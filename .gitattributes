# Keep patch files byte-exact (LF, no CRLF conversion) so `git am` / `patch` never break
*.patch -text

# Build scripts must stay LF: a CRLF shell script dies with `$'\r': command not
# found` and exits 127 — which reads as a build failure long after the build
# actually succeeded (build-sop, 2026-07-11).
*.sh text eol=lf
verify_markers.txt text eol=lf
LICENSE -text
docs/ASUS-Merlin_Changelog-3006.txt -text
