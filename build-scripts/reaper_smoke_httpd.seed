# nvram seed for reaper_httpd_smoke.sh: a set-up router serving plain HTTP on the test port.
x_Setting=1
w_Setting=1
productid=RT-BE96U
odmpid=
http_enable=0
http_lanport=18080
https_lanport=18443
http_username=admin
http_passwd=reaper-smoke-not-a-password
lan_ipaddr=127.0.0.1
lan_netmask=255.0.0.0
lan_ifname=lo
lan_hostname=RT-BE96U
time_zone_x=UTC
preferred_lang=EN
misc_http_x=0
ipv6_service=disabled
sw_mode=1
wans_dualwan=wan none
wan_unit=0
