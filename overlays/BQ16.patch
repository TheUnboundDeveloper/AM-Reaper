diff --git a/release/src-rt/target.mak b/release/src-rt/target.mak
index f4822fe99d..7f2154adeb 100644
--- a/release/src-rt/target.mak
+++ b/release/src-rt/target.mak
@@ -348,6 +348,37 @@ export RT-BE96U += BUILD_NAME="RT-BE96U" EXT_PHY="BCM84880" NVSIZE="192" DHDAP=y
 # RouterOptions selects the SAMBA4 branch (RTCONFIG_SAMBA4=y), not SAMBA36X.
 export RT-BE96U += SAMBA4=y SAMBA3=
 
+# reaper: ZenWiFi BQ16 (non-Pro, 2.4/5/5/6, boards BQ16_2556 and BQ16_2556_2). Token set =
+# ASUS GPL 102_39256 BQ16 block with the RT-BE96U de-cloud decisions applied: BWDPI, ALEXA,
+# GOOGLE_ASST, NATNL_AICLOUD, NATNL_AIHOME left out; WEBDAV SMARTSYNCBASE FRS_FEEDBACK CLOUDCHECK
+# FORCE_AUTO_UPGRADE UUPLUGIN ASD AHS FRS_LIVE_UPDATE =n. No MULTISERVICE_WAN (stock BQ16 has none;
+# the base WAN page is installed, as on GT-BE98). No AURALED (SINGLE_LED board).
+export BQ16 := $(HND-96813_BASE)
+export BQ16 += BUILD_NAME="BQ16" SWITCH2="BCM53134" NVSIZE="128" DHDAP=y HND_WL=y DPSTA=n LACP=y WTFAST=n REPEATER=y \
+		DISABLE_REPEATER_UI=y DISABLE_PROXYSTA_UI=y IPV6SUPP=y HTTPS=y ARM=y AUTODICT=y BBEXTRAS=y USBEXTRAS=y EBTABLES=y \
+		MEDIASRV=y MODEM=y USB_WAN_BACKUP=y PARENTAL2=y ACCEL_PPTPD=y PRINTER=y WEBDAV=n SMARTSYNCBASE=n USB="USB" \
+		APP="network" PROXYSTA=y DNSMQ=y SHP=n BCMWL6=y BCMWL6A=y DISK_MONITOR=y BTN_WIFITOG=n OPTIMIZE_XBOX=y ODMPID=y \
+		LED_BTN=n BCMSMP=y XHCI=y DUALWAN=y NEW_USER_LOW_RSSI=y OPENVPN=y TIMEMACHINE=y MDNS=y VPNC=y JFFS2LOG=y \
+		DUMP_OOPS_MSG=n LINUX_MTD="64" DEBUGFS=y TEMPROOTFS=n SSH=y EMAIL=y FRS_FEEDBACK=n SYSSTATE=y ROG=n STAINFO=y \
+		CLOUDCHECK=n REBOOT_SCHEDULE=y MULTICASTIPTV=y QUAGGA=y WLCLMLOAD=n BCM_MUMIMO=y LAN50="all" ATCOVER=y \
+		GETREALIP=y CFEZ=y ETLAN_LED=y TFAT=y NTFS="tuxera" HFS="tuxera" NEWSSID_REV2=y NEWSSID_REV4=y NEWSSID_REV5=y \
+		NEW_APP_ARM=y VISUALIZATION=n BONDING=y BONDING_WAN=n NETOOL=y TRACEROUTE=y FORCE_AUTO_UPGRADE=n IFTTT=n \
+		SW_HW_AUTH=y HD_SPINDOWN=y ASPMD=n BCM_MEVENT=n BCM_APPEVENTD=n LETSENCRYPT=y VPN_FUSION=y JFFS_NVRAM=y \
+		NVRAM_ENCRYPT=y IPSEC=STRONGSWAN IPSEC_SRVCLI_ONLY=SRV BCM_CEVENTD=y UTF8_SSID=y AMAS=y DWB=y FRONTHAUL_DWB=y \
+		DBLOG=y ETHOBD=y CFGSYNC_LOCSYNC=y CONNDIAG=y NFCM=n DNSQUERY_INTERCEPT=y CRASHLOG=y WATCH_REINIT=y \
+		WATCH_RXF1OVFL=y BW160M=y BRCM_HOSTAPD=y UUPLUGIN=n IPERF3=y MSSID_PRELINK=y FRS_LIVE_UPDATE=n BCM_CLED=y \
+		SINGLE_LED=y BCN_RPT=y BTM_11V=y INFO_EXAP=y BCMEVENTD=y AMAS_ADTBW=y SW_CTRL_ALLLED=y AMAS_SYNC_2G_BW=y \
+		AMAZON_WSS=n AHS=n ASD=n INTERNETCTRL=y AVBLCHAN=y ADTBW_RADAR=y INSTANT_GUARD=y AMAS_ETHDETECT=y RTL8221VB=y \
+		ACL96=y EXTEND_LIMIT=y ASUSCTRL=y DHD_6715B0=y COMFW=y FRONTHAUL_AP_AUTO_OPT=y WIREGUARD=y BCMBSD_V2=y \
+		FSCRYPTCTL=n AMAS_SS2=n WIFI7=y BW320M=y QUADBAND=y HAS_5G_2=y HAS_6G=y MTLANCFG=y WPA3_ENTERPRISE=y \
+		SMART_HOME_MASTER_UI=y \
+		EXTRA_KERNEL_CONFIGS="BCM_JUMBO_FRAME=y BCM_MAX_MTU_SIZE=10240 CONFIG_BCM_IGNORE_BRIDGE_MTU=y" \
+		AMAS_OB_DISABLE_DSAP=y OWE_TRANS=y MLO=y AUTO_WANPORT=y SMARTHAUL=y DOWNGRADE_CHECK=y MLO_DEFAULT_ACTIVE=y \
+		MLO_BH_BAND=y MLO_CONFIG_556=y AMAS_DIS_HASH_KEY_GEN_CHECK=y
+export BQ16 += NFS=n SNMPD=y TOR=y UPNPIGD2=y NANO=y NTPD=y IPSET=y VPN_FUSION_MERLIN=y
+export BQ16 += SAMBA4=y SAMBA3=
+export BQ16_CFG := $(BQ16)
+
 export GT-BE98_PRO := $(HND-96813_BASE)
 export GT-BE98_PRO += BUILD_NAME="GT-BE98_PRO" EXT_PHY="BCM84880" NVSIZE="192" DHDAP=y DPSTA=n REPEATER=y IPV6SUPP=y HTTPS=y ARM=y \
 		AUTODICT=y BBEXTRAS=y USBEXTRAS=y EBTABLES=y MEDIASRV=y MODEM=y PARENTAL2=y ACCEL_PPTPD=y PRINTER=y WEBDAV=n \
