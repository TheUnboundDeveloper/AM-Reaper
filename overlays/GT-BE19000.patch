diff --git a/release/src-rt/target.mak b/release/src-rt/target.mak
index f4822fe99d..8e5f7439f6 100644
--- a/release/src-rt/target.mak
+++ b/release/src-rt/target.mak
@@ -348,6 +348,63 @@ export RT-BE96U += BUILD_NAME="RT-BE96U" EXT_PHY="BCM84880" NVSIZE="192" DHDAP=y
 # RouterOptions selects the SAMBA4 branch (RTCONFIG_SAMBA4=y), not SAMBA36X.
 export RT-BE96U += SAMBA4=y SAMBA3=
 
+# GT-BE19000 (ROG Rapture, non-AI SKU) - onboarded 2026-09-10.
+#
+# Same BCM4916/6813 silicon, 96813GW profile and NAND layout as the RT-BE96U;
+# only the GT-BE19000AI variant is eMMC. This block is DERIVED from the RT-BE96U
+# block above plus the per-model token delta ASUS ships in its own 39274 GPL, so
+# every de-cloud edit made there is inherited rather than restated - and a future
+# change to one becomes a visible divergence instead of a silent one.
+#
+# Delta vs RT-BE96U, and why:
+#   + PRESSURE_SENSOR        the I2C pressure sensor this SKU carries
+#   + BTN_TURBO BTN_WIFITOG  its physical buttons; RT-BE96U has LED_BTN instead
+#   + DHD_6715B0 MAX_VPNF=4  ASUS per-model values from the GPL
+#   + ROG=y                  ROG SKU: LED complement and board identity
+#   - ROG_UI                 OFF. Upstream Merlin sets ROG_UI=n on its own ROG
+#                            model (GT-AX11000), and Reaper replaces the web UI
+#                            wholesale, so the ROG skin has nothing to skin.
+#   - WTFAST_V2              OFF. A third-party cloud gaming service - the same
+#                            class as the tunnels and account bindings this fork
+#                            removes. It does not come back in on a new model.
+#   - BONDING_WAN            n, per ASUS for this SKU.
+#   - LED_BTN PC_SCHED_V3 MULTISERVICE_WAN DOWNGRADE_CHECK
+#                            RT-BE96U-only in the GPL; not claimed for this board.
+#
+# AURALED / AURALED_NIGHT are inherited from RT-BE96U. They are Reaper additions
+# (unset for both models in the GPL) and are UNVERIFIED on this board, which has
+# a different LED complement - confirm on hardware.
+export GT-BE19000 := $(HND-96813_BASE)
+export GT-BE19000 += BUILD_NAME="GT-BE19000" EXT_PHY="BCM84880" NVSIZE="192" DHDAP=y DPSTA=n REPEATER=y IPV6SUPP=y HTTPS=y ARM=y \
+ AUTODICT=y BBEXTRAS=y USBEXTRAS=y EBTABLES=y MEDIASRV=y MODEM=y PARENTAL2=y ACCEL_PPTPD=y PRINTER=y WEBDAV=n \
+ SMARTSYNCBASE=n USB="USB" APP="network" PROXYSTA=y DNSMQ=y SHP=n BCMWL6=y BCMWL6A=y DISK_MONITOR=y \
+ OPTIMIZE_XBOX=y ODMPID=y BCMSMP=y XHCI=y DUALWAN=y NEW_USER_LOW_RSSI=y OPENVPN=y TIMEMACHINE=y MDNS=y VPNC=y \
+ JFFS2LOG=y DUMP_OOPS_MSG=n LINUX_MTD="64" DEBUGFS=y TEMPROOTFS=n SSH=y EMAIL=y FRS_FEEDBACK=n SYSSTATE=y \
+ STAINFO=y CLOUDCHECK=n REBOOT_SCHEDULE=y MULTICASTIPTV=y QUAGGA=y WLCLMLOAD=n BCM_MUMIMO=y LAN50="all" \
+ ATCOVER=y GETREALIP=y CFEZ=y ETLAN_LED=y TFAT=y NTFS="tuxera" HFS="tuxera" NEWSSID_REV4=y NEW_APP_ARM=y NETOOL=y \
+ TRACEROUTE=y FORCE_AUTO_UPGRADE=n SW_HW_AUTH=y HD_SPINDOWN=y ASPMD=n BCM_MEVENT=n BCMEVENTD=y BCM_APPEVENTD=n \
+ LETSENCRYPT=y VPN_FUSION=y JFFS_NVRAM=y NVRAM_ENCRYPT=y BCM_CEVENTD=y UTF8_SSID=y I2CTOOLS=y AMAS=y \
+ DBLOG=y ETHOBD=y CFGSYNC_LOCSYNC=y CONNDIAG=y NFCM=n DNSQUERY_INTERCEPT=y IPSEC=STRONGSWAN IPSEC_SRVCLI_ONLY=SRV \
+ DWB=y OPEN_NAT=y AMASDB=n CRASHLOG=y WATCH_REINIT=n BW160M=y BRCM_HOSTAPD=y UUPLUGIN=n IPERF3=y INFO_EXAP=y BCN_RPT=y \
+ BTM_11V=y INTERNETCTRL=y ASD=n AHS=n FRS_LIVE_UPDATE=n ASUSCTRL=y HAS_6G=y CAPTCHA=y OUTFOX=y GAME_MODE=y \
+ AMAS_ETHDETECT=y INSTANT_GUARD=y AVBLCHAN=y FRONTHAUL_DWB=y BCM_CLED=y BONDING=y BONDING_WAN=n ACL96=y LACP=y \
+ OWE_TRANS=y EXTEND_LIMIT=y WIREGUARD=y BCMBSD_V2=y AURALED_NIGHT=y AURALED=y \
+ SW_CTRL_ALLLED=y COMFW=y WIFI7=y BW320M=y MTLANCFG=y CAPTIVE_PORTAL=y CP_FREEWIFI=y \
+ WPA3_ENTERPRISE=y USB_WAN_BACKUP=y \
+ EXTRA_KERNEL_CONFIGS="BCM_JUMBO_FRAME=y BCM_MAX_MTU_SIZE=10240 CONFIG_BCM_IGNORE_BRIDGE_MTU=y" \
+ AMAS_OB_DISABLE_DSAP=y AUTO_WANPORT=y \
+ NFS=n SNMPD=y TOR=y UPNPIGD2=y NANO=y NTPD=y IPSET=y VPN_FUSION_MERLIN=y
+
+# reaper: RT-BE96U on Samba 4.x for SMB3 (BE96U-only for now). Trailing SAMBA3=
+# (blank) overrides the SAMBA3="3.6.x" inherited from HND-96813_BASE so
+# RouterOptions selects the SAMBA4 branch (RTCONFIG_SAMBA4=y), not SAMBA36X.
+# Per-model delta vs the RT-BE96U block above. Its own append rather than a
+# continuation: the block it is derived from interleaves comments, and tokens
+# spliced onto the wrong line are dropped by make without a word.
+export GT-BE19000 += BTN_TURBO=y BTN_WIFITOG=y DHD_6715B0=y MAX_VPNF=4 PRESSURE_SENSOR=y ROG=y ROG_UI=n WTFAST_V2=n
+export GT-BE19000 += SAMBA4=y SAMBA3=
+
+
 export GT-BE98_PRO := $(HND-96813_BASE)
 export GT-BE98_PRO += BUILD_NAME="GT-BE98_PRO" EXT_PHY="BCM84880" NVSIZE="192" DHDAP=y DPSTA=n REPEATER=y IPV6SUPP=y HTTPS=y ARM=y \
 		AUTODICT=y BBEXTRAS=y USBEXTRAS=y EBTABLES=y MEDIASRV=y MODEM=y PARENTAL2=y ACCEL_PPTPD=y PRINTER=y WEBDAV=n \
