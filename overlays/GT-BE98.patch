diff --git a/release/src/router/rc/reaper_chanlist_shim.c b/release/src/router/rc/reaper_chanlist_shim.c
new file mode 100644
index 0000000000..aa62df693f
--- /dev/null
+++ b/release/src/router/rc/reaper_chanlist_shim.c
@@ -0,0 +1,46 @@
+/* SPDX-License-Identifier: GPL-2.0-only
+ * Reaper GT-BE98 (non-Pro) prebuilt-compat shim.
+ *
+ * v1.5.9 rework. The closed per-model objects rc/broadcom.o, rc/private.o,
+ * shared/spwenc.o and shared/nvpriv.o are now the OFFICIAL ASUS GT-BE98
+ * GPL 102_39274 builds. Through v1.5.1 they were the GT-BE98_PRO 102.8
+ * objects (an earlier version-skew workaround) - running the Pro's
+ * model-specific closed code on the non-Pro board is the prime suspect for
+ * the field-reported symptoms: only 3 of 4 radios (no 6 GHz), an empty
+ * wireless client list, and roughly halved wired throughput.
+ *
+ * The 39274 objects are model-correct but predate three helpers our
+ * 3006.102.8-level open source links against. Each stub below reproduces the
+ * behavior of ASUS's own (working) GT-BE98 firmware at 39274, which had no
+ * such symbol and therefore no such branch:
+ *
+ * - wl_scb(): an rc diagnostic applet dispatch added in the .8 line
+ *   (rc.c "wl_scb" busybox-style applet). No-op here; the applet simply
+ *   reports nothing, exactly like stock 39274.
+ * - backup_eth_ob_log(): watchdog's AiMesh onboarding-timeout path backs up
+ *   an onboarding log right before notify_rc("resetdefault"). Skipping the
+ *   backup loses only that diagnostic file; the reset path is unchanged.
+ * - is_wan_port_ext_switch(): gates a MULTISERVICE_WAN STB auto-bridge
+ *   branch in interface.c. Returning 0 selects the generic path, which is
+ *   what 39274's open code (no branch at all) did on this exact board.
+ *
+ * The previous Get_ChannelList_5G_2() delegate shim is GONE: the 39274
+ * broadcom.o defines the real one (and ed_thresh_clear), so the ATE second-5
+ * GHz channel list is now exact instead of mirroring the primary 5 GHz list.
+ */
+
+void wl_scb(void)
+{
+	/* not provided by the GT-BE98 102_39274 prebuilt; nothing to report */
+}
+
+int backup_eth_ob_log(void)
+{
+	return 0;
+}
+
+int is_wan_port_ext_switch(int base_unit)
+{
+	(void)base_unit;
+	return 0;
+}
