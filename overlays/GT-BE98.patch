+ *     0          - OK\n
+ *    <0          - error\n
+ */
+int bdmf_type_info(bdmf_type_handle drv, bdmf_type_info_t *info);
+
+
+/** Get number of attributes supported by managed object type
+ *
+ * \param[in]   drv     Managed object type handle
+ * \return number of attributes
