+ * \param[in]       val         Value in external format - 0-terminated string
+ * \return
+ *     0 - OK\n
+ *     error code otherwise
+ */
+int bdmf_attrelem_find_by_string(bdmf_object_handle mo, bdmf_attr_id attr, bdmf_index *index, const char *val);
