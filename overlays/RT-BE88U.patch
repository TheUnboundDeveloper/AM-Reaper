+ */
+static inline int bdmf_attr_get_as_buf(bdmf_object_handle mo_or_mattr,
+                                       bdmf_attr_id attr, void *buffer, uint32_t size)
+{
+    return bdmf_attrelem_get_as_buf(mo_or_mattr, attr, -1, buffer, size);
