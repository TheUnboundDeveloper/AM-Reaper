 	 /*to replace '<' to ',' e.g. 192.168.3.1/16,192.168.2.1/24*/
 	while ((ptr=strchr(p_tmp, '<'))!=NULL) *ptr = ',';
 	
@@ -290,7 +295,7 @@ void ipsec_prof_fill(int prof_idx, char *p_data, ipsec_prof_type_t prof_type)
