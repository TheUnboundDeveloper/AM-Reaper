-    ipsec_profile_str_parse(p_end, p_tmp, &i);
+    ipsec_profile_str_parse(p_end, p_tmp, sizeof(prof[prof_type][prof_idx].remote_subnet), &i);
     /*to replace '<' to ',' e.g. 192.168.3.1/16,192.168.2.1/24*/
