From a0b21a90fa29919958c76d5dd6eca47176e8378b Mon Sep 17 00:00:00 2001
From: reaper <theunbounddeveloper@outlook.com>
Date: Sat, 27 Jun 2026 14:01:20 -0400
Subject: [PATCH 14/25] rc/usb_devices: bound hotplug_dbg, NOFOLLOW debug log,
 strlcpy (M4/M8/L2)

- M4: hotplug_dbg() built err_str/err_str2 with sprintf() from uevent
  env strings (action/driver/strerror); use snprintf and widen err_str2
  to 128 so "PID:%d %s" never truncates.
- L2: the debug log was fopen("/tmp/usb_err","a+") as root on a
  predictable path -> a planted symlink could redirect/append-attack an
  arbitrary file. Open with O_WRONLY|O_CREAT|O_APPEND|O_NOFOLLOW, 0600
  via open()+fdopen(), and guard all writes on a non-NULL stream.
- M8: replace strcpy(blkdev,devname) [blkdev is 8 bytes; e.g. mmcblk0p1
  is 9] and strcpy(device_type, nvram_safe_get(prefix)) [16 bytes] with
  strlcpy bounded by the destination size.

Compiles clean with the real userspace toolchain; no warnings at the
edited sites.

Co-Authored-By: Claude Opus 4.8 (1M context) <noreply@anthropic.com>
---
 release/src/router/rc/usb_devices.c | 22 ++++++++++++++--------
 1 file changed, 14 insertions(+), 8 deletions(-)

diff --git a/release/src/router/rc/usb_devices.c b/release/src/router/rc/usb_devices.c
index 5fb89ca1f4..8895a6abd6 100644
--- a/release/src/router/rc/usb_devices.c
+++ b/release/src/router/rc/usb_devices.c
@@ -2725,13 +2725,19 @@ FILE *fp = NULL;
 #define hotplug_dbg(fmt, args...) (\
 { \
 	char err_str[100] = {0}; \
-	char err_str2[100] = {0}; \
+	char err_str2[128] = {0}; /* M4: holds "PID:%d " + err_str without truncation */ \
 	if (hotplug_pid == -1) hotplug_pid = getpid(); \
-	if (!fp) fp = fopen("/tmp/usb_err", "a+"); \
-	sprintf(err_str, fmt, ##args); \
-	sprintf(err_str2, "PID:%d %s", hotplug_pid, err_str); \
-	fwrite(err_str2, strlen(err_str2), 1,  fp); \
-	fflush(fp); \
+	if (!fp) { \
+		/* L2: O_NOFOLLOW + 0600 so a planted /tmp/usb_err symlink can't redirect root appends */ \
+		int _fd = open("/tmp/usb_err", O_WRONLY|O_CREAT|O_APPEND|O_NOFOLLOW, 0600); \
+		if (_fd >= 0) fp = fdopen(_fd, "a"); \
+	} \
+	if (fp) { \
+		snprintf(err_str, sizeof(err_str), fmt, ##args); /* M4: bound uevent-derived text */ \
+		snprintf(err_str2, sizeof(err_str2), "PID:%d %s", hotplug_pid, err_str); \
+		fwrite(err_str2, strlen(err_str2), 1,  fp); \
+		fflush(fp); \
+	} \
 } \
 )
 
@@ -2899,7 +2905,7 @@ static void optimize_block_device(const char *devname)
 	int err;
 
 	memset(blkdev, 0, sizeof(blkdev));
-	strcpy(blkdev, devname);
+	strlcpy(blkdev, devname, sizeof(blkdev));	/* M8 */
 	for (p = blkdev; *p; ++p) {
 		if (!isdigit(*p))
 			continue;
@@ -4514,7 +4520,7 @@ int asus_usb_interface(const char *device_name, const char *action)
 			nvram_unset(nvram_usb_path);
 		}
 
-		strcpy(device_type, nvram_safe_get(prefix));
+		strlcpy(device_type, nvram_safe_get(prefix), sizeof(device_type));	/* M8 */
 
 #ifdef RTCONFIG_USB_MODEM
 		vid = strtoul(nvram_safe_get(strcat_r(prefix, "_vid", tmp)), NULL, 16);
