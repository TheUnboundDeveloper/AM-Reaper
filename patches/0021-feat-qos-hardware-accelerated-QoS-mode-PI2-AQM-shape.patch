From dd60fca594ba0ac579bdeb4d2e55327b25e46620 Mon Sep 17 00:00:00 2001
From: reaper <theunbounddeveloper@outlook.com>
Date: Sun, 28 Jun 2026 16:14:29 -0400
Subject: [PATCH] feat(qos): hardware-accelerated QoS mode (PI2 AQM + shaper,
 accelerator stays on)

New qos_type=10 "Hardware QoS": programs the Broadcom Runner egress traffic
manager (PI2 AQM + per-queue rate shaper) on the WAN egress queue via tmctl,
instead of software tc/HTB. Unlike T.QoS / Bandwidth-Limiter it does NOT disable
the flow accelerator (fc/runner), so shaping + AQM run on the hardware fast path
with the CPU out of the data path. Eliminates upload bufferbloat and packet loss
at near-zero CPU cost. Upload-side only; download is future work.

- shared.h: IS_HWQOS() (qos_type 10)
- init-broadcom.c hnd_nat_ac_init(): exempt IS_HWQOS from fc_disable/runner_disable
- qos.c: add_iQosRules early-return (no iptables/tc); start_iQos dispatch; new
  start_hwqos() emits the qosfn start/stop script (setqdropalg 4 then setqshaper
  qos_obw; stop resets both). Drop-alg before shaper since setqdropalg clears it.
- rc.h: declare start_hwqos()

Validated on stock RT-BE96U hardware (manual tmctl): 0% loss, loaded latency
71ms->30ms, all four A53 cores <2%, flow accelerator stays enabled.

Co-Authored-By: Claude Opus 4.8 (1M context) <noreply@anthropic.com>
---
 release/src/router/rc/qos.c                   | 58 +++++++++++++++++++
 release/src/router/rc/rc.h                    |  1 +
 release/src/router/rc/sysdeps/init-broadcom.c |  8 +--
 release/src/router/shared/shared.h            |  1 +
 4 files changed, 64 insertions(+), 4 deletions(-)

diff --git a/release/src/router/rc/qos.c b/release/src/router/rc/qos.c
index 13d22aabd3f..1bedd796b16 100644
--- a/release/src/router/rc/qos.c
+++ b/release/src/router/rc/qos.c
@@ -2714,6 +2714,9 @@ int add_iQosRules(char *pcWANIF)
 
 	if (pcWANIF == NULL || nvram_get_int("qos_type") == 1 || nvram_get_int("qos_type") == 8) return -1;
 
+	/* HW QoS shapes in the hardware egress TM (no iptables/tc classification needed) */
+	if (IS_HWQOS()) return -1;
+
 	if (IS_TQOS()) {
 		status = add_qos_rules(pcWANIF);
 	}
@@ -2779,6 +2782,9 @@ int start_iQos(void)
 		status = start_bcm_tm();
 	}
 #endif
+	else if (IS_HWQOS()) {
+		status = start_hwqos();
+	}
 #endif
 
 /* OPPO */
@@ -2959,6 +2965,58 @@ int start_cake(void)
 	return 0;
 }
 
+/*
+ * Hardware-accelerated QoS (upload).
+ *
+ * Programs the Broadcom Runner egress traffic manager on the WAN port's
+ * default egress queue (qid 0) with PI2 AQM plus a rate shaper, via tmctl.
+ * Unlike T.QoS / Bandwidth-Limiter (software tc/HTB) this keeps the flow
+ * accelerator ENABLED: IS_HWQOS() is exempted from fc_disable/runner_disable
+ * in hnd_nat_ac_init(), so all packet processing stays on the hardware fast
+ * path and the CPU is not in the data path.
+ *
+ * Upload bandwidth comes from nvram qos_obw (kbit/s); 0 = shaper off.
+ * Ordering matters: setqdropalg rewrites the queue config and clears the
+ * shaper, so the drop algorithm MUST be programmed before the shaper.
+ */
+int start_hwqos(void)
+{
+	FILE *f;
+	unsigned int obw;
+	const char *wan_ifname = get_wan_ifname(wan_primary_ifunit());
+
+	obw = strtoul(nvram_safe_get("qos_obw"), NULL, 10);
+
+	if ((f = fopen(qosfn, "w")) == NULL) return -2;
+
+	fprintf(f,
+		"#!/bin/sh\n"
+		"WANIF='%s'\n"
+		"OBW='%u'\n"
+		"QID=0\n\n"
+		"case \"$1\" in\n"
+		"start)\n"
+		"\ttmctl setqdropalg --devtype 0 --if $WANIF --qid $QID --dropalg 4\n"
+		"\t[ \"$OBW\" -gt 0 ] && tmctl setqshaper --devtype 0 --if $WANIF --qid $QID --shapingrate $OBW\n"
+		"\t;;\n"
+		"stop)\n"
+		"\ttmctl setqshaper  --devtype 0 --if $WANIF --qid $QID --shapingrate 0\n"
+		"\ttmctl setqdropalg --devtype 0 --if $WANIF --qid $QID --dropalg 0\n"
+		"\t;;\n"
+		"*)\n"
+		"esac\n",
+		wan_ifname,
+		obw
+	);
+
+	fclose(f);
+	chmod(qosfn, 0755);
+	run_custom_script("qos-start", 120, "init", NULL);
+	eval((char *)qosfn, "start");
+
+	return 0;
+}
+
 #if defined(BCM4912) || defined(RTCONFIG_HND_ROUTER_BE_4916)
 
 #define QOS_MIN_QPKTS       8
diff --git a/release/src/router/rc/rc.h b/release/src/router/rc/rc.h
index fd47a1d06c8..e0a54369fee 100644
--- a/release/src/router/rc/rc.h
+++ b/release/src/router/rc/rc.h
@@ -1942,6 +1942,7 @@ extern int start_cake(void);
 #if defined(BCM4912) || defined(RTCONFIG_HND_ROUTER_BE_4916)
 extern int start_bcm_tm(void);
 #endif
+extern int start_hwqos(void);
 #endif
 extern void set_codel_patch(void);
 extern void remove_codel_patch(void);
diff --git a/release/src/router/rc/sysdeps/init-broadcom.c b/release/src/router/rc/sysdeps/init-broadcom.c
index 62699b357f9..1b7eb339da1 100644
--- a/release/src/router/rc/sysdeps/init-broadcom.c
+++ b/release/src/router/rc/sysdeps/init-broadcom.c
@@ -19278,11 +19278,11 @@ void hnd_nat_ac_init(int bootup)
 {
 	int routing_mode = is_routing_enabled();
 
-	// A.QOS/BCMTM : not to disable fc
-	nvram_set_int("fc_disable", nvram_get_int("fc_disable_force") || (routing_mode && IS_NON_AQOS() && !IS_RB_QOS() && !IS_BCMTM_QOS()) ? 1 : 0);
+	// A.QOS/BCMTM/HWQOS : not to disable fc (both hardware QoS modes shape in the Runner TM)
+	nvram_set_int("fc_disable", nvram_get_int("fc_disable_force") || (routing_mode && IS_NON_AQOS() && !IS_RB_QOS() && !IS_BCMTM_QOS() && !IS_HWQOS()) ? 1 : 0);
 
-	// A.QOS/BCMTM : no need to disable runner
-	nvram_set_int("runner_disable", nvram_get_int("runner_disable_force") || (routing_mode && IS_NON_AQOS() && !IS_RB_QOS() && !IS_BCMTM_QOS()) ? 1 : 0);
+	// A.QOS/BCMTM/HWQOS : no need to disable runner
+	nvram_set_int("runner_disable", nvram_get_int("runner_disable_force") || (routing_mode && IS_NON_AQOS() && !IS_RB_QOS() && !IS_BCMTM_QOS() && !IS_HWQOS()) ? 1 : 0);
 
 #ifdef RTCONFIG_HND_ROUTER_BE_4916
 	/*
diff --git a/release/src/router/shared/shared.h b/release/src/router/shared/shared.h
index c77f1c98eff..294ab3bf9dd 100644
--- a/release/src/router/shared/shared.h
+++ b/release/src/router/shared/shared.h
@@ -327,6 +327,7 @@ static inline char *wan_if_eth(void)
 #define IS_RB_QOS()             (nvram_get_int("rb_enable") == 1)   // Router Boost QoS (OPPO)
 #define IS_CAKE_QOS()		(nvram_get_int("qos_enable") == 1 && nvram_get_int("qos_type") == 9)   // Cake QoS
 #define IS_BCMTM_QOS()		(nvram_get_int("qos_enable") == 1 && nvram_get_int("qos_type") == 8)	// BCM Traffic Manager (PI2/WRED)
+#define IS_HWQOS()		(nvram_get_int("qos_enable") == 1 && nvram_get_int("qos_type") == 10)  // Hardware QoS (Runner egress TM: PI2 AQM + shaper, keeps flow accelerator on)
 
 /* Guest network mark */
 #if defined(RTCONFIG_HND_ROUTER_BE_4916)
