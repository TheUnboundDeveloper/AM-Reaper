-	static const char iprule_tmp[] = "/tmp/iprule_tmp";
+	char iprule_tmp[] = "/tmp/iprule_tmp.XXXXXX";	/* M9: unique file (mkstemp, O_EXCL) instead of a predictable, symlink-raceable path */
