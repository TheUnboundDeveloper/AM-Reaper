From 7ced303602f0f948631774c3c8d897df06807f49 Mon Sep 17 00:00:00 2001
From: reaper <theunbounddeveloper@outlook.com>
Date: Sat, 27 Jun 2026 14:48:33 -0400
Subject: [PATCH 22/25] build: tag custom build version + image with -reaper
 (BUILDREV)

Default BUILDREV to -reaper so RT_EXTENDNO becomes "beta2-reaper" and the
output image is named ..._beta2-reaper.trx, marking this hardened custom
build. An explicitly-passed BUILDREV still uses the original -g<hash> form.

Co-Authored-By: Claude Opus 4.8 (1M context) <noreply@anthropic.com>
---
 release/src-rt/Makefile | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/release/src-rt/Makefile b/release/src-rt/Makefile
index 864092d5bd..1ac0b6d2b3 100755
--- a/release/src-rt/Makefile
+++ b/release/src-rt/Makefile
@@ -296,7 +296,10 @@ export CONFIG_LINUX26=y
 	# its multi-arch in 94908, specify ARCH in kbuild result bad
 export IFADDRS_LINKS=$(SRCBASE)/router/libusbmuxd-2.0.2/common/ifaddrs.c $(SRCBASE)/router/minidlna/ifaddrs.c $(SRCBASE)/router/miniupnpd/ifaddrs.c $(SRCBASE)/router/wsdd2/ifaddrs.c
 endif
-ifneq ($(BUILDREV),)
+# REAPER custom build: default the firmware version/image suffix to -reaper
+ifeq ($(BUILDREV),)
+export BUILDREV := -reaper
+else
 export BUILDREV := -g$(shell git log --pretty=format:'%h' -n 1)
 endif
 #-include .config
