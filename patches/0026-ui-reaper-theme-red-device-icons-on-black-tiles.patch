From 3bd814859bbd34d241757c619ea127efe88a079a Mon Sep 17 00:00:00 2001
From: reaper <theunbounddeveloper@outlook.com>
Date: Tue, 30 Jun 2026 15:55:08 -0400
Subject: [PATCH] ui: reaper theme - red device icons on black tiles

Append a scoped Reaper-theme override to the client/device icon CSS so the
network-map + client-list device-type and vendor symbols render reaper-red
(#E10600) on black tiles, regardless of the active skin's default fill
(base=white, UI4=black). Uses !important on the existing mask-fill and
.clientIcon* tile rules; no base64 icon artwork is modified.

Applied to the UI4 (BE96U default skin) and base CSS:
 - device-map/device-map.css, device-map/clientlist.css
 - sysdep/FUNCTION/UI4/device-map/device-map.css
 - sysdep/FUNCTION/UI4/css/business-white.css

Note: .type36 (animated full-colour ASUS/AiMesh icon, not a mask) is left
as-is and remains its original colour.

Co-Authored-By: Claude Opus 4.8 (1M context) <noreply@anthropic.com>
---
 .../src/router/www/device-map/clientlist.css  | 16 ++++++++++++++++
 .../src/router/www/device-map/device-map.css  | 19 ++++++++++++++++++-
 .../FUNCTION/UI4/css/business-white.css       | 16 ++++++++++++++++
 .../FUNCTION/UI4/device-map/device-map.css    | 19 ++++++++++++++++++-
 4 files changed, 68 insertions(+), 2 deletions(-)

diff --git a/release/src/router/www/device-map/clientlist.css b/release/src/router/www/device-map/clientlist.css
index 0c2286fc38..4c86ac1266 100644
--- a/release/src/router/www/device-map/clientlist.css
+++ b/release/src/router/www/device-map/clientlist.css
@@ -1182,3 +1182,19 @@ html::-webkit-scrollbar-track:hover {
 
 }
 
+/* ===== REAPER THEME: red device symbols on black tiles ===== */
+/* Device-type + vendor mask icons painted reaper-red (overrides white/black skin fills). */
+i[class^='type'], i[class*=' type'],
+i[class^='vendor-icon'], i[class*=' vendor-icon']{
+	background-color: #E10600 !important;
+}
+/* Client icon tiles: black background with a dark-red edge. */
+.clientIcon, .clientIcon_clicked,
+.clientIcon_no_hover, .vendorIcon_no_hover{
+	background-color: #000000 !important;
+	box-shadow: 0px 0px 0px 1px #330000 !important;
+}
+.clientIcon:hover, .clientIcon.clicked{
+	background-color: #1A0000 !important;
+}
+/* ===== END REAPER THEME ===== */
