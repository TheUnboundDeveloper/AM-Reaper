From e662f676765c3add4537aacda2bc19298094bdfd Mon Sep 17 00:00:00 2001
From: reaper <theunbounddeveloper@outlook.com>
Date: Mon, 29 Jun 2026 15:49:54 -0400
Subject: [PATCH] fix(qos): start_cake format specifier %d -> %u for unsigned
 bandwidth

Round-3 audit Tier D11 (cosmetic; ibw/obw are unsigned int).

Co-Authored-By: Claude Opus 4.8 (1M context) <noreply@anthropic.com>
---
 release/src/router/rc/qos.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/release/src/router/rc/qos.c b/release/src/router/rc/qos.c
index 1bedd796b16..10fd8b97bd2 100644
--- a/release/src/router/rc/qos.c
+++ b/release/src/router/rc/qos.c
@@ -2882,12 +2882,12 @@ int start_cake(void)
 	if (ibw == 0)
 		*ibwstr = '\0';
 	else
-		snprintf(ibwstr, sizeof(ibwstr), "bandwidth %dkbit", ibw);
+		snprintf(ibwstr, sizeof(ibwstr), "bandwidth %ukbit", ibw);
 
 	if (obw == 0)
 		*obwstr = '\0';
 	else
-		snprintf(obwstr, sizeof(obwstr), "bandwidth %dkbit", obw);
+		snprintf(obwstr, sizeof(obwstr), "bandwidth %ukbit", obw);
 
 	snprintf(overheadstr, sizeof(overheadstr), "overhead %d mpu %d", nvram_get_int("qos_overhead"), nvram_get_int("qos_mpu"));
 
-- 
2.25.1

