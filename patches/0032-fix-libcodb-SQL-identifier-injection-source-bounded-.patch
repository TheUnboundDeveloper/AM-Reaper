 release/src/router/libcodb/codb_utils.c  | 12 ++---
 release/src/router/libcodb/cosql_utils.c | 63 ++++++++++++++++++------
 2 files changed, 54 insertions(+), 21 deletions(-)
 mode change 100755 => 100644 release/src/router/libcodb/cosql_utils.c

