From c060e46b5791da2ab6137910f9120bc21c153223 Mon Sep 17 00:00:00 2001
From: reaper <theunbounddeveloper@outlook.com>
Date: Mon, 29 Jun 2026 20:45:09 -0400
Subject: [PATCH] build: drop "beta2" from version; brand image as
 3006.102.8_reaper

Sets EXTENDNO=reaper (was beta2) so the firmware version and image name
read RT-BE96U_3006_102.8_reaper, removing the beta2 token while keeping
the reaper brand. BUILDREV now defaults to empty (brand moved to
EXTENDNO), which also stays empty through exported sub-makes and avoids
the prior BUILDREV export-recursion flip that produced -g<hash> labels.

Co-Authored-By: Claude Opus 4.8 (1M context) <noreply@anthropic.com>
---
 release/src-rt/Makefile     | 8 ++++----
 release/src-rt/version.conf | 2 +-
 2 files changed, 5 insertions(+), 5 deletions(-)
 mode change 100755 => 100644 release/src-rt/Makefile

diff --git a/release/src-rt/Makefile b/release/src-rt/Makefile
old mode 100755
new mode 100644
index 1ac0b6d2b3..d12f591575
--- a/release/src-rt/Makefile
+++ b/release/src-rt/Makefile
@@ -296,11 +296,11 @@ export CONFIG_LINUX26=y
 	# its multi-arch in 94908, specify ARCH in kbuild result bad
 export IFADDRS_LINKS=$(SRCBASE)/router/libusbmuxd-2.0.2/common/ifaddrs.c $(SRCBASE)/router/minidlna/ifaddrs.c $(SRCBASE)/router/miniupnpd/ifaddrs.c $(SRCBASE)/router/wsdd2/ifaddrs.c
 endif
-# REAPER custom build: default the firmware version/image suffix to -reaper
+# REAPER custom build: brand is carried by EXTENDNO=reaper (version.conf), so the
+# version/image name reads ..._102.8_reaper with no extra suffix. BUILDREV defaults to
+# empty (and stays empty through exported sub-makes, avoiding the export-recursion flip).
 ifeq ($(BUILDREV),)
-export BUILDREV := -reaper
-else
-export BUILDREV := -g$(shell git log --pretty=format:'%h' -n 1)
+export BUILDREV :=
 endif
 #-include .config
 #
diff --git a/release/src-rt/version.conf b/release/src-rt/version.conf
index 7a1dfa1d79..12106b52b2 100644
--- a/release/src-rt/version.conf
+++ b/release/src-rt/version.conf
@@ -4,6 +4,6 @@ KERNEL_VER_AM=$(subst .,,$(KERNEL_VER))
 FS_VER_AM=$(subst .,,$(FS_VER))
 
 SERIALNO=102.8
-EXTENDNO=beta2
+EXTENDNO=reaper
 
 RCNO=0
-- 
2.25.1

