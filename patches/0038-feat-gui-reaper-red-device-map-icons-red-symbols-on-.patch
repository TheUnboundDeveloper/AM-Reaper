From eee156ab69746b674c7208ea169cd486dbb3830e Mon Sep 17 00:00:00 2001
From: reaper <theunbounddeveloper@outlook.com>
Date: Tue, 30 Jun 2026 17:05:24 -0400
Subject: [PATCH] feat(gui): reaper red device-map icons (red symbols on black
 tiles)

Append the reaper theme override to the shipped classic-UI client/device icon
CSS so network-map + client-list device-type and vendor symbols render
reaper-red (#E10600) on black tiles. Mask-based icons (i.type*/vendor-icon)
recolored via background-color; .clientIcon* tiles set black. No base64 art
changed. BE96U ships classic UI (RTCONFIG_UI4 not set) so the base
device-map.css + clientlist.css are the files that ship.

Mirrors AM-Reaper patch 0026 (developed on the stale /home/builder
clone); this is the same change on the authoritative /home/reaper build tree.

Co-Authored-By: Claude Opus 4.8 (1M context) <noreply@anthropic.com>
---
 .../src/router/www/device-map/clientlist.css   | 17 +++++++++++++++++
 .../src/router/www/device-map/device-map.css   | 18 +++++++++++++++++-
 2 files changed, 34 insertions(+), 1 deletion(-)

diff --git a/release/src/router/www/device-map/clientlist.css b/release/src/router/www/device-map/clientlist.css
index 0c2286fc38..3978025807 100644
--- a/release/src/router/www/device-map/clientlist.css
+++ b/release/src/router/www/device-map/clientlist.css
@@ -1182,3 +1182,20 @@ html::-webkit-scrollbar-track:hover {
 
 }
 
+
+/* ===== REAPER THEME: red device symbols on black tiles ===== */
+/* Device-type + vendor mask icons painted reaper-red (overrides skin default fill). */
+i[class^='type'], i[class*=' type'],
+i[class^='vendor-icon'], i[class*=' vendor-icon']{
+	background-color: #E10600 !important;
+}
+/* Client icon tiles: black background with a dark-red edge. */
+.clientIcon, .clientIcon_clicked,
+.clientIcon_no_hover, .vendorIcon_no_hover{
+	background-color: #000000 !important;
+	box-shadow: 0px 0px 0px 1px #330000 !important;
+}
+.clientIcon:hover, .clientIcon.clicked{
+	background-color: #1A0000 !important;
+}
+/* ===== END REAPER THEME ===== */
diff --git a/release/src/router/www/device-map/device-map.css b/release/src/router/www/device-map/device-map.css
index bf42e1a00a..fd4eece85b 100644
--- a/release/src/router/www/device-map/device-map.css
+++ b/release/src/router/www/device-map/device-map.css
@@ -1091,4 +1091,20 @@ i.vendor-icon.d-link{
 }
 .hintColor{
 	color: #FFCC00;
-}
\ No newline at end of file
