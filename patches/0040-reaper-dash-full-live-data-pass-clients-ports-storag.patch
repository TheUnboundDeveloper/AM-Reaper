+<script>
+/* ---- real values injected server-side via SSI ---- */
+var SSI = {
+  model:    '<% nvram_get("productid"); %>',
+  firmver:  '<% nvram_get("firmver"); %>',
+  buildno:  '<% nvram_get("buildno"); %>',
+  extendno: '<% nvram_get("extendno"); %>',
+  wanip:    '<% nvram_get("wan0_ipaddr"); %>',
+  gw:       '<% nvram_get("wan0_gateway"); %>',
+  dns:      '<% nvram_get("wan0_dns"); %>',
+  wan_state:'<% nvram_get("wan0_state_t"); %>',
+  ddns_en:  '<% nvram_get("ddns_enable_x"); %>',
+  ddns_host:'<% nvram_get("ddns_hostname_x"); %>',
+  fw4:      '<% nvram_get("fw_enable_x"); %>',
+  fw6:      '<% nvram_get("ipv6_fw_enable"); %>',
+  upnp:     '<% nvram_get("upnp_enable"); %>',
+  wps:      '<% nvram_get("wps_enable"); %>',
+  telnet:   '<% nvram_get("telnetd_enable"); %>',
+  ssh:      '<% nvram_get("sshd_enable"); %>',
+  dos:      '<% nvram_get("fw_dos_x"); %>',
+  http_en:  '<% nvram_get("http_enable"); %>',
+  wan_admin:'<% nvram_get("misc_http_x"); %>',
+  cloud:    '<% nvram_get("enable_cloudsync"); %>',
+  jffs:     '<% nvram_get("jffs2_on"); %>',
+  jffs_sc:  '<% nvram_get("jffs2_scripts"); %>',
+  mlo:      '<% nvram_get("mld_enable"); %>',
+  norebind: '<% nvram_get("dns_norebind"); %>',
+  dnssec:   '<% nvram_get("dnssec_enable"); %>',
+  usb1:     '<% nvram_get("usb_path1"); %>',
+  usb1_spd: '<% nvram_get("usb_path1_speed"); %>',
+  usb2:     '<% nvram_get("usb_path2"); %>',
+  usb2_spd: '<% nvram_get("usb_path2_speed"); %>'
+};
+/* per-radio config (BE96U: wl0=2.4 GHz, wl1=5 GHz, wl2=6 GHz — labelled via nband) */
+var WL = [
+  {nband:'<% nvram_get("wl0_nband"); %>', radio:'<% nvram_get("wl0_radio"); %>', auth:'<% nvram_get("wl0_auth_mode_x"); %>', ssid:decodeURIComponent('<% nvram_char_to_ascii("WLANConfig11b", "wl0_ssid"); %>')},
+  {nband:'<% nvram_get("wl1_nband"); %>', radio:'<% nvram_get("wl1_radio"); %>', auth:'<% nvram_get("wl1_auth_mode_x"); %>', ssid:decodeURIComponent('<% nvram_char_to_ascii("WLANConfig11b", "wl1_ssid"); %>')},
+  {nband:'<% nvram_get("wl2_nband"); %>', radio:'<% nvram_get("wl2_radio"); %>', auth:'<% nvram_get("wl2_auth_mode_x"); %>', ssid:decodeURIComponent('<% nvram_char_to_ascii("WLANConfig11b", "wl2_ssid"); %>')}
+];
+var USBINFO = <% get_usb_info(); %>;
+var UPSTR = "<% sysuptime(); %>";
+function $id(id){return document.getElementById(id);}
+function setTxt(id,v){var el=$id(id); if(el&&v) el.textContent=v;}
+function cap(s){return s? s.charAt(0).toUpperCase()+s.slice(1):s;}
+(function(){
+  try{
+    var fwstr = (SSI.firmver||'').replace(/\./g,'') + '.' + (SSI.buildno||'');
+    if(SSI.extendno && SSI.extendno!=='0') fwstr += '_'+cap(SSI.extendno);
+    if(fwstr.length>2) setTxt('p_fw', fwstr);
+    /* WAN state from wan0_state_t (2 = connected), guarded against stale/0.0.0.0 IP */
+    var wanUp = (SSI.wan_state==='2') && !!SSI.wanip && SSI.wanip!=='0.0.0.0';
+    setTxt('p_wan', wanUp?'Connected':'Disconnected');
+    var istate=$id('i_state');
+    if(istate){ istate.textContent = wanUp?'Connected':'Disconnected'; if(!wanUp) istate.style.color='var(--danger)'; }
+    if(!wanUp){
+      var idot=$id('i_dot'), pdot=$id('p_wan_dot');
+      if(idot){ idot.style.background='var(--danger)'; idot.style.boxShadow='none'; }
+      if(pdot){ pdot.style.background='var(--danger)'; pdot.style.boxShadow='none'; }
+    }
+    if(wanUp) setTxt('i_wanip', SSI.wanip);
+    if(SSI.gw && SSI.gw!=='0.0.0.0')  setTxt('i_gw', SSI.gw);
+    if(SSI.dns) setTxt('i_dns', String(SSI.dns).split(' ')[0]);
+    var dd = (SSI.ddns_en==='1' && SSI.ddns_host) ? SSI.ddns_host : 'Not Active';
+    var de = $id('i_ddns'); if(de){ de.textContent = dd; de.style.color = (dd==='Not Active')?'var(--steel)':'var(--bone)'; }
+    if(SSI.model) document.title = SSI.model + ' — REAPER';
+
+    /* firewall: IPv4 fw_enable_x + IPv6 ipv6_fw_enable */
+    var f4=(SSI.fw4==='1'), f6=(SSI.fw6==='1'), fp=[];
+    if(f4) fp.push('IPv4'); if(f6) fp.push('IPv6');
+    var fsub=$id('s_fw_sub'); if(fsub) fsub.textContent = fp.length ? ('Inbound blocked · '+fp.join(' + ')+' firewall on') : 'Firewall disabled';
+    var ftag=$id('s_fw_tag'); if(ftag){ ftag.textContent = f4?'Active':'Off'; ftag.className='tag '+(f4?'ok':'warn'); }
+
+    /* posture toggles from nvram (UPnP/WPS/Telnet enabled = weaker; DoS on = stronger) */
+    function setTag(id,txt,cls){ var t=$id(id); if(t){ t.textContent=txt; t.className='tag '+cls; } }
+    var upnpOn=(SSI.upnp==='1'), wpsOn=(SSI.wps==='1'), telOn=(SSI.telnet==='1'), dosOn=(SSI.dos==='1');
+    setTag('s_upnp_tag', upnpOn?'Enabled':'Disabled', upnpOn?'warn':'ok'); setTxt('s_upnp_sub', upnpOn?'Auto port-mapping on':'No auto port-mapping');
+    setTag('s_wps_tag', wpsOn?'Enabled':'Disabled', wpsOn?'warn':'ok'); setTxt('s_wps_sub', wpsOn?'Push-button pairing on':'Pairing disabled');
+    if(SSI.telnet===''){ setTag('s_telnet_tag','Removed','ok'); setTxt('s_telnet_sub','Not present in this firmware'); }
+    else { setTag('s_telnet_tag', telOn?'Enabled':'Disabled', telOn?'warn':'ok'); setTxt('s_telnet_sub', telOn?'Cleartext shell open':'Cleartext shell off'); }
+    setTag('s_dos_tag', dosOn?'On':'Off', dosOn?'ok':'warn'); setTxt('s_dos_sub', dosOn?'SYN-flood / port-scan guard':'Not enabled');
+    var sshv=String(SSI.ssh||'0');
+    if(sshv==='0'){ setTag('s_ssh_tag','Disabled','ok'); setTxt('s_ssh_sub','SSH server off'); }
+    else if(sshv==='2'){ setTag('s_ssh_tag','LAN only','ok'); setTxt('s_ssh_sub','LAN-only access'); }
+    else { setTag('s_ssh_tag','WAN open','warn'); setTxt('s_ssh_sub','Reachable from WAN'); }
+
+    /* Wi-Fi encryption — per enabled radio from wlX_auth_mode_x; worst state wins the tag */
+    function encInfo(a){
+      switch(a){
+        case 'psk2':     return {t:'WPA2',c:'ok'};
+        case 'sae':      return {t:'WPA3',c:'ok'};
+        case 'psk2sae':  return {t:'WPA2/WPA3',c:'ok'};
+        case 'pskpsk2':  return {t:'WPA/WPA2',c:'warn'};
+        case 'psk':      return {t:'WPA',c:'warn'};
+        case 'owe':      return {t:'Enhanced Open',c:'warn'};
+        case 'open':     return {t:'OPEN',c:'danger'};
+        case 'wpa2': case 'wpa3': case 'wpawpa2': case 'wpa2wpa3': case 'suite-b': return {t:'Enterprise',c:'ok'};
+        default:         return {t:a||'?',c:'warn'};
+      }
+    }
+    function bandName(nb){ return nb==='2'?'2.4G':(nb==='4'?'6G':'5G'); }
+    var encParts=[], encWorst='ok', encRank={ok:0,warn:1,danger:2};
+    for(var wi=0; wi<WL.length; wi++){
+      var wcfg=WL[wi]; if(!wcfg.nband) continue;
+      if(wcfg.radio!=='1'){ encParts.push(bandName(wcfg.nband)+' off'); continue; }
+      var einf=encInfo(wcfg.auth); encParts.push(bandName(wcfg.nband)+' '+einf.t);
+      if(encRank[einf.c]>encRank[encWorst]) encWorst=einf.c;
+    }
+    if(encParts.length){
+      setTxt('s_wifi_sub', encParts.join(' · '));
+      setTag('s_wifi_tag', encWorst==='ok'?'Secure':(encWorst==='warn'?'Mixed':'Open'), encWorst);
+    }
+
+    /* remote / cloud access: misc_http_x (WAN admin) + enable_cloudsync */
+    var wanAdmin=(SSI.wan_admin==='1'), cloudOn=(SSI.cloud==='1');
+    setTxt('s_rc_sub', (wanAdmin?'WAN admin ENABLED':'WAN admin off')+' · '+(cloudOn?'cloud sync on':'no cloud sync'));
+    setTag('s_rc_tag', (wanAdmin||cloudOn)?'Exposed':'Disabled', (wanAdmin||cloudOn)?'warn':'ok');
+
+    /* admin login: http_enable (0 http / 1 https / 2 both) + WAN reachability */
+    var hev=String(SSI.http_en), proto = hev==='1'?'HTTPS only':(hev==='2'?'HTTP + HTTPS':'HTTP only');
+    setTxt('s_adm_sub', proto+' · '+(wanAdmin?'WAN reachable':'LAN-only'));
+    if(wanAdmin) setTag('s_adm_tag','WAN open','warn');
+    else if(hev!=='1') setTag('s_adm_tag','HTTP on','warn');
+    else setTag('s_adm_tag','Locked','ok');
+
+    /* JFFS: jffs2_on + jffs2_scripts */
+    var jOn=(SSI.jffs==='1'), jSc=(SSI.jffs_sc==='1');
+    setTxt('s_jffs_sub', jOn?('Mounted · custom scripts '+(jSc?'on':'off')):'Not mounted');
+    setTag('s_jffs_tag', jOn?'Mounted':'Off', jOn?'ok':'warn');
+
+    /* MLO: mld_enable */
+    var mloOn=(SSI.mlo==='1');
+    setTxt('s_mlo_sub', mloOn?'Wi-Fi 7 multi-link active':'Multi-link off');
+    setTag('s_mlo_tag', mloOn?'Enabled':'Disabled','ok');
+
+    /* DNS rebind protection + DNSSEC */
+    var nrOn=(SSI.norebind==='1'), dsOn=(SSI.dnssec==='1');
+    setTxt('s_dnsr_sub', (nrOn?'Rebind block on':'Rebind block off')+' · '+(dsOn?'DNSSEC validate':'DNSSEC off'));
+    setTag('s_dnsr_tag', (nrOn&&dsOn)?'On':((nrOn||dsOn)?'Partial':'Off'), (nrOn&&dsOn)?'ok':'warn');
+
+    /* uptime from sysuptime (/proc/uptime) — offset-proof, ticks locally */
+    var UPS = String(UPSTR).replace(/\s*since boot\s*$/i,'').trim();
+    function relSec(s){ var b=0; var dm=s.match(/(\d+)\s*d/i); if(dm)b+=(+dm[1])*86400; var cm=s.match(/(\d+):(\d{2})(?::(\d{2}))?/); if(cm){ b+=(+cm[1])*3600+(+cm[2])*60+(+(cm[3]||0)); return b; } function g(re){var m=s.match(re);return m?+m[1]:0;} return b+g(/(\d+)\s*h/i)*3600+g(/(\d+)\s*m(?!o)/i)*60+g(/(\d+)\s*s/i); }
+    var up0=relSec(UPS), t0=Date.now();
+    function p2(n){return(n<10?'0':'')+n;}
+    function upTick(){ var s=up0+Math.floor((Date.now()-t0)/1000); var d=Math.floor(s/86400),h=Math.floor(s%86400/3600),m=Math.floor(s%3600/60); var el=$id('p_uptime'); if(el)el.textContent=d+'d '+p2(h)+':'+p2(m); }
+    if(up0>0){ upTick(); setInterval(upTick,20000); } else if(UPS){ setTxt('p_uptime', UPS); }
+  }catch(e){}
+})();
