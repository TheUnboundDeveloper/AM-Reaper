+/* ---- live CPU / RAM via /cpu_ram_status.asp ---- */
+function setDial(id,pct,unit){
+  var d=$id(id); if(!d) return;
+  pct=Math.max(0,Math.min(100,Math.round(pct)));
+  d.style.setProperty('--v', pct);
+  var t=d.querySelector('.txt'); if(t) t.innerHTML = pct+'%<small>'+unit+'</small>';
+}
+var _prevCpu=null, _prevCores=null;
+function pollSys(){
+  var x=new XMLHttpRequest();
+  x.open('GET','/cpu_ram_status.asp?_='+(new Date()).getTime(),true);
+  x.onreadystatechange=function(){
+    if(x.readyState!==4||x.status!==200) return;
+    try{
+      var cpuInfo={}, memInfo={};
+      eval(x.responseText);              /* defines cpuInfo, memInfo */
+      var tot=0,use=0,per=[];
+      for(var k in cpuInfo){ var c=cpuInfo[k]; if(c&&c.total!=null){ tot+=Number(c.total); use+=Number(c.usage); per.push({t:Number(c.total),u:Number(c.usage)}); } }
+      if(tot>0){
+        var pct=0;
+        if(_prevCpu){ var dt=tot-_prevCpu.t, du=use-_prevCpu.u; pct = dt>0? du/dt*100 : 0; }
+        _prevCpu={t:tot,u:use};
+        setDial('m_cpu', pct, 'load');
+        var bars=$id('m_cores');
+        if(bars && _prevCores && _prevCores.length===per.length){
+          var bel=bars.getElementsByTagName('i');
+          for(var ci=0; ci<per.length && ci<bel.length; ci++){
+            var cdt=per[ci].t-_prevCores[ci].t, cdu=per[ci].u-_prevCores[ci].u;
+            var cp = cdt>0? Math.max(0,Math.min(100,cdu/cdt*100)) : 0;
+            bel[ci].style.background='rgba(225,6,0,'+(0.10+0.90*cp/100).toFixed(2)+')';
+          }
+        }
+        _prevCores=per;
+      }
+      if(memInfo && memInfo.total){
+        var mt=Number(memInfo.total);
+        var mu=Number(memInfo.simple_used!=null?memInfo.simple_used:(mt-Number(memInfo.simple_free!=null?memInfo.simple_free:memInfo.free)));
+        setDial('m_ram', mu/mt*100, 'used');
+        var elr=$id('m_ram_sub'); if(elr) elr.textContent=Math.round(mu/1024)+' / '+Math.round(mt/1024)+' MB';
+      }
+    }catch(e){}
+  };
+  x.send();
+}
+pollSys(); setInterval(pollSys, 1000);
