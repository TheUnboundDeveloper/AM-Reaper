From d91dac247e1251cb27ed4a0cbbf7fdd87c4a420b Mon Sep 17 00:00:00 2001
From: reaper <theunbounddeveloper@outlook.com>
Date: Thu, 2 Jul 2026 10:09:53 -0400
Subject: [PATCH] =?UTF-8?q?reaper=20dash:=20full=20live-data=20pass=20?=
 =?UTF-8?q?=E2=80=94=20clients/ports/storage/posture=20wired,=20no=20sampl?=
 =?UTF-8?q?e=20data?=
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

get_clientlist (10s) for clients+bands+device list; ajax_ethernet_ports (5s) for link states; get_usb_info SSI for storage; wlX radio/ssid/auth tiles + posture rows (misc_http_x, http_enable, enable_cloudsync, jffs2, mld_enable, dns_norebind, dnssec); wan0_state_t connected check; telnet row = removed-from-firmware; per-core CPU bars; all baked-in sample values replaced with placeholders.
---
 release/src/router/www/Main_ReaperDash.asp | 751 +++++++++++++++++++++
 1 file changed, 751 insertions(+)
 create mode 100644 release/src/router/www/Main_ReaperDash.asp

diff --git a/release/src/router/www/Main_ReaperDash.asp b/release/src/router/www/Main_ReaperDash.asp
new file mode 100644
index 0000000000..f4c173fa79
--- /dev/null
+++ b/release/src/router/www/Main_ReaperDash.asp
@@ -0,0 +1,751 @@
+<!DOCTYPE html>
+<html lang="en">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width, initial-scale=1">
+<title>REAPER — Dashboard</title>
+<style>
+/* self-hosted fonts (offline; no CDN) */
+@font-face{font-family:'Rajdhani';font-weight:500;font-display:swap;src:url('/fonts/rajdhani-500.woff2') format('woff2')}
+@font-face{font-family:'Rajdhani';font-weight:600;font-display:swap;src:url('/fonts/rajdhani-600.woff2') format('woff2')}
+@font-face{font-family:'Rajdhani';font-weight:700;font-display:swap;src:url('/fonts/rajdhani-700.woff2') format('woff2')}
+@font-face{font-family:'Inter';font-weight:400;font-display:swap;src:url('/fonts/inter-400.woff2') format('woff2')}
+@font-face{font-family:'Inter';font-weight:500;font-display:swap;src:url('/fonts/inter-500.woff2') format('woff2')}
+@font-face{font-family:'Inter';font-weight:600;font-display:swap;src:url('/fonts/inter-600.woff2') format('woff2')}
+:root{
+  --bg:#08080a; --panel:#0f0f12; --panel-2:#141418;
+  --line:rgba(225,6,0,.16); --line-soft:rgba(255,255,255,.06);
+  --crimson:#E10600; --crimson-deep:#B3000C; --crimson-dim:#7A0C0C;
+  --bone:#ECE7DB; --bone-dim:#B7B1A4; --steel:#71767b;
+  --jade:#4FB286; --amber:#E0A93B; --danger:#FF3B30;
+  --hdr:'Rajdhani','Oswald',system-ui,sans-serif;
+  --body:'Inter',system-ui,-apple-system,Segoe UI,sans-serif;
+}
+*{box-sizing:border-box}
+html,body{margin:0;height:100%}
+body{font-family:var(--body);color:var(--bone-dim);background:var(--bg);
+  background-image:
+    radial-gradient(1200px 500px at 18% -10%,rgba(225,6,0,.10),transparent 60%),
+    radial-gradient(900px 600px at 120% 120%,rgba(225,6,0,.06),transparent 55%),
+    radial-gradient(100% 100% at 50% 40%,transparent 55%,rgba(0,0,0,.55) 100%);
+  -webkit-font-smoothing:antialiased}
+body::after{content:"";position:fixed;inset:0;pointer-events:none;opacity:.035;z-index:9;
+  background-image:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='140' height='140'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='2'/></filter><rect width='100%25' height='100%25' filter='url(%23n)'/></svg>")}
+h1,h2,h3,h4,.hdr{font-family:var(--hdr);letter-spacing:.04em;color:var(--bone);margin:0}
+.mono{font-variant-numeric:tabular-nums}
+/* page scrollbar: black track, crimson thumb */
+html{scrollbar-width:thin;scrollbar-color:var(--crimson) #000}
+::-webkit-scrollbar{width:12px;height:12px}
+::-webkit-scrollbar-track{background:#000}
+::-webkit-scrollbar-thumb{background:var(--crimson);border-radius:8px;border:2px solid #000}
+::-webkit-scrollbar-thumb:hover{background:var(--crimson-deep)}
+/* clients filter + scrollable device list */
+.cl-filter{margin-top:14px;width:100%;background:#000;border:1px solid var(--line-soft);color:var(--bone);font-family:var(--hdr);font-weight:600;font-size:13px;letter-spacing:.04em;padding:9px 10px;border-radius:8px;outline:none;cursor:pointer}
+.cl-filter:focus{border-color:var(--line)}
+.cl-list{margin-top:10px;max-height:210px;overflow-y:auto;display:flex;flex-direction:column;gap:6px;padding-right:4px}
+.cl-item{border:1px solid var(--line-soft);border-radius:8px;padding:8px 10px;background:rgba(255,255,255,.015)}
+.cl-item .cn{color:var(--bone);font-size:13px;font-weight:500}
+.cl-item .cd{color:var(--steel);font-size:11px;margin-top:3px}
+.cl-item .cd .mono{color:var(--bone-dim)}
+.eyebrow{font-family:var(--hdr);text-transform:uppercase;letter-spacing:.22em;font-size:11px;color:var(--steel)}
+
+/* ---------- shell / always-expanded rail ---------- */
+.app{display:grid;grid-template-columns:250px 1fr;min-height:100vh}
+.rail{background:linear-gradient(180deg,#0c0c0f,#08080a);border-right:1px solid var(--line-soft);
+  display:flex;flex-direction:column;padding:14px 12px;gap:2px}
+.wordmark{font-family:var(--hdr);font-weight:700;font-size:21px;letter-spacing:.02em;line-height:1.15;padding:4px 6px 12px;text-align:center}
+.wordmark .a{color:var(--bone)} .wordmark .m{color:var(--bone-dim)} .wordmark .r{color:var(--crimson)} .wordmark .d{color:var(--crimson)}
+.railsearch{margin:2px 4px 8px}
+.railsearch input{width:100%;background:#000;border:1px solid var(--line-soft);border-radius:8px;color:var(--bone);
+  padding:9px 11px;font-family:var(--body);font-size:12px;outline:none}
+.railsearch input:focus{border-color:var(--line)}
+.railsearch input:disabled{opacity:.4;cursor:not-allowed}
+.grp{font-family:var(--hdr);text-transform:uppercase;letter-spacing:.2em;font-size:10px;color:var(--steel);padding:12px 10px 4px}
+.nav{display:flex;flex-direction:column;gap:2px;width:100%}
+.nav a{display:flex;align-items:center;gap:12px;height:40px;border-radius:9px;color:var(--steel);
+  text-decoration:none;justify-content:flex-start;padding:0 12px;position:relative;transition:.15s}
+.nav a .ni{width:20px;flex:0 0 20px;display:grid;place-items:center}
+.nav a svg{width:19px;height:19px;stroke:currentColor;fill:none;stroke-width:1.7}
+.nav a .nl{font-family:var(--hdr);font-weight:600;letter-spacing:.03em;font-size:14px;white-space:nowrap}
+.nav a:hover{color:var(--bone);background:var(--panel)}
+.nav a.on{color:var(--crimson);background:linear-gradient(90deg,rgba(225,6,0,.14),transparent)}
+.nav a.on::before{content:"";position:absolute;left:0;top:8px;bottom:8px;width:2px;background:var(--crimson);border-radius:2px}
+
+/* ---------- topbar ---------- */
+.top{display:flex;align-items:center;gap:18px;padding:12px 22px;flex-wrap:wrap;
+  border-bottom:1px solid var(--line-soft);box-shadow:0 1px 0 rgba(225,6,0,.12);
+  background:#040405;position:sticky;top:0;z-index:10}
+.brand{display:flex;align-items:center;flex:0 0 auto;text-decoration:none}
+.brand img{height:46px;width:auto;display:block}
+.pills{display:flex;gap:10px;flex-wrap:wrap}
+.pill{display:flex;align-items:center;gap:8px;padding:7px 12px;border:1px solid var(--line-soft);border-radius:8px;background:var(--panel);font-size:12px}
+.pill .k{color:var(--steel);text-transform:uppercase;letter-spacing:.12em;font-size:10px}
+.pill .v{color:var(--bone);font-family:var(--hdr);font-weight:600;letter-spacing:.03em}
+.dot{width:8px;height:8px;border-radius:50%;background:var(--jade);box-shadow:0 0 0 3px rgba(79,178,134,.15)}
+.spacer{flex:1}
+.btn{font-family:var(--hdr);font-weight:600;letter-spacing:.08em;text-transform:uppercase;font-size:12px;
+  padding:9px 16px;border-radius:8px;border:1px solid var(--line-soft);background:var(--panel);color:var(--bone-dim);cursor:pointer;transition:.15s}
+.btn:hover{color:var(--bone);border-color:var(--line)}
+.btn.crit{color:#fff;border-color:var(--crimson-dim);background:linear-gradient(180deg,var(--crimson),var(--crimson-deep))}
+.btn.crit:hover{filter:brightness(1.08)}
+
+/* ---------- grid / cards ---------- */
+.wrap{padding:22px}
+.grid{display:grid;gap:16px;grid-template-columns:repeat(12,1fr)}
+.card{background:linear-gradient(180deg,var(--panel-2),var(--panel));border:1px solid var(--line-soft);
+  border-radius:14px;padding:18px;position:relative;overflow:hidden}
+.card::before{content:"";position:absolute;left:0;top:0;height:2px;width:100%;background:linear-gradient(90deg,var(--crimson),transparent 40%)}
+.card .head{display:flex;align-items:center;justify-content:space-between;margin-bottom:14px;gap:10px}
+.card .head h3{font-size:15px;text-transform:uppercase;letter-spacing:.14em;font-weight:600}
+.link{font-family:var(--hdr);font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:var(--crimson);text-decoration:none;border:1px solid var(--line);padding:5px 10px;border-radius:7px;white-space:nowrap}
+.link:hover{background:rgba(225,6,0,.10)}
+.col3{grid-column:span 3}.col4{grid-column:span 4}.col5{grid-column:span 5}
+.col6{grid-column:span 6}.col7{grid-column:span 7}.col8{grid-column:span 8}.col12{grid-column:span 12}
+
+/* hero internet */
+.hero{display:grid;grid-template-columns:1.1fr 1fr;gap:20px;align-items:center}
+.big{font-family:var(--hdr);font-weight:700;color:var(--bone);line-height:1}
+.wanip{font-size:30px;letter-spacing:.02em}
+.state{display:flex;align-items:center;gap:10px;margin-bottom:6px}
+.state .lbl{font-family:var(--hdr);text-transform:uppercase;letter-spacing:.16em;color:var(--jade);font-weight:600;font-size:13px}
+.meta{display:flex;gap:26px;margin-top:16px;flex-wrap:wrap}
+.meta .m .k{font-size:10px;letter-spacing:.16em;text-transform:uppercase;color:var(--steel)}
+.meta .m .v{font-family:var(--hdr);font-size:16px;color:var(--bone);margin-top:3px}
+.speeds{display:flex;gap:22px}
+.spd{flex:1}
+.spd .k{font-size:10px;letter-spacing:.18em;text-transform:uppercase;color:var(--steel);display:flex;align-items:center;gap:6px}
+.spd .v{font-family:var(--hdr);font-weight:700;font-size:26px;color:var(--bone);margin-top:2px}
+.spd .v small{font-size:12px;color:var(--bone-dim);font-weight:500;letter-spacing:.05em}
+.arrow{width:0;height:0}
+.dl .arrow{border-left:5px solid transparent;border-right:5px solid transparent;border-top:7px solid var(--jade)}
+.ul .arrow{border-left:5px solid transparent;border-right:5px solid transparent;border-bottom:7px solid var(--crimson)}
+.spark{margin-top:12px}
+
+/* meters */
+.meters{display:flex;gap:16px;justify-content:space-between;flex-wrap:wrap}
+.meter{text-align:center;flex:1;min-width:90px}
+.dial{--v:0;--c:var(--crimson);width:92px;height:92px;border-radius:50%;margin:0 auto;
+  background:conic-gradient(var(--c) calc(var(--v)*1%),rgba(255,255,255,.06) 0);display:grid;place-items:center;position:relative}
+.dial::after{content:"";position:absolute;inset:9px;border-radius:50%;background:var(--panel)}
+.dial .txt{position:relative;z-index:1;font-family:var(--hdr);font-weight:700;font-size:20px;color:var(--bone)}
+.dial .txt small{display:block;font-size:9px;letter-spacing:.14em;color:var(--steel);text-transform:uppercase;font-weight:500}
+.meter .cap{margin-top:9px;font-family:var(--hdr);text-transform:uppercase;letter-spacing:.14em;font-size:12px;color:var(--bone-dim)}
+.sub{font-size:10px;color:var(--steel)}
+.cores{display:flex;gap:5px;justify-content:center;margin-top:8px}
+.cores i{width:8px;height:22px;border-radius:2px;background:rgba(255,255,255,.08);display:block}
+
+/* security rows */
+.rows{display:flex;flex-direction:column;gap:10px}
+.rows.two{display:grid;grid-template-columns:1fr 1fr;gap:10px}
+.srow{display:flex;align-items:center;justify-content:space-between;padding:11px 12px;border:1px solid var(--line-soft);border-radius:10px;background:rgba(255,255,255,.015);gap:10px}
+.srow .l{display:flex;align-items:center;gap:11px;min-width:0}
+.ico{width:30px;height:30px;border-radius:8px;display:grid;place-items:center;background:#000;border:1px solid var(--line);flex:0 0 30px}
+.ico svg{width:16px;height:16px;stroke:var(--crimson);fill:none;stroke-width:1.7}
+.srow .name{color:var(--bone);font-weight:500;font-size:13px}
+.srow .sub2{color:var(--steel);font-size:11px;margin-top:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
+.tag{font-family:var(--hdr);font-size:11px;letter-spacing:.08em;text-transform:uppercase;padding:5px 10px;border-radius:6px;font-weight:600;white-space:nowrap}
+.tag.ok{color:var(--jade);border:1px solid rgba(79,178,134,.35);background:rgba(79,178,134,.08)}
+.tag.warn{color:var(--amber);border:1px solid rgba(224,169,59,.35);background:rgba(224,169,59,.08)}
+.tag.danger{color:#fff;border:1px solid var(--danger);background:rgba(255,59,48,.18)}
+.posture .score{font-family:var(--hdr);font-weight:700;font-size:13px;letter-spacing:.12em;padding:5px 12px;border-radius:7px;text-transform:uppercase}
+.posture .hardened{color:var(--jade);border:1px solid rgba(79,178,134,.45);background:rgba(79,178,134,.10)}
+.legend{margin-top:14px;padding-top:14px;border-top:1px solid var(--line-soft);display:flex;flex-direction:row;flex-wrap:wrap;gap:8px 22px;font-size:11px;color:var(--steel)}
+.legend b{font-family:var(--hdr);letter-spacing:.1em}
+
+/* clients */
+.cbig{display:flex;align-items:baseline;gap:10px}
+.cbig .n{font-family:var(--hdr);font-weight:700;font-size:44px;color:var(--bone);line-height:1}
+.cbig .u{font-size:11px;letter-spacing:.16em;text-transform:uppercase;color:var(--steel)}
+.bands{margin-top:14px;display:flex;flex-direction:column;gap:9px}
+.band{display:grid;grid-template-columns:56px 1fr 28px;align-items:center;gap:10px;font-size:11px}
+.band .bl{font-family:var(--hdr);letter-spacing:.08em;color:var(--bone-dim)}
+.bar{height:7px;border-radius:4px;background:rgba(255,255,255,.06);overflow:hidden}
+.bar i{display:block;height:100%;background:linear-gradient(90deg,var(--crimson),var(--crimson-deep))}
+.band .bn{text-align:right;font-family:var(--hdr);color:var(--bone);font-weight:600}
+
+/* storage */
+.stg{display:flex;align-items:center;gap:16px}
+.stg .ring{--v:0;width:76px;height:76px;border-radius:50%;position:relative;flex:0 0 76px;
+  background:conic-gradient(var(--crimson) calc(var(--v)*1%),rgba(255,255,255,.06) 0);display:grid;place-items:center}
+.stg .ring::after{content:"";position:absolute;width:58px;height:58px;border-radius:50%;background:var(--panel)}
+.stg .ring b{position:relative;z-index:1;font-family:var(--hdr);color:var(--bone);font-size:15px}
+.stg .d .t{color:var(--bone);font-weight:600;font-size:14px}
+.stg .d .s{color:var(--steel);font-size:11px;margin-top:3px}
+
+/* connections */
+.ports{display:flex;gap:10px;flex-wrap:wrap}
+.port{flex:1;min-width:104px;border:1px solid var(--line-soft);border-radius:10px;padding:12px;background:rgba(255,255,255,.015);text-align:center}
+.port .pn{font-family:var(--hdr);font-weight:700;color:var(--bone);font-size:15px}
+.port .ps{font-size:10px;letter-spacing:.12em;text-transform:uppercase;color:var(--steel);margin-top:5px}
+.port .led{width:9px;height:9px;border-radius:50%;margin:8px auto 0;background:rgba(255,255,255,.12)}
+.port.up .led{background:var(--jade);box-shadow:0 0 0 3px rgba(79,178,134,.15)}
+.port.up{border-color:var(--line)}
+.port.wan .pn{color:var(--crimson)}
+.conngroup{display:flex;align-items:center;gap:6px;margin:4px 0 8px}
+.conngroup:not(:first-of-type){margin-top:16px}
+.cglabel{font-family:var(--hdr);text-transform:uppercase;letter-spacing:.2em;font-size:10px;color:var(--steel)}
+.cgline{flex:1;height:1px;background:var(--line-soft)}
+
+/* ---------- responsive ---------- */
+@media (max-width:1180px){
+  .col8{grid-column:span 12}.col7{grid-column:span 12}
+  .col5{grid-column:span 7}.col4{grid-column:span 5}.col3{grid-column:span 4}
+}
+@media (max-width:900px){
+  .hero{grid-template-columns:1fr;gap:18px}
+  .col8,.col7,.col6,.col5,.col4,.col3{grid-column:span 12}
+  .rows.two{grid-template-columns:1fr}
+  .pills .pill:nth-child(n+3){display:none}
+}
+@media (max-width:680px){
+  .app{grid-template-columns:1fr}
+  .rail{position:sticky;top:0;height:auto;width:100%;flex-direction:row;align-items:center;
+    justify-content:flex-start;gap:4px;padding:8px 10px;overflow-x:auto;border-right:0;border-bottom:1px solid var(--line-soft)}
+  .wordmark{padding:0 10px 0 0;font-size:17px;white-space:nowrap;text-align:left}
+  .railsearch,.grp{display:none}
+  .nav{flex-direction:row;width:auto}
+  .nav a .nl{display:none}
+  .nav a{padding:0 10px}
+  .nav a.on::before{left:8px;right:8px;top:0;bottom:auto;width:auto;height:2px}
+  .top{gap:12px;padding:10px 14px}
+  .brand img{height:36px}
+  .pills{order:3;width:100%}
+  .pills .pill:nth-child(n+3){display:flex}
+  .spacer{display:none}
+  .wrap{padding:14px}
+  .wanip{font-size:24px}
+}
+@media (max-width:430px){
+  .ports .port{flex:1 1 calc(50% - 5px);min-width:0}
+  .cbig .n{font-size:36px}
+  .pills .pill{flex:1 1 calc(50% - 5px)}
+  .btn{flex:1 1 auto}
+}
+</style>
+</head>
+<body>
+<div class="app">
+
+  <!-- LEFT RAIL (always expanded; menu mirrors the current firmware) -->
+  <aside class="rail">
+    <div class="wordmark"><span class="a">ASUS</span> <span class="d">·</span> <span class="m">Merlin</span> <span class="d">·</span> <span class="r">Reaper</span></div>
+    <div class="railsearch"><input type="text" placeholder="Search — coming soon" disabled></div>
+
+    <div class="grp">General</div>
+    <nav class="nav">
+      <a class="on"><span class="ni"><svg viewBox="0 0 24 24"><path d="M3 12l9-8 9 8"/><path d="M5 10v10h14V10"/></svg></span><span class="nl">Network Map</span></a>
+      <a><span class="ni"><svg viewBox="0 0 24 24"><circle cx="6" cy="6" r="2.5"/><circle cx="18" cy="6" r="2.5"/><circle cx="12" cy="18" r="2.5"/><path d="M7.7 7.7l3 8M16.3 7.7l-3 8M8 6h8"/></svg></span><span class="nl">AiMesh</span></a>
+      <a><span class="ni"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c3 3 3 15 0 18M12 3c-3 3-3 15 0 18"/></svg></span><span class="nl">Network</span></a>
+      <a><span class="ni"><svg viewBox="0 0 24 24"><path d="M12 3l8 4v5c0 5-3.5 8-8 9-4.5-1-8-4-8-9V7z"/><path d="M9 12l2 2 4-4"/></svg></span><span class="nl">AiProtection</span></a>
+      <a><span class="ni"><svg viewBox="0 0 24 24"><circle cx="9" cy="8" r="2.5"/><circle cx="16" cy="9" r="2"/><path d="M4 19a5 5 0 0 1 10 0M13 19a4 4 0 0 1 7-3"/></svg></span><span class="nl">Parental Controls</span></a>
+      <a><span class="ni"><svg viewBox="0 0 24 24"><path d="M4 18v-5M9 18V7M14 18v-8M19 18v-12"/></svg></span><span class="nl">Adaptive QoS</span></a>
+      <a><span class="ni"><svg viewBox="0 0 24 24"><path d="M3 16l5-6 4 4 5-7 4 5"/></svg></span><span class="nl">Traffic Analyzer</span></a>
+      <a><span class="ni"><svg viewBox="0 0 24 24"><rect x="3" y="8" width="18" height="9" rx="4"/><path d="M8 12v-2M7 12h2M15.5 12h.01M18 13.5h.01"/></svg></span><span class="nl">Game</span></a>
+      <a><span class="ni"><svg viewBox="0 0 24 24"><path d="M7 8l-4 4 4 4M17 8l4 4-4 4M14 6l-4 12"/></svg></span><span class="nl">Open NAT</span></a>
+      <a><span class="ni"><svg viewBox="0 0 24 24"><rect x="4" y="5" width="16" height="14" rx="2"/><path d="M8 5v14"/></svg></span><span class="nl">USB Application</span></a>
+      <a><span class="ni"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 11v5M12 8h.01"/></svg></span><span class="nl">System Info</span></a>
+    </nav>
+
+    <div class="grp">Advanced Settings</div>
