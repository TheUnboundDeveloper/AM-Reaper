+<!DOCTYPE html>
+<html lang="en">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width, initial-scale=1">
+<title>REAPER &mdash; Settings</title>
+<script type="text/javascript" src="/require/require.min.js"></script>
+<style>
+/* REAPER settings shell: owns topbar + rail geometry; stock pages load
+   unmodified into the frame (all settings preserved); /reaper/reaper_content.css
+   inside each framed page hides the stock chrome and rethemes the content.
+   RULE: pure ASCII only - the www packaging minifier strips non-ASCII bytes. */
+@font-face{font-family:'Rajdhani';font-weight:500;font-display:swap;src:url('/fonts/rajdhani-500.woff2') format('woff2')}
+@font-face{font-family:'Rajdhani';font-weight:600;font-display:swap;src:url('/fonts/rajdhani-600.woff2') format('woff2')}
+@font-face{font-family:'Rajdhani';font-weight:700;font-display:swap;src:url('/fonts/rajdhani-700.woff2') format('woff2')}
+@font-face{font-family:'Inter';font-weight:400;font-display:swap;src:url('/fonts/inter-400.woff2') format('woff2')}
+@font-face{font-family:'Inter';font-weight:500;font-display:swap;src:url('/fonts/inter-500.woff2') format('woff2')}
+:root{
+  --bg:#08080a; --panel:#0f0f12; --panel-2:#141418;
+  --line:rgba(225,6,0,.16); --line-soft:rgba(255,255,255,.06);
+  --crimson:#E10600; --crimson-deep:#B3000C;
+  --bone:#ECE7DB; --bone-dim:#B7B1A4; --steel:#71767b;
+  --hdr:'Rajdhani','Oswald',system-ui,sans-serif;
+  --body:'Inter',system-ui,-apple-system,Segoe UI,sans-serif;
+}
+*{box-sizing:border-box}
+html,body{margin:0;height:100%;overflow:hidden}
+body{font-family:var(--body);color:var(--bone-dim);background:var(--bg)}
+.app{display:grid;grid-template-columns:250px 1fr;grid-template-rows:auto 1fr;height:100vh}
+/* topbar spans both columns */
+.top{grid-column:1 / 3;display:flex;align-items:center;gap:14px;padding:10px 22px;
+  border-bottom:1px solid var(--line-soft);box-shadow:0 1px 0 rgba(225,6,0,.12);background:#040405}
+.top .brand img{height:44px;width:auto;display:block;border:0}
+.top .spacer{flex:1}
+.btn{font-family:var(--hdr);font-weight:600;letter-spacing:.08em;text-transform:uppercase;font-size:12px;
+  padding:8px 15px;border-radius:8px;border:1px solid var(--line-soft);background:var(--panel);
+  color:var(--bone-dim);cursor:pointer;transition:.15s;text-decoration:none;display:inline-block;line-height:normal}
+.btn:hover{color:var(--bone);border-color:var(--line)}
+.btn.crit{color:#fff;border-color:#7A0C0C;background:linear-gradient(180deg,var(--crimson),var(--crimson-deep))}
+.btn.crit:hover{filter:brightness(1.08)}
+/* rail */
+.rail{background:linear-gradient(180deg,#0c0c0f,#08080a);border-right:1px solid var(--line-soft);
+  display:flex;flex-direction:column;padding:14px 12px;gap:2px;overflow-y:auto}
+.rail::-webkit-scrollbar{width:10px}
+.rail::-webkit-scrollbar-track{background:#000}
+.rail::-webkit-scrollbar-thumb{background:var(--crimson);border-radius:8px;border:2px solid #000}
+.wordmark{font-family:var(--hdr);font-weight:700;font-size:20px;letter-spacing:.02em;line-height:1.15;
+  padding:4px 6px 12px;text-align:center;color:var(--bone)}
+.wordmark .m{color:var(--bone-dim)} .wordmark .r{color:var(--crimson)}
+.grp{font-family:var(--hdr);text-transform:uppercase;letter-spacing:.2em;font-size:10px;color:var(--steel);padding:12px 10px 4px}
+a.item{display:flex;align-items:center;gap:12px;height:38px;border-radius:9px;color:var(--steel);
+  text-decoration:none;padding:0 12px;position:relative;transition:.15s;
+  font-family:var(--hdr);font-weight:600;letter-spacing:.03em;font-size:14px;white-space:nowrap;flex:0 0 auto}
+a.item svg{width:18px;height:18px;stroke:currentColor;fill:none;stroke-width:1.7;flex:0 0 18px}
+a.item:hover{color:var(--bone);background:var(--panel)}
+a.item.on{color:var(--crimson);background:linear-gradient(90deg,rgba(225,6,0,.14),transparent)}
+a.item.on::before{content:"";position:absolute;left:0;top:7px;bottom:7px;width:2px;background:var(--crimson);border-radius:2px}
+/* content frame */
+.stage{position:relative;background:var(--bg)}
+#page_frame{width:100%;height:100%;border:0;display:block;background:var(--bg)}
+</style>
+</head>
+<body>
+<div class="app">
+  <header class="top">
+    <a class="brand" href="/Main_ReaperDash.asp" title="REAPER dashboard"><img src="/images/REAPER.png" alt="REAPER"></a>
+    <span class="spacer"></span>
+    <a class="btn" href="/Main_ReaperDash.asp">Dashboard</a>
+    <button class="btn" type="button" id="btn_reboot">Reboot</button>
+    <button class="btn crit" type="button" id="btn_logout">Logout</button>
+  </header>
+  <aside class="rail" id="rail">
+    <div class="wordmark">ASUS <span class="r">&middot;</span> <span class="m">Merlin</span> <span class="r">&middot;</span> <span class="r">Reaper</span></div>
+  </aside>
+  <main class="stage">
+    <iframe id="page_frame" name="reaper_frame" title="settings page"></iframe>
+  </main>
+</div>
+
+<iframe name="hidden_frame" id="hidden_frame" style="display:none" title="hidden"></iframe>
+<form method="post" name="rebootForm" action="apply.cgi" target="hidden_frame">
+  <input type="hidden" name="action_mode" value="reboot">
+  <input type="hidden" name="action_script" value="">
+  <input type="hidden" name="action_wait" value="<% get_default_reboot_time(); %>">
+</form>
+<div id="reboot_overlay" style="display:none;position:fixed;inset:0;z-index:99;background:rgba(4,4,5,.92)">
+  <div style="position:absolute;top:42%;left:50%;transform:translate(-50%,-50%);text-align:center">
+    <div style="font-family:var(--hdr);color:var(--crimson);font-size:22px;letter-spacing:.2em;text-transform:uppercase">Rebooting</div>
+    <div id="reboot_count" style="margin-top:12px;color:var(--bone);font-family:var(--hdr);font-size:34px;font-weight:700">&mdash;</div>
+    <div style="margin-top:10px;color:var(--steel);font-size:12px">The UI will reload when the router is back.</div>
+  </div>
+</div>
+
+<script>
+/* Pages that have a reaper-themed tandem copy (pilot phase): the shell loads
+   R_<name> instead of the stock file. At full rollout this list goes away and
+   every page carries /reaper/reaper_content.css itself. */
+var PILOTS = {
+  'Advanced_Wireless_Content.asp':1,
+  'Advanced_LAN_Content.asp':1,
+  'Advanced_WAN_Content.asp':1,
+  'Advanced_BasicFirewall_Content.asp':1,
+  'Advanced_System_Content.asp':1,
+  'Main_LogStatus_Content.asp':1
+};
+var DEFAULT_PAGE = 'Advanced_System_Content.asp';
+
+var ICONS = {
+  menu_Index:          '<svg viewBox="0 0 24 24"><path d="M3 12l9-8 9 8"/><path d="M5 10v10h14V10"/></svg>',
+  menu_AiMesh:         '<svg viewBox="0 0 24 24"><circle cx="6" cy="6" r="2.5"/><circle cx="18" cy="6" r="2.5"/><circle cx="12" cy="18" r="2.5"/><path d="M7.7 7.7l3 8M16.3 7.7l-3 8M8 6h8"/></svg>',
+  menu_GuestNetwork:   '<svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c3 3 3 15 0 18M12 3c-3 3-3 15 0 18"/></svg>',
+  menu_AiProtection:   '<svg viewBox="0 0 24 24"><path d="M12 3l8 4v5c0 5-3.5 8-8 9-4.5-1-8-4-8-9V7z"/><path d="M9 12l2 2 4-4"/></svg>',
+  menu_ParentalControl:'<svg viewBox="0 0 24 24"><circle cx="9" cy="8" r="2.5"/><circle cx="16" cy="9" r="2"/><path d="M4 19a5 5 0 0 1 10 0M13 19a4 4 0 0 1 7-3"/></svg>',
+  menu_QoS:            '<svg viewBox="0 0 24 24"><path d="M4 18v-5M9 18V7M14 18v-8M19 18v-12"/></svg>',
+  menu_TrafficAnalyzer:'<svg viewBox="0 0 24 24"><path d="M3 16l5-6 4 4 5-7 4 5"/></svg>',
+  menu_BandwidthMonitor:'<svg viewBox="0 0 24 24"><path d="M3 16l5-6 4 4 5-7 4 5"/></svg>',
+  menu_GameBoost:      '<svg viewBox="0 0 24 24"><rect x="3" y="8" width="18" height="9" rx="4"/><path d="M8 12v-2M7 12h2M15.5 12h.01M18 13.5h.01"/></svg>',
+  menu_OpenNAT:        '<svg viewBox="0 0 24 24"><path d="M7 8l-4 4 4 4M17 8l4 4-4 4M14 6l-4 12"/></svg>',
+  menu_APP:            '<svg viewBox="0 0 24 24"><rect x="4" y="5" width="16" height="14" rx="2"/><path d="M8 5v14"/></svg>',
+  menu_AiCloud:        '<svg viewBox="0 0 24 24"><path d="M7 17a4 4 0 0 1 .6-8 5 5 0 0 1 9.6 1.4A3.5 3.5 0 0 1 17 17z"/></svg>',
+  menu_Tool:           '<svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 11v5M12 8h.01"/></svg>',
+  menu_Wireless:       '<svg viewBox="0 0 24 24"><path d="M4 9a12 12 0 0 1 16 0M7 12a8 8 0 0 1 10 0M10 15a4 4 0 0 1 4 0"/><circle cx="12" cy="18" r="1"/></svg>',
+  menu_LAN:            '<svg viewBox="0 0 24 24"><rect x="3" y="10" width="18" height="8" rx="2"/><path d="M7 10V6h10v4"/></svg>',
+  menu_WAN:            '<svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a15 15 0 0 1 0 18"/><path d="M16 4l4 2-2 4"/></svg>',
+  menu_Alexa_IFTTT:    '<svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="8"/><circle cx="12" cy="12" r="2.5"/></svg>',
+  menu_VPN:            '<svg viewBox="0 0 24 24"><path d="M12 3l8 4v5c0 5-3.5 8-8 9-4.5-1-8-4-8-9V7z"/><path d="M12 9v6M9 12h6"/></svg>',
+  menu_Firewall:       '<svg viewBox="0 0 24 24"><path d="M4 5h16v6c0 5-4 8-8 9-4-1-8-4-8-9z"/><path d="M4 9h16M9 5v4M15 5v4"/></svg>',
+  menu_Setting:        '<svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"/><path d="M12 3v3M12 18v3M3 12h3M18 12h3M5 5l2 2M17 17l2 2M19 5l-2 2M7 17l-2 2"/></svg>',
+  menu_Log:            '<svg viewBox="0 0 24 24"><path d="M6 3h9l3 3v15H6z"/><path d="M9 9h6M9 13h6M9 17h4"/></svg>',
+  menu_NekworkTool:    '<svg viewBox="0 0 24 24"><path d="M14 7a3 3 0 0 0-4 4l-6 6 2 2 6-6a3 3 0 0 0 4-4l-2 2-2-2z"/></svg>',
+  _default:            '<svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="8"/><circle cx="12" cy="12" r="2.5"/></svg>'
+};
+
+function $id(id){return document.getElementById(id);}
+function frameUrl(page){ return '/' + (PILOTS[page] ? ('R_' + page) : page); }
+
+function loadPage(page){
+  var f=$id('page_frame');
+  if(f) f.src = frameUrl(page);
+  try{ history.replaceState(null, '', '/reaper_shell.asp#' + page); }catch(e){}
+  var links=document.querySelectorAll('#rail a.item');
+  for(var i=0;i<links.length;i++){
+    var pages=(links[i].getAttribute('data-pages')||'').split('|');
+    var hit=(pages.indexOf(page)!==-1);
+    links[i].className='item'+(hit?' on':'');
+  }
+}
+
+function buildRail(menuTree){
+  var rail=$id('rail');
+  var exMenus=[], exTabs=[];
+  try{ exMenus=menuTree.exclude.menus()||[]; }catch(e){}
+  try{ exTabs=menuTree.exclude.tabs()||[]; }catch(e){}
+  var list=menuTree.list||[], h='';
+  for(var i=0;i<list.length;i++){
+    var m=list[i];
+    if(!m||!m.index) continue;
+    if(exMenus.indexOf(m.index)!==-1) continue;
+    if(m.index==='menu_QIS') continue;
+    if(m.index==='menu_Split'){ h+='<div class="grp">'+m.menuName+'</div>'; continue; }
+    var first=-1, pages=[];
+    for(var j=0;j<(m.tab||[]).length;j++){
+      var t=m.tab[j];
+      if(!t||!t.url||t.url==='NULL') continue;
+      if(exTabs.indexOf(t.url)!==-1) continue;
+      if(first===-1) first=j;
+      pages.push(t.url);
+    }
+    if(first===-1) continue;
+    var ic=ICONS[m.index]||ICONS._default;
+    h+='<a class="item" href="/reaper_shell.asp#'+m.tab[first].url+'" data-page="'+m.tab[first].url+'" data-pages="'+pages.join('|')+'">'+ic+'<span>'+m.menuName+'</span></a>';
+  }
+  rail.insertAdjacentHTML('beforeend', h);
+  var links=rail.querySelectorAll('a.item');
+  for(var k=0;k<links.length;k++){
+    links[k].addEventListener('click', function(ev){
+      ev.preventDefault();
+      loadPage(this.getAttribute('data-page'));
+    });
+  }
+  var initial=(location.hash||'').replace('#','');
+  loadPage(initial || DEFAULT_PAGE);
+}
+
+require(['/require/modules/menuTree.js'], function(menuTree){ buildRail(menuTree); });
+
+/* logout / reboot (stock mechanisms, shell-owned) */
+(function(){
+  var lo=$id('btn_logout');
+  if(lo) lo.addEventListener('click', function(){
+    if(confirm('Log out of the router?')) location='/Logout.asp';
+  });
+  var rb=$id('btn_reboot');
+  if(rb) rb.addEventListener('click', function(){
+    if(!confirm('Reboot the router now?')) return;
+    var wait=parseInt(document.rebootForm.action_wait.value,10)||170;
+    document.rebootForm.submit();
+    var ov=$id('reboot_overlay'); if(ov) ov.style.display='block';
+    var left=wait;
+    var tick=setInterval(function(){
+      left--;
+      var c=$id('reboot_count'); if(c) c.textContent=left>0?(left+'s'):'...';
+      if(left<=0){ clearInterval(tick); location.reload(); }
+    },1000);
+  });
+})();
+</script>
+</body>
+</html>
