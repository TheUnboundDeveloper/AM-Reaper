-  border:1px solid rgba(255,255,255,.06)!important;border-radius:8px 8px 0 0!important;
-  background-image:none!important}
-.submenuBlock .tab:hover{background:#141418!important;border-color:rgba(225,6,0,.16)!important}
-.submenuBlock .tabClicked{background:linear-gradient(180deg,rgba(225,6,0,.22),#141418)!important;
