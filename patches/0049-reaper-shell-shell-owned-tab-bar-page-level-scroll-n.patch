@@ -137,6 +146,36 @@ var ICONS = {
 function $id(id){return document.getElementById(id);}
 function frameUrl(page){ return '/' + (PILOTS[page] ? ('R_' + page) : page); }
 
+var MENULIST=[], EXTABS=[];   /* set by buildRail; used for the shell tab bar */
+
+function renderTabs(page){
+  var bar=$id('tabbar'); if(!bar) return;
+  var menu=null;
+  for(var i=0;i<MENULIST.length && !menu;i++){
+    var m=MENULIST[i]; if(!m||!m.tab) continue;
+    for(var j=0;j<m.tab.length;j++){ if(m.tab[j].url===page){ menu=m; break; } }
+  }
+  if(!menu){ bar.style.display='none'; bar.innerHTML=''; return; }
+  var h='', count=0;
+  for(var k=0;k<menu.tab.length;k++){
+    var t=menu.tab[k];
+    if(!t||!t.url||t.url==='NULL') continue;
+    if(t.tabName==='__HIDE__'||t.tabName==='__INHERIT__') continue;
+    if(EXTABS.indexOf(t.url)!==-1) continue;
+    h+='<a class="rtab'+(t.url===page?' on':'')+'" href="/reaper_shell.asp#'+t.url+'" data-page="'+t.url+'">'+t.tabName+'</a>';
+    count++;
+  }
+  if(count<2){ bar.style.display='none'; bar.innerHTML=''; return; }
+  bar.innerHTML=h; bar.style.display='flex';
+  var links=bar.querySelectorAll('a.rtab');
+  for(var n=0;n<links.length;n++){
+    links[n].addEventListener('click', function(ev){
+      ev.preventDefault();
+      loadPage(this.getAttribute('data-page'));
+    });
+  }
+}
+
 function loadPage(page){
   var f=$id('page_frame');
   if(f) f.src = frameUrl(page);
@@ -147,6 +186,7 @@ function loadPage(page){
     var hit=(pages.indexOf(page)!==-1);
     links[i].className='item'+(hit?' on':'');
   }
+  renderTabs(page);
 }
 
 function buildRail(menuTree){
@@ -156,6 +196,7 @@ function buildRail(menuTree){
   try{ exMenus=menuTree.exclude.menus()||[]; }catch(e){}
   try{ exTabs=menuTree.exclude.tabs()||[]; }catch(e){}
   var list=menuTree.list||[], h='';
+  MENULIST=list; EXTABS=exTabs;
   for(var i=0;i<list.length;i++){
     var m=list[i];
     if(!m||!m.index) continue;
