-.stage{position:relative;background:var(--bg)}
-#page_frame{width:100%;height:100%;border:0;display:block;background:var(--bg)}
+/* content stage: shell-owned tab bar + frame; sticky so it stays put while
+   the rail scrolls with the page */
+.stage{position:sticky;top:65px;height:calc(100vh - 65px);background:var(--bg);
