From 47f6affadce4fed60b5c5d4403a7eb9a305503ae Mon Sep 17 00:00:00 2001
From: reaper <theunbounddeveloper@outlook.com>
Date: Fri, 3 Jul 2026 12:23:22 -0400
Subject: [PATCH] reaper shell: full-height rail + topbar butts to rail; fix
 banner-shim clipping

- shell grid: rail spans both rows (dashboard geometry), topbar sits right
  of the rail instead of spanning above it
- reaper_content.css: neutralize stock banner-offset shims that pulled
  content above the visible top once the banner was hidden (index.asp
  #NM_shift -140px, aidisk #FormTitle -140px); neutralize table-level
  bgcolor 4d595d slabs
- verified in local headless-Edge harness against the staged fs (Network
  Map card no longer clipped, aidisk panel at top, standard pages OK)
---
 release/src/router/www/reaper/reaper_content.css | 7 +++++++
 release/src/router/www/reaper_shell.asp          | 6 +++---
 2 files changed, 10 insertions(+), 3 deletions(-)

diff --git a/release/src/router/www/reaper/reaper_content.css b/release/src/router/www/reaper/reaper_content.css
index b2449e648a..d705ab6148 100644
--- a/release/src/router/www/reaper/reaper_content.css
+++ b/release/src/router/www/reaper/reaper_content.css
@@ -81,3 +81,10 @@ textarea,.textarea_log,.textarea_log_table{background:#000!important;color:#B7B1
   font-family:Consolas,Monaco,monospace!important;border:1px solid rgba(255,255,255,.1)!important}
 a:link,a:visited{color:#E0A93B}
 a:hover{color:#E10600}
+
+/* ---------- 5. stock banner-offset shims ---------- */
+/* classic pages tuck content under the stock banner with negative-margin
+   shims; with the banner hidden those pull content above the visible top */
+#NM_shift{margin-top:0!important}
+table#FormTitle{margin-top:0!important}
+table[bgcolor="#4d595d"],table[bgcolor="#4D595D"],td[bgcolor="#4d595d"]{background:transparent!important}
diff --git a/release/src/router/www/reaper_shell.asp b/release/src/router/www/reaper_shell.asp
index 3d72ab78e2..0ade3bc35a 100644
--- a/release/src/router/www/reaper_shell.asp
+++ b/release/src/router/www/reaper_shell.asp
@@ -32,7 +32,7 @@ body{font-family:var(--body);color:var(--bone-dim);background:var(--bg);overflow
 /* one page-level scrollbar: the body scrolls; topbar and the content stage are
    sticky so only the rail visually scrolls when it is taller than the viewport */
 .app{display:grid;grid-template-columns:250px 1fr;grid-template-rows:auto 1fr;min-height:100vh}
-.top{grid-column:1 / 3;display:flex;align-items:center;gap:14px;padding:10px 22px;
+.top{grid-column:2;grid-row:1;display:flex;align-items:center;gap:14px;padding:10px 22px;
   border-bottom:1px solid var(--line-soft);box-shadow:0 1px 0 rgba(225,6,0,.12);background:#040405;
   position:sticky;top:0;z-index:300}
 .top .brand img{height:44px;width:auto;display:block;border:0}
@@ -44,7 +44,7 @@ body{font-family:var(--body);color:var(--bone-dim);background:var(--bg);overflow
 .btn.crit{color:#fff;border-color:#7A0C0C;background:linear-gradient(180deg,var(--crimson),var(--crimson-deep))}
 .btn.crit:hover{filter:brightness(1.08)}
 /* rail: no scrollbar of its own - the page scrollbar handles overflow */
-.rail{background:linear-gradient(180deg,#0c0c0f,#08080a);border-right:1px solid var(--line-soft);
+.rail{grid-column:1;grid-row:1 / 3;background:linear-gradient(180deg,#0c0c0f,#08080a);border-right:1px solid var(--line-soft);
   display:flex;flex-direction:column;padding:14px 12px;gap:2px}
 .wordmark{font-family:var(--hdr);font-weight:700;font-size:20px;letter-spacing:.02em;line-height:1.15;
   padding:4px 6px 12px;text-align:center;color:var(--bone)}
@@ -59,7 +59,7 @@ a.item.on{color:var(--crimson);background:linear-gradient(90deg,rgba(225,6,0,.14
 a.item.on::before{content:"";position:absolute;left:0;top:7px;bottom:7px;width:2px;background:var(--crimson);border-radius:2px}
 /* content stage: shell-owned tab bar + frame; sticky so it stays put while
    the rail scrolls with the page */
-.stage{position:sticky;top:65px;height:calc(100vh - 65px);background:var(--bg);
+.stage{grid-column:2;grid-row:2;position:sticky;top:65px;height:calc(100vh - 65px);background:var(--bg);
   display:flex;flex-direction:column}
 #tabbar{display:none;gap:6px;padding:12px 16px 0;flex-wrap:wrap;flex:0 0 auto}
 #tabbar a.rtab{font-family:var(--hdr);font-weight:600;letter-spacing:.05em;font-size:13px;
-- 
2.25.1

