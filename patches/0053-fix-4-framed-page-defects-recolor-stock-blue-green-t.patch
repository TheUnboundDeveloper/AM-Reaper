From 3017396925960d147764563b4648a902bcb5fbc9 Mon Sep 17 00:00:00 2001
From: reaper <theunbounddeveloper@outlook.com>
Date: Fri, 3 Jul 2026 14:03:14 -0400
Subject: [PATCH] fix 4 framed-page defects + recolor stock blue/green to
 reaper palette

- AdaptiveQoS_InternetSpeed: nested speedtest iframe collapsed to the 150px
  default (height copied from an empty inline style) - now viewport-sized
- VPN Status class: popup.js showLoading sets html overflow:hidden; a stalled
  restore left framed pages unable to scroll - overflow-y kept auto always
- GameBoost Gear Accelerator toggle: ON/OFF labels overflowed their 50px
  halves under the wider Inter font - condensed Rajdhani at 15px
- Advanced_Smart_Connect: replace the -36px overlap hack (our earlier
  addition) with a flex row so the buttons align with the hint text
- recolor pass: QoS speedmeter gauges + iphone-style switches crimson via
  css filters, GameBoost switch checked-state crimson, traffic bars crimson,
  tr[bgcolor=4D595D] + bare div#FormTitle slabs darkened, contentM_qis
  popups dark with crimson border
---
 .../src/router/www/Advanced_Smart_Connect.asp |  5 ++--
 .../src/router/www/reaper/reaper_content.css  | 27 +++++++++++++++++++
 2 files changed, 30 insertions(+), 2 deletions(-)

diff --git a/release/src/router/www/Advanced_Smart_Connect.asp b/release/src/router/www/Advanced_Smart_Connect.asp
index fa9d47883c..059c350458 100644
--- a/release/src/router/www/Advanced_Smart_Connect.asp
+++ b/release/src/router/www/Advanced_Smart_Connect.asp
@@ -1022,8 +1022,9 @@ function toggleSmartConnect(){
 			<div>&nbsp;</div>
 			<div class="formfonttitle"><#menu5_1#> - <#smart_connect_rule#></div>
 			<div style="margin:10px 0 10px 5px;" class="splitLine"></div>
-			<div class="formfontdesc"><#smart_connect_hint#></div>
-			<div style="text-align:right;margin-top:-36px;padding-bottom:3px;"><input type="button" id="smartConnectToggle" class="button_gen" style="margin-right:8px;" value="Smart Connect" onClick="toggleSmartConnect();"><input type="button" class="button_gen" value="<#View_List#>" onClick="showClientlistModal()"></div>
+			<div style="display:flex;align-items:flex-start;gap:12px;margin-bottom:8px;">
+			<div class="formfontdesc" style="flex:1;margin-bottom:0;"><#smart_connect_hint#></div>
+			<div style="white-space:nowrap;padding-top:2px;"><input type="button" id="smartConnectToggle" class="button_gen" style="margin-right:8px;" value="Smart Connect" onClick="toggleSmartConnect();"><input type="button" class="button_gen" value="<#View_List#>" onClick="showClientlistModal()"></div></div>
 			<div id="scDisableDisclaimer" class="formfontdesc" style="display:none;color:#FFCC00;line-height:18px;margin:10px 5px;padding:8px 10px;border:1px solid #FFCC00;border-radius:4px;background:rgba(255,204,0,0.06);">
 				<b>Heads up &mdash; Smart Connect is off.</b> Band steering no longer moves your devices between the 2.4 / 5 / 6 GHz radios. If those radios share the same SSID, a device may stay connected to a less-than-optimal band (for example 2.4 GHz instead of 5 GHz or 6 GHz). Set a preferred band on the device itself if that option is available; if it is not, disconnect and reconnect to the Wi-Fi to let the device re-select the preferred band. To make the choice explicit, give each band its own separate SSID.
 			</div>
diff --git a/release/src/router/www/reaper/reaper_content.css b/release/src/router/www/reaper/reaper_content.css
index c973a7ddc5..3bf9b47444 100644
--- a/release/src/router/www/reaper/reaper_content.css
+++ b/release/src/router/www/reaper/reaper_content.css
@@ -92,3 +92,30 @@ table[bgcolor="#4d595d"],table[bgcolor="#4D595D"],td[bgcolor="#4d595d"]{backgrou
    with an inline margin-top:-140px AFTER load (tucks content under the stock
    banner); important beats inline, attribute selector tracks the JS write */
 div[style*="margin-top:-140px"],div[style*="margin-top: -140px"]{margin-top:0!important}
+
+/* ---------- 6. per-page fixes ---------- */
+/* AdaptiveQoS_InternetSpeed: the nested speedtest iframe copies its height
+   from an empty inline style and collapses to the 150px default */
+#internetSpeed_iframe{height:calc(100vh - 175px)!important;min-height:600px!important}
+/* popup.js showLoading()/showLoadingBar() set inline overflow:hidden on the
+   html element; if the restore path stalls the framed page can never scroll
+   again (VPN Status symptom) - keep vertical scrolling available */
+html{overflow-y:auto!important}
+/* GameBoost Gear Accelerator ON/OFF toggle: labels overflow the 50px halves
+   with the wider Inter body font - condensed Rajdhani at a tighter size */
+.switch .container{font-family:'Rajdhani',system-ui,sans-serif!important}
+.switch .container div div{font-size:15px!important;letter-spacing:.02em}
+/* remaining stock chrome surfaces */
+tr[bgcolor="#4D595D"],tr[bgcolor="#4d595d"]{background:transparent!important}
+.contentM_qis{background-color:#0f0f12!important;border:1px solid rgba(225,6,0,.35)!important}
+
+/* ---------- 7. recolor: stock blue/green accents -> reaper palette ---------- */
+.switch input:checked~.container{background:linear-gradient(180deg,#E10600,#B3000C)!important}
+.switch2 input:checked~.container{background:linear-gradient(180deg,#E10600,#B3000C)!important}
+img.iphone_switch{filter:grayscale(1) sepia(1) hue-rotate(-50deg) saturate(4) brightness(.95)}
+.speed-meter-100{filter:grayscale(1) sepia(1) hue-rotate(-50deg) saturate(3.5) brightness(.9)}
+#indicator_upload,#indicator_download{filter:grayscale(1) sepia(1) hue-rotate(-50deg) saturate(3)}
+.traffic_bar{background-color:#E10600!important}
+/* InternetSpeed wraps the speedtest in a bare div#FormTitle with an inline
+   grey background - and deepen the recolored gauge tone */
+div#FormTitle{background-color:#0f0f12!important}
-- 
2.25.1

