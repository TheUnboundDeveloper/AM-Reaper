 		html_landing += "return false;\n";
 		html_landing += "}\n";
 		html_landing += "<_TAG_END_>\n";
-		html_landing += "<link rel="stylesheet" type="text/css" href="/reaper/reaper_content.css">
-<script>if(self===top){var rp=location.pathname.split("/").pop()||"index.asp";location.replace(rp==="index.asp"?"/Main_ReaperDash.asp":"/reaper_shell.asp#"+rp+location.search);}</script>
-</head>\n";
+		html_landing += "</head>\n";
 		html_landing += "<body onload='initial();' id='splash_body' class='splash_body'>\n";
 		if(terms_service_status) {
 			html_landing += "<div id='terms_service' class='terms_service'></div>\n";
@@ -1835,6 +1833,8 @@ function check_gn_if_status(_subunit, _gn_array) {
 }
 </script>
 
+<link rel="stylesheet" type="text/css" href="/reaper/reaper_content.css">
+<script>if(self===top){var rp=location.pathname.split("/").pop()||"index.asp";location.replace(rp==="index.asp"?"/Main_ReaperDash.asp":"/reaper_shell.asp#"+rp+location.search);}</script>
 </head>
 
 <body onload="initial();" onunLoad="return unload_body();" class="bg">
