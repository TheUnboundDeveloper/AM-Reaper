From b5d29e0510af1a2e2e39f2c93b8bd38ee9e0556b Mon Sep 17 00:00:00 2001
From: reaper <theunbounddeveloper@outlook.com>
Date: Fri, 3 Jul 2026 22:03:01 -0400
Subject: [PATCH] gui: reaper theme for Ookla speed test page (chrome/controls
 only)

internet_speed.html never got the reaper pass (no TopBanner -> no baked
css; inner iframe -> shell injector cannot reach it). Add
reaper/internet_speed_reaper.css and link it after internetSpeed.css:
panels/server bar/Level pill to reaper blacks, Go button + blue accent
icons crimson via the established filter recipe, crimson links and
scrollbars. Data viz stays stock: rainbow level bar, speed-tier icons,
live gauge, readouts.

Co-Authored-By: Claude Fable 5 <noreply@anthropic.com>
---
 release/src/router/www/internet_speed.html    |  1 +
 .../www/reaper/internet_speed_reaper.css      | 79 +++++++++++++++++++
 2 files changed, 80 insertions(+)
 create mode 100644 release/src/router/www/reaper/internet_speed_reaper.css

diff --git a/release/src/router/www/internet_speed.html b/release/src/router/www/internet_speed.html
index 7cbc9d7b28..354fa24d3f 100644
--- a/release/src/router/www/internet_speed.html
+++ b/release/src/router/www/internet_speed.html
@@ -2,6 +2,7 @@
 <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
 <meta http-equiv="X-UA-Compatible" content="ie=edge">
 <link rel="stylesheet" type="text/css" href="css/internetSpeed.css">
+<link rel="stylesheet" type="text/css" href="/reaper/internet_speed_reaper.css">
 <script type="text/javaScript" src="/js/jquery.js"></script>
 <script type="text/javascript" src="/state.js"></script>
 <script type="text/javascript" src="/js/httpApi.js"></script>
diff --git a/release/src/router/www/reaper/internet_speed_reaper.css b/release/src/router/www/reaper/internet_speed_reaper.css
new file mode 100644
index 0000000000..3d25195eb3
--- /dev/null
+++ b/release/src/router/www/reaper/internet_speed_reaper.css
@@ -0,0 +1,79 @@
+/* REAPER theme - Ookla speed test page (internet_speed.html).
+   Chrome/controls only: panels, Go button, icons, history table, links.
+   Data viz stays stock: rainbow level bar, speed-tier icons, live gauge,
+   result readouts. Loaded after css/internetSpeed.css. */
+
+/* ---- panels ---- */
+.speedTest_div,
+.speed_level_detail{
+	background: #0f0f12 !important;
+	background-color: #0f0f12 !important;
+	border-color: #26262c !important;
+}
+.LinkRate_div{
+	border: 1px solid #26262c !important;
+}
+.level_ping_div{
+	background: #141419 !important;
+}
+.close_icon{
+	background-color: #141419 !important;
+}
+
+/* ---- Go button: blue svg sprite -> crimson-mono (same filter recipe as
+        the themed gauges in reaper_content.css) ---- */
+.speedTest_btn_normal,
+.speedTest_btn_press,
+.speedTest_btn_disable{
+	filter: grayscale(1) sepia(1) hue-rotate(-50deg) saturate(7) brightness(0.82);
+}
+
+/* ---- server-select bar + dropdown (rounded slate pills) ---- */
+.cur_server_container,
+#outer_server_container{
+	background: #141419 !important;
+}
+
+/* ---- "Level" pill: navy svg pill -> flat dark pill; the colored
+        fast/good/great/super/ultra variants are semantic, left stock ---- */
+.speed_level_default{
+	background-image: none !important;
+	background-color: #141419 !important;
+	border: 1px solid #26262c;
+	border-radius: 25px;
+}
+
+/* ---- blue accent icons -> crimson via the same filter ---- */
+.server_icon,
+.down_arrow,
+.up_arrow:hover,
+.server_list_check,
+.history_select_checked{
+	filter: grayscale(1) sepia(1) hue-rotate(-50deg) saturate(5);
+}
+
+/* ---- history table / server list ---- */
+#function_row,
+.history_row,
+.host_div{
+	border-color: #26262c !important;
+}
+.history_delete_enable,
+.history_delete:hover{
+	background-color: rgba(225,6,0,0.15) !important;
+}
+.history_select:hover{
+	border-color: #E10600 !important;
+}
+.host_div:hover{
+	background: rgba(225,6,0,0.10);
+}
+
+/* ---- links ---- */
+a, a:visited{ color: #E10600 !important; }
+a:hover{ color: #ff453f !important; }
+
+/* ---- scrollbars (server list overflow) ---- */
+::-webkit-scrollbar{ width: 8px; height: 8px; }
+::-webkit-scrollbar-thumb{ background: #E10600 !important; border-radius: 4px; }
+::-webkit-scrollbar-track{ background: #141419; }
-- 
2.25.1

