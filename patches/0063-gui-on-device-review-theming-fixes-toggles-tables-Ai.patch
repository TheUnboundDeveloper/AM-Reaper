From 36095445f28e3dfef3af531615bb027ef29d8a98 Mon Sep 17 00:00:00 2001
From: reaper <theunbounddeveloper@outlook.com>
Date: Sat, 4 Jul 2026 11:23:39 -0400
Subject: [PATCH] gui: on-device review theming fixes (toggles, tables, AiMesh
 tabs, SDN/MLO, USB, nav)

Global: on/off toggle switches recolored crimson -> neutral grey (an ON
toggle in brand-red read as an alert); rail padding-bottom so the browser
URL tooltip no longer covers the last nav item.
reaper_content.css section 12: theme tableApi_table (js/table/table.css
thead td #4D595D) - covers DHCP leases, Instant Guard Connection Status,
Port Trigger list, Network Analysis result; USB Samba/FTP AiDiskTable +
accountBar share panel; Operation Mode #Senario image screen-blended so its
baked teal box drops out; Network Map View List popup + remaining USB port
icons.
Section 13: foundational SDN/MLO SPA palette override (card #45535C ->
dark, blue #2597FF/#2ED3F1/#00BFFF/#00FBBD accents -> crimson/amber, section
labels, selected states, SPA toggle grey) - component-heavy, VALIDATE ON
DEVICE.
AiMesh top tabs (Topology/System Settings): the generic .clicked rule
painted a bright-red fill; now read as tabs with a maroon underline.

Co-Authored-By: Claude Fable 5 <noreply@anthropic.com>
---
 release/src/router/www/Main_ReaperDash.asp    |  2 +-
 .../src/router/www/reaper/reaper_content.css  | 96 +++++++++++++++++--
 release/src/router/www/reaper_shell.asp       |  5 +-
 3 files changed, 95 insertions(+), 8 deletions(-)

diff --git a/release/src/router/www/Main_ReaperDash.asp b/release/src/router/www/Main_ReaperDash.asp
index ad21bb0c67..d957c2ca7e 100644
--- a/release/src/router/www/Main_ReaperDash.asp
+++ b/release/src/router/www/Main_ReaperDash.asp
@@ -54,7 +54,7 @@ html{scrollbar-width:thin;scrollbar-color:var(--crimson) #000}
 /* ---------- shell / always-expanded rail ---------- */
 .app{display:grid;grid-template-columns:250px 1fr;min-height:100vh}
 .rail{background:linear-gradient(180deg,#0c0c0f,#08080a);border-right:1px solid var(--line-soft);
-  display:flex;flex-direction:column;padding:14px 12px;gap:2px}
+  display:flex;flex-direction:column;padding:14px 12px 56px;gap:2px}
 .wordmark{font-family:var(--hdr);font-weight:700;font-size:21px;letter-spacing:.02em;line-height:1.15;padding:4px 6px 12px;text-align:center}
 .wordmark .a{color:var(--bone)} .wordmark .m{color:var(--bone-dim)} .wordmark .r{color:var(--crimson)} .wordmark .d{color:var(--crimson)}
 .railsearch{margin:2px 4px 8px}
diff --git a/release/src/router/www/reaper/reaper_content.css b/release/src/router/www/reaper/reaper_content.css
index edf2adb86d..fd3edd8bf4 100644
--- a/release/src/router/www/reaper/reaper_content.css
+++ b/release/src/router/www/reaper/reaper_content.css
@@ -129,12 +129,13 @@ html::-webkit-scrollbar{display:block!important;width:12px!important;height:12px
 html::-webkit-scrollbar-thumb{background-color:#E10600!important;border:2px solid #000!important;border-radius:8px!important}
 html::-webkit-scrollbar-track{background-color:#000!important}
 
-/* toggle switches - all three stock mechanisms */
-.switch input:checked~.container{background:linear-gradient(180deg,#E10600,#B3000C)!important}
-.switch2 input:checked~.container{background:linear-gradient(180deg,#E10600,#B3000C)!important}
-img.iphone_switch{filter:grayscale(1) sepia(1) hue-rotate(-50deg) saturate(4) brightness(.95)}
-input.switch:checked~.switch_container>.switch_bar{background-color:#E10600!important}
-input.switch:checked~.switch_container>.switch_bar+.switch_circle>div{filter:grayscale(1) sepia(1) hue-rotate(-50deg) saturate(4)}
+/* toggle switches - all three stock mechanisms. User choice: NEUTRAL GREY,
+   not crimson (an ON toggle in brand-red read as an alert/warning) */
+.switch input:checked~.container{background:linear-gradient(180deg,#6b6b72,#45454b)!important}
+.switch2 input:checked~.container{background:linear-gradient(180deg,#6b6b72,#45454b)!important}
+img.iphone_switch{filter:grayscale(1) brightness(.85)!important}
+input.switch:checked~.switch_container>.switch_bar{background-color:#6b6b72!important}
+input.switch:checked~.switch_container>.switch_bar+.switch_circle>div{filter:grayscale(1) brightness(.95)!important}
 
 /* selected pills / tab chips (AiProtection, Parental Controls, AiDisk) */
 .clicked{background-color:#E10600!important;box-shadow:0 0 6px rgba(225,6,0,.45)!important}
@@ -320,3 +321,86 @@ div[id$="_Block_PC"],div[id$="_Block_PC"] div,div[id$="_Block_PC"] a{
 .jstree-clicked .product_icon_container{
   border:1px solid #E10600!important;
   box-shadow:0 0 2px 0 rgba(0,0,0,.6),0 0 2px 2px rgba(225,6,0,.35),0 0 4px 0 rgba(0,0,0,.2)!important}
+/* AiMesh top tabs (Topology / System Settings): the generic .clicked rule
+   painted a bright-red FILL; make them read as tabs with a maroon underline */
+.aimesh_tab > span{color:#B7B1A4!important;background:transparent!important;box-shadow:none!important}
+.aimesh_tab > span.clicked{color:#ECE7DB!important;background:transparent!important;box-shadow:none!important}
+.aimesh_tab > span.clicked:before{border-bottom:2px solid #B3000C!important}
+
+/* ---------- 12. on-device review 2026-07-04: remaining stock surfaces ---------- */
+/* tableApi data tables (js/table/table.css: thead td #4D595D teal, th #1f2d35)
+   used by DHCP leases, Instant Guard Connection Status, Port Trigger list,
+   Network Analysis result, and other log/status pages */
+.tableApi_table{border-color:rgba(255,255,255,.08)!important}
+.tableApi_table thead td,.tableApi_table thead th{
+  background:linear-gradient(180deg,#2a0507,#141418)!important;color:#ECE7DB!important}
+.tableApi_table th{background-color:#101014!important;color:#B7B1A4!important}
+.tableApi_table td{background-color:#0c0c0f!important;color:#ECE7DB!important;
+  border-color:rgba(255,255,255,.08)!important}
+.tableApi_table td span{color:#FFCC00!important}
+.tableApi_table tr:nth-child(even) td{background-color:#101014!important}
+
+/* USB Application - Samba/FTP account+share widget at the bottom (teal panes) */
+.AiDiskTable,.accountBar,.AiDiskTable td,.AiDiskTable th,
+#account_menu,#account_menu td,#permissionTitle,#permissionTitle td,
+.machineName,.permission_table,.permission_table td{
+  background-color:#0f0f12!important;color:#ECE7DB!important;
+  border-color:rgba(255,255,255,.08)!important}
+.accountBar{background:linear-gradient(180deg,#141418,#0f0f12)!important}
+#account_menu .selectedAccount,#account_menu tr.click:hover{
+  background-color:rgba(225,6,0,.22)!important}
+
+/* Administration > Operation Mode: the mode diagram (#Senario) is a raster
+   image with a dark-teal box baked in; screen-blend it onto the page so the
+   line-art survives and the box background drops out */
+#Senario{background-color:#08080a!important;background-blend-mode:screen!important}
+
+/* Network Map: empty/other USB port icons still on the stock blue sprite +
+   the USB2.0 no-device tile square. Extend the crimson filter and neutralize
+   any teal tile behind them */
+#iconUSBdisk_0,#iconUSBdisk_1,#iconUSBdisk_2,.iconUSB,.iconUSB_dis,
+.usbicon,.usbPortIcon{
+  filter:grayscale(1) sepia(1) hue-rotate(-50deg) saturate(3) brightness(.95)!important}
+.usb_client_bg,.usb_index_bg,.usbPort_bg{background-color:transparent!important}
+
+/* Network Map "View List" popup (device-map/clientlist.html): the client list
+   still rendered on stock teal */
+.clientlist_viewlist,.clientlist_viewlist td,.clientlist_viewlist th,
+.viewlist_content,.clientlist_view_block,#clientlist_viewlist_content,
+.viewlist_table,.viewlist_table td{
+  background-color:#0f0f12!important;color:#ECE7DB!important;
+  border-color:rgba(255,255,255,.08)!important}
+.clientlist_viewlist thead td,.viewlist_table thead td,.viewlist_table thead th{
+  background:linear-gradient(180deg,#2a0507,#141418)!important;color:#ECE7DB!important}
+
+/* ---------- 13. SDN / MLO SPA (www/SDN/sdn.css + mlo.css) - own bundle, not
+   covered by earlier sections. FOUNDATIONAL palette override: card/border
+   teal-grey #45535C -> dark, blue accents #2597FF/#2ED3F1/#00BFFF -> crimson,
+   section-label + selected states. Component-heavy SPA; VALIDATE ON DEVICE. */
+/* card / container surfaces + borders */
+.profile_item_container,.feature_desc_container,.cb_item_container,
+.client_container,.category_container,.bg_template_container,
+.item_scenarios_container,.VPN_list_container,.dns_list_container,
+.clientlist_container,.dhcp_rule_container,.bandwidth_item,
+.wizard_list_bg,.faq_link_bg,.main_content_container,.sub_content_container{
+  background-color:#141419!important;border-color:rgba(255,255,255,.10)!important}
+[style*="border: 1px solid #45535C"],[style*="border:1px solid #45535C"],
+[style*="border-bottom: 1px solid #45535C"]{border-color:rgba(255,255,255,.10)!important}
+/* blue accents -> crimson (selected borders, links, highlight text) */
+[style*="#2597FF"],[style*="#2597ff"]{border-color:#E10600!important;color:#E10600!important}
+.item_text_container .main_info,.gaming_profile_list_title,
+.sdn_section_title,.category_title,.feature_title{color:#ECE7DB!important}
+/* the blue section labels (MAIN NETWORK / GUEST NETWORK PRO / CHOOSE A DEFINED) */
+.title_text,.section_title,.list_title,.group_title{color:#B7B1A4!important}
+/* selected/active profile + Add-a-Network highlight (was blue) */
+.profile_item_container.clicked,.profile_item_container.selected,
+.cb_item_container.clicked,.add_profile_container:hover{
+  border-color:#E10600!important;box-shadow:0 0 6px rgba(225,6,0,.35)!important}
+/* SPA toggle (was blue #2597FF) -> neutral grey, matching global toggle choice */
+.switch_bg.on,.sdn_switch.on,.switch_container.on,input.sdn_switch:checked~.switch_bar{
+  background-color:#6b6b72!important}
+/* cyan detail text #2ED3F1 */
+[style*="#2ED3F1"],[style*="#2ed3f1"]{color:#E0A93B!important}
+/* MLO page (mlo.css): cyan #00FBBD accent + banner */
+[style*="#00FBBD"],[style*="#00fbbd"]{color:#E0A93B!important}
+.mlo_banner_bg,.mlo_intro_bg{background-color:#141419!important}
diff --git a/release/src/router/www/reaper_shell.asp b/release/src/router/www/reaper_shell.asp
index 8d8fd7f5e0..84625805b0 100644
--- a/release/src/router/www/reaper_shell.asp
+++ b/release/src/router/www/reaper_shell.asp
@@ -45,7 +45,10 @@ body{font-family:var(--body);color:var(--bone-dim);background:var(--bg);overflow
 .btn.crit:hover{filter:brightness(1.08)}
 /* rail: no scrollbar of its own - the page scrollbar handles overflow */
 .rail{grid-column:1;grid-row:1 / 3;background:linear-gradient(180deg,#0c0c0f,#08080a);border-right:1px solid var(--line-soft);
-  display:flex;flex-direction:column;padding:14px 12px;gap:2px}
+  display:flex;flex-direction:column;padding:14px 12px;gap:2px;overflow-y:auto}
+/* bottom breathing room so the browser URL/status tooltip cannot cover the
+   last rail item on hover */
+.rail{padding-bottom:56px}
 .wordmark{font-family:var(--hdr);font-weight:700;font-size:20px;letter-spacing:.02em;line-height:1.15;
   padding:4px 6px 12px;text-align:center;color:var(--bone)}
 .wordmark .m{color:var(--bone-dim)} .wordmark .r{color:var(--crimson)}
-- 
2.25.1

