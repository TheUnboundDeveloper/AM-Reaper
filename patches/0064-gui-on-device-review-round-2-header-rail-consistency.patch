+      <div class="pill"><span class="k">Mesh Nodes</span><span class="v mono" id="p_mesh">0</span></div>
+    </div>
     <span class="spacer"></span>
     <a class="btn" href="/Main_ReaperDash.asp">Dashboard</a>
     <button class="btn" type="button" id="btn_reboot">Reboot</button>
@@ -285,6 +307,44 @@ window.addEventListener("hashchange",function(){var p=(location.hash||"").replac
     },1000);
   });
 })();
+
+/* topbar status pills - same data set as the Main_ReaperDash header, so every
+   page shows an identical live header (WAN / Mode / Uptime / Firmware / Clients
+   / Mesh). ASCII-only per the www minifier rule. */
+(function(){
+  function $t(id,v){var e=$id(id); if(e&&v!=null&&v!=='') e.textContent=v;}
+  function p2(n){return n<10?'0'+n:''+n;}
+  /* firmware */
+  var fw=('<% nvram_get("firmver"); %>').replace(/\./g,'')+'.'+'<% nvram_get("buildno"); %>';
+  var ext='<% nvram_get("extendno"); %>';
+  if(ext && ext!=='0'){ ext=ext.charAt(0).toUpperCase()+ext.slice(1); fw+='_'+ext; }
+  if(fw.length>2) $t('p_fw', fw);
+  /* WAN state: connected = wan0_state_t==2 with a real IP */
+  var wSt='<% nvram_get("wan0_state_t"); %>', wIP='<% nvram_get("wan0_ipaddr"); %>';
+  var up=(wSt==='2' && wIP && wIP!=='0.0.0.0');
+  $t('p_wan', up?'Connected':'Disconnected');
+  var dot=$id('p_wan_dot'); if(dot && !up){ dot.style.background='#E10600'; dot.style.boxShadow='0 0 0 3px rgba(225,6,0,.15)'; }
+  /* operation mode */
+  var opNames={rt:'Wireless Router',ap:'Access Point',rp:'Repeater',mb:'Media Bridge',ew2:'Express Way',ew5:'Express Way',hs:'Hotspot',wisp:'WISP'};
+  var op=[<% get_operation_mode(); %>][0];
+  $t('i_opmode', opNames[op]||String(op||'').toUpperCase());
+  /* uptime (client-side ticked) */
+  function relSec(s){var d=0,h=0,m=0,sec=0;var dm=s.match(/(\d+)\s*day/);if(dm)d=+dm[1];var tm=s.match(/(\d+):(\d+):(\d+)/);if(tm){h=+tm[1];m=+tm[2];sec=+tm[3];}return d*86400+h*3600+m*60+sec;}
+  var ups=String("<% sysuptime(); %>").replace(/\s*since boot\s*$/i,'').trim();
+  var up0=relSec(ups), t0=Date.now();
+  function upTick(){var s=up0+Math.floor((Date.now()-t0)/1000);var d=Math.floor(s/86400),h=Math.floor(s%86400/3600),m=Math.floor(s%3600/60);$t('p_uptime', d+'d '+p2(h)+':'+p2(m));}
+  if(up0>0){ upTick(); setInterval(upTick,20000); }
+  /* clients + mesh via hooks (best-effort) */
+  try{
+    var cl=httpApi.hookGet('get_clientlist', true);
+    if(cl){var n=0,ml=cl.maclist||[];
+      if(ml.length){for(var i=0;i<ml.length;i++){var c=cl[ml[i]];if(c&&c.isOnline=='1')n++;}}
+      else{for(var k in cl){if(k!=='maclist'&&cl[k]&&cl[k].isOnline=='1')n++;}}
+      $t('p_clients', String(n));}
+    var cfg=httpApi.hookGet('get_cfg_clientlist', true);
+    if(cfg && cfg.length) $t('p_mesh', String(Math.max(0,cfg.length-1)));
+  }catch(e){}
+})();
 </script>
