index 0000000000..bba5c99071
--- /dev/null
+++ b/release/src/router/httpd/reaper_inject.c
@@ -0,0 +1,186 @@
+/*
+ * reaper_inject.c - serve-time injection of the reaper theme.
+ *
+ * MERGEABILITY: instead of baking a theme <link>+bounce block into the <head>
+ * of ~165 stock .asp pages (a per-page edit that conflicts on every upstream
+ * GPL drop), we inject that block from ONE place at serve time. Stock pages
+ * revert to pristine upstream and merge cleanly; all reaper theme logic lives
+ * in new files (this file + www/reaper/reaper_content.css) behind a single
+ * one-line hook in httpd.c.
+ *
+ * reaper_output() wraps mime_handler->output(). For text/html responses (and
+ * not the excluded chrome/login pages) it interposes a streaming filter
+ * (fopencookie) between the page generator (do_ej / do_*_ej) and the socket
+ * FILE*, emitting the reaper block exactly once immediately before the first
+ * </head>. Because do_ej serves every .asp/.htm INCLUDING the deeply nested
+ * SDN/MLO SPA docs (sdn.html/mlo.html), the theme now reaches every iframe
+ * depth uniformly.
+ *
+ * Safety: fail-open (any allocation failure -> unfiltered stock output) and
+ * gated by nvram 'reaper_inject' (default on; set to 0 + restart_httpd to serve
+ * pristine stock UI without reflashing).
+ */
+#define _GNU_SOURCE
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <strings.h>
+#include <ctype.h>
+#include <sys/types.h>
+
+#include <bcmnvram.h>
+#include <httpd.h>
+
+#include "reaper_inject.h"
+
+/* The exact block that used to be baked before </head> in every stock page. */
+static const char REAPER_BLOCK[] =
+	"<link rel=\"stylesheet\" type=\"text/css\" href=\"/reaper/reaper_content.css\">"
+	"<script>if(self===top){var rp=location.pathname.split(\"/\").pop()||\"index.asp\";"
+	"location.replace(rp===\"index.asp\"?\"/Main_ReaperDash.asp\":"
+	"\"/reaper_shell.asp#\"+rp+location.search);}</script>";
+
+#define REAPER_TAG	"</head>"
+#define REAPER_TAGLEN	7		/* strlen("</head>") */
+
+/*
+ * Pages that must NOT receive the bounce: the shell and dashboard are the
+ * redirect targets (bouncing them loops), and the login pages must not redirect.
+ * Matched on basename, case-insensitive.
+ */
+static const char *reaper_skip[] = {
+	"Main_ReaperDash.asp",
+	"reaper_shell.asp",
+	"Main_Login.asp",
+	"Nologin.asp",
+	/* Captive_Portal* embed a </head> INSIDE a <script> splash template before
+	   the real </head>; injecting at the first </head> would land inside the
+	   script and prematurely close it. They are the only multi-</head> pages, so
+	   skip them (guest-facing splash renders stock). */
+	"Captive_Portal.asp",
+	"Captive_Portal_Advanced.asp",
+	NULL
+};
+
+struct reaper_filt {
+	FILE	*dst;			/* the real socket stream (conn_fp) */
+	int	 done;			/* block already injected */
+	int	 hlen;			/* bytes currently held (a </head> prefix) */
+	char	 hold[REAPER_TAGLEN];
+};
+
+static int reaper_should_inject(struct mime_handler *h, const char *file)
+{
+	const char *b, *v;
+	int i;
+
+	/* runtime kill-switch: unset/nonzero = inject, explicit "0" = skip */
+	v = nvram_get("reaper_inject");
+	if (v && *v && atoi(v) == 0)
+		return 0;
+
+	/* only text/html; this alone excludes state.js, **.js/json/xml/css */
+	if (!h || !h->mime_type || strncasecmp(h->mime_type, "text/html", 9) != 0)
+		return 0;
+	if (!file)
+		return 0;
+
+	b = strrchr(file, '/');
+	b = b ? b + 1 : file;
+	for (i = 0; reaper_skip[i]; i++)
+		if (strcasecmp(b, reaper_skip[i]) == 0)
+			return 0;
+
+	return 1;
+}
+
+/*
+ * fopencookie write hook. Streams the generator's output to st->dst, injecting
+ * REAPER_BLOCK once immediately before the first </head> (case-insensitive),
+ * tolerant of </head> split across write() calls and of false starts. Note that
+ * "</head>" has no repeating prefix (empty KMP border), so on any mismatch the
+ * correct recovery is to flush all held bytes and restart the match at the
+ * current byte.
+ */
+static ssize_t reaper_cookie_write(void *cookie, const char *buf, size_t size)
+{
+	struct reaper_filt *st = (struct reaper_filt *)cookie;
+	size_t i;
+
+	for (i = 0; i < size; i++) {
+		unsigned char c = (unsigned char)buf[i];
+
+		if (st->done) {
+			fputc(c, st->dst);
+			continue;
+		}
+
+		if (tolower(c) == tolower((unsigned char)REAPER_TAG[st->hlen])) {
+			st->hold[st->hlen++] = (char)c;
+			if (st->hlen == REAPER_TAGLEN) {	/* full </head> held */
+				fwrite(REAPER_BLOCK, 1, sizeof(REAPER_BLOCK) - 1, st->dst);
+				fwrite(st->hold, 1, REAPER_TAGLEN, st->dst);
+				st->done = 1;
+				st->hlen = 0;
+			}
+			continue;
+		}
+
+		/* mismatch: flush the held prefix, then this byte may start a fresh one */
+		if (st->hlen > 0) {
+			fwrite(st->hold, 1, st->hlen, st->dst);
+			st->hlen = 0;
+		}
+		if (tolower(c) == tolower((unsigned char)REAPER_TAG[0]))
+			st->hold[st->hlen++] = (char)c;
+		else
+			fputc(c, st->dst);
+	}
+
+	return (ssize_t)size;
+}
+
+static int reaper_cookie_close(void *cookie)
+{
+	struct reaper_filt *st = (struct reaper_filt *)cookie;
+
+	/* a partial </head> prefix stranded at EOF was never a real tag: emit it */
+	if (!st->done && st->hlen > 0)
+		fwrite(st->hold, 1, st->hlen, st->dst);
+	return 0;
+}
+
+void reaper_output(struct mime_handler *handler, char *file, FILE *conn_fp)
+{
+	struct reaper_filt st;
+	cookie_io_functions_t io;
+	FILE *filt;
+
+	if (!handler || !handler->output)
+		return;
+
+	if (!reaper_should_inject(handler, file)) {
+		handler->output(file, conn_fp);
+		return;
+	}
+
+	st.dst  = conn_fp;
+	st.done = 0;
+	st.hlen = 0;
+
+	memset(&io, 0, sizeof(io));
+	io.write = reaper_cookie_write;
+	io.close = reaper_cookie_close;
+
+	filt = fopencookie(&st, "w", io);
+	if (!filt) {				/* fail-open: serve unfiltered stock output */
+		handler->output(file, conn_fp);
+		return;
+	}
+	setvbuf(filt, NULL, _IONBF, 0);		/* stream through per generator write */
+
+	handler->output(file, filt);		/* do_ej / do_*_ej write through us */
+
+	fflush(filt);
+	fclose(filt);				/* frees filt only; conn_fp is untouched */
+}
