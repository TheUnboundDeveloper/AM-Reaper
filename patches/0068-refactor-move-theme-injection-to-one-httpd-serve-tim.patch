--- /dev/null
+++ b/release/src/router/httpd/reaper_inject.h
@@ -0,0 +1,16 @@
+#ifndef _REAPER_INJECT_H_
+#define _REAPER_INJECT_H_
+
+#include <stdio.h>
+
+struct mime_handler;	/* full definition in httpd.h */
+
+/*
+ * Serve-time reaper theme injection. Wraps mime_handler->output() so the reaper
+ * theme <link> + shell "bounce" is emitted once before the last </head> of every
+ * text/html response - replacing the per-page inline edits baked into ~165 stock
+ * .asp files, so those pages stay pristine and merge cleanly against upstream.
+ */
+void reaper_output(struct mime_handler *handler, char *file, FILE *conn_fp);
+
+#endif	/* _REAPER_INJECT_H_ */
