+/* self-hosted fonts (offline; no CDN) */
+@font-face{font-family:'Rajdhani';font-weight:500;font-display:swap;src:url('/fonts/rajdhani-500.woff2') format('woff2')}
+@font-face{font-family:'Rajdhani';font-weight:600;font-display:swap;src:url('/fonts/rajdhani-600.woff2') format('woff2')}
+@font-face{font-family:'Rajdhani';font-weight:700;font-display:swap;src:url('/fonts/rajdhani-700.woff2') format('woff2')}
+@font-face{font-family:'Inter';font-weight:400;font-display:swap;src:url('/fonts/inter-400.woff2') format('woff2')}
+@font-face{font-family:'Inter';font-weight:500;font-display:swap;src:url('/fonts/inter-500.woff2') format('woff2')}
+@font-face{font-family:'Inter';font-weight:600;font-display:swap;src:url('/fonts/inter-600.woff2') format('woff2')}
+:root{
+  --bg:#08080a; --panel:#0f0f12; --panel-2:#141418;
+  --line:rgba(225,6,0,.16); --line-soft:rgba(255,255,255,.06);
+  --crimson:#E10600; --crimson-deep:#B3000C; --crimson-dim:#7A0C0C;
+  --bone:#ECE7DB; --bone-dim:#B7B1A4; --steel:#71767b;
+  --jade:#4FB286; --amber:#E0A93B;
+  --hdr:'Rajdhani','Oswald',system-ui,sans-serif;
+  --body:'Inter',system-ui,-apple-system,Segoe UI,sans-serif;
+}
+*{box-sizing:border-box}
+html,body{margin:0;min-height:100%}
+html{scrollbar-width:thin;scrollbar-color:var(--crimson) #000}
+::-webkit-scrollbar{width:12px;height:12px}
+::-webkit-scrollbar-track{background:#000}
+::-webkit-scrollbar-thumb{background:var(--crimson);border-radius:8px;border:2px solid #000}
+::-webkit-scrollbar-thumb:hover{background:var(--crimson-deep)}
+body.wrapper{
+  font-family:var(--body);color:var(--bone-dim);background:var(--bg);
+  background-image:
+    radial-gradient(1200px 500px at 18% -10%,rgba(225,6,0,.10),transparent 60%),
+    radial-gradient(900px 600px at 120% 120%,rgba(225,6,0,.06),transparent 55%),
+    radial-gradient(100% 100% at 50% 40%,transparent 55%,rgba(0,0,0,.55) 100%);
+  -webkit-font-smoothing:antialiased;
+  min-height:100vh;display:flex;padding:24px 12px;
+}
+body.wrapper::after{content:"";position:fixed;inset:0;pointer-events:none;opacity:.035;z-index:9;
+  background-image:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='140' height='140'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='2'/></filter><rect width='100%25' height='100%25' filter='url(%23n)'/></svg>")}
+form[name="form"]{margin:auto}
+/* stock table-div structure recast as one centered card */
+.div_table{display:block}
+.div_td{display:block}
+.main_field_gap{margin:0;width:min(480px,94vw)}
+.div_tr{display:block;position:relative;overflow:hidden;border-radius:14px;
+  background:linear-gradient(180deg,var(--panel-2),var(--panel));
+  border:1px solid var(--line-soft);padding:30px 34px 34px;
+  box-shadow:0 18px 50px rgba(0,0,0,.5)}
+.div_tr::before{content:"";position:absolute;left:0;top:0;height:2px;width:100%;
+  background:linear-gradient(90deg,var(--crimson),transparent 40%)}
+/* header: REAPER wordmark over the sign-in title */
+.title_name{display:flex;flex-direction:column;align-items:center;gap:14px}
+.img_gap{padding:0}
+.login_img{width:340px;height:36px;background:url('images/REAPER.png') center/contain no-repeat}
+.signin_hint{font-family:var(--hdr);font-weight:600;font-size:19px;letter-spacing:.24em;
+  text-transform:uppercase;color:var(--bone);padding-left:.24em}
+.prod_madelName{margin:8px 0 0;text-align:center;font-family:var(--hdr);font-weight:600;
+  font-size:12px;letter-spacing:.26em;text-transform:uppercase;color:var(--steel);padding-left:.26em}
+.p1{width:auto;margin:0;color:var(--bone-dim);font-size:13px;line-height:1.5}
+.title_gap{margin:22px 0 0}
+.password_gap{margin:14px 0 0}
+.form_input{display:block;width:100%;height:auto;background:#000;
+  border:1px solid var(--line-soft);border-radius:8px;color:var(--bone);
+  padding:12px 13px;font-family:var(--body);font-size:14px;outline:none;transition:border-color .15s}
+.form_input:focus{border-color:rgba(225,6,0,.45)}
+.form_input::placeholder{color:var(--steel)}
+.button{float:none;width:100%;height:46px;line-height:46px;margin:24px 0 0;
+  border-radius:8px;text-align:center;cursor:pointer;
+  font-family:var(--hdr);font-weight:600;font-size:14px;letter-spacing:.14em;text-transform:uppercase;
+  color:#fff;background:linear-gradient(180deg,var(--crimson),var(--crimson-deep));
+  border:1px solid var(--crimson-dim);transition:filter .15s}
+.button:hover{filter:brightness(1.08)}
+.button.disabled{filter:grayscale(100%) opacity(.5);pointer-events:none}
+.error_hint{margin:12px 0 0;color:var(--amber);font-size:12px;line-height:1.5}
+.error_hint1{margin:18px 0 0;font-size:15px;line-height:1.55;width:auto}
+.error_hint a,.error_hint1 a{color:var(--amber)!important}
+.warming_desc{margin:12px 0 0;width:auto;color:var(--amber);font-size:12px;line-height:1.5}
+.nologin{margin:20px 0 0;width:auto;padding:18px;border-radius:10px;
+  background:rgba(255,255,255,.02);border:1px solid var(--line-soft);
+  color:var(--bone-dim);font-size:14px;line-height:1.55}
+.nologin a{color:var(--bone)!important}
+/* captcha row */
+#captcha_field{overflow:hidden}
+#captcha_input_div{float:left;margin:16px 12px 0 0}
+#captcha_text{width:150px;height:auto;background:#000;border:1px solid var(--line-soft);
+  border-radius:8px;color:var(--bone);padding:12px 13px;font-size:20px;letter-spacing:.2em;
+  font-family:var(--body);outline:none}
+#captcha_text:focus{border-color:rgba(225,6,0,.45)}
+#captcha_img_div{float:left;margin:16px 0 0;width:150px;height:52px;border-radius:8px;background:#FFF;overflow:hidden}
+#captcha_pic{width:100%;height:100%;margin:0;object-fit:contain}
+#reCaptcha{float:left;margin:28px 0 0 12px;width:30px;height:30px;cursor:pointer;opacity:.7;
+  background-image:url("data:image/svg+xml;charset=US-ASCII,%3C%3Fxml%20version%3D%221.0%22%20encoding%3D%22iso-8859-1%22%3F%3E%0A%3C!DOCTYPE%20svg%20PUBLIC%20%22-%2F%2FW3C%2F%2FDTD%20SVG%201.1%2F%2FEN%22%20%22http%3A%2F%2Fwww.w3.org%2FGraphics%2FSVG%2F1.1%2FDTD%2Fsvg11.dtd%22%3E%0A%3Csvg%20version%3D%221.1%22%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20xmlns%3Axlink%3D%22http%3A%2F%2Fwww.w3.org%2F1999%2Fxlink%22%20width%3D%2232%22%20height%3D%2232%22%20viewBox%3D%220%200%2032%2032%22%3E%0A%3Cpath%20fill%3D%22%23ABB2BB%22%20d%3D%22M31.638%2022.702c-0.181-0.664-0.906-0.604-1.509-0.785l-1.208-0.423c0.966-1.992%201.087-3.321%201.087-5.555%200-8.211-6.642-14.853-14.853-14.853s-14.853%206.702-14.853%2014.913%206.641%2014.853%2014.853%2014.853c0.664%200%201.208-0.543%201.208-1.208s-0.543-1.208-1.208-1.208c-6.823%200-12.438-5.555-12.438-12.438s5.615-12.438%2012.438-12.438%2012.438%205.555%2012.438%2012.438c0%201.872-0.060%202.838-0.845%204.528l-0.906-0.785c-0.604-0.423-0.906-0.966-1.509-0.785-0.664%200.181-0.966%200.906-0.785%201.509l1.449%204.408c0.181%200.543%200.664%200.845%201.147%200.845%200.121%200%200.241%200%200.362-0.060l4.408-1.449c0.604-0.181%200.966-0.845%200.725-1.509v0z%22%3E%3C%2Fpath%3E%0A%3C%2Fsvg%3E%0A");
+  background-repeat:no-repeat;background-size:26px}
+#reCaptcha:hover{opacity:1}
+@media screen and (max-width:480px){
+  .div_tr{padding:24px 18px 26px}
+  .login_img{width:260px;height:28px}
+  .signin_hint{font-size:16px}
+  #captcha_text{width:120px}
+  #captcha_img_div{width:120px}
 }
