 #endif
 
 /* OPPO */
@@ -3006,4 +3013,97 @@ int start_hwqos(void)
 
 	return 0;
 }
+
+/*
+ * Hardware-accelerated classful QoS (upload).
+ *
+ * Extends start_hwqos() from one shaped queue to per-class egress queues on
+ * the WAN port. Classification reuses the Traditional QoS engine untouched:
+ * add_qos_rules() CONNMARKs each connection with its class (1..5 from rule
+ * prio 0..4 = highest..lowest; 6 = LAN/multicast) and restores it to
+ * skb->mark bits [2:0] on egress. Those bits are the Broadcom SKBMARK queue
+ * field (bcm_skb_defines.h), which the flow cache records into the Runner
+ * flow entry at flow-creation time, so hardware-accelerated flows egress
+ * through the queue matching their class: class N -> WAN egress qid N.
+ * Unclassified traffic (mark 0) uses qid 0.
+ *
+ * Each class queue gets PI2 AQM plus a shaper cap taken from the class ceil
+ * percentage in qos_orates ("rate-ceil,..." per prio, T.QoS format) applied
+ * to qos_obw; qid 0 and qid 6 are capped at the full qos_obw. The egress TM
+ * has no port-aggregate shaper, so strict aggregate control needs class
+ * ceils that sum to <= 100%.
+ *
+ * Like plain HW QoS this keeps the flow accelerator ENABLED (exempted from
+ * fc_disable/runner_disable in hnd_nat_ac_init()). Upload only: download
+ * egresses per-LAN/WLAN-port and cannot be aggregate-shaped here (use Cake).
+ * Ordering matters: setqdropalg rewrites the queue config and clears the
+ * shaper, so the drop algorithm MUST be programmed before the shaper.
+ */
+int start_hwqos_classful(void)
+{
+	FILE *f;
+	unsigned int obw, rate, ceil, cap;
+	int i, qid;
+	char *buf, *g, *p;
+	const char *wan_ifname = get_wan_ifname(wan_primary_ifunit());
+	const char *q;
+
+	obw = strtoul(nvram_safe_get("qos_obw"), NULL, 10);
+
+	/* same shell-safety guard as start_hwqos: wan_ifname is single-quoted in
+	 * the generated root script; reject anything that isn't a plain interface
+	 * name and fall back to an empty (inert) WANIF rather than emit it. */
+	for (q = wan_ifname; *q; q++) {
+		if (!((*q >= 'a' && *q <= 'z') || (*q >= 'A' && *q <= 'Z') ||
+		      (*q >= '0' && *q <= '9') || *q == '.' || *q == '_' || *q == '-')) {
+			wan_ifname = "";
+			break;
+		}
+	}
+
+	if ((f = fopen(qosfn, "w")) == NULL) return -2;
+
+	fprintf(f,
+		"#!/bin/sh\n"
+		"WANIF='%s'\n\n"
+		"case \"$1\" in\n"
+		"start)\n",
+		wan_ifname
+	);
+
+	/* class queues 1..5: PI2 + ceil% of OBW from qos_orates (prio order 0..4) */
+	g = buf = strdup(nvram_safe_get("qos_orates"));
+	for (i = 0; i < 5; ++i) {
+		if ((!g) || ((p = strsep(&g, ",")) == NULL)) break;
+		if (sscanf(p, "%u-%u", &rate, &ceil) != 2) continue;
+		qid = i + 1;
+		cap = (ceil >= 1 && ceil < 100) ? calc(obw, ceil) : obw;
+		fprintf(f, "\ttmctl setqdropalg --devtype 0 --if $WANIF --qid %d --dropalg 4\n", qid);
+		if (cap > 0)
+			fprintf(f, "\ttmctl setqshaper --devtype 0 --if $WANIF --qid %d --shapingrate %u\n", qid, cap);
+	}
+	free(buf);
+
+	/* qid 0 (unclassified) and qid 6 (LAN/multicast class): PI2 + full OBW cap */
+	fprintf(f, "\ttmctl setqdropalg --devtype 0 --if $WANIF --qid 0 --dropalg 4\n");
+	fprintf(f, "\ttmctl setqdropalg --devtype 0 --if $WANIF --qid 6 --dropalg 4\n");
+	if (obw > 0) {
+		fprintf(f, "\ttmctl setqshaper --devtype 0 --if $WANIF --qid 0 --shapingrate %u\n", obw);
+		fprintf(f, "\ttmctl setqshaper --devtype 0 --if $WANIF --qid 6 --shapingrate %u\n", obw);
+	}
+
+	fprintf(f, "\t;;\nstop)\n");
+	for (qid = 0; qid <= 6; qid++) {
+		fprintf(f, "\ttmctl setqshaper  --devtype 0 --if $WANIF --qid %d --shapingrate 0\n", qid);
+		fprintf(f, "\ttmctl setqdropalg --devtype 0 --if $WANIF --qid %d --dropalg 0\n", qid);
+	}
+	fprintf(f, "\t;;\n*)\nesac\n");
+
+	fclose(f);
+	chmod(qosfn, 0755);
+	run_custom_script("qos-start", 120, "init", NULL);
+	eval((char *)qosfn, "start");
+
+	return 0;
+}
 #endif
