From 5e96d4f2f1cdfd83b539708e58da6aea4e3650f4 Mon Sep 17 00:00:00 2001
From: reaper <theunbounddeveloper@outlook.com>
Date: Mon, 6 Jul 2026 18:59:08 -0400
Subject: [PATCH] www: hide unused overhead/Mode row under HW QoS; login page
 polish

- QoS_EZQoS.asp: the init path re-showed qos_overhead_tr for any codel-capable
  build when qos_type != 1, overriding the change_qos_type() hide for the
  hardware types; exclude 10/11 (overhead/MPU are not used by the hw shaper).
- Main_Login.asp: drop the Sign_in_title line (ASUS account wording); enlarge
  the REAPER wordmark 340x36 -> 400x42 (300x32 narrow) with max-width:100%
  so it can never exceed the card. Same header serves the logout view.

Co-Authored-By: Claude Fable 5 <noreply@anthropic.com>
---
 release/src/router/www/Main_Login.asp | 6 ++----
 release/src/router/www/QoS_EZQoS.asp  | 2 +-
 2 files changed, 3 insertions(+), 5 deletions(-)

diff --git a/release/src/router/www/Main_Login.asp b/release/src/router/www/Main_Login.asp
index 04901552c9..104d377913 100644
--- a/release/src/router/www/Main_Login.asp
+++ b/release/src/router/www/Main_Login.asp
@@ -60,7 +60,7 @@ form[name="form"]{margin:auto}
 /* header: REAPER wordmark over the sign-in title */
 .title_name{display:flex;flex-direction:column;align-items:center;gap:14px}
 .img_gap{padding:0}
-.login_img{width:340px;height:36px;background:url('images/REAPER.png') center/contain no-repeat}
+.login_img{width:400px;max-width:100%;height:42px;background:url('images/REAPER.png') center/contain no-repeat}
 .signin_hint{font-family:var(--hdr);font-weight:600;font-size:19px;letter-spacing:.24em;
   text-transform:uppercase;color:var(--bone);padding-left:.24em}
 .prod_madelName{margin:8px 0 0;text-align:center;font-family:var(--hdr);font-weight:600;
@@ -103,7 +103,7 @@ form[name="form"]{margin:auto}
 #reCaptcha:hover{opacity:1}
 @media screen and (max-width:480px){
   .div_tr{padding:24px 18px 26px}
-  .login_img{width:260px;height:28px}
+  .login_img{width:300px;height:32px}
   .signin_hint{font-size:16px}
   #captcha_text{width:120px}
   #captcha_img_div{width:120px}
@@ -608,8 +608,6 @@ const sha256 = function a(b){function c(a,b){return a>>>b|a<<32-b}for(var d,e,f=
 
 		<!-- Login field -->
 		<div id="login_filed">
-			<div class="p1 title_gap"><#Sign_in_title#></div>
-
 			<div id="name_title_ie" style="display:none;margin:20px 0 -10px 78px;" class="p1 title_gap"><#Username#></div>
 			<div class="title_gap">
 				<input type="text" id="login_username" name="login_username" tabindex="1" class="form_input" maxlength="128" autocapitalize="off" autocomplete="off" placeholder="<#Username#>">
diff --git a/release/src/router/www/QoS_EZQoS.asp b/release/src/router/www/QoS_EZQoS.asp
index e289097c24..3b93fe814c 100644
--- a/release/src/router/www/QoS_EZQoS.asp
+++ b/release/src/router/www/QoS_EZQoS.asp
@@ -470,7 +470,7 @@
                 } else
                     show_settings("NonAdaptive");
 
-                if ((cake_support && (qos_type == 9)) || (codel_support && (qos_type != 1))) {
+                if ((cake_support && (qos_type == 9)) || (codel_support && (qos_type != 1 && qos_type != 10 && qos_type != 11))) {	// overhead/MPU are not used by the hardware shaper (10/11)
                     document.getElementById('qos_overhead_tr').style.display = "";
                 }
                 if ((cake_support) && (qos_type == 9)) {
-- 
