From 5a26f235ab06eb52e7e3a4fc92223fff3ef83d7b Mon Sep 17 00:00:00 2001
From: reaper <theunbounddeveloper@outlook.com>
Date: Mon, 6 Jul 2026 23:24:10 -0400
Subject: [PATCH] www: rename type 11 to HW QoS Classful; dashboard knows type
 11

The dashboard qosModes map lacked 11 and fell back to "Type 11".

Co-Authored-By: Claude Fable 5 <noreply@anthropic.com>
---
 release/src/router/www/Main_ReaperDash.asp | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/release/src/router/www/Main_ReaperDash.asp b/release/src/router/www/Main_ReaperDash.asp
index aef92977c10..5ff9e97dd99 100644
--- a/release/src/router/www/Main_ReaperDash.asp
+++ b/release/src/router/www/Main_ReaperDash.asp
@@ -589,9 +589,9 @@ function cap(s){return s? s.charAt(0).toUpperCase()+s.slice(1):s;}
     setTag('s_upnp_tag', upnpOn?'Enabled':'Disabled', upnpOn?'warn':'ok'); setTxt('s_upnp_sub', upnpOn?'Auto port-mapping on':'No auto port-mapping');
     setTag('s_wps_tag', wpsOn?'Enabled':'Disabled', wpsOn?'warn':'ok'); setTxt('s_wps_sub', wpsOn?'Push-button pairing on':'Pairing disabled');
 
-    /* QoS: qos_enable + qos_type (0 Traditional / 1 Adaptive / 2 Bandwidth Limiter / 9 Cake / 10 Hardware) */
+    /* QoS: qos_enable + qos_type (0 Traditional / 1 Adaptive / 2 Bandwidth Limiter / 9 Cake / 10 Hardware / 11 HW Classful) */
     var qosOn=(SSI.qos_en==='1');
-    var qosModes={'0':'Traditional QoS','1':'Adaptive QoS','2':'Bandwidth Limiter','9':'Cake','10':'Hardware QoS'};
+    var qosModes={'0':'Traditional QoS','1':'Adaptive QoS','2':'Bandwidth Limiter','9':'Cake','10':'Hardware QoS','11':'HW QoS Classful'};
     setTag('s_qos_tag', qosOn?'Enabled':'Disabled', 'ok');
     setTxt('s_qos_sub', qosOn ? (qosModes[SSI.qos_type]||('Type '+SSI.qos_type)) : 'No traffic shaping');
     setTag('s_dos_tag', dosOn?'On':'Off', dosOn?'ok':'warn'); setTxt('s_dos_sub', dosOn?'SYN-flood / port-scan guard':'Not enabled');
-- 
