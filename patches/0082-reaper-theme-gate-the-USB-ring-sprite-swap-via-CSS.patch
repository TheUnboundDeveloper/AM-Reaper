From 0010cead648a0d5059d1079f862e26123f83f516 Mon Sep 17 00:00:00 2001
From: reaper <theunbounddeveloper@outlook.com>
Date: Mon, 6 Jul 2026 23:24:09 -0400
Subject: [PATCH] reaper: theme-gate the USB ring sprite swap via CSS

Move the white_04 -> white_05 swap out of the stock pages (reverted to
pristine, preserving the kill-switch/mergeability invariant) and into
reaper_content.css ([id^=ring_USBdisk] background-image override, beats
the inline style). Theme on = user-authored white_05, theme off = stock
white_04. The sprite is hand-made artwork - never filter/recolor it.

Co-Authored-By: Claude Fable 5 <noreply@anthropic.com>
---
 release/src/router/www/device-map/disk_format.asp  | 4 ++--
 release/src/router/www/device-map/disk_utility.asp | 8 ++++----
 release/src/router/www/index.asp                   | 2 +-
 release/src/router/www/reaper/reaper_content.css   | 6 ++++++
 4 files changed, 13 insertions(+), 7 deletions(-)

diff --git a/release/src/router/www/device-map/disk_format.asp b/release/src/router/www/device-map/disk_format.asp
index bf177bf782..9869146330 100644
--- a/release/src/router/www/device-map/disk_format.asp
+++ b/release/src/router/www/device-map/disk_format.asp
@@ -282,7 +282,7 @@ function showLoadingUpdate(){
 				document.getElementById('progress_bar_no').innerHTML = progressBar + "%";
 				document.getElementById('scan_message').innerHTML = "Disk format error!";
 				if(!parent.rog_support) {
-					parent.document.getElementById('ring_USBdisk_'+diskOrder).style.backgroundImage = "url(/images/New_ui/networkmap/white_05.gif)";
+					parent.document.getElementById('ring_USBdisk_'+diskOrder).style.backgroundImage = "url(/images/New_ui/networkmap/white_04.gif)";
 					parent.document.getElementById('ring_USBdisk_'+diskOrder).style.backgroundPosition = '0px -184px';
 					parent.document.getElementById('iconUSBdisk_'+diskOrder).style.backgroundPosition = '1px -206px';
 				}
@@ -299,7 +299,7 @@ function showLoadingUpdate(){
 				document.getElementById('scan_status_field').style.display = "";
 				document.getElementById('btn_format').disabled = false;
 				if(!parent.rog_support) {
-					parent.document.getElementById('ring_USBdisk_'+diskOrder).style.backgroundImage = "url(/images/New_ui/networkmap/white_05.gif)";
+					parent.document.getElementById('ring_USBdisk_'+diskOrder).style.backgroundImage = "url(/images/New_ui/networkmap/white_04.gif)";
 					parent.document.getElementById('ring_USBdisk_'+diskOrder).style.backgroundPosition = '0% 0%';
 				}
 				else
diff --git a/release/src/router/www/device-map/disk_utility.asp b/release/src/router/www/device-map/disk_utility.asp
index 92c5e7f4d6..bd83a9dd9a 100644
--- a/release/src/router/www/device-map/disk_utility.asp
+++ b/release/src/router/www/device-map/disk_utility.asp
@@ -382,7 +382,7 @@ function check_status(_device){
 
 		if(stopScan == 1 || scan_done == 1){
 			if(!parent.rog_support)
-				parent.document.getElementById('ring_USBdisk_'+diskOrder).style.backgroundImage = "url(/images/New_ui/networkmap/white_05.gif)";
+				parent.document.getElementById('ring_USBdisk_'+diskOrder).style.backgroundImage = "url(/images/New_ui/networkmap/white_04.gif)";
 			parent.document.getElementById('ring_USBdisk_'+diskOrder).style.backgroundPosition = '0px -184px';
 		}
 		parent.document.getElementById('iconUSBdisk_'+diskOrder).style.backgroundPosition = '1px -206px';
@@ -390,13 +390,13 @@ function check_status(_device){
 	else if(got_code_2){
 		if(stopScan == 1){
 			if(!parent.rog_support)
-				parent.document.getElementById('ring_USBdisk_'+diskOrder).style.backgroundImage = "url(/images/New_ui/networkmap/white_05.gif)";
+				parent.document.getElementById('ring_USBdisk_'+diskOrder).style.backgroundImage = "url(/images/New_ui/networkmap/white_04.gif)";
 			parent.document.getElementById('ring_USBdisk_'+diskOrder).style.backgroundPosition = '0% 0%';
 		}
 	}
 	else if(got_code_3){
 		if(!parent.rog_support)
-			parent.document.getElementById('ring_USBdisk_'+diskOrder).style.backgroundImage = "url(/images/New_ui/networkmap/white_05.gif)";
+			parent.document.getElementById('ring_USBdisk_'+diskOrder).style.backgroundImage = "url(/images/New_ui/networkmap/white_04.gif)";
 		parent.document.getElementById('ring_USBdisk_'+diskOrder).style.backgroundPosition = '0% 0%';
 	}
 	else{ // got_code_0
@@ -406,7 +406,7 @@ function check_status(_device){
 		document.getElementById('scan_status_image').src = "/images/New_ui/networkmap/blue.png";
 		if(stopScan == 1 || scan_done == 1){
 			if(!parent.rog_support)
-				parent.document.getElementById('ring_USBdisk_'+diskOrder).style.backgroundImage = "url(/images/New_ui/networkmap/white_05.gif)";
+				parent.document.getElementById('ring_USBdisk_'+diskOrder).style.backgroundImage = "url(/images/New_ui/networkmap/white_04.gif)";
 
 			parent.document.getElementById('ring_USBdisk_'+diskOrder).style.backgroundPosition = '0px -92px';
 		}
diff --git a/release/src/router/www/index.asp b/release/src/router/www/index.asp
index a63dd1c7ab..86acc56b18 100644
--- a/release/src/router/www/index.asp
+++ b/release/src/router/www/index.asp
@@ -1120,7 +1120,7 @@ function check_status(_device){
 	document.getElementById('iconUSBdisk_'+diskOrder).style.backgroundPosition = '1px -4px';
 	document.getElementById('iconUSBdisk_'+diskOrder).style.backgroundSize = "100%";
 
-	document.getElementById('ring_USBdisk_'+diskOrder).style.backgroundImage = "url(/images/New_ui/networkmap/white_05.gif)";	
+	document.getElementById('ring_USBdisk_'+diskOrder).style.backgroundImage = "url(/images/New_ui/networkmap/white_04.gif)";	
 	document.getElementById('ring_USBdisk_'+diskOrder).style.display = "";
 
 	if(!diskUtility_support)
diff --git a/release/src/router/www/reaper/reaper_content.css b/release/src/router/www/reaper/reaper_content.css
index a8430454eb..86b5f94214 100644
--- a/release/src/router/www/reaper/reaper_content.css
+++ b/release/src/router/www/reaper/reaper_content.css
@@ -244,6 +244,12 @@ div[id$="_Block_PC"],div[id$="_Block_PC"] div,div[id$="_Block_PC"] a{
    circle; force natural size so a plugged drive renders as the same clean circle
    as the empty slot. */
 .iconUSBdisk,.iconM2{background-position:0% 0%!important;background-size:auto!important;filter:none!important}
+/* USB slot ring: swap the stock teal-tile sprite (white_04.gif) for the
+   USER-AUTHORED dark-background recolor (white_05.gif, same 95x276 frame
+   geometry). Theme-gated by construction: this file is only injected when
+   reaper_inject=1, so the stock UI / kill-switch keeps white_04. Do NOT
+   apply any color filter to this sprite - it is hand-made artwork. */
+[id^="ring_USBdisk"]{background-image:url("/images/New_ui/networkmap/white_05.gif")!important}
 .statusbody,.NM_radius_bottom_container{background:#0f0f12!important}
 .statusTitle{background:linear-gradient(180deg,#2a0507,#141418)!important;color:#ECE7DB!important;
   font-family:'Rajdhani','Oswald',system-ui,sans-serif!important;letter-spacing:.08em!important}
