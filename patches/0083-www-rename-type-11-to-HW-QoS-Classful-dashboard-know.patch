From db61546b08eb39fd6396841c21aee5da627dd52a Mon Sep 17 00:00:00 2001
From: reaper <theunbounddeveloper@outlook.com>
Date: Mon, 6 Jul 2026 23:24:10 -0400
Subject: [PATCH] www: rename type 11 to HW QoS Classful; dashboard knows type
 11

The dashboard qosModes map lacked 11 and fell back to "Type 11".

Co-Authored-By: Claude Fable 5 <noreply@anthropic.com>
---
 release/src/router/www/Main_ReaperDash.asp | 4 ++--
 release/src/router/www/QoS_EZQoS.asp       | 6 +++---
 2 files changed, 5 insertions(+), 5 deletions(-)

diff --git a/release/src/router/www/Main_ReaperDash.asp b/release/src/router/www/Main_ReaperDash.asp
index aef92977c1..5ff9e97dd9 100644
--- a/release/src/router/www/Main_ReaperDash.asp
+++ b/release/src/router/www/Main_ReaperDash.asp
@@ -589,9 +589,9 @@ function cap(s){return s? s.charAt(0).toUpperCase()+s.slice(1):s;}
     setTag('s_upnp_tag', upnpOn?'Enabled':'Disabled', upnpOn?'warn':'ok'); setTxt('s_upnp_sub', upnpOn?'Auto port-mapping on':'No auto port-mapping');
     setTag('s_wps_tag', wpsOn?'Enabled':'Disabled', wpsOn?'warn':'ok'); setTxt('s_wps_sub', wpsOn?'Push-button pairing on':'Pairing disabled');
 
-    /* QoS: qos_enable + qos_type (0 Traditional / 1 Adaptive / 2 Bandwidth Limiter / 9 Cake / 10 Hardware) */
+    /* QoS: qos_enable + qos_type (0 Traditional / 1 Adaptive / 2 Bandwidth Limiter / 9 Cake / 10 Hardware / 11 HW Classful) */
     var qosOn=(SSI.qos_en==='1');
-    var qosModes={'0':'Traditional QoS','1':'Adaptive QoS','2':'Bandwidth Limiter','9':'Cake','10':'Hardware QoS'};
+    var qosModes={'0':'Traditional QoS','1':'Adaptive QoS','2':'Bandwidth Limiter','9':'Cake','10':'Hardware QoS','11':'HW QoS Classful'};
     setTag('s_qos_tag', qosOn?'Enabled':'Disabled', 'ok');
     setTxt('s_qos_sub', qosOn ? (qosModes[SSI.qos_type]||('Type '+SSI.qos_type)) : 'No traffic shaping');
     setTag('s_dos_tag', dosOn?'On':'Off', dosOn?'ok':'warn'); setTxt('s_dos_sub', dosOn?'SYN-flood / port-scan guard':'Not enabled');
diff --git a/release/src/router/www/QoS_EZQoS.asp b/release/src/router/www/QoS_EZQoS.asp
index 3b93fe814c..46849f731e 100644
--- a/release/src/router/www/QoS_EZQoS.asp
+++ b/release/src/router/www/QoS_EZQoS.asp
@@ -2257,7 +2257,7 @@
                                                                     </li>
                                                                     <li id="hwqosc_desc_li">
                                                                         <div style="font-weight:bolder;font-size:14px;">
-                                                                            Hardware QoS &mdash; Classful (Upload only)
+                                                                            HW QoS Classful (Upload only)
                                                                         </div>
                                                                         <div>Hardware QoS plus priorities: your QoS rules sort upload traffic into classes, each with its own hardware queue and bandwidth cap &mdash; NAT acceleration stays on. Only upload is shaped &mdash; for download control, use Cake instead.
                                                                         </div>
@@ -2348,7 +2348,7 @@
                                                         <span id="hwqosc_type_wrap" style="white-space:nowrap;"><input id="hwqosc_type" name="qos_type_radio" value="11"
                                                                onClick="change_qos_type(this.value);" style="display: none;" type="radio" <% nvram_match("qos_type", "11","checked"); %>><label
                                                             id="hwqosc_type_label" style="display:none;"
-                                                            for="hwqosc_type">Hardware QoS &mdash; Classful (Upload only)</label></span>
+                                                            for="hwqosc_type">HW QoS Classful (Upload only)</label></span>
                                                     </td>
                                                 </tr>
                                                 <tr id="hwqos_desc_tr" style="display:none">
@@ -2361,7 +2361,7 @@
                                                 <tr id="hwqosc_desc_tr" style="display:none">
                                                     <td colspan="3">
                                                         <div class="formfontdesc" style="color:#FFCC00;line-height:18px;margin:5px 0;">
-                                                            <b>Hardware QoS Classful &mdash; upload only.</b> Adds per-class priority queues to Hardware QoS: your <b>QoS rules</b> (same editor as Traditional QoS) sort upload traffic into up to 5 classes, each mapped to its own hardware egress queue with PI2 queue management and a bandwidth cap from the class ceiling percentages &mdash; still <b>without</b> disabling NAT acceleration. Classification is applied when a connection starts. Enter your <b>upload</b> bandwidth below; class caps are percentages of it (for a strict total limit, keep the ceilings summing to about 100%). <u>Download is not shaped by this mode</u> &mdash; use <b>Cake</b> for download control.
+                                                            <b>HW QoS Classful &mdash; upload only.</b> Adds per-class priority queues to Hardware QoS: your <b>QoS rules</b> (same editor as Traditional QoS) sort upload traffic into up to 5 classes, each mapped to its own hardware egress queue with PI2 queue management and a bandwidth cap from the class ceiling percentages &mdash; still <b>without</b> disabling NAT acceleration. Classification is applied when a connection starts. Enter your <b>upload</b> bandwidth below; class caps are percentages of it (for a strict total limit, keep the ceilings summing to about 100%). <u>Download is not shaped by this mode</u> &mdash; use <b>Cake</b> for download control.
                                                         </div>
                                                     </td>
                                                 </tr>
-- 
2.25.1

