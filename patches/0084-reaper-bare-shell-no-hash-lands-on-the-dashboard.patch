From dd8b5d0788e21ab6478ed513e50edc9275087830 Mon Sep 17 00:00:00 2001
From: reaper <theunbounddeveloper@outlook.com>
Date: Mon, 6 Jul 2026 23:24:11 -0400
Subject: [PATCH] reaper: bare shell (no #hash) lands on the dashboard

Post-login redirect to reaper_shell.asp loses the #fragment (never sent
to the server), so the shell opened its DEFAULT_PAGE network map. No
target now redirects to Main_ReaperDash.asp - dashboard is the landing
page on every login path.

Co-Authored-By: Claude Fable 5 <noreply@anthropic.com>
---
 release/src/router/www/reaper_shell.asp | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/release/src/router/www/reaper_shell.asp b/release/src/router/www/reaper_shell.asp
index e9ec5eca85..a7d38e294b 100644
--- a/release/src/router/www/reaper_shell.asp
+++ b/release/src/router/www/reaper_shell.asp
@@ -249,7 +249,10 @@ function buildRail(menuTree){
     });
   }
   var initial=(location.hash||'').replace('#','');
-  loadPage(initial || DEFAULT_PAGE);
+  /* no target (e.g. post-login redirect to bare reaper_shell.asp - the #hash
+   * never reaches the server): land on the dashboard, not the network map */
+  if(!initial){ location.replace('/Main_ReaperDash.asp'); return; }
+  loadPage(initial);
 }
 
 /* every page framed by the shell gets the reaper content theme, pilot or not:
-- 
