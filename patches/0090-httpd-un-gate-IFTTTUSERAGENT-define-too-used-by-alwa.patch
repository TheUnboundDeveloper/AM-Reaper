From 4d9f046ea7ee76bb9aa307364e5ebdd1a322fc04 Mon Sep 17 00:00:00 2001
From: reaper <theunbounddeveloper@outlook.com>
Date: Tue, 7 Jul 2026 18:48:04 -0400
Subject: [PATCH] httpd: un-gate IFTTTUSERAGENT define too (used by
 always-compiled add_ifttt_flag)

Follow-up to the web_hook.o blob fix: add_ifttt_flag is now compiled
unconditionally but its IFTTTUSERAGENT constant was still inside the
voice-assistant guard -> httpd.c:883 undeclared. Move just that define
out; GETIFTTTCGI/GETIFTTTOKEN stay guarded.

Co-Authored-By: Claude Fable 5 <noreply@anthropic.com>
---
 release/src/router/httpd/httpd.h | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/release/src/router/httpd/httpd.h b/release/src/router/httpd/httpd.h
index 38e78f92d1..77a7629ea8 100644
--- a/release/src/router/httpd/httpd.h
+++ b/release/src/router/httpd/httpd.h
@@ -195,8 +195,9 @@ struct wl_sync_nvram {
 #define HTTPD_AUTH_V2   1
 
 
-#if defined(RTCONFIG_IFTTT) || defined(RTCONFIG_ALEXA) || defined(RTCONFIG_GOOGLE_ASST)
+/* IFTTTUSERAGENT always defined: add_ifttt_flag (web_hook.o blob dep) uses it */
 #define IFTTTUSERAGENT  "asusrouter-Windows-IFTTT-1.0"
+#if defined(RTCONFIG_IFTTT) || defined(RTCONFIG_ALEXA) || defined(RTCONFIG_GOOGLE_ASST)
 #define GETIFTTTCGI     "get_IFTTTPincode.cgi"
 #define GETIFTTTOKEN "get_IFTTTtoken.cgi"
 #endif
-- 
2.25.1

