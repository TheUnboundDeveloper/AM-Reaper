 release/src/router/httpd/web.c   |   1 -
 release/src/router/rc/firewall.c |  32 --
 release/src/router/rc/services.c |  13 -
 release/src/router/rc/usb.c      | 715 -------------------------------
 5 files changed, 762 deletions(-)

