-/* Returns hash value for header 'name', converting it to lower-case
- * in-place. */
-static inline unsigned int hash_and_lower(char *name)
-{
-    char *pnt;
-    unsigned int hash = 0;
-
-    for (pnt = name; *pnt != '\0'; pnt++) {
-	*pnt = ne_tolower(*pnt);
-	hash = HH_ITERATE(hash,*pnt);
-    }
-
-    return hash;
-}
