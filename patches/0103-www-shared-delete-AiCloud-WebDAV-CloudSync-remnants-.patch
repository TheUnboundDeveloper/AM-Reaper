-
-ne_iaddr_type ne_iaddr_typeof(const ne_inet_addr *ia)
-{
-#if defined(USE_GETADDRINFO) && defined(AF_INET6)
-    return ia->ai_family == AF_INET6 ? ne_iaddr_ipv6 : ne_iaddr_ipv4;
