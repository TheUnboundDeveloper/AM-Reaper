index f122bf55c7..0000000000
--- a/release/src/router/neon/src/ne_compress.c
+++ /dev/null
@@ -1,449 +0,0 @@
-/* 
-   Handling of compressed HTTP responses
-   Copyright (C) 2001-2006, Joe Orton <joe@manyfish.co.uk>
-
