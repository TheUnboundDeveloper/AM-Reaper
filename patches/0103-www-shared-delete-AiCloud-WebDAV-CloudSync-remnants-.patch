-	    ("for `%s': charset unset", ctypes[n].value));
-	
-	ONV(ctypes[n].charset == NULL && ct.charset != NULL,
-	    ("for `%s': unexpected charset `%s'", ctypes[n].value, 
-	     ct.charset));
-
-	ONV(ctypes[n].charset && ct.charset &&
-	    strcmp(ctypes[n].charset, ct.charset),
