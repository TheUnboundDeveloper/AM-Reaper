-          "start-prop[/alpha,/alpha-1,proptwo];cdata-prop[foobar];"
-          "end-prop[proptwo];"
-          "end-pstat[/alpha-1]-status={200 OK};end-resp[/alpha];" }
-
-    };
-    size_t n;
-
-    for (n = 0; n < sizeof(ts)/sizeof(ts[0]); n++)
-        CALL(run_207_response(ts[n][0], ts[n][1]));        
