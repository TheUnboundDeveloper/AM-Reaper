-.SH "NAME"
-ne_status \- HTTP status structure
-.SH "SYNOPSIS"
-.sp
-.ft B
-.nf
-#include <ne_utils\&.h>
-
-typedef struct {
-    int major_version, minor_version;
-    int code, klass;
-    const char *reason_phrase;
-} ne_status;
