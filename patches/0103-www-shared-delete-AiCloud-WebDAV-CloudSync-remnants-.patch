-ssize_t ne_sock_fullread(ne_socket *sock, char *buffer, size_t buflen) 
-{
-    ssize_t len;
-
-    while (buflen > 0) {
-	len = ne_sock_read(sock, buffer, buflen);
-	if (len < 0) return len;
-	buflen -= len;
-	buffer += len;
-    }
-
-    return 0;
-}
