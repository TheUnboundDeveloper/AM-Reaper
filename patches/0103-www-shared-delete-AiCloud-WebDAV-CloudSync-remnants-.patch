-const unsigned char *ne_tolower_array(void);
-
-/* Convert an ASCII hexadecimal character in the ranges '0'..'9'
- * 'a'..'f' 'A'..'F' to its numeric equivalent. */
-#define NE_ASC2HEX(x) (((x) <= '9') ? ((x) - '0') : \
-                       (ne_tolower((x)) + 10 - 'a'))
