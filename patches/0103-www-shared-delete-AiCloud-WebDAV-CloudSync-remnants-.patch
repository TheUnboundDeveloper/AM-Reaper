-    unsigned char c1, c2;
-
-    if (p1 == p2)
-        return 0;
-    
-    do {
-        c1 = TOLOWER(*p1++);
-        c2 = TOLOWER(*p2++);
-        if (c1 == '\0')
-            break;
-    } while (c1 == c2);
-    
-    return c1 - c2;
-}
