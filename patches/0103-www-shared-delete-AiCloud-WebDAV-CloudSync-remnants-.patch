-int ne_sock_close(ne_socket *sock)
-{
-    int ret;
-
-    /* Per API description - for an SSL connection, simply send the
-     * close_notify but do not wait for the peer's response. */
-#if defined(HAVE_OPENSSL)
-    if (sock->ssl) {
