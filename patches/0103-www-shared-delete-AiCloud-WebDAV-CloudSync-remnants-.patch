-	("peek mismatch: `%.*s' not `%.*s'", 
-	 (int)len, buffer, (int)len, str));
-    ONV(buffer[len] != '@',
-        ("buffer overrun: %" NE_FMT_SSIZE_T "nth byte was '%c' not '@'", 
-         len, buffer[len]));
-    return OK;
-}
