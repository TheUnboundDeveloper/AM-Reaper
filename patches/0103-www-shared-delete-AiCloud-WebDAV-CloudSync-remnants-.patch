-
-    while ((cursor = ne_response_header_iterate(req, cursor, &name, &value))) {
-        n = -1;
-
-        ONV(strncmp(name, "x-", 2) || strncmp(value, "Y-", 2)
-            || strcmp(name + 2, value + 2)
-            || (n = atoi(name + 2)) >= MANY_HEADERS
-            || n < 0,
