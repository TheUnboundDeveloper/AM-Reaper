-	case ne_acl_href:
-	    ne_buffer_concat(body, "<href>", right[m].principal,
-			     "</href>" EOL, NULL);
-	    break;
-	}
-
-	ne_buffer_concat(body, "</principal>" EOL "<", type, ">" EOL, NULL);
-	
-	if (right[m].read == 0)
-	    ne_buffer_concat(body,
-			     "<privilege>" "<read/>" "</privilege>" EOL,
-			     NULL);
-	if (right[m].read_acl == 0)
