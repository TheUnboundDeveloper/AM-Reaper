-/* Tests for lock store handling. */
-static int store_single(void)
-{
-    ne_lock_store *store = ne_lockstore_create();
-    struct ne_lock *lk = make_lock("/foo", "blah", ne_lockscope_exclusive, 0);
-    struct ne_lock *lk2;
-
-    ONN("create failed", store == NULL);
