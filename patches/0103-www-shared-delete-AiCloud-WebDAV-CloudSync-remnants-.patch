-static ssize_t write_gnutls(ne_socket *sock, const char *data, size_t len)
-{
-    ssize_t ret;
-
-    do {
-        ret = gnutls_record_send(sock->ssl, data, len);
-    } while (RETRY_GNUTLS(sock, ret));
-
-    if (ret < 0)
-	return error_gnutls(sock, ret);
-
-    return ret;
-}
