-
-        sess->ntlm_context = ne__ntlm_create_context(sess->username, password);
-    }
-
-    status = ne__ntlm_authenticate(sess->ntlm_context, parms->opaque);
-    if (status) {
-        return status;
-    }
-
-    return 0;
