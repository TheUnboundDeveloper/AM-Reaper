-    ssize_t ret;
-    memset(buffer, '@', sizeof buffer);
-    ret = ne_sock_peek(sock, buffer, len);
-    ONV((ssize_t)len != ret, 
-	("peek got %" NE_FMT_SSIZE_T " bytes not %" NE_FMT_SIZE_T, ret, len));
