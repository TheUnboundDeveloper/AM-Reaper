-    const char *name, *value;
-    
-    ne_buffer_czappend(buf, "HTTP/1.0 200 OK\r\n");
-
-    for (n = 0; n < MANY_HEADERS; n++) {
-        sprintf(hdrs[n].name, "x-%d", n);
-        sprintf(hdrs[n].value, "Y-%d", n);
-        hdrs[n].seen = 0;
-        
-        ne_buffer_concat(buf, hdrs[n].name, ": ", hdrs[n].value, "\r\n", NULL);
