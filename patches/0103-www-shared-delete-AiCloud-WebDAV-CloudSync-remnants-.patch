-int ne_sock_fullwrite(ne_socket *sock, const char *data, size_t len)
-{
-    ssize_t ret;
-
-    do {
-        ret = sock->ops->swrite(sock, data, len);
-        if (ret > 0) {
-            data += ret;
-            len -= ret;
-        }
-    } while (ret > 0 && len > 0);
-
-    return ret < 0 ? ret : 0;
-}
