-      </funcprototype>
-
-      <funcprototype>
-        <funcdef>int <function>ne_addr_result</function></funcdef>
-        <paramdef>const ne_sock_addr *<parameter>addr</parameter></paramdef>
-      </funcprototype>
-
-      <funcprototype>
-        <funcdef>const ne_inet_addr *<function>ne_addr_first</function></funcdef>
