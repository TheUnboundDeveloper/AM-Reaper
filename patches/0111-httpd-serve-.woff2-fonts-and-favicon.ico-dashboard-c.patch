From 9c066ab3878ebd7adfe2060c8c021429cf4d408a Mon Sep 17 00:00:00 2001
From: reaper <theunbounddeveloper@outlook.com>
Date: Wed, 8 Jul 2026 18:25:25 -0400
Subject: [PATCH] httpd: serve .woff2 fonts and favicon.ico (dashboard console
 404s)

- mime_handlers: add fonts/*.woff2 (font/woff2) and favicon.ico
  (image/x-icon) entries; reaper woff2 fonts were staged in the image
  but httpd had no matching pattern, so every request 404'd and the
  dashboard fell back to system fonts.
- log_pass_handlers: suppress access-log noise for woff2/ico.
- www/favicon.ico: new multi-size ICO (48/32/16 PNG-in-ICO) built from
  the reaper emblem in images/REAPER.png; served at the web root for
  the browser default /favicon.ico request.
---
 release/src/router/httpd/web.c     |   4 ++++
 release/src/router/www/favicon.ico | Bin 0 -> 8042 bytes
 2 files changed, 4 insertions(+)
 create mode 100644 release/src/router/www/favicon.ico

diff --git a/release/src/router/httpd/web.c b/release/src/router/httpd/web.c
index cd591b3639..94645e14c1 100644
--- a/release/src/router/httpd/web.c
+++ b/release/src/router/httpd/web.c
@@ -28562,6 +28562,8 @@ struct mime_handler mime_handlers[] =
 	{ "fonts/*.ttf", "application/x-font-ttf", cache_object, NULL, do_file, NULL },
 	{ "fonts/*.otf", "application/x-font-otf", cache_object, NULL, do_file, NULL },
 	{ "fonts/*.woff", "application/font-woff", cache_object, NULL, do_file, NULL },
+	{ "fonts/*.woff2", "font/woff2", cache_object, NULL, do_file, NULL },
+	{ "favicon.ico", "image/x-icon", cache_object, NULL, do_file, NULL },
 #ifdef RTCONFIG_FINDASUS
 	{ "findasus.cgi", "text/html", no_cache_IE7, do_html_post_and_get, do_findasus_cgi, do_auth },
 	{ "find_device.asp", "text/html", no_cache_IE7, do_html_post_and_get, do_ej, do_auth },
@@ -43544,6 +43546,8 @@ struct log_pass_url_list log_pass_handlers[] = {
 	{ "fonts/*.ttf", NULL },
 	{ "fonts/*.otf", NULL },
 	{ "fonts/*.woff", NULL },
+	{ "fonts/*.woff2", NULL },
+	{ "**.ico", NULL },
 	{ "**.js", NULL },
 	{ "**.mjs", NULL },
 	{ "**.xml", NULL },
diff --git a/release/src/router/www/favicon.ico b/release/src/router/www/favicon.ico
new file mode 100644
index 0000000000000000000000000000000000000000..1febd427d2bdc34bfc20cb65bb06de6de198f6b6
GIT binary patch
