+<script>
+/* ---- HW QoS Classful priority editor (reaper v1.2.3, triage item 11) ----
+   Reorder the 5 upload priority classes (top = highest = first hardware egress
+   queue) and set each class ceiling as a percent of upload bandwidth. Order +
+   ceilings persist to qos_orates (positional, "min-ceil"); labels persist to the
+   UI-only qos_class_names nvram. The classful engine (rc/qos.c start_hwqos_classful)
+   reads the ceilings from qos_orates in queue order. */
+var HWQOSC_MIN_TMPL=[80,10,5,3,2];
+function hwqoscParse(){
+  var raw=(document.getElementById('qos_orates_input')||{}).value||'';
+  var parts=raw.split(','),ceils=[];
+  for(var i=0;i<5;i++){var seg=(parts[i]||'').split('-');ceils.push(seg.length>1?(parseInt(seg[1],10)||0):(parseInt(seg[0],10)||0));}
+  var nraw=(document.getElementById('qos_class_names_input')||{}).value||'';
+  var d=nraw.split(','),def=['Gaming','Web/VoIP','Streaming','Downloads','Default'],names=[];
+  for(var j=0;j<5;j++)names.push((d[j]&&d[j].length)?d[j]:def[j]);
+  return {ceils:ceils,names:names};
+}
+function hwqoscBuildEditor(){
+  var tb=document.getElementById('qos_prio_tbody');if(!tb)return;
+  var m=hwqoscParse();tb.innerHTML='';
+  for(var i=0;i<5;i++){
+    var tr=document.createElement('tr');
+    tr.innerHTML='<td style="text-align:center;white-space:nowrap;">'
+      +'<img src="/images/unfold_more.svg" title="move up" style="height:14px;transform:rotate(180deg);cursor:pointer;opacity:.85;" onclick="hwqoscMove(this,-1);">'
+      +'<img src="/images/unfold_more.svg" title="move down" style="height:14px;cursor:pointer;opacity:.85;margin-left:6px;" onclick="hwqoscMove(this,1);"></td>'
+      +'<td style="text-align:left;"><input type="text" class="input_15_table" maxlength="24" value="'+String(m.names[i]).replace(/"/g,'&quot;')+'" style="width:150px;"></td>'
+      +'<td class="qprioq" style="text-align:center;color:#B7B1A4;"></td>'
+      +'<td><input type="text" class="input_6_table" maxlength="3" value="'+m.ceils[i]+'" onKeyPress="return validator.isNumber(this,event);" onblur="hwqoscClamp(this);" style="width:60px;"><span style="margin-left:5px;color:#B7B1A4;">%</span></td>';
+    tb.appendChild(tr);
+  }
+  hwqoscRenumber();
+}
+function hwqoscClamp(o){var v=parseInt(o.value,10);if(isNaN(v)||v<0)v=0;if(v>100)v=100;o.value=v;}
+function hwqoscRenumber(){
+  var rows=document.querySelectorAll('#qos_prio_tbody tr');
+  for(var i=0;i<rows.length;i++){var q=rows[i].querySelector('.qprioq');
+    if(q)q.textContent='Q'+(i+1)+(i===0?' (highest)':(i===rows.length-1?' (lowest)':''));}
+}
+function hwqoscMove(img,dir){
+  var tr=img.parentNode.parentNode,tb=tr.parentNode;
+  if(dir<0&&tr.previousElementSibling)tb.insertBefore(tr,tr.previousElementSibling);
+  else if(dir>0&&tr.nextElementSibling)tb.insertBefore(tr.nextElementSibling,tr);
+  hwqoscRenumber();
+}
+function hwqoscSerialize(){
+  var rows=document.querySelectorAll('#qos_prio_tbody tr');if(!rows.length)return;
+  var ceils=[],names=[];
+  for(var i=0;i<rows.length;i++){var ins=rows[i].getElementsByTagName('input');
+    names.push((ins[0].value||('Class'+(i+1))).replace(/,/g,' ').replace(/</g,'').replace(/>/g,''));
+    var v=parseInt(ins[1].value,10);if(isNaN(v)||v<0)v=0;if(v>100)v=100;ceils.push(v);}
+  var pairs=[];for(var j=0;j<10;j++)pairs.push(j<ceils.length?((HWQOSC_MIN_TMPL[j]||0)+'-'+ceils[j]):'0-0');
+  var oi=document.getElementById('qos_orates_input');oi.disabled=false;oi.value=pairs.join(',');
+  var ni=document.getElementById('qos_class_names_input');ni.disabled=false;ni.value=names.join(',');
+}
+</script>
 </body>
