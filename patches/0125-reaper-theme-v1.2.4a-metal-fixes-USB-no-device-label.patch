From 6c1728f315c896d81c1a8462d737b173b8099cf0 Mon Sep 17 00:00:00 2001
From: reaper <theunbounddeveloper@outlook.com>
Date: Fri, 10 Jul 2026 15:18:40 -0400
Subject: [PATCH] reaper theme: v1.2.4a metal fixes (USB no-device/label/quota
 bar, VPN detail panel + Samba toggle + GET START button)

Cosmetic fixes from the v1.2.4 on-metal walk, shipped as the side-image
Reaper_v1.2.4a (v1.2.4 base + these CSS-only changes; sha256 c3f9235e...).
Carried forward here onto the v1.2.5 tip so v1.2.6 inherits them:
- .iconNo/.iconNoM2: dim the stock grey 'No Device' USB slot (distinct class,
  does not widen the crimson glyph filter).
- .usb_text.plugin: bone text + light shadow (was white on a heavy #000 box).
- #diskquota: faint track instead of a solid black slab.
- section 21: .popup_edit_profile_container slate -> dark; .switch.on detail
  toggle blue -> neutral grey (rule 11); .get_start_container + .add_btn_vpnc
  blue -> dark/crimson.
USB ring alignment deferred: sprite geometry verified correct-by-construction
(white_05.gif == stock 95x276); residual is a perceptual tune via a CSS
transform lever, pending an on-metal v1.2.4a screenshot.
---
 .../src/router/www/reaper/reaper_content.css  | 28 ++++++++++++++++++-
 1 file changed, 27 insertions(+), 1 deletion(-)

diff --git a/release/src/router/www/reaper/reaper_content.css b/release/src/router/www/reaper/reaper_content.css
index ac71cd8e83..948de87f3f 100644
--- a/release/src/router/www/reaper/reaper_content.css
+++ b/release/src/router/www/reaper/reaper_content.css
@@ -261,7 +261,9 @@ div[id$="_Block_PC"],div[id$="_Block_PC"] div,div[id$="_Block_PC"] a{
 .top-messgae1,.top-messgae2,.top-messgae3{background-color:#101014!important;color:#ECE7DB!important}
 .clients span,.style1{color:#ECE7DB!important}
 .input{background:#000!important;color:#ECE7DB!important;border:1px solid rgba(255,255,255,.12)!important}
-#diskquota{background:#000!important}
+/* v1.2.4a: was solid #000 (a black slab under the disk label); use a faint track so
+   the crimson .quotabar fill reads as an actual usage bar on the dark panel. */
+#diskquota{background:#1c1c22!important}
 .button{background:linear-gradient(180deg,#1a1a1f,#101014)!important;color:#ECE7DB!important;
   border:1px solid rgba(255,255,255,.14)!important}
 .client_tag{background-color:#1a1a1f!important}
@@ -275,6 +277,9 @@ div[id$="_Block_PC"],div[id$="_Block_PC"] div,div[id$="_Block_PC"] a{
 .table1px,.table1px th,.table1px tr,.table1px td{background-color:#0c0c0f!important;
   border-color:rgba(255,255,255,.08)!important}
 .usb_text,.status{color:#B7B1A4!important}
+/* v1.2.4a: the mounted-disk label (.usb_text.plugin) used white text on a heavy #000
+   text-shadow that read as a black box; bone text + a light shadow instead. */
+.usb_text.plugin{color:#ECE7DB!important;text-shadow:0 1px 2px rgba(0,0,0,.55)!important}
 /* client-list rows (device-map/clients.asp): .clientBg paints a teal-grey card
    via a background-IMAGE (bg.png) that also bakes in the teal border - a
    background-color swap can't touch it, so drop the image and use a flat dark
@@ -399,6 +404,12 @@ div[id$="_Block_PC"],div[id$="_Block_PC"] div,div[id$="_Block_PC"] a{
    Alignment geometry is frame-precise -> tuned on-device. */
 div[id^="ring_USBdisk"]{background-image:url("/images/New_ui/networkmap/white_05.gif")!important;
   background-repeat:no-repeat!important;filter:none!important;mix-blend-mode:screen!important}
+/* v1.2.4a: the empty USB slot ("No Device") uses a DIFFERENT class + sprite
+   (.iconNo / devicebt_default.png, a bright stock grey circle) that the crimson
+   GLYPH rule above never touched -> it glared against the dark panel. Dim + desaturate
+   so an empty slot recedes; distinct selector, so the populated crimson icon is
+   untouched (does NOT widen the [id^=iconUSBdisk] filter that caused the ring-tint). */
+.iconNo,.iconNoM2{filter:grayscale(1) brightness(.45)!important;opacity:.85!important}
 
 /* Network Map "View List" popup (device-map/clientlist.html): the client list
    still rendered on stock teal */
@@ -677,6 +688,21 @@ body.bg,.container.no_highlights,.content_container{background:transparent!impor
 .svr_item_switch_container .switch{background:#45454B!important}
 .svr_item_switch_container .switch.on{background:#6B6B72!important}
 .vpnc_help_icon,.svr_list_help_icon,.svr_list_add_icon{color:#E10600!important}
+/* v1.2.4a: section 21 covered the LEFT server-list cards but not the RIGHT
+   detail/config panel, which stayed stock slate. VPN Server > Others > PPTP etc.:
+   the panel body .popup_edit_profile_container was rgb(40,58,70) (#283A46). */
+.profile_setting_container .popup_edit_profile_container{background:#0c0c0f!important}
+/* detail-panel toggles (Network Place (Samba) Support, etc.) are the class-toggled
+   .switch (not the input-based one) and turned BLUE (#248DFF) on -> neutral grey
+   per standing rule 11. Scoped to the VPN-SPA row classes so nothing else bleeds. */
+.profile_setting_item .switch.on,.switch_item .switch.on{background:#6B6B72!important}
+.profile_setting_item .switch.off,.switch_item .switch.off{background:#45454B!important}
+/* VPN Client > PPTP/L2TP "GET START" panel: container was rgb(48,61,67), heading
+   #4CB4FF, and the "Add profile" button rgb(0,145,255) (#0091FF). */
+.get_start_container{background:#0c0c0f!important;
+  border:1px solid rgba(255,255,255,.08)!important}
+.get_start_container .main_info_container .title{color:#ECE7DB!important}
+.get_start_container .add_btn,.add_btn_vpnc{background:#E10600!important;color:#fff!important}
 
 /* Network Analysis (Main_Analysis_Content.asp): the ping graph + results table
    are a fixed 730px block; in the wide shell frame they stranded left with dead
-- 
2.25.1

