diff --git a/release/src/router/rc/snmpd.c b/release/src/router/rc/snmpd.c
index ce6e7c15d0..7f1b72380d 100644
--- a/release/src/router/rc/snmpd.c
+++ b/release/src/router/rc/snmpd.c
@@ -50,6 +50,26 @@ static void snmp_sanitize(char *dst, size_t dsize, const char *src)
 	dst[j] = '\0';
 }
 
+/* Token variant: additionally drops spaces (U3). Values used on multi-token
+ * net-snmp directive lines (createUser/rocommunity/rwcommunity) must stay a
+ * single token - an embedded space shifts the following tokens, e.g. the rest
+ * of a spaced community becomes the SOURCE field and silently narrows the ACL.
+ * sysName/sysLocation/sysContact are rest-of-line directives and keep spaces. */
+static void snmp_sanitize_token(char *dst, size_t dsize, const char *src)
+{
+	size_t j = 0;
+
+	if (dsize == 0)
+		return;
+	for (; src && *src && j + 1 < dsize; src++) {
+		unsigned char c = (unsigned char)*src;
+		if (c <= 0x20 || c == 0x7f)
+			continue;	/* drop control chars and spaces */
+		dst[j++] = (char)c;
+	}
+	dst[j] = '\0';
+}
+
 void start_snmpd(void)
 {
 	int ret = 0;
@@ -73,11 +93,11 @@ void start_snmpd(void)
 	memset(privType, 0x0, 5);
 	memset(authPwd, 0x0, 256);
 	memset(privPwd, 0x0, 256);
-	snmp_sanitize(user, sizeof(user), nvram_safe_get("http_username"));
-	snmp_sanitize(authType, sizeof(authType), nvram_safe_get("v3_auth_type"));
-	snmp_sanitize(authPwd, sizeof(authPwd), nvram_safe_get("v3_auth_passwd"));
-	snmp_sanitize(privType, sizeof(privType), nvram_safe_get("v3_priv_type"));
-	snmp_sanitize(privPwd, sizeof(privPwd), nvram_safe_get("v3_priv_passwd"));
+	snmp_sanitize_token(user, sizeof(user), nvram_safe_get("http_username"));
+	snmp_sanitize_token(authType, sizeof(authType), nvram_safe_get("v3_auth_type"));
+	snmp_sanitize_token(authPwd, sizeof(authPwd), nvram_safe_get("v3_auth_passwd"));
+	snmp_sanitize_token(privType, sizeof(privType), nvram_safe_get("v3_priv_type"));
+	snmp_sanitize_token(privPwd, sizeof(privPwd), nvram_safe_get("v3_priv_passwd"));
 
 	cprintf("write config for snmpd!\n");
 
@@ -104,13 +124,13 @@ void start_snmpd(void)
 		cprintf("Wrong SNMPv3 Authentication type!!\n");
 
 	if(strlen(nvram_safe_get("roCommunity"))) {
-		snmp_sanitize(cval, sizeof(cval), nvram_safe_get("roCommunity"));
+		snmp_sanitize_token(cval, sizeof(cval), nvram_safe_get("roCommunity"));
 		if(cval[0])
 			fprintf(fp, "rocommunity %s default\n", cval);
 	}
 
 	if(strlen(nvram_safe_get("rwCommunity"))) {
-		snmp_sanitize(cval, sizeof(cval), nvram_safe_get("rwCommunity"));
+		snmp_sanitize_token(cval, sizeof(cval), nvram_safe_get("rwCommunity"));
 		if(cval[0])
 			fprintf(fp, "rwcommunity %s default\n", cval);
 	}
