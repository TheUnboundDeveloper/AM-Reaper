+<script>
+/* ---------- nvram bootstrap (R4-4 pattern: user text via char_to_ascii) ---------- */
+var NV = {
+  enable:  '<% nvram_get("qos_enable"); %>',
+  type:    '<% nvram_get("qos_type"); %>',
+  obw:     '<% nvram_get("qos_obw"); %>',
+  ibw:     '<% nvram_get("qos_ibw"); %>',
+  orates:  decodeURIComponent('<% nvram_char_to_ascii("", "qos_orates"); %>'),
+  cnames:  decodeURIComponent('<% nvram_char_to_ascii("", "qos_class_names"); %>'),
+  pshaper: '<% nvram_get("qos_pshaper"); %>',
+  minrates:'<% nvram_get("qos_minrates"); %>',
+  dscp:    '<% nvram_get("qos_dscp_trust"); %>'
+};
+
+/* ---------- mode model (qos_type 1/Adaptive is retired with the DPI stack) ---------- */
+var MODES = [
+  {key:'off', type:null, name:'Off', desc:'No traffic shaping. Full accelerator throughput; upload bursts will queue in the ISP buffer (bufferbloat under load).',
+   tags:[['Accel on','good'],['No control','']]},
+  {key:'11', type:'11', name:'HW QoS Classful', rec:true, desc:'Five priority classes with guaranteed minimums and per-class ceilings, shaped in hardware with PI2 AQM. Accelerator stays on.',
+   tags:[['Accel on','good'],['Upload only',''],['Classes + guarantees','good']]},
+  {key:'10', type:'10', name:'Hardware QoS', desc:'Single hardware queue: one upload cap plus AQM. The simplest bufferbloat fix, no classes.',
+   tags:[['Accel on','good'],['Upload only',''],['No classes','']]},
+  {key:'9', type:'9', name:'Cake', desc:'Software shaper with excellent download control. Turns the NAT accelerator off; expect roughly 1 Gb/s ceiling with CPU-bound shaping.',
+   tags:[['Accel OFF','warn'],['Up + Down','good']]},
+  {key:'0', type:'0', name:'Traditional QoS', desc:'The classic software engine with rule-based classes. Turns the NAT accelerator off.',
+   tags:[['Accel OFF','warn'],['Up + Down','']]},
+  {key:'2', type:'2', name:'Bandwidth Limiter', desc:'Hard per-device speed caps rather than smart sharing. Configure device limits on the stock page (link below).',
+   tags:[['Per-device caps',''],['Not bufferbloat','warn']]}
+];
+var sel = (NV.enable === '1') ? String(NV.type) : 'off';
+if (sel !== 'off' && !MODES.some(function(m){return m.key===sel;})) sel = 'off'; /* unknown/retired type */
+
+function renderModes(){
+  var host = document.getElementById('modes'); host.innerHTML = '';
+  for (var i=0;i<MODES.length;i++){ (function(m){
+    var d = document.createElement('div');
+    d.className = 'mode' + (sel===m.key ? ' sel' : '');
+    var h = '';
+    if (m.rec) h += '<span class="rec">RECOMMENDED</span>';
+    h += '<h3>'+m.name+'</h3><p>'+m.desc+'</p><div class="tags">';
+    for (var t=0;t<m.tags.length;t++) h += '<span class="tag '+(m.tags[t][1]||'')+'">'+m.tags[t][0]+'</span>';
+    h += '</div>';
+    d.innerHTML = h;
+    d.onclick = function(){ sel = m.key; renderModes(); syncPanels(); };
+    host.appendChild(d);
+  })(MODES[i]); }
+}
+function syncPanels(){
+  document.getElementById('clpanel').style.display = (sel === '11') ? '' : 'none';
+  var on = (NV.enable === '1');
+  var pill = document.getElementById('engpill');
+  pill.className = 'pill' + (on ? ' on' : '');
+  var mm = null;
+  for (var i=0;i<MODES.length;i++) if (MODES[i].key === String(NV.type)) mm = MODES[i];
+  document.getElementById('engpill_t').textContent = on ? ('Running: ' + (mm ? mm.name : ('Type '+NV.type))) : 'Shaping off';
+}
+
+/* ---------- bandwidth (nvram kbps <-> UI Mb/s, stock x1024 convention) ---------- */
+function kb2mb(k){ k = parseInt(k,10)||0; return k ? (Math.round(k/1024*10)/10) : ''; }
+function mb2kb(m){ m = parseFloat(m)||0; return Math.round(m*1024); }
+document.getElementById('bw_up').value = kb2mb(NV.obw);
+document.getElementById('bw_dn').value = kb2mb(NV.ibw);
+
+/* ---------- class editor ---------- */
+var DEFN = ['Gaming','Web/VoIP','Streaming','Downloads','Default'];
+function parseOrates(){
+  var parts = (NV.orates||'').split(','), mins=[], ceils=[];
+  for (var i=0;i<5;i++){
+    var seg = (parts[i]||'0-0').split('-');
+    mins.push(parseInt(seg[0],10)||0);
+    ceils.push(seg.length>1 ? (parseInt(seg[1],10)||0) : 0);
+  }
+  var d = (NV.cnames||'').split(','), names=[];
+  for (var j=0;j<5;j++) names.push((d[j]&&d[j].length)?d[j]:DEFN[j]);
+  return {mins:mins, ceils:ceils, names:names};
+}
+function buildEditor(){
+  var tb = document.getElementById('ctbody'); tb.innerHTML='';
+  var m = parseOrates();
+  for (var i=0;i<5;i++){
+    var tr = document.createElement('tr');
+    tr.innerHTML =
+      '<td class="arrows"><span onclick="rowMove(this,-1)" title="move up">&#9650;</span><span onclick="rowMove(this,1)" title="move down">&#9660;</span></td>'
+      +'<td><input type="text" maxlength="24" style="width:170px" value="'+String(m.names[i]).replace(/"/g,'&quot;')+'"></td>'
+      +'<td><span class="qbadge qb"></span> <span class="qnote qn"></span></td>'
+      +'<td><input type="text" maxlength="3" style="width:56px" value="'+m.mins[i]+'" onblur="clampPct(this)"></td>'
+      +'<td><input type="text" maxlength="3" style="width:56px" value="'+m.ceils[i]+'" onblur="clampPct(this)"></td>'
+      +'<td class="statcell"><span class="rate">&ndash;</span></td>'
+      +'<td class="statcell"><span class="drops">&ndash;</span></td>';
+    tb.appendChild(tr);
+  }
+  renumber();
+}
+function clampPct(o){ var v=parseInt(o.value,10); if(isNaN(v)||v<0)v=0; if(v>100)v=100; o.value=v; }
+function renumber(){
+  var rows = document.querySelectorAll('#ctbody tr');
+  for (var i=0;i<rows.length;i++){
+    rows[i].querySelector('.qb').textContent = 'Q'+(i+1);
+    rows[i].querySelector('.qn').textContent = i===0?'served first':(i===rows.length-1?'served last':'');
+  }
+}
+function rowMove(sp,dir){
+  var tr = sp.parentNode.parentNode, tb = tr.parentNode;
+  if (dir<0 && tr.previousElementSibling) tb.insertBefore(tr, tr.previousElementSibling);
+  else if (dir>0 && tr.nextElementSibling) tb.insertBefore(tr.nextElementSibling, tr);
+  renumber();
+}
+function serializeClasses(){
+  var rows = document.querySelectorAll('#ctbody tr'); if(!rows.length) return null;
+  var mins=[], ceils=[], names=[], csum=0, msum=0;
+  for (var i=0;i<rows.length;i++){
+    var ins = rows[i].getElementsByTagName('input');
+    names.push((ins[0].value||('Class'+(i+1))).replace(/,/g,' ').replace(/</g,'').replace(/>/g,''));
+    var mn = parseInt(ins[1].value,10); if(isNaN(mn)||mn<0)mn=0; if(mn>100)mn=100;
+    var cl = parseInt(ins[2].value,10); if(isNaN(cl)||cl<0)cl=0; if(cl>100)cl=100;
+    if (mn > cl && cl > 0){ mn = cl; ins[1].value = mn; } /* a floor above the ceiling is meaningless */
+    mins.push(mn); ceils.push(cl); msum+=mn; csum+=cl;
+  }
+  if (csum === 0){ alert('At least one class must have a non-zero upload ceiling (%).'); return null; }
+  if (document.getElementById('tg_minrates').checked && msum > 100){
+    alert('Guaranteed minimums total '+msum+'%. Guarantees cannot exceed 100% of the upload - lower the Min values (or switch off Guaranteed minimums).');
+    return null;
+  }
+  if (!document.getElementById('tg_pshaper').checked && csum > 100 &&
+      !confirm('Ceilings total '+csum+'% and the aggregate cap is OFF: several busy classes together can exceed the upload figure and re-enter the ISP buffer. Continue?'))
+    return null;
+  var pairs=[]; for (var j=0;j<10;j++) pairs.push(j<5 ? (mins[j]+'-'+ceils[j]) : '0-0');
+  return { orates: pairs.join(','), names: names.join(',') };
+}
+
+/* ---------- live stats ---------- */
+var lastStats = null, lastT = 0;
+function fmtRate(bps){
+  if (bps >= 1e9) return (Math.round(bps/1e8)/10)+' Gb/s';
+  if (bps >= 1e6) return (Math.round(bps/1e5)/10)+' Mb/s';
+  if (bps >= 1e3) return (Math.round(bps/100)/10)+' kb/s';
+  return Math.round(bps)+' b/s';
+}
+function pollStats(){
+  if (!(NV.enable==='1' && String(NV.type)==='11')) return;
+  var x = new XMLHttpRequest();
+  x.open('GET','/reaper_qos_stats.cgi?_='+Date.now(), true);
+  x.onreadystatechange = function(){
+    if (x.readyState!==4 || x.status!==200) return;
+    var d; try{ d = JSON.parse(x.responseText); }catch(e){ return; }
+    if (!d.enabled) return;
+    var now = Date.now();
+    var rows = document.querySelectorAll('#ctbody tr');
+    for (var i=0;i<5;i++){
+      var q = d['q'+(i+1)]; if(!q || !rows[i]) continue;
+      var rateEl = rows[i].querySelector('.rate'), dropEl = rows[i].querySelector('.drops');
+      if (lastStats && lastStats['q'+(i+1)] && now>lastT){
+        var bps = Math.max(0,(q.txb - lastStats['q'+(i+1)].txb))*8000/(now-lastT);
+        rateEl.textContent = fmtRate(bps);
+        var dd = q.dp - lastStats['q'+(i+1)].dp;
+        dropEl.textContent = q.dp + (dd>0 ? ' (+'+dd+')' : '');
+        dropEl.className = 'drops' + (dd>0 ? ' hot' : '');
+      } else rateEl.textContent = '...';
+    }
+    var xq = [['q0','xq0'],['q6','xq6']];
+    for (var k=0;k<xq.length;k++){
+      var qq = d[xq[k][0]], el = document.getElementById(xq[k][1]);
+      if (qq && el){
+        var r = '';
+        if (lastStats && lastStats[xq[k][0]] && now>lastT)
+          r = fmtRate(Math.max(0,(qq.txb-lastStats[xq[k][0]].txb))*8000/(now-lastT))+' &middot; ';
+        el.innerHTML = r + qq.dp + ' drops';
+      }
+    }
+    lastStats = d; lastT = now;
+  };
+  x.send();
+}
+setInterval(pollStats, 3000);
+
+/* ---------- apply ---------- */
+function applyQoS(){
+  var f = document.form;
+  var wasOn = (NV.enable==='1'), wasType = String(NV.type);
+  var nowOn = (sel !== 'off'), nowType = nowOn ? sel : wasType;
+
+  f.qos_enable.value = nowOn ? '1' : '0';
+  f.qos_type.value = nowType;
+
+  var up = document.getElementById('bw_up').value, dn = document.getElementById('bw_dn').value;
+  if (nowOn && (sel==='10'||sel==='11') && !(parseFloat(up)>0) &&
+      !confirm('No upload bandwidth is set. Hardware QoS will enable AQM but cannot shape without it. Continue anyway?')) return;
+  f.qos_obw.disabled = false; f.qos_obw.value = up==='' ? '' : String(mb2kb(up));
+  f.qos_ibw.disabled = false; f.qos_ibw.value = dn==='' ? '' : String(mb2kb(dn));
+
+  if (sel === '11'){
+    var s = serializeClasses(); if (!s) return;
+    f.qos_orates.disabled=false;      f.qos_orates.value = s.orates;
+    f.qos_class_names.disabled=false; f.qos_class_names.value = s.names;
+    f.qos_pshaper.disabled=false;     f.qos_pshaper.value = document.getElementById('tg_pshaper').checked ? '1':'0';
+    f.qos_minrates.disabled=false;    f.qos_minrates.value = document.getElementById('tg_minrates').checked ? '1':'0';
+    f.qos_dscp_trust.disabled=false;  f.qos_dscp_trust.value = document.getElementById('tg_dscp').checked ? '1':'0';
+  }
+
+  /* stock HND semantics: same enable+type (or turning off) restarts live;
+     an engine switch / fresh enable reconfigures the accelerator = reboot */
+  var live = (wasOn === nowOn && (!nowOn || wasType === nowType)) || (wasOn && !nowOn);
+  if (live){
+    f.action_script.value = 'restart_qos;restart_firewall';
+    f.action_wait.value = '15';
+  } else {
+    if (!confirm('Changing the QoS mode reboots the router so the flow accelerator can be reconfigured. Reboot now?')) return;
+    f.action_script.value = 'reboot';
+    f.action_wait.value = '<% get_default_reboot_time(); %>';
+  }
+  document.getElementById('ap_t').textContent = live ? 'Applying' : 'Rebooting';
+  document.getElementById('ap_p').textContent = live ? 'Settings are being applied. This page will refresh.' :
+    'The router is rebooting to switch QoS engines. This page will refresh when it is back.';
+  document.getElementById('applying').className = 'applying show';
+  f.submit();
+  var wait = (parseInt(f.action_wait.value,10)||15) + 5;
+  setTimeout(function(){ location.reload(); }, wait*1000);
+}
+
+/* ---------- FAQ fly-out ---------- */
+function faqOpen(){ document.getElementById('flyout').className='flyout open'; document.getElementById('scrim').className='scrim open'; }
+function faqClose(){ document.getElementById('flyout').className='flyout'; document.getElementById('scrim').className='scrim'; }
+document.addEventListener('keydown', function(e){ if(e.key==='Escape') faqClose(); });
+
+/* ---------- init ---------- */
+document.getElementById('tg_pshaper').checked = (NV.pshaper !== '0');
+document.getElementById('tg_minrates').checked = (NV.minrates !== '0');
+document.getElementById('tg_dscp').checked = (NV.dscp === '1');
+renderModes(); syncPanels(); buildEditor(); pollStats();
+</script>
+</body>
+</html>
