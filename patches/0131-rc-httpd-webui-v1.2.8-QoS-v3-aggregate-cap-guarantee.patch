diff --git a/release/src/router/httpd/web.c b/release/src/router/httpd/web.c
index e14a9e01ad..f4daed5124 100644
--- a/release/src/router/httpd/web.c
+++ b/release/src/router/httpd/web.c
@@ -21599,6 +21599,53 @@ do_set_ASUS_NEW_EULA_cgi(char *url, FILE *stream)
 /* reaper v1.2.7: do_set_ASUS_EULA_cgi removed - legacy app-only EULA setter with zero www callers;
  * EULA pre-signed in defaults.c. The modern set_ASUS_NEW_EULA.cgi path is KEPT (QIS wizard/AiMesh + httpApi.newEula). */
 
+/* reaper QoS v3: per-class egress queue counters for the Reaper_QoS.asp live
+ * stats tiles. Reads tmctl getqstats for WAN qids 0..6 and emits JSON. No
+ * request input is consumed (url ignored); the only interpolated value is the
+ * kernel-provided WAN ifname, charset-guarded like rc/qos.c start_hwqos. */
+static void
+do_reaper_qos_stats_cgi(char *url, FILE *stream)
+{
+	int qid, active;
+	const char *ifname = "";
+	const char *q;
+	char cmd[160], line[160];
+	FILE *p;
+
+	active = (nvram_get_int("qos_enable") == 1 && nvram_get_int("qos_type") == 11);
+	websWrite(stream, "{\"enabled\":%d", active ? 1 : 0);
+
+	if (active) {
+		ifname = get_wan_ifname(wan_primary_ifunit());
+		for (q = ifname; *q; q++) {
+			if (!((*q >= 'a' && *q <= 'z') || (*q >= 'A' && *q <= 'Z') ||
+			      (*q >= '0' && *q <= '9') || *q == '.' || *q == '_' || *q == '-')) {
+				ifname = "";
+				break;
+			}
+		}
+	}
+
+	if (active && *ifname) {
+		for (qid = 0; qid <= 6; qid++) {
+			unsigned long long txp = 0, txb = 0, dp = 0, db = 0;
+			snprintf(cmd, sizeof(cmd), "tmctl getqstats --devtype 0 --if %s --qid %d", ifname, qid);
+			if ((p = popen(cmd, "r")) != NULL) {
+				while (fgets(line, sizeof(line), p)) {
+					if (sscanf(line, " txPackets: %llu", &txp) == 1) continue;
+					if (sscanf(line, " txBytes: %llu", &txb) == 1) continue;
+					if (sscanf(line, " droppedPackets: %llu", &dp) == 1) continue;
+					if (sscanf(line, " droppedBytes: %llu", &db) == 1) continue;
+				}
+				pclose(p);
+			}
+			websWrite(stream, ",\"q%d\":{\"txp\":%llu,\"txb\":%llu,\"dp\":%llu,\"db\":%llu}",
+				qid, txp, txb, dp, db);
+		}
+	}
+	websWrite(stream, "}");
+}
+
 static void
 do_unreg_ASUSDDNS_cgi(char *url, FILE *stream)
 {
@@ -28678,6 +28725,7 @@ struct mime_handler mime_handlers[] =
 	{ "upgrade.cgi*", "text/html", no_cache_IE7, do_upgrade_post, do_upgrade_cgi, do_auth},
 	{ "upload.cgi*", "text/html", no_cache_IE7, do_upload_post, do_upload_cgi, do_auth },
 	/* reaper v1.2.7: set_ASUS_EULA.cgi endpoint removed (legacy app-only setter; EULA pre-signed in defaults.c) */
+	{ "reaper_qos_stats.cgi*", "text/html", no_cache_IE7, do_html_post_and_get, do_reaper_qos_stats_cgi, do_auth },
 	{ "set_ASUS_NEW_EULA.cgi*", "text/html", no_cache_IE7, do_html_post_and_get, do_set_ASUS_NEW_EULA_cgi, do_auth },
 	{ "set_ASUS_privacy_policy.cgi*", "text/html", no_cache_IE7, do_html_post_and_get, do_set_ASUS_privacy_policy_cgi, do_auth },
 	{ "get_ASUS_privacy_policy.cgi*", "text/html", no_cache_IE7, do_html_post_and_get, do_get_ASUS_privacy_policy_cgi, do_auth },
diff --git a/release/src/router/rc/qos.c b/release/src/router/rc/qos.c
index 79d6a693a6..c34ed17c06 100644
--- a/release/src/router/rc/qos.c
+++ b/release/src/router/rc/qos.c
@@ -914,6 +914,36 @@ static int add_qos_rules(char *pcWANIF)
 	}
 	free(buf);
 
+	/* reaper QoS v3: DSCP trust (qos_dscp_trust=1, HW classful engine only).
+	 * Map the standard DiffServ classes onto the 5 upload classes AFTER the
+	 * explicit user rules (an admin rule always wins) and BEFORE the default
+	 * catch-all (DSCP beats only "unmatched"). The connection takes the class
+	 * of its first marked packet (gum bit set, no re-detection) - consistent
+	 * with the documented HW-offload freeze semantics for type 11. */
+	if (IS_HWQOS_CLASSFUL() && nvram_match("qos_dscp_trust", "1")) {
+		static const struct { const char *dscp; int cls; } dscp_map[] = {
+			{ "EF", 1 }, { "CS7", 1 }, { "CS6", 1 }, { "CS5", 1 },	/* voice / interactive     -> Q1 */
+			{ "CS4", 2 }, { "AF41", 2 }, { "AF42", 2 }, { "AF43", 2 },	/* video conf / gaming     -> Q2 */
+			{ "CS3", 3 }, { "AF31", 3 }, { "AF32", 3 }, { "AF33", 3 },	/* streaming / signaling   -> Q3 */
+			{ "CS1", 5 },						/* scavenger / bulk        -> Q5 */
+		};
+		int di;
+		for (di = 0; di < (int)(sizeof(dscp_map)/sizeof(dscp_map[0])); di++) {
+			fprintf(fn, "-A QOSO -m dscp --dscp-class %s -j CONNMARK %s 0x%x/0x%x\n",
+				dscp_map[di].dscp, action, dscp_map[di].cls|class_gum, class_mask|class_gum);
+			if (manual_return)
+				fprintf(fn, "-A QOSO -m dscp --dscp-class %s -j RETURN\n", dscp_map[di].dscp);
+#ifdef RTCONFIG_IPV6
+			if (fn_ipv6 && ipv6_enabled()) {
+				fprintf(fn_ipv6, "-A QOSO -m dscp --dscp-class %s -j CONNMARK %s 0x%x/0x%x\n",
+					dscp_map[di].dscp, action, dscp_map[di].cls|class_gum, class_mask|class_gum);
+				if (manual_return)
+					fprintf(fn_ipv6, "-A QOSO -m dscp --dscp-class %s -j RETURN\n", dscp_map[di].dscp);
+			}
+#endif
+		}
+	}
+
 	/* The default class */
 	i = nvram_get_int("qos_default");
 	if ((i < 0) || (i > 4)) i = 3;  // "lowest"
@@ -3063,13 +3093,16 @@ int start_hwqos(void)
 int start_hwqos_classful(void)
 {
 	FILE *f;
-	unsigned int obw, rate, ceil, cap;
-	int i, qid;
+	unsigned int obw, rate, ceil, cap, minr;
+	int i, qid, minrates;
 	char *buf, *g, *p;
 	const char *wan_ifname = get_wan_ifname(wan_primary_ifunit());
 	const char *q;
 
 	obw = strtoul(nvram_safe_get("qos_obw"), NULL, 10);
+	/* v3 kill-switch semantics (mirror reaper_inject/get_index_page):
+	 * unset or any value other than literal "0" = on, "0" = off. */
+	minrates = !nvram_match("qos_minrates", "0");
 
 	/* same shell-safety guard as start_hwqos: wan_ifname is single-quoted in
 	 * the generated root script; reject anything that isn't a plain interface
@@ -3092,7 +3125,10 @@ int start_hwqos_classful(void)
 		wan_ifname
 	);
 
-	/* class queues 1..5: PI2 + ceil% of OBW from qos_orates (prio order 0..4) */
+	/* class queues 1..5: PI2 + min%/ceil% of OBW from qos_orates (prio order 0..4).
+	 * v3: the min half of each "min-ceil" pair (ignored by v2) is now emitted as
+	 * a committed rate (--minrate) - lower classes keep a guaranteed floor while
+	 * the SP scheduler lets higher classes take the rest (CBWFQ model). */
 	g = buf = strdup(nvram_safe_get("qos_orates"));
 	for (i = 0; i < 5; ++i) {
 		if ((!g) || ((p = strsep(&g, ",")) == NULL)) break;
@@ -3102,9 +3138,16 @@ int start_hwqos_classful(void)
 		 * matching start_hwqos. (calc() floors to 2, so without this guard a
 		 * blank OBW would throttle every 1..99%% class to ~2 kbit.) */
 		cap = (obw > 0 && ceil >= 1 && ceil < 100) ? calc(obw, ceil) : obw;
+		minr = (minrates && obw > 0 && rate >= 1 && rate <= 100) ? calc(obw, rate) : 0;
+		if (cap > 0 && minr > cap)
+			minr = cap;	/* a guarantee can never exceed the ceiling */
 		fprintf(f, "\ttmctl setqdropalg --devtype 0 --if $WANIF --qid %d --dropalg 4\n", qid);
-		if (cap > 0)
-			fprintf(f, "\ttmctl setqshaper --devtype 0 --if $WANIF --qid %d --shapingrate %u\n", qid, cap);
+		if (cap > 0) {
+			if (minr > 0)
+				fprintf(f, "\ttmctl setqshaper --devtype 0 --if $WANIF --qid %d --minrate %u --shapingrate %u\n", qid, minr, cap);
+			else
+				fprintf(f, "\ttmctl setqshaper --devtype 0 --if $WANIF --qid %d --shapingrate %u\n", qid, cap);
+		}
 	}
 	free(buf);
 
@@ -3116,9 +3159,20 @@ int start_hwqos_classful(void)
 		fprintf(f, "\ttmctl setqshaper --devtype 0 --if $WANIF --qid 6 --shapingrate %u\n", obw);
 	}
 
+	/* v3: aggregate cap - port shaper pinned to OBW. With the whole port held
+	 * at the configured upload, per-class ceilings become safe burst
+	 * allowances: they may sum past 100%% without the combined egress ever
+	 * exceeding OBW (the ISP buffer stays out of the game even when several
+	 * classes saturate at once). qos_pshaper="0" kills. */
+	if (obw > 0 && !nvram_match("qos_pshaper", "0"))
+		fprintf(f, "\ttmctl setportshaper --devtype 0 --if $WANIF --shapingrate %u\n", obw);
+
 	fprintf(f, "\t;;\nstop)\n");
+	fprintf(f, "\ttmctl setportshaper --devtype 0 --if $WANIF --shapingrate 0\n");
 	for (qid = 0; qid <= 6; qid++) {
-		fprintf(f, "\ttmctl setqshaper  --devtype 0 --if $WANIF --qid %d --shapingrate 0\n", qid);
+		/* reset minrate along with the ceiling - a bare "--shapingrate 0"
+		 * would leave a stale committed rate configured on the queue */
+		fprintf(f, "\ttmctl setqshaper  --devtype 0 --if $WANIF --qid %d --minrate 0 --shapingrate 0\n", qid);
 		fprintf(f, "\ttmctl setqdropalg --devtype 0 --if $WANIF --qid %d --dropalg 0\n", qid);
 	}
 	fprintf(f, "\t;;\n*)\nesac\n");
