+	/* v4: per-class scheduler mode from qos_sched - 5 comma tokens by queue
+	 * position: "p" = strict priority (default, v3 behavior) or "w<1-63>" =
+	 * WRR with that weight. The port scheduler is an SP_WRR combo: SP queues
+	 * are always served first, WRR queues share what remains by weight.
+	 * qos_l4s=1 additionally flags every class queue L4S (EXPERIMENTAL -
+	 * DualPI2 marking for ECT(1) flows; harmless no-op if the TM rejects it). */
+	{
+		char *sbuf, *sg, *st;
+		int widx;
+		for (widx = 0; widx < 5; widx++) sched_w[widx] = 0;	/* 0 = SP */
+		sg = sbuf = strdup(nvram_safe_get("qos_sched"));
+		for (widx = 0; widx < 5 && sg; widx++) {
+			if ((st = strsep(&sg, ",")) == NULL) break;
+			if (st[0] == 'w') {
+				int w = atoi(st + 1);
+				if (w >= 1 && w <= 63) sched_w[widx] = w;
+			}
+		}
+		free(sbuf);
+	}
+	l4s = nvram_match("qos_l4s", "1");
+
 	/* class queues 1..5: PI2 + min%/ceil% of OBW from qos_orates (prio order 0..4).
 	 * v3: the min half of each "min-ceil" pair (ignored by v2) is now emitted as
 	 * a committed rate (--minrate) - lower classes keep a guaranteed floor while
@@ -3134,6 +3157,17 @@ int start_hwqos_classful(void)
 		if ((!g) || ((p = strsep(&g, ",")) == NULL)) break;
 		if (sscanf(p, "%u-%u", &rate, &ceil) != 2) continue;
 		qid = i + 1;
+		/* v4: setqcfg FIRST - like setqdropalg it rewrites the whole queue
+		 * config (the v1 ordering lesson), so scheduler mode must land before
+		 * drop-alg and shaper. qsize is platform-tuned, so it is read back at
+		 * run time and preserved; if the read fails the setqcfg is skipped
+		 * (never write a zero qsize). Only emitted when the class actually
+		 * departs from the SP default, so v3 scripts stay byte-identical. */
+		if (sched_w[i] > 0 || l4s) {
+			fprintf(f, "\tQS=$(tmctl getqcfg --devtype 0 --if $WANIF --qid %d | awk '/qsize/{print $3}')\n", qid);
+			fprintf(f, "\t[ -n \"$QS\" ] && tmctl setqcfg --devtype 0 --if $WANIF --qid %d --priority %d --qsize $QS --schedmode %d --weight %d --l4s %d\n",
+				qid, qid, sched_w[i] > 0 ? 2 : 1, sched_w[i] > 0 ? sched_w[i] : 1, l4s ? 1 : 0);
+		}
 		/* obw==0 means "no bandwidth configured" -> leave the class unshaped,
 		 * matching start_hwqos. (calc() floors to 2, so without this guard a
 		 * blank OBW would throttle every 1..99%% class to ~2 kbit.) */
@@ -3169,6 +3203,15 @@ int start_hwqos_classful(void)
 
 	fprintf(f, "\t;;\nstop)\n");
 	fprintf(f, "\ttmctl setportshaper --devtype 0 --if $WANIF --shapingrate 0\n");
+	/* v4: restore strict priority on any queue this script reconfigured
+	 * (setqcfg first, mirroring the start ordering; weight 1 is the lowest
+	 * legal value and is ignored in SP mode - the tool rejects weight 0) */
+	for (i = 0; i < 5; i++) {
+		if (sched_w[i] > 0 || l4s) {
+			fprintf(f, "\tQS=$(tmctl getqcfg --devtype 0 --if $WANIF --qid %d | awk '/qsize/{print $3}')\n", i + 1);
+			fprintf(f, "\t[ -n \"$QS\" ] && tmctl setqcfg --devtype 0 --if $WANIF --qid %d --priority %d --qsize $QS --schedmode 1 --weight 1 --l4s 0\n", i + 1, i + 1);
+		}
+	}
 	for (qid = 0; qid <= 6; qid++) {
 		/* reset minrate along with the ceiling - a bare "--shapingrate 0"
 		 * would leave a stale committed rate configured on the queue */
