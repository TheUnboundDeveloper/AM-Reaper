+/* reaper v1.3.0: stream a collector snapshot for Reaper_Traffic.asp. The only
+ * request input is the window name, matched against a fixed allowlist - the
+ * filesystem path is always one of five literals. */
+static void
+do_reaper_traffic_cgi(char *url, FILE *stream)
+{
+	static const char *wins[] = { "live", "m5", "hour", "day", "month", NULL };
+	char path[48], buf[4096];
+	const char *want = "live";
+	char *q;
+	FILE *f;
+	size_t n;
+	int i;
+
+	if ((q = strstr(url, "f=")) != NULL) {
+		for (i = 0; wins[i]; i++) {
+			size_t l = strlen(wins[i]);
+			if (strncmp(q + 2, wins[i], l) == 0 &&
+			    (q[2 + l] == '\0' || q[2 + l] == '&')) {
+				want = wins[i];
+				break;
+			}
+		}
+	}
+	snprintf(path, sizeof(path), "/tmp/rtraf/%s.json", want);
+	if ((f = fopen(path, "r")) == NULL) {
+		websWrite(stream, "{}");
+		return;
+	}
+	while ((n = fread(buf, 1, sizeof(buf), f)) > 0)
+		fwrite(buf, 1, n, stream);
+	fclose(f);
+}
+
