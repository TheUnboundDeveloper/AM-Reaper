diff --git a/release/src/router/rtrafd/rtrafd.c b/release/src/router/rtrafd/rtrafd.c
new file mode 100644
index 0000000000..94fa656dcb
--- /dev/null
+++ b/release/src/router/rtrafd/rtrafd.c
@@ -0,0 +1,704 @@
+/*
+ * rtrafd - reaper traffic collector (v1, firmware v1.2.10)
+ *
+ * Samples every POLL seconds:
+ *   - /proc/net/dev            WAN + all br* interfaces (per-network)
+ *   - /proc/net/nf_conntrack   per-client byte deltas (LAN-attributed) + top talkers
+ *   - tmctl getqstats          per-QoS-class tx/drops (only while HW classful runs)
+ *   - optional ping probe      WAN latency/loss (opt-in, user-set target)
+ *
+ * Keeps four ring granularities per series (5min x 288 = 24h, hour x 336 = 14d,
+ * day x 366, month x 24) and publishes JSON snapshots under /tmp/rtraf/ for the
+ * authenticated httpd endpoint. History survives reboot only when the owner
+ * selects a persistent store (nvram rtraf_path: "" = RAM, "jffs", "usb") -
+ * mirroring the classic rstats save-location feature.
+ *
+ * Accounting caveats (documented in the UI FAQ): per-client numbers come from
+ * conntrack, which the flow accelerator syncs periodically - short flows that
+ * die between polls may undercount slightly. IPv6 flows count toward interface
+ * totals but are not client-attributed in v1.
+ */
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+#include <stdint.h>
+#include <time.h>
+#include <signal.h>
+#include <syslog.h>
+#include <errno.h>
+#include <dirent.h>
+#include <fcntl.h>
+#include <sys/stat.h>
+#include <sys/types.h>
+#include <arpa/inet.h>
+
+#include <bcmnvram.h>
+#include <shutils.h>
+#include <shared.h>
+
+#define POLL		30
+#define N5		288	/* 5-min slots  (24 h) */
+#define NH		336	/* hour slots   (14 d) */
+#define ND		366	/* day slots    (~1 y) */
+#define NM		24	/* month slots  (2 y)  */
+#define NNET		8
+#define NCLI		64
+#define NFLOW		16384	/* conntrack delta table (power of 2) */
+#define NTOP		20
+#define SAVE_EVERY	3600	/* persist once an hour */
+#define DB_MAGIC	0x52545246	/* "RTRF" */
+#define DB_VER		1
+
+typedef struct { uint64_t rx, tx; } cnt_t;	/* class rings: rx=txbytes, tx=dropped pkts */
+						/* probe ring:  rx=avg rtt us, tx=loss %   */
+typedef struct {
+	cnt_t b5[N5], bh[NH], bd[ND], bm[NM];
+} ring_t;
+
+typedef struct {
+	uint64_t key;
+	uint64_t ob, rb;	/* last seen orig/reply byte counters */
+	uint32_t gen;
+} flow_t;
+
+typedef struct {
+	char key[20];		/* MAC "aa:bb:cc:dd:ee:ff" or bare IP */
+	char ip[16];
+	time_t last;
+	int used;
+} cli_t;
+
+/* persisted header (rings follow in fixed order) */
+typedef struct {
+	uint32_t magic, ver;
+	int64_t saved;
+	int nnet;
+	char netname[NNET][16];
+	cli_t cli[NCLI];
+} dbhdr_t;
+
+static ring_t *r_wan, *r_net[NNET], *r_cls[7], *r_cli[NCLI], *r_prb;
+static char netname[NNET][16];
+static int nnet = 0;
+static cli_t cli[NCLI];
+static flow_t *flows;
+static uint32_t flowgen = 0;
+
+static uint64_t last_if_rx[NNET + 1], last_if_tx[NNET + 1];	/* [0]=wan */
+static int have_if_last[NNET + 1];
+static uint64_t last_cls_txb[7], last_cls_dp[7];
+static int have_cls_last = 0;
+
+static uint32_t lan_net = 0, lan_mask = 0;
+static volatile sig_atomic_t running = 1;
+
+/* probe accumulators for the open 5-min bucket */
+static uint64_t prb_rtt_sum = 0;
+static uint32_t prb_n = 0, prb_lost = 0;
+
+/* quota syslog once-flags */
+static int warned80 = 0, warned100 = 0, warn_month = -1;
+
+/* current live snapshot (for live.json) */
+typedef struct {
+	char src[16], dst[46];
+	int dport, proto;	/* proto: 6/17/other */
+	uint64_t rate;		/* bytes/sec both dirs */
+	uint64_t up, dn;	/* delta bytes this poll */
+} top_t;
+static top_t top[NTOP];
+static int ntop = 0;
+
+static void on_term(int sig) { (void)sig; running = 0; }
+
+static uint64_t fnv64(const char *s)
+{
+	uint64_t h = 1469598103934665603ULL;
+	while (*s) { h ^= (unsigned char)*s++; h *= 1099511628211ULL; }
+	return h ? h : 1;
+}
+
+/* ---------- slot indexing ---------- */
+static int i5cur, ihcur, idcur, imcur;
+
+static void slots_for(time_t t, int *i5, int *ih, int *id, int *im)
+{
+	struct tm tm;
+	localtime_r(&t, &tm);
+	*i5 = (int)((t / 300) % N5);
+	*ih = (int)((t / 3600) % NH);
+	*id = tm.tm_yday % ND;
+	*im = ((tm.tm_year * 12) + tm.tm_mon) % NM;
+}
+
+static void ring_zero_slot(ring_t *r, int which, int idx)
+{
+	if (!r) return;
+	switch (which) {
+	case 0: r->b5[idx].rx = r->b5[idx].tx = 0; break;
+	case 1: r->bh[idx].rx = r->bh[idx].tx = 0; break;
+	case 2: r->bd[idx].rx = r->bd[idx].tx = 0; break;
+	case 3: r->bm[idx].rx = r->bm[idx].tx = 0; break;
+	}
+}
+
+static void all_zero_slot(int which, int idx)
+{
+	int i;
+	ring_zero_slot(r_wan, which, idx);
+	for (i = 0; i < NNET; i++) ring_zero_slot(r_net[i], which, idx);
+	for (i = 0; i < 7; i++) ring_zero_slot(r_cls[i], which, idx);
+	for (i = 0; i < NCLI; i++) ring_zero_slot(r_cli[i], which, idx);
+	ring_zero_slot(r_prb, which, idx);
+}
+
+static void ring_add(ring_t *r, uint64_t rx, uint64_t tx)
+{
+	if (!r) return;
+	r->b5[i5cur].rx += rx; r->b5[i5cur].tx += tx;
+	r->bh[ihcur].rx += rx; r->bh[ihcur].tx += tx;
+	r->bd[idcur].rx += rx; r->bd[idcur].tx += tx;
+	r->bm[imcur].rx += rx; r->bm[imcur].tx += tx;
+}
+
+/* ---------- helpers ---------- */
+static int ifname_ok(const char *s)
+{
+	for (; *s; s++)
+		if (!((*s >= 'a' && *s <= 'z') || (*s >= 'A' && *s <= 'Z') ||
+		      (*s >= '0' && *s <= '9') || *s == '.' || *s == '_' || *s == '-'))
+			return 0;
+	return 1;
+}
+
+static int host_ok(const char *s)	/* probe target: hostname / IPv4 chars only */
+{
+	if (!*s || strlen(s) > 63) return 0;
+	for (; *s; s++)
+		if (!((*s >= 'a' && *s <= 'z') || (*s >= 'A' && *s <= 'Z') ||
+		      (*s >= '0' && *s <= '9') || *s == '.' || *s == '-'))
+			return 0;
+	return 1;
+}
+
+static int net_slot(const char *name)
+{
+	int i;
+	for (i = 0; i < nnet; i++)
+		if (strcmp(netname[i], name) == 0) return i;
+	if (nnet >= NNET) return -1;
+	strlcpy(netname[nnet], name, sizeof(netname[0]));
+	return nnet++;
+}
+
+static int cli_slot(const char *key, const char *ip)
+{
+	int i, oldest = 0;
+	time_t omin = 0;
+	for (i = 0; i < NCLI; i++)
+		if (cli[i].used && strcmp(cli[i].key, key) == 0) {
+			strlcpy(cli[i].ip, ip, sizeof(cli[i].ip));
+			cli[i].last = time(NULL);
+			return i;
+		}
+	for (i = 0; i < NCLI; i++)
+		if (!cli[i].used) { oldest = i; goto take; }
+	/* LRU replace: wipe that client's history */
+	for (i = 0; i < NCLI; i++)
+		if (omin == 0 || cli[i].last < omin) { omin = cli[i].last; oldest = i; }
+	memset(r_cli[oldest], 0, sizeof(ring_t));
+take:
+	cli[oldest].used = 1;
+	strlcpy(cli[oldest].key, key, sizeof(cli[0].key));
+	strlcpy(cli[oldest].ip, ip, sizeof(cli[0].ip));
+	cli[oldest].last = time(NULL);
+	return oldest;
+}
+
+/* ip -> mac from /proc/net/arp (linear scan; table is small) */
+static int arp_mac(const char *ip, char *mac, size_t maclen)
+{
+	FILE *f = fopen("/proc/net/arp", "r");
+	char line[256], aip[64], hw[64], dev[32];
+	int type, fl;
+	if (!f) return 0;
+	fgets(line, sizeof(line), f);	/* header */
+	while (fgets(line, sizeof(line), f)) {
+		if (sscanf(line, "%63s 0x%x 0x%x %63s %*s %31s", aip, &type, &fl, hw, dev) < 4)
+			continue;
+		if (strcmp(aip, ip) == 0 && strcmp(hw, "00:00:00:00:00:00") != 0) {
+			strlcpy(mac, hw, maclen);
+			fclose(f);
+			return 1;
+		}
+	}
+	fclose(f);
+	return 0;
+}
+
+/* ---------- pollers ---------- */
+static void poll_ifaces(const char *wanif)
+{
+	FILE *f = fopen("/proc/net/dev", "r");
+	char line[512], name[32];
+	uint64_t rxb, txb;
+	if (!f) return;
+	while (fgets(line, sizeof(line), f)) {
+		char *c = strchr(line, ':');
+		char *s = line;
+		if (!c) continue;
+		*c = '\0';
+		while (*s == ' ') s++;
+		strlcpy(name, s, sizeof(name));
+		if (sscanf(c + 1, "%llu %*u %*u %*u %*u %*u %*u %*u %llu",
+			   (unsigned long long *)&rxb, (unsigned long long *)&txb) != 2)
+			continue;
+		if (strcmp(name, wanif) == 0) {
+			if (have_if_last[0] && rxb >= last_if_rx[0] && txb >= last_if_tx[0])
+				ring_add(r_wan, rxb - last_if_rx[0], txb - last_if_tx[0]);
+			last_if_rx[0] = rxb; last_if_tx[0] = txb; have_if_last[0] = 1;
+		} else if (strncmp(name, "br", 2) == 0 && name[2] >= '0' && name[2] <= '9') {
+			int sl = net_slot(name);
+			if (sl < 0) continue;
+			if (have_if_last[sl + 1] && rxb >= last_if_rx[sl + 1] && txb >= last_if_tx[sl + 1])
+				ring_add(r_net[sl], rxb - last_if_rx[sl + 1], txb - last_if_tx[sl + 1]);
+			last_if_rx[sl + 1] = rxb; last_if_tx[sl + 1] = txb; have_if_last[sl + 1] = 1;
+		}
+	}
+	fclose(f);
+}
+
+static void poll_classes(const char *wanif)
+{
+	int qid;
+	char cmd[160], line[160];
+	if (!(nvram_get_int("qos_enable") == 1 && nvram_get_int("qos_type") == 11)) {
+		have_cls_last = 0;
+		return;
+	}
+	for (qid = 0; qid <= 6; qid++) {
+		uint64_t txb = 0, dp = 0;
+		FILE *p;
+		snprintf(cmd, sizeof(cmd), "tmctl getqstats --devtype 0 --if %s --qid %d", wanif, qid);
+		if ((p = popen(cmd, "r")) == NULL) return;
+		while (fgets(line, sizeof(line), p)) {
+			sscanf(line, " txBytes: %llu", (unsigned long long *)&txb);
+			sscanf(line, " droppedPackets: %llu", (unsigned long long *)&dp);
+		}
+		pclose(p);
+		if (have_cls_last && txb >= last_cls_txb[qid] && dp >= last_cls_dp[qid])
+			ring_add(r_cls[qid], txb - last_cls_txb[qid], dp - last_cls_dp[qid]);
+		last_cls_txb[qid] = txb; last_cls_dp[qid] = dp;
+	}
+	have_cls_last = 1;
+}
+
+static void top_note(const char *src, const char *dst, int dport, int proto,
+		     uint64_t up, uint64_t dn)
+{
+	uint64_t rate = (up + dn) / POLL;
+	int i, worst = 0;
+	if (rate == 0) return;
+	if (ntop < NTOP) { i = ntop++; goto put; }
+	for (i = 1; i < NTOP; i++)
+		if (top[i].rate < top[worst].rate) worst = i;
+	if (rate <= top[worst].rate) return;
+	i = worst;
+put:
+	strlcpy(top[i].src, src, sizeof(top[0].src));
+	strlcpy(top[i].dst, dst, sizeof(top[0].dst));
+	top[i].dport = dport; top[i].proto = proto;
+	top[i].rate = rate; top[i].up = up; top[i].dn = dn;
+}
+
+static void poll_conntrack(void)
+{
+	FILE *f = fopen("/proc/net/nf_conntrack", "r");
+	char line[768];
+	if (!f) return;
+	flowgen++;
+	ntop = 0;
+	while (fgets(line, sizeof(line), f)) {
+		char proto[16] = "", src[64] = "", dst[64] = "";
+		char rsrc[64] = "";
+		unsigned long long ob = 0, rb = 0;
+		int sport = 0, dport = 0, pnum = 0;
+		char *p;
+
+		if (strncmp(line, "ipv4", 4) != 0) continue;	/* v1: v4 attribution only */
+		if (sscanf(line, "%*s %*d %15s %d", proto, &pnum) != 2) continue;
+
+		/* original direction: first src=/dst=/sport=/dport=/bytes= */
+		if ((p = strstr(line, "src=")) == NULL) continue;
+		sscanf(p, "src=%63s", src);
+		if ((p = strstr(p, "dst=")) == NULL) continue;
+		sscanf(p, "dst=%63s", dst);
+		if ((p = strstr(p, "sport=")) != NULL) sscanf(p, "sport=%d", &sport);
+		if (p && (p = strstr(p, "dport=")) != NULL) sscanf(p, "dport=%d", &dport);
+		if ((p = strstr(line, "bytes=")) == NULL) continue;	/* needs nf_conntrack_acct=1 */
+		sscanf(p, "bytes=%llu", &ob);
+		/* reply direction: second src= then its bytes= */
+		if ((p = strstr(p, "src=")) != NULL) {
+			sscanf(p, "src=%63s", rsrc);
+			if ((p = strstr(p, "bytes=")) != NULL) sscanf(p, "bytes=%llu", &rb);
+		}
+
+		/* LAN attribution */
+		{
+			struct in_addr a;
+			uint64_t key, dob, drb;
+			uint32_t idx;
+			flow_t *fl;
+			char kbuf[160], mac[20];
+			int ci;
+
+			if (inet_aton(src, &a) == 0) continue;
+			if ((ntohl(a.s_addr) & lan_mask) != lan_net) continue;
+
+			snprintf(kbuf, sizeof(kbuf), "%d/%s/%s/%d/%d", pnum, src, dst, sport, dport);
+			key = fnv64(kbuf);
+			idx = (uint32_t)(key & (NFLOW - 1));
+			fl = NULL;
+			{
+				uint32_t j;
+				for (j = 0; j < NFLOW; j++) {
+					flow_t *e = &flows[(idx + j) & (NFLOW - 1)];
+					if (e->key == key) { fl = e; break; }
+					if (e->key == 0 || (int)(flowgen - e->gen) > 2) { fl = e; fl->key = 0; break; }
+				}
+			}
+			if (!fl) continue;	/* table full - skip flow */
+			if (fl->key == key && ob >= fl->ob && rb >= fl->rb) {
+				dob = ob - fl->ob; drb = rb - fl->rb;
+			} else {
+				dob = ob; drb = rb;	/* new (or recycled) entry: count from zero */
+			}
+			fl->key = key; fl->ob = ob; fl->rb = rb; fl->gen = flowgen;
+
+			if (dob == 0 && drb == 0) continue;
+			if (!arp_mac(src, mac, sizeof(mac)))
+				strlcpy(mac, src, sizeof(mac));
+			ci = cli_slot(mac, src);
+			ring_add(r_cli[ci], drb, dob);	/* rx=download(reply), tx=upload(orig) */
+			top_note(src, dst, dport, pnum, dob, drb);
+		}
+	}
+	fclose(f);
+}
+
+static void poll_probe(void)
+{
+	char tgt[64], cmd[128], line[256];
+	FILE *p;
+	int got = 0;
+	strlcpy(tgt, nvram_safe_get("rtraf_probe"), sizeof(tgt));
+	if (!host_ok(tgt)) return;
+	snprintf(cmd, sizeof(cmd), "ping -c 1 -W 2 %s 2>/dev/null", tgt);
+	if ((p = popen(cmd, "r")) == NULL) return;
+	while (fgets(line, sizeof(line), p)) {
+		char *t = strstr(line, "time=");
+		if (t) {
+			double ms = atof(t + 5);
+			prb_rtt_sum += (uint64_t)(ms * 1000.0);
+			got = 1;
+		}
+	}
+	pclose(p);
+	prb_n++;
+	if (!got) prb_lost++;
+}
+
+static void probe_close_bucket(void)
+{
+	uint64_t rtt = prb_n > prb_lost && prb_n ? prb_rtt_sum / (prb_n - prb_lost) : 0;
+	uint64_t loss = prb_n ? (prb_lost * 100) / prb_n : 0;
+	/* store straight into the JUST-CLOSED 5-min slot; hour/day/month keep the
+	 * latest closed values (coarse but adequate for an overlay) */
+	r_prb->b5[i5cur].rx = rtt; r_prb->b5[i5cur].tx = loss;
+	r_prb->bh[ihcur].rx = rtt; r_prb->bh[ihcur].tx = loss;
+	r_prb->bd[idcur].rx = rtt; r_prb->bd[idcur].tx = loss;
+	r_prb->bm[imcur].rx = rtt; r_prb->bm[imcur].tx = loss;
+	prb_rtt_sum = 0; prb_n = prb_lost = 0;
+}
+
+/* ---------- quota ---------- */
+static void check_quota(void)
+{
+	uint64_t cap_gb = strtoull(nvram_safe_get("rtraf_cap_gb"), NULL, 10);
+	uint64_t used;
+	struct tm tm;
+	time_t t = time(NULL);
+	localtime_r(&t, &tm);
+	if (warn_month != tm.tm_mon) { warned80 = warned100 = 0; warn_month = tm.tm_mon; }
+	if (cap_gb == 0) return;
+	used = r_wan->bm[imcur].rx + r_wan->bm[imcur].tx;
+	if (!warned100 && used >= cap_gb * 1000000000ULL) {
+		syslog(LOG_WARNING, "rtrafd: monthly WAN data cap REACHED (%llu GB cap)", (unsigned long long)cap_gb);
+		warned100 = 1;
+	} else if (!warned80 && used * 10 >= cap_gb * 1000000000ULL * 8) {
+		syslog(LOG_WARNING, "rtrafd: monthly WAN usage passed 80%% of the %llu GB cap", (unsigned long long)cap_gb);
+		warned80 = 1;
+	}
+}
+
+/* ---------- JSON output ---------- */
+static void json_ring(FILE *o, ring_t *r, int which)
+{
+	cnt_t *a = which == 0 ? r->b5 : which == 1 ? r->bh : which == 2 ? r->bd : r->bm;
+	int n = which == 0 ? N5 : which == 1 ? NH : which == 2 ? ND : NM;
+	int cur = which == 0 ? i5cur : which == 1 ? ihcur : which == 2 ? idcur : imcur;
+	int i;
+	fputc('[', o);
+	for (i = 0; i < n; i++) {
+		int idx = (cur + 1 + i) % n;	/* oldest -> newest, ends at current */
+		fprintf(o, "%s[%llu,%llu]", i ? "," : "",
+			(unsigned long long)a[idx].rx, (unsigned long long)a[idx].tx);
+	}
+	fputc(']', o);
+}
+
+static void write_hist(int which, const char *fn, int step)
+{
+	char tmp[64], path[64];
+	FILE *o;
+	int i;
+	snprintf(tmp, sizeof(tmp), "/tmp/rtraf/.%s", fn);
+	snprintf(path, sizeof(path), "/tmp/rtraf/%s", fn);
+	if ((o = fopen(tmp, "w")) == NULL) return;
+	fprintf(o, "{\"now\":%lld,\"step\":%d,\"wan\":", (long long)time(NULL), step);
+	json_ring(o, r_wan, which);
+	fprintf(o, ",\"nets\":{");
+	for (i = 0; i < nnet; i++) {
+		fprintf(o, "%s\"%s\":", i ? "," : "", netname[i]);
+		json_ring(o, r_net[i], which);
+	}
+	fprintf(o, "},\"class\":{");
+	for (i = 0; i <= 6; i++) {
+		fprintf(o, "%s\"q%d\":", i ? "," : "", i);
+		json_ring(o, r_cls[i], which);
+	}
+	fprintf(o, "},\"clients\":{");
+	{
+		int first = 1;
+		for (i = 0; i < NCLI; i++) {
+			if (!cli[i].used) continue;
+			fprintf(o, "%s\"%s\":{\"ip\":\"%s\",\"d\":", first ? "" : ",", cli[i].key, cli[i].ip);
+			json_ring(o, r_cli[i], which);
+			fputc('}', o);
+			first = 0;
+		}
+	}
+	fprintf(o, "},\"probe\":");
+	json_ring(o, r_prb, which);
+	fprintf(o, "}");
+	fclose(o);
+	rename(tmp, path);
+}
+
+static void write_live(const char *store, uint64_t wrx_d, uint64_t wtx_d,
+		       uint64_t cls_txd[7], uint64_t cls_dpd[7], int qos_on)
+{
+	FILE *o = fopen("/tmp/rtraf/.live.json", "w");
+	int i;
+	uint64_t cap_gb = strtoull(nvram_safe_get("rtraf_cap_gb"), NULL, 10);
+	if (!o) return;
+	fprintf(o, "{\"t\":%lld,\"poll\":%d,\"store\":\"%s\",\"qos\":%d",
+		(long long)time(NULL), POLL, store, qos_on);
+	fprintf(o, ",\"wan\":{\"rx_bps\":%llu,\"tx_bps\":%llu}",
+		(unsigned long long)(wrx_d * 8 / POLL), (unsigned long long)(wtx_d * 8 / POLL));
+	fprintf(o, ",\"class\":[");
+	for (i = 0; i <= 6; i++)
+		fprintf(o, "%s{\"tx_bps\":%llu,\"dp\":%llu}", i ? "," : "",
+			(unsigned long long)(cls_txd[i] * 8 / POLL), (unsigned long long)cls_dpd[i]);
+	fprintf(o, "],\"quota\":{\"used\":%llu,\"cap_gb\":%llu}",
+		(unsigned long long)(r_wan->bm[imcur].rx + r_wan->bm[imcur].tx),
+		(unsigned long long)cap_gb);
+	fprintf(o, ",\"probe\":{\"rtt_us\":%llu,\"loss\":%llu}",
+		(unsigned long long)r_prb->b5[i5cur].rx, (unsigned long long)r_prb->b5[i5cur].tx);
+	fprintf(o, ",\"top\":[");
+	for (i = 0; i < ntop; i++)
+		fprintf(o, "%s{\"src\":\"%s\",\"dst\":\"%s\",\"dport\":%d,\"proto\":%d,\"rate\":%llu,\"up\":%llu,\"dn\":%llu}",
+			i ? "," : "", top[i].src, top[i].dst, top[i].dport, top[i].proto,
+			(unsigned long long)top[i].rate, (unsigned long long)top[i].up,
+			(unsigned long long)top[i].dn);
+	fprintf(o, "]}");
+	fclose(o);
+	rename("/tmp/rtraf/.live.json", "/tmp/rtraf/live.json");
+}
+
+/* ---------- persistence (RAM / jffs / usb) ---------- */
+static const char *resolve_store(char *buf, size_t len)
+{
+	char mode[16];
+	strlcpy(mode, nvram_safe_get("rtraf_path"), sizeof(mode));
+	if (strcmp(mode, "jffs") == 0) {
+		mkdir("/jffs/reaper", 0700);
+		if (access("/jffs/reaper", W_OK) == 0) {
+			strlcpy(buf, "/jffs/reaper/rtraf.db", len);
+			return "jffs";
+		}
+	} else if (strcmp(mode, "usb") == 0) {
+		DIR *d = opendir("/tmp/mnt");
+		struct dirent *e;
+		if (d) {
+			while ((e = readdir(d)) != NULL) {
+				char p[128];
+				if (e->d_name[0] == '.') continue;
+				snprintf(p, sizeof(p), "/tmp/mnt/%s/reaper", e->d_name);
+				mkdir(p, 0700);
+				if (access(p, W_OK) == 0) {
+					snprintf(buf, len, "%s/rtraf.db", p);
+					closedir(d);
+					return "usb";
+				}
+			}
+			closedir(d);
+		}
+	}
+	buf[0] = '\0';
+	return "ram";
+}
+
+static void db_save(const char *path)
+{
+	dbhdr_t h;
+	FILE *o;
+	char tmp[160];
+	int i;
+	if (!path[0]) return;
+	snprintf(tmp, sizeof(tmp), "%s.new", path);
+	if ((o = fopen(tmp, "w")) == NULL) return;
+	memset(&h, 0, sizeof(h));
+	h.magic = DB_MAGIC; h.ver = DB_VER; h.saved = time(NULL); h.nnet = nnet;
+	memcpy(h.netname, netname, sizeof(netname));
+	memcpy(h.cli, cli, sizeof(cli));
+	fwrite(&h, sizeof(h), 1, o);
+	fwrite(r_wan, sizeof(ring_t), 1, o);
+	for (i = 0; i < NNET; i++) fwrite(r_net[i], sizeof(ring_t), 1, o);
+	for (i = 0; i < 7; i++) fwrite(r_cls[i], sizeof(ring_t), 1, o);
+	for (i = 0; i < NCLI; i++) fwrite(r_cli[i], sizeof(ring_t), 1, o);
+	fwrite(r_prb, sizeof(ring_t), 1, o);
+	fclose(o);
+	rename(tmp, path);
+}
+
+static void db_load(const char *path)
+{
+	dbhdr_t h;
+	FILE *o;
+	int i;
+	if (!path[0] || (o = fopen(path, "r")) == NULL) return;
+	if (fread(&h, sizeof(h), 1, o) != 1 || h.magic != DB_MAGIC || h.ver != DB_VER) {
+		fclose(o);
+		return;
+	}
+	nnet = h.nnet > NNET ? NNET : h.nnet;
+	memcpy(netname, h.netname, sizeof(netname));
+	memcpy(cli, h.cli, sizeof(cli));
+	if (fread(r_wan, sizeof(ring_t), 1, o) != 1) goto out;
+	for (i = 0; i < NNET; i++) if (fread(r_net[i], sizeof(ring_t), 1, o) != 1) goto out;
+	for (i = 0; i < 7; i++) if (fread(r_cls[i], sizeof(ring_t), 1, o) != 1) goto out;
+	for (i = 0; i < NCLI; i++) if (fread(r_cli[i], sizeof(ring_t), 1, o) != 1) goto out;
+	fread(r_prb, sizeof(ring_t), 1, o);
+	syslog(LOG_INFO, "rtrafd: history restored from %s (saved %lld)", path, (long long)h.saved);
+out:
+	fclose(o);
+}
+
+/* ---------- main ---------- */
+int main(int argc, char **argv)
+{
+	char wanif[24], dbpath[160];
+	const char *store;
+	time_t last_save;
+	int i;
+
+	if (daemon(0, 0) < 0) return 1;
+	openlog("rtrafd", LOG_PID, LOG_DAEMON);
+	signal(SIGTERM, on_term);
+	signal(SIGINT, on_term);
+
+	/* allocations (about 1.3 MB of rings + flow table) */
+	r_wan = calloc(1, sizeof(ring_t));
+	for (i = 0; i < NNET; i++) r_net[i] = calloc(1, sizeof(ring_t));
+	for (i = 0; i < 7; i++) r_cls[i] = calloc(1, sizeof(ring_t));
+	for (i = 0; i < NCLI; i++) r_cli[i] = calloc(1, sizeof(ring_t));
+	r_prb = calloc(1, sizeof(ring_t));
+	flows = calloc(NFLOW, sizeof(flow_t));
+	if (!r_wan || !r_prb || !flows) return 1;
+
+	mkdir("/tmp/rtraf", 0700);
+	f_write_string("/proc/sys/net/netfilter/nf_conntrack_acct", "1", 0, 0);
+
+	strlcpy(wanif, get_wan_ifname(wan_primary_ifunit()), sizeof(wanif));
+	if (!ifname_ok(wanif) || !wanif[0]) strlcpy(wanif, "eth0", sizeof(wanif));
+
+	{
+		struct in_addr a, m;
+		if (inet_aton(nvram_safe_get("lan_ipaddr"), &a) &&
+		    inet_aton(nvram_safe_get("lan_netmask"), &m)) {
+			lan_mask = ntohl(m.s_addr);
+			lan_net = ntohl(a.s_addr) & lan_mask;
+		}
+	}
+
+	store = resolve_store(dbpath, sizeof(dbpath));
+	db_load(dbpath);
+	last_save = time(NULL);
+	slots_for(time(NULL), &i5cur, &ihcur, &idcur, &imcur);
+	syslog(LOG_INFO, "rtrafd: started (store=%s wan=%s)", store, wanif);
+
+	while (running) {
+		time_t now = time(NULL);
+		int n5, nh, nd, nm;
+		uint64_t wrx0 = r_wan->b5[i5cur].rx, wtx0 = r_wan->b5[i5cur].tx;
+		uint64_t c_tx0[7], c_dp0[7], cls_txd[7], cls_dpd[7];
+
+		slots_for(now, &n5, &nh, &nd, &nm);
+		if (n5 != i5cur) {
+			probe_close_bucket();
+			/* publish closing snapshots BEFORE advancing */
+			write_hist(0, "m5.json", 300);
+			if (nh != ihcur) write_hist(1, "hour.json", 3600);
+			if (nd != idcur) write_hist(2, "day.json", 86400);
+			if (nm != imcur) write_hist(3, "month.json", 0);
+			if (n5 != i5cur) all_zero_slot(0, n5);
+			if (nh != ihcur) all_zero_slot(1, nh);
+			if (nd != idcur) all_zero_slot(2, nd);
+			if (nm != imcur) all_zero_slot(3, nm);
+			i5cur = n5; ihcur = nh; idcur = nd; imcur = nm;
+			wrx0 = r_wan->b5[i5cur].rx; wtx0 = r_wan->b5[i5cur].tx;
+		}
+
+		for (i = 0; i <= 6; i++) { c_tx0[i] = r_cls[i]->b5[i5cur].rx; c_dp0[i] = r_cls[i]->b5[i5cur].tx; }
+
+		poll_ifaces(wanif);
+		poll_classes(wanif);
+		poll_conntrack();
+		poll_probe();
+		check_quota();
+
+		for (i = 0; i <= 6; i++) {
+			cls_txd[i] = r_cls[i]->b5[i5cur].rx - c_tx0[i];
+			cls_dpd[i] = r_cls[i]->b5[i5cur].tx - c_dp0[i];
+		}
+		write_live(store, r_wan->b5[i5cur].rx - wrx0, r_wan->b5[i5cur].tx - wtx0,
+			   cls_txd, cls_dpd,
+			   nvram_get_int("qos_enable") == 1 && nvram_get_int("qos_type") == 11);
+
+		if (now - last_save >= SAVE_EVERY) {
+			store = resolve_store(dbpath, sizeof(dbpath));
+			db_save(dbpath);
+			last_save = now;
+		}
+
+		for (i = 0; i < POLL && running; i++) sleep(1);
+	}
+
+	store = resolve_store(dbpath, sizeof(dbpath));
+	db_save(dbpath);
+	syslog(LOG_INFO, "rtrafd: stopped (history %s)", dbpath[0] ? "saved" : "in RAM only - lost");
+	return 0;
+}
