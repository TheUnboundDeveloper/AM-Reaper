+++ b/release/src/router/www/Reaper_Traffic.asp
@@ -0,0 +1,429 @@
+<!DOCTYPE html>
+<html lang="en">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width, initial-scale=1">
+<meta name="reaper-native" content="1">
+<title>REAPER &mdash; Traffic Analyzer</title>
+<style>
+@font-face{font-family:'Rajdhani';font-weight:600;font-display:swap;src:url('/fonts/rajdhani-600.woff2') format('woff2')}
+@font-face{font-family:'Rajdhani';font-weight:700;font-display:swap;src:url('/fonts/rajdhani-700.woff2') format('woff2')}
+@font-face{font-family:'Inter';font-weight:400;font-display:swap;src:url('/fonts/inter-400.woff2') format('woff2')}
+@font-face{font-family:'Inter';font-weight:500;font-display:swap;src:url('/fonts/inter-500.woff2') format('woff2')}
+@font-face{font-family:'Inter';font-weight:600;font-display:swap;src:url('/fonts/inter-600.woff2') format('woff2')}
+:root{
+  --bg:#08080a; --panel:#0f0f12; --panel-2:#141418; --surface-1:#141418;
+  --line-soft:rgba(255,255,255,.06); --line:rgba(225,6,0,.16);
+  --crimson:#E10600; --crimson-deep:#B3000C;
+  --bone:#ECE7DB; --bone-dim:#B7B1A4; --steel:#71767b;
+  --jade:#4FB286; --amber:#E0A93B;
+  /* validated categorical series (dataviz dark set) for stacked classes/networks */
+  --s1:#3987e5; --s2:#199e70; --s3:#c98500; --s4:#9085e9; --s5:#d95926;
+  --s6:#e66767; --s7:#d55181;
+  --hdr:'Rajdhani','Oswald',system-ui,sans-serif;
+  --body:'Inter',system-ui,-apple-system,Segoe UI,sans-serif;
+}
+*{box-sizing:border-box}
+html,body{margin:0;min-height:100%}
+body{font-family:var(--body);color:var(--bone-dim);background:var(--bg);
+  background-image:radial-gradient(1200px 500px at 18% -10%,rgba(225,6,0,.10),transparent 60%),
+    radial-gradient(100% 100% at 50% 40%,transparent 55%,rgba(0,0,0,.55) 100%);
+  -webkit-font-smoothing:antialiased;padding:22px 26px 60px}
+h1,h2,h3,.hdr{font-family:var(--hdr);letter-spacing:.04em;color:var(--bone);margin:0}
+.mono{font-variant-numeric:tabular-nums}
+html{scrollbar-width:thin;scrollbar-color:var(--crimson) #000}
+::-webkit-scrollbar{width:12px;height:12px}::-webkit-scrollbar-track{background:#000}
+::-webkit-scrollbar-thumb{background:var(--crimson);border-radius:8px;border:2px solid #000}
+.eyebrow{font-family:var(--hdr);text-transform:uppercase;letter-spacing:.22em;font-size:11px;color:var(--steel)}
+a{color:var(--bone-dim)} a:hover{color:var(--bone)}
+
+.pagehead{display:flex;align-items:center;gap:14px;margin-bottom:16px;flex-wrap:wrap}
+.pagehead h1{font-size:24px;font-weight:700}
+.spacer{flex:1}
+.pill{display:inline-flex;align-items:center;gap:7px;border:1px solid var(--line-soft);border-radius:999px;
+  padding:5px 12px;font-family:var(--hdr);font-weight:600;font-size:12px;letter-spacing:.06em;color:var(--bone-dim);background:var(--panel)}
+.pill .dot{width:8px;height:8px;border-radius:50%;background:var(--jade)}
+.btn{display:inline-block;border:1px solid var(--line-soft);background:var(--panel);color:var(--bone);
+  font-family:var(--hdr);font-weight:600;font-size:13px;letter-spacing:.05em;border-radius:9px;padding:9px 16px;cursor:pointer;text-transform:uppercase}
+.btn:hover{border-color:var(--line)}
+.btn.ghost{background:transparent}
+
+/* window tabs */
+.wins{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:16px}
+.win{font-family:var(--hdr);font-weight:600;font-size:12.5px;letter-spacing:.06em;text-transform:uppercase;
+  border:1px solid var(--line-soft);background:var(--panel);color:var(--bone-dim);border-radius:8px;padding:8px 15px;cursor:pointer}
+.win:hover{border-color:var(--line)}
+.win.on{color:#fff;background:linear-gradient(180deg,var(--crimson),var(--crimson-deep));border-color:transparent}
+
+.grid{display:grid;grid-template-columns:1fr 1fr;gap:16px}
+@media(max-width:1100px){.grid{grid-template-columns:1fr}}
+.panel{background:var(--panel);border:1px solid var(--line-soft);border-radius:14px;padding:16px 18px;margin-bottom:16px}
+.panel.span{grid-column:1/-1}
+.panel h2{font-size:14px;font-weight:700;text-transform:uppercase;letter-spacing:.12em;margin-bottom:2px}
+.panel .sub{font-size:12px;color:var(--steel);margin:2px 0 12px;line-height:1.5}
+.legend{display:flex;flex-wrap:wrap;gap:12px;margin:8px 0 4px;font-size:12px}
+.legend span{display:inline-flex;align-items:center;gap:6px;color:var(--bone-dim)}
+.legend i{width:11px;height:11px;border-radius:3px;display:inline-block}
+
+/* stat tiles */
+.tiles{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:12px;margin-bottom:16px}
+.tile{border:1px solid var(--line-soft);border-radius:12px;background:var(--panel-2);padding:13px 15px}
+.tile .k{font-family:var(--hdr);font-weight:600;font-size:10.5px;letter-spacing:.14em;text-transform:uppercase;color:var(--steel)}
+.tile .v{font-family:var(--hdr);font-weight:700;font-size:23px;color:var(--bone);margin-top:5px}
+.tile .v small{font-size:13px;color:var(--bone-dim);font-weight:600}
+.tile .v.up{color:var(--jade)} .tile .v.dn{color:var(--s1)}
+
+svg .grid-l{stroke:var(--line-soft);stroke-width:1}
+svg .axl{fill:var(--steel);font:10px var(--body)}
+.chart-wrap{width:100%;overflow-x:auto}
+
+/* tables */
+table.ta{width:100%;border-collapse:collapse}
+table.ta th{font-family:var(--hdr);font-weight:600;font-size:10px;letter-spacing:.13em;text-transform:uppercase;
+  color:var(--steel);text-align:left;padding:7px 8px;border-bottom:1px solid var(--line-soft)}
+table.ta td{padding:8px;border-bottom:1px solid var(--line-soft);font-size:12.5px;color:var(--bone-dim)}
+table.ta tr:last-child td{border-bottom:none}
+table.ta .num{text-align:right;font-variant-numeric:tabular-nums;color:var(--bone)}
+.bar{position:relative;height:7px;border-radius:4px;background:rgba(255,255,255,.05);margin-top:5px;overflow:hidden}
+.bar>span{position:absolute;left:0;top:0;bottom:0;border-radius:4px;background:var(--s1)}
+.tname{color:var(--bone);font-weight:500}
+.badge{font-family:var(--hdr);font-size:9.5px;letter-spacing:.08em;border:1px solid var(--line-soft);border-radius:5px;padding:2px 6px;color:var(--steel)}
+
+/* quota meter */
+.meter{height:12px;border-radius:7px;background:rgba(255,255,255,.05);overflow:hidden;margin:10px 0 6px}
+.meter>span{display:block;height:100%;border-radius:7px;background:linear-gradient(90deg,var(--jade),var(--amber))}
+.meter>span.hot{background:linear-gradient(90deg,var(--amber),var(--crimson))}
+
+/* settings + faq flyout */
+.togglerow{display:flex;align-items:flex-start;gap:12px;padding:11px 0;border-top:1px solid var(--line-soft)}
+.togglerow:first-of-type{border-top:none}
+.tswitch{position:relative;flex:0 0 42px;height:22px;margin-top:2px}
+.tswitch input{position:absolute;opacity:0;width:100%;height:100%;margin:0;cursor:pointer;z-index:2}
+.tswitch .track{position:absolute;inset:0;background:#26262b;border:1px solid var(--line-soft);border-radius:999px}
+.tswitch .track::after{content:"";position:absolute;top:2px;left:2px;width:16px;height:16px;border-radius:50%;background:#6a6f75;transition:.15s}
+.tswitch input:checked~.track{background:#3a3f45}
+.tswitch input:checked~.track::after{left:22px;background:#c9cdd2}
+.tmeta .tname2{font-family:var(--hdr);font-weight:600;font-size:13.5px;letter-spacing:.05em;color:var(--bone)}
+.tmeta .tdesc{font-size:12px;color:var(--steel);line-height:1.5;margin-top:2px}
+.fld{margin:12px 0}
+.fld label{display:block;font-family:var(--hdr);font-weight:600;font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:var(--bone-dim);margin-bottom:6px}
+.fld input,.fld select{background:#000;border:1px solid var(--line-soft);border-radius:8px;color:var(--bone);font-family:var(--body);font-size:13px;padding:9px 11px;outline:none}
+.fld input:focus,.fld select:focus{border-color:var(--line)}
+.fld .u{margin-left:7px;color:var(--steel);font-size:12px}
+.storenote{font-size:12px;color:var(--steel);line-height:1.55;margin-top:6px}
+.storenote b{color:var(--bone-dim)}
+
+.scrim{position:fixed;inset:0;background:rgba(0,0,0,.55);opacity:0;pointer-events:none;transition:.2s;z-index:40}
+.scrim.open{opacity:1;pointer-events:auto}
+.flyout{position:fixed;top:0;right:-460px;width:440px;max-width:92vw;height:100vh;background:var(--panel);border-left:1px solid var(--line);z-index:41;transition:right .22s ease;display:flex;flex-direction:column}
+.flyout.open{right:0}
+.flyout .fhead{display:flex;align-items:center;gap:10px;padding:16px 18px;border-bottom:1px solid var(--line-soft)}
+.flyout .fhead h2{font-size:16px;font-weight:700;flex:1}
+.flyout .fclose{cursor:pointer;color:var(--steel);font-size:20px;padding:2px 6px}
+.flyout .fclose:hover{color:var(--bone)}
+.flyout .fbody{overflow-y:auto;padding:6px 18px 40px}
+.flyout details{border-bottom:1px solid var(--line-soft);padding:2px 0}
+.flyout summary{cursor:pointer;font-family:var(--hdr);font-weight:600;font-size:13.5px;color:var(--bone);padding:12px 2px;list-style:none;position:relative;padding-right:22px}
+.flyout summary::-webkit-details-marker{display:none}
+.flyout summary::after{content:"+";position:absolute;right:4px;top:10px;color:var(--steel);font-size:16px}
+.flyout details[open] summary::after{content:"\2013"}
+.flyout .fc{font-size:12.5px;line-height:1.65;color:var(--bone-dim);padding:0 2px 14px}
+.flyout .fc b{color:var(--bone)}
+.applying{position:fixed;inset:0;background:rgba(0,0,0,.78);display:none;z-index:60;place-items:center}
+.applying.show{display:grid}
+.applying .abox{text-align:center}.applying .abox h2{font-size:18px;margin-bottom:8px}.applying .abox p{color:var(--steel);font-size:13px}
+</style>
+</head>
+<body>
+<script>if (self === top) location.href = '/reaper_shell.asp#Reaper_Traffic.asp';</script>
+
+<div class="pagehead">
+  <div><div class="eyebrow">Traffic Analyzer</div><h1>Bandwidth &amp; Usage</h1></div>
+  <span class="pill" id="statuspill"><span class="dot"></span><span id="statuspill_t">Live</span></span>
+  <div class="spacer"></div>
+  <button type="button" class="btn ghost" onclick="exportJSON()">Export</button>
+  <button type="button" class="btn ghost" onclick="faqOpen()">Guide</button>
+  <button type="button" class="btn ghost" onclick="scrollTo(0,document.body.scrollHeight)">Settings</button>
+</div>
+
+<div class="tiles" id="tiles"></div>
+
+<div class="wins" id="wins">
+  <div class="win on" data-w="live" data-step="live">Live</div>
+  <div class="win" data-w="m5" data-step="300">24 hours</div>
+  <div class="win" data-w="hour" data-step="3600">14 days</div>
+  <div class="win" data-w="day" data-step="86400">1 year</div>
+  <div class="win" data-w="month" data-step="0">By month</div>
+</div>
+
+<div class="panel span">
+  <h2>WAN throughput</h2>
+  <div class="sub">Upload and download across the internet link. <span id="probe_note"></span></div>
+  <div class="legend">
+    <span><i style="background:var(--jade)"></i>Download</span>
+    <span><i style="background:var(--crimson)"></i>Upload</span>
+    <span id="lat_leg" style="display:none"><i style="background:var(--amber)"></i>Latency (right axis)</span>
+  </div>
+  <div class="chart-wrap"><svg id="wanchart" width="100%" height="230" viewBox="0 0 1000 230" preserveAspectRatio="none"></svg></div>
+</div>
+
+<div class="grid">
+  <div class="panel">
+    <h2>By QoS class</h2>
+    <div class="sub">Per-class upload (needs HW QoS Classful running). Stacked, newest at right.</div>
+    <div class="legend" id="clslegend"></div>
+    <div class="chart-wrap"><svg id="clschart" width="100%" height="200" viewBox="0 0 1000 200" preserveAspectRatio="none"></svg></div>
+  </div>
+  <div class="panel">
+    <h2>By network</h2>
+    <div class="sub">Per-bridge totals &mdash; main LAN, guest, and each SDN/VLAN.</div>
+    <div class="legend" id="netlegend"></div>
+    <div class="chart-wrap"><svg id="netchart" width="100%" height="200" viewBox="0 0 1000 200" preserveAspectRatio="none"></svg></div>
+  </div>
+</div>
+
+<div class="grid">
+  <div class="panel">
+    <h2>Top devices</h2>
+    <div class="sub">Total usage this window, by LAN device (conntrack-accounted).</div>
+    <table class="ta"><thead><tr><th>Device</th><th class="num">Down</th><th class="num">Up</th></tr></thead><tbody id="clitbody"></tbody></table>
+  </div>
+  <div class="panel">
+    <h2>Top talkers (live)</h2>
+    <div class="sub">Highest-rate active flows right now, by destination port bucket.</div>
+    <table class="ta"><thead><tr><th>Source</th><th>Destination</th><th class="num">Rate</th></tr></thead><tbody id="toptbody"></tbody></table>
+  </div>
+</div>
+
+<div class="panel span" id="quotapanel" style="display:none">
+  <h2>Monthly data cap</h2>
+  <div class="sub">Month-to-date WAN usage against your cap. A warning is logged to the system log (and any remote syslog/SIEM) at 80% and 100%.</div>
+  <div class="meter"><span id="quotabar"></span></div>
+  <div style="font-size:12.5px" id="quotatxt"></div>
+</div>
+
+<div class="panel span">
+  <h2>Settings</h2>
+  <div class="sub">The collector adds no listening ports. It only reads local counters (interfaces, conntrack, QoS queues).</div>
+  <div class="togglerow">
+    <label class="tswitch"><input type="checkbox" id="tg_enable"><span class="track"></span></label>
+    <div class="tmeta"><div class="tname2">Collect traffic history</div><div class="tdesc">Turns the rtrafd collector on or off. Off = the realtime interface monitor still works, but no history or per-device accounting.</div></div>
+  </div>
+  <div class="fld">
+    <label>History storage</label>
+    <select id="set_path">
+      <option value="">RAM (fast, cleared on reboot)</option>
+      <option value="jffs">JFFS (survives reboot, internal flash)</option>
+      <option value="usb">USB disk (survives reboot, most space)</option>
+    </select>
+    <div class="storenote">
+      <b>RAM</b> keeps everything in memory &mdash; the live view and up to a year of rolled-up history, but it all resets when the router reboots. Choose <b>JFFS</b> or <b>USB</b> to keep history across reboots. The collector snapshots once an hour, so at most the last hour is lost on an unclean shutdown. JFFS is limited internal flash (fine for this data, a few hundred KB); USB has the most room and avoids flash wear. If the chosen target is not writable, the collector silently falls back to RAM.
+    </div>
+  </div>
+  <div class="fld">
+    <label>WAN latency probe (optional)</label>
+    <input type="text" id="set_probe" maxlength="63" placeholder="e.g. 1.1.1.1 (blank = off)" style="width:230px">
+    <div class="storenote">A single ping per sample to this host graphs latency and loss under load beside throughput &mdash; the bufferbloat picture. Left blank, nothing is sent (no forced outbound). Use an IP or hostname you are comfortable pinging continuously.</div>
+  </div>
+  <div class="fld">
+    <label>Monthly data cap</label>
+    <input type="text" id="set_cap" maxlength="7" style="width:120px"><span class="u">GB (0 = off)</span>
+  </div>
+  <button type="button" class="btn" style="background:linear-gradient(180deg,var(--crimson),var(--crimson-deep));border-color:transparent;color:#fff" onclick="applySettings()">Apply settings</button>
+</div>
+
+<div class="scrim" id="scrim" onclick="faqClose()"></div>
+<aside class="flyout" id="flyout">
+  <div class="fhead"><h2>Traffic Analyzer Guide</h2><span class="fclose" onclick="faqClose()">&times;</span></div>
+  <div class="fbody">
+    <details open><summary>Where is my history stored?</summary><div class="fc">Choose in Settings: <b>RAM</b> (default, cleared on reboot), <b>JFFS</b> (internal flash, survives reboot), or <b>USB</b> (a plugged-in disk, most space). Anything longer than the live view needs JFFS or USB if you want it to outlast a reboot. The collector writes a snapshot hourly, so an unclean shutdown loses at most the last hour.</div></details>
+    <details><summary>How accurate are the per-device numbers?</summary><div class="fc">They come from the kernel connection tracker, which the flow accelerator syncs periodically &mdash; so totals are accurate to within a poll interval, and a very short flow that starts and ends between polls can undercount slightly. Device names come from the network map; a device shows as a bare IP until it is named there. IPv6 traffic counts toward interface and network totals but is not split per-device in this version.</div></details>
+    <details><summary>Why is the per-class chart empty?</summary><div class="fc">Per-class data only exists while <b>HW QoS Classful</b> (Traffic Manager) is the active engine &mdash; that is what creates the five upload queues this reads. On any other QoS mode the class chart stays blank; everything else still works.</div></details>
+    <details><summary>What are "top talkers"?</summary><div class="fc">The highest-rate active connections right now, grouped by destination port so you can tell <i>what kind</i> of traffic it is (HTTPS 443, QUIC 443/UDP, SSH 22, mail, torrent-range, etc.) without deep packet inspection. This is the privacy-respecting replacement for the old per-app view &mdash; it reads only the connection table, never packet contents.</div></details>
+    <details><summary>How does the data cap work?</summary><div class="fc">Set a monthly GB figure and the collector tracks month-to-date WAN usage (up + down). At 80% and again at 100% it writes a warning to the system log; if you have a remote syslog server or SIEM configured, the warning reaches it too. It is a notification, not an enforcement &mdash; nothing is cut off.</div></details>
+    <details><summary>Does this add any attack surface?</summary><div class="fc">No listening ports. The collector only reads local kernel counters and writes JSON files the web UI serves through the normal authenticated session. The optional latency probe is the only outbound traffic, and only to the host you enter.</div></details>
+  </div>
+</aside>
+
+<div class="applying" id="applying"><div class="abox"><h2>Applying</h2><p>Restarting the collector.</p></div></div>
+
+<iframe name="hidden_frame" style="display:none" width="0" height="0"></iframe>
+<form method="post" name="form" action="/start_apply.htm" target="hidden_frame">
+  <input type="hidden" name="current_page" value="Reaper_Traffic.asp">
+  <input type="hidden" name="next_page" value="Reaper_Traffic.asp">
+  <input type="hidden" name="action_mode" value="apply">
+  <input type="hidden" name="action_script" value="restart_rtraf">
+  <input type="hidden" name="action_wait" value="5">
+  <input type="hidden" name="rtraf_enable" value="" disabled>
+  <input type="hidden" name="rtraf_path" value="" disabled>
+  <input type="hidden" name="rtraf_probe" value="" disabled>
+  <input type="hidden" name="rtraf_cap_gb" value="" disabled>
+</form>
+
+<script>
+var NV = {
+  enable: '<% nvram_get("rtraf_enable"); %>',
+  path:   '<% nvram_get("rtraf_path"); %>',
+  probe:  decodeURIComponent('<% nvram_char_to_ascii("", "rtraf_probe"); %>'),
+  cap:    '<% nvram_get("rtraf_cap_gb"); %>'
+};
+var CLSCOLOR = ['#71767b','#3987e5','#199e70','#c98500','#9085e9','#d95926','#e66767'];
+var CLSNAME  = (decodeURIComponent('<% nvram_char_to_ascii("", "qos_class_names"); %>')||'Q1,Q2,Q3,Q4,Q5').split(',');
+var NETCOLOR = ['#3987e5','#199e70','#c98500','#9085e9','#d95926','#e66767','#d55181','#71767b'];
+var curWin = 'live', curStep = 'live', liveTimer = null;
+
+/* ---- formatting ---- */
+function fmtBps(b){ b=+b||0; if(b>=1e9)return (b/1e9).toFixed(2)+' Gb/s'; if(b>=1e6)return (b/1e6).toFixed(1)+' Mb/s'; if(b>=1e3)return (b/1e3).toFixed(0)+' kb/s'; return b.toFixed(0)+' b/s'; }
+function fmtBytes(b){ b=+b||0; if(b>=1e12)return (b/1e12).toFixed(2)+' TB'; if(b>=1e9)return (b/1e9).toFixed(2)+' GB'; if(b>=1e6)return (b/1e6).toFixed(1)+' MB'; if(b>=1e3)return (b/1e3).toFixed(0)+' KB'; return b+' B'; }
+function esc(s){ return String(s).replace(/[<>&"]/g,function(c){return {'<':'&lt;','>':'&gt;','&':'&amp;','"':'&quot;'}[c];}); }
+var PORTS={20:'FTP',21:'FTP',22:'SSH',25:'SMTP',53:'DNS',80:'HTTP',110:'POP3',143:'IMAP',443:'HTTPS/QUIC',465:'SMTPS',587:'SMTP',993:'IMAPS',3074:'Xbox',3478:'STUN/RTC',5060:'SIP',5061:'SIP',8080:'HTTP-alt',51413:'BitTorrent',32400:'Plex'};
+function portName(p,proto){ if(PORTS[p]) return PORTS[p]+' ('+p+')'; if(p>=6881&&p<=6999) return 'BitTorrent ('+p+')'; if(p>=27000&&p<=27100) return 'Game ('+p+')'; return (proto===17?'UDP ':proto===6?'TCP ':'')+p; }
+
+/* ---- fetch ---- */
+function getJSON(f, cb){
+  var x=new XMLHttpRequest();
+  x.open('GET','/reaper_traffic.cgi?f='+f+'&_='+Date.now(),true);
+  x.onreadystatechange=function(){ if(x.readyState!==4)return; var d={}; try{d=JSON.parse(x.responseText);}catch(e){} cb(d); };
+  x.send();
+}
+
+/* ---- SVG chart helpers (W=1000 viewBox) ---- */
+var W=1000;
+function axis(svg, H, maxv, unit){
+  var g='', steps=4, i;
+  for(i=0;i<=steps;i++){ var y=10+(H-24)*i/steps, val=maxv*(1-i/steps);
+    g+='<line class="grid-l" x1="44" y1="'+y.toFixed(1)+'" x2="'+W+'" y2="'+y.toFixed(1)+'"/>';
+    g+='<text class="axl" x="0" y="'+(y+3).toFixed(1)+'">'+unit(val)+'</text>'; }
+  return g;
+}
+function lineChart(id, series, maxv, unit){
+  var svg=document.getElementById(id), H=+svg.getAttribute('viewBox').split(' ')[3];
+  var body=axis(svg,H,maxv||1,unit), s, i;
+  for(s=0;s<series.length;s++){ var pts=series[s].data, d='';
+    for(i=0;i<pts.length;i++){ var x=44+(W-44)*(pts.length<2?0:i/(pts.length-1)), y=10+(H-24)*(1-(pts[i]/(maxv||1)));
+      d+=(i?'L':'M')+x.toFixed(1)+' '+Math.max(10,Math.min(H-14,y)).toFixed(1)+' '; }
+    body+='<path d="'+d+'" fill="none" stroke="'+series[s].color+'" stroke-width="2"/>'; }
+  svg.innerHTML=body;
+}
+function stackChart(id, layers, labels, colors){
+  var svg=document.getElementById(id), H=+svg.getAttribute('viewBox').split(' ')[3];
+  var n=layers.length?layers[0].length:0, i, s, tot=[], maxv=1;
+  for(i=0;i<n;i++){ tot[i]=0; for(s=0;s<layers.length;s++) tot[i]+=layers[s][i]; if(tot[i]>maxv)maxv=tot[i]; }
+  var body=axis(svg,H,maxv,fmtBytes), acc=new Array(n).fill(0);
+  for(s=0;s<layers.length;s++){ var up='',dn='';
+    for(i=0;i<n;i++){ var x=44+(W-44)*(n<2?0:i/(n-1));
+      var y0=10+(H-24)*(1-acc[i]/maxv), y1=10+(H-24)*(1-(acc[i]+layers[s][i])/maxv);
+      up+=(i?'L':'M')+x.toFixed(1)+' '+y1.toFixed(1)+' '; }
+    for(i=n-1;i>=0;i--){ var x2=44+(W-44)*(n<2?0:i/(n-1)); dn+='L'+x2.toFixed(1)+' '+(10+(H-24)*(1-acc[i]/maxv)).toFixed(1)+' '; }
+    body+='<path d="'+up+dn+'Z" fill="'+colors[s]+'" fill-opacity="0.75" stroke="'+colors[s]+'" stroke-width="1"/>';
+    for(i=0;i<n;i++) acc[i]+=layers[s][i]; }
+  svg.innerHTML=body;
+}
+
+/* ---- render live ---- */
+function renderLive(d){
+  document.getElementById('statuspill_t').textContent = 'Live - '+(d.store?d.store.toUpperCase():'RAM');
+  var wan=d.wan||{rx_bps:0,tx_bps:0};
+  var tiles=[['Download',fmtBps(wan.rx_bps),'dn'],['Upload',fmtBps(wan.tx_bps),'up']];
+  if(d.probe&&d.probe.rtt_us){ tiles.push(['Latency',(d.probe.rtt_us/1000).toFixed(1)+' <small>ms</small>','']); tiles.push(['Loss',d.probe.loss+' <small>%</small>','']); }
+  var q=d.quota||{}; if(q.cap_gb>0){ tiles.push(['Cap used',fmtBytes(q.used)+' <small>/ '+q.cap_gb+' GB</small>','']); }
+  var th=''; for(var i=0;i<tiles.length;i++) th+='<div class="tile"><div class="k">'+tiles[i][0]+'</div><div class="v '+tiles[i][2]+'">'+tiles[i][1]+'</div></div>';
+  document.getElementById('tiles').innerHTML=th;
+  /* live top talkers */
+  var tb=''; (d.top||[]).sort(function(a,b){return b.rate-a.rate;}).slice(0,12).forEach(function(t){
+    tb+='<tr><td class="tname">'+esc(t.src)+'</td><td>'+esc(t.dst)+' <span class="badge">'+esc(portName(t.dport,t.proto))+'</span></td><td class="num">'+fmtBps(t.rate*8)+'</td></tr>'; });
+  document.getElementById('toptbody').innerHTML = tb || '<tr><td colspan="3" style="color:var(--steel)">No active flows.</td></tr>';
+  /* live class strip */
+  var cls=d.class||[]; var lays=[], cols=[], labs=[];
+  for(var c=1;c<=5;c++){ if(cls[c]){ lays.push([cls[c].tx_bps||0]); cols.push(CLSCOLOR[c]); labs.push(CLSNAME[c-1]||('Q'+c)); } }
+  document.getElementById('probe_note').textContent = d.qos? 'QoS Classful active - per-class chart live.' : 'Enable HW QoS Classful for per-class data.';
+}
+
+/* ---- render history window ---- */
+function renderHist(d){
+  var wan=d.wan||[], rx=wan.map(function(p){return p[0];}), tx=wan.map(function(p){return p[1];});
+  var step=d.step||300, div=step>0?step:2592000;
+  var rxbps=rx.map(function(v){return v*8/div;}), txbps=tx.map(function(v){return v*8/div;});
+  var maxv=Math.max(1,Math.max.apply(null,rxbps),Math.max.apply(null,txbps));
+  var series=[{data:rxbps,color:'var(--jade)'},{data:txbps,color:'var(--crimson)'}];
+  var probe=d.probe||[], hasP=probe.some(function(p){return p[0]>0;});
+  document.getElementById('lat_leg').style.display = hasP?'':'none';
+  if(hasP){ var lat=probe.map(function(p){return p[0]/1000;}), lmax=Math.max.apply(null,lat)||1;
+    series.push({data:lat.map(function(v){return v/lmax*maxv;}),color:'var(--amber)'}); }
+  lineChart('wanchart', series, maxv, fmtBps);
+
+  /* class stack */
+  var cl=d.class||{}, clsLays=[], clsCols=[], clsLeg='';
+  for(var c=1;c<=5;c++){ var arr=(cl['q'+c]||[]).map(function(p){return p[0];}); if(arr.length){ clsLays.push(arr); clsCols.push(CLSCOLOR[c]); clsLeg+='<span><i style="background:'+CLSCOLOR[c]+'"></i>'+esc(CLSNAME[c-1]||('Q'+c))+'</span>'; } }
+  document.getElementById('clslegend').innerHTML = clsLeg || '<span style="color:var(--steel)">No QoS class data in this window.</span>';
+  if(clsLays.length) stackChart('clschart', clsLays, null, clsCols); else document.getElementById('clschart').innerHTML='';
+
+  /* network stack */
+  var nets=d.nets||{}, netLays=[], netCols=[], netLeg='', ni=0;
+  for(var nm in nets){ if(!nets.hasOwnProperty(nm))continue; var narr=nets[nm].map(function(p){return p[0]+p[1];}); var col=NETCOLOR[ni%NETCOLOR.length]; netLays.push(narr); netCols.push(col); netLeg+='<span><i style="background:'+col+'"></i>'+esc(nm)+'</span>'; ni++; }
+  document.getElementById('netlegend').innerHTML = netLeg || '<span style="color:var(--steel)">No per-network data yet.</span>';
+  if(netLays.length) stackChart('netchart', netLays, null, netCols); else document.getElementById('netchart').innerHTML='';
+
+  /* top devices (sum window) */
+  var cli=d.clients||{}, rows=[];
+  for(var k in cli){ if(!cli.hasOwnProperty(k))continue; var dn=0,up=0; cli[k].d.forEach(function(p){dn+=p[0];up+=p[1];}); rows.push({name:k,ip:cli[k].ip,dn:dn,up:up,tot:dn+up}); }
+  rows.sort(function(a,b){return b.tot-a.tot;});
+  var maxTot=rows.length?rows[0].tot:1, tb='';
+  rows.slice(0,15).forEach(function(r){ tb+='<tr><td><span class="tname">'+esc(r.ip||r.name)+'</span><div class="bar"><span style="width:'+(r.tot/maxTot*100).toFixed(0)+'%"></span></div></td><td class="num">'+fmtBytes(r.dn)+'</td><td class="num">'+fmtBytes(r.up)+'</td></tr>'; });
+  document.getElementById('clitbody').innerHTML = tb || '<tr><td colspan="3" style="color:var(--steel)">No per-device data yet.</td></tr>';
+
+  /* quota */
+  var q=null; getJSON('live', function(l){ if(l.quota&&l.quota.cap_gb>0){ var used=l.quota.used, cap=l.quota.cap_gb*1e9, pct=Math.min(100,used/cap*100);
+    document.getElementById('quotapanel').style.display=''; var bar=document.getElementById('quotabar'); bar.style.width=pct.toFixed(0)+'%'; bar.className=pct>=80?'hot':'';
+    document.getElementById('quotatxt').innerHTML=fmtBytes(used)+' of '+l.quota.cap_gb+' GB ('+pct.toFixed(0)+'%) this month'; }
+    else document.getElementById('quotapanel').style.display='none'; });
+}
+
+/* ---- window switching ---- */
+function loadWin(){
+  if(liveTimer){ clearInterval(liveTimer); liveTimer=null; }
+  if(curWin==='live'){
+    var tick=function(){ getJSON('live', renderLive); };
+    tick(); liveTimer=setInterval(tick,5000);
+    /* also draw the 24h history behind the live tiles for context */
+    getJSON('m5', renderHist);
+  } else {
+    getJSON(curWin, renderHist);
+    getJSON('live', renderLive);   /* keep tiles fresh */
+  }
+}
+(function(){ var ws=document.querySelectorAll('#wins .win'); for(var i=0;i<ws.length;i++) ws[i].onclick=function(){
+  document.querySelectorAll('#wins .win').forEach(function(x){x.className='win';}); this.className='win on';
+  curWin=this.getAttribute('data-w'); curStep=this.getAttribute('data-step'); loadWin(); }; })();
+
+/* ---- settings ---- */
+function applySettings(){
+  var f=document.form;
+  f.rtraf_enable.disabled=false; f.rtraf_enable.value=document.getElementById('tg_enable').checked?'1':'0';
+  f.rtraf_path.disabled=false;   f.rtraf_path.value=document.getElementById('set_path').value;
+  var pv=document.getElementById('set_probe').value.trim();
+  if(pv && !/^[A-Za-z0-9.\-]{1,63}$/.test(pv)){ alert('Probe target must be a plain hostname or IPv4 address.'); return; }
+  f.rtraf_probe.disabled=false;  f.rtraf_probe.value=pv;
+  var cv=parseInt(document.getElementById('set_cap').value,10); if(isNaN(cv)||cv<0)cv=0;
+  f.rtraf_cap_gb.disabled=false; f.rtraf_cap_gb.value=String(cv);
+  document.getElementById('applying').className='applying show';
+  f.submit();
+  setTimeout(function(){ location.reload(); }, 6000);
+}
+function exportJSON(){
+  var win = curWin==='live'?'m5':curWin;
+  window.open('/reaper_traffic.cgi?f='+win, '_blank');
+}
+function faqOpen(){ document.getElementById('flyout').className='flyout open'; document.getElementById('scrim').className='scrim open'; }
+function faqClose(){ document.getElementById('flyout').className='flyout'; document.getElementById('scrim').className='scrim'; }
+document.addEventListener('keydown',function(e){ if(e.key==='Escape')faqClose(); });
+
+/* ---- init ---- */
+document.getElementById('tg_enable').checked = (NV.enable!=='0');
+document.getElementById('set_path').value = NV.path||'';
+document.getElementById('set_probe').value = NV.probe||'';
+document.getElementById('set_cap').value = NV.cap||'0';
+loadWin();
+</script>
+</body>
+</html>
