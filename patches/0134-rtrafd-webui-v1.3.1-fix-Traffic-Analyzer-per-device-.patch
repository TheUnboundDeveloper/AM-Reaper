 };
+var QOSMODES={'0':'Traditional QoS','2':'Bandwidth Limiter','9':'Cake','10':'Hardware QoS (single queue)','11':'HW QoS Classful'};
+/* Per-class data only exists on qos_type 11. Show an explicit state on the class
+   panel rather than a blank chart when QoS is off or on a non-classful engine. */
+function classGate(){
+  var on = (NV.qos_en==='1' && NV.qos_ty==='11');
+  document.getElementById('clsgate').style.display = on?'none':'';
+  document.getElementById('clsbody').style.display = on?'':'none';
+  if(!on){
