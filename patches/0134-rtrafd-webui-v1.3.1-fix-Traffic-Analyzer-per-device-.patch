@@ -313,6 +354,161 @@ put:
 	top[i].rate = rate; top[i].up = up; top[i].dn = dn;
 }
 
+/* Broadcom flow-cache reader (offload-accurate). /proc/fcache/nflist lists
+ * every actively-forwarded flow (SW + HW hits) with a cumulative TotalBytes,
+ * the real LAN source IP/MAC on the upload direction, and an nf_conn pointer
+ * shared by both directions of a connection. We delta each flow's TotalBytes
+ * per flow-id slot, then group the two directions by nf_conn to attribute
+ * download bytes (which are NAT'd and don't carry the LAN IP) back to the
+ * client. This is what conntrack byte-accounting cannot see once the Runner
+ * offloads a flow to hardware. Falls back to conntrack if the table is absent. */
+static void poll_conntrack(void);	/* fwd decl - fallback */
+
+struct fcf {
+	uint64_t nfc;		/* nf_conn[0] pointer (connection correlation key) */
+	uint64_t delta;		/* TotalBytes delta this poll */
+	uint32_t sip, dip;
+	int dport, lan;		/* lan = source is a LAN address (upload dir) */
+	char mac[20], dev[16];	/* client MAC (upload SA); LAN-side dev */
+};
+
+static void poll_fcache(void)
+{
+	FILE *f = fopen("/proc/fcache/nflist", "r");
+	char line[1024];
+	static struct fcf fl[FC_MAX];
+	static char consumed[FC_MAX];
+	int nfl = 0, i, j, parsed = 0;
+
+	if (!f) { poll_conntrack(); return; }	/* accelerator table absent */
+
+	ntop = 0;
+	if (!fgets(line, sizeof(line), f) || !fgets(line, sizeof(line), f)) {
+		fclose(f);		/* two header lines */
+		return;
+	}
+
+	while (fgets(line, sizeof(line), f)) {
+		int flowid, sport, dport, a, b, c, d;
+		unsigned long long tbytes = 0;
+		char sips[24], dips[24], macs[24], rxdev[16], txdev[16], nfcs[24];
+		char *p, *q, *gt;
+		uint64_t last, delta;
+
+		parsed++;
+		if (nfl >= FC_MAX) {
+			if (!fc_overflow_logged) {
+				syslog(LOG_NOTICE, "rtrafd: >%d active flows, per-device totals sampled", FC_MAX);
+				fc_overflow_logged = 1;
+			}
+			break;
+		}
+		/* left block is fixed-width: flowid=tok1, TotalBytes=tok8 */
+		if (sscanf(line, "%d %*s %*s %*s %*s %*s %*s %llu", &flowid, &tbytes) != 2)
+			continue;
+		if (flowid < 0 || flowid >= FC_SLOTS)
+			continue;
+		/* src ip:port = 1st <...>, dst ip:port = 2nd <...> */
+		if ((p = strchr(line, '<')) == NULL) continue;
+		if (sscanf(p, "<%23[0-9.]:%d>", sips, &sport) != 2) continue;
+		if ((q = strchr(p + 1, '<')) == NULL) continue;
+		if (sscanf(q, "<%23[0-9.]:%d>", dips, &dport) != 2) continue;
+		/* MAC SA = 3rd <...>; MAC DA = 4th; then RxDev TxDev nf_conn[0] */
+		macs[0] = rxdev[0] = txdev[0] = nfcs[0] = '\0';
+		if ((p = strchr(q + 1, '<')) != NULL) {
+			sscanf(p, "<%19[0-9a-fA-F:]>", macs);
+			if ((p = strchr(p + 1, '<')) != NULL &&	/* MAC DA */
+			    (gt = strchr(p, '>')) != NULL)
+				sscanf(gt + 1, " %15s %15s %23s", rxdev, txdev, nfcs);
+		}
+		/* octets are zero-padded (192.168.050.215) -> parse decimal, NOT
+		 * inet_aton (which would read "050" as octal). */
+		if (sscanf(sips, "%d.%d.%d.%d", &a, &b, &c, &d) != 4) continue;
+		fl[nfl].sip = ((uint32_t)a << 24) | (b << 16) | (c << 8) | d;
+		if (sscanf(dips, "%d.%d.%d.%d", &a, &b, &c, &d) == 4)
+			fl[nfl].dip = ((uint32_t)a << 24) | (b << 16) | (c << 8) | d;
+		else
+			fl[nfl].dip = 0;
+
+		last = fc_last[flowid];
+		delta = (tbytes >= last) ? (tbytes - last) : tbytes;	/* recycle-safe */
+		fc_last[flowid] = tbytes;
+		if (delta == 0) continue;
+
+		fl[nfl].nfc = strtoull(nfcs, NULL, 16);
+		fl[nfl].delta = delta;
+		fl[nfl].dport = dport;
+		fl[nfl].lan = ((fl[nfl].sip & lan_mask) == lan_net);
+		strlcpy(fl[nfl].mac, macs, sizeof(fl[0].mac));
+		strlcpy(fl[nfl].dev, fl[nfl].lan ? rxdev : txdev, sizeof(fl[0].dev));
+		nfl++;
+	}
+	fclose(f);
+
+	/* nflist yielded no flows-with-deltas. Two cases: (a) genuinely idle, or
+	 * (b) the accelerator is OFF - which is exactly what the software QoS
+	 * engines (Traditional type 0, Cake type 9) do. Either way, fall back to
+	 * conntrack, which sees the software path accurately when accel is off (and
+	 * finds little when merely idle). No double counting: when accel is ON,
+	 * nfl>0 and this is skipped; and an offloaded flow's conntrack bytes freeze
+	 * at offload, so the two sources never account the same bytes. */
+	if (nfl == 0) {
+		poll_conntrack();
+		return;
+	}
+	(void)parsed;
+
+	/* age the fc_last table: any slot NOT seen this poll keeps its value, which
+	 * is fine (delta stays 0 until it grows or a new flow recycles the slot). */
+
+	memset(consumed, 0, nfl);
+	for (i = 0; i < nfl; i++) {
+		uint64_t nfc, up = 0, dn = 0;
+		int have_lan = 0, ci, ns;
+		uint32_t cli_ip = 0, dst_ip = 0;
+		int dport = 0;
+		char cli_mac[20] = "", cli_dev[16] = "", ips[16], dsts[16];
+
+		if (consumed[i]) continue;
+		nfc = fl[i].nfc;
+		/* group both directions of this connection (shared nf_conn) */
+		for (j = i; j < nfl; j++) {
+			if (consumed[j]) continue;
+			if (nfc && fl[j].nfc != nfc) continue;
+			if (!nfc && j != i) continue;	/* nfc==0: don't group blindly */
+			consumed[j] = 1;
+			if (fl[j].lan) {
+				up += fl[j].delta;
+				if (!have_lan) {
+					have_lan = 1;
+					cli_ip = fl[j].sip;
+					dst_ip = fl[j].dip;
+					dport = fl[j].dport;
+					strlcpy(cli_mac, fl[j].mac, sizeof(cli_mac));
+					strlcpy(cli_dev, fl[j].dev, sizeof(cli_dev));
+				}
+			} else {
+				dn += fl[j].delta;
+				if (!cli_dev[0])
+					strlcpy(cli_dev, fl[j].dev, sizeof(cli_dev));
+			}
+		}
+		if (!have_lan)
+			continue;	/* no LAN side = router-originated / unmatched */
+
+		ip2str(cli_ip, ips);
+		ci = cli_slot(cli_mac[0] ? cli_mac : ips, ips);
+		ring_add(r_cli[ci], dn, up);	/* rx=download, tx=upload */
+
+		ns = net_slot(dev_bridge(cli_dev));
+		if (ns >= 0)
+			ring_add(r_net[ns], dn, up);
+
+		ip2str(dst_ip, dsts);
+		top_note(ips, dsts, dport, 0, up, dn);
+	}
+}
+
 static void poll_conntrack(void)
 {
 	FILE *f = fopen("/proc/net/nf_conntrack", "r");
@@ -515,8 +711,17 @@ static void write_live(const char *store, uint64_t wrx_d, uint64_t wtx_d,
 	fprintf(o, "],\"quota\":{\"used\":%llu,\"cap_gb\":%llu}",
 		(unsigned long long)(r_wan->bm[imcur].rx + r_wan->bm[imcur].tx),
 		(unsigned long long)cap_gb);
-	fprintf(o, ",\"probe\":{\"rtt_us\":%llu,\"loss\":%llu}",
-		(unsigned long long)r_prb->b5[i5cur].rx, (unsigned long long)r_prb->b5[i5cur].tx);
+	/* live probe = running average since the current 5-min bucket opened;
+	 * the ring slot is only stamped at bucket close, so reading it directly
+	 * showed 0 for most of each window. Fall back to the last closed slot
+	 * until the first sample of a new bucket lands. */
+	{
+		uint64_t live_rtt = (prb_n > prb_lost) ? prb_rtt_sum / (prb_n - prb_lost)
+						       : r_prb->b5[i5cur].rx;
+		uint64_t live_loss = prb_n ? (prb_lost * 100) / prb_n : r_prb->b5[i5cur].tx;
+		fprintf(o, ",\"probe\":{\"rtt_us\":%llu,\"loss\":%llu}",
+			(unsigned long long)live_rtt, (unsigned long long)live_loss);
+	}
 	fprintf(o, ",\"top\":[");
 	for (i = 0; i < ntop; i++)
 		fprintf(o, "%s{\"src\":\"%s\",\"dst\":\"%s\",\"dport\":%d,\"proto\":%d,\"rate\":%llu,\"up\":%llu,\"dn\":%llu}",
@@ -627,7 +832,8 @@ int main(int argc, char **argv)
 	for (i = 0; i < NCLI; i++) r_cli[i] = calloc(1, sizeof(ring_t));
 	r_prb = calloc(1, sizeof(ring_t));
 	flows = calloc(NFLOW, sizeof(flow_t));
-	if (!r_wan || !r_prb || !flows) return 1;
+	fc_last = calloc(FC_SLOTS, sizeof(uint64_t));
+	if (!r_wan || !r_prb || !flows || !fc_last) return 1;
 
 	mkdir("/tmp/rtraf", 0700);
 	f_write_string("/proc/sys/net/netfilter/nf_conntrack_acct", "1", 0, 0);
@@ -648,7 +854,9 @@ int main(int argc, char **argv)
 	db_load(dbpath);
 	last_save = time(NULL);
 	slots_for(time(NULL), &i5cur, &ihcur, &idcur, &imcur);
-	syslog(LOG_INFO, "rtrafd: started (store=%s wan=%s)", store, wanif);
+	/* LOG_NOTICE so it clears the default syslog threshold and shows in logread */
+	syslog(LOG_NOTICE, "rtrafd: started (store=%s wan=%s lan=%s/%08x)",
+	       store, wanif, nvram_safe_get("lan_ipaddr"), lan_mask);
 
 	while (running) {
 		time_t now = time(NULL);
@@ -676,7 +884,7 @@ int main(int argc, char **argv)
 
 		poll_ifaces(wanif);
 		poll_classes(wanif);
-		poll_conntrack();
+		poll_fcache();		/* offload-accurate per-client/per-network + top talkers */
 		poll_probe();
 		check_quota();
 
