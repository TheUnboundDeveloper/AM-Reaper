+static void ip2str(uint32_t ip, char *out /* >=16 */)
+{
+	snprintf(out, 16, "%u.%u.%u.%u",
+		 (ip >> 24) & 0xff, (ip >> 16) & 0xff, (ip >> 8) & 0xff, ip & 0xff);
+}
+
+/* LAN-side interface -> its bridge (per-network grouping). A port's bridge is
+ * /sys/class/net/<dev>/master; wireless VIFs (wl2.1) and wired ports resolve to
+ * br0/br1/... Cached; unbridged devices report under their own name. */
+static const char *dev_bridge(const char *dev)
+{
+	int i;
+	char path[80], link[80];
+	ssize_t n;
+	const char *b = dev;
+
+	if (!dev[0]) return dev;
+	for (i = 0; i < nbrmap; i++)
+		if (strcmp(brmap[i].dev, dev) == 0) return brmap[i].br;
+
+	snprintf(path, sizeof(path), "/sys/class/net/%s/master", dev);
+	n = readlink(path, link, sizeof(link) - 1);
+	if (n > 0) {
+		char *s;
+		link[n] = '\0';
+		s = strrchr(link, '/');
+		b = s ? s + 1 : link;
+	}
+	if (nbrmap >= (int)(sizeof(brmap) / sizeof(brmap[0])))
+		return "lan";	/* map full (won't happen in practice): safe constant */
+	strlcpy(brmap[nbrmap].dev, dev, sizeof(brmap[0].dev));
+	strlcpy(brmap[nbrmap].br, b, sizeof(brmap[0].br));
+	return brmap[nbrmap++].br;
+}
+
 static int cli_slot(const char *key, const char *ip)
 {
 	int i, oldest = 0;
@@ -255,16 +298,14 @@ static void poll_ifaces(const char *wanif)
 		if (sscanf(c + 1, "%llu %*u %*u %*u %*u %*u %*u %*u %llu",
 			   (unsigned long long *)&rxb, (unsigned long long *)&txb) != 2)
 			continue;
+		/* WAN only: the eth0 port counter is authoritative and sees offloaded
+		 * traffic. Per-network is NOT read here - the br* software-bridge
+		 * counters miss hardware-offloaded flows (they never traverse the
+		 * Linux bridge); per-network is derived from the flow cache instead. */
