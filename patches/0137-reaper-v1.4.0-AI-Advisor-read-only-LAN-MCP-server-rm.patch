+#ifdef RTCONFIG_REAPER_MCP
+/* reaper v1.4.0: read-only LAN MCP advisor. This is the ONE deliberate inbound
+ * listener in an otherwise listener-free build, so it is fenced hard:
+ *   - NEVER launched from start_services / the boot path (this build comes up
+ *     dark every reboot). It starts ONLY on an explicit user ARM action, which
+ *     the httpd arming endpoint services by writing /tmp/reaper_mcp/session and
+ *     then notify_rc("start_rmcp").
+ *   - the daemon itself refuses to run without that armed session file, binds
+ *     lan_ipaddr only, and self-terminates on the arming timeout / Disable.
+ * Disable just kills it; the session file + iptables rule are torn down by the
+ * daemon's own atexit/signal cleanup. */
+void
+stop_rmcp(void)
+{
+	if (pids("rmcpd"))
+		killall_tk("rmcpd");
+}
+
+void
+start_rmcp(void)
+{
+	stop_rmcp();
+	if (!is_routing_enabled()) return;
+	/* the armed session file is the gate - no file, no daemon */
+	if (!f_exists("/tmp/reaper_mcp/session")) {
+		logmessage("rmcpd", "start requested with no armed session - ignoring");
+		return;
+	}
+	xstart("rmcpd");
+}
+#endif
+
 //Ren.B
 #ifdef RTCONFIG_DSL
 void stop_spectrum(void)
@@ -21423,6 +21458,13 @@ retry_wps_enr:
 		if(action & RC_SERVICE_STOP) stop_rtraf();
 		if(action & RC_SERVICE_START) start_rtraf();
 	}
+#ifdef RTCONFIG_REAPER_MCP
+	else if (strcmp(script, "rmcp") == 0)
+	{
+		if(action & RC_SERVICE_STOP) stop_rmcp();
+		if(action & RC_SERVICE_START) start_rmcp();
+	}
+#endif
 	else if (strcmp(script, "conntrack") == 0)
 	{
 		setup_conntrack();
