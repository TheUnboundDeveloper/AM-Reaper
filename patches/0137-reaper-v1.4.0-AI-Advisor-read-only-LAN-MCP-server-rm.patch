+#ifdef RTCONFIG_REAPER_MCP
+/* reaper v1.4.0: arming control plane for the read-only MCP advisor (rmcpd).
+ *
+ * This endpoint is the SECOND FACTOR gate. The advisor daemon never runs at boot
+ * and refuses to start without an armed session file; only a successful "arm"
+ * here (admin session AND the out-of-band arming code) writes that file and asks
+ * rc to launch the daemon. The arming code is NEVER stored - only its salt and
+ * PBKDF2-HMAC-SHA256 hash, so a flash-dump attacker gets an uncrackable hash and
+ * still cannot arm. Repeated wrong codes lock arming for 15 minutes.
+ *
+ * Actions (GET param "action"): status | provision | deprovision | arm | disarm.
+ * The arming token and connection snippet are returned once, on a successful arm. */
+
+#define RMCP_ITER	120000
+#define RMCP_STATE_DIR	"/tmp/reaper_mcp"
+#define RMCP_SESSION	RMCP_STATE_DIR "/session"
+#define RMCP_LOCK_SECS	900
+#define RMCP_MAX_FAIL	5
+
+static void rmcp_hex(const unsigned char *in, int n, char *out)
+{
+	static const char *h = "0123456789abcdef";
+	int i;
+	for (i = 0; i < n; i++) {
+		out[i * 2]     = h[(in[i] >> 4) & 0xf];
+		out[i * 2 + 1] = h[in[i] & 0xf];
+	}
+	out[n * 2] = 0;
+}
+
+static int rmcp_unhex(const char *hex, unsigned char *out, int maxout)
+{
+	int n = 0;
+	while (hex[0] && hex[1] && n < maxout) {
+		char b[3] = { hex[0], hex[1], 0 };
+		out[n++] = (unsigned char)strtol(b, NULL, 16);
+		hex += 2;
+	}
+	return n;
+}
+
+/* PBKDF2-HMAC-SHA256(code, salt) -> 32-byte digest, hex-encoded into hashhex */
+static int rmcp_kdf(const char *code, const unsigned char *salt, int saltlen, char *hashhex)
+{
+	unsigned char dk[32];
+	if (PKCS5_PBKDF2_HMAC(code, strlen(code), salt, saltlen, RMCP_ITER,
+			      EVP_sha256(), sizeof(dk), dk) != 1)
+		return -1;
+	rmcp_hex(dk, sizeof(dk), hashhex);
+	return 0;
+}
+
+static void
+do_reaper_mcp_cgi(char *url, FILE *stream)
+{
+	char *action = get_cgi("action");
+	time_t now = time(NULL);
+	long lock_until = strtol(nvram_safe_get("rmcp_lock_until"), NULL, 10);
+	int provisioned = (nvram_safe_get("rmcp_code_hash")[0] != 0);
+
+	if (!action) action = "status";
+
+	if (!strcmp(action, "status")) {
+		int armed = f_exists(RMCP_SESSION);
+		long expiry = 0;
+		if (armed) {
+			char *sess = file2str(RMCP_SESSION);
+			if (sess) {
+				char *e = strstr(sess, "expiry=");
+				if (e) expiry = strtol(e + 7, NULL, 10);
+				free(sess);
+			}
+		}
+		websWrite(stream, "{\"provisioned\":%d,\"armed\":%d,\"expiry\":%ld,"
+			"\"now\":%ld,\"port\":%s,\"timeout\":%s,\"lan_ip\":\"%s\","
+			"\"locked\":%d,\"lock_until\":%ld}",
+			provisioned, armed ? 1 : 0, expiry, (long)now,
+			nvram_safe_get("rmcp_port"), nvram_safe_get("rmcp_timeout"),
+			nvram_safe_get("lan_ipaddr"),
+			(lock_until > now) ? 1 : 0, lock_until);
+		return;
+	}
+
+	if (!strcmp(action, "provision")) {
+		char *code = get_cgi("code");
+		unsigned char salt[16];
+		char salthex[40], hashhex[80];
+		if (!code || strlen(code) < 12) {
+			websWrite(stream, "{\"ok\":0,\"error\":\"code must be at least 12 characters\"}");
+			return;
+		}
+		/* SECOND-FACTOR INTEGRITY: rotating an existing code requires proving you
+		 * know the current one. This is what makes admin-session access alone
+		 * insufficient to enable the advisor - an attacker who stole the admin
+		 * password still cannot silently replace the arming code and arm. First-
+		 * time provisioning (no code set yet) is open; a factory reset is the
+		 * only other way to clear a forgotten code. Lockout applies here too. */
+		if (provisioned) {
+			char *oldcode = get_cgi("oldcode");
+			unsigned char osalt[32];
+			char ocalc[80];
+			const char *ostored = nvram_safe_get("rmcp_code_hash");
+			int oslen;
+			if (lock_until > now) {
+				websWrite(stream, "{\"ok\":0,\"error\":\"locked - too many failures\",\"lock_until\":%ld}", lock_until);
+				return;
+			}
+			oslen = rmcp_unhex(nvram_safe_get("rmcp_code_salt"), osalt, sizeof(osalt));
+			if (!oldcode || oslen <= 0 || rmcp_kdf(oldcode, osalt, oslen, ocalc) != 0 ||
+			    strlen(ocalc) != strlen(ostored) ||
+			    CRYPTO_memcmp(ocalc, ostored, strlen(ostored)) != 0) {
+				int f = atoi(nvram_safe_get("rmcp_fails")) + 1;
+				char fb[8]; snprintf(fb, sizeof(fb), "%d", f);
+				nvram_set("rmcp_fails", fb);
+				if (f >= RMCP_MAX_FAIL) {
+					char lb[16]; snprintf(lb, sizeof(lb), "%ld", (long)(now + RMCP_LOCK_SECS));
+					nvram_set("rmcp_lock_until", lb);
+				}
+				nvram_commit();
+				websWrite(stream, "{\"ok\":0,\"error\":\"current code required to rotate\"}");
+				return;
+			}
+		}
+		if (RAND_bytes(salt, sizeof(salt)) != 1) {
+			websWrite(stream, "{\"ok\":0,\"error\":\"rng failure\"}");
+			return;
+		}
+		rmcp_hex(salt, sizeof(salt), salthex);
+		if (rmcp_kdf(code, salt, sizeof(salt), hashhex) != 0) {
+			websWrite(stream, "{\"ok\":0,\"error\":\"kdf failure\"}");
+			return;
+		}
+		nvram_set("rmcp_code_salt", salthex);
+		nvram_set("rmcp_code_hash", hashhex);
+		nvram_set("rmcp_fails", "0");
+		nvram_set("rmcp_lock_until", "0");
+		nvram_commit();
+		logmessage("rmcpd", "arming code provisioned");
+		websWrite(stream, "{\"ok\":1}");
+		return;
+	}
+
+	if (!strcmp(action, "deprovision")) {
+		/* clearing the code also disarms any live session */
+		unlink(RMCP_SESSION);
+		notify_rc("stop_rmcp");
+		nvram_set("rmcp_code_salt", "");
+		nvram_set("rmcp_code_hash", "");
+		nvram_set("rmcp_fails", "0");
+		nvram_set("rmcp_lock_until", "0");
+		nvram_commit();
+		logmessage("rmcpd", "arming code cleared, advisor disabled");
+		websWrite(stream, "{\"ok\":1}");
+		return;
+	}
+
+	if (!strcmp(action, "arm")) {
+		char *code = get_cgi("code");
+		unsigned char salt[32], token[16];
+		char calc[80], tokhex[40];
+		const char *stored = nvram_safe_get("rmcp_code_hash");
+		int saltlen, fails, timeout;
+		FILE *sf;
+
+		if (!provisioned) {
+			websWrite(stream, "{\"ok\":0,\"error\":\"not provisioned - set an arming code first\"}");
+			return;
+		}
+		if (lock_until > now) {
+			websWrite(stream, "{\"ok\":0,\"error\":\"arming locked - too many failures\",\"lock_until\":%ld}", lock_until);
+			return;
+		}
+		if (!code) {
+			websWrite(stream, "{\"ok\":0,\"error\":\"code required\"}");
+			return;
+		}
+		saltlen = rmcp_unhex(nvram_safe_get("rmcp_code_salt"), salt, sizeof(salt));
+		if (saltlen <= 0 || rmcp_kdf(code, salt, saltlen, calc) != 0) {
+			websWrite(stream, "{\"ok\":0,\"error\":\"verify failed\"}");
+			return;
+		}
+		/* constant-time compare of the two hex digests */
+		if (strlen(calc) != strlen(stored) ||
+		    CRYPTO_memcmp(calc, stored, strlen(stored)) != 0) {
+			fails = atoi(nvram_safe_get("rmcp_fails")) + 1;
+			char fb[8]; snprintf(fb, sizeof(fb), "%d", fails);
+			nvram_set("rmcp_fails", fb);
+			if (fails >= RMCP_MAX_FAIL) {
+				char lb[16]; snprintf(lb, sizeof(lb), "%ld", (long)(now + RMCP_LOCK_SECS));
+				nvram_set("rmcp_lock_until", lb);
+				logmessage("rmcpd", "arming locked after %d failed attempts", fails);
+			}
+			nvram_commit();
+			websWrite(stream, "{\"ok\":0,\"error\":\"incorrect code\",\"fails\":%d}", fails);
+			return;
+		}
+		/* success: mint a session token and start the daemon */
+		nvram_set("rmcp_fails", "0");
+		nvram_set("rmcp_lock_until", "0");
+		nvram_commit();
+		if (RAND_bytes(token, sizeof(token)) != 1) {
+			websWrite(stream, "{\"ok\":0,\"error\":\"rng failure\"}");
+			return;
+		}
+		rmcp_hex(token, sizeof(token), tokhex);
+		timeout = atoi(nvram_safe_get("rmcp_timeout"));
+		if (timeout < 15 || timeout > 240) timeout = 60;
+
+		mkdir(RMCP_STATE_DIR, 0700);
+		sf = fopen(RMCP_SESSION, "w");
+		if (!sf) {
+			websWrite(stream, "{\"ok\":0,\"error\":\"cannot write session\"}");
+			return;
+		}
+		fchmod(fileno(sf), 0600);
+		fprintf(sf, "token=%s\nexpiry=%ld\nclient=%s\n",
+			tokhex, (long)(now + timeout * 60), nvram_safe_get("rmcp_client"));
+		fclose(sf);
+
+		notify_rc("start_rmcp");
+		logmessage("rmcpd", "advisor armed for %d minutes", timeout);
+		websWrite(stream, "{\"ok\":1,\"token\":\"%s\",\"lan_ip\":\"%s\",\"port\":%s,"
+			"\"expiry\":%ld,\"url\":\"http://%s:%s/mcp\"}",
+			tokhex, nvram_safe_get("lan_ipaddr"), nvram_safe_get("rmcp_port"),
+			(long)(now + timeout * 60),
+			nvram_safe_get("lan_ipaddr"), nvram_safe_get("rmcp_port"));
+		return;
+	}
+
+	if (!strcmp(action, "disarm")) {
+		unlink(RMCP_SESSION);
+		notify_rc("stop_rmcp");
+		logmessage("rmcpd", "advisor disarmed by user");
+		websWrite(stream, "{\"ok\":1}");
+		return;
+	}
+
+	websWrite(stream, "{\"ok\":0,\"error\":\"unknown action\"}");
+}
+#endif	/* RTCONFIG_REAPER_MCP */
+
 static void
 do_unreg_ASUSDDNS_cgi(char *url, FILE *stream)
 {
@@ -28765,6 +29012,9 @@ struct mime_handler mime_handlers[] =
