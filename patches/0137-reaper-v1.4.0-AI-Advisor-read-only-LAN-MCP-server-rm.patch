+	{ "rmcp_code_hash", "", CKN_STR128, CKN_TYPE_DEFAULT, CKN_ACC_LEVEL_DEFAULT, CKN_ENC_DEFAULT, 0 },	/* PBKDF2-HMAC-SHA256 of the arming code (hex); code never stored */
+	{ "rmcp_client", "", CKN_STR32, CKN_TYPE_DEFAULT, CKN_ACC_LEVEL_DEFAULT, CKN_ENC_DEFAULT, 0 },	/* optional single-client IP pin (empty = any LAN host) */
+	{ "rmcp_fails", "0", CKN_STR8, CKN_TYPE_DEFAULT, CKN_ACC_LEVEL_DEFAULT, CKN_ENC_DEFAULT, 0 },	/* arming-code failure counter (lockout after 5) */
