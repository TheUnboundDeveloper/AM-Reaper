diff --git a/release/src/router/www/Reaper_Advisor.asp b/release/src/router/www/Reaper_Advisor.asp
new file mode 100644
index 0000000000..d7622f0938
--- /dev/null
+++ b/release/src/router/www/Reaper_Advisor.asp
@@ -0,0 +1,264 @@
+<!DOCTYPE html>
+<html lang="en">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width, initial-scale=1">
+<meta name="reaper-native" content="1">
+<title>REAPER &mdash; AI Advisor</title>
+<style>
+@font-face{font-family:'Rajdhani';font-weight:600;font-display:swap;src:url('/fonts/rajdhani-600.woff2') format('woff2')}
+@font-face{font-family:'Rajdhani';font-weight:700;font-display:swap;src:url('/fonts/rajdhani-700.woff2') format('woff2')}
+@font-face{font-family:'Inter';font-weight:400;font-display:swap;src:url('/fonts/inter-400.woff2') format('woff2')}
+@font-face{font-family:'Inter';font-weight:500;font-display:swap;src:url('/fonts/inter-500.woff2') format('woff2')}
+@font-face{font-family:'Inter';font-weight:600;font-display:swap;src:url('/fonts/inter-600.woff2') format('woff2')}
+:root{
+  --bg:#08080a; --panel:#0f0f12; --panel-2:#141418;
+  --line-soft:rgba(255,255,255,.06); --line:rgba(225,6,0,.16);
+  --crimson:#E10600; --crimson-deep:#B3000C;
+  --bone:#ECE7DB; --bone-dim:#B7B1A4; --steel:#71767b;
+  --jade:#4FB286; --amber:#E0A93B;
+  --hdr:'Rajdhani','Oswald',system-ui,sans-serif;
+  --body:'Inter',system-ui,-apple-system,Segoe UI,sans-serif;
+}
+*{box-sizing:border-box}
+html,body{margin:0;min-height:100%}
+body{font-family:var(--body);color:var(--bone-dim);background:var(--bg);
+  background-image:radial-gradient(1200px 500px at 18% -10%,rgba(225,6,0,.10),transparent 60%),
+    radial-gradient(100% 100% at 50% 40%,transparent 55%,rgba(0,0,0,.55) 100%);
+  -webkit-font-smoothing:antialiased;padding:22px 26px 60px}
+h1,h2,h3,.hdr{font-family:var(--hdr);letter-spacing:.04em;color:var(--bone);margin:0}
+.mono{font-family:ui-monospace,Menlo,Consolas,monospace;font-variant-numeric:tabular-nums}
+.eyebrow{font-family:var(--hdr);text-transform:uppercase;letter-spacing:.22em;font-size:11px;color:var(--steel)}
+a{color:var(--bone-dim)} a:hover{color:var(--bone)}
+.pagehead{display:flex;align-items:center;gap:14px;margin-bottom:8px;flex-wrap:wrap}
+.pagehead h1{font-size:24px;font-weight:700}
+.spacer{flex:1}
+.pill{display:inline-flex;align-items:center;gap:7px;border:1px solid var(--line-soft);border-radius:999px;
+  padding:5px 12px;font-family:var(--hdr);font-weight:600;font-size:12px;letter-spacing:.06em;color:var(--bone-dim);background:var(--panel)}
+.pill .dot{width:8px;height:8px;border-radius:50%;background:var(--steel)}
+.pill.armed .dot{background:var(--jade);box-shadow:0 0 8px var(--jade)}
+.btn{display:inline-block;border:1px solid var(--line-soft);background:var(--panel);color:var(--bone);
+  font-family:var(--hdr);font-weight:600;font-size:13px;letter-spacing:.05em;border-radius:9px;padding:9px 16px;cursor:pointer;text-transform:uppercase}
+.btn:hover{border-color:var(--line)}
+.btn.primary{background:linear-gradient(180deg,var(--crimson),var(--crimson-deep));border-color:transparent;color:#fff}
+.btn.ghost{background:transparent}
+.btn:disabled{opacity:.4;cursor:not-allowed}
+.panel{background:var(--panel);border:1px solid var(--line-soft);border-radius:14px;padding:18px 20px;margin-bottom:16px;max-width:820px}
+.panel h2{font-size:17px;font-weight:700;margin-bottom:4px}
+.panel .sub{font-size:12.5px;color:var(--steel);margin-bottom:14px}
+.row{display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin:10px 0}
+label.fld{display:block;font-size:12px;color:var(--bone-dim);margin-bottom:5px}
+input[type=text],input[type=password],input[type=number]{background:#0a0a0c;border:1px solid var(--line-soft);border-radius:8px;
+  color:var(--bone);font-family:var(--body);font-size:14px;padding:9px 12px;min-width:240px}
+input:focus{outline:none;border-color:var(--line)}
+.note{font-size:12.5px;line-height:1.55}
+.banner{border:1px solid var(--line);border-radius:12px;background:linear-gradient(180deg,rgba(225,6,0,.06),transparent);
+  padding:14px 16px;margin-bottom:18px;max-width:820px}
+.banner ul{margin:8px 0 0;padding-left:18px}
+.banner li{margin:3px 0;font-size:12.5px}
+.creds{background:#0a0a0c;border:1px solid var(--line-soft);border-radius:10px;padding:12px 14px;margin-top:12px}
+.creds .k{font-size:11px;color:var(--steel);text-transform:uppercase;letter-spacing:.1em}
+.creds .v{font-family:ui-monospace,Menlo,Consolas,monospace;font-size:13px;color:var(--bone);word-break:break-all;margin:2px 0 10px}
+pre.snip{background:#0a0a0c;border:1px solid var(--line-soft);border-radius:10px;padding:12px 14px;overflow-x:auto;
+  font-size:12px;color:var(--bone-dim);white-space:pre;max-width:100%}
+.count{font-family:var(--hdr);font-size:15px;color:var(--amber)}
+.msg{font-size:12.5px;margin-top:8px;min-height:16px}
+.msg.err{color:var(--crimson)}
+.msg.ok{color:var(--jade)}
+.hide{display:none!important}
+.hr{height:1px;background:var(--line-soft);margin:16px 0;border:0}
+.grid2{display:grid;grid-template-columns:1fr 1fr;gap:12px}
+@media(max-width:680px){.grid2{grid-template-columns:1fr}}
+</style>
+</head>
+<body>
+<div class="pagehead">
+  <div class="eyebrow">Reaper</div>
+  <h1>AI Advisor</h1>
+  <span id="statePill" class="pill"><span class="dot"></span><span id="stateTxt">Dark</span></span>
+  <div class="spacer"></div>
+  <button class="btn ghost" onclick="loadStatus()">Refresh</button>
+</div>
+
+<div class="banner note">
+  A <b>read-only</b> bridge that lets <b>your own</b> AI assistant read this router's
+  configuration and traffic to audit and explain it &mdash; nothing more.
+  <ul>
+    <li><b>Off by default.</b> Nothing listens until you arm it below, and it never survives a reboot.</li>
+    <li><b>LAN only.</b> It binds this router's LAN address and is never reachable from the internet.</li>
+    <li><b>Read only.</b> It cannot change a single setting &mdash; it recommends; you apply.</li>
+    <li><b>Secrets never leave.</b> Wi-Fi passwords, admin credentials and keys are never exposed.</li>
+    <li><b>Two-factor.</b> Even with the admin password, arming also needs your out-of-band arming code.</li>
+    <li><b>Your key stays on your machine.</b> The AI runs in your client; no API key is stored here.</li>
+  </ul>
+</div>
+
+<!-- PROVISION -->
+<div class="panel">
+  <h2>1 &middot; Arming code</h2>
+  <div class="sub">A second factor stored only as a one-way hash. Keep the code in your password manager; the router never keeps the code itself.</div>
+  <div id="provState" class="note"></div>
+  <div class="row" id="oldRow" style="display:none">
+    <div>
+      <label class="fld" for="oldcode">Current code (required to rotate)</label>
+      <input type="password" id="oldcode" autocomplete="off" placeholder="current arming code">
+    </div>
+  </div>
+  <div class="row">
+    <div>
+      <label class="fld" for="code">Set / rotate arming code (min 12 chars)</label>
+      <input type="text" id="code" autocomplete="off" spellcheck="false" placeholder="paste or generate">
+    </div>
+    <button class="btn" onclick="genCode()">Generate</button>
+    <button class="btn primary" onclick="provision()">Save code</button>
+    <button class="btn ghost" onclick="deprovision()">Clear</button>
+  </div>
+  <div id="provMsg" class="msg"></div>
+</div>
+
+<!-- SETTINGS -->
+<div class="panel">
+  <h2>2 &middot; Settings</h2>
+  <div class="sub">Applied on save. The daemon reads these when you arm.</div>
+  <div class="grid2">
+    <div><label class="fld" for="port">LAN port (1024&ndash;65535)</label><input type="number" id="port" min="1024" max="65535"></div>
+    <div><label class="fld" for="timeout">Session timeout (15&ndash;240 min)</label><input type="number" id="timeout" min="15" max="240"></div>
+    <div><label class="fld" for="client">Pin to one client IP (optional)</label><input type="text" id="client" placeholder="e.g. 192.168.50.20 (blank = any LAN host)"></div>
+  </div>
+  <div class="row"><button class="btn" onclick="saveSettings()">Save settings</button></div>
+  <div id="setMsg" class="msg"></div>
+</div>
+
+<!-- ARM -->
+<div class="panel">
+  <h2>3 &middot; Arm the advisor</h2>
+  <div class="sub">Opens the door for one timed session. The door locks itself when the timer ends or you disable it.</div>
+  <div class="row">
+    <div><label class="fld" for="armcode">Arming code</label><input type="password" id="armcode" autocomplete="off" placeholder="your code"></div>
+    <button class="btn primary" id="armBtn" onclick="arm()">Arm</button>
+    <button class="btn ghost" id="disarmBtn" onclick="disarm()">Disable now</button>
+  </div>
+  <div id="armMsg" class="msg"></div>
+
+  <div id="armedBox" class="creds hide">
+    <div class="k">Session ends in</div><div class="v"><span id="countdown" class="count">&mdash;</span></div>
+    <div class="k">Endpoint (MCP, Streamable HTTP)</div><div class="v" id="epUrl">&mdash;</div>
+    <div class="k">Bearer token (shown once)</div><div class="v" id="epTok">&mdash;</div>
+    <hr class="hr">
+    <div class="k">Claude Desktop config snippet</div>
+    <pre class="snip" id="snip">&mdash;</pre>
+    <button class="btn" onclick="copySnip()">Copy snippet</button>
+    <div class="note" style="margin-top:10px;color:var(--steel)">
+      Point your AI client at the endpoint with this token. Some clients need the
+      <span class="mono">mcp-remote</span> bridge for plain HTTP MCP servers.
+    </div>
+  </div>
+</div>
+
+<script>
+var CGI = '/reaper_mcp.cgi';
+var lastToken = '', endExpiry = 0, ticker = null, provisionedNow = false;
+
+function esc(s){return (s==null?'':(''+s)).replace(/[<>&"]/g,function(c){return {'<':'&lt;','>':'&gt;','&':'&amp;','"':'&quot;'}[c];});}
+function post(action, params){
+  var body = 'action=' + encodeURIComponent(action);
+  if(params) for(var k in params) body += '&' + k + '=' + encodeURIComponent(params[k]);
+  return fetch(CGI, {method:'POST', headers:{'Content-Type':'application/x-www-form-urlencoded'}, body:body})
+    .then(function(r){return r.text();}).then(function(t){ try{return JSON.parse(t);}catch(e){return {ok:0,error:'bad response'};} });
+}
+
+function setMsg(id, text, cls){ var e=document.getElementById(id); e.textContent=text||''; e.className='msg'+(cls?(' '+cls):''); }
+
+function fmtLeft(sec){ if(sec<0)sec=0; var m=Math.floor(sec/60), s=sec%60; return m+'m '+(s<10?'0':'')+s+'s'; }
+
+function loadStatus(){
+  post('status').then(function(d){
+    var pill=document.getElementById('statePill'), txt=document.getElementById('stateTxt');
+    if(d.armed){ pill.className='pill armed'; txt.textContent='Armed'; endExpiry=d.expiry; startTicker(); document.getElementById('armedBox').classList.remove('hide'); }
+    else { pill.className='pill'; txt.textContent='Dark'; document.getElementById('armedBox').classList.add('hide'); stopTicker(); }
+    document.getElementById('provState').innerHTML = d.provisioned
+      ? '<span style="color:var(--jade)">An arming code is set.</span> Rotating it requires the current code.'
+      : '<span style="color:var(--amber)">No arming code yet.</span> Set one before you can arm.';
+    document.getElementById('oldRow').style.display = d.provisioned ? '' : 'none';
+    provisionedNow = !!d.provisioned;
+    if(d.port) document.getElementById('port').value=d.port;
+    if(d.timeout) document.getElementById('timeout').value=d.timeout;
+    document.getElementById('armBtn').disabled = !d.provisioned || (d.locked?true:false);
+    if(d.locked) setMsg('armMsg','Arming is temporarily locked after repeated wrong codes.','err');
+  });
+}
+
+function genCode(){
+  var a=new Uint8Array(16); (crypto||window.crypto).getRandomValues(a);
+  var abc='0123456789ABCDEFGHJKMNPQRSTVWXYZ', out='';
+  for(var i=0;i<a.length;i++){ out+=abc[a[i]&31]; if(i%4===3 && i<a.length-1) out+='-'; }
+  document.getElementById('code').value=out;
+}
+
+function provision(){
+  var code=document.getElementById('code').value.trim();
+  if(code.length<12){ setMsg('provMsg','Code must be at least 12 characters.','err'); return; }
+  var p={code:code};
+  if(provisionedNow){
+    var oc=document.getElementById('oldcode').value;
+    if(!oc){ setMsg('provMsg','Enter the current code to rotate.','err'); return; }
+    p.oldcode=oc;
+  }
+  post('provision',p).then(function(d){
+    if(d.ok){ setMsg('provMsg','Saved. Store this code safely - it is not recoverable from the router.','ok'); document.getElementById('code').value=''; document.getElementById('oldcode').value=''; loadStatus(); }
+    else setMsg('provMsg', d.error||'Failed.', 'err');
+  });
+}
+
+function deprovision(){
+  if(!confirm('Clear the arming code and disable the advisor?')) return;
+  post('deprovision').then(function(d){ setMsg('provMsg', d.ok?'Cleared.':'Failed.', d.ok?'ok':'err'); loadStatus(); });
+}
+
+function saveSettings(){
+  var port=parseInt(document.getElementById('port').value,10);
+  var to=parseInt(document.getElementById('timeout').value,10);
+  var cl=document.getElementById('client').value.trim();
+  if(!(port>=1024&&port<=65535)){ setMsg('setMsg','Port must be 1024-65535.','err'); return; }
+  if(!(to>=15&&to<=240)){ setMsg('setMsg','Timeout must be 15-240 minutes.','err'); return; }
+  var f=new FormData();
+  f.append('action_mode','apply'); f.append('rmcp_port',''+port); f.append('rmcp_timeout',''+to); f.append('rmcp_client',cl);
+  fetch('/applyapp.cgi',{method:'POST',body:new URLSearchParams(f)}).then(function(){ setMsg('setMsg','Saved.','ok'); });
+}
+
+function arm(){
+  var code=document.getElementById('armcode').value;
+  if(!code){ setMsg('armMsg','Enter your arming code.','err'); return; }
+  setMsg('armMsg','Arming...','');
+  post('arm',{code:code}).then(function(d){
+    document.getElementById('armcode').value='';
+    if(!d.ok){ setMsg('armMsg', d.error||'Arming failed.', 'err'); loadStatus(); return; }
+    setMsg('armMsg','Armed. The door is open until the timer ends.','ok');
+    lastToken=d.token; endExpiry=d.expiry;
+    document.getElementById('epUrl').textContent=d.url;
+    document.getElementById('epTok').textContent=d.token;
+    document.getElementById('snip').textContent=buildSnip(d.url,d.token);
+    document.getElementById('armedBox').classList.remove('hide');
+    startTicker(); loadStatus();
+  });
+}
+
+function disarm(){ post('disarm').then(function(){ setMsg('armMsg','Disabled. The door is locked.','ok'); lastToken=''; loadStatus(); }); }
+
+function buildSnip(url,tok){
+  return '{\n  "mcpServers": {\n    "reaper-router": {\n      "url": "'+url+'",\n      "headers": { "Authorization": "Bearer '+tok+'" }\n    }\n  }\n}';
+}
+function copySnip(){ var t=document.getElementById('snip').textContent; if(navigator.clipboard) navigator.clipboard.writeText(t); }
+
+function startTicker(){ stopTicker(); ticker=setInterval(tick,1000); tick(); }
+function stopTicker(){ if(ticker){clearInterval(ticker);ticker=null;} }
+function tick(){
+  var left=endExpiry-Math.floor(Date.now()/1000);
+  document.getElementById('countdown').textContent=fmtLeft(left);
+  if(left<=0){ stopTicker(); loadStatus(); }
+}
+
+loadStatus();
+</script>
+</body>
+</html>
