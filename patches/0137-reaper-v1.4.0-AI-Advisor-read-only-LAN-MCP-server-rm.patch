+endif
+
+ifeq ($(RTCONFIG_BCMARM),y)
+CFLAGS += -I$(SRCBASE)/shared/bcmwifi/include -DTYPEDEF_FLOAT_T
+CFLAGS += -I$(SRCBASE)/common/include
+endif
+
+OBJS = rmcpd.o
+
+all: rmcpd
+
+rmcpd: $(OBJS)
+	@echo " [rmcpd] CC -o $@"
+	$(CC) $(LDFLAGS) -o $@ $(OBJS)
+
+	$(SIZECHECK)
+	$(CPTMP)
+
+clean:
+	rm -f rmcpd .*.depend
+	rm -f *.o
+
+install: all
+	@echo " [rmcpd] Installing..."
+	install -D rmcpd $(INSTALLDIR)/bin/rmcpd
+	$(STRIP) $(INSTALLDIR)/bin/rmcpd
+
+%.o: %.c .%.depend
+	@echo " [rmcpd] CC $@"
+	@$(CC) $(CFLAGS) -c $<
+
+.depend: $(OBJS:%.o=%.c)
+	@$(CC) $(CFLAGS) -M $^ > .depend
+
+.%.depend: %.c
+	@$(CC) $(CFLAGS) -M $< > $@
+
+-include $(OBJS:%.o=.%.depend)
diff --git a/release/src/router/rmcpd/rmcpd.c b/release/src/router/rmcpd/rmcpd.c
new file mode 100644
index 0000000000..e6fe0829af
--- /dev/null
+++ b/release/src/router/rmcpd/rmcpd.c
@@ -0,0 +1,784 @@
+/*
+ * rmcpd - Reaper Advisor: read-only Model Context Protocol server (v1)
+ *
+ * PHILOSOPHY (see file-memory ai-hook-concept): reaper is a de-cloud, anti
+ * phone-home, physical-access-only hardening fork. This daemon is the ONE
+ * deliberate exception to "no inbound listeners", and it is fenced hard:
+ *
+ *   - OFF BY DEFAULT and NEVER started from the boot path. It runs only after
+ *     an explicit, second-factor-gated ARM action in the GUI, which writes the
+ *     session file this daemon requires to start at all.
+ *   - LAN-ONLY. Binds lan_ipaddr (never 0.0.0.0 / WAN); an INPUT accept rule is
+ *     added on the LAN bridge at start and removed on every exit path.
+ *   - READ-ONLY. It exposes curated read tools only - no write/apply tool
+ *     exists, not even a disabled one. The user's own AI client (with the
+ *     user's own API key) connects and advises; the human applies changes.
+ *   - EPHEMERAL. It self-terminates on session expiry (the GUI arming timeout),
+ *     on explicit Disable, or on repeated auth failure. Arming state lives in
+ *     /tmp only, so every reboot comes up dark.
+ *   - SECRETS NEVER LEAVE. Every nvram value passes a whitelist; every output
+ *     passes a scrubber for secret-shaped keys/values (PSKs, passwords, keys).
+ *
+ * The API key stays on the user's machine; nothing here talks to any cloud.
+ * Protocol: MCP Streamable HTTP - JSON-RPC 2.0 over HTTP POST /mcp, stateless
+ * responses (no SSE). Single client, tiny bounded parser, Bearer-token auth.
+ */
+
+#ifndef _GNU_SOURCE
+#define _GNU_SOURCE	/* strcasestr */
+#endif
+#include <stdio.h>
+#include <stdlib.h>
+#include <stdarg.h>
+#include <string.h>
+#include <strings.h>
+#include <unistd.h>
+#include <stdint.h>
+#include <time.h>
+#include <signal.h>
+#include <syslog.h>
+#include <errno.h>
+#include <ctype.h>
+#include <fcntl.h>
+#include <sys/stat.h>
+#include <sys/types.h>
+#include <sys/socket.h>
+#include <sys/select.h>
+#include <netinet/in.h>
+#include <arpa/inet.h>
+
+#include <json.h>	/* json-c umbrella; Makefile adds -I$(TOP)/json-c */
+
+#include <bcmnvram.h>
+#include <shutils.h>
+#include <shared.h>
+
+#define STATE_DIR	"/tmp/reaper_mcp"
+#define SESSION_FILE	STATE_DIR "/session"	/* token=<hex> expiry=<epoch> client=<ip> */
+#define DEF_PORT	5199
+#define MAX_BADAUTH	5		/* self-kill after this many bad tokens */
+#define REQ_MAX		65536		/* max request bytes we will read */
+#define TICK_SECS	1		/* accept/expiry poll cadence */
+#define TOOLOUT_MAX	(256 * 1024)	/* cap on a single tool's text output */
+
+#define PROTO_VER	"2024-11-05"	/* MCP protocol revision we speak */
+
+static volatile sig_atomic_t g_stop = 0;
+static int   g_added_rule = 0;
+static char  g_lan_ip[32] = "";
+static char  g_client_ip[32] = "";	/* pin, or "" for any LAN host */
+static int   g_port = DEF_PORT;
+static char  g_token[80] = "";
+static time_t g_expiry = 0;
+static int   g_badauth = 0;
+
+/* ------------------------------------------------------------------ */
+/* lifecycle: iptables fence + cleanup                                 */
+/* ------------------------------------------------------------------ */
+
+static const char *lan_ifname(void)
+{
+	char *lif = nvram_safe_get("lan_ifname");
+	return (lif && *lif) ? lif : "br0";
+}
+
+/* Insert / remove the single LAN-only accept rule. We shell out to the same
+ * iptables the rest of rc uses; args are daemon-controlled (ifname/ip/port),
+ * never request-derived, and the port/ip are numeric-validated below. */
+static void fence_rule(const char *op /* "-I" or "-D" */)
+{
+	char cmd[256];
+	const char *src = (g_client_ip[0] ? g_client_ip : "");
+
+	if (src[0])
+		snprintf(cmd, sizeof(cmd),
+			"iptables %s INPUT -i %s -s %s -p tcp --dport %d -j ACCEPT",
+			op, lan_ifname(), src, g_port);
+	else
+		snprintf(cmd, sizeof(cmd),
+			"iptables %s INPUT -i %s -p tcp --dport %d -j ACCEPT",
+			op, lan_ifname(), g_port);
+	system(cmd);
+}
+
+static void cleanup(void)
+{
+	if (g_added_rule) {
+		fence_rule("-D");
+		g_added_rule = 0;
+	}
+	unlink(SESSION_FILE);
+}
+
+static void on_signal(int sig)
+{
+	(void)sig;
+	g_stop = 1;
+}
+
+/* ------------------------------------------------------------------ */
+/* session file: written by the httpd arming endpoint before we start  */
+/* ------------------------------------------------------------------ */
+
+static int load_session(void)
+{
+	FILE *f = fopen(SESSION_FILE, "r");
+	char line[256];
+
+	if (!f)
+		return -1;
+	while (fgets(line, sizeof(line), f)) {
+		char *nl = strchr(line, '\n');
+		if (nl) *nl = 0;
+		if (!strncmp(line, "token=", 6))
+			snprintf(g_token, sizeof(g_token), "%s", line + 6);
+		else if (!strncmp(line, "expiry=", 7))
+			g_expiry = (time_t)strtoll(line + 7, NULL, 10);
+		else if (!strncmp(line, "client=", 7))
+			snprintf(g_client_ip, sizeof(g_client_ip), "%s", line + 7);
+	}
+	fclose(f);
+	if (!g_token[0] || g_expiry <= 0)
+		return -1;
+	return 0;
+}
+
+/* Accept only dotted-quad in the client pin, else drop the pin (defensive:
+ * the file is root-written, but never build a shell arg we didn't validate). */
+static void sanitize_client_ip(void)
+{
+	struct in_addr a;
+	if (g_client_ip[0] && inet_aton(g_client_ip, &a) != 1)
+		g_client_ip[0] = 0;
+}
+
+/* ------------------------------------------------------------------ */
+/* redaction: the single choke point every output passes through       */
+/* ------------------------------------------------------------------ */
+
+/* nvram keys safe to surface verbatim. Deny-by-default: anything not here is
+ * never emitted by get_nvram. Deliberately excludes every secret-bearing key
+ * (wl*_wpa_psk, http_passwd, *_key, vpn/radius/ddns creds, tokens). */
+static const char *NV_WHITELIST[] = {
+	"productid", "firmver", "buildno", "extendno", "odmpid", "territory_code",
+	"lan_ipaddr", "lan_netmask", "lan_proto", "lan_domain",
+	"wan_proto", "wan0_proto", "wan_ifname",
+	"dhcp_enable_x", "dhcp_start", "dhcp_end", "dhcp_lease",
+	"time_zone", "ntp_server0", "ntp_server1",
+	"wl0_ssid", "wl1_ssid", "wl2_ssid",
+	"wl0_auth_mode_x", "wl1_auth_mode_x", "wl2_auth_mode_x",
+	"wl0_crypto", "wl1_crypto", "wl2_crypto",
+	"wl0_channel", "wl1_channel", "wl2_channel",
+	"wl0_bw", "wl1_bw", "wl2_bw",
+	"wl0_closed", "wl1_closed", "wl2_closed",
+	"smart_connect_x", "smart_connect_v2",
+	"qos_enable", "qos_type", "qos_ibw", "qos_obw", "qos_bw_rulelist",
+	"fw_enable_x", "fw_log_x", "misc_http_x", "misc_httpport_x",
+	"upnp_enable", "wan0_upnp_enable", "wan1_upnp_enable",
+	"dmz_ip", "vts_enable_x",
+	"sshd_enable", "sshd_port",
+	"rtraf_enable", "rtraf_path", "rtraf_cap_gb",
+	"reaper_inject",
+	NULL
+};
+
+static int nv_whitelisted(const char *key)
+{
+	int i;
+	for (i = 0; NV_WHITELIST[i]; i++)
+		if (!strcmp(key, NV_WHITELIST[i]))
+			return 1;
+	return 0;
+}
+
+/* Secret-shaped key fragments. If get_nvram is ever pointed at a key that
+ * matches one of these it is dropped even were it whitelisted - belt and
+ * suspenders so the whitelist can never leak a secret by accident. */
+static const char *SECRET_FRAG[] = {
+	"psk", "passwd", "password", "_key", "wpa_", "radius", "secret",
+	"token", "crt", "cert", "privkey", "_ca", "cablekey", "cusootpw", NULL
+};
+
+static int key_is_secret(const char *key)
+{
+	int i;
+	char lo[128];
+	size_t j;
+	for (j = 0; key[j] && j < sizeof(lo) - 1; j++)
+		lo[j] = tolower((unsigned char)key[j]);
+	lo[j] = 0;
+	for (i = 0; SECRET_FRAG[i]; i++)
+		if (strstr(lo, SECRET_FRAG[i]))
+			return 1;
+	return 0;
+}
+
+/* ------------------------------------------------------------------ */
+/* small output buffer for building a tool's text payload             */
+/* ------------------------------------------------------------------ */
+
+typedef struct { char *p; size_t len, cap; int truncated; } sbuf_t;
+
+static void sb_init(sbuf_t *s)
+{
+	s->cap = 8192;
+	s->len = 0;
+	s->truncated = 0;
+	s->p = malloc(s->cap);
+	if (s->p) s->p[0] = 0;
+}
+
+static void sb_add(sbuf_t *s, const char *data, size_t n)
+{
+	if (!s->p || s->truncated)
+		return;
+	if (s->len + n >= TOOLOUT_MAX) {
+		s->truncated = 1;
+		return;
+	}
+	if (s->len + n + 1 > s->cap) {
+		size_t nc = s->cap * 2;
+		char *np;
+		while (nc < s->len + n + 1) nc *= 2;
+		np = realloc(s->p, nc);
+		if (!np) { s->truncated = 1; return; }
+		s->p = np;
+		s->cap = nc;
+	}
+	memcpy(s->p + s->len, data, n);
+	s->len += n;
+	s->p[s->len] = 0;
+}
+
+static void sb_puts(sbuf_t *s, const char *str) { sb_add(s, str, strlen(str)); }
+
+static void sb_printf(sbuf_t *s, const char *fmt, ...)
+{
+	char tmp[1024];
+	va_list ap;
+	int n;
+	va_start(ap, fmt);
+	n = vsnprintf(tmp, sizeof(tmp), fmt, ap);
+	va_end(ap);
+	if (n > 0)
+		sb_add(s, tmp, (size_t)n < sizeof(tmp) ? (size_t)n : sizeof(tmp) - 1);
+}
+
+static void sb_free(sbuf_t *s) { free(s->p); s->p = NULL; }
+
+/* append a JSON-string-escaped copy of src */
+static void sb_json_str(sbuf_t *s, const char *src)
+{
+	const unsigned char *u = (const unsigned char *)src;
+	char esc[8];
+	if (!src) { sb_puts(s, "null"); return; }
+	sb_puts(s, "\"");
+	for (; *u; u++) {
+		switch (*u) {
+		case '\"': sb_puts(s, "\\\""); break;
+		case '\\': sb_puts(s, "\\\\"); break;
+		case '\n': sb_puts(s, "\\n"); break;
+		case '\r': sb_puts(s, "\\r"); break;
+		case '\t': sb_puts(s, "\\t"); break;
+		default:
+			if (*u < 0x20) {
+				snprintf(esc, sizeof(esc), "\\u%04x", *u);
+				sb_puts(s, esc);
+			} else {
+				char c = (char)*u;
+				sb_add(s, &c, 1);
+			}
+		}
+	}
+	sb_puts(s, "\"");
+}
+
+/* read a small file (proc/tmp) into the sbuf, capped */
+static void sb_addfile(sbuf_t *s, const char *path, size_t cap)
+{
+	FILE *f = fopen(path, "r");
+	char buf[2048];
+	size_t got = 0, n;
+	if (!f) { sb_puts(s, "(unavailable)"); return; }
+	while ((n = fread(buf, 1, sizeof(buf), f)) > 0) {
+		if (got + n > cap) n = cap - got;
+		sb_add(s, buf, n);
+		got += n;
+		if (got >= cap) break;
+	}
+	fclose(f);
+}
+
+/* run a fixed (non-request-derived) command, capture stdout into sbuf */
+static void sb_addcmd(sbuf_t *s, const char *cmd, size_t cap)
+{
+	FILE *p = popen(cmd, "r");
+	char buf[2048];
+	size_t got = 0, n;
+	if (!p) { sb_puts(s, "(command unavailable)"); return; }
+	while ((n = fread(buf, 1, sizeof(buf), p)) > 0) {
+		if (got + n > cap) n = cap - got;
+		sb_add(s, buf, n);
+		got += n;
+		if (got >= cap) break;
+	}
+	pclose(p);
+}
+
+/* emit one whitelisted nvram key as a JSON "key":"value" pair (or skip) */
+static void sb_nv_pair(sbuf_t *s, const char *key, int *first)
+{
+	const char *v;
+	if (!nv_whitelisted(key) || key_is_secret(key))
+		return;
+	v = nvram_safe_get(key);
+	if (!*first) sb_puts(s, ",");
+	*first = 0;
+	sb_json_str(s, key);
+	sb_puts(s, ":");
+	sb_json_str(s, v);
+}
+
+/* ------------------------------------------------------------------ */
+/* the tools                                                           */
+/* ------------------------------------------------------------------ */
+
+static void tool_overview(sbuf_t *s)
+{
+	int first = 1;
+	sb_puts(s, "{");
+	sb_nv_pair(s, "productid", &first);
+	sb_nv_pair(s, "firmver", &first);
+	sb_nv_pair(s, "buildno", &first);
+	sb_nv_pair(s, "extendno", &first);
+	sb_puts(s, ",\"uptime\":"); { sbuf_t t; sb_init(&t); sb_addfile(&t, "/proc/uptime", 64);
+		/* first token only */ if (t.p) { char *sp = strchr(t.p, ' '); if (sp) *sp = 0; }
+		sb_json_str(s, t.p ? t.p : ""); sb_free(&t); }
+	sb_puts(s, ",\"loadavg\":"); { sbuf_t t; sb_init(&t); sb_addfile(&t, "/proc/loadavg", 96);
+		if (t.p) { char *nl = strchr(t.p, '\n'); if (nl) *nl = 0; } sb_json_str(s, t.p ? t.p : ""); sb_free(&t); }
+	sb_puts(s, ",\"meminfo\":"); { sbuf_t t; sb_init(&t); sb_puts(&t, ""); sb_addcmd(&t, "grep -E '^(MemTotal|MemFree|MemAvailable):' /proc/meminfo", 256);
+		sb_json_str(s, t.p ? t.p : ""); sb_free(&t); }
+	sb_puts(s, "}");
+}
+
+static void tool_wireless(sbuf_t *s)
+{
+	static const char *keys[] = {
+		"wl0_ssid", "wl0_auth_mode_x", "wl0_crypto", "wl0_channel", "wl0_bw", "wl0_closed",
+		"wl1_ssid", "wl1_auth_mode_x", "wl1_crypto", "wl1_channel", "wl1_bw", "wl1_closed",
+		"wl2_ssid", "wl2_auth_mode_x", "wl2_crypto", "wl2_channel", "wl2_bw", "wl2_closed",
+		"smart_connect_x", "smart_connect_v2", NULL };
+	int first = 1, i;
+	sb_puts(s, "{");
+	for (i = 0; keys[i]; i++)
+		sb_nv_pair(s, keys[i], &first);
+	sb_puts(s, "}");
+	/* NOTE: PSKs are intentionally absent - only security MODE is surfaced. */
+}
+
+static void tool_clients(sbuf_t *s)
+{
+	sb_puts(s, "{\"arp\":");
+	{ sbuf_t t; sb_init(&t); sb_addfile(&t, "/proc/net/arp", 8192); sb_json_str(s, t.p ? t.p : ""); sb_free(&t); }
+	sb_puts(s, ",\"dhcp_leases\":");
+	{ sbuf_t t; sb_init(&t); sb_addfile(&t, "/var/lib/misc/dnsmasq.leases", 8192); sb_json_str(s, t.p ? t.p : ""); sb_free(&t); }
+	sb_puts(s, "}");
+}
+
+static void tool_qos(sbuf_t *s)
+{
+	int first = 1;
+	static const char *keys[] = { "qos_enable", "qos_type", "qos_ibw", "qos_obw", "qos_bw_rulelist", NULL };
+	int i;
+	sb_puts(s, "{\"config\":{");
+	for (i = 0; keys[i]; i++)
+		sb_nv_pair(s, keys[i], &first);
+	sb_puts(s, "},\"stats_hint\":\"per-class live counters via Reaper_QoS.asp / reaper_qos_stats.cgi when qos_type=11\"}");
+}
+
+static void tool_traffic(sbuf_t *s, const char *win)
+{
+	static const char *wins[] = { "live", "m5", "hour", "day", "month", NULL };
+	const char *want = "live";
+	char path[64];
+	int i;
+	for (i = 0; wins[i]; i++)
+		if (win && !strcmp(win, wins[i])) { want = wins[i]; break; }
+	snprintf(path, sizeof(path), "/tmp/rtraf/%s.json", want);
+	sb_addfile(s, path, 200 * 1024);
+}
+
+static void tool_firewall(sbuf_t *s)
+{
+	sb_puts(s, "{\"filter\":");
+	{ sbuf_t t; sb_init(&t); sb_addcmd(&t, "iptables -S 2>/dev/null", 32768); sb_json_str(s, t.p ? t.p : ""); sb_free(&t); }
+	sb_puts(s, ",\"nat_forwards\":");
+	{ sbuf_t t; sb_init(&t); sb_addcmd(&t, "iptables -t nat -S 2>/dev/null | grep -Ei 'DNAT|VSERVER|dport'", 16384); sb_json_str(s, t.p ? t.p : ""); sb_free(&t); }
+	sb_puts(s, "}");
+}
+
+static void tool_nvram(sbuf_t *s)
+{
+	int i, first = 1;
+	sb_puts(s, "{");
+	for (i = 0; NV_WHITELIST[i]; i++)
+		sb_nv_pair(s, NV_WHITELIST[i], &first);
+	sb_puts(s, "}");
+}
+
+static void tool_logs(sbuf_t *s)
+{
+	/* syslog tail; redact anything that looks like a secret assignment */
+	sb_addcmd(s, "tail -n 200 /tmp/syslog.log 2>/dev/null | "
+		"sed -E 's/(psk|password|passwd|key|secret|token)=[^ ]+/\\1=<redacted>/Ig'",
+		48 * 1024);
+}
+
+static void tool_audit(sbuf_t *s)
+{
+	/* Composed posture snapshot - the AI's main entree. */
+	sb_puts(s, "{\"overview\":");   tool_overview(s);
+	sb_puts(s, ",\"wireless\":");   tool_wireless(s);
+	sb_puts(s, ",\"qos\":");        tool_qos(s);
+	sb_puts(s, ",\"firewall\":");   tool_firewall(s);
+	sb_puts(s, ",\"key_settings\":"); tool_nvram(s);
+	sb_puts(s, "}");
+}
+
+/* dispatch a tools/call by name; returns 0 if handled, -1 if unknown tool */
+static int run_tool(const char *name, struct json_object *args, sbuf_t *out)
+{
+	if (!strcmp(name, "get_overview"))        { tool_overview(out); return 0; }
+	if (!strcmp(name, "get_wireless_status")) { tool_wireless(out); return 0; }
+	if (!strcmp(name, "get_clients"))         { tool_clients(out); return 0; }
+	if (!strcmp(name, "get_qos"))             { tool_qos(out); return 0; }
+	if (!strcmp(name, "get_traffic")) {
+		struct json_object *w = NULL;
+		const char *win = NULL;
+		if (args && json_object_object_get_ex(args, "window", &w))
+			win = json_object_get_string(w);
+		tool_traffic(out, win);
+		return 0;
+	}
+	if (!strcmp(name, "get_firewall_summary")) { tool_firewall(out); return 0; }
+	if (!strcmp(name, "get_nvram"))            { tool_nvram(out); return 0; }
+	if (!strcmp(name, "get_logs"))             { tool_logs(out); return 0; }
+	if (!strcmp(name, "get_settings_audit"))   { tool_audit(out); return 0; }
+	return -1;
+}
+
+/* the tools/list catalog (static JSON) */
+static const char *TOOLS_CATALOG =
+"["
+"{\"name\":\"get_overview\",\"description\":\"Router model, firmware, uptime, load, memory.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{}}},"
+"{\"name\":\"get_wireless_status\",\"description\":\"Per-radio SSID, security MODE (never the PSK), channel, width.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{}}},"
+"{\"name\":\"get_clients\",\"description\":\"Connected clients from ARP and DHCP leases.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{}}},"
+"{\"name\":\"get_qos\",\"description\":\"QoS engine, type, and bandwidth configuration.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{}}},"
+"{\"name\":\"get_traffic\",\"description\":\"Traffic Analyzer snapshot for a window.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"window\":{\"type\":\"string\",\"enum\":[\"live\",\"m5\",\"hour\",\"day\",\"month\"]}}}},"
+"{\"name\":\"get_firewall_summary\",\"description\":\"iptables filter rules and NAT forwards summary.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{}}},"
+"{\"name\":\"get_nvram\",\"description\":\"Curated non-secret configuration keys (secrets are never included).\",\"inputSchema\":{\"type\":\"object\",\"properties\":{}}},"
+"{\"name\":\"get_logs\",\"description\":\"Recent system log lines, secrets redacted.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{}}},"
+"{\"name\":\"get_settings_audit\",\"description\":\"Composed security-posture snapshot for auditing and explanation.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{}}}"
+"]";
+
+/* ------------------------------------------------------------------ */
+/* HTTP + JSON-RPC                                                     */
+/* ------------------------------------------------------------------ */
+
+static void http_send(int fd, int code, const char *status, const char *body, size_t blen)
+{
+	char hdr[256];
+	int n = snprintf(hdr, sizeof(hdr),
+		"HTTP/1.1 %d %s\r\n"
+		"Content-Type: application/json\r\n"
+		"Content-Length: %zu\r\n"
+		"Connection: close\r\n"
+		"\r\n", code, status, blen);
+	if (n > 0) write(fd, hdr, n);
+	if (body && blen) write(fd, body, blen);
+}
+
+static void http_error(int fd, int code, const char *status, const char *msg)
+{
+	char body[256];
+	int n = snprintf(body, sizeof(body), "{\"error\":%s}", "\"err\"");
+	(void)msg;
+	http_send(fd, code, status, body, n > 0 ? (size_t)n : 0);
+}
+
+/* Build a JSON-RPC result envelope wrapping a tools/call text content. */
+static void send_rpc_result_raw(int fd, struct json_object *id, const char *raw_json_result)
+{
+	sbuf_t o;
+	sb_init(&o);
+	sb_puts(&o, "{\"jsonrpc\":\"2.0\",\"id\":");
+	sb_puts(&o, id ? json_object_to_json_string(id) : "null");
+	sb_puts(&o, ",\"result\":");
+	sb_puts(&o, raw_json_result);
+	sb_puts(&o, "}");
+	http_send(fd, 200, "OK", o.p ? o.p : "{}", o.len);
+	sb_free(&o);
+}
+
+static void send_rpc_error(int fd, struct json_object *id, int code, const char *message)
+{
+	sbuf_t o;
+	sb_init(&o);
+	sb_puts(&o, "{\"jsonrpc\":\"2.0\",\"id\":");
+	sb_puts(&o, id ? json_object_to_json_string(id) : "null");
+	sb_printf(&o, ",\"error\":{\"code\":%d,\"message\":", code);
+	sb_json_str(&o, message);
+	sb_puts(&o, "}}");
+	http_send(fd, 200, "OK", o.p ? o.p : "{}", o.len);
+	sb_free(&o);
+}
+
+static void handle_rpc(int fd, const char *body)
+{
+	struct json_object *root, *jid = NULL, *jmethod = NULL, *jparams = NULL;
+	const char *method;
+
+	root = json_tokener_parse(body);
+	if (!root) { http_error(fd, 400, "Bad Request", "parse"); return; }
+
+	json_object_object_get_ex(root, "id", &jid);
+	json_object_object_get_ex(root, "method", &jmethod);
+	json_object_object_get_ex(root, "params", &jparams);
+	method = jmethod ? json_object_get_string(jmethod) : "";
+
+	if (!strcmp(method, "initialize")) {
+		sbuf_t r; sb_init(&r);
+		sb_puts(&r, "{\"protocolVersion\":\"" PROTO_VER "\","
+			"\"capabilities\":{\"tools\":{}},"
+			"\"serverInfo\":{\"name\":\"reaper-advisor\",\"version\":\"1.0\"},"
+			"\"instructions\":\"Read-only Reaper router advisor. All tools are read-only; "
+			"recommend changes for the human to apply. Secrets are never exposed.\"}");
+		send_rpc_result_raw(fd, jid, r.p ? r.p : "{}");
+		sb_free(&r);
+	} else if (!strcmp(method, "ping")) {
+		send_rpc_result_raw(fd, jid, "{}");
+	} else if (!strncmp(method, "notifications/", 14)) {
+		/* JSON-RPC notification - no id, no response body expected */
+		http_send(fd, 202, "Accepted", "", 0);
+	} else if (!strcmp(method, "tools/list")) {
+		sbuf_t r; sb_init(&r);
+		sb_puts(&r, "{\"tools\":");
+		sb_puts(&r, TOOLS_CATALOG);
+		sb_puts(&r, "}");
+		send_rpc_result_raw(fd, jid, r.p ? r.p : "{}");
+		sb_free(&r);
+	} else if (!strcmp(method, "tools/call")) {
+		struct json_object *jname = NULL, *jargs = NULL;
+		const char *tname;
+		sbuf_t tout, r;
+		if (!jparams || !json_object_object_get_ex(jparams, "name", &jname)) {
+			send_rpc_error(fd, jid, -32602, "missing tool name");
+			json_object_put(root);
+			return;
+		}
+		json_object_object_get_ex(jparams, "arguments", &jargs);
+		tname = json_object_get_string(jname);
+		sb_init(&tout);
+		if (run_tool(tname, jargs, &tout) != 0) {
+			send_rpc_error(fd, jid, -32601, "unknown tool");
+			sb_free(&tout);
+			json_object_put(root);
+			return;
+		}
+		syslog(LOG_NOTICE, "rmcpd: tools/call %s (%zu bytes%s)",
+			tname, tout.len, tout.truncated ? ", truncated" : "");
+		/* wrap the tool text as MCP content */
+		sb_init(&r);
+		sb_puts(&r, "{\"content\":[{\"type\":\"text\",\"text\":");
+		sb_json_str(&r, tout.p ? tout.p : "");
+		sb_puts(&r, "}],\"isError\":false}");
+		send_rpc_result_raw(fd, jid, r.p ? r.p : "{}");
+		sb_free(&r);
+		sb_free(&tout);
+	} else {
+		send_rpc_error(fd, jid, -32601, "method not found");
+	}
+	json_object_put(root);
+}
+
+/* returns 1 if the request carried the correct Bearer token */
+static int check_auth(const char *headers)
+{
+	const char *h = strcasestr(headers, "\nauthorization:");
+	const char *b;
+	char got[128];
+	size_t i = 0;
+	if (!h) return 0;
+	h += 15;
+	while (*h == ' ' || *h == '\t') h++;
+	if (strncasecmp(h, "bearer ", 7)) return 0;
+	b = h + 7;
+	while (*b && *b != '\r' && *b != '\n' && i < sizeof(got) - 1)
+		got[i++] = *b++;
+	got[i] = 0;
+	/* length-first compare to keep it simple; token is 128-bit random hex */
+	if (strlen(got) != strlen(g_token)) return 0;
+	return strcmp(got, g_token) == 0 ? 1 : 0;
+}
+
+static void serve_conn(int fd)
+{
+	char *req = malloc(REQ_MAX + 1);
+	size_t total = 0;
+	ssize_t n;
+	char *hdr_end, *body;
+	long clen = 0;
+	const char *cl;
+
+	if (!req) { close(fd); return; }
+
+	/* read headers (and whatever body arrives with them) */
+	while (total < REQ_MAX) {
+		n = read(fd, req + total, REQ_MAX - total);
+		if (n <= 0) break;
+		total += n;
+		req[total] = 0;
+		if (strstr(req, "\r\n\r\n")) {
+			/* have full header block; check if we still need more body */
+			hdr_end = strstr(req, "\r\n\r\n");
+			cl = strcasestr(req, "\ncontent-length:");
+			if (cl) clen = strtol(cl + 16, NULL, 10);
+			if (clen < 0) clen = 0;
+			if ((size_t)((hdr_end + 4) - req) + (size_t)clen <= total)
+				break;
+		}
+	}
+	req[total] = 0;
+
+	hdr_end = strstr(req, "\r\n\r\n");
+	if (!hdr_end) { http_error(fd, 400, "Bad Request", "hdr"); free(req); close(fd); return; }
+
+	/* method + path: only POST /mcp is served */
+	if (strncmp(req, "POST ", 5) || !strstr(req, " /mcp")) {
+		http_error(fd, 404, "Not Found", "path");
+		free(req); close(fd); return;
+	}
+
+	if (!check_auth(req)) {
+		if (++g_badauth >= MAX_BADAUTH) {
+			syslog(LOG_CRIT, "rmcpd: %d bad tokens - self-terminating", g_badauth);
+			g_stop = 1;
+		}
+		http_error(fd, 401, "Unauthorized", "auth");
+		free(req); close(fd); return;
+	}
+	g_badauth = 0;
+
+	body = hdr_end + 4;
+	handle_rpc(fd, body);
+	free(req);
+	close(fd);
+}
+
+/* ------------------------------------------------------------------ */
+/* main                                                                */
+/* ------------------------------------------------------------------ */
+
+int main(int argc, char **argv)
+{
+	int ls;
+	struct sockaddr_in sa;
+	int one = 1;
+	char *pv;
+
+	(void)argc; (void)argv;
+	openlog("rmcpd", 0, LOG_DAEMON);
+
+	if (load_session() != 0) {
+		syslog(LOG_ERR, "rmcpd: no valid armed session - refusing to start");
+		return 1;
+	}
+	sanitize_client_ip();
+
+	snprintf(g_lan_ip, sizeof(g_lan_ip), "%s", nvram_safe_get("lan_ipaddr"));
+	if (!g_lan_ip[0]) {
+		syslog(LOG_ERR, "rmcpd: no lan_ipaddr - refusing to start");
+		return 1;
+	}
+	pv = nvram_safe_get("rmcp_port");
+	if (pv && *pv) {
+		int p = atoi(pv);
+		if (p >= 1024 && p <= 65535) g_port = p;
+	}
+
+	signal(SIGTERM, on_signal);
+	signal(SIGINT,  on_signal);
+	signal(SIGPIPE, SIG_IGN);
+
+	ls = socket(AF_INET, SOCK_STREAM, 0);
+	if (ls < 0) { syslog(LOG_ERR, "rmcpd: socket: %m"); return 1; }
+	setsockopt(ls, SOL_SOCKET, SO_REUSEADDR, &one, sizeof(one));
+
+	memset(&sa, 0, sizeof(sa));
+	sa.sin_family = AF_INET;
+	sa.sin_port = htons(g_port);
+	/* LAN-ONLY: bind the LAN address explicitly, never INADDR_ANY */
+	if (inet_aton(g_lan_ip, &sa.sin_addr) != 1) {
+		syslog(LOG_ERR, "rmcpd: bad lan_ipaddr %s", g_lan_ip);
+		close(ls);
+		return 1;
+	}
+	if (bind(ls, (struct sockaddr *)&sa, sizeof(sa)) < 0) {
+		syslog(LOG_ERR, "rmcpd: bind %s:%d: %m", g_lan_ip, g_port);
+		close(ls);
+		return 1;
+	}
+	if (listen(ls, 4) < 0) {
+		syslog(LOG_ERR, "rmcpd: listen: %m");
+		close(ls);
+		return 1;
+	}
+
+	fence_rule("-I");
+	g_added_rule = 1;
+	atexit(cleanup);
+
+	syslog(LOG_NOTICE, "rmcpd: armed, read-only advisor on %s:%d, session ends in %ld min",
+		g_lan_ip, g_port, (long)((g_expiry - time(NULL)) / 60));
+
+	while (!g_stop) {
+		fd_set rf;
+		struct timeval tv;
+		int r;
+		time_t now = time(NULL);
+
+		if (now >= g_expiry) {
+			syslog(LOG_NOTICE, "rmcpd: session expired - locking the door");
+			break;
+		}
+		FD_ZERO(&rf);
+		FD_SET(ls, &rf);
+		tv.tv_sec = TICK_SECS;
+		tv.tv_usec = 0;
+		r = select(ls + 1, &rf, NULL, NULL, &tv);
+		if (r < 0) {
+			if (errno == EINTR) continue;
+			break;
+		}
+		if (r == 0) continue;
+		if (FD_ISSET(ls, &rf)) {
+			struct sockaddr_in ca;
+			socklen_t cl = sizeof(ca);
+			int cfd = accept(ls, (struct sockaddr *)&ca, &cl);
+			if (cfd < 0) continue;
+			/* defense in depth atop iptables: enforce client pin here too */
+			if (g_client_ip[0]) {
+				char peer[32];
+				snprintf(peer, sizeof(peer), "%s", inet_ntoa(ca.sin_addr));
+				if (strcmp(peer, g_client_ip)) { close(cfd); continue; }
+			}
+			serve_conn(cfd);
+		}
+	}
+
+	close(ls);
+	cleanup();
+	syslog(LOG_NOTICE, "rmcpd: stopped");
+	closelog();
+	return 0;
+}
