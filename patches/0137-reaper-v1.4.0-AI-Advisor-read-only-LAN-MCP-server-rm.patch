 	{ "rtraf_cap_gb", "0", CKN_STR8, CKN_TYPE_DEFAULT, CKN_ACC_LEVEL_DEFAULT, CKN_ENC_DEFAULT, 0 },	/* monthly WAN quota in GB (0 = off); warns via syslog at 80/100% */
+
+	/* reaper v1.4.0: read-only LAN MCP advisor (rmcpd). No runtime enable flag by
