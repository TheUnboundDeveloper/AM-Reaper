@@ -21846,10 +21906,56 @@ do_reaper_mcp_cgi(char *url, FILE *stream)
 		return;
 	}
 
+	/* Mode B: enroll an OPTIONAL USB key as an additional arming factor. The
+	 * router generates the key, writes it to the stick, and keeps only its hash
+	 * - the key material lives on the stick, off the router (like the code). */
+	if (!strcmp(action, "usb_enroll")) {
+		char dir[288], kp[300], hexh[80];
+		unsigned char key[32];
+		FILE *kf;
+		if (rmcp_usb_writable_dir(dir, sizeof(dir)) != 0) {
+			websWrite(stream, "{\"ok\":0,\"error\":\"no writable USB drive found - insert a USB stick first\"}");
+			return;
+		}
+		if (RAND_bytes(key, sizeof(key)) != 1) {
+			websWrite(stream, "{\"ok\":0,\"error\":\"rng failure\"}");
+			return;
+		}
+		snprintf(kp, sizeof(kp), "%s/reaper.key", dir);
+		kf = fopen(kp, "wb");
+		if (!kf) {
+			websWrite(stream, "{\"ok\":0,\"error\":\"cannot write to USB\"}");
+			return;
+		}
+		fchmod(fileno(kf), 0600);
+		fwrite(key, 1, sizeof(key), kf);
+		fclose(kf);
+		if (rmcp_sha256_file(kp, hexh) != 0) {
+			websWrite(stream, "{\"ok\":0,\"error\":\"hash failure\"}");
+			return;
+		}
+		nvram_set("rmcp_usb_hash", hexh);
+		nvram_set("rmcp_usb_enable", "1");
+		nvram_commit();
+		logmessage("rmcpd", "USB key enrolled as optional 2nd arming factor");
+		websWrite(stream, "{\"ok\":1,\"volume\":\"%s\"}", dir);
+		return;
+	}
+
+	if (!strcmp(action, "usb_unenroll")) {
+		nvram_set("rmcp_usb_hash", "");
+		nvram_set("rmcp_usb_enable", "0");
+		nvram_commit();
+		logmessage("rmcpd", "USB key 2nd factor removed (code-only arming)");
+		websWrite(stream, "{\"ok\":1}");
+		return;
+	}
+
 	if (!strcmp(action, "arm")) {
 		char *code = get_cgi("code");
 		unsigned char salt[32], token[16];
 		char calc[80], tokhex[40];
+		char usbkey_line[320] = "";	/* Mode B: "usbkey=<path>\n" or empty */
 		const char *stored = nvram_safe_get("rmcp_code_hash");
 		int saltlen, fails, timeout;
 		FILE *sf;
@@ -21886,6 +21992,18 @@ do_reaper_mcp_cgi(char *url, FILE *stream)
 			websWrite(stream, "{\"ok\":0,\"error\":\"incorrect code\",\"fails\":%d}", fails);
 			return;
 		}
+		/* Mode B: if a USB key is enrolled, it must be present to arm. Record the
+		 * matched keyfile path in the session so rmcpd can watch it and lock the
+		 * door the instant the stick is pulled. Code was already verified above;
+		 * this is the ADDITIONAL factor, never a replacement. */
+		if (nvram_get_int("rmcp_usb_enable") == 1) {
+			char kp[300];
+			if (rmcp_usb_find_key(nvram_safe_get("rmcp_usb_hash"), kp, sizeof(kp)) != 0) {
+				websWrite(stream, "{\"ok\":0,\"error\":\"enrolled USB key not found - insert your key to arm\"}");
+				return;
+			}
+			snprintf(usbkey_line, sizeof(usbkey_line), "usbkey=%s\n", kp);
+		}
 		/* success: mint a session token and start the daemon */
 		nvram_set("rmcp_fails", "0");
 		nvram_set("rmcp_lock_until", "0");
@@ -21905,12 +22023,14 @@ do_reaper_mcp_cgi(char *url, FILE *stream)
 			return;
 		}
 		fchmod(fileno(sf), 0600);
-		fprintf(sf, "token=%s\nexpiry=%ld\nclient=%s\n",
-			tokhex, (long)(now + timeout * 60), nvram_safe_get("rmcp_client"));
+		fprintf(sf, "token=%s\nexpiry=%ld\nclient=%s\n%s",
+			tokhex, (long)(now + timeout * 60), nvram_safe_get("rmcp_client"),
+			usbkey_line);
 		fclose(sf);
 
 		notify_rc("start_rmcp");
-		logmessage("rmcpd", "advisor armed for %d minutes", timeout);
+		logmessage("rmcpd", "advisor armed for %d minutes%s", timeout,
+			usbkey_line[0] ? " (USB key required)" : "");
 		websWrite(stream, "{\"ok\":1,\"token\":\"%s\",\"lan_ip\":\"%s\",\"port\":%s,"
 			"\"expiry\":%ld,\"url\":\"http://%s:%s/mcp\"}",
 			tokhex, nvram_safe_get("lan_ipaddr"), nvram_safe_get("rmcp_port"),
