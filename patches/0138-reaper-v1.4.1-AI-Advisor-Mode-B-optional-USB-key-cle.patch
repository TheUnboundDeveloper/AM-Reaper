+/* Mode B (optional USB key) helpers. SHA-256 a file -> hex (64 chars). */
+static int rmcp_sha256_file(const char *path, char *hexout)
+{
+	FILE *f = fopen(path, "rb");
+	EVP_MD_CTX *ctx;
+	unsigned char buf[4096], md[32];
+	unsigned int mdlen = 0;
+	size_t n;
+	if (!f) return -1;
+	if (!(ctx = EVP_MD_CTX_new())) { fclose(f); return -1; }
+	EVP_DigestInit_ex(ctx, EVP_sha256(), NULL);
+	while ((n = fread(buf, 1, sizeof(buf), f)) > 0)
+		EVP_DigestUpdate(ctx, buf, n);
+	EVP_DigestFinal_ex(ctx, md, &mdlen);
+	EVP_MD_CTX_free(ctx);
+	fclose(f);
+	rmcp_hex(md, 32, hexout);
+	return 0;
+}
+
+/* first writable /tmp/mnt/<vol> mountpoint (where we can drop the keyfile) */
+static int rmcp_usb_writable_dir(char *out, size_t outsz)
+{
+	DIR *d = opendir("/tmp/mnt");
+	struct dirent *e;
+	if (!d) return -1;
+	while ((e = readdir(d))) {
+		char p[288];
+		if (e->d_name[0] == '.') continue;
+		snprintf(p, sizeof(p), "/tmp/mnt/%s", e->d_name);
+		if (access(p, W_OK) == 0) { snprintf(out, outsz, "%s", p); closedir(d); return 0; }
+	}
+	closedir(d);
+	return -1;
+}
+
+/* scan mounted USB volumes for a reaper.key whose SHA-256 == wanthash */
+static int rmcp_usb_find_key(const char *wanthash, char *out, size_t outsz)
+{
+	DIR *d = opendir("/tmp/mnt");
+	struct dirent *e;
+	int found = -1;
+	if (!d) return -1;
+	while ((e = readdir(d)) != NULL && found != 0) {
+		char kp[300], h[80];
+		if (e->d_name[0] == '.') continue;
+		snprintf(kp, sizeof(kp), "/tmp/mnt/%s/reaper.key", e->d_name);
+		if (access(kp, R_OK) != 0) continue;
+		if (rmcp_sha256_file(kp, h) == 0 && strlen(h) == strlen(wanthash) &&
+		    CRYPTO_memcmp(h, wanthash, strlen(wanthash)) == 0) {
+			snprintf(out, outsz, "%s", kp);
+			found = 0;
+		}
+	}
+	closedir(d);
+	return found;
+}
+
