-	sb_puts(s, "}");
-	/* NOTE: PSKs are intentionally absent - only security MODE is surfaced. */
+	sb_puts(s, "},\"networks\":[");
+
+	/* Friendly SSIDs from the SDN MAINFH profiles - mirrors state.js
+	 * get_sdn_main_fh_info(): split sdn_rl on '<', keep MAINFH entries, field
+	 * [5] (0-based, '>'-split) = apm index, read apm<idx>_ssid + auth MODE.
+	 * The PSK (apm<idx>_security field 3) is deliberately NEVER read. */
+	rl = strdup(nvram_safe_get("sdn_rl"));
+	if (rl) {
+		for (entry = strtok_r(rl, "<", &save1); entry; entry = strtok_r(NULL, "<", &save1)) {
+			char *e2, *tok, *save2, *fields[8];
+			int nf = 0;
+			if (!strstr(entry, "MAINFH")) continue;
+			if (!(e2 = strdup(entry))) continue;
+			for (tok = strtok_r(e2, ">", &save2); tok && nf < 8; tok = strtok_r(NULL, ">", &save2))
+				fields[nf++] = tok;
+			if (nf > 5) {
+				char key[32], skey[40], auth[48] = "";
+				const char *ssid, *sec, *lt;
+				snprintf(key, sizeof(key), "apm%s_ssid", fields[5]);
+				snprintf(skey, sizeof(skey), "apm%s_security", fields[5]);
+				ssid = nvram_safe_get(key);
+				sec = nvram_safe_get(skey);
+				/* apm<idx>_security = "...<...>AUTH>...>PSK>..." : take the field
+				 * at index 1 after the first '<' as the auth mode; never index 3. */
+				if ((lt = strchr(sec, '<')) != NULL) {
+					char *sd = strdup(lt + 1), *st, *sv;
+					int si = 0;
+					if (sd) {
+						for (st = strtok_r(sd, ">", &sv); st; st = strtok_r(NULL, ">", &sv)) {
+							if (si == 1) { snprintf(auth, sizeof(auth), "%s", st); break; }
+							si++;
+						}
+						free(sd);
+					}
+				}
+				if (nn++) sb_puts(s, ",");
+				sb_puts(s, "{\"ssid\":");
+				sb_json_str(s, ssid);
+				sb_puts(s, ",\"auth\":");
+				sb_json_str(s, auth);
+				sb_puts(s, "}");
+			}
+			free(e2);
+		}
+		free(rl);
+	}
+	sb_puts(s, "]}");
+	/* PSKs intentionally absent - only SSID + security MODE. */
 }
 
