+/* CSRF / second-factor guard for the destructive advisor actions. reaper_mcp.cgi
+ * is a Reaper-added CGI, so it is NOT in the (prebuilt, closed) httpd Referer
+ * whitelist - do_referer stays 0 and referer_check() never runs for it. do_auth
+ * only proves a live admin cookie, which a CSRF POST rides. Proving knowledge of
+ * the current arming code - a secret the browser never holds - defeats that for
+ * the security-relevant actions (wiping the code, dropping the USB 2nd factor),
+ * mirroring the code-rotation guard already used in 'provision'. Shares the same
+ * fail-count + lockout accounting. Returns 1 to proceed; on failure it has already
+ * written the JSON error and the caller must return. */
+static int
+rmcp_require_code(FILE *stream, const char *code, time_t now, long lock_until)
+{
+	unsigned char salt[32];
+	char calc[80];
+	const char *stored = nvram_safe_get("rmcp_code_hash");
+	int saltlen, fails;
+
+	if (lock_until > now) {
+		websWrite(stream, "{\"ok\":0,\"error\":\"locked - too many failures\",\"lock_until\":%ld}", lock_until);
+		return 0;
+	}
+	saltlen = rmcp_unhex(nvram_safe_get("rmcp_code_salt"), salt, sizeof(salt));
+	if (!code || saltlen <= 0 || rmcp_kdf(code, salt, saltlen, calc) != 0 ||
+	    strlen(calc) != strlen(stored) ||
+	    CRYPTO_memcmp(calc, stored, strlen(stored)) != 0) {
+		fails = atoi(nvram_safe_get("rmcp_fails")) + 1;
+		char fb[8]; snprintf(fb, sizeof(fb), "%d", fails);
+		nvram_set("rmcp_fails", fb);
+		if (fails >= RMCP_MAX_FAIL) {
+			char lb[16]; snprintf(lb, sizeof(lb), "%ld", (long)(now + RMCP_LOCK_SECS));
+			nvram_set("rmcp_lock_until", lb);
+		}
+		nvram_commit();
+		websWrite(stream, "{\"ok\":0,\"error\":\"current arming code required\"}");
+		return 0;
+	}
+	return 1;
+}
+
 static void
 do_reaper_mcp_cgi(char *url, FILE *stream)
 {
@@ -21894,7 +21933,10 @@ do_reaper_mcp_cgi(char *url, FILE *stream)
 	}
 
 	if (!strcmp(action, "deprovision")) {
-		/* clearing the code also disarms any live session */
+		/* clearing the code also disarms any live session; require proof of the
+		 * current code so a CSRF/stale-cookie POST cannot wipe the 2nd factor */
+		if (provisioned && !rmcp_require_code(stream, get_cgi("code"), now, lock_until))
+			return;
 		unlink(RMCP_SESSION);
 		notify_rc("stop_rmcp");
 		nvram_set("rmcp_code_salt", "");
@@ -21944,6 +21986,10 @@ do_reaper_mcp_cgi(char *url, FILE *stream)
 	}
 
 	if (!strcmp(action, "usb_unenroll")) {
+		/* dropping the 2nd factor is a security downgrade - gate it on the code
+		 * too, so a CSRF/stale-cookie POST cannot silently remove the USB key */
+		if (provisioned && !rmcp_require_code(stream, get_cgi("code"), now, lock_until))
+			return;
 		nvram_set("rmcp_usb_hash", "");
 		nvram_set("rmcp_usb_enable", "0");
 		nvram_commit();
diff --git a/release/src/router/rc/services.c b/release/src/router/rc/services.c
index d836419c6a..a090c0e0b3 100644
--- a/release/src/router/rc/services.c
+++ b/release/src/router/rc/services.c
@@ -7632,6 +7632,75 @@ start_rmcp(void)
 	}
 	xstart("rmcpd");
 }
+
+/* strict dotted-quad check: the client IP is spliced into an iptables shell
+ * command below, so a crafted session file must not be able to inject. */
+static int rmcp_ipv4_literal_ok(const char *s)
+{
+	size_t i, len;
+	if (!s) return 0;
+	len = strlen(s);
+	if (len < 7 || len > 15) return 0;	/* 0.0.0.0 .. 255.255.255.255 */
+	for (i = 0; i < len; i++)
+		if (!((s[i] >= '0' && s[i] <= '9') || s[i] == '.')) return 0;
+	return 1;
+}
+
+/* reaper v1.4.4: boot-time stale-rule sweep. Normally the daemon's atexit/signal
+ * cleanup removes its LAN INPUT ACCEPT rule and /tmp/reaper_mcp/session. If it
+ * died abnormally (SIGKILL/SEGV) that cleanup never ran and both can linger -
+ * inert (the daemon is gone) but untidy, and the port match stays open. On boot,
+ * with rmcpd NOT running, reconstruct the exact rule from nvram + the session's
+ * recorded client and tear it down. A clean boot has neither file nor rule, so
+ * this is a no-op. */
+void
+reaper_mcp_boot_sweep(void)
+{
+	char client[64] = "";
+	char cmd[256];
+	const char *lif;
+	int port, i;
+	FILE *f;
+
+	if (pids("rmcpd"))
+		return;				/* daemon alive - leave its rule in place */
+	if (!f_exists("/tmp/reaper_mcp/session"))
+		return;				/* nothing the daemon would have left behind */
+
+	port = nvram_get_int("rmcp_port");
+	if (port < 1024 || port > 65535)
+		port = 5199;
+	if ((f = fopen("/tmp/reaper_mcp/session", "r"))) {
+		char line[256];
+		while (fgets(line, sizeof(line), f)) {
+			char *nl = strchr(line, '\n');
+			if (nl) *nl = 0;
+			if (!strncmp(line, "client=", 7))
+				strlcpy(client, line + 7, sizeof(client));
+		}
+		fclose(f);
+	}
+
+	lif = nvram_safe_get("lan_ifname");
+	if (!lif || !*lif)
+		lif = "br0";
+	/* delete both rule shapes (pinned -s and unpinned); repeat to clear dups */
+	for (i = 0; i < 4; i++) {
+		if (rmcp_ipv4_literal_ok(client)) {
+			snprintf(cmd, sizeof(cmd),
+				"iptables -D INPUT -i %s -s %s -p tcp --dport %d -j ACCEPT 2>/dev/null",
+				lif, client, port);
+			system(cmd);
+		}
+		snprintf(cmd, sizeof(cmd),
+			"iptables -D INPUT -i %s -p tcp --dport %d -j ACCEPT 2>/dev/null",
+			lif, port);
+		system(cmd);
+	}
+
+	unlink("/tmp/reaper_mcp/session");
+	logmessage("rmcpd", "boot: cleared stale advisor rule/session left by an unclean exit");
+}
 #endif
 
