+/* The stock same-origin status endpoints return "<var> = {..JSON..};" assignment
+ * text (ej emitters + json-c, always single-line valid JSON). Extract the object
+ * and JSON.parse it rather than eval()-ing the response body, so an unexpected or
+ * tampered response can only ever become inert data, never executable code. */
+function pickJSON(text, name){
+  var m = text.match(new RegExp(name + '\\s*=\\s*(\\{.*\\})\\s*;'));
+  if(!m) return null;
+  try{ return JSON.parse(m[1]); }catch(e){ return null; }
+}
 var _prevCpu=null, _prevCores=null;
 function pollSys(){
   var x=new XMLHttpRequest();
@@ -687,8 +696,7 @@ function pollSys(){
   x.onreadystatechange=function(){
     if(x.readyState!==4||x.status!==200) return;
     try{
-      var cpuInfo={}, memInfo={};
-      eval(x.responseText);              /* defines cpuInfo, memInfo */
+      var cpuInfo=pickJSON(x.responseText,'cpuInfo')||{}, memInfo=pickJSON(x.responseText,'memInfo')||{};
       var tot=0,use=0,per=[];
       for(var k in cpuInfo){ var c=cpuInfo[k]; if(c&&c.total!=null){ tot+=Number(c.total); use+=Number(c.usage); per.push({t:Number(c.total),u:Number(c.usage)}); } }
       if(tot>0){
@@ -731,7 +739,7 @@ function pollTemp(){
   x.open('GET','/ajax_coretmp.asp?_='+(new Date()).getTime(),true);
   x.onreadystatechange=function(){
     if(x.readyState!==4||x.status!==200) return;
-    try{ eval(x.responseText); var t=parseFloat(String(window.curr_cpuTemp||'').replace(/[^0-9.]/g,'')); if(t>0) setTemp(t); }catch(e){}
+    try{ var m=x.responseText.match(/curr_cpuTemp\s*=\s*"([^"]*)"/); var t=m?parseFloat(m[1].replace(/[^0-9.]/g,'')):0; if(t>0) setTemp(t); }catch(e){}
   };
   x.send();
 }
@@ -889,8 +897,7 @@ function pollPorts(){
   x.onreadystatechange=function(){
     if(x.readyState!==4||x.status!==200) return;
     try{
-      var get_wan_lan_status={};
-      eval(x.responseText);              /* defines get_wan_lan_status */
+      var get_wan_lan_status=pickJSON(x.responseText,'get_wan_lan_status')||{};
       var sp=(get_wan_lan_status&&get_wan_lan_status.portSpeed)||{};
       var keys=[]; for(var k in sp) keys.push(k);
       if(!keys.length) return;
