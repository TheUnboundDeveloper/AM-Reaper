@@ -801,13 +801,23 @@ static void write_live(const char *store)
 }
 
 /* ---------- persistence (RAM / jffs / usb) ---------- */
+
+/* The store dir must be a REAL directory, not a symlink an attacker planted on
+ * a USB mount (which would silently redirect our rtraf.db writes elsewhere).
+ * lstat, don't follow: a symlink reports S_ISLNK, so S_ISDIR fails and we skip. */
+static int dir_ok(const char *p)
+{
+	struct stat st;
+	return lstat(p, &st) == 0 && S_ISDIR(st.st_mode);
+}
+
 static const char *resolve_store(char *buf, size_t len)
 {
 	char mode[16];
 	strlcpy(mode, nvram_safe_get("rtraf_path"), sizeof(mode));
 	if (strcmp(mode, "jffs") == 0) {
 		mkdir("/jffs/reaper", 0700);
-		if (access("/jffs/reaper", W_OK) == 0) {
+		if (dir_ok("/jffs/reaper") && access("/jffs/reaper", W_OK) == 0) {
 			strlcpy(buf, "/jffs/reaper/rtraf.db", len);
 			return "jffs";
 		}
@@ -820,7 +830,7 @@ static const char *resolve_store(char *buf, size_t len)
 				if (e->d_name[0] == '.') continue;
 				snprintf(p, sizeof(p), "/tmp/mnt/%s/reaper", e->d_name);
 				mkdir(p, 0700);
-				if (access(p, W_OK) == 0) {
+				if (dir_ok(p) && access(p, W_OK) == 0) {
 					snprintf(buf, len, "%s/rtraf.db", p);
 					closedir(d);
 					return "usb";
@@ -839,9 +849,17 @@ static void db_save(const char *path)
 	FILE *o;
 	char tmp[160];
 	int i;
+	int fd;
 	if (!path[0]) return;
 	snprintf(tmp, sizeof(tmp), "%s.new", path);
-	if ((o = fopen(tmp, "w")) == NULL) return;
+	/* On an attacker-controlled USB mount, tmp could be a pre-planted symlink;
+	 * clear it, then create exclusively without following (O_EXCL|O_NOFOLLOW)
+	 * with 0600 so history is never world-readable and never redirected. The
+	 * final rtraf.db is this 0600 file, published atomically via rename(). */
+	unlink(tmp);
+	fd = open(tmp, O_CREAT | O_EXCL | O_WRONLY | O_NOFOLLOW, 0600);
+	if (fd < 0) return;
+	if ((o = fdopen(fd, "w")) == NULL) { close(fd); unlink(tmp); return; }
 	memset(&h, 0, sizeof(h));
 	h.magic = DB_MAGIC; h.ver = DB_VER; h.saved = time(NULL); h.nnet = nnet;
 	memcpy(h.netname, netname, sizeof(netname));
@@ -861,7 +879,12 @@ static void db_load(const char *path)
 	dbhdr_t h;
 	FILE *o;
 	int i;
-	if (!path[0] || (o = fopen(path, "r")) == NULL) return;
+	int fd;
+	if (!path[0]) return;
+	/* don't follow a symlink planted where rtraf.db should be */
+	fd = open(path, O_RDONLY | O_NOFOLLOW);
+	if (fd < 0) return;
+	if ((o = fdopen(fd, "r")) == NULL) { close(fd); return; }
 	if (fread(&h, sizeof(h), 1, o) != 1 || h.magic != DB_MAGIC || h.ver != DB_VER) {
 		fclose(o);
 		return;
