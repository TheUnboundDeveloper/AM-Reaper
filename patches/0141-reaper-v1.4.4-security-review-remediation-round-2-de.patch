@@ -13280,6 +13349,9 @@ start_services(void)
 	start_infosvr();
 	restart_rstats();
 	start_rtraf();	/* reaper v1.3.0 traffic collector */
+#ifdef RTCONFIG_REAPER_MCP
+	reaper_mcp_boot_sweep();	/* reaper v1.4.4 - drop stale advisor rule/session from an unclean prior exit; never starts the daemon */
+#endif
 #ifdef RTCONFIG_DSL
 	start_spectrum(); //Ren
 #endif
diff --git a/release/src/router/rtrafd/rtrafd.c b/release/src/router/rtrafd/rtrafd.c
index 212421a321..6d3db13694 100644
--- a/release/src/router/rtrafd/rtrafd.c
