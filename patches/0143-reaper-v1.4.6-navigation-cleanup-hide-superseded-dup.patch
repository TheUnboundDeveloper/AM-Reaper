-/* The exact block that used to be baked before </head> in every stock page. */
+/* The block baked before </head> in every stock page: the reaper theme <link>
+ * plus the bounce/suppression script.
+ *
+ * SUP{} maps stock pages that a reaper-native page has SUPERSEDED to their
+ * replacement; hitting one (by direct URL or framed in the shell) redirects the
+ * TOP window to the reaper page instead of showing the dead stock page. The
+ * suppression check runs in BOTH top and framed contexts (top.location), so a
+ * bookmark or in-page link can't sneak a superseded page into the shell iframe.
+ * The normal index->dashboard / other->shell bounce still runs for top-level
+ * loads that are not suppressed. */
 static const char REAPER_BLOCK[] =
 	"<link rel=\"stylesheet\" type=\"text/css\" href=\"/reaper/reaper_content.css\">"
-	"<script>if(self===top){var rp=location.pathname.split(\"/\").pop()||\"index.asp\";"
-	"location.replace(rp===\"index.asp\"?\"/Main_ReaperDash.asp\":"
-	"\"/reaper_shell.asp#\"+rp+location.search);}</script>";
+	"<script>(function(){var rp=location.pathname.split(\"/\").pop()||\"index.asp\";"
+	"var SUP={\"main_trafficmonitor_realtime.asp\":\"Reaper_Traffic.asp\","
+	"\"main_trafficmonitor_last24.asp\":\"Reaper_Traffic.asp\","
+	"\"main_trafficmonitor_daily.asp\":\"Reaper_Traffic.asp\","
+	"\"main_trafficmonitor_monthly.asp\":\"Reaper_Traffic.asp\","
+	"\"main_trafficmonitor_settings.asp\":\"Reaper_Traffic.asp\","
+	"\"trafficanalyzer_statistic.asp\":\"Reaper_Traffic.asp\","
+	"\"advanced_qosuserprio_content.asp\":\"Reaper_QoS.asp\","
+	"\"advanced_qosuserrules_content.asp\":\"Reaper_QoS.asp\"};"
+	"var s=SUP[rp.toLowerCase()];"
+	"if(s){top.location.replace(\"/reaper_shell.asp#\"+s);return;}"
+	"if(self===top){location.replace(rp===\"index.asp\"?\"/Main_ReaperDash.asp\":"
+	"\"/reaper_shell.asp#\"+rp+location.search);}})();</script>";
 
 #define REAPER_TAG	"</head>"
 #define REAPER_TAGLEN	7		/* strlen("</head>") */
