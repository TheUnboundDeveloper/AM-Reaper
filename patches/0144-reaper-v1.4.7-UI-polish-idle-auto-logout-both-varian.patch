-var curWin = 'live', curStep = 'live', liveTimer = null, pollMs = 1000;
+var curWin = 'live', curStep = 'live', liveTimer = null, pollMs = 1000, curStore = 'RAM';
+/* reading pill mirrors the SELECTED window label + the store location (was hardcoded 'Live') */
+function setPill(){ var on=document.querySelector('#wins .win.on');
+  document.getElementById('statuspill_t').textContent=(on?on.textContent.trim():'Live')+' - '+curStore; }
 
 /* ---- formatting ---- */
