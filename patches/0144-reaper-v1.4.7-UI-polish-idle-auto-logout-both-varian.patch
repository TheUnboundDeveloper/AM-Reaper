   });
   window.addEventListener('resize', fit);
 })();
 
+/* v1.4.7: idle auto-logout (15 min) - closes an unattended admin session. Activity in
+   the shell chrome AND inside the framed page (re-attached on each load above) resets it. */
+(function(){
+  var IDLE=900000,t;
+  function go(){ try{ location='/Logout.asp'; }catch(e){} }
+  window.reaperIdleReset=function(){ clearTimeout(t); t=setTimeout(go,IDLE); };
+  window.reaperIdleAttach=function(doc){ try{ var es=['mousemove','mousedown','keydown','touchstart','scroll','wheel'];
+    for(var i=0;i<es.length;i++) doc.addEventListener(es[i],window.reaperIdleReset,{passive:true}); }catch(e){} };
+  window.reaperIdleAttach(document);
+  window.reaperIdleReset();
+})();
