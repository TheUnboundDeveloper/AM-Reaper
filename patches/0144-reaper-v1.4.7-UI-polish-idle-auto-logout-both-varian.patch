index b73a4d8688..0c9c23afc0 100644
--- a/release/src/router/www/reaper/reaper_content.css
+++ b/release/src/router/www/reaper/reaper_content.css
@@ -261,9 +261,11 @@ div[id$="_Block_PC"],div[id$="_Block_PC"] div,div[id$="_Block_PC"] a{
 .top-messgae1,.top-messgae2,.top-messgae3{background-color:#101014!important;color:#ECE7DB!important}
 .clients span,.style1{color:#ECE7DB!important}
 .input{background:#000!important;color:#ECE7DB!important;border:1px solid rgba(255,255,255,.12)!important}
-/* v1.2.4a: was solid #000 (a black slab under the disk label); use a faint track so
-   the crimson .quotabar fill reads as an actual usage bar on the dark panel. */
-#diskquota{background:#1c1c22!important}
+/* v1.4.7: remove the USB disk quota bar entirely - it crowds the tile and squeezes
+   the device name into a clip. Hidden via CSS so stock index.asp stays pristine. The
+   name text is also nudged down a size so a long disk name ("SanDisk Ultra Fit") fits. */
+#diskquota{display:none!important}
+[id^="deviceText_"]{font-size:12px!important}
 .button{background:linear-gradient(180deg,#1a1a1f,#101014)!important;color:#ECE7DB!important;
   border:1px solid rgba(255,255,255,.14)!important}
 .client_tag{background-color:#1a1a1f!important}
@@ -354,6 +356,12 @@ div[id$="_Block_PC"],div[id$="_Block_PC"] div,div[id$="_Block_PC"] a{
 .aimesh_tab > span{color:#B7B1A4!important;background:transparent!important;box-shadow:none!important}
 .aimesh_tab > span.clicked{color:#ECE7DB!important;background:transparent!important;box-shadow:none!important}
 .aimesh_tab > span.clicked:before{border-bottom:2px solid #B3000C!important}
+/* v1.4.7: the location photo behind the router/node name (.translucent_bg, default
+   Home.jpg) -> the ASUS logo. !important overrides every per-location variant
+   (.translucent_bg.Home/.Living_Room/...); contain keeps the whole logo visible. */
+.translucent_bg{background-image:url("/images/ASUSLogo.png")!important;
+  background-size:contain!important;background-position:center!important;
+  background-repeat:no-repeat!important}
 
 /* ---------- 12. on-device review 2026-07-04: remaining stock surfaces ---------- */
 /* tableApi data tables (js/table/table.css: thead td #4D595D teal, th #1f2d35)
@@ -414,7 +422,7 @@ div[id^="ring_USBdisk"]{background-image:url("/images/New_ui/networkmap/white_05
    high in the ring. Its background-position is set inline by index.asp JS so CSS
    can't retune it, but transform is NOT inline -> nudge the glyph down to centre it
    on the ring. ITERATION-1 offset (metal-tuned); ring div is untouched (id ring_). */
-div[id^="iconUSBdisk"]{transform:translateY(4px)!important}
+div[id^="iconUSBdisk"]{transform:translateY(4px)!important;background-position:0px -10px!important}
 
 /* Network Map "View List" popup (device-map/clientlist.html): the client list
    still rendered on stock teal */
