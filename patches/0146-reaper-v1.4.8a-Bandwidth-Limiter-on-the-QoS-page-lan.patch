+    ins[1].onblur = function(){ r.up = bwlMb2Kb(this.value); this.value = bwlKb2Mb(r.up); };
+    tr.querySelector('.bwldel').onclick = function(){ BWL.splice(idx,1); renderBwl(); };
+    tb.appendChild(tr);
+  })(i); }
+}
+function bwlAdd(){
