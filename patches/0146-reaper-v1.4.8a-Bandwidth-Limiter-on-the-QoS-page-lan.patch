+var BWL = [];            /* [{en, mac, dn(kb), up(kb)}] */
+var BWLNAMES = {};       /* mac(lower) -> display name from the client list */
+function bwlEsc(s){ return String(s==null?'':s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }
