diff --git a/release/src/router/httpd/web.c b/release/src/router/httpd/web.c
index c7df615c2a..05ee9c5902 100644
--- a/release/src/router/httpd/web.c
+++ b/release/src/router/httpd/web.c
@@ -21990,10 +21990,23 @@ do_reaper_mcp_cgi(char *url, FILE *stream)
 		 * too, so a CSRF/stale-cookie POST cannot silently remove the USB key */
 		if (provisioned && !rmcp_require_code(stream, get_cgi("code"), now, lock_until))
 			return;
+		/* reaper v1.4.9: the USB key is BINDING. It can only be removed with the
+		 * ENROLLED stick physically inserted - a code-holder alone (even via the
+		 * deprovision-then-unenroll path, where 'provisioned' is already 0) cannot
+		 * strip the third factor. Kept independent of 'provisioned' on purpose. If
+		 * the stick is lost, a factory reset / nvram clear is the ONLY way to clear
+		 * this lock. */
+		if (nvram_get_int("rmcp_usb_enable") == 1) {
+			char kp[300];
+			if (rmcp_usb_find_key(nvram_safe_get("rmcp_usb_hash"), kp, sizeof(kp)) != 0) {
+				websWrite(stream, "{\"ok\":0,\"error\":\"insert the enrolled USB key to remove it - a lost key can only be cleared by a factory reset\"}");
+				return;
+			}
+		}
 		nvram_set("rmcp_usb_hash", "");
 		nvram_set("rmcp_usb_enable", "0");
 		nvram_commit();
-		logmessage("rmcpd", "USB key 2nd factor removed (code-only arming)");
+		logmessage("rmcpd", "USB key 2nd factor removed (enrolled stick verified present)");
 		websWrite(stream, "{\"ok\":1}");
 		return;
 	}
