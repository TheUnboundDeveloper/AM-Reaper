diff --git a/release/src/router/www/Reaper_Advisor.asp b/release/src/router/www/Reaper_Advisor.asp
index 2d1d8802ba..02e92591b0 100644
--- a/release/src/router/www/Reaper_Advisor.asp
+++ b/release/src/router/www/Reaper_Advisor.asp
@@ -284,12 +284,22 @@ function buildSnip(url,tok){
 }
 function copySnip(){ var t=document.getElementById('snip').textContent; if(navigator.clipboard) navigator.clipboard.writeText(t); }
 
-function startTicker(){ stopTicker(); ticker=setInterval(tick,1000); tick(); }
+var tickN=0;
+function startTicker(){ stopTicker(); tickN=0; ticker=setInterval(tick,1000); tick(); }
 function stopTicker(){ if(ticker){clearInterval(ticker);ticker=null;} }
 function tick(){
   var left=endExpiry-Math.floor(Date.now()/1000);
   document.getElementById('countdown').textContent=fmtLeft(left);
-  if(left<=0){ stopTicker(); loadStatus(); }
+  if(left<=0){ stopTicker(); loadStatus(); return; }
+  /* reaper v1.4.9: re-poll the server every ~5s so a server-side session end
+     (USB key pulled, session timeout, or disarm) flips the UI to locked promptly
+     instead of counting down a session the router has already torn down. */
+  if((++tickN % 5)===0){
+    post('status').then(function(d){
+      if(!d.armed){ stopTicker(); setMsg('armMsg','<#RADV_72#>','err'); loadStatus(); }
+      else if(d.expiry){ endExpiry=d.expiry; }
+    });
+  }
 }
 
 loadStatus();
