+.app{display:grid;grid-template-columns:236px minmax(0,1fr);grid-template-rows:auto 1fr;min-height:100vh}
 .top{grid-column:2;grid-row:1;display:flex;align-items:center;gap:14px;padding:14px 18px;flex-wrap:nowrap;
   border-bottom:1px solid var(--line-soft);box-shadow:0 1px 0 rgba(225,6,0,.12);background:#040405;
   position:sticky;top:0;z-index:300}
@@ -57,6 +57,14 @@ body{font-family:var(--body);color:var(--bone-dim);background:var(--bg);overflow
   no-repeat 9px center;background-size:15px 15px}
 .langsel:hover{border-color:var(--crimson);color:#fff}
 .langsel option{background:var(--panel-2);color:var(--bone);text-transform:none;font-weight:600}
+/* language selector relocated into the rail (above the first group): compact
+   "LANGUAGE: [select]" row that flexes to the rail width without widening it */
+.raillang{display:flex;align-items:center;gap:6px;padding:2px 6px 10px}
+.raillbl{font-family:var(--hdr);text-transform:uppercase;letter-spacing:.1em;font-size:10px;color:var(--steel);flex:0 0 auto;white-space:nowrap}
+.raillangsel{flex:1 1 auto;min-width:0;width:100%;font-family:var(--hdr);font-weight:600;font-size:11px;letter-spacing:.02em;
+  padding:5px 6px;border-radius:7px;border:1px solid var(--line);cursor:pointer;color:var(--bone);background:var(--panel-2)}
+.raillangsel:hover{border-color:var(--crimson)}
+.raillangsel option{background:var(--panel-2);color:var(--bone);font-weight:600}
 .btn.crit{color:#fff;border-color:#7A0C0C;background:linear-gradient(180deg,var(--crimson),var(--crimson-deep))}
 .btn.crit:hover{filter:brightness(1.08)}
 /* rail: no scrollbar of its own - the page scrollbar handles overflow */
@@ -113,13 +121,13 @@ a.item.on::before{content:"";position:absolute;left:0;top:7px;bottom:7px;width:2
       <div class="pill"><span class="k"><#Reaper_c_mesh_nodes#></span><span class="v mono" id="p_mesh">0</span></div>
     </div>
     <span class="spacer"></span>
-    <select class="langsel" id="select_lang" title="<#Reaper_c_language#>" aria-label="<#Reaper_c_language#>"></select>
     <a class="btn" href="/Main_ReaperDash.asp"><#AiProtection_title_Dashboard_title#></a>
     <button class="btn" type="button" id="btn_reboot"><#BTN_REBOOT#></button>
