+/* ------------------------------------------------------------------ */
+/* active-diagnostics tier (v1.5.0): bounded ping/traceroute/dns/netstat, */
+/* gated by per-session consent (g_diag). argv-exec via _eval (NEVER a    */
+/* shell), single-flight, audited; targets scoped so the advisor cannot   */
+/* be used to sweep the internal network.                                 */
+/* ------------------------------------------------------------------ */
+
+/* A dotted-quad target is allowed if it is public, or private but on the
+ * router's own LAN subnet. Blocks using the advisor to sweep RFC1918 space. */
+static int diag_target_allowed_v4(struct in_addr a)
+{
+	unsigned long ip = ntohl(a.s_addr);
+	int priv = ((ip >> 24) == 10) ||
+		   ((ip & 0xFFF00000UL) == 0xAC100000UL) /* 172.16/12 */ ||
+		   ((ip & 0xFFFF0000UL) == 0xC0A80000UL) /* 192.168/16 */ ||
+		   ((ip >> 24) == 127) /* loopback */ ||
+		   ((ip & 0xFFFF0000UL) == 0xA9FE0000UL) /* 169.254/16 */;
+	struct in_addr lan, mask;
+	if (!priv)
+		return 1;
+	if (inet_aton(nvram_safe_get("lan_ipaddr"), &lan) == 1 &&
+	    inet_aton(nvram_safe_get("lan_netmask"), &mask) == 1)
+		return (a.s_addr & mask.s_addr) == (lan.s_addr & mask.s_addr);
+	return 0;
+}
+
+/* Validate + resolve a probe target to the numeric address we hand the tool.
+ * FQDNs are resolved FIRST and the resolved IPv4 is guarded, so a name that
+ * maps into internal space is rejected. IPv6 literals pass through. 1 = ok. */
+static int resolve_and_guard(const char *host, char *ipout, size_t iplen)
+{
+	struct in_addr a4;
+	struct in6_addr a6;
+	struct addrinfo hints, *res = NULL, *p;
+	int ok = 0;
+	size_t i, n = host ? strlen(host) : 0;
+
+	if (n == 0 || n > 253)
+		return 0;
+	if (inet_pton(AF_INET, host, &a4) == 1) {
+		if (!diag_target_allowed_v4(a4)) return 0;
+		snprintf(ipout, iplen, "%s", host);
+		return 1;
+	}
+	if (inet_pton(AF_INET6, host, &a6) == 1) {
+		snprintf(ipout, iplen, "%s", host);
+		return 1;
+	}
+	/* FQDN: conservative charset, must contain a dot, no leading/trailing sep */
+	if (host[0] == '.' || host[0] == '-' || host[n-1] == '.' || host[n-1] == '-')
+		return 0;
+	{
+		int dot = 0;
+		for (i = 0; i < n; i++) {
+			char c = host[i];
+			if (!(isalnum((unsigned char)c) || c == '.' || c == '-')) return 0;
+			if (c == '.') dot = 1;
+		}
+		if (!dot) return 0;
+	}
+	memset(&hints, 0, sizeof(hints));
+	hints.ai_family = AF_UNSPEC;
+	hints.ai_socktype = SOCK_DGRAM;
+	if (getaddrinfo(host, NULL, &hints, &res) != 0 || !res)
+		return 0;
+	for (p = res; p && !ok; p = p->ai_next) {
+		if (p->ai_family == AF_INET) {
+			struct sockaddr_in *si = (struct sockaddr_in *)p->ai_addr;
+			if (diag_target_allowed_v4(si->sin_addr)) {
+				inet_ntop(AF_INET, &si->sin_addr, ipout, iplen);
+				ok = 1;
+			}
+		}
+	}
+	for (p = res; p && !ok; p = p->ai_next) {
+		if (p->ai_family == AF_INET6) {
+			struct sockaddr_in6 *si6 = (struct sockaddr_in6 *)p->ai_addr;
+			inet_ntop(AF_INET6, &si6->sin6_addr, ipout, iplen);
+			ok = 1;
+		}
+	}
+	freeaddrinfo(res);
+	return ok;
+}
+
+/* one diagnostic at a time; run argv bounded (no shell, alarm timeout via
+ * _eval), capture to DIAG_OUT, read back capped, audit, clean up. */
+static void run_diag(const char *tool, const char *target, char *const argv[], int timeout_s, sbuf_t *out)
+{
+	int fd = open(DIAG_LOCK, O_CREAT | O_EXCL | O_WRONLY, 0600);
+	if (fd < 0) {
+		sb_puts(out, "error: another diagnostic is already running - try again shortly");
+		return;
+	}
+	close(fd);
+	syslog(LOG_NOTICE, "rmcpd: diag %s target=%s client=%s",
+		tool, target ? target : "-", g_client_ip[0] ? g_client_ip : "any-lan");
+	unlink(DIAG_OUT);
+	_eval(argv, ">" DIAG_OUT, timeout_s, NULL);	/* blocks; alarm-bounded */
+	sb_addfile(out, DIAG_OUT, DIAG_MAX);
+	unlink(DIAG_OUT);
+	unlink(DIAG_LOCK);
+}
+
+static const char *diag_arg_host(struct json_object *args)
+{
+	struct json_object *jh = NULL;
+	if (args && json_object_object_get_ex(args, "host", &jh))
+		return json_object_get_string(jh);
+	return NULL;
+}
+
+static void tool_net_ping(struct json_object *args, sbuf_t *out)
+{
+	const char *host = diag_arg_host(args);
+	char ip[64];
+	char *argv[] = { "ping", "-c", "4", "-w", "6", NULL, NULL };
+	if (!host) { sb_puts(out, "error: missing 'host'"); return; }
+	if (!resolve_and_guard(host, ip, sizeof(ip))) {
+		sb_puts(out, "error: target not permitted (unresolvable, or a private host outside this router's LAN)");
+		return;
+	}
+	argv[5] = ip;
+	run_diag("net_ping", ip, argv, 9, out);
+}
+
+static void tool_net_traceroute(struct json_object *args, sbuf_t *out)
+{
+	const char *host = diag_arg_host(args);
+	char ip[64];
+	char *argv[] = { "traceroute", "-n", "-q", "1", "-w", "2", "-m", "15", NULL, NULL };
+	if (!host) { sb_puts(out, "error: missing 'host'"); return; }
+	if (!resolve_and_guard(host, ip, sizeof(ip))) {
+		sb_puts(out, "error: target not permitted (unresolvable, or a private host outside this router's LAN)");
+		return;
+	}
+	argv[8] = ip;
+	run_diag("net_traceroute", ip, argv, 40, out);
+}
+
+static void tool_net_dns_lookup(struct json_object *args, sbuf_t *out)
+{
+	const char *name = diag_arg_host(args);
+	char clean[256];
+	char *argv[] = { "nslookup", NULL, NULL };
+	size_t i, n = name ? strlen(name) : 0;
+	if (n == 0 || n > 253) { sb_puts(out, "error: missing or oversized 'host'"); return; }
+	/* a DNS query, not a network probe of the target - just sanitize charset */
+	for (i = 0; i < n; i++) {
+		char c = name[i];
+		if (!(isalnum((unsigned char)c) || c == '.' || c == '-' || c == ':')) {
+			sb_puts(out, "error: invalid characters in 'host'"); return;
+		}
+	}
+	snprintf(clean, sizeof(clean), "%s", name);
+	argv[1] = clean;
+	run_diag("net_dns_lookup", clean, argv, 8, out);
+}
+
+static void tool_net_netstat(struct json_object *args, sbuf_t *out)
+{
+	char *argv[] = { "netstat", "-tuna", NULL };
+	(void)args;
+	run_diag("net_netstat", NULL, argv, 6, out);
+}
+
