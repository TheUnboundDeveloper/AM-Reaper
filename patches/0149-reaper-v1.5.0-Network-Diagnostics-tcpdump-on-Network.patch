 {
@@ -525,6 +702,13 @@ static int run_tool(const char *name, struct json_object *args, sbuf_t *out)
 	if (!strcmp(name, "get_nvram"))            { tool_nvram(out); return 0; }
 	if (!strcmp(name, "get_logs"))             { tool_logs(out); return 0; }
 	if (!strcmp(name, "get_settings_audit"))   { tool_audit(out); return 0; }
+	/* active-diagnostics tier - only reachable when the session consented */
+	if (g_diag) {
+		if (!strcmp(name, "net_ping"))       { tool_net_ping(args, out); return 0; }
+		if (!strcmp(name, "net_traceroute")) { tool_net_traceroute(args, out); return 0; }
+		if (!strcmp(name, "net_dns_lookup")) { tool_net_dns_lookup(args, out); return 0; }
+		if (!strcmp(name, "net_netstat"))    { tool_net_netstat(args, out); return 0; }
+	}
 	return -1;
 }
 
