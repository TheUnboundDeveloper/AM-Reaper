diff --git a/release/src/router/www/Main_PacketCapture_Content.asp b/release/src/router/www/Main_PacketCapture_Content.asp
new file mode 100644
index 0000000000..58be5b859c
--- /dev/null
+++ b/release/src/router/www/Main_PacketCapture_Content.asp
@@ -0,0 +1,158 @@
+<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
+<html xmlns="http://www.w3.org/1999/xhtml">
+<head>
+<meta http-equiv="X-UA-Compatible" content="IE=Edge">
+<meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
+<meta HTTP-EQUIV="Pragma" CONTENT="no-cache">
+<meta HTTP-EQUIV="Expires" CONTENT="-1">
+<link rel="shortcut icon" href="images/favicon.png">
+<link rel="icon" href="images/favicon.png">
+<title><#Network_Tools#> - <#NetworkTools_PktCap#></title>
+<link rel="stylesheet" type="text/css" href="index_style.css">
+<link rel="stylesheet" type="text/css" href="form_style.css">
+<script language="JavaScript" type="text/javascript" src="/js/jquery.js"></script>
+<script language="JavaScript" type="text/javascript" src="/state.js"></script>
+<script language="JavaScript" type="text/javascript" src="/general.js"></script>
+<script language="JavaScript" type="text/javascript" src="/popup.js"></script>
+<script language="JavaScript" type="text/javascript" src="/help.js"></script>
+<script language="JavaScript" type="text/javascript" src="/validator.js"></script>
+<script type="text/javascript" src="/form.js"></script>
+<script>
+function initial(){
+	show_menu();
+}
+
+/* client-side mirror of the server allow-list (server re-validates everything) */
+function filterOk(v){
+	return /^[A-Za-z0-9 ._:\/()\-]*$/.test(v);
+}
+
+function runCapture(){
+	var iface  = document.getElementById('pc_iface').value;
+	var count  = document.getElementById('pc_count').value || '20';
+	var dur    = document.getElementById('pc_dur').value || '5';
+	var snap   = document.getElementById('pc_snap').value || '256';
+	var filter = document.getElementById('pc_filter').value || '';
+
+	if(!iface){ alert('<#NetworkTools_PktCap_iface#>'); return; }
+	if(!filterOk(filter)){ alert('<#NetworkTools_PktCap_filter#>'); return; }
+
+	var btn = document.getElementById('pc_btn');
+	btn.disabled = true; btn.style.color = '#666';
+	document.getElementById('pc_load').style.display = '';
+	document.getElementById('pc_out').value = '...';
+
+	$.ajax({
+		url: '/reaper_pcap.cgi',
+		type: 'POST',
+		dataType: 'text',
+		data: { iface: iface, count: count, dur: dur, snap: snap, filter: filter },
+		error: function(){ finishCapture('capture failed - try again'); },
+		success: function(resp){ finishCapture(resp); }
+	});
+}
+
+function finishCapture(txt){
+	var ta = document.getElementById('pc_out');
+	ta.value = txt;
+	ta.scrollTop = ta.scrollHeight;
+	var btn = document.getElementById('pc_btn');
+	btn.disabled = false; btn.style.color = '';
+	document.getElementById('pc_load').style.display = 'none';
+}
+</script>
+</head>
+<body onload="initial();" class="bg">
+<div id="TopBanner"></div>
+<div id="Loading" class="popup_bg"></div>
+<iframe name="hidden_frame" id="hidden_frame" src="" width="0" height="0" frameborder="0"></iframe>
+<form method="POST" name="form" action="/reaper_pcap.cgi" target="hidden_frame">
+<input type="hidden" name="current_page" value="Main_PacketCapture_Content.asp">
+<input type="hidden" name="next_page" value="Main_PacketCapture_Content.asp">
+<input type="hidden" name="preferred_lang" id="preferred_lang" value="<% nvram_get("preferred_lang"); %>">
+<input type="hidden" name="firmver" value="<% nvram_get("firmver"); %>">
+
+<table class="content" align="center" cellpadding="0" cellspacing="0">
+	<tr>
+		<td width="17">&nbsp;</td>
+		<td valign="top" width="202">
+			<div id="mainMenu"></div>
+			<div id="subMenu"></div>
+		</td>
+		<td valign="top">
+			<div id="tabMenu" class="submenuBlock"></div>
+			<table width="98%" border="0" align="left" cellpadding="0" cellspacing="0">
+				<tr>
+					<td align="left" valign="top">
+						<table width="760px" border="0" cellpadding="5" cellspacing="0" bordercolor="#6b8fa3" class="FormTitle" id="FormTitle">
+							<tr>
+								<td bgcolor="#4D595D" colspan="3" valign="top">
+								<div class="container">
+
+									<div>&nbsp;</div>
+									<div class="formfonttitle"><#Network_Tools#> - <#NetworkTools_PktCap#></div>
+									<div style="margin:10px 0 10px 5px;" class="splitLine"></div>
+									<div class="formfontdesc"><#NetworkTools_PktCap_desc#></div>
+									<table width="100%" border="1" align="center" cellpadding="4" cellspacing="0" bordercolor="#6b8fa3" class="FormTable">
+										<tr>
+											<th width="30%"><#NetworkTools_PktCap_iface#></th>
+											<td>
+												<select id="pc_iface" class="input_option">
+													<option value="<% nvram_get("lan_ifname"); %>">LAN (<% nvram_get("lan_ifname"); %>)</option>
+													<option value="<% nvram_get("wan0_ifname"); %>">WAN (<% nvram_get("wan0_ifname"); %>)</option>
+												</select>
+											</td>
+										</tr>
+										<tr>
+											<th width="30%"><#NetworkTools_Count#></th>
+											<td>
+												<input type="text" id="pc_count" class="input_6_table" maxlength="4" value="20" onKeyPress="return validator.isNumber(this, event);" placeholder="20" autocorrect="off" autocapitalize="off"> (1 - 2000)
+											</td>
+										</tr>
+										<tr>
+											<th width="30%"><#NetworkTools_PktCap_dur#></th>
+											<td>
+												<input type="text" id="pc_dur" class="input_6_table" maxlength="2" value="5" onKeyPress="return validator.isNumber(this, event);" placeholder="5" autocorrect="off" autocapitalize="off"> (1 - 15)
+											</td>
+										</tr>
+										<tr>
+											<th width="30%"><#NetworkTools_PktCap_snap#></th>
+											<td>
+												<input type="text" id="pc_snap" class="input_6_table" maxlength="4" value="256" onKeyPress="return validator.isNumber(this, event);" placeholder="256" autocorrect="off" autocapitalize="off"> (64 - 2048)
+											</td>
+										</tr>
+										<tr>
+											<th width="30%"><#NetworkTools_PktCap_filter#></th>
+											<td>
+												<input type="text" id="pc_filter" class="input_32_table" maxlength="128" value="" placeholder="ex: tcp port 443" autocorrect="off" autocapitalize="off">
+											</td>
+										</tr>
+									</table>
+
+									<div class="apply_gen">
+										<span><input class="btn_subusage button_gen" id="pc_btn" onClick="runCapture();" type="button" value="<#NetworkTools_PktCap_btn#>"></span>
+										<img id="pc_load" style="display:none;" src="/images/InternetScan.gif">
+									</div>
+
+									<div style="margin-top:8px">
+										<textarea cols="63" rows="27" wrap="off" readonly="readonly" id="pc_out" style="width:99%;font-family:Courier New, Courier, mono; font-size:11px;background:#475A5F;color:#FFFFFF;"></textarea>
+									</div>
+
+									</div>	<!-- for .container  -->
+									<div class="popup_container popup_element_second"></div>
+
+								</td>
+							</tr>
+						</table>
+					</td>
+				</tr>
+			</table>
+		</td>
+		<td width="10" align="center" valign="top"></td>
+	</tr>
+</table>
+</form>
+
+<div id="footer"></div>
+</body>
+</html>
