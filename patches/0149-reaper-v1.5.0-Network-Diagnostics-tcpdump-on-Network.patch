+#ifdef RTCONFIG_TCPDUMP
+/* Reaper v1.5.0 Packet Capture (Network Tools page). Bounded, admin-authed
+ * tcpdump run via _eval - argv-based (NEVER a shell), alarm()-timeout, packet
+ * count cap, one-shot. Deliberately does NOT reuse the stock SystemCmd path
+ * (its char-whitelist rejects BPF-filter characters and it is unbounded).
+ * Returns decoded text as the response body (the page shows it in a textarea). */
+#define PCAP_OUT "/tmp/reaper_pcap.txt"
+static void
+do_reaper_pcap_cgi(char *url, FILE *stream)
+{
+	char *iface  = get_cgi("iface");
+	char *scount = get_cgi("count");
+	char *sdur   = get_cgi("dur");
+	char *ssnap  = get_cgi("snap");
+	char *filter = get_cgi("filter");
+	char cbuf[8], nbuf[8];
+	static char fbuf[160];
+	int count, dur, snap, ac = 0;
+	char *argv[24];
+	FILE *f;
+	char line[1024];
+	size_t total = 0;
+
+	/* interface must be a REAL interface - blocks arbitrary/injected strings */
+	if (!iface || !*iface || strlen(iface) > 16 || if_nametoindex(iface) == 0) {
+		websWrite(stream, "error: invalid interface");
+		return;
+	}
+	count = scount ? atoi(scount) : 0; if (count < 1) count = 20;  if (count > 2000) count = 2000;
+	dur   = sdur   ? atoi(sdur)   : 0; if (dur < 1)   dur = 5;     if (dur > 15)   dur = 15;
+	snap  = ssnap  ? atoi(ssnap)  : 0; if (snap < 64) snap = 256;  if (snap > 2048) snap = 2048;
+	snprintf(cbuf, sizeof(cbuf), "%d", count);
+	snprintf(nbuf, sizeof(nbuf), "%d", snap);
+
+	argv[ac++] = "/usr/sbin/tcpdump";
+	argv[ac++] = "-i";    argv[ac++] = iface;
+	argv[ac++] = "-c";    argv[ac++] = cbuf;
+	argv[ac++] = "-s";    argv[ac++] = nbuf;
+	argv[ac++] = "-n";
+	argv[ac++] = "-tttt";
+	/* optional BPF filter: strict char allow-list, then split into argv tokens
+	 * (each token a separate argv element - no shell, no injection surface) */
+	if (filter && *filter) {
+		int ok = 1; size_t k, fn = strlen(filter);
+		if (fn > 128) ok = 0;
+		for (k = 0; ok && k < fn; k++) {
+			char c = filter[k];
+			if (!(isalnum((unsigned char)c) || c==' ' || c=='.' || c==':' ||
+			      c=='/' || c=='(' || c==')' || c=='-' || c=='_'))
+				ok = 0;
+		}
+		if (!ok) {
+			websWrite(stream, "error: invalid filter (allowed: letters digits space . : / ( ) - _)");
+			return;
+		}
+		snprintf(fbuf, sizeof(fbuf), "%s", filter);
+		{
+			char *p = fbuf, *tok;
+			while ((tok = strsep(&p, " ")) != NULL && ac < 22)
+				if (*tok) argv[ac++] = tok;
+		}
+	}
+	argv[ac] = NULL;
+
+	unlink(PCAP_OUT);
+	_eval(argv, ">" PCAP_OUT, dur, NULL);	/* bounded: -c count AND alarm(dur) */
+
+	f = fopen(PCAP_OUT, "r");
+	if (!f) { websWrite(stream, "(no output - interface idle or capture failed)"); return; }
+	while (fgets(line, sizeof(line), f) && total < 64 * 1024) {
+		websWrite(stream, "%s", line);
+		total += strlen(line);
+	}
+	fclose(f);
+	unlink(PCAP_OUT);
+	if (total == 0)
+		websWrite(stream, "(no packets matched in %d s on %s)", dur, iface);
+}
+#endif	/* RTCONFIG_TCPDUMP */
