+/* IPv6 counterpart of diag_target_allowed_v4 (F3): refuse loopback (::1),
+ * link/site-local, ULA (fc00::/7), unspecified and multicast; apply the v4
+ * policy to a v4-mapped address; allow global unicast. */
+static int diag_target_allowed_v6(const struct in6_addr *a)
+{
+	const unsigned char *b = a->s6_addr;
+	if (IN6_IS_ADDR_LOOPBACK(a) || IN6_IS_ADDR_UNSPECIFIED(a)) return 0;
+	if (IN6_IS_ADDR_LINKLOCAL(a) || IN6_IS_ADDR_SITELOCAL(a)) return 0;
+	if (IN6_IS_ADDR_MULTICAST(a)) return 0;
+	if ((b[0] & 0xFE) == 0xFC) return 0;			/* fc00::/7 ULA */
+	if (IN6_IS_ADDR_V4MAPPED(a)) {
+		struct in_addr v4;
+		memcpy(&v4, b + 12, 4);
+		return diag_target_allowed_v4(v4);
+	}
+	return 1;						/* global unicast */
+}
