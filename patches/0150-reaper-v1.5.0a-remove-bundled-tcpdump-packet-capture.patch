 /* ---------- JSON output ---------- */
+/* F11: minimal JSON string escaper (sources are already constrained charsets -
+ * bridge names, hex MACs, dotted IPs - so this is defense-in-depth). */
+static const char *jesc(const char *s, char *dst, size_t dn)
+{
+	size_t j = 0;
+	if (!s) s = "";
+	for (; *s && j + 7 < dn; s++) {
+		unsigned char c = (unsigned char)*s;
+		if (c == '"' || c == '\\') { dst[j++] = '\\'; dst[j++] = (char)c; }
+		else if (c < 0x20) { j += snprintf(dst + j, dn - j, "\\u%04x", c); }
+		else dst[j++] = (char)c;
+	}
+	dst[j] = 0;
+	return dst;
+}
