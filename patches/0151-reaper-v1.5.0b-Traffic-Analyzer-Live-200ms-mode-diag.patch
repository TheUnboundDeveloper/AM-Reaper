 		g_https ? "https" : "http", g_lan_ip, g_port, (long)((g_expiry - time(NULL)) / 60));
 
 	while (!g_stop) {
diff --git a/release/src/router/rtrafd/rtrafd.c b/release/src/router/rtrafd/rtrafd.c
index 3131b21216..91a6c502d7 100644
--- a/release/src/router/rtrafd/rtrafd.c
+++ b/release/src/router/rtrafd/rtrafd.c
@@ -1,7 +1,7 @@
 /*
  * rtrafd - reaper traffic collector (v1, firmware v1.2.10)
  *
- * Samples every POLL seconds:
+ * Samples on a fast base tick (each source at its own sub-cadence):
  *   - /proc/net/dev            WAN + all br* interfaces (per-network)
  *   - /proc/net/nf_conntrack   per-client byte deltas (LAN-attributed) + top talkers
  *   - tmctl getqstats          per-QoS-class tx/drops (only while HW classful runs)
@@ -38,16 +38,18 @@
 #include <shutils.h>
 #include <shared.h>
 
-/* Dual cadence: a fast 1s base tick drives the live view (WAN rate + per-class
- * + live.json write) so the page updates once a second; the expensive flow-cache
- * scan (per-device/per-network/top-talkers) and the ping probe run on slower
- * sub-cadences to keep CPU down. History rings just accumulate finer deltas -
+/* Dual cadence: a fast 200 ms base tick drives the live view (WAN rate +
+ * live.json write) so the page's "Live" refresh mode gets true 200 ms samples;
+ * the heavier sources keep their wall-clock cadences - per-class every 2 s
+ * (tmctl popens), the flow-cache scan (per-device/per-network/top-talkers) and
+ * the ping probe every 5 s. History rings just accumulate finer deltas -
  * still binned into the same 5-min/hour/day/month slots. */
-#define POLL		1	/* base tick / WAN + live.json cadence (s) */
-#define CLASS_EVERY	2	/* poll per-QoS-class every N ticks */
-#define HEAVY_EVERY	5	/* poll flow cache (per-dev/net/top) every N ticks */
-#define PROBE_EVERY	5	/* ping probe every N ticks */
-#define FCACHE_SECS	(HEAVY_EVERY * POLL)	/* flow-cache sample interval (s) */
+#define TICK_MS		200	/* base tick / WAN + live.json cadence (ms) */
+#define TPS		(1000 / TICK_MS)	/* ticks per second */
+#define CLASS_EVERY	(2 * TPS)	/* poll per-QoS-class every 2 s */
+#define HEAVY_EVERY	(5 * TPS)	/* poll flow cache (per-dev/net/top) every 5 s */
+#define PROBE_EVERY	(5 * TPS)	/* ping probe every 5 s */
+#define FCACHE_SECS	(HEAVY_EVERY * TICK_MS / 1000)	/* flow-cache sample interval (s) */
 #define N5		288	/* 5-min slots  (24 h) */
 #define NH		336	/* hour slots   (14 d) */
 #define ND		366	/* day slots    (~1 y) */
@@ -758,8 +760,8 @@ static void write_hist(int which, const char *fn, int step)
 	rename(tmp, path);
 }
 
-/* Published every base tick (1s). WAN + class are true per-interval rates held
- * in the lv_* globals; per-network and per-device rates come from the last
+/* Published every base tick (200 ms). WAN + class are true per-interval rates
+ * held in the lv_* globals; per-network and per-device rates come from the last
  * flow-cache sample (refreshed every FCACHE_SECS). */
 static void write_live(const char *store)
 {
@@ -769,8 +771,8 @@ static void write_live(const char *store)
 	uint64_t cap_gb = strtoull(nvram_safe_get("rtraf_cap_gb"), NULL, 10);
 	int qos_on = (nvram_get_int("qos_enable") == 1 && nvram_get_int("qos_type") == 11);
 	if (!o) return;
-	fprintf(o, "{\"t\":%lld,\"poll\":%d,\"store\":\"%s\",\"qos\":%d",
-		(long long)time(NULL), POLL, store, qos_on);
+	fprintf(o, "{\"t\":%lld,\"poll_ms\":%d,\"store\":\"%s\",\"qos\":%d",
+		(long long)time(NULL), TICK_MS, store, qos_on);
 	fprintf(o, ",\"wan\":{\"rx_bps\":%llu,\"tx_bps\":%llu}",
 		(unsigned long long)lv_wan_rx, (unsigned long long)lv_wan_tx);
 	fprintf(o, ",\"class\":[");
@@ -986,6 +988,9 @@ int main(int argc, char **argv)
 		time_t now = time(NULL);
 		int n5, nh, nd, nm;
 		uint64_t wrx0, wtx0;
+		struct timespec t0;
+
+		clock_gettime(CLOCK_MONOTONIC, &t0);
 
 		/* history boundary - fires every 5 min regardless of tick rate */
 		slots_for(now, &n5, &nh, &nd, &nm);
@@ -1002,11 +1007,12 @@ int main(int argc, char **argv)
 			i5cur = n5; ihcur = nh; idcur = nd; imcur = nm;
 		}
 
-		/* WAN: every tick (the lively graph). Rate = this-tick delta / POLL. */
+		/* WAN: every tick (the lively graph). Rate = this-tick delta scaled
+		 * to bits/sec. */
 		wrx0 = r_wan->b5[i5cur].rx; wtx0 = r_wan->b5[i5cur].tx;
 		poll_ifaces(wanif);
-		lv_wan_rx = (r_wan->b5[i5cur].rx - wrx0) * 8 / POLL;
-		lv_wan_tx = (r_wan->b5[i5cur].tx - wtx0) * 8 / POLL;
+		lv_wan_rx = (r_wan->b5[i5cur].rx - wrx0) * 8 * TPS;
+		lv_wan_tx = (r_wan->b5[i5cur].tx - wtx0) * 8 * TPS;
 
 		/* per-class: every CLASS_EVERY ticks (tmctl is heavier than a proc read) */
 		if (tick % CLASS_EVERY == 0) {
@@ -1014,7 +1020,7 @@ int main(int argc, char **argv)
 			for (i = 0; i <= 6; i++) { c_tx0[i] = r_cls[i]->b5[i5cur].rx; c_dp0[i] = r_cls[i]->b5[i5cur].tx; }
 			poll_classes(wanif);
 			for (i = 0; i <= 6; i++) {
-				lv_cls_tx[i] = (r_cls[i]->b5[i5cur].rx - c_tx0[i]) * 8 / (CLASS_EVERY * POLL);
+				lv_cls_tx[i] = (r_cls[i]->b5[i5cur].rx - c_tx0[i]) * 8 * TPS / CLASS_EVERY;
 				lv_cls_dp[i] = r_cls[i]->b5[i5cur].tx - c_dp0[i];
 			}
 		}
@@ -1024,7 +1030,8 @@ int main(int argc, char **argv)
 			poll_fcache();
 		if (tick % PROBE_EVERY == 0)
 			poll_probe();
-		check_quota();
+		if (tick % TPS == 0)
+			check_quota();	/* monthly cap: once a second is plenty */
 
 		write_live(store);
 
@@ -1035,7 +1042,20 @@ int main(int argc, char **argv)
 		}
 
 		tick++;
-		for (i = 0; i < POLL && running; i++) sleep(1);
+		{
+			/* pace off measured work time so a heavy tick (tmctl popens,
+			 * fcache scan) doesn't stretch the sample interval; if the
+			 * work overran the tick, yield briefly instead of bursting */
+			struct timespec t1, ts;
+			long nap_ms;
+			clock_gettime(CLOCK_MONOTONIC, &t1);
+			nap_ms = TICK_MS - ((long)(t1.tv_sec - t0.tv_sec) * 1000 +
+					    (t1.tv_nsec - t0.tv_nsec) / 1000000);
+			if (nap_ms < 1) nap_ms = 1;
+			ts.tv_sec = nap_ms / 1000;
+			ts.tv_nsec = (nap_ms % 1000) * 1000000L;
+			nanosleep(&ts, NULL);	/* SIGTERM interrupts; loop re-checks running */
+		}
 	}
 	}
 
