+			sb_puts(&r, "\"instructions\":\"Reaper router advisor. Settings are "
+				"read-only: it cannot change any setting - recommend changes for the "
+				"human to apply. Secrets are never exposed. Network diagnostics ARE "
+				"ENABLED for this session: run net_ping, net_traceroute, net_dns_lookup "
+				"and net_netstat yourself to isolate faults (router vs LAN vs ISP vs "
+				"destination) rather than asking the human to run them. The probes send "
+				"packets but change nothing on the router.\"}");
+		else
+			sb_puts(&r, "\"instructions\":\"Read-only Reaper router advisor. It cannot "
+				"change any setting - recommend changes for the human to apply. Secrets "
+				"are never exposed. This session has NO active diagnostics: if network "
+				"probes (ping/traceroute/dns/netstat) would help, ask the human to re-arm "
+				"the Advisor with 'Allow network diagnostics' checked.\"}");
 		send_rpc_result_raw(fp, jid, r.p ? r.p : "{}");
 		sb_free(&r);
 	} else if (!strcmp(method, "ping")) {
@@ -1043,7 +1057,8 @@ int main(int argc, char **argv)
 	g_added_rule = 1;
