 static const char *TOOLS_DIAG =
-",{\"name\":\"net_ping\",\"description\":\"Ping a public host or a LAN host (4 packets, bounded). Isolates reachability/latency at the router vs the path. Read-only probe.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"host\":{\"type\":\"string\"}},\"required\":[\"host\"]}},"
-"{\"name\":\"net_traceroute\",\"description\":\"Traceroute to a host (bounded hops). Shows where in the path (router / ISP / WAN) latency or loss appears. Read-only probe.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"host\":{\"type\":\"string\"}},\"required\":[\"host\"]}},"
-"{\"name\":\"net_dns_lookup\",\"description\":\"Resolve a name via the router's DNS. Distinguishes DNS problems from connectivity problems. Read-only.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"host\":{\"type\":\"string\"}},\"required\":[\"host\"]}},"
+",{\"name\":\"net_ping\",\"description\":\"Run a ping from the router to a public or LAN host (4 packets, bounded). Isolates reachability/latency at the router vs the path. Active probe; changes no settings.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"host\":{\"type\":\"string\"}},\"required\":[\"host\"]}},"
+"{\"name\":\"net_traceroute\",\"description\":\"Run a traceroute from the router (bounded hops). Shows where in the path (router / ISP / WAN) latency or loss appears. Active probe; changes no settings.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"host\":{\"type\":\"string\"}},\"required\":[\"host\"]}},"
+"{\"name\":\"net_dns_lookup\",\"description\":\"Resolve a name via the router's DNS. Distinguishes DNS problems from connectivity problems. Changes no settings.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"host\":{\"type\":\"string\"}},\"required\":[\"host\"]}},"
 "{\"name\":\"net_netstat\",\"description\":\"Active TCP/UDP sockets on the router (numeric).\",\"inputSchema\":{\"type\":\"object\",\"properties\":{}}}";
 
 /* ------------------------------------------------------------------ */
@@ -833,11 +833,25 @@ static void handle_rpc(FILE *fp, const char *body)
 		sbuf_t r; sb_init(&r);
 		sb_puts(&r, "{\"protocolVersion\":\"" PROTO_VER "\","
 			"\"capabilities\":{\"tools\":{}},"
-			"\"serverInfo\":{\"name\":\"reaper-advisor\",\"version\":\"1.0\"},"
-			"\"instructions\":\"Read-only Reaper router advisor. It cannot change any "
-			"setting - recommend changes for the human to apply. Secrets are never exposed. "
-			"When the human enables diagnostics for this session, additional bounded, read-only "
-			"network probes (ping/traceroute/dns/netstat) become available for root-cause isolation.\"}");
+			"\"serverInfo\":{\"name\":\"reaper-advisor\",\"version\":\"1.0\"},");
+		/* the model takes this text at face value: when the session granted
+		 * diagnostics (g_diag), say so affirmatively - a static "read-only"
+		 * blurb makes it call itself read-only and hand probes back to the
+		 * human even though tools/list offers them */
