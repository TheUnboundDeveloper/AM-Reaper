From 629cc618d5442a36d059309b3391b8b2933ec285 Mon Sep 17 00:00:00 2001
From: reaper <theunbounddeveloper@outlook.com>
Date: Mon, 13 Jul 2026 14:56:08 -0400
Subject: [PATCH] reaper v1.5.0d: de-ASUS rebrand - REAPER1 banner, RLogo
 AiMesh, rail clock

- Replace the REAPER.png logo with the REAPER1.png wordmark banner everywhere it
  is used: shell + dashboard topbar brand, the login/logout banner (Main_Login,
  shared by Logout.asp), and the stock-page top banner (state.js). Drop "ASUS"
  from the dashboard brand alt text.
- AiMesh node backdrop: swap ASUSLogo.png -> RLogo.png and remove the now-unused
  ASUSLogo.png asset.
- Replace the "ASUS . Merlin . Reaper" rail wordmark (shell + dashboard) with a
  live, themed router-time clock (24-hour, offset-proof: parses <% uptime(); %>
  at render then ticks locally). Falls back to a placeholder if uptime doesn't
  resolve.

Co-Authored-By: Claude Fable 5 <noreply@anthropic.com>
---
 release/src-rt/version.conf                   |   2 +-
 release/src/router/www/Main_Login.asp         |   2 +-
 release/src/router/www/Main_ReaperDash.asp    |  14 +++++++++-----
 release/src/router/www/images/ASUSLogo.png    | Bin 2323117 -> 0 bytes
 release/src/router/www/images/REAPER1.png     | Bin 0 -> 661428 bytes
 release/src/router/www/images/RLogo.png       | Bin 0 -> 1764593 bytes
 .../src/router/www/reaper/reaper_content.css  |   2 +-
 release/src/router/www/reaper_shell.asp       |  12 +++++++-----
 release/src/router/www/state.js               |   4 ++--
 9 files changed, 21 insertions(+), 15 deletions(-)
 delete mode 100644 release/src/router/www/images/ASUSLogo.png
 create mode 100755 release/src/router/www/images/REAPER1.png
 create mode 100755 release/src/router/www/images/RLogo.png

diff --git a/release/src-rt/version.conf b/release/src-rt/version.conf
index d47f581bc9..598c6cff42 100644
--- a/release/src-rt/version.conf
+++ b/release/src-rt/version.conf
@@ -4,6 +4,6 @@ KERNEL_VER_AM=$(subst .,,$(KERNEL_VER))
 FS_VER_AM=$(subst .,,$(FS_VER))
 
 SERIALNO=102.8
-EXTENDNO=Reaper_v1.5.0c
+EXTENDNO=Reaper_v1.5.0d
 
 RCNO=0
diff --git a/release/src/router/www/Main_Login.asp b/release/src/router/www/Main_Login.asp
index 104d377913..666ceea343 100644
--- a/release/src/router/www/Main_Login.asp
+++ b/release/src/router/www/Main_Login.asp
@@ -60,7 +60,7 @@ form[name="form"]{margin:auto}
 /* header: REAPER wordmark over the sign-in title */
 .title_name{display:flex;flex-direction:column;align-items:center;gap:14px}
 .img_gap{padding:0}
-.login_img{width:400px;max-width:100%;height:42px;background:url('images/REAPER.png') center/contain no-repeat}
+.login_img{width:400px;max-width:100%;height:42px;background:url('images/REAPER1.png') center/contain no-repeat}
 .signin_hint{font-family:var(--hdr);font-weight:600;font-size:19px;letter-spacing:.24em;
   text-transform:uppercase;color:var(--bone);padding-left:.24em}
 .prod_madelName{margin:8px 0 0;text-align:center;font-family:var(--hdr);font-weight:600;
diff --git a/release/src/router/www/Main_ReaperDash.asp b/release/src/router/www/Main_ReaperDash.asp
index 121725dd29..c0df0b0a51 100644
--- a/release/src/router/www/Main_ReaperDash.asp
+++ b/release/src/router/www/Main_ReaperDash.asp
@@ -58,8 +58,10 @@ html{scrollbar-width:thin;scrollbar-color:var(--crimson) #000}
 .app{display:grid;grid-template-columns:236px 1fr;min-height:100vh}
 .rail{background:linear-gradient(180deg,#0c0c0f,#08080a);border-right:1px solid var(--line-soft);
   display:flex;flex-direction:column;padding:14px 12px 56px;gap:2px}
-.wordmark{font-family:var(--hdr);font-weight:700;font-size:18px;letter-spacing:.01em;line-height:1.15;padding:4px 6px 12px;text-align:center;white-space:nowrap}
-.wordmark .a{color:var(--bone)} .wordmark .m{color:var(--bone-dim)} .wordmark .r{color:var(--crimson)} .wordmark .d{color:var(--crimson)}
+.railclock{padding:6px 6px 14px;text-align:center;line-height:1.05}
+.railclock .rc-time{font-family:var(--hdr);font-weight:700;font-size:23px;letter-spacing:.07em;color:var(--bone);font-variant-numeric:tabular-nums}
+.railclock .rc-sec{color:var(--crimson)}
+.railclock .rc-date{font-family:var(--hdr);font-weight:600;font-size:10.5px;letter-spacing:.16em;text-transform:uppercase;color:var(--steel);margin-top:4px}
 .railsearch{margin:2px 4px 8px}
 .railsearch input{width:100%;background:#000;border:1px solid var(--line-soft);border-radius:8px;color:var(--bone);
   padding:9px 11px;font-family:var(--body);font-size:12px;outline:none}
@@ -239,7 +241,8 @@ html{scrollbar-width:thin;scrollbar-color:var(--crimson) #000}
   .pills{flex-wrap:wrap;overflow:visible}
   .rail{position:sticky;top:0;height:auto;width:100%;flex-direction:row;align-items:center;
     justify-content:flex-start;gap:4px;padding:8px 10px;overflow-x:auto;border-right:0;border-bottom:1px solid var(--line-soft)}
-  .wordmark{padding:0 10px 0 0;font-size:17px;white-space:nowrap;text-align:left}
+  .railclock{padding:0 10px 0 0;text-align:left}
+  .railclock .rc-time{font-size:16px} .railclock .rc-date{display:none}
   .railsearch,.grp{display:none}
   .nav{flex-direction:row;width:auto}
   .nav a .nl{display:none}
@@ -281,7 +284,8 @@ html{scrollbar-width:thin;scrollbar-color:var(--crimson) #000}
 
   <!-- LEFT RAIL (always expanded; menu mirrors the current firmware) -->
   <aside class="rail">
-    <div class="wordmark"><span class="a">ASUS</span> <span class="d">&middot;</span> <span class="m">Merlin</span> <span class="d">&middot;</span> <span class="r">Reaper</span></div>
+    <div class="railclock"><div class="rc-time" id="rc_time">--:--:--</div><div class="rc-date" id="rc_date">&mdash;</div></div>
+    <script>(function(){var us="<% uptime(); %>";var nf=us.substring(8,11)+" "+us.substring(5,7)+" "+us.substring(17,25)+" "+us.substring(12,16);var b=Date.parse(nf);var et=document.getElementById('rc_time'),ed=document.getElementById('rc_date');if(!et||isNaN(b))return;var t0=Date.now();var DW=['Sun','Mon','Tue','Wed','Thu','Fri','Sat'],MO=['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];function p2(n){return(n<10?'0':'')+n;}function tk(){var d=new Date(b+(Date.now()-t0));et.innerHTML=p2(d.getHours())+':'+p2(d.getMinutes())+':<span class="rc-sec">'+p2(d.getSeconds())+'</span>';if(ed)ed.textContent=DW[d.getDay()]+' '+d.getDate()+' '+MO[d.getMonth()]+' '+d.getFullYear();}tk();setInterval(tk,1000);})();</script>
     <div class="raillang"><span class="raillbl"><#Reaper_c_language#>:</span><select class="raillangsel" id="select_lang" title="<#Reaper_c_language#>" aria-label="<#Reaper_c_language#>"></select></div>
 
     <div class="grp"><#menu5_1_1#></div>
@@ -314,7 +318,7 @@ html{scrollbar-width:thin;scrollbar-color:var(--crimson) #000}
   <!-- MAIN -->
   <main>
     <header class="top">
-      <a class="brand" href="#" title="REAPER &mdash; RT-BE96U"><img src="/images/REAPER.png" alt="ASUS RT-BE96U REAPER"></a>
+      <a class="brand" href="#" title="REAPER &mdash; RT-BE96U"><img src="/images/REAPER1.png" alt="REAPER RT-BE96U"></a>
       <div class="pills">
         <div class="pill"><span class="dot" id="p_wan_dot"></span><span class="k"><#menu5_3#></span><span class="v" id="p_wan">&mdash;</span></div>
         <div class="pill"><span class="k"><#DSL_Mode#></span><span class="v" id="i_opmode">&mdash;</span></div>
