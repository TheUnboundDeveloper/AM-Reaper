-		while ((*s == ' ') || (*s == '\n') || (*s == '\t')) ++s;
-		if (*s == 0) break;
-		while ((*s != 0) && (*s != ' ') && (*s != '\n') && (*s != '\t')) {
-			*e++ = *s++;
-		}
