-	.name		= "tos",
-	.version	= XTABLES_VERSION,
-	.size		= XT_ALIGN(sizeof(struct ipt_tos_info)),
-	.userspacesize	= XT_ALIGN(sizeof(struct ipt_tos_info)),
-	.help		= &help,
