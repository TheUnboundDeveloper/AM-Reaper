-/* ---------------------------------------------------------------------- */
-static void
-free_nlmsglist (struct nlmsg_list *nlm0)
-{
-  struct nlmsg_list *nlm, *nlm_next;
-  int saved_errno;
-  if (!nlm0)
-    return;
