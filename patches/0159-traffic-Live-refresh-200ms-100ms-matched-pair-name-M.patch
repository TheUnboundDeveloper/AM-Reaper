+/* ---- client identity (v1.5.3): names from networkmap - same source as the
+   dashboard - keyed by lowercase MAC, plus an IP->MAC map for rows where the
+   collector only knew the IP. Fetched once at load; rows fall back to raw
+   ip/mac until (or unless) it answers. ---- */
+var CLNAME={}, IP2MAC={};
+function fetchClNames(){
+  var x=new XMLHttpRequest();
+  x.open('GET','/appGet.cgi?hook=get_clientlist()&_='+Date.now(),true);
+  x.onreadystatechange=function(){
+    if(x.readyState!==4||x.status!==200) return;
+    try{
+      var j=JSON.parse(x.responseText), cl=j.get_clientlist||j, ml=cl.maclist||[];
+      for(var i=0;i<ml.length;i++){ var mac=String(ml[i]), c=cl[mac]; if(!c) continue;
+        var nm=(c.nickName&&String(c.nickName).length)?String(c.nickName):((c.name&&String(c.name).length)?String(c.name):'');
+        var lm=mac.toLowerCase(); if(nm) CLNAME[lm]=nm; if(c.ip) IP2MAC[c.ip]=lm; }
+    }catch(e){}
+  };
+  x.send();
+}
+/* one-cell identity block: name on top when known, "ip - mac" subline.
+   mac may be an IP (collector key fallback) - only shown when it has ':'. */
+function devCell(ip, mac){
+  var m=String(mac||IP2MAC[ip]||'').toLowerCase(); if(m.indexOf(':')<0) m='';
+  var nm=CLNAME[m]||'';
+  var head=nm||ip||m.toUpperCase();
+  var bits=[];
+  if(nm&&ip) bits.push(esc(ip));
+  if(m&&String(head).toLowerCase()!==m) bits.push(esc(m.toUpperCase()));
+  return '<span class="tname">'+esc(head)+'</span>'+(bits.length?'<div class="tsub">'+bits.join(' &middot; ')+'</div>':'');
+}
