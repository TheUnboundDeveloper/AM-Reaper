-/* Dual cadence: a fast 200 ms base tick drives the live view (WAN rate +
- * live.json write) so the page's "Live" refresh mode gets true 200 ms samples;
- * the heavier sources keep their wall-clock cadences - per-class every 2 s
- * (tmctl popens), the flow-cache scan (per-device/per-network/top-talkers) and
- * the ping probe every 5 s. History rings just accumulate finer deltas -
- * still binned into the same 5-min/hour/day/month slots. */
-#define TICK_MS		200	/* base tick / WAN + live.json cadence (ms) */
+/* Dual cadence: a fast 100 ms base tick drives the live view (WAN rate +
+ * live.json write) so the page's "Live" refresh mode gets true 100 ms samples
+ * (v1.5.3, owner ask - was 200 ms; the page poll and this tick are a matched
+ * pair, change them together). The heavier sources keep their wall-clock
+ * cadences - per-class every 2 s (tmctl popens), the flow-cache scan
+ * (per-device/per-network/top-talkers) and the ping probe every 5 s. History
+ * rings just accumulate finer deltas - still binned into the same
+ * 5-min/hour/day/month slots. */
+#define TICK_MS		100	/* base tick / WAN + live.json cadence (ms) */
 #define TPS		(1000 / TICK_MS)	/* ticks per second */
 #define CLASS_EVERY	(2 * TPS)	/* poll per-QoS-class every 2 s */
 #define HEAVY_EVERY	(5 * TPS)	/* poll flow cache (per-dev/net/top) every 5 s */
