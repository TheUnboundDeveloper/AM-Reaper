 		first = 0;
 	}
 	fprintf(o, "]");
@@ -814,11 +819,17 @@ static void write_live(const char *store)
 			(unsigned long long)live_rtt, (unsigned long long)live_loss);
 	}
 	fprintf(o, ",\"top\":[");
-	for (i = 0; i < ntop; i++)
-		fprintf(o, "%s{\"src\":\"%s\",\"dst\":\"%s\",\"dport\":%d,\"proto\":%d,\"rate\":%llu,\"up\":%llu,\"dn\":%llu}",
-			i ? "," : "", jesc(top[i].src, eb, sizeof(eb)), jesc(top[i].dst, eb2, sizeof(eb2)), top[i].dport, top[i].proto,
+	for (i = 0; i < ntop; i++) {
+		/* LAN-side MAC from the per-poll ARP cache so the page can name the
+		 * talker; remote dst never resolves and stays IP-only */
+		char smac[24], eb3[80];
+		if (!arp_mac(top[i].src, smac, sizeof(smac)))
+			smac[0] = '\0';
+		fprintf(o, "%s{\"src\":\"%s\",\"smac\":\"%s\",\"dst\":\"%s\",\"dport\":%d,\"proto\":%d,\"rate\":%llu,\"up\":%llu,\"dn\":%llu}",
+			i ? "," : "", jesc(top[i].src, eb, sizeof(eb)), jesc(smac, eb3, sizeof(eb3)), jesc(top[i].dst, eb2, sizeof(eb2)), top[i].dport, top[i].proto,
 			(unsigned long long)top[i].rate, (unsigned long long)top[i].up,
 			(unsigned long long)top[i].dn);
+	}
 	fprintf(o, "]}");
 	fclose(o);
 	rename("/tmp/rtraf/.live.json", "/tmp/rtraf/live.json");
