-		fprintf(o, "%s{\"ip\":\"%s\",\"dn\":%llu,\"up\":%llu}", first ? "" : ",",
-			jesc(cli[i].ip, eb, sizeof(eb)), (unsigned long long)lv_cli_rx[i], (unsigned long long)lv_cli_tx[i]);
+		/* key is the client MAC when the flow carried one (IP fallback
+		 * otherwise) - the page shows it only when it looks like a MAC */
+		fprintf(o, "%s{\"ip\":\"%s\",\"mac\":\"%s\",\"dn\":%llu,\"up\":%llu}", first ? "" : ",",
+			jesc(cli[i].ip, eb, sizeof(eb)), jesc(cli[i].key, eb2, sizeof(eb2)),
