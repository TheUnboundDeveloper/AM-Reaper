diff --git a/release/src/router/rc/qos.c b/release/src/router/rc/qos.c
index 393f8eeb9c..eb93cceb63 100644
--- a/release/src/router/rc/qos.c
+++ b/release/src/router/rc/qos.c
@@ -954,10 +954,15 @@ static int add_qos_rules(char *pcWANIF)
 	 * engine only, "0" kills). The Broadcom driver picks the WMM access
 	 * category on AP egress from the DSCP precedence bits, so stamping
 	 * LAN-bound packets of classified connections lifts Q1 to AC_VO (CS6) and
-	 * Q2 to AC_VI (CS5) and drops Q5 bulk to AC_BK (CS1) on every wireless
-	 * client - the classful model then steers BOTH directions. Q3/Q4 stay
-	 * unstamped: precedence 3/4 would also land in AC_VI/AC_BE and dilute the
-	 * Q2 lift. connmark reads conntrack directly, so this needs no
+	 * Q2 to AC_VI (CS5) on every wireless
+	 * client - the classful model then steers BOTH directions. LIFT-ONLY
+	 * (v1.5.4): Q3/Q4/Q5 stay unstamped at AC_BE. The original v1.5.3 map also
+	 * demoted Q5 to CS1/AC_BK - but Q5 in the shipped class template IS the
+	 * catch-all default class, so that demotion put nearly ALL wifi-bound
+	 * traffic (including upload ACK streams) into the starved background AC:
+	 * metal showed 433/265 Mb/s with 1.5%% loss and 77ms jitter on a healthy
+	 * 6GHz/320MHz client. NEVER stamp the default class down. connmark reads
+	 * conntrack directly, so this needs no
 	 * restore-mark ordering; the stamp happens before HW offload freezes the
 	 * flow and is replayed by the blogged header mods thereafter. Same
 	 * connection-start freeze semantics as every type-11 rule: classify on
@@ -966,7 +971,6 @@ static int add_qos_rules(char *pcWANIF)
 		static const struct { int cls; const char *dscp; } wmm_map[] = {
 			{ 1, "CS6" },	/* Q1 highest -> AC_VO */
 			{ 2, "CS5" },	/* Q2         -> AC_VI */
-			{ 5, "CS1" },	/* Q5 bulk    -> AC_BK */
 		};
 		int wi;
 		for (wi = 0; wi < (int)(sizeof(wmm_map)/sizeof(wmm_map[0])); wi++) {
@@ -3246,21 +3250,28 @@ int start_hwqos_classful(void)
 	 * the egress shapers; backed by an rdpa policer object, so the flow
 	 * accelerator stays on). A policer has no queue: excess is dropped early and
 	 * TCP/QUIC back off before the ISP's upstream buffer ever fills - which is
-	 * why qos_ibw must be ~90%% of MEASURED downlink, not line rate. Unlike the
-	 * XRDP egress shapers, burstsize IS honored here: sized to ~10ms of the
-	 * configured rate (kbps * 1.25 = bytes per 10ms), floored at 64KB so low
-	 * rates keep a workable token bucket, capped at 8MB. qos_ipolicer="0" kills. */
+	 * why qos_ibw must be ~90%% of MEASURED downlink, NOT line rate: at 100%% the
+	 * token bucket never refills and multi-stream TCP collapses in synchronized
+	 * backoff (metal-observed 2026-07-15: rate=line gave ~1/6 throughput and
+	 * aborted transfers at ANY bucket size; 90%% held full rated speed with
+	 * LOWER ping). Burst = ~100ms of the configured rate (kbps * 12.5 = bytes
+	 * per 100ms; 10ms also collapsed on metal - the bucket must ride out
+	 * slow-start overshoot), floored at 64KB for low rates, capped at 100MB
+	 * (rdpa_policer.h CBS legal range is 1K-100M). qos_ipolicer="0" kills. */
 	ibw = strtoul(nvram_safe_get("qos_ibw"), NULL, 10);
 	if (ibw > 0 && !nvram_match("qos_ipolicer", "0")) {
-		burst = ibw + ibw / 4;
+		burst = ibw * 12 + ibw / 2;
 		if (burst < 65536) burst = 65536;
-		if (burst > 8388608) burst = 8388608;
+		if (burst > 100000000) burst = 100000000;
 		fprintf(f, "\ttmctl setportrxrate --devtype 0 --if $WANIF --shapingrate %u --burstsize %u\n", ibw, burst);
 	}
 
 	fprintf(f, "\t;;\nstop)\n");
 	fprintf(f, "\ttmctl setportshaper --devtype 0 --if $WANIF --shapingrate 0\n");
-	fprintf(f, "\ttmctl setportrxrate --devtype 0 --if $WANIF --shapingrate 0 --burstsize 0\n");
+	/* readback guard: clearing a policer that was never set logs a one-time
+	 * kernel ERR (_drv_policer_clear_profile, metal-observed on first apply
+	 * after boot) - skip the clear when the readback already shows (0, 0, 0) */
+	fprintf(f, "\ttmctl getportrxrate --devtype 0 --if $WANIF 2>/dev/null | grep -q '(0, 0, 0)' || tmctl setportrxrate --devtype 0 --if $WANIF --shapingrate 0 --burstsize 0\n");
 	/* v4: restore strict priority on any queue this script reconfigured
 	 * (setqcfg first, mirroring the start ordering; weight 1 is the lowest
 	 * legal value and is ignored in SP mode - the tool rejects weight 0) */
diff --git a/release/src/router/www/BR.dict b/release/src/router/www/BR.dict
index 41972ad491..1d0fab4822 100644
--- a/release/src/router/www/BR.dict
+++ b/release/src/router/www/BR.dict
@@ -5585,9 +5585,9 @@ RQOS_113=Pick a device or enter a MAC address (AA:BB:CC:DD:EE:FF).
 RQOS_114=Download and upload must each be at least 0.1 Mb/s.
 RQOS_115=You can limit up to 32 devices.
 RQOS_116=Download cap (ingress policer)
-RQOS_117=Polices WAN ingress at the download figure above, so heavy downloads back off before the ISP buffer fills &mdash; download bufferbloat control with hardware acceleration still on. A policer has no queue: a small share of packets is dropped early to signal senders, which is why the figure must be ~90% of what a speed test <i>measures</i>.
+RQOS_117=Polices WAN ingress at the download figure above, so heavy downloads back off before the ISP buffer fills &mdash; download bufferbloat control with hardware acceleration still on. <b>The figure must be ~90% of what a speed test measures, never 100%:</b> at line rate the token bucket never refills and download throughput collapses (metal-verified). At 90% the cap holds full rated speed with lower ping. Burst sizing is automatic.
 RQOS_118=Wi-Fi downstream priority (WMM)
-RQOS_119=Stamps DiffServ onto LAN-bound traffic by class &mdash; Q1 to CS6 (voice airtime), Q2 to CS5 (video airtime), bulk Q5 to CS1 (background) &mdash; so Wi-Fi serves the same priorities on the download side. Wired clients are unaffected; a connection keeps the class it started with.
+RQOS_119=Stamps DiffServ onto LAN-bound traffic for the top classes &mdash; Q1 to CS6 (voice airtime), Q2 to CS5 (video airtime) &mdash; so Wi-Fi serves your priorities on the download side too. Lift-only: nothing is ever demoted below normal best-effort. Wired clients are unaffected; a connection keeps the class it started with.
 RQOS_120=How does the download side work?
 RQOS_121=<p>Upload is shaped in hardware with per-class queues. Download has no hardware queue set on this silicon, so two mechanisms cover it: the <b>ingress policer</b> caps aggregate download before the ISP buffer can fill, and <b>WMM stamping</b> lets Wi-Fi transmit high classes first. Per-device download caps live in the Bandwidth Limiter; full download AQM needs Cake (which disables acceleration).</p>
 RQOS_122=No download figure is set, so the download cap will not engage. Apply anyway?
