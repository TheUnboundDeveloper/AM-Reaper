+/* ---- live Internet status poll (status must self-update during boot) ----
+   The hero Internet state above is rendered once from the server-injected
+   wan0_state_t. During a boot the WAN usually comes up AFTER the page loads, so a
+   one-shot render leaves a stale "Disconnected". Re-check live and update both the
+   Internet card and the header WAN pill; poll fast while down, slow once up. */
+(function(){
+  var FAST=4000, SLOW=30000;
+  function v6Up(){ var a=String((WAN6&&WAN6.IPv6_Address)||'').split('/')[0]; return !!(WAN6&&WAN6.status==='1'&&a); }
+  function apply(st, ip){
+    var v4=(st==='2') && !!ip && ip!=='0.0.0.0';
+    var any=v4 || v6Up();
+    setTxt('i_state', any?'<#Connected#>':'<#Disconnected#>');
+    var istate=$id('i_state'); if(istate) istate.style.color = any?'var(--jade)':'var(--danger)';
+    var p=$id('p_wan'); if(p) p.textContent = any?'<#Connected#>':'<#Disconnected#>';
+    [$id('i_dot'),$id('p_wan_dot')].forEach(function(d){ if(!d) return;
+      if(any){ d.style.background='var(--jade)'; d.style.boxShadow=''; }
+      else { d.style.background='var(--danger)'; d.style.boxShadow='none'; } });
+    var c4=$id('chip4'); if(c4){ c4.className='chip '+(v4?'up':'off'); c4.textContent=v4?'IPv4':'<#RDSH_28#>'; }
+    if(v4) setTxt('i_wanip', ip);
+    return any;
+  }
+  function tick(){
+    var x=new XMLHttpRequest();
+    x.open('GET','/appGet.cgi?hook=nvram_get(wan0_state_t)%3bnvram_get(wan0_ipaddr)&_='+(new Date()).getTime(),true);
+    x.onreadystatechange=function(){
+      if(x.readyState!==4||x.status!==200) return;
+      var st='',ip=''; try{ var j=JSON.parse(x.responseText); st=j.wan0_state_t||''; ip=j.wan0_ipaddr||''; }catch(e){ return; }
+      var up=apply(st,ip);
+      setTimeout(tick, up?SLOW:FAST);
+    };
+    x.send();
+  }
+  setTimeout(tick, FAST);
+})();
+
 /* ---- live CPU / RAM via /cpu_ram_status.asp ---- */
 function setDial(id,pct,unit){
   var d=$id(id); if(!d) return;
