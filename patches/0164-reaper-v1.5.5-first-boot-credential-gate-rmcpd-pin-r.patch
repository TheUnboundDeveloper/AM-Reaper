+<body>
+<div class="card">
+  <div class="brand"><div class="mark">R<b>3</b>APER</div></div>
+  <div class="eyebrow">First-time setup</div>
+  <div class="steps"><span class="on"></span><span id="step2bar"></span></div>
+
+  <h2>Secure your router</h2>
+  <p class="lead">This router was just reset or set up for the first time. Set an admin
+     username and password now. Next you'll be asked to set your Wi&#8209;Fi password.
+     You can change all of these later in the GUI.</p>
+
+  <form id="fbForm" onsubmit="return false;">
+    <label for="fb_user">Router username</label>
+    <input type="text" id="fb_user" autocomplete="username" spellcheck="false" value="admin" maxlength="32">
+    <div class="hint">Letters, numbers, - and _ . You may keep &ldquo;admin&rdquo; if the password is strong.</div>
+
+    <label for="fb_pw">Router password</label>
+    <input type="password" id="fb_pw" autocomplete="new-password" maxlength="32">
+    <div class="hint">5&ndash;32 characters. Must differ from the username and from the default.</div>
+
+    <label for="fb_pw2">Confirm password</label>
+    <input type="password" id="fb_pw2" autocomplete="new-password" maxlength="32">
+
+    <div class="err" id="fb_err"></div>
+    <button class="btn" id="fb_go" type="submit">Continue &rarr;</button>
+    <div class="spin" id="fb_spin">Applying &amp; restarting the admin service&hellip;</div>
+  </form>
+</div>
+
+<script>
+(function(){
+  "use strict";
+  var DEFAULT_PW = "admin";  /* mirrors defaults.c http_passwd default */
+  function $(id){return document.getElementById(id);}
+  function showErr(m){var e=$("fb_err"); e.textContent=m; e.style.display="block";}
+  function clrErr(){$("fb_err").style.display="none";}
+
+  var reUser = /^[a-zA-Z0-9][a-zA-Z0-9\-\_]{0,31}$/;
+
+  function validate(u,p,p2){
+    if(!reUser.test(u)) return "Username must start alphanumeric and use only letters, numbers, - or _.";
+    if(p.length < 5) return "Password must be at least 5 characters.";
+    if(p.length > 32) return "Password must be 32 characters or fewer.";
+    if(p !== p2) return "The two passwords do not match.";
+    if(p === u) return "Password must not equal the username.";
+    if(p === DEFAULT_PW) return "Password must not be the default value.";
+    return "";
+  }
+
+  function submit(){
+    clrErr();
+    var u=$("fb_user").value.trim(), p=$("fb_pw").value, p2=$("fb_pw2").value;
+    var msg=validate(u,p,p2);
+    if(msg){ showErr(msg); return; }
+
+    $("fb_go").disabled=true; $("fb_spin").style.display="block";
+    /* same call Main_Password.asp uses -- no bespoke apply path */
+    try{
+      httpApi.chpass({
+        "restart_httpd":"0",
+        "new_username":u,
+        "new_passwd":p,
+        "defpass_enable":"0"
+      });
+    }catch(e){
+      showErr("Could not apply credentials. Please try again.");
+      $("fb_go").disabled=false; $("fb_spin").style.display="none";
+      return;
+    }
+    /* Changing the admin password may drop this session. Head to "/"; state.js then
+       forces the Wi-Fi step (Advanced_Wireless_Content.asp) until a PSK is set, or
+       to the login page to re-authenticate with the new password. */
+    setTimeout(function(){ top.location.href = "/"; }, 2600);
+  }
+
+  document.addEventListener("DOMContentLoaded", function(){
+    $("fb_go").addEventListener("click", submit);
+    $("fbForm").addEventListener("submit", function(e){ e.preventDefault(); submit(); });
+    $("fb_pw").addEventListener("keyup", function(e){ if(e.keyCode===13) $("fb_pw2").focus(); });
+    $("fb_pw2").addEventListener("keyup", function(e){ if(e.keyCode===13) submit(); });
+    $("fb_user").focus();
+  });
+})();
+</script>
+</body>
+</html>
