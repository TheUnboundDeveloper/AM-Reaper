+     Part of the Reaper hardened Asuswrt-Merlin build. See LICENSE / LICENSE.reaper.
+
+     First-boot / factory-reset credential gate (CISA AA26-194A hygiene).
+     Reaper-themed page that forces the admin username + password on a factory-clean
+     box. state.js redirects here while the admin password is still default; after the
+     password is set, state.js forces the (proven, stock) wireless page until a WiFi
+     PSK exists. This page therefore only owns the credential step -- it writes NO
+     wifi/nvram apply of its own (chpass is the same call Main_Password.asp uses). -->
+<!DOCTYPE html>
+<html lang="en">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width, initial-scale=1">
+<meta name="reaper-native" content="1">
+<meta http-equiv="Pragma" content="no-cache">
+<meta http-equiv="Expires" content="-1">
+<title>REAPER &mdash; First-time Setup</title>
+<link rel="shortcut icon" href="images/favicon.png">
+<script language="JavaScript" type="text/javascript" src="/js/jquery.js"></script>
+<script type="text/javascript" src="/js/httpApi.js"></script>
+<style>
+@font-face{font-family:'Rajdhani';font-weight:700;font-display:swap;src:url('/fonts/rajdhani-700.woff2') format('woff2')}
+@font-face{font-family:'Inter';font-weight:400;font-display:swap;src:url('/fonts/inter-400.woff2') format('woff2')}
+@font-face{font-family:'Inter';font-weight:600;font-display:swap;src:url('/fonts/inter-600.woff2') format('woff2')}
+:root{
+  --bg:#08080a; --panel:#0f0f12; --panel-2:#141418;
+  --line:rgba(225,6,0,.16); --line-soft:rgba(255,255,255,.06);
+  --crimson:#E10600; --crimson-deep:#B3000C;
+  --bone:#ECE7DB; --bone-dim:#B7B1A4; --steel:#71767b;
+  --jade:#4FB286; --amber:#E0A93B; --danger:#E10600;
+  --hdr:'Rajdhani','Oswald',system-ui,sans-serif;
+  --body:'Inter',system-ui,-apple-system,Segoe UI,sans-serif;
+}
+*{box-sizing:border-box}
+html,body{margin:0;min-height:100%}
+body{font-family:var(--body);color:var(--bone-dim);background:var(--bg);
+  background-image:radial-gradient(1200px 500px at 18% -10%,rgba(225,6,0,.10),transparent 60%),
+    radial-gradient(100% 100% at 50% 40%,transparent 55%,rgba(0,0,0,.55) 100%);
+  -webkit-font-smoothing:antialiased;min-height:100vh;display:flex;align-items:center;justify-content:center;padding:24px}
+h1,h2,h3{font-family:var(--hdr);letter-spacing:.04em;color:var(--bone);margin:0}
+.eyebrow{font-family:var(--hdr);text-transform:uppercase;letter-spacing:.22em;font-size:11px;color:var(--steel)}
+.card{width:100%;max-width:460px;background:linear-gradient(180deg,var(--panel),var(--panel-2));
+  border:1px solid var(--line);border-radius:14px;padding:30px 30px 26px;
+  box-shadow:0 24px 60px rgba(0,0,0,.55)}
+.brand{display:flex;align-items:center;gap:12px;margin-bottom:4px}
+.brand .mark{font-family:var(--hdr);font-weight:700;font-size:26px;letter-spacing:.16em;color:var(--bone)}
+.brand .mark b{color:var(--crimson)}
+h2{font-size:20px;margin:14px 0 6px}
+.lead{font-size:13px;line-height:1.5;margin:0 0 18px}
+label{display:block;font-family:var(--hdr);letter-spacing:.06em;text-transform:uppercase;
+  font-size:11px;color:var(--steel);margin:16px 0 6px}
+input[type=text],input[type=password]{width:100%;background:#0b0b0e;border:1px solid var(--line-soft);
+  border-radius:8px;color:var(--bone);font-family:var(--body);font-size:14px;padding:12px 12px;outline:none}
+input:focus{border-color:var(--crimson)}
+.hint{font-size:11px;color:var(--steel);margin-top:6px}
+.err{display:none;margin-top:14px;padding:10px 12px;border-radius:8px;
+  background:rgba(225,6,0,.08);border:1px solid rgba(225,6,0,.35);color:#ffb3ae;font-size:12.5px}
+.btn{margin-top:22px;width:100%;border:0;border-radius:9px;cursor:pointer;
+  font-family:var(--hdr);letter-spacing:.08em;text-transform:uppercase;font-size:14px;
+  color:#fff;padding:13px 16px;background:linear-gradient(180deg,var(--crimson),var(--crimson-deep))}
+.btn:disabled{opacity:.55;cursor:default}
+.steps{display:flex;gap:6px;margin:2px 0 2px}
+.steps span{flex:1;height:3px;border-radius:2px;background:var(--line-soft)}
+.steps span.on{background:var(--crimson)}
+.spin{display:none;margin-top:18px;text-align:center;font-size:12.5px;color:var(--bone-dim)}
+</style>
