+RWIF_1=Wireless Diagnostics
+RWIF_2=Radio State
+RWIF_4=Locked
+RWIF_5=Auto
+RWIF_6=Lock current channel
+RWIF_7=Unlock
+RWIF_8=Channel Selection Constraints
+RWIF_9=Auto-select exclusions
+RWIF_10=Channel Quality Capture
+RWIF_11=Start capture
+RWIF_12=Stop
+RWIF_13=Download CSV
+RWIF_14=undecodable energy
+RWIF_15=free airtime
