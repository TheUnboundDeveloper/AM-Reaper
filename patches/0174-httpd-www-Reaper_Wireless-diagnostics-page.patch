index 57063a7280..60604b82ad 100644
--- a/release/src/router/httpd/web.c
+++ b/release/src/router/httpd/web.c
@@ -21690,6 +21690,262 @@ do_reaper_traffic_cgi(char *url, FILE *stream)
 	fclose(f);
 }
 
+/* reaper v1.5.8: backend for Reaper_Wireless.asp - radio state snapshot plus an
+ * on-demand channel-quality capture (the 1 Hz chanim_stats loop that located a
+ * real-world 320 MHz interferer on 2026-07-16, productized). Read-only toward
+ * the radio: the page changes chanspec through the stock start_apply flow,
+ * never through this endpoint.
+ *
+ * Security model (same as do_reaper_traffic_cgi and rmcpd): no request string
+ * is ever placed in a shell command. The radio unit and capture duration are
+ * matched against fixed allowlists; the only variable in any popen command is
+ * the nvram wlN_ifname value, and it is charset-checked first. Capture output
+ * is CSV under /tmp/reaper_wifi (RAM only - never syslog, never flash, per the
+ * always-on-sampler lesson from rtrafd). The worker is a detached grandchild
+ * that samples once per second and exits on its own deadline or when the run
+ * token is unlinked, so "stop" is an unlink and no signal is ever sent. */
+
+#define RWIFI_DIR	"/tmp/reaper_wifi"
+#define RWIFI_CSV	RWIFI_DIR "/cap.csv"
+#define RWIFI_RUN	RWIFI_DIR "/run"
+#define RWIFI_MAXUNIT	2
+
+static int rwifi_ifname(int unit, char *buf, size_t blen)
+{
+	char tmp[32];
+	const char *v;
+	int i;
+
+	snprintf(tmp, sizeof(tmp), "wl%d_ifname", unit);
+	v = nvram_safe_get(tmp);
+	if (*v == 0 || strlen(v) >= blen)
+		return 0;
+	for (i = 0; v[i]; i++) {
+		if (!isalnum((unsigned char)v[i]) && v[i] != '.' && v[i] != '_' && v[i] != '-')
+			return 0;
+	}
+	strcpy(buf, v);
+	return 1;
+}
+
+/* running chanspec, first token of the wl output (e.g. "6g5/320-1") */
+static void rwifi_run_chanspec(const char *ifname, char *out)
+{
+	char cmd[128], line[256];
+	FILE *p;
+
+	out[0] = 0;
+	snprintf(cmd, sizeof(cmd), "/usr/sbin/wl -i %s chanspec 2>/dev/null", ifname);
+	if ((p = popen(cmd, "r")) == NULL)
+		return;
+	if (fgets(line, sizeof(line), p))
+		sscanf(line, "%63s", out);
+	pclose(p);
+}
+
+/* emit a JSON string value keeping only chanspec/list-safe characters, so a
+ * poisoned nvram value can never break out of the quoted JSON context */
+static void rwifi_json_str(FILE *stream, const char *s)
+{
+	int i;
+
+	websWrite(stream, "\"");
+	for (i = 0; s[i]; i++) {
+		unsigned char c = (unsigned char)s[i];
+		if (isalnum(c) || strchr(",/._:-", c))
+			websWrite(stream, "%c", c);
+	}
+	websWrite(stream, "\"");
+}
+
+/* exact-token membership test for ifname inside space-separated acs_ifnames */
+static int rwifi_in_acs(const char *ifname)
+{
+	char list[256], *tok, *sp;
+
+	snprintf(list, sizeof(list), "%s", nvram_safe_get("acs_ifnames"));
+	for (tok = strtok_r(list, " ", &sp); tok; tok = strtok_r(NULL, " ", &sp)) {
+		if (strcmp(tok, ifname) == 0)
+			return 1;
+	}
+	return 0;
+}
+
+/* one chanim_stats sample appended as a CSV row; header and version lines fail
+ * the 15-field parse and are skipped naturally */
+static int rwifi_sample(const char *ifname, int sec, FILE *csv)
+{
+	char cmd[128], line[512], chspec[32];
+	FILE *p;
+	int got = 0;
+	int tx, inbss, obss, nocat, nopkt, doze, txop, goodtx, badtx, glitch, badplcp, knoise, idle, busy;
+
+	snprintf(cmd, sizeof(cmd), "/usr/sbin/wl -i %s chanim_stats 2>/dev/null", ifname);
+	if ((p = popen(cmd, "r")) == NULL)
+		return 0;
+	while (fgets(line, sizeof(line), p)) {
+		if (sscanf(line, "%31s %d %d %d %d %d %d %d %d %d %d %d %d %d %d",
+			chspec, &tx, &inbss, &obss, &nocat, &nopkt, &doze, &txop,
+			&goodtx, &badtx, &glitch, &badplcp, &knoise, &idle, &busy) == 15) {
+			fprintf(csv, "%d,%s,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d\n",
+				sec, chspec, tx, inbss, obss, nocat, nopkt, doze, txop,
+				goodtx, badtx, glitch, badplcp, knoise, idle, busy);
+			got = 1;
+			break;
+		}
+	}
+	pclose(p);
+	return got;
+}
+
+static void rwifi_worker(int unit, int secs)
+{
+	char ifname[32];
+	struct stat st;
+	FILE *csv;
+	int t;
+
+	if (!rwifi_ifname(unit, ifname, sizeof(ifname)))
+		_exit(0);
+	if ((csv = fopen(RWIFI_CSV, "w")) == NULL)
+		_exit(0);
+	fprintf(csv, "sec,chspec,tx,inbss,obss,nocat,nopkt,doze,txop,goodtx,badtx,glitch,badplcp,knoise,idle,busy\n");
+	fflush(csv);
+	for (t = 0; t < secs; t++) {
+		if (stat(RWIFI_RUN, &st) != 0)
+			break;
+		rwifi_sample(ifname, t, csv);
+		fflush(csv);
+		sleep(1);
+	}
+	fclose(csv);
+	unlink(RWIFI_RUN);
+	_exit(0);
+}
+
+static void
+do_reaper_wifi_cgi(char *url, FILE *stream)
+{
+	static const int durs[] = { 30, 60, 120, 300, 0 };
+	char ifname[32], run[64], tmp[64], buf[4096];
+	struct stat st;
+	char *act, *up, *dp;
+	FILE *f;
+	size_t n;
+	pid_t pid;
+	int unit, secs, i, first;
+
+	act = get_cgi("action");
+	if (act == NULL)
+		act = "status";
+
+	if (strcmp(act, "status") == 0) {
+		websWrite(stream, "{\"territory\":");
+		rwifi_json_str(stream, nvram_safe_get("territory_code"));
+		websWrite(stream, ",\"psc6g\":\"%d\",\"cap\":%d,\"bands\":[",
+			nvram_get_int("psc6g"), stat(RWIFI_RUN, &st) == 0 ? 1 : 0);
+		first = 1;
+		for (unit = 0; unit <= RWIFI_MAXUNIT; unit++) {
+			if (!rwifi_ifname(unit, ifname, sizeof(ifname)))
+				continue;
+			rwifi_run_chanspec(ifname, run);
+			websWrite(stream, "%s{\"unit\":%d,\"ifname\":", first ? "" : ",", unit);
+			rwifi_json_str(stream, ifname);
+			snprintf(tmp, sizeof(tmp), "wl%d_nband", unit);
+			websWrite(stream, ",\"nband\":%d", nvram_get_int(tmp));
+			snprintf(tmp, sizeof(tmp), "wl%d_radio", unit);
+			websWrite(stream, ",\"radio\":%d", nvram_get_int(tmp));
+			snprintf(tmp, sizeof(tmp), "wl%d_chanspec", unit);
+			websWrite(stream, ",\"nv_chanspec\":");
+			rwifi_json_str(stream, nvram_safe_get(tmp));
+			snprintf(tmp, sizeof(tmp), "wl%d_bw", unit);
+			websWrite(stream, ",\"bw\":");
+			rwifi_json_str(stream, nvram_safe_get(tmp));
+			websWrite(stream, ",\"run_chanspec\":");
+			rwifi_json_str(stream, run);
+			snprintf(tmp, sizeof(tmp), "wl%d_acs_excl_chans", unit);
+			websWrite(stream, ",\"excl\":");
+			rwifi_json_str(stream, nvram_safe_get(tmp));
+			websWrite(stream, ",\"acs\":%d}", rwifi_in_acs(ifname));
+			first = 0;
+		}
+		websWrite(stream, "]}");
+		return;
+	}
+
+	if (strcmp(act, "capstart") == 0) {
+		unit = -1;
+		secs = 0;
+		up = get_cgi("unit");
+		dp = get_cgi("secs");
+		if (up && strlen(up) == 1 && up[0] >= '0' && up[0] <= '0' + RWIFI_MAXUNIT)
+			unit = up[0] - '0';
+		if (dp) {
+			for (i = 0; durs[i]; i++) {
+				if (atoi(dp) == durs[i]) {
+					secs = durs[i];
+					break;
+				}
+			}
+		}
+		if (unit < 0 || secs == 0 || !rwifi_ifname(unit, ifname, sizeof(ifname))) {
+			websWrite(stream, "{\"err\":\"params\"}");
+			return;
+		}
+		mkdir(RWIFI_DIR, 0700);
+		/* a live token younger than the longest duration means a worker is
+		 * still sampling; a stale one is leftover from a crash - reclaim it */
+		if (stat(RWIFI_RUN, &st) == 0 && time(NULL) - st.st_mtime < 400) {
+			websWrite(stream, "{\"err\":\"busy\"}");
+			return;
+		}
+		unlink(RWIFI_RUN);
+		if ((f = fopen(RWIFI_RUN, "w")) != NULL) {
+			fprintf(f, "%d %d\n", unit, secs);
+			fclose(f);
+		}
+		pid = fork();
+		if (pid == 0) {
+			/* intermediate child: detach a grandchild so httpd reaps
+			 * immediately and the worker never becomes a zombie */
+			if (fork() == 0) {
+				int fd;
+				setsid();
+				for (fd = 0; fd < 64; fd++)
+					close(fd);
+				fd = open("/dev/null", O_RDWR);
+				if (fd == 0) {
+					dup2(0, 1);
+					dup2(0, 2);
+				}
+				rwifi_worker(unit, secs);
+			}
+			_exit(0);
+		}
+		if (pid > 0)
+			waitpid(pid, NULL, 0);
+		websWrite(stream, "{\"ok\":1,\"secs\":%d}", secs);
+		return;
+	}
+
+	if (strcmp(act, "capstop") == 0) {
+		unlink(RWIFI_RUN);
+		websWrite(stream, "{\"ok\":1}");
+		return;
+	}
+
+	if (strcmp(act, "capdata") == 0) {
+		if ((f = fopen(RWIFI_CSV, "r")) == NULL)
+			return;
+		while ((n = fread(buf, 1, sizeof(buf), f)) > 0)
+			fwrite(buf, 1, n, stream);
+		fclose(f);
+		return;
+	}
+
+	websWrite(stream, "{\"err\":\"action\"}");
+}
+
 #ifdef RTCONFIG_REAPER_MCP
 /* reaper v1.4.0: arming control plane for the read-only MCP advisor (rmcpd).
  *
@@ -29215,6 +29471,7 @@ struct mime_handler mime_handlers[] =
 	/* reaper v1.2.7: set_ASUS_EULA.cgi endpoint removed (legacy app-only setter; EULA pre-signed in defaults.c) */
 	{ "reaper_qos_stats.cgi*", "text/html", no_cache_IE7, do_html_post_and_get, do_reaper_qos_stats_cgi, do_auth },
 	{ "reaper_traffic.cgi*", "text/html", no_cache_IE7, do_html_post_and_get, do_reaper_traffic_cgi, do_auth },
+	{ "reaper_wifi.cgi*", "text/html", no_cache_IE7, do_html_post_and_get, do_reaper_wifi_cgi, do_auth },
 #ifdef RTCONFIG_REAPER_MCP
 	{ "reaper_mcp.cgi*", "text/html", no_cache_IE7, do_html_post_and_get, do_reaper_mcp_cgi, do_auth },
 #endif
