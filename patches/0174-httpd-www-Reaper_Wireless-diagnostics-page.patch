+<script>
+(function(){
+"use strict";
+
+/* the four acsd exclusion lists compiled into rc/sysdeps/init-broadcom.c -
+ * matched verbatim so the panel can name WHICH branch produced the live list */
+var U5="0x5001,0x5002,0x5005,0x5009,0x500d,0x5011,0x5015,0x5019,0x501d,0x5803,0x5903,0x580b,0x590b,0x5813,0x5913,0x581b,0x591b,0x6007,0x6107,0x6207,0x6307,0x6017,0x6117,0x6217,0x6317,0x680f,0x690f,0x6a0f,0x6b0f,0x6c0f,0x6d0f,0x6e0f,0x6f0f";
+var U8="0x50e9,0x50e1,0x50e5,0x58e3,0x59e3";
+var W5="0x5059,0x585b,0x595b,0x6057,0x6157,0x6257,0x6357,0x684f,0x694f,0x6a4f,0x6b4f,0x6c4f,0x6d4f,0x6e4f,0x6f4f,0x7002,0x7042,0x7082,0x70c2,0x7102,0x7142,0x7182,0x71c2,0x7001,0x7041,0x7081,0x70c1,0x7101,0x7141,0x7181,0x71c1,0x7201,0x7241,0x7281,0x72c1,0x7301,0x7341,0x7381,0x73c1";
+var W6="0x7202,0x7242,0x7282,0x72c2,0x7302,0x7342,0x7382,0x73c2";
+
+var BANDNAME={2:"2.4 GHz",1:"5 GHz",4:"6 GHz"};
+var ST=null, CAPPOLL=null, CSV="";
+
+function esc(s){return String(s).replace(/[&<>"']/g,function(c){return "&#"+c.charCodeAt(0)+";"});}
+
+function widthOf(cs){
+  if(!cs) return "";
+  if(cs.indexOf("/320")>=0) return "320";
+  if(cs.indexOf("/160")>=0) return "160";
+  if(cs.indexOf("/80")>=0) return "80";
+  if(cs.indexOf("/40")>=0||/[0-9][lu]$/.test(cs)) return "40";
+  return "20";
+}
+function bwCode(cs){
+  var w=widthOf(cs);
+  return w==="320"?"6":w==="160"?"5":w==="80"?"3":w==="40"?"2":"1";
+}
+
+/* best-effort decode of one Broadcom chanspec hex word (6 GHz encodings) */
+function decodeCs(hex){
+  var v=parseInt(hex,16);
+  if(isNaN(v)) return {w:"?",ch:""};
+  var lo=v&0xff, pos;
+  if((v&0xff00)===0x5000) return {w:"20",ch:String(lo)};
+  if((v&0xfe00)===0x5800){pos=(v>>8)&1;return {w:"40",ch:String(pos?lo+2:lo-2)};}
+  if((v&0xfc00)===0x6000){pos=(v>>8)&3;return {w:"80",ch:String(lo-6+4*pos)};}
+  if((v&0xf800)===0x6800){pos=(v>>8)&7;return {w:"160",ch:String(lo-14+4*pos)};}
+  if((v&0xfc00)===0x7000){return {w:"320",ch:"block "+(v&0xf)};}
+  return {w:"?",ch:""};
+}
+
+function classify(excl){
+  if(!excl) return {label:"<#RWIF_24#>",war:false};
+  if(excl===U8) return {label:"US &middot; UNII-8 " + "<#RWIF_25#>",war:false};
+  if(excl===U5+","+U8) return {label:"<#RWIF_26#>",war:false};
+  if(excl===U5+","+U8+","+W5+","+W6) return {label:"<#RWIF_21#>",war:true};
+  return {label:"<#RWIF_27#>",war:false};
+}
+
+function fetchStatus(cb){
+  var x=new XMLHttpRequest();
+  x.open("GET","/reaper_wifi.cgi?action=status&_="+Date.now(),true);
+  x.onreadystatechange=function(){
+    if(x.readyState!==4) return;
+    try{ST=JSON.parse(x.responseText);}catch(e){ST=null;}
+    render();
+    if(cb) cb();
+  };
+  x.send();
+}
+
+function render(){
+  if(!ST) return;
+  var tb=document.querySelector("#radios tbody"), h="";
+  h+="<tr><th><#menu5_1#></th><th>ifname</th><th><#WLANConfig11b_Channel_itemname#></th>"+
+     "<th><#WLANConfig11b_ChannelBW_itemname#></th><th>acsd</th><th></th></tr>";
+  var i,b;
+  for(i=0;i<ST.bands.length;i++){
+    b=ST.bands[i];
+    var locked=b.nv_chanspec&&b.nv_chanspec!=="0";
+    var w=widthOf(b.run_chanspec);
+    h+="<tr><td class=\"tname\">"+(BANDNAME[b.nband]||("nband "+b.nband))+"</td>"+
+       "<td class=\"mono\">"+esc(b.ifname)+"</td>"+
+       "<td class=\"mono\">"+(b.run_chanspec?esc(b.run_chanspec):"&ndash;")+
+       (locked?" <span class=\"badge lock\"><#RWIF_4#></span>":" <span class=\"badge auto\"><#RWIF_5#></span>")+
+       (b.radio?"":" <span class=\"badge off\">radio off</span>")+"</td>"+
+       "<td class=\"mono\">"+(w?w+" MHz":"&ndash;")+"</td>"+
+       "<td>"+(b.acs?"<span class=\"badge auto\">yes</span>":"<span class=\"badge off\">no</span>")+"</td>"+
+       "<td style=\"text-align:right\">"+
+       (locked?"<button class=\"btn\" onclick=\"RW.unlock("+b.unit+")\"><#RWIF_7#></button>"
+              :"<button class=\"btn\" "+(b.radio&&b.run_chanspec?"":"disabled ")+
+               "onclick=\"RW.lock("+b.unit+")\"><#RWIF_6#></button>")+"</td></tr>";
+  }
+  tb.innerHTML=h;
+
+  var six=null;
+  for(i=0;i<ST.bands.length;i++) if(ST.bands[i].nband===4) six=ST.bands[i];
+  var tiles="", sub="", ex="";
+  tiles+="<div class=\"tile\"><div class=\"k\"><#RWIF_20#></div><div class=\"v\"><small>"+(ST.territory?esc(ST.territory):"&ndash;")+"</small></div></div>";
+  tiles+="<div class=\"tile\"><div class=\"k\">PSC</div><div class=\"v "+(ST.psc6g==="1"?"ok":"warn")+"\"><small>"+(ST.psc6g==="1"?"on":"off")+"</small></div></div>";
+  if(six){
+    var cls=classify(six.excl);
+    tiles+="<div class=\"tile\"><div class=\"k\"><#RWIF_9#></div><div class=\"v "+(cls.war?"warn":"")+"\"><small>"+cls.label+"</small></div></div>";
+    sub="wl2_acs_excl_chans";
+    if(six.excl){
+      var parts=six.excl.split(","), rows="", j, d;
+      for(j=0;j<parts.length;j++){
+        d=decodeCs(parts[j]);
+        rows+="<tr><td class=\"mono\">"+esc(parts[j])+"</td><td class=\"mono\">"+d.w+" MHz</td><td class=\"mono\">"+esc(d.ch)+"</td></tr>";
+      }
+      ex="<div class=\"exwrap\"><table class=\"ta\"><thead><tr><th>chanspec</th><th><#WLANConfig11b_ChannelBW_itemname#></th><th><#WLANConfig11b_Channel_itemname#></th></tr></thead><tbody>"+rows+"</tbody></table></div>";
+    }
+  }
+  document.getElementById("constrtiles").innerHTML=tiles;
+  document.getElementById("constrsub").textContent=sub;
+  document.getElementById("exlists").innerHTML=ex;
+
+  var cu=document.getElementById("capunit");
+  if(cu.options.length===0){
+    var o;
+    for(i=0;i<ST.bands.length;i++){
+      b=ST.bands[i];
+      o=document.createElement("option");
+      o.value=b.unit; o.text=(BANDNAME[b.nband]||b.ifname);
+      if(b.nband===4) o.selected=true;
+      cu.appendChild(o);
+    }
+  }
+  var pill=document.getElementById("cappill");
+  pill.style.display=ST.cap?"":"none";
+  document.getElementById("capstop").disabled=!ST.cap;
+  document.getElementById("capgo").disabled=!!ST.cap;
+  if(ST.cap&&!CAPPOLL) capPoll();
+}
+
+/* channel lock: pin the RUNNING chanspec through the stock apply flow so
+ * validate_apply and restart_wireless do all the real work */
+function lock(unit){
+  var b=null,i;
+  for(i=0;i<ST.bands.length;i++) if(ST.bands[i].unit===unit) b=ST.bands[i];
+  if(!b||!b.run_chanspec) return;
+  submitApply(unit,b.run_chanspec,bwCode(b.run_chanspec));
+}
+function unlock(unit){
+  submitApply(unit,"0","0");
+}
+function submitApply(unit,cs,bw){
+  var f=document.lockform;
+  var e1=f["wl"+unit+"_chanspec"], e2=f["wl"+unit+"_bw"];
+  e1.disabled=false; e1.value=cs;
+  e2.disabled=false; e2.value=bw;
+  f.submit();
+  setTimeout(function(){fetchStatus();},18000);
+}
+
+function capStart(){
+  var u=document.getElementById("capunit").value;
+  var s=document.getElementById("capsecs").value;
+  var x=new XMLHttpRequest();
+  x.open("GET","/reaper_wifi.cgi?action=capstart&unit="+u+"&secs="+s+"&_="+Date.now(),true);
+  x.onreadystatechange=function(){if(x.readyState===4){fetchStatus();capPoll();}};
+  x.send();
+}
+function capStop(){
+  var x=new XMLHttpRequest();
+  x.open("GET","/reaper_wifi.cgi?action=capstop&_="+Date.now(),true);
+  x.onreadystatechange=function(){if(x.readyState===4) fetchStatus();};
+  x.send();
+}
+function capPoll(){
+  if(CAPPOLL) return;
+  CAPPOLL=setInterval(function(){
+    var x=new XMLHttpRequest();
+    x.open("GET","/reaper_wifi.cgi?action=capdata&_="+Date.now(),true);
+    x.onreadystatechange=function(){
+      if(x.readyState!==4) return;
+      CSV=x.responseText||"";
+      renderCap();
+      var y=new XMLHttpRequest();
+      y.open("GET","/reaper_wifi.cgi?action=status&_="+Date.now(),true);
+      y.onreadystatechange=function(){
+        if(y.readyState!==4) return;
+        try{ST=JSON.parse(y.responseText);}catch(e){}
+        if(ST&&!ST.cap){clearInterval(CAPPOLL);CAPPOLL=null;render();}
+      };
+      y.send();
+    };
+    x.send();
+  },2000);
+}
+function renderCap(){
+  var lines=CSV.split("\n").filter(function(l){return l&&l.indexOf("sec,")!==0;});
+  var n=lines.length;
+  document.getElementById("capempty").style.display=n?"none":"";
+  document.getElementById("capwrap").style.display=n?"":"none";
+  document.getElementById("captiles").style.display=n?"":"none";
+  document.getElementById("capdl").disabled=!n;
+  if(!n){document.getElementById("capverdict").textContent="";return;}
+  var i,c,sumNo=0,sumTx=0,maxGl=0,rows="";
+  for(i=0;i<n;i++){
+    c=lines[i].split(",");
+    sumNo+=+c[6]; sumTx+=+c[8]; if(+c[11]>maxGl) maxGl=+c[11];
+  }
+  var lo=Math.max(0,n-12);
+  for(i=n-1;i>=lo;i--){
+    c=lines[i].split(",");
+    rows+="<tr><td class=\"mono\">"+esc(c[0])+"</td><td class=\"mono\">"+esc(c[1])+"</td>"+
+      "<td class=\"num\">"+esc(c[2])+"</td><td class=\"num\">"+esc(c[4])+"</td>"+
+      "<td class=\"num\" style=\""+(+c[6]>=20?"color:var(--crimson)":"")+"\">"+esc(c[6])+"</td>"+
+      "<td class=\"num\">"+esc(c[7])+"</td><td class=\"num\">"+esc(c[8])+"</td>"+
+      "<td class=\"num\" style=\""+(+c[11]>=50?"color:var(--amber)":"")+"\">"+esc(c[11])+"</td>"+
+      "<td class=\"num\">"+esc(c[13])+"</td><td class=\"num\">"+esc(c[15])+"</td></tr>";
+  }
+  document.querySelector("#captable tbody").innerHTML=rows;
+  var avgNo=sumNo/n, avgTx=sumTx/n;
+  var eN=document.getElementById("t_nopkt");
+  eN.textContent=avgNo.toFixed(1)+"%"; eN.className="v "+(avgNo>=20?"bad":"ok");
+  document.getElementById("t_txop").textContent=avgTx.toFixed(1)+"%";
+  document.getElementById("t_glitch").textContent=String(maxGl);
+  document.getElementById("t_n").textContent=String(n);
+  document.getElementById("cappilltxt").textContent=n+"s";
+  var v=document.getElementById("capverdict");
+  if(n>=10){
+    v.className="verdict "+(avgNo>=20?"bad":"ok");
+    v.innerHTML=avgNo>=20?"<#RWIF_23#>":"<#RWIF_22#>";
+  } else v.textContent="";
+}
+function capDownload(){
+  var a=document.createElement("a");
+  a.href=URL.createObjectURL(new Blob([CSV],{type:"text/csv"}));
+  a.download="reaper_wifi_capture.csv";
+  document.body.appendChild(a); a.click();
+  setTimeout(function(){URL.revokeObjectURL(a.href);a.remove();},2000);
+}
+
+window.RW={lock:lock,unlock:unlock};
+window.capStart=capStart; window.capStop=capStop; window.capDownload=capDownload;
+fetchStatus();
+setInterval(function(){if(!CAPPOLL) fetchStatus();},30000);
+})();
+</script>
+</body>
+</html>
