-/* reading pill mirrors the SELECTED window label + the store location (was hardcoded 'Live') */
+/* reading pill mirrors the SELECTED window label + the store location (was hardcoded 'Live');
+   it also carries the no-response marker when polls stop answering, so a dead
+   collector/session reads as stalled instead of silently rendering nothing new */
+var stalled=false;
 function setPill(){ var on=document.querySelector('#wins .win.on');
-  document.getElementById('statuspill_t').textContent=(on?on.textContent.trim():'<#RTRF_02#>')+' - '+curStore; }
+  document.getElementById('statuspill_t').textContent=(on?on.textContent.trim():'<#RTRF_02#>')+' - '+curStore+(stalled?' - <#RTRF_72#>':''); }
+function setStalled(s){ if(s===stalled)return; stalled=s;
+  document.getElementById('statuspill').className='pill'+(s?' stall':''); setPill(); }
 
 /* ---- formatting ---- */
 function fmtBps(b){ b=+b||0; if(b>=1e9)return (b/1e9).toFixed(2)+' Gb/s'; if(b>=1e6)return (b/1e6).toFixed(1)+' Mb/s'; if(b>=1e3)return (b/1e3).toFixed(0)+' kb/s'; return b.toFixed(0)+' b/s'; }
@@ -313,11 +319,20 @@ var PORTS={20:'FTP',21:'FTP',22:'SSH',25:'SMTP',53:'DNS',80:'HTTP',110:'POP3',14
 function portName(p,proto){ if(PORTS[p]) return PORTS[p]+' ('+p+')'; if(p>=6881&&p<=6999) return 'BitTorrent ('+p+')'; if(p>=27000&&p<=27100) return 'Game ('+p+')'; return (proto===17?'UDP ':proto===6?'TCP ':'')+p; }
 
 /* ---- fetch ---- */
+/* cb(data, ok). onloadend fires exactly once on success, HTTP error, timeout AND
+   abort, so a request can never end in no state at all - a stalled XHR is what
+   wedged the old in-flight guard and froze the page. ok=false means no usable
+   payload arrived: callers keep the last paint and mark the pill stalled rather
+   than render zeros. Returns the XHR so the live loop can watchdog it. */
 function getJSON(f, cb){
   var x=new XMLHttpRequest();
   x.open('GET','/reaper_traffic.cgi?f='+f+'&_='+Date.now(),true);
-  x.onreadystatechange=function(){ if(x.readyState!==4)return; var d={}; try{d=JSON.parse(x.responseText);}catch(e){} cb(d); };
+  x.timeout=Math.max(3000, 2*pollMs+2000);
+  x.onloadend=function(){ var d=null;
+    if(x.status===200){ try{d=JSON.parse(x.responseText);}catch(e){} }
+    if(d&&typeof d==='object') cb(d,true); else cb({},false); };
   x.send();
+  return x;
 }
 
 /* ---- client identity (v1.5.3): names from networkmap - same source as the
@@ -496,14 +511,28 @@ function loadWin(){
   if(curWin==='live'){
     wanBuf=[]; clsBuf=[];   /* fresh rolling window */
     /* in-flight guard: at the 100ms Live rate a slow response must skip ticks,
-       not stack XHRs against the single-threaded httpd */
-    var inflight=false;
-    var tick=function(){ if(inflight) return; inflight=true;
-      getJSON('live', function(d){ inflight=false; renderLive(d); }); };
+       not stack XHRs against the single-threaded httpd. The guard holds the XHR
+       + a start stamp: a request that outlives the XHR timeout is aborted here
+       (belt-and-suspenders) so one hung response can never wedge the loop - the
+       old boolean flag had no way back to false and froze the whole page. */
+    var inflight=null, inflightAt=0;
+    var tick=function(){
+      if(inflight){
+        if(Date.now()-inflightAt < Math.max(5000, 2*pollMs+3000)) return;
+        try{ inflight.abort(); }catch(e){}
+        inflight=null;
+      }
+      inflightAt=Date.now();
+      inflight=getJSON('live', function(d,ok){ inflight=null; setStalled(!ok); if(ok) renderLive(d); });
+    };
     tick(); liveTimer=setInterval(tick, pollMs);   /* live view refresh (user-selectable) */
   } else {
-    getJSON(curWin, renderHist);
-    getJSON('live', renderLive);   /* tiles + top talkers reflect current moment */
+    var histTick=function(){
+      getJSON(curWin, function(d,ok){ if(ok) renderHist(d); });
+      getJSON('live', function(d,ok){ setStalled(!ok); if(ok) renderLive(d); });   /* tiles + top talkers */
+    };
+    histTick();
+    liveTimer=setInterval(histTick, 30000);   /* history windows refresh too (were one-shot -> went stale) */
   }
 }
 function setPollRate(){
