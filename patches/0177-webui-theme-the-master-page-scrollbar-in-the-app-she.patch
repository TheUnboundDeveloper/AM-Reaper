From 8d2844563ec774cd9ec381abb68af130bb09abf7 Mon Sep 17 00:00:00 2001
From: reaper <theunbounddeveloper@outlook.com>
Date: Fri, 17 Jul 2026 11:36:24 -0400
Subject: [PATCH] webui: theme the master page scrollbar in the app shell

The far-right top-window scrollbar was black-track/crimson-thumb on the
dashboard (Main_ReaperDash.asp) but stock gray on every shell-framed
page - reaper_shell.asp is the top window for all of them and carried no
scrollbar rules. Apply the same scrollbar-color / ::-webkit-scrollbar
rules to the shell so the master scrollbar is themed everywhere.

Co-Authored-By: Claude Fable 5 <noreply@anthropic.com>
---
 release/src/router/www/reaper_shell.asp | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/release/src/router/www/reaper_shell.asp b/release/src/router/www/reaper_shell.asp
index 1c96cd05e0..3379db1021 100644
--- a/release/src/router/www/reaper_shell.asp
+++ b/release/src/router/www/reaper_shell.asp
@@ -35,6 +35,14 @@ html,body{margin:0}
 body{font-family:var(--body);color:var(--bone-dim);background:var(--bg);overflow-x:hidden}
 /* one page-level scrollbar: the body scrolls; topbar and the content stage are
    sticky so only the rail visually scrolls when it is taller than the viewport */
+/* master page scrollbar: black track, crimson thumb (same rules as the dashboard) -
+   this is the top window for every framed page, so it themes the far-right
+   scrollbar everywhere */
+html{scrollbar-width:thin;scrollbar-color:var(--crimson) #000}
+::-webkit-scrollbar{width:12px;height:12px}
+::-webkit-scrollbar-track{background:#000}
+::-webkit-scrollbar-thumb{background:var(--crimson);border-radius:8px;border:2px solid #000}
+::-webkit-scrollbar-thumb:hover{background:var(--crimson-deep)}
 /* rail width + topbar geometry standardized to match Main_ReaperDash exactly */
 .app{display:grid;grid-template-columns:236px minmax(0,1fr);grid-template-rows:auto 1fr;min-height:100vh}
 .top{grid-column:2;grid-row:1;display:flex;align-items:center;gap:14px;padding:14px 18px;flex-wrap:nowrap;
-- 
2.25.1

