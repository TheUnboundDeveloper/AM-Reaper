@@ -22355,9 +22355,22 @@ do_reaper_mcp_cgi(char *url, FILE *stream)
 			return;
 		}
 		fchmod(fileno(sf), 0600);
-		fprintf(sf, "token=%s\nexpiry=%ld\nclient=%s\n%s%s",
-			tokhex, (long)(now + timeout * 60), nvram_safe_get("rmcp_client"),
-			usbkey_line, diag_line);
+		{
+			/* Defense-in-depth: rmcp_client is written verbatim into the
+			 * newline-delimited session file that rmcpd and the boot sweep parse
+			 * line-by-line. Strip any CR/LF and keep only dotted-quad characters
+			 * (the value is always a LAN IPv4 literal) so a crafted nvram value
+			 * cannot inject extra key=value session lines. */
+			char clbuf[64];
+			char *c;
+			strlcpy(clbuf, nvram_safe_get("rmcp_client"), sizeof(clbuf));
+			clbuf[strcspn(clbuf, "\r\n")] = '\0';
+			for (c = clbuf; *c; c++)
+				if (!((*c >= '0' && *c <= '9') || *c == '.')) { clbuf[0] = '\0'; break; }
+			fprintf(sf, "token=%s\nexpiry=%ld\nclient=%s\n%s%s",
+				tokhex, (long)(now + timeout * 60), clbuf,
+				usbkey_line, diag_line);
+		}
