@@ -821,8 +850,8 @@ static void write_live(const char *store)
 	FILE *o = fopen("/tmp/rtraf/.live.json", "w");
 	char eb[80], eb2[80];	/* F11 escape scratch */
 	int i, first;
-	uint64_t cap_gb = strtoull(nvram_safe_get("rtraf_cap_gb"), NULL, 10);
-	int qos_on = (nvram_get_int("qos_enable") == 1 && nvram_get_int("qos_type") == 11);
+	uint64_t cap_gb = cfg_cap_gb;		/* cached at 1 Hz (refresh_cfg) */
+	int qos_on = cfg_qos_on;
 	if (!o) return;
 	fprintf(o, "{\"t\":%lld,\"poll_ms\":%d,\"store\":\"%s\",\"qos\":%d",
 		(long long)time(NULL), TICK_MS, store, qos_on);
@@ -868,13 +897,11 @@ static void write_live(const char *store)
 	}
 	fprintf(o, ",\"top\":[");
 	for (i = 0; i < ntop; i++) {
-		/* LAN-side MAC from the per-poll ARP cache so the page can name the
-		 * talker; remote dst never resolves and stays IP-only */
-		char smac[24], eb3[80];
-		if (!arp_mac(top[i].src, smac, sizeof(smac)))
-			smac[0] = '\0';
+		/* LAN-side MAC was resolved once when the row was built (top_note);
+		 * remote dst never resolves and stays IP-only */
+		char eb3[80];
 		fprintf(o, "%s{\"src\":\"%s\",\"smac\":\"%s\",\"dst\":\"%s\",\"dport\":%d,\"proto\":%d,\"rate\":%llu,\"up\":%llu,\"dn\":%llu}",
-			i ? "," : "", jesc(top[i].src, eb, sizeof(eb)), jesc(smac, eb3, sizeof(eb3)), jesc(top[i].dst, eb2, sizeof(eb2)), top[i].dport, top[i].proto,
+			i ? "," : "", jesc(top[i].src, eb, sizeof(eb)), jesc(top[i].smac, eb3, sizeof(eb3)), jesc(top[i].dst, eb2, sizeof(eb2)), top[i].dport, top[i].proto,
 			(unsigned long long)top[i].rate, (unsigned long long)top[i].up,
 			(unsigned long long)top[i].dn);
 	}
