+ * - for values that only change on a QoS/settings apply - is pure lock churn.
+ * refresh_cfg() reloads them once at startup and then only in the 1 Hz branch. */
+static uint64_t cfg_cap_gb = 0;
+static int cfg_qos_on = 0;
+
+static void refresh_cfg(void)
+{
+	cfg_cap_gb = strtoull(nvram_safe_get("rtraf_cap_gb"), NULL, 10);
+	cfg_qos_on = (nvram_get_int("qos_enable") == 1 && nvram_get_int("qos_type") == 11);
+}
+
 /* live snapshot holders (bits/sec), refreshed at each source's own cadence and
  * republished into live.json every tick so the page always has a fresh value */
 static uint64_t lv_wan_rx, lv_wan_tx;		/* WAN rate (every tick) */
@@ -138,6 +151,7 @@ typedef struct {
 	int dport, proto;	/* proto: 6/17/other */
 	uint64_t rate;		/* bytes/sec both dirs */
