diff --git a/release/src/router/rmcpd/rmcpd.c b/release/src/router/rmcpd/rmcpd.c
index 16eb985542..6d0c5cd4a4 100644
--- a/release/src/router/rmcpd/rmcpd.c
+++ b/release/src/router/rmcpd/rmcpd.c
@@ -374,8 +374,21 @@ static FILE *popen_pid(const char *cmd, pid_t *pid_out)
 	}
 	close(fds[1]);
 	setpgid(pid, pid);
-	*pid_out = pid;
-	return fdopen(fds[0], "r");
+	{
+		FILE *fp = fdopen(fds[0], "r");
+		if (!fp) {
+			/* fdopen failed after the fork: close the read fd so it does not
+			 * leak, and don't leave an orphaned child (its write end would keep
+			 * the pipe open and it would linger as a zombie). The child put
+			 * itself in its own process group, so kill the whole group and reap. */
+			close(fds[0]);
+			killpg(pid, SIGKILL);
+			waitpid(pid, NULL, 0);
+			return NULL;
+		}
+		*pid_out = pid;
+		return fp;
+	}
 }
 
