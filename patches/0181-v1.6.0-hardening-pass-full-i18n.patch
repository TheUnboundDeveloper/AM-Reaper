-	if (!r_wan || !r_prb || !flows || !fc_last) return 1;
+	/* allocations (about 1.3 MB of rings + flow table). Every ring is dereferenced
+	 * unconditionally on the hot path, so a NULL among ANY of the 83 - not just the
+	 * four spot-checked before - would crash later; verify them all up front. */
+	{
+		int ok = 1;
+		if (!(r_wan = calloc(1, sizeof(ring_t)))) ok = 0;
+		for (i = 0; i < NNET; i++) if (!(r_net[i] = calloc(1, sizeof(ring_t)))) ok = 0;
+		for (i = 0; i < 7; i++) if (!(r_cls[i] = calloc(1, sizeof(ring_t)))) ok = 0;
+		for (i = 0; i < NCLI; i++) if (!(r_cli[i] = calloc(1, sizeof(ring_t)))) ok = 0;
+		if (!(r_prb = calloc(1, sizeof(ring_t)))) ok = 0;
+		if (!(flows = calloc(NFLOW, sizeof(flow_t)))) ok = 0;
+		if (!(fc_last = calloc(FC_SLOTS, sizeof(uint64_t)))) ok = 0;
+		if (!ok) { syslog(LOG_ERR, "rtrafd: out of memory during init"); return 1; }
+	}
 
 	mkdir("/tmp/rtraf", 0700);
 	f_write_string("/proc/sys/net/netfilter/nf_conntrack_acct", "1", 0, 0);
@@ -1040,6 +1072,7 @@ int main(int argc, char **argv)
 	db_load(dbpath);
