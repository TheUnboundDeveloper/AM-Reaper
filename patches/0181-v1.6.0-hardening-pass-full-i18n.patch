@@ -325,15 +339,26 @@ static int arp_mac(const char *ip, char *mac, size_t maclen)
 
 /* ---------- pollers ---------- */
 
-/* read a single unsigned counter out of a sysfs file */
-static int rd_u64(const char *path, uint64_t *out)
+/* Read a single unsigned counter out of a sysfs file, holding the fd open across
+ * calls. poll_ifaces runs at the 10 Hz base tick for the router's whole uptime;
+ * reopening the two WAN counter files every tick is pure syscall churn. kernfs
+ * regenerates the value on a pread at offset 0, so one open per interface is
+ * enough - reopen only if a read fails (interface churn). */
+static int rd_u64_fd(int *fd, const char *ifn, const char *stat, uint64_t *out)
 {
-	FILE *f = fopen(path, "r");
-	int ok;
-	if (!f) return 0;
-	ok = (fscanf(f, "%llu", (unsigned long long *)out) == 1);
-	fclose(f);
-	return ok;
+	char buf[32];
+	ssize_t n;
+	if (*fd < 0) {
+		char p[160];
+		snprintf(p, sizeof(p), "/sys/class/net/%s/statistics/%s", ifn, stat);
+		if ((*fd = open(p, O_RDONLY | O_CLOEXEC)) < 0)
+			return 0;
+	}
+	n = pread(*fd, buf, sizeof(buf) - 1, 0);
+	if (n <= 0) { close(*fd); *fd = -1; return 0; }
+	buf[n] = '\0';
+	*out = strtoull(buf, NULL, 10);
+	return 1;
 }
 
 /* WAN byte counters, read straight from the WAN interface's sysfs entries.
@@ -353,13 +378,11 @@ static int rd_u64(const char *path, uint64_t *out)
  */
 static void poll_ifaces(const char *wanif)
 {
-	char p[160];
+	static int fd_rx = -1, fd_tx = -1;	/* opened once, held across ticks */
 	uint64_t rxb, txb;
 
-	snprintf(p, sizeof(p), "/sys/class/net/%s/statistics/rx_bytes", wanif);
-	if (!rd_u64(p, &rxb)) return;
-	snprintf(p, sizeof(p), "/sys/class/net/%s/statistics/tx_bytes", wanif);
-	if (!rd_u64(p, &txb)) return;
+	if (!rd_u64_fd(&fd_rx, wanif, "rx_bytes", &rxb)) return;
+	if (!rd_u64_fd(&fd_tx, wanif, "tx_bytes", &txb)) return;
 
 	if (have_if_last[0] && rxb >= last_if_rx[0] && txb >= last_if_tx[0])
 		ring_add(r_wan, rxb - last_if_rx[0], txb - last_if_tx[0]);
@@ -409,6 +432,12 @@ put:
 	strlcpy(top[i].dst, dst, sizeof(top[0].dst));
 	top[i].dport = dport; top[i].proto = proto;
 	top[i].rate = rate; top[i].up = up; top[i].dn = dn;
+	/* Resolve the LAN-side MAC ONCE, here, while the ARP cache is fresh (both
+	 * poll_fcache and poll_conntrack call arp_refresh() before their top_note
+	 * loop). write_live() then just prints it, instead of re-scanning the whole
+	 * ARP table for every top row on every 10 Hz live write. */
+	if (!arp_mac(src, top[i].smac, sizeof(top[0].smac)))
+		top[i].smac[0] = '\0';
 }
 
