diff --git a/release/src/router/rchqd/Makefile b/release/src/router/rchqd/Makefile
new file mode 100644
index 0000000000..1aed3949dd
--- /dev/null
+++ b/release/src/router/rchqd/Makefile
@@ -0,0 +1,55 @@
+# SPDX-License-Identifier: GPL-2.0-only
+# Copyright (C) 2026 the Reaper project maintainer
+# Part of the Reaper hardened Asuswrt-Merlin build. See LICENSE / LICENSE.reaper.
+include ../common.mak
+
+CFLAGS	+= -Os -Wall $(EXTRACFLAGS)
+CFLAGS	+= -I$(SRCBASE)/include -I$(TOP)/shared
+# exploit-mitigation hardening (matches rtrafd/rmcpd): FORTIFY + strong canaries
+# + format-security + PIE; the BCM base ships neither by default.
+CFLAGS	+= -D_FORTIFY_SOURCE=2 -fstack-protector-strong -Wformat -Wformat-security -fPIE
+LDFLAGS	= -L$(TOP_PLATFORM)/nvram$(BCMEX)$(EX7) -lnvram -L$(TOP)/shared -lshared
+ifeq ($(RTCONFIG_BCM_502L07P2),y)
+LDFLAGS += -L$(TOP_PLATFORM)/ethctl_lib -lethctl
+endif
+ifeq ($(HND_ROUTER),y)
+LDFLAGS += -L$(TOP_PLATFORM)/wlcsm -lwlcsm
+endif
+LDFLAGS += -pie -Wl,-z,relro,-z,now
+
+ifeq ($(RTCONFIG_BCMARM),y)
+CFLAGS += -I$(SRCBASE)/shared/bcmwifi/include -DTYPEDEF_FLOAT_T
+CFLAGS += -I$(SRCBASE)/common/include
+endif
+
+OBJS = rchqd.o
+
+all: rchqd
+
+rchqd: $(OBJS)
+	@echo " [rchqd] CC -o $@"
+	$(CC) $(LDFLAGS) -o $@ $(OBJS)
+
+	$(SIZECHECK)
+	$(CPTMP)
+
+clean:
+	rm -f rchqd .*.depend
+	rm -f *.o
+
+install: all
+	@echo " [rchqd] Installing..."
+	install -D rchqd $(INSTALLDIR)/bin/rchqd
+	$(STRIP) $(INSTALLDIR)/bin/rchqd
+
+%.o: %.c .%.depend
+	@echo " [rchqd] CC $@"
+	@$(CC) $(CFLAGS) -c $<
+
+.depend: $(OBJS:%.o=%.c)
+	@$(CC) $(CFLAGS) -M $^ > .depend
+
+.%.depend: %.c
+	@$(CC) $(CFLAGS) -M $< > $@
+
+-include $(OBJS:%.o=.%.depend)
diff --git a/release/src/router/rchqd/rchqd.c b/release/src/router/rchqd/rchqd.c
new file mode 100644
index 0000000000..51f473c90c
--- /dev/null
+++ b/release/src/router/rchqd/rchqd.c
@@ -0,0 +1,180 @@
+/* SPDX-License-Identifier: GPL-2.0-only
+ * Copyright (C) 2026 the Reaper project maintainer
+ * Part of the Reaper hardened Asuswrt-Merlin build. See LICENSE / LICENSE.reaper. */
+/*
+ * rchqd - reaper channel-quality monitor (v1, firmware v1.6.1)
+ *
+ * A PASSIVE, opt-in always-on health watcher for the Wi-Fi radios. Once per
+ * RCHQ_TICK it reads `wl chanim_stats` on each radio's CURRENT operating
+ * channel - the same on-channel read the Wireless page's capture panel already
+ * does live, with no client disruption - and publishes a per-radio health
+ * snapshot to /tmp/reaper_chq/live.json for the UI.
+ *
+ * It is deliberately READ-ONLY: it never sets a chanspec, never restarts
+ * wireless, never hops off-channel. When a radio's undecodable-energy (nopkt)
+ * stays high it raises a soft "degraded" advisory - the remedy is the user
+ * running Auto Scan on the Wireless page, never an action taken here. Gated by
+ * nvram rchq_enable (default 0); services.c only launches it when enabled and
+ * it also exits on its own if the flag is later cleared.
+ */
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+#include <time.h>
+#include <signal.h>
+#include <syslog.h>
+#include <ctype.h>
+#include <sys/stat.h>
+#include <sys/types.h>
+
+#include <bcmnvram.h>
+#include <shutils.h>
+#include <shared.h>
+
+#define RCHQ_DIR	"/tmp/reaper_chq"
+#define RCHQ_LIVE	RCHQ_DIR "/live.json"
+#define RCHQ_TICK	10		/* seconds between passive samples */
+#define RCHQ_MAXUNIT	3		/* quad-band ceiling */
+#define RCHQ_DEGRADED	20		/* smoothed nopkt %% at/above = degraded advisory */
+
+static volatile sig_atomic_t running = 1;
+static void on_term(int sig) { (void)sig; running = 0; }
+
+/* per-radio smoothed nopkt (EWMA) so one noisy second does not flip the flag */
+static int ewma_nopkt[RCHQ_MAXUNIT + 1];
+static int have_ewma[RCHQ_MAXUNIT + 1];
+
+static int rchq_ifname(int unit, char *buf, size_t blen)
+{
+	char key[32];
+	const char *v;
+	int i;
+
+	snprintf(key, sizeof(key), "wl%d_ifname", unit);
+	v = nvram_safe_get(key);
+	if (*v == 0 || strlen(v) >= blen)
+		return 0;
+	for (i = 0; v[i]; i++)
+		if (!isalnum((unsigned char)v[i]) && v[i] != '.' && v[i] != '_' && v[i] != '-')
+			return 0;
+	strcpy(buf, v);
+	return 1;
+}
+
+static void rchq_chanspec(const char *ifname, char *out, size_t olen)
+{
+	char cmd[128], line[256], tok[64];
+	FILE *p;
+
+	out[0] = 0;
+	snprintf(cmd, sizeof(cmd), "/usr/sbin/wl -i %s chanspec 2>/dev/null", ifname);
+	if ((p = popen(cmd, "r")) == NULL)
+		return;
+	if (fgets(line, sizeof(line), p) && sscanf(line, "%63s", tok) == 1)
+		snprintf(out, olen, "%s", tok);
+	pclose(p);
+}
+
+/* one on-channel chanim sample; returns 1 on success (no retune, no disruption) */
+static int rchq_sample(const char *ifname, int *nopkt, int *txop, int *glitch)
+{
+	char cmd[128], line[512], chspec[32];
+	FILE *p;
+	int tx, inbss, obss, nocat, np, doze, to, goodtx, badtx, gl, badplcp, knoise, idle, busy;
+	int got = 0;
+
+	snprintf(cmd, sizeof(cmd), "/usr/sbin/wl -i %s chanim_stats 2>/dev/null", ifname);
+	if ((p = popen(cmd, "r")) == NULL)
+		return 0;
+	while (fgets(line, sizeof(line), p)) {
+		if (sscanf(line, "%31s %d %d %d %d %d %d %d %d %d %d %d %d %d %d",
+			chspec, &tx, &inbss, &obss, &nocat, &np, &doze, &to,
+			&goodtx, &badtx, &gl, &badplcp, &knoise, &idle, &busy) == 15) {
+			*nopkt = np; *txop = to; *glitch = gl; got = 1;
+			break;
+		}
+	}
+	pclose(p);
+	return got;
+}
+
+/* JSON string emit keeping only chanspec-safe characters */
+static void j_str(FILE *f, const char *s)
+{
+	int i;
+
+	fputc('"', f);
+	for (i = 0; s && s[i]; i++) {
+		unsigned char c = (unsigned char)s[i];
+		if (isalnum(c) || strchr(",/._:-", c))
+			fputc(c, f);
+	}
+	fputc('"', f);
+}
+
+int main(int argc, char **argv)
+{
+	(void)argc; (void)argv;
+
+	if (daemon(0, 0) < 0)
+		return 1;
+	openlog("rchqd", LOG_PID, LOG_DAEMON);
+	signal(SIGTERM, on_term);
+	signal(SIGINT, on_term);
+	mkdir(RCHQ_DIR, 0700);
+	syslog(LOG_NOTICE, "rchqd: started (passive channel-quality monitor)");
+
+	while (running) {
+		char tmp[80], ifname[32], cs[64], rkey[32];
+		FILE *f;
+		int unit, first = 1, s;
+
+		/* honor a runtime disable without needing a signal */
+		if (!nvram_get_int("rchq_enable")) {
+			syslog(LOG_NOTICE, "rchqd: rchq_enable cleared, exiting");
+			break;
+		}
+
+		snprintf(tmp, sizeof(tmp), "%s.tmp", RCHQ_LIVE);
+		if ((f = fopen(tmp, "w")) != NULL) {
+			fprintf(f, "{\"tick\":%d,\"radios\":[", RCHQ_TICK);
+			for (unit = 0; unit <= RCHQ_MAXUNIT; unit++) {
+				int nopkt = 0, txop = 0, glitch = 0, degraded;
+
+				if (!rchq_ifname(unit, ifname, sizeof(ifname)))
+					continue;
+				snprintf(rkey, sizeof(rkey), "wl%d_radio", unit);
+				if (!nvram_get_int(rkey)) { have_ewma[unit] = 0; continue; }
+				if (!rchq_sample(ifname, &nopkt, &txop, &glitch))
+					continue;
+				rchq_chanspec(ifname, cs, sizeof(cs));
+
+				/* EWMA: new = 3/4 old + 1/4 sample */
+				if (!have_ewma[unit]) { ewma_nopkt[unit] = nopkt; have_ewma[unit] = 1; }
+				else ewma_nopkt[unit] = (ewma_nopkt[unit] * 3 + nopkt) / 4;
+				degraded = (ewma_nopkt[unit] >= RCHQ_DEGRADED) ? 1 : 0;
+
+				fprintf(f, "%s{\"unit\":%d,\"ifname\":", first ? "" : ",", unit);
+				j_str(f, ifname);
+				fprintf(f, ",\"chanspec\":");
+				j_str(f, cs);
+				fprintf(f, ",\"nopkt\":%d,\"txop\":%d,\"glitch\":%d,\"avg_nopkt\":%d,\"degraded\":%d}",
+					nopkt, txop, glitch, ewma_nopkt[unit], degraded);
+				first = 0;
+			}
+			fprintf(f, "],\"ts\":%ld}", (long)time(NULL));
+			fclose(f);
+			rename(tmp, RCHQ_LIVE);
+		}
+
+		for (s = 0; s < RCHQ_TICK && running; s++)
+			sleep(1);
+	}
+
+	unlink(RCHQ_LIVE);
+	syslog(LOG_NOTICE, "rchqd: stopped");
+	closelog();
+	return 0;
+}
