+/* ---- Auto Scan: server-driven sweep of the 6 GHz 320 MHz channels ----
+ * The worker (reaper_wifi.cgi?action=scanstart) pins each candidate through
+ * the same nvram+restart_wireless path Lock uses, samples chanim_stats on it,
+ * ranks them, and RESTORES the original channel. This page only polls results
+ * and, on the user's click, pins the winner. It is the only path here that
+ * changes the channel - exactly one deliberate, warned action. */
+function six_band(){
+  var i;
+  for(i=0;ST&&i<ST.bands.length;i++) if(ST.bands[i].nband===4) return ST.bands[i];
+  return null;
+}
+function scanStart(){
+  var six=six_band();
+  if(!six){alert("<#RWIF_38#>");return;}
+  if(!confirm("<#RWIF_33#>")) return;
+  var x=new XMLHttpRequest();
+  x.open("GET","/reaper_wifi.cgi?action=scanstart&unit="+six.unit+"&_="+Date.now(),true);
+  x.onreadystatechange=function(){
+    if(x.readyState!==4) return;
+    var r=null; try{r=JSON.parse(x.responseText);}catch(e){}
+    if(!r||!r.ok){document.getElementById("scanprog").textContent=(r&&r.err)?("error: "+r.err):"error";return;}
+    scanPoll();
+  };
+  x.send();
+}
+function scanStop(){
+  var x=new XMLHttpRequest();
+  x.open("GET","/reaper_wifi.cgi?action=scanstop&_="+Date.now(),true);
+  x.send();
+}
+function scanPoll(){
+  document.getElementById("scango").disabled=true;
+  document.getElementById("scanstop").disabled=false;
+  if(SCANPOLL) return;
+  SCANPOLL=setInterval(function(){
+    var x=new XMLHttpRequest();
+    x.open("GET","/reaper_wifi.cgi?action=scandata&_="+Date.now(),true);
+    x.onreadystatechange=function(){
+      if(x.readyState!==4) return;
+      try{SCANDATA=JSON.parse(x.responseText);}catch(e){SCANDATA=null;}
+      renderScan();
+      if(SCANDATA&&SCANDATA.done){
+        clearInterval(SCANPOLL);SCANPOLL=null;
+        document.getElementById("scango").disabled=false;
+        document.getElementById("scanstop").disabled=true;
+        setTimeout(function(){fetchStatus();},1000);
+      }
+    };
+    x.send();
+  },2000);
+}
+function renderScan(){
+  if(!SCANDATA) return;
+  var prog=document.getElementById("scanprog");
+  if(!SCANDATA.done){
+    prog.innerHTML="<span class=\"badge warn\">scanning</span> "+esc(SCANDATA.cur||"")+
+      " ("+(SCANDATA.idx||0)+"/"+(SCANDATA.total||0)+") &middot; <#RWIF_34#>";
+  } else {
+    prog.textContent=SCANDATA.aborted?"<#RWIF_39#>":"<#RWIF_40#>";
+  }
+  var res=SCANDATA.results||[];
+  document.getElementById("scanempty").style.display=res.length?"none":"";
+  document.getElementById("scanwrap").style.display=res.length?"":"none";
+  var rows="",i,r;
+  for(i=0;i<res.length;i++){
+    r=res[i];
+    rows+="<tr><td class=\"num\">"+(i+1)+"</td>"+
+      "<td class=\"mono\">"+esc(r.chanspec)+(i===0?" <span class=\"badge auto\"><#RWIF_41#></span>":"")+"</td>"+
+      "<td class=\"num\" style=\""+(+r.nopkt>=20?"color:var(--crimson)":"")+"\">"+(+r.nopkt).toFixed(0)+"</td>"+
+      "<td class=\"num\">"+(+r.txop).toFixed(0)+"</td>"+
+      "<td class=\"num\">"+esc(r.glitch)+"</td>"+
+      "<td class=\"num\">"+(+r.score).toFixed(0)+"</td></tr>";
+  }
+  document.querySelector("#scantable tbody").innerHTML=rows;
+  SCANBEST=res.length?res[0]:null;
+  document.getElementById("scanpin").disabled=!(SCANDATA.done&&SCANBEST&&SCANBEST.chanspec);
+}
+function scanPin(){
+  var six=six_band();
+  if(!six||!SCANBEST||!SCANBEST.chanspec) return;
+  if(!confirm("<#RWIF_42#> "+SCANBEST.chanspec)) return;
+  submitApply(six.unit,SCANBEST.chanspec,bwCode(SCANBEST.chanspec));
+}
+
+/* ---- Passive Channel Monitor (rchqd): opt-in, read-only, advises only ---- */
+function chqToggle(){
+  var on=(ST&&ST.chq_on)?0:1;
+  var x=new XMLHttpRequest();
+  x.open("GET","/reaper_wifi.cgi?action=chqset&on="+on+"&_="+Date.now(),true);
+  x.onreadystatechange=function(){if(x.readyState===4) setTimeout(function(){fetchStatus();},600);};
+  x.send();
+}
+function chqPoll(){
+  if(CHQPOLL) return;
+  var tick=function(){
+    var x=new XMLHttpRequest();
+    x.open("GET","/reaper_wifi.cgi?action=chq&_="+Date.now(),true);
+    x.onreadystatechange=function(){
+      if(x.readyState!==4) return;
+      var d=null; try{d=JSON.parse(x.responseText);}catch(e){}
+      chqRenderLive(d);
+    };
+    x.send();
+  };
+  tick();
+  CHQPOLL=setInterval(tick,10000);
+}
+function chqRenderLive(d){
+  var body=document.getElementById("chqbody");
+  if(!body) return;
+  if(!d||!d.radios||!d.radios.length){ body.innerHTML="<#RWIF_47#>"; return; }
+  var i,r,bad,h="";
+  for(i=0;i<d.radios.length;i++){
+    r=d.radios[i]; bad=r.degraded;
+    h+="<div style=\"margin:3px 0\"><span class=\"mono\">"+esc(r.chanspec||r.ifname)+"</span> &middot; nopkt "+
+       "<b style=\""+(bad?"color:var(--crimson)":"color:var(--jade)")+"\">"+(+r.avg_nopkt)+"%</b> &middot; "+
+       (bad?"<span class=\"badge warn\"><#RWIF_48#></span>":"<span class=\"badge auto\"><#RWIF_49#></span>")+"</div>";
+  }
+  body.innerHTML=h;
+}
 
 window.RW={lock:lock,unlock:unlock};
-window.capStart=capStart; window.capStop=capStop; window.capDownload=capDownload;
+window.capStart=capStart; window.capStop=capStop; window.capDownload=capDownload; window.capClear=capClear;
+window.scanStart=scanStart; window.scanStop=scanStop; window.scanPin=scanPin;
+window.chqToggle=chqToggle;
 fetchStatus();
 setInterval(function(){if(!CAPPOLL) fetchStatus();},30000);
 })();
