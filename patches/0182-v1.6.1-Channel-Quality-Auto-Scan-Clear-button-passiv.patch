+/* reaper v1.6.1: passive channel-quality monitor. Opt-in (nvram rchq_enable),
+ * read-only - it samples chanim_stats on each radio's current channel and
+ * publishes /tmp/reaper_chq/live.json; it NEVER changes a channel or restarts
+ * wireless. Safe to run always-on because on-channel chanim reads do not
+ * disturb clients. It also self-exits if rchq_enable is later cleared. */
+void
+stop_rchqd(void)
+{
+	if (pids("rchqd"))
+		killall_tk("rchqd");
+}
+
+void
+start_rchqd(void)
+{
+	stop_rchqd();
+	if (!is_routing_enabled()) return;
+	if (nvram_match("rchq_enable", "0")) return;
+	xstart("rchqd");
+}
+
 #ifdef RTCONFIG_REAPER_MCP
