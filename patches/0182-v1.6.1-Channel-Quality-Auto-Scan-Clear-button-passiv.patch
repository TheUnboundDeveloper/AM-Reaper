 }
 
+/* ---- Auto Scan: sweep the 6 GHz 320 MHz channels, rank by cleanliness ----
+ *
+ * This is the ONLY httpd path that changes a channel. It pins each candidate
+ * through the same nvram + restart_wireless flow the Lock button uses (a live
+ * "wl chanspec" set does not stick on a running AP - wlconf re-applies at radio
+ * init), samples chanim_stats on it, then RESTORES the pre-scan channel. It is
+ * deliberately disruptive (a wireless restart per candidate) and user-initiated
+ * only; the page warns before starting. nvram is set in RAM (never committed),
+ * so nothing survives a reboot and only the user's explicit "Pin best" - which
+ * goes through the normal apply/commit flow - makes a choice permanent. */
+
+struct rwifi_scres { char cs[24]; int nopkt, txop, glitch, score; };
+
+static int rwifi_is_psc(int ch)
+{
+	static const int psc[] = { 5,21,37,53,69,85,101,117,133,149,165,181,197,213,229,0 };
+	int i;
+	for (i = 0; psc[i]; i++)
+		if (psc[i] == ch)
+			return 1;
+	return 0;
+}
+
+/* distinct PSC-anchored 6 GHz 320 MHz chanspecs the driver reports as valid,
+ * spread across the band if there are more than `max` of them */
+static int rwifi_scan_candidates(const char *ifname, char cand[][24], int max)
+{
+	char cmd[128], line[256], all[64][24], tok[24];
+	FILE *p;
+	int nall = 0, i, ch;
+
+	snprintf(cmd, sizeof(cmd), "/usr/sbin/wl -i %s chanspecs 2>/dev/null", ifname);
+	if ((p = popen(cmd, "r")) == NULL)
+		return 0;
+	while (fgets(line, sizeof(line), p) && nall < 64) {
+		if (sscanf(line, "%23s", tok) != 1)
+			continue;
+		if (!strstr(tok, "/320"))
+			continue;
+		if (sscanf(tok, "6g%d/", &ch) != 1 || !rwifi_is_psc(ch))
+			continue;
+		for (i = 0; i < nall; i++)
+			if (strcmp(all[i], tok) == 0)
+				break;
+		if (i < nall)
+			continue;
+		snprintf(all[nall], 24, "%s", tok);
+		nall++;
+	}
+	pclose(p);
+	if (nall == 0)
+		return 0;
+	if (nall <= max) {
+		for (i = 0; i < nall; i++)
+			snprintf(cand[i], 24, "%s", all[i]);
+		return nall;
+	}
+	for (i = 0; i < max; i++)
+		snprintf(cand[i], 24, "%s", all[(int)((long)i * nall / max)]);
+	return max;
+}
+
+/* average chanim_stats over nsec on-channel samples; glitch is a max */
+static void rwifi_avg_sample(const char *ifname, int nsec, int *nopkt, int *txop, int *glitch)
+{
+	char cmd[128], line[512], chspec[32];
+	int i, gotn = 0, sN = 0, sT = 0, mg = 0;
+	int tx, inbss, obss, nocat, np, doze, to, goodtx, badtx, gl, badplcp, knoise, idle, busy;
+
+	snprintf(cmd, sizeof(cmd), "/usr/sbin/wl -i %s chanim_stats 2>/dev/null", ifname);
+	for (i = 0; i < nsec; i++) {
+		FILE *p = popen(cmd, "r");
+		if (p) {
+			while (fgets(line, sizeof(line), p)) {
+				if (sscanf(line, "%31s %d %d %d %d %d %d %d %d %d %d %d %d %d %d",
+					chspec, &tx, &inbss, &obss, &nocat, &np, &doze, &to,
+					&goodtx, &badtx, &gl, &badplcp, &knoise, &idle, &busy) == 15) {
+					sN += np; sT += to; if (gl > mg) mg = gl; gotn++;
+					break;
+				}
+			}
+			pclose(p);
+		}
+		sleep(1);
+	}
+	if (gotn == 0) { *nopkt = 100; *txop = 0; *glitch = 0; return; }
+	*nopkt = sN / gotn; *txop = sT / gotn; *glitch = mg;
+}
+
+/* rank result indices by score ascending (lower score = cleaner) */
+static void rwifi_scan_rank(struct rwifi_scres *r, int n, int *order)
+{
+	int i, j, t;
+	for (i = 0; i < n; i++)
+		order[i] = i;
+	for (i = 0; i < n; i++)
+		for (j = i + 1; j < n; j++)
+			if (r[order[j]].score < r[order[i]].score) {
+				t = order[i]; order[i] = order[j]; order[j] = t;
+			}
+}
+
+static void rwifi_scan_publish(int done, int aborted, const char *cur, int idx, int total,
+			       struct rwifi_scres *r, int n, int *order)
+{
+	char tmp[80];
+	FILE *f;
+	int i, k;
+
+	snprintf(tmp, sizeof(tmp), "%s.tmp", RWIFI_SCAN);
+	if ((f = fopen(tmp, "w")) == NULL)
+		return;
+	fprintf(f, "{\"done\":%d,\"aborted\":%d,\"cur\":\"%s\",\"idx\":%d,\"total\":%d,\"results\":[",
+		done, aborted, cur ? cur : "", idx, total);
+	for (i = 0; i < n; i++) {
+		k = order[i];
+		fprintf(f, "%s{\"chanspec\":\"%s\",\"nopkt\":%d,\"txop\":%d,\"glitch\":%d,\"score\":%d}",
+			i ? "," : "", r[k].cs, r[k].nopkt, r[k].txop, r[k].glitch, r[k].score);
+	}
+	fprintf(f, "]}");
+	fclose(f);
+	rename(tmp, RWIFI_SCAN);
+}
+
+/* block until the radio reports `target` as its running chanspec, or timeout */
+static void rwifi_wait_chanspec(const char *ifname, const char *target, int maxsec)
+{
+	char run[64];
+	int i;
+	for (i = 0; i < maxsec; i++) {
+		sleep(1);
+		rwifi_run_chanspec(ifname, run);
+		if (strcmp(run, target) == 0) {
+			sleep(1);	/* small settle once it lands */
+			return;
+		}
+	}
+}
+
+static void rwifi_scan_worker(int unit)
+{
+	char ifname[32], orig_cs[64], orig_bw[16], nvk[32], cand[RWIFI_SCAN_MAX][24], cur[24];
+	struct rwifi_scres r[RWIFI_SCAN_MAX];
+	int order[RWIFI_SCAN_MAX];
+	int i, n = 0, ncand, aborted;
+	struct stat st;
+
+	if (!rwifi_ifname(unit, ifname, sizeof(ifname))) {
+		unlink(RWIFI_SRUN);
+		_exit(0);
+	}
+
+	snprintf(nvk, sizeof(nvk), "wl%d_chanspec", unit);
+	snprintf(orig_cs, sizeof(orig_cs), "%s", nvram_safe_get(nvk));
+	snprintf(nvk, sizeof(nvk), "wl%d_bw", unit);
+	snprintf(orig_bw, sizeof(orig_bw), "%s", nvram_safe_get(nvk));
+
+	ncand = rwifi_scan_candidates(ifname, cand, RWIFI_SCAN_MAX);
+	rwifi_scan_rank(r, 0, order);
+	if (ncand <= 0) {
+		rwifi_scan_publish(1, 0, "", 0, 0, r, 0, order);
+		unlink(RWIFI_SRUN);
+		_exit(0);
+	}
+
+	for (i = 0; i < ncand; i++) {
+		if (stat(RWIFI_SRUN, &st) != 0)
+			break;			/* user hit stop */
+		snprintf(cur, sizeof(cur), "%s", cand[i]);
+		rwifi_scan_rank(r, n, order);
+		rwifi_scan_publish(0, 0, cur, i + 1, ncand, r, n, order);
+
+		/* pin candidate (RAM only, no commit) and restart the radio */
+		snprintf(nvk, sizeof(nvk), "wl%d_chanspec", unit);
+		nvram_set(nvk, cand[i]);
+		snprintf(nvk, sizeof(nvk), "wl%d_bw", unit);
+		nvram_set(nvk, "6");
+		notify_rc("restart_wireless");
+		rwifi_wait_chanspec(ifname, cand[i], RWIFI_SCAN_SETTLE);
+
+		if (stat(RWIFI_SRUN, &st) != 0)
+			break;			/* stopped during the slow restart */
+
+		snprintf(r[n].cs, sizeof(r[n].cs), "%s", cand[i]);
+		rwifi_avg_sample(ifname, RWIFI_SCAN_DWELL, &r[n].nopkt, &r[n].txop, &r[n].glitch);
+		r[n].score = r[n].nopkt + (100 - r[n].txop) +
+			     (r[n].glitch > 200 ? 200 : r[n].glitch) / 10;
+		n++;
+		rwifi_scan_rank(r, n, order);
+		rwifi_scan_publish(0, 0, cur, i + 1, ncand, r, n, order);
+	}
+
+	aborted = (stat(RWIFI_SRUN, &st) != 0);
+
+	/* restore the pre-scan channel regardless of how we got here */
+	snprintf(nvk, sizeof(nvk), "wl%d_chanspec", unit);
+	nvram_set(nvk, orig_cs);
+	snprintf(nvk, sizeof(nvk), "wl%d_bw", unit);
+	nvram_set(nvk, orig_bw);
+	notify_rc("restart_wireless");
+
+	rwifi_scan_rank(r, n, order);
+	rwifi_scan_publish(1, aborted ? 1 : 0, "", ncand, ncand, r, n, order);
+	unlink(RWIFI_SRUN);
+	_exit(0);
+}
+
 static void
 do_reaper_wifi_cgi(char *url, FILE *stream)
 {
@@ -21842,8 +22055,9 @@ do_reaper_wifi_cgi(char *url, FILE *stream)
 	if (strcmp(act, "status") == 0) {
 		websWrite(stream, "{\"territory\":");
 		rwifi_json_str(stream, nvram_safe_get("territory_code"));
-		websWrite(stream, ",\"psc6g\":\"%d\",\"cap\":%d,\"bands\":[",
-			nvram_get_int("psc6g"), stat(RWIFI_RUN, &st) == 0 ? 1 : 0);
+		websWrite(stream, ",\"psc6g\":\"%d\",\"cap\":%d,\"scan\":%d,\"chq_on\":%d,\"bands\":[",
+			nvram_get_int("psc6g"), stat(RWIFI_RUN, &st) == 0 ? 1 : 0,
+			stat(RWIFI_SRUN, &st) == 0 ? 1 : 0, nvram_get_int("rchq_enable"));
 		first = 1;
 		for (unit = 0; unit <= RWIFI_MAXUNIT; unit++) {
 			if (!rwifi_ifname(unit, ifname, sizeof(ifname)))
@@ -21943,6 +22157,99 @@ do_reaper_wifi_cgi(char *url, FILE *stream)
 		return;
 	}
 
+	if (strcmp(act, "scanstart") == 0) {
+		unit = -1;
+		up = get_cgi("unit");
+		if (up && strlen(up) == 1 && up[0] >= '0' && up[0] <= '0' + RWIFI_MAXUNIT)
+			unit = up[0] - '0';
+		snprintf(tmp, sizeof(tmp), "wl%d_nband", unit < 0 ? 0 : unit);
+		/* auto-scan is 6 GHz only (nband 4); it retunes the radio */
+		if (unit < 0 || !rwifi_ifname(unit, ifname, sizeof(ifname)) ||
+		    nvram_get_int(tmp) != 4) {
+			websWrite(stream, "{\"err\":\"params\"}");
+			return;
+		}
+		mkdir(RWIFI_DIR, 0700);
+		/* refuse if a capture or another scan is still live */
+		if ((stat(RWIFI_RUN, &st) == 0 && time(NULL) - st.st_mtime < 400) ||
+		    (stat(RWIFI_SRUN, &st) == 0 && time(NULL) - st.st_mtime < 600)) {
+			websWrite(stream, "{\"err\":\"busy\"}");
+			return;
+		}
+		unlink(RWIFI_SRUN);
+		if ((f = fopen(RWIFI_SRUN, "w")) != NULL) {
+			fprintf(f, "%d\n", unit);
+			fclose(f);
+		}
+		unlink(RWIFI_SCAN);
+		pid = fork();
+		if (pid == 0) {
+			/* detach a grandchild so httpd reaps immediately */
+			if (fork() == 0) {
+				int fd;
+				setsid();
+				for (fd = 0; fd < 64; fd++)
+					close(fd);
+				fd = open("/dev/null", O_RDWR);
+				if (fd == 0) {
+					dup2(0, 1);
+					dup2(0, 2);
+				}
+				rwifi_scan_worker(unit);
+			}
+			_exit(0);
+		}
+		if (pid > 0)
+			waitpid(pid, NULL, 0);
+		websWrite(stream, "{\"ok\":1}");
+		return;
+	}
+
+	if (strcmp(act, "scanstop") == 0) {
+		unlink(RWIFI_SRUN);
+		websWrite(stream, "{\"ok\":1}");
+		return;
+	}
+
+	if (strcmp(act, "scandata") == 0) {
+		if ((f = fopen(RWIFI_SCAN, "r")) == NULL) {
+			websWrite(stream, "{\"done\":0,\"results\":[]}");
+			return;
+		}
+		while ((n = fread(buf, 1, sizeof(buf), f)) > 0)
+			fwrite(buf, 1, n, stream);
+		fclose(f);
+		return;
+	}
+
+	/* rchqd passive monitor: read its snapshot */
+	if (strcmp(act, "chq") == 0) {
+		if ((f = fopen(RWIFI_CHQ, "r")) == NULL) {
+			websWrite(stream, "{\"radios\":[]}");
+			return;
+		}
+		while ((n = fread(buf, 1, sizeof(buf), f)) > 0)
+			fwrite(buf, 1, n, stream);
+		fclose(f);
+		return;
+	}
+
+	/* enable/disable the passive monitor (opt-in, persisted); read-only daemon */
+	if (strcmp(act, "chqset") == 0) {
+		up = get_cgi("on");
+		if (up && up[0] == '1') {
+			nvram_set("rchq_enable", "1");
+			nvram_commit();
+			notify_rc("start_rchqd");
+		} else {
+			nvram_set("rchq_enable", "0");
+			nvram_commit();
+			notify_rc("stop_rchqd");
+		}
+		websWrite(stream, "{\"ok\":1,\"chq_on\":%d}", nvram_get_int("rchq_enable"));
+		return;
+	}
+
 	websWrite(stream, "{\"err\":\"action\"}");
 }
 
