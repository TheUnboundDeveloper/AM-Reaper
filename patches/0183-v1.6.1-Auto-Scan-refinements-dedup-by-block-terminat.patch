@@ -21710,9 +21710,11 @@ do_reaper_traffic_cgi(char *url, FILE *stream)
 #define RWIFI_RUN	RWIFI_DIR "/run"
 #define RWIFI_SCAN	RWIFI_DIR "/scan.json"	/* auto-scan progress + ranked results */
 #define RWIFI_SRUN	RWIFI_DIR "/scanrun"	/* auto-scan run token; unlink = abort */
