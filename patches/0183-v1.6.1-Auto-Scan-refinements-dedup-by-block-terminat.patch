 static int rwifi_is_psc(int ch)
 {
@@ -21852,50 +21854,54 @@ static int rwifi_is_psc(int ch)
 	return 0;
 }
 
-/* distinct PSC-anchored 6 GHz 320 MHz chanspecs the driver reports as valid,
- * spread across the band if there are more than `max` of them */
+/* distinct PHYSICAL 6 GHz 320 MHz channels the driver reports as valid. Every
+ * primary inside one 320 block occupies the SAME spectrum, so scanning more
+ * than one of them is redundant - keep just one PSC-anchored representative per
+ * block. The -1 grid starts at ch1 and the -2 grid at ch33; each 320 block
+ * spans 64 twenty-MHz channels. This yields the ~6 real 320 positions across
+ * both sub-grids (low/mid/high on each), with no wasted restarts. */
 static int rwifi_scan_candidates(const char *ifname, char cand[][24], int max)
 {
-	char cmd[128], line[256], all[64][24], tok[24];
+	char cmd[128], line[256], tok[24], seen[16][8], key[8];
 	FILE *p;
-	int nall = 0, i, ch;
+	int nseen = 0, n = 0, ch, sub, base, blk, i;
 
 	snprintf(cmd, sizeof(cmd), "/usr/sbin/wl -i %s chanspecs 2>/dev/null", ifname);
 	if ((p = popen(cmd, "r")) == NULL)
 		return 0;
-	while (fgets(line, sizeof(line), p) && nall < 64) {
+	while (fgets(line, sizeof(line), p) && n < max && nseen < 16) {
 		if (sscanf(line, "%23s", tok) != 1)
 			continue;
-		if (!strstr(tok, "/320"))
+		/* need both the primary channel and the -1/-2 sub-block index */
+		if (sscanf(tok, "6g%d/320-%d", &ch, &sub) != 2)
 			continue;
-		if (sscanf(tok, "6g%d/", &ch) != 1 || !rwifi_is_psc(ch))
+		if (!rwifi_is_psc(ch))
 			continue;
-		for (i = 0; i < nall; i++)
-			if (strcmp(all[i], tok) == 0)
-				break;
-		if (i < nall)
+		base = (sub == 2) ? 33 : 1;
+		blk = (ch - base) / 64;			/* 0,1,2 within this grid */
+		if (blk < 0)
 			continue;
-		snprintf(all[nall], 24, "%s", tok);
-		nall++;
+		snprintf(key, sizeof(key), "%d_%d", sub, blk);
+		for (i = 0; i < nseen; i++)
+			if (strcmp(seen[i], key) == 0)
+				break;
+		if (i < nseen)
+			continue;			/* already have this physical block */
+		snprintf(seen[nseen], sizeof(seen[0]), "%s", key);
+		nseen++;
+		snprintf(cand[n], 24, "%s", tok);
+		n++;
 	}
 	pclose(p);
-	if (nall == 0)
-		return 0;
-	if (nall <= max) {
-		for (i = 0; i < nall; i++)
-			snprintf(cand[i], 24, "%s", all[i]);
-		return nall;
-	}
-	for (i = 0; i < max; i++)
-		snprintf(cand[i], 24, "%s", all[(int)((long)i * nall / max)]);
-	return max;
+	return n;
 }
 
-/* average chanim_stats over nsec on-channel samples; glitch is a max */
-static void rwifi_avg_sample(const char *ifname, int nsec, int *nopkt, int *txop, int *glitch)
+/* average chanim_stats over nsec on-channel samples; glitch is a max, knoise
+ * (noise floor, dBm - negative) is averaged too */
+static void rwifi_avg_sample(const char *ifname, int nsec, int *nopkt, int *txop, int *glitch, int *knz)
 {
 	char cmd[128], line[512], chspec[32];
-	int i, gotn = 0, sN = 0, sT = 0, mg = 0;
+	int i, gotn = 0, sN = 0, sT = 0, mg = 0, sK = 0;
 	int tx, inbss, obss, nocat, np, doze, to, goodtx, badtx, gl, badplcp, knoise, idle, busy;
 
 	snprintf(cmd, sizeof(cmd), "/usr/sbin/wl -i %s chanim_stats 2>/dev/null", ifname);
@@ -21906,7 +21912,7 @@ static void rwifi_avg_sample(const char *ifname, int nsec, int *nopkt, int *txop
 				if (sscanf(line, "%31s %d %d %d %d %d %d %d %d %d %d %d %d %d %d",
 					chspec, &tx, &inbss, &obss, &nocat, &np, &doze, &to,
 					&goodtx, &badtx, &gl, &badplcp, &knoise, &idle, &busy) == 15) {
-					sN += np; sT += to; if (gl > mg) mg = gl; gotn++;
+					sN += np; sT += to; sK += knoise; if (gl > mg) mg = gl; gotn++;
 					break;
 				}
 			}
@@ -21914,8 +21920,8 @@ static void rwifi_avg_sample(const char *ifname, int nsec, int *nopkt, int *txop
 		}
 		sleep(1);
 	}
-	if (gotn == 0) { *nopkt = 100; *txop = 0; *glitch = 0; return; }
-	*nopkt = sN / gotn; *txop = sT / gotn; *glitch = mg;
+	if (gotn == 0) { *nopkt = 100; *txop = 0; *glitch = 0; *knz = 0; return; }
+	*nopkt = sN / gotn; *txop = sT / gotn; *glitch = mg; *knz = sK / gotn;
 }
 
 /* rank result indices by score ascending (lower score = cleaner) */
@@ -21945,8 +21951,8 @@ static void rwifi_scan_publish(int done, int aborted, const char *cur, int idx,
 		done, aborted, cur ? cur : "", idx, total);
 	for (i = 0; i < n; i++) {
 		k = order[i];
-		fprintf(f, "%s{\"chanspec\":\"%s\",\"nopkt\":%d,\"txop\":%d,\"glitch\":%d,\"score\":%d}",
-			i ? "," : "", r[k].cs, r[k].nopkt, r[k].txop, r[k].glitch, r[k].score);
+		fprintf(f, "%s{\"chanspec\":\"%s\",\"nopkt\":%d,\"txop\":%d,\"glitch\":%d,\"knoise\":%d,\"score\":%d}",
+			i ? "," : "", r[k].cs, r[k].nopkt, r[k].txop, r[k].glitch, r[k].knoise, r[k].score);
 	}
 	fprintf(f, "]}");
 	fclose(f);
@@ -21968,16 +21974,32 @@ static void rwifi_wait_chanspec(const char *ifname, const char *target, int maxs
 	}
 }
 
+/* the sweep is alive while the run token exists AND the browser is still polling
+ * (heartbeat fresh). A closed tab / navigated-away page stops polling, the
+ * heartbeat goes stale, and the sweep aborts + restores the channel. */
+static int rwifi_scan_alive(void)
+{
+	struct stat st;
+
+	if (stat(RWIFI_SRUN, &st) != 0)
+		return 0;			/* explicit stop (scanstop unlinked it) */
+	if (stat(RWIFI_SHB, &st) != 0)
+		return 0;
+	if (time(NULL) - st.st_mtime >= RWIFI_SCAN_HB)
+		return 0;			/* browser stopped polling */
+	return 1;
+}
+
 static void rwifi_scan_worker(int unit)
 {
 	char ifname[32], orig_cs[64], orig_bw[16], nvk[32], cand[RWIFI_SCAN_MAX][24], cur[24];
 	struct rwifi_scres r[RWIFI_SCAN_MAX];
 	int order[RWIFI_SCAN_MAX];
 	int i, n = 0, ncand, aborted;
-	struct stat st;
 
 	if (!rwifi_ifname(unit, ifname, sizeof(ifname))) {
 		unlink(RWIFI_SRUN);
+		unlink(RWIFI_SHB);
 		_exit(0);
 	}
 
@@ -21991,12 +22013,13 @@ static void rwifi_scan_worker(int unit)
 	if (ncand <= 0) {
 		rwifi_scan_publish(1, 0, "", 0, 0, r, 0, order);
 		unlink(RWIFI_SRUN);
+		unlink(RWIFI_SHB);
 		_exit(0);
 	}
 
 	for (i = 0; i < ncand; i++) {
-		if (stat(RWIFI_SRUN, &st) != 0)
-			break;			/* user hit stop */
+		if (!rwifi_scan_alive())
+			break;			/* stopped, or the browser left */
 		snprintf(cur, sizeof(cur), "%s", cand[i]);
 		rwifi_scan_rank(r, n, order);
 		rwifi_scan_publish(0, 0, cur, i + 1, ncand, r, n, order);
@@ -22009,11 +22032,11 @@ static void rwifi_scan_worker(int unit)
 		notify_rc("restart_wireless");
 		rwifi_wait_chanspec(ifname, cand[i], RWIFI_SCAN_SETTLE);
 
-		if (stat(RWIFI_SRUN, &st) != 0)
+		if (!rwifi_scan_alive())
 			break;			/* stopped during the slow restart */
 
 		snprintf(r[n].cs, sizeof(r[n].cs), "%s", cand[i]);
-		rwifi_avg_sample(ifname, RWIFI_SCAN_DWELL, &r[n].nopkt, &r[n].txop, &r[n].glitch);
+		rwifi_avg_sample(ifname, RWIFI_SCAN_DWELL, &r[n].nopkt, &r[n].txop, &r[n].glitch, &r[n].knoise);
 		r[n].score = r[n].nopkt + (100 - r[n].txop) +
 			     (r[n].glitch > 200 ? 200 : r[n].glitch) / 10;
 		n++;
@@ -22021,7 +22044,7 @@ static void rwifi_scan_worker(int unit)
 		rwifi_scan_publish(0, 0, cur, i + 1, ncand, r, n, order);
 	}
 
-	aborted = (stat(RWIFI_SRUN, &st) != 0);
+	aborted = !rwifi_scan_alive();
 
 	/* restore the pre-scan channel regardless of how we got here */
 	snprintf(nvk, sizeof(nvk), "wl%d_chanspec", unit);
@@ -22032,7 +22055,12 @@ static void rwifi_scan_worker(int unit)
 
 	rwifi_scan_rank(r, n, order);
 	rwifi_scan_publish(1, aborted ? 1 : 0, "", ncand, ncand, r, n, order);
+	if (!aborted && n > 0)
+		logmessage("reaper_scan",
+			"auto-scan: best %s (nopkt %d%%, score %d) of %d channels",
+			r[order[0]].cs, r[order[0]].nopkt, r[order[0]].score, n);
 	unlink(RWIFI_SRUN);
+	unlink(RWIFI_SHB);
 	_exit(0);
 }
 
@@ -22181,6 +22209,10 @@ do_reaper_wifi_cgi(char *url, FILE *stream)
 			fprintf(f, "%d\n", unit);
 			fclose(f);
 		}
+		if ((f = fopen(RWIFI_SHB, "w")) != NULL) {	/* seed the browser heartbeat */
+			fputc('1', f);
+			fclose(f);
+		}
 		unlink(RWIFI_SCAN);
 		pid = fork();
 		if (pid == 0) {
@@ -22212,6 +22244,12 @@ do_reaper_wifi_cgi(char *url, FILE *stream)
 	}
 
 	if (strcmp(act, "scandata") == 0) {
+		/* browser poll = heartbeat: refresh it while a sweep runs so the worker
+		 * knows the page is still open (a closed tab self-aborts the sweep) */
+		if (stat(RWIFI_SRUN, &st) == 0 && (f = fopen(RWIFI_SHB, "w")) != NULL) {
+			fputc('1', f);
+			fclose(f);
+		}
 		if ((f = fopen(RWIFI_SCAN, "r")) == NULL) {
 			websWrite(stream, "{\"done\":0,\"results\":[]}");
 			return;
