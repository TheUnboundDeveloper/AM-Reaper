+/* stop a running sweep immediately if the tab is closed or navigated away, so
+ * the radio is not left bouncing unattended (the heartbeat is the crash backstop) */
+function scanUnloadStop(){
+  if(SCANPOLL && navigator.sendBeacon){
+    try{ navigator.sendBeacon("/reaper_wifi.cgi?action=scanstop"); }catch(e){}
+  }
+}
+window.addEventListener("pagehide",scanUnloadStop);
+window.addEventListener("beforeunload",scanUnloadStop);
 fetchStatus();
 setInterval(function(){if(!CAPPOLL) fetchStatus();},30000);
 })();
