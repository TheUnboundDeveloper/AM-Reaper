+	if (nband == 4) {
+		char seen[16][8], key[8];
+		int nseen = 0, ch, sub, base, blk;
+
+		if ((p = popen(cmd, "r")) == NULL)
+			return 0;
+		while (fgets(line, sizeof(line), p) && n < max && nseen < 16) {
+			if (sscanf(line, "%23s", tok) != 1)
+				continue;
+			if (sscanf(tok, "6g%d/320-%d", &ch, &sub) != 2)
+				continue;
+			if (!rwifi_is_psc(ch))
+				continue;
+			base = (sub == 2) ? 33 : 1;
+			blk = (ch - base) / 64;
+			if (blk < 0)
+				continue;
+			snprintf(key, sizeof(key), "%d_%d", sub, blk);
+			for (i = 0; i < nseen; i++)
+				if (strcmp(seen[i], key) == 0)
+					break;
+			if (i < nseen)
