-		if (sscanf(tok, "6g%d/320-%d", &ch, &sub) != 2)
-			continue;
-		if (!rwifi_is_psc(ch))
-			continue;
-		base = (sub == 2) ? 33 : 1;
-		blk = (ch - base) / 64;			/* 0,1,2 within this grid */
-		if (blk < 0)
-			continue;
-		snprintf(key, sizeof(key), "%d_%d", sub, blk);
-		for (i = 0; i < nseen; i++)
-			if (strcmp(seen[i], key) == 0)
-				break;
-		if (i < nseen)
-			continue;			/* already have this physical block */
-		snprintf(seen[nseen], sizeof(seen[0]), "%s", key);
-		nseen++;
-		snprintf(cand[n], 24, "%s", tok);
-		n++;
