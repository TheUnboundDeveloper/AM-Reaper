From 81cc559fc976f74b56825740ae093535efba97e2 Mon Sep 17 00:00:00 2001
From: reaper <theunbounddeveloper@outlook.com>
Date: Sun, 19 Jul 2026 11:10:22 -0400
Subject: [PATCH] v1.6.3: rchqd degraded-event syslog trail (edge-triggered,
 throttled per radio)

---
 release/src-rt/version.conf      |  2 +-
 release/src/router/rchqd/rchqd.c | 33 ++++++++++++++++++++++++++++++--
 2 files changed, 32 insertions(+), 3 deletions(-)

diff --git a/release/src-rt/version.conf b/release/src-rt/version.conf
index ad8080f84f..e8295ca277 100644
--- a/release/src-rt/version.conf
+++ b/release/src-rt/version.conf
@@ -4,6 +4,6 @@ KERNEL_VER_AM=$(subst .,,$(KERNEL_VER))
 FS_VER_AM=$(subst .,,$(FS_VER))
 
 SERIALNO=102.8
-EXTENDNO=Reaper_v1.6.2
+EXTENDNO=Reaper_v1.6.3
 
 RCNO=0
diff --git a/release/src/router/rchqd/rchqd.c b/release/src/router/rchqd/rchqd.c
index 51f473c90c..411e933d39 100644
--- a/release/src/router/rchqd/rchqd.c
+++ b/release/src/router/rchqd/rchqd.c
@@ -2,7 +2,7 @@
  * Copyright (C) 2026 the Reaper project maintainer
  * Part of the Reaper hardened Asuswrt-Merlin build. See LICENSE / LICENSE.reaper. */
 /*
- * rchqd - reaper channel-quality monitor (v1, firmware v1.6.1)
+ * rchqd - reaper channel-quality monitor (v2, firmware v1.6.3)
  *
  * A PASSIVE, opt-in always-on health watcher for the Wi-Fi radios. Once per
  * RCHQ_TICK it reads `wl chanim_stats` on each radio's CURRENT operating
@@ -10,6 +10,11 @@
  * does live, with no client disruption - and publishes a per-radio health
  * snapshot to /tmp/reaper_chq/live.json for the UI.
  *
+ * Degraded/recovered transitions are also written to syslog (edge-triggered,
+ * throttled per radio) so interference events leave a timestamped trail even
+ * when nobody has the Wireless page open; the /tmp JSON is RAM-only and
+ * invisible otherwise.
+ *
  * It is deliberately READ-ONLY: it never sets a chanspec, never restarts
  * wireless, never hops off-channel. When a radio's undecodable-energy (nopkt)
  * stays high it raises a soft "degraded" advisory - the remedy is the user
@@ -38,6 +43,7 @@
 #define RCHQ_TICK	10		/* seconds between passive samples */
 #define RCHQ_MAXUNIT	3		/* quad-band ceiling */
 #define RCHQ_DEGRADED	20		/* smoothed nopkt %% at/above = degraded advisory */
+#define RCHQ_LOG_HOLDOFF 900		/* min seconds between repeat degraded syslogs per radio */
 
 static volatile sig_atomic_t running = 1;
 static void on_term(int sig) { (void)sig; running = 0; }
@@ -46,6 +52,12 @@ static void on_term(int sig) { (void)sig; running = 0; }
 static int ewma_nopkt[RCHQ_MAXUNIT + 1];
 static int have_ewma[RCHQ_MAXUNIT + 1];
 
+/* syslog trail state: what was last announced, and when, per radio. A radio
+ * flapping around the threshold inside RCHQ_LOG_HOLDOFF stays silent (its
+ * recovery line is withheld too, so the log never shows an orphan pair). */
+static int log_degraded[RCHQ_MAXUNIT + 1];
+static time_t log_last[RCHQ_MAXUNIT + 1];
+
 static int rchq_ifname(int unit, char *buf, size_t blen)
 {
 	char key[32];
@@ -146,7 +158,7 @@ int main(int argc, char **argv)
 				if (!rchq_ifname(unit, ifname, sizeof(ifname)))
 					continue;
 				snprintf(rkey, sizeof(rkey), "wl%d_radio", unit);
-				if (!nvram_get_int(rkey)) { have_ewma[unit] = 0; continue; }
+				if (!nvram_get_int(rkey)) { have_ewma[unit] = 0; log_degraded[unit] = 0; continue; }
 				if (!rchq_sample(ifname, &nopkt, &txop, &glitch))
 					continue;
 				rchq_chanspec(ifname, cs, sizeof(cs));
@@ -156,6 +168,23 @@ int main(int argc, char **argv)
 				else ewma_nopkt[unit] = (ewma_nopkt[unit] * 3 + nopkt) / 4;
 				degraded = (ewma_nopkt[unit] >= RCHQ_DEGRADED) ? 1 : 0;
 
+				if (degraded && !log_degraded[unit]) {
+					time_t now = time(NULL);
+					if (now - log_last[unit] >= RCHQ_LOG_HOLDOFF) {
+						syslog(LOG_WARNING,
+							"rchqd: wl%d (%s, %s) channel quality degraded - avg nopkt %d%% (threshold %d%%); run Auto Scan on the Wireless page for a cleaner channel",
+							unit, ifname, cs[0] ? cs : "?",
+							ewma_nopkt[unit], RCHQ_DEGRADED);
+						log_last[unit] = now;
+						log_degraded[unit] = 1;
+					}
+				} else if (!degraded && log_degraded[unit]) {
+					syslog(LOG_NOTICE,
+						"rchqd: wl%d (%s, %s) channel quality recovered - avg nopkt %d%%",
+						unit, ifname, cs[0] ? cs : "?", ewma_nopkt[unit]);
+					log_degraded[unit] = 0;
+				}
+
 				fprintf(f, "%s{\"unit\":%d,\"ifname\":", first ? "" : ",", unit);
 				j_str(f, ifname);
 				fprintf(f, ",\"chanspec\":");
-- 
2.25.1

