+<div id="ovl" role="alert" aria-busy="true">
+  <div class="ovlbox">
+    <div class="spin"></div>
+    <h3><#RDIAG_29#><span id="dots">.</span></h3>
+    <p><#RDIAG_30#></p>
+  </div>
+</div>
+
+<script>
+(function(){
+  var MODEL = '<% nvram_get("productid"); %>' || 'router';
+  function fname(){
+    var d=new Date(), p=function(n){return (n<10?'0':'')+n};
+    return 'reaper_diag_'+MODEL+'_'+d.getFullYear()+p(d.getMonth()+1)+p(d.getDate())+'_'+p(d.getHours())+p(d.getMinutes())+p(d.getSeconds())+'.txt';
+  }
+  document.getElementById('fn').textContent = 'reaper_diag_'+MODEL+'_....txt';
+
+  var busy=false, dotT=null;
+  function overlay(on){
+    var o=document.getElementById('ovl'), de=document.getElementById('dots');
+    if(on){
+      o.classList.add('show');
+      var n=1; de.textContent='.';
+      dotT=setInterval(function(){ n=n%3+1; de.textContent='...'.slice(0,n); },450);
+    }else{
+      o.classList.remove('show');
+      if(dotT){ clearInterval(dotT); dotT=null; }
+    }
+  }
+  document.getElementById('dl').addEventListener('click', function(){
+    if(busy) return;
+    busy=true;
+    var btn=this, err=document.getElementById('dlerr');
+    btn.disabled=true; err.style.display='none';
+    overlay(true);
+    var x=new XMLHttpRequest();
+    x.open('GET','/reaper_diag.cgi?_='+Date.now(), true);
+    x.timeout=180000;
+    x.onreadystatechange=function(){
+      if(x.readyState!==4) return;
+      overlay(false); busy=false; btn.disabled=false;
+      var t=x.responseText||'';
+      if(x.status===200 && t.length>200 && t.indexOf('ERROR:')!==0){
+        var a=document.createElement('a');
+        a.href=URL.createObjectURL(new Blob([t],{type:'text/plain'}));
+        a.download=fname();
+        document.body.appendChild(a); a.click();
+        setTimeout(function(){ URL.revokeObjectURL(a.href); a.remove(); },2000);
+      }else{
+        err.style.display='block';
+      }
+    };
+    x.ontimeout=function(){ overlay(false); busy=false; btn.disabled=false; document.getElementById('dlerr').style.display='block'; };
+    x.send();
+  });
+})();
+</script>
+</body>
+</html>
