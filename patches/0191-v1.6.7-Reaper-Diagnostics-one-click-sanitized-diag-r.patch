+.lede{max-width:68ch;margin:8px 0 18px;color:var(--bone-dim)}
+.lede b{color:var(--bone);font-weight:600}
+.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(290px,1fr));gap:14px;margin:0 0 16px;max-width:1060px}
+.card{background:var(--panel);border:1px solid var(--line-soft);border-radius:12px;padding:16px 18px}
+.card h2{font-size:14px;text-transform:uppercase;letter-spacing:.1em;margin-bottom:10px;padding-bottom:8px;border-bottom:1px solid var(--line-soft)}
+.card h2.red{color:var(--crimson)}
+.card ul{list-style:none;padding:0;display:flex;flex-direction:column;gap:7px;font-size:12.5px}
+.card li{padding-left:16px;position:relative}
+.card li::before{content:"";position:absolute;left:2px;top:7px;width:5px;height:5px;border-radius:50%;background:var(--steel)}
+.card.keep li::before{background:var(--jade)}
+.card.mask li::before{background:var(--crimson)}
+.card li b{color:var(--bone);font-weight:600}
+.tok{font-family:ui-monospace,Consolas,monospace;font-size:11px;color:var(--bone);background:var(--panel-2);border:1px solid var(--line-soft);border-radius:5px;padding:1px 5px;white-space:nowrap}
+.ledger{background:var(--panel);border:1px solid var(--line-soft);border-radius:12px;padding:16px 18px;margin-bottom:16px;max-width:1060px}
+.ledger h2{font-size:14px;text-transform:uppercase;letter-spacing:.1em;margin-bottom:8px}
+.ledger p{font-size:12.5px;max-width:70ch;margin:0 0 10px}
+pre.sample{background:#050506;border:1px solid var(--line-soft);border-radius:8px;padding:12px 14px;overflow-x:auto;font-size:11px;line-height:1.6;color:var(--bone-dim);font-family:ui-monospace,Consolas,monospace}
+pre.sample .g{color:var(--jade)} pre.sample .r{color:#e0837d} pre.sample .w{color:var(--bone)}
+.dlrow{display:flex;align-items:center;gap:18px;flex-wrap:wrap;background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:18px;max-width:1060px}
+.btn{font-family:var(--hdr);font-weight:600;letter-spacing:.07em;text-transform:uppercase;font-size:13px;color:var(--bone);background:linear-gradient(180deg,rgba(225,6,0,.28),rgba(225,6,0,.10));border:1px solid var(--crimson-deep);border-radius:9px;padding:11px 26px;cursor:pointer}
+.btn:hover{background:linear-gradient(180deg,rgba(225,6,0,.42),rgba(225,6,0,.16))}
