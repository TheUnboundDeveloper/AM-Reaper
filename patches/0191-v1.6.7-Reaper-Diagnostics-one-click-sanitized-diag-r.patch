diff --git a/release/src/router/httpd/web.c b/release/src/router/httpd/web.c
index 552d6bc720..0c13bb1e7e 100644
--- a/release/src/router/httpd/web.c
+++ b/release/src/router/httpd/web.c
@@ -21605,6 +21605,57 @@ do_set_ASUS_NEW_EULA_cgi(char *url, FILE *stream)
 /* reaper v1.2.7: do_set_ASUS_EULA_cgi removed - legacy app-only EULA setter with zero www callers;
  * EULA pre-signed in defaults.c. The modern set_ASUS_NEW_EULA.cgi path is KEPT (QIS wizard/AiMesh + httpApi.newEula). */
 
+/* reaper v1.6.7: sanitized diagnostic report download (Reaper_Diag.asp).
+ * Runs the baked /usr/sbin/reaper_diag collector and streams its plain-text
+ * report to the browser. The collector prints the report path on its final
+ * lines; only a path under /tmp/reaper_diag_ is accepted. A lockfile (stale
+ * after 180 s) rejects overlapping runs - the page also disables the button
+ * client-side. No request input is consumed (url ignored). On failure the
+ * body starts with ERROR: which the page JS surfaces instead of saving. */
+static void
+do_reaper_diag_cgi(char *url, FILE *stream)
+{
+	FILE *p, *f;
+	char line[256], path[128], buf[4096];
+	size_t n;
+	struct stat st;
+	const char *lock = "/tmp/.reaper_diag_busy";
+
+	path[0] = '\0';
+
+	if (stat(lock, &st) == 0 && (time(NULL) - st.st_mtime) < 180) {
+		websWrite(stream, "ERROR: a diagnostic collection is already running. Try again shortly.\n");
+		return;
+	}
+	if ((f = fopen(lock, "w")) != NULL)
+		fclose(f);
+
+	if ((p = popen("/usr/sbin/reaper_diag 2>/dev/null", "r")) != NULL) {
+		while (fgets(line, sizeof(line), p)) {
+			char *m = strstr(line, "written to: ");
+			if (m != NULL) {
+				snprintf(path, sizeof(path), "%s", m + 12);
+				m = strchr(path, '\n');
+				if (m != NULL)
+					*m = '\0';
+			}
+		}
+		pclose(p);
+	}
+
+	unlink(lock);
+
+	if (path[0] == '\0' || strncmp(path, "/tmp/reaper_diag_", 17) != 0 ||
+	    strstr(path, "..") != NULL || (f = fopen(path, "r")) == NULL) {
+		websWrite(stream, "ERROR: diagnostic collection failed. Check the system log and try again.\n");
+		return;
+	}
+	while ((n = fread(buf, 1, sizeof(buf), f)) > 0)
+		fwrite(buf, 1, n, stream);
+	fclose(f);
+	unlink(path);
+}
+
 /* reaper QoS v3: per-class egress queue counters for the Reaper_QoS.asp live
  * stats tiles. Reads tmctl getqstats for WAN qids 0..6 and emits JSON. No
  * request input is consumed (url ignored); the only interpolated value is the
@@ -29888,6 +29939,7 @@ struct mime_handler mime_handlers[] =
 	{ "reaper_qos_stats.cgi*", "text/html", no_cache_IE7, do_html_post_and_get, do_reaper_qos_stats_cgi, do_auth },
 	{ "reaper_traffic.cgi*", "text/html", no_cache_IE7, do_html_post_and_get, do_reaper_traffic_cgi, do_auth },
 	{ "reaper_wifi.cgi*", "text/html", no_cache_IE7, do_html_post_and_get, do_reaper_wifi_cgi, do_auth },
+	{ "reaper_diag.cgi*", "text/plain", no_cache_IE7, do_html_post_and_get, do_reaper_diag_cgi, do_auth },
 #ifdef RTCONFIG_REAPER_MCP
 	{ "reaper_mcp.cgi*", "text/html", no_cache_IE7, do_html_post_and_get, do_reaper_mcp_cgi, do_auth },
 #endif
