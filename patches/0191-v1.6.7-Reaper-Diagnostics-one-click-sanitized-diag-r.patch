+.dlhint .dlwarn{display:block;margin-top:6px;color:var(--bone);font-weight:500}
+.dlerr{display:none;margin-top:10px;color:var(--danger);font-size:12.5px;max-width:1060px}
+.assure{display:flex;gap:22px;flex-wrap:wrap;margin:14px 2px 0;font-size:12px;max-width:1060px}
+.assure span{display:flex;align-items:center;gap:7px}
