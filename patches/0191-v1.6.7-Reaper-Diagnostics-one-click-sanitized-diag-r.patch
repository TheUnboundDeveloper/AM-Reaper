+#ovl{position:fixed;inset:0;background:rgba(4,4,5,.82);display:none;align-items:center;justify-content:center;z-index:50}
+#ovl.show{display:flex}
+.ovlbox{background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:30px 38px;text-align:center;max-width:380px}
