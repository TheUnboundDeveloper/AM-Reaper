index 0000000000..3ff8391569
--- /dev/null
+++ b/release/src/router/others/reaper_diag
@@ -0,0 +1,312 @@
+#!/bin/sh
+# ============================================================================
+#  REAPER-DIAG v1.0 (2026-07-20) - sanitized one-shot diagnostic bundle
+#  Runs on ANY Reaper model (RT-BE96U / RT-BE86U / RT-BE88U / GT-BE98 /
+#  GT-BE98_PRO) - radios, ports and features are discovered at runtime.
+#
+#  PRIVACY BY ARCHITECTURE: everything is gathered raw into a private temp
+#  file, then pushed through ONE sanitizer pass before anything is written
+#  to the report. The report NEVER contains:
+#    - passwords / PSKs / keys / tokens  (presence reported as SET/EMPTY)
+#    - usernames, DDNS/host names, SSID values (consistent [USER-n]/[SSID-n])
+#    - any MAC address, router or client   (consistent MAC-n pseudonyms)
+#    - any public IPv4 / any IPv6 address  (consistent [EXT-IP-n]/[IP6-n])
+#  RFC1918/loopback/link-local IPv4 and channel/RF/QoS numbers are kept -
+#  they are the diagnostic payload and identify nothing.
+#  Pseudonyms are stable WITHIN one report (cross-referencing works) and
+#  meaningless across reports.
+# ============================================================================
+PATH=/sbin:/bin:/usr/sbin:/usr/bin
+VER="REAPER-DIAG v1.0"
+MODEL="$(nvram get productid 2>/dev/null)"
+EXTNO="$(nvram get extendno 2>/dev/null)"
+STAMP="$(date +%Y%m%d_%H%M%S)"
+RAW="/tmp/.rdiag_raw.$$"
+SLIST="/tmp/.rdiag_secrets.$$"
+AWKP="/tmp/.rdiag_awk.$$"
+BODY="/tmp/.rdiag_body.$$"
+LEDG="/tmp/.rdiag_ledger.$$"
+OUT="/tmp/reaper_diag_${MODEL}_${STAMP}.txt"
+umask 077
+trap 'rm -f $RAW $SLIST $SLIST.s $AWKP $BODY $LEDG' EXIT
+
+sec() { echo ""; echo "#### $1 ####"; }
+have() { command -v "$1" >/dev/null 2>&1; }
+setchk() { v="$(nvram get "$1" 2>/dev/null)"; [ -n "$v" ] && echo "  $1 : SET (redacted)" || echo "  $1 : EMPTY"; }
+
+# ---------------------------------------------------------------------------
+# 1. Collect sensitive literals -> $SLIST as "CLASS<TAB>value" (never printed)
+# ---------------------------------------------------------------------------
+nvram show 2>/dev/null | awk -F= '
+  /^[A-Za-z0-9_.]+=/ {
+    k=$1; sub(/^[^=]*=/,""); v=$0
+    if (length(v) < 3) next
+    if (v ~ /^[0-9]+$/ && length(v) < 6) next
+    cls=""
+    if (k ~ /passwd|password|_psk|wpa_psk|_key[0-9]?$|radius_key|_secret|secret_|token|private|pincode|pin_code|_pin$|wps_.*pin|serial_no|acc_list|auth_pass/) cls="SEC"
+    else if (k ~ /username|_user$|_account|http_username|login_name/) cls="USR"
+    else if (k ~ /_ssid$/) cls="SSID"
+    else if (k ~ /ddns_hostname|_hostname$|computer_name|lan_domain|ddns_username/) cls="HOST"
+    if (cls != "") print cls "\t" v
+  }' > "$SLIST" 2>/dev/null
+# DHCP client hostnames (dnsmasq leases field 4)
+for LF in /var/lib/misc/dnsmasq.leases /tmp/var/lib/misc/dnsmasq.leases /jffs/nmp/dnsmasq.leases; do
+  [ -f "$LF" ] && awk '{ if ($4 != "*" && length($4) >= 3) print "HOST\t" $4 }' "$LF" >> "$SLIST" 2>/dev/null && break
+done
+# longest-first so partial overlaps can not leak (dedupe must PRESERVE that order)
+awk -F'\t' '{ print length($2) "\t" $0 }' "$SLIST" | sort -rn | cut -f2- | awk '!seen[$0]++' > "$SLIST.s"
+
+# ---------------------------------------------------------------------------
+# 2. Sanitizer (busybox awk) - literals, MACs, IPv6, public IPv4
+# ---------------------------------------------------------------------------
+cat > "$AWKP" <<'AWKEOF'
+BEGIN {
+  n = 0
+  while ((getline l < SFILE) > 0) {
+    t = index(l, "\t"); if (t < 2) continue
+    n++; CLS[n] = substr(l, 1, t-1); VAL[n] = substr(l, t+1)
+  }
+  cS=0; cU=0; cW=0; cH=0; cM=0; c6=0; c4=0
+}
+function toklit(cls, v) {
+  if (v in LMAP) return LMAP[v]
+  if (cls=="SEC")  { cS++; LMAP[v]="[REDACTED-SECRET-" cS "]" }
+  else if (cls=="USR")  { cU++; LMAP[v]="[USER-" cU "]" }
+  else if (cls=="SSID") { cW++; LMAP[v]="[SSID-" cW "]" }
+  else { cH++; LMAP[v]="[HOST-" cH "]" }
+  return LMAP[v]
+}
+function privip(ip,  a) {
+  if (ip == FWVER) return 1
+  split(ip, a, ".")
+  if (a[1]>255||a[2]>255||a[3]>255||a[4]>255) return 1
+  if (a[1]==10 || a[1]==127 || a[1]==0) return 1
+  if (a[1]==192 && a[2]==168) return 1
+  if (a[1]==172 && a[2]>=16 && a[2]<=31) return 1
+  if (a[1]==169 && a[2]==254) return 1
+  if (a[1]>=224) return 1
+  return 0
+}
+{
+  line = $0
+  # pass 1: sensitive literal values (longest first from sorted list)
+  for (i = 1; i <= n; i++) {
+    v = VAL[i]
+    while ((p = index(line, v)) > 0)
+      line = substr(line, 1, p-1) toklit(CLS[i], v) substr(line, p + length(v))
+  }
+  # pass 2: MAC addresses -> MAC-n
+  out = ""
+  while (match(line, /[0-9a-fA-F][0-9a-fA-F]:[0-9a-fA-F][0-9a-fA-F]:[0-9a-fA-F][0-9a-fA-F]:[0-9a-fA-F][0-9a-fA-F]:[0-9a-fA-F][0-9a-fA-F]:[0-9a-fA-F][0-9a-fA-F]/)) {
+    m = toupper(substr(line, RSTART, RLENGTH))
+    if (!(m in MMAP)) { cM++; MMAP[m] = "MAC-" cM }
+    out = out substr(line, 1, RSTART-1) MMAP[m]
+    line = substr(line, RSTART + RLENGTH)
+  }
+  line = out line
+  # pass 3: IPv6 (compressed :: forms and long full forms) -> [IP6-n]
+  out = ""
+  while (match(line, /[0-9a-fA-F][0-9a-fA-F:]*::[0-9a-fA-F:.]*[0-9a-fA-F]|[0-9a-fA-F]+:[0-9a-fA-F]+:[0-9a-fA-F]+:[0-9a-fA-F]+:[0-9a-fA-F]+:[0-9a-fA-F]+:[0-9a-fA-F:.]+/)) {
+    m = substr(line, RSTART, RLENGTH)
+    if (!(m in M6)) { c6++; M6[m] = "[IP6-" c6 "]" }
+    out = out substr(line, 1, RSTART-1) M6[m]
+    line = substr(line, RSTART + RLENGTH)
+  }
+  line = out line
+  # pass 4: IPv4 - keep private/loopback/multicast/masks, token the rest
+  out = ""
+  while (match(line, /[0-9][0-9]*\.[0-9][0-9]*\.[0-9][0-9]*\.[0-9][0-9]*/)) {
+    m = substr(line, RSTART, RLENGTH)
+    if (privip(m)) rep = m
+    else { if (!(m in M4)) { c4++; M4[m] = "[EXT-IP-" c4 "]" }; rep = M4[m] }
+    out = out substr(line, 1, RSTART-1) rep
+    line = substr(line, RSTART + RLENGTH)
+  }
+  print out line
+}
+END {
+  print "  secrets redacted           : " cS   > "/dev/stderr"
+  print "  usernames redacted         : " cU   > "/dev/stderr"
+  print "  SSID values redacted       : " cW   > "/dev/stderr"
+  print "  hostnames redacted         : " cH   > "/dev/stderr"
+  print "  MAC addresses pseudonymized: " cM   > "/dev/stderr"
+  print "  IPv6 addresses redacted    : " c6   > "/dev/stderr"
+  print "  public IPv4 redacted       : " c4   > "/dev/stderr"
+}
+AWKEOF
+
+# ---------------------------------------------------------------------------
+# 3. Gather (raw; sanitized afterwards)
+# ---------------------------------------------------------------------------
+{
+sec "1. IDENTITY / VERSION"
+echo "  diag: $VER   generated: $(date)"
+echo "  uptime/load: $(uptime)"
+echo "  uname: $(uname -a)"
+for k in productid model odmpid build_name firmver buildno extendno territory_code sw_mode re_mode; do
+  echo "  $k = $(nvram get $k 2>/dev/null)"
+done
+
+sec "2. CREDENTIAL / IDENTITY PRESENCE (values withheld by design)"
+setchk http_username; setchk http_passwd
+setchk wan0_pppoe_username; setchk wan0_pppoe_passwd
+setchk ddns_enable_x; setchk ddns_hostname_x
+u=0; while [ $u -le 3 ]; do
+  [ -n "$(nvram get wl${u}_ifname 2>/dev/null)" ] && setchk wl${u}_wpa_psk
+  u=$((u+1))
+done
+
+sec "3. SYSTEM"
+echo "  loadavg: $(cat /proc/loadavg 2>/dev/null)"
+head -4 /proc/meminfo 2>/dev/null | sed 's/^/  /'
+echo "  -- storage --"; df -h 2>/dev/null | sed 's/^/  /'
+echo "  -- jffs/usb mounts --"; mount 2>/dev/null | grep -E "jffs|/mnt|usb|sd[a-z]" | sed 's/^/  /'
+echo "  -- top (snapshot) --"; top -bn1 2>/dev/null | head -12 | sed 's/^/  /'
+
+sec "4. LAN / BRIDGE"
+for k in lan_proto lan_ipaddr lan_netmask lan_ifname lan_ifnames lanports wanports dhcp_enable_x dhcp_start dhcp_end; do
+  echo "  $k = $(nvram get $k 2>/dev/null)"
+done
+echo "  -- brctl show --"; brctl show 2>/dev/null | sed 's/^/  /'
+echo "  -- br0 addrs --"; ifconfig br0 2>/dev/null | grep -E "inet|HWaddr" | sed 's/^/  /'
+
+sec "5. WAN"
+for k in wans_dualwan wan0_proto wan0_state_t wan0_sbstate_t wan0_auxstate_t link_wan switch_wantag; do
+  echo "  $k = $(nvram get $k 2>/dev/null)"
+done
+WIP="$(nvram get wan0_ipaddr 2>/dev/null)"
+case "$WIP" in
+  10.*|192.168.*|172.1[6-9].*|172.2[0-9].*|172.3[01].*) echo "  wan0 IPv4: PRIVATE/CGN-or-LAN-range ($WIP)";;
+  ""|0.0.0.0) echo "  wan0 IPv4: NONE";;
+  *) echo "  wan0 IPv4: PUBLIC (present, redacted; mask $(nvram get wan0_netmask 2>/dev/null))";;
+esac
+echo "  -- DNS in use --"
+for d in $(nvram get wan0_dns 2>/dev/null) $(nvram get wan0_xdns 2>/dev/null) $(awk '/^nameserver/{print $2}' /etc/resolv.conf 2>/dev/null); do
+  case "$d" in
+    1.1.1.*|1.0.0.*) echo "  resolver: Cloudflare family ($d)";;
+    8.8.8.8|8.8.4.4) echo "  resolver: Google";;
+    9.9.9.*|149.112.112.*) echo "  resolver: Quad9";;
+    94.140.14.*|94.140.15.*) echo "  resolver: AdGuard";;
+    208.67.2*) echo "  resolver: OpenDNS";;
+    10.*|192.168.*|172.1[6-9].*|172.2[0-9].*|172.3[01].*|127.*) echo "  resolver: LAN-local ($d)";;
+    "") ;;
+    *) echo "  resolver: other-external (redacted)";;
+  esac
+done
+echo "  -- routes --"; ip route 2>/dev/null | sed 's/^/  /'
+
+sec "6. IPV6"
+echo "  ipv6_service = $(nvram get ipv6_service 2>/dev/null)"
+V6="$(ifconfig br0 2>/dev/null | grep -c 'Scope:Global')"
+echo "  br0 global IPv6: $( [ "${V6:-0}" -gt 0 ] && echo "PRESENT x$V6 (redacted)" || echo none )"
+
+sec "7. WIRELESS (radios discovered at runtime)"
+u=0; while [ $u -le 3 ]; do
+  IFN="$(nvram get wl${u}_ifname 2>/dev/null)"
+  [ -z "$IFN" ] && { u=$((u+1)); continue; }
+  NB="$(nvram get wl${u}_nband 2>/dev/null)"
+  case "$NB" in 1) BAND=5G;; 2) BAND=2.4G;; 4) BAND=6G;; *) BAND="nband=$NB";; esac
+  echo "  -- unit $u  ifname=$IFN  band=$BAND --"
+  echo "     radio_on=$(nvram get wl${u}_radio 2>/dev/null)  closed=$(nvram get wl${u}_closed 2>/dev/null)  country=$(nvram get wl${u}_country_code 2>/dev/null)"
+  echo "     chanspec: $(wl -i $IFN chanspec 2>/dev/null)"
+  S="$(nvram get wl${u}_ssid 2>/dev/null)"
+  SL=${#S}
+  case "$S" in
+    *[!0-9A-Fa-f]*) SC="normal";;
+    "") SC="empty";;
+    *) [ "$SL" = "32" ] && SC="32-HEX (machine-generated? check for nvram residue)" || SC="hex-only";;
+  esac
+  echo "     ssid: [see SSID token] len=$SL charset=$SC"
+  AC="$(wl -i $IFN assoclist 2>/dev/null | wc -l)"
+  echo "     associated stations: ${AC:-0}"
+  wl -i $IFN chanim_stats 2>/dev/null | head -4 | sed 's/^/     chanim: /'
+  # per-station diagnostic detail (MACs pseudonymized by the sanitizer)
+  wl -i $IFN assoclist 2>/dev/null | awk '{print $2}' | while read M; do
+    echo "     .. sta $M:"
+    wl -i $IFN sta_info "$M" 2>/dev/null | grep -E "rate of last|rssi|smoothed|PS :|idle|in network|flags|link bandwidth|tx pkts:|tx failures" | sed 's/^/        /'
+  done
+  # guest / extra VIFs on this unit
+  for VIF in $(nvram get wl${u}_vifs 2>/dev/null); do
+    VAC="$(wl -i $VIF assoclist 2>/dev/null | wc -l)"
+    echo "     vif $VIF: up=$(ifconfig $VIF 2>/dev/null | grep -c UP) stations=${VAC:-0} ssid_len=$(nvram get ${VIF}_ssid 2>/dev/null | wc -c)"
+  done
+  u=$((u+1))
+done
+
+sec "8. WIRED PORTS"
+for E in /sys/class/net/eth*; do
+  [ -e "$E" ] || continue
+  P="${E##*/}"
+  CAR="$(cat $E/carrier 2>/dev/null)"; SPD="$(cat $E/speed 2>/dev/null)"
+  echo "  -- $P  carrier=$CAR speed=${SPD}Mb/s --"
+  have ethctl && ethctl $P media-type 2>/dev/null | head -6 | sed 's/^/     /'
+done
+
+sec "9. FLOW ACCELERATION"
+have fc && fc status 2>/dev/null | head -14 | sed 's/^/  /'
+have fcctl && echo "  active flows: $(fcctl status 2>/dev/null | grep -i -m1 flow)"
+
+sec "10. QOS (engine + hardware readbacks)"
+for k in qos_enable qos_type qos_obw qos_ibw qos_pshaper qos_minrates qos_dscp_trust qos_ipolicer qos_dscp_wmm qos_sched qos_orates; do
+  echo "  $k = $(nvram get $k 2>/dev/null)"
+done
+WANIF="$(nvram get wan0_ifname 2>/dev/null)"; [ -z "$WANIF" ] && WANIF=eth0
+if have tmctl; then
+  echo "  -- tmctl portshaper ($WANIF) --"; tmctl getportshaper --devtype 0 --if $WANIF 2>/dev/null | sed 's/^/     /'
+  echo "  -- tmctl portrxrate ($WANIF) --"; tmctl getportrxrate --devtype 0 --if $WANIF 2>/dev/null | sed 's/^/     /'
+  q=0; while [ $q -le 6 ]; do
+    echo "  -- qcfg qid $q --"; tmctl getqcfg --devtype 0 --if $WANIF --qid $q 2>/dev/null | head -3 | sed 's/^/     /'
+    q=$((q+1))
+  done
+fi
+
+sec "11. DHCP LEASES (identities pseudonymized)"
+for LF in /var/lib/misc/dnsmasq.leases /tmp/var/lib/misc/dnsmasq.leases; do
+  if [ -f "$LF" ]; then
+    echo "  lease count: $(wc -l < $LF)"
+    sed 's/^/  /' "$LF"
+    break
+  fi
+done
+
+sec "12. PROCESSES / LISTENING SOCKETS"
+ps w 2>/dev/null | sed 's/^/  /'
+echo "  -- listeners --"
+netstat -tuln 2>/dev/null | sed 's/^/  /'
+
+sec "13. ADDONS / JFFS"
+echo "  jffs scripts: $(ls /jffs/scripts 2>/dev/null | tr '\n' ' ')"
+echo "  entware: $( [ -d /opt/bin ] && echo present || echo absent )"
+echo "  amtm-ish mounts: $(mount 2>/dev/null | grep -c /tmp/mnt)"
+
+sec "14. KERNEL LOG (tail)"
+dmesg 2>/dev/null | tail -120 | sed 's/^/  /'
+
+sec "15. SYSLOG (tail)"
+tail -150 /tmp/syslog.log 2>/dev/null | sed 's/^/  /'
+
+echo ""; echo "#### END OF DIAG ####"
+} > "$RAW" 2>&1
+
+# ---------------------------------------------------------------------------
+# 4. Sanitize + assemble
+# ---------------------------------------------------------------------------
+awk -v SFILE="$SLIST.s" -v FWVER="$(nvram get firmver 2>/dev/null)" -f "$AWKP" "$RAW" > "$BODY" 2> "$LEDG"
+
+{
+  echo "==================== $MODEL Reaper sanitized diag ===================="
+  echo " $VER | firmware: $EXTNO | generated: $(date)"
+  echo ""
+  echo "#### 0. SANITIZATION LEDGER (what was found and withheld) ####"
+  cat "$LEDG"
+  echo "  NOTE: pseudonyms (MAC-n / [EXT-IP-n] / [SSID-n] ...) are consistent"
+  echo "  within this report only. No credentials, MACs, host/user names or"
+  echo "  external IPs are contained in this file. Safe to post publicly."
+  cat "$BODY"
+  echo "==================== end diag $(date) ===================="
+} > "$OUT"
+
+chmod 600 "$OUT"
+echo ""
+echo "Sanitized diagnostic written to: $OUT"
+echo "$(wc -l < "$OUT") lines. Review ledger at top; safe to share as-is."
