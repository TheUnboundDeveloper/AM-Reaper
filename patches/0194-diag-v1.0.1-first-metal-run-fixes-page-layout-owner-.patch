 #ovl{position:fixed;inset:0;background:rgba(4,4,5,.82);display:none;align-items:center;justify-content:center;z-index:50}
 #ovl.show{display:flex}
 .ovlbox{background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:30px 38px;text-align:center;max-width:380px}
@@ -72,7 +69,7 @@ pre.sample .g{color:var(--jade)} pre.sample .r{color:#e0837d} pre.sample .w{colo
 
 <div class="pagehead">
   <h1><#RDIAG_00#></h1>
-  <span class="ver"><#RDIAG_01#> &middot; REAPER-DIAG v1.0</span>
+  <span class="ver"><#RDIAG_01#> &middot; REAPER-DIAG v1.0.1</span>
 </div>
 <p class="lede"><#RDIAG_02#></p>
 
@@ -111,6 +108,8 @@ pre.sample .g{color:var(--jade)} pre.sample .r{color:#e0837d} pre.sample .w{colo
 
 <div class="ledger">
   <h2><#RDIAG_21#></h2>
+  <div class="ledgrid">
