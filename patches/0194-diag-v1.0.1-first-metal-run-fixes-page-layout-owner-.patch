From bb6278a40c2a7442300c51e837cb0c8a4d3a49ea Mon Sep 17 00:00:00 2001
From: reaper <theunbounddeveloper@outlook.com>
Date: Mon, 20 Jul 2026 20:22:01 -0400
Subject: [PATCH] diag v1.0.1: first-metal-run fixes + page layout (owner
 request)

Collector (field report from the owner's RT-BE96U v1.6.7 run):
- FIX LEAK: bare 12-hex colonless MACs (bridge ids, serial: daemon args) are
  now pseudonymized, mapping to the SAME MAC-n token as their colon form;
  full-run matching keeps 16-hex kernel pointers and all-digit counters intact
- over-redaction: min literal length 3->5; protect list for the model name and
  ASUS/ASUSWRT (lan_hostname defaults to the model, which had redacted
  productid and mangled ASUSWRT-Merlin)
- have() switched from "command -v" (absent in on-router busybox ash - left
  fc/fcctl/tmctl/ethctl sections empty on metal) to "type"
- per-station detail now gathered on VIFs too (MULTILAN builds put user
  networks and their stations on VIFs, not the primary)
- http_passwd presence reported as PROTECTED (CKN_ENC_SVR encrypted nvram is
  deliberately not shell-readable) instead of a misleading EMPTY
- 32-hex physical SSID note reworded: normal internal radio id on this
  firmware, user networks broadcast from VIF profiles (owner's healthy BE96U
  confirmed; closes the GT-BE98 residue question)

Page: download button moves up beside the ledger example; the hint text,
do-not-navigate line and the three assurance checkmarks are removed (busy
overlay retains the stay-on-page message). RDIAG_24-28 dict tokens now
unused but retained for lockstep. Sanitizer regression harness re-run: zero
leaks, keep-list intact.
---
 release/src/router/others/reaper_diag  | 47 +++++++++++++++++++++-----
 release/src/router/www/Reaper_Diag.asp | 33 +++++++-----------
 2 files changed, 50 insertions(+), 30 deletions(-)

diff --git a/release/src/router/others/reaper_diag b/release/src/router/others/reaper_diag
index 3ff8391569..d9ff0d48c2 100755
--- a/release/src/router/others/reaper_diag
+++ b/release/src/router/others/reaper_diag
@@ -17,7 +17,7 @@
 #  meaningless across reports.
 # ============================================================================
 PATH=/sbin:/bin:/usr/sbin:/usr/bin
-VER="REAPER-DIAG v1.0"
+VER="REAPER-DIAG v1.0.1"
 MODEL="$(nvram get productid 2>/dev/null)"
 EXTNO="$(nvram get extendno 2>/dev/null)"
 STAMP="$(date +%Y%m%d_%H%M%S)"
@@ -31,7 +31,7 @@ umask 077
 trap 'rm -f $RAW $SLIST $SLIST.s $AWKP $BODY $LEDG' EXIT
 
 sec() { echo ""; echo "#### $1 ####"; }
-have() { command -v "$1" >/dev/null 2>&1; }
+have() { type "$1" >/dev/null 2>&1; }  # v1.0.1: on-router busybox ash lacks "command -v"
 setchk() { v="$(nvram get "$1" 2>/dev/null)"; [ -n "$v" ] && echo "  $1 : SET (redacted)" || echo "  $1 : EMPTY"; }
 
 # ---------------------------------------------------------------------------
@@ -40,7 +40,7 @@ setchk() { v="$(nvram get "$1" 2>/dev/null)"; [ -n "$v" ] && echo "  $1 : SET (r
 nvram show 2>/dev/null | awk -F= '
   /^[A-Za-z0-9_.]+=/ {
     k=$1; sub(/^[^=]*=/,""); v=$0
-    if (length(v) < 3) next
+    if (length(v) < 5) next
     if (v ~ /^[0-9]+$/ && length(v) < 6) next
     cls=""
     if (k ~ /passwd|password|_psk|wpa_psk|_key[0-9]?$|radius_key|_secret|secret_|token|private|pincode|pin_code|_pin$|wps_.*pin|serial_no|acc_list|auth_pass/) cls="SEC"
@@ -51,10 +51,15 @@ nvram show 2>/dev/null | awk -F= '
   }' > "$SLIST" 2>/dev/null
 # DHCP client hostnames (dnsmasq leases field 4)
 for LF in /var/lib/misc/dnsmasq.leases /tmp/var/lib/misc/dnsmasq.leases /jffs/nmp/dnsmasq.leases; do
-  [ -f "$LF" ] && awk '{ if ($4 != "*" && length($4) >= 3) print "HOST\t" $4 }' "$LF" >> "$SLIST" 2>/dev/null && break
+  [ -f "$LF" ] && awk '{ if ($4 != "*" && length($4) >= 5) print "HOST\t" $4 }' "$LF" >> "$SLIST" 2>/dev/null && break
 done
-# longest-first so partial overlaps can not leak (dedupe must PRESERVE that order)
-awk -F'\t' '{ print length($2) "\t" $0 }' "$SLIST" | sort -rn | cut -f2- | awk '!seen[$0]++' > "$SLIST.s"
+# longest-first so partial overlaps can not leak (dedupe must PRESERVE that order).
+# v1.0.1 protect list: never treat the model name or the ASUS brand as a secret
+# literal - lan_hostname defaults to the model, which redacted productid and
+# mangled "ASUSWRT-Merlin" in the field. Min literal length is 5 (was 3) so a
+# short username like "nas" cannot hit inside words like "nasapps".
+awk -F'\t' '{ print length($2) "\t" $0 }' "$SLIST" | sort -rn | cut -f2- | awk '!seen[$0]++' | \
+  awk -F'\t' -v mdl="$MODEL" 'toupper($2)!=toupper(mdl) && toupper($2)!="ASUS" && toupper($2)!="ASUSWRT"' > "$SLIST.s"
 
 # ---------------------------------------------------------------------------
 # 2. Sanitizer (busybox awk) - literals, MACs, IPv6, public IPv4
@@ -104,6 +109,23 @@ function privip(ip,  a) {
     line = substr(line, RSTART + RLENGTH)
   }
   line = out line
+  # pass 2b (v1.0.1): bare 12-hex runs = colonless MACs (bridge ids like
+  # 8000.107c6185fef0, "serial:..." daemon args) - field-observed leak. Full
+  # hex runs are matched so a 12-char window inside a 16-char kernel pointer
+  # can not false-positive; all-digit 12-char runs are left alone unless the
+  # colonized form was already seen (protects long decimal counters).
+  out = ""
+  while (match(line, /[0-9a-fA-F][0-9a-fA-F]*/)) {
+    m = substr(line, RSTART, RLENGTH); rep = m
+    if (RLENGTH == 12 && (m ~ /[a-fA-F]/ || (toupper(substr(m,1,2)":"substr(m,3,2)":"substr(m,5,2)":"substr(m,7,2)":"substr(m,9,2)":"substr(m,11,2)) in MMAP))) {
+      cm = toupper(substr(m,1,2)":"substr(m,3,2)":"substr(m,5,2)":"substr(m,7,2)":"substr(m,9,2)":"substr(m,11,2))
+      if (!(cm in MMAP)) { cM++; MMAP[cm] = "MAC-" cM }
+      rep = MMAP[cm]
+    }
+    out = out substr(line, 1, RSTART-1) rep
+    line = substr(line, RSTART + RLENGTH)
+  }
+  line = out line
   # pass 3: IPv6 (compressed :: forms and long full forms) -> [IP6-n]
   out = ""
   while (match(line, /[0-9a-fA-F][0-9a-fA-F:]*::[0-9a-fA-F:.]*[0-9a-fA-F]|[0-9a-fA-F]+:[0-9a-fA-F]+:[0-9a-fA-F]+:[0-9a-fA-F]+:[0-9a-fA-F]+:[0-9a-fA-F]+:[0-9a-fA-F:.]+/)) {
@@ -148,7 +170,8 @@ for k in productid model odmpid build_name firmver buildno extendno territory_co
 done
 
 sec "2. CREDENTIAL / IDENTITY PRESENCE (values withheld by design)"
-setchk http_username; setchk http_passwd
+setchk http_username
+echo "  http_passwd : PROTECTED (encrypted nvram, not shell-readable by design)"
 setchk wan0_pppoe_username; setchk wan0_pppoe_passwd
 setchk ddns_enable_x; setchk ddns_hostname_x
 u=0; while [ $u -le 3 ]; do
@@ -214,7 +237,7 @@ u=0; while [ $u -le 3 ]; do
   case "$S" in
     *[!0-9A-Fa-f]*) SC="normal";;
     "") SC="empty";;
-    *) [ "$SL" = "32" ] && SC="32-HEX (machine-generated? check for nvram residue)" || SC="hex-only";;
+    *) [ "$SL" = "32" ] && SC="32-hex (NORMAL on this firmware: internal radio id; user networks broadcast from the VIF profiles)" || SC="hex-only";;
   esac
   echo "     ssid: [see SSID token] len=$SL charset=$SC"
   AC="$(wl -i $IFN assoclist 2>/dev/null | wc -l)"
@@ -225,10 +248,16 @@ u=0; while [ $u -le 3 ]; do
     echo "     .. sta $M:"
     wl -i $IFN sta_info "$M" 2>/dev/null | grep -E "rate of last|rssi|smoothed|PS :|idle|in network|flags|link bandwidth|tx pkts:|tx failures" | sed 's/^/        /'
   done
-  # guest / extra VIFs on this unit
+  # guest / extra VIFs on this unit. v1.0.1: on MULTILAN builds the user
+  # networks (and therefore the stations) live on the VIFs, so per-station
+  # detail is gathered here too, not just on the primary.
   for VIF in $(nvram get wl${u}_vifs 2>/dev/null); do
     VAC="$(wl -i $VIF assoclist 2>/dev/null | wc -l)"
     echo "     vif $VIF: up=$(ifconfig $VIF 2>/dev/null | grep -c UP) stations=${VAC:-0} ssid_len=$(nvram get ${VIF}_ssid 2>/dev/null | wc -c)"
+    wl -i $VIF assoclist 2>/dev/null | awk '{print $2}' | while read M; do
+      echo "     .. sta $M (on $VIF):"
+      wl -i $VIF sta_info "$M" 2>/dev/null | grep -E "rate of last|rssi|smoothed|PS :|idle|in network|flags|link bandwidth|tx pkts:|tx failures" | sed 's/^/        /'
+    done
   done
   u=$((u+1))
 done
