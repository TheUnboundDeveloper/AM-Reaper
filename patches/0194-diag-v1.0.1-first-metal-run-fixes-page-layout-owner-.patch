   <p><#RDIAG_22#></p>
   <pre class="sample"><span class="w">#### 0. SANITIZATION LEDGER (what was found and withheld) ####</span>
   secrets redacted           : <span class="g">2</span>
@@ -120,20 +119,12 @@ pre.sample .g{color:var(--jade)} pre.sample .r{color:#e0837d} pre.sample .w{colo
   public IPv4 redacted       : <span class="g">3</span>
   <span class="r">NOTE: no credentials, MACs, host/user names or external IPs
   are contained in this file. Safe to post publicly.</span></pre>
