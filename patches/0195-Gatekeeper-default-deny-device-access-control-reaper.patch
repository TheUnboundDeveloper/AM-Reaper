diff --git a/release/src/router/rc/gatekeeper.c b/release/src/router/rc/gatekeeper.c
new file mode 100644
index 0000000000..5eb684bb36
--- /dev/null
+++ b/release/src/router/rc/gatekeeper.c
@@ -0,0 +1,208 @@
+/* SPDX-License-Identifier: GPL-2.0-only
+ * Copyright (C) 2026 the Reaper project maintainer
+ *
+ * Gatekeeper (reaper v1.6.8) - default-deny device access control.
+ *
+ * Enforcement model (all driven from nvram gk_rl = "<MAC>state>expiry..."
+ * with state 0=block 1=full 2=internet-only 3=guest):
+ *
+ *   iptables/ip6tables FORWARD  REAPER_GKF  - internet gate. Approved MACs
+ *     RETURN, blocked MACs DROP, and in quarantine mode (gk_default=0) an
+ *     unknown MAC falls through to a terminal DROP. Hooked at position 1 so
+ *     no ESTABLISHED shortcut can bypass a revocation.
+ *   iptables/ip6tables INPUT    REAPER_GKI  - router-services gate. A held
+ *     or blocked device may only reach DHCP, DNS and HTTP (the captive
+ *     "awaiting approval" page); everything else to the router is dropped,
+ *     which also fences the admin UI off from unapproved devices.
+ *   iptables nat PREROUTING     REAPER_GKN  - captive redirect. Unknown
+ *     MACs get tcp/80 DNAT'd to httpd, whose pre-auth intercept serves the
+ *     waiting page (OS captive-portal probes are plain HTTP, so phones pop
+ *     the native sign-in sheet).
+ *   ebtables FORWARD            REAPER_GK   - LAN isolation at the bridge.
+ *     Only approved-FULL MACs may source bridged frames; internet-only,
+ *     guest, blocked and (in quarantine mode) unknown devices cannot reach,
+ *     probe or ARP-scan other LAN devices. Router-bound frames are local
+ *     bridge INPUT, not FORWARD, so DHCP/DNS/captive still work.
+ *
+ * The rule set is written to /tmp/gk/apply.sh (idempotent: full teardown
+ * then rebuild) so gkd can self-heal after a firewall or wireless restart
+ * flushes the tables. The flow accelerator is flushed on every apply so
+ * already-offloaded flows re-traverse the fresh rules.
+ *
+ * KNOWN LIMIT (documented on the page): two clients on the SAME wireless
+ * BSS may be bridged inside the Broadcom driver below ebtables. Metal
+ * probe owed; per-BSS ap_isolate is the fallback if the driver forwards.
+ */
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+
+#include "rc.h"
+#include <shared.h>
+
+#define GK_DIR    "/tmp/gk"
+#define GK_APPLY  GK_DIR "/apply.sh"
+
+/* emit one per-MAC rule line into every chain that takes it */
+static void gk_emit_mac(FILE *f, const char *mac, int state, int quarantine)
+{
+	switch (state) {
+	case 0:	/* blocked: nothing, anywhere */
+		fprintf(f, "for T in iptables ip6tables; do\n"
+			   "  $T -A REAPER_GKF -m mac --mac-source %s -j DROP\n"
+			   "  $T -A REAPER_GKI -m mac --mac-source %s -j DROP\n"
+			   "done\n"
+			   "ebtables -A REAPER_GK -s %s -j DROP\n", mac, mac, mac);
+		break;
+	case 1:	/* full: internet + LAN */
+		fprintf(f, "for T in iptables ip6tables; do\n"
+			   "  $T -A REAPER_GKF -m mac --mac-source %s -j RETURN\n"
+			   "  $T -A REAPER_GKI -m mac --mac-source %s -j RETURN\n"
+			   "done\n"
+			   "ebtables -A REAPER_GK -s %s -j RETURN\n", mac, mac, mac);
+		break;
+	case 2:	/* internet-only */
+	case 3:	/* guest (internet-only + expiry, gkd handles the clock) */
+		fprintf(f, "for T in iptables ip6tables; do\n"
+			   "  $T -A REAPER_GKF -m mac --mac-source %s -j RETURN\n"
+			   "  $T -A REAPER_GKI -m mac --mac-source %s -j RETURN\n"
+			   "done\n"
+			   "ebtables -A REAPER_GK -s %s -j DROP\n", mac, mac, mac);
+		break;
+	}
+	/* known MACs never hit the captive redirect */
+	if (quarantine)
+		fprintf(f, "iptables -t nat -A REAPER_GKN -m mac --mac-source %s -j RETURN\n", mac);
+}
+
+static void gk_gen_apply(void)
+{
+	FILE *f;
+	char *rl, *buf, *tok, *sp = NULL;
+	const char *lanif = nvram_safe_get("lan_ifname");
+	const char *lanip = nvram_safe_get("lan_ipaddr");
+	int quarantine = !nvram_match("gk_default", "1");
+	int captive = !nvram_match("gk_captive", "0");
+
+	f = fopen(GK_APPLY, "w");
+	if (!f) return;
+
+	fprintf(f, "#!/bin/sh\n"
+		   "# generated by start_gk - do not edit; idempotent (teardown+rebuild)\n"
+		   "LANIF=%s\n"
+		   "# ---- teardown ----\n"
+		   "for T in iptables ip6tables; do\n"
+		   "  $T -D FORWARD -i $LANIF -j REAPER_GKF 2>/dev/null\n"
+		   "  $T -D INPUT -i $LANIF -j REAPER_GKI 2>/dev/null\n"
+		   "  $T -F REAPER_GKF 2>/dev/null; $T -X REAPER_GKF 2>/dev/null\n"
+		   "  $T -F REAPER_GKI 2>/dev/null; $T -X REAPER_GKI 2>/dev/null\n"
+		   "done\n"
+		   "iptables -t nat -D PREROUTING -i $LANIF -j REAPER_GKN 2>/dev/null\n"
+		   "iptables -t nat -F REAPER_GKN 2>/dev/null; iptables -t nat -X REAPER_GKN 2>/dev/null\n"
+		   "ebtables -D FORWARD --logical-in $LANIF -j REAPER_GK 2>/dev/null\n"
+		   "ebtables -F REAPER_GK 2>/dev/null; ebtables -X REAPER_GK 2>/dev/null\n"
+		   "# ---- build ----\n"
+		   "for T in iptables ip6tables; do\n"
+		   "  $T -N REAPER_GKF\n"
+		   "  $T -N REAPER_GKI\n"
+		   "done\n"
+		   "iptables -t nat -N REAPER_GKN\n"
+		   "ebtables -N REAPER_GK -P RETURN\n",
+		   lanif);
+
+	/* per-device rules */
+	rl = nvram_safe_get("gk_rl");
+	buf = strdup(rl);
+	if (buf) {
+		for (tok = strtok_r(buf, "<", &sp); tok; tok = strtok_r(NULL, "<", &sp)) {
+			char mac[18] = "";
+			int st = -1;
+			if (sscanf(tok, "%17[^>]>%d", mac, &st) != 2) continue;
+			if (strlen(mac) != 17 || st < 0 || st > 3) continue;
+			gk_emit_mac(f, mac, st, quarantine);
+		}
+		free(buf);
+	}
+
+	if (quarantine) {
+		/* unknown MACs: held at the gate */
+		fprintf(f,
+			"# unknown devices - quarantine\n"
+			"for T in iptables ip6tables; do\n"
+			"  $T -A REAPER_GKF -j DROP\n"
+			"done\n"
+			/* router services a held device is allowed: DHCP, DNS, HTTP(captive) */
+			"iptables -A REAPER_GKI -p udp --dport 67:68 -j RETURN\n"
+			"iptables -A REAPER_GKI -p udp --dport 53 -j RETURN\n"
+			"iptables -A REAPER_GKI -p tcp --dport 53 -j RETURN\n"
+			"iptables -A REAPER_GKI -p tcp --dport 80 -j RETURN\n"
+			"iptables -A REAPER_GKI -j DROP\n"
+			"ip6tables -A REAPER_GKI -p icmpv6 -j RETURN\n"       /* NDP must live */
+			"ip6tables -A REAPER_GKI -p udp --dport 546:547 -j RETURN\n"
+			"ip6tables -A REAPER_GKI -p udp --dport 53 -j RETURN\n"
+			"ip6tables -A REAPER_GKI -p tcp --dport 53 -j RETURN\n"
+			"ip6tables -A REAPER_GKI -p tcp --dport 80 -j RETURN\n"
+			"ip6tables -A REAPER_GKI -j DROP\n"
+			"ebtables -A REAPER_GK -j DROP\n");
+		if (captive)
+			fprintf(f, "iptables -t nat -A REAPER_GKN -p tcp --dport 80 "
+				   "-j DNAT --to-destination %s:80\n", lanip);
+	}
+
+	/* hooks at position 1: revocation must beat any ESTABLISHED shortcut */
+	fprintf(f, "# ---- hooks ----\n"
+		   "for T in iptables ip6tables; do\n"
+		   "  $T -I FORWARD 1 -i $LANIF -j REAPER_GKF\n"
+		   "  $T -I INPUT 1 -i $LANIF -j REAPER_GKI\n"
+		   "done\n"
+		   "iptables -t nat -I PREROUTING 1 -i $LANIF -j REAPER_GKN\n"
+		   "ebtables -I FORWARD 1 --logical-in $LANIF -j REAPER_GK\n"
+		   "# offloaded flows must re-traverse the fresh rules\n"
+		   "fc flush 2>/dev/null\n");
+
+	fclose(f);
+	chmod(GK_APPLY, 0700);
+}
+
+void gk_teardown_rules(void)
+{
+	/* fixed, state-free teardown (mirrors the apply.sh preamble) */
+	const char *lanif = nvram_safe_get("lan_ifname");
+	char cmd[512];
+	snprintf(cmd, sizeof(cmd),
+		"for T in iptables ip6tables; do "
+		"$T -D FORWARD -i %s -j REAPER_GKF 2>/dev/null; "
+		"$T -D INPUT -i %s -j REAPER_GKI 2>/dev/null; "
+		"$T -F REAPER_GKF 2>/dev/null; $T -X REAPER_GKF 2>/dev/null; "
+		"$T -F REAPER_GKI 2>/dev/null; $T -X REAPER_GKI 2>/dev/null; done; "
+		"iptables -t nat -D PREROUTING -i %s -j REAPER_GKN 2>/dev/null; "
+		"iptables -t nat -F REAPER_GKN 2>/dev/null; iptables -t nat -X REAPER_GKN 2>/dev/null; "
+		"ebtables -D FORWARD --logical-in %s -j REAPER_GK 2>/dev/null; "
+		"ebtables -F REAPER_GK 2>/dev/null; ebtables -X REAPER_GK 2>/dev/null; "
+		"fc flush 2>/dev/null",
+		lanif, lanif, lanif, lanif);
+	system(cmd);
+}
+
+void stop_gk(void)
+{
+	if (pids("gkd"))
+		killall_tk("gkd");
+	gk_teardown_rules();
+	unlink(GK_APPLY);
+}
+
+void start_gk(void)
+{
+	stop_gk();
+	if (!is_routing_enabled())
+		return;
+	if (!nvram_match("gk_enable", "1"))
+		return;
+	mkdir(GK_DIR, 0700);
+	gk_gen_apply();
+	system("sh " GK_APPLY);
+	xstart("gkd");
+}
