+
+.%.depend: %.c
+	@$(CC) $(CFLAGS) -M $< > $@
+
+-include $(OBJS:%.o=.%.depend)
diff --git a/release/src/router/gkd/gkd.c b/release/src/router/gkd/gkd.c
new file mode 100644
index 0000000000..92a6bd75dd
--- /dev/null
+++ b/release/src/router/gkd/gkd.c
@@ -0,0 +1,348 @@
+/* SPDX-License-Identifier: GPL-2.0-only
+ * Copyright (C) 2026 the Reaper project maintainer
+ *
+ * gkd - Gatekeeper watcher (reaper v1.6.8)
+ *
+ * Small poller behind the Gatekeeper device-access-control feature. It never
+ * enforces anything itself - enforcement is the iptables/ebtables chain set
+ * written by rc's start_gk() into /tmp/gk/apply.sh. This daemon:
+ *
+ *   1. discovers devices (IPv4 ARP + IPv6 neighbours + DHCP leases + per-BSS
+ *      wireless assoclists) and maintains /tmp/gk/seen.json for the UI;
+ *   2. syslogs the first sight of an unknown MAC (gk_notify);
+ *   3. expires guest passes: entry removed from gk_rl (device returns to the
+ *      gate), nvram committed, rules refreshed via notify_rc("restart_gk");
+ *   4. self-heals: if the enforcement chains vanish (firewall/wireless
+ *      restarts flush tables), re-runs /tmp/gk/apply.sh.
+ *
+ * No listener, no outbound traffic, nothing persisted outside nvram.
+ */
+
+#ifndef _GNU_SOURCE
+#define _GNU_SOURCE	/* strcasestr */
+#endif
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <strings.h>
+#include <unistd.h>
+#include <signal.h>
+#include <time.h>
+#include <ctype.h>
+#include <sys/stat.h>
+#include <syslog.h>
+#include <dirent.h>
+
+#include <bcmnvram.h>
+#include <shutils.h>
+#include <shared.h>
+
+#define GK_DIR        "/tmp/gk"
+#define SEEN_TSV      GK_DIR "/seen.tsv"
+#define SEEN_TMP      GK_DIR "/seen.tsv.new"
+#define APPLY_SH      GK_DIR "/apply.sh"
+#define CHAIN_STAMP   GK_DIR "/chains.ok"
+#define POLL_SECS     10
+#define WL_REFRESH    3        /* assoclist sweep every POLL_SECS * WL_REFRESH */
+#define MAX_DEV       256
+#define LEASE_FILE    "/var/lib/misc/dnsmasq.leases"
+
+typedef struct {
+	char mac[18];
+	char ip[46];
+	char host[33];
+	char band[8];          /* "2.4", "5", "6" or "" */
+	int wired;
+	long first;
+	long last;
+	int online;
+	int logged;            /* new-device syslog emitted */
+} dev_t_gk;
+
+static dev_t_gk devs[MAX_DEV];
+static int ndev = 0;
+static volatile sig_atomic_t g_stop = 0;
+
+static void on_sig(int sig) { (void)sig; g_stop = 1; }
+
+static void norm_mac(char *m)
+{
+	for (; *m; m++) *m = toupper((unsigned char)*m);
+}
+
+static int valid_mac(const char *m)
+{
+	int i;
+	if (strlen(m) != 17) return 0;
+	for (i = 0; i < 17; i++) {
+		if ((i % 3) == 2) { if (m[i] != ':') return 0; }
+		else if (!isxdigit((unsigned char)m[i])) return 0;
+	}
+	/* ignore broadcast + all-zero */
+	if (!strcasecmp(m, "FF:FF:FF:FF:FF:FF")) return 0;
+	if (!strcasecmp(m, "00:00:00:00:00:00")) return 0;
+	return 1;
+}
+
+static dev_t_gk *find_dev(const char *mac)
+{
+	int i;
+	for (i = 0; i < ndev; i++)
+		if (!strcasecmp(devs[i].mac, mac)) return &devs[i];
+	return NULL;
+}
+
+static dev_t_gk *touch_dev(const char *mac, long now)
+{
+	dev_t_gk *d = find_dev(mac);
+	if (!d) {
+		if (ndev >= MAX_DEV) return NULL;
+		d = &devs[ndev++];
+		memset(d, 0, sizeof(*d));
+		snprintf(d->mac, sizeof(d->mac), "%s", mac);
+		norm_mac(d->mac);
+		d->first = now;
+	}
+	d->last = now;
+	d->online = 1;
+	return d;
+}
+
+/* mac appears (any state) in gk_rl? gk_rl = "<MAC>state>expiry<MAC>state>expiry..." */
+static int in_rl(const char *rl, const char *mac)
+{
+	const char *p = rl;
+	size_t n = strlen(mac);
+	while ((p = strcasestr(p, mac)) != NULL) {
+		if (p != rl && *(p - 1) == '<' && *(p + n) == '>') return 1;
+		p += n;
+	}
+	return 0;
+}
+
+static void scan_arp(long now)
+{
+	FILE *f = fopen("/proc/net/arp", "r");
+	char line[256], ip[64], hw[64], dev_if[32];
+	unsigned flags;
+	if (!f) return;
+	if (!fgets(line, sizeof(line), f)) { fclose(f); return; }   /* header */
+	while (fgets(line, sizeof(line), f)) {
+		if (sscanf(line, "%63s 0x%*x 0x%x %63s %*s %31s", ip, &flags, hw, dev_if) != 4)
+			continue;
+		if (!(flags & 2)) continue;                 /* incomplete */
+		if (strncmp(dev_if, "br", 2)) continue;     /* LAN bridge only */
+		if (!valid_mac(hw)) continue;
+		{
+			dev_t_gk *d = touch_dev(hw, now);
+			if (d) snprintf(d->ip, sizeof(d->ip), "%s", ip);
+		}
+	}
+	fclose(f);
+}
+
+static void scan_ndp(long now)
+{
+	/* IPv6-only devices never show in ARP; merge the v6 neighbour table. */
+	FILE *p = popen("ip -6 neigh show 2>/dev/null", "r");
+	char line[256];
+	if (!p) return;
+	while (fgets(line, sizeof(line), p)) {
+		char ip6[64] = "", mac[64] = "";
+		char *ll = strstr(line, "lladdr ");
+		if (!ll) continue;
+		if (sscanf(line, "%63s", ip6) != 1) continue;
+		if (sscanf(ll + 7, "%63s", mac) != 1) continue;
+		if (strncasecmp(ip6, "fe80", 4) == 0) continue;   /* link-local noise */
+		if (!strstr(line, " br")) continue;
+		if (!valid_mac(mac)) continue;
+		{
+			dev_t_gk *d = touch_dev(mac, now);
+			if (d && !d->ip[0]) snprintf(d->ip, sizeof(d->ip), "%s", ip6);
+		}
+	}
+	pclose(p);
+}
+
+static void scan_leases(void)
+{
+	FILE *f = fopen(LEASE_FILE, "r");
+	char line[512];
+	if (!f) return;
+	while (fgets(line, sizeof(line), f)) {
+		char mac[64], ip[64], host[64];
+		if (sscanf(line, "%*s %63s %63s %63s", mac, ip, host) != 3) continue;
+		if (!valid_mac(mac)) continue;
+		{
+			dev_t_gk *d = find_dev(mac);
+			if (d && strcmp(host, "*")) snprintf(d->host, sizeof(d->host), "%.32s", host);
+		}
+	}
+	fclose(f);
+}
+
+static const char *unit_band(int unit)
+{
+	char key[24];
+	snprintf(key, sizeof(key), "wl%d_nband", unit);
+	switch (nvram_get_int(key)) {
+	case 2: return "2.4";
+	case 1: return "5";
+	case 4: return "6";
+	}
+	return "";
+}
+
+static void scan_wl(void)
+{
+	/* every wl BSS (base + VIF - MULTILAN puts user networks on VIFs) */
+	DIR *dh = opendir("/sys/class/net");
+	struct dirent *e;
+	if (!dh) return;
+	while ((e = readdir(dh)) != NULL) {
+		int unit = -1, sub = -1;
+		char cmd[128], line[128];
+		FILE *p;
+		if (sscanf(e->d_name, "wl%d.%d", &unit, &sub) != 2 &&
+		    sscanf(e->d_name, "wl%d", &unit) != 1)
+			continue;
+		if (strchr(e->d_name, ':')) continue;
+		snprintf(cmd, sizeof(cmd), "wl -i %s assoclist 2>/dev/null", e->d_name);
+		p = popen(cmd, "r");
+		if (!p) continue;
+		while (fgets(line, sizeof(line), p)) {
+			char mac[64];
+			if (sscanf(line, "assoclist %63s", mac) != 1) continue;
+			if (!valid_mac(mac)) continue;
+			{
+				dev_t_gk *d = find_dev(mac);
+				if (d) {
+					snprintf(d->band, sizeof(d->band), "%s", unit_band(unit));
+					d->wired = 0;
+				}
+			}
+		}
+		pclose(p);
+	}
+	closedir(dh);
+}
+
+static void write_seen(void)
+{
+	/* one device per line: mac \t ip \t host \t band \t wired \t first \t last \t online
+	 * (host is scrubbed of tab/ctrl chars; the CGI JSON-escapes on the way out) */
+	FILE *f = fopen(SEEN_TMP, "w");
+	int i;
+	char *c;
+	if (!f) return;
+	for (i = 0; i < ndev; i++) {
+		dev_t_gk *d = &devs[i];
+		for (c = d->host; *c; c++)
+			if ((unsigned char)*c < 0x20 || *c == '\t') *c = '?';
+		fprintf(f, "%s\t%s\t%s\t%s\t%d\t%ld\t%ld\t%d\n",
+			d->mac, d->ip, d->host, d->band,
+			d->wired, d->first, d->last, d->online);
+	}
+	fclose(f);
+	rename(SEEN_TMP, SEEN_TSV);
+}
+
+static void notify_new(const char *rl)
+{
+	int i;
+	if (nvram_match("gk_notify", "0")) return;
+	for (i = 0; i < ndev; i++) {
+		dev_t_gk *d = &devs[i];
+		if (d->logged || in_rl(rl, d->mac)) { d->logged = 1; continue; }
+		logmessage("gatekeeper", "new device %s%s%s (%s%s) - %s",
+			d->mac,
+			d->host[0] ? " " : "", d->host,
+			d->wired ? "wired" : "wifi",
+			d->band[0] ? d->band : "",
+			nvram_match("gk_default", "1") ? "allowed (alert-only mode)" : "held at the gate");
+		d->logged = 1;
+	}
+}
+
+static void expire_guests(const char *rl_in)
+{
+	char *rl = strdup(rl_in), *out, *tok, *sp = NULL;
+	int changed = 0;
+	long now = time(NULL);
+	size_t cap;
+	if (!rl) return;
+	cap = strlen(rl) + 2;
+	out = calloc(1, cap);
+	if (!out) { free(rl); return; }
+	/* entries are "<MAC>state>expiry" - split on '<' */
+	for (tok = strtok_r(rl, "<", &sp); tok; tok = strtok_r(NULL, "<", &sp)) {
+		char mac[18] = ""; int st = -1; long exp = 0;
+		if (sscanf(tok, "%17[^>]>%d>%ld", mac, &st, &exp) >= 2 &&
+		    st == 3 && exp > 0 && now >= exp) {
+			logmessage("gatekeeper", "guest pass expired for %s - back at the gate", mac);
+			changed = 1;
+			continue;
+		}
+		strlcat(out, "<", cap);
+		strlcat(out, tok, cap);
+	}
+	if (changed) {
+		nvram_set("gk_rl", out);
+		nvram_commit();
+		notify_rc("restart_gk");
+	}
+	free(out);
+	free(rl);
+}
+
+static void self_heal(void)
+{
+	/* start_firewall rebuilds iptables wholesale (user chains deleted) and
+	 * start_lan/lan_up/restart_wireless/setup_dnsmq/wanduck run a full
+	 * "ebtables -F" (chains survive but EMPTY, hook rules gone) - so test
+	 * the iptables CHAIN but the ebtables HOOK RULE. apply.sh is a full
+	 * teardown+rebuild, safe to re-run. */
+	struct stat st;
+	if (stat(APPLY_SH, &st)) return;
+	if (system("iptables -nL REAPER_GKF >/dev/null 2>&1") == 0 &&
+	    system("ebtables -L FORWARD 2>/dev/null | grep -q REAPER_GK") == 0)
+		return;
+	logmessage("gatekeeper", "enforcement chains missing (firewall/wireless restart?) - reapplying");
+	system("sh " APPLY_SH);
+}
+
+int main(int argc, char **argv)
+{
+	int tick = 0;
+	(void)argc; (void)argv;
+
+	signal(SIGTERM, on_sig);
+	signal(SIGINT, on_sig);
+	signal(SIGHUP, SIG_IGN);
+
+	if (daemon(1, 0) < 0) return 1;
+	mkdir(GK_DIR, 0700);
+	logmessage("gatekeeper", "watcher started (%s mode)",
+		nvram_match("gk_default", "1") ? "alert-only" : "quarantine");
+
+	while (!g_stop) {
+		char *rl = nvram_safe_get("gk_rl");
+		int i;
+		long now = time(NULL);
+
+		for (i = 0; i < ndev; i++) devs[i].online = 0;
+		scan_arp(now);
+		scan_ndp(now);
+		scan_leases();
+		if ((tick++ % WL_REFRESH) == 0) scan_wl();
+
+		notify_new(rl);
+		expire_guests(rl);
+		write_seen();
+		self_heal();
+
+		for (i = 0; i < POLL_SECS && !g_stop; i++) sleep(1);
+	}
+	logmessage("gatekeeper", "watcher stopped");
+	return 0;
+}
