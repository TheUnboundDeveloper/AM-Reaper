+const char *
+reaper_gk_wait_page(void)
+{
+	/* self-contained, ASCII-only, auto-refreshing; served to unauthenticated
+	 * quarantined devices so it carries no router details beyond the theme */
+	return
+	"<!DOCTYPE html><html><head><meta charset=\"utf-8\">"
+	"<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">"
+	"<meta http-equiv=\"refresh\" content=\"10\">"
+	"<title>Awaiting approval</title><style>"
+	"body{background:#08080a;color:#B7B1A4;font-family:system-ui,sans-serif;"
+	"display:flex;align-items:center;justify-content:center;min-height:100vh;margin:0;padding:20px}"
+	".c{max-width:320px;text-align:center;border:1px solid rgba(225,6,0,.25);"
+	"border-radius:14px;padding:30px 22px;background:#0f0f12}"
+	".g{width:38px;height:38px;margin:0 auto 14px;border-radius:50%;"
+	"border:2px solid #E10600;position:relative}"
+	".g:after{content:\"\";position:absolute;left:17px;top:8px;width:2px;height:12px;"
+	"background:#E10600;transform-origin:bottom;transform:rotate(45deg)}"
+	"h1{color:#ECE7DB;font-size:19px;margin:0 0 8px;letter-spacing:.03em}"
+	"p{font-size:13px;line-height:1.55;margin:0}"
+	"</style></head><body><div class=\"c\"><div class=\"g\"></div>"
+	"<h1>Awaiting approval</h1>"
+	"<p>This device is connected to the network but is being held at the gate. "
+	"The network owner has been notified - access opens the moment it is approved. "
+	"This page refreshes automatically.</p>"
+	"</div></body></html>";
+}
