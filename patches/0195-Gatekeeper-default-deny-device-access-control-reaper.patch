index 0c13bb1e7e..3a4a3c9774 100644
--- a/release/src/router/httpd/web.c
+++ b/release/src/router/httpd/web.c
@@ -22519,6 +22519,366 @@ static int rmcp_usb_find_key(const char *wanthash, char *out, size_t outsz)
  * mirroring the code-rotation guard already used in 'provision'. Shares the same
  * fail-count + lockout accounting. Returns 1 to proceed; on failure it has already
  * written the JSON error and the caller must return. */
+static int
+gk_valid_mac(const char *m)
+{
+	int i;
+	if (!m || strlen(m) != 17) return 0;
+	for (i = 0; i < 17; i++) {
+		if ((i % 3) == 2) { if (m[i] != ':') return 0; }
+		else if (!isxdigit((unsigned char)m[i])) return 0;
+	}
+	return 1;
+}
+
+/* find mac in gk_rl ("<MAC>state>expiry..."); returns 1 + fills state/expiry */
+static int
+gk_rl_find(const char *rl, const char *mac, int *state, long *expiry)
+{
+	const char *p = rl;
+	size_t n = strlen(mac);
+	while ((p = strcasestr(p, mac)) != NULL) {
+		if (p != rl && *(p - 1) == '<' && *(p + n) == '>') {
+			if (state) *state = atoi(p + n + 1);
+			if (expiry) {
+				const char *e = strchr(p + n + 1, '>');
+				*expiry = e ? strtol(e + 1, NULL, 10) : 0;
+			}
+			return 1;
+		}
+		p += n;
+	}
+	return 0;
+}
+
+/* rewrite gk_rl with mac set to state (state < 0 = remove the entry) */
+static void
+gk_rl_update(const char *mac, int state, long expiry)
+{
+	char *rl = nvram_safe_get("gk_rl");
+	size_t cap = strlen(rl) + 64;
+	char *out = calloc(1, cap);
+	char *buf = strdup(rl);
+	char *tok, *sp = NULL;
+	if (!out || !buf) { free(out); free(buf); return; }
+	for (tok = strtok_r(buf, "<", &sp); tok; tok = strtok_r(NULL, "<", &sp)) {
+		char m[18] = "";
+		if (sscanf(tok, "%17[^>]", m) != 1 || !gk_valid_mac(m)) continue;
+		if (!strcasecmp(m, mac)) continue;	/* old entry dropped */
+		strlcat(out, "<", cap);
+		strlcat(out, tok, cap);
+	}
+	if (state >= 0) {
+		char add[48];
+		snprintf(add, sizeof(add), "<%s>%d>%ld", mac, state, expiry);
+		strlcat(out, add, cap);
+	}
+	nvram_set("gk_rl", out);
+	free(out);
+	free(buf);
+}
+
+static void
+gk_json_esc(FILE *stream, const char *s)
+{
+	websWrite(stream, "\"");
+	for (; *s; s++) {
+		unsigned char c = (unsigned char)*s;
+		if (c == '"' || c == '\\') websWrite(stream, "\\%c", c);
+		else if (c < 0x20) websWrite(stream, "\\u%04x", c);
+		else websWrite(stream, "%c", c);
+	}
+	websWrite(stream, "\"");
+}
+
+/* look mac up in custom_clientlist ("<name>MAC>...") for a friendly name */
+static void
+gk_client_name(const char *mac, char *name, size_t nlen)
+{
+	char *cl = nvram_safe_get("custom_clientlist");
+	char *buf = strdup(cl), *tok, *sp = NULL;
+	name[0] = 0;
+	if (!buf) return;
+	for (tok = strtok_r(buf, "<", &sp); tok; tok = strtok_r(NULL, "<", &sp)) {
+		char *f1 = strchr(tok, '>');
+		if (!f1) continue;
+		*f1++ = 0;
+		{
+			char *f2 = strchr(f1, '>');
+			if (f2) *f2 = 0;
+		}
+		if (!strcasecmp(f1, mac)) {
+			snprintf(name, nlen, "%.32s", tok);
+			break;
+		}
+	}
+	free(buf);
+}
+
+#define GK_SEEN_TSV "/tmp/gk/seen.tsv"
+#define GK_SEEN_MAX 256
+
+struct gk_seen {
+	char mac[18], ip[46], host[40], band[8];
+	int wired, online;
+	long first, last;
+};
+
+static int
+gk_load_seen(struct gk_seen *v, int max)
+{
+	/* tab-split by hand - fields (ip/host/band) are legitimately empty, which
+	 * sscanf("%[^\t]") cannot match, so it would desync every later column */
+	FILE *f = fopen(GK_SEEN_TSV, "r");
+	char line[256];
+	int n = 0;
+	if (!f) return 0;
+	while (n < max && fgets(line, sizeof(line), f)) {
+		struct gk_seen *d = &v[n];
+		char *fld[8] = {0};
+		char *p = line, *tab;
+		int i = 0;
+		line[strcspn(line, "\n")] = 0;
+		while (i < 8) {
+			fld[i++] = p;
+			tab = strchr(p, '\t');
+			if (!tab) break;
+			*tab = 0;
+			p = tab + 1;
+		}
+		if (i < 8) continue;			/* malformed row */
+		memset(d, 0, sizeof(*d));
+		snprintf(d->mac, sizeof(d->mac), "%s", fld[0]);
+		snprintf(d->ip, sizeof(d->ip), "%s", fld[1]);
+		snprintf(d->host, sizeof(d->host), "%s", fld[2]);
+		snprintf(d->band, sizeof(d->band), "%s", fld[3]);
+		d->wired  = atoi(fld[4]);
+		d->first  = strtol(fld[5], NULL, 10);
+		d->last   = strtol(fld[6], NULL, 10);
+		d->online = atoi(fld[7]);
+		if (!gk_valid_mac(d->mac)) continue;
+		n++;
+	}
+	fclose(f);
+	return n;
+}
+
+static void
+gk_emit_seen(FILE *stream, struct gk_seen *d, int rand_flag)
+{
+	char name[40];
+	if (!d->host[0]) gk_client_name(d->mac, name, sizeof(name));
+	else snprintf(name, sizeof(name), "%s", d->host);
+	websWrite(stream, "{\"mac\":\"%s\",\"ip\":", d->mac);
+	gk_json_esc(stream, d->ip);
+	websWrite(stream, ",\"host\":");
+	gk_json_esc(stream, name);
+	websWrite(stream, ",\"band\":\"%s\",\"wired\":%d,\"online\":%d,\"first\":%ld,\"last\":%ld",
+		d->band, d->wired, d->online, d->first, d->last);
+	if (rand_flag >= 0)
+		websWrite(stream, ",\"rand\":%d", rand_flag);
+	websWrite(stream, "}");
+}
+
+/* one-time approve-everything-present baseline when the feature is enabled
+ * with an empty list; sources ARP directly since gkd has never run yet */
+static void
+gk_baseline_snapshot(void)
+{
+	FILE *f = fopen("/proc/net/arp", "r");
+	char line[256], ip[64], hw[64], dif[32];
+	unsigned flags;
+	char *rl;
+	size_t cap = 1;
+	char *out;
+	if (!f) return;
+	out = calloc(1, cap = 8192);
+	if (!out) { fclose(f); return; }
+	if (fgets(line, sizeof(line), f)) { /* header */ }
+	while (fgets(line, sizeof(line), f)) {
+		if (sscanf(line, "%63s 0x%*x 0x%x %63s %*s %31s", ip, &flags, hw, dif) != 4)
+			continue;
+		if (!(flags & 2) || strncmp(dif, "br", 2) || !gk_valid_mac(hw))
+			continue;
+		{
+			char add[48];
+			int i;
+			for (i = 0; hw[i]; i++) hw[i] = toupper((unsigned char)hw[i]);
+			snprintf(add, sizeof(add), "<%s>1>0", hw);
+			if (strlen(out) + strlen(add) + 1 < cap)
+				strlcat(out, add, cap);
+		}
+	}
+	fclose(f);
+	rl = nvram_safe_get("gk_rl");
+	if (!rl[0] && out[0]) {
+		nvram_set("gk_rl", out);
+		logmessage("gatekeeper", "enabled - baseline snapshot approved the devices already present");
+	}
+	free(out);
+}
+
+static void
+do_reaper_gk_cgi(char *url, FILE *stream)
+{
+	char *action = get_cgi("action");
+	char *rl = nvram_safe_get("gk_rl");
+
+	if (!action) action = "status";
+
+	/* CSRF: state-changing actions must carry http_id (same guard as rmcp) */
+	if (strcmp(action, "status") != 0) {
+		char *hid = get_cgi("http_id");
+		char *want = nvram_safe_get("http_id");
+		if (!hid || !want[0] || strcmp(hid, want) != 0) {
+			websWrite(stream, "{\"ok\":0,\"error\":\"invalid request token\"}");
+			return;
+		}
+	}
+
+	if (!strcmp(action, "status")) {
+		static struct gk_seen seen[GK_SEEN_MAX];
+		int ns = gk_load_seen(seen, GK_SEEN_MAX);
+		int i, first;
+		char *buf, *tok, *sp = NULL;
+
+		websWrite(stream, "{\"enable\":%d,\"def\":%d,\"guest_hours\":%d,\"captive\":%d,\"notify\":%d",
+			nvram_match("gk_enable", "1") ? 1 : 0,
+			nvram_match("gk_default", "1") ? 1 : 0,
+			nvram_get_int("gk_guest_hours") > 0 ? nvram_get_int("gk_guest_hours") : 24,
+			nvram_match("gk_captive", "0") ? 0 : 1,
+			nvram_match("gk_notify", "0") ? 0 : 1);
+
+		/* pending = seen but not in gk_rl */
+		websWrite(stream, ",\"pending\":[");
+		first = 1;
+		for (i = 0; i < ns; i++) {
+			int rand_flag;
+			char c;
+			if (gk_rl_find(rl, seen[i].mac, NULL, NULL)) continue;
+			c = seen[i].mac[1];
+			rand_flag = (c == '2' || c == '6' || c == 'A' || c == 'E') ? 1 : 0;
+			if (!first) websWrite(stream, ",");
+			first = 0;
+			gk_emit_seen(stream, &seen[i], rand_flag);
+		}
+		websWrite(stream, "]");
+
+		/* devices = every gk_rl entry, enriched from seen when available */
+		websWrite(stream, ",\"devices\":[");
+		first = 1;
+		buf = strdup(rl);
+		if (buf) {
+			for (tok = strtok_r(buf, "<", &sp); tok; tok = strtok_r(NULL, "<", &sp)) {
+				char mac[18] = "";
+				int st = -1;
+				long exp = 0;
+				struct gk_seen off, *d = NULL;
+				if (sscanf(tok, "%17[^>]>%d>%ld", mac, &st, &exp) < 2) continue;
+				if (!gk_valid_mac(mac) || st < 0 || st > 3) continue;
+				for (i = 0; i < ns; i++)
+					if (!strcasecmp(seen[i].mac, mac)) { d = &seen[i]; break; }
+				if (!d) {
+					memset(&off, 0, sizeof(off));
+					snprintf(off.mac, sizeof(off.mac), "%s", mac);
+					d = &off;
+				}
+				if (!first) websWrite(stream, ",");
+				first = 0;
+				websWrite(stream, "{\"mac\":\"%s\",\"state\":%d,\"expiry\":%ld,\"ip\":", d->mac, st, exp);
+				gk_json_esc(stream, d->ip);
+				websWrite(stream, ",\"host\":");
+				{
+					char name[40];
+					if (!d->host[0]) gk_client_name(d->mac, name, sizeof(name));
+					else snprintf(name, sizeof(name), "%s", d->host);
+					gk_json_esc(stream, name);
+				}
+				websWrite(stream, ",\"band\":\"%s\",\"wired\":%d,\"online\":%d,\"last\":%ld}",
+					d->band, d->wired, d->online, d->last);
+			}
+			free(buf);
+		}
+		websWrite(stream, "]}");
+		return;
+	}
+
+	if (!strcmp(action, "set")) {
+		char *mac = get_cgi("mac");
+		char *st = get_cgi("state");
+		char umac[18];
+		int state, i;
+		long expiry = 0;
+		if (!gk_valid_mac(mac) || !st) {
+			websWrite(stream, "{\"ok\":0,\"error\":\"bad mac/state\"}");
+			return;
+		}
+		state = atoi(st);
+		if (state < 0 || state > 3) {
+			websWrite(stream, "{\"ok\":0,\"error\":\"bad state\"}");
+			return;
+		}
+		for (i = 0; i < 17; i++) umac[i] = toupper((unsigned char)mac[i]);
+		umac[17] = 0;
+		if (state == 3) {
+			int h = nvram_get_int("gk_guest_hours");
+			if (h < 1 || h > 168) h = 24;
+			expiry = (long)time(NULL) + (long)h * 3600;
+		}
+		gk_rl_update(umac, state, expiry);
+		nvram_commit();
+		notify_rc("restart_gk");
+		websWrite(stream, "{\"ok\":1}");
+		return;
+	}
+
+	if (!strcmp(action, "remove")) {
+		char *mac = get_cgi("mac");
+		char umac[18];
+		int i;
+		if (!gk_valid_mac(mac)) {
+			websWrite(stream, "{\"ok\":0,\"error\":\"bad mac\"}");
+			return;
+		}
+		for (i = 0; i < 17; i++) umac[i] = toupper((unsigned char)mac[i]);
+		umac[17] = 0;
+		gk_rl_update(umac, -1, 0);
+		nvram_commit();
+		notify_rc("restart_gk");
+		websWrite(stream, "{\"ok\":1}");
+		return;
+	}
+
+	if (!strcmp(action, "config")) {
+		char *v;
+		if ((v = get_cgi("enable")) != NULL && (*v == '0' || *v == '1')) {
+			if (*v == '1' && !nvram_match("gk_enable", "1") && !nvram_safe_get("gk_rl")[0])
+				gk_baseline_snapshot();
+			nvram_set("gk_enable", *v == '1' ? "1" : "0");
+		}
+		if ((v = get_cgi("def")) != NULL && (*v == '0' || *v == '1'))
+			nvram_set("gk_default", *v == '1' ? "1" : "0");
+		if ((v = get_cgi("captive")) != NULL && (*v == '0' || *v == '1'))
+			nvram_set("gk_captive", *v == '1' ? "1" : "0");
+		if ((v = get_cgi("notify")) != NULL && (*v == '0' || *v == '1'))
+			nvram_set("gk_notify", *v == '1' ? "1" : "0");
+		if ((v = get_cgi("guest_hours")) != NULL) {
+			int h = atoi(v);
+			if (h >= 1 && h <= 168) {
+				char hb[8];
+				snprintf(hb, sizeof(hb), "%d", h);
+				nvram_set("gk_guest_hours", hb);
+			}
+		}
+		nvram_commit();
+		notify_rc("restart_gk");
+		websWrite(stream, "{\"ok\":1}");
+		return;
+	}
+
+	websWrite(stream, "{\"ok\":0,\"error\":\"unknown action\"}");
+}
