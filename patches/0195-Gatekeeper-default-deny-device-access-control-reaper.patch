@@ -45,6 +45,9 @@
 ** SUCH DAMAGE.
 */
 
+#ifndef _GNU_SOURCE
+#define _GNU_SOURCE	/* reaper v1.6.8: strcasestr in the Gatekeeper captive check */
+#endif
