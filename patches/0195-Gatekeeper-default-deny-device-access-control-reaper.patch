+/* ---- reaper v1.6.8 Gatekeeper captive support ------------------------- */
+
+/* IPv4 client IP -> MAC via /proc/net/arp; tiny 2s single-entry cache since
+ * a quarantined phone hammers captive probes. Returns 1 on hit. */
+static int
+gk_ip_to_mac(const char *ip, char *mac, size_t maclen)
+{
+	static char c_ip[46] = "", c_mac[18] = "";
+	static time_t c_at = 0;
+	FILE *f;
+	char line[256], aip[64], hw[64], dif[32];
+	unsigned flags;
+	time_t now = time(NULL);
+
+	if (c_at && now - c_at <= 2 && !strcmp(ip, c_ip)) {
+		if (!c_mac[0]) return 0;
+		snprintf(mac, maclen, "%s", c_mac);
+		return 1;
+	}
+	snprintf(c_ip, sizeof(c_ip), "%s", ip);
+	c_mac[0] = 0;
+	c_at = now;
+
+	f = fopen("/proc/net/arp", "r");
+	if (!f) return 0;
+	if (fgets(line, sizeof(line), f)) { /* header */ }
+	while (fgets(line, sizeof(line), f)) {
+		if (sscanf(line, "%63s 0x%*x 0x%x %63s %*s %31s", aip, &flags, hw, dif) != 4)
+			continue;
+		if (!(flags & 2) || strncmp(dif, "br", 2))
+			continue;
+		if (!strcmp(aip, ip) && strlen(hw) == 17) {
+			snprintf(c_mac, sizeof(c_mac), "%s", hw);
+			break;
+		}
+	}
+	fclose(f);
+	if (!c_mac[0]) return 0;
+	snprintf(mac, maclen, "%s", c_mac);
+	return 1;
+}
+
+/* is mac listed (any state) in gk_rl "<MAC>state>expiry..."? */
+static int
+gk_mac_known(const char *mac)
+{
+	char *rl = nvram_safe_get("gk_rl");
+	const char *p = rl;
+	size_t n = strlen(mac);
+	while ((p = strcasestr(p, mac)) != NULL) {
+		if (p != rl && *(p - 1) == '<' && *(p + n) == '>')
+			return 1;
+		p += n;
+	}
+	return 0;
+}
+
+int
+reaper_gk_captive_check(const char *client_ip)
+{
+	char mac[18];
+
+	if (!nvram_match("gk_enable", "1"))
+		return 0;
+	if (nvram_match("gk_captive", "0") || nvram_match("gk_default", "1"))
+		return 0;
+	if (!client_ip || !client_ip[0] || !strcmp(client_ip, "127.0.0.1"))
+		return 0;
+	if (strchr(client_ip, ':'))		/* v6 peer: ARP can't resolve - let it through */
+		return 0;
+	if (!gk_ip_to_mac(client_ip, mac, sizeof(mac)))
+		return 0;				/* unresolvable - fail open, chains still enforce */
+	return gk_mac_known(mac) ? 0 : 1;
+}
