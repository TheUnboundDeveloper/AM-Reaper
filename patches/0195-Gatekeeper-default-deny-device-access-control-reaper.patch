+}
+*{box-sizing:border-box;margin:0}
+html,body{background:var(--bg)}
+body{font-family:var(--body);color:var(--bone-dim);font-size:13.5px;line-height:1.55;padding:20px 22px 48px}
+h1,h2,h3{font-family:var(--hdr);letter-spacing:.04em;color:var(--bone);margin:0}
+.pagehead{display:flex;align-items:center;gap:16px;flex-wrap:wrap;margin-bottom:4px;max-width:1120px}
+.pagehead h1{font-size:24px;font-weight:700}
+.pagehead .ver{font-size:11px;color:var(--steel);letter-spacing:.1em;text-transform:uppercase}
+.statuspill{font-family:var(--hdr);font-weight:600;font-size:11px;letter-spacing:.1em;text-transform:uppercase;border-radius:20px;padding:4px 12px;border:1px solid var(--line);color:var(--jade)}
+.statuspill.off{color:var(--steel);border-color:var(--line-soft)}
+.mastertg{margin-left:auto;display:flex;align-items:center;gap:10px;font-size:12.5px;color:var(--bone)}
+.lede{max-width:74ch;margin:6px 0 18px}
+.lede b{color:var(--bone);font-weight:600}
+.tg{position:relative;width:40px;height:21px;border-radius:12px;background:#26262c;border:1px solid rgba(255,255,255,.12);cursor:pointer;flex:0 0 40px}
+.tg::after{content:"";position:absolute;top:2px;left:2px;width:15px;height:15px;border-radius:50%;background:var(--steel);transition:.15s}
+.tg.on{background:#33333a}
+.tg.on::after{left:21px;background:var(--bone)}
+.offbanner{display:none;background:var(--panel);border:1px solid var(--line-soft);border-radius:12px;padding:14px 18px;margin-bottom:16px;max-width:1120px;color:var(--bone-dim)}
+.offbanner b{color:var(--bone)}
+.stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:12px;margin:0 0 16px;max-width:1120px}
+.stat{background:var(--panel);border:1px solid var(--line-soft);border-radius:12px;padding:12px 16px}
+.stat .n{font-family:var(--hdr);font-weight:700;font-size:26px;color:var(--bone);font-variant-numeric:tabular-nums}
+.stat .l{font-size:11px;text-transform:uppercase;letter-spacing:.1em;color:var(--steel)}
+.stat.attn{border-color:var(--line)}
+.stat.attn .n{color:var(--crimson)}
+.card{background:var(--panel);border:1px solid var(--line-soft);border-radius:12px;padding:16px 18px;margin-bottom:16px;max-width:1120px}
+.card>h2{font-size:14px;text-transform:uppercase;letter-spacing:.1em;margin-bottom:10px;padding-bottom:8px;border-bottom:1px solid var(--line-soft)}
+.card>h2 .cnt{color:var(--crimson)}
+.card.hot{border-color:var(--line)}
+.pend{display:flex;align-items:center;gap:14px;padding:12px 4px;border-bottom:1px solid var(--line-soft);flex-wrap:wrap}
+.pend:last-child{border-bottom:none}
+.pico{width:38px;height:38px;flex:0 0 38px;border-radius:9px;background:var(--panel-2);border:1px solid var(--line);display:flex;align-items:center;justify-content:center}
+.pico svg{width:20px;height:20px;stroke:var(--crimson);fill:none;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round}
+.pinfo{flex:1 1 260px;min-width:0}
+.pname{color:var(--bone);font-weight:600;font-size:14px;display:flex;align-items:center;gap:8px;flex-wrap:wrap}
+.chip{font-size:10px;font-weight:600;text-transform:uppercase;letter-spacing:.08em;border-radius:4px;padding:1px 6px;border:1px solid var(--line-soft);color:var(--steel)}
+.chip.rand{color:var(--amber);border-color:rgba(217,164,65,.35)}
+.pmeta{font-size:12px;color:var(--steel);font-family:ui-monospace,Consolas,monospace}
+.pmeta b{color:var(--bone-dim);font-family:var(--body);font-weight:400}
+.pacts{display:flex;gap:8px;flex-wrap:wrap}
+.btn{font-family:var(--hdr);font-weight:600;letter-spacing:.06em;text-transform:uppercase;font-size:12px;color:var(--bone);background:linear-gradient(180deg,rgba(225,6,0,.28),rgba(225,6,0,.10));border:1px solid var(--crimson-deep);border-radius:8px;padding:7px 14px;cursor:pointer}
+.btn:hover{background:linear-gradient(180deg,rgba(225,6,0,.42),rgba(225,6,0,.16))}
+.btng{font-family:var(--hdr);font-weight:600;letter-spacing:.06em;text-transform:uppercase;font-size:12px;color:var(--bone-dim);background:transparent;border:1px solid rgba(255,255,255,.16);border-radius:8px;padding:7px 14px;cursor:pointer}
+.btng:hover{color:var(--bone);border-color:rgba(255,255,255,.3)}
+.btnd{font-family:var(--hdr);font-weight:600;letter-spacing:.06em;text-transform:uppercase;font-size:12px;color:var(--danger);background:transparent;border:1px solid rgba(255,59,48,.4);border-radius:8px;padding:7px 14px;cursor:pointer}
+.nopend{font-size:12.5px;color:var(--steel);padding:6px 2px}
+.tblbar{display:flex;gap:8px;align-items:center;margin-bottom:10px;flex-wrap:wrap}
+.fchip{font-size:11.5px;border:1px solid rgba(255,255,255,.14);border-radius:16px;padding:3px 12px;color:var(--bone-dim);cursor:pointer;user-select:none}
+.fchip.on{border-color:var(--crimson-deep);color:var(--bone);background:rgba(225,6,0,.10)}
+.search{margin-left:auto;background:var(--panel-2);border:1px solid var(--line-soft);border-radius:8px;color:var(--bone-dim);font-family:var(--body);font-size:12.5px;padding:6px 12px;width:200px}
+.tblwrap{overflow-x:auto}
+table{width:100%;border-collapse:collapse;font-size:12.8px}
+th{font-family:var(--hdr);font-weight:600;font-size:11px;text-transform:uppercase;letter-spacing:.1em;color:var(--steel);text-align:left;padding:8px 10px;border-bottom:1px solid var(--line)}
+td{padding:9px 10px;border-bottom:1px solid var(--line-soft);white-space:nowrap}
+td.dev{color:var(--bone);font-weight:600}
+td.mac{font-family:ui-monospace,Consolas,monospace;font-size:11.5px;color:var(--steel)}
+.st{display:inline-flex;align-items:center;gap:6px;font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:.07em;border-radius:5px;padding:2px 8px;border:1px solid var(--line-soft)}
+.st i{width:6px;height:6px;border-radius:50%;display:inline-block}
+.st.full{color:var(--jade)} .st.full i{background:var(--jade)}
+.st.inet{color:var(--amber)} .st.inet i{background:var(--amber)}
+.st.guest{color:var(--bone-dim)} .st.guest i{background:var(--bone-dim)}
+.st.block{color:var(--danger)} .st.block i{background:var(--danger)}
+.rowsel{background:var(--panel-2);border:1px solid var(--line-soft);border-radius:7px;color:var(--bone-dim);font-family:var(--body);font-size:11.5px;padding:4px 8px}
+.duo{display:grid;grid-template-columns:repeat(auto-fit,minmax(320px,1fr));gap:16px;margin-bottom:16px;max-width:1120px}
+.duo .card{margin:0}
+.setrow{display:flex;align-items:center;gap:12px;padding:9px 2px;border-bottom:1px solid var(--line-soft)}
+.setrow:last-child{border-bottom:none}
+.setrow .sl{flex:1;color:var(--bone);font-size:13px}
+.setrow .sd{font-size:11.5px;color:var(--steel);display:block;margin-top:1px;font-weight:400}
+.setsel{background:var(--panel-2);border:1px solid var(--line-soft);border-radius:7px;color:var(--bone);font-family:var(--body);font-size:12.5px;padding:5px 10px}
+.portalprev{background:#050506;border:1px solid var(--line-soft);border-radius:10px;padding:22px 18px;text-align:center}
+.portalprev .pp-in{max-width:290px;margin:0 auto;border:1px solid var(--line);border-radius:12px;padding:22px 16px;background:var(--panel)}
+.portalprev h3{font-size:16px;margin:8px 0 6px}
+.portalprev p{font-size:11.8px;color:var(--bone-dim)}
+.portalprev .glyph{width:34px;height:34px;margin:0 auto;border-radius:50%;border:1.5px solid var(--crimson);display:flex;align-items:center;justify-content:center}
+.portalprev .glyph svg{width:17px;height:17px;stroke:var(--crimson);fill:none;stroke-width:1.7;stroke-linecap:round}
+.cap{font-size:10.5px;color:var(--steel);text-transform:uppercase;letter-spacing:.1em;margin-top:10px}
+.card ul{list-style:none;padding:0;display:flex;flex-direction:column;gap:7px;font-size:12.5px;max-width:80ch}
+.card li{padding-left:16px;position:relative}
+.card li::before{content:"";position:absolute;left:2px;top:7px;width:5px;height:5px;border-radius:50%;background:var(--steel)}
+.card li b{color:var(--bone);font-weight:600}
+</style>
+</head>
+<body>
+
+<div class="pagehead">
+  <h1><#RGK_00#></h1>
+  <span class="ver"><#RGK_01#> &middot; v1.0</span>
+  <span class="statuspill off" id="pill"><#RGK_38#></span>
+  <span class="mastertg"><#RGK_37#> <span class="tg" id="tgmaster" onclick="gkToggle()"></span></span>
+</div>
+<p class="lede"><#RGK_02#></p>
+
+<div class="offbanner" id="offbanner"><b><#RGK_00#></b> &mdash; <#RGK_39#></div>
+
+<div class="stats" id="statwrap">
+  <div class="stat attn"><div class="n" id="n_pend">0</div><div class="l"><#RGK_03#></div></div>
+  <div class="stat"><div class="n" id="n_full">0</div><div class="l"><#RGK_40#></div></div>
+  <div class="stat"><div class="n" id="n_inet">0</div><div class="l"><#RGK_06#></div></div>
+  <div class="stat"><div class="n" id="n_block">0</div><div class="l"><#RGK_13#></div></div>
+</div>
+
+<div class="card hot" id="pendcard">
+  <h2><#RGK_03#> &middot; <span class="cnt" id="pendcnt">0</span></h2>
+  <div id="pendlist"><div class="nopend"><#RGK_36#></div></div>
+</div>
+
+<div class="card">
+  <h2><#RGK_09#></h2>
+  <div class="tblbar">
+    <span class="fchip on" data-f="all" onclick="gkFilter(this)"><#RGK_10#> &middot; <span id="n_all">0</span></span>
+    <span class="fchip" data-f="1" onclick="gkFilter(this)"><#RGK_11#></span>
+    <span class="fchip" data-f="2" onclick="gkFilter(this)"><#RGK_06#></span>
+    <span class="fchip" data-f="3" onclick="gkFilter(this)"><#RGK_07#></span>
+    <span class="fchip" data-f="0" onclick="gkFilter(this)"><#RGK_13#></span>
+    <input class="search" id="q" placeholder="<#RGK_14#>" oninput="gkRender()">
+  </div>
+  <div class="tblwrap">
+  <table>
+    <thead><tr><th><#RGK_15#></th><th>MAC</th><th><#RGK_17#></th><th><#RGK_18#></th><th><#RGK_19#></th><th></th></tr></thead>
+    <tbody id="devrows"></tbody>
+  </table>
+  </div>
+</div>
+
+<div class="duo">
+  <div class="card">
+    <h2><#RGK_20#></h2>
+    <div class="setrow"><span class="sl"><#RGK_21#><span class="sd"><#RGK_22#></span></span>
+      <select class="setsel" id="s_def" onchange="gkCfg()"><option value="0"><#RGK_23#></option><option value="1"><#RGK_24#></option></select></div>
+    <div class="setrow"><span class="sl"><#RGK_25#><span class="sd"><#RGK_26#></span></span>
+      <select class="setsel" id="s_hours" onchange="gkCfg()"><option value="4">4</option><option value="8">8</option><option value="24">24</option><option value="48">48</option></select></div>
+    <div class="setrow"><span class="sl"><#RGK_27#><span class="sd"><#RGK_28#></span></span><span class="tg" id="s_captive" onclick="gkTg(this)"></span></div>
+    <div class="setrow"><span class="sl"><#RGK_29#><span class="sd"><#RGK_30#></span></span><span class="tg" id="s_notify" onclick="gkTg(this)"></span></div>
+  </div>
+  <div class="card">
+    <h2><#RGK_31#></h2>
+    <div class="portalprev">
+      <div class="pp-in">
+        <div class="glyph"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/></svg></div>
+        <h3><#RGK_32#></h3>
+        <p><#RGK_33#></p>
+      </div>
+      <div class="cap"><#RGK_34#></div>
+    </div>
+  </div>
+</div>
+
+<div class="card">
+  <h2><#RGK_35#></h2>
+  <ul>
+    <li><#RGK_41#></li>
+    <li><#RGK_42#></li>
+    <li><#RGK_43#></li>
+    <li><#RGK_44#></li>
+  </ul>
+</div>
+
+<script>
+var REAPER_HTTPID = '<% nvram_get("http_id"); %>';  /* F4 CSRF token */
+(function(){ window.GK = { st:null, filter:'all', busy:false }; })();
+
+function gkEsc(s){ return String(s==null?'':s).replace(/[&<>"']/g, function(c){ return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]; }); }
+
+function gkAgo(ep){
+  if(!ep) return '-';
+  var d = Math.max(0, Math.floor(Date.now()/1000) - ep);
+  if(d < 45) return '<#RGK_45#>';
+  if(d < 3600) return Math.floor(d/60) + ' <#RGK_46#>';
+  if(d < 86400) return Math.floor(d/3600) + ' <#RGK_47#>';
+  return Math.floor(d/86400) + ' <#RGK_48#>';
+}
+function gkLeft(ep){
+  var d = ep - Math.floor(Date.now()/1000);
+  if(d <= 0) return '0:00';
+  var h = Math.floor(d/3600), m = Math.floor((d%3600)/60);
+  return h + ':' + (m<10?'0':'') + m;
+}
+function gkConn(d){
+  if(d.band) return '<#RGK_50#> &middot; ' + gkEsc(d.band);
+  if(d.wired) return '<#RGK_49#>';
+  return '-';
+}
+
+function gkGet(url, cb){
+  var x = new XMLHttpRequest();
+  x.open('GET', url + '&_=' + Date.now(), true);
+  x.timeout = 12000;
+  x.onreadystatechange = function(){
+    if(x.readyState !== 4) return;
+    var j = null;
+    if(x.status === 200){ try{ j = JSON.parse(x.responseText); }catch(e){} }
+    cb(j);
+  };
+  x.send();
+}
+
+function gkRefresh(){
+  gkGet('/reaper_gk.cgi?action=status', function(j){
+    if(!j) return;
+    GK.st = j;
+    gkPaint();
+  });
+}
+
+function gkPaint(){
+  var j = GK.st, on = j.enable === 1;
+  document.getElementById('tgmaster').className = 'tg' + (on ? ' on' : '');
+  var pill = document.getElementById('pill');
+  var devs = j.devices || [], pend = j.pending || [];
+  pill.className = 'statuspill' + (on ? '' : ' off');
+  pill.textContent = on ? ('<#RGK_51#> - ' + (devs.length + pend.length)) : '<#RGK_38#>';
+  document.getElementById('offbanner').style.display = on ? 'none' : 'block';
+  document.getElementById('statwrap').style.opacity = on ? '1' : '.45';
+
+  var nf = 0, ni = 0, nb = 0;
+  for(var i = 0; i < devs.length; i++){
+    var s = devs[i].state;
+    if(s === 1) nf++; else if(s === 2 || s === 3) ni++; else if(s === 0) nb++;
+  }
+  document.getElementById('n_pend').textContent = pend.length;
+  document.getElementById('n_full').textContent = nf;
+  document.getElementById('n_inet').textContent = ni;
+  document.getElementById('n_block').textContent = nb;
+  document.getElementById('n_all').textContent = devs.length;
+  document.getElementById('pendcnt').textContent = pend.length;
+
+  var ph = '';
+  for(var p = 0; p < pend.length; p++){
+    var d = pend[p], nm = d.host ? gkEsc(d.host) : '<#RGK_16#>';
+    ph += '<div class="pend">'
+      + '<div class="pico"><svg viewBox="0 0 24 24"><rect x="7" y="3" width="10" height="18" rx="2"/><path d="M11 18h2"/></svg></div>'
+      + '<div class="pinfo"><div class="pname">' + nm
+      + (d.rand ? ' <span class="chip rand"><#RGK_52#></span>' : '') + '</div>'
+      + '<div class="pmeta">' + gkEsc(d.mac) + ' &nbsp;&middot;&nbsp; <b>' + gkConn(d) + '</b> &nbsp;&middot;&nbsp; <b><#RGK_53#> ' + gkAgo(d.first) + '</b></div></div>'
+      + '<div class="pacts">'
+      + '<button class="btn" onclick="gkSet(\'' + d.mac + '\',1)"><#RGK_05#></button>'
+      + '<button class="btng" onclick="gkSet(\'' + d.mac + '\',2)"><#RGK_06#></button>'
+      + '<button class="btng" onclick="gkSet(\'' + d.mac + '\',3)"><#RGK_07#> &middot; ' + gkEsc(j.guest_hours) + ' h</button>'
+      + '<button class="btnd" onclick="gkSet(\'' + d.mac + '\',0)"><#RGK_08#></button>'
+      + '</div></div>';
+  }
+  document.getElementById('pendlist').innerHTML = ph || '<div class="nopend"><#RGK_36#></div>';
+
+  document.getElementById('s_def').value = String(j.def);
+  document.getElementById('s_hours').value = String(j.guest_hours);
+  document.getElementById('s_captive').className = 'tg' + (j.captive === 1 ? ' on' : '');
+  document.getElementById('s_notify').className = 'tg' + (j.notify === 1 ? ' on' : '');
+  gkRender();
+}
+
+function gkRender(){
+  var j = GK.st;
+  if(!j) return;
+  var q = document.getElementById('q').value.toLowerCase();
+  var rows = '';
+  var devs = j.devices || [];
+  var stName = {0:'<#RGK_13#>',1:'<#RGK_11#>',2:'<#RGK_06#>',3:'<#RGK_07#>'};
+  var stCls  = {0:'block',1:'full',2:'inet',3:'guest'};
+  for(var i = 0; i < devs.length; i++){
+    var d = devs[i];
+    if(GK.filter !== 'all' && String(d.state) !== GK.filter) continue;
+    var nm = d.host ? d.host : '<#RGK_16#>';
+    if(q && nm.toLowerCase().indexOf(q) < 0 && d.mac.toLowerCase().indexOf(q) < 0) continue;
+    var lbl = stName[d.state] || '?';
+    if(d.state === 3 && d.expiry) lbl += ' &middot; ' + gkLeft(d.expiry) + ' <#RGK_54#>';
+    rows += '<tr><td class="dev">' + gkEsc(nm) + '</td><td class="mac">' + gkEsc(d.mac) + '</td>'
+      + '<td>' + gkConn(d) + '</td>'
+      + '<td><span class="st ' + stCls[d.state] + '"><i></i>' + lbl + '</span></td>'
+      + '<td>' + (d.online ? '<#RGK_45#>' : gkAgo(d.last)) + '</td>'
+      + '<td><select class="rowsel" onchange="gkSet(\'' + d.mac + '\', this.value)">'
+      + '<option value="" selected disabled>...</option>'
+      + '<option value="1"><#RGK_11#></option><option value="2"><#RGK_06#></option>'
+      + '<option value="3"><#RGK_07#></option><option value="0"><#RGK_13#></option>'
+      + '<option value="-1"><#RGK_55#></option>'
+      + '</select></td></tr>';
+  }
+  document.getElementById('devrows').innerHTML = rows || '<tr><td colspan="6" class="nopend"><#RGK_56#></td></tr>';
+}
+
+function gkFilter(el){
+  GK.filter = el.getAttribute('data-f');
+  var c = document.querySelectorAll('.fchip');
+  for(var i = 0; i < c.length; i++) c[i].className = 'fchip' + (c[i] === el ? ' on' : '');
+  gkRender();
+}
+
+function gkAct(url){
+  if(GK.busy) return;
+  GK.busy = true;
+  gkGet(url + '&http_id=' + encodeURIComponent(REAPER_HTTPID), function(){ GK.busy = false; gkRefresh(); });
+}
+function gkSet(mac, state){
+  if(String(state) === '-1'){ gkAct('/reaper_gk.cgi?action=remove&mac=' + encodeURIComponent(mac)); return; }
+  gkAct('/reaper_gk.cgi?action=set&mac=' + encodeURIComponent(mac) + '&state=' + state);
+}
+function gkToggle(){
+  var on = document.getElementById('tgmaster').className.indexOf('on') >= 0;
+  gkAct('/reaper_gk.cgi?action=config&enable=' + (on ? 0 : 1));
+}
+function gkTg(el){
+  var key = el.id === 's_captive' ? 'captive' : 'notify';
+  var on = el.className.indexOf('on') >= 0;
+  gkAct('/reaper_gk.cgi?action=config&' + key + '=' + (on ? 0 : 1));
+}
+function gkCfg(){
+  gkAct('/reaper_gk.cgi?action=config&def=' + document.getElementById('s_def').value
+    + '&guest_hours=' + document.getElementById('s_hours').value);
+}
+
+gkRefresh();
+setInterval(gkRefresh, 5000);
+</script>
+</body>
+</html>
