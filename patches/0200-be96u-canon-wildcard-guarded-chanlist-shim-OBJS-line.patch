From e426b542d37a3afe514f5b8b4ee639d58fa82f4a Mon Sep 17 00:00:00 2001
From: reaper <theunbounddeveloper@outlook.com>
Date: Tue, 21 Jul 2026 14:45:52 -0400
Subject: [PATCH] be96u canon: wildcard-guarded chanlist-shim OBJS line + track
 openvpn/.gitattributes

Port-proofing from the GT-BE98 v1.7.0 build campaign: (1) the shim OBJS line is
wildcard-guarded (no-op where the file is absent) so model ports that checkout
rc/Makefile can never clobber a model's shim again; (2) .gitattributes is an
all-am prerequisite of openvpn and was untracked - tracking it so no clean or
fresh clone loses it.
---
 release/src/router/openvpn/.gitattributes | 1 +
 release/src/router/rc/Makefile            | 1 +
 2 files changed, 2 insertions(+)
 create mode 100644 release/src/router/openvpn/.gitattributes

diff --git a/release/src/router/openvpn/.gitattributes b/release/src/router/openvpn/.gitattributes
new file mode 100644
index 0000000000..74883d840a
--- /dev/null
+++ b/release/src/router/openvpn/.gitattributes
@@ -0,0 +1 @@
+*.[ch] whitespace=space-before-tab,indent-with-non-tab,trailing-space
diff --git a/release/src/router/rc/Makefile b/release/src/router/rc/Makefile
index d17a302a6c..bb0859f292 100644
--- a/release/src/router/rc/Makefile
+++ b/release/src/router/rc/Makefile
@@ -464,6 +464,7 @@ endif
 
 ifeq ($(CONFIG_BCMWL5),y)
 OBJS += init-broadcom.o wps-broadcom.o broadcom.o ate-broadcom.o
+OBJS += $(if $(wildcard reaper_chanlist_shim.c),reaper_chanlist_shim.o)
 ifeq ($(BUILD_NAME),$(filter $(BUILD_NAME),RP-AX56))
 OBJS += rpmac.o
 endif
-- 
