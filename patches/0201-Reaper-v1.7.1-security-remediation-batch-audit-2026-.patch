+	 * mutating action (capstart/capstop/scanstart/scanstop/chqset) is gated. */
+	if (strcmp(act, "status") != 0 && strcmp(act, "capdata") != 0 &&
+	    strcmp(act, "scandata") != 0 && strcmp(act, "chq") != 0) {
+		char *hid = get_cgi("http_id");
+		char *want = nvram_safe_get("http_id");
+		if (!hid || !want[0] || strcmp(hid, want) != 0) {
+			websWrite(stream, "{\"err\":\"token\"}");
+			return;
+		}
+	}
+
 	if (strcmp(act, "status") == 0) {
 		websWrite(stream, "{\"territory\":");
 		rwifi_json_str(stream, nvram_safe_get("territory_code"));
@@ -22439,12 +22457,23 @@ gk_rl_find(const char *rl, const char *mac, int *state, long *expiry)
 static void
 gk_rl_update(const char *mac, int state, long expiry)
 {
-	char *rl = nvram_safe_get("gk_rl");
-	size_t cap = strlen(rl) + 64;
-	char *out = calloc(1, cap);
-	char *buf = strdup(rl);
-	char *tok, *sp = NULL;
-	if (!out || !buf) { free(out); free(buf); return; }
+	char *rl, *out, *buf, *tok, *sp = NULL;
+	size_t cap;
+	/* serialize the gk_rl read-modify-write against gkd's expire_guests
+	 * (reaper v1.7.1, audit M2). The lock is held only across the tiny RMW
+	 * below - the fresh nvram read must happen INSIDE it. If /tmp/gk is not
+	 * yet present the lock is skipped (degrades to pre-1.7.1 behaviour). */
+	int lf = open("/tmp/gk/rl.lock", O_CREAT | O_RDWR, 0600);
+	if (lf >= 0) flock(lf, LOCK_EX);
+	rl = nvram_safe_get("gk_rl");
+	cap = strlen(rl) + 64;
+	out = calloc(1, cap);
+	buf = strdup(rl);
+	if (!out || !buf) {
+		free(out); free(buf);
+		if (lf >= 0) { flock(lf, LOCK_UN); close(lf); }
+		return;
+	}
 	for (tok = strtok_r(buf, "<", &sp); tok; tok = strtok_r(NULL, "<", &sp)) {
 		char m[18] = "";
 		if (sscanf(tok, "%17[^>]", m) != 1 || !gk_valid_mac(m)) continue;
@@ -22458,6 +22487,7 @@ gk_rl_update(const char *mac, int state, long expiry)
 		strlcat(out, add, cap);
 	}
 	nvram_set("gk_rl", out);
+	if (lf >= 0) { flock(lf, LOCK_UN); close(lf); }
 	free(out);
 	free(buf);
 }
