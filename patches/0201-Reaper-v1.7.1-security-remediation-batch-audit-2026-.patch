     return "";
   }
 
+  /* v1.7.1 (audit L2+L3): set the admin credential via POST so the base64
+     password rides the request BODY, not the GET query string, AND return a
+     checkable result (the shared httpApi.chpass defaults to GET and swallows
+     failures). Param contract mirrors httpApi.chpass exactly (btoa user+pw).
+     If POST fails for ANY reason (e.g. chpass.cgi is GET-only) we fall back to
+     the metal-proven shared GET path, so this can never reintroduce the
+     v1.6.6c lockout. Returns true only when the credential was actually set. */
+  function reaperSetCred(u, p){
+    try{
+      var x=new XMLHttpRequest();
+      var body="new_username="+encodeURIComponent(btoa(u))
+             + "&new_passwd="+encodeURIComponent(btoa(p))
+             + "&restart_httpd=0&defpass_enable=0";
+      x.open("POST","/chpass.cgi",false);
+      x.setRequestHeader("Content-Type","application/x-www-form-urlencoded");
+      x.send(body);
+      if(x.status===200){
+        var r=null; try{ r=JSON.parse(x.responseText); }catch(e){}
+        if(r && String(r.statusCode)==="200") return true;
+      }
+    }catch(e){}
+    /* fallback: proven shared GET path (metal-validated v1.6.6c) */
+    var sc=httpApi.chpass({"restart_httpd":"0","new_username":u,"new_passwd":p,"defpass_enable":"0"});
+    return (String(sc)==="200");
+  }
+
   function submit(){
     clrErr();
     var u=$("fb_user").value.trim(), p=$("fb_pw").value, p2=$("fb_pw2").value;
@@ -150,16 +176,13 @@ input:focus{border-color:var(--crimson)}
     if(msg){ showErr(msg); return; }
 
     $("fb_go").disabled=true; $("fb_spin").style.display="block";
-    /* httpApi.chpass is synchronous (async:false) -> http_passwd/http_username are
-       set in nvram (pw_enc-encrypted by do_chpass) before we continue. */
-    try{
-      httpApi.chpass({
-        "restart_httpd":"0",
-        "new_username":u,
-        "new_passwd":p,
-        "defpass_enable":"0"
-      });
-    }catch(e){
+    /* Synchronous credential set -> http_passwd/http_username are committed
+       (pw_enc-encrypted by do_chpass) before we continue. v1.7.1 (L3): unlike
