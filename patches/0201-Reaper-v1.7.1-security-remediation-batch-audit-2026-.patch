 #define CHAIN_STAMP   GK_DIR "/chains.ok"
 #define POLL_SECS     10
 #define WL_REFRESH    3        /* assoclist sweep every POLL_SECS * WL_REFRESH */
+#define HEAL_EVERY    3        /* self-heal probe every POLL_SECS * HEAL_EVERY (v1.7.1 L5) */
 #define MAX_DEV       256
+#define DEV_TTL       (24*3600) /* evict a device unseen this long (v1.7.1 L4) */
 #define LEASE_FILE    "/var/lib/misc/dnsmasq.leases"
 
 typedef struct {
@@ -247,6 +251,48 @@ static void write_seen(void)
 	rename(SEEN_TMP, SEEN_TSV);
 }
 
+/* L4 (v1.7.1): drop devices unseen within DEV_TTL so the fixed devs[] table
+ * cannot wedge at MAX_DEV on a busy/guest-heavy LAN and silently stop
+ * discovering new MACs. Enforcement is unaffected (the iptables/ebtables
+ * catch-all handles unknowns); this only keeps visibility + new-device
+ * alerts working on long uptime. */
+static void compact_devs(long now)
+{
+	int i, k = 0;
+	for (i = 0; i < ndev; i++)
+		if (devs[i].online || (now - devs[i].last) < DEV_TTL)
+			devs[k++] = devs[i];
+	ndev = k;
+}
+
+/* I1 (v1.7.1): reload the last seen.tsv on startup so a self-restart
+ * (restart_gk fired by a guest-pass expiry) does not reset first-seen times or
+ * re-log every already-known device as "new". Manual tab-split so an empty
+ * field (e.g. a device with no hostname) is preserved, not swallowed. */
+static void load_seen(void)
+{
+	FILE *f = fopen(SEEN_TSV, "r");
+	char line[256];
+	if (!f) return;
+	while (ndev < MAX_DEV && fgets(line, sizeof(line), f)) {
+		char *fld[8]; int nf = 0; char *p = line, *nl;
+		dev_t_gk *d;
+		if ((nl = strchr(line, '\n')) != NULL) *nl = 0;
+		fld[nf++] = p;
+		while (nf < 8 && (p = strchr(p, '\t')) != NULL) { *p++ = 0; fld[nf++] = p; }
+		if (nf < 7 || !valid_mac(fld[0])) continue;
+		d = &devs[ndev];
+		memset(d, 0, sizeof(*d));
+		snprintf(d->mac, sizeof(d->mac), "%s", fld[0]);
+		norm_mac(d->mac);
+		d->first = strtol(fld[5], NULL, 10);
+		d->last  = strtol(fld[6], NULL, 10);
+		d->logged = 1;	/* known before restart - suppress duplicate new-device log */
+		ndev++;
+	}
+	fclose(f);
+}
+
 static void notify_new(const char *rl)
 {
 	int i;
@@ -264,16 +310,23 @@ static void notify_new(const char *rl)
 	}
 }
 
-static void expire_guests(const char *rl_in)
+static void expire_guests(void)
 {
-	char *rl = strdup(rl_in), *out, *tok, *sp = NULL;
-	int changed = 0;
+	char *rl, *out, *tok, *sp = NULL;
+	int changed = 0, lf;
 	long now = time(NULL);
 	size_t cap;
-	if (!rl) return;
+	/* M2 (v1.7.1): serialize against httpd gk_rl_update and read gk_rl FRESH
+	 * inside the lock - never the poll-start snapshot, which is seconds stale
+	 * after the blocking scans and would clobber an admin approve/block that
+	 * landed during this poll. */
+	lf = open(GK_DIR "/rl.lock", O_CREAT | O_RDWR, 0600);
+	if (lf >= 0) flock(lf, LOCK_EX);
+	rl = strdup(nvram_safe_get("gk_rl"));
+	if (!rl) { if (lf >= 0) { flock(lf, LOCK_UN); close(lf); } return; }
 	cap = strlen(rl) + 2;
 	out = calloc(1, cap);
-	if (!out) { free(rl); return; }
+	if (!out) { free(rl); if (lf >= 0) { flock(lf, LOCK_UN); close(lf); } return; }
 	/* entries are "<MAC>state>expiry" - split on '<' */
 	for (tok = strtok_r(rl, "<", &sp); tok; tok = strtok_r(NULL, "<", &sp)) {
 		char mac[18] = ""; int st = -1; long exp = 0;
@@ -289,8 +342,10 @@ static void expire_guests(const char *rl_in)
 	if (changed) {
 		nvram_set("gk_rl", out);
 		nvram_commit();
-		notify_rc("restart_gk");
 	}
+	if (lf >= 0) { flock(lf, LOCK_UN); close(lf); }
+	if (changed)
+		notify_rc("restart_gk");	/* outside the lock - it kills+respawns this gkd */
 	free(out);
 	free(rl);
 }
@@ -304,7 +359,13 @@ static void self_heal(void)
 	 * teardown+rebuild, safe to re-run. */
 	struct stat st;
 	if (stat(APPLY_SH, &st)) return;
+	/* §4 (v1.7.1): probe EVERY enforcement component, not just GKF + the
+	 * ebtables hook. apply.sh always creates GKF/GKI/GKN (v4+v6) and the
+	 * ebtables chain, so any one missing means a flush occurred - reapply. */
 	if (system("iptables -nL REAPER_GKF >/dev/null 2>&1") == 0 &&
+	    system("iptables -nL REAPER_GKI >/dev/null 2>&1") == 0 &&
+	    system("iptables -t nat -nL REAPER_GKN >/dev/null 2>&1") == 0 &&
+	    system("ip6tables -nL REAPER_GKF >/dev/null 2>&1") == 0 &&
 	    system("ebtables -L FORWARD 2>/dev/null | grep -q REAPER_GK") == 0)
 		return;
 	logmessage("gatekeeper", "enforcement chains missing (firewall/wireless restart?) - reapplying");
@@ -322,6 +383,7 @@ int main(int argc, char **argv)
 
 	if (daemon(1, 0) < 0) return 1;
 	mkdir(GK_DIR, 0700);
+	load_seen();	/* I1: restore known devices so a self-restart doesn't re-log them */
 	logmessage("gatekeeper", "watcher started (%s mode)",
 		nvram_match("gk_default", "1") ? "alert-only" : "quarantine");
 
@@ -334,12 +396,14 @@ int main(int argc, char **argv)
 		scan_arp(now);
 		scan_ndp(now);
 		scan_leases();
-		if ((tick++ % WL_REFRESH) == 0) scan_wl();
+		if ((tick % WL_REFRESH) == 0) scan_wl();
 
+		compact_devs(now);	/* L4: evict stale entries before the table fills */
 		notify_new(rl);
-		expire_guests(rl);
+		expire_guests();	/* M2: reads gk_rl fresh under lock (rl above is snapshot for notify_new only) */
 		write_seen();
-		self_heal();
+		if ((tick % HEAL_EVERY) == 0) self_heal();	/* L5: throttle the probe forks */
+		tick++;
 
 		for (i = 0; i < POLL_SECS && !g_stop; i++) sleep(1);
 	}
