 #include <sys/stat.h>
 
 #include "rc.h"
@@ -45,6 +46,22 @@
 #define GK_DIR    "/tmp/gk"
 #define GK_APPLY  GK_DIR "/apply.sh"
 
+/* strict MAC check - identical to httpd gk_valid_mac / gkd valid_mac. Every
+ * gk_rl consumer validates before use; this generator must too, since the
+ * mac flows UNQUOTED into the root-run apply.sh (a hostile 17-char token with
+ * shell metacharacters would otherwise inject). Not reachable via the feature
+ * writers (all validate), but closes the sink for a direct-nvram-seeded value. */
+static int gk_valid_mac(const char *m)
+{
+	int i;
+	if (!m || strlen(m) != 17) return 0;
+	for (i = 0; i < 17; i++) {
+		if ((i % 3) == 2) { if (m[i] != ':') return 0; }
+		else if (!isxdigit((unsigned char)m[i])) return 0;
+	}
+	return 1;
+}
+
 /* emit one per-MAC rule line into every chain that takes it */
 static void gk_emit_mac(FILE *f, const char *mac, int state, int quarantine)
 {
@@ -120,7 +137,7 @@ static void gk_gen_apply(void)
 			char mac[18] = "";
 			int st = -1;
 			if (sscanf(tok, "%17[^>]>%d", mac, &st) != 2) continue;
-			if (strlen(mac) != 17 || st < 0 || st > 3) continue;
+			if (!gk_valid_mac(mac) || st < 0 || st > 3) continue;
 			gk_emit_mac(f, mac, st, quarantine);
 		}
 		free(buf);
