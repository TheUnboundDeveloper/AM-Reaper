From 12a2af2c970a3cd55e32ff3ac59065f74a6edd40 Mon Sep 17 00:00:00 2001
From: reaper <theunbounddeveloper@outlook.com>
Date: Wed, 22 Jul 2026 14:53:17 -0400
Subject: [PATCH 207/211] webui: kill the stock-style flash before the Reaper
 theme paints

Some framed menus showed the stock ASUS blue for a split second before the
Reaper theme applied. Two layers close it:

- httpd/reaper_inject.c: the serve-time injected head block now carries an
  inline <style>html,body{background:#08080a}</style> ahead of the theme
  <link>. Inline = zero fetch, so the very first paint is already matte-black
  even when the stylesheet is revalidating or a nested/SPA bundle applies late.
  Not !important, so reaper_content.css wins once it is live.
- www/reaper_shell.asp: a frame 'veil' - the content iframe is hidden the
  instant a page swap starts (loadPage) and revealed only once the document is
  themed (serve-time-themed pages on load; runtime-injected pages when their
  injected stylesheet's onload fires). A 700ms failsafe timer guarantees the
  frame is never left hidden on a slow page, where the dark pre-paint above
  covers the remainder.

CSS/JS only, no behavior change.

Co-Authored-By: Claude Fable 5 <noreply@anthropic.com>
---
 release/src/router/httpd/reaper_inject.c |  6 ++++++
 release/src/router/www/reaper_shell.asp  | 26 ++++++++++++++++++++----
 2 files changed, 28 insertions(+), 4 deletions(-)

diff --git a/release/src/router/httpd/reaper_inject.c b/release/src/router/httpd/reaper_inject.c
index e4bb16df8d..bceb76c766 100644
--- a/release/src/router/httpd/reaper_inject.c
+++ b/release/src/router/httpd/reaper_inject.c
@@ -48,6 +48,12 @@
  * loads that are not suppressed. */
 static const char REAPER_BLOCK[] =
 	"<link rel=\"stylesheet\" type=\"text/css\" href=\"/reaper/reaper_content.css\">"
+	/* Anti-flash pre-paint (backlog 2026-07-22): an inline style costs no fetch,
+	 * so the very first paint is already matte-black even on any path where a
+	 * late-applying layer (SPA bundle css, nested frame, slow stylesheet
+	 * revalidation) briefly showed the stock ASUS colors. Deliberately NOT
+	 * !important: once reaper_content.css is live its rules take over. */
+	"<style>html,body{background:#08080a}</style>"
 	"<script>(function(){var rp=location.pathname.split(\"/\").pop()||\"index.asp\";"
 	"var SUP={\"main_trafficmonitor_realtime.asp\":\"Reaper_Traffic.asp\","
 	"\"main_trafficmonitor_last24.asp\":\"Reaper_Traffic.asp\","
diff --git a/release/src/router/www/reaper_shell.asp b/release/src/router/www/reaper_shell.asp
index e01af45c4f..ee139d0a7e 100644
--- a/release/src/router/www/reaper_shell.asp
+++ b/release/src/router/www/reaper_shell.asp
@@ -113,7 +113,11 @@ a.item.on::before{content:"";position:absolute;left:0;top:7px;bottom:7px;width:2
 #tabbar a.rtab:hover{color:var(--bone);background:var(--panel-2)}
 #tabbar a.rtab.on{color:var(--bone);background:linear-gradient(180deg,rgba(225,6,0,.22),var(--panel-2));
   border-color:rgba(225,6,0,.35);box-shadow:inset 0 -2px 0 var(--crimson)}
-#page_frame{width:100%;flex:1 1 auto;border:0;display:block;background:var(--bg);min-height:calc(100vh - 64px);overflow:hidden}
+#page_frame{width:100%;flex:1 1 auto;border:0;display:block;background:var(--bg);min-height:calc(100vh - 64px);overflow:hidden;opacity:1;transition:opacity .12s ease}
+/* anti-flash veil (backlog 2026-07-22): hidden instantly on a page swap, revealed
+   once the new document is themed (or by the loadPage failsafe timer) - masks any
+   split-second stock-styled paint, esp. pages themed by the runtime injector below */
+#page_frame.veil{opacity:0;transition:none}
 .mono{font-family:ui-monospace,'Cascadia Code',Consolas,monospace}
 /* drop the lowest-priority pills before the header can clip at 1080p / 125% */
 @media (max-width:1700px){ .pills .pill:nth-child(n+6){display:none} }
@@ -278,7 +282,16 @@ function renderTabs(page){
 
 function loadPage(page){
   var f=$id('page_frame');
-  if(f) f.src = frameUrl(page);
+  if(f){
+    /* anti-flash veil: hide the frame for the swap; the load handler below
+       reveals it once the document is themed. The 700ms failsafe keeps slow
+       server-side pages from sitting hidden - past that the dark pre-paint
+       (reaper_inject.c) covers the remaining load. */
+    f.classList.add('veil');
+    clearTimeout(f._veilT);
+    f._veilT=setTimeout(function(){ f.classList.remove('veil'); }, 700);
+    f.src = frameUrl(page);
+  }
   try{ history.replaceState(null, '', '/reaper_shell.asp#' + page); }catch(e){}
   var links=document.querySelectorAll('#rail a.item');
   for(var i=0;i<links.length;i++){
@@ -351,15 +364,20 @@ function buildRail(menuTree){
   var f=$id('page_frame');
   if(!f) return;
   f.addEventListener('load', function(){
+    /* anti-flash veil reveal (see loadPage): a serve-time-themed page is safe to
+       show at load; a runtime-injected page stays veiled until its stylesheet
+       lands so the stock colors never paint. Failsafe timer still backstops. */
+    var unveil=function(){ clearTimeout(f._veilT); f.classList.remove('veil'); };
     try{
       var d=this.contentDocument;
       /* reaper-native pages (meta reaper-native) carry their own full theme;
          reaper_content.css targets STOCK markup and would fight them */
-      if(!d || d.querySelector('link[href*="reaper_content"]') || d.querySelector('meta[name="reaper-native"]')) return;
+      if(!d || d.querySelector('link[href*="reaper_content"]') || d.querySelector('meta[name="reaper-native"]')){ unveil(); return; }
       var l=d.createElement('link');
       l.rel='stylesheet'; l.type='text/css'; l.href='/reaper/reaper_content.css';
+      l.onload=unveil; l.onerror=unveil;
       (d.head||d.documentElement).appendChild(l);
-    }catch(e){}
+    }catch(e){ unveil(); }
   });
 })();
 
