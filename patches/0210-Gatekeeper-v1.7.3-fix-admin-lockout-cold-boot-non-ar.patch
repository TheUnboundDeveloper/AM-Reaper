--- a/release/src/router/gkd/gkd.c
+++ b/release/src/router/gkd/gkd.c
@@ -356,19 +356,49 @@ static void self_heal(void)
 	 * start_lan/lan_up/restart_wireless/setup_dnsmq/wanduck run a full
 	 * "ebtables -F" (chains survive but EMPTY, hook rules gone) - so test
 	 * the iptables CHAIN but the ebtables HOOK RULE. apply.sh is a full
-	 * teardown+rebuild, safe to re-run. */
+	 * teardown+rebuild, safe to re-run.
+	 *
+	 * reaper v1.7.3: also maintains /tmp/gk/chains.ok - the "armed" stamp the
+	 * status CGI reports to the UI - and logs only the armed<->unarmed
+	 * TRANSITIONS, so a cold-boot deferral (LAN not up yet, apply.sh re-runs
+	 * every cycle) does not spam the log while it waits for the bridge. */
+	static int last_armed = -1;	/* -1 = unknown at startup */
 	struct stat st;
-	if (stat(APPLY_SH, &st)) return;
+	int armed;
+
+	/* gkd is killed+respawned by restart_gk on every guest-pass expiry; seed
+	 * the transition tracker from the persisted stamp so a respawn while already
+	 * armed does not re-log a phantom "enforcement active". */
+	if (last_armed == -1)
+		last_armed = (stat(CHAIN_STAMP, &st) == 0) ? 1 : 0;
+
+	if (stat(APPLY_SH, &st)) {
+		if (last_armed != 0) { unlink(CHAIN_STAMP); last_armed = 0; }
+		return;
+	}
 	/* §4 (v1.7.1): probe EVERY enforcement component, not just GKF + the
 	 * ebtables hook. apply.sh always creates GKF/GKI/GKN (v4+v6) and the
 	 * ebtables chain, so any one missing means a flush occurred - reapply. */
-	if (system("iptables -nL REAPER_GKF >/dev/null 2>&1") == 0 &&
-	    system("iptables -nL REAPER_GKI >/dev/null 2>&1") == 0 &&
-	    system("iptables -t nat -nL REAPER_GKN >/dev/null 2>&1") == 0 &&
-	    system("ip6tables -nL REAPER_GKF >/dev/null 2>&1") == 0 &&
-	    system("ebtables -L FORWARD 2>/dev/null | grep -q REAPER_GK") == 0)
+	armed = (system("iptables -nL REAPER_GKF >/dev/null 2>&1") == 0 &&
+	         system("iptables -nL REAPER_GKI >/dev/null 2>&1") == 0 &&
+	         system("iptables -t nat -nL REAPER_GKN >/dev/null 2>&1") == 0 &&
+	         system("ip6tables -nL REAPER_GKF >/dev/null 2>&1") == 0 &&
+	         system("ebtables -L FORWARD 2>/dev/null | grep -q REAPER_GK") == 0);
+
+	if (armed) {
+		int fd = open(CHAIN_STAMP, O_CREAT | O_WRONLY | O_TRUNC, 0600);
+		if (fd >= 0) close(fd);
+		if (last_armed != 1) {
+			logmessage("gatekeeper", "enforcement active");
+			last_armed = 1;
+		}
 		return;
-	logmessage("gatekeeper", "enforcement chains missing (firewall/wireless restart?) - reapplying");
+	}
+	unlink(CHAIN_STAMP);
+	if (last_armed != 0) {
+		logmessage("gatekeeper", "enforcement chains missing (firewall/wireless restart or LAN not ready) - reapplying");
+		last_armed = 0;
+	}
 	system("sh " APPLY_SH);
 }
 
diff --git a/release/src/router/httpd/httpd.c b/release/src/router/httpd/httpd.c
index e07464267f..ff0b3f8ca1 100644
--- a/release/src/router/httpd/httpd.c
+++ b/release/src/router/httpd/httpd.c
@@ -1299,6 +1299,20 @@ reaper_gk_captive_check(const char *client_ip)
 
 	if (!nvram_match("gk_enable", "1"))
 		return 0;
+	/* reaper v1.7.3 admin escape hatch: never serve the waiting page on the
+	 * HTTPS admin instance (do_ssl). Captive interception is for plain-HTTP OS
+	 * portal probes; masking HTTPS would fence a held admin off from the very
+	 * page that disables Gatekeeper. The REAPER_GKI firewall chain likewise
+	 * always permits the HTTPS admin port, so the owner can always recover. */
+	if (do_ssl)
+		return 0;
+	/* HTTP-only router (no HTTPS instance): the escape hatch lives on the
+	 * plain-HTTP admin port, so we must not captive-intercept it or the owner
+	 * is locked out. Enforcement still holds via the REAPER_GKF/ebtables gates;
+	 * only the waiting-room page is skipped in this uncommon config (gatekeeper.c
+	 * likewise suppresses the port-80 DNAT when http_enable==0). */
+	if (nvram_get_int("http_enable") == 0)
+		return 0;
 	if (nvram_match("gk_captive", "0") || nvram_match("gk_default", "1"))
 		return 0;
 	if (!client_ip || !client_ip[0] || !strcmp(client_ip, "127.0.0.1"))
diff --git a/release/src/router/httpd/web.c b/release/src/router/httpd/web.c
