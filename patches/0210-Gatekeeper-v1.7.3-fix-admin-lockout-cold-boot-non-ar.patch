@@ -22594,40 +22594,104 @@ gk_emit_seen(FILE *stream, struct gk_seen *d, int rand_flag)
 	websWrite(stream, "}");
 }
 
-/* one-time approve-everything-present baseline when the feature is enabled
- * with an empty list; sources ARP directly since gkd has never run yet */
+/* append "<MAC>1>0" (approved/full) to the baseline buffer, uppercased,
+ * validated, and de-duplicated. reaper v1.7.3 */
+static void
+gk_seed_add(char *out, size_t cap, const char *macraw)
+{
+	char mac[18], key[20], add[48];
+	int i;
+	if (!macraw || strlen(macraw) != 17)
+		return;
+	for (i = 0; i < 17; i++)
+		mac[i] = toupper((unsigned char)macraw[i]);
+	mac[17] = 0;
+	if (!gk_valid_mac(mac))
+		return;
+	/* never grandfather broadcast / all-zero (can appear in leases/clientlist);
+	 * matches gkd's valid_mac() rejects. */
+	if (!strcasecmp(mac, "FF:FF:FF:FF:FF:FF") || !strcasecmp(mac, "00:00:00:00:00:00"))
+		return;
+	snprintf(key, sizeof(key), "<%s>", mac);
+	if (strcasestr(out, key))		/* already grandfathered from another source */
+		return;
+	snprintf(add, sizeof(add), "<%s>1>0", mac);
+	if (strlen(out) + strlen(add) + 1 < cap)
+		strlcat(out, add, cap);
+}
+
+/* one-time approve-everything-known baseline when the feature is enabled with
+ * an empty list. reaper v1.7.3: unions live ARP with the DHCP lease table and
+ * the router's known-client registry so devices that are merely asleep/idle at
+ * enable time (or IPv6-only) are grandfathered too - the ARP-only snapshot
+ * mass-quarantined half a normal household the instant the switch was flipped. */
 static void
 gk_baseline_snapshot(void)
 {
-	FILE *f = fopen("/proc/net/arp", "r");
-	char line[256], ip[64], hw[64], dif[32];
-	unsigned flags;
-	char *rl;
-	size_t cap = 1;
-	char *out;
-	if (!f) return;
-	out = calloc(1, cap = 8192);
-	if (!out) { fclose(f); return; }
-	if (fgets(line, sizeof(line), f)) { /* header */ }
-	while (fgets(line, sizeof(line), f)) {
-		if (sscanf(line, "%63s 0x%*x 0x%x %63s %*s %31s", ip, &flags, hw, dif) != 4)
-			continue;
-		if (!(flags & 2) || strncmp(dif, "br", 2) || !gk_valid_mac(hw))
-			continue;
-		{
-			char add[48];
-			int i;
-			for (i = 0; hw[i]; i++) hw[i] = toupper((unsigned char)hw[i]);
-			snprintf(add, sizeof(add), "<%s>1>0", hw);
-			if (strlen(out) + strlen(add) + 1 < cap)
-				strlcat(out, add, cap);
+	const size_t cap = 16384;
+	char line[512];
+	char *out, *rl;
+	FILE *f;
+	int n = 0;
+
+	out = calloc(1, cap);
+	if (!out)
+		return;
+
+	/* 1. live ARP - completed entries on the LAN bridge (currently talking) */
+	f = fopen("/proc/net/arp", "r");
+	if (f) {
+		char ip[64], hw[64], dif[32];
+		unsigned flags;
+		if (fgets(line, sizeof(line), f)) { /* header */ }
+		while (fgets(line, sizeof(line), f)) {
+			if (sscanf(line, "%63s 0x%*x 0x%x %63s %*s %31s", ip, &flags, hw, dif) != 4)
+				continue;
+			if (!(flags & 2) || strncmp(dif, "br", 2))
+				continue;
+			gk_seed_add(out, cap, hw);
 		}
+		fclose(f);
+	}
+
+	/* 2. DHCP leases - devices the router knows but that are asleep/idle now */
+	f = fopen("/var/lib/misc/dnsmasq.leases", "r");
+	if (f) {
+		char mac[64];
+		while (fgets(line, sizeof(line), f)) {
+			if (sscanf(line, "%*s %63s", mac) != 1)
+				continue;
+			gk_seed_add(out, cap, mac);
+		}
+		fclose(f);
+	}
+
+	/* 3. custom_clientlist "<name>MAC>type>..." - the named-client registry */
+	{
+		char *buf = strdup(nvram_safe_get("custom_clientlist"));
+		char *tok, *sp = NULL;
+		if (buf) {
+			for (tok = strtok_r(buf, "<", &sp); tok; tok = strtok_r(NULL, "<", &sp)) {
+				char *m = strchr(tok, '>'), *m2;
+				if (!m)
+					continue;
+				m++;
+				if ((m2 = strchr(m, '>')) != NULL)
+					*m2 = 0;
+				gk_seed_add(out, cap, m);
+			}
+			free(buf);
+		}
+	}
+
+	{
+		char *q = out;
+		while ((q = strchr(q, '<')) != NULL) { n++; q++; }
 	}
-	fclose(f);
 	rl = nvram_safe_get("gk_rl");
 	if (!rl[0] && out[0]) {
 		nvram_set("gk_rl", out);
-		logmessage("gatekeeper", "enabled - baseline snapshot approved the devices already present");
+		logmessage("gatekeeper", "enabled - baseline approved %d known device(s) (ARP + DHCP leases + client list)", n);
 	}
 	free(out);
 }
@@ -22656,8 +22720,13 @@ do_reaper_gk_cgi(char *url, FILE *stream)
 		int i, first;
 		char *buf, *tok, *sp = NULL;
 
-		websWrite(stream, "{\"enable\":%d,\"def\":%d,\"guest_hours\":%d,\"captive\":%d,\"notify\":%d",
+		/* reaper v1.7.3: "armed" reflects whether the enforcement chains are
+		 * actually present (gkd stamps /tmp/gk/chains.ok when they are). It can
+		 * lag "enable" right after a cold boot until the LAN bridge comes up -
+		 * the UI surfaces that gap so the admin is never left guessing. */
+		websWrite(stream, "{\"enable\":%d,\"armed\":%d,\"def\":%d,\"guest_hours\":%d,\"captive\":%d,\"notify\":%d",
 			nvram_match("gk_enable", "1") ? 1 : 0,
+			f_exists("/tmp/gk/chains.ok") ? 1 : 0,
 			nvram_match("gk_default", "1") ? 1 : 0,
 			nvram_get_int("gk_guest_hours") > 0 ? nvram_get_int("gk_guest_hours") : 24,
 			nvram_match("gk_captive", "0") ? 0 : 1,
diff --git a/release/src/router/rc/gatekeeper.c b/release/src/router/rc/gatekeeper.c
index 1c6e236973..016801dc02 100644
--- a/release/src/router/rc/gatekeeper.c
+++ b/release/src/router/rc/gatekeeper.c
@@ -45,6 +45,7 @@
 
 #define GK_DIR    "/tmp/gk"
 #define GK_APPLY  GK_DIR "/apply.sh"
+#define GK_STAMP  GK_DIR "/chains.ok"	/* gkd's "armed" marker; keep in lockstep with gkd.c CHAIN_STAMP */
 
 /* strict MAC check - identical to httpd gk_valid_mac / gkd valid_mac. Every
  * gk_rl consumer validates before use; this generator must too, since the
@@ -98,17 +99,37 @@ static void gk_gen_apply(void)
 {
 	FILE *f;
 	char *rl, *buf, *tok, *sp = NULL;
-	const char *lanif = nvram_safe_get("lan_ifname");
-	const char *lanip = nvram_safe_get("lan_ipaddr");
 	int quarantine = !nvram_match("gk_default", "1");
-	int captive = !nvram_match("gk_captive", "0");
 
 	f = fopen(GK_APPLY, "w");
 	if (!f) return;
 
+	/* reaper v1.7.3: the LAN identity (bridge ifname, router IP, admin port) is
+	 * resolved at RUN time via `nvram get`, not baked in when this script is
+	 * generated. On a cold boot start_gk can fire before the LAN bridge exists;
+	 * a later re-run of this same script by the firewall hook or gkd self-heal
+	 * (once the bridge is up) then arms correctly with no regeneration. If the
+	 * bridge is still not ready the script defers cleanly (exit 1) rather than
+	 * writing half-built rules with an empty interface. */
 	fprintf(f, "#!/bin/sh\n"
 		   "# generated by start_gk - do not edit; idempotent (teardown+rebuild)\n"
-		   "LANIF=%s\n"
+		   "LANIF=\"$(nvram get lan_ifname)\"\n"
+		   "LANIP=\"$(nvram get lan_ipaddr)\"\n"
+		   /* Admin escape-hatch port. With HTTPS admin present (http_enable != 0) a
+		    * held device reaches the real login on the HTTPS port - the httpd
+		    * do_ssl carve-out serves the login there, not the waiting page. On an
+		    * HTTP-only router (http_enable == 0) there is no HTTPS instance, so the
+		    * hatch falls back to the plain-HTTP admin port and the captive redirect
+		    * is suppressed below, else the owner would be locked out. Fallbacks
+		    * mirror start_httpd (443 / 80); a non-numeric value is rejected. */
+		   "GKHTTPEN=\"$(nvram get http_enable)\"\n"
+		   "GKADMIN=\"$(nvram get https_lanport)\"\n"
+		   "[ \"$GKHTTPEN\" = \"0\" ] && GKADMIN=\"$(nvram get http_lanport)\"\n"
+		   "case \"$GKADMIN\" in ''|0|*[!0-9]*) if [ \"$GKHTTPEN\" = \"0\" ]; then GKADMIN=80; else GKADMIN=443; fi;; esac\n"
+		   "if [ -z \"$LANIF\" ]; then\n"
+		   "  logger -t gatekeeper 'lan_ifname not ready - enforcement deferred' 2>/dev/null\n"
+		   "  exit 1\n"
+		   "fi\n"
 		   "# ---- teardown ----\n"
 		   "for T in iptables ip6tables; do\n"
 		   "  $T -D FORWARD -i $LANIF -j REAPER_GKF 2>/dev/null\n"
@@ -126,8 +147,7 @@ static void gk_gen_apply(void)
 		   "  $T -N REAPER_GKI\n"
 		   "done\n"
 		   "iptables -t nat -N REAPER_GKN\n"
-		   "ebtables -N REAPER_GK -P RETURN\n",
-		   lanif);
+		   "ebtables -N REAPER_GK -P RETURN\n");
 
 	/* per-device rules */
 	rl = nvram_safe_get("gk_rl");
@@ -155,17 +175,30 @@ static void gk_gen_apply(void)
 			"iptables -A REAPER_GKI -p udp --dport 53 -j RETURN\n"
 			"iptables -A REAPER_GKI -p tcp --dport 53 -j RETURN\n"
 			"iptables -A REAPER_GKI -p tcp --dport 80 -j RETURN\n"
+			/* reaper v1.7.3 admin escape hatch: a held device must ALWAYS be
+			 * able to reach the HTTPS admin UI to turn Gatekeeper back off,
+			 * otherwise a mis-grandfathered admin box (asleep/idle at enable
+			 * time, so not in the baseline) locks itself out with no recovery
+			 * short of a factory reset. HTTPS only - the plain-HTTP port stays
+			 * captive-redirected so OS portal probes still pop the sheet. */
+			"iptables -A REAPER_GKI -p tcp --dport $GKADMIN -j RETURN\n"
 			"iptables -A REAPER_GKI -j DROP\n"
 			"ip6tables -A REAPER_GKI -p icmpv6 -j RETURN\n"       /* NDP must live */
 			"ip6tables -A REAPER_GKI -p udp --dport 546:547 -j RETURN\n"
 			"ip6tables -A REAPER_GKI -p udp --dport 53 -j RETURN\n"
 			"ip6tables -A REAPER_GKI -p tcp --dport 53 -j RETURN\n"
 			"ip6tables -A REAPER_GKI -p tcp --dport 80 -j RETURN\n"
+			"ip6tables -A REAPER_GKI -p tcp --dport $GKADMIN -j RETURN\n"  /* admin escape hatch (v6) */
 			"ip6tables -A REAPER_GKI -j DROP\n"
 			"ebtables -A REAPER_GK -j DROP\n");
-		if (captive)
-			fprintf(f, "iptables -t nat -A REAPER_GKN -p tcp --dport 80 "
-				   "-j DNAT --to-destination %s:80\n", lanip);
+		/* captive redirect - decided at run time so it always agrees with httpd's
+		 * live view: only when gk_captive is on, an HTTPS admin instance exists
+		 * (http_enable != 0, so the escape hatch survives), and the router IP is
+		 * known (else the DNAT target would be malformed). */
+		fprintf(f,
+			"if [ \"$(nvram get gk_captive)\" != \"0\" ] && [ \"$GKHTTPEN\" != \"0\" ] && [ -n \"$LANIP\" ]; then\n"
+			"  iptables -t nat -A REAPER_GKN -p tcp --dport 80 -j DNAT --to-destination $LANIP:80\n"
+			"fi\n");
 	}
 
 	/* hooks at position 1: revocation must beat any ESTABLISHED shortcut */
@@ -209,6 +242,9 @@ void stop_gk(void)
 		killall_tk("gkd");
 	gk_teardown_rules();
 	unlink(GK_APPLY);
+	/* clear the "armed" marker so the UI never shows enforcing after a disable
+	 * (gkd is not respawned when gk_enable=0, so it can't clear it itself). */
+	unlink(GK_STAMP);
 }
 
 void start_gk(void)
@@ -220,6 +256,10 @@ void start_gk(void)
 		return;
