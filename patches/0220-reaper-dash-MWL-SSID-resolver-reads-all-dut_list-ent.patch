From 47dacfc931d069c92398733fa7691433ae99467e Mon Sep 17 00:00:00 2001
From: reaper <theunbounddeveloper@outlook.com>
Date: Sat, 25 Jul 2026 06:52:26 -0400
Subject: [PATCH 220/226] reaper dash: MWL SSID resolver reads all dut_list
 entries (MLO reorder fix)

The per-band tile SSID resolver read the SDN band bitmask from only the
first apmX_dut_list entry (dut[1]). Enabling MLO reorders the link entries,
pushing 2.4 GHz out of slot 0, so its band bit (1) was never matched and the
tile fell through to the wlX_ssid onboarding hex ID (raw "0204..." shown on
the 2.4 GHz card). Now OR the band bits across ALL dut entries, matching the
stock sdn.js parser (release/.../SDN/sdn.js) which accumulates. Order-
independent; only adds band matches so 5/6 GHz tiles are unaffected.
---
 release/src/router/www/Main_ReaperDash.asp | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/release/src/router/www/Main_ReaperDash.asp b/release/src/router/www/Main_ReaperDash.asp
index 7493048c35..4ad9a77910 100644
--- a/release/src/router/www/Main_ReaperDash.asp
+++ b/release/src/router/www/Main_ReaperDash.asp
@@ -1032,7 +1032,8 @@ function renderViewList(){
         var en=decodeURIComponent(a['apm'+idx+'_enable']||'');
         var ssid=decodeURIComponent(a['apm'+idx+'_ssid']||'');
         var dut=decodeURIComponent(a['apm'+idx+'_dut_list']||'').split('<');
-        var mask=(dut[1] ? parseInt(dut[1].split('>')[1]||'0',10) : 0)||0;
+        var mask=0;  /* OR band bits across ALL dut entries (stock sdn.js accumulates); reading only dut[1] dropped bands whose entry was not first */
+        for(var di=0;di<dut.length;di++){ if(dut[di]) mask|=(parseInt(dut[di].split('>')[1]||'0',10)||0); }
         if(en!=='1' || !ssid) continue;
         for(var wi=0; wi<WL.length; wi++){ var w=WL[wi]; if(!done[w.idx] && (mask & bandBits(w.nband))){ done[w.idx]=1; setTile(w, ssid); } }
       }
