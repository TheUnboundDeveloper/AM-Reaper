diff --git a/release/src/router/openssh-sftp/openbsd-compat/getcwd.c b/release/src/router/openssh-sftp/openbsd-compat/getcwd.c
new file mode 100644
index 0000000000..a904291a29
--- /dev/null
+++ b/release/src/router/openssh-sftp/openbsd-compat/getcwd.c
@@ -0,0 +1,242 @@
+/*	$OpenBSD: getcwd.c,v 1.14 2005/08/08 08:05:34 espie Exp */
+/*
+ * Copyright (c) 1989, 1991, 1993
+ *	The Regents of the University of California.  All rights reserved.
+ *
