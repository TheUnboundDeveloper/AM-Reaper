diff --git a/release/src/router/openssh-sftp/sshsig.c b/release/src/router/openssh-sftp/sshsig.c
new file mode 100644
index 0000000000..470b286a3a
--- /dev/null
+++ b/release/src/router/openssh-sftp/sshsig.c
@@ -0,0 +1,1157 @@
+/* $OpenBSD: sshsig.c,v 1.35 2024/03/08 22:16:32 djm Exp $ */
