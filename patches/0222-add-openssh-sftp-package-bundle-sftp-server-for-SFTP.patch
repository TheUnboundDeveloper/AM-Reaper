diff --git a/release/src/router/openssh-sftp/cipher.c b/release/src/router/openssh-sftp/cipher.c
new file mode 100644
index 0000000000..f12daa1234
--- /dev/null
+++ b/release/src/router/openssh-sftp/cipher.c
@@ -0,0 +1,505 @@
+/* $OpenBSD: cipher.c,v 1.121 2024/05/17 02:39:11 jsg Exp $ */
+/*
+ * Author: Tatu Ylonen <ylo@cs.hut.fi>
+ * Copyright (c) 1995 Tatu Ylonen <ylo@cs.hut.fi>, Espoo, Finland
+ *                    All rights reserved
+ *
