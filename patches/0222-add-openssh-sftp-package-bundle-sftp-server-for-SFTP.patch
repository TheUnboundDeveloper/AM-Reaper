diff --git a/release/src/router/openssh-sftp/addrmatch.c b/release/src/router/openssh-sftp/addrmatch.c
new file mode 100644
index 0000000000..b0dc096804
--- /dev/null
+++ b/release/src/router/openssh-sftp/addrmatch.c
@@ -0,0 +1,169 @@
+/*	$OpenBSD: addrmatch.c,v 1.17 2021/04/03 06:18:40 djm Exp $ */
+
+/*
+ * Copyright (c) 2004-2008 Damien Miller <djm@mindrot.org>
+ *
+ * Permission to use, copy, modify, and distribute this software for any
+ * purpose with or without fee is hereby granted, provided that the above
+ * copyright notice and this permission notice appear in all copies.
