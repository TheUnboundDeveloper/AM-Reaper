+u_int
+mm_do_pam_account(void)
+{
+	struct sshbuf *m;
+	u_int ret;
+	char *msg;
+	size_t msglen;
+	int r;
+
+	debug3("%s entering", __func__);
+	if (!options.use_pam)
+		fatal("UsePAM=no, but ended up in %s anyway", __func__);
