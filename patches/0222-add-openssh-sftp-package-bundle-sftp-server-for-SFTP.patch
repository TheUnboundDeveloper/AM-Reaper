diff --git a/release/src/router/openssh-sftp/openbsd-compat/bsd-pselect.c b/release/src/router/openssh-sftp/openbsd-compat/bsd-pselect.c
new file mode 100644
index 0000000000..b363208636
--- /dev/null
+++ b/release/src/router/openssh-sftp/openbsd-compat/bsd-pselect.c
@@ -0,0 +1,205 @@
+/*
+ * Copyright (c) 2001 Markus Friedl.  All rights reserved.
+ * Copyright (c) 2021 Darren Tucker (dtucker at dtucker net).
+ *
+ * Redistribution and use in source and binary forms, with or without
+ * modification, are permitted provided that the following conditions
