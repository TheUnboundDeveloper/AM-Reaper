diff --git a/release/src/router/Makefile b/release/src/router/Makefile
index 23ef6a4578..9b4f876a07 100644
--- a/release/src/router/Makefile
+++ b/release/src/router/Makefile
@@ -1649,6 +1649,7 @@ obj-$(RTCONFIG_HTTPS) += wget
 obj-$(RTCONFIG_HTTPS) += zlib
 obj-$(RTCONFIG_HTTPS) += curl
 obj-$(RTCONFIG_SSH) += dropbear
+obj-$(RTCONFIG_SSH) += openssh-sftp
 obj-$(RTCONFIG_WTFAST) += wtfast
 #obj-$(RTCONFIG_ZEBRA) += zebra
 obj-$(RTCONFIG_QUAGGA) += quagga
@@ -6455,6 +6456,28 @@ dropbear-clean:
 	-@$(MAKE) -C dropbear clean
 	@rm -f dropbear/config.h
 
+#openssh sftp-server: bundled SFTP subsystem binary for dropbear
+#(dropbear/localoptions.h SFTPSERVER_PATH=/usr/libexec/sftp-server). Cross-built
+#against the in-tree openssl+zlib; only the sftp-server target is compiled.
+openssh-sftp/stamp-h1:
+	cd $(TOP)/openssh-sftp && $(CONFIGURE) \
+		--without-pam --without-selinux --disable-strip \
+		--without-openssl-header-check \
+		--with-privsep-path=/var/empty --sysconfdir=/etc/ssh \
+		CPPFLAGS="-I$(TOP)/openssl/include -I$(TOP)/zlib" \
+		LDFLAGS="-L$(TOP)/openssl -L$(TOP)/zlib" && touch stamp-h1
+
+openssh-sftp: openssh-sftp/stamp-h1
+	@$(MAKE) -C openssh-sftp sftp-server
+
+openssh-sftp-install:
+	install -D openssh-sftp/sftp-server $(INSTALLDIR)/openssh-sftp/usr/libexec/sftp-server
+	$(STRIP) $(INSTALLDIR)/openssh-sftp/usr/libexec/sftp-server
+
+openssh-sftp-clean:
+	@[ ! -f openssh-sftp/Makefile ] || $(MAKE) -C openssh-sftp clean
+	@rm -f openssh-sftp/Makefile openssh-sftp/config.h openssh-sftp/stamp-h1
+
 wtfast-configure:
 	@true
 
