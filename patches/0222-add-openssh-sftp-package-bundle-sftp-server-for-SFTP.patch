+int
+parse_ipqos(const char *cp)
+{
+	const char *errstr;
+	u_int i;
+	int val;
+
+	if (cp == NULL)
+		return -1;
+	for (i = 0; ipqos[i].name != NULL; i++) {
+		if (strcasecmp(cp, ipqos[i].name) == 0)
+			return ipqos[i].value;
+	}
+	/* Try parsing as an integer */
+	val = (int)strtonum(cp, 0, 255, &errstr);
+	if (errstr)
+		return -1;
