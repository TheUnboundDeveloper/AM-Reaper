index 0000000000..445f2dd541
--- /dev/null
+++ b/release/src/router/openssh-sftp/authfile.c
@@ -0,0 +1,528 @@
+/* $OpenBSD: authfile.c,v 1.144 2023/03/14 07:26:25 dtucker Exp $ */
+/*
+ * Copyright (c) 2000, 2013 Markus Friedl.  All rights reserved.
+ *
