index 0000000000..5058b3ff6f
--- /dev/null
+++ b/release/src/router/rc/rwarden.c
@@ -0,0 +1,286 @@
+/*
+ * rc/rwarden.c - Reaper Warden: ipset-backed threat-feed / geo / manual IP
+ * firewall (RT-BE96U "reaper", v1.8.0).
+ *
+ * Model mirrors rc/gatekeeper.c: start_rwarden() writes an idempotent
+ * teardown+build shell script whose interface/subnet values are resolved at
+ * RUN time via `nvram get` (so a cold boot before the bridge is up defers
+ * cleanly and re-arms on the firewall hook), then runs it. A separate cron'd
+ * updater (rwarden_update) fetches feeds over the router's own HTTPS and loads
+ * them into ipset; sets are cached to /jffs so a boot with no internet keeps
+ * the last-good protection. No resident daemon.
+ *
+ * SETS (hash:net, IPv4):  rw_allow (never-block whitelist, checked first),
+ *   rw_ban (manual DROP), rw_threat (feed DROP), rw_geo (country DROP).
+ * CHAIN REAPER_WARDEN (INPUT+FORWARD): ESTABLISHED,RELATED -> RETURN; LAN
+ *   subnet -> RETURN; rw_allow -> RETURN; then rw_ban/rw_threat/rw_geo hit the
+ *   RW_DROP sub-chain (optional LOG then DROP). Anti-lockout is structural: the
+ *   admin's LAN and live conns can never be dropped (the Gatekeeper lesson).
+ *   Default OFF (opt-in) given lockout risk.
+ *
+ * nvram: rwarden_enable rwarden_feeds rwarden_geo rwarden_dir rwarden_ban
+ *        rwarden_allow rwarden_log rwarden_sched rwarden_lastupd
+ */
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <ctype.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+#include "rc.h"
+#include <shared.h>
+
+#define RW_DIR    "/tmp/rwarden"
+#define RW_APPLY  "/tmp/rwarden/apply.sh"
+#define RW_UPDATE "/tmp/rwarden/update.sh"
+#define RW_CACHE  "/jffs/rwarden"
+#define RW_SAVE   "/jffs/rwarden/sets.ipset"
+
+/* Curated open IP/CIDR feeds. id must be [a-z0-9]; url is emitted only into a
+ * single-quoted curl arg in the generated updater, and is a fixed literal here
+ * (never user data). Country lists come from ipdeny (CC-BY). */
+struct rw_feed { const char *id; const char *url; };
+static const struct rw_feed rw_feeds[] = {
+	{ "firehol1", "https://raw.githubusercontent.com/firehol/blocklist-ipsets/master/firehol_level1.netset" },
+	{ "feodo",    "https://feodotracker.abuse.ch/downloads/ipblocklist.txt" },
+	{ "spamhaus", "https://www.spamhaus.org/drop/drop.txt" },
+	{ "dshield",  "https://raw.githubusercontent.com/firehol/blocklist-ipsets/master/dshield.netset" },
+	{ NULL, NULL }
+};
+
+/* A single IPv4 address or CIDR, tokens only [0-9./]. Rejects anything that
+ * could break out of the ipset/iptables shell string (the S2/S7 audit lesson).
+ * Structural sanity only; ipset itself does the final parse. */
+static int rw_valid_cidr(const char *s)
+{
+	int dots = 0, slash = 0, ndig = 0;
+	const char *p;
+	if (!s || !*s || strlen(s) > 18) return 0;
+	for (p = s; *p; p++) {
+		if (*p >= '0' && *p <= '9') { ndig++; continue; }
+		if (*p == '.') { dots++; continue; }
+		if (*p == '/') { slash++; continue; }
+		return 0;                 /* any other char -> reject */
+	}
+	return (dots == 3 && slash <= 1 && ndig >= 4);
+}
+
+/* country code: exactly two ascii letters (ipdeny filenames). */
+static int rw_valid_cc(const char *s)
+{
+	return s && strlen(s) == 2 && isalpha((int)s[0]) && isalpha((int)s[1]);
+}
+
+/* cron schedule from nvram flows UNQUOTED into the crontab line via cru, then
+ * to the shell. Charset-gate to the cron field alphabet only ([0-9 */,-]);
+ * cron itself validates field count/ranges. Reject anything else so the sched
+ * cannot inject a second command. */
+static int rw_valid_sched(const char *s)
+{
+	const char *p;
+	if (!s || !*s || strlen(s) > 64) return 0;
+	for (p = s; *p; p++) {
+		if (*p >= '0' && *p <= '9') continue;
+		if (*p == ' ' || *p == '*' || *p == '/' || *p == ',' || *p == '-') continue;
+		return 0;
+	}
+	return 1;
+}
+
+/* feed id from nvram must match a known feed (prevents arbitrary ids). */
+static const char *rw_feed_url(const char *id)
+{
+	int i;
+	for (i = 0; rw_feeds[i].id; i++)
+		if (!strcmp(rw_feeds[i].id, id)) return rw_feeds[i].url;
+	return NULL;
+}
+
+/* emit `ipset add <set> <cidr> -exist` for each valid token in an nvram list
+ * (separators: space, comma, '<', '>'). Invalid tokens are silently skipped. */
+static void rw_emit_cidrs(FILE *f, const char *set, const char *nvkey)
+{
+	char *list = strdup(nvram_safe_get(nvkey)), *tok, *save = NULL;
+	if (!list) return;
+	for (tok = strtok_r(list, " ,<>", &save); tok; tok = strtok_r(NULL, " ,<>", &save))
+		if (rw_valid_cidr(tok))
+			fprintf(f, "ipset add %s %s -exist\n", set, tok);
+	free(list);
+}
+
+void rw_teardown_rules(void)
+{
+	/* unhook + drop the dispatch chain first (it references RW_DROP), then the
+	 * RW_DROP sub-chain, else -X fails on a still-referenced chain. */
+	doSystem("iptables -D INPUT -j REAPER_WARDEN 2>/dev/null");
+	doSystem("iptables -D FORWARD -j REAPER_WARDEN 2>/dev/null");
+	doSystem("iptables -F REAPER_WARDEN 2>/dev/null");
+	doSystem("iptables -X REAPER_WARDEN 2>/dev/null");
+	doSystem("iptables -F RW_DROP 2>/dev/null");
+	doSystem("iptables -X RW_DROP 2>/dev/null");
+}
+
+static void rw_gen_apply(void)
+{
+	FILE *f = fopen(RW_APPLY, "w");
+	if (!f) return;
+	fprintf(f,
+	  "#!/bin/sh\n"
+	  "# generated by start_rwarden - do not edit; idempotent (teardown+rebuild)\n"
+	  "LANIF=\"$(nvram get lan_ifname)\"\n"
+	  "LANIP=\"$(nvram get lan_ipaddr)\"\n"
+	  "LANMASK=\"$(nvram get lan_netmask)\"\n"
+	  "if [ -z \"$LANIP\" ]; then logger -t rwarden 'lan not ready - deferred'; exit 1; fi\n");
+	/* Derive LAN CIDR from the netmask (standard class values); /24 fallback. */
+	fprintf(f,
+	  "case \"$LANMASK\" in\n"
+	  "  255.255.255.0) LANNET=\"${LANIP%%.*}.0/24\";;\n"
+	  "  255.255.0.0)   LANNET=\"$(echo $LANIP|cut -d. -f1-2).0.0/16\";;\n"
+	  "  255.255.255.128) LANNET=\"${LANIP%%.*}.0/25\";;\n"
+	  "  *) LANNET=\"${LANIP%%.*}.0/24\";;\n"
+	  "esac\n");
+	/* ---- teardown ---- (dispatch chain before its RW_DROP dependency) */
+	fprintf(f,
+	  "iptables -D INPUT -j REAPER_WARDEN 2>/dev/null\n"
+	  "iptables -D FORWARD -j REAPER_WARDEN 2>/dev/null\n"
+	  "iptables -F REAPER_WARDEN 2>/dev/null; iptables -X REAPER_WARDEN 2>/dev/null\n"
+	  "iptables -F RW_DROP 2>/dev/null; iptables -X RW_DROP 2>/dev/null\n");
+	/* sets (idempotent create) */
+	fprintf(f,
+	  "for s in rw_allow rw_ban rw_threat rw_geo; do ipset create $s hash:net -exist; done\n");
+	/* restore cached feed sets from jffs (boot without internet still protected) */
+	fprintf(f,
+	  "[ -f " RW_SAVE " ] && ipset restore -exist < " RW_SAVE " 2>/dev/null\n");
+	/* manual allow/ban from nvram (validated) */
+	fprintf(f, "ipset flush rw_allow; ipset flush rw_ban\n");
+	rw_emit_cidrs(f, "rw_allow", "rwarden_allow");
+	rw_emit_cidrs(f, "rw_ban",   "rwarden_ban");
+	/* ---- build ---- RW_DROP: optional LOG then terminal DROP. Built before
+	 * REAPER_WARDEN so the -j RW_DROP jumps resolve. */
+	fprintf(f, "iptables -N RW_DROP\n"
+	           "iptables -F RW_DROP\n");
+	if (nvram_match("rwarden_log", "1"))
+		fprintf(f, "iptables -A RW_DROP -j LOG --log-prefix \"REAPER-WARDEN \" --log-level 4\n");
+	fprintf(f, "iptables -A RW_DROP -j DROP\n");
+	/* dispatch chain: anti-lockout RETURNs first, then set-match -> RW_DROP */
+	fprintf(f,
+	  "iptables -N REAPER_WARDEN\n"
+	  "iptables -A REAPER_WARDEN -m conntrack --ctstate ESTABLISHED,RELATED -j RETURN\n"
+	  "iptables -A REAPER_WARDEN -s $LANNET -j RETURN\n"
+	  "iptables -A REAPER_WARDEN -m set --match-set rw_allow src -j RETURN\n");
+	/* inbound (src) matches - always on when enabled */
+	fprintf(f,
+	  "iptables -A REAPER_WARDEN -m set --match-set rw_ban src -j RW_DROP\n"
+	  "iptables -A REAPER_WARDEN -m set --match-set rw_threat src -j RW_DROP\n"
+	  "iptables -A REAPER_WARDEN -m set --match-set rw_geo src -j RW_DROP\n");
+	/* outbound (dst) matches when rwarden_dir is out/both */
+	if (nvram_match("rwarden_dir", "out") || nvram_match("rwarden_dir", "both"))
+		fprintf(f,
+		  "iptables -A REAPER_WARDEN -m set --match-set rw_ban dst -j RW_DROP\n"
+		  "iptables -A REAPER_WARDEN -m set --match-set rw_threat dst -j RW_DROP\n"
+		  "iptables -A REAPER_WARDEN -m set --match-set rw_geo dst -j RW_DROP\n");
+	/* hook: INPUT protects the router, FORWARD protects LAN clients */
+	fprintf(f,
+	  "iptables -I INPUT -j REAPER_WARDEN\n"
+	  "iptables -I FORWARD -j REAPER_WARDEN\n");
+	fclose(f);
+}
+
+/* The updater: fetches enabled feeds + country CIDRs over HTTPS into ipset,
+ * then persists all sets to /jffs. Generated fresh so it reflects current
+ * nvram selections; run by cron (rwarden_sched) and by the UI "update now". */
+static void rw_gen_update(void)
+{
+	FILE *f = fopen(RW_UPDATE, "w");
+	char *list, *tok, *save = NULL;
+	const char *url;
+	if (!f) return;
+	fprintf(f,
+	  "#!/bin/sh\n"
+	  "# generated by start_rwarden - fetch feeds -> ipset, cache to jffs\n"
+	  "CURL='curl -fsSL --retry 2 --max-time 40'\n"
+	  "TMP=/tmp/rwarden/feed.$$\n"
+	  "for s in rw_threat rw_geo; do ipset create $s hash:net -exist; done\n"
+	  "NEW=/tmp/rwarden/threat.new; : > $NEW\n");
+	/* enabled threat feeds */
+	list = strdup(nvram_safe_get("rwarden_feeds"));
+	if (list) {
+		for (tok = strtok_r(list, " ,<>", &save); tok; tok = strtok_r(NULL, " ,<>", &save)) {
+			url = rw_feed_url(tok);
+			if (!url) continue;
+			fprintf(f,
+			  "if $CURL '%s' -o $TMP 2>/dev/null; then\n"
+			  "  grep -oE '([0-9]{1,3}\\.){3}[0-9]{1,3}(/[0-9]{1,2})?' $TMP >> $NEW\n"
+			  "fi\n", url);
+		}
+		free(list);
+	}
+	/* rebuild rw_threat atomically via a swap set */
+	fprintf(f,
+	  "if [ -s $NEW ]; then\n"
+	  "  ipset create rw_threat_tmp hash:net -exist; ipset flush rw_threat_tmp\n"
+	  "  sort -u $NEW | while read n; do ipset add rw_threat_tmp $n -exist; done\n"
+	  "  ipset swap rw_threat_tmp rw_threat; ipset destroy rw_threat_tmp\n"
+	  "fi\n");
+	/* country CIDRs from ipdeny */
+	fprintf(f, "ipset flush rw_geo\n");
+	save = NULL;
+	list = strdup(nvram_safe_get("rwarden_geo"));
+	if (list) {
+		for (tok = strtok_r(list, " ,<>", &save); tok; tok = strtok_r(NULL, " ,<>", &save)) {
+			if (!rw_valid_cc(tok)) continue;
+			/* lower-case the cc for the ipdeny path */
+			fprintf(f,
+			  "CC=$(echo '%s' | tr A-Z a-z)\n"
+			  "if $CURL \"https://www.ipdeny.com/ipblocks/data/aggregated/${CC}-aggregated.zone\" -o $TMP 2>/dev/null; then\n"
+			  "  grep -oE '([0-9]{1,3}\\.){3}[0-9]{1,3}(/[0-9]{1,2})?' $TMP | while read n; do ipset add rw_geo $n -exist; done\n"
+			  "fi\n", tok);
+		}
+		free(list);
+	}
+	fprintf(f,
+	  "rm -f $TMP $NEW\n"
+	  "mkdir -p " RW_CACHE "\n"
+	  "ipset save rw_allow rw_ban rw_threat rw_geo > " RW_SAVE ".tmp 2>/dev/null && mv " RW_SAVE ".tmp " RW_SAVE "\n"
+	  "nvram set rwarden_lastupd=$(date +%%s); nvram commit\n"
+	  "logger -t rwarden \"feeds updated: threat=$(ipset -t list rw_threat 2>/dev/null | sed -n 's/.*Number of entries: //p') geo=$(ipset -t list rw_geo 2>/dev/null | sed -n 's/.*Number of entries: //p')\"\n");
+	fclose(f);
+}
+
+void stop_rwarden(void)
+{
+	rw_teardown_rules();
+	eval("cru", "d", "rwarden");
+	unlink(RW_APPLY);
+	unlink(RW_UPDATE);
+}
+
+void start_rwarden(void)
+{
+	stop_rwarden();
+	if (!is_routing_enabled())
+		return;
+	if (!nvram_match("rwarden_enable", "1"))
+		return;
+	mkdir(RW_DIR, 0700);
+	rw_gen_apply();
+	rw_gen_update();
+	chmod(RW_APPLY, 0700);
+	chmod(RW_UPDATE, 0700);
+	/* apply.sh exits non-zero when the LAN is not up yet (cold boot): expected,
+	 * not an error - the firewall hook re-runs the same script and arms the
+	 * moment the LAN appears (the Gatekeeper cold-boot deferral pattern). */
+	if (system("sh " RW_APPLY) != 0)
+		logmessage("rwarden", "LAN not ready at boot - protection deferred, re-arms on firewall hook");
+	/* schedule feed refresh (default daily 04:30) unless user set rwarden_sched.
+	 * cru convention (rc/wireguard.c): schedule + command are ONE quoted arg. */
+	{
+		const char *sched = nvram_safe_get("rwarden_sched");
+		char line[128];
+		if (!rw_valid_sched(sched))
+			sched = "30 4 * * *";
+		snprintf(line, sizeof(line), "%s sh %s", sched, RW_UPDATE);
+		eval("cru", "a", "rwarden", line);
+	}
+}
