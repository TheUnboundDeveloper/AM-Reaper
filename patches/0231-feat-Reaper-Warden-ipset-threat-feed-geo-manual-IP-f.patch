+};
+var FEED_IDS = ['firehol1','feodo','spamhaus','dshield'];
+/* ISO 3166-1 alpha-2 subset (common + commonly-blocked). Codes only ever leave
+   here as 2 ascii letters; the backend re-validates each as [A-Za-z]{2}. */
+var COUNTRIES = [
+ ['AF','Afghanistan'],['AL','Albania'],['DZ','Algeria'],['AR','Argentina'],['AU','Australia'],
+ ['AT','Austria'],['AZ','Azerbaijan'],['BD','Bangladesh'],['BY','Belarus'],['BE','Belgium'],
+ ['BR','Brazil'],['BG','Bulgaria'],['KH','Cambodia'],['CA','Canada'],['CL','Chile'],
+ ['CN','China'],['CO','Colombia'],['HR','Croatia'],['CU','Cuba'],['CZ','Czechia'],
+ ['DK','Denmark'],['EG','Egypt'],['EE','Estonia'],['FI','Finland'],['FR','France'],
+ ['GE','Georgia'],['DE','Germany'],['GH','Ghana'],['GR','Greece'],['HK','Hong Kong'],
+ ['HU','Hungary'],['IN','India'],['ID','Indonesia'],['IR','Iran'],['IQ','Iraq'],
+ ['IE','Ireland'],['IL','Israel'],['IT','Italy'],['JP','Japan'],['KZ','Kazakhstan'],
+ ['KE','Kenya'],['KP','Korea, North'],['KR','Korea, South'],['KW','Kuwait'],['LV','Latvia'],
+ ['LB','Lebanon'],['LT','Lithuania'],['LU','Luxembourg'],['MY','Malaysia'],['MX','Mexico'],
+ ['MD','Moldova'],['MA','Morocco'],['NL','Netherlands'],['NZ','New Zealand'],['NG','Nigeria'],
+ ['NO','Norway'],['PK','Pakistan'],['PS','Palestine'],['PA','Panama'],['PE','Peru'],
+ ['PH','Philippines'],['PL','Poland'],['PT','Portugal'],['QA','Qatar'],['RO','Romania'],
+ ['RU','Russia'],['SA','Saudi Arabia'],['RS','Serbia'],['SG','Singapore'],['SK','Slovakia'],
+ ['SI','Slovenia'],['ZA','South Africa'],['ES','Spain'],['LK','Sri Lanka'],['SE','Sweden'],
+ ['CH','Switzerland'],['SY','Syria'],['TW','Taiwan'],['TH','Thailand'],['TR','Turkey'],
+ ['UA','Ukraine'],['AE','United Arab Emirates'],['GB','United Kingdom'],['US','United States'],
+ ['UZ','Uzbekistan'],['VE','Venezuela'],['VN','Vietnam'],['YE','Yemen'],['ZW','Zimbabwe']
+];
+
+function rwEsc(s){ return String(s==null?'':s).replace(/[&<>"']/g, function(c){ return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]; }); }
+
+/* split an nvram list on any of space, comma, '<', '>' */
+function rwSplit(s){ return String(s||'').split(/[\s,<>]+/).filter(function(x){ return x.length; }); }
+
+function rwBuildGeo(){
+  var sel = document.getElementById('geosel');
+  var picked = {}; rwSplit(NV.geo).forEach(function(c){ picked[c.toUpperCase()] = 1; });
+  var h = '';
+  for (var i=0;i<COUNTRIES.length;i++){
+    var cc = COUNTRIES[i][0];
+    h += '<option value="'+cc+'"'+(picked[cc]?' selected':'')+'>'+rwEsc(cc)+' &middot; '+rwEsc(COUNTRIES[i][1])+'</option>';
+  }
+  sel.innerHTML = h;
+}
+
+function rwPaint(){
+  var on = NV.enable === '1';
+  document.getElementById('tgmaster').className = 'tg' + (on ? ' on' : '');
+  var pill = document.getElementById('pill');
+  pill.className = 'statuspill' + (on ? '' : ' off');
+  pill.textContent = on ? '<#RWDN_03#>' : '<#RWDN_04#>';
+  document.getElementById('offbanner').style.display = on ? 'none' : 'block';
+
+  var feeds = {}; rwSplit(NV.feeds).forEach(function(f){ feeds[f] = 1; });
+  var nf = 0;
+  FEED_IDS.forEach(function(id){ var c = !!feeds[id]; document.getElementById('f_'+id).checked = c; if(c) nf++; });
+  document.getElementById('dir').value = (NV.dir === 'out' || NV.dir === 'both') ? NV.dir : 'in';
+  document.getElementById('tglog').className = 'tg' + (NV.log === '1' ? ' on' : '');
+  document.getElementById('ban').value   = rwSplit(NV.ban).join('\n');
+  document.getElementById('allow').value = rwSplit(NV.allow).join('\n');
+  rwBuildGeo();
+
+  document.getElementById('s_feeds').textContent = String(nf);
+  document.getElementById('s_geo').textContent   = String(rwSplit(NV.geo).length);
+  var lu = parseInt(NV.lastupd, 10);
+  document.getElementById('s_lastupd').textContent = (lu>0) ? rwAgo(lu) : '<#RWDN_29#>';
+}
+
+function rwAgo(ep){
+  var d = Math.max(0, Math.floor(Date.now()/1000) - ep);
+  if(d < 90) return '<#RGK_45#>';
+  if(d < 3600) return Math.floor(d/60) + ' <#RGK_46#>';
+  if(d < 86400) return Math.floor(d/3600) + ' <#RGK_47#>';
+  return Math.floor(d/86400) + ' <#RGK_48#>';
+}
+
+function rwToggleMaster(){
+  var el = document.getElementById('tgmaster');
+  var on = el.className.indexOf('on') >= 0;
+  el.className = 'tg' + (on ? '' : ' on');
+  var pill = document.getElementById('pill');
+  pill.className = 'statuspill' + (on ? ' off' : '');
+  pill.textContent = on ? '<#RWDN_04#>' : '<#RWDN_03#>';
+  document.getElementById('offbanner').style.display = on ? 'block' : 'none';
+}
+function rwTg(el){ var on = el.className.indexOf('on') >= 0; el.className = 'tg' + (on ? '' : ' on'); }
+
+/* keep only IPv4/CIDR-safe chars, one token per line -> space-joined nvram list */
+function rwCleanCidrs(raw){
+  var out = [];
+  String(raw||'').split(/[\s,]+/).forEach(function(t){
+    t = t.replace(/[^0-9.\/]/g, '');
+    if(t.length) out.push(t);
+  });
+  return out.join(' ');
+}
+/* 2-letter codes only */
+function rwCleanCC(list){
+  var out = [];
+  list.forEach(function(c){
+    c = String(c||'').replace(/[^A-Za-z]/g, '').toUpperCase();
+    if(c.length === 2) out.push(c);
+  });
+  return out.join(' ');
+}
+
+function rwSave(updateNow){
+  var f = document.form;
+  var on = document.getElementById('tgmaster').className.indexOf('on') >= 0;
+
+  var feeds = [];
+  FEED_IDS.forEach(function(id){ if(document.getElementById('f_'+id).checked) feeds.push(id); });
+
+  var geo = [];
+  var opts = document.getElementById('geosel').options;
+  for(var i=0;i<opts.length;i++){ if(opts[i].selected) geo.push(opts[i].value); }
+
+  f.rwarden_enable.value = on ? '1' : '0';
+  f.rwarden_feeds.value  = feeds.join(' ');
+  f.rwarden_geo.value    = rwCleanCC(geo);
+  f.rwarden_dir.value    = document.getElementById('dir').value;
+  f.rwarden_ban.value    = rwCleanCidrs(document.getElementById('ban').value);
+  f.rwarden_allow.value  = rwCleanCidrs(document.getElementById('allow').value);
+  f.rwarden_log.value    = (document.getElementById('tglog').className.indexOf('on') >= 0) ? '1' : '0';
+
+  /* Save & Apply restarts the service (regenerates rules + updater). "Update
+     now" also regenerates first (so the fetch reflects current selections) then
+     runs the on-demand feed refresh. */
+  if(updateNow){
+    f.action_script.value = 'restart_rwarden;start_rwarden_update';
+    f.action_wait.value = '45';
+  } else {
+    f.action_script.value = 'restart_rwarden';
+    f.action_wait.value = '10';
+  }
+  document.getElementById('applying').className = 'applying show';
+  f.submit();
+  var wait = (parseInt(f.action_wait.value,10)||10) + 5;
+  setTimeout(function(){ location.reload(); }, wait*1000);
+}
+
+rwPaint();
+</script>
+</body>
+</html>
