index ad8b3e81e5..641eb6a70e 100644
--- a/release/src/router/gkd/gkd.c
+++ b/release/src/router/gkd/gkd.c
@@ -211,6 +211,11 @@ static void scan_wl(void)
 		    sscanf(e->d_name, "wl%d", &unit) != 1)
 			continue;
 		if (strchr(e->d_name, ':')) continue;
+		/* hardening (S6): d_name reaches a shell via popen() below; the sscanf
+		 * only prefix-matches "wl%d", so reject any name bearing a char outside
+		 * a safe set (rmcpd anchors ^wl[0-9]+(\.[0-9]+)?$ for the same scan). */
+		if (e->d_name[strspn(e->d_name, "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789._-")] != '\0')
+			continue;
 		snprintf(cmd, sizeof(cmd), "wl -i %s assoclist 2>/dev/null", e->d_name);
 		p = popen(cmd, "r");
 		if (!p) continue;
