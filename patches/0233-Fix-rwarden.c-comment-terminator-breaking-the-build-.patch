From bf8f429094ff3fa20063135f2cb364efe5af9f3c Mon Sep 17 00:00:00 2001
From: reaper <theunbounddeveloper@outlook.com>
Date: Sat, 25 Jul 2026 19:11:31 -0400
Subject: [PATCH 233/245] Fix rwarden.c comment terminator breaking the build +
 bump v1.8.0

The rw_valid_sched() doc comment contained the literal cron alphabet
'[0-9 */,-]', whose embedded */ prematurely closed the C block comment
so the trailing words parsed as code (error: unknown type name 'itself').
Batch D (63c989a883) was committed without a clean compile as a result.

Reword the comment to spell the alphabet out (digits, space, asterisk,
slash, comma, dash) - no code change. Verified: rwarden.o compiles and
the full RT-BE96U v1.8.0 image builds (MAKE_EXIT=0, Reaper_Warden.asp
staged). Also bumps EXTENDNO Reaper_v1.7.9 -> Reaper_v1.8.0.

Co-Authored-By: Claude Opus 4.8 (1M context) <noreply@anthropic.com>
---
 release/src-rt/version.conf     | 2 +-
 release/src/router/rc/rwarden.c | 6 +++---
 2 files changed, 4 insertions(+), 4 deletions(-)

diff --git a/release/src-rt/version.conf b/release/src-rt/version.conf
index 9b18ff18d8..fa8c8d2721 100644
--- a/release/src-rt/version.conf
+++ b/release/src-rt/version.conf
@@ -4,6 +4,6 @@ KERNEL_VER_AM=$(subst .,,$(KERNEL_VER))
 FS_VER_AM=$(subst .,,$(FS_VER))
 
 SERIALNO=102.8
-EXTENDNO=Reaper_v1.7.9
+EXTENDNO=Reaper_v1.8.0
 
 RCNO=0
diff --git a/release/src/router/rc/rwarden.c b/release/src/router/rc/rwarden.c
index 5058b3ff6f..da7b6c4cbc 100644
--- a/release/src/router/rc/rwarden.c
+++ b/release/src/router/rc/rwarden.c
@@ -73,9 +73,9 @@ static int rw_valid_cc(const char *s)
 }
 
 /* cron schedule from nvram flows UNQUOTED into the crontab line via cru, then
- * to the shell. Charset-gate to the cron field alphabet only ([0-9 */,-]);
- * cron itself validates field count/ranges. Reject anything else so the sched
- * cannot inject a second command. */
+ * to the shell. Charset-gate to the cron field alphabet only (digits, space,
+ * asterisk, slash, comma, dash); cron itself validates field count/ranges.
+ * Reject anything else so the sched cannot inject a second command. */
 static int rw_valid_sched(const char *s)
 {
 	const char *p;
