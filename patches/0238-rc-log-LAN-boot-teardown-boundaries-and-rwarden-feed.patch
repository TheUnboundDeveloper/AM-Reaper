From cdb648157b9887a82ed65133198f4f3006ba93f9 Mon Sep 17 00:00:00 2001
From: reaper <theunbounddeveloper@outlook.com>
Date: Sun, 26 Jul 2026 16:24:40 -0400
Subject: [PATCH 238/245] rc: log LAN boot/teardown boundaries and rwarden
 feed-fetch failures

start_lan()/stop_lan(): add begin/done logmessage markers so the boot
and reboot LAN phases show up in /tmp/syslog.log (previously only the
console ring), bracketing the fine-grained teardown markers already
added for the phy-power cycle and per-VIF radio-off.

rwarden.c: the generated updater now logs a "feed fetch FAILED" line
on any threat/geo curl failure. This makes the fail-open geo condition
visible (a transient outage can currently empty the country set); the
underlying fail-open fix stays with the audit's C6 item.

Co-Authored-By: Claude Fable 5 <noreply@anthropic.com>
---
 release/src/router/rc/lan.c     | 5 +++++
 release/src/router/rc/rwarden.c | 6 +++++-
 2 files changed, 10 insertions(+), 1 deletion(-)

diff --git a/release/src/router/rc/lan.c b/release/src/router/rc/lan.c
index cf8c3c296e..c0794d7a5b 100644
--- a/release/src/router/rc/lan.c
+++ b/release/src/router/rc/lan.c
@@ -1425,6 +1425,8 @@ void start_lan(void)
 		fc_init();
 #endif /* HND_ROUTER */
 
+	logmessage("lan", "start_lan: begin");
+
 #if defined(RTCONFIG_AMAS) && defined(RTCONFIG_PSR_GUEST) && !defined(RTCONFIG_HND_ROUTER_BE_4916)
 	update_wlx_psr_mbss();
 #endif	// #if defined(RTCONFIG_AMAS) && defined(RTCONFIG_PSR_GUEST) && !defined(RTCONFIG_HND_ROUTER_BE_4916)
@@ -2845,12 +2847,14 @@ _dprintf("nat_rule: stop_nat_rules 1.\n");
 		nvram_set("5gbh_war", "0");
 	}
 #endif
+	logmessage("lan", "start_lan: done");
 	_dprintf("%s %d\n", __FUNCTION__, __LINE__);
 }
 
 void stop_lan(void)
 {
 	_dprintf("%s %d\n", __FUNCTION__, __LINE__);
+	logmessage("lan", "stop_lan: begin");
 
 	char lan_ifname[16];
 	char *lan_ifnames, *p, *ifname;
@@ -3193,6 +3197,7 @@ skip_br:
 	nvram_unset("qtn_ready");
 #endif
 
+	logmessage("lan", "stop_lan: done");
 	_dprintf("%s %d\n", __FUNCTION__, __LINE__);
 }
 
diff --git a/release/src/router/rc/rwarden.c b/release/src/router/rc/rwarden.c
index da7b6c4cbc..26d5c35c34 100644
--- a/release/src/router/rc/rwarden.c
+++ b/release/src/router/rc/rwarden.c
@@ -212,7 +212,9 @@ static void rw_gen_update(void)
 			fprintf(f,
 			  "if $CURL '%s' -o $TMP 2>/dev/null; then\n"
 			  "  grep -oE '([0-9]{1,3}\\.){3}[0-9]{1,3}(/[0-9]{1,2})?' $TMP >> $NEW\n"
-			  "fi\n", url);
+			  "else\n"
+			  "  logger -t rwarden \"threat feed fetch FAILED: %s\"\n"
+			  "fi\n", url, url);
 		}
 		free(list);
 	}
@@ -235,6 +237,8 @@ static void rw_gen_update(void)
 			  "CC=$(echo '%s' | tr A-Z a-z)\n"
 			  "if $CURL \"https://www.ipdeny.com/ipblocks/data/aggregated/${CC}-aggregated.zone\" -o $TMP 2>/dev/null; then\n"
 			  "  grep -oE '([0-9]{1,3}\\.){3}[0-9]{1,3}(/[0-9]{1,2})?' $TMP | while read n; do ipset add rw_geo $n -exist; done\n"
+			  "else\n"
+			  "  logger -t rwarden \"geo feed fetch FAILED for ${CC} - country block set may be incomplete this cycle\"\n"
 			  "fi\n", tok);
 		}
 		free(list);
-- 
