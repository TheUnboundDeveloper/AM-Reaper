diff --git a/release/src/router/rc/rwarden.c b/release/src/router/rc/rwarden.c
index 26d5c35c34..28470eaf8d 100644
--- a/release/src/router/rc/rwarden.c
+++ b/release/src/router/rc/rwarden.c
@@ -163,11 +163,17 @@ static void rw_gen_apply(void)
 	if (nvram_match("rwarden_log", "1"))
 		fprintf(f, "iptables -A RW_DROP -j LOG --log-prefix \"REAPER-WARDEN \" --log-level 4\n");
 	fprintf(f, "iptables -A RW_DROP -j DROP\n");
-	/* dispatch chain: anti-lockout RETURNs first, then set-match -> RW_DROP */
+	/* dispatch chain. Order matters for BOTH anti-lockout and outbound blocking:
+	 * ESTABLISHED/RELATED and the rw_allow whitelist RETURN first; then inbound
+	 * (src) drops; then outbound (dst) drops; and ONLY THEN the LAN-source
+	 * anti-lockout RETURN. The LAN RETURN must sit AFTER the dst drops (audit L2)
+	 * - a LAN client's forwarded traffic is LAN-sourced, so an early LAN RETURN
+	 * exempts it and silently disables all outbound blocking. LAN addresses never
+	 * appear in the feed sets, so the src drops above cannot lock out the admin,
+	 * and ESTABLISHED + rw_allow already cover live/whitelisted traffic. */
 	fprintf(f,
 	  "iptables -N REAPER_WARDEN\n"
 	  "iptables -A REAPER_WARDEN -m conntrack --ctstate ESTABLISHED,RELATED -j RETURN\n"
-	  "iptables -A REAPER_WARDEN -s $LANNET -j RETURN\n"
 	  "iptables -A REAPER_WARDEN -m set --match-set rw_allow src -j RETURN\n");
 	/* inbound (src) matches - always on when enabled */
 	fprintf(f,
@@ -180,6 +186,10 @@ static void rw_gen_apply(void)
 		  "iptables -A REAPER_WARDEN -m set --match-set rw_ban dst -j RW_DROP\n"
 		  "iptables -A REAPER_WARDEN -m set --match-set rw_threat dst -j RW_DROP\n"
 		  "iptables -A REAPER_WARDEN -m set --match-set rw_geo dst -j RW_DROP\n");
+	/* anti-lockout: LAN sources pass freely - AFTER the outbound dst drops (L2) so
+	 * a LAN client reaching a blocked dst is still enforced. */
+	fprintf(f,
+	  "iptables -A REAPER_WARDEN -s $LANNET -j RETURN\n");
 	/* hook: INPUT protects the router, FORWARD protects LAN clients */
 	fprintf(f,
 	  "iptables -I INPUT -j REAPER_WARDEN\n"
@@ -225,8 +235,10 @@ static void rw_gen_update(void)
 	  "  sort -u $NEW | while read n; do ipset add rw_threat_tmp $n -exist; done\n"
 	  "  ipset swap rw_threat_tmp rw_threat; ipset destroy rw_threat_tmp\n"
 	  "fi\n");
-	/* country CIDRs from ipdeny */
-	fprintf(f, "ipset flush rw_geo\n");
+	/* country CIDRs from ipdeny -> temp file, then swap-if-nonempty (mirrors the
+	 * threat feed) so a transient fetch failure keeps the last-good geo set
+	 * instead of flushing it empty (audit C6: was flush-before-fetch = fail-open). */
+	fprintf(f, "GEO=/tmp/rwarden/geo.new; : > $GEO\n");
 	save = NULL;
 	list = strdup(nvram_safe_get("rwarden_geo"));
 	if (list) {
@@ -236,15 +248,22 @@ static void rw_gen_update(void)
 			fprintf(f,
 			  "CC=$(echo '%s' | tr A-Z a-z)\n"
 			  "if $CURL \"https://www.ipdeny.com/ipblocks/data/aggregated/${CC}-aggregated.zone\" -o $TMP 2>/dev/null; then\n"
-			  "  grep -oE '([0-9]{1,3}\\.){3}[0-9]{1,3}(/[0-9]{1,2})?' $TMP | while read n; do ipset add rw_geo $n -exist; done\n"
+			  "  grep -oE '([0-9]{1,3}\\.){3}[0-9]{1,3}(/[0-9]{1,2})?' $TMP >> $GEO\n"
 			  "else\n"
 			  "  logger -t rwarden \"geo feed fetch FAILED for ${CC} - country block set may be incomplete this cycle\"\n"
 			  "fi\n", tok);
 		}
 		free(list);
 	}
+	/* atomically publish geo only when something was actually fetched */
+	fprintf(f,
+	  "if [ -s $GEO ]; then\n"
+	  "  ipset create rw_geo_tmp hash:net -exist; ipset flush rw_geo_tmp\n"
+	  "  sort -u $GEO | while read n; do ipset add rw_geo_tmp $n -exist; done\n"
+	  "  ipset swap rw_geo_tmp rw_geo; ipset destroy rw_geo_tmp\n"
+	  "fi\n");
 	fprintf(f,
-	  "rm -f $TMP $NEW\n"
+	  "rm -f $TMP $NEW $GEO\n"
 	  "mkdir -p " RW_CACHE "\n"
 	  "ipset save rw_allow rw_ban rw_threat rw_geo > " RW_SAVE ".tmp 2>/dev/null && mv " RW_SAVE ".tmp " RW_SAVE "\n"
 	  "nvram set rwarden_lastupd=$(date +%%s); nvram commit\n"
diff --git a/release/src/router/samba-4.15.13/build-reaper.sh b/release/src/router/samba-4.15.13/build-reaper.sh
old mode 100755
new mode 100644
index 15db4bf6a9..1ba307642c
--- a/release/src/router/samba-4.15.13/build-reaper.sh
+++ b/release/src/router/samba-4.15.13/build-reaper.sh
@@ -15,6 +15,11 @@ STG="$B/staging"          # build-time prefix for crypto deps (headers/.pc/.so)
 INSTROOT="$B/instroot"    # DESTDIR: rootfs subset with /usr paths baked in
 SAMBA="$B/samba-4.15.13"
 STAMP="$PKGDIR/.reaper-built"
+# reaper (audit C33): the stamp carries a hash of the reaper-patches/ set, so an
+# incremental rebuild re-runs whenever a patch is added/changed. A bare
+# file-exists stamp could otherwise skip the build and reship a stale binary
+# that still reports the Reaper vendor suffix WITHOUT the current CVE patches.
+STAMP_SIG="$(cat "$PKGDIR"/reaper-patches/*.patch 2>/dev/null | sha256sum | awk '{print $1}')"
 
 TC="$(ls -d /opt/toolchains/crosstools-arm_softfp-gcc-10.3*/usr/bin 2>/dev/null | head -1)"
 SYSROOT="$(ls -d /opt/toolchains/crosstools-arm_softfp-gcc-10.3*/arm-buildroot-linux-gnueabi/sysroot 2>/dev/null | head -1)"
@@ -30,8 +35,8 @@ export PKG_CONFIG_PATH="$STG/lib/pkgconfig"
 export QEMU_LD_PREFIX="$SYSROOT"        # qemu finds /lib/ld-linux.so.3 + libc for ARM codegen tools
 J="$(nproc)"
 
-if [ -f "$STAMP" ] && [ -x "$INSTROOT/usr/sbin/smbd" ]; then
-  echo "[build-reaper] already built (stamp present); skipping"; exit 0
+if [ -f "$STAMP" ] && [ -x "$INSTROOT/usr/sbin/smbd" ] && [ "$(cat "$STAMP" 2>/dev/null)" = "$STAMP_SIG" ]; then
+  echo "[build-reaper] already built (patch set unchanged); skipping"; exit 0
 fi
 command -v qemu-arm-static >/dev/null 2>&1 || { echo "[build-reaper] ERROR: qemu-arm-static missing. Host prereq: apt install qemu-user-static binfmt-support libparse-yapp-perl; update-binfmts --enable qemu-arm"; exit 1; }
 
@@ -107,5 +112,5 @@ make -j"$J"
 echo "[build-reaper] === samba install -> $INSTROOT ==="
 make install DESTDIR="$INSTROOT"
 
-touch "$STAMP"
+printf '%s\n' "$STAMP_SIG" > "$STAMP"
 echo "[build-reaper] DONE: $INSTROOT/usr/sbin/smbd"
