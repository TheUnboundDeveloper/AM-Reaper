From b6216ddc83ff730e1563af87b2a141a8c34110e7 Mon Sep 17 00:00:00 2001
From: reaper <theunbounddeveloper@outlook.com>
Date: Mon, 27 Jul 2026 17:10:29 -0400
Subject: [PATCH] be96u-only: rename header banner REAPER1.png ->
 RT-96U_REAPER_Header.png

Give each model a unique banner filename so a shared-tree copy can never
clobber it with another model's banner (the v1.8.6 REAPER1.png collision).
Update all 4 references (Main_Login/Main_ReaperDash/reaper_shell/state.js).

Co-Authored-By: Claude Opus 4.8 <noreply@anthropic.com>
---
 release/src/router/www/Main_Login.asp               |   2 +-
 release/src/router/www/Main_ReaperDash.asp          |   2 +-
 .../{REAPER1.png => RT-96U_REAPER_Header.png}       | Bin
 release/src/router/www/reaper_shell.asp             |   2 +-
 release/src/router/www/state.js                     |   2 +-
 5 files changed, 4 insertions(+), 4 deletions(-)
 rename release/src/router/www/images/{REAPER1.png => RT-96U_REAPER_Header.png} (100%)
 mode change 100755 => 100644

diff --git a/release/src/router/www/Main_Login.asp b/release/src/router/www/Main_Login.asp
index 92ac53868b..cb19c06e36 100644
--- a/release/src/router/www/Main_Login.asp
+++ b/release/src/router/www/Main_Login.asp
@@ -60,7 +60,7 @@ form[name="form"]{margin:auto}
 /* header: REAPER wordmark over the sign-in title */
 .title_name{display:flex;flex-direction:column;align-items:center;gap:14px}
 .img_gap{padding:0}
-.login_img{width:400px;max-width:100%;height:42px;background:url('images/REAPER1.png') center/contain no-repeat}
+.login_img{width:400px;max-width:100%;height:42px;background:url('images/RT-96U_REAPER_Header.png') center/contain no-repeat}
 .signin_hint{font-family:var(--hdr);font-weight:600;font-size:19px;letter-spacing:.24em;
   text-transform:uppercase;color:var(--bone);padding-left:.24em}
 .prod_madelName{margin:8px 0 0;text-align:center;font-family:var(--hdr);font-weight:600;
diff --git a/release/src/router/www/Main_ReaperDash.asp b/release/src/router/www/Main_ReaperDash.asp
index dd9adfeab6..cb2a354207 100644
--- a/release/src/router/www/Main_ReaperDash.asp
+++ b/release/src/router/www/Main_ReaperDash.asp
@@ -320,7 +320,7 @@ html{scrollbar-width:thin;scrollbar-color:var(--crimson) #000}
   <!-- MAIN -->
   <main>
     <header class="top">
-      <a class="brand" href="#" title="REAPER"><img src="/images/REAPER1.png" alt="REAPER"></a>
+      <a class="brand" href="#" title="REAPER"><img src="/images/RT-96U_REAPER_Header.png" alt="REAPER"></a>
       <div class="pills">
         <div class="pill"><span class="dot" id="p_wan_dot"></span><span class="k"><#menu5_3#></span><span class="v" id="p_wan">&mdash;</span></div>
         <div class="pill"><span class="k"><#DSL_Mode#></span><span class="v" id="i_opmode">&mdash;</span></div>
diff --git a/release/src/router/www/images/REAPER1.png b/release/src/router/www/images/RT-96U_REAPER_Header.png
old mode 100755
new mode 100644
similarity index 100%
rename from release/src/router/www/images/REAPER1.png
rename to release/src/router/www/images/RT-96U_REAPER_Header.png
diff --git a/release/src/router/www/reaper_shell.asp b/release/src/router/www/reaper_shell.asp
index 00310709d5..cd6e560732 100644
--- a/release/src/router/www/reaper_shell.asp
+++ b/release/src/router/www/reaper_shell.asp
@@ -132,7 +132,7 @@ a.item.on::before{content:"";position:absolute;left:0;top:7px;bottom:7px;width:2
 <body>
 <div class="app">
   <header class="top">
-    <a class="brand" href="/Main_ReaperDash.asp" title="REAPER dashboard"><img src="/images/REAPER1.png" alt="REAPER"></a>
+    <a class="brand" href="/Main_ReaperDash.asp" title="REAPER dashboard"><img src="/images/RT-96U_REAPER_Header.png" alt="REAPER"></a>
     <div class="pills">
       <div class="pill"><span class="dot" id="p_wan_dot"></span><span class="k"><#menu5_3#></span><span class="v" id="p_wan">&mdash;</span></div>
       <div class="pill"><span class="k"><#DSL_Mode#></span><span class="v" id="i_opmode">&mdash;</span></div>
diff --git a/release/src/router/www/state.js b/release/src/router/www/state.js
index a0b62601fd..66fbc281bc 100644
--- a/release/src/router/www/state.js
+++ b/release/src/router/www/state.js
@@ -1262,7 +1262,7 @@ function show_banner(L3){// L3 = The third Level of Menu
 		banner_code +='<a href="javascript:reboot();"><div style="margin-top:13px;margin-left:0px;*width:136px;" class="titlebtn" align="center"><span><#BTN_REBOOT#></span></div></a>\n';
 	}
 	else{
-		banner_code +='<div class="banner1" align="center"><img src="images/REAPER1.png" height="54" align="left" style="margin-left:10px;">\n';
+		banner_code +='<div class="banner1" align="center"><img src="images/RT-96U_REAPER_Header.png" height="54" align="left" style="margin-left:10px;">\n';
 		/* REAPER wordmark banner; keep modelName_top in the DOM (hidden) for the dispatchEvent() reference elsewhere, and drop the now-redundant secondary logo. */
 		banner_code +='<div style="display:none;"><span id="modelName_top" onclick="this.focus();" class="modelName_top"><#Web_Title2#></span></div>';
 
