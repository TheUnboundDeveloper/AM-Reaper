From e43eac79ac1ca493ee6d6110800c51ed0c8b45fe Mon Sep 17 00:00:00 2001
From: reaper <theunbounddeveloper@outlook.com>
Date: Tue, 28 Jul 2026 11:23:28 -0400
Subject: [PATCH 248/248] reaper_diag: replace field-observed bridge-id example with
 synthetic MAC

The pass-2b comment documented the colonless-MAC sanitizer using a real
device's bridge id as the example; use a synthetic one instead so no
unit-specific identifier ships in the image.
---
 release/src/router/others/reaper_diag | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/release/src/router/others/reaper_diag b/release/src/router/others/reaper_diag
index d9ff0d48c2..cc798db473 100755
--- a/release/src/router/others/reaper_diag
+++ b/release/src/router/others/reaper_diag
@@ -110,7 +110,7 @@ function privip(ip,  a) {
   }
   line = out line
   # pass 2b (v1.0.1): bare 12-hex runs = colonless MACs (bridge ids like
-  # 8000.107c6185fef0, "serial:..." daemon args) - field-observed leak. Full
+  # 8000.aabbccddeeff, "serial:..." daemon args) - field-observed leak. Full
   # hex runs are matched so a 12-char window inside a 16-char kernel pointer
   # can not false-positive; all-digit 12-char runs are left alone unless the
   # colonized form was already seen (protects long decimal counters).
-- 
2.25.1

