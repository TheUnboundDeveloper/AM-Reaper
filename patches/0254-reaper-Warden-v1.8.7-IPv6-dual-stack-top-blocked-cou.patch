+	 * RW_DROP sub-chain, else -X fails on a still-referenced chain. Both stacks. */
 	doSystem("iptables -D INPUT -j REAPER_WARDEN 2>/dev/null");
 	doSystem("iptables -D FORWARD -j REAPER_WARDEN 2>/dev/null");
