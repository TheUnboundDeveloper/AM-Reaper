-/* country code: exactly two ascii letters (ipdeny filenames). */
+/* A single IPv6 address or CIDR, tokens only [0-9a-fA-F:/]. Must contain at
+ * least one ':' (that is how we tell it apart from a v4 token). Structural
+ * charset gate only - ipset does the real parse. Max textual v6 CIDR is
+ * "ffff:...:ffff/128" = 43 chars. */
+static int rw_valid_cidr6(const char *s)
+{
+	int colon = 0, slash = 0, nhex = 0;
+	const char *p;
+	if (!s || !*s || strlen(s) > 43) return 0;
+	for (p = s; *p; p++) {
+		if ((*p >= '0' && *p <= '9') ||
+		    (*p >= 'a' && *p <= 'f') ||
+		    (*p >= 'A' && *p <= 'F')) { nhex++; continue; }
+		if (*p == ':') { colon++; continue; }
+		if (*p == '/') { slash++; continue; }
+		return 0;                 /* any other char -> reject */
+	}
+	return (colon >= 2 && slash <= 1);
+}
