+/* emit the per-country set-create lines for both stacks (validated CC list). */
+static void rw_emit_country_creates(FILE *f)
+{
+	char *list = strdup(nvram_safe_get("rwarden_geo")), *tok, *save = NULL;
+	if (!list) return;
+	for (tok = strtok_r(list, " ,<>", &save); tok; tok = strtok_r(NULL, " ,<>", &save)) {
+		char cc[3];
+		if (!rw_valid_cc(tok)) continue;
+		cc[0] = tolower((int)tok[0]); cc[1] = tolower((int)tok[1]); cc[2] = 0;
+		fprintf(f, "ipset create rw_g_%s hash:net -exist\n", cc);
+		fprintf(f, "ipset create rw_g6_%s hash:net family inet6 -exist\n", cc);
+	}
+	free(list);
+}
+
+/* emit the per-country drop rules (one per country per stack). $IPT expands to
+ * iptables or ip6tables in the generated script; $SET to rw_g_ or rw_g6_. The
+ * per-rule packet counter is what the stats reader attributes to the country. */
+static void rw_emit_country_rules(FILE *f, const char *dir /* "src" or "dst" */)
+{
+	char *list = strdup(nvram_safe_get("rwarden_geo")), *tok, *save = NULL;
+	if (!list) return;
+	for (tok = strtok_r(list, " ,<>", &save); tok; tok = strtok_r(NULL, " ,<>", &save)) {
+		char cc[3];
+		if (!rw_valid_cc(tok)) continue;
+		cc[0] = tolower((int)tok[0]); cc[1] = tolower((int)tok[1]); cc[2] = 0;
+		fprintf(f, "$IPT -A REAPER_WARDEN -m set --match-set ${SET}%s %s -j RW_DROP\n", cc, dir);
+	}
+	free(list);
 }
 
