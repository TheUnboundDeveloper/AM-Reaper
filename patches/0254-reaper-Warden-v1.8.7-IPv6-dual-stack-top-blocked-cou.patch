+/* stats.sh: read live iptables/ip6tables counters -> JSON snapshot for the UI.
+ * total blocked = packets through RW_DROP (v4+v6); per-country = packets on each
+ * rw_g_<cc>/rw_g6_<cc> match rule, summed across stacks; then top 5 by count. */
+static void rw_gen_stats(void)
+{
+	FILE *f = fopen(RW_STATS, "w");
+	if (!f) return;
+	fprintf(f, "%s",
+	  "#!/bin/sh\n"
+	  "# generated by start_rwarden - emit warden block stats as JSON\n"
+	  "EN=$(nvram get rwarden_enable); [ \"$EN\" = 1 ] || EN=0\n"
+	  "LU=$(nvram get rwarden_lastupd); [ -n \"$LU\" ] || LU=0\n"
+	  "ARMED=0; iptables -nL REAPER_WARDEN >/dev/null 2>&1 && ARMED=1\n"
+	  "V6=0; ip6tables -nL REAPER_WARDEN >/dev/null 2>&1 && V6=1\n"
+	  "TN=$(ipset -t list rw_threat 2>/dev/null | sed -n 's/.*Number of entries: //p'); [ -n \"$TN\" ] || TN=0\n"
+	  "TN6=$(ipset -t list rw_threat6 2>/dev/null | sed -n 's/.*Number of entries: //p'); [ -n \"$TN6\" ] || TN6=0\n"
+	  "GN=$(ipset list -n 2>/dev/null | grep -c '^rw_g_')\n"
+	  "TOTAL=$( { iptables -nvxL RW_DROP 2>/dev/null; ip6tables -nvxL RW_DROP 2>/dev/null; } "
+	  "| awk '/ DROP /{s+=$1} END{print s+0}')\n"
+	  "# per-country pkt sums across both stacks\n"
+	  "TOP=$( { iptables -nvxL REAPER_WARDEN 2>/dev/null; ip6tables -nvxL REAPER_WARDEN 2>/dev/null; } | awk '\n"
+	  "  { for(i=1;i<=NF;i++) if($i ~ /^rw_g6?_[a-z][a-z]$/){ n=$i; sub(/^rw_g6?_/,\"\",n); c[toupper(n)]+=$1 } }\n"
+	  "  END{ for(k in c) print c[k], k }' | sort -rn | head -5 | awk '\n"
+	  "  { if(NR>1) printf \",\"; printf \"{\\\"cc\\\":\\\"%s\\\",\\\"n\\\":%d}\", $2, $1 }')\n"
+	  "printf '{\"enable\":%d,\"armed\":%d,\"v6\":%d,\"lastupd\":%d,\"threat_n\":%d,\"geo_n\":%d,\"blocked\":{\"total\":%d,\"top\":[%s]}}\\n' "
+	  "\"$EN\" \"$ARMED\" \"$V6\" \"$LU\" \"$((TN+TN6))\" \"$GN\" \"$TOTAL\" \"$TOP\"\n");
 	fclose(f);
 }
 
