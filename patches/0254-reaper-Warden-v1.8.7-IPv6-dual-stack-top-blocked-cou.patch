+/* reaper v1.8.7 Warden live stats. Read-only: streams the JSON snapshot produced
+ * by /tmp/rwarden/stats.sh (which reads the live iptables/ip6tables packet
+ * counters -> total blocked + top blocked countries). No state-changing action
+ * lives here (config flows through apply.cgi -> restart_rwarden), so no CSRF
+ * token is required. NOT MCP-gated - ships in both builds (kept OUTSIDE the
+ * RTCONFIG_REAPER_MCP block below, same as do_reaper_gk_cgi). */
+static void
+do_reaper_warden_cgi(char *url, FILE *stream)
+{
+	char *action = get_cgi("action");
+	FILE *p;
+	char buf[256];
+	int got = 0;
+
+	if (!action) action = "status";
+
+	if (f_exists("/tmp/rwarden/stats.sh") &&
+	    (p = popen("sh /tmp/rwarden/stats.sh 2>/dev/null", "r")) != NULL) {
+		while (fgets(buf, sizeof(buf), p) != NULL) {
+			websWrite(stream, "%s", buf);
+			got = 1;
+		}
+		pclose(p);
+	}
+	/* fail-safe: warden off / not yet armed / script missing -> minimal JSON so
+	 * the page renders its empty state instead of erroring. */
+	if (!got)
+		websWrite(stream,
+			"{\"enable\":%d,\"armed\":0,\"v6\":0,\"lastupd\":%d,"
+			"\"threat_n\":0,\"geo_n\":0,\"blocked\":{\"total\":0,\"top\":[]}}",
+			nvram_match("rwarden_enable", "1") ? 1 : 0,
+			nvram_get_int("rwarden_lastupd"));
+}
