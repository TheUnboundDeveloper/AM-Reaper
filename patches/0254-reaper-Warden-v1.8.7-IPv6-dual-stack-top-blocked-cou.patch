+function rwCCName(cc){ for(var i=0;i<COUNTRIES.length;i++){ if(COUNTRIES[i][0]===cc) return COUNTRIES[i][1]; } return cc; }
+function rwStats(){
+  var x = new XMLHttpRequest();
+  x.open('GET','/reaper_warden.cgi?action=status',true);
+  x.timeout = 8000;
+  x.onreadystatechange = function(){
+    if(x.readyState !== 4) return;
+    var j; try{ j = JSON.parse(x.responseText); }catch(e){ return; }
+    var pill = document.getElementById('livepill');
+    /* protocols actually enforced (v6 present only when ip6tables armed) */
+    document.getElementById('s_proto').textContent = j.v6 ? 'IPv4 · IPv6' : 'IPv4';
+    if(j.lastupd > 0) document.getElementById('s_lastupd').textContent = rwAgo(j.lastupd);
+    var b = j.blocked || {};
+    document.getElementById('s_blocked').textContent =
+      (typeof b.total === 'number') ? b.total.toLocaleString() : '—';
+    var top = (b.top || []).slice(0, 5);
+    var tb = document.getElementById('topbody');
+    if(j.armed){ pill.className = 'livepill'; } else { pill.className = 'livepill stale'; }
+    if(!top.length){ return; }                 /* keep the empty-state row */
+    var max = 0; top.forEach(function(t){ if((t.n||0) > max) max = t.n; });
+    var h = '';
+    for(var i=0;i<top.length;i++){
+      var cc = String(top[i].cc||'').toUpperCase();
+      var n  = Number(top[i].n||0);
+      var pct = max > 0 ? Math.max(4, Math.round(n*100/max)) : 0;
+      h += '<tr><td class="rank">'+(i+1)+'</td>'
+         + '<td><span class="cc">'+rwEsc(cc)+'</span>'+rwEsc(rwCCName(cc))
+         + '<div class="bar"><i style="width:'+pct+'%"></i></div></td>'
+         + '<td class="cnt">'+n.toLocaleString()+'</td></tr>';
+    }
+    tb.innerHTML = h;
+  };
+  try{ x.send(); }catch(e){}
+}
+
+/* dismissable caveat banner - remembers the choice across visits */
+function rwDismiss(){
+  try{ localStorage.setItem('rw_warn_hidden','1'); }catch(e){}
+  var b = document.getElementById('warnbanner'); if(b) b.style.display='none';
+}
+try{
+  if(localStorage.getItem('rw_warn_hidden')==='1'){
+    var _b = document.getElementById('warnbanner'); if(_b) _b.style.display='none';
