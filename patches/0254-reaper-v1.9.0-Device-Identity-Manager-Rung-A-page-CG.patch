 	{ "reaper_warden.cgi*", "text/html", no_cache_IE7, do_html_post_and_get, do_reaper_warden_cgi, do_auth },
+	{ "reaper_dev.cgi*", "text/html", no_cache_IE7, do_html_post_and_get, do_reaper_dev_cgi, do_auth },
