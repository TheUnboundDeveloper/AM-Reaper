+/* ===================================================================
+ * reaper v1.9.0: Device Identity Manager (Reaper_Devices.asp).
+ *
+ * Correlates, per MAC, the five identity stores that stock ASUS scatters:
+ * custom_clientlist (name), dhcp_staticlist (reservation), gk_rl (access),
+ * DHCP leases + ARP + wireless assoclists (presence). Reads and WRITES only
+ * those existing stores - no sixth store is introduced - and every write is a
+ * read-modify-write that preserves the foreign fields of each tuple, re-reads
+ * nvram at action time (never trusts stale page state), commits, and re-runs
+ * the affected consumer. Traffic (24h) is enriched CLIENT-side from the
+ * existing /reaper_traffic.cgi?f=m5 feed, so this CGI never parses that JSON.
+ *
+ * NOT MCP-gated - ships in both builds (kept OUTSIDE the RTCONFIG_REAPER_MCP
+ * block below, same as do_reaper_gk_cgi / do_reaper_warden_cgi).
+ * =================================================================== */
+
+#define RDEV_MAX 320
+
+struct rdev {
+	char mac[18];		/* uppercase colon form (the merge key) */
+	char ip[46];
+	char host[64];		/* self-reported (lease/assoc) hostname */
+	char band[8];		/* "2.4" / "5" / "6" or "" (wired/unknown) */
+	int  wired;		/* seen on ethernet (in ARP, not in any assoclist) */
+	int  wifi;		/* seen in a wl assoclist */
+	int  online;
+	long last;
+	int  resv;		/* has a dhcp_staticlist entry */
+	char resv_ip[46];
+	int  gk_state;		/* -1 = not in gk_rl */
+	long gk_expiry;
+};
+
+/* dotted-quad -> host-order u32; 0 on parse failure (0.0.0.0 is never a host) */
+static unsigned int rdev_ip2u(const char *s)
+{
+	struct in_addr a;
+	if (!s || !s[0]) return 0;
+	if (inet_aton(s, &a) == 0) return 0;
+	return ntohl(a.s_addr);
+}
+
+/* find MAC (case-insensitive) in the table, or add it (uppercased). Returns
+ * index, or -1 when full. */
+static int rdev_find(struct rdev *v, int *n, const char *macraw)
+{
+	char mac[18];
+	int i;
+	if (!macraw || strlen(macraw) != 17) return -1;
+	for (i = 0; i < 17; i++) mac[i] = toupper((unsigned char)macraw[i]);
+	mac[17] = 0;
+	if (!gk_valid_mac(mac)) return -1;
+	if (!strcasecmp(mac, "FF:FF:FF:FF:FF:FF") || !strcasecmp(mac, "00:00:00:00:00:00"))
+		return -1;
+	for (i = 0; i < *n; i++)
+		if (!strcasecmp(v[i].mac, mac)) return i;
+	if (*n >= RDEV_MAX) return -1;
+	memset(&v[*n], 0, sizeof(v[0]));
+	snprintf(v[*n].mac, sizeof(v[0].mac), "%s", mac);
+	v[*n].gk_state = -1;
+	return (*n)++;
+}
+
+/* enumerate wireless associations across every radio + its VIFs (MULTILAN:
+ * the user networks - and therefore the stations - live on the VIFs). Mirrors
+ * gkd/reaper_diag: nvram wl{u}_ifname + wl{u}_vifs, wl -i <if> assoclist, with
+ * the S6 charset guard before the name reaches popen. Sets band/wifi/online. */
+static void rdev_scan_wl(struct rdev *v, int *n)
+{
+	int u;
+	for (u = 0; u <= 3; u++) {
+		char key[16], cmd[96], line[128];
+		char ifl[512];
+		const char *band;
+		char *tok, *sp = NULL;
+		int nb;
+
+		snprintf(key, sizeof(key), "wl%d_ifname", u);
+		snprintf(ifl, sizeof(ifl), "%s", nvram_safe_get(key));
+		if (!ifl[0]) continue;
+		snprintf(key, sizeof(key), "wl%d_nband", u);
+		nb = nvram_get_int(key);
+		band = (nb == 2) ? "2.4" : (nb == 1) ? "5" : (nb == 4) ? "6" : "";
+
+		/* base ifname + each VIF, space/comma/&lt;&gt; separated */
+		{
+			char both[576];
+			snprintf(key, sizeof(key), "wl%d_vifs", u);
+			snprintf(both, sizeof(both), "%s %s", ifl, nvram_safe_get(key));
+			for (tok = strtok_r(both, " ,<>", &sp); tok; tok = strtok_r(NULL, " ,<>", &sp)) {
+				FILE *p;
+				/* reject anything that is not a plain iface name before popen */
+				if (tok[strspn(tok, "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789._-")] != '\0')
+					continue;
+				snprintf(cmd, sizeof(cmd), "wl -i %s assoclist 2>/dev/null", tok);
+				if ((p = popen(cmd, "r")) == NULL) continue;
+				while (fgets(line, sizeof(line), p)) {
+					char mac[64];
+					int idx;
+					if (sscanf(line, "assoclist %63s", mac) != 1) continue;
+					idx = rdev_find(v, n, mac);
+					if (idx < 0) continue;
+					v[idx].wifi = 1;
+					v[idx].online = 1;
+					if (!v[idx].band[0])
+						snprintf(v[idx].band, sizeof(v[0].band), "%s", band);
+				}
+				pclose(p);
+			}
+		}
+	}
+}
+
+/* the 2nd hex nibble x2 bit => locally-administered (randomized) MAC */
+static int rdev_is_rand(const char *mac)
+{
+	char c = toupper((unsigned char)mac[1]);
+	return (c == '2' || c == '6' || c == 'A' || c == 'E') ? 1 : 0;
+}
+
+static void do_reaper_dev_cgi(char *url, FILE *stream)
+{
+	char *action = get_cgi("action");
+
+	if (!action) action = "status";
+
+	/* CSRF: state-changing actions must carry http_id (same guard as GK) */
+	if (strcmp(action, "status") != 0) {
+		char *hid = get_cgi("http_id");
+		char *want = nvram_safe_get("http_id");
+		if (!hid || !want[0] || strcmp(hid, want) != 0) {
+			websWrite(stream, "{\"ok\":0,\"error\":\"invalid request token\"}");
+			return;
+		}
+	}
+
+	/* ---------------- STATUS: the merged snapshot ---------------- */
+	if (!strcmp(action, "status")) {
+		static struct rdev dev[RDEV_MAX];
+		static struct gk_seen seen[GK_SEEN_MAX];
+		int n = 0, ns, i, first;
+		char line[512];
+		FILE *f;
+		char *buf, *tok, *sp = NULL;
+		unsigned int lan_ip, lan_mask, lan_net, dstart, dend;
+		int pool_size, gk_on;
+
+		lan_ip   = rdev_ip2u(nvram_safe_get("lan_ipaddr"));
+		lan_mask = rdev_ip2u(nvram_safe_get("lan_netmask"));
+		lan_net  = lan_ip & lan_mask;
+		dstart   = rdev_ip2u(nvram_safe_get("dhcp_start"));
+		dend     = rdev_ip2u(nvram_safe_get("dhcp_end"));
+		pool_size = (dend >= dstart && dstart) ? (int)(dend - dstart + 1) : 0;
+		gk_on    = nvram_match("gk_enable", "1") ? 1 : 0;
+
+		/* 1. DHCP leases: known devices (ip + self-reported host) */
+		f = fopen("/var/lib/misc/dnsmasq.leases", "r");
+		if (f) {
+			while (fgets(line, sizeof(line), f)) {
+				char mac[64], ip[64], host[64];
+				int idx;
+				/* fmt: <expiry> <mac> <ip> <host> <clientid> */
+				if (sscanf(line, "%*s %63s %63s %63s", mac, ip, host) < 2) continue;
+				idx = rdev_find(dev, &n, mac);
+				if (idx < 0) continue;
+				if (!dev[idx].ip[0]) snprintf(dev[idx].ip, sizeof(dev[0].ip), "%s", ip);
+				if (host[0] && strcmp(host, "*") && !dev[idx].host[0])
+					snprintf(dev[idx].host, sizeof(dev[0].host), "%s", host);
+			}
+			fclose(f);
+		}
+
+		/* 2. ARP: currently-talking devices on the LAN bridge (=> online) */
+		f = fopen("/proc/net/arp", "r");
+		if (f) {
+			char ip[64], hw[64], dif[32];
+			unsigned flags;
+			if (fgets(line, sizeof(line), f)) { /* header */ }
+			while (fgets(line, sizeof(line), f)) {
+				int idx;
+				if (sscanf(line, "%63s 0x%*x 0x%x %63s %*s %31s", ip, &flags, hw, dif) != 4)
+					continue;
+				if (!(flags & 2) || strncmp(dif, "br", 2)) continue;
+				idx = rdev_find(dev, &n, hw);
+				if (idx < 0) continue;
+				dev[idx].online = 1;
+				if (!dev[idx].ip[0]) snprintf(dev[idx].ip, sizeof(dev[0].ip), "%s", ip);
+			}
+			fclose(f);
+		}
+
+		/* 3. wireless assoclists (band + wifi + online) */
+		rdev_scan_wl(dev, &n);
+		/* online-but-not-wifi => wired */
+		for (i = 0; i < n; i++)
+			if (dev[i].online && !dev[i].wifi) dev[i].wired = 1;
+
+		/* 4. dhcp_staticlist reservations: <MAC>IP>DNS>HOST */
+		buf = strdup(nvram_safe_get("dhcp_staticlist"));
+		if (buf) {
+			for (tok = strtok_r(buf, "<", &sp); tok; tok = strtok_r(NULL, "<", &sp)) {
+				char rmac[64], rip[64];
+				int idx;
+				rip[0] = 0;
+				if (sscanf(tok, "%63[^>]>%63[^>]", rmac, rip) < 1) continue;
+				idx = rdev_find(dev, &n, rmac);
+				if (idx < 0) continue;
+				dev[idx].resv = 1;
+				snprintf(dev[idx].resv_ip, sizeof(dev[0].resv_ip), "%s", rip);
+			}
+			free(buf);
+		}
+
+		/* 5. gk_rl access states (also surfaces offline gk-listed devices) */
+		buf = strdup(nvram_safe_get("gk_rl"));
+		sp = NULL;
+		if (buf) {
+			for (tok = strtok_r(buf, "<", &sp); tok; tok = strtok_r(NULL, "<", &sp)) {
+				char gmac[64];
+				int st = -1, idx; long exp = 0;
+				if (sscanf(tok, "%63[^>]>%d>%ld", gmac, &st, &exp) < 2) continue;
+				if (st < 0 || st > 3) continue;
+				idx = rdev_find(dev, &n, gmac);
+				if (idx < 0) continue;
+				dev[idx].gk_state = st;
+				dev[idx].gk_expiry = exp;
+			}
+			free(buf);
+		}
+
+		/* 6. seen.tsv enrichment (first/last/band/online) when gkd has it fresh */
+		ns = gk_load_seen(seen, GK_SEEN_MAX);
+		for (i = 0; i < ns; i++) {
+			int idx = rdev_find(dev, &n, seen[i].mac);
+			if (idx < 0) continue;
+			if (seen[i].online) dev[idx].online = 1;
+			if (seen[i].last > dev[idx].last) dev[idx].last = seen[i].last;
+			if (!dev[idx].band[0] && seen[i].band[0])
+				snprintf(dev[idx].band, sizeof(dev[0].band), "%s", seen[i].band);
+			if (!dev[idx].host[0] && seen[i].host[0])
+				snprintf(dev[idx].host, sizeof(dev[0].host), "%s", seen[i].host);
+			if (!dev[idx].ip[0] && seen[i].ip[0])
+				snprintf(dev[idx].ip, sizeof(dev[0].ip), "%s", seen[i].ip);
+		}
+
+		/* ---- pool / store facts + next free out-of-pool host ---- */
+		{
+			char *sl = nvram_safe_get("dhcp_staticlist");
+			int entries = 0, dyn = 0, resv_in = 0;
+			unsigned int subnet_bcast = lan_net | ~lan_mask;
+			unsigned int cand, chosen = 0;
+			const char *p;
+
+			for (p = sl; *p; p++) if (*p == '<') entries++;
+			for (i = 0; i < n; i++) {
+				unsigned int rip = rdev_ip2u(dev[i].resv_ip);
+				if (dev[i].resv && rip && dstart && rip >= dstart && rip <= dend) resv_in++;
+				else if (dev[i].online && dev[i].ip[0] && !dev[i].resv) dyn++;
+			}
+			/* first free host above dhcp_end, still inside the subnet, not taken */
+			for (cand = dend + 1; cand < subnet_bcast; cand++) {
+				int taken = 0;
+				for (i = 0; i < n; i++) {
+					if (rdev_ip2u(dev[i].ip) == cand || rdev_ip2u(dev[i].resv_ip) == cand) {
+						taken = 1; break;
+					}
+				}
+				if (!taken) { chosen = cand; break; }
+			}
+
+			websWrite(stream, "{\"now\":%ld,\"gk_enable\":%d,", (long)time(NULL), gk_on);
+			websWrite(stream, "\"pool\":{\"subnet\":\"%u.%u.%u\",\"start\":\"%s\",\"end\":\"%s\",\"size\":%d},",
+				(lan_net >> 24) & 0xff, (lan_net >> 16) & 0xff, (lan_net >> 8) & 0xff,
+				nvram_safe_get("dhcp_start"), nvram_safe_get("dhcp_end"), pool_size);
+			websWrite(stream, "\"store\":{\"used\":%d,\"cap\":65535,\"entries\":%d},",
+				(int)strlen(sl), entries);
+			websWrite(stream, "\"next_free_out\":%u,", chosen ? (chosen & 0xff) : 0);
+			(void)dyn; (void)resv_in;	/* pool math is finished in the page */
+		}
+
+		/* ---- devices array ---- */
+		websWrite(stream, "\"devices\":[");
+		first = 1;
+		for (i = 0; i < n; i++) {
+			struct rdev *d = &dev[i];
+			char uname[40];
+			int have_user;
+			unsigned int rip = rdev_ip2u(d->resv_ip);
+			int rin = (d->resv && rip && dstart && rip >= dstart && rip <= dend) ? 1 : 0;
+			int orphan = (d->resv && rip && lan_mask && (rip & lan_mask) != lan_net) ? 1 : 0;
+			int nolease = (d->wifi && !d->ip[0]) ? 1 : 0;
+			int dup = 0, j;
+			const char *src;
+
+			/* duplicate reservation: another device pinned to the same ip */
+			if (d->resv && rip)
+				for (j = 0; j < n; j++)
+					if (j != i && dev[j].resv && rdev_ip2u(dev[j].resv_ip) == rip) { dup = 1; break; }
+
+			gk_client_name(d->mac, uname, sizeof(uname));
+			have_user = uname[0] ? 1 : 0;
+			src = have_user ? "user" : (d->host[0] ? "lease" : "");
+
+			if (!first) websWrite(stream, ",");
+			first = 0;
+			websWrite(stream, "{\"mac\":\"%s\",\"name\":", d->mac);
+			gk_json_esc(stream, have_user ? uname : "");
+			websWrite(stream, ",\"host\":");
+			gk_json_esc(stream, d->host);
+			websWrite(stream, ",\"src\":\"%s\",\"ip\":", src);
+			gk_json_esc(stream, d->ip);
+			websWrite(stream, ",\"band\":\"%s\",\"wired\":%d,\"online\":%d,\"last\":%ld",
+				d->band, d->wired, d->online, d->last);
+			websWrite(stream, ",\"gk\":%d,\"gk_expiry\":%ld,\"resv\":%d,\"resv_in_pool\":%d,",
+				d->gk_state, d->gk_expiry, d->resv ? 1 : 0, rin);
+			websWrite(stream, "\"resv_ip\":");
+			gk_json_esc(stream, d->resv_ip);
+			websWrite(stream, ",\"rand\":%d,\"orphan\":%d,\"dup\":%d,\"nolease\":%d}",
+				rdev_is_rand(d->mac), orphan, dup, nolease);
+		}
+		websWrite(stream, "]}");
+		return;
+	}
+
+	/* ---------------- SET_NAME: custom_clientlist RMW ---------------- */
+	if (!strcmp(action, "set_name")) {
+		char *mac = get_cgi("mac");
+		char *nm  = get_cgi("name");
+		char umac[18], clean[40], *cl, *out, *tok, *sp = NULL;
+		size_t cap;
+		int i, keep = 0;
+
+		if (!gk_valid_mac(mac)) {
+			websWrite(stream, "{\"ok\":0,\"error\":\"bad mac\"}");
+			return;
+		}
+		for (i = 0; i < 17; i++) umac[i] = toupper((unsigned char)mac[i]);
+		umac[17] = 0;
+		/* names are stored raw; reject the tuple delimiters and control chars,
+		 * bound to 32 bytes (matches the stock popup's charset + length rule) */
+		clean[0] = 0;
+		if (nm) {
+			int o = 0;
+			for (i = 0; nm[i] && o < (int)sizeof(clean) - 1; i++) {
+				unsigned char c = (unsigned char)nm[i];
+				if (c == '<' || c == '>' || c < 0x20) continue;
+				clean[o++] = c;
+			}
+			clean[o] = 0;
+			while (o > 0 && clean[o - 1] == ' ') clean[--o] = 0;	/* rtrim */
+		}
+		keep = clean[0] ? 1 : 0;	/* empty name = clear the entry */
+
+		cl = nvram_safe_get("custom_clientlist");
+		cap = strlen(cl) + 64;
+		out = calloc(1, cap);
+		{ char *b = strdup(cl); if (!out || !b) { free(out); free(b);
+			websWrite(stream, "{\"ok\":0,\"error\":\"oom\"}"); return; }
+			for (tok = strtok_r(b, "<", &sp); tok; tok = strtok_r(NULL, "<", &sp)) {
+				/* keep every OTHER device's full tuple byte-identical */
+				char *g = strchr(tok, '>');
+				char tmac[18] = "";
+				if (g) { size_t l = g - tok; if (l < sizeof(tmac)) { memcpy(tmac, tok, l); tmac[l] = 0; } }
+				if (g && !strcasecmp(tmac, umac)) continue;	/* drop old record for this mac */
+				strlcat(out, "<", cap); strlcat(out, tok, cap);
+			}
+			free(b);
+		}
+		if (keep) {
+			/* new record: <name>MAC>0>0>>0  (group 0, type 0, empty callback, keeparp 0) */
+			char add[80];
+			snprintf(add, sizeof(add), "<%s>%s>0>0>>0", clean, umac);
+			if (strlen(out) + strlen(add) + 1 < cap) strlcat(out, add, cap);
+			else { free(out); websWrite(stream, "{\"ok\":0,\"error\":\"name store full\"}"); return; }
+		}
+		nvram_set("custom_clientlist", out);
+		nvram_commit();
+		free(out);
+		websWrite(stream, "{\"ok\":1}");
+		return;
+	}
+
+	/* --------- SET_RESERVE / UNPIN: dhcp_staticlist RMW --------- */
+	if (!strcmp(action, "set_reserve") || !strcmp(action, "unpin")) {
+		char *mac = get_cgi("mac");
+		char *ip  = get_cgi("ip");
+		int pin = !strcmp(action, "set_reserve");
+		char umac[18], *sl, *out, *tok, *sp = NULL, keephost[64] = "";
+		size_t cap;
+		int i;
+		unsigned int lan_net, lan_mask, u;
+
+		if (!gk_valid_mac(mac)) {
+			websWrite(stream, "{\"ok\":0,\"error\":\"bad mac\"}");
+			return;
+		}
+		for (i = 0; i < 17; i++) umac[i] = toupper((unsigned char)mac[i]);
+		umac[17] = 0;
+		lan_mask = rdev_ip2u(nvram_safe_get("lan_netmask"));
+		lan_net  = rdev_ip2u(nvram_safe_get("lan_ipaddr")) & lan_mask;
+
+		if (pin) {
+			u = rdev_ip2u(ip);
+			/* must be a real host inside the LAN subnet (stock page's own rule) */
+			if (!u || !lan_mask || (u & lan_mask) != lan_net) {
+				websWrite(stream, "{\"ok\":0,\"error\":\"ip not in LAN subnet\"}");
+				return;
+			}
+			/* refuse a duplicate: same ip pinned to a different mac */
+			sl = strdup(nvram_safe_get("dhcp_staticlist"));
+			if (sl) {
+				for (tok = strtok_r(sl, "<", &sp); tok; tok = strtok_r(NULL, "<", &sp)) {
+					char em[64], eip[64];
+					eip[0] = 0;
+					if (sscanf(tok, "%63[^>]>%63[^>]", em, eip) < 2) continue;
+					if (rdev_ip2u(eip) == u && strcasecmp(em, umac)) {
+						free(sl);
+						websWrite(stream, "{\"ok\":0,\"error\":\"address already reserved by another device\"}");
+						return;
+					}
+				}
+				free(sl);
+			}
+		}
+
+		sl = nvram_safe_get("dhcp_staticlist");
+		cap = strlen(sl) + 96;
+		out = calloc(1, cap);
+		{ char *b = strdup(sl); if (!out || !b) { free(out); free(b);
+			websWrite(stream, "{\"ok\":0,\"error\":\"oom\"}"); return; }
+			sp = NULL;
+			for (tok = strtok_r(b, "<", &sp); tok; tok = strtok_r(NULL, "<", &sp)) {
+				char em[18] = ""; char *g = strchr(tok, '>');
+				if (g) { size_t l = g - tok; if (l < sizeof(em)) { memcpy(em, tok, l); em[l] = 0; } }
+				if (g && !strcasecmp(em, umac)) {
+					/* preserve this device's existing DNS+hostname fields */
+					char *f2 = g ? strchr(g + 1, '>') : NULL;	/* after IP */
+					if (f2) snprintf(keephost, sizeof(keephost), "%s", f2);	/* ">DNS>HOST" */
+					continue;	/* drop old record; re-added below if pinning */
+				}
+				strlcat(out, "<", cap); strlcat(out, tok, cap);
+			}
+			free(b);
+		}
+		if (pin) {
+			char add[160];
+			/* <MAC>IP + preserved ">DNS>HOST" (or empty). Bound to nvram cap. */
+			snprintf(add, sizeof(add), "<%s>%s%s", umac, ip, keephost[0] ? keephost : "");
+			if (strlen(out) + strlen(add) + 1 < 65535 && strlen(out) + strlen(add) + 1 < cap)
+				strlcat(out, add, cap);
+			else { free(out); websWrite(stream, "{\"ok\":0,\"error\":\"reservation store full\"}"); return; }
+		}
+		nvram_set("dhcp_staticlist", out);
+		nvram_set("dhcp_static_x", "1");	/* ensure the manual list is honored */
+		nvram_commit();
+		free(out);
+		notify_rc("restart_dnsmasq");
+		websWrite(stream, "{\"ok\":1}");
+		return;
+	}
+
+	/* ---------------- SET_STATE: delegate to the GK backend ---------------- */
+	if (!strcmp(action, "set_state")) {
+		char *mac = get_cgi("mac");
+		char *st  = get_cgi("state");
+		char umac[18];
+		int state, i;
+		long expiry = 0;
+		if (!gk_valid_mac(mac) || !st) {
+			websWrite(stream, "{\"ok\":0,\"error\":\"bad mac/state\"}");
+			return;
+		}
+		state = atoi(st);
+		if (state < 0 || state > 3) {
+			websWrite(stream, "{\"ok\":0,\"error\":\"bad state\"}");
+			return;
+		}
+		for (i = 0; i < 17; i++) umac[i] = toupper((unsigned char)mac[i]);
+		umac[17] = 0;
+		if (state == 3) {
+			int h = nvram_get_int("gk_guest_hours");
+			if (h < 1 || h > 168) h = 24;
+			expiry = (long)time(NULL) + (long)h * 3600;
+		}
+		gk_rl_update(umac, state, expiry);	/* same format authority as GK */
+		nvram_commit();
+		notify_rc("restart_gk");
+		websWrite(stream, "{\"ok\":1}");
+		return;
+	}
+
+	/* ---------------- WIDEN_POOL: edit dhcp_start/end ---------------- */
+	if (!strcmp(action, "widen_pool")) {
+		char *s = get_cgi("start");
+		char *e = get_cgi("end");
+		unsigned int us, ue, lan_net, lan_mask, bcast;
+		if (!s || !e) { websWrite(stream, "{\"ok\":0,\"error\":\"missing range\"}"); return; }
+		us = rdev_ip2u(s); ue = rdev_ip2u(e);
+		lan_mask = rdev_ip2u(nvram_safe_get("lan_netmask"));
+		lan_net  = rdev_ip2u(nvram_safe_get("lan_ipaddr")) & lan_mask;
+		bcast    = lan_net | ~lan_mask;
+		/* both ends inside the subnet, ordered, and not the net/bcast addresses */
+		if (!us || !ue || us > ue || (us & lan_mask) != lan_net || (ue & lan_mask) != lan_net ||
+		    us <= lan_net || ue >= bcast) {
+			websWrite(stream, "{\"ok\":0,\"error\":\"range not valid for this subnet\"}");
+			return;
+		}
+		nvram_set("dhcp_start", s);
+		nvram_set("dhcp_end", e);
+		nvram_commit();
+		notify_rc("restart_dnsmasq");
+		websWrite(stream, "{\"ok\":1}");
+		return;
+	}
+
+	websWrite(stream, "{\"ok\":0,\"error\":\"unknown action\"}");
+}
