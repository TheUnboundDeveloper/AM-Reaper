diff --git a/release/src/router/www/Reaper_Devices.asp b/release/src/router/www/Reaper_Devices.asp
new file mode 100644
index 0000000000..93e173d6ca
--- /dev/null
+++ b/release/src/router/www/Reaper_Devices.asp
@@ -0,0 +1,521 @@
+<!-- SPDX-License-Identifier: GPL-2.0-only
+     Copyright (C) 2026 the Reaper project maintainer
+     Part of the Reaper hardened Asuswrt-Merlin build. See LICENSE / LICENSE.reaper.
+     reaper v1.9.0: Device Identity Manager. Correlates name/reservation/access/
+     presence per MAC (data from reaper_dev.cgi; 24h traffic from reaper_traffic.cgi).
+     Writes only the stock stores (custom_clientlist / dhcp_staticlist / gk_rl). -->
+<!DOCTYPE html>
+<html lang="en">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width, initial-scale=1">
+<meta name="reaper-native" content="1">
+<title>REAPER &mdash; <#RDEV_00#></title>
+<style>
+@font-face{font-family:'Rajdhani';font-weight:600;font-display:swap;src:url('/fonts/rajdhani-600.woff2') format('woff2')}
+@font-face{font-family:'Rajdhani';font-weight:700;font-display:swap;src:url('/fonts/rajdhani-700.woff2') format('woff2')}
+@font-face{font-family:'Inter';font-weight:400;font-display:swap;src:url('/fonts/inter-400.woff2') format('woff2')}
+@font-face{font-family:'Inter';font-weight:600;font-display:swap;src:url('/fonts/inter-600.woff2') format('woff2')}
+:root{
+  --bg:#08080a; --panel:#0f0f12; --panel-2:#141418;
+  --line:rgba(225,6,0,.16); --line-soft:rgba(255,255,255,.06);
+  --crimson:#E10600; --crimson-deep:#B3000C;
+  --bone:#ECE7DB; --bone-dim:#B7B1A4; --steel:#71767b;
+  --jade:#4FB286; --amber:#d9a441; --danger:#FF3B30;
+  --hdr:'Rajdhani','Oswald',system-ui,sans-serif;
+  --body:'Inter',system-ui,-apple-system,'Segoe UI',sans-serif;
+}
+*{box-sizing:border-box;margin:0}
+html,body{background:var(--bg)}
+body{font-family:var(--body);color:var(--bone-dim);font-size:13.5px;line-height:1.55;padding:20px 22px 48px}
+h1,h2,h3{font-family:var(--hdr);letter-spacing:.04em;color:var(--bone);margin:0}
+.pagehead{display:flex;align-items:center;gap:16px;flex-wrap:wrap;margin-bottom:4px;max-width:1120px}
+.pagehead h1{font-size:24px;font-weight:700}
+.statuspill{font-family:var(--hdr);font-weight:600;font-size:11px;letter-spacing:.1em;text-transform:uppercase;border-radius:20px;padding:4px 12px;border:1px solid var(--line);color:var(--jade)}
+.statuspill.warn{color:var(--amber);border-color:rgba(217,164,65,.35)}
+.statuspill.danger{color:var(--danger);border-color:rgba(255,59,48,.4)}
+.lede{max-width:74ch;margin:6px 0 14px}
+.lede b{color:var(--bone);font-weight:600}
+.gauges{display:grid;grid-template-columns:repeat(auto-fit,minmax(340px,1fr));gap:12px;margin:0 0 14px;max-width:1120px}
+.gauge{background:var(--panel);border:1px solid var(--line-soft);border-radius:12px;padding:12px 16px}
+.gauge h3{font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:.1em;color:var(--steel);margin-bottom:8px}
+.gauge h3 b{color:var(--bone);font-variant-numeric:tabular-nums}
+.bar{height:12px;border-radius:6px;background:var(--panel-2);border:1px solid var(--line-soft);overflow:hidden;display:flex}
+.bar i{display:block;height:100%}
+.bar .dyn{background:#4a4f57}
+.bar .resv{background:var(--amber)}
+.bar .used{background:#4a4f57}
+.gauge.warn .bar{border-color:rgba(217,164,65,.5)}
+.gauge.danger .bar{border-color:rgba(255,59,48,.55)}
+.gauge .legend{display:flex;gap:14px;margin-top:7px;font-size:11px;color:var(--steel);flex-wrap:wrap}
+.gauge .legend i{display:inline-block;width:8px;height:8px;border-radius:2px;margin-right:5px;vertical-align:baseline}
+.gauge .legend .warntx{color:var(--amber)}
+.gauge .legend .dangertx{color:var(--danger)}
+.stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:12px;margin:0 0 16px;max-width:1120px}
+.stat{background:var(--panel);border:1px solid var(--line-soft);border-radius:12px;padding:12px 16px;cursor:pointer}
+.stat .n{font-family:var(--hdr);font-weight:700;font-size:26px;color:var(--bone);font-variant-numeric:tabular-nums}
+.stat .l{font-size:11px;text-transform:uppercase;letter-spacing:.1em;color:var(--steel)}
+.stat.attn{border-color:var(--line)}
+.stat.attn .n{color:var(--crimson)}
+.card{background:var(--panel);border:1px solid var(--line-soft);border-radius:12px;padding:16px 18px;margin-bottom:16px;max-width:1120px}
+.card>h2{font-size:14px;text-transform:uppercase;letter-spacing:.1em;margin-bottom:10px;padding-bottom:8px;border-bottom:1px solid var(--line-soft)}
+.card.hot{border-color:rgba(217,164,65,.4)}
+.card.hot>h2{color:var(--amber);border-bottom-color:rgba(217,164,65,.25)}
+.issue{display:flex;align-items:center;gap:14px;padding:10px 4px;border-bottom:1px solid var(--line-soft);flex-wrap:wrap}
+.issue:last-child{border-bottom:none}
+.issue .itx{flex:1 1 320px;min-width:0}
+.issue .itx b{color:var(--bone)}
+.issue .itx .mono{font-family:ui-monospace,Consolas,monospace;font-size:12px;color:var(--bone-dim)}
+.issue .sev{font-size:10px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;border-radius:4px;padding:2px 7px;flex:0 0 auto}
+.issue .sev.warn{color:var(--amber);border:1px solid rgba(217,164,65,.4)}
+.issue .sev.crit{color:var(--danger);border:1px solid rgba(255,59,48,.45)}
+.btn{font-family:var(--hdr);font-weight:600;letter-spacing:.06em;text-transform:uppercase;font-size:12px;color:var(--bone);background:linear-gradient(180deg,rgba(225,6,0,.28),rgba(225,6,0,.10));border:1px solid var(--crimson-deep);border-radius:8px;padding:7px 14px;cursor:pointer}
+.btn:hover{background:linear-gradient(180deg,rgba(225,6,0,.42),rgba(225,6,0,.16))}
+.btng{font-family:var(--hdr);font-weight:600;letter-spacing:.06em;text-transform:uppercase;font-size:12px;color:var(--bone-dim);background:transparent;border:1px solid rgba(255,255,255,.16);border-radius:8px;padding:7px 14px;cursor:pointer}
+.btng:hover{color:var(--bone);border-color:rgba(255,255,255,.3)}
+.btng[disabled]{opacity:.4;cursor:not-allowed}
+.btnsm{font-size:10.5px;padding:4px 10px}
+.tblbar{display:flex;gap:8px;align-items:center;margin-bottom:10px;flex-wrap:wrap}
+.fchip{font-size:11.5px;border:1px solid rgba(255,255,255,.14);border-radius:16px;padding:3px 12px;color:var(--bone-dim);cursor:pointer;user-select:none}
+.fchip.on{border-color:var(--crimson-deep);color:var(--bone);background:rgba(225,6,0,.10)}
+.search{margin-left:auto;background:var(--panel-2);border:1px solid var(--line-soft);border-radius:8px;color:var(--bone-dim);font-family:var(--body);font-size:12.5px;padding:6px 12px;width:200px}
+.tblwrap{overflow-x:auto}
+table{width:100%;border-collapse:collapse;font-size:12.8px}
+th{font-family:var(--hdr);font-weight:600;font-size:11px;text-transform:uppercase;letter-spacing:.1em;color:var(--steel);text-align:left;padding:8px 10px;border-bottom:1px solid var(--line)}
+td{padding:9px 10px;border-bottom:1px solid var(--line-soft);white-space:nowrap;vertical-align:middle}
+tr:last-child td{border-bottom:none}
+.dot{display:inline-block;width:8px;height:8px;border-radius:50%;background:var(--steel);margin-right:9px;flex:0 0 8px}
+.dot.on{background:var(--jade);box-shadow:0 0 6px rgba(79,178,134,.6)}
+.dcell{display:flex;align-items:center;min-width:200px}
+.dname{color:var(--bone);font-weight:600;cursor:pointer;border-bottom:1px dashed transparent}
+.dname:hover{border-bottom-color:var(--steel)}
+.dname.unnamed{color:var(--steel);font-style:italic;font-weight:400}
+.dname input{background:var(--panel-2);border:1px solid var(--crimson-deep);border-radius:6px;color:var(--bone);font-family:var(--body);font-size:12.8px;padding:2px 8px;width:150px}
+.src{font-size:9.5px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;border-radius:4px;padding:1px 5px;border:1px solid var(--line-soft);color:var(--steel);margin-left:8px}
+.chip{font-size:10px;font-weight:600;text-transform:uppercase;letter-spacing:.08em;border-radius:4px;padding:1px 6px;border:1px solid var(--line-soft);color:var(--steel);margin-left:6px}
+.chip.rand{color:var(--amber);border-color:rgba(217,164,65,.35)}
+.chip.nolease{color:var(--danger);border-color:rgba(255,59,48,.45)}
+.chip.pin{color:var(--jade);border-color:rgba(79,178,134,.4)}
+.chip.pinout{color:var(--jade);border-color:rgba(79,178,134,.4)}
+.chip.pindead{color:var(--danger);border-color:rgba(255,59,48,.45)}
+td.mac{font-family:ui-monospace,Consolas,monospace;font-size:11.5px;color:var(--steel)}
+td.ip{font-family:ui-monospace,Consolas,monospace;font-size:11.5px;color:var(--bone-dim)}
+.conn{font-size:10.5px;font-weight:600;letter-spacing:.06em;border-radius:5px;padding:2px 8px;border:1px solid var(--line-soft);color:var(--bone-dim)}
+select.acc{background:var(--panel-2);border:1px solid var(--line-soft);border-radius:7px;color:var(--bone-dim);font-family:var(--body);font-size:11.5px;padding:4px 8px}
+.tlink{color:var(--bone-dim);text-decoration:none;font-size:11.5px;border:1px solid var(--line-soft);border-radius:6px;padding:3px 9px}
+.tlink:hover{color:var(--bone);border-color:rgba(255,255,255,.3)}
+.lastseen{color:var(--steel);font-size:11.5px}
+.foot{font-size:12px;color:var(--steel);max-width:1120px}
+.foot b{color:var(--bone-dim)}
+.rtip{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
+.ovl{display:none;position:fixed;inset:0;background:rgba(0,0,0,.65);z-index:50;align-items:center;justify-content:center}
+.ovl.show{display:flex}
+.modal{background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:20px 22px;max-width:480px;width:92%}
+.modal h3{font-size:16px;margin-bottom:8px}
+.modal p{margin-bottom:10px}
+.modal .mono{font-family:ui-monospace,Consolas,monospace;color:var(--bone)}
+.modal .opts{display:flex;flex-direction:column;gap:10px;margin:14px 0}
+.mopt{border:1px solid var(--line-soft);border-radius:10px;padding:12px 14px;cursor:pointer}
+.mopt:hover{border-color:var(--crimson-deep)}
+.mopt b{color:var(--bone);display:block;margin-bottom:2px}
+.mopt .sub{font-size:12px;color:var(--steel)}
+.mopt.rec{border-color:rgba(79,178,134,.4)}
+.mopt.rec b span{color:var(--jade);font-size:10px;letter-spacing:.08em;text-transform:uppercase;margin-left:8px}
+.mopt.blocked{opacity:.5;cursor:not-allowed}
+.mclose{display:flex;justify-content:flex-end;gap:10px;margin-top:6px}
+</style>
+</head>
+<body>
+<div class="pagehead">
+  <h1><#RDEV_00#></h1>
+  <span class="statuspill" id="pill">&nbsp;</span>
+</div>
+<p class="lede"><#RDEV_01#></p>
+
+<div class="gauges">
+  <div class="gauge" id="g_pool">
+    <h3><#RDEV_04#> <b id="g_pool_t"></b></h3>
+    <div class="bar" id="g_pool_bar"></div>
+    <div class="legend" id="g_pool_leg"></div>
+  </div>
+  <div class="gauge" id="g_store">
+    <h3><#RDEV_10#> <b id="g_store_t"></b></h3>
+    <div class="bar" id="g_store_bar"></div>
+    <div class="legend" id="g_store_leg"></div>
+  </div>
+</div>
+
+<div class="stats" id="stats"></div>
+
+<div class="card hot" id="attn_card" style="display:none">
+  <h2><#RDEV_44#></h2>
+  <div id="issues"></div>
+</div>
+
+<div class="card">
+  <h2><#RDEV_19#></h2>
+  <div class="tblbar" id="chips"></div>
+  <div class="tblwrap">
+    <table>
+      <thead><tr>
+        <th><#RDEV_23#></th><th>MAC</th><th><#RDEV_24#></th><th><#RDEV_25#></th>
+        <th><#RDEV_26#></th><th><#RDEV_27#></th><th><#RDEV_28#></th><th></th>
+      </tr></thead>
+      <tbody id="rows"></tbody>
+    </table>
+  </div>
+</div>
+
+<p class="foot"><b><#RDEV_60#></b> <#RDEV_61#></p>
+
+<div class="ovl" id="pin_ovl"><div class="modal" id="pin_modal"></div></div>
+
+<script>
+var REAPER_HTTPID = '<% nvram_get("http_id"); %>';  /* CSRF token */
+var D = null, TRAF = {}, filter = "all", q = "";
+
+function esc(s){ var d=document.createElement('div'); d.textContent=String(s==null?'':s); return d.innerHTML; }
+/* dict strings for JS use: each value is resolved server-side from the dict
+   (backticks per the sq-token rule); plain ASCII so esc() over them is a no-op */
+var L = {
+  RDEV_02:`<#RDEV_02#>`, RDEV_03:`<#RDEV_03#>`, RDEV_05:`<#RDEV_05#>`, RDEV_06:`<#RDEV_06#>`,
+  RDEV_07:`<#RDEV_07#>`, RDEV_08:`<#RDEV_08#>`, RDEV_09:`<#RDEV_09#>`, RDEV_11:`<#RDEV_11#>`,
+  RDEV_12:`<#RDEV_12#>`, RDEV_13:`<#RDEV_13#>`, RDEV_14:`<#RDEV_14#>`, RDEV_15:`<#RDEV_15#>`,
+  RDEV_16:`<#RDEV_16#>`, RDEV_17:`<#RDEV_17#>`, RDEV_18:`<#RDEV_18#>`, RDEV_20:`<#RDEV_20#>`,
+  RDEV_21:`<#RDEV_21#>`, RDEV_22:`<#RDEV_22#>`, RDEV_29:`<#RDEV_29#>`, RDEV_30:`<#RDEV_30#>`,
+  RDEV_31:`<#RDEV_31#>`, RDEV_32:`<#RDEV_32#>`, RDEV_33:`<#RDEV_33#>`, RDEV_34:`<#RDEV_34#>`,
+  RDEV_35:`<#RDEV_35#>`, RDEV_36:`<#RDEV_36#>`, RDEV_37:`<#RDEV_37#>`, RDEV_38:`<#RDEV_38#>`,
+  RDEV_39:`<#RDEV_39#>`, RDEV_40:`<#RDEV_40#>`, RDEV_41:`<#RDEV_41#>`, RDEV_42:`<#RDEV_42#>`,
+  RDEV_43:`<#RDEV_43#>`, RDEV_45:`<#RDEV_45#>`, RDEV_46:`<#RDEV_46#>`, RDEV_47:`<#RDEV_47#>`,
+  RDEV_48:`<#RDEV_48#>`, RDEV_49:`<#RDEV_49#>`, RDEV_50:`<#RDEV_50#>`, RDEV_51:`<#RDEV_51#>`,
+  RDEV_65:`<#RDEV_65#>`, RDEV_66:`<#RDEV_66#>`, RDEV_67:`<#RDEV_67#>`, RDEV_68:`<#RDEV_68#>`,
+  RDEV_69:`<#RDEV_69#>`, RDEV_70:`<#RDEV_70#>`, RDEV_71:`<#RDEV_71#>`, RDEV_72:`<#RDEV_72#>`,
+  RDEV_73:`<#RDEV_73#>`, RDEV_74:`<#RDEV_74#>`, RDEV_75:`<#RDEV_75#>`, RDEV_76:`<#RDEV_76#>`,
+  RDEV_77:`<#RDEV_77#>`, RDEV_78:`<#RDEV_78#>`, RDEV_79:`<#RDEV_79#>`, RDEV_80:`<#RDEV_80#>`,
+  RDEV_81:`<#RDEV_81#>`, RDEV_82:`<#RDEV_82#>`, RDEV_83:`<#RDEV_83#>`, RDEV_84:`<#RDEV_84#>`,
+  RDEV_85:`<#RDEV_85#>`, RDEV_86:`<#RDEV_86#>`, RDEV_62:`<#RDEV_62#>`, RDEV_63:`<#RDEV_63#>`,
+  RDEV_64:`<#RDEV_64#>`
+};
+function T(id){ return L[id] || ''; }
+function ago(sec){
+  if(sec < 90) return `<#RDEV_29#>`;
+  if(sec < 3600) return Math.round(sec/60) + ' ' + `<#RDEV_62#>`;
+  if(sec < 172800) return Math.round(sec/3600) + ' ' + `<#RDEV_63#>`;
+  return Math.round(sec/86400) + ' ' + `<#RDEV_64#>`;
+}
+function fmtBytes(b){
+  if(b >= 1073741824) return (b/1073741824).toFixed(1) + ' GB';
+  if(b >= 1048576) return Math.round(b/1048576) + ' MB';
+  if(b >= 1024) return Math.round(b/1024) + ' KB';
+  return b > 0 ? b + ' B' : '&mdash;';
+}
+function poolMath(){
+  var p = D.pool;
+  var resvIn = D.devices.filter(function(d){ return d.resv && d.resv_in_pool && !d.orphan; }).length;
+  var dyn = D.devices.filter(function(d){ return d.online && d.ip && !d.resv && !d.nolease; }).length;
+  var free = p.size - resvIn - dyn; if(free < 0) free = 0;
+  return {size:p.size, resvIn:resvIn, dyn:dyn, free:free};
+}
+
+function xGet(url, cb){
+  var x = new XMLHttpRequest();
+  x.open('GET', url + '&_=' + Date.now(), true);
+  x.timeout = 12000;
+  x.onreadystatechange = function(){
+    if(x.readyState !== 4) return;
+    var j = null;
+    if(x.status === 200){ try{ j = JSON.parse(x.responseText); }catch(e){} }
+    cb(j);
+  };
+  x.send();
+}
+function xAct(url, cb){
+  xGet(url + '&http_id=' + encodeURIComponent(REAPER_HTTPID), function(j){ if(cb) cb(j); });
+}
+
+function loadAll(){
+  xGet('/reaper_dev.cgi?action=status', function(j){
+    if(!j){ document.getElementById('rows').innerHTML = '<tr><td colspan="8" style="color:var(--danger)">'+esc(T('RDEV_65'))+'</td></tr>'; return; }
+    D = j;
+    render();
+    /* enrich 24h traffic from the existing rtrafd feed - no C JSON parsing */
+    xGet('/reaper_traffic.cgi?f=m5', function(m){
+      TRAF = {};
+      if(m && m.clients){
+        Object.keys(m.clients).forEach(function(k){
+          if(k.indexOf(':') < 0) return;  /* IP-fallback rows are not MACs */
+          var arr = m.clients[k].d || [], t = 0;
+          for(var i=0;i<arr.length;i++){ t += (arr[i][0]||0) + (arr[i][1]||0); }
+          TRAF[k.toUpperCase()] = t;
+        });
+      }
+      renderRows();
+    });
+  });
+}
+
+function render(){
+  var el, pm = poolMath();
+  var pg = document.getElementById('g_pool');
+  var warn = pm.free <= Math.max(3, Math.round(pm.size*0.1));
+  var crit = pm.free === 0 && pm.size > 0;
+  pg.className = 'gauge' + (crit ? ' danger' : (warn ? ' warn' : ''));
+  document.getElementById('g_pool_t').textContent =
+    D.pool.start + ' - ' + D.pool.end + '  -  ' + pm.free + ' / ' + pm.size + ' ' + T('RDEV_05');
+  document.getElementById('g_pool_bar').innerHTML = pm.size > 0 ?
+    ('<i class="dyn" style="width:' + (pm.dyn/pm.size*100) + '%"></i>' +
+     '<i class="resv" style="width:' + (pm.resvIn/pm.size*100) + '%"></i>') : '';
+  document.getElementById('g_pool_leg').innerHTML =
+    '<span><i style="background:#4a4f57"></i>' + esc(T('RDEV_06')) + ' ' + pm.dyn + '</span>' +
+    '<span><i style="background:var(--amber)"></i>' + esc(T('RDEV_07')) + ' ' + pm.resvIn + '</span>' +
+    '<span><i style="background:var(--panel-2);border:1px solid var(--line-soft)"></i>' + esc(T('RDEV_05')) + ' ' + pm.free + '</span>' +
+    (crit ? '<span class="dangertx">' + esc(T('RDEV_08')) + '</span>'
+     : (warn ? '<span class="warntx">' + esc(T('RDEV_09')) + '</span>' : ''));
+
+  var st = D.store, pct = st.cap ? st.used/st.cap : 0;
+  var sg = document.getElementById('g_store');
+  sg.className = 'gauge' + (pct > .95 ? ' danger' : (pct > .8 ? ' warn' : ''));
+  document.getElementById('g_store_t').textContent = st.used + ' / ' + st.cap + '  -  ' + st.entries + ' ' + T('RDEV_11');
+  document.getElementById('g_store_bar').innerHTML = '<i class="used" style="width:' + (pct*100) + '%"></i>';
+  document.getElementById('g_store_leg').innerHTML = pct > .95
+    ? '<span class="dangertx">' + esc(T('RDEV_13')) + '</span>'
+    : (pct > .8 ? '<span class="warntx">' + esc(T('RDEV_12')) + '</span>' : '<span>nvram dhcp_staticlist</span>');
+
+  /* attention list derived from device flags + pool state */
+  var issues = buildIssues();
+  var pill = document.getElementById('pill');
+  var nIssues = issues.length;
+  if(nIssues){ pill.className = 'statuspill ' + (issues.some(function(i){return i.sev==='crit';}) ? 'danger' : 'warn'); pill.textContent = nIssues + ' ' + T('RDEV_03'); }
+  else { pill.className = 'statuspill'; pill.textContent = T('RDEV_02'); }
+
+  var s = {
+    all: D.devices.length,
+    online: D.devices.filter(function(d){return d.online;}).length,
+    unnamed: D.devices.filter(function(d){return !d.name;}).length,
+    resv: D.devices.filter(function(d){return d.resv;}).length,
+    rand: D.devices.filter(function(d){return d.rand;}).length,
+    attn: issues.length
+  };
+  document.getElementById('stats').innerHTML =
+    '<div class="stat" data-f="all"><div class="n">' + s.all + '</div><div class="l">' + esc(T('RDEV_14')) + '</div></div>' +
+    '<div class="stat" data-f="online"><div class="n">' + s.online + '</div><div class="l">' + esc(T('RDEV_15')) + '</div></div>' +
+    '<div class="stat" data-f="unnamed"><div class="n">' + s.unnamed + '</div><div class="l">' + esc(T('RDEV_16')) + '</div></div>' +
+    '<div class="stat" data-f="resv"><div class="n">' + s.resv + '</div><div class="l">' + esc(T('RDEV_17')) + '</div></div>' +
+    '<div class="stat" data-f="rand"><div class="n">' + s.rand + '</div><div class="l">' + esc(T('RDEV_18')) + '</div></div>' +
+    '<div class="stat' + (s.attn?' attn':'') + '" data-f="attn"><div class="n">' + s.attn + '</div><div class="l">' + esc(T('RDEV_03')) + '</div></div>';
+  Array.prototype.forEach.call(document.querySelectorAll('#stats .stat'), function(nn){
+    nn.onclick = function(){ filter = nn.getAttribute('data-f'); render(); };
+  });
+
+  var ic = document.getElementById('attn_card');
+  if(issues.length){
+    ic.style.display = '';
+    el = '';
+    issues.forEach(function(iss, idx){
+      el += '<div class="issue"><span class="sev ' + iss.sev + '">' + (iss.sev==='crit'?esc(T('RDEV_45')):esc(T('RDEV_46'))) + '</span>' +
+            '<div class="itx">' + iss.html + '</div>' +
+            iss.actions.map(function(a){ return '<button class="btng btnsm" data-ai="' + idx + '" data-aid="' + a.id + '">' + esc(a.label) + '</button>'; }).join('') +
+            '</div>';
+    });
+    document.getElementById('issues').innerHTML = el;
+    Array.prototype.forEach.call(document.querySelectorAll('#issues button'), function(b){
+      b.onclick = function(){ fixIssue(issues[+b.getAttribute('data-ai')], b.getAttribute('data-aid')); };
+    });
+  } else ic.style.display = 'none';
+
+  var chips = [['all','RDEV_66'],['online','RDEV_15'],['offline','RDEV_20'],['unnamed','RDEV_16'],['resv','RDEV_17'],['rand','RDEV_67'],['blocked','RDEV_21'],['attn','RDEV_03']];
+  el = '';
+  chips.forEach(function(c){ el += '<span class="fchip' + (filter===c[0]?' on':'') + '" data-f="' + c[0] + '">' + esc(T(c[1])) + '</span>'; });
+  el += '<input class="search" id="q" placeholder="' + esc(T('RDEV_22')) + '" value="' + esc(q) + '">';
+  document.getElementById('chips').innerHTML = el;
+  Array.prototype.forEach.call(document.querySelectorAll('#chips .fchip'), function(nn){
+    nn.onclick = function(){ filter = nn.getAttribute('data-f'); render(); };
+  });
+  var qi = document.getElementById('q');
+  qi.oninput = function(){ q = qi.value; renderRows(); };
+
+  renderRows();
+}
+
+function buildIssues(){
+  var out = [], pm = poolMath();
+  var orphans = D.devices.filter(function(d){ return d.orphan; });
+  if(orphans.length){
+    out.push({ sev:'crit',
+      html: '<b>' + orphans.length + '</b> ' + esc(T('RDEV_48')),
+      actions: [{id:'unpin_orphans', label:T('RDEV_49')}], macs: orphans.map(function(d){return d.mac;}) });
+  }
+  /* duplicate reservations grouped by ip */
+  var seenDup = {};
+  D.devices.forEach(function(d){
+    if(d.dup && d.resv_ip && !seenDup[d.resv_ip]){
+      seenDup[d.resv_ip] = 1;
+      out.push({ sev:'crit',
+        html: esc(T('RDEV_50')) + ' <span class="mono">' + esc(d.resv_ip) + '</span>',
+        actions: [{id:'unpin_dup', label:T('RDEV_49')}], macs: D.devices.filter(function(x){return x.resv_ip===d.resv_ip;}).map(function(x){return x.mac;}) });
+    }
+  });
+  var noleases = D.devices.filter(function(d){ return d.nolease; });
+  if(noleases.length && pm.free === 0){
+    out.push({ sev:'crit',
+      html: '<b>' + noleases.length + '</b> ' + esc(T('RDEV_51')),
+      actions: [{id:'widen', label:T('RDEV_47')}], macs: noleases.map(function(d){return d.mac;}) });
+  }
+  return out;
+}
+
+function visible(d){
+  if(filter==='online' && !d.online) return false;
+  if(filter==='offline' && d.online) return false;
+  if(filter==='unnamed' && d.name) return false;
+  if(filter==='resv' && !d.resv) return false;
+  if(filter==='rand' && !d.rand) return false;
+  if(filter==='blocked' && d.gk !== 0) return false;
+  if(filter==='attn' && !(d.orphan || d.dup || d.nolease)) return false;
+  if(q){
+    var hay = ((d.name||'') + ' ' + d.mac + ' ' + (d.ip||'') + ' ' + (d.host||'')).toLowerCase();
+    if(hay.indexOf(q.toLowerCase()) < 0) return false;
+  }
+  return true;
+}
+
+function renderRows(){
+  if(!D){ return; }
+  var now = D.now, el = '';
+  D.devices.forEach(function(d, i){
+    if(!visible(d)) return;
+    var nameHtml = d.name
+      ? '<span class="dname rtip" data-i="' + i + '" title="' + esc(T('RDEV_68')) + '">' + esc(d.name) + '</span><span class="src">' + esc(d.src) + '</span>'
+      : '<span class="dname unnamed rtip" data-i="' + i + '" title="' + esc(T('RDEV_69')) + '">' + (d.host ? esc(d.host) : esc(T('RDEV_42'))) + '</span><span class="src">' + (d.host ? 'lease' : '&mdash;') + '</span>';
+    var chipsHtml = (d.rand ? '<span class="chip rand" title="' + esc(T('RDEV_70')) + '">' + esc(T('RDEV_36')) + '</span>' : '') +
+                    (d.nolease ? '<span class="chip nolease" title="' + esc(T('RDEV_71')) + '">' + esc(T('RDEV_37')) + '</span>' : '');
+    var ipHtml = d.nolease ? '<span style="color:var(--danger)">&mdash;</span>'
+               : (d.ip ? esc(d.ip) : '<span style="color:var(--steel)">&mdash;</span>');
+    if(d.resv){
+      if(d.orphan) ipHtml += '<span class="chip pindead" title="' + esc(T('RDEV_72')) + '">' + esc(T('RDEV_40')) + '</span>';
+      else if(d.dup) ipHtml += '<span class="chip pindead" title="' + esc(T('RDEV_73')) + '">' + esc(T('RDEV_41')) + '</span>';
+      else ipHtml += '<span class="chip ' + (d.resv_in_pool ? 'pin' : 'pinout') + '" title="' + esc(d.resv_in_pool ? T('RDEV_74') : T('RDEV_75')) + '">' + esc(d.resv_in_pool ? T('RDEV_38') : T('RDEV_39')) + '</span>';
+    }
+    var conn = d.wired ? T('RDEV_43') : (d.band ? d.band + ' GHz' : '&mdash;');
+    var gksel = D.gk_enable
+      ? '<select class="acc" data-i="' + i + '">' +
+        [[1,T('RDEV_30')],[2,T('RDEV_31')],[3,T('RDEV_32')],[0,T('RDEV_33')]].map(function(o){
+          return '<option value="' + o[0] + '"' + (d.gk===o[0]?' selected':'') + '>' + esc(o[1]) + '</option>';
+        }).join('') + '</select>'
+      : '<span style="color:var(--steel);font-size:11.5px">&mdash;</span>';
+    var traf = TRAF[d.mac] || 0;
+    el += '<tr>' +
+      '<td><div class="dcell"><span class="dot' + (d.online?' on':'') + '"></span><span>' + nameHtml + chipsHtml + '</span></div></td>' +
+      '<td class="mac">' + esc(d.mac) + '</td>' +
+      '<td class="ip">' + ipHtml + '</td>' +
+      '<td><span class="conn">' + esc(conn) + '</span></td>' +
+      '<td>' + gksel + '</td>' +
+      '<td class="lastseen">' + (d.online ? '<span style="color:var(--jade)">' + esc(T('RDEV_29')) + '</span>' : (d.last ? ago(now - d.last) : '&mdash;')) + '</td>' +
+      '<td><a class="tlink" href="#reaper_shell.asp" data-traf="' + esc(d.mac) + '">' + fmtBytes(traf) + '</a></td>' +
+      '<td>' + (d.resv
+          ? '<button class="btng btnsm" data-unpin="' + i + '">' + esc(T('RDEV_35')) + '</button>'
+          : (d.ip ? '<button class="btng btnsm"' + (D.store.used/D.store.cap > .95 ? ' disabled title="' + esc(T('RDEV_13')) + '"' : '') + ' data-pin="' + i + '">' + esc(T('RDEV_34')) + '</button>' : '')) +
+      '</td></tr>';
+  });
+  document.getElementById('rows').innerHTML = el || '<tr><td colspan="8" style="color:var(--steel)">' + esc(T('RDEV_76')) + '</td></tr>';
+  wireRows();
+  if(window.reaperTips) window.reaperTips(document.getElementById('rows'));
+}
+
+function wireRows(){
+  Array.prototype.forEach.call(document.querySelectorAll('#rows .dname'), function(n){
+    n.onclick = function(){ editName(+n.getAttribute('data-i'), n); };
+  });
+  Array.prototype.forEach.call(document.querySelectorAll('#rows select.acc'), function(n){
+    n.onchange = function(){ setGk(+n.getAttribute('data-i'), n.value); };
+  });
+  Array.prototype.forEach.call(document.querySelectorAll('#rows [data-pin]'), function(n){
+    n.onclick = function(){ pinAsk(+n.getAttribute('data-pin')); };
+  });
+  Array.prototype.forEach.call(document.querySelectorAll('#rows [data-unpin]'), function(n){
+    n.onclick = function(){ unpin(+n.getAttribute('data-unpin')); };
+  });
+  Array.prototype.forEach.call(document.querySelectorAll('#rows [data-traf]'), function(n){
+    n.onclick = function(){ return trafGo(n.getAttribute('data-traf')); };
+  });
+}
+
+function editName(i, node){
+  var d = D.devices[i], inp = document.createElement('input');
+  inp.value = d.name || ''; node.replaceWith(inp); inp.focus();
+  var done = false;
+  function commit(){
+    if(done) return; done = true;
+    var v = inp.value.replace(/[<>]/g, '').slice(0, 32).trim();
+    xAct('/reaper_dev.cgi?action=set_name&mac=' + encodeURIComponent(d.mac) + '&name=' + encodeURIComponent(v), function(){ loadAll(); });
+  }
+  inp.onblur = commit;
+  inp.onkeydown = function(e){ if(e.key==='Enter') commit(); if(e.key==='Escape'){ done=true; render(); } };
+}
+function setGk(i, v){
+  xAct('/reaper_dev.cgi?action=set_state&mac=' + encodeURIComponent(D.devices[i].mac) + '&state=' + encodeURIComponent(v), function(){ loadAll(); });
+}
+function trafGo(mac){ top.location.href = '/reaper_shell.asp#Reaper_Traffic.asp'; return false; }
+function unpin(i){
+  xAct('/reaper_dev.cgi?action=unpin&mac=' + encodeURIComponent(D.devices[i].mac), function(){ loadAll(); });
+}
+
+function pinAsk(i){
+  var d = D.devices[i], pm = poolMath();
+  var tight = pm.free <= Math.max(3, Math.round(pm.size*0.1));
+  var m = document.getElementById('pin_modal');
+  var outIp = D.next_free_out ? (D.pool.subnet + '.' + D.next_free_out) : '';
+  var rec = tight ? '<span>' + esc(T('RDEV_77')) + '</span>' : '';
+  var norec = tight ? '' : '<span>' + esc(T('RDEV_78')) + '</span>';
+  m.innerHTML = '<h3>' + esc(T('RDEV_79')) + ' ' + esc(d.name || d.host || d.mac) + '</h3>' +
+    '<p>' + esc(T('RDEV_80')) + ' <span class="mono">' + esc(d.mac) + '</span></p>' +
+    '<div class="opts">' +
+    '<div class="mopt' + (tight ? '' : ' rec') + (pm.free===0 ? ' blocked' : '') + '" data-in="1">' +
+      '<b>' + esc(T('RDEV_81')) + ' <span class="mono">' + esc(d.ip) + '</span>' + norec + '</b>' +
+      '<div class="sub">' + esc(T('RDEV_82')) + (pm.free===0 ? ' <b style="color:var(--danger)">' + esc(T('RDEV_08')) + '</b>' : '') + '</div></div>' +
+    (outIp ? ('<div class="mopt' + (tight ? ' rec' : '') + '" data-in="0">' +
+      '<b>' + esc(T('RDEV_83')) + ' <span class="mono">' + esc(outIp) + '</span>' + rec + '</b>' +
+      '<div class="sub">' + esc(T('RDEV_84')) + '</div></div>') : '') +
+    '</div>' +
+    '<div class="mclose"><button class="btng" id="pin_cancel">' + esc(T('RDEV_85')) + '</button></div>';
+  Array.prototype.forEach.call(m.querySelectorAll('.mopt'), function(o){
+    if(o.className.indexOf('blocked') >= 0) return;
+    o.onclick = function(){ pinDo(i, o.getAttribute('data-in') === '1'); };
+  });
+  document.getElementById('pin_cancel').onclick = pinClose;
+  document.getElementById('pin_ovl').className = 'ovl show';
+}
+function pinDo(i, inPool){
+  var d = D.devices[i];
+  var ip = inPool ? d.ip : (D.pool.subnet + '.' + D.next_free_out);
+  pinClose();
+  xAct('/reaper_dev.cgi?action=set_reserve&mac=' + encodeURIComponent(d.mac) + '&ip=' + encodeURIComponent(ip), function(j){
+    if(j && j.ok === 0 && j.error) alert(j.error);
+    loadAll();
+  });
+}
+function pinClose(){ document.getElementById('pin_ovl').className = 'ovl'; }
+
+function fixIssue(iss, act){
+  if(act === 'widen'){
+    if(!confirm(T('RDEV_86'))) return;
+    /* widen to the whole usable subnet minus .1 (router): start = .2, end = last-1 */
+    var base = D.pool.subnet;
+    xAct('/reaper_dev.cgi?action=widen_pool&start=' + encodeURIComponent(base + '.2') + '&end=' + encodeURIComponent(base + '.254'), function(){ loadAll(); });
+    return;
+  }
+  /* unpin_orphans / unpin_dup: remove each affected reservation */
+  var macs = iss.macs.slice(), done = 0;
+  if(!macs.length){ return; }
+  macs.forEach(function(mac){
+    xAct('/reaper_dev.cgi?action=unpin&mac=' + encodeURIComponent(mac), function(){
+      if(++done === macs.length) loadAll();
+    });
+  });
+}
+
+if(document.readyState !== 'loading') loadAll();
+else document.addEventListener('DOMContentLoaded', loadAll);
+</script>
+</body>
+</html>
