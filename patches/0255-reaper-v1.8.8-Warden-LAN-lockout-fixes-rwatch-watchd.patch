diff --git a/release/src/router/rc/rwatch.c b/release/src/router/rc/rwatch.c
new file mode 100644
index 0000000000..93fd60457a
--- /dev/null
+++ b/release/src/router/rc/rwatch.c
@@ -0,0 +1,172 @@
+/*
+ * rc/rwatch.c - Reaper watchdog (v1.8.8, born from the 2026-07-29 incident).
+ *
+ * A cron'd health probe - no resident daemon. Every rwatch_iv minutes (default
+ * 5) /tmp/rwatch.sh checks, in order:
+ *   1. first-hop WAN gateway reachability (by IP - no external hosts, so this
+ *      adds zero phone-home surface),
+ *   2. loopback DNS through dnsmasq (the exact path the 2026-07-29 Warden
+ *      lockout killed first: INPUT src 127.0.0.1 was dropped),
+ *   3. the Warden canary: the router's own LAN IP and 127.0.0.1 must never
+ *      match a Warden block set (defense-in-depth behind the updater's
+ *      reserved-range filter; on a hit it re-runs the idempotent apply.sh so
+ *      the structural anti-lockout chain order is guaranteed current),
+ *   4. the GDX skb_idx pool: host local TCP rides the GDX accelerator (HTOA
+ *      license), whose 8192-entry pool drains silently when the Runner loop
+ *      wedges - the stock stack has NO watchdog or log for this, so a drained
+ *      pool is otherwise invisible until "the internet is frozen".
+ *
+ * Results are a state machine in /tmp/rwatch.state: transitions (and every
+ * 3rd consecutive failing tick) go to syslog with tag "rwatch"; the FIRST
+ * failing tick also snapshots bounded diagnostics to /jffs/rwatch/inc-<epoch>
+ * (newest 3 kept) - route table, iptables/ipset state, GDX/FPM/fcache/BPM
+ * counters, tmctl qid-0 stats, dmesg and syslog tails. Rationale: during the
+ * incident SSH/GUI were unreachable but LOCAL scripts kept running fine, so
+ * the box can always self-document a wedge even when nobody can log in.
+ *
+ * nvram: rwatch_enable (default 1), rwatch_iv (minutes, 1-30, default 5).
+ */
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+#include "rc.h"
+#include <shared.h>
+
+#define RWATCH_SH    "/tmp/rwatch.sh"
+#define RWATCH_STATE "/tmp/rwatch.state"
+
+/* The probe script is constant (it reads nvram itself at run time), so emit
+ * it with fputs - no printf-format escaping hazards. */
+static void rwatch_gen(void)
+{
+	FILE *f = fopen(RWATCH_SH, "w");
+	if (!f)
+		return;
+	fputs(
+	  "#!/bin/sh\n"
+	  "# generated by start_rwatch - do not edit\n"
+	  "STATE=" RWATCH_STATE "\n"
+	  "DUMPROOT=/jffs/rwatch\n"
+	  "\n"
+	  "# boot grace: the WAN is legitimately down for the first minutes\n"
+	  "UP=$(cut -d. -f1 /proc/uptime)\n"
+	  "[ \"$UP\" -lt 300 ] && exit 0\n"
+	  "\n"
+	  "GW=\"$(nvram get wan0_gateway)\"\n"
+	  "{ [ -n \"$GW\" ] && [ \"$GW\" != \"0.0.0.0\" ]; } || GW=\"$(nvram get wan_gateway)\"\n"
+	  "LANIP=\"$(nvram get lan_ipaddr)\"\n"
+	  "FAIL=\"\"; CRIT=\"\"\n"
+	  "\n"
+	  "# 1) first-hop reachability (by IP, two tries)\n"
+	  "if [ -n \"$GW\" ] && [ \"$GW\" != \"0.0.0.0\" ]; then\n"
+	  "  ping -c1 -W3 \"$GW\" >/dev/null 2>&1 || ping -c1 -W3 \"$GW\" >/dev/null 2>&1 || FAIL=\"$FAIL wan-gw\"\n"
+	  "fi\n"
+	  "\n"
+	  "# 2) loopback DNS through dnsmasq (hosts-file name: no upstream dependency,\n"
+	  "#    no external query - tests exactly the path the 2026-07-29 lockout cut)\n"
+	  "nslookup localhost 127.0.0.1 >/dev/null 2>&1 || FAIL=\"$FAIL loopback-dns\"\n"
+	  "\n"
+	  "# 3) Warden canary: own LAN IP / loopback must never match a block set\n"
+	  "if iptables -nL REAPER_WARDEN >/dev/null 2>&1 && [ -n \"$LANIP\" ]; then\n"
+	  "  for s in rw_ban rw_threat $(ipset list -n 2>/dev/null | grep '^rw_g_'); do\n"
+	  "    if ipset test \"$s\" \"$LANIP\" 2>/dev/null || ipset test \"$s\" 127.0.0.1 2>/dev/null; then\n"
+	  "      CRIT=\"$CRIT warden-poison:$s\"\n"
+	  "    fi\n"
+	  "  done\n"
+	  "fi\n"
+	  "\n"
+	  "# 4) GDX host-TCP pool: 0 available = the silent accelerator-wedge\n"
+	  "#    signature. Parse tolerantly; skip the check if the format is unknown.\n"
+	  "if [ -r /proc/gdx/skb_idx ]; then\n"
+	  "  AV=$(grep -i avail /proc/gdx/skb_idx 2>/dev/null | head -1 | sed 's/[^0-9]*\\([0-9][0-9]*\\).*/\\1/')\n"
+	  "  case \"$AV\" in\n"
+	  "    ''|*[!0-9]*) : ;;\n"
+	  "    0) FAIL=\"$FAIL gdx-pool-exhausted\" ;;\n"
+	  "  esac\n"
+	  "fi\n"
+	  "\n"
+	  "rw_dump() {\n"
+	  "  D=\"$DUMPROOT/inc-$(date +%s)\"\n"
+	  "  mkdir -p \"$D\" 2>/dev/null || return\n"
+	  "  { date; uptime; echo \"reasons:$*\"; } > \"$D/summary.txt\" 2>&1\n"
+	  "  { ip route; ip -6 route; } > \"$D/route.txt\" 2>&1\n"
+	  "  iptables -nvxL > \"$D/iptables.txt\" 2>&1\n"
+	  "  ip6tables -nvxL > \"$D/ip6tables.txt\" 2>&1\n"
+	  "  ipset list -t > \"$D/ipset-headers.txt\" 2>&1\n"
+	  "  [ -r /proc/gdx/skb_idx ] && cat /proc/gdx/skb_idx > \"$D/gdx-skb_idx.txt\" 2>&1\n"
+	  "  [ -r /proc/gdx/stats ] && cat /proc/gdx/stats > \"$D/gdx-stats.txt\" 2>&1\n"
+	  "  [ -r /proc/driver/fpm/fpm ] && head -80 /proc/driver/fpm/fpm > \"$D/fpm.txt\" 2>&1\n"
+	  "  fcctl status > \"$D/fcache.txt\" 2>&1\n"
+	  "  bpmctl status > \"$D/bpm.txt\" 2>&1\n"
+	  "  WANIF=\"$(nvram get wan0_ifname)\"\n"
+	  "  [ -n \"$WANIF\" ] && tmctl getqstats --devtype 0 --if \"$WANIF\" --qid 0 > \"$D/tmctl-q0.txt\" 2>&1\n"
+	  "  dmesg | tail -120 > \"$D/dmesg.txt\" 2>&1\n"
+	  "  tail -200 /tmp/syslog.log > \"$D/syslog-tail.txt\" 2>/dev/null\n"
+	  "  ls -1dt \"$DUMPROOT\"/inc-* 2>/dev/null | tail -n +4 | while read d; do rm -rf \"$d\"; done\n"
+	  "}\n"
+	  "\n"
+	  "NOW=$(date +%s)\n"
+	  "PREV=\"$(cat $STATE 2>/dev/null)\"\n"
+	  "\n"
+	  "# CRITICAL: with the fixed chain order this can no longer lock anyone out,\n"
+	  "# but it means the ingest filter was breached upstream - alarm loudly and\n"
+	  "# re-assert the chain (apply.sh is idempotent).\n"
+	  "if [ -n \"$CRIT\" ]; then\n"
+	  "  logger -t rwatch \"CRITICAL:$CRIT - LAN/loopback found in a Warden block set (ingest filter breached); re-applied warden chain\"\n"
+	  "  [ -f /tmp/rwarden/apply.sh ] && sh /tmp/rwarden/apply.sh >/dev/null 2>&1\n"
+	  "fi\n"
+	  "\n"
+	  "if [ -n \"$FAIL$CRIT\" ]; then\n"
+	  "  case \"$PREV\" in\n"
+	  "  FAIL*)\n"
+	  "    T0=$(echo \"$PREV\" | cut -d' ' -f2); N=$(echo \"$PREV\" | cut -d' ' -f3)\n"
+	  "    N=$((N+1))\n"
+	  "    [ $((N % 3)) -eq 0 ] && logger -t rwatch \"still failing:$FAIL$CRIT ($(( (NOW-T0)/60 )) min)\"\n"
+	  "    echo \"FAIL $T0 $N\" > $STATE\n"
+	  "    ;;\n"
+	  "  *)\n"
+	  "    logger -t rwatch \"FAILURE detected:$FAIL$CRIT - diagnostics dumped to $DUMPROOT\"\n"
+	  "    rw_dump \"$FAIL$CRIT\"\n"
+	  "    echo \"FAIL $NOW 1\" > $STATE\n"
+	  "    ;;\n"
+	  "  esac\n"
+	  "else\n"
+	  "  case \"$PREV\" in\n"
+	  "  FAIL*)\n"
+	  "    T0=$(echo \"$PREV\" | cut -d' ' -f2)\n"
+	  "    logger -t rwatch \"recovered ($(( (NOW-T0)/60 )) min outage)\"\n"
+	  "    ;;\n"
+	  "  esac\n"
+	  "  echo OK > $STATE\n"
+	  "fi\n", f);
+	fclose(f);
+	chmod(RWATCH_SH, 0700);
+}
+
+void stop_rwatch(void)
+{
+	eval("cru", "d", "rwatch");
+	unlink(RWATCH_SH);
+	unlink(RWATCH_STATE);
+}
+
+void start_rwatch(void)
+{
+	int iv;
+	char line[64];
+
+	stop_rwatch();
+	if (!nvram_match("rwatch_enable", "1"))
+		return;
+	iv = nvram_get_int("rwatch_iv");
+	if (iv < 1 || iv > 30)
+		iv = 5;
+	rwatch_gen();
+	/* cru convention (rc/wireguard.c): schedule + command are ONE quoted arg */
+	snprintf(line, sizeof(line), "*/%d * * * * sh %s", iv, RWATCH_SH);
+	eval("cru", "a", "rwatch", line);
+	logmessage("rwatch", "watchdog armed (probe every %d min; incident dumps in /jffs/rwatch)", iv);
+}
