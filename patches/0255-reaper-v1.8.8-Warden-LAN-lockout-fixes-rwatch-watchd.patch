+ * - a UI-stripped "192.168.1.*" - which then failed silently at `ipset add`,
+ * so the user believed the entry was active while the set stayed empty).
+ * Exactly four octets 0-255, optional /0-32 prefix. Also keeps the shell-
+ * safety property (only [0-9./] can pass). ipset does the final parse. */
 static int rw_valid_cidr(const char *s)
 {
-	int dots = 0, slash = 0, ndig = 0;
+	int oct = 0, val = -1, prefix = -1, seen_slash = 0;
 	const char *p;
 	if (!s || !*s || strlen(s) > 18) return 0;
 	for (p = s; *p; p++) {
-		if (*p >= '0' && *p <= '9') { ndig++; continue; }
-		if (*p == '.') { dots++; continue; }
-		if (*p == '/') { slash++; continue; }
+		if (*p >= '0' && *p <= '9') {
+			if (seen_slash) {
+				prefix = (prefix < 0 ? 0 : prefix) * 10 + (*p - '0');
+				if (prefix > 32) return 0;
+			} else {
+				val = (val < 0 ? 0 : val) * 10 + (*p - '0');
+				if (val > 255) return 0;
+			}
+			continue;
+		}
+		if (*p == '.') {
+			if (seen_slash || val < 0 || oct >= 3) return 0;
+			oct++; val = -1;
+			continue;
+		}
+		if (*p == '/') {
+			if (seen_slash || val < 0 || oct != 3) return 0;
+			seen_slash = 1;
+			continue;
+		}
 		return 0;                 /* any other char -> reject */
 	}
-	return (dots == 3 && slash <= 1 && ndig >= 4);
+	if (seen_slash) return (prefix >= 0);
+	return (oct == 3 && val >= 0);
