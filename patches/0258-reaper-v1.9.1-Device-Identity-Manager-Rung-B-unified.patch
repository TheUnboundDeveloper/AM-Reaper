+/* ===================================================================
+ * reaper v1.9.1: Device Identity Manager Rung B - unified long-term
+ * storage (Reaper_Storage.asp, System Log group).
+ *
+ * Resolve the durable base directory for reaper history datasets. This
+ * MIRRORS the shell rstore_base() generated in rc/rwatch.c (the history
+ * writer runs on that cron tick) - keep the two in lockstep. Never follows
+ * a symlink an attacker could plant on a USB mount (lstat, not stat).
+ * Returns "ram" | "jffs" | "usb" (the effective location, which falls back
+ * to ram when the requested medium is unavailable) and fills buf. =========== */
+static const char *rdev_store_base(char *buf, size_t len)
+{
+	char mode[8];
+	struct stat st;
+	strlcpy(mode, nvram_safe_get("reaper_store"), sizeof(mode));
+	if (!strcmp(mode, "jffs")) {
+		mkdir("/jffs/reaper", 0700);
+		if (lstat("/jffs/reaper", &st) == 0 && S_ISDIR(st.st_mode) &&
+		    access("/jffs/reaper", W_OK) == 0) {
+			strlcpy(buf, "/jffs/reaper", len);
+			return "jffs";
+		}
+	} else if (!strcmp(mode, "usb")) {
+		DIR *d = opendir("/tmp/mnt");
+		struct dirent *e;
+		if (d) {
+			while ((e = readdir(d)) != NULL) {
+				char p[128];
+				if (e->d_name[0] == '.') continue;
+				snprintf(p, sizeof(p), "/tmp/mnt/%s/.reaper", e->d_name);
+				mkdir(p, 0700);
+				if (lstat(p, &st) == 0 && S_ISDIR(st.st_mode) &&
+				    access(p, W_OK) == 0) {
+					strlcpy(buf, p, len);
+					closedir(d);
+					return "usb";
+				}
+			}
+			closedir(d);
+		}
+	}
+	mkdir("/tmp/reaper", 0700);
+	strlcpy(buf, "/tmp/reaper", len);
+	return "ram";
+}
+
+/* is dataset <ds> opted into durability? (reaper_store_ds is a comma list) */
+static int rdev_ds_on(const char *ds)
+{
+	char list[80], *tok, *sp = NULL;
+	strlcpy(list, nvram_safe_get("reaper_store_ds"), sizeof(list));
+	for (tok = strtok_r(list, ", ", &sp); tok; tok = strtok_r(NULL, ", ", &sp))
+		if (!strcmp(tok, ds)) return 1;
+	return 0;
+}
+
+/* append a page-action audit line to the durable audit ring (best-effort).
+ * Only when the device-history dataset is durable (store != ram). O_APPEND
+ * write is atomic for a short line; size-capped by a one-generation rename
+ * (no shell, so a USB volume name can never inject). */
+static void rdev_audit(const char *act, const char *mac, const char *detail)
+{
+	char base[128], path[160];
+	const char *loc;
+	FILE *f;
+	struct stat st;
+
+	if (!rdev_ds_on("dev")) return;
+	loc = rdev_store_base(base, sizeof(base));
+	if (!strcmp(loc, "ram")) return;	/* volatile default: nothing durable to write */
+	snprintf(path, sizeof(path), "%s/audit.log", base);
+	if ((f = fopen(path, "a")) == NULL) return;
+	fprintf(f, "%ld %s %s %s\n", (long)time(NULL), act,
+		(mac && mac[0]) ? mac : "-", (detail && detail[0]) ? detail : "-");
+	fclose(f);
+	if (stat(path, &st) == 0 && st.st_size > 512 * 1024) {
+		char old[176];
+		snprintf(old, sizeof(old), "%s.1", path);
+		rename(path, old);	/* keep one prior generation, start fresh */
+	}
+	/* mark first-collection time for the "collecting since" column */
+	{
+		char since[160];
+		snprintf(since, sizeof(since), "%s/dev.since", base);
+		if (access(since, F_OK) != 0 && (f = fopen(since, "w")) != NULL) {
+			fprintf(f, "%ld\n", (long)time(NULL));
+			fclose(f);
+		}
+	}
+}
+
 static void do_reaper_dev_cgi(char *url, FILE *stream)
 {
 	char *action = get_cgi("action");
 
 	if (!action) action = "status";
 
-	/* CSRF: state-changing actions must carry http_id (same guard as GK) */
-	if (strcmp(action, "status") != 0) {
+	/* CSRF: state-changing actions must carry http_id (same guard as GK).
+	 * status + store_status are read-only snapshots -> no token required. */
+	if (strcmp(action, "status") != 0 && strcmp(action, "store_status") != 0) {
 		char *hid = get_cgi("http_id");
 		char *want = nvram_safe_get("http_id");
 		if (!hid || !want[0] || strcmp(hid, want) != 0) {
@@ -23287,6 +23380,7 @@ static void do_reaper_dev_cgi(char *url, FILE *stream)
 		nvram_set("custom_clientlist", out);
 		nvram_commit();
 		free(out);
+		rdev_audit(keep ? "name" : "name_clear", umac, keep ? clean : "");
 		websWrite(stream, "{\"ok\":1}");
 		return;
 	}
@@ -23366,6 +23460,7 @@ static void do_reaper_dev_cgi(char *url, FILE *stream)
 		nvram_commit();
 		free(out);
 		notify_rc("restart_dnsmasq");
+		rdev_audit(pin ? "pin" : "unpin", umac, pin ? ip : "");
 		websWrite(stream, "{\"ok\":1}");
 		return;
 	}
@@ -23396,6 +23491,7 @@ static void do_reaper_dev_cgi(char *url, FILE *stream)
 		gk_rl_update(umac, state, expiry);	/* same format authority as GK */
 		nvram_commit();
 		notify_rc("restart_gk");
+		{ char sd[8]; snprintf(sd, sizeof(sd), "%d", state); rdev_audit("access", umac, sd); }
 		websWrite(stream, "{\"ok\":1}");
 		return;
 	}
@@ -23420,6 +23516,96 @@ static void do_reaper_dev_cgi(char *url, FILE *stream)
 		nvram_set("dhcp_end", e);
 		nvram_commit();
 		notify_rc("restart_dnsmasq");
+		{ char d[48]; snprintf(d, sizeof(d), "%s-%s", s, e); rdev_audit("widen_pool", "-", d); }
+		websWrite(stream, "{\"ok\":1}");
+		return;
+	}
+
+	/* ---------------- STORE_STATUS: durable-storage snapshot (read-only) ---- */
+	if (!strcmp(action, "store_status")) {
+		char base[128];
+		const char *loc_eff;
+		const char *req = nvram_safe_get("reaper_store");
+		struct statvfs vfs;
+		unsigned long long freeb = 0, totb = 0;
+		int mounted;
+		struct stat st;
+		char path[176];
+
+		loc_eff = rdev_store_base(base, sizeof(base));
+		if (statvfs(base, &vfs) == 0) {
+			freeb = (unsigned long long)vfs.f_bavail * vfs.f_frsize;
+			totb  = (unsigned long long)vfs.f_blocks * vfs.f_frsize;
+		}
+		/* requested usb but resolved elsewhere => no writable stick present */
+		mounted = (!strcmp(req, loc_eff)) ? 1 : 0;
+
+		websWrite(stream, "{\"loc\":\"%s\",\"loc_eff\":\"%s\",\"mounted\":%d,",
+			(req && req[0]) ? req : "ram", loc_eff, mounted);
+		websWrite(stream, "\"ds\":");
+		gk_json_esc(stream, nvram_safe_get("reaper_store_ds"));
+		websWrite(stream, ",\"free\":%llu,\"total\":%llu,", freeb, totb);
+
+		/* per-dataset facts: durable file size + first-collection marker */
+		snprintf(path, sizeof(path), "%s/dev.since", base);
+		{
+			long since = 0;
+			FILE *sf = fopen(path, "r");
+			if (sf) { if (fscanf(sf, "%ld", &since) != 1) since = 0; fclose(sf); }
+			websWrite(stream, "\"dev_since\":%ld,", since);
+		}
+		snprintf(path, sizeof(path), "%s/devhist.log", base);
+		websWrite(stream, "\"dev_bytes\":%lld,", (stat(path, &st) == 0) ? (long long)st.st_size : 0LL);
+		snprintf(path, sizeof(path), "%s/audit.log", base);
+		websWrite(stream, "\"audit_bytes\":%lld,", (stat(path, &st) == 0) ? (long long)st.st_size : 0LL);
+		snprintf(path, sizeof(path), "%s/syslog.mirror", base);
+		websWrite(stream, "\"slog_bytes\":%lld,", (stat(path, &st) == 0) ? (long long)st.st_size : 0LL);
+		snprintf(path, sizeof(path), "%s/chqhist.log", base);
+		websWrite(stream, "\"chq_bytes\":%lld,", (stat(path, &st) == 0) ? (long long)st.st_size : 0LL);
+		websWrite(stream, "\"rchq_enable\":%d,\"gk_enable\":%d,\"rtraf_enable\":%d}",
+			nvram_match("rchq_enable", "1") ? 1 : 0,
+			nvram_match("gk_enable", "1") ? 1 : 0,
+			nvram_match("rtraf_enable", "1") ? 1 : 0);
+		return;
+	}
+
+	/* ---------------- STORE_SET: location + per-dataset opt-in --------------- */
+	if (!strcmp(action, "store_set")) {
+		char *loc = get_cgi("loc");
+		char *ds  = get_cgi("ds");
+		char clean[80] = "";
+		const char *known[] = { "dev", "traf", "watch", "chq", "slog", NULL };
+		int traf_on = 0;
+
+		if (!loc || (strcmp(loc, "ram") && strcmp(loc, "jffs") && strcmp(loc, "usb"))) {
+			websWrite(stream, "{\"ok\":0,\"error\":\"bad location\"}");
+			return;
+		}
+		/* sanitize the dataset list: keep only known tokens, comma-joined */
+		if (ds) {
+			char work[128], *tok, *sp = NULL;
+			int k;
+			strlcpy(work, ds, sizeof(work));
+			for (tok = strtok_r(work, ", ", &sp); tok; tok = strtok_r(NULL, ", ", &sp)) {
+				for (k = 0; known[k]; k++) {
+					if (!strcmp(tok, known[k])) {
+						if (clean[0]) strlcat(clean, ",", sizeof(clean));
+						strlcat(clean, tok, sizeof(clean));
+						if (!strcmp(tok, "traf")) traf_on = 1;
+						break;
+					}
+				}
+			}
+		}
+		nvram_set("reaper_store", loc);
+		nvram_set("reaper_store_ds", clean);
+		/* traffic fold-in: rtrafd already reads rtraf_path ("" ram | jffs | usb).
+		 * Derive it from the selector so this tab is the single writable UI. */
+		nvram_set("rtraf_path", (traf_on && strcmp(loc, "ram")) ? loc : "");
+		nvram_commit();
+		notify_rc("restart_rtraf");	/* apply the store change to rtrafd */
+		notify_rc("restart_rwatch");	/* regenerate the tick script (loc/ds/DUMPROOT) */
+		rdev_audit("store_set", "-", loc);
 		websWrite(stream, "{\"ok\":1}");
 		return;
 	}
diff --git a/release/src/router/rc/rwatch.c b/release/src/router/rc/rwatch.c
index 93fd60457a..96ddc0d5a8 100644
--- a/release/src/router/rc/rwatch.c
+++ b/release/src/router/rc/rwatch.c
@@ -25,6 +25,13 @@
  * the box can always self-document a wedge even when nobody can log in.
  *
  * nvram: rwatch_enable (default 1), rwatch_iv (minutes, 1-30, default 5).
+ *
+ * reaper v1.9.1 (Device Identity Manager Rung B): this same tick also carries
+ * the opt-in long-term history writer (Reaper_Storage.asp). Guarded by nvram
+ * reaper_store (ram|jffs|usb) + reaper_store_ds (comma list: dev traf watch chq
+ * slog); the writer only touches files when a non-volatile store is selected and
+ * runs strictly AFTER the watchdog state machine so it can never disturb it. The
+ * shell rstore_base() below mirrors rdev_store_base() in httpd/web.c.
  */
 #include <stdio.h>
 #include <stdlib.h>
@@ -49,7 +56,26 @@ static void rwatch_gen(void)
 	  "#!/bin/sh\n"
 	  "# generated by start_rwatch - do not edit\n"
 	  "STATE=" RWATCH_STATE "\n"
+	  "\n"
+	  "# reaper v1.9.1 (Rung B): durable-store resolver - MIRRORS rdev_store_base()\n"
+	  "# in httpd/web.c (keep the two in lockstep). Re-resolved every tick so a USB\n"
+	  "# hotplug/removal is picked up without re-arming. Never follows a symlink.\n"
+	  "rstore_base() {\n"
+	  "  M=\"$(nvram get reaper_store)\"\n"
+	  "  case \"$M\" in\n"
+	  "    jffs) mkdir -p /jffs/reaper 2>/dev/null; [ -d /jffs/reaper ] && [ -w /jffs/reaper ] && { echo /jffs/reaper; return; } ;;\n"
+	  "    usb)  for d in /tmp/mnt/*/; do [ -d \"$d\" ] || continue; b=\"${d}.reaper\"; mkdir -p \"$b\" 2>/dev/null; [ -d \"$b\" ] && [ -w \"$b\" ] && { echo \"$b\"; return; }; done ;;\n"
+	  "  esac\n"
+	  "  mkdir -p /tmp/reaper 2>/dev/null; echo /tmp/reaper\n"
+	  "}\n"
+	  "DS=\",$(nvram get reaper_store_ds),\"\n"
+	  "BASE=\"$(rstore_base)\"\n"
+	  "VOLATILE=0; [ \"$BASE\" = /tmp/reaper ] && VOLATILE=1\n"
+	  "\n"
+	  "# rwatch incident dumps: default durable /jffs/rwatch; relocate onto the\n"
+	  "# selected medium only when 'watch' is opted in AND the base is non-volatile.\n"
 	  "DUMPROOT=/jffs/rwatch\n"
+	  "case \"$DS\" in *,watch,*) [ \"$VOLATILE\" = 0 ] && DUMPROOT=\"$BASE/rwatch\";; esac\n"
 	  "\n"
 	  "# boot grace: the WAN is legitimately down for the first minutes\n"
 	  "UP=$(cut -d. -f1 /proc/uptime)\n"
@@ -141,7 +167,57 @@ static void rwatch_gen(void)
 	  "    ;;\n"
 	  "  esac\n"
 	  "  echo OK > $STATE\n"
-	  "fi\n", f);
+	  "fi\n"
+	  "\n"
+	  "# ================= reaper v1.9.1: long-term history writer =================\n"
+	  "# Rides this same tick (no new daemon). Everything below is best-effort and\n"
+	  "# runs AFTER the watchdog state machine, so a fault here cannot affect it.\n"
+	  "# Nothing is written when the store is volatile (RAM): durability is opt-in.\n"
+	  "NOWH=$(date +%s)\n"
+	  "\n"
+	  "# 1) device presence deltas (join/leave of active LAN devices) -> capped ring\n"
+	  "case \"$DS\" in *,dev,*)\n"
+	  "  if [ \"$VOLATILE\" = 0 ]; then\n"
+	  "    SNAP=/tmp/rhist.snap; CUR=/tmp/rhist.cur\n"
+	  "    awk 'NR>1 && $3==\"0x2\" && $6 ~ /^br/ {print toupper($4)}' /proc/net/arp 2>/dev/null | sort -u > \"$CUR\"\n"
+	  "    if [ -s \"$SNAP\" ]; then\n"
+	  "      for m in $(grep -vxF -f \"$SNAP\" \"$CUR\" 2>/dev/null); do echo \"$NOWH J $m\" >> \"$BASE/devhist.log\"; done\n"
+	  "      for m in $(grep -vxF -f \"$CUR\" \"$SNAP\" 2>/dev/null); do echo \"$NOWH L $m\" >> \"$BASE/devhist.log\"; done\n"
+	  "    fi\n"
+	  "    mv \"$CUR\" \"$SNAP\" 2>/dev/null\n"
+	  "    if [ -f \"$BASE/devhist.log\" ]; then\n"
+	  "      LN=$(wc -l < \"$BASE/devhist.log\" 2>/dev/null || echo 0)\n"
+	  "      [ \"$LN\" -gt 5000 ] && { tail -n 5000 \"$BASE/devhist.log\" > \"$BASE/devhist.log.r\" 2>/dev/null && mv \"$BASE/devhist.log.r\" \"$BASE/devhist.log\"; }\n"
+	  "      [ -f \"$BASE/dev.since\" ] || echo \"$NOWH\" > \"$BASE/dev.since\"\n"
+	  "    fi\n"
+	  "  fi ;;\n"
+	  "esac\n"
+	  "\n"
+	  "# 2) channel-quality snapshot (rchqd live.json, if that monitor is running)\n"
+	  "case \"$DS\" in *,chq,*)\n"
+	  "  if [ \"$VOLATILE\" = 0 ] && [ -r /tmp/reaper_chq/live.json ]; then\n"
+	  "    { printf '%s ' \"$NOWH\"; cat /tmp/reaper_chq/live.json; echo; } >> \"$BASE/chqhist.log\" 2>/dev/null\n"
+	  "    LN=$(wc -l < \"$BASE/chqhist.log\" 2>/dev/null || echo 0)\n"
+	  "    [ \"$LN\" -gt 20000 ] && { tail -n 20000 \"$BASE/chqhist.log\" > \"$BASE/chqhist.log.r\" 2>/dev/null && mv \"$BASE/chqhist.log.r\" \"$BASE/chqhist.log\"; }\n"
+	  "  fi ;;\n"
+	  "esac\n"
+	  "\n"
+	  "# 3) syslog mirror (append lines added since the last tick), rotated at 8 MB\n"
+	  "case \"$DS\" in *,slog,*)\n"
+	  "  if [ \"$VOLATILE\" = 0 ] && [ -r /tmp/syslog.log ]; then\n"
+	  "    CURN=$(wc -l < /tmp/syslog.log 2>/dev/null || echo 0)\n"
+	  "    LASTN=$(cat /tmp/rhist.slogn 2>/dev/null || echo 0)\n"
+	  "    case \"$LASTN\" in ''|*[!0-9]*) LASTN=0;; esac\n"
+	  "    if [ \"$CURN\" -ge \"$LASTN\" ]; then\n"
+	  "      [ \"$CURN\" -gt \"$LASTN\" ] && tail -n +$((LASTN+1)) /tmp/syslog.log 2>/dev/null | head -n $((CURN-LASTN)) >> \"$BASE/syslog.mirror\" 2>/dev/null\n"
+	  "    else\n"
+	  "      cat /tmp/syslog.log >> \"$BASE/syslog.mirror\" 2>/dev/null\n"
+	  "    fi\n"
+	  "    echo \"$CURN\" > /tmp/rhist.slogn\n"
+	  "    SZ=$(wc -c < \"$BASE/syslog.mirror\" 2>/dev/null || echo 0)\n"
+	  "    [ \"$SZ\" -gt 8388608 ] && mv \"$BASE/syslog.mirror\" \"$BASE/syslog.mirror.1\" 2>/dev/null\n"
+	  "  fi ;;\n"
+	  "esac\n", f);
 	fclose(f);
 	chmod(RWATCH_SH, 0700);
 }
