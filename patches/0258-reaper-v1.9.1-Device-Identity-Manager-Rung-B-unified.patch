diff --git a/release/src/router/www/Reaper_Storage.asp b/release/src/router/www/Reaper_Storage.asp
new file mode 100644
index 0000000000..95df68c611
--- /dev/null
+++ b/release/src/router/www/Reaper_Storage.asp
@@ -0,0 +1,236 @@
+<!-- SPDX-License-Identifier: GPL-2.0-only
+     Copyright (C) 2026 the Reaper project maintainer
+     Part of the Reaper hardened Asuswrt-Merlin build. See LICENSE / LICENSE.reaper.
+     reaper v1.9.1: Device Identity Manager Rung B - unified long-term storage.
+     Chooses a durable location (RAM / JFFS / USB) for opt-in history datasets;
+     writes nvram reaper_store + reaper_store_ds via reaper_dev.cgi (store_set),
+     derives rtraf_path for the traffic fold-in. No new store, no new daemon:
+     the writer rides the rwatch cron tick (see rc/rwatch.c). -->
+<!DOCTYPE html>
+<html lang="en">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width, initial-scale=1">
+<meta name="reaper-native" content="1">
+<title>REAPER &mdash; <#RDST_00#></title>
+<style>
+@font-face{font-family:'Rajdhani';font-weight:600;font-display:swap;src:url('/fonts/rajdhani-600.woff2') format('woff2')}
+@font-face{font-family:'Rajdhani';font-weight:700;font-display:swap;src:url('/fonts/rajdhani-700.woff2') format('woff2')}
+@font-face{font-family:'Inter';font-weight:400;font-display:swap;src:url('/fonts/inter-400.woff2') format('woff2')}
+@font-face{font-family:'Inter';font-weight:600;font-display:swap;src:url('/fonts/inter-600.woff2') format('woff2')}
+:root{
+  --bg:#08080a; --panel:#0f0f12; --panel-2:#141418;
+  --line:rgba(225,6,0,.16); --line-soft:rgba(255,255,255,.06);
+  --crimson:#E10600; --crimson-deep:#B3000C;
+  --bone:#ECE7DB; --bone-dim:#B7B1A4; --steel:#71767b;
+  --jade:#4FB286; --amber:#d9a441; --danger:#FF3B30;
+  --hdr:'Rajdhani','Oswald',system-ui,sans-serif;
+  --body:'Inter',system-ui,-apple-system,'Segoe UI',sans-serif;
+}
+*{box-sizing:border-box;margin:0}
+html,body{background:var(--bg)}
+body{font-family:var(--body);color:var(--bone-dim);font-size:13.5px;line-height:1.55;padding:20px 22px 48px}
+h1,h2,h3{font-family:var(--hdr);letter-spacing:.04em;color:var(--bone);margin:0}
+.pagehead{display:flex;align-items:center;gap:16px;flex-wrap:wrap;margin-bottom:4px;max-width:1120px}
+.pagehead h1{font-size:24px;font-weight:700}
+.statuspill{font-family:var(--hdr);font-weight:600;font-size:11px;letter-spacing:.1em;text-transform:uppercase;border-radius:20px;padding:4px 12px;border:1px solid var(--line);color:var(--jade)}
+.statuspill.vol{color:var(--steel);border-color:var(--line-soft)}
+.lede{max-width:78ch;margin:6px 0 16px}
+.lede b{color:var(--bone);font-weight:600}
+.card{background:var(--panel);border:1px solid var(--line-soft);border-radius:12px;padding:16px 18px;margin-bottom:16px;max-width:1120px}
+.card>h2{font-size:14px;text-transform:uppercase;letter-spacing:.1em;margin-bottom:10px;padding-bottom:8px;border-bottom:1px solid var(--line-soft)}
+.tblbar{display:flex;gap:8px;align-items:center;margin-bottom:12px;flex-wrap:wrap}
+.tblbar .lbl{font-size:11px;text-transform:uppercase;letter-spacing:.1em;color:var(--steel)}
+.fchip{font-size:11.5px;border:1px solid rgba(255,255,255,.14);border-radius:16px;padding:3px 12px;color:var(--bone-dim);cursor:pointer;user-select:none}
+.fchip.on{border-color:var(--crimson-deep);color:var(--bone);background:rgba(225,6,0,.10)}
+.health{margin-left:auto;font-size:11.5px}
+.note{font-size:12px;color:var(--steel);line-height:1.55;margin-top:4px}
+.note b{color:var(--bone-dim)}
+.warn{color:var(--amber)}
+.tblwrap{overflow-x:auto}
+table{width:100%;border-collapse:collapse;font-size:12.8px}
+th{font-family:var(--hdr);font-weight:600;font-size:11px;text-transform:uppercase;letter-spacing:.1em;color:var(--steel);text-align:left;padding:8px 10px;border-bottom:1px solid var(--line)}
+td{padding:10px 10px;border-bottom:1px solid var(--line-soft);vertical-align:middle}
+tr:last-child td{border-bottom:none}
+td.dsname{color:var(--bone);white-space:nowrap}
+td.dswrite{color:var(--steel);font-size:12px;white-space:normal;max-width:360px}
+td.dscap{color:var(--steel);white-space:nowrap}
+td.dssince{color:var(--bone-dim);white-space:nowrap}
+.tg{position:relative;width:40px;height:21px;border-radius:12px;background:#26262c;border:1px solid rgba(255,255,255,.12);cursor:pointer;display:inline-block;vertical-align:middle}
+.tg::after{content:"";position:absolute;top:2px;left:2px;width:15px;height:15px;border-radius:50%;background:var(--steel);transition:.15s}
+.tg.on{background:#33333a}
+.tg.on::after{left:21px;background:var(--bone)}
+.chip{font-size:10px;font-weight:600;text-transform:uppercase;letter-spacing:.08em;border-radius:4px;padding:2px 7px;border:1px solid var(--line-soft);color:var(--steel)}
+.btn{font-family:var(--hdr);font-weight:600;letter-spacing:.06em;text-transform:uppercase;font-size:12px;color:#fff;background:linear-gradient(180deg,var(--crimson),var(--crimson-deep));border:1px solid transparent;border-radius:8px;padding:9px 18px;cursor:pointer}
+.btn[disabled]{opacity:.4;cursor:not-allowed}
+.saved{margin-left:12px;font-size:12px;color:var(--jade)}
+.saved.err{color:var(--danger)}
+.foot{font-size:12px;color:var(--steel);max-width:1120px}
+</style>
+</head>
+<body>
+<div class="pagehead">
+  <h1><#RDST_00#></h1>
+  <span class="statuspill" id="pill">&nbsp;</span>
+</div>
+<p class="lede"><#RDST_01#></p>
+
+<div class="card">
+  <div class="tblbar">
+    <span class="lbl"><#RDST_02#></span>
+    <span class="fchip stg" data-s="ram"><#RDST_03#></span>
+    <span class="fchip stg" data-s="jffs"><#RDST_04#></span>
+    <span class="fchip stg" data-s="usb"><#RDST_05#></span>
+    <span class="health" id="health">&nbsp;</span>
+  </div>
+  <p class="note" id="loc_note">&nbsp;</p>
+</div>
+
+<div class="card">
+  <h2><#RDST_00#></h2>
+  <div class="tblwrap"><table>
+    <thead><tr><th></th><th><#RDST_06#></th><th><#RDST_07#></th><th><#RDST_08#></th><th><#RDST_09#></th></tr></thead>
+    <tbody id="ds_rows"></tbody>
+  </table></div>
+  <p class="note" id="timeline_note" style="margin-top:12px"><#RDST_36#></p>
+  <div style="margin-top:14px">
+    <button class="btn" id="saveBtn"><#RDST_31#></button>
+    <span class="saved" id="saved" style="display:none">&nbsp;</span>
+  </div>
+</div>
+
+<script>
+var REAPER_HTTPID = '<% nvram_get("http_id"); %>';   /* CSRF token */
+var S = null;                 /* store_status snapshot */
+var loc = 'ram';              /* staged (unsaved) location */
+var dsOn = {};                /* staged (unsaved) per-dataset enable */
+
+function esc(s){ var d=document.createElement('div'); d.textContent=String(s==null?'':s); return d.innerHTML; }
+function fmtBytes(b){
+  if(b >= 1073741824) return (b/1073741824).toFixed(1) + ' GB';
+  if(b >= 1048576) return Math.round(b/1048576) + ' MB';
+  if(b >= 1024) return Math.round(b/1024) + ' KB';
+  return b > 0 ? b + ' B' : '0 B';
+}
+function fmtDate(sec){
+  if(!sec) return '&mdash;';
+  var d = new Date(sec*1000);
+  return d.toLocaleDateString();
+}
+
+/* dataset catalog (order = display order). key must match reaper_store_ds tokens.
+   cap strings mix a number (kept literal) with a tokenized noun (rule 24). */
+var CAP_RING = `<#RDST_34#>`, CAP_INC = `<#RDST_35#>`;
+var DSETS = [
+  {k:'dev',   name:`<#RDST_10#>`, write:`<#RDST_11#>`, cap:'2 MB ' + CAP_RING},
+  {k:'traf',  name:`<#RDST_12#>`, write:`<#RDST_13#>`, cap:'32 MB ' + CAP_RING},
+  {k:'watch', name:`<#RDST_14#>`, write:`<#RDST_15#>`, cap:'3 ' + CAP_INC},
+  {k:'chq',   name:`<#RDST_16#>`, write:`<#RDST_17#>`, cap:'4 MB ' + CAP_RING},
+  {k:'slog',  name:`<#RDST_18#>`, write:`<#RDST_19#>`, cap:'8 MB x 2'},
+  {k:'ward',  name:`<#RDST_20#>`, write:`<#RDST_21#>`, cap:'&mdash;', locked:1}
+];
+
+function xGet(url, cb){
+  var x = new XMLHttpRequest();
+  x.open('GET', url + '&_=' + Date.now(), true);
+  x.timeout = 12000;
+  x.onreadystatechange = function(){
+    if(x.readyState !== 4) return;
+    var j = null;
+    if(x.status === 200){ try{ j = JSON.parse(x.responseText); }catch(e){} }
+    cb(j);
+  };
+  x.send();
+}
+
+function loadStatus(){
+  xGet('/reaper_dev.cgi?action=store_status', function(j){
+    if(!j){ document.getElementById('loc_note').innerHTML = '<span style="color:var(--danger)">' + esc(`<#RDST_33#>`) + '</span>'; return; }
+    S = j;
+    loc = (j.loc === 'jffs' || j.loc === 'usb') ? j.loc : 'ram';
+    dsOn = {};
+    (j.ds || '').split(',').forEach(function(t){ t = t.trim(); if(t) dsOn[t] = 1; });
+    render();
+  });
+}
+
+function render(){
+  /* location chips */
+  Array.prototype.forEach.call(document.querySelectorAll('.stg'), function(n){
+    n.className = 'fchip stg' + (n.getAttribute('data-s') === loc ? ' on' : '');
+    n.onclick = function(){ loc = n.getAttribute('data-s'); render(); };
+  });
+
+  var durable = (loc !== 'ram');
+  var usbFail = (loc === 'usb' && S && !S.mounted);
+
+  /* health line */
+  var h = document.getElementById('health');
+  if(loc === 'ram'){ h.innerHTML = '<span style="color:var(--steel)">' + esc(`<#RDST_28#>`) + '</span>'; }
+  else if(usbFail){ h.innerHTML = '<span style="color:var(--amber)">' + esc(`<#RDST_30#>`) + '</span>'; }
+  else {
+    var label = (loc === 'jffs') ? `<#RDST_04#>` : `<#RDST_05#>`;
+    var freeTx = (S && S.free) ? (fmtBytes(S.free) + ' ' + esc(`<#RDST_29#>`)) : '';
+    h.innerHTML = '<span style="color:var(--jade)">' + esc(label) + '</span>' + (freeTx ? ' &middot; ' + freeTx : '');
+  }
+
+  /* location note */
+  var ln = document.getElementById('loc_note');
+  ln.innerHTML = (loc === 'usb')
+      ? ('<b>' + esc(`<#RDST_24#>`) + '</b> ' + esc(`<#RDST_25#>`))
+      : (loc === 'jffs') ? esc(`<#RDST_26#>`) : esc(`<#RDST_27#>`);
+
+  /* status pill */
+  var pill = document.getElementById('pill');
+  if(durable && !usbFail){ pill.className = 'statuspill'; pill.textContent = `<#RDST_37#>`; }
+  else { pill.className = 'statuspill vol'; pill.textContent = `<#RDST_38#>`; }
+
+  /* dataset rows */
+  var el = '';
+  DSETS.forEach(function(ds){
+    var tog, since;
+    if(ds.locked){
+      tog = '<span class="chip" title="' + esc(`<#RDST_22#>`) + '">' + esc(`<#RDST_23#>`) + '</span>';
+      since = '&mdash;';   /* Warden cache is locked to /jffs; not tracked here */
+    } else {
+      var on = !!dsOn[ds.k];
+      tog = '<span class="tg' + (on ? ' on' : '') + '" data-k="' + ds.k + '"></span>';
+      since = (ds.k === 'dev' && durable && S && S.dev_since)
+            ? fmtDate(S.dev_since) : '<span style="color:var(--steel)">&mdash;</span>';
+    }
+    el += '<tr>' +
+      '<td>' + tog + '</td>' +
+      '<td class="dsname">' + ds.name + '</td>' +
+      '<td class="dswrite">' + ds.write + '</td>' +
+      '<td class="dscap">' + ds.cap + '</td>' +
+      '<td class="dssince">' + since + '</td></tr>';
+  });
+  document.getElementById('ds_rows').innerHTML = el;
+  Array.prototype.forEach.call(document.querySelectorAll('#ds_rows .tg'), function(n){
+    n.onclick = function(){ var k = n.getAttribute('data-k'); dsOn[k] = dsOn[k] ? 0 : 1; render(); };
+  });
+}
+
+function save(){
+  var order = ['dev','traf','watch','chq','slog'];
+  var list = order.filter(function(k){ return dsOn[k]; }).join(',');
+  var btn = document.getElementById('saveBtn'); btn.disabled = true;
+  xGet('/reaper_dev.cgi?action=store_set&loc=' + encodeURIComponent(loc) +
+       '&ds=' + encodeURIComponent(list) +
+       '&http_id=' + encodeURIComponent(REAPER_HTTPID), function(j){
+    btn.disabled = false;
+    var s = document.getElementById('saved');
+    if(j && j.ok === 1){ s.className = 'saved'; s.textContent = `<#RDST_32#>`; }
+    else { s.className = 'saved err'; s.textContent = (j && j.error) ? j.error : `<#RDST_33#>`; }
+    s.style.display = '';
+    setTimeout(function(){ s.style.display = 'none'; }, 4000);
+    loadStatus();
+  });
+}
+
+document.getElementById('saveBtn').onclick = save;
+if(document.readyState !== 'loading') loadStatus();
+else document.addEventListener('DOMContentLoaded', loadStatus);
+</script>
+</body>
+</html>
