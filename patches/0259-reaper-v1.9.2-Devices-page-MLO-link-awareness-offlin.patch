diff --git a/release/src/router/httpd/web.c b/release/src/router/httpd/web.c
index e177613b99..c59be05537 100644
--- a/release/src/router/httpd/web.c
+++ b/release/src/router/httpd/web.c
@@ -23147,7 +23147,7 @@ static void do_reaper_dev_cgi(char *url, FILE *stream)
 		FILE *f;
 		char *buf, *tok, *sp = NULL;
 		unsigned int lan_ip, lan_mask, lan_net, dstart, dend;
-		int pool_size, gk_on;
+		int pool_size, gk_on, mlo_on;
 
 		lan_ip   = rdev_ip2u(nvram_safe_get("lan_ipaddr"));
 		lan_mask = rdev_ip2u(nvram_safe_get("lan_netmask"));
@@ -23156,6 +23156,14 @@ static void do_reaper_dev_cgi(char *url, FILE *stream)
 		dend     = rdev_ip2u(nvram_safe_get("dhcp_end"));
 		pool_size = (dend >= dstart && dstart) ? (int)(dend - dstart + 1) : 0;
 		gk_on    = nvram_match("gk_enable", "1") ? 1 : 0;
+		/* MLO fronthaul active? mld_enable is the master switch (same flag the
+		 * stock Wireless page reads); a non-empty mld{0,1,2}_ifnames means a
+		 * Multi-Link Device is actually formed. When on, a client's per-link
+		 * affiliated MACs each appear in a radio assoclist as a locally-
+		 * administered, lease-less station - NOT a separate device. */
+		mlo_on = (nvram_match("mld_enable", "1") &&
+		          (*nvram_safe_get("mld0_ifnames") || *nvram_safe_get("mld1_ifnames") ||
+		           *nvram_safe_get("mld2_ifnames"))) ? 1 : 0;
 
 		/* 1. DHCP leases: known devices (ip + self-reported host) */
 		f = fopen("/var/lib/misc/dnsmasq.leases", "r");
@@ -23272,7 +23280,7 @@ static void do_reaper_dev_cgi(char *url, FILE *stream)
 				if (!taken) { chosen = cand; break; }
 			}
 
-			websWrite(stream, "{\"now\":%ld,\"gk_enable\":%d,", (long)time(NULL), gk_on);
+			websWrite(stream, "{\"now\":%ld,\"gk_enable\":%d,\"mlo\":%d,", (long)time(NULL), gk_on, mlo_on);
 			websWrite(stream, "\"pool\":{\"subnet\":\"%u.%u.%u\",\"start\":\"%s\",\"end\":\"%s\",\"size\":%d},",
 				(lan_net >> 24) & 0xff, (lan_net >> 16) & 0xff, (lan_net >> 8) & 0xff,
 				nvram_safe_get("dhcp_start"), nvram_safe_get("dhcp_end"), pool_size);
@@ -23293,6 +23301,10 @@ static void do_reaper_dev_cgi(char *url, FILE *stream)
 			int rin = (d->resv && rip && dstart && rip >= dstart && rip <= dend) ? 1 : 0;
 			int orphan = (d->resv && rip && lan_mask && (rip & lan_mask) != lan_net) ? 1 : 0;
 			int nolease = (d->wifi && !d->ip[0]) ? 1 : 0;
+			/* affiliated MLO link: a Wi-Fi-associated, locally-administered,
+			 * lease-less, un-reserved station while MLO is active = one radio
+			 * link of a multi-link device, not a device in its own right. */
+			int mlo_link = (mlo_on && d->wifi && !d->ip[0] && !d->resv && rdev_is_rand(d->mac)) ? 1 : 0;
 			int dup = 0, j;
 			const char *src;
 
@@ -23319,8 +23331,8 @@ static void do_reaper_dev_cgi(char *url, FILE *stream)
 				d->gk_state, d->gk_expiry, d->resv ? 1 : 0, rin);
 			websWrite(stream, "\"resv_ip\":");
 			gk_json_esc(stream, d->resv_ip);
-			websWrite(stream, ",\"rand\":%d,\"orphan\":%d,\"dup\":%d,\"nolease\":%d}",
-				rdev_is_rand(d->mac), orphan, dup, nolease);
+			websWrite(stream, ",\"rand\":%d,\"orphan\":%d,\"dup\":%d,\"nolease\":%d,\"mlo_link\":%d}",
+				rdev_is_rand(d->mac), orphan, dup, nolease, mlo_link);
 		}
 		websWrite(stream, "]}");
 		return;
