From 4c99c21b61404aa3c21fbfda82698cb4f2cb2736 Mon Sep 17 00:00:00 2001
From: reaper <theunbounddeveloper@outlook.com>
Date: Wed, 29 Jul 2026 19:19:36 -0400
Subject: [PATCH] reaper v1.9.3: Devices page - merge Wi-Fi 7 MLO links into
 one device row

Follow-up to v1.9.2 (which only labelled MLO links in place). Using the driver's
per-link MLD mapping (wl sta_info -> 'MLO: peer mld address'), affiliated links are
now folded into their real device so a multi-link client is ONE row.

- rdev_sta_mld(): reads a station's MLD MAC from wl sta_info (only MLO_CAP stations
  carry the peer-mld line; mlo_status/mlo_config are Unsupported on this driver).
- rdev_scan_wl(): a randomized affiliated link (locally-administered, one per radio)
  is grouped under its MLD MAC instead of becoming its own lease-less orphan row;
  the device accrues a bandmask across its links. Only randomized MACs are probed
  (one cheap sta_info each) and only while MLO is active - the global-MAC primary
  link is added normally and gains mlo + bands when a sibling groups into it. Zero
  extra work / zero behavior change when MLO is off.
- CGI emits per-device mlo + bands (e.g. "5+6"); page shows connection "MLO . 5+6 GHz"
  on the merged row (and the parent that used to read "Wired" now reads MLO). The
  v1.9.2 in-place label remains as a fallback for any link sta_info cannot map.
No new tokens/dicts (MLO/bands are literal acronyms/units).
---
 release/src-rt/version.conf               |  2 +-
 release/src/router/httpd/web.c            | 77 ++++++++++++++++++++---
 release/src/router/www/Reaper_Devices.asp |  3 +-
 3 files changed, 71 insertions(+), 11 deletions(-)

diff --git a/release/src-rt/version.conf b/release/src-rt/version.conf
index 0b82e9ffdd..d2b663dee7 100644
--- a/release/src-rt/version.conf
+++ b/release/src-rt/version.conf
@@ -4,6 +4,6 @@ KERNEL_VER_AM=$(subst .,,$(KERNEL_VER))
 FS_VER_AM=$(subst .,,$(FS_VER))
 
 SERIALNO=102.8
-EXTENDNO=Reaper_v1.9.2
+EXTENDNO=Reaper_v1.9.3
 
 RCNO=0
diff --git a/release/src/router/httpd/web.c b/release/src/router/httpd/web.c
index c59be05537..fb52db0b96 100644
--- a/release/src/router/httpd/web.c
+++ b/release/src/router/httpd/web.c
@@ -22941,6 +22941,8 @@ struct rdev {
 	char resv_ip[46];
 	int  gk_state;		/* -1 = not in gk_rl */
 	long gk_expiry;
+	int  mlo;		/* Wi-Fi 7 MLD: an affiliated link folded into this MLD MAC */
+	int  bandmask;		/* bands linked on: 1=2.4 2=5 4=6 */
 };
 
 /* dotted-quad -> host-order u32; 0 on parse failure (0.0.0.0 is never a host) */
@@ -22977,7 +22979,43 @@ static int rdev_find(struct rdev *v, int *n, const char *macraw)
  * the user networks - and therefore the stations - live on the VIFs). Mirrors
  * gkd/reaper_diag: nvram wl{u}_ifname + wl{u}_vifs, wl -i <if> assoclist, with
  * the S6 charset guard before the name reaches popen. Sets band/wifi/online. */
-static void rdev_scan_wl(struct rdev *v, int *n)
+/* rdev_is_rand() is defined below (after rdev_scan_wl) but used inside it */
+static int rdev_is_rand(const char *mac);
+
+/* Read a station's MLD (Multi-Link Device) MAC from wl sta_info if it is an
+ * affiliated Wi-Fi 7 MLO link. The line is:
+ *     MLO: peer mld address : 78:46:5C:3B:8A:27
+ * Only MLO_CAP stations carry it. Returns 1 + fills mld (uppercase) on a hit.
+ * ifname is charset-validated by the caller; mac is validated here. */
+static int rdev_sta_mld(const char *ifname, const char *mac, char *mld, size_t mldlen)
+{
+	char cmd[128], line[256];
+	FILE *p;
+	int got = 0;
+
+	mld[0] = '\0';
+	if (!gk_valid_mac(mac)) return 0;
+	snprintf(cmd, sizeof(cmd), "wl -i %s sta_info %s 2>/dev/null", ifname, mac);
+	if ((p = popen(cmd, "r")) == NULL) return 0;
+	while (fgets(line, sizeof(line), p)) {
+		char *q = strstr(line, "peer mld address");
+		char m[32];
+		if (!q) continue;
+		q = strchr(q, ':');		/* the " : " separator before the MAC */
+		if (q && sscanf(q + 1, " %31s", m) == 1 && strlen(m) == 17 && gk_valid_mac(m)) {
+			int i;
+			for (i = 0; i < 17 && i < (int)mldlen - 1; i++)
+				mld[i] = toupper((unsigned char)m[i]);
+			mld[i] = '\0';
+			got = 1;
+		}
+		break;
+	}
+	pclose(p);
+	return got;
+}
+
+static void rdev_scan_wl(struct rdev *v, int *n, int mlo_on)
 {
 	int u;
 	for (u = 0; u <= 3; u++) {
@@ -22985,7 +23023,7 @@ static void rdev_scan_wl(struct rdev *v, int *n)
 		char ifl[512];
 		const char *band;
 		char *tok, *sp = NULL;
-		int nb;
+		int nb, bandbit;
 
 		snprintf(key, sizeof(key), "wl%d_ifname", u);
 		snprintf(ifl, sizeof(ifl), "%s", nvram_safe_get(key));
@@ -22993,6 +23031,7 @@ static void rdev_scan_wl(struct rdev *v, int *n)
 		snprintf(key, sizeof(key), "wl%d_nband", u);
 		nb = nvram_get_int(key);
 		band = (nb == 2) ? "2.4" : (nb == 1) ? "5" : (nb == 4) ? "6" : "";
+		bandbit = (nb == 2) ? 1 : (nb == 1) ? 2 : (nb == 4) ? 4 : 0;
 
 		/* base ifname + each VIF, space/comma/&lt;&gt; separated */
 		{
@@ -23007,13 +23046,27 @@ static void rdev_scan_wl(struct rdev *v, int *n)
 				snprintf(cmd, sizeof(cmd), "wl -i %s assoclist 2>/dev/null", tok);
 				if ((p = popen(cmd, "r")) == NULL) continue;
 				while (fgets(line, sizeof(line), p)) {
-					char mac[64];
+					char mac[64], mld[18];
 					int idx;
 					if (sscanf(line, "assoclist %63s", mac) != 1) continue;
-					idx = rdev_find(v, n, mac);
-					if (idx < 0) continue;
+					/* Fold a randomized affiliated MLO link into its MLD device so the
+					 * device is ONE row, not a cluster of lease-less link orphans. Only
+					 * randomized MACs are probed (affiliated links are locally-admin-
+					 * istered), and only while MLO is active; a global-MAC primary link
+					 * is added as itself and gains mlo + bands when a sibling groups in. */
+					if (mlo_on && rdev_is_rand(mac) &&
+					    rdev_sta_mld(tok, mac, mld, sizeof(mld)) && mld[0] &&
+					    strcasecmp(mld, mac) != 0) {
+						idx = rdev_find(v, n, mld);
+						if (idx < 0) continue;
+						v[idx].mlo = 1;
+					} else {
+						idx = rdev_find(v, n, mac);
+						if (idx < 0) continue;
+					}
 					v[idx].wifi = 1;
 					v[idx].online = 1;
+					v[idx].bandmask |= bandbit;
 					if (!v[idx].band[0])
 						snprintf(v[idx].band, sizeof(v[0].band), "%s", band);
 				}
@@ -23202,7 +23255,7 @@ static void do_reaper_dev_cgi(char *url, FILE *stream)
 		}
 
 		/* 3. wireless assoclists (band + wifi + online) */
-		rdev_scan_wl(dev, &n);
+		rdev_scan_wl(dev, &n, mlo_on);
 		/* online-but-not-wifi => wired */
 		for (i = 0; i < n; i++)
 			if (dev[i].online && !dev[i].wifi) dev[i].wired = 1;
@@ -23304,7 +23357,7 @@ static void do_reaper_dev_cgi(char *url, FILE *stream)
 			/* affiliated MLO link: a Wi-Fi-associated, locally-administered,
 			 * lease-less, un-reserved station while MLO is active = one radio
 			 * link of a multi-link device, not a device in its own right. */
-			int mlo_link = (mlo_on && d->wifi && !d->ip[0] && !d->resv && rdev_is_rand(d->mac)) ? 1 : 0;
+			int mlo_link = (mlo_on && d->wifi && !d->ip[0] && !d->resv && rdev_is_rand(d->mac) && !d->mlo) ? 1 : 0;
 			int dup = 0, j;
 			const char *src;
 
@@ -23331,8 +23384,14 @@ static void do_reaper_dev_cgi(char *url, FILE *stream)
 				d->gk_state, d->gk_expiry, d->resv ? 1 : 0, rin);
 			websWrite(stream, "\"resv_ip\":");
 			gk_json_esc(stream, d->resv_ip);
-			websWrite(stream, ",\"rand\":%d,\"orphan\":%d,\"dup\":%d,\"nolease\":%d,\"mlo_link\":%d}",
-				rdev_is_rand(d->mac), orphan, dup, nolease, mlo_link);
+			{
+				char bands[16] = "";
+				if (d->bandmask & 1) strlcat(bands, "2.4", sizeof(bands));
+				if (d->bandmask & 2) { if (bands[0]) strlcat(bands, "+", sizeof(bands)); strlcat(bands, "5", sizeof(bands)); }
+				if (d->bandmask & 4) { if (bands[0]) strlcat(bands, "+", sizeof(bands)); strlcat(bands, "6", sizeof(bands)); }
+				websWrite(stream, ",\"rand\":%d,\"orphan\":%d,\"dup\":%d,\"nolease\":%d,\"mlo_link\":%d,\"mlo\":%d,\"bands\":\"%s\"}",
+					rdev_is_rand(d->mac), orphan, dup, nolease, mlo_link, d->mlo, bands);
+			}
 		}
 		websWrite(stream, "]}");
 		return;
diff --git a/release/src/router/www/Reaper_Devices.asp b/release/src/router/www/Reaper_Devices.asp
index ff90f26b73..9e18397518 100644
--- a/release/src/router/www/Reaper_Devices.asp
+++ b/release/src/router/www/Reaper_Devices.asp
@@ -401,7 +401,8 @@ function renderRows(){
     }
     /* built as HTML (NOT esc'd) so the em-dash renders; the offline/unknown case
        used to pass '&mdash;' through esc() and printed the literal entity text */
-    var connHtml = d.mlo_link ? ('MLO' + (d.band ? ' &middot; ' + esc(d.band) + ' GHz' : ''))
+    var connHtml = (d.mlo && d.bands) ? ('MLO &middot; ' + esc(d.bands) + ' GHz')
+                 : d.mlo_link ? ('MLO' + (d.band ? ' &middot; ' + esc(d.band) + ' GHz' : ''))
                  : d.wired ? esc(T('RDEV_43'))
                  : d.band ? (esc(d.band) + ' GHz')
                  : '<span style="color:var(--steel)">&mdash;</span>';
