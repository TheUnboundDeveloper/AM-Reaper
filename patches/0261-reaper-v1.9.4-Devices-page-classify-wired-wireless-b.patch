From c2bbec51fbd4f1cb8a7a6d89b538137cc622aa20 Mon Sep 17 00:00:00 2001
From: reaper <theunbounddeveloper@outlook.com>
Date: Wed, 29 Jul 2026 20:24:17 -0400
Subject: [PATCH] reaper v1.9.4: Devices page - classify wired/wireless by
 bridge FDB (fix Wi-Fi shown as Wired)

Root cause: do_reaper_dev_cgi decided wired vs wireless as (online && !in-assoclist).
But wl assoclist INTERMITTENTLY OMITS associated EHT / 6GHz / pseudo-MLO stations
(metal-confirmed: a station whose wl sta_info returns data + is in the bridge FDB was
absent from that VIF's assoclist), so those Wi-Fi clients fell through to "Wired".

Fix: rdev_scan_fdb() classifies by the LAN bridge FORWARDING TABLE - the port a MAC
was learned on (brctl showmacs br0 -> port_no, mapped to ifname via
/sys/class/net/br0/brif/*/port_no). eth* port => wired; wlN[.M] port => wireless on
that radio's band (nband); presence in the table => online. It only reclassifies
devices already discovered (rdev_lookup, no new rows), runs after the assoclist/MLO
pass, never clobbers a merged MLO device's multi-band, and never downgrades an
assoclist-positive Wi-Fi client to wired on a stale FDB entry. The old heuristic
remains only as a last resort for a device the bridge never placed. brctl is shipped.
No page/dict change - the recovered band flows through the existing connection cell.
---
 release/src-rt/version.conf    |  2 +-
 release/src/router/httpd/web.c | 98 +++++++++++++++++++++++++++++++++-
 2 files changed, 97 insertions(+), 3 deletions(-)

diff --git a/release/src-rt/version.conf b/release/src-rt/version.conf
index d2b663dee7..1771c1c9a1 100644
--- a/release/src-rt/version.conf
+++ b/release/src-rt/version.conf
@@ -4,6 +4,6 @@ KERNEL_VER_AM=$(subst .,,$(KERNEL_VER))
 FS_VER_AM=$(subst .,,$(FS_VER))
 
 SERIALNO=102.8
-EXTENDNO=Reaper_v1.9.3
+EXTENDNO=Reaper_v1.9.4
 
 RCNO=0
diff --git a/release/src/router/httpd/web.c b/release/src/router/httpd/web.c
index fb52db0b96..d614b16b52 100644
--- a/release/src/router/httpd/web.c
+++ b/release/src/router/httpd/web.c
@@ -23076,6 +23076,97 @@ static void rdev_scan_wl(struct rdev *v, int *n, int mlo_on)
 	}
 }
 
+/* like rdev_find but NEVER adds - returns an existing MAC's index or -1. Used by
+ * the bridge-FDB pass so it only RECLASSIFIES devices already discovered. */
+static int rdev_lookup(struct rdev *v, int n, const char *macraw)
+{
+	char mac[18];
+	int i;
+	if (!macraw || strlen(macraw) != 17) return -1;
+	for (i = 0; i < 17; i++) mac[i] = toupper((unsigned char)macraw[i]);
+	mac[17] = 0;
+	for (i = 0; i < n; i++)
+		if (!strcasecmp(v[i].mac, mac)) return i;
+	return -1;
+}
+
+/* Classify wired/wireless by the LAN bridge forwarding table - the port a MAC was
+ * learned on is ground truth and, unlike wl assoclist, never omits EHT/6GHz/pseudo-
+ * MLO stations (assoclist DROPPING associated 6GHz/EHT clients is exactly why some
+ * Wi-Fi devices showed as "Wired"). A MAC on an eth* port is wired; on a wlN[.M]
+ * port it is wireless on that radio's band, and being in the table means it is
+ * actively bridging => online. Only reclassifies devices already in the table. */
+static void rdev_scan_fdb(struct rdev *v, int *n)
+{
+	struct { int pno, kind, bandbit; char band[8]; } port[40];
+	int nports = 0;
+	DIR *d;
+	struct dirent *e;
+	FILE *p;
+	char line[192];
+
+	d = opendir("/sys/class/net/br0/brif");
+	if (!d) return;
+	while ((e = readdir(d)) != NULL && nports < 40) {
+		char path[128];
+		FILE *f;
+		long pno = -1;
+		if (e->d_name[0] == '.') continue;
+		snprintf(path, sizeof(path), "/sys/class/net/br0/brif/%s/port_no", e->d_name);
+		if ((f = fopen(path, "r")) != NULL) {
+			if (fscanf(f, "%li", &pno) != 1) pno = -1;	/* sysfs is 0x.. hex */
+			fclose(f);
+		}
+		if (pno < 0) continue;
+		port[nports].pno = (int)pno;
+		port[nports].kind = 0;
+		port[nports].bandbit = 0;
+		port[nports].band[0] = 0;
+		if (!strncmp(e->d_name, "eth", 3)) {
+			port[nports].kind = 1;		/* wired */
+		} else if (!strncmp(e->d_name, "wl", 2)) {
+			char key[16];
+			int u = atoi(e->d_name + 2), nb;	/* wlN[.M] -> N */
+			port[nports].kind = 2;		/* wireless */
+			snprintf(key, sizeof(key), "wl%d_nband", u);
+			nb = nvram_get_int(key);
+			snprintf(port[nports].band, sizeof(port[0].band), "%s",
+				(nb == 2) ? "2.4" : (nb == 1) ? "5" : (nb == 4) ? "6" : "");
+			port[nports].bandbit = (nb == 2) ? 1 : (nb == 1) ? 2 : (nb == 4) ? 4 : 0;
+		}
+		nports++;
+	}
+	closedir(d);
+	if (!nports) return;
+
+	p = popen("brctl showmacs br0 2>/dev/null", "r");
+	if (!p) return;
+	while (fgets(line, sizeof(line), p)) {
+		int pno, idx, k;
+		char mac[64], islocal[8];
+		/* "<pno> <mac> <is local?> <ageing>"; the header line fails %d -> skipped */
+		if (sscanf(line, "%d %63s %7s", &pno, mac, islocal) != 3) continue;
+		if (!strcmp(islocal, "yes")) continue;	/* the bridge's own port MACs */
+		idx = rdev_lookup(v, *n, mac);
+		if (idx < 0) continue;
+		for (k = 0; k < nports; k++) {
+			if (port[k].pno != pno) continue;
+			if (port[k].kind == 1) {
+				if (!v[idx].wifi) { v[idx].wired = 1; v[idx].online = 1; }
+			} else if (port[k].kind == 2) {
+				v[idx].wifi = 1; v[idx].wired = 0; v[idx].online = 1;
+				if (!v[idx].mlo && !v[idx].bandmask) {	/* don't clobber merged MLO bands */
+					v[idx].bandmask |= port[k].bandbit;
+					if (!v[idx].band[0])
+						snprintf(v[idx].band, sizeof(v[0].band), "%s", port[k].band);
+				}
+			}
+			break;
+		}
+	}
+	pclose(p);
+}
+
 /* the 2nd hex nibble x2 bit => locally-administered (randomized) MAC */
 static int rdev_is_rand(const char *mac)
 {
@@ -23256,9 +23347,12 @@ static void do_reaper_dev_cgi(char *url, FILE *stream)
 
 		/* 3. wireless assoclists (band + wifi + online) */
 		rdev_scan_wl(dev, &n, mlo_on);
-		/* online-but-not-wifi => wired */
+		/* bridge FDB is authoritative for wired/wireless + band (assoclist omits
+		 * some EHT/6GHz/pseudo-MLO stations, which used to read as "Wired"). */
+		rdev_scan_fdb(dev, &n);
+		/* last resort: an online device the FDB never placed and no radio saw */
 		for (i = 0; i < n; i++)
-			if (dev[i].online && !dev[i].wifi) dev[i].wired = 1;
+			if (dev[i].online && !dev[i].wifi && !dev[i].wired) dev[i].wired = 1;
 
 		/* 4. dhcp_staticlist reservations: <MAC>IP>DNS>HOST */
 		buf = strdup(nvram_safe_get("dhcp_staticlist"));
-- 
2.25.1

