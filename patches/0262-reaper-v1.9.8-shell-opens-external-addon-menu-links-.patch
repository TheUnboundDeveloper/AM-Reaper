+/* reaper v1.9.8 (change auditing): one structured syslog line whenever a Reaper
+ * feature setting is changed through its CGI, so on/off/config changes appear
+ * in the System Log (hence remote syslog + the syslog storage dataset). Kept
+ * OUTSIDE the MCP ifdef so the always-present GK/WiFi/Devices CGIs can call it
+ * in both build variants; read-only actions never call it. */
+static void reaper_audit(const char *feat, const char *act, const char *detail)
+{
+	logmessage("reaper-audit", "%s %s%s%s",
+		feat ? feat : "-", act ? act : "-",
+		(detail && detail[0]) ? " " : "", (detail && detail[0]) ? detail : "");
+}
+
 static void
 do_reaper_wifi_cgi(char *url, FILE *stream)
 {
@@ -22412,6 +22424,7 @@ do_reaper_wifi_cgi(char *url, FILE *stream)
 			nvram_commit();
 			notify_rc("stop_rchqd");
 		}
+		reaper_audit("wireless", "channel-monitor", nvram_get_int("rchq_enable") ? "on" : "off");
 		websWrite(stream, "{\"ok\":1,\"chq_on\":%d}", nvram_get_int("rchq_enable"));
 		return;
 	}
@@ -22822,6 +22835,7 @@ do_reaper_gk_cgi(char *url, FILE *stream)
 		gk_rl_update(umac, state, expiry);
 		nvram_commit();
 		notify_rc("restart_gk");
+		reaper_audit("gatekeeper", "set-access", umac);
 		websWrite(stream, "{\"ok\":1}");
 		return;
 	}
@@ -22837,6 +22851,7 @@ do_reaper_gk_cgi(char *url, FILE *stream)
 		for (i = 0; i < 17; i++) umac[i] = toupper((unsigned char)mac[i]);
 		umac[17] = 0;
 		gk_rl_update(umac, -1, 0);
+		reaper_audit("gatekeeper", "remove-device", umac);
 		nvram_commit();
 		notify_rc("restart_gk");
 		websWrite(stream, "{\"ok\":1}");
@@ -22867,6 +22882,7 @@ do_reaper_gk_cgi(char *url, FILE *stream)
 				nvram_set("gk_guest_hours", hb);
 			}
 		}
+		reaper_audit("gatekeeper", "config", nvram_match("gk_enable", "1") ? "enabled" : "disabled");
 		nvram_commit();
 		notify_rc("restart_gk");
 		websWrite(stream, "{\"ok\":1}");
@@ -22905,9 +22921,10 @@ do_reaper_warden_cgi(char *url, FILE *stream)
 	if (!got)
 		websWrite(stream,
 			"{\"enable\":%d,\"armed\":0,\"v6\":0,\"lastupd\":%d,"
-			"\"threat_n\":0,\"geo_n\":0,\"blocked\":{\"total\":0,\"top\":[]}}",
+			"\"threat_n\":0,\"geo_n\":0,\"blocked\":{\"total\":0,\"top\":[]},\"jffs\":%d}",
 			nvram_match("rwarden_enable", "1") ? 1 : 0,
-			nvram_get_int("rwarden_lastupd"));
+			nvram_get_int("rwarden_lastupd"),
+			check_if_dir_writable("/jffs") ? 1 : 0);
 }
 
 /* ===================================================================
@@ -23241,6 +23258,7 @@ static void rdev_audit(const char *act, const char *mac, const char *detail)
 	FILE *f;
 	struct stat st;
 
+	reaper_audit("devices", act, (mac && mac[0] && mac[0] != '-') ? mac : detail);
 	if (!rdev_ds_on("dev")) return;
 	loc = rdev_store_base(base, sizeof(base));
 	if (!strcmp(loc, "ram")) return;	/* volatile default: nothing durable to write */
