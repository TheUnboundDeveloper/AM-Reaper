+++ b/release/src/router/httpd/web.c
@@ -21767,7 +21767,11 @@ do_reaper_traffic_cgi(char *url, FILE *stream)
 #define RWIFI_SRUN	RWIFI_DIR "/scanrun"	/* auto-scan run token; unlink = abort */
 #define RWIFI_SHB	RWIFI_DIR "/scanhb"	/* auto-scan heartbeat; browser poll refreshes it */
 #define RWIFI_CHQ	"/tmp/reaper_chq/live.json"	/* rchqd passive monitor snapshot */
-#define RWIFI_SCAN_HB	12	/* abort the sweep if the browser stops polling for this long (s) */
+#define RWIFI_SCAN_HB	60	/* abort the sweep if the browser stops polling for this long (s).
+				   Generous on purpose: scanning the band the admin is ON drops the
+				   browser ~20s per candidate (each restart_wireless) - a short window
+				   would self-abort after one channel. The sweep is bounded and self-
+				   restores, so a longer wait for a genuinely-closed tab is harmless. */
 #define RWIFI_MAXUNIT	3	/* quad-band ceiling; absent units have no wlN_ifname and are skipped */
 #define RWIFI_SCAN_MAX		12	/* max candidate channels a sweep will visit (6 GHz ~6 blocks, 5 GHz 9 non-DFS) */
 #define RWIFI_SCAN_DWELL	5	/* chanim samples averaged per candidate (s) */
