+  <div class="note"><b>Apply</b> writes every changed value and issues one <code>restart_wireless</code> &mdash;
+  all three radios cycle together (~10&nbsp;s). Only changed fields are written; everything you don't touch is left as-is.
+  <#RWFP_12#></div>
+</div>
+
+<form id="applyform" method="post" action="/start_apply.htm" target="hidden_frame" style="display:none">
+  <input type="hidden" name="current_page" value="Reaper_WiFiPro.asp">
+  <input type="hidden" name="next_page" value="Reaper_WiFiPro.asp">
+  <input type="hidden" name="action_mode" value="apply">
+  <input type="hidden" name="action_script" value="restart_wireless">
+  <input type="hidden" name="action_wait" value="10">
+</form>
+<iframe name="hidden_frame" id="hidden_frame" width="0" height="0" frameborder="0" style="display:none"></iframe>
+
+<div class="overlay" id="overlay"><div class="ovcard"><div class="spin"></div><div class="ovmsg"><#RWFP_11#></div></div></div>
+
+<script>
+(function(){
+  "use strict";
+  var chgN=document.getElementById("chgN"), btn=document.getElementById("applyAll");
+  function isTog(el){ return el.classList.contains("tog"); }
+  function getVal(el){ return isTog(el) ? (el.classList.contains("on")?"1":"0") : String(el.value); }
+  // init each control from its data-nv, remember the baseline
+  document.querySelectorAll("[data-name]").forEach(function(el){
+    var v=el.getAttribute("data-nv"); if(v==null) v="";
+    if(isTog(el)){ if(v==="1"){el.classList.add("on");} el.setAttribute("aria-checked",v==="1"?"true":"false"); el._base=(v==="1")?"1":"0"; }
+    else { if(v!=="") el.value=v; el._base=String(el.value); }
+  });
+  function recount(){
+    var n=0;
+    document.querySelectorAll("[data-name]").forEach(function(el){
+      var c=el.closest(".cell"), d=getVal(el)!==el._base;
+      if(c) c.classList.toggle("dirty",d); if(d) n++;
+    });
+    chgN.textContent=n; btn.disabled=n===0; return n;
+  }
+  document.addEventListener("change",function(e){ if(e.target.closest("[data-name]")) recount(); });
+  document.addEventListener("input",function(e){ if(e.target.classList.contains("num")) recount(); });
+  document.querySelectorAll(".tog").forEach(function(t){
+    t.addEventListener("click",function(){ var on=t.classList.toggle("on"); t.setAttribute("aria-checked",on?"true":"false"); recount(); });
+  });
+  // label cells for the mobile stacked view
+  var names=["2.4 GHz","5 GHz","6 GHz"];
+  document.querySelectorAll(".row .cell").forEach(function(c,i){ c.setAttribute("data-band",names[i%3]); });
+
+  btn.addEventListener("click",function(){
+    // range-validate dirty numbers
+    var bad=null;
+    document.querySelectorAll(".num").forEach(function(el){
+      if(getVal(el)===el._base) return;
+      var v=parseInt(el.value,10), lo=+el.getAttribute("data-min"), hi=+el.getAttribute("data-max");
+      if(isNaN(v)||v<lo||v>hi){ bad=bad||el; }
+    });
+    if(bad){ bad.focus(); bad.closest(".cell").classList.add("dirty");
+      alert("A value is out of range: "+bad.getAttribute("data-name")+" ("+bad.getAttribute("data-min")+" to "+bad.getAttribute("data-max")+")."); return; }
+    var f=document.getElementById("applyform");
+    Array.prototype.slice.call(f.querySelectorAll(".dyn")).forEach(function(n){ n.remove(); });
+    var n=0;
+    document.querySelectorAll("[data-name]").forEach(function(el){
+      var v=getVal(el); if(v===el._base) return;
+      var i=document.createElement("input"); i.type="hidden"; i.className="dyn";
+      i.name=el.getAttribute("data-name"); i.value=v; f.appendChild(i); n++;
+    });
+    if(n===0) return;
+    document.getElementById("overlay").classList.add("show");
+    f.submit();
+    setTimeout(function(){ try{ location.reload(); }catch(e){} },13000);
+  });
+  recount();
+})();
+</script>
+</body>
+</html>
