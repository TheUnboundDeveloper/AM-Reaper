@@ -21861,6 +21861,48 @@ static int rwifi_sample(const char *ifname, int sec, FILE *csv)
 	return got;
 }
 
+/* A run/scan token is "live" only while the worker PID it names is still
+ * running. A token whose worker died (a crash, or a mid-sweep wireless restart
+ * that took the process with it) is stale: reclaim it instead of wedging every
+ * scan and capture for the full timeout. First field of the token = worker PID;
+ * "0" means "reserved, worker not started yet" - fall back to mtime age for that
+ * brief window. Unlinks a confirmed-dead token as a side effect. */
+static int rwifi_token_live(const char *path, int maxage)
+{
+	struct stat st;
+	FILE *f;
+	int pid = 0;
+
+	if (stat(path, &st) != 0)
+		return 0;
+	if ((f = fopen(path, "r")) != NULL) {
+		if (fscanf(f, "%d", &pid) != 1)
+			pid = 0;
+		fclose(f);
+	}
+	if (pid > 0) {
+		if (kill(pid, 0) == 0 || errno == EPERM)
+			return 1;			/* worker still running */
+		unlink(path);				/* ESRCH: worker gone - reclaim */
+		return 0;
+	}
+	if (time(NULL) - st.st_mtime < maxage)
+		return 1;				/* reserved slot, worker still starting */
+	unlink(path);					/* placeholder went stale - reclaim */
+	return 0;
+}
+
+/* the owning worker stamps its own PID as the token's first field, so a later
+ * scan/capture can tell a live job from a stale leftover via rwifi_token_live */
+static void rwifi_token_own(const char *path, const char *tag)
+{
+	FILE *f = fopen(path, "w");
+	if (f != NULL) {
+		fprintf(f, "%d %s\n", (int)getpid(), tag ? tag : "");
+		fclose(f);
+	}
+}
+
 static void rwifi_worker(int unit, int secs)
 {
 	char ifname[32];
@@ -21868,10 +21910,15 @@ static void rwifi_worker(int unit, int secs)
 	FILE *csv;
 	int t;
 
-	if (!rwifi_ifname(unit, ifname, sizeof(ifname)))
+	if (!rwifi_ifname(unit, ifname, sizeof(ifname))) {
+		unlink(RWIFI_RUN);		/* never strand the token on an early bail */
 		_exit(0);
-	if ((csv = fopen(RWIFI_CSV, "w")) == NULL)
+	}
+	if ((csv = fopen(RWIFI_CSV, "w")) == NULL) {
+		unlink(RWIFI_RUN);
 		_exit(0);
+	}
+	rwifi_token_own(RWIFI_RUN, "cap");	/* claim the reserved token with our PID */
 	fprintf(csv, "sec,chspec,tx,inbss,obss,nocat,nopkt,doze,txop,goodtx,badtx,glitch,badplcp,knoise,idle,busy\n");
 	fflush(csv);
 	for (t = 0; t < secs; t++) {
@@ -22115,6 +22162,7 @@ static void rwifi_scan_worker(int unit)
 		unlink(RWIFI_SHB);
 		_exit(0);
 	}
+	rwifi_token_own(RWIFI_SRUN, "scan");	/* claim the reserved token with our PID */
 
 	snprintf(nvk, sizeof(nvk), "wl%d_chanspec", unit);
 	snprintf(orig_cs, sizeof(orig_cs), "%s", nvram_safe_get(nvk));
@@ -22224,8 +22272,8 @@ do_reaper_wifi_cgi(char *url, FILE *stream)
 		websWrite(stream, "{\"territory\":");
 		rwifi_json_str(stream, nvram_safe_get("territory_code"));
 		websWrite(stream, ",\"psc6g\":\"%d\",\"cap\":%d,\"scan\":%d,\"chq_on\":%d,\"bands\":[",
-			nvram_get_int("psc6g"), stat(RWIFI_RUN, &st) == 0 ? 1 : 0,
-			stat(RWIFI_SRUN, &st) == 0 ? 1 : 0, nvram_get_int("rchq_enable"));
+			nvram_get_int("psc6g"), rwifi_token_live(RWIFI_RUN, 400) ? 1 : 0,
+			rwifi_token_live(RWIFI_SRUN, 600) ? 1 : 0, nvram_get_int("rchq_enable"));
 		first = 1;
 		for (unit = 0; unit <= RWIFI_MAXUNIT; unit++) {
 			if (!rwifi_ifname(unit, ifname, sizeof(ifname)))
@@ -22277,13 +22325,13 @@ do_reaper_wifi_cgi(char *url, FILE *stream)
 		mkdir(RWIFI_DIR, 0700);
 		/* a live token younger than the longest duration means a worker is
 		 * still sampling; a stale one is leftover from a crash - reclaim it */
-		if (stat(RWIFI_RUN, &st) == 0 && time(NULL) - st.st_mtime < 400) {
+		if (rwifi_token_live(RWIFI_RUN, 400)) {
 			websWrite(stream, "{\"err\":\"busy\"}");
 			return;
 		}
 		unlink(RWIFI_RUN);
 		if ((f = fopen(RWIFI_RUN, "w")) != NULL) {
-			fprintf(f, "%d %d\n", unit, secs);
+			fprintf(f, "0 %d %d\n", unit, secs);	/* PID 0 = reserved; worker stamps its own */
 			fclose(f);
 		}
 		pid = fork();
@@ -22338,15 +22386,19 @@ do_reaper_wifi_cgi(char *url, FILE *stream)
 			return;
 		}
 		mkdir(RWIFI_DIR, 0700);
-		/* refuse if a capture or another scan is still live */
-		if ((stat(RWIFI_RUN, &st) == 0 && time(NULL) - st.st_mtime < 400) ||
-		    (stat(RWIFI_SRUN, &st) == 0 && time(NULL) - st.st_mtime < 600)) {
+		/* refuse if a capture or another scan is still live - distinct errors
+		 * so the page can name the real blocker instead of always "capture" */
+		if (rwifi_token_live(RWIFI_RUN, 400)) {
+			websWrite(stream, "{\"err\":\"busycap\"}");
+			return;
+		}
+		if (rwifi_token_live(RWIFI_SRUN, 600)) {
 			websWrite(stream, "{\"err\":\"busy\"}");
 			return;
 		}
 		unlink(RWIFI_SRUN);
 		if ((f = fopen(RWIFI_SRUN, "w")) != NULL) {
-			fprintf(f, "%d\n", unit);
+			fprintf(f, "0 %d\n", unit);	/* PID 0 = reserved; worker stamps its own */
 			fclose(f);
 		}
 		if ((f = fopen(RWIFI_SHB, "w")) != NULL) {	/* seed the browser heartbeat */
