From f1e483464cffa5697d5adc1a7c61b9e0117f2cc8 Mon Sep 17 00:00:00 2001
From: reaper <theunbounddeveloper@outlook.com>
Date: Fri, 31 Jul 2026 15:29:02 -0400
Subject: [PATCH] reaper v1.9.9d: all-bands Professional - left-justify layout
 (fill width, cap label column)

Metal feedback (v1.9.9c): the page rendered centered (max-width 1160 + margin:0
auto) with a wide empty left margin in the shell frame. Now left-justified and
full-width like the other reaper-native pages (max-width 1800, margin:0, 26px
pad); label column capped at 420px so values stay close to their labels. No
functional change - CSS only.

Co-Authored-By: Claude Opus 4.8 (1M context) <noreply@anthropic.com>
---
 release/src-rt/version.conf               | 2 +-
 release/src/router/www/Reaper_WiFiPro.asp | 8 ++++----
 2 files changed, 5 insertions(+), 5 deletions(-)

diff --git a/release/src-rt/version.conf b/release/src-rt/version.conf
index a370ca7ea7..1eebefa0ff 100644
--- a/release/src-rt/version.conf
+++ b/release/src-rt/version.conf
@@ -4,6 +4,6 @@ KERNEL_VER_AM=$(subst .,,$(KERNEL_VER))
 FS_VER_AM=$(subst .,,$(FS_VER))
 
 SERIALNO=102.8
-EXTENDNO=Reaper_v1.9.9c
+EXTENDNO=Reaper_v1.9.9d
 
 RCNO=0
diff --git a/release/src/router/www/Reaper_WiFiPro.asp b/release/src/router/www/Reaper_WiFiPro.asp
index 5b1d238f5c..db99ea8913 100644
--- a/release/src/router/www/Reaper_WiFiPro.asp
+++ b/release/src/router/www/Reaper_WiFiPro.asp
@@ -20,10 +20,10 @@ body{font-family:var(--body);color:var(--bone-dim);background:var(--bg);
  -webkit-font-smoothing:antialiased;font-size:14px;line-height:1.5}
 h1,h2{font-family:var(--hdr);color:var(--bone);margin:0;letter-spacing:.04em}
 code{font-family:ui-monospace,Consolas,monospace}
-.wrap{max-width:1160px;margin:0 auto;padding:0 20px 90px}
+.wrap{max-width:1800px;margin:0;padding:0 26px 90px}
 .stickytop{position:sticky;top:0;z-index:30;background:linear-gradient(180deg,#0a0a0c 70%,rgba(10,10,12,.92));
  backdrop-filter:blur(6px);border-bottom:1px solid var(--line2)}
-.stickytop .inner{max-width:1160px;margin:0 auto;padding:0 20px}
+.stickytop .inner{max-width:1800px;margin:0;padding:0 26px}
 .appbar{display:flex;align-items:center;gap:18px;padding:16px 0 12px}
 .eyebrow{font-family:var(--hdr);text-transform:uppercase;letter-spacing:.24em;font-size:10.5px;color:var(--steel)}
 .appbar h1{font-size:22px;font-weight:700;line-height:1.05}
@@ -39,7 +39,7 @@ code{font-family:ui-monospace,Consolas,monospace}
 .applybtn:hover{filter:brightness(1.08)}.applybtn:active{transform:translateY(1px)}
 .applybtn:disabled{opacity:.4;cursor:default;box-shadow:none;filter:none}
 .applybtn:focus-visible{outline:2px solid var(--bone);outline-offset:2px}
-.gridrow{display:grid;grid-template-columns:minmax(258px,1.6fr) repeat(3,minmax(132px,1fr));gap:0 14px;align-items:center}
+.gridrow{display:grid;grid-template-columns:minmax(240px,420px) repeat(3,minmax(132px,1fr));gap:0 14px;align-items:center}
 .bandhead{padding:2px 0 12px}
 .bh{display:flex;align-items:center;gap:9px;padding:8px 12px;border:1px solid var(--line);border-radius:10px;background:var(--panel)}
 .bh-dot{width:9px;height:9px;border-radius:50%;flex:0 0 auto}
@@ -52,7 +52,7 @@ code{font-family:ui-monospace,Consolas,monospace}
  color:var(--bone);padding-bottom:9px;margin-bottom:6px;border-bottom:1px solid var(--line2);position:relative}
 .sec-h::after{content:"";position:absolute;left:0;bottom:-1px;width:46px;height:2px;background:var(--red)}
 .matrix{background:var(--panel);border:1px solid var(--line);border-radius:12px;overflow:hidden}
-.row{display:grid;grid-template-columns:minmax(258px,1.6fr) repeat(3,minmax(132px,1fr));gap:0 14px;
+.row{display:grid;grid-template-columns:minmax(240px,420px) repeat(3,minmax(132px,1fr));gap:0 14px;
  align-items:center;padding:11px 16px;border-bottom:1px solid var(--line)}
 .row:last-child{border-bottom:none}.row:hover{background:var(--panel2)}
 .rowlabel{min-width:0;padding-right:8px}
-- 
2.25.1

