From e6c4ab007e4f888642b92385a9c6568459ef180c Mon Sep 17 00:00:00 2001
From: reaper <theunbounddeveloper@outlook.com>
Date: Sat, 1 Aug 2026 08:17:41 -0400
Subject: [PATCH] reaper v2.0.1: remove ASUS AWSIOT phone-home +
 ACCOUNT_BINDING cloud surface

De-cloud pass (backlog "AWSIOT phone-home -- removal plan", analyzed 2026-07-30,
verified LINK-SAFE: nothing DT_NEEDs libawsiot_ipc.so; RP- models already build
with both flags off, so the drop is compile-safe by construction).

release/src-rt/Makefile (RouterOptions config-gen): the generator force-re-added
RTCONFIG_AWSIOT=y and RTCONFIG_ACCOUNT_BINDING=y on top of config_base's
"is not set" defaults. Neutralized all five echo-=y sites (AWSIOT at the
AWSIOT-guarded block and the non-RP block; ACCOUNT_BINDING at its guarded block,
the non-RP block, and the RPAX else-branch) so the generated config_rt-be96u now
carries "# ... is not set" for both. With the flags off:
  - obj-$(RTCONFIG_AWSIOT) += aws-iot drops the awsiot build+install (no
    /usr/sbin/awsiot, no /usr/lib/libawsiot_ipc.so staged),
  - #ifdef RTCONFIG_AWSIOT compiles out start_awsiot()/awsiot_check() +
    watchdog respawn, so the boot-start and killall-resurrection both go away,
  - #ifdef RTCONFIG_ACCOUNT_BINDING drops the ASUS-account binding surface
    (add_rc_support("account_binding") gated out; no cloud transport remains).
Loses only ASUS-cloud remote/app + account-binding features; AiMesh and all
LAN-side function are unaffected (RP nodes prove out the off state).

Shared behnd Makefile => applies fleet-wide to all 5 BCM4916 models on their
respective branches when ported.

version.conf: EXTENDNO Reaper_v2.0.0 -> Reaper_v2.0.1 (2.0.0 already shipped +
metal-validated; this de-cloud image gets a distinct version).

Co-Authored-By: Claude Opus 4.8 <noreply@anthropic.com>
---
 release/src-rt/Makefile     | 10 +++++-----
 release/src-rt/version.conf |  2 +-
 2 files changed, 6 insertions(+), 6 deletions(-)

diff --git a/release/src-rt/Makefile b/release/src-rt/Makefile
index d12f591575..536a79f995 100644
--- a/release/src-rt/Makefile
+++ b/release/src-rt/Makefile
@@ -1569,7 +1569,7 @@ define RouterOptions
 	fi; \
 	if [ "$(AWSIOT)" = "y" ]; then \
 		sed -i "/RTCONFIG_AWSIOT/d" $(1); \
-		echo "RTCONFIG_AWSIOT=y" >>$(1); \
+		echo "# RTCONFIG_AWSIOT is not set" >>$(1); \
 	fi;
 	if [ "$(REALTEK)" = "y" ]; then \
 		sed -i "/RTCONFIG_REALTEK/d" $(1); \
@@ -2155,7 +2155,7 @@ define RouterOptions
 	fi;
 	if [ "$(ACCOUNT_BINDING)" = "y" ]; then \
 		sed -i "/RTCONFIG_ACCOUNT_BINDING/d" $(1); \
-		echo "RTCONFIG_ACCOUNT_BINDING=y" >>$(1); \
+		echo "# RTCONFIG_ACCOUNT_BINDING is not set" >>$(1); \
 	fi;
 	if [ "$(NEWSITE_PROVISIONING)" = "y" ]; then \
 		sed -i "/RTCONFIG_NEWSITE_PROVISIONING/d" $(1); \
@@ -4191,9 +4191,9 @@ define RouterOptions
 		echo "RTCONFIG_AMAS_SYNC_2G_BW=y" >>$(1); \
 		if [ "$(findstring RP-, $(BUILD_NAME))" != "RP-" ]; then \
 			sed -i "/RTCONFIG_ACCOUNT_BINDING/d" $(1); \
-			echo "RTCONFIG_ACCOUNT_BINDING=y" >>$(1); \
+			echo "# RTCONFIG_ACCOUNT_BINDING is not set" >>$(1); \
 			sed -i "/RTCONFIG_AWSIOT/d" $(1); \
-			echo "RTCONFIG_AWSIOT=y" >>$(1); \
+			echo "# RTCONFIG_AWSIOT is not set" >>$(1); \
 		fi; \
 		sed -i "/RTCONFIG_NOTIFICATION_CENTER/d" $(1); \
 		echo "RTCONFIG_NOTIFICATION_CENTER=y" >>$(1); \
@@ -4231,7 +4231,7 @@ define RouterOptions
 		if [ "$(RPAX56)" = "y" ] || [ "$(RPAX58)" = "y" ] || [ "$(RPBE58)" = "y" ]; then \
 			echo "# RTCONFIG_ACCOUNT_BINDING is not set" >>$(1); \
 		else \
-			echo "RTCONFIG_ACCOUNT_BINDING=y" >>$(1); \
+			echo "# RTCONFIG_ACCOUNT_BINDING is not set" >>$(1); \
 		fi; \
 		sed -i "/RTCONFIG_PREFERAP_RE_SELFOPT/d" $(1); \
 		echo "RTCONFIG_PREFERAP_RE_SELFOPT=y" >>$(1); \
diff --git a/release/src-rt/version.conf b/release/src-rt/version.conf
index 16a1fd77e0..6e4696c66f 100644
--- a/release/src-rt/version.conf
+++ b/release/src-rt/version.conf
@@ -4,6 +4,6 @@ KERNEL_VER_AM=$(subst .,,$(KERNEL_VER))
 FS_VER_AM=$(subst .,,$(FS_VER))
 
 SERIALNO=102.8
-EXTENDNO=Reaper_v2.0.0
+EXTENDNO=Reaper_v2.0.1
 
 RCNO=0
-- 
2.25.1

