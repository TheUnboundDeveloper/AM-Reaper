diff --git a/release/src/router/mssl/mssl.c b/release/src/router/mssl/mssl.c
index b4e3ea14d1..d19167e790 100644
--- a/release/src/router/mssl/mssl.c
+++ b/release/src/router/mssl/mssl.c
@@ -245,6 +245,8 @@ typedef struct {
 } mssl_cookie_t;
 
 static SSL_CTX* ctx;
+static int mssl_ca_loaded = 0;	/* set when CA bundle is loaded (enables client verify) */
+#define MSSL_CA_BUNDLE "/rom/etc/ssl/certs/ca-certificates.crt"
 
 static inline void mssl_print_err(SSL* ssl)
 {
@@ -381,16 +383,34 @@ static FILE *_ssl_fopen(int sd, int client, const char *name)
 	SSL_set_mode(kuki->ssl, SSL_MODE_AUTO_RETRY);
 
 	if (client) {
-		// Setup SNI
+		/* Fail CLOSED: without a CA bundle we cannot verify the peer, so refuse
+		 * rather than silently accept any certificate (on-path MITM). */
+		if (!mssl_ca_loaded) {
+			syslog(LOG_WARNING, "%s: CA bundle unavailable, refusing client TLS", __FUNCTION__);
+			goto ERROR;
+		}
+		/* Verify the server certificate chain (CLIENT path only; the server
+		 * path keeps the SSL_VERIFY_NONE baseline set above). */
+		SSL_set_verify(kuki->ssl, SSL_VERIFY_PEER, NULL);
+
+		// Setup SNI + hostname verification
 #if OPENSSL_VERSION_NUMBER >= 0x0090806fL && !defined(OPENSSL_NO_TLSEXT)
 		if (name && *name) {
 			struct addrinfo *res, hint = { .ai_flags = AI_NUMERICHOST };
 			if (getaddrinfo(name, NULL, &hint, &res) == 0)
-				freeaddrinfo(res);
-			else if (SSL_set_tlsext_host_name(kuki->ssl, name) != 1) {
-				_dprintf("%s: SSL_set_tlsext_host_name failed\n", __FUNCTION__);
-				mssl_print_err(kuki->ssl);
-				goto ERROR;
+				freeaddrinfo(res);	/* numeric IP: no SNI; chain still verified */
+			else {
+				if (SSL_set_tlsext_host_name(kuki->ssl, name) != 1) {
+					_dprintf("%s: SSL_set_tlsext_host_name failed\n", __FUNCTION__);
+					mssl_print_err(kuki->ssl);
+					goto ERROR;
+				}
+				/* Enforce hostname match against the presented certificate. */
+#if OPENSSL_VERSION_NUMBER >= 0x10100000L
+				SSL_set1_host(kuki->ssl, name);
+#elif OPENSSL_VERSION_NUMBER >= 0x10002000L
+				X509_VERIFY_PARAM_set1_host(SSL_get0_param(kuki->ssl), name, 0);
+#endif
 			}
 		}
 #endif
@@ -566,6 +586,13 @@ int mssl_init_ex(char *cert, char *priv, char *ciphers)
 
 	SSL_CTX_set_verify(ctx, SSL_VERIFY_NONE, NULL);
 
+	/* Load the system CA bundle so the CLIENT path (see _ssl_fopen) can verify
+	 * peers. A missing bundle is NOT fatal here -- the server must still start --
+	 * but it is recorded so the client path fails closed. */
+	mssl_ca_loaded = (SSL_CTX_load_verify_locations(ctx, MSSL_CA_BUNDLE, NULL) == 1);
+	if (!mssl_ca_loaded)
+		syslog(LOG_WARNING, "mssl: could not load CA bundle %s; client TLS verification unavailable", MSSL_CA_BUNDLE);
+
 	_dprintf("%s() success\n", __FUNCTION__);
 	return 1;
 }
