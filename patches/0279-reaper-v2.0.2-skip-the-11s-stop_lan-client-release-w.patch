From d65e6ad15b0b2d0e020d8f231f32b5bf4f77a56e Mon Sep 17 00:00:00 2001
From: reaper <theunbounddeveloper@outlook.com>
Date: Sat, 1 Aug 2026 15:21:02 -0400
Subject: [PATCH] reaper v2.0.2: skip the 11s stop_lan client-release wait on
 upgrade reboots too

The BE_4916 stop_lan phy-power-cycle + 10s client-release wait already had a
Reaper skip for g_reboot, but firmware-upgrade reboots set g_upgrade (not
g_reboot), so every flash still paid the full ~11s of dead time (confirmed in a
metal boot log: "phy-power cycle + client-release wait: done (11 s)" on an
rc_upg_fw reboot). The wait only nudges live LAN clients to renew during a LAN
restart; it is pointless when the box is about to reboot into new firmware.

- rc.h: declare extern int g_upgrade (defined in services.c) so lan.c sees it.
- lan.c: gate the skip on (g_reboot or g_upgrade); update comment + log string.

Co-Authored-By: Claude Opus 4.8 <noreply@anthropic.com>
---
 release/src/router/rc/lan.c | 6 +++---
 release/src/router/rc/rc.h  | 1 +
 2 files changed, 4 insertions(+), 3 deletions(-)

diff --git a/release/src/router/rc/lan.c b/release/src/router/rc/lan.c
index c0794d7a5b..cbb2c25fcc 100644
--- a/release/src/router/rc/lan.c
+++ b/release/src/router/rc/lan.c
@@ -2904,12 +2904,12 @@ void stop_lan(void)
 
 #if defined(RTCONFIG_HND_ROUTER_BE_4916)
 	/* reaper: skip the phy-power cycle + fixed 10s client-release wait on
-	 * reboot/halt - it only nudges live LAN clients into renewing during a
+	 * reboot/halt/upgrade - it only nudges live LAN clients into renewing during a
 	 * `restart lan`, and is pure dead time when the box is power-cycling.
 	 * Mirrors the existing !g_reboot gates on stop_wan()/stop_usb(). Both
 	 * branches log to syslog so the cost is visible on the next boot. */
-	if (g_reboot) {
-		logmessage("stop_lan", "reboot: skipped phy-power cycle + 10s client-release wait");
+	if (g_reboot || g_upgrade) {
+		logmessage("stop_lan", "reboot/upgrade: skipped phy-power cycle + 10s client-release wait");
 	} else {
 	phy_port_mapping port_mapping;
 	int eth_if_idx, i;
diff --git a/release/src/router/rc/rc.h b/release/src/router/rc/rc.h
index c229b99f67..8c18a02eda 100644
--- a/release/src/router/rc/rc.h
+++ b/release/src/router/rc/rc.h
@@ -244,6 +244,7 @@ extern char wan6face[];
 #define HAVE_DHCP6 0x2
 
 extern int g_reboot;
+extern int g_upgrade;	/* reaper: firmware-upgrade reboot flag (defined in services.c) */
 extern int wan_phyid;
 #if defined(RTCONFIG_JFFS2) || defined(RTCONFIG_JFFSV1) || defined(RTCONFIG_BRCM_NAND_JFFS2)
 extern int jffs2_fail;
-- 
