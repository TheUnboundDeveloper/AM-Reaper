 	websWrite(stream, "}");
 }
 
+/* reaper v2.0.5: Hardware QoS Diagnostics feed for Reaper_QoSDiag.asp. Read-only;
+ * no request input is parsed - the bdmf-shell command is a fixed literal
+ * (injection-safe, same model as do_reaper_traffic_cgi). Streams the live
+ * egress_tm scheduler / queue / occupancy dump (parsed client-side) plus the
+ * qos_* config used to label queues. The dump is emitted as an escaped JSON
+ * string under "tm"; occupancy is a live QM counter read (safe to poll). */
+static void
+do_reaper_qdiag_cgi(char *url, FILE *stream)
+{
+	FILE *p;
+	int c;
+
+	websWrite(stream,
+		"{\"qos_enable\":%d,\"qos_type\":%d,\"qos_obw\":\"%s\",\"qos_orates\":\"%s\","
+		"\"qos_sched\":\"%s\",\"qos_default\":\"%s\",\"qos_l4s\":\"%s\"",
+		nvram_get_int("qos_enable"), nvram_get_int("qos_type"),
+		nvram_safe_get("qos_obw"), nvram_safe_get("qos_orates"),
+		nvram_safe_get("qos_sched"), nvram_safe_get("qos_default"),
+		nvram_safe_get("qos_l4s"));
+
+	websWrite(stream, ",\"tm\":\"");
+	if ((p = popen("bs /Bdmf/e egress_tm max_prints:-1 2>/dev/null", "r")) != NULL) {
+		while ((c = fgetc(p)) != EOF) {
+			if (c == '"' || c == '\\') { fputc('\\', stream); fputc(c, stream); }
+			else if (c == '\n') websWrite(stream, "\\n");
+			else if (c == '\r') { /* drop CR */ }
+			else if (c == '\t') websWrite(stream, "\\t");
+			else if (c < 0x20) websWrite(stream, "\\u%04x", c);
+			else fputc(c, stream);
+		}
+		pclose(p);
+	}
+	websWrite(stream, "\"}");
+}
+
