+<body>
+<div class="stickytop"><div class="inner">
+  <div class="appbar">
+    <div>
+      <div class="eyebrow">REAPER &middot; Traffic Manager</div>
+      <h1>Hardware QoS Diagnostics</h1>
+      <div class="sub">Live view of the Runner / XRDP egress traffic manager &mdash; per-queue occupancy, scheduler, drops &amp; estimated delay.</div>
+    </div>
+    <div class="spacer"></div>
+    <div class="live">
+      <div class="hint">Fast polling runs only while this page is open.</div>
+      <div class="rate" id="rate">
+        <button data-ms="250">250 ms</button>
+        <button data-ms="500" class="on">500 ms</button>
+        <button data-ms="4000">4 s</button>
+      </div>
+      <button class="livebtn" id="livebtn"><span class="dot"></span>LIVE</button>
+    </div>
+  </div>
+</div></div>
+
+<div class="wrap">
+  <div class="grid4" id="cards"></div>
+
+  <div class="sec split">
+    <div>
+      <h2 class="sec-h">Scheduler &amp; Queues <span class="tag" id="qtag">rdpa egress_tm</span>
+        <span class="psel" id="pselwrap"></span></h2>
+      <div id="qbody"></div>
+      <h2 class="sec-h" style="margin-top:24px">Scheduler Tree <span class="tag" id="stag"></span></h2>
+      <div class="sched"><div class="sroot" id="sroot"></div></div>
+    </div>
+    <div><div class="detail" id="detail"></div></div>
+  </div>
+
+  <div class="sec">
+    <h2 class="sec-h">Live Trends <span class="tag" id="gtag">window 45 s</span></h2>
+    <div class="split" style="grid-template-columns:1fr 1fr">
+      <div class="gcard"><h3>Per-queue occupancy <b id="occnow">&mdash;</b></h3><canvas id="occcv"></canvas><div class="legend" id="occleg"></div></div>
+      <div class="gcard"><h3>Drops / sec <b id="dropnow">&mdash;</b></h3><canvas id="dropcv"></canvas><div class="legend"><span><i style="background:var(--red)"></i>tail + AQM drops (combined)</span></div></div>
+    </div>
+  </div>
+
+  <div class="note">
+    <b>Estimated Delay</b> is derived (queue backlog &divide; shaper rate) <span class="badge">est</span> &mdash; the hardware TM has no direct latency counter.
+    <b>Occupancy</b> is the live RDPA <code>queue_occupancy</code> read (0 when the link is idle, fills under load); <b>Drops</b> are the combined tail+AQM counter; <b>Size</b>/<b>Shaper</b>/<b>AQM</b> come from the queue config.
+    The view adapts to your QoS mode &mdash; a single shaped queue under Hardware PI2 (type&nbsp;10), the full weighted scheduler under HW Classful (type&nbsp;11).
+  </div>
+</div>
+
+<iframe name="hidden_frame" width="0" height="0" frameborder="0" style="display:none"></iframe>
+<script>
+(function(){
+  "use strict";
+  var ENDPOINT="/reaper_qdiag.cgi";
+  var COLORS=["#4FB286","#7EA6C9","#E0A93B","#E10600","#C77DFF","#5AD1C4","#B7B1A4","#8894a0"];
+  var HIST=45, state={objs:[],selObj:null,selQ:null,qos:{},prev:{},occHist:{},dropHist:[]};
+
+  // ---- parse the bs egress_tm dump (format: [[tm-queue-diag]]) ----
+  function field(s,re){ var m=s.match(re); return m?m[1]:null; }
+  function parseTM(tm){
+    if(!tm) return [];
+    var blocks=tm.split(/(?=Object:\s*egress_tm)/), out=[];
+    blocks.forEach(function(b){
+      if(b.indexOf("egress_tm/index=")<0) return;
+      var idx=field(b,/egress_tm\/index=(\d+)/), port=field(b,/port\/name=(\S+?)[\s.]/)||field(b,/port\/name=(\S+)/);
+      var dir=field(b,/\bdir\s*:\s*(us|ds)/), mode=field(b,/\bmode\s*:\s*(\w+)/), nq=+(field(b,/num_queues\s*:\s*(\d+)/)||0);
+      var q={};
+      var re=/queue_cfg\[(\d+)\]\s*:\s*(\{(?:[^{}]|\{[^{}]*\})*\})/g,m;
+      while((m=re.exec(b))){ var i=+m[1],g=m[2];
+        q[i]=q[i]||{}; q[i].qid=+field(g,/queue_id=(\d+)/); q[i].size=+field(g,/drop_threshold=(\d+)/);
+        q[i].weight=+field(g,/weight=(\d+)/); q[i].aqm=field(g,/drop_alg=(\w+)/);
+        var af=field(g,/rate_limit\/index=\d+\{af=(\d+)/); q[i].af=af?+af:0; }
+      var rs=/queue_stat\[(\d+)\]\s*:\s*(\{(?:[^{}]|\{[^{}]*\})*\})/g;
+      while((m=rs.exec(b))){ var i2=+m[1],g2=m[2]; q[i2]=q[i2]||{};
