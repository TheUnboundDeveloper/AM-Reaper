From 07b120ca350b84ecf52f2b04365398ef53d3f1c1 Mon Sep 17 00:00:00 2001
From: reaper <theunbounddeveloper@outlook.com>
Date: Sat, 1 Aug 2026 20:14:09 -0400
Subject: [PATCH 282/288] reaper v2.0.4: secure factory-reset defaults - WPS
 off by default (wps_enable/wps_enable_x=0) + UPnP master off (upnp_enable=0).
 Audit confirmed all other unneeded features (remote mgmt, SSH/Telnet, WAN
 ping, FTP/DLNA/DDNS, guest net, DPI/AiProtection, LLTD, WebDAV/AiCloud,
 IFTTT/Alexa) already off or compiled out. USB auto-share + roaming assistant
 -70 kept per owner decision.

---
 release/src-rt/version.conf          | 2 +-
 release/src/router/shared/defaults.c | 6 +++---
 2 files changed, 4 insertions(+), 4 deletions(-)

diff --git a/release/src-rt/version.conf b/release/src-rt/version.conf
index d919c1c650..016b47ebaf 100644
--- a/release/src-rt/version.conf
+++ b/release/src-rt/version.conf
@@ -4,6 +4,6 @@ KERNEL_VER_AM=$(subst .,,$(KERNEL_VER))
 FS_VER_AM=$(subst .,,$(FS_VER))
 
 SERIALNO=102.8
-EXTENDNO=Reaper_v2.0.3
+EXTENDNO=Reaper_v2.0.4
 
 RCNO=0
diff --git a/release/src/router/shared/defaults.c b/release/src/router/shared/defaults.c
index a055eee1b7..05bca2c1cd 100644
--- a/release/src/router/shared/defaults.c
+++ b/release/src/router/shared/defaults.c
@@ -1269,8 +1269,8 @@ struct nvram_tuple router_defaults[] = {
 	{ "wps_enable", "0", CKN_STR1, CKN_TYPE_DEFAULT, CKN_ACC_LEVEL_DEFAULT, CKN_ENC_DEFAULT, 0 },
 	{ "wps_enable_x", "0", CKN_STR1, CKN_TYPE_DEFAULT, CKN_ACC_LEVEL_DEFAULT, CKN_ENC_DEFAULT, 0 },
 #else
-	{ "wps_enable", "1", CKN_STR1, CKN_TYPE_DEFAULT, CKN_ACC_LEVEL_DEFAULT, CKN_ENC_DEFAULT, 0 },
-	{ "wps_enable_x", "1", CKN_STR1, CKN_TYPE_DEFAULT, CKN_ACC_LEVEL_DEFAULT, CKN_ENC_DEFAULT, 0 },
+	{ "wps_enable", "0", CKN_STR1, CKN_TYPE_DEFAULT, CKN_ACC_LEVEL_DEFAULT, CKN_ENC_DEFAULT, 0 },
+	{ "wps_enable_x", "0", CKN_STR1, CKN_TYPE_DEFAULT, CKN_ACC_LEVEL_DEFAULT, CKN_ENC_DEFAULT, 0 },
 #endif
 
 #ifdef RTCONFIG_RALINK
@@ -2629,7 +2629,7 @@ struct nvram_tuple router_defaults[] = {
 
 	// For miniupnpd, so far default value only
 #ifndef RTCONFIG_BCM_MFG
-	{ "upnp_enable", "1", CKN_STR1, CKN_TYPE_DEFAULT, CKN_ACC_LEVEL_DEFAULT, CKN_ENC_DEFAULT, 0 },
+	{ "upnp_enable", "0", CKN_STR1, CKN_TYPE_DEFAULT, CKN_ACC_LEVEL_DEFAULT, CKN_ENC_DEFAULT, 0 },
 #else
 	{ "upnp_enable", "0", CKN_STR1, CKN_TYPE_DEFAULT, CKN_ACC_LEVEL_DEFAULT, CKN_ENC_DEFAULT, 0 },
 #endif
-- 
2.25.1

