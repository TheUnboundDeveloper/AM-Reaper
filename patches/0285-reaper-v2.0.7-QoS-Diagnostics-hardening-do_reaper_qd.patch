From 5673c4272a01b7cb79369b77c9b7a6d04e63debb Mon Sep 17 00:00:00 2001
From: reaper <theunbounddeveloper@outlook.com>
Date: Sat, 1 Aug 2026 23:44:36 -0400
Subject: [PATCH 285/288] reaper v2.0.7: QoS Diagnostics hardening -
 do_reaper_qdiag.cgi now invokes bdmf_shell directly with the boot-written
 /var/bdmf_sh_id session id (digit-validated) instead of 'bs', which is only
 an interactive-shell alias and worked solely through an untracked /bin/bs
 wrapper a rebuild can silently drop; page rate/drop deltas are now
 32-bit-wrap-aware (metal-observed byte-counter wrap every ~15s at ~2 Gbps
 caused periodic zero-rate ticks), with counter-reset deltas discarded

Co-Authored-By: Claude Fable 5 <noreply@anthropic.com>
---
 release/src-rt/version.conf               |  2 +-
 release/src/router/httpd/web.c            | 30 +++++++++++++++++------
 release/src/router/www/Reaper_QoSDiag.asp | 11 +++++++--
 3 files changed, 33 insertions(+), 10 deletions(-)
 mode change 100755 => 100644 release/src/router/www/Reaper_QoSDiag.asp

diff --git a/release/src-rt/version.conf b/release/src-rt/version.conf
index a1424b9093..daf29d4d72 100644
--- a/release/src-rt/version.conf
+++ b/release/src-rt/version.conf
@@ -4,6 +4,6 @@ KERNEL_VER_AM=$(subst .,,$(KERNEL_VER))
 FS_VER_AM=$(subst .,,$(FS_VER))
 
 SERIALNO=102.8
-EXTENDNO=Reaper_v2.0.6
+EXTENDNO=Reaper_v2.0.7
 
 RCNO=0
diff --git a/release/src/router/httpd/web.c b/release/src/router/httpd/web.c
index 17d59bae27..f6503aaddb 100644
--- a/release/src/router/httpd/web.c
+++ b/release/src/router/httpd/web.c
@@ -21721,15 +21721,20 @@ do_reaper_qos_stats_cgi(char *url, FILE *stream)
 }
 
 /* reaper v2.0.5: Hardware QoS Diagnostics feed for Reaper_QoSDiag.asp. Read-only;
- * no request input is parsed - the bdmf-shell command is a fixed literal
- * (injection-safe, same model as do_reaper_traffic_cgi). Streams the live
- * egress_tm scheduler / queue / occupancy dump (parsed client-side) plus the
- * qos_* config used to label queues. The dump is emitted as an escaped JSON
- * string under "tm"; occupancy is a live QM counter read (safe to poll). */
+ * no request input is parsed. Streams the live egress_tm scheduler / queue /
+ * occupancy dump (parsed client-side) plus the qos_* config used to label
+ * queues. The dump is emitted as an escaped JSON string under "tm";
+ * occupancy is a live QM counter read (safe to poll).
+ * v2.0.7: invoke bdmf_shell directly with the session id rdpa_init.sh writes
+ * at boot - 'bs' is only an interactive-shell alias, so the previous popen
+ * only worked through an untracked /bin/bs wrapper that a rebuild can drop.
+ * The id is digit-validated before interpolation; the command is otherwise a
+ * fixed literal (injection-safe, same model as do_reaper_traffic_cgi). */
 static void
 do_reaper_qdiag_cgi(char *url, FILE *stream)
 {
-	FILE *p;
+	FILE *p, *f;
+	char sid[16], cmd[128], *e;
 	int c;
 
 	websWrite(stream,
@@ -21740,8 +21745,19 @@ do_reaper_qdiag_cgi(char *url, FILE *stream)
 		nvram_safe_get("qos_sched"), nvram_safe_get("qos_default"),
 		nvram_safe_get("qos_l4s"));
 
+	sid[0] = '\0';
+	if ((f = fopen("/var/bdmf_sh_id", "r")) != NULL) {
+		if (fgets(sid, sizeof(sid), f) == NULL)
+			sid[0] = '\0';
+		fclose(f);
+		for (e = sid; *e >= '0' && *e <= '9'; e++);
+		*e = '\0';
+	}
+	snprintf(cmd, sizeof(cmd),
+		"bdmf_shell -c %s -cmd /Bdmf/e egress_tm max_prints:-1 2>/dev/null", sid);
+
 	websWrite(stream, ",\"tm\":\"");
-	if ((p = popen("bs /Bdmf/e egress_tm max_prints:-1 2>/dev/null", "r")) != NULL) {
+	if (sid[0] != '\0' && (p = popen(cmd, "r")) != NULL) {
 		while ((c = fgetc(p)) != EOF) {
 			if (c == '"' || c == '\\') { fputc('\\', stream); fputc(c, stream); }
 			else if (c == '\n') websWrite(stream, "\\n");
diff --git a/release/src/router/www/Reaper_QoSDiag.asp b/release/src/router/www/Reaper_QoSDiag.asp
old mode 100755
new mode 100644
index 3581155dbb..891413efc5
--- a/release/src/router/www/Reaper_QoSDiag.asp
+++ b/release/src/router/www/Reaper_QoSDiag.asp
@@ -241,8 +241,15 @@ canvas{display:block;width:100%;height:120px}
     var pv=state.prev[key]||{}, dt=(pv.ts?(now-pv.ts):0)/1000;
     o.queues.forEach(function(q){
       var p=pv[q.qid];
-      q.rateBps=(p&&dt>0)?Math.max(0,(q.txb-p.txb)*8/dt):0;
-      q.dropRate=(p&&dt>0)?Math.max(0,(q.dp-p.dp)/dt):0;
+      // v2.0.7: queue_stat counters are 32-bit in HW (metal-observed byte wrap
+      // at ~2 Gbps every ~15 s); un-wrap negative deltas instead of clamping
+      // the whole tick to 0. A QoS restart resets counters to 0, which looks
+      // like a wrap - discard deltas implying > 20 Gbps (2x the 10G port).
+      function d32(a,b){ var d=a-b; return d<0?d+4294967296:d; }
+      q.rateBps=(p&&dt>0)?d32(q.txb,p.txb)*8/dt:0;
+      if(q.rateBps>2e10)q.rateBps=0;
+      q.dropRate=(p&&dt>0)?d32(q.dp,p.dp)/dt:0;
+      if(q.dropRate>1e8)q.dropRate=0;
       var sb=shaperBps(o,q); q.pct=q.size>0?Math.min(100,q.ob/q.size*100):0;
       q.delayMs=sb>0?(q.ob*8/sb*1000):null;
     });
-- 
