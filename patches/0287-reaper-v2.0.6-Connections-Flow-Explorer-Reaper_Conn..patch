+/* reaper v2.0.6: nflist IPs are zero-padded (192.168.050.215); parse the octets
+ * as DECIMAL (%d) and rebuild -- inet_aton would read "050" as octal. */
+static void reaper_ip_strip_zeros(char *ip)
+{
+	int a, b, c, d;
+	if (sscanf(ip, "%d.%d.%d.%d", &a, &b, &c, &d) == 4 &&
+	    !((a | b | c | d) & ~0xff))
+		sprintf(ip, "%d.%d.%d.%d", a, b, c, d);
+}
+
+/* reaper v2.0.6: Connections / Flow Explorer feed for Reaper_Conn.asp. Read-only;
+ * no request input is parsed. Streams every Runner flow-cache entry from
+ * /proc/fcache/nflist as JSON rows (the page groups them by nf_conn and computes
+ * rate/HW%), plus the resident first-seen table (nf_conn -> epoch, written by
+ * rtrafd) and the server clock, so the page can show true connection age.
+ * Column layout verified on metal 2026-08-01 (see [[tm-queue-diag]] sibling). */
+static void
+do_reaper_conn_cgi(char *url, FILE *stream)
+{
+	FILE *f;
+	char line[1024];
+	uint32_t lan_net = 0, lan_mask = 0;
+	struct in_addr ia;
+	int first;
+
+	if (inet_aton(nvram_safe_get("lan_ipaddr"), &ia)) lan_net = ntohl(ia.s_addr);
+	if (inet_aton(nvram_safe_get("lan_netmask"), &ia)) lan_mask = ntohl(ia.s_addr);
+	lan_net &= lan_mask;
+
+	websWrite(stream, "{\"qos_type\":%d,\"now\":%ld,\"seen\":{",
+		nvram_get_int("qos_type"), (long)time(NULL));
+
+	/* resident first-seen table: lines "<nfc-hex> <epoch>" written by rtrafd */
+	first = 1;
+	if ((f = fopen("/tmp/reaper_conn_seen", "r")) != NULL) {
+		char nfc[40]; long ep;
+		while (fgets(line, sizeof(line), f)) {
+			if (sscanf(line, "%39s %ld", nfc, &ep) == 2) {
+				websWrite(stream, "%s\"%s\":%ld", first ? "" : ",", nfc, ep);
+				first = 0;
+			}
+		}
+		fclose(f);
+	}
+	websWrite(stream, "},\"flows\":[");
+
+	first = 1;
+	if ((f = fopen("/proc/fcache/nflist", "r")) != NULL) {
+		while (fgets(line, sizeof(line), f)) {
+			int flowid = 0, prot = 0, sp = 0, dp = 0, iq = 0, dscp;
+			unsigned long long tot = 0, tbytes = 0, swb = 0, hw = 0, sw;
+			char swstr[24], sip[24], dip[24], tos[16] = "00", nfc[40] = "0";
+			char *p, *q, *gt, *m1, *m2, *mg;
+			uint32_t sipn;
+
+			/* leading fixed block: flowid, TotalHits, TotalBytes, SW_TotHits(:),
+			 * SW_TotalBytes, [HW_tpl Fhw_idx HW_Hits] HW_TotHits, [HW_TotalBytes
+			 * L1-Info X] Prot   (verified column offsets) */
+			if (sscanf(line,
+				"%d %*s %*s %*s %*s %*s %llu %llu %23s %llu %*s %*s %*s %llu %*llu %*s %*d %d",
+				&flowid, &tot, &tbytes, swstr, &swb, &hw, &prot) != 7)
+				continue;			/* header / malformed */
+			sw = strtoull(swstr, NULL, 10);		/* strips the trailing ':' */
+
+			if ((p = strchr(line, '<')) == NULL) continue;
+			if (sscanf(p, "<%23[0-9.]:%d>", sip, &sp) != 2) continue;
+			if ((q = strchr(p + 1, '<')) == NULL) continue;
+			if (sscanf(q, "<%23[0-9.]:%d>", dip, &dp) != 2) continue;
+
+			/* after the dst <..>: Vlan0 Vlan1 tag# ToS IqPrio ... */
+			if ((gt = strchr(q, '>')) != NULL)
+				sscanf(gt + 1, " %*s %*s %*s %15s %d", tos, &iq);
+			dscp = (int)(strtol(tos, NULL, 16) >> 2);
+
+			/* MAC SA <..> MAC DA <..> then RxDev TxDev nf_conn[0] */
+			if (gt && (m1 = strchr(gt, '<')) != NULL &&
+			    (m2 = strchr(m1 + 1, '<')) != NULL &&
+			    (mg = strchr(m2, '>')) != NULL)
+				sscanf(mg + 1, " %*s %*s %39s", nfc);
+
+			reaper_ip_strip_zeros(sip); reaper_ip_strip_zeros(dip);
+			sipn = 0; if (inet_aton(sip, &ia)) sipn = ntohl(ia.s_addr);
+
+			websWrite(stream,
+				"%s{\"nfc\":\"%s\",\"lan\":%d,\"sip\":\"%s\",\"sp\":%d,\"dip\":\"%s\",\"dp\":%d,"
+				"\"proto\":%d,\"dscp\":%d,\"q\":%d,\"bytes\":%llu,\"tot\":%llu,\"sw\":%llu,\"hw\":%llu}",
+				first ? "" : ",", nfc, (lan_mask && (sipn & lan_mask) == lan_net) ? 1 : 0,
+				sip, sp, dip, dp, prot, dscp, iq, tbytes, tot, sw, hw);
+			first = 0;
+		}
+		fclose(f);
+	}
+	websWrite(stream, "]}");
+}
