index 812c2c5680..8a62651b3d 100644
--- a/release/src/router/rtrafd/rtrafd.c
+++ b/release/src/router/rtrafd/rtrafd.c
@@ -475,6 +475,46 @@ struct fcf {
 	char mac[20], dev[16];	/* client MAC (upload SA); LAN-side dev */
 };
 
+/* reaper v2.0.6: resident first-seen table for the Connections page (true age).
+ * Keyed by the nf_conn pointer; records when each flow was first observed and
+ * writes /tmp/reaper_conn_seen for do_reaper_conn_cgi. Grace of ~12 polls (60 s)
+ * so a briefly-idle flow (temporarily dropped from the delta list) keeps its
+ * start time instead of resetting. */
+#define CONNSEEN_MAX 2048
+static struct { uint64_t nfc; time_t seen; int miss; } connseen[CONNSEEN_MAX];
+static int connseen_n = 0;
+static void connseen_update(struct fcf *fl, int nfl)
+{
+	int i, j;
+	time_t now = time(NULL);
+	FILE *cf;
+
+	for (i = 0; i < connseen_n; i++) connseen[i].miss++;
+	for (i = 0; i < nfl; i++) {
+		if (!fl[i].nfc) continue;
+		for (j = 0; j < connseen_n; j++)
+			if (connseen[j].nfc == fl[i].nfc) break;
+		if (j == connseen_n) {
+			if (connseen_n >= CONNSEEN_MAX) continue;
+			connseen[connseen_n].nfc = fl[i].nfc;
+			connseen[connseen_n].seen = now;
+			connseen_n++;
+			j = connseen_n - 1;
+		}
+		connseen[j].miss = 0;
+	}
+	for (i = 0; i < connseen_n; ) {
+		if (connseen[i].miss > 12) connseen[i] = connseen[--connseen_n];
+		else i++;
+	}
+	if ((cf = fopen("/tmp/reaper_conn_seen", "w")) != NULL) {
+		for (i = 0; i < connseen_n; i++)
+			fprintf(cf, "%llx %ld\n",
+				(unsigned long long)connseen[i].nfc, (long)connseen[i].seen);
+		fclose(cf);
+	}
+}
+
 static void poll_fcache(void)
 {
 	FILE *f = fopen("/proc/fcache/nflist", "r");
@@ -559,6 +599,8 @@ static void poll_fcache(void)
 	}
 	fclose(f);
 
+	connseen_update(fl, nfl);
