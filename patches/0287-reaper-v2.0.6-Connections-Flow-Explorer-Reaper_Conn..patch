+  <div class="sec split">
+    <div>
+      <h2 class="sec-h">Active Flows <span id="ftag" style="font-family:var(--mono);font-size:10px;letter-spacing:0;text-transform:none;color:var(--steel)"></span>
+        <span class="filters" id="filters">
+          <button data-f="all" class="on">All</button>
+          <button data-f="acc">Accelerated</button>
+          <button data-f="cpu">CPU path</button>
+        </span></h2>
+      <div id="fbody"></div>
+    </div>
+    <div><div class="detail" id="detail"></div></div>
+  </div>
+  <div class="note">
+    <b>Live from the Runner flow cache</b> (<code>/proc/fcache/nflist</code>), grouped by connection. <b>Hardware %/CPU %</b> is a real per-flow split
+    (hardware-forwarded vs slow-path packet counters); <b>Accelerated</b> means the Runner is forwarding it in hardware. <b>Duration</b> is true age (tracked from first-seen).
+    <b>Queue/DSCP</b> reflect the flow's egress mapping &mdash; mostly zero under Hardware PI2 (a single shaped queue), richer under HW Classful. Rate is measured between polls.
+  </div>
+</div>
+
+<script>
+(function(){
+  "use strict";
+  var ENDPOINT="/reaper_conn.cgi";
+  var state={conns:[],sel:null,prev:{},qos:0};
+  var filter="all", currentMs=1000, live=true, timer=null;
+
+  function fmtBytes(b){ if(b>=1e12)return(b/1e12).toFixed(1)+" TB"; if(b>=1e9)return(b/1e9).toFixed(1)+" GB"; if(b>=1e6)return(b/1e6).toFixed(0)+" MB"; if(b>=1e3)return(b/1e3).toFixed(0)+" KB"; return (b|0)+" B"; }
+  function fmtRate(bps){ if(bps>=1e9)return(bps/1e9).toFixed(2)+" Gbps"; if(bps>=1e6)return(bps/1e6).toFixed(0)+" Mbps"; if(bps>=1e3)return(bps/1e3).toFixed(0)+" Kbps"; return Math.round(bps)+" bps"; }
+  function fmtAge(sec){ if(sec<0)return "new"; if(sec>=3600)return Math.floor(sec/3600)+"h "+Math.floor(sec%3600/60)+"m"; if(sec>=60)return Math.floor(sec/60)+"m "+(sec%60)+"s"; return sec+"s"; }
+  function protoName(p){ return ({6:"TCP",17:"UDP",1:"ICMP",58:"ICMPv6"})[p]||("IP"+p); }
+  function dscpName(d){ return d===46?" (EF)":d===34?" (AF41)":d===26?" (AF31)":d===0?"":""; }
+  function schedFor(c){ return c.q>0?"WRR":"SP"; }
+
+  function fetchOnce(){
+    var x=new XMLHttpRequest();
+    x.open("GET",ENDPOINT+"?_="+Date.now(),true); x.timeout=6000;
+    x.onreadystatechange=function(){ if(x.readyState!==4)return; var j; try{ j=JSON.parse(x.responseText); }catch(e){ return; } ingest(j); render(); };
+    x.onerror=x.ontimeout=function(){}; x.send();
+  }
+
+  function ingest(j){
+    state.qos=j.qos_type;
+    var g={}, order=[], seen=j.seen||{}, now=j.now||0;
+    (j.flows||[]).forEach(function(r){
+      var c=g[r.nfc];
+      if(!c){ c=g[r.nfc]={nfc:r.nfc,proto:r.proto,dscp:0,q:0,bytes:0,tot:0,sw:0,hw:0,cli:"",cp:0,srv:"",spt:0,haveC:0}; order.push(r.nfc); }
+      c.bytes+=r.bytes; c.tot+=r.tot; c.sw+=r.sw; c.hw+=r.hw; c.proto=r.proto;
+      if(r.dscp) c.dscp=r.dscp; if(r.q) c.q=r.q;
+      if(r.lan){ c.cli=r.sip; c.cp=r.sp; c.srv=r.dip; c.spt=r.dp; c.haveC=1; }
+      else if(!c.haveC){ c.cli=r.dip; c.cp=r.dp; c.srv=r.sip; c.spt=r.sp; }
+    });
+    var tnow=Date.now(), conns=[];
+    order.forEach(function(nfc){
+      var c=g[nfc], p=state.prev[nfc], dt=p?(tnow-p.ts)/1000:0;
+      c.rate=(p&&dt>0)?Math.max(0,(c.bytes-p.bytes)*8/dt):0;
+      c.hwPct=c.tot>0?c.hw/c.tot*100:0;
+      c.acc=c.hw>0;
+      c.age=(seen[nfc]!=null)?(now-seen[nfc]):-1;
+      conns.push(c);
+    });
+    var np={}; conns.forEach(function(c){ np[c.nfc]={bytes:c.bytes,ts:tnow}; }); state.prev=np;
+    state.conns=conns;
+    if(state.sel==null || !conns.some(function(c){return c.nfc===state.sel;}))
+      state.sel = conns.length ? conns.slice().sort(function(a,b){return b.rate-a.rate;})[0].nfc : null;
+  }
+
+  function render(){
+    var conns=state.conns;
+    var shown=conns.filter(function(c){ return filter==="all"||(filter==="acc"&&c.hwPct>=50)||(filter==="cpu"&&c.hwPct<50); })
+                   .sort(function(a,b){ return b.rate-a.rate; });
+    var accN=conns.filter(function(c){return c.hwPct>=50;}).length;
+    var totRate=conns.reduce(function(a,c){return a+c.rate;},0);
+    var hwR=conns.reduce(function(a,c){return a+c.rate*c.hwPct/100;},0);
+    var hwPct=totRate>0?hwR/totRate*100:100;
+
+    document.getElementById("cards").innerHTML=
+      card("Active Flows",conns.length,"connections in the flow cache","")+
+      card("Hardware Accelerated",accN+" <small>/ "+conns.length+"</small>","forwarded by the Runner","",conns.length?Math.round(accN/conns.length*100):0)+
+      card("Total Throughput",fmtRate(totRate),"measured across flows","")+
+      cardSplit("Forwarding Path",hwPct);
+
+    document.getElementById("ftag").textContent="("+shown.length+" shown)";
+
+    if(!conns.length){ document.getElementById("fbody").innerHTML='<div class="empty">No active flows in the accelerator cache. Generate some traffic (or QoS/accelerator may be off).</div>'; document.getElementById("detail").innerHTML=""; return; }
+
+    var rows=shown.map(function(c){
+      var hw=Math.round(c.hwPct*10)/10, cpu=Math.round((100-c.hwPct)*10)/10, acc=c.hwPct>=50;
+      return '<div class="frow'+(c.nfc===state.sel?" sel":"")+'" data-n="'+c.nfc+'">'+
+        '<div class="fid">'+c.nfc.slice(-6)+'</div>'+
+        '<div class="flow5"><div class="ep">'+c.cli+':'+c.cp+'<span class="ar">&rarr;</span>'+c.srv+':'+c.spt+'</div></div>'+
+        '<div><span class="proto '+protoName(c.proto).toLowerCase()+'">'+protoName(c.proto)+'</span></div>'+
+        '<div>'+(acc?'<span class="pathbadge acc"><span class="ck">&#10003;</span>Runner</span>':'<span class="pathbadge slow">CPU</span>')+'</div>'+
+        '<div><span class="qpill">'+c.q+'</span></div>'+
+        '<div class="r num'+(c.dscp?"":" dim")+'">'+c.dscp+'</div>'+
+        '<div class="r num">'+(c.rate/1e6).toFixed(0)+'<span class="num dim"> M</span></div>'+
+        '<div class="r num">'+fmtBytes(c.bytes)+'</div>'+
+        '<div class="r num dim">'+fmtAge(c.age)+'</div>'+
+        '<div class="mix"><i class="hw" style="width:'+hw+'%"></i><i class="cpu" style="width:'+cpu+'%"></i><span>'+hw.toFixed(0)+'% HW</span></div>'+
+        '</div>';
+    }).join("");
+    document.getElementById("fbody").innerHTML='<div class="ftable"><div class="fhead"><div>Flow</div><div>Source &rarr; Destination</div><div>Proto</div><div>Path</div><div class="r">Q</div><div class="r">DSCP</div><div class="r">Rate</div><div class="r">Bytes</div><div class="r">Age</div><div>HW / CPU</div></div>'+rows+'</div>';
+    document.querySelectorAll(".frow").forEach(function(r){ r.onclick=function(){ state.sel=r.getAttribute("data-n"); render(); }; });
+    renderDetail();
+  }
+  function card(lbl,val,sub,h,pct){ return '<div class="card"><div class="lbl">'+lbl+'</div><div class="val">'+val+'</div><div class="sub2">'+sub+'</div>'+(pct!=null?'<div class="splitbar"><i class="hw" style="width:'+pct+'%"></i></div>':'')+'</div>'; }
+  function cardSplit(lbl,hwPct){ var cpu=100-hwPct; return '<div class="card"><div class="lbl">'+lbl+'</div><div class="val" style="font-size:16px"><span style="color:var(--jade)">'+hwPct.toFixed(1)+'% HW</span> <small>/ '+cpu.toFixed(1)+'% CPU</small></div><div class="splitbar"><i class="hw" style="width:'+hwPct+'%"></i><i class="cpu" style="width:'+cpu+'%"></i></div></div>'; }
+
+  function renderDetail(){
+    var c=state.conns.filter(function(x){return x.nfc===state.sel;})[0];
+    if(!c){ document.getElementById("detail").innerHTML=""; return; }
+    var hw=c.hwPct, cpu=100-hw, acc=hw>=50;
+    document.getElementById("detail").innerHTML=
+      '<div class="dhd"><div><div class="k">Flow '+c.nfc.slice(-6)+'</div><div class="n">'+c.srv+'</div></div>'+
+        (acc?'<span class="chip acc">&#10003; Accelerated</span>':'<span class="chip" style="color:var(--amber);border-color:rgba(224,169,59,.4)">CPU path</span>')+'</div>'+
+      '<div class="drows">'+
+        drow("Source",c.cli+':'+c.cp)+
+        drow("Destination",c.srv+':'+c.spt)+
+        drow("Protocol",protoName(c.proto))+
+        drow("Hardware Accelerated",(acc?'<span style="color:var(--jade)">&#10003; Runner</span>':'<span style="color:var(--amber)">No (CPU)</span>'))+
+        drow("Queue",c.q)+
+        drow("Scheduler",schedFor(c))+
+        drow("DSCP",c.dscp+dscpName(c.dscp))+
+        drow("Current Rate",'<span class="dv big">'+fmtRate(c.rate)+'</span>')+
+        drow("Bytes",fmtBytes(c.bytes))+
+        drow("Duration",fmtAge(c.age))+
+      '</div>'+
+      '<div class="dsplit"><div class="row2"><span class="hwt">Hardware '+hw.toFixed(1)+'%</span><span class="cput">CPU '+cpu.toFixed(1)+'%</span></div>'+
+        '<div class="mix" style="height:16px"><i class="hw" style="width:'+hw+'%"></i><i class="cpu" style="width:'+cpu+'%"></i></div></div>';
+  }
+  function drow(k,v){ return '<div class="drow"><span class="dk">'+k+'</span><span class="dv">'+v+'</span></div>'; }
+
+  function start(){ stop(); if(live){ fetchOnce(); timer=setInterval(fetchOnce,currentMs); } }
+  function stop(){ if(timer){clearInterval(timer);timer=null;} }
+  document.getElementById("rate").addEventListener("click",function(e){ var b=e.target.closest("button"); if(!b)return; currentMs=+b.getAttribute("data-ms"); document.querySelectorAll("#rate button").forEach(function(x){x.classList.toggle("on",x===b);}); start(); });
+  document.getElementById("filters").addEventListener("click",function(e){ var b=e.target.closest("button"); if(!b)return; filter=b.getAttribute("data-f"); document.querySelectorAll("#filters button").forEach(function(x){x.classList.toggle("on",x===b);}); render(); });
+  var lb=document.getElementById("livebtn");
+  lb.addEventListener("click",function(){ live=!live; lb.classList.toggle("paused",!live); lb.childNodes[1].textContent=live?"LIVE":"PAUSED"; live?start():stop(); });
+  document.addEventListener("visibilitychange",function(){ document.hidden?stop():(live&&start()); });
+  start();
+})();
+</script>
+</body>
+</html>
