diff --git a/release/src/router/rc/rwatch.c b/release/src/router/rc/rwatch.c
index 96ddc0d5a8..450292a967 100644
--- a/release/src/router/rc/rwatch.c
+++ b/release/src/router/rc/rwatch.c
@@ -11,10 +11,13 @@
  *      match a Warden block set (defense-in-depth behind the updater's
  *      reserved-range filter; on a hit it re-runs the idempotent apply.sh so
  *      the structural anti-lockout chain order is guaranteed current),
- *   4. the GDX skb_idx pool: host local TCP rides the GDX accelerator (HTOA
- *      license), whose 8192-entry pool drains silently when the Runner loop
- *      wedges - the stock stack has NO watchdog or log for this, so a drained
- *      pool is otherwise invisible until "the internet is frozen".
+ *   4. the GDX skb_idx pool (OPT-IN, rwatch_gdx=1, default off): host local TCP
+ *      rides the GDX accelerator (HTOA license), whose 8192-entry pool drains
+ *      silently when the Runner loop wedges - the stock stack has NO watchdog or
+ *      log for this, so a drained pool is otherwise invisible until "the internet
+ *      is frozen". Gated because it reads a kernel accelerator /proc surface every
+ *      tick and skb_idx is not yet field-proven safe under sustained polling
+ *      (pre-release audit 2026-08-02, per the shelved wifi-accel reboot lesson).
  *
  * Results are a state machine in /tmp/rwatch.state: transitions (and every
  * 3rd consecutive failing tick) go to syslog with tag "rwatch"; the FIRST
@@ -24,7 +27,8 @@
  * incident SSH/GUI were unreachable but LOCAL scripts kept running fine, so
  * the box can always self-document a wedge even when nobody can log in.
  *
- * nvram: rwatch_enable (default 1), rwatch_iv (minutes, 1-30, default 5).
+ * nvram: rwatch_enable (default 1), rwatch_iv (minutes, 1-30, default 5),
+ *        rwatch_gdx (opt-in kernel GDX/FPM /proc probes, default 0 = off).
  *
  * reaper v1.9.1 (Device Identity Manager Rung B): this same tick also carries
  * the opt-in long-term history writer (Reaper_Storage.asp). Guarded by nvram
@@ -84,6 +88,7 @@ static void rwatch_gen(void)
 	  "GW=\"$(nvram get wan0_gateway)\"\n"
 	  "{ [ -n \"$GW\" ] && [ \"$GW\" != \"0.0.0.0\" ]; } || GW=\"$(nvram get wan_gateway)\"\n"
 	  "LANIP=\"$(nvram get lan_ipaddr)\"\n"
+	  "GDX=\"$(nvram get rwatch_gdx)\"\n"
 	  "FAIL=\"\"; CRIT=\"\"\n"
 	  "\n"
 	  "# 1) first-hop reachability (by IP, two tries)\n"
@@ -105,8 +110,10 @@ static void rwatch_gen(void)
 	  "fi\n"
 	  "\n"
 	  "# 4) GDX host-TCP pool: 0 available = the silent accelerator-wedge\n"
-	  "#    signature. Parse tolerantly; skip the check if the format is unknown.\n"
-	  "if [ -r /proc/gdx/skb_idx ]; then\n"
+	  "#    signature. OPT-IN (rwatch_gdx=1): reads a kernel accelerator /proc\n"
+	  "#    surface every tick; default-off until skb_idx is field-proven non-\n"
+	  "#    destructive under sustained polling (pre-release audit 2026-08-02).\n"
+	  "if [ \"$GDX\" = 1 ] && [ -r /proc/gdx/skb_idx ]; then\n"
 	  "  AV=$(grep -i avail /proc/gdx/skb_idx 2>/dev/null | head -1 | sed 's/[^0-9]*\\([0-9][0-9]*\\).*/\\1/')\n"
 	  "  case \"$AV\" in\n"
 	  "    ''|*[!0-9]*) : ;;\n"
@@ -122,9 +129,9 @@ static void rwatch_gen(void)
 	  "  iptables -nvxL > \"$D/iptables.txt\" 2>&1\n"
 	  "  ip6tables -nvxL > \"$D/ip6tables.txt\" 2>&1\n"
 	  "  ipset list -t > \"$D/ipset-headers.txt\" 2>&1\n"
-	  "  [ -r /proc/gdx/skb_idx ] && cat /proc/gdx/skb_idx > \"$D/gdx-skb_idx.txt\" 2>&1\n"
-	  "  [ -r /proc/gdx/stats ] && cat /proc/gdx/stats > \"$D/gdx-stats.txt\" 2>&1\n"
-	  "  [ -r /proc/driver/fpm/fpm ] && head -80 /proc/driver/fpm/fpm > \"$D/fpm.txt\" 2>&1\n"
+	  "  [ \"$GDX\" = 1 ] && [ -r /proc/gdx/skb_idx ] && cat /proc/gdx/skb_idx > \"$D/gdx-skb_idx.txt\" 2>&1\n"
+	  "  [ \"$GDX\" = 1 ] && [ -r /proc/gdx/stats ] && cat /proc/gdx/stats > \"$D/gdx-stats.txt\" 2>&1\n"
+	  "  [ \"$GDX\" = 1 ] && [ -r /proc/driver/fpm/fpm ] && head -80 /proc/driver/fpm/fpm > \"$D/fpm.txt\" 2>&1\n"
 	  "  fcctl status > \"$D/fcache.txt\" 2>&1\n"
 	  "  bpmctl status > \"$D/bpm.txt\" 2>&1\n"
 	  "  WANIF=\"$(nvram get wan0_ifname)\"\n"
