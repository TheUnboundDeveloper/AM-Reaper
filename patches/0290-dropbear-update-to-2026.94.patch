From 8ce015115b2eb6b92edde4e9c3e6178a5e9884cb Mon Sep 17 00:00:00 2001
From: Eric Sauvageau <merlin@asuswrt-merlin.net>
Date: Fri, 24 Jul 2026 17:43:44 -0400
Subject: [PATCH] dropbear: update to 2026.94

(cherry picked from commit 291d46531031b75b6e7996543bacd1e6a6761c33)
---
 release/src/router/dropbear/src/svr-runopts.c | 4 ----
 1 file changed, 4 deletions(-)

diff --git a/release/src/router/dropbear/src/svr-runopts.c b/release/src/router/dropbear/src/svr-runopts.c
index 74eb0c4920f..2baec6bdefa 100644
--- a/release/src/router/dropbear/src/svr-runopts.c
+++ b/release/src/router/dropbear/src/svr-runopts.c
@@ -85,9 +85,7 @@ static void printhelp(const char * progname) {
 					"-s		Disable password logins\n"
 					"-g		Disable password logins for root\n"
 					"-B		Allow blank password logins\n"
-#if DEPRECATED_TWO_FACTOR
 					"-t		Enable two-factor authentication (both password and public key required)\n"
-#endif
 #endif
 					"-T		Maximum authentication tries (default %d)\n"
 #if DROPBEAR_SVR_LOCALANYFWD
@@ -346,11 +344,9 @@ void svr_getopts(int argc, char ** argv) {
 				case 'B':
 					svr_opts.allowblankpass = 1;
 					break;
-#if DEPRECATED_TWO_FACTOR
 				case 't':
 					svr_opts.multiauthmethod = 1;
 					break;
-#endif
 #else
 				case 's':
 				case 'g':
