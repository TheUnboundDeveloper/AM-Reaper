+/* ------------------------------------------------------------------ */
+/* structural egress scrub (backlog 2026-08-02): EVERY tools/call       */
+/* result passes through this at the single emit point in handle_rpc.   */
+/* Before this, only get_logs scrubbed its own output - the other tools */
+/* were safe purely because of the sources chosen, and a future tool    */
+/* added to the same pattern would have bypassed redaction silently.    */
+/* Redacts the VALUE of any secret-shaped "<frag>[:=] value" assignment */
+/* (the get_logs sed fragment set, plus privkey/apikey). A false        */
+/* positive costs cosmetics; a miss costs a secret.                     */
+/* ------------------------------------------------------------------ */
+
+static const char *SCRUB_FRAG[] = {
+	"passphrase", "credential", "password", "apikey", "privkey",
+	"secret", "bearer", "passwd", "token", "pass", "psk", "pin", "key",
+	NULL
+};
+
+static void sb_scrub_secrets(sbuf_t *in)
+{
+	sbuf_t out;
+	size_t i = 0;
+
+	if (!in->p || !in->len)
+		return;
+	sb_init(&out);
+	if (!out.p) {
+		/* cannot build the scrubbed copy: withhold rather than leak */
+		in->len = 0;
+		in->p[0] = 0;
+		in->truncated = 0;
+		sb_puts(in, "(scrub unavailable - output withheld)");
+		return;
+	}
+	while (i < in->len) {
+		int f, matched = 0;
+		for (f = 0; SCRUB_FRAG[f] && !matched; f++) {
+			size_t fl = strlen(SCRUB_FRAG[f]);
+			size_t j, v0;
+			if (i + fl > in->len || strncasecmp(in->p + i, SCRUB_FRAG[f], fl) != 0)
+				continue;
+			j = i + fl;
+			/* JSON/quoted key form: "token": "x" - step over the key's
+			 * closing quote so the separator check still lands on [:=] */
+			if (j < in->len && (in->p[j] == '"' || in->p[j] == '\''))
+				j++;
+			while (j < in->len && (in->p[j] == ' ' || in->p[j] == '\t')) j++;
+			if (j >= in->len || (in->p[j] != ':' && in->p[j] != '='))
+				continue;
+			j++;
+			while (j < in->len && (in->p[j] == ' ' || in->p[j] == '\t')) j++;
+			if (j < in->len && in->p[j] == '"') j++;
+			v0 = j;
+			while (j < in->len) {
+				char c = in->p[j];
+				if (c == '"' || c == ',' || c == ' ' || c == '\t' ||
+				    c == '\r' || c == '\n' || c == '\0')
+					break;
+				j++;
+			}
+			if (j > v0) {
+				sb_add(&out, in->p + i, fl);
+				sb_puts(&out, "=<redacted>");
+				i = j;
+				matched = 1;
+			}
+		}
+		if (!matched) {
+			sb_add(&out, in->p + i, 1);
+			i++;
+		}
+	}
+	/* swap in the scrubbed copy (fail-closed: if redaction GREW the buffer
+	 * past the cap, the truncated-but-scrubbed copy still replaces the
+	 * original - a cut payload is acceptable, an unscrubbed one is not) */
+	sb_free(in);
+	*in = out;
+}
+
+/* A buffer that hit the size cap was cut mid-stream, silently. Rewind a
+ * little and append an explicit marker. The buffer is plain text (it gets
+ * JSON-escaped downstream), so no structural repair is needed - only
+ * honesty about the cut (backlog 2026-08-02: the cut used to be silent
+ * and could land mid-structure of the embedded tool JSON). */
+#define SB_TRUNC_MARK "\n...[truncated: output hit the size cap]"
+static void sb_mark_truncated(sbuf_t *s)
+{
+	size_t need = sizeof(SB_TRUNC_MARK);	/* marker + NUL */
+
+	if (!s->p || !s->truncated)
+		return;
+	if (s->len + need > s->cap)
+		s->len = (s->cap > need) ? s->cap - need : 0;
+	if (s->len + need > TOOLOUT_MAX)
+		s->len = TOOLOUT_MAX - need;
+	memcpy(s->p + s->len, SB_TRUNC_MARK, need - 1);
+	s->len += need - 1;
+	s->p[s->len] = 0;
+}
