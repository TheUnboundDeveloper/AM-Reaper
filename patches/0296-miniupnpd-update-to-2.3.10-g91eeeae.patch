 release/src/router/miniupnpd-igdv2/upnphttp.c |  9 ++-
 .../router/miniupnpd-igdv2/upnppermissions.c  | 63 +++++++++++--------
 release/src/router/miniupnpd/Changelog.txt    |  5 ++
 release/src/router/miniupnpd/miniupnpd.c      | 16 ++---
 .../miniupnpd/netfilter_nft/nftnlrdr_misc.c   | 40 +++++++-----
 .../router/miniupnpd/testupnppermissions.sh   |  6 +-
 release/src/router/miniupnpd/upnphttp.c       |  9 ++-
