diff --git a/release/src/router/rc/rwarden.c b/release/src/router/rc/rwarden.c
index 810623c8196..34e41c99055 100644
--- a/release/src/router/rc/rwarden.c
+++ b/release/src/router/rc/rwarden.c
@@ -54,6 +54,7 @@
 #define RW_APPLY  "/tmp/rwarden/apply.sh"
 #define RW_UPDATE "/tmp/rwarden/update.sh"
 #define RW_STATS  "/tmp/rwarden/stats.sh"
+#define RW_BASE   "/tmp/rwarden/blocked_base"	/* cumulative block count across re-arms */
 #define RW_CACHE  "/jffs/rwarden"
 #define RW_SAVE   "/jffs/rwarden/sets.ipset"
 
@@ -280,6 +281,19 @@ static void rw_gen_apply(void)
 	  "V6PFX=\"$(nvram get ipv6_prefix)\"\n"
 	  "V6LEN=\"$(nvram get ipv6_prefix_length)\"\n"
 	  "[ -n \"$V6PFX\" ] && [ -n \"$V6LEN\" ] && V6LAN=\"${V6PFX}/${V6LEN}\" || V6LAN=\"\"\n");
+	/* reaper (v2.1.x, field: "block count doesn't track actual blocks"): the
+	 * live RW_DROP packet counter is the ONLY source of "total blocked", but the
+	 * teardown below flushes RW_DROP - and apply.sh re-runs on every
+	 * restart_firewall - so the counter kept zeroing and the UI total never
+	 * accumulated. Snapshot the counter about to be discarded into a /tmp
+	 * baseline (accumulating); stats.sh then reports baseline + live. /tmp clears
+	 * on reboot, so this is a live/session total, not cross-reboot. NOTE: it does
+	 * NOT recover drops the HW flow-accelerator may offload without incrementing
+	 * iptables - that potential undercount is a separate, metal-only question. */
+	fprintf(f,
+	  "_rwb=$(cat " RW_BASE " 2>/dev/null); [ -n \"$_rwb\" ] || _rwb=0\n"
+	  "_rwc=$( { iptables -nvxL RW_DROP 2>/dev/null; ip6tables -nvxL RW_DROP 2>/dev/null; } | awk '/ DROP /{s+=$1} END{print s+0}')\n"
+	  "echo $((_rwb+_rwc)) > " RW_BASE "\n");
 	/* ---- teardown ---- both stacks (dispatch chain before its RW_DROP dep) */
 	fprintf(f,
 	  "for T in iptables ip6tables; do\n"
@@ -546,8 +560,12 @@ static void rw_gen_stats(void)
 	  "TN=$(ipset -t list rw_threat 2>/dev/null | sed -n 's/.*Number of entries: //p'); [ -n \"$TN\" ] || TN=0\n"
 	  "TN6=$(ipset -t list rw_threat6 2>/dev/null | sed -n 's/.*Number of entries: //p'); [ -n \"$TN6\" ] || TN6=0\n"
 	  "GN=$(ipset list -n 2>/dev/null | grep -c '^rw_g_')\n"
-	  "TOTAL=$( { iptables -nvxL RW_DROP 2>/dev/null; ip6tables -nvxL RW_DROP 2>/dev/null; } "
+	  "# total blocked = persisted baseline (carried across firewall re-arms that\n"
+	  "# flush RW_DROP) + the live RW_DROP packet counter\n"
+	  "RWBASE=$(cat " RW_BASE " 2>/dev/null); [ -n \"$RWBASE\" ] || RWBASE=0\n"
+	  "LIVE=$( { iptables -nvxL RW_DROP 2>/dev/null; ip6tables -nvxL RW_DROP 2>/dev/null; } "
 	  "| awk '/ DROP /{s+=$1} END{print s+0}')\n"
+	  "TOTAL=$((RWBASE+LIVE))\n"
 	  "# per-country pkt sums across both stacks\n"
 	  "TOP=$( { iptables -nvxL REAPER_WARDEN 2>/dev/null; ip6tables -nvxL REAPER_WARDEN 2>/dev/null; } | awk '\n"
 	  "  { for(i=1;i<=NF;i++) if($i ~ /^rw_g6?_[a-z][a-z]$/){ n=$i; sub(/^rw_g6?_/,\"\",n); c[toupper(n)]+=$1 } }\n"
@@ -565,6 +583,7 @@ void stop_rwarden(void)
 	unlink(RW_APPLY);
 	unlink(RW_UPDATE);
 	unlink(RW_STATS);
+	unlink(RW_BASE);	/* disabling Warden resets the cumulative block count */
 }
 
 void start_rwarden(void)
