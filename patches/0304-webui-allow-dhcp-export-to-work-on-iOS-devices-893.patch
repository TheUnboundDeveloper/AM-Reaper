From c6b7094385fcfbada03adbe941465b089012ad6b Mon Sep 17 00:00:00 2001
From: dave14305 <44532942+dave14305@users.noreply.github.com>
Date: Tue, 7 Jul 2026 15:32:09 -0400
Subject: [PATCH] webui: allow dhcp export to work on iOS devices (#893)

(cherry picked from commit b0f8db90a07a2481f11d726ca95864c2f11cc57e)
---
 release/src/router/www/Advanced_DHCP_Content.asp | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/release/src/router/www/Advanced_DHCP_Content.asp b/release/src/router/www/Advanced_DHCP_Content.asp
index 6fc55ce257..97e3ff4045 100644
--- a/release/src/router/www/Advanced_DHCP_Content.asp
+++ b/release/src/router/www/Advanced_DHCP_Content.asp
@@ -772,8 +772,9 @@ function exportCSV(){
 		if(item.mac != "" && item.ip != "")
 			csv += `${item.mac},${item.ip},${item.dns},${item.hostname}\n`;
 	});
+	const blob = new Blob([csv], { type: "text/csv;charset=utf-8" });
 	var hiddenElement = document.createElement('a');
-	hiddenElement.href = 'data:text/csv;charset=utf-8,' + encodeURI(csv);
+	hiddenElement.href = URL.createObjectURL(blob);
 	hiddenElement.target = '_blank';
 	hiddenElement.download = 'dhcp_manual_list.csv';
 	hiddenElement.click();
-- 
2.25.1

