From 1f0dbbbdc94aebedfa36b6b8338c05da5825ba50 Mon Sep 17 00:00:00 2001
From: reaper <theunbounddeveloper@outlook.com>
Date: Mon, 3 Aug 2026 21:32:03 -0400
Subject: [PATCH] www: three UI polish fixes (WiFiPro nvram names, Advisor
 wording, dashboard SSID case)

- Reaper_WiFiPro.asp: drop the raw nvram field name (wlN_<key>) shown under each
  friendly setting label; developer detail, not user-facing.
- EN.dict RADV_01: complete the truncated Advisor intro sentence ('...read this
  router's' -> '...read this router's status and configuration.').
- Main_ReaperDash.asp: SSID radio tiles were upper-cased by the shared .port .ps
  style (wanted for wired/USB port-speed labels); override #wl_ports .ps to show
  the SSID in its real mixed case, matching the Network page.
---
 release/src/router/www/EN.dict             | 2 +-
 release/src/router/www/Main_ReaperDash.asp | 1 +
 release/src/router/www/Reaper_WiFiPro.asp  | 2 +-
 3 files changed, 3 insertions(+), 2 deletions(-)

diff --git a/release/src/router/www/EN.dict b/release/src/router/www/EN.dict
index 25f8297409..dd528655ea 100644
--- a/release/src/router/www/EN.dict
+++ b/release/src/router/www/EN.dict
@@ -5244,7 +5244,7 @@ Reaper_c_ai_advisor=AI Advisor
 Reaper_c_system_info=System Info
 Reaper_c_language=Language
 RSHL_reboot_note=The UI will reload when the router is back.
-RADV_01=A <b>read-only</b> bridge that lets <b>your own</b> AI assistant read this router's
+RADV_01=A <b>read-only</b> bridge that lets <b>your own</b> AI assistant read this router's status and configuration.
 RADV_02=<b>Off by default.</b> Nothing listens until you arm it below, and it never survives a reboot.
 RADV_03=<b>LAN only.</b> It binds this router's LAN address and is never reachable from the internet.
 RADV_04=<b>Read only.</b> It cannot change a setting. When you allow it, it can also run bounded, read-only network diagnostics (ping / traceroute / DNS / netstat).
diff --git a/release/src/router/www/Main_ReaperDash.asp b/release/src/router/www/Main_ReaperDash.asp
index c14d03707c..4c16d5bec7 100644
--- a/release/src/router/www/Main_ReaperDash.asp
+++ b/release/src/router/www/Main_ReaperDash.asp
@@ -219,6 +219,7 @@ html{scrollbar-width:thin;scrollbar-color:var(--crimson) #000}
 .port{flex:1;min-width:104px;border:1px solid var(--line-soft);border-radius:10px;padding:12px;background:rgba(255,255,255,.015);text-align:center}
 .port .pn{font-family:var(--hdr);font-weight:700;color:var(--bone);font-size:15px}
 .port .ps{font-size:10px;letter-spacing:.12em;text-transform:uppercase;color:var(--steel);margin-top:5px}
+#wl_ports .ps{text-transform:none;letter-spacing:.02em}
 .port .led{width:9px;height:9px;border-radius:50%;margin:8px auto 0;background:rgba(255,255,255,.12)}
 .port.up .led{background:var(--jade);box-shadow:0 0 0 3px rgba(79,178,134,.15)}
 .port.up{border-color:var(--line)}
diff --git a/release/src/router/www/Reaper_WiFiPro.asp b/release/src/router/www/Reaper_WiFiPro.asp
index 8c90c9eca0..2fa11621f9 100644
--- a/release/src/router/www/Reaper_WiFiPro.asp
+++ b/release/src/router/www/Reaper_WiFiPro.asp
@@ -270,7 +270,7 @@ code{font-family:ui-monospace,Consolas,monospace}
         var chip=row.chip?' <span class="chip '+row.chip.c+'">'+esc(row.chip.t)+'</span>':'';
         var help=row.help?'<div class="rl-help">'+esc(row.help)+'</div>':'';
         var label='<div class="rowlabel"><div class="rl-top"><span class="rl-name">'+esc(row.name)+'</span>'+chip+'</div>'+help+
-                  '<code class="rl-key">wlN_'+esc(row.key)+'</code></div>';
+                  '</div>';
         return '<div class="row">'+label+RADIOS.map(function(r){return cellHTML(row,r);}).join("")+'</div>';
       }).join("");
       return '<section class="sec"><h2 class="sec-h">'+esc(s.sec)+'</h2><div class="matrix">'+rows+'</div></section>';
-- 
2.25.1

