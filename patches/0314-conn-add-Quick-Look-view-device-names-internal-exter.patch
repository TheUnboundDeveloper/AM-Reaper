From 9faa847d3263490b619e5737a0143ddd843a8bdc Mon Sep 17 00:00:00 2001
From: reaper <theunbounddeveloper@outlook.com>
Date: Mon, 3 Aug 2026 22:11:03 -0400
Subject: [PATCH] conn: add Quick Look view (device names + internal/external +
 TCP state) + Advanced toggle

Reaper-native two-mode Connections page (supersedes the idea of reusing Merlin's
stock Main_ConnStatus page):
- Quick Look (new default): a fast, at-a-glance list - device NAME (resolved from
  networkmap via /appGet.cgi?hook=get_clientlist(), same source as Reaper_Traffic),
  local IP, remote IP:port, an Internal/External scope badge (RFC1918 test on the
  remote end), protocol, and TCP state. Lighter, name-first, styled like the rest
  of the page. The existing live flow explorer is retained unchanged as 'Advanced'.
- A single header slider toggles Quick Look <-> Advanced, persisted in localStorage.
- Advanced gains an explicit 'Pause' option in the rate control (500ms/1s/4s kept),
  and now shows the device name + TCP state in its per-flow detail panel too.
- Backend: do_reaper_conn_cgi now reads /proc/net/nf_conntrack once and matches each
  fcache flow by 5-tuple (either direction), emitting a new "st" (TCP state) field;
  UDP/unmatched flows get an empty state. Bounded array, freed each call.

NOT BUILT - the C is uncompiled; the v2.1.3 build is its first compile. New Quick
Look labels (Device/Scope/State/Internal/External/Quick Look/Advanced/Pause) are
English literals pending an i18n tokenization pass.
---
 release/src/router/httpd/web.c         |  61 +++++++++-
 release/src/router/www/Reaper_Conn.asp | 158 +++++++++++++++++++++----
 2 files changed, 193 insertions(+), 26 deletions(-)

diff --git a/release/src/router/httpd/web.c b/release/src/router/httpd/web.c
index 2ab047a3c3..b4d84e4f9b 100644
--- a/release/src/router/httpd/web.c
+++ b/release/src/router/httpd/web.c
@@ -21802,6 +21802,9 @@ do_reaper_conn_cgi(char *url, FILE *stream)
 	uint32_t lan_net = 0, lan_mask = 0;
 	struct in_addr ia;
 	int first, cf;
+	/* v2.1.3 (Quick Look): conntrack TCP-state table, matched to each flow below */
+	struct rc_ctst { uint32_t s, d; unsigned sp, dp; char st[16]; } *ctv = NULL;
+	int ctn = 0, ctcap = 0;
 
 	if (inet_aton(nvram_safe_get("lan_ipaddr"), &ia)) lan_net = ntohl(ia.s_addr);
 	if (inet_aton(nvram_safe_get("lan_netmask"), &ia)) lan_mask = ntohl(ia.s_addr);
@@ -21824,6 +21827,43 @@ do_reaper_conn_cgi(char *url, FILE *stream)
 	}
 	websWrite(stream, "},\"flows\":[");
 
+	/* v2.1.3 (Quick Look): read conntrack ONCE into a small table. The fcache feed
+	 * carries no TCP state, so each flow below is matched to this by its 5-tuple.
+	 * TCP lines only (state word is the token immediately before the first src=). */
+	{
+		FILE *ctf = fopen("/proc/net/nf_conntrack", "r");
+		char ctl[1024];
+		if (ctf != NULL) {
+			while (fgets(ctl, sizeof(ctl), ctf)) {
+				char cs[24], cd[24], stw[16], *sv, *b, *e;
+				unsigned csp = 0, cdp = 0;
+				struct in_addr a;
+				int stl;
+				if (strstr(ctl, " tcp ") == NULL) continue;
+				if ((sv = strstr(ctl, "src=")) == NULL) continue;
+				e = sv; while (e > ctl && e[-1] == ' ') e--;
+				b = e;  while (b > ctl && b[-1] != ' ') b--;
+				stl = (int)(e - b);
+				if (stl <= 0 || stl >= (int)sizeof(stw)) continue;
+				memcpy(stw, b, (size_t)stl); stw[stl] = '\0';
+				if (sscanf(sv, "src=%23s dst=%23s sport=%u dport=%u", cs, cd, &csp, &cdp) != 4)
+					continue;
+				if (ctn == ctcap) {
+					int nc = ctcap ? ctcap * 2 : 256;
+					struct rc_ctst *nv = realloc(ctv, (size_t)nc * sizeof(*ctv));
+					if (nv == NULL) break;
+					ctv = nv; ctcap = nc;
+				}
+				ctv[ctn].s = inet_aton(cs, &a) ? a.s_addr : 0;
+				ctv[ctn].d = inet_aton(cd, &a) ? a.s_addr : 0;
+				ctv[ctn].sp = csp; ctv[ctn].dp = cdp;
+				strlcpy(ctv[ctn].st, stw, sizeof(ctv[ctn].st));
+				ctn++;
+			}
+			fclose(ctf);
+		}
+	}
+
 	/* single-flight the /proc/fcache/nflist read (pre-release audit 2026-08-02):
 	 * this Runner accelerator surface is the same family as the shelved wifi-accel
 	 * /proc readers that wedged the box under sustained/concurrent CGI polling. A
@@ -21845,6 +21885,7 @@ do_reaper_conn_cgi(char *url, FILE *stream)
 			char swstr[24], sip[24], dip[24], tos[16] = "00", nfc[40] = "0";
 			char *p, *q, *gt, *m1, *m2, *mg;
 			uint32_t sipn;
+			const char *cstate = "";
 
 			/* leading fixed block: flowid, TotalHits, TotalBytes, SW_TotHits(:),
 			 * SW_TotalBytes, [HW_tpl Fhw_idx HW_Hits] HW_TotHits, [HW_TotalBytes
@@ -21874,15 +21915,31 @@ do_reaper_conn_cgi(char *url, FILE *stream)
 			reaper_ip_strip_zeros(sip); reaper_ip_strip_zeros(dip);
 			sipn = 0; if (inet_aton(sip, &ia)) sipn = ntohl(ia.s_addr);
 
+			/* match this flow's 5-tuple to the conntrack table (either direction) */
+			{
+				struct in_addr sa, da;
+				uint32_t sN = inet_aton(sip, &sa) ? sa.s_addr : 0;
+				uint32_t dN = inet_aton(dip, &da) ? da.s_addr : 0;
+				int k;
+				for (k = 0; k < ctn; k++) {
+					if ((ctv[k].s == sN && ctv[k].sp == (unsigned)sp && ctv[k].d == dN && ctv[k].dp == (unsigned)dp) ||
+					    (ctv[k].d == sN && ctv[k].dp == (unsigned)sp && ctv[k].s == dN && ctv[k].sp == (unsigned)dp)) {
+						cstate = ctv[k].st;
+						break;
+					}
+				}
+			}
+
 			websWrite(stream,
 				"%s{\"nfc\":\"%s\",\"lan\":%d,\"sip\":\"%s\",\"sp\":%d,\"dip\":\"%s\",\"dp\":%d,"
-				"\"proto\":%d,\"dscp\":%d,\"q\":%d,\"bytes\":%llu,\"tot\":%llu,\"sw\":%llu,\"hw\":%llu}",
+				"\"proto\":%d,\"dscp\":%d,\"q\":%d,\"bytes\":%llu,\"tot\":%llu,\"sw\":%llu,\"hw\":%llu,\"st\":\"%s\"}",
 				first ? "" : ",", nfc, (lan_mask && (sipn & lan_mask) == lan_net) ? 1 : 0,
-				sip, sp, dip, dp, prot, dscp, iq, tbytes, tot, sw, hw);
+				sip, sp, dip, dp, prot, dscp, iq, tbytes, tot, sw, hw, cstate);
 			first = 0;
 		}
 		fclose(f);
 	}
+	free(ctv);
 	if (cf >= 0) { flock(cf, LOCK_UN); close(cf); }
 	websWrite(stream, "]}");
 }
