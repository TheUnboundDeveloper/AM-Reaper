From de6ac2d2e0c301e81a72aef638ec7388fa7e403d Mon Sep 17 00:00:00 2001
From: reaper <theunbounddeveloper@outlook.com>
Date: Mon, 3 Aug 2026 21:42:44 -0400
Subject: [PATCH] www: allow RFC 4638 baby-jumbo PPPoE MTU (1500/1508) in the
 WAN GUI

The rc backend already supports it (rc/wan.c ~2075: when wan_pppoe_mtu/mru > 1492
it raises the parent WAN interface MTU to pppoe_mtu+8, i.e. 1508). The only blocker
was the WAN page validation: wan_pppoe_mtu/mru were capped at 1492 and wan_mtu at
1500, and the pppoe_mtu <= wan_mtu-8 clamp knocked 1500 back to 1492. Raised the
caps to 1500 (pppoe_mtu/mru) and 1508 (wan_mtu) + the range hint, so a user CAN set
a clean 1500-byte PPPoE MTU/MRU on full-fibre lines. Opt-in: defaults stay 1492/1500,
so existing PPPoE users are unaffected. METAL-TEST OWED on a live PPPoE line.
---
 release/src/router/www/Advanced_WAN_Content.asp | 8 ++++----
 1 file changed, 4 insertions(+), 4 deletions(-)

diff --git a/release/src/router/www/Advanced_WAN_Content.asp b/release/src/router/www/Advanced_WAN_Content.asp
index d9c7950a32..887994a24c 100644
--- a/release/src/router/www/Advanced_WAN_Content.asp
+++ b/release/src/router/www/Advanced_WAN_Content.asp
@@ -1034,8 +1034,8 @@ function validForm(){
 	}
 	
 	if(wan_type == "pppoe"){
-		if(!validator.numberRange(document.form.wan_pppoe_mtu, 128, 1492)
-				|| !validator.numberRange(document.form.wan_pppoe_mru, 128, 1492))
+		if(!validator.numberRange(document.form.wan_pppoe_mtu, 128, 1500)
+				|| !validator.numberRange(document.form.wan_pppoe_mru, 128, 1500))
 			return false;
 
 		/* reset wan_mtu to default value */
@@ -1132,7 +1132,7 @@ function validForm(){
 		 	return false;
 
 	if($("#wan_mtu_tr").css("display") != "none" && (orig_mtu != "" || document.form.wan_mtu.value.length > 0)) {
-		if(!validator.numberRange(document.form.wan_mtu, 1280, 1500)) {
+		if(!validator.numberRange(document.form.wan_mtu, 1280, 1508)) {
 			document.form.wan_mtu.focus();
 			document.form.wan_mtu.select();
 			return false;
@@ -3136,7 +3136,7 @@ function get_default_wan_name(){
 				<#PPPConnection_x_PPPoEMTU_itemname#>
 			</th>
 			<td>
-				<input type="text" maxlength="5" name="wan_mtu" class="input_6_table" value="<% nvram_get("wan_mtu"); %>" onKeyPress="return validator.isNumber(this,event);" autocorrect="off" autocapitalize="off"/>&nbsp;1280 - 1500
+				<input type="text" maxlength="5" name="wan_mtu" class="input_6_table" value="<% nvram_get("wan_mtu"); %>" onKeyPress="return validator.isNumber(this,event);" autocorrect="off" autocapitalize="off"/>&nbsp;1280 - 1508
 			</td>
 		</tr>
 		</table>
