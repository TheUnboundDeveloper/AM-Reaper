From a11cc568799504c7faf8346ae32edafa86c44df2 Mon Sep 17 00:00:00 2001
From: reaper <theunbounddeveloper@outlook.com>
Date: Tue, 4 Aug 2026 17:14:25 -0400
Subject: [PATCH 320/322] firstboot: make Reaper_FirstBoot self-recovering -
 kill the 'won't accept anything' credential loop

Field report (v2.1.4, factory reset): the first-boot page rejects every
username/password entered - user locked out. Second independent report of the
same class as the v2.1.2 dual-surface incident, but on a build where that race
is already closed.

Root cause class, proven by disassembly of the do_chpass/check_chpass_auth
blob (libwebapi/prebuild/RT-BE96U/priv_webapi.o):
  - password DEFAULT            -> chpass has NO failure path at all
  - non-default + force_chgpass==1 -> auth bypassed, succeeds
  - non-default otherwise       -> 401 without current creds; 5th try = 402 +
                                   forced logout (chpass_login_try)
Therefore 'every input rejected' means the password was ALREADY non-default
when the user submitted - i.e. the page was rendered/kept alive across a state
change: our own earlier submit whose 200 never reached the page (dropped
response, back-nav, bfcache restore), or an older build's dual-surface race.
Reaper_FirstBoot never sends current credentials and never re-checks server
state, so once in that state every submit is mathematically doomed -> RFB_13
loop, then forced logout. Recovery previously required a stock-firmware
restore.

Fix (page-only, no C/blob changes):
  1. Load guard: if the password is no longer default and force_chgpass!=1,
     this page cannot succeed and is not needed - location.replace('/').
  2. Failure probe: on a rejected chpass, re-fetch this page and parse the
     live check_pw/force_chgpass flags; if the password is in fact set (and no
     operator force), treat the credential step as DONE and run the normal
     finish flow (saveNvram;restart_chpass apply + navigate '/') instead of
     showing the dead-end error.
  3. Post-success block factored into finishOk() shared by both paths.

Inline JS node --check clean; ASCII-only; tokens remain in double quotes
(standing rule 29). METAL OWED: factory reset -> set creds -> reboot-survival,
plus the recovery path (back-nav to a stale first-boot page must bounce to /).

Rides v2.1.5 with the MULTISERVICE_WAN MTU fix.
---
 release/src/router/www/Reaper_FirstBoot.asp | 34 +++++++++++++++++++++
 1 file changed, 34 insertions(+)

diff --git a/release/src/router/www/Reaper_FirstBoot.asp b/release/src/router/www/Reaper_FirstBoot.asp
index f3790dfaf9..1bc705c4a2 100644
--- a/release/src/router/www/Reaper_FirstBoot.asp
+++ b/release/src/router/www/Reaper_FirstBoot.asp
@@ -126,6 +126,17 @@ input:focus{border-color:var(--crimson)}
 <script>
 (function(){
   "use strict";
+  /* v2.1.5 (field: "won't accept anything" credential loop): live first-boot state.
+     Blob contract (priv_webapi.o do_chpass, disasm-verified): while the password is
+     DEFAULT there is NO failure path at all; once it is NON-default, a chpass without
+     current credentials fails 401 (and 402+forced logout after 5 tries) UNLESS
+     force_chgpass==1 (operator force, auth bypassed). So if this page renders with a
+     non-default password and no operator force it can NEVER succeed - the only ways
+     to get here are a stale/back-nav/bfcache copy or a prior submit whose success
+     response never reached the page. Leave instead of dead-ending. */
+  var RFB_PW_IS_DEFAULT=('<% check_pw(); %>'==='1');
+  var RFB_FORCE_CHG=('<% nvram_get("force_chgpass"); %>'==='1');
+  if(!RFB_PW_IS_DEFAULT && !RFB_FORCE_CHG){ location.replace("/"); }
   var DEFAULT_PW = "admin";  /* mirrors defaults.c http_passwd default */
   function $(id){return document.getElementById(id);}
   function showErr(m){var e=$("fb_err"); e.textContent=m; e.style.display="block";}
@@ -183,6 +194,25 @@ input:focus{border-color:var(--crimson)}
     var credOK=false;
     try{ credOK=reaperSetCred(u,p); }catch(e){ credOK=false; }
     if(!credOK){
+      /* v2.1.5: a rejected chpass while the password is still default is impossible
+         (see blob contract above) - so probe the LIVE state before declaring failure.
+         If the password is no longer default (our own earlier submit landed, or an
+         older build's dual-surface race already set it) and no operator force is
+         pending, the credential step is in fact DONE: finish the flow instead of
+         looping "Could not apply credentials" forever. */
+      var stillDef=true, forced=false;
+      try{
+        var pr=new XMLHttpRequest();
+        pr.open("GET","/Reaper_FirstBoot.asp?probe=1",false);
+        pr.send(null);
+        if(pr.status===200){
+          var md=pr.responseText.match(/var RFB_PW_IS_DEFAULT=\('([^']*)'/);
+          var mf=pr.responseText.match(/var RFB_FORCE_CHG=\('([^']*)'/);
+          if(md) stillDef=(md[1]==="1");
+          if(mf) forced=(mf[1]==="1");
+        }
+      }catch(e){}
+      if(!stillDef && !forced){ finishOk(); return; }
       showErr("<#RFB_13#>");
       $("fb_go").disabled=false; $("fb_spin").style.display="none";
       return;
@@ -197,6 +227,10 @@ input:focus{border-color:var(--crimson)}
        Reuse the hidden titleForm (posts to /start_apply.htm via the fb_hidden iframe,
        so it never navigates the page); run it AFTER chpass so restart_chpass rebuilds
        /etc/shadow from the just-committed nvram value. */
+    finishOk();
+  }
+
+  function finishOk(){
     try{
       var tf=$("titleForm");
       tf.action_script.value="saveNvram;restart_chpass";
-- 
