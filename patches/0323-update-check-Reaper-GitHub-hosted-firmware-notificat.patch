+#!/bin/sh
+# reaper_webs_note.sh - release-note fetch for the Reaper update check.
+# Args: $1 = model (unused; kept for stock call-signature compat)  $2 = version
+# Fetches updates/notes/Reaper_v<ver>.txt from the Reaper GitHub raw tree into
+# /tmp/release_note.txt and sets cfg_note the way the stock page expects.
+
+wget_options="-q -t 2 -T 30"
+RAW_BASE="https://raw.githubusercontent.com/TheUnboundDeveloper/AM-Reaper/main/updates/notes"
+NOTE_PATH="/tmp/release_note.txt"
+
+nvram set cfg_note=0
+
+if [ $# -lt 2 ]; then
+	nvram set cfg_note=2
+	exit 0
+fi
+
+# $2 arrives as the webs_state_info string "3006.102.8_Reaper_v2.1.5"; take the vX.Y.Z
+ver=$(echo "$2" | sed 's/.*Reaper_v//; s/[^0-9.].*//')
+[ -z "$ver" ] && { nvram set cfg_note=2; exit 0; }
+
+/usr/sbin/wget $wget_options "$RAW_BASE/Reaper_v${ver}.txt" -O "$NOTE_PATH"
+if [ "$?" != "0" ] || [ ! -s "$NOTE_PATH" ]; then
+	# no per-version note published; point at the GitHub release page instead
+	echo "Reaper v${ver} is available." > "$NOTE_PATH"
+	echo "" >> "$NOTE_PATH"
+	echo "Release notes: https://github.com/TheUnboundDeveloper/AM-Reaper/releases" >> "$NOTE_PATH"
+fi
+
+nvram set cfg_note=1
diff --git a/release/src/router/rom/webs_scripts/reaper_webs_update.sh b/release/src/router/rom/webs_scripts/reaper_webs_update.sh
new file mode 100755
index 0000000000..fc7e8840f2
--- /dev/null
+++ b/release/src/router/rom/webs_scripts/reaper_webs_update.sh
@@ -0,0 +1,82 @@
+#!/bin/sh
+# reaper_webs_update.sh - Reaper GitHub-hosted firmware update CHECK (notify only).
+# Replaces Merlin's webs_update.sh: fetches Reaper's own plain-text manifest from
+# GitHub (never ASUS/Merlin), compares the running Reaper vX.Y.Z against the
+# published one for THIS model AND THIS variant (MCP vs noMCP), and sets the
+# stock webs_state_* nvram the firmware page already renders. It NEVER downloads
+# or flashes an image (Phase 1). Opt-in: rc only runs this when the user has
+# enabled the check (firmware_check_enable=1; default 0).
+
+wget_options="-q -t 2 -T 30"
+MANIFEST_URL="https://raw.githubusercontent.com/TheUnboundDeveloper/AM-Reaper/main/updates/manifest_3006.txt"
+TMP=/tmp/reaper_update.txt
+LOG=/tmp/webs_upgrade.log
+
+nvram set webs_state_update=0
+nvram set webs_state_flag=0
+nvram set webs_state_error=0
+nvram set webs_state_url=""
+
+echo "---- reaper update check $(date) ----" > "$LOG"
+
+model=$(nvram get productid)
+
+# variant: MCP builds ship rmcpd + Reaper_Advisor.asp; noMCP ships neither
+# (same signal reaper_verify uses). Guarantees we never cross-flash variants.
+if [ -f /usr/sbin/rmcpd ] || [ -f /www/Reaper_Advisor.asp ]; then
+	variant="MCP"
+else
+	variant="noMCP"
+fi
+
+# running Reaper version: extendno = "Reaper_v2.1.5" (maybe a -gHASH or letter
+# suffix). Extract MAJOR.MINOR.PATCH; drop any trailing letter / -g suffix.
+cur_ver=$(nvram get extendno | sed 's/^Reaper_v//; s/-g.*//; s/_.*//; s/[a-z]$//')
+case "$cur_ver" in
+	''|*[!0-9.]*) cur_ver="0.0.0" ;;
+esac
+
+echo "---- model=$model variant=$variant running=$cur_ver ----" >> "$LOG"
+
+/usr/sbin/wget $wget_options "$MANIFEST_URL" -O "$TMP"
+if [ "$?" != "0" ] || [ ! -s "$TMP" ]; then
+	echo "---- manifest fetch failed ----" >> "$LOG"
+	nvram set webs_state_error=1
+	nvram set webs_state_update=1
+	exit 0
+fi
+
+# manifest line: MODEL#VARIANT#X.Y.Z#<download-url>
+line=$(grep "^${model}#${variant}#" "$TMP" | head -1)
+if [ -z "$line" ]; then
+	echo "---- no manifest entry for ${model}#${variant} ----" >> "$LOG"
+	nvram set webs_state_error=1
+	nvram set webs_state_update=1
+	rm -f "$TMP"
+	exit 0
+fi
+
+rem_ver=$(echo "$line" | cut -d'#' -f3)
+rem_url=$(echo "$line" | cut -d'#' -f4)
+rm -f "$TMP"
+
+# numeric compare: X.Y.Z -> XXXYYYZZZ (zero-padded), integer -gt
+ver_num() { echo "$1" | awk -F. '{printf "%d%03d%03d\n", $1+0, $2+0, $3+0}'; }
+cur_n=$(ver_num "$cur_ver")
+rem_n=$(ver_num "$rem_ver")
+
+echo "---- published=$rem_ver ($rem_n) running=$cur_ver ($cur_n) ----" >> "$LOG"
+
+if [ "$rem_n" -gt "$cur_n" ] 2>/dev/null; then
+	echo "---- update available: Reaper v$rem_ver ----" >> "$LOG"
+	nvram set webs_state_flag=1
+	# firmware-string shape the page renders; keeps the Reaper version visible
+	nvram set webs_state_info="3006.102.8_Reaper_v${rem_ver}"
+	# Phase 2 will consume this; harmless in Phase 1 (page never auto-downloads)
+	nvram set webs_state_url="$rem_url"
+else
+	echo "---- up to date ----" >> "$LOG"
+	nvram set webs_state_flag=0
+fi
+
+nvram set webs_state_update=1
