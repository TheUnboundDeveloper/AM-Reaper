+/* USB disk cards (v2.1.7: the networkmap USB side-menu functions live here now) */
+.dk{border:1px solid var(--line-soft);border-radius:10px;background:var(--panel-2);padding:14px 16px;margin-bottom:12px}
+.dkhead{display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:8px}
+.dkname{font-family:var(--hdr);font-weight:600;font-size:15px;color:var(--bone)}
+.dkport{font-size:11px;color:var(--steel);text-transform:uppercase;letter-spacing:.08em}
+.dkbadge{font-size:10px;font-weight:600;text-transform:uppercase;letter-spacing:.08em;border:1px solid var(--crimson-deep);color:var(--bone);background:rgba(225,6,0,.10);border-radius:4px;padding:2px 7px}
+.dkpart{display:flex;align-items:center;gap:10px;font-size:12.5px;padding:6px 0;border-top:1px solid var(--line-soft)}
+.dkpart .pn{color:var(--bone-dim);min-width:110px}
+.dkpart .pf{color:var(--steel);min-width:56px;text-transform:uppercase;font-size:11px}
+.dkbar{flex:1;height:6px;border-radius:4px;background:#1c1c21;overflow:hidden;min-width:120px}
+.dkbar i{display:block;height:100%;background:linear-gradient(90deg,var(--crimson-deep),var(--crimson))}
+.dkuse{color:var(--steel);white-space:nowrap;font-size:11.5px}
