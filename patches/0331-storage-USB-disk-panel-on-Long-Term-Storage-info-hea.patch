+/* ---------------- USB disks ---------------- */
+var dkBusy = 0;          /* a scan/format is in flight (buttons lock globally) */
+
+function dkFresh(cb){    /* live re-read of the disk inventory via appGet */
+  var x = new XMLHttpRequest();
+  x.open('GET', '/appGet.cgi?hook=' + encodeURIComponent('get_usb_info()') + '&_=' + Date.now(), true);
+  x.timeout = 12000;
+  x.onreadystatechange = function(){
+    if(x.readyState !== 4) return;
+    if(x.status === 200){
+      try{
+        var j = JSON.parse(x.responseText), k;
+        for(k in j){ if(Object.prototype.hasOwnProperty.call(j, k)){ USBINFO = j[k] || []; break; } }
+      }catch(e){}
+    }
+    if(cb) cb();
+  };
+  x.send();
+}
+
+function dkPost(fields){ /* stock apply: posted nvram vars are written, then action_script runs */
+  var f = document.createElement('form'), k;
+  f.method = 'POST'; f.action = '/start_apply.htm'; f.target = 'dk_hidden'; f.style.display = 'none';
+  fields.action_mode = 'apply'; fields.action_wait = '1';
+  for(k in fields){
+    var i = document.createElement('input');
+    i.type = 'hidden'; i.name = k; i.value = fields[k]; f.appendChild(i);
+  }
+  document.body.appendChild(f); f.submit();
+  setTimeout(function(){ f.parentNode && f.parentNode.removeChild(f); }, 4000);
+}
+
+function dkStatus(cb){   /* diskmon_status: 0 idle, 1-4 scan phases, 5 done, 7 formatting */
+  var x = new XMLHttpRequest();
+  x.open('GET', '/appGet.cgi?hook=' + encodeURIComponent('nvram_get(diskmon_status)') + '&_=' + Date.now(), true);
+  x.timeout = 8000;
+  x.onreadystatechange = function(){
+    if(x.readyState !== 4) return;
+    var v = -1;
+    if(x.status === 200){
+      try{ var j = JSON.parse(x.responseText), k; for(k in j){ v = parseInt(j[k], 10); break; } }catch(e){}
+    }
+    cb(isNaN(v) ? -1 : v);
+  };
+  x.send();
+}
+
+function dkSetStat(port, txt, cls){
+  var n = document.getElementById('dkstat_' + port);
+  if(n){ n.className = 'dkstat' + (cls ? ' ' + cls : ''); n.innerHTML = txt; }
+}
+
+function dkPoll(port, mode, tries){   /* wait for the diskmon run to finish */
+  if(tries > 900){ dkBusy = 0; renderDisks(); return; }   /* 30 min cap */
+  dkStatus(function(v){
+    if(v >= 1 && v !== 5 && v !== 6){  /* running (start/umount/scan/remount/format) */
+      dkSetStat(port, esc(mode === 'fmt' ? `<#format_formatting#>` : `<#Scan#>`) + '&hellip;');
+      setTimeout(function(){ dkPoll(port, mode, tries + 1); }, 2000);
+      return;
+    }
+    dkBusy = 0;
+    if(mode === 'fmt'){
+      dkSetStat(port, esc(`<#format_complete#>`), 'ok');
+      dkFresh(renderDisks);
+    } else {
+      dkSetStat(port, esc(`<#diskUtility_detailInfo#>`) + ':', 'ok');
+      var x = new XMLHttpRequest();
+      x.open('GET', '/disk_fsck.xml?diskmon_usbport=' + encodeURIComponent(port) + '&_=' + Date.now(), true);
+      x.onreadystatechange = function(){
+        if(x.readyState !== 4) return;
+        var log = document.getElementById('dklog_' + port), t = '';
+        if(x.status === 200 && x.responseXML){
+          var ns = x.responseXML.getElementsByTagName('*');
+          for(var i = 0; i < ns.length; i++)
+            if(ns[i].childNodes.length && ns[i].firstChild.nodeValue && /disk/i.test(ns[i].nodeName))
+              t += ns[i].firstChild.nodeValue + '\n';
+        }
+        if(log){ log.textContent = t || x.responseText || ''; log.style.display = 'block'; }
+        dkFresh(renderDisks);
+      };
+      x.send();
+    }
+  });
+}
+
+function dkScan(port){
+  if(dkBusy) return;
+  dkBusy = 1;
+  dkSetStat(port, esc(`<#Scan#>`) + '&hellip;');
+  dkPost({ action_script: 'start_diskscan', diskmon_usbport: port });
+  setTimeout(function(){ dkPoll(port, 'scan', 0); }, 3000);
+}
+
+function dkFormat(port){
+  if(dkBusy) return;
+  var fsSel = document.getElementById('dkfs_' + port), lb = document.getElementById('dklb_' + port);
+  if(!fsSel) return;
+  if(!confirm(`<#RDST_46#>`)) return;
+  dkBusy = 1;
+  dkSetStat(port, esc(`<#format_formatting#>`) + '&hellip;');
+  dkPost({ action_script: 'start_diskformat',
+           diskmon_usbport: port,
+           diskformat_file_system: fsSel.value,
+           diskformat_label: (lb && lb.value) ? lb.value.replace(/[^0-9A-Za-z_-]/g, '') : 'USBDISK' });
+  setTimeout(function(){ dkPoll(port, 'fmt', 0); }, 3000);
+}
+
+function dkEject(port){
+  if(dkBusy) return;
+  if(!confirm(`<#Safelyremovedisk_confirm#>`)) return;
+  var x = new XMLHttpRequest();
+  x.open('GET', '/device-map/safely_remove_disk.asp?disk=' + encodeURIComponent(port) + '&_=' + Date.now(), true);
+  x.onreadystatechange = function(){
+    if(x.readyState !== 4) return;
+    if(x.status === 200 && x.responseText.indexOf('success') >= 0){
+      dkSetStat(port, esc(`<#Safelyremovedisk#>`), 'ok');
+    } else {
+      dkSetStat(port, esc(`<#RDST_33#>`), 'err');
+    }
+    setTimeout(function(){ dkFresh(renderDisks); }, 1500);
+  };
+  x.send();
+}
+
+function renderDisks(){
+  var box = document.getElementById('usb_disks');
+  if(!box) return;
+  var disks = USBINFO || [], out = '', n = 0;
+  disks.forEach(function(d){
+    if(!d || !d.deviceName) return;
+    n++;
+    var port = String(d.usbPath || '');
+    var name = ''; try{ name = decodeURIComponent(String(d.deviceName)); }catch(e){ name = String(d.deviceName); }
+    var parts = d.partition || [], size = 0, used = 0, prows = '', isStore = false;
+    parts.forEach(function(p, i){
+      var ps = Number(p.size_int || 0), pu = Number(p.used_int || 0);
+      size += ps; used += pu;
+      var pct = ps > 0 ? Math.min(100, Math.round(pu / ps * 100)) : 0;
+      var pname = p.partName || p.mountPoint || (name + '-' + (i + 1));
+      try{ pname = decodeURIComponent(String(pname)); }catch(e){}
+      if(S && S.loc === 'usb' && S.path && p.mountPoint && String(S.path).indexOf(String(p.mountPoint)) === 0) isStore = true;
+      prows += '<div class="dkpart"><span class="pn">' + esc(pname) + '</span>' +
+        '<span class="pf">' + esc(p.format || '') + '</span>' +
+        '<div class="dkbar"><i style="width:' + pct + '%"></i></div>' +
+        '<span class="dkuse">' + fmtBytes(pu * 1024) + ' / ' + fmtBytes(ps * 1024) + '</span></div>';
+    });
+    var fsOpts = '<option value="tfat">FAT32</option>';
+    if(FS_NTFS) fsOpts += '<option value="ntfs">NTFS</option>';
+    if(FS_HFS)  fsOpts += '<option value="hfs">HFS+</option>';
+    out += '<div class="dk">' +
+      '<div class="dkhead"><span class="dkname">' + esc(name) + '</span>' +
+      '<span class="dkport">USB ' + esc(port) + '</span>' +
+      (isStore ? '<span class="dkbadge">' + esc(`<#RDST_45#>`) + '</span>' : '') +
+      '<span class="dkuse" style="margin-left:auto">' + esc(`<#Totalspace#>`) + ': ' + fmtBytes(size * 1024) + '</span></div>' +
+      prows +
+      '<div class="dkacts">' +
+      '<button class="btn2" onclick="dkScan(\'' + esc(port) + '\')"' + (dkBusy ? ' disabled' : '') + '>' + esc(`<#diskUtility#>`) + '</button>' +
+      '<button class="btn2 danger" onclick="dkFmtRow(\'' + esc(port) + '\')"' + (dkBusy ? ' disabled' : '') + '>' + esc(`<#CTL_format#>`) + '</button>' +
+      '<button class="btn2" onclick="dkEject(\'' + esc(port) + '\')"' + (dkBusy ? ' disabled' : '') + '>' + esc(`<#Safelyremovedisk_title#>`) + '</button>' +
+      '</div>' +
+      '<div class="fmtrow" id="dkfmt_' + esc(port) + '">' +
+      '<span class="flbl">' + esc(`<#format_type#>`) + '</span><select id="dkfs_' + esc(port) + '">' + fsOpts + '</select>' +
+      '<span class="flbl">' + esc(`<#RDST_47#>`) + '</span><input id="dklb_' + esc(port) + '" maxlength="11" value="USBDISK">' +
+      '<button class="btn2 danger" onclick="dkFormat(\'' + esc(port) + '\')">' + esc(`<#CTL_format#>`) + '</button>' +
+      '<button class="btn2" onclick="dkFmtRow(\'' + esc(port) + '\')">' + esc(`<#CTL_Cancel#>`) + '</button>' +
+      '</div>' +
+      '<div class="dkstat" id="dkstat_' + esc(port) + '"></div>' +
+      '<div class="dklog" id="dklog_' + esc(port) + '"></div>' +
+      '</div>';
+  });
+  if(n === 0) out = '<p class="note">' + esc(`<#RDST_44#>`) + '</p>';
+  box.innerHTML = out;
+}
+
+function dkFmtRow(port){
+  var r = document.getElementById('dkfmt_' + port);
+  if(r) r.style.display = (r.style.display === 'flex') ? 'none' : 'flex';
+}
+
 document.getElementById('saveBtn').onclick = save;
-if(document.readyState !== 'loading') loadStatus();
-else document.addEventListener('DOMContentLoaded', loadStatus);
+function boot(){ loadStatus(); renderDisks(); }
+if(document.readyState !== 'loading') boot();
+else document.addEventListener('DOMContentLoaded', boot);
 </script>
 </body>
