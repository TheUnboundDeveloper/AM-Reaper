 <script>
 var REAPER_HTTPID = '<% nvram_get("http_id"); %>';   /* CSRF token */
+/* v2.1.7: the networkmap USB side-menu (Information / Health Scanner / Format /
+   Safely Remove) moved here so that page can be retired. Same stock backends:
+   get_usb_info for the inventory, start_diskscan / start_diskformat via the
+   normal apply flow (posted nvram diskmon_usbport selects the disk), the
+   safely_remove_disk ej for eject, disk_fsck.xml for scan results. */
+var USBINFO = <% get_usb_info(); %>;
+var FS_NTFS = '<% nvram_get("usb_ntfs_mod"); %>';
+var FS_HFS  = '<% nvram_get("usb_hfs_mod"); %>';
 /* store_set error keys (ek) -> localized text; raw j.error stays the fallback */
 var SERR = { RDEVE_1:`<#RDEVE_1#>`, RDEVE_12:`<#RDEVE_12#>`, RDEVE_13:`<#RDEVE_13#>` };
 var S = null;                 /* store_status snapshot */
@@ -211,6 +249,7 @@ function render(){
   Array.prototype.forEach.call(document.querySelectorAll('#ds_rows .tg'), function(n){
     n.onclick = function(){ var k = n.getAttribute('data-k'); dsOn[k] = dsOn[k] ? 0 : 1; render(); };
   });
+  renderDisks();   /* store-status arrived: refresh the disk cards (store badge) */
 }
 
 function save(){
