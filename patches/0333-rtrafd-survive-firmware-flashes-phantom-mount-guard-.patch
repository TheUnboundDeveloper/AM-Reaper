From 2d4567a670e954aa7d347690d08bee5ae9d26afb Mon Sep 17 00:00:00 2001
From: reaper <theunbounddeveloper@outlook.com>
Date: Wed, 5 Aug 2026 10:14:00 -0400
Subject: [PATCH] rtrafd: survive firmware flashes - phantom-mount guard,
 load-status parking, late restore

Field: USB long-term history reset by a firmware flash (reboots persist since
v2.1.5). Three holes in the flash path:

1. The upgrade flow (web.c do_upgrade_post) runs ejusb -1 BEFORE services
   stop, which can leave the bare /tmp/mnt/<label> mountpoint dir on tmpfs.
   resolve_store recreated reaper/ there and the final save wrote the whole
   history into RAM - reported saved, gone at reboot. resolve_store now skips
   any /tmp/mnt entry whose st_dev matches tmpfs /tmp/mnt (not a real mount),
   and scans in two passes preferring the partition that already holds
   reaper/rtraf.db (multi-partition boxes no longer retarget on readdir order).
2. db_load failures were invisible: a rejected/unreadable db still set
   db_attached and the next save overwrote it. db_load now returns
   loaded/absent/bad; a bad file is parked as rtraf.db.prev (db_park_prev)
   and logged at every attach site.
3. A store that appeared after the 15-min retry window was parked as .prev
   and never restored - a post-flash fsck or slow HDD spin-up made a flash
   look like a full reset. Within LATE_LOAD_SECS (4 h) of boot the late
   store is now LOADED (history outweighs the since-boot RAM rings); only
   past that is it parked.

Shutdown log now says explicitly when the store was unmounted at stop time
(the ejusb/flash case) and that the last periodic save stands.

Co-Authored-By: Claude Fable 5 <noreply@anthropic.com>
---
 release/src/router/rtrafd/rtrafd.c | 118 ++++++++++++++++++++---------
 1 file changed, 83 insertions(+), 35 deletions(-)

diff --git a/release/src/router/rtrafd/rtrafd.c b/release/src/router/rtrafd/rtrafd.c
index 3324b668ae..ddf4fb0be3 100644
--- a/release/src/router/rtrafd/rtrafd.c
+++ b/release/src/router/rtrafd/rtrafd.c
@@ -74,6 +74,11 @@
 #define SAVE_EVERY	3600	/* persist once an hour (jffs - NAND wear) */
 #define SAVE_EVERY_USB	900	/* USB has no wear concern; tighter loss window */
 #define STORE_RETRY_SECS 900	/* how long to wait for a late-mounting store */
+#define LATE_LOAD_SECS	14400	/* still restore (not park) a store that appears
+				 * this early in the boot - a post-flash fsck or a
+				 * slow HDD spin-up can blow past STORE_RETRY_SECS,
+				 * and the saved history is worth far more than the
+				 * since-boot RAM rings. Past this, RAM data wins. */
 #define DB_MAGIC	0x52545246	/* "RTRF" */
 #define DB_VER		1
 
@@ -1039,16 +1044,36 @@ static const char *resolve_store(char *buf, size_t len)
 			return "jffs";
 		}
 	} else if (strcmp(mode, "usb") == 0) {
-		DIR *d = opendir("/tmp/mnt");
+		/* v2.1.7 (field: "USB history reset by a firmware flash"): the upgrade
+		 * flow runs `ejusb -1` BEFORE services stop, which can leave the bare
+		 * /tmp/mnt/<label> mountpoint DIRECTORY behind on tmpfs. The old scan
+		 * then recreated reaper/ inside it and the final save wrote the whole
+		 * history into RAM - "saved" successfully, gone at reboot. A real USB
+		 * mount has a different st_dev from tmpfs /tmp/mnt, so skip any entry
+		 * that is not actually a mounted filesystem. Also scan in two passes,
+		 * preferring the partition that already holds reaper/rtraf.db, so a
+		 * box with several USB partitions keeps saving to the one that has
+		 * the history instead of whichever readdir happens to list first. */
+		struct stat mroot, ms;
+		DIR *d;
 		struct dirent *e;
-		if (d) {
+		int pass;
+		if (stat("/tmp/mnt", &mroot) != 0) { buf[0] = '\0'; return "ram"; }
+		for (pass = 0; pass < 2; pass++) {
+			if ((d = opendir("/tmp/mnt")) == NULL) break;
 			while ((e = readdir(d)) != NULL) {
-				char p[128];
+				char p[144], db[160];
 				if (e->d_name[0] == '.') continue;
+				snprintf(p, sizeof(p), "/tmp/mnt/%s", e->d_name);
+				if (stat(p, &ms) != 0 || ms.st_dev == mroot.st_dev)
+					continue;	/* bare dir on tmpfs, not a mount */
 				snprintf(p, sizeof(p), "/tmp/mnt/%s/reaper", e->d_name);
+				snprintf(db, sizeof(db), "%s/rtraf.db", p);
+				if (pass == 0 && access(db, F_OK) != 0)
+					continue;	/* pass 0 wants an existing db */
 				mkdir(p, 0700);
 				if (dir_ok(p) && access(p, W_OK) == 0) {
-					snprintf(buf, len, "%s/rtraf.db", p);
+					strlcpy(buf, db, len);
 					closedir(d);
 					return "usb";
 				}
@@ -1091,26 +1116,41 @@ static void db_save(const char *path)
 	rename(tmp, path);
 }
 
-static void db_load(const char *path)
+/* Park an existing db out of the way as <path>.prev so it is never silently
+ * overwritten by rings that do not contain its history (failed/rejected load,
+ * or a store that appeared too late to restore). No-op if the file is absent. */
+static void db_park_prev(const char *path)
+{
+	char prev[176];
+	if (!path[0] || access(path, F_OK) != 0) return;
+	snprintf(prev, sizeof(prev), "%s.prev", path);
+	if (rename(path, prev) == 0)
+		syslog(LOG_WARNING, "rtrafd: prior %s not restored - preserved as %s", path, prev);
+}
+
+/* returns 1 = history loaded (possibly truncated), 0 = no db file,
+ *        -1 = file exists but is unreadable or not our format (caller should
+ *             park it as .prev rather than let a later save overwrite it) */
+static int db_load(const char *path)
 {
 	dbhdr_t h;
 	FILE *o;
 	int i;
 	int fd;
-	if (!path[0]) return;
+	if (!path[0]) return 0;
 	/* don't follow a symlink planted where rtraf.db should be */
 	fd = open(path, O_RDONLY | O_NOFOLLOW);
-	if (fd < 0) return;
-	if ((o = fdopen(fd, "r")) == NULL) { close(fd); return; }
+	if (fd < 0) return (errno == ENOENT) ? 0 : -1;
+	if ((o = fdopen(fd, "r")) == NULL) { close(fd); return -1; }
 	if (fread(&h, sizeof(h), 1, o) != 1 || h.magic != DB_MAGIC || h.ver != DB_VER) {
 		fclose(o);
-		return;
+		return -1;
 	}
 	/* The db comes from USB/JFFS and is UNTRUSTED. h.nnet is a signed int read
 	 * straight from disk: clamping only the high end let a negative value through
 	 * to net_slot() -> netname[negative] out-of-bounds write. Reject any header
 	 * whose nnet is out of range. */
-	if (h.nnet < 0 || h.nnet > NNET) { fclose(o); return; }
+	if (h.nnet < 0 || h.nnet > NNET) { fclose(o); return -1; }
 	nnet = h.nnet;
 	memcpy(netname, h.netname, sizeof(netname));
 	memcpy(cli, h.cli, sizeof(cli));
@@ -1122,14 +1162,18 @@ static void db_load(const char *path)
 		cli[i].ip[sizeof(cli[0].ip) - 1] = 0;
 		cli[i].used = cli[i].used ? 1 : 0;
 	}
-	if (fread(r_wan, sizeof(ring_t), 1, o) != 1) goto out;
-	for (i = 0; i < NNET; i++) if (fread(r_net[i], sizeof(ring_t), 1, o) != 1) goto out;
-	for (i = 0; i < 7; i++) if (fread(r_cls[i], sizeof(ring_t), 1, o) != 1) goto out;
-	for (i = 0; i < NCLI; i++) if (fread(r_cli[i], sizeof(ring_t), 1, o) != 1) goto out;
-	if (fread(r_prb, sizeof(ring_t), 1, o) != 1) goto out;	/* guard the last ring too */
+	if (fread(r_wan, sizeof(ring_t), 1, o) != 1) goto trunc;
+	for (i = 0; i < NNET; i++) if (fread(r_net[i], sizeof(ring_t), 1, o) != 1) goto trunc;
+	for (i = 0; i < 7; i++) if (fread(r_cls[i], sizeof(ring_t), 1, o) != 1) goto trunc;
+	for (i = 0; i < NCLI; i++) if (fread(r_cli[i], sizeof(ring_t), 1, o) != 1) goto trunc;
+	if (fread(r_prb, sizeof(ring_t), 1, o) != 1) goto trunc;	/* guard the last ring too */
 	syslog(LOG_INFO, "rtrafd: history restored from %s (saved %lld)", path, (long long)h.saved);
-out:
 	fclose(o);
+	return 1;
+trunc:
+	syslog(LOG_WARNING, "rtrafd: %s truncated - partial history restored", path);
+	fclose(o);
+	return 1;
 }
 
 /* ---------- main ---------- */
@@ -1188,7 +1232,8 @@ int main(int argc, char **argv)
 	 * save over a file we did not load (see the clobber guard at the save site). */
 	store = resolve_store(dbpath, sizeof(dbpath));
 	if (dbpath[0]) {
-		db_load(dbpath);
+		if (db_load(dbpath) < 0)
+			db_park_prev(dbpath);	/* unreadable/foreign file: never save over it */
 		db_attached = 1;
 	} else if (nvram_safe_get("rtraf_path")[0]) {
 		syslog(LOG_NOTICE,
@@ -1305,7 +1350,8 @@ int main(int argc, char **argv)
 				if (now - boot_t <= STORE_RETRY_SECS) {
 					store = resolve_store(dbpath, sizeof(dbpath));
 					if (dbpath[0]) {
-						db_load(dbpath);
+						if (db_load(dbpath) < 0)
+							db_park_prev(dbpath);
 						db_attached = 1;
 						syslog(LOG_NOTICE, "rtrafd: store came up late - attached %s", dbpath);
 					}
@@ -1322,17 +1368,18 @@ int main(int argc, char **argv)
 
 		if (now - last_save >= (strcmp(store, "usb") == 0 ? SAVE_EVERY_USB : SAVE_EVERY)) {
 			store = resolve_store(dbpath, sizeof(dbpath));
-			/* If the medium appeared only after the retry window (db_gave_up),
-			 * this is the first time we can see the file - and we never loaded
-			 * it, so writing now would destroy the previous boot's history.
-			 * Preserve it once as rtraf.db.prev, then own the path. */
+			/* The medium appeared only after the retry window (db_gave_up) -
+			 * this is the first time we can see the file, and we never loaded
+			 * it. v2.1.7: if we are still early in this boot, RESTORE it (a
+			 * post-flash fsck or slow HDD spin-up can blow the 15-min window,
+			 * and the saved history outweighs the since-boot RAM rings). On a
+			 * box up for hours, the RAM data wins: park the file as .prev,
+			 * then own the path. Either way never overwrite unread history. */
 			if (dbpath[0] && !db_attached) {
-				char prev[176];
-				snprintf(prev, sizeof(prev), "%s.prev", dbpath);
-				if (access(dbpath, F_OK) == 0) {
-					rename(dbpath, prev);
-					syslog(LOG_WARNING, "rtrafd: unloaded prior history preserved as %s", prev);
-				}
+				if (now - boot_t <= LATE_LOAD_SECS && db_load(dbpath) > 0)
+					syslog(LOG_NOTICE, "rtrafd: store appeared late - history restored from %s", dbpath);
+				else
+					db_park_prev(dbpath);
 				db_attached = 1;
 			}
 			db_save(dbpath);
@@ -1358,13 +1405,14 @@ int main(int argc, char **argv)
 	}
 
 	store = resolve_store(dbpath, sizeof(dbpath));
-	if (dbpath[0] && !db_attached) {
-		char prev[176];
-		snprintf(prev, sizeof(prev), "%s.prev", dbpath);
-		if (access(dbpath, F_OK) == 0)
-			rename(dbpath, prev);
-	}
+	if (dbpath[0] && !db_attached)
+		db_park_prev(dbpath);
 	db_save(dbpath);
-	syslog(LOG_INFO, "rtrafd: stopped (history %s)", dbpath[0] ? "saved" : "in RAM only - lost");
+	if (dbpath[0])
+		syslog(LOG_INFO, "rtrafd: stopped (history saved to %s)", dbpath);
+	else if (nvram_safe_get("rtraf_path")[0])
+		syslog(LOG_NOTICE, "rtrafd: stopped - store not mounted (ejected for a firmware flash?); the last periodic save stands");
+	else
+		syslog(LOG_INFO, "rtrafd: stopped (history in RAM only - lost)");
 	return 0;
 }
-- 
2.25.1

