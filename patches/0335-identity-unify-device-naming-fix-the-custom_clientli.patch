+/* reaper: unified device-name overlay - same source/priority every other page
+ * uses (custom_clientlist nickName, else networkmap auto-name), keyed by MAC */
+var devNameByMac = {};
+function fetchDeviceNames(cb) {
+	$.getJSON("/appGet.cgi?hook=get_clientlist()&_=" + Date.now(), function(data){
+		try {
+			var cl = (data && data.get_clientlist) ? data.get_clientlist : (data || {});
+			var ml = cl.maclist || [];
+			for (var i = 0; i < ml.length; i++) {
+				var mac = String(ml[i]), c = cl[mac];
+				if (!c) continue;
+				var nm = (c.nickName && String(c.nickName).length) ? String(c.nickName)
+					: ((c.name && String(c.name).length) ? String(c.name) : "");
+				if (nm) devNameByMac[mac.toUpperCase()] = nm;
+			}
+		} catch(e) {}
+		if (cb) cb();
+	}).fail(function(){ if (cb) cb(); });
+}
+function escDevName(s) {
+	return String(s).replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;").replace(/"/g,"&quot;").replace(/'/g,"&#39;");
