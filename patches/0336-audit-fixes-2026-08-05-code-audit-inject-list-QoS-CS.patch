+			snprintf(cs, sizeof(cs), "%u.%u.%u.%u", (us>>24)&0xff, (us>>16)&0xff, (us>>8)&0xff, us&0xff);
+			snprintf(ce, sizeof(ce), "%u.%u.%u.%u", (ue>>24)&0xff, (ue>>16)&0xff, (ue>>8)&0xff, ue&0xff);
+			nvram_set("dhcp_start", cs);
+			nvram_set("dhcp_end", ce);
