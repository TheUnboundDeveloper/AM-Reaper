+  /* ---- Preamble lock (owner request 2026-08-05) ----
+     While a 2.4 GHz radio's Disable-802.11b select (rateset) shows "ofdm", that
+     radio's Preamble select (plcphdr) is forced to its Disable-802.11b option
+     ("0" - the value the STOCK page derives rateset from) and locked. Switching
+     back to "Allow 802.11b" unlocks it and restores the pre-lock selection (a
+     queued preamble change is parked while locked, not lost). */
+  function pairedSel(el,from,to){
+    var nm=el.getAttribute("data-name"); if(nm.slice(-from.length)!==from) return null;
+    return document.querySelector('[data-name="'+nm.slice(0,-from.length)+to+'"]');
+  }
+  /* a LOCKED plcphdr is staged only when its rateset is itself a staged change:
+     the (ofdm,0) pair is written together. If nvram already held rateset=ofdm
+     (lock engaged at render), the forced "0" is display-only - never submitted -
+     so an inconsistent stored pair does not surface as a phantom pending change. */
+  function lockSuppressed(el){
+    if(!el._locked) return false;
+    var rsel=pairedSel(el,"_plcphdr","_rateset");
+    return !(rsel && getVal(rsel)!==rsel._base);
+  }
+  function syncPreambleLock(rsel){
+    var psel=pairedSel(rsel,"_rateset","_plcphdr"); if(!psel) return;
+    var w=psel.closest(".selwrap"), b=w?w.querySelector(".csel"):null;
+    if(String(rsel.value)==="ofdm"){
+      if(psel._locked) return;
+      psel._prev=String(psel.value); psel._locked=true; psel.disabled=true; psel.value="0";
+      if(w){ w.classList.add("locked"); if(w._sync) w._sync(); }
+      if(b) b.setAttribute("aria-disabled","true");
+    } else if(psel._locked){
+      psel._locked=false; psel.disabled=false;
+      var back=psel._prev;
+      if(back==null||back==="0"||back==="") back=(psel._base&&psel._base!=="0")?psel._base:"long";
+      psel.value=back;
+      if(w){ w.classList.remove("locked"); if(w._sync) w._sync(); }
+      if(b) b.removeAttribute("aria-disabled");
+    }
+  }
+
