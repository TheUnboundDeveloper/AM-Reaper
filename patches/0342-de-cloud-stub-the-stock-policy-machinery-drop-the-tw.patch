From 0e8b79182734fd10e53fea56f30ae034391e9e52 Mon Sep 17 00:00:00 2001
From: reaper <theunbounddeveloper@outlook.com>
Date: Thu, 6 Aug 2026 09:33:26 -0400
Subject: [PATCH] de-cloud: stub the stock policy machinery + drop the two
 ASUS-CDN icon fetches + encode client-popup title attrs (backlog batch)

Three small backlog items closed in one sweep:

1. asus_policy.js PolicyStatus() now resolves immediately with the exact
   shape its own fetch-failed path returned ({isFetchDone:false}) instead
   of fetching /get_ASUS_privacy_policy.cgi on every page - the EULA is
   pre-signed in defaults.c and the policy endpoints are part of the
   removed phone-home surface, so the call only produced the console
   'Error fetching ASUS privacy policy' noise plus a wasted request.
   Every caller already handles this shape (it was the de-facto result).

2. dashboard/js/clientlist.module.js: both browser->ASUS-CDN fetches are
   gone. saveCloudAsusClientIcon() no longer pulls product icons from
   nw-dlcdnet.asus.com for ASUS-made clients (leaked presence/model of
   ASUS devices; the bundled type icon is used, as for every other
   vendor). fetchIconList() no longer replaces the bundled icon catalog
   with the CDN copy; the constructor's built-in list is authoritative
   and getIconByType/queryIconList work unchanged.

3. Same file, defense-in-depth (2026-08-05 audit residual): the three
   raw client.vendor / client.deviceTypeName emissions into single-quoted
   title='...' attributes are now htmlEncode'd PLUS apostrophe-encoded
   (the stock encoder skips the apostrophe - the v2.1.3 XSS class).
   Values are vendor/OUI-DB-sourced, not attacker-freeform.

Validated: asus_policy.js parses (node vm), clientlist.module.js parses
as an ES module (node --check); all added lines ASCII-only.
---
 .../www/dashboard/js/clientlist.module.js     | 19 ++++++++++++++++---
 release/src/router/www/js/asus_policy.js      |  9 +++++++++
 2 files changed, 25 insertions(+), 3 deletions(-)

diff --git a/release/src/router/www/dashboard/js/clientlist.module.js b/release/src/router/www/dashboard/js/clientlist.module.js
index 3604f64e0d..cfd61b6b09 100644
--- a/release/src/router/www/dashboard/js/clientlist.module.js
+++ b/release/src/router/www/dashboard/js/clientlist.module.js
@@ -180,6 +180,12 @@ class Client {
     }
 
     async saveCloudAsusClientIcon() {
+        /* reaper de-cloud (v2.2.0, backlog item): no browser->ASUS-CDN requests.
+           This fetched a product icon for ASUS-made clients from nw-dlcdnet.asus.com,
+           leaking the presence/model of ASUS devices on the LAN. The bundled type
+           icon (already shown for every other vendor) is used instead. */
+        return;
+
         if (!this.isCloudIconFetched && this.type !== '' && !this.isUserUploadImg && this.isASUS && this.type == this.defaultType && this.name != "ASUS") {
             const mac = this.mac.replace(/\:/g, "").toUpperCase();
             await fetch(`https://nw-dlcdnet.asus.com/plugin/productIcons/${this.name}.png`)
@@ -1480,7 +1486,7 @@ export class ClientListTable {
             clientIconCode += `<div class='client_icon'>`;
 
             if (client.uploadIcon !== "NoIcon") {
-                clientIconCode += "<div title='" + client.vendor + "'>";
+                clientIconCode += "<div title='" + htmlEnDeCode.htmlEncode(client.vendor).replace(/'/g, "&#39;") + "'>";	/* reaper v2.2.0: encode incl. apostrophe - single-quoted attr (defense-in-depth, audit residual) */
                 if (client.isUserUploadImg) {
                     clientIconCode += '<img class="imgUserIcon" src="' + client.uploadIcon + '">';
                 } else {
@@ -1496,10 +1502,10 @@ export class ClientListTable {
             } else if (client.vendor != "") {
                 const vendorIconClassName = getVendorIconClassName(client.vendor.toLowerCase());
                 if (vendorIconClassName != "" && !isSupport("sfp4m")) {
-                    clientIconCode += `<div class='vendorIcon_no_hover' title='${client.deviceTypeName}'><i class='vendor-icon ${vendorIconClassName}'></i></div>`;
+                    clientIconCode += `<div class='vendorIcon_no_hover' title='${htmlEnDeCode.htmlEncode(client.deviceTypeName).replace(/'/g, "&#39;")}'><i class='vendor-icon ${vendorIconClassName}'></i></div>`;
                 } else {
                     icon_type = "type" + client.type;
-                    clientIconCode += `<div class='clientIcon_no_hover' title='${client.deviceTypeName}'><i class='${icon_type}' style="--svg:url(${this.iconList.getIconByType(client.type).src})"></i></div>`;
+                    clientIconCode += `<div class='clientIcon_no_hover' title='${htmlEnDeCode.htmlEncode(client.deviceTypeName).replace(/'/g, "&#39;")}'><i class='${icon_type}' style="--svg:url(${this.iconList.getIconByType(client.type).src})"></i></div>`;
                 }
             }
             clientIconCode += `</div>`;
@@ -7948,6 +7954,13 @@ class ClinetIconFetcher {
     }
 
     async fetchIconList() {
+        /* reaper de-cloud (v2.2.0, backlog item): no browser->ASUS-CDN requests.
+           This replaced the bundled icon catalog above with a cloud copy from
+           nw-dlcdnet.asus.com on every client-popup open. The constructor's
+           built-in list stays authoritative; getIconByType/queryIconList work
+           unchanged against it. */
+        return;
+
         const response = await fetch('https://nw-dlcdnet.asus.com/beta/plugin/js/extend_custom_svg_icon.json')
             .then(res => res.json())
             .then(data => {
diff --git a/release/src/router/www/js/asus_policy.js b/release/src/router/www/js/asus_policy.js
index 4f53f25db0..666541aaa2 100644
--- a/release/src/router/www/js/asus_policy.js
+++ b/release/src/router/www/js/asus_policy.js
@@ -1047,6 +1047,15 @@ let policy_status = {
 };
 
 async function PolicyStatus() {
+    /* reaper de-cloud (v2.2.0, backlog item): never run the stock ASUS policy
+       machinery. The EULA/privacy-policy is pre-signed in defaults.c and the
+       policy endpoints are part of the removed phone-home surface, so the fetch
+       below only produced a console "Error fetching ASUS privacy policy" on
+       every page. Resolve immediately with the exact shape the fetch-FAILED
+       path below already returns - every caller demonstrably handles it (that
+       was the de-facto behavior, minus the noise and the wasted request). */
+    return { isFetchDone: false };
+
     let policy_status = {};
 
     try {
