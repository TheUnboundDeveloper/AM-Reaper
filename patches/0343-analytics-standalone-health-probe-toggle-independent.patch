+  var want = this.classList.contains('on') ? 0 : 1, self = this;
+  self.style.pointerEvents = 'none';
+  xhr('GET', '/reaper_export.cgi?action=probe&on=' + want + '&http_id=' + encodeURIComponent(REAPER_HTTPID), function(j){
