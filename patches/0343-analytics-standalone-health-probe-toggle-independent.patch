diff --git a/release/src/router/httpd/web.c b/release/src/router/httpd/web.c
index 35fed0d9fd2..9a80b30f65a 100644
--- a/release/src/router/httpd/web.c
+++ b/release/src/router/httpd/web.c
@@ -24545,6 +24545,7 @@ do_reaper_export_cgi(char *url, FILE *stream)
 		gk_json_esc(stream, scr);	/* shown to the admin for their prometheus.yml */
 		websWrite(stream, ",\"last\":");
 		gk_json_esc(stream, sbuf);
+		websWrite(stream, ",\"hprobe\":%d", nvram_match("rtraf_hprobe", "1") ? 1 : 0);
 		websWrite(stream, "}");
 		return;
 	}
@@ -24597,6 +24598,19 @@ do_reaper_export_cgi(char *url, FILE *stream)
 		return;
 	}
 
+	if (!strcmp(action, "probe")) {
+		/* v2.3.0: standalone master collect switch. Sets rtraf_hprobe directly,
+		 * INDEPENDENT of export - so the per-device health probe can run for the
+		 * live view + payload preview with export off. CSRF-guarded above
+		 * (action != status). Does not touch reaper_export_mode. */
+		char *on = get_cgi("on");
+		nvram_set("rtraf_hprobe", (on && !strcmp(on, "1")) ? "1" : "0");
+		nvram_commit();
+		notify_rc("restart_rtraf");
+		websWrite(stream, "{\"ok\":1,\"hprobe\":%d}", nvram_match("rtraf_hprobe", "1") ? 1 : 0);
+		return;
+	}
+
 	websWrite(stream, "{\"ok\":0,\"error\":\"unknown action\"}");
 }
 
