diff --git a/release/src/router/httpd/web.c b/release/src/router/httpd/web.c
index 9a80b30f65a..04a484eae01 100644
--- a/release/src/router/httpd/web.c
+++ b/release/src/router/httpd/web.c
@@ -24456,7 +24456,7 @@ static void do_reaper_dev_cgi(char *url, FILE *stream)
 		 * Anything other than off needs the per-device health probe running. */
 		{
 			char *xm = get_cgi("xmode");
-			if (xm && (!strcmp(xm, "off") || !strcmp(xm, "both") || !strcmp(xm, "exportonly"))) {
+			if (xm && (!strcmp(xm, "off") || !strcmp(xm, "storeonly") || !strcmp(xm, "both") || !strcmp(xm, "exportonly"))) {
 				nvram_set("reaper_export_mode", xm);
 				if (strcmp(xm, "off")) nvram_set("rtraf_hprobe", "1");
 			}
@@ -24552,7 +24552,7 @@ do_reaper_export_cgi(char *url, FILE *stream)
 
 	if (!strcmp(action, "save")) {
 		char *v;
-		if ((v = get_cgi("mode")) && (!strcmp(v, "off") || !strcmp(v, "both") || !strcmp(v, "exportonly")))
+		if ((v = get_cgi("mode")) && (!strcmp(v, "off") || !strcmp(v, "storeonly") || !strcmp(v, "both") || !strcmp(v, "exportonly")))
 			nvram_set("reaper_export_mode", v);
 		if ((v = get_cgi("engine")))   nvram_set("reaper_export_engine", v);
 		if ((v = get_cgi("url")))      nvram_set("reaper_export_url", v);
diff --git a/release/src/router/rtrafd/rtrafd.c b/release/src/router/rtrafd/rtrafd.c
index 7e44131c480..09c55bd41d3 100644
--- a/release/src/router/rtrafd/rtrafd.c
+++ b/release/src/router/rtrafd/rtrafd.c
@@ -109,7 +109,7 @@
 #define HBUSY_BPS	(300ULL * 1000000)	/* defer a new cycle while either WAN dir is busier than this (speed-test back-off) */
 #define HSPOOL		"/tmp/rtraf/healthhist.spool"	/* RAM staging for history rows; flushed to the store off the hot loop */
 enum { HP_IDLE = 0, HP_SCAN, HP_SEND, HP_WAIT };	/* v2.2.4 health-cycle phase */
-enum { EXP_OFF = 0, EXP_BOTH = 1, EXP_ONLY = 2 };	/* reaper_export_mode */
+enum { EXP_OFF = 0, EXP_STORE = 1, EXP_BOTH = 2, EXP_ONLY = 3 };	/* reaper_export_mode */
 
 typedef struct { uint64_t rx, tx; } cnt_t;	/* class rings: rx=txbytes, tx=dropped pkts */
 						/* probe ring:  rx=avg rtt us, tx=loss %   */
@@ -190,7 +190,8 @@ static void refresh_cfg(void)
 	if (cfg_hint > H_MAX_IV) cfg_hint = H_MAX_IV;
 	m = nvram_safe_get("reaper_export_mode");
 	cfg_export_mode = (strcmp(m, "exportonly") == 0) ? EXP_ONLY
-			: (strcmp(m, "both") == 0)       ? EXP_BOTH : EXP_OFF;
+			: (strcmp(m, "both") == 0)       ? EXP_BOTH
+			: (strcmp(m, "storeonly") == 0)  ? EXP_STORE : EXP_OFF;
 }
 
 /* live snapshot holders (bits/sec), refreshed at each source's own cadence and
@@ -1417,12 +1418,12 @@ static void write_health(void)
 	}
 
 	/* durable retention: SPOOL a compact JSONL row to tmpfs (cheap, non-blocking)
-	 * unless the user chose export-only. v2.2.4: the actual flash append used to run
+	 * only when the mode retains locally (storeonly or both). v2.2.4: the actual flash append used to run
 	 * inline here on the health-close tick; it now piggybacks the hourly db_save via
 	 * health_flush_spool(), so no NAND/USB write ever lands on the 10 Hz loop. The
 	 * RAM spool is bounded: if the store is wedged/absent and the spool already tops
 	 * HLOG_MAX, skip the append rather than grow it (older rows flush first). */
-	if (g_store_dir[0] && cfg_export_mode != EXP_ONLY) {
+	if (g_store_dir[0] && (cfg_export_mode == EXP_STORE || cfg_export_mode == EXP_BOTH)) {
 		struct stat st;
 		FILE *h;
 		if (stat(HSPOOL, &st) == 0 && st.st_size > HLOG_MAX) return;
