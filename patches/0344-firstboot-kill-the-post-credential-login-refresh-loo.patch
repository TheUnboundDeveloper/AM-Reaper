From 137d96338a90026e8f20066cfbd6034cb5c7f49a Mon Sep 17 00:00:00 2001
From: reaper <theunbounddeveloper@outlook.com>
Date: Thu, 6 Aug 2026 09:10:20 -0400
Subject: [PATCH] firstboot: kill the post-credential login refresh-loop -
 recompute the index live (v2.1.6 field reports)

Field (v2.1.6, factory-fresh installs, all models): after setting custom
credentials in the first-boot wizard, the 'login window' reappears and
reloads in a tight loop with no input possible; users recovered by
reflashing stock and upgrading. Root cause: httpd caches the landing page
ONCE at startup (get_index_page -> indexpage global, httpd.c main) - on a
factory box that cache is Reaper_FirstBoot.asp, and the credential flow
never restarts httpd by design (chpass restart_httpd=0; restart_chpass =
setup_passwd only). So '/' kept serving the wizard, whose v2.1.5
done-guard (live check_pw()==0) bounced back to '/' -> infinite reload.
login_cgi's post-login meta used the same stale global, so re-login
re-entered the loop. Same root cause as the v2.1.2-era 'Could not apply
credentials' dead-end; the v2.1.5 guard just made it visible. Full
analysis: lean repo docs/LOGIN-LOOP-2026-08-06.md.

Fix, two independent layers:
- LIVE RECOMPUTE: refresh indexpage via get_index_page() at both stale
  consumers - the bare-'/' mapping (httpd.c) and login_cgi's post-login
  redirect (web.c). Cost: one nvram read + pw_dec + two stat()s on those
  requests only.
- STABLE LANDING: Reaper_FirstBoot's done-guard and finishOk() now leave
  to /Main_ReaperDash.asp explicitly, never '/'. The dashboard does not
  consult the index cache, so no future staleness can ping-pong; with a
  dropped session it lands on the login page with the dashboard as the
  stored next page.

Field workaround for existing v2.1.6 boxes: power-cycle (httpd recomputes
at start), then log in with the new credentials.

Validated: httpd compiled+linked clean via the tree sub-make (real
toolchain); FirstBoot JS parse-checked (node vm) and ASCII-clean; mock
render confirms the done-state page now lands on the dashboard. Metal
owed: factory-reset first-boot end-to-end (incl. whether do_chpass
invalidates the session token - if so the saveNvram commit dies and the
new password is RAM-only until reboot; probe on hardware). Markers
www/Reaper_FirstBoot.asp|/Main_ReaperDash.asp|2 + forbidden
location.replace("/") added to verify_markers.txt.
---
 release/src/router/httpd/httpd.c            | 12 ++++++++++-
 release/src/router/httpd/web.c              |  6 ++++++
 release/src/router/www/Reaper_FirstBoot.asp | 23 +++++++++++++++------
 3 files changed, 34 insertions(+), 7 deletions(-)

diff --git a/release/src/router/httpd/httpd.c b/release/src/router/httpd/httpd.c
index e578a613d3..5cd032e662 100644
--- a/release/src/router/httpd/httpd.c
+++ b/release/src/router/httpd/httpd.c
@@ -1604,8 +1604,18 @@ handle_request(void)
 		else if(isDeviceDiscovery == 1)
 			file = "find_device.asp";
 #endif
-		else
+		else {
+			/* reaper 2026-08-06 (field: first-boot login refresh-loop, v2.1.6 reports):
+			 * indexpage is cached ONCE at startup (main), so on a factory-default box
+			 * it stays "Reaper_FirstBoot.asp" after the credential step - the
+			 * credential flow never restarts httpd by design (chpass restart_httpd=0;
+			 * restart_chpass = setup_passwd only), so "/" kept serving the wizard,
+			 * whose done-guard bounced back to "/" -> infinite reload, GUI unusable
+			 * until an httpd restart. Recompute per bare-"/" request; the cost is one
+			 * nvram read + pw_dec + two stat()s. Twin recompute in web.c login_cgi. */
+			get_index_page(indexpage, sizeof(indexpage));
 			file = indexpage;
+		}
 	}
 
 	char *query;
diff --git a/release/src/router/httpd/web.c b/release/src/router/httpd/web.c
index d12b8671ab..00c2ca0f83 100644
--- a/release/src/router/httpd/web.c
+++ b/release/src/router/httpd/web.c
@@ -25369,6 +25369,12 @@ login_cgi(webs_t wp, char_t *url, int auth_version)
 			else
 #endif
 			{
+				/* reaper 2026-08-06: refresh the startup-cached index before using it.
+				 * On a factory box the cache still says Reaper_FirstBoot.asp after the
+				 * credential step (httpd is never restarted by that flow), which threw
+				 * a fresh post-credential login straight back into the first-boot
+				 * refresh-loop. Twin of the bare-"/" recompute in httpd.c. */
+				get_index_page(indexpage, sizeof(indexpage));
 
 				if(redirect_service_page(next_page, wp) == 0)
 				{
diff --git a/release/src/router/www/Reaper_FirstBoot.asp b/release/src/router/www/Reaper_FirstBoot.asp
index 1bc705c4a2..1dc955ed4a 100644
--- a/release/src/router/www/Reaper_FirstBoot.asp
+++ b/release/src/router/www/Reaper_FirstBoot.asp
@@ -136,7 +136,15 @@ input:focus{border-color:var(--crimson)}
      response never reached the page. Leave instead of dead-ending. */
   var RFB_PW_IS_DEFAULT=('<% check_pw(); %>'==='1');
   var RFB_FORCE_CHG=('<% nvram_get("force_chgpass"); %>'==='1');
-  if(!RFB_PW_IS_DEFAULT && !RFB_FORCE_CHG){ location.replace("/"); }
+  /* v2.2.0 (field: v2.1.6 first-boot refresh-loop): leave to the DASHBOARD, never to
+     "/". httpd's startup-cached indexpage could still say THIS page after the
+     credential step (that flow never restarts httpd), so leaving to "/" re-served the
+     wizard and this guard bounced it back - an infinite reload loop, GUI unusable.
+     The dashboard never routes back here (it does not consult the index cache), so
+     this target is structurally loop-proof; with a dead session it lands on the login
+     page with the dashboard as the stored next page - the correct flow. The cache
+     itself is also fixed (live recompute in httpd.c / web.c login_cgi). */
+  if(!RFB_PW_IS_DEFAULT && !RFB_FORCE_CHG){ location.replace("/Main_ReaperDash.asp"); }
   var DEFAULT_PW = "admin";  /* mirrors defaults.c http_passwd default */
   function $(id){return document.getElementById(id);}
   function showErr(m){var e=$("fb_err"); e.textContent=m; e.style.display="block";}
@@ -238,11 +246,14 @@ input:focus{border-color:var(--crimson)}
       tf.next_page.value="";
       tf.submit();
     }catch(e){}
-    /* Changing the admin password may drop this session. Head to "/"; state.js then
-       forces the Wi-Fi step (Advanced_Wireless_Content.asp) until a PSK is set, or
-       to the login page to re-authenticate with the new password. Wait a beat longer
-       than stock (3000ms) so the apply/commit lands before we leave. */
-    setTimeout(function(){ top.location.href = "/"; }, 3200);
+    /* Changing the admin password may drop this session. Head to the DASHBOARD
+       explicitly (v2.2.0 - never "/", which the stale httpd index cache could route
+       right back to this page; see the guard note above): with a live session it
+       lands there directly; with a dropped one it lands on the login page with the
+       dashboard as the stored next page. state.js still forces the Wi-Fi step on the
+       stock pages until a PSK is set. Wait a beat longer than stock (3000ms) so the
+       apply/commit lands before we leave. */
+    setTimeout(function(){ top.location.href = "/Main_ReaperDash.asp"; }, 3200);
   }
 
   document.addEventListener("DOMContentLoaded", function(){
-- 
