diff --git a/release/src/router/httpd/web.c b/release/src/router/httpd/web.c
index 04a484eae01..54ba2275683 100644
--- a/release/src/router/httpd/web.c
+++ b/release/src/router/httpd/web.c
@@ -24602,8 +24602,16 @@ do_reaper_export_cgi(char *url, FILE *stream)
 		/* v2.3.0: standalone master collect switch. Sets rtraf_hprobe directly,
 		 * INDEPENDENT of export - so the per-device health probe can run for the
 		 * live view + payload preview with export off. CSRF-guarded above
-		 * (action != status). Does not touch reaper_export_mode. */
+		 * (action != status). */
 		char *on = get_cgi("on");
+		/* v2.3.0 review: collection is REQUIRED while export is armed. Refuse to turn
+		 * the probe OFF from under an active exporter - it would freeze health.json
+		 * while rexport keeps POSTing the stale snapshot. Turning ON is always OK;
+		 * set the retain/send mode to Off to stop collecting. */
+		if (!(on && !strcmp(on, "1")) && !nvram_match("reaper_export_mode", "off")) {
+			websWrite(stream, "{\"ok\":0,\"export_armed\":1,\"error\":\"Set the retain/send mode to Off before turning the probe off.\"}");
+			return;
+		}
 		nvram_set("rtraf_hprobe", (on && !strcmp(on, "1")) ? "1" : "0");
 		nvram_commit();
 		notify_rc("restart_rtraf");
