From 2b01195a64ad7e7f263470ce32ba6f7f5a17ab43 Mon Sep 17 00:00:00 2001
From: reaper <theunbounddeveloper@outlook.com>
Date: Thu, 6 Aug 2026 11:33:44 -0400
Subject: [PATCH] storage: show 'collecting since' for every dataset, not just
 Devices (owner report 2026-08-06)

The Long-Term Storage 'collecting since' column only ever filled for the
Devices dataset (dev.since), so every other row showed a dash - which read as
'no dates'. Generalize it: rwatch now stamps a <ds>.since marker for each
ENABLED dataset on its first durable tick (dev/traf/watch/chq/slog);
store_status emits <ds>_since for all of them; the page looks up
S[ds.k+'_since'] per row. Still only shows on a durable store (JFFS/USB) - RAM
is volatile by design. No dict change. Metal owed: enable a dataset on a
durable store, confirm its since appears after the first rwatch tick and
survives a reboot.
---
 release/src/router/httpd/web.c            | 20 ++++++++++++++------
 release/src/router/rc/rwatch.c            | 10 +++++++++-
 release/src/router/www/Reaper_Storage.asp |  8 ++++++--
 3 files changed, 29 insertions(+), 9 deletions(-)

diff --git a/release/src/router/httpd/web.c b/release/src/router/httpd/web.c
index 00c2ca0f83..dfec3d87df 100644
--- a/release/src/router/httpd/web.c
+++ b/release/src/router/httpd/web.c
@@ -24086,13 +24086,21 @@ static void do_reaper_dev_cgi(char *url, FILE *stream)
 		gk_json_esc(stream, nvram_safe_get("reaper_store_ds"));
 		websWrite(stream, ",\"free\":%llu,\"total\":%llu,", freeb, totb);
 
-		/* per-dataset facts: durable file size + first-collection marker */
-		snprintf(path, sizeof(path), "%s/dev.since", base);
+		/* per-dataset facts: durable file size + first-collection marker.
+		 * 2026-08-06: emit a since for EVERY dataset (rwatch stamps <ds>.since on
+		 * the first durable tick after each is enabled) so the Storage page can
+		 * show "collecting since" per row, not just for Devices. */
 		{
-			long since = 0;
-			FILE *sf = fopen(path, "r");
-			if (sf) { if (fscanf(sf, "%ld", &since) != 1) since = 0; fclose(sf); }
-			websWrite(stream, "\"dev_since\":%ld,", since);
+			static const char *since_ds[] = { "dev", "traf", "watch", "chq", "slog", NULL };
+			int di;
+			for (di = 0; since_ds[di]; di++) {
+				long since = 0;
+				FILE *sf;
+				snprintf(path, sizeof(path), "%s/%s.since", base, since_ds[di]);
+				sf = fopen(path, "r");
+				if (sf) { if (fscanf(sf, "%ld", &since) != 1) since = 0; fclose(sf); }
+				websWrite(stream, "\"%s_since\":%ld,", since_ds[di], since);
+			}
 		}
 		snprintf(path, sizeof(path), "%s/devhist.log", base);
 		websWrite(stream, "\"dev_bytes\":%lld,", (stat(path, &st) == 0) ? (long long)st.st_size : 0LL);
diff --git a/release/src/router/rc/rwatch.c b/release/src/router/rc/rwatch.c
index a4ec5eb8ac..18a60770ff 100644
--- a/release/src/router/rc/rwatch.c
+++ b/release/src/router/rc/rwatch.c
@@ -202,6 +202,15 @@ static void rwatch_gen(void)
 	  "# Nothing is written when the store is volatile (RAM): durability is opt-in.\n"
 	  "NOWH=$(date +%s)\n"
 	  "\n"
+	  "# 0) 'collecting since' marker per ENABLED dataset (2026-08-06: the Storage\n"
+	  "#    page only ever showed a date for 'dev'; stamp every enabled dataset the\n"
+	  "#    first durable tick after it is turned on so each row can show a since).\n"
+	  "if [ \"$VOLATILE\" = 0 ]; then\n"
+	  "  for _ds in dev traf watch chq slog; do\n"
+	  "    case \"$DS\" in *,$_ds,*) [ -f \"$BASE/$_ds.since\" ] || echo \"$NOWH\" > \"$BASE/$_ds.since\" ;; esac\n"
+	  "  done\n"
+	  "fi\n"
+	  "\n"
 	  "# 1) device presence deltas (join/leave of active LAN devices) -> capped ring\n"
 	  "case \"$DS\" in *,dev,*)\n"
 	  "  if [ \"$VOLATILE\" = 0 ]; then\n"
@@ -215,7 +224,6 @@ static void rwatch_gen(void)
 	  "    if [ -f \"$BASE/devhist.log\" ]; then\n"
 	  "      LN=$(wc -l < \"$BASE/devhist.log\" 2>/dev/null || echo 0)\n"
 	  "      [ \"$LN\" -gt 5000 ] && { tail -n 5000 \"$BASE/devhist.log\" > \"$BASE/devhist.log.r\" 2>/dev/null && mv \"$BASE/devhist.log.r\" \"$BASE/devhist.log\"; }\n"
-	  "      [ -f \"$BASE/dev.since\" ] || echo \"$NOWH\" > \"$BASE/dev.since\"\n"
 	  "    fi\n"
 	  "  fi ;;\n"
 	  "esac\n"
diff --git a/release/src/router/www/Reaper_Storage.asp b/release/src/router/www/Reaper_Storage.asp
index 806897f41a..90833079fb 100644
--- a/release/src/router/www/Reaper_Storage.asp
+++ b/release/src/router/www/Reaper_Storage.asp
@@ -201,8 +201,12 @@ function render(){
     } else {
       var on = !!dsOn[ds.k];
       tog = '<span class="tg' + (on ? ' on' : '') + '" data-k="' + ds.k + '"></span>';
-      since = (ds.k === 'dev' && durable && S && S.dev_since)
-            ? fmtDate(S.dev_since) : '<span style="color:var(--steel)">&mdash;</span>';
+      /* 2026-08-06: per-dataset "collecting since" (was Devices-only). rwatch
+         stamps <ds>.since on the first durable tick after a dataset is enabled;
+         store_status now returns dev_since/traf_since/watch_since/chq_since/slog_since. */
+      var sinceEpoch = (S && S[ds.k + '_since']) ? S[ds.k + '_since'] : 0;
+      since = (durable && sinceEpoch)
+            ? fmtDate(sinceEpoch) : '<span style="color:var(--steel)">&mdash;</span>';
     }
     el += '<tr>' +
       '<td>' + tog + '</td>' +
-- 
