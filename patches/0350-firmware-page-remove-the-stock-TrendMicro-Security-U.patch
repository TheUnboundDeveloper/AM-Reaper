From 8f9cd55a86ec9f20aab68ddbdaea97d909e34750 Mon Sep 17 00:00:00 2001
From: reaper <theunbounddeveloper@outlook.com>
Date: Thu, 6 Aug 2026 11:33:46 -0400
Subject: [PATCH] firmware-page: remove the stock TrendMicro 'Security Update'
 section (de-cloud, owner request 2026-08-06)

The firmware upgrade page still rendered the stock 'Security Update'
(Secur_Stab_auto_upgrade) section - an ASUS-cloud TrendMicro signature
auto-upgrade toggle (httpApi.securityUpdate + the ASUS privacy-policy modal)
that does nothing on the de-clouded build. Removed. The stock auto-firmware
scheduler above it is already stripped at load (afwupg_support=false), and
Reaper's own update check is unchanged and already correct: the
firmware_check_enable Yes/No toggle drives the scheduled check and the Check
button fires start_webs_update -> the installed webs_update.sh, which IS
reaper_webs_update.sh (the AM-Reaper GitHub manifest check). No orphan refs
(verified: 0 remaining references to secur_stab_setting).
---
 .../www/Advanced_FirmwareUpgrade_Content.asp  | 58 +++----------------
 1 file changed, 8 insertions(+), 50 deletions(-)

diff --git a/release/src/router/www/Advanced_FirmwareUpgrade_Content.asp b/release/src/router/www/Advanced_FirmwareUpgrade_Content.asp
index 5aadb2210f..d510f61aed 100644
--- a/release/src/router/www/Advanced_FirmwareUpgrade_Content.asp
+++ b/release/src/router/www/Advanced_FirmwareUpgrade_Content.asp
@@ -2052,56 +2052,14 @@ function get_mobile_fw_upgrade_status(){
 			</tr>
 		</table>
 
-		<table id="secur_stab_setting" width="100%" border="1" align="center" cellpadding="4" cellspacing="0" bordercolor="#6b8fa3" class="FormTable">
-			<thead>
-			<tr>
-				<td colspan="2"><#Secur_Stab_auto_upgrade#></td>
-			</tr>	
-			</thead>
-			<tr>
-				<th><#Secur_Stab_auto_upgrade#></th>
-				<td>
-					<div align="center" class="left" style="width:75px; float:left; cursor:pointer;" id="switch_security_update_enable"></div>
-					<script type="text/javascript">
-						$('#switch_security_update_enable').iphoneSwitch(httpApi.securityUpdate.get(),
-								function () {
-									//on
-									PolicyStatus()
-                                        .then(data => {
-                                            if (data.PP < 1) {
-                                                const policyModal = new PolicyModalComponent({
-                                                    policy: "PP",
-                                                    policyStatus: data,
-                                                    agreeCallback: () => {
-                                                        httpApi.securityUpdate.set(1);
-                                                    },
-                                                    knowRiskCallback: () => {
-                                                        alert(`<#ASUS_POLICY_Function_Confirm#>`);
-                                                        location.reload();
-                                                    }
-                                                });
-                                                policyModal.show();
-                                                return false;
-                                            } else {
-                                                httpApi.securityUpdate.set(1);
-                                            }
-                                        });
-								},
-								function () {
-									//off
-									httpApi.securityUpdate.set(0);
-								}
-						);
-					</script>
-				</td>	
-			</tr>
-
-			<tr>
-				<td colspan="2">
-					<#Secur_Stab_auto_upgrade_desc#>
-				</td>
-			</tr>
-		</table>
+		<!-- reaper de-cloud (2026-08-06): the stock "Security Update" (TrendMicro
+		     signature auto-upgrade) section is removed. It is ASUS cloud machinery
+		     (httpApi.securityUpdate + the ASUS privacy-policy modal) that does
+		     nothing on the de-clouded build; the stock auto-firmware-upgrade
+		     scheduler above it is likewise already stripped at load
+		     (afwupg_support=false). Reaper's own update check is the
+		     firmware_check_enable toggle + the Check button below, which drive the
+		     GitHub manifest check (reaper_webs_update.sh). -->
 
 		<table width="100%" border="1" align="center" cellpadding="4" cellspacing="0" bordercolor="#6b8fa3" class="FormTable">
 			<thead>
-- 
