+/* ===================================================================
+ * reaper v2.2.2: analytics export configuration (Reaper_Analytics.asp) +
+ * Prometheus scrape endpoint. The per-device health snapshot is produced by
+ * rtrafd (/tmp/rtraf/health.json); rc/rexport.c pushes it; this pair configures
+ * the exporter and serves the pull-model metrics.
+ * =================================================================== */
+
+/* random bearer token for the Prometheus scrape endpoint */
+static void gen_scrape_token(char *out, size_t n)
+{
+	static const char hex[] = "0123456789abcdef";
+	unsigned char r[16];
+	FILE *f;
+	size_t i;
+	strlcpy(out, "rpx_", n);
+	if ((f = fopen("/dev/urandom", "r")) != NULL) {
+		if (fread(r, 1, sizeof(r), f) == sizeof(r)) {
+			for (i = 0; i < sizeof(r) && (4 + i * 2 + 1) < n; i++) {
+				out[4 + i * 2]     = hex[r[i] >> 4];
+				out[4 + i * 2 + 1] = hex[r[i] & 0xf];
+			}
+			out[4 + sizeof(r) * 2] = '\0';
+		}
+		fclose(f);
+	}
+}
+
+static void
+do_reaper_export_cgi(char *url, FILE *stream)
+{
+	char *action = get_cgi("action");
+	if (!action) action = "status";
+
+	/* CSRF guard on every state-changing / subprocess action (status is read-only) */
+	if (strcmp(action, "status") != 0) {
+		char *hid = get_cgi("http_id"), *want = nvram_safe_get("http_id");
+		if (!hid || !want[0] || strcmp(hid, want) != 0) {
+			websWrite(stream, "{\"ok\":0,\"error\":\"invalid request token\"}");
+			return;
+		}
+	}
+
+	if (!strcmp(action, "status")) {
+		const char *tok = nvram_safe_get("reaper_export_token");
+		const char *scr = nvram_safe_get("reaper_export_scrape_token");
+		const char *xm  = nvram_safe_get("reaper_export_mode");
+		int tlen = strlen(tok), iv = nvram_get_int("reaper_export_interval");
+		char last[8] = "", sbuf[160] = "";
+		FILE *sf;
+		if (tlen >= 4) strlcpy(last, tok + tlen - 4, sizeof(last));
+		if ((sf = fopen("/tmp/rexport.status", "r")) != NULL) {
+			if (fgets(sbuf, sizeof(sbuf), sf)) { char *nl = strchr(sbuf, '\n'); if (nl) *nl = '\0'; }
+			fclose(sf);
+		}
+		websWrite(stream, "{\"mode\":\"%s\",\"engine\":", xm[0] ? xm : "off");
+		gk_json_esc(stream, nvram_safe_get("reaper_export_engine"));
+		websWrite(stream, ",\"url\":");
+		gk_json_esc(stream, nvram_safe_get("reaper_export_url"));
+		websWrite(stream, ",\"token_set\":%d,\"token_last4\":\"%s\"", tlen > 0 ? 1 : 0, last);
+		websWrite(stream, ",\"tlsverify\":%d", nvram_match("reaper_export_tlsverify", "0") ? 0 : 1);
+		websWrite(stream, ",\"interval\":%d", iv > 0 ? iv : 60);
+		websWrite(stream, ",\"metrics\":");
+		gk_json_esc(stream, nvram_safe_get("reaper_export_metrics"));
+		websWrite(stream, ",\"index\":");
+		gk_json_esc(stream, nvram_safe_get("reaper_export_index"));
+		websWrite(stream, ",\"source\":");
+		gk_json_esc(stream, nvram_safe_get("reaper_export_source"));
+		websWrite(stream, ",\"maskmac\":%d,\"scrape_set\":%d,\"scrape_token\":",
+			nvram_match("reaper_export_maskmac", "1") ? 1 : 0, scr[0] ? 1 : 0);
+		gk_json_esc(stream, scr);	/* shown to the admin for their prometheus.yml */
+		websWrite(stream, ",\"last\":");
+		gk_json_esc(stream, sbuf);
+		websWrite(stream, "}");
+		return;
+	}
+
+	if (!strcmp(action, "save")) {
+		char *v;
+		if ((v = get_cgi("mode")) && (!strcmp(v, "off") || !strcmp(v, "both") || !strcmp(v, "exportonly")))
+			nvram_set("reaper_export_mode", v);
+		if ((v = get_cgi("engine")))   nvram_set("reaper_export_engine", v);
+		if ((v = get_cgi("url")))      nvram_set("reaper_export_url", v);
+		if ((v = get_cgi("token")) && v[0]) nvram_set("reaper_export_token", v);	/* blank = keep existing */
+		if ((v = get_cgi("cleartoken")) && !strcmp(v, "1")) nvram_set("reaper_export_token", "");
+		if ((v = get_cgi("tlsv")))     nvram_set("reaper_export_tlsverify", strcmp(v, "0") ? "1" : "0");
+		if ((v = get_cgi("interval"))) {
+			int n = atoi(v); char b[12];
+			if (n < 10) n = 10; if (n > 3600) n = 3600;
+			snprintf(b, sizeof(b), "%d", n); nvram_set("reaper_export_interval", b);
+		}
+		if ((v = get_cgi("metrics")))  nvram_set("reaper_export_metrics", v);
+		if ((v = get_cgi("index")))    nvram_set("reaper_export_index", v);
+		if ((v = get_cgi("source")))   nvram_set("reaper_export_source", v);
+		if ((v = get_cgi("maskmac")))  nvram_set("reaper_export_maskmac", strcmp(v, "1") ? "0" : "1");
+		if ((v = get_cgi("regen_scrape")) && !strcmp(v, "1")) {
+			char t[40]; gen_scrape_token(t, sizeof(t)); nvram_set("reaper_export_scrape_token", t);
+		}
+		/* export requires the per-device health probe to have data to send */
+		if (!nvram_match("reaper_export_mode", "off")) nvram_set("rtraf_hprobe", "1");
+		nvram_commit();
+		notify_rc("restart_rtraf");
+		notify_rc("restart_rexport");
+		websWrite(stream, "{\"ok\":1}");
+		return;
+	}
+
+	if (!strcmp(action, "test")) {
+		char sbuf[160] = "";
+		FILE *sf;
+		if (!f_exists("/tmp/rexport.sh")) {
+			websWrite(stream, "{\"ok\":0,\"error\":\"save the configuration first\"}");
+			return;
+		}
+		doSystem("sh /tmp/rexport.sh test");
+		if ((sf = fopen("/tmp/rexport.status", "r")) != NULL) {
+			if (fgets(sbuf, sizeof(sbuf), sf)) { char *nl = strchr(sbuf, '\n'); if (nl) *nl = '\0'; }
+			fclose(sf);
+		}
+		websWrite(stream, "{\"ok\":1,\"result\":");
+		gk_json_esc(stream, sbuf);
+		websWrite(stream, "}");
+		return;
+	}
+
+	websWrite(stream, "{\"ok\":0,\"error\":\"unknown action\"}");
+}
+
+/* Prometheus scrape endpoint. Public (no session) but bearer-token gated via
+ * ?token=<reaper_export_scrape_token> so Prometheus can authenticate the scrape;
+ * serves the OpenMetrics text rtrafd renders at /tmp/rtraf/metrics.prom. */
+static void
+do_reaper_metrics_cgi(char *url, FILE *stream)
+{
+	char *tok = get_cgi("token");
+	const char *want = nvram_safe_get("reaper_export_scrape_token");
+	FILE *f;
+	char line[512];
+	if (!want[0] || !tok || strcmp(tok, want) != 0) {
+		websWrite(stream, "# unauthorized: a valid ?token= is required\n");
+		return;
+	}
+	if ((f = fopen("/tmp/rtraf/metrics.prom", "r")) == NULL) {
+		websWrite(stream, "# no metrics available (enable the connection-health probe)\n");
+		return;
+	}
+	while (fgets(line, sizeof(line), f)) websWrite(stream, "%s", line);
+	fclose(f);
+}
