@@ -0,0 +1,359 @@
+<!-- SPDX-License-Identifier: GPL-2.0-only
+     Copyright (C) 2026 the Reaper project maintainer
+     Part of the Reaper hardened Asuswrt-Merlin build. See LICENSE / LICENSE.reaper.
+     reaper v2.2.2: Data Export - configure per-device connection-health export to
+     an analytics engine (Splunk/Datadog/Dynatrace/Elastic/Generic/OTLP/Syslog push,
+     or a Prometheus scrape endpoint). Reads/writes via reaper_export.cgi; the health
+     snapshot is produced by rtrafd and pushed by rc/rexport.c. -->
+<!DOCTYPE html>
+<html lang="en">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width, initial-scale=1">
+<meta name="reaper-native" content="1">
+<title>REAPER &mdash; <#RANL_00#></title>
+<style>
+@font-face{font-family:'Rajdhani';font-weight:600;font-display:swap;src:url('/fonts/rajdhani-600.woff2') format('woff2')}
+@font-face{font-family:'Rajdhani';font-weight:700;font-display:swap;src:url('/fonts/rajdhani-700.woff2') format('woff2')}
+@font-face{font-family:'Inter';font-weight:400;font-display:swap;src:url('/fonts/inter-400.woff2') format('woff2')}
+@font-face{font-family:'Inter';font-weight:600;font-display:swap;src:url('/fonts/inter-600.woff2') format('woff2')}
+:root{
+  --bg:#08080a; --panel:#0f0f12; --panel-2:#141418; --panel-3:#191920;
+  --line:rgba(225,6,0,.16); --line-soft:rgba(255,255,255,.06); --line-mid:rgba(255,255,255,.12);
+  --crimson:#E10600; --crimson-deep:#B3000C;
+  --bone:#ECE7DB; --bone-dim:#B7B1A4; --steel:#71767b;
+  --jade:#4FB286; --amber:#d9a441; --danger:#FF3B30;
+  --hdr:'Rajdhani','Oswald',system-ui,sans-serif;
+  --body:'Inter',system-ui,-apple-system,'Segoe UI',sans-serif;
+}
+*{box-sizing:border-box;margin:0}
+html,body{background:var(--bg)}
+body{font-family:var(--body);color:var(--bone-dim);font-size:13.5px;line-height:1.55;padding:20px 22px 60px}
+h1,h2,h3{font-family:var(--hdr);letter-spacing:.04em;color:var(--bone);margin:0}
+.pagehead{display:flex;align-items:center;gap:16px;flex-wrap:wrap;margin-bottom:4px;max-width:1120px}
+.pagehead h1{font-size:24px;font-weight:700}
+.statuspill{font-family:var(--hdr);font-weight:600;font-size:11px;letter-spacing:.1em;text-transform:uppercase;border-radius:20px;padding:4px 12px;border:1px solid var(--line);color:var(--jade)}
+.statuspill.off{color:var(--steel);border-color:var(--line-soft)}
+.lede{max-width:76ch;margin:6px 0 18px}
+.lede b{color:var(--bone);font-weight:600}
+.card{background:var(--panel);border:1px solid var(--line-soft);border-radius:12px;padding:16px 18px;margin-bottom:16px;max-width:1120px}
+.card>h2{font-size:13px;text-transform:uppercase;letter-spacing:.1em;margin-bottom:12px;padding-bottom:8px;border-bottom:1px solid var(--line-soft);color:var(--bone);display:flex;align-items:center;gap:10px}
+.card>h2 .hint{font-family:var(--body);font-weight:400;letter-spacing:0;text-transform:none;font-size:11.5px;color:var(--steel);margin-left:auto}
+.row{display:flex;align-items:center;gap:12px;flex-wrap:wrap;margin:9px 0}
+.row .lbl{font-size:11px;text-transform:uppercase;letter-spacing:.1em;color:var(--steel);min-width:120px}
+.grid2{display:grid;grid-template-columns:130px 1fr;gap:11px 14px;align-items:center}
+.grid2 .lbl{font-size:11px;text-transform:uppercase;letter-spacing:.1em;color:var(--steel)}
+.fchip{font-size:11.5px;border:1px solid var(--line-mid);border-radius:16px;padding:4px 13px;color:var(--bone-dim);cursor:pointer;user-select:none}
+.fchip.on{border-color:var(--crimson-deep);color:var(--bone);background:rgba(225,6,0,.10)}
+.pchip{font-family:var(--hdr);font-weight:600;font-size:12px;letter-spacing:.03em;border:1px solid var(--line-mid);border-radius:7px;padding:7px 13px;color:var(--bone-dim);cursor:pointer;user-select:none;display:inline-flex;align-items:center;gap:7px}
+.pchip .g{width:6px;height:6px;border-radius:50%;background:var(--steel)}
+.pchip.on{border-color:var(--crimson-deep);color:var(--bone);background:rgba(225,6,0,.09)}
+.pchip.on .g{background:var(--crimson)}
+.tg{position:relative;width:40px;height:21px;border-radius:12px;background:#26262c;border:1px solid var(--line-mid);cursor:pointer;display:inline-block;vertical-align:middle;flex:none}
+.tg::after{content:"";position:absolute;top:2px;left:2px;width:15px;height:15px;border-radius:50%;background:var(--steel);transition:.15s}
+.tg.on{background:#33333a}
+.tg.on::after{left:21px;background:var(--bone)}
+input.fld,select.fld{width:100%;max-width:520px;background:var(--panel-3);border:1px solid var(--line-mid);border-radius:7px;color:var(--bone);font-family:var(--body);font-size:13px;padding:8px 11px}
+input.fld:focus,select.fld:focus{outline:2px solid rgba(225,6,0,.4);outline-offset:1px;border-color:var(--crimson-deep)}
+.fld.mono{font-family:ui-monospace,'Cascadia Code',Consolas,monospace;letter-spacing:.02em}
+.suffix{font-size:12px;color:var(--steel)}
+.btn{font-family:var(--hdr);font-weight:600;letter-spacing:.06em;text-transform:uppercase;font-size:12px;color:#fff;background:linear-gradient(180deg,var(--crimson),var(--crimson-deep));border:1px solid transparent;border-radius:8px;padding:9px 18px;cursor:pointer}
+.btn.ghost{background:transparent;border:1px solid var(--line-mid);color:var(--bone-dim)}
+.btn.ghost:hover{border-color:var(--crimson-deep);color:var(--bone)}
+.btn[disabled]{opacity:.4;cursor:not-allowed}
+.note{font-size:12px;color:var(--steel);line-height:1.55;margin-top:6px}
+.warnnote{font-size:12px;color:var(--amber);margin-top:6px;display:none}
+.saved{font-size:12px;color:var(--jade)}
+.saved.err{color:var(--danger)}
+.readout{display:flex;gap:26px;flex-wrap:wrap}
+.readout .kv{display:flex;flex-direction:column;gap:2px}
+.readout .k{font-size:10px;letter-spacing:.13em;text-transform:uppercase;color:var(--steel)}
+.readout .v{font-family:var(--hdr);font-weight:600;font-size:19px;color:var(--bone)}
+.readout .v.ok{color:var(--jade)}
+pre.payload{background:#0a0a0c;border:1px solid var(--line-soft);border-radius:8px;padding:12px 14px;overflow-x:auto;font-family:ui-monospace,Consolas,monospace;font-size:11.5px;color:var(--bone-dim);line-height:1.5;margin-top:10px;max-width:1120px;white-space:pre-wrap;word-break:break-word}
+.hidden{display:none}
+</style>
+</head>
+<body>
+<div class="pagehead">
+  <h1><#RANL_00#></h1>
+  <span class="statuspill off" id="pill">&nbsp;</span>
+</div>
+<p class="lede"><#RANL_01#></p>
+
+<div class="card">
+  <h2><#RANL_02#></h2>
+  <div class="row" style="margin-top:0">
+    <span class="lbl"><#RANL_38#></span>
+    <span class="tg" id="enTg"></span>
+    <span class="suffix" id="enTxt">&nbsp;</span>
+  </div>
+  <div class="readout" style="margin-top:12px">
+    <div class="kv"><span class="k"><#RANL_06#></span><span class="v" id="ro_dest">&mdash;</span></div>
+    <div class="kv"><span class="k"><#RANL_07#></span><span class="v" id="ro_last">&mdash;</span></div>
+  </div>
+</div>
+
+<div class="card">
+  <h2><#RANL_08#></h2>
+  <div class="row" id="presets" style="margin-top:0">
+    <span class="pchip" data-e="splunk"><span class="g"></span>Splunk HEC</span>
+    <span class="pchip" data-e="datadog"><span class="g"></span>Datadog</span>
+    <span class="pchip" data-e="dynatrace"><span class="g"></span>Dynatrace</span>
+    <span class="pchip" data-e="elastic"><span class="g"></span>Elastic / Kibana</span>
+    <span class="pchip" data-e="prometheus"><span class="g"></span>Prometheus</span>
+    <span class="pchip" data-e="otlp"><span class="g"></span>OpenTelemetry</span>
+    <span class="pchip" data-e="syslog"><span class="g"></span>Syslog (TLS)</span>
+    <span class="pchip" data-e="generic"><span class="g"></span>Generic HTTP</span>
+  </div>
+  <p class="note" id="engNote">&nbsp;</p>
+</div>
+
+<div class="card" id="pushCard">
+  <h2><#RANL_09#></h2>
+  <div class="grid2">
+    <span class="lbl"><#RANL_10#></span>
+    <input class="fld mono" id="urlFld" placeholder="https://collector.example:8088/services/collector">
+    <span class="lbl"><#RANL_11#></span>
+    <div style="display:flex;gap:10px;align-items:center;flex-wrap:wrap">
+      <input class="fld mono" id="tokFld" style="max-width:340px">
+      <button class="btn ghost" id="tokBtn" onclick="editTok()"><#RANL_12#></button>
+    </div>
+    <span class="lbl splunkonly"><#RANL_17#></span>
+    <input class="fld splunkonly" id="idxFld" style="max-width:260px" placeholder="network">
+    <span class="lbl splunkonly"><#RANL_18#></span>
+    <input class="fld splunkonly" id="srcFld" style="max-width:280px" placeholder="reaper:client_health">
+    <span class="lbl"><#RANL_13#></span>
+    <div style="display:flex;align-items:center;gap:11px">
+      <span class="tg on" id="tlsTg" onclick="tlsToggle()"></span>
+      <span class="suffix" id="tlsTxt"><#RANL_14#></span>
+    </div>
+  </div>
+  <p class="warnnote" id="tlsWarn"><#RANL_16#></p>
+</div>
+
+<div class="card hidden" id="pullCard">
+  <h2><#RANL_19#> <span class="hint">Prometheus</span></h2>
+  <p class="note" style="margin-top:0"><#RANL_20#></p>
+  <div class="grid2" style="margin-top:12px">
+    <span class="lbl"><#RANL_21#></span>
+    <div style="display:flex;gap:10px;align-items:center;flex-wrap:wrap">
+      <input class="fld mono" id="scrapeUrl" style="max-width:440px" readonly>
+      <button class="btn ghost" onclick="copyFld('scrapeUrl',this)"><#RANL_23#></button>
+    </div>
+    <span class="lbl"><#RANL_22#></span>
+    <div style="display:flex;gap:10px;align-items:center;flex-wrap:wrap">
+      <input class="fld mono" id="scrapeTok" style="max-width:340px" readonly>
+      <button class="btn ghost" onclick="copyFld('scrapeTok',this)"><#RANL_23#></button>
+      <button class="btn ghost" onclick="regenScrape(this)"><#RANL_24#></button>
+    </div>
+  </div>
+  <pre class="payload" id="promYml">&nbsp;</pre>
+</div>
+
+<div class="card">
+  <h2><#RANL_25#></h2>
+  <div class="row"><span class="lbl"><#RANL_25#></span>
+    <span class="fchip mchip" data-m="lat"><#RANL_26#></span>
+    <span class="fchip mchip" data-m="tcp"><#RANL_27#></span>
+    <span class="fchip mchip" data-m="thru"><#RANL_28#></span>
+  </div>
+  <div class="row"><span class="lbl"><#RANL_29#></span>
+    <input class="fld" id="ivFld" style="max-width:90px" value="60"><span class="suffix"><#RANL_30#></span>
+  </div>
+  <div class="row"><span class="lbl">&nbsp;</span>
+    <span class="tg" id="maskTg" onclick="this.classList.toggle('on')"></span>
+    <span class="suffix"><#RANL_31#></span>
+  </div>
+  <div class="row" style="margin-top:4px">
+    <button class="btn ghost" onclick="preview(this)"><#RANL_32#></button>
+    <span class="note" style="margin:0"><#RANL_33#></span>
+  </div>
+  <pre class="payload hidden" id="previewBox">&nbsp;</pre>
+</div>
+
+<div class="card">
+  <h2><#RANL_34#></h2>
+  <div class="row" style="margin:0">
+    <button class="btn ghost" id="testBtn" onclick="runTest(this)"><#RANL_35#></button>
+    <span class="saved" id="testMsg" style="display:none">&nbsp;</span>
+  </div>
+</div>
+
+<div style="max-width:1120px;display:flex;align-items:center;gap:14px">
+  <button class="btn" id="saveBtn" onclick="save()"><#RANL_36#></button>
+  <span class="saved" id="saved" style="display:none">&nbsp;</span>
+</div>
+
+<script>
+var REAPER_HTTPID = '<% nvram_get("http_id"); %>';
+var C = null;             /* last loaded config */
+var engine = 'splunk';
+var tokenDirty = false;
+var mets = { lat:1, tcp:1, thru:1 };
+
+function esc(s){ return String(s==null?'':s).replace(/[&<>"']/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];}); }
+function $(id){ return document.getElementById(id); }
+
+var ENGNOTE = {
+  splunk:`<#RANL_39#>`, datadog:`<#RANL_39#>`, dynatrace:`<#RANL_39#>`,
+  elastic:`<#RANL_39#>`, generic:`<#RANL_39#>`, otlp:`<#RANL_39#>`,
+  syslog:`<#RANL_39#>`, prometheus:`<#RANL_40#>`
+};
+
+function xhr(method, url, cb){
+  var x = new XMLHttpRequest();
+  x.open(method, url + (url.indexOf('?')<0?'?':'&') + '_=' + Date.now(), true);
+  x.timeout = 30000;
+  x.onreadystatechange = function(){
+    if(x.readyState !== 4) return;
+    var j = null;
+    if(x.status === 200){ try{ j = JSON.parse(x.responseText); }catch(e){ j = { _raw:x.responseText }; } }
+    cb(j);
+  };
+  x.send();
+}
+
+function setEngine(e){
+  engine = e;
+  Array.prototype.forEach.call(document.querySelectorAll('#presets .pchip'), function(c){
+    c.className = 'pchip' + (c.getAttribute('data-e') === e ? ' on' : '');
+  });
+  $('engNote').innerHTML = (ENGNOTE[e] || '');
+  var pull = (e === 'prometheus');
+  $('pushCard').className = 'card' + (pull ? ' hidden' : '');
+  $('pullCard').className = 'card' + (pull ? '' : ' hidden');
+  Array.prototype.forEach.call(document.querySelectorAll('.splunkonly'), function(n){ n.style.display = (e === 'splunk') ? '' : 'none'; });
+  if(pull) renderScrape();
+}
+
+function renderScrape(){
+  var origin = window.location.origin;
+  var tok = (C && C.scrape_token) ? C.scrape_token : '';
+  $('scrapeUrl').value = origin + '/reaper_metrics.cgi';
+  $('scrapeTok').value = tok || '(none - Regenerate)';
+  var yml = "scrape_configs:\n  - job_name: 'reaper'\n    scheme: https\n    metrics_path: /reaper_metrics.cgi\n    params: { token: ['" + (tok || 'YOUR_TOKEN') + "'] }\n    static_configs: [{ targets: ['" + window.location.host + "'] }]";
+  $('promYml').textContent = yml;
+}
+
+function tlsToggle(){
+  var t = $('tlsTg'); t.classList.toggle('on');
+  var on = t.classList.contains('on');
+  $('tlsTxt').innerHTML = on ? `<#RANL_14#>` : `<#RANL_15#>`;
+  $('tlsWarn').style.display = on ? 'none' : 'block';
+}
+function editTok(){ var f = $('tokFld'); f.readOnly = false; f.value = ''; tokenDirty = true; f.focus(); }
+
+function render(){
+  setEngine(C.engine || 'splunk');
+  $('urlFld').value = C.url || '';
+  if(C.token_set){ $('tokFld').value = '****' + (C.token_last4 || ''); $('tokFld').readOnly = true; tokenDirty = false; }
+  else { $('tokFld').value = ''; $('tokFld').readOnly = false; tokenDirty = true; }
+  $('idxFld').value = C.index || '';
+  $('srcFld').value = C.source || '';
+  $('tlsTg').className = 'tg' + (C.tlsverify ? ' on' : '');
+  $('tlsTxt').innerHTML = C.tlsverify ? `<#RANL_14#>` : `<#RANL_15#>`;
+  $('tlsWarn').style.display = C.tlsverify ? 'none' : 'block';
+  $('ivFld').value = C.interval || 60;
+  $('maskTg').className = 'tg' + (C.maskmac ? ' on' : '');
+  mets = { lat:0, tcp:0, thru:0 };
+  (C.metrics || 'lat,tcp,thru').split(',').forEach(function(m){ m = m.trim(); if(m) mets[m] = 1; });
+  Array.prototype.forEach.call(document.querySelectorAll('.mchip'), function(c){
+    var k = c.getAttribute('data-m');
+    c.className = 'fchip mchip' + (mets[k] ? ' on' : '');
+    c.onclick = function(){ mets[k] = mets[k] ? 0 : 1; c.className = 'fchip mchip' + (mets[k] ? ' on' : ''); };
+  });
+  var on = (C.mode === 'both' || C.mode === 'exportonly');
+  $('enTg').className = 'tg' + (on ? ' on' : '');
+  $('enTxt').textContent = on ? `<#RANL_04#>` : `<#RANL_05#>`;
+  var pill = $('pill');
+  pill.className = 'statuspill' + (on ? '' : ' off');
+  pill.textContent = on ? `<#RANL_04#>` : `<#RANL_05#>`;
+  $('ro_dest').textContent = C.engine ? C.engine : '-';
+  $('ro_last').textContent = (C.last && C.last.length) ? C.last : `<#RANL_41#>`;
+}
+
+$('enTg').onclick = function(){ this.classList.toggle('on');
+  var on = this.classList.contains('on');
+  $('enTxt').textContent = on ? `<#RANL_04#>` : `<#RANL_05#>`; };
+
+Array.prototype.forEach.call(document.querySelectorAll('#presets .pchip'), function(c){
+  c.onclick = function(){ setEngine(c.getAttribute('data-e')); };
+});
+
+function copyFld(id, b){ var f = $(id); f.select();
+  try{ document.execCommand('copy'); }catch(e){}
+  var o = b.textContent; b.textContent = `<#RANL_42#>`; setTimeout(function(){ b.textContent = o; }, 1000); }
+
+function regenScrape(b){
+  b.disabled = true;
+  xhr('GET', '/reaper_export.cgi?action=save&regen_scrape=1&http_id=' + encodeURIComponent(REAPER_HTTPID), function(j){
+    b.disabled = false; load();
+  });
+}
+
+function preview(b){
+  var box = $('previewBox');
+  if(!box.classList.contains('hidden')){ box.classList.add('hidden'); return; }
+  xhr('GET', '/reaper_traffic.cgi?f=health', function(j){
+    var txt;
+    try{ txt = JSON.stringify(j, null, 2); }catch(e){ txt = (j && j._raw) || '{}'; }
+    box.textContent = txt;
+    box.classList.remove('hidden');
+  });
+}
+
+function runTest(b){
+  b.disabled = true; b.textContent = `<#RANL_43#>`;
+  var m = $('testMsg'); m.style.display = 'none';
+  xhr('GET', '/reaper_export.cgi?action=test&http_id=' + encodeURIComponent(REAPER_HTTPID), function(j){
+    b.disabled = false; b.textContent = `<#RANL_35#>`;
+    m.className = 'saved' + (j && j.ok ? '' : ' err');
+    m.textContent = (j && j.result) ? j.result : (j && j.error) ? j.error : 'error';
+    m.style.display = '';
+  });
+}
+
+function metricList(){ var a = []; ['lat','tcp','thru'].forEach(function(k){ if(mets[k]) a.push(k); }); return a.join(','); }
+
+function save(){
+  var b = $('saveBtn'); b.disabled = true;
+  var mode = $('enTg').classList.contains('on')
+    ? ((C && C.mode === 'exportonly') ? 'exportonly' : 'both') : 'off';
+  var tlsv = $('tlsTg').classList.contains('on') ? '1' : '0';
+  var maskmac = $('maskTg').classList.contains('on') ? '1' : '0';
+  var q = '/reaper_export.cgi?action=save'
+    + '&mode=' + encodeURIComponent(mode)
+    + '&engine=' + encodeURIComponent(engine)
+    + '&url=' + encodeURIComponent($('urlFld').value)
+    + '&tlsv=' + tlsv
+    + '&interval=' + encodeURIComponent($('ivFld').value)
+    + '&metrics=' + encodeURIComponent(metricList())
+    + '&index=' + encodeURIComponent($('idxFld').value)
+    + '&source=' + encodeURIComponent($('srcFld').value)
+    + '&maskmac=' + maskmac
+    + '&http_id=' + encodeURIComponent(REAPER_HTTPID);
+  if(tokenDirty && $('tokFld').value) q += '&token=' + encodeURIComponent($('tokFld').value);
+  xhr('GET', q, function(j){
+    b.disabled = false;
+    var s = $('saved');
+    if(j && j.ok){ s.className = 'saved'; s.textContent = `<#RANL_37#>`; }
+    else { s.className = 'saved err'; s.textContent = (j && j.error) ? j.error : 'error'; }
+    s.style.display = '';
+    setTimeout(function(){ s.style.display = 'none'; }, 4000);
+    load();
+  });
+}
+
+function load(){
+  xhr('GET', '/reaper_export.cgi?action=status', function(j){
+    if(!j){ $('engNote').textContent = `<#RANL_45#>`; return; }
+    C = j; render();
+  });
+}
+function boot(){ load(); }
+if(document.readyState !== 'loading') boot();
+else document.addEventListener('DOMContentLoaded', boot);
+</script>
+</body>
+</html>
