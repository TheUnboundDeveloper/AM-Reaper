+	  "  datadog)\n"
+	  "    AH=\"DD-API-KEY: $TOKEN\"\n"
+	  "    { printf '[{\"ddsource\":\"reaper\",\"service\":\"router\",\"host\":\"%s\",\"message\":' \"$HOST\"; cat \"$SRCF\"; printf '}]'; } > \"$BODY\" ;;\n"
+	  "  elastic)\n"
+	  "    AH=\"Authorization: ApiKey $TOKEN\"; CT='Content-Type: application/x-ndjson'\n"
+	  "    { printf '{\"index\":{}}\\n'; cat \"$SRCF\"; printf '\\n'; } > \"$BODY\" ;;\n"
+	  "  dynatrace)\n"
+	  "    AH=\"Authorization: Api-Token $TOKEN\"\n"
+	  "    cat \"$SRCF\" > \"$BODY\" ;;\n"
+	  "  *)\n"          /* generic / otlp */
+	  "    AH=\"Authorization: Bearer $TOKEN\"\n"
+	  "    cat \"$SRCF\" > \"$BODY\" ;;\n"
+	  "esac\n"
+	  "\n"
+	  "umask 077\n"
+	  "{\n"
+	  "  echo \"url = \\\"$URL\\\"\"\n"
+	  "  echo \"header = \\\"$CT\\\"\"\n"
+	  "  [ -n \"$TOKEN\" ] && echo \"header = \\\"$AH\\\"\"\n"
+	  "  [ \"$TLSV\" = 0 ] && echo insecure\n"
+	  "  echo 'max-time = 25'\n"
+	  "  echo 'connect-timeout = 10'\n"
+	  "  echo 'retry = 1'\n"
+	  "  echo silent\n"
+	  "} > \"$CFG\"\n"
+	  "\n"
+	  "RESP=$(curl -K \"$CFG\" --data-binary @\"$BODY\" -o /dev/null -w '%{http_code}' 2>/dev/null)\n"
+	  "rm -f \"$CFG\" \"$BODY\"\n"
+	  "[ \"$SRCF\" = /tmp/rexport.src ] && rm -f /tmp/rexport.src\n"
+	  "echo \"$NOW $ENGINE $RESP\" > \"$STAT\"\n"
+	  "case \"$RESP\" in 2*) : ;; *) logger -t rexport \"export to $ENGINE failed (HTTP ${RESP:-none})\" ;; esac\n", f);
+	fclose(f);
+	chmod(REXPORT_SH, 0700);
+}
+
+void stop_rexport(void)
+{
+	eval("cru", "d", "rexport");
+	unlink(REXPORT_SH);
+}
+
+void start_rexport(void)
+{
+	const char *mode = nvram_safe_get("reaper_export_mode");
+	int iv, mins;
+	char line[80];
+
+	stop_rexport();
+	rexport_gen();		/* always present so "Test Connection" works even while off */
+	if (strcmp(mode, "both") != 0 && strcmp(mode, "exportonly") != 0)
+		return;					/* export off: not scheduled */
+	if (nvram_match("reaper_export_engine", "prometheus"))
+		return;					/* pull model: no scheduled pusher */
+
+	iv = nvram_get_int("reaper_export_interval");
+	if (iv <= 0) iv = 60;
+	mins = (iv + 59) / 60;				/* cron granularity is 1 minute */
+	if (mins < 1) mins = 1;
+	if (mins > 60) mins = 60;
+	snprintf(line, sizeof(line), "*/%d * * * * sh %s", mins, REXPORT_SH);
+	eval("cru", "a", "rexport", line);
+	/* engine name only - never the URL or token */
+	logmessage("rexport", "analytics export armed (%s, every %d min)",
+		   nvram_safe_get("reaper_export_engine"), mins);
+}
