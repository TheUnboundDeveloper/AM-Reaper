@@ -0,0 +1,166 @@
+/* SPDX-License-Identifier: GPL-2.0-only
+ * Copyright (C) 2026 the Reaper project maintainer
+ * Part of the Reaper hardened Asuswrt-Merlin build. See LICENSE / LICENSE.reaper.
+ *
+ * rc/rexport.c - Reaper analytics exporter (v2.2.2).
+ *
+ * A cron'd pusher - no resident daemon (mirrors rwatch/rwarden). Every
+ * reaper_export_interval seconds (rounded up to whole cron minutes) it reads
+ * the per-device connection-health snapshot rtrafd publishes at
+ * /tmp/rtraf/health.json, shapes it for the selected analytics engine, and
+ * POSTs it over HTTPS with curl. The engines split into two delivery models:
+ *   - PUSH  (Splunk HEC / Datadog / Dynatrace / Elastic / Generic / OTLP /
+ *            Syslog-TLS) - handled here.
+ *   - PULL  (Prometheus) - the router instead EXPOSES OpenMetrics at
+ *            reaper_metrics.cgi and Prometheus scrapes it; this pusher is a
+ *            no-op for that engine.
+ *
+ * Security posture (hardened build): egress is OFF by default
+ * (reaper_export_mode=off). TLS certificate verification is ON unless the user
+ * explicitly sets reaper_export_tlsverify=0 (self-signed collector opt-out).
+ * The API token is written into a 0600 curl config file passed with -K so it
+ * never appears in argv/ps or any log line. On failure only the engine name +
+ * HTTP status are logged, never the URL or token.
+ *
+ * nvram: reaper_export_mode (off|both|exportonly), reaper_export_engine,
+ *        reaper_export_url, reaper_export_token, reaper_export_tlsverify
+ *        (default on; "0" = off), reaper_export_interval (s, default 60),
+ *        reaper_export_index / reaper_export_source (Splunk), reaper_export_maskmac.
+ */
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+#include "rc.h"
+#include <shared.h>
+
+#define REXPORT_SH	"/tmp/rexport.sh"
+
+/* The script is constant (it reads nvram itself at run time), so emit it with
+ * fputs - no printf-format escaping hazards. */
+static void rexport_gen(void)
+{
+	FILE *f = fopen(REXPORT_SH, "w");
+	if (!f)
+		return;
+	fputs(
