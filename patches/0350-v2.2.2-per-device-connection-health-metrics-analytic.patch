+/* ---------- per-device connection health (v2.2.2, opt-in rtraf_hprobe) ----------
+ * Adds per-client latency / jitter / loss via a BATCHED in-process ICMP echo
+ * (one non-blocking raw socket - never fork-per-ping, which would not scale to
+ * ~150 clients) plus per-client TCP connection count + established-state read
+ * from conntrack. conntrack keeps an entry's STATE even for hardware-offloaded
+ * flows (only its byte counters freeze), so conn-count/state is reliable; we do
+ * NOT try to derive retransmits (they cannot be sourced cleanly and would
+ * undercount on every accelerated flow). Publishes /tmp/rtraf/health.json each
+ * cycle for the exporter + a future health UI, and appends a rotated JSONL
+ * history to the durable store (unless export-only). */
+typedef struct {
+	float rtt_ms, jit_ms, loss;	/* EWMA gauges */
+	int tcp_total, tcp_estab;	/* last conntrack pass */
+	struct timespec tsend;		/* echo send instant for the open cycle */
+	int pending;			/* awaiting a reply this cycle */
+	int probed;			/* has ever been probed (gauges valid) */
+} chealth_t;
+static chealth_t chealth[NCLI];
+static int hp_fd = -1;
+static int hp_disabled = 0;
+static uint16_t hp_id = 0;
+static char g_store_dir[160];		/* durable store dir (healthhist.log); "" = RAM */
+
+static void set_store_dir(const char *dbpath)
+{
+	char *s;
+	g_store_dir[0] = '\0';
+	if (!dbpath || !dbpath[0]) return;
+	strlcpy(g_store_dir, dbpath, sizeof(g_store_dir));
+	if ((s = strrchr(g_store_dir, '/')) != NULL) *s = '\0';
+	else g_store_dir[0] = '\0';
+}
+
+static uint16_t hp_cksum(void *b, int len)
+{
+	uint32_t sum = 0;
+	uint16_t *w = b;
+	for (; len > 1; len -= 2) sum += *w++;
+	if (len == 1) sum += *(uint8_t *)w;
+	sum = (sum >> 16) + (sum & 0xffff);
+	sum += (sum >> 16);
+	return (uint16_t)~sum;
+}
+
+static int hp_open(void)
+{
+	int fl;
+	if (hp_fd >= 0) return 1;
+	if (hp_disabled) return 0;
+	if ((hp_fd = socket(AF_INET, SOCK_RAW, IPPROTO_ICMP)) < 0) {
+		syslog(LOG_WARNING, "rtrafd: health latency disabled (raw ICMP socket: %s)", strerror(errno));
+		hp_disabled = 1;
+		return 0;
+	}
+	fl = fcntl(hp_fd, F_GETFL, 0);
+	fcntl(hp_fd, F_SETFL, fl | O_NONBLOCK);
+	fcntl(hp_fd, F_SETFD, FD_CLOEXEC);
+	hp_id = (uint16_t)(getpid() & 0xffff);
+	return 1;
+}
+
+/* send one echo to every active LAN client (skips the Router pseudo-device) */
+static void health_send_batch(void)
+{
+	int i;
+	struct icmphdr pkt;
+	struct sockaddr_in to;
+	struct timespec now;
+	if (!hp_open()) return;
+	clock_gettime(CLOCK_MONOTONIC, &now);
+	memset(&to, 0, sizeof(to));
+	to.sin_family = AF_INET;
+	for (i = 0; i < NCLI; i++) {
+		chealth[i].pending = 0;
+		if (!cli[i].used || strcmp(cli[i].key, RT_DEVKEY) == 0) continue;
+		if (!cli[i].ip[0] || inet_aton(cli[i].ip, &to.sin_addr) == 0) continue;
+		memset(&pkt, 0, sizeof(pkt));
+		pkt.type = ICMP_ECHO;
+		pkt.un.echo.id = htons(hp_id);
+		pkt.un.echo.sequence = htons((uint16_t)i);
+		pkt.checksum = 0;
+		pkt.checksum = hp_cksum(&pkt, sizeof(pkt));
+		chealth[i].pending = 1;
+		chealth[i].probed = 1;
+		chealth[i].tsend = now;
+		sendto(hp_fd, &pkt, sizeof(pkt), 0, (struct sockaddr *)&to, sizeof(to));
+	}
+}
+
+/* non-blocking drain of any echo replies that have arrived (called each tick
+ * while a cycle is open); updates rtt/jitter EWMA and clears pending */
+static void health_drain(void)
+{
+	unsigned char buf[256];
+	struct sockaddr_in from;
+	socklen_t fl;
+	struct timespec now;
+	ssize_t n;
+	if (hp_fd < 0) return;
+	clock_gettime(CLOCK_MONOTONIC, &now);
+	for (;;) {
+		struct iphdr *ip;
+		struct icmphdr *ic;
+		int hlen, slot;
+		fl = sizeof(from);
+		n = recvfrom(hp_fd, buf, sizeof(buf), MSG_DONTWAIT, (struct sockaddr *)&from, &fl);
+		if (n <= 0) break;
+		if (n < (ssize_t)sizeof(struct iphdr)) continue;
+		ip = (struct iphdr *)buf;
+		hlen = ip->ihl * 4;
+		if (hlen < (int)sizeof(struct iphdr) || n < hlen + (int)sizeof(struct icmphdr)) continue;
+		ic = (struct icmphdr *)(buf + hlen);
+		if (ic->type != ICMP_ECHOREPLY || ntohs(ic->un.echo.id) != hp_id) continue;
+		slot = ntohs(ic->un.echo.sequence);
+		if (slot < 0 || slot >= NCLI || !chealth[slot].pending) continue;
+		{
+			float ms = (now.tv_sec - chealth[slot].tsend.tv_sec) * 1000.0f
+				 + (now.tv_nsec - chealth[slot].tsend.tv_nsec) / 1000000.0f;
+			if (ms < 0) ms = 0;
+			if (chealth[slot].rtt_ms <= 0) {
+				chealth[slot].rtt_ms = ms;
+			} else {
+				float d = ms - chealth[slot].rtt_ms;
+				if (d < 0) d = -d;
+				chealth[slot].jit_ms = chealth[slot].jit_ms * 0.75f + d * 0.25f;
+				chealth[slot].rtt_ms = chealth[slot].rtt_ms * 0.7f + ms * 0.3f;
+			}
+			chealth[slot].pending = 0;	/* received */
+		}
+	}
+}
+
+/* per-client TCP connection count + established-state, independent of the byte
+ * fallback so it runs whether or not the accelerator is on */
+static void health_conn_scan(void)
+{
+	FILE *f = fopen("/proc/net/nf_conntrack", "r");
+	char line[768];
+	int i;
+	if (!f) return;
+	for (i = 0; i < NCLI; i++) { chealth[i].tcp_total = 0; chealth[i].tcp_estab = 0; }
+	while (fgets(line, sizeof(line), f)) {
+		char proto[16] = "", src[64] = "";
+		struct in_addr a;
+		char *p;
+		int pnum = 0, slot = -1;
+		if (strncmp(line, "ipv4", 4) != 0) continue;
+		if (sscanf(line, "%*s %*d %15s %d", proto, &pnum) != 2) continue;
+		if (strcmp(proto, "tcp") != 0) continue;
+		if ((p = strstr(line, "src=")) == NULL) continue;
+		sscanf(p, "src=%63s", src);
+		if (inet_aton(src, &a) == 0) continue;
+		if ((ntohl(a.s_addr) & lan_mask) != lan_net) continue;
+		for (i = 0; i < NCLI; i++)
+			if (cli[i].used && strcmp(cli[i].ip, src) == 0) { slot = i; break; }
+		if (slot < 0) continue;
+		chealth[slot].tcp_total++;
+		if (strstr(line, "ESTABLISHED")) chealth[slot].tcp_estab++;
+	}
+	fclose(f);
+}
+
+static void write_health(void)
+{
+	FILE *o = fopen("/tmp/rtraf/.health.json", "w");
+	char eb[80], eb2[80];
+	int i, first = 1;
+	time_t now = time(NULL);
+	if (!o) return;
+	fprintf(o, "{\"now\":%lld,\"iv\":%d,\"devices\":[", (long long)now, cfg_hint);
+	for (i = 0; i < NCLI; i++) {
+		if (!cli[i].used || strcmp(cli[i].key, RT_DEVKEY) == 0) continue;
+		fprintf(o, "%s{\"mac\":\"%s\",\"ip\":\"%s\",\"rtt_ms\":%.1f,\"jitter_ms\":%.1f,"
+			   "\"loss_pct\":%.1f,\"tcp_estab\":%d,\"tcp_total\":%d,"
+			   "\"dn_bps\":%llu,\"up_bps\":%llu,\"online\":%d}",
+			first ? "" : ",",
+			jesc(cli[i].key, eb, sizeof(eb)), jesc(cli[i].ip, eb2, sizeof(eb2)),
+			chealth[i].probed ? chealth[i].rtt_ms : 0.0f,
+			chealth[i].probed ? chealth[i].jit_ms : 0.0f,
+			chealth[i].probed ? chealth[i].loss : 0.0f,
+			chealth[i].tcp_estab, chealth[i].tcp_total,
+			(unsigned long long)lv_cli_rx[i], (unsigned long long)lv_cli_tx[i],
+			((now - cli[i].last) < 120) ? 1 : 0);
+		first = 0;
+	}
+	fprintf(o, "]}");
+	fclose(o);
+	rename("/tmp/rtraf/.health.json", "/tmp/rtraf/health.json");
+
+	/* OpenMetrics text for the Prometheus scrape endpoint (reaper_metrics.cgi).
+	 * Grouped per metric family (HELP/TYPE then all series) as Prometheus prefers.
+	 * mac/ip label values are constrained charsets (hex/colon/dot) - no escaping. */
+	{
+		FILE *m = fopen("/tmp/rtraf/.metrics.prom", "w");
+		if (m) {
+			static const struct { const char *name, *help; } fam[6] = {
+				{ "reaper_client_rtt_ms", "Per-device ICMP round-trip time (ms)" },
+				{ "reaper_client_jitter_ms", "Per-device RTT jitter (ms)" },
+				{ "reaper_client_loss_ratio", "Per-device ICMP loss ratio (0-1)" },
+				{ "reaper_client_tcp_established", "Per-device established TCP connections" },
+				{ "reaper_client_tcp_total", "Per-device tracked TCP connections" },
+				{ "reaper_client_online", "Per-device online (1) / offline (0)" },
+			};
+			int k;
+			for (k = 0; k < 6; k++) {
+				fprintf(m, "# HELP %s %s\n# TYPE %s gauge\n", fam[k].name, fam[k].help, fam[k].name);
+				for (i = 0; i < NCLI; i++) {
+					if (!cli[i].used || strcmp(cli[i].key, RT_DEVKEY) == 0) continue;
+					fprintf(m, "%s{mac=\"%s\",ip=\"%s\"} ", fam[k].name, cli[i].key, cli[i].ip);
+					switch (k) {
+					case 0: fprintf(m, "%.1f\n", chealth[i].probed ? chealth[i].rtt_ms : 0.0f); break;
+					case 1: fprintf(m, "%.1f\n", chealth[i].probed ? chealth[i].jit_ms : 0.0f); break;
+					case 2: fprintf(m, "%.3f\n", chealth[i].probed ? chealth[i].loss / 100.0f : 0.0f); break;
+					case 3: fprintf(m, "%d\n", chealth[i].tcp_estab); break;
+					case 4: fprintf(m, "%d\n", chealth[i].tcp_total); break;
+					default: fprintf(m, "%d\n", ((now - cli[i].last) < 120) ? 1 : 0); break;
+					}
+				}
+			}
+			fclose(m);
+			rename("/tmp/rtraf/.metrics.prom", "/tmp/rtraf/metrics.prom");
+		}
+	}
+
+	/* durable retention: append a compact JSONL row (rotated at HLOG_MAX) unless
+	 * the user chose export-only (send without keeping a local copy) */
+	if (g_store_dir[0] && cfg_export_mode != EXP_ONLY) {
+		char lp[176];
+		struct stat st;
+		FILE *h;
+		snprintf(lp, sizeof(lp), "%s/healthhist.log", g_store_dir);
+		if (stat(lp, &st) == 0 && st.st_size > HLOG_MAX) {
+			char pv[192];
+			snprintf(pv, sizeof(pv), "%s.1", lp);
+			rename(lp, pv);
+		}
+		if ((h = fopen(lp, "a")) != NULL) {
+			first = 1;
+			fprintf(h, "{\"t\":%lld,\"dev\":[", (long long)now);
+			for (i = 0; i < NCLI; i++) {
+				if (!cli[i].used || strcmp(cli[i].key, RT_DEVKEY) == 0) continue;
+				if (!chealth[i].probed && chealth[i].tcp_total == 0) continue;
+				fprintf(h, "%s{\"m\":\"%s\",\"r\":%.1f,\"j\":%.1f,\"l\":%.1f,\"te\":%d,\"tt\":%d}",
+					first ? "" : ",", jesc(cli[i].key, eb, sizeof(eb)),
+					chealth[i].rtt_ms, chealth[i].jit_ms, chealth[i].loss,
+					chealth[i].tcp_estab, chealth[i].tcp_total);
+				first = 0;
+			}
+			fprintf(h, "]}\n");
+			fclose(h);
+		}
+	}
+}
+
+/* close the open cycle: any client that never replied counts as loss, then
+ * publish the snapshot */
+static void health_close(void)
+{
+	int i;
+	for (i = 0; i < NCLI; i++) {
+		if (!cli[i].used || !chealth[i].probed) continue;
+		if (chealth[i].pending) chealth[i].loss = chealth[i].loss * 0.8f + 100.0f * 0.2f;
+		else                    chealth[i].loss = chealth[i].loss * 0.8f;
+		chealth[i].pending = 0;
+	}
+	write_health();
+}
