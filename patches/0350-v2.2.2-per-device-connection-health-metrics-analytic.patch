+	  "  if printf '%s\\n' \"$MSG\" | openssl s_client -quiet -connect \"$SH:$SP\" >/dev/null 2>&1; then\n"
+	  "    echo \"$NOW syslog ok\" > \"$STAT\"\n"
+	  "  else\n"
