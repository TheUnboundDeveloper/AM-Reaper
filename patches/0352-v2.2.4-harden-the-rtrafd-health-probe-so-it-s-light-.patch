+/* v2.2.4: O(1) ip->slot index, rebuilt once at the start of each conntrack scan.
+ * conn_scan used to do an O(NCLI) inner strcmp per TCP line; the NCLI 64->192 bump
+ * made that O(lines x 192) on a single tick. This turns the per-line attribution
+ * into a short hash probe (get re-checks the ip so a collision can't false-match). */
+static void hp_ipindex_build(void)
+{
+	int i, j;
+	for (i = 0; i < CLI_HASH; i++) hp_ip_hash[i] = -1;
+	for (i = 0; i < NCLI; i++) {
+		uint32_t h;
+		if (!cli[i].used || !cli[i].ip[0]) continue;
+		h = (uint32_t)(fnv64(cli[i].ip) & (CLI_HASH - 1));
+		for (j = 0; j < CLI_HASH; j++) {
+			int p = (h + j) & (CLI_HASH - 1);
+			if (hp_ip_hash[p] < 0) { hp_ip_hash[p] = i; break; }
+		}
+	}
+}
+
+static int hp_ipindex_get(const char *ip)
+{
+	uint32_t h = (uint32_t)(fnv64(ip) & (CLI_HASH - 1));
+	int j;
+	for (j = 0; j < CLI_HASH; j++) {
+		int p = (h + j) & (CLI_HASH - 1);
+		int s = hp_ip_hash[p];
+		if (s < 0) return -1;
+		if (cli[s].used && strcmp(cli[s].ip, ip) == 0) return s;
+	}
+	return -1;
+}
