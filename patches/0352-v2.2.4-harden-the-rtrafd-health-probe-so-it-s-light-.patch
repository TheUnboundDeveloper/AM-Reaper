+/* v2.2.4: flush the RAM spool to $store/healthhist.log (rotated at HLOG_MAX) and
+ * truncate it. Called from the existing periodic-save tick - the one place that
+ * already blocks on flash - so history persistence stays entirely off the hot loop.
+ * A crash loses at most one save-interval of history rows (fine for a history log,
+ * and far kinder to NAND than the old every-cycle append). */
+static void health_flush_spool(void)
+{
+	char lp[176];
+	struct stat st;
+	FILE *in, *out;
+	char buf[2048];
+	size_t n;
+	if (!g_store_dir[0]) return;
+	if (stat(HSPOOL, &st) != 0 || st.st_size == 0) return;		/* nothing pending */
+	snprintf(lp, sizeof(lp), "%s/healthhist.log", g_store_dir);
+	if (stat(lp, &st) == 0 && st.st_size > HLOG_MAX) {
+		char pv[192];
+		snprintf(pv, sizeof(pv), "%s.1", lp);
+		rename(lp, pv);
+	}
+	if ((in = fopen(HSPOOL, "r")) == NULL) return;
+	if ((out = fopen(lp, "a")) == NULL) { fclose(in); return; }
+	while ((n = fread(buf, 1, sizeof(buf), in)) > 0) fwrite(buf, 1, n, out);
+	fclose(out);
+	fclose(in);
+	if (truncate(HSPOOL, 0) != 0)		/* best-effort; a failure just re-flushes the same rows next time */
+		syslog(LOG_DEBUG, "rtrafd: healthhist spool reset: %s", strerror(errno));
+}
