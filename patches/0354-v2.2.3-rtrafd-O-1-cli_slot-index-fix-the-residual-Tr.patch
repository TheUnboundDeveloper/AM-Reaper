+/* v2.2.3: O(1) client-slot lookup. cli_slot() was an O(NCLI) linear scan called
+ * once per client-connection inside poll_fcache() (every 5 s, up to 1536 flows) and
+ * poll_conntrack(); the NCLI 64->192 bump tripled it and pushed the 5 s heavy tick
+ * over the 100 ms budget on large LANs (the residual analyzer stutter that persists
+ * with the health probe OFF). An open-addressed fnv(key)->slot index makes the
+ * common path - a client we already track - a short hash probe. The index is
+ * maintained on the free-slot insert and rebuilt on the rare LRU eviction / db
+ * restore, so it can never hold a stale entry (and cli_index_get re-checks the key,
+ * so a hash collision can't false-match). */
+static void cli_index_clear(void)
+{
+	int i;
+	for (i = 0; i < CLI_HASH; i++) cli_hash[i] = -1;
+}
+
+static void cli_index_put(const char *key, int slot)
+{
+	uint32_t h = (uint32_t)(fnv64(key) & (CLI_HASH - 1));
+	int j;
+	for (j = 0; j < CLI_HASH; j++) {
+		int p = (h + j) & (CLI_HASH - 1);
+		if (cli_hash[p] < 0 || cli_hash[p] == slot) { cli_hash[p] = slot; return; }
+	}
+}
+
+static void cli_index_rebuild(void)
+{
+	int i;
+	cli_index_clear();
+	for (i = 0; i < NCLI; i++)
+		if (cli[i].used) cli_index_put(cli[i].key, i);
+}
+
+static int cli_index_get(const char *key)
+{
+	uint32_t h = (uint32_t)(fnv64(key) & (CLI_HASH - 1));
+	int j;
+	for (j = 0; j < CLI_HASH; j++) {
+		int p = (h + j) & (CLI_HASH - 1);
+		int s = cli_hash[p];
+		if (s < 0) return -1;			/* empty slot terminates the probe */
+		if (cli[s].used && strcmp(cli[s].key, key) == 0) return s;
+	}
+	return -1;
+}
+
 static int cli_slot(const char *key, const char *ip)
 {
 	int i, oldest = 0;
 	time_t omin = 0;
-	for (i = 0; i < NCLI; i++)
-		if (cli[i].used && strcmp(cli[i].key, key) == 0) {
-			strlcpy(cli[i].ip, ip, sizeof(cli[i].ip));
-			cli[i].last = time(NULL);
-			return i;
-		}
+	/* fast path: a client we already track (the overwhelmingly common case) */
+	if ((i = cli_index_get(key)) >= 0) {
+		strlcpy(cli[i].ip, ip, sizeof(cli[i].ip));
+		cli[i].last = time(NULL);
+		return i;
+	}
+	/* new client: a free slot (the O(NCLI) walk here runs only on first sight) */
 	for (i = 0; i < NCLI; i++)
 		if (!cli[i].used) { oldest = i; goto take; }
-	/* LRU replace: wipe that client's history */
+	/* table full: LRU replace, wipe that client's history, then rebuild the index
+	 * (the evicted key must leave it) */
 	for (i = 0; i < NCLI; i++)
 		if (omin == 0 || cli[i].last < omin) { omin = cli[i].last; oldest = i; }
 	memset(r_cli[oldest], 0, sizeof(ring_t));
+	cli[oldest].used = 1;
+	strlcpy(cli[oldest].key, key, sizeof(cli[0].key));
+	strlcpy(cli[oldest].ip, ip, sizeof(cli[0].ip));
+	cli[oldest].last = time(NULL);
+	cli_index_rebuild();
+	return oldest;
 take:
 	cli[oldest].used = 1;
 	strlcpy(cli[oldest].key, key, sizeof(cli[0].key));
 	strlcpy(cli[oldest].ip, ip, sizeof(cli[0].ip));
 	cli[oldest].last = time(NULL);
+	cli_index_put(key, oldest);
 	return oldest;
 }
 
