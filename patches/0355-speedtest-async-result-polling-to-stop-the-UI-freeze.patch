From 80fc8bfa889a21ab3da6848c3ce7ca36d661776b Mon Sep 17 00:00:00 2001
From: reaper <reaper@local>
Date: Fri, 7 Aug 2026 21:12:44 -0400
Subject: [PATCH] speedtest: async result polling to stop the UI freeze during
 a run

The Internet Speed Test page (internet_speed.html) polled the ookla
result buffer with a SYNCHRONOUS hookGet() every 200ms for the whole
run. During the download/upload phases the test binary pegs the CPU,
httpd lags, and each blocking XHR stalls the browser main thread -
progressively longer until the tab hits Page Unresponsive (the field
freeze). The backend completes normally, so a refresh shows the
finished numbers.

Fix: fetch ookla_speedtest_get_result asynchronously and chain the next
poll from the response callback, with a single-flight guard so polls
never stack. UI thread stays free the whole run; the 120s timeout and
the existing silent-retry path are unchanged.

Bump EXTENDNO to Reaper_v2.2.6.
---
 release/src-rt/version.conf                |  2 +-
 release/src/router/www/internet_speed.html | 38 +++++++++++++++++++---
 2 files changed, 34 insertions(+), 6 deletions(-)

diff --git a/release/src-rt/version.conf b/release/src-rt/version.conf
index 8ac1c57dd2..d1b21262bf 100644
--- a/release/src-rt/version.conf
+++ b/release/src-rt/version.conf
@@ -4,6 +4,6 @@ KERNEL_VER_AM=$(subst .,,$(KERNEL_VER))
 FS_VER_AM=$(subst .,,$(FS_VER))
 
 SERIALNO=102.8
-EXTENDNO=Reaper_v2.2.5
+EXTENDNO=Reaper_v2.2.6
 
 RCNO=0
diff --git a/release/src/router/www/internet_speed.html b/release/src/router/www/internet_speed.html
index cc9e687b6a..9d8bc086da 100644
--- a/release/src/router/www/internet_speed.html
+++ b/release/src/router/www/internet_speed.html
@@ -73,6 +73,7 @@ var go_btn_type = "go";
 var LEVEL_ERR_MAX = 50;
 var level_err_cnt = 0;
 var speedTest_retry_done = false;	/* reaper: one silent auto-retry per user-run to absorb a transient first-attempt failure (cold DNS / pre-NTP TLS on the single config.speedtest.net fetch) */
+var speedTest_poll_inflight = false;	/* reaper: single-flight guard so async result polls never stack up */
 var ookla_states = {
 		"IDLE": "0",
 		"RUN": "1",
@@ -381,6 +382,7 @@ function reset_speedTest_div(){
 
 function start_speedTest(){
 	speedTest_retry_done = false;	/* reaper: fresh retry budget per user-initiated run */
+	speedTest_poll_inflight = false;	/* reaper: clear any stale in-flight poll guard */
 	reset_speedTest_div();
 	change_speedTestBtn("testing");
 	if(!enable_auto_server && cur_server_id != "")
@@ -418,18 +420,44 @@ function check_duplicate_result(result_obj){
 }
 
 function get_speedTest_result(){
-	speedTest_result = [];
-	speedTest_result = httpApi.hookGet("ookla_speedtest_get_result", true);
-	var result_time = {};
+	/* reaper: fetch the ookla result buffer ASYNCHRONOUSLY. The stock code polled it with a
+	   SYNCHRONOUS hookGet() every 200ms; during the transfer phase the test binary pegs the
+	   CPU, httpd lags, and each blocking XHR froze the browser main thread ("page
+	   unresponsive") even though the backend completed fine. Async keeps the UI thread free;
+	   a single-flight guard stops overlapping poll chains from stacking requests. */
 	var now = new Date();
-	var get_next = true;
-
 	get_result_time = now.getTime();
 	if(get_result_time - test_start_time >= test_timeout){
+		speedTest_poll_inflight = false;
 		error_handling(ookla_states.ERR_TIMEOUT);
 		return;
 	}
 
+	if(speedTest_poll_inflight)
+		return;
+	speedTest_poll_inflight = true;
+
+	$.ajax({
+		url: "/appGet.cgi?hook=ookla_speedtest_get_result()",
+		dataType: "json",
+		async: true,
+		error: function(){
+			/* transient httpd stall under load: reschedule, do not fail the run */
+			speedTest_poll_inflight = false;
+			setTimeout("get_speedTest_result();", 200);
+		},
+		success: function(response){
+			speedTest_poll_inflight = false;
+			speedTest_result = (response && response.ookla_speedtest_get_result) ? response.ookla_speedtest_get_result : [];
+			process_speedTest_result();
+		}
+	});
+}
+
+function process_speedTest_result(){
+	var result_time = {};
+	var get_next = true;
+
 	if(speedTest_result.length < 2){
 		setTimeout("get_speedTest_result();", 200);
 	}
-- 
2.25.1

