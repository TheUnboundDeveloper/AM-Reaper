+/* reaper: mask the plaintext Wi-Fi key in the post-apply reconnect card. The shared
+ * state.js showWlHintContainer() renders "<#Network_key#>: <b>KEY</b>" per band as a
+ * reconnect hint for a Wi-Fi admin whose connection restart_wireless is about to bounce;
+ * showing the key in the clear is a shoulder-surf exposure. We keep the SSID hint but
+ * replace the key text with dots after the card renders. Scoped to sdn.js only - the
+ * shared state.js body (also used by mlo/Advanced_VLAN/Roaming) is left untouched. */
+function reaperMaskWlHintKey(){
+	try{
+		var c = top.document.getElementById("WlHintContainer");
+		if(!c) return;
+		var rows = c.querySelectorAll(".nologin");
+		for(var i=0; i<rows.length; i++){
+			var bolds = rows[i].getElementsByTagName("b");	/* [0]=SSID, [1]=key */
+			if(bolds.length >= 2){
+				var txt = (bolds[1].textContent || bolds[1].innerText || "");
+				if(txt !== "" && txt !== "Open System")
+					bolds[1].textContent = Array(9).join(String.fromCharCode(0x2022)); /* 8 dot chars, ASCII source */
+			}
+		}
+	}catch(e){}
+}
