+++ b/release/src/router/www/reaper_util.js
@@ -0,0 +1,99 @@
+/* reaper_util.js - shared device-name resolver + byte/rate formatters.
+ *
+ * D1 (backlog): the get_clientlist + nickName||name resolver was reimplemented in
+ * Reaper_Traffic / Reaper_Conn / Reaper_QoS with three different keyings (lc-MAC+IP,
+ * IP-only, lc-MAC). This is the single implementation: one index keyed by BOTH
+ * lowercase MAC and IP, seeded from the persistent custom_clientlist master store
+ * (so OFFLINE devices keep their user-assigned name - the v2.2.5 Traffic behaviour,
+ * now shared by all three pages) and then overwritten by the freshest live nickName.
+ * The server-side custom_clientlist string is still injected per-page via the ASP
+ * <% nvram_char_to_ascii %> tag (a .js file is not ASP-processed) and passed to
+ * refresh(); everything else lives here.
+ *
+ * D3 (backlog): one decimal-SI (1000-based) byte formatter + the bit-rate formatters,
+ * so pages stop each carrying their own slightly-drifted copy. QoS bandwidth CAPS stay
+ * on their own 1024 bit formatter by design (a bitrate cap is a different quantity).
+ */
+window.ReaperNames = (function(){
+  var byMac = {}, ip2mac = {};
+  function nrm(m){ return String(m == null ? '' : m).toLowerCase(); }
+
+  /* parse the ASP-injected custom_clientlist tuple string: <name>mac>group>type>... */
+  function seedCustom(raw){
+    if(!raw) return;
+    try{
+      var s = decodeURIComponent(raw).replace(/&#62/g, '>').replace(/&#60/g, '<');
+      var ents = s.split('<');
+      for(var i = 0; i < ents.length; i++){
+        if(!ents[i]) continue;
+        var f = ents[i].split('>'), nm = f[0] || '', mac = nrm(f[1]);
+        if(nm && mac.indexOf(':') > -1) byMac[mac] = nm;   /* live list overwrites below */
+      }
+    }catch(e){}
+  }
+
+  /* fetch the live networkmap client list once; nickName||name; key by lc-MAC and IP.
+     cb(clientListObj|null) lets a caller do page-specific work (e.g. QoS datalist)
+     with the same fetched payload - no second request. */
+  function fetchLive(cb){
+    var x = new XMLHttpRequest();
+    x.open('GET', '/appGet.cgi?hook=get_clientlist()&_=' + Date.now(), true);
+    x.timeout = 6000;
+    x.onreadystatechange = function(){
+      if(x.readyState !== 4) return;
+      var cl = null;
+      if(x.status === 200){
+        try{
+          var j = JSON.parse(x.responseText); cl = j.get_clientlist || j;
+          var ml = cl.maclist || [];
+          for(var i = 0; i < ml.length; i++){
+            var mac = String(ml[i]), c = cl[mac]; if(!c) continue;
+            var nm = (c.nickName && String(c.nickName).length) ? String(c.nickName)
+                   : ((c.name && String(c.name).length) ? String(c.name) : '');
+            var lm = nrm(mac);
+            if(nm) byMac[lm] = nm;            /* freshest live name wins over custom */
+            if(c.ip) ip2mac[c.ip] = lm;
+          }
+        }catch(e){ cl = null; }
+      }
+      if(cb) cb(cl);
+    };
+    x.onerror = x.ontimeout = function(){ if(cb) cb(null); };
+    x.send();
+  }
+
+  return {
+    /* customRaw = the page's ASP-injected custom_clientlist string (may be ''). */
+    refresh: function(customRaw, cb){ seedCustom(customRaw); fetchLive(cb); },
+    /* name for a MAC; fb defaults to '' (Traffic/Conn), pass the MAC for QoS. */
+    byMac: function(mac, fb){ var n = byMac[nrm(mac)]; return (n !== undefined && n !== '') ? n : (fb !== undefined ? fb : ''); },
+    /* name for an IP (via the live IP->MAC index). */
+    byIp: function(ip, fb){ var m = ip2mac[ip], n = m ? byMac[m] : undefined; return (n !== undefined && n !== '') ? n : (fb !== undefined ? fb : ''); },
+    /* the lc-MAC the live list mapped to this IP (Traffic identity cell), or ''. */
+    macForIp: function(ip){ return ip2mac[ip] || ''; }
+  };
+})();
+
+/* D3: one decimal-SI byte formatter + bit-rate formatters. Both bit-rate label styles
+   are provided ("Mb/s" and "Mbps") so no page's rate label text changes; the numeric
+   logic (thresholds, decimals, 1000-base) is what gets unified. */
+window.ReaperFmt = {
+  bytes: function(b){ b = +b || 0;
+    if(b >= 1e12) return (b/1e12).toFixed(2) + ' TB';
+    if(b >= 1e9)  return (b/1e9).toFixed(2)  + ' GB';
+    if(b >= 1e6)  return (b/1e6).toFixed(1)  + ' MB';
+    if(b >= 1e3)  return (b/1e3).toFixed(0)  + ' KB';
+    return b + ' B'; },
+  /* bit/s with "b/s" family label (Reaper_Traffic style) */
+  bps: function(b){ b = +b || 0;
+    if(b >= 1e9) return (b/1e9).toFixed(2) + ' Gb/s';
+    if(b >= 1e6) return (b/1e6).toFixed(1) + ' Mb/s';
+    if(b >= 1e3) return (b/1e3).toFixed(0) + ' kb/s';
+    return b.toFixed(0) + ' b/s'; },
+  /* bit/s with "bps" family label (Reaper_Conn style) */
+  rate: function(b){ b = +b || 0;
+    if(b >= 1e9) return (b/1e9).toFixed(2) + ' Gbps';
+    if(b >= 1e6) return (b/1e6).toFixed(0) + ' Mbps';
+    if(b >= 1e3) return (b/1e3).toFixed(0) + ' Kbps';
+    return Math.round(b) + ' bps'; }
+};
