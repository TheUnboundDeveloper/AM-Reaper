+/* A classification rule that matches on TRANSFERRED BYTES cannot ride hardware
+   flow offload: add_qos_rules() gives it rule_gum=0 (non-sticky) and matches it
+   with -m connbytes, which re-evaluates on every packet. Under the classful
+   engine it also misclassifies anything long-lived -- streaming video is HTTPS
+   and passes any byte threshold in seconds, so it ends up in the bulk class
+   (metal, 2026-08-10). The shipped presets no longer do this; a user rule still
+   can, so name the offenders. Rules are edited on the stock user-rules page;
+   this page only reports. Format: desc>addr>port>proto>transferred>prio, and
+   the stock editor writes a bare "~" for "no range". */
+function rulesWarn(){
+  var el = document.getElementById('xferwarn');
+  if(!el) return;
+  var bad = [], parts = String(NV.rules || '').split('<'), i, f;
+  for(i = 0; i < parts.length; i++){
+    if(!parts[i]) continue;
+    f = parts[i].split('>');
+    if(f.length === 6 && f[4] && f[4] !== '~') bad.push(f[0] || ('#' + i));
+  }
+  if(!bad.length || sel !== '11'){ el.style.display = 'none'; return; }
+  el.innerHTML = `<#RQOS_123#>` + ' <b>' + bwlEsc(bad.join(', ')) + '</b>';
+  el.style.display = '';
+}
+
 function syncPanels(){
   document.getElementById('clpanel').style.display = (sel === '11') ? '' : 'none';
+  rulesWarn();
   document.getElementById('bwlimpanel').style.display = (sel === '2') ? '' : 'none';
   document.getElementById('bwpanel').style.display = (sel === '2') ? 'none' : '';
   var on = (NV.enable === '1');
