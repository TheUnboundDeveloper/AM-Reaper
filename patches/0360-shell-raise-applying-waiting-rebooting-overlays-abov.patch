From 7bc1448cd511f5041a525002c6fabd04047510dd Mon Sep 17 00:00:00 2001
From: reaper <theunbounddeveloper@outlook.com>
Date: Sat, 8 Aug 2026 00:50:19 -0400
Subject: [PATCH 357/369] shell: raise applying/waiting/rebooting overlays
 above the navbar (z-index)

The Reaper settings shell (reaper_shell.asp) owns the topbar/nav chrome at
z-index:300 and loads pages in an iframe. Its three blocking overlays -
lang_overlay ("applying"), reaper_wait ("applying"/"waiting"), reboot_overlay
("rebooting") - were pinned at z-index 99/100, i.e. BELOW the navbar. So during
an apply/reboot the overlay covered the iframe content but the nav + header
stayed on top and clickable - a user could navigate away mid-apply.

The v2.2.5 overlay fix only raised the UI4 loader (which the classic-base
RT-BE96U build does not use) and never touched these shell overlays. Raise all
three to z-index:2147483000 - the same "above all shell chrome" ceiling the
popup.js UI4 loader already uses - so the overlay blocks the navbar at the
critical moment. CSS-only, no logic change.

Bump EXTENDNO to Reaper_v2.2.8.
---
 release/src-rt/version.conf             | 2 +-
 release/src/router/www/reaper_shell.asp | 6 +++---
 2 files changed, 4 insertions(+), 4 deletions(-)

diff --git a/release/src-rt/version.conf b/release/src-rt/version.conf
index 258ff4bb7b..a6f09f32bb 100644
--- a/release/src-rt/version.conf
+++ b/release/src-rt/version.conf
@@ -4,6 +4,6 @@ KERNEL_VER_AM=$(subst .,,$(KERNEL_VER))
 FS_VER_AM=$(subst .,,$(FS_VER))
 
 SERIALNO=102.8
-EXTENDNO=Reaper_v2.2.7
+EXTENDNO=Reaper_v2.2.8
 
 RCNO=0
diff --git a/release/src/router/www/reaper_shell.asp b/release/src/router/www/reaper_shell.asp
index 4d17f37afe..db9225b0ee 100644
--- a/release/src/router/www/reaper_shell.asp
+++ b/release/src/router/www/reaper_shell.asp
@@ -178,10 +178,10 @@ a.item.on::before{content:"";position:absolute;left:0;top:7px;bottom:7px;width:2
 </form>
 <span id="lang_src" style="display:none"><% shown_language_css(); %></span>
 <span id="lang_cur_name" style="display:none"><#selected_language#></span>
-<div id="lang_overlay" style="display:none;position:fixed;inset:0;z-index:99;background:rgba(4,4,5,.92)">
+<div id="lang_overlay" style="display:none;position:fixed;inset:0;z-index:2147483000;background:rgba(4,4,5,.92)">
   <div style="position:absolute;top:44%;left:50%;transform:translate(-50%,-50%);text-align:center;font-family:var(--hdr);color:var(--crimson);font-size:20px;letter-spacing:.2em;text-transform:uppercase"><#Reaper_c_applying#></div>
 </div>
-<div id="reboot_overlay" style="display:none;position:fixed;inset:0;z-index:99;background:rgba(4,4,5,.92)">
+<div id="reboot_overlay" style="display:none;position:fixed;inset:0;z-index:2147483000;background:rgba(4,4,5,.92)">
   <div style="position:absolute;top:42%;left:50%;transform:translate(-50%,-50%);text-align:center">
     <div style="font-family:var(--hdr);color:var(--crimson);font-size:22px;letter-spacing:.2em;text-transform:uppercase"><#Reaper_c_rebooting#></div>
     <div id="reboot_count" style="margin-top:12px;color:var(--bone);font-family:var(--hdr);font-size:34px;font-weight:700">&mdash;</div>
@@ -191,7 +191,7 @@ a.item.on::before{content:"";position:absolute;left:0;top:7px;bottom:7px;width:2
 
 <!-- reusable themed "waiting" modal for framed Reaper pages (item: pages lacked one).
      A content page calls (window.parent||window).reaperWait('...') / .reaperWaitDone(). -->
-<div id="reaper_wait" style="display:none;position:fixed;inset:0;z-index:100;background:rgba(4,4,5,.92)">
+<div id="reaper_wait" style="display:none;position:fixed;inset:0;z-index:2147483000;background:rgba(4,4,5,.92)">
   <div style="position:absolute;top:44%;left:50%;transform:translate(-50%,-50%);text-align:center">
     <div style="width:34px;height:34px;margin:0 auto 16px;border:3px solid rgba(225,6,0,.25);border-top-color:var(--crimson);border-radius:50%;animation:rwspin .8s linear infinite"></div>
     <div id="reaper_wait_msg" style="font-family:var(--hdr);color:var(--crimson);font-size:20px;letter-spacing:.2em;text-transform:uppercase"><#Reaper_c_applying#></div>
