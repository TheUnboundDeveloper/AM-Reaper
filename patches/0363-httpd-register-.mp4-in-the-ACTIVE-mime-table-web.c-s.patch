From 5e02783c3559a2e0c83c94ec83d1fc16c35e435b Mon Sep 17 00:00:00 2001
From: reaper <theunbounddeveloper@outlook.com>
Date: Sat, 8 Aug 2026 10:31:59 -0400
Subject: [PATCH 363/369] httpd: register .mp4 in the ACTIVE mime table (web.c)
 so the header animation plays

v2.3.0 put the .mp4 handler in basic.c's mime_handlers[], but the router httpd
links web.c's table (web.o is in OBJS; basic.o is not) - so httpd still 404'd the
.mp4 and the header showed only the static poster. Move it to web.c next to
**.webp: { "**.mp4", "video/mp4", cache_object, NULL, do_file, NULL }. Same
do_file + NULL-auth static-media class as .webp/.png/.gif; handler->auth (the real
auth gate) unchanged; the httpd.c login-IP accounting skip stays scoped to
_REAPER_Header.mp4. basic.c reverted (dead edit).

Also: hide the "Router" row from the Traffic Analyzer BY NETWORK view. That bucket
(rtrafd RT_NETLBL) is the router's OWN traffic (ntp/update-check/latency probe),
not a real network, so it's filtered from the per-network render loop in
Reaper_Traffic.asp (display-only; rtrafd still collects it).

Bump EXTENDNO to Reaper_v2.3.1.
---
 release/src-rt/version.conf               | 2 +-
 release/src/router/httpd/web.c            | 1 +
 release/src/router/www/Reaper_Traffic.asp | 2 +-
 3 files changed, 3 insertions(+), 2 deletions(-)

diff --git a/release/src-rt/version.conf b/release/src-rt/version.conf
index 887cba1571..b94f0f330e 100644
--- a/release/src-rt/version.conf
+++ b/release/src-rt/version.conf
@@ -4,6 +4,6 @@ KERNEL_VER_AM=$(subst .,,$(KERNEL_VER))
 FS_VER_AM=$(subst .,,$(FS_VER))
 
 SERIALNO=102.8
-EXTENDNO=Reaper_v2.3.0
+EXTENDNO=Reaper_v2.3.1
 
 RCNO=0
diff --git a/release/src/router/httpd/web.c b/release/src/router/httpd/web.c
index cc1814761b..7dddbecd53 100644
--- a/release/src/router/httpd/web.c
+++ b/release/src/router/httpd/web.c
@@ -31875,6 +31875,7 @@ struct mime_handler mime_handlers[] =
 	{ "**.svg", "image/svg+xml", cache_object, NULL, do_file, NULL },
 #endif
 	{ "**.webp", "image/webp", cache_object, NULL, do_file, NULL },
+	{ "**.mp4", "video/mp4", cache_object, NULL, do_file, NULL },	/* reaper v2.3.1: animated login/logout/set-password header. The router httpd links THIS table (web.o in OBJS), not basic.c; same do_file + NULL-auth static-media class as .webp/.png/.gif - handler->auth unchanged, no new authenticated surface. */
 	{ "**.swf", "application/x-shockwave-flash", NULL, NULL, do_file, NULL  },
 	{ "**.htc", "text/x-component", NULL, NULL, do_file, NULL  },
 	{ "js/asus_policy.js", "text/javascript", no_cache, do_html_post_and_get, do_ej, do_auth },
diff --git a/release/src/router/www/Reaper_Traffic.asp b/release/src/router/www/Reaper_Traffic.asp
index 2b7a44ad21..ba2823c396 100644
--- a/release/src/router/www/Reaper_Traffic.asp
+++ b/release/src/router/www/Reaper_Traffic.asp
@@ -433,7 +433,7 @@ function renderLive(d){
   if(drawTbl){
   document.getElementById('netchart').innerHTML='';
   var nets=d.net||{}, nrows=[], nmax=1;
-  for(var nm in nets){ if(!nets.hasOwnProperty(nm))continue; var v=(nets[nm][0]||0)+(nets[nm][1]||0); nrows.push([nm,v]); if(v>nmax)nmax=v; }
+  for(var nm in nets){ if(!nets.hasOwnProperty(nm))continue; if(nm==="Router")continue; /* reaper: hide the router-self bucket (ntp/update/probe) from the per-network view */ var v=(nets[nm][0]||0)+(nets[nm][1]||0); nrows.push([nm,v]); if(v>nmax)nmax=v; }
   nrows.sort(function(a,b){return b[1]-a[1];});
   var nh='';
   for(var n2=0;n2<nrows.length;n2++){ var col=NETCOLOR[n2%NETCOLOR.length];
-- 
