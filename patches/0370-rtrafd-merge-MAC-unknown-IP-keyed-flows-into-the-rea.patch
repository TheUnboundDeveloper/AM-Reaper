diff --git a/release/src/router/rtrafd/rtrafd.c b/release/src/router/rtrafd/rtrafd.c
index 09c55bd41d..0a28b022ae 100644
--- a/release/src/router/rtrafd/rtrafd.c
+++ b/release/src/router/rtrafd/rtrafd.c
@@ -397,6 +397,18 @@ static int cli_slot(const char *key, const char *ip)
 		cli[i].last = time(NULL);
 		return i;
 	}
+	/* v2.3.0: a MAC-unknown flow falls back to an IP key (cli_slot(ip, ip)). If this
+	 * device is already tracked by its real MAC, reuse that slot instead of spawning a
+	 * duplicate IP-keyed phantom - the same (usually offline) device otherwise appears
+	 * twice, once by MAC and once by IP, in the health/traffic tables and the exports.
+	 * Only for an IPv4-looking key (no ':', has '.'); never a MAC or the "router" bucket. */
+	if (!strchr(key, ':') && strchr(key, '.')) {
+		for (i = 0; i < NCLI; i++)
+			if (cli[i].used && strchr(cli[i].key, ':') && strcmp(cli[i].ip, ip) == 0) {
+				cli[i].last = time(NULL);
+				return i;
+			}
+	}
 	/* new client: a free slot (the O(NCLI) walk here runs only on first sight) */
 	for (i = 0; i < NCLI; i++)
 		if (!cli[i].used) { oldest = i; goto take; }
