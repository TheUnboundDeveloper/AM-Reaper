From 522241c96cd9b4ead30da59877aec891b82e4b86 Mon Sep 17 00:00:00 2001
From: reaper <theunbounddeveloper@outlook.com>
Date: Sat, 8 Aug 2026 13:26:46 -0400
Subject: [PATCH 368/369] rtrafd: periodic sweep to evict IP-keyed phantom
 slots (completes the dedup)

The cli_slot() merge (60aa369376) only stopped an IP-keyed slot from forming
when the MAC was ALREADY known. It did not clean one created BEFORE the MAC
resolved (boot-time lingering conntrack arrives before ARP populates) or one
reloaded from a pre-fix rtraf.db - so a device still showed twice (once by MAC,
once with the IP jammed into "mac"), exactly as reported.

Add cli_dedup_ipkeys(): a 1 Hz sweep that drops any IP-keyed slot which has a
MAC-keyed twin at the same IP (the MAC slot is authoritative; its ring + health
are cleared and the index rebuilt). Off the per-flow hot path. Existing phantoms
self-clean within ~1 s of their MAC slot being present; new ones are still
prevented up front by the cli_slot merge. Together: at most one slot per device.

v2.3.0.
---
 release/src/router/rtrafd/rtrafd.c | 29 +++++++++++++++++++++++++++++
 1 file changed, 29 insertions(+)

diff --git a/release/src/router/rtrafd/rtrafd.c b/release/src/router/rtrafd/rtrafd.c
index 0a28b022ae..48c844308a 100644
--- a/release/src/router/rtrafd/rtrafd.c
+++ b/release/src/router/rtrafd/rtrafd.c
@@ -1457,6 +1457,34 @@ static void write_health(void)
 	}
 }
 
+/* v2.3.0: fold away IP-keyed phantom client slots. A device first seen before its
+ * MAC resolved (boot-time lingering conntrack, or a slot reloaded from a pre-fix
+ * rtraf.db) leaves a slot keyed by its IP that duplicates the real MAC-keyed slot
+ * for the same IP - so it shows twice (once by MAC, once with the IP in the "mac"
+ * field) in health.json, the analytics export, and the Traffic Analyzer. Drop each
+ * IP-keyed slot that has a MAC-keyed twin at the same IP. Cheap: 1 Hz, off the
+ * per-flow hot path. Complements the cli_slot() merge that prevents most forming. */
+static void cli_dedup_ipkeys(void)
+{
+	int i, j, evicted = 0;
+	for (i = 0; i < NCLI; i++) {
+		if (!cli[i].used) continue;
+		if (strchr(cli[i].key, ':') || !strchr(cli[i].key, '.'))
+			continue;		/* only IPv4-keyed slots are phantom candidates */
+		for (j = 0; j < NCLI; j++) {
+			if (j == i || !cli[j].used) continue;
+			if (strchr(cli[j].key, ':') && strcmp(cli[j].ip, cli[i].ip) == 0) {
+				cli[i].used = 0;	/* MAC slot is authoritative; drop the IP twin */
+				memset(r_cli[i], 0, sizeof(ring_t));
+				memset(&chealth[i], 0, sizeof(chealth[i]));
+				evicted = 1;
+				break;
+			}
+		}
+	}
+	if (evicted) cli_index_rebuild();
+}
+
 /* v2.2.4: flush the RAM spool to $store/healthhist.log (rotated at HLOG_MAX) and
  * truncate it. Called from the existing periodic-save tick - the one place that
  * already blocks on flash - so history persistence stays entirely off the hot loop.
@@ -1863,6 +1891,7 @@ int main(int argc, char **argv)
 		}
 		if (tick % TPS == 0) {
 			refresh_cfg();	/* reload cached nvram config at 1 Hz, not per tick */
+			cli_dedup_ipkeys();	/* v2.3.0: drop IP-keyed phantoms of MAC-keyed devices */
 			/* v2.2.5 review: if the health probe is turned OFF mid-cycle, the
 			 * cfg_hprobe-gated block below stops running - release the conntrack
 			 * handle and reset the phase so no fd is held while it's disabled
