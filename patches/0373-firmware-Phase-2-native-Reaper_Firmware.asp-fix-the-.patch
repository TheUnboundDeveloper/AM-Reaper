@@ -1,22 +1,31 @@
 #!/bin/sh
 # reaper_webs_note.sh - release-note fetch for the Reaper update check.
-# Args: $1 = model (unused; kept for stock call-signature compat)  $2 = version
-# Fetches updates/notes/Reaper_v<ver>.txt from the Reaper GitHub raw tree into
-# /tmp/release_note.txt and sets cfg_note the way the stock page expects.
+# Args: $1 = model (unused; stock call-signature compat)  $2 = version string.
+# BOTH args are optional: when absent (the plain "start_release_note" rc
+# service passes none) the version comes from webs_state_info, which the
+# update check has already set. Fetches updates/notes/Reaper_v<ver>.txt from
+# the Reaper GitHub raw tree and writes it where the GUI reads notes:
+# /tmp/release_note0.txt (nvram_dump target of /release_note0.asp - the file
+# the stock viewer iframe and Reaper_Firmware.asp actually fetch; the
+# original Phase 1 script wrote only /tmp/release_note.txt, which nothing
