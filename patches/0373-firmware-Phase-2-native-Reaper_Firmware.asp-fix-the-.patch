-if [ $# -lt 2 ]; then
+info="$2"
+[ -n "$info" ] || info=$(nvram get webs_state_info)
+if [ -z "$info" ]; then
 	nvram set cfg_note=2
 	exit 0
 fi
 
-# $2 arrives as the webs_state_info string "3006.102.8_Reaper_v2.1.5"; take the vX.Y.Z
-ver=$(echo "$2" | sed 's/.*Reaper_v//; s/[^0-9.].*//')
