diff --git a/release/src/router/rom/webs_scripts/reaper_webs_upgrade.sh b/release/src/router/rom/webs_scripts/reaper_webs_upgrade.sh
new file mode 100755
index 0000000000..7d65e56175
--- /dev/null
+++ b/release/src/router/rom/webs_scripts/reaper_webs_upgrade.sh
@@ -0,0 +1,120 @@
+#!/bin/sh
+# reaper_webs_upgrade.sh - Reaper GitHub-hosted download + verify + FLASH (Phase 2).
+# Installed as /usr/sbin/webs_upgrade.sh (rom/Makefile, MERLINUPDATE branch) and
+# run by the generic "start_webs_upgrade" rc service (services.c webs_* fallback).
+# Downloads the image webs_state_url points at - that nvram is set ONLY by
+# reaper_webs_update.sh from the Reaper manifest - re-checks the URL host, the
+# model and the MCP/noMCP variant on this box, verifies the manifest SHA-256,
+# runs the platform firmware_check applet, then flashes with the same sequence
+# stock ssl_webs_upgrade.sh uses (stop services -> restart_upgrade). On success
+# the router reboots into the new firmware and this script never returns.
+#
+# UI contract (Reaper_Firmware.asp polls ajax_fwdl_percent.asp):
+#   webs_state_upgrade  0 = running (downloading/verifying)
+#                       2 = verified, flashing (reboot imminent)
+#                       1 = finished WITHOUT flashing - read webs_state_error
+#   webs_state_error    1 = guard/download failure   2 = not enough RAM
+#                       3 = verification failure (size/sha256/firmware_check)
+
+LOG=/tmp/webs_upgrade.log
+FW=/tmp/linux.trx
+WGET_LOG=/tmp/fwget_log
+
+fail() {
+	echo "---- ABORT: $1 ----" >> "$LOG"
+	logger -t REAPER_UPGRADE "abort: $1"
+	rm -f "$FW"
+	nvram set webs_state_error=$2
+	nvram set webs_state_upgrade=1
+	exit 0
+}
+
+nvram set webs_state_upgrade=0
+nvram set webs_state_error=0
+echo "---- reaper webs upgrade $(date) ----" > "$LOG"
+rm -f "$FW" "$WGET_LOG"
+
+url=$(nvram get webs_state_url)
+sha=$(nvram get webs_state_sha256 | tr 'A-F' 'a-f')
+size=$(nvram get webs_state_size)
+model=$(nvram get productid)
+
+[ -n "$url" ] || fail "no download url - run the update check first" 1
+[ "$(nvram get webs_state_flag)" = "1" ] || fail "no update pending - run the update check first" 1
+
+# host pin: only images published on the Reaper GitHub release channel
+case "$url" in
+	https://github.com/TheUnboundDeveloper/AM-Reaper/*) ;;
+	*) fail "url is not the Reaper release channel: $url" 1 ;;
+esac
+
+# model guard: the image basename must be for THIS productid (anchored at
+# "_3006" so GT-BE98 can never match a GT-BE98_PRO image or vice versa)
+base=${url##*/}
+case "$base" in
+	"${model}_3006"*) ;;
+	*) fail "image $base is not for $model" 1 ;;
+esac
+
+# variant guard: same on-box signal reaper_webs_update.sh / reaper_verify use
+if [ -f /usr/sbin/rmcpd ] || [ -f /www/Reaper_Advisor.asp ]; then
+	case "$base" in
+		*_noMCP_*) fail "noMCP image offered to an MCP box" 1 ;;
+	esac
+else
+	case "$base" in
+		*_noMCP_*) ;;
+		*) fail "MCP image offered to a noMCP box" 1 ;;
+	esac
+fi
+
+# never flash blind: the manifest entry must carry the image checksum
+[ -n "$sha" ] || fail "manifest carries no sha256 for this image - not flashing unverified" 3
+
+# space check: /tmp (tmpfs) must hold the image plus slack
+need_kb=$(( ${size:-125829120} / 1024 + 8192 ))
+free_kb=$(df -k /tmp | awk 'NR==2{print $4}')
+if [ -z "$free_kb" ] || [ "$free_kb" -le "$need_kb" ]; then
+	fail "not enough free RAM for the download (need ${need_kb}kB have ${free_kb:-0}kB)" 2
+fi
+
+echo "---- downloading $base ----" >> "$LOG"
+logger -t REAPER_UPGRADE "downloading $base"
+# GNU wget; --output-file feeds ej_get_fwdl_percent (the page's progress bar)
+/usr/sbin/wget -t 2 -T 30 --output-file="$WGET_LOG" "$url" -O "$FW"
+if [ "$?" != "0" ] || [ ! -s "$FW" ]; then
+	fail "download failed" 1
+fi
+
+if [ -n "$size" ] && [ "$(wc -c < "$FW")" != "$size" ]; then
+	fail "size mismatch (got $(wc -c < "$FW") want $size)" 3
+fi
+
+got=$(sha256sum "$FW" | cut -d' ' -f1)
+if [ "$got" != "$sha" ]; then
+	fail "sha256 mismatch (got $got want $sha)" 3
+fi
+echo "---- sha256 verified ----" >> "$LOG"
+logger -t REAPER_UPGRADE "sha256 verified"
+
+# platform image sanity check (stock applet; sets nvram firmware_check=1 on pass)
+nvram set firmware_check=0
+firmware_check "$FW"
+sleep 1
+if [ "$(nvram get firmware_check)" != "1" ]; then
+	fail "firmware_check rejected the image" 3
+fi
+
+nvram set webs_state_upgrade=2
+echo "---- image verified - flashing, router will reboot ----" >> "$LOG"
+logger -t REAPER_UPGRADE "image verified - flashing, router will reboot"
+
+# stock flash sequence (mirrors ssl_webs_upgrade.sh; RSA step replaced by the
+# SHA-256 + firmware_check verification above)
+/sbin/ejusb -1 0
+rc rc_service stop_logger
+rc rc_service "stop_jffs2 0"
+sleep 1
+nvram set auto_upgrade=0
+nvram commit
+rc rc_service restart_upgrade
