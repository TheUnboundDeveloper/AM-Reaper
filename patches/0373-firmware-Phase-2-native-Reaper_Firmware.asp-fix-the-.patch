index 0000000000..cc4fa0e6a0
--- /dev/null
+++ b/release/src/router/www/Reaper_Firmware.asp
@@ -0,0 +1,465 @@
+<!-- SPDX-License-Identifier: GPL-2.0-only
+     Copyright (C) 2026 the Reaper project maintainer
+     Part of the Reaper hardened Asuswrt-Merlin build. See LICENSE / LICENSE.reaper.
+     reaper 2026-08-08: Phase 2 native firmware page (replaces the stock
+     Advanced_FirmwareUpgrade_Content.asp tab). The stock page's Check routed
+     through cfg_mnt (action_mode=firmware_check -> ASUS's servers) whenever
+     cfg_sync is compiled in, so the Reaper update check (reaper_webs_update.sh,
+     Phase 1) never ran from the GUI. This page drives the Reaper scripts
+     directly: start_webs_update (manifest check), start_release_note (note
+     fetch), start_webs_upgrade (reaper_webs_upgrade.sh: download, SHA-256 +
+     firmware_check verify, flash). Manual upload posts to the stock
+     upgrade.cgi (do_upgrade_post) like the stock page did. Progress rides the
+     stock ej ajax_fwdl_percent.asp; notes ride /release_note0.asp. -->
+<!DOCTYPE html>
+<html lang="en">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width, initial-scale=1">
+<meta name="reaper-native" content="1">
+<title>REAPER &mdash; <#menu5_6_3#></title>
+<style>
+@font-face{font-family:'Rajdhani';font-weight:600;font-display:swap;src:url('/fonts/rajdhani-600.woff2') format('woff2')}
+@font-face{font-family:'Rajdhani';font-weight:700;font-display:swap;src:url('/fonts/rajdhani-700.woff2') format('woff2')}
+@font-face{font-family:'Inter';font-weight:400;font-display:swap;src:url('/fonts/inter-400.woff2') format('woff2')}
+@font-face{font-family:'Inter';font-weight:600;font-display:swap;src:url('/fonts/inter-600.woff2') format('woff2')}
+:root{
+  --bg:#08080a; --panel:#0f0f12; --panel-2:#141418;
+  --line:rgba(225,6,0,.16); --line-soft:rgba(255,255,255,.06);
+  --crimson:#E10600; --crimson-deep:#B3000C;
+  --bone:#ECE7DB; --bone-dim:#B7B1A4; --steel:#71767b;
+  --jade:#4FB286; --amber:#E0A93B; --danger:#FF3B30;
+  --hdr:'Rajdhani','Oswald',system-ui,sans-serif;
+  --body:'Inter',system-ui,-apple-system,'Segoe UI',sans-serif;
+}
+*{box-sizing:border-box;margin:0}
+html,body{background:var(--bg)}
+body{font-family:var(--body);color:var(--bone-dim);font-size:13.5px;line-height:1.55;padding:20px 22px 48px}
+h1,h2{font-family:var(--hdr);letter-spacing:.04em;color:var(--bone);margin:0}
+.pagehead{display:flex;align-items:center;gap:16px;flex-wrap:wrap;margin-bottom:12px;max-width:1120px}
+.pagehead h1{font-size:24px;font-weight:700}
+.card{background:var(--panel);border:1px solid var(--line-soft);border-radius:12px;padding:16px 18px;margin-bottom:16px;max-width:1120px}
+.card h2{font-size:15px;font-weight:600;text-transform:uppercase;letter-spacing:.08em;margin-bottom:10px}
+.note{font-size:12px;color:var(--steel);line-height:1.55;margin-top:6px}
+.rowg{display:grid;grid-template-columns:170px 1fr;gap:4px 14px;font-size:13px}
+.rowg .rl{color:var(--steel);text-transform:uppercase;font-size:11px;letter-spacing:.08em;align-self:center}
+.rowg .rv{color:var(--bone)}
+.badge{display:inline-block;font-size:10px;font-weight:600;text-transform:uppercase;letter-spacing:.08em;border:1px solid var(--crimson-deep);color:var(--bone);background:rgba(225,6,0,.10);border-radius:4px;padding:2px 7px;margin-left:8px;vertical-align:1px}
+.btn2{font-family:var(--hdr);font-weight:600;letter-spacing:.06em;text-transform:uppercase;font-size:11.5px;color:var(--bone-dim);background:transparent;border:1px solid rgba(255,255,255,.16);border-radius:8px;padding:8px 16px;cursor:pointer}
+.btn2:hover{color:var(--bone);border-color:var(--crimson-deep)}
+.btn2[disabled]{opacity:.4;cursor:not-allowed}
+.btnP{font-family:var(--hdr);font-weight:700;letter-spacing:.06em;text-transform:uppercase;font-size:12px;color:var(--bone);background:linear-gradient(180deg,var(--crimson),var(--crimson-deep));border:1px solid var(--crimson-deep);border-radius:8px;padding:9px 18px;cursor:pointer}
+.btnP:hover{filter:brightness(1.12)}
+.btnP[disabled]{opacity:.4;cursor:not-allowed;filter:none}
+.acts{display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin-top:10px}
+.stat{font-size:12.5px;margin-top:10px;color:var(--steel)}
+.stat.ok{color:var(--jade)} .stat.err{color:var(--danger)} .stat.run{color:var(--bone-dim)}
+.avail{display:none;border:1px solid var(--line);border-radius:10px;background:var(--panel-2);padding:14px 16px;margin-top:12px}
+.avail .av{font-family:var(--hdr);font-weight:700;font-size:19px;color:var(--bone)}
+.avail .avtag{color:var(--crimson);font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:.1em;margin-bottom:2px}
+.notebox{display:none;margin-top:10px;max-height:280px;overflow:auto;background:#0a0a0c;border:1px solid var(--line-soft);border-radius:8px;padding:10px 12px;font:11.5px/1.6 monospace;color:var(--bone-dim);white-space:pre-wrap}
+.nblbl{font-size:11px;text-transform:uppercase;letter-spacing:.08em;color:var(--steel);margin-top:12px;display:none}
+.bar{height:8px;border-radius:5px;background:#1c1c21;overflow:hidden;margin-top:10px;display:none}
+.bar i{display:block;height:100%;width:0;background:linear-gradient(90deg,var(--crimson-deep),var(--crimson));transition:width .4s ease}
+.tgl{display:flex;align-items:center;gap:10px;margin-top:2px}
+.tgl input{width:16px;height:16px;accent-color:#555a60;cursor:pointer}
+.tgl label{color:var(--bone);font-size:13px;cursor:pointer}
+.file{margin-top:4px}
+.file input[type=file]{color:var(--bone-dim);font-size:12.5px}
+.file input[type=file]::file-selector-button{font-family:var(--hdr);font-weight:600;letter-spacing:.06em;text-transform:uppercase;font-size:11px;color:var(--bone-dim);background:transparent;border:1px solid rgba(255,255,255,.16);border-radius:8px;padding:7px 14px;margin-right:12px;cursor:pointer}
+.veil{display:none;position:fixed;inset:0;background:rgba(4,4,5,.92);z-index:1000;align-items:center;justify-content:center}
+.veil .vin{max-width:480px;width:90%;text-align:center}
+.veil .vt{font-family:var(--hdr);font-weight:700;font-size:20px;color:var(--bone);letter-spacing:.04em}
+.veil .vs{font-size:12.5px;color:var(--bone-dim);margin-top:8px}
+.veil .vw{font-size:11.5px;color:var(--amber);text-transform:uppercase;letter-spacing:.08em;margin-top:14px}
+.veil .bar{display:block}
+</style>
+</head>
+<body>
+<div class="pagehead">
+  <h1><#menu5_6_3#></h1>
+</div>
+
+<div class="card">
+  <h2><#RFWU_1#></h2>
+  <div class="rowg">
+    <span class="rl"><#RFWU_29#></span><span class="rv" id="rvModel"></span>
+    <span class="rl"><#RFWU_24#></span><span class="rv" id="rvVariant"></span>
+    <span class="rl"><#RFWU_20#></span><span class="rv" id="rvVer"></span>
+    <span class="rl"><#RFWU_21#></span><span class="rv" id="rvBase"></span>
+  </div>
+  <p class="note"><#RFWU_23#></p>
+</div>
+
+<div class="card">
+  <h2><#RFWU_2#></h2>
+  <div class="acts">
+    <button class="btn2" id="btnCheck" onclick="doCheck()"><#RFWU_3#></button>
+    <span class="stat" id="chkStat" style="margin-top:0"></span>
+  </div>
+  <div class="avail" id="availBox">
+    <div class="avtag"><#RFWU_6#></div>
+    <div class="av" id="availVer"></div>
+    <div class="acts">
+      <button class="btnP" id="btnInstall" onclick="doInstall()"><#RFWU_8#></button>
+      <span class="note" id="shaNote" style="margin-top:0"></span>
+    </div>
+    <div class="nblbl" id="noteLbl"><#RFWU_19#></div>
+    <div class="notebox" id="noteBox"></div>
+  </div>
+  <div style="margin-top:16px;border-top:1px solid var(--line-soft);padding-top:12px">
+    <div class="tgl">
+      <input type="checkbox" id="schedChk" onchange="schedSave()">
+      <label for="schedChk"><#RFWU_14#></label>
+      <span class="stat ok" id="schedStat" style="margin-top:0;display:none">&#10003;</span>
+    </div>
+    <p class="note"><#RFWU_15#></p>
+  </div>
+</div>
+
+<div class="card">
+  <h2><#RFWU_16#></h2>
+  <p class="note" style="margin:0 0 8px"><#RFWU_17#> <#RFWU_26#></p>
+  <div class="acts file">
+    <input type="file" id="fwFile" accept=".pkgtb,.trx,.w">
+    <button class="btnP" id="btnUpload" onclick="doUpload()"><#CTL_upload#></button>
+  </div>
+  <div class="stat" id="upStat"></div>
+</div>
+
+<div class="veil" id="veil">
+  <div class="vin">
+    <div class="vt" id="veilT"></div>
+    <div class="bar" id="veilBar"><i id="veilBarI"></i></div>
+    <div class="vs" id="veilS"></div>
+    <div class="vw"><#RFWU_26#></div>
+  </div>
+</div>
+
+<iframe name="fw_hidden" style="display:none"></iframe>
+
+<script>
+var MODEL = '<% nvram_get("productid"); %>';
+var FIRMVER = '<% nvram_get("firmver"); %>';
+var BUILDNO = '<% nvram_get("buildno"); %>';
+var EXTENDNO = '<% nvram_get("extendno"); %>';
+var PREF_LANG = '<% nvram_get("preferred_lang"); %>';
+var FW = {
+  flag: '<% nvram_get("webs_state_flag"); %>',
+  info: '<% nvram_get("webs_state_info"); %>',
+  url:  '<% nvram_get("webs_state_url"); %>',
+  sha:  '<% nvram_get("webs_state_sha256"); %>',
+  err:  '<% nvram_get("webs_state_error"); %>',
+  upd:  '<% nvram_get("webs_state_update"); %>'
+};
+var CHK_EN = '<% nvram_get("firmware_check_enable"); %>';
+/* the noMCP build stamps "_noMCP" into EXTENDNO (same signal the backend
+   scripts read from the filesystem) - no extra probe needed */
+var IS_MCP = EXTENDNO.indexOf('_noMCP') < 0;
+var busy = 0;
+
+function esc(s){ return String(s==null?'':s).replace(/[&<>"']/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];}); }
+function $id(i){ return document.getElementById(i); }
+function prettyVer(s){
+  /* "3006.102.8_Reaper_v2.3.0[_noMCP]" or "Reaper_v2.3.0a" -> "Reaper v2.3.0a" */
+  var m = String(s||'').match(/Reaper_v([0-9][0-9a-z.\-]*)/);
+  return m ? 'Reaper v' + m[1] : String(s||'');
+}
+
+function nvGet(name, cb){   /* single-nvram read via appGet (Reaper_USB pattern) */
+  var x = new XMLHttpRequest();
+  x.open('GET', '/appGet.cgi?hook=' + encodeURIComponent('nvram_get(' + name + ')') + '&_=' + Date.now(), true);
+  x.timeout = 8000;
+  x.onreadystatechange = function(){
+    if(x.readyState !== 4) return;
+    var v = null;
+    if(x.status === 200){
+      try{ var j = JSON.parse(x.responseText), k; for(k in j){ v = j[k]; break; } }catch(e){}
+    }
+    cb(v === null ? '' : String(v));
+  };
+  x.onerror = function(){ cb(''); };
+  x.send();
+}
+function nvGetMany(names, cb, acc){   /* sequential reads -> {name:value} */
+  acc = acc || {};
+  if(!names.length){ cb(acc); return; }
+  var n = names[0];
+  nvGet(n, function(v){ acc[n] = v; nvGetMany(names.slice(1), cb, acc); });
+}
+
+function post(fields){      /* stock apply flow (start_apply.htm, hidden iframe) */
+  var f = document.createElement('form'), k;
+  f.method = 'POST'; f.action = '/start_apply.htm'; f.target = 'fw_hidden'; f.style.display = 'none';
+  fields.action_mode = 'apply';
+  if(!('action_wait' in fields)) fields.action_wait = '1';
+  for(k in fields){
+    var i = document.createElement('input');
+    i.type = 'hidden'; i.name = k; i.value = fields[k]; f.appendChild(i);
+  }
+  document.body.appendChild(f); f.submit();
+  setTimeout(function(){ f.parentNode && f.parentNode.removeChild(f); }, 4000);
+}
+
+function setStat(id, txt, cls){
+  var n = $id(id);
+  if(n){ n.className = 'stat' + (cls ? ' ' + cls : ''); n.innerHTML = txt; if(id === 'chkStat') n.style.marginTop = '0'; }
+}
+
+/* ---------------- update check ---------------- */
+
+function doCheck(){
+  if(busy) return;
+  busy = 1;
+  $id('btnCheck').disabled = true;
+  $id('availBox').style.display = 'none';
+  setStat('chkStat', esc(`<#RFWU_4#>`), 'run');
+  post({ action_script: 'start_webs_update' });
+  setTimeout(function(){ pollCheck(0); }, 2500);
+}
+
+function pollCheck(tries){
+  if(tries > 40){ checkDone({ 'webs_state_error': '1' }); return; }
+  nvGet('webs_state_update', function(v){
+    if(v !== '1'){ setTimeout(function(){ pollCheck(tries + 1); }, 1500); return; }
+    nvGetMany(['webs_state_flag','webs_state_error','webs_state_info','webs_state_url','webs_state_sha256'], checkDone);
+  });
+}
+
+function checkDone(r){
+  busy = 0;
+  $id('btnCheck').disabled = false;
+  FW.flag = r['webs_state_flag'] || '0';
+  FW.err  = r['webs_state_error'] || '0';
+  FW.info = r['webs_state_info'] || '';
+  FW.url  = r['webs_state_url'] || '';
+  FW.sha  = r['webs_state_sha256'] || '';
+  if(FW.err !== '' && FW.err !== '0'){
+    setStat('chkStat', esc(`<#RFWU_7#>`), 'err');
+    return;
+  }
+  if(FW.flag === '1'){ showAvail(); }
+  else setStat('chkStat', esc(`<#RFWU_5#>`), 'ok');
+}
+
+function showAvail(){
+  setStat('chkStat', '', '');
+  $id('availVer').textContent = prettyVer(FW.info);
+  $id('btnInstall').disabled = !FW.sha;
+  $id('shaNote').innerHTML = FW.sha ? ('SHA-256 ' + esc(FW.sha.substring(0, 16)) + '&hellip;') : esc(`<#RFWU_22#>`);
+  $id('availBox').style.display = 'block';
+  loadNote(0);
+}
+
+/* ---------------- release note ---------------- */
+
+function loadNote(round){
+  var x = new XMLHttpRequest();
+  x.open('GET', '/release_note0.asp?_=' + Date.now(), true);
+  x.timeout = 8000;
+  x.onreadystatechange = function(){
+    if(x.readyState !== 4) return;
+    var t = (x.status === 200) ? String(x.responseText || '').replace(/^\s+|\s+$/g, '') : '';
+    if(t.length > 4){
+      $id('noteBox').textContent = t;
+      $id('noteBox').style.display = 'block';
+      $id('noteLbl').style.display = 'block';
+      return;
+    }
+    if(round === 0){
+      /* nothing cached on the box yet - ask rc to fetch it, then poll */
+      post({ action_script: 'start_release_note' });
+      setTimeout(function(){ pollNote(0); }, 2000);
+    }
+  };
+  x.send();
+}
+function pollNote(tries){
+  if(tries > 15) return;
+  nvGet('cfg_note', function(v){
+    if(v === '1'){ loadNote(1); }
+    else if(v === '2'){ /* fetch failed; leave the box hidden */ }
+    else setTimeout(function(){ pollNote(tries + 1); }, 1500);
+  });
+}
+
+/* ---------------- download + install ---------------- */
+
+function veil(title, sub, showBar){
+  $id('veilT').innerHTML = title;
+  $id('veilS').innerHTML = sub || '';
+  $id('veilBar').style.display = showBar ? 'block' : 'none';
+  $id('veil').style.display = 'flex';
+}
+function veilPct(p){ $id('veilBarI').style.width = Math.max(0, Math.min(100, p)) + '%'; }
+function veilOff(){ $id('veil').style.display = 'none'; }
+
+function doInstall(){
+  if(busy || !FW.sha) return;
+  if(!confirm(`<#RFWU_9#>`)) return;
+  busy = 1;
+  veil(esc(`<#RFWU_10#>`), prettyVer(FW.info), true);
+  veilPct(0);
+  post({ action_script: 'start_webs_upgrade' });
+  setTimeout(function(){ pollInstall(0); }, 2500);
+}
+
+function pollInstall(tries){
+  if(tries > 900){ installFail(`<#RFWU_12#>`); return; }   /* 30 min cap */
+  var x = new XMLHttpRequest();
+  x.open('GET', '/ajax_fwdl_percent.asp?_=' + Date.now(), true);
+  x.timeout = 6000;
+  x.onreadystatechange = function(){
+    if(x.readyState !== 4) return;
+    if(x.status !== 200){
+      /* httpd going away while installing = the flash sequence took over */
+      veil(esc(`<#RFWU_11#>`), esc(`<#RFWU_28#>`), false);
+      pollBack(0, 0);
+      return;
+    }
+    var t = String(x.responseText || '');
+    var up = (t.match(/webs_state_upgrade\s*=\s*'?(\d+)/) || [])[1] || '0';
+    var er = (t.match(/webs_state_error\s*=\s*'?(\d+)/) || [])[1] || '0';
+    var pc = (t.match(/fwdl_percent\s*=\s*"(\d+)%/) || [])[1];
+    if(up === '2'){
+      veil(esc(`<#RFWU_11#>`), esc(`<#RFWU_28#>`), false);
+      setTimeout(function(){ pollBack(0, 0); }, 4000);
+      return;
+    }
+    if(up === '1'){
+      if(er === '2') installFail(`<#RFWU_25#>`);
+      else if(er === '3') installFail(`<#RFWU_13#>`);
+      else installFail(`<#RFWU_12#>`);
+      return;
+    }
+    if(pc !== undefined) veilPct(parseInt(pc, 10));
+    setTimeout(function(){ pollInstall(tries + 1); }, 2000);
+  };
+  x.onerror = function(){
+    veil(esc(`<#RFWU_11#>`), esc(`<#RFWU_28#>`), false);
+    pollBack(0, 0);
+  };
+  x.send();
+}
+
+function installFail(tok){
+  busy = 0;
+  veilOff();
+  setStat('chkStat', esc(tok), 'err');
+}
+
+function pollBack(tries, wentDown){
+  /* wait for the router to reboot into the new firmware: it must go DOWN
+     first (wentDown), then answer again -> back to login */
+  if(tries > 450){ veil(esc(`<#FIRM_reboot_manually#>`), '', false); return; }
+  var x = new XMLHttpRequest();
+  x.open('GET', '/httpd_check.xml?_=' + Date.now(), true);
+  x.timeout = 3000;
+  x.onreadystatechange = function(){
+    if(x.readyState !== 4) return;
+    if(x.status === 200){
+      if(wentDown){ location.href = '/Main_Login.asp'; return; }
+      setTimeout(function(){ pollBack(tries + 1, 0); }, 2000);
+    } else {
+      setTimeout(function(){ pollBack(tries + 1, 1); }, 2000);
+    }
+  };
+  x.onerror = function(){ setTimeout(function(){ pollBack(tries + 1, 1); }, 2000); };
+  x.send();
+}
+
+/* ---------------- scheduled check ---------------- */
+
+function schedSave(){
+  var v = $id('schedChk').checked ? '1' : '0';
+  post({ action_script: 'saveNvram', firmware_check_enable: v });
+  var s = $id('schedStat');
+  s.style.display = 'inline';
+  setTimeout(function(){ s.style.display = 'none'; }, 2500);
+}
+
+/* ---------------- manual upload ---------------- */
+
+function doUpload(){
+  if(busy) return;
+  var inp = $id('fwFile');
+  if(!inp.files || !inp.files.length){ setStat('upStat', esc(`<#RFWU_17#>`), ''); return; }
+  var f = inp.files[0], nm = String(f.name || '');
+  var looksRight = nm.indexOf(MODEL + '_3006') === 0 &&
+                   (IS_MCP ? nm.indexOf('_noMCP_') < 0 : nm.indexOf('_noMCP_') >= 0);
+  if(!looksRight && !confirm(`<#RFWU_30#>`)) return;
+  if(!confirm(`<#RFWU_31#>`)) return;
+  busy = 1;
+  setStat('upStat', '', '');
+  veil(esc(`<#RFWU_18#>`), esc(nm), true);
+  veilPct(0);
+  var fd = new FormData();
+  fd.append('current_page', 'Reaper_Firmware.asp');
+  fd.append('next_page', '');
+  fd.append('action_mode', '');
+  fd.append('action_script', '');
+  fd.append('action_wait', '');
+  fd.append('preferred_lang', PREF_LANG);
+  fd.append('firmver', FIRMVER);
+  fd.append('file', f, nm);
+  var x = new XMLHttpRequest();
+  x.open('POST', '/upgrade.cgi', true);
+  if(x.upload) x.upload.onprogress = function(ev){
+    if(ev.lengthComputable) veilPct(Math.round(ev.loaded / ev.total * 100));
+  };
+  x.onload = function(){
+    /* do_upgrade_post has the image; httpd now verifies + flashes (success
+       reboots the box). Liveness decides the verdict: if the router never
+       goes down, the image was rejected. */
+    veil(esc(`<#RFWU_11#>`), esc(`<#RFWU_28#>`), false);
+    pollUpBack(0, 0);
+  };
+  x.onerror = function(){
+    /* connection torn down mid-response usually means the flash started */
+    veil(esc(`<#RFWU_11#>`), esc(`<#RFWU_28#>`), false);
+    pollUpBack(0, 0);
+  };
+  x.send(fd);
+}
+
+function pollUpBack(tries, wentDown){
+  if(!wentDown && tries > 60){   /* ~2 min still answering = image rejected */
+    busy = 0;
+    veilOff();
+    setStat('upStat', esc(`<#RFWU_27#>`), 'err');
+    return;
+  }
+  if(tries > 450){ veil(esc(`<#FIRM_reboot_manually#>`), '', false); return; }
+  var x = new XMLHttpRequest();
+  x.open('GET', '/httpd_check.xml?_=' + Date.now(), true);
+  x.timeout = 3000;
+  x.onreadystatechange = function(){
+    if(x.readyState !== 4) return;
+    if(x.status === 200){
+      if(wentDown){ location.href = '/Main_Login.asp'; return; }
+      setTimeout(function(){ pollUpBack(tries + 1, 0); }, 2000);
+    } else {
+      setTimeout(function(){ pollUpBack(tries + 1, 1); }, 2000);
+    }
+  };
+  x.onerror = function(){ setTimeout(function(){ pollUpBack(tries + 1, 1); }, 2000); };
+  x.send();
+}
+
+/* ---------------- boot ---------------- */
+
+function boot(){
+  $id('rvModel').textContent = MODEL;
+  $id('rvVariant').innerHTML = IS_MCP ? 'AI Advisor <span class="badge">MCP</span>' : 'Standard <span class="badge">noMCP</span>';
+  $id('rvVer').textContent = prettyVer(EXTENDNO);
+  $id('rvBase').textContent = FIRMVER + '.' + BUILDNO;
+  $id('schedChk').checked = (CHK_EN === '1');
+  /* a previous check (scheduled or manual) already found an update ->
+     render it immediately (this is where the dashboard badge lands) */
+  if(FW.flag === '1' && FW.info){ showAvail(); }
+}
+if(document.readyState !== 'loading') boot();
+else document.addEventListener('DOMContentLoaded', boot);
+</script>
+</body>
+</html>
