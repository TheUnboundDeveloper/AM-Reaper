+/* ===================================================================
+ * reaper v2.3.3: Native Firewall suite, Phase 0 (Reaper_Firewall.asp).
+ *
+ * READ-ONLY visibility CGI: live iptables/ip6tables chain listings with
+ * exact hit counters (action=status) and the firewall-classified tail of
+ * the syslog for the drops viewer (action=drops). It changes nothing -
+ * every setting on the firewall page is written through the stock
+ * start_apply.htm -> restart_firewall path, and both popen() commands are
+ * fixed literals, so no request data ever reaches a shell. The raw listing
+ * text is passed through as JSON strings and parsed client-side (the
+ * Warden stats.sh precedent: keep the C dumb, keep the parsing where it
+ * can be iterated without a firmware build).
+ *
+ * Counters zero on every firewall rebuild (start_firewall fires on WAN
+ * events, service restarts, ...), so the page labels every count "since
+ * the last firewall rebuild" rather than pretending to a lifetime total.
+ *
+ * NOT MCP-gated - ships in both builds (kept OUTSIDE the RTCONFIG_REAPER_MCP
+ * block below, same as do_reaper_gk_cgi / do_reaper_warden_cgi). */
+
+/* emit the BODY of a JSON string (no surrounding quotes) - the same
+ * escaping contract as gk_json_esc, split out so multi-chunk output
+ * (popen lines, syslog lines) can stream into one JSON string value. */
+static void
+fw_json_frag(FILE *stream, const char *s)
+{
+	for (; *s; s++) {
+		unsigned char c = (unsigned char)*s;
+		if (c == '"' || c == '\\') websWrite(stream, "\\%c", c);
+		else if (c < 0x20) websWrite(stream, "\\u%04x", c);
+		else if (c == '<' || c == '>' || c == '&') websWrite(stream, "\\u%04x", c);
+		else websWrite(stream, "%c", c);
+	}
+}
+
+/* stream one FIXED-LITERAL command's stdout as a JSON string value, capped
+ * so a pathological chain set cannot balloon the response. */
+static void
+fw_emit_cmd(FILE *stream, const char *cmd, size_t cap)
+{
+	FILE *p;
+	char buf[512];
+	size_t used = 0;
+
+	websWrite(stream, "\"");
+	if ((p = popen(cmd, "r")) != NULL) {
+		while (fgets(buf, sizeof(buf), p) != NULL) {
+			used += strlen(buf);
+			if (used > cap) {
+				fw_json_frag(stream, "\n(truncated)\n");
+				break;
+			}
+			fw_json_frag(stream, buf);
+		}
+		pclose(p);
+	}
+	websWrite(stream, "\"");
+}
+
+/* a syslog line belongs to the drops viewer iff klogd tagged it kernel:
+ * and it carries one of the three firewall LOG prefixes this build can
+ * emit (complete inventory, rc/ grep 2026-08-10): "DROP " / "ACCEPT "
+ * (fw_log_x target chains, --state NEW only) and "REAPER-WARDEN "
+ * (rwarden_log=1, every packet). Gatekeeper drops emit no LOG rules. */
+static int
+fw_line_is_fwlog(const char *line)
+{
+	const char *k = strstr(line, "kernel:");
+	if (!k) return 0;
+	return (strstr(k, "DROP IN=") != NULL ||
+		strstr(k, "ACCEPT IN=") != NULL ||
+		strstr(k, "REAPER-WARDEN ") != NULL);
+}
+
+#define FW_DROPS_MAX	400
+#define FW_DROPS_LINE	640
+
+static void
+fw_scan_syslog(const char *path, char *ring, int *head, int *count)
+{
+	FILE *f;
+	char line[FW_DROPS_LINE];
+
+	if ((f = fopen(path, "r")) == NULL)
+		return;
+	while (fgets(line, sizeof(line), f) != NULL) {
+		if (!fw_line_is_fwlog(line)) continue;
+		strlcpy(ring + (size_t)(*head) * FW_DROPS_LINE, line, FW_DROPS_LINE);
+		*head = (*head + 1) % FW_DROPS_MAX;
+		if (*count < FW_DROPS_MAX) (*count)++;
+	}
+	fclose(f);
+}
+
+static void
+do_reaper_fw_cgi(char *url, FILE *stream)
+{
+	char *action = get_cgi("action");
+
+	if (!action) action = "status";
+
+	/* reaper (A1-SEC-002 model): every action here forks (popen) or walks
+	 * the syslog - require the http_id CSRF token like the Warden / diag
+	 * readers, on ALL actions. */
+	{
+		char *hid = get_cgi("http_id"), *want = nvram_safe_get("http_id");
+		if (!hid || !want[0] || strcmp(hid, want) != 0) {
+			websWrite(stream, "{\"ok\":0,\"error\":\"invalid request token\",\"ek\":\"RDEVE_1\"}");
+			return;
+		}
+	}
+
+	if (strcmp(action, "status") == 0) {
+		int v6up = 0;
+#ifdef RTCONFIG_IPV6
+		v6up = ipv6_enabled() ? 1 : 0;
+#endif
+		websWrite(stream,
+			"{\"ok\":1,\"fw\":{\"enable\":%d,\"dos\":%d,\"ping\":%d,"
+			"\"wl\":%d,\"lw\":%d,\"url\":%d,\"kw\":%d,"
+			"\"v6up\":%d,\"v6fw\":%d,\"gk\":%d,\"warden\":%d,\"wlog\":%d,\"log\":",
+			nvram_match("fw_enable_x", "1") ? 1 : 0,
+			nvram_match("fw_dos_x", "1") ? 1 : 0,
+			nvram_match("misc_ping_x", "1") ? 1 : 0,
+			nvram_match("fw_wl_enable_x", "1") ? 1 : 0,
+			nvram_match("fw_lw_enable_x", "1") ? 1 : 0,
+			nvram_match("url_enable_x", "1") ? 1 : 0,
+			nvram_match("keyword_enable_x", "1") ? 1 : 0,
+			v6up,
+			nvram_match("ipv6_fw_enable", "1") ? 1 : 0,
+			nvram_match("gk_enable", "1") ? 1 : 0,
+			nvram_match("rwarden_enable", "1") ? 1 : 0,
+			nvram_match("rwarden_log", "1") ? 1 : 0);
+		gk_json_esc(stream, nvram_safe_get("fw_log_x"));
+		websWrite(stream, "},\"v4\":");
+		fw_emit_cmd(stream, "iptables -nvxL 2>/dev/null", 98304);
+		websWrite(stream, ",\"v6\":");
+		fw_emit_cmd(stream, "ip6tables -nvxL 2>/dev/null", 65536);
+		websWrite(stream, "}");
+		return;
+	}
+
+	if (strcmp(action, "drops") == 0) {
+		/* last FW_DROPS_MAX matching lines across the rotated pair, oldest
+		 * file first so the ring ends holding the newest. 400*640 = 250 KB,
+		 * heap not stack. */
+		char *ring = calloc(FW_DROPS_MAX, FW_DROPS_LINE);
+		int head = 0, count = 0, i;
+
+		if (!ring) {
+			websWrite(stream, "{\"ok\":0,\"error\":\"oom\"}");
+			return;
+		}
+		fw_scan_syslog(get_syslog_fname(1), ring, &head, &count);
+		fw_scan_syslog(get_syslog_fname(0), ring, &head, &count);
+
+		websWrite(stream, "{\"ok\":1,\"wlog\":%d,\"n\":%d,\"log\":",
+			nvram_match("rwarden_log", "1") ? 1 : 0, count);
+		gk_json_esc(stream, nvram_safe_get("fw_log_x"));
+		websWrite(stream, ",\"lines\":\"");
+		for (i = 0; i < count; i++) {
+			int idx = (count < FW_DROPS_MAX) ? i : (head + i) % FW_DROPS_MAX;
+			fw_json_frag(stream, ring + (size_t)idx * FW_DROPS_LINE);
+		}
+		websWrite(stream, "\"}");
+		free(ring);
+		return;
+	}
+
+	websWrite(stream, "{\"ok\":0,\"error\":\"unknown action\"}");
+}
+
