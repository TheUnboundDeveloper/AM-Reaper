+++ b/release/src/router/www/Reaper_Firewall.asp
@@ -0,0 +1,786 @@
+<!-- SPDX-License-Identifier: GPL-2.0-only
+     Copyright (C) 2026 the Reaper project maintainer
+     Part of the Reaper hardened Asuswrt-Merlin build. See LICENSE / LICENSE.reaper.
+     reaper v2.3.3: Native Firewall suite, Phase 0. One hub page replacing the four
+     stock firewall tabs (General / Network Services / URL / Keyword) with native
+     equivalents that reuse the stock nvram + restart_firewall apply, plus two new
+     read-only views: Status (live iptables/ip6tables chains + hit counters, chain
+     ownership) and Logging (fw_log_x control + a firewall drop-log viewer). Status
+     and Logging read reaper_fw.cgi; the four filter tabs write through the stock
+     start_apply.htm path. Custom rules engine / egress / commit-confirm are Phase 1+
+     (docs/FIREWALL-PLAN.md), not in this rung. -->
+<!DOCTYPE html>
+<html lang="en">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width, initial-scale=1">
+<meta name="reaper-native" content="1">
+<title>REAPER &mdash; <#RFW_0#></title>
+<style>
+@font-face{font-family:'Rajdhani';font-weight:600;font-display:swap;src:url('/fonts/rajdhani-600.woff2') format('woff2')}
+@font-face{font-family:'Rajdhani';font-weight:700;font-display:swap;src:url('/fonts/rajdhani-700.woff2') format('woff2')}
+@font-face{font-family:'Inter';font-weight:400;font-display:swap;src:url('/fonts/inter-400.woff2') format('woff2')}
+@font-face{font-family:'Inter';font-weight:600;font-display:swap;src:url('/fonts/inter-600.woff2') format('woff2')}
+:root{
+  --bg:#08080a; --panel:#0f0f12; --panel-2:#141418; --panel-3:#191920;
+  --line:rgba(225,6,0,.16); --line-soft:rgba(255,255,255,.06); --line-mid:rgba(255,255,255,.12);
+  --crimson:#E10600; --crimson-deep:#B3000C;
+  --bone:#ECE7DB; --bone-dim:#B7B1A4; --steel:#71767b;
+  --jade:#4FB286; --amber:#E0A93B; --danger:#FF3B30;
+  --hdr:'Rajdhani','Oswald',system-ui,sans-serif;
+  --body:'Inter',system-ui,-apple-system,'Segoe UI',sans-serif;
+}
+*{box-sizing:border-box;margin:0}
+html,body{background:var(--bg)}
+body{font-family:var(--body);color:var(--bone-dim);font-size:13.5px;line-height:1.55;padding:20px 22px 60px}
+h1,h2,h3{font-family:var(--hdr);letter-spacing:.04em;color:var(--bone);margin:0}
+.pagehead{display:flex;align-items:center;gap:16px;flex-wrap:wrap;margin-bottom:4px;max-width:1120px}
+.pagehead h1{font-size:24px;font-weight:700}
+.statuspill{font-family:var(--hdr);font-weight:600;font-size:11px;letter-spacing:.1em;text-transform:uppercase;border-radius:20px;padding:4px 12px;border:1px solid var(--line);color:var(--jade)}
+.statuspill.off{color:var(--steel);border-color:var(--line-soft)}
+.lede{max-width:82ch;margin:6px 0 16px}
+.lede b{color:var(--bone);font-weight:600}
+.wins{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:16px;max-width:1120px}
+.win{font-family:var(--hdr);font-weight:600;font-size:12.5px;letter-spacing:.06em;text-transform:uppercase;border:1px solid var(--line-soft);background:var(--panel);color:var(--bone-dim);border-radius:8px;padding:8px 15px;cursor:pointer}
+.win:hover{border-color:var(--line)}
+.win.on{color:#fff;background:linear-gradient(180deg,var(--crimson),var(--crimson-deep));border-color:transparent}
+.tab{display:none}
+.tab.on{display:block}
+.card{background:var(--panel);border:1px solid var(--line-soft);border-radius:12px;padding:16px 18px;margin-bottom:16px;max-width:1120px}
+.card>h2{font-size:13px;text-transform:uppercase;letter-spacing:.1em;margin-bottom:12px;padding-bottom:8px;border-bottom:1px solid var(--line-soft);color:var(--bone);display:flex;align-items:center;gap:10px}
+.card>h2 .hint{font-family:var(--body);font-weight:400;letter-spacing:0;text-transform:none;font-size:11.5px;color:var(--steel);margin-left:auto}
+.row{display:flex;align-items:center;gap:12px;flex-wrap:wrap;margin:9px 0}
+.row .lbl{font-size:11px;text-transform:uppercase;letter-spacing:.1em;color:var(--steel);min-width:150px}
+.grid2{display:grid;grid-template-columns:180px 1fr;gap:11px 14px;align-items:center}
+.grid2 .lbl{font-size:11px;text-transform:uppercase;letter-spacing:.1em;color:var(--steel)}
+.tg{position:relative;width:40px;height:21px;border-radius:12px;background:#26262c;border:1px solid var(--line-mid);cursor:pointer;display:inline-block;vertical-align:middle;flex:none}
+.tg::after{content:"";position:absolute;top:2px;left:2px;width:15px;height:15px;border-radius:50%;background:var(--steel);transition:.15s}
+.tg.on{background:#33333a}
+.tg.on::after{left:21px;background:var(--bone)}
+input.fld,select.fld{width:100%;max-width:520px;background:var(--panel-3);border:1px solid var(--line-mid);border-radius:7px;color:var(--bone);font-family:var(--body);font-size:13px;padding:8px 11px}
+input.fld.s{max-width:180px}
+input.fld:focus,select.fld:focus{outline:2px solid rgba(225,6,0,.4);outline-offset:1px;border-color:var(--crimson-deep)}
+.fld.mono{font-family:ui-monospace,'Cascadia Code',Consolas,monospace;letter-spacing:.02em}
+.suffix{font-size:12px;color:var(--steel)}
+.btn{font-family:var(--hdr);font-weight:600;letter-spacing:.06em;text-transform:uppercase;font-size:12px;color:#fff;background:linear-gradient(180deg,var(--crimson),var(--crimson-deep));border:1px solid transparent;border-radius:8px;padding:9px 18px;cursor:pointer}
+.btn.ghost{background:transparent;border:1px solid var(--line-mid);color:var(--bone-dim)}
+.btn.ghost:hover{border-color:var(--crimson-deep);color:var(--bone)}
+.btn.sm{padding:6px 13px;font-size:11px}
+.btn[disabled]{opacity:.4;cursor:not-allowed}
+.note{font-size:12px;color:var(--steel);line-height:1.55;margin-top:8px}
+.note.warn{color:var(--amber)}
+.saved{font-size:12px;color:var(--jade);margin-left:10px}
+.saved.err{color:var(--danger)}
+table.rt{width:100%;border-collapse:collapse;margin-top:10px;font-size:12.5px}
+table.rt th{font-family:var(--hdr);font-weight:600;text-transform:uppercase;letter-spacing:.06em;font-size:10.5px;color:var(--steel);text-align:left;padding:7px 10px;border-bottom:1px solid var(--line-soft)}
+table.rt td{padding:7px 10px;border-bottom:1px solid var(--line-soft);color:var(--bone-dim);vertical-align:top}
+table.rt tr:last-child td{border-bottom:0}
+table.rt .del{color:var(--crimson);cursor:pointer;font-weight:600;border:1px solid var(--line-mid);border-radius:6px;padding:3px 9px;background:transparent;font-size:11px}
+table.rt .empty td{color:var(--steel);text-align:center;padding:14px}
+.addrow{display:flex;gap:8px;flex-wrap:wrap;align-items:flex-end;margin-top:12px}
+.addrow .fg{display:flex;flex-direction:column;gap:4px}
+.addrow .fg .fl{font-size:10px;text-transform:uppercase;letter-spacing:.1em;color:var(--steel)}
+.days{display:flex;gap:6px;flex-wrap:wrap}
+.days label{display:inline-flex;align-items:center;gap:5px;font-size:12px;color:var(--bone-dim);border:1px solid var(--line-mid);border-radius:6px;padding:5px 9px;cursor:pointer}
+.chaincard{background:var(--panel-2);border:1px solid var(--line-soft);border-radius:9px;margin-bottom:10px;overflow:hidden}
+.chaincard .ch{display:flex;align-items:center;gap:10px;padding:9px 12px;background:#111116;border-bottom:1px solid var(--line-soft);flex-wrap:wrap}
+.chaincard .ch .nm{font-family:var(--hdr);font-weight:600;font-size:13px;color:var(--bone);letter-spacing:.03em}
+.chaincard .ch .pol{font-size:10.5px;text-transform:uppercase;letter-spacing:.08em;color:var(--steel)}
+.chaincard .ch .pol b{color:var(--bone-dim)}
+.owner{font-size:9.5px;font-weight:600;text-transform:uppercase;letter-spacing:.06em;border-radius:4px;padding:2px 7px;margin-left:auto}
+.owner.core{border:1px solid var(--line-mid);color:var(--bone-dim)}
+.owner.warden{border:1px solid var(--crimson-deep);color:var(--bone);background:rgba(225,6,0,.10)}
+.owner.gk{border:1px solid #4a6b8a;color:#a9cde8}
+.owner.vpn{border:1px solid #6a5a9a;color:#c3b6ea}
+.owner.sdn{border:1px solid #3d7a5c;color:#9fd8bb}
+.owner.ctrl{border:1px solid #8a7a3a;color:#e0cf8b}
+.owner.other{border:1px solid var(--line-soft);color:var(--steel)}
+table.ipt{width:100%;border-collapse:collapse;font-family:ui-monospace,Consolas,monospace;font-size:11px}
+table.ipt th{text-align:left;color:var(--steel);font-weight:400;padding:5px 9px;border-bottom:1px solid var(--line-soft)}
+table.ipt td{padding:4px 9px;border-bottom:1px solid rgba(255,255,255,.03);color:var(--bone-dim);white-space:nowrap}
+table.ipt td.n{text-align:right;color:var(--bone)}
+table.ipt td.hit{color:var(--amber)}
+.statgrid{display:flex;gap:22px;flex-wrap:wrap}
+.statgrid .kv{display:flex;flex-direction:column;gap:2px;min-width:96px}
+.statgrid .k{font-size:10px;letter-spacing:.12em;text-transform:uppercase;color:var(--steel)}
+.statgrid .v{font-family:var(--hdr);font-weight:600;font-size:17px;color:var(--bone)}
+.statgrid .v.on{color:var(--jade)}
+.statgrid .v.off{color:var(--steel)}
+.cols2{display:grid;grid-template-columns:1fr 1fr;gap:16px;max-width:1120px}
+@media(max-width:900px){.cols2{grid-template-columns:1fr}}
