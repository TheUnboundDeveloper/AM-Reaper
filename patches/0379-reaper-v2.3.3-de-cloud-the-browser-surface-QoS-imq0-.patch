+}
+function initGeneral(){
+  $('g_log').value=NV.fw_log_x||'none';
+  v4parse();v4render();v6parse();v6render();
+  $('v4_add').onclick=function(){
+    var src=$('v4_src').value.trim(),proto=$('v4_proto').value,port=normPort($('v4_port').value);
+    if(port===null){alert(`<#RFW_67#>`);return;}
+    if(v4rules.length>=128){alert(`<#RFW_64#>`.replace('%N%','128'));return;}
+    v4rules.push({proto:proto,src:src,port:port});$('v4_src').value='';$('v4_port').value='';v4render();
+  };
+  $('v6_add').onclick=function(){
+    var desc=$('v6_desc').value.replace(/[<>'%]/g,'').trim();
+    var rip=$('v6_rip').value.replace(/\s/g,''),lip=$('v6_lip').value.replace(/\s/g,''),port=$('v6_port').value.replace(/\s/g,''),proto=$('v6_proto').value;
+    if(v6rules.length>=128){alert(`<#RFW_64#>`.replace('%N%','128'));return;}
+    v6rules.push({desc:desc,rip:rip,lip:lip,port:port,proto:proto});
+    $('v6_desc').value='';$('v6_rip').value='';$('v6_lip').value='';$('v6_port').value='';v6render();
