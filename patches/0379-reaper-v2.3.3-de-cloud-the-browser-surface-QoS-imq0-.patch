index 0000000000..4d744c0d99
--- /dev/null
+++ b/release/src/router/rc/reaper_fw.c
@@ -0,0 +1,360 @@
+/*
+ * rc/reaper_fw.c - Reaper native firewall: object-model custom rules engine
+ * (RT-BE96U "reaper", v2.3.3, FIREWALL-PLAN Phase 1).
+ *
+ * WHAT THIS IS
+ *   A general-purpose, object-based stateful firewall layer that sits BESIDE
+ *   Gatekeeper (per-device internet on/off) and Warden (inbound geo/threat
+ *   feeds) - it does not absorb them. Users define reusable OBJECTS (address /
+ *   service), GROUPS, and ZONES, then write RULES that reference them by name.
+ *   The engine compiles the ruleset into three owned chains, REAPER_FWI
+ *   (INPUT), REAPER_FWF (FORWARD), REAPER_FWO (OUTPUT), dual-stack (iptables +
+ *   ip6tables), backed by ipset. Model mirrors rc/rwarden.c and rc/gatekeeper.c:
+ *   start_reaper_fw() writes an idempotent teardown+build shell script whose
+ *   interface/subnet values are resolved at RUN time via `nvram get`, then runs
+ *   it, and it re-arms from the start_firewall() re-apply hook so the chains
+ *   survive restart_firewall / WAN events / service restarts. No resident daemon.
+ *
+ * ============================ SECURITY CONTRACT ============================
+ * A firewall is the one subsystem where a single ordering or validation slip is
+ * a real vulnerability. The following are INVARIANTS, not preferences. Any
+ * change here must preserve every one of them (and the pre-build security review
+ * checks them):
+ *
+ * S1. STRUCTURAL ANTI-LOCKOUT. Every owned chain begins, BEFORE any user DROP,
+ *     with protective RETURNs that can never be overridden by a user rule:
+ *       loopback -> RETURN
+ *       ESTABLISHED,RELATED -> RETURN   (keeps the admin's in-flight session,
+ *                                        incl. the commit-confirm POST, alive -
+ *                                        the base est-accept is appended BELOW
+ *                                        our -I jump, so we must carry our own)
+ *       DHCP (v4 67:68 / v6 546:547) -> RETURN
+ *       admin RETURN                    (the REMOTE_ADDR of the session that
+ *                                        applied, to its mgmt transport - so a
+ *                                        bad ruleset cannot sever the operator)
+ *     Only after these do user rules run, then the zone default-policy matrix,
+ *     then a final default. Rule 7 of Warden's chain (the LAN RETURN) taught us
+ *     this the hard way (2026-07-29 lockout); we encode it structurally.
+ *
+ * S2. INPUT IS UNTRUSTED. Everything from nvram is validated STRUCTURALLY (not
+ *     just charset-gated) before it reaches the generated shell, and every field
+ *     that flows into the shell is restricted to a charset that cannot break out
+ *     of its quoting. Object/zone/service NAMES become ipset names and shell
+ *     tokens: [A-Za-z0-9_] only. An invalid record is DROPPED and logged; it is
+ *     never emitted half-formed (a silently-dropped-but-believed-active entry
+ *     was a Warden lockout ingredient).
+ *
+ * S3. COMMIT-CONFIRM IS THE SAFETY NET, AND IT IS LOAD-BEARING. Applying a
+ *     candidate ruleset arms an auto-revert (reaper_fw_confirm seconds, floor
+ *     15, never 0). If the operator does not confirm - e.g. a rule broke their
+ *     own route so the confirm never arrives - the ruleset is reverted. The
+ *     revert deadline is owned by a DURABLE watcher (cru, which survives httpd/rc
+ *     restarts), never a best-effort child process. Rollback REGENERATES our
+ *     chains from the last-good config; it NEVER snapshot/restores the shared
+ *     table (that would clobber GK/Warden/SDN). If regeneration itself fails,
+ *     the last resort is FAIL-OPEN for our layer only: remove our jumps so the
+ *     base firewall still protects the box and connectivity is restored.
+ *
+ * S4. WE TOUCH ONLY WHAT WE OWN. Apply/rollback flush and rebuild ONLY
+ *     REAPER_FWI/FWF/FWO (+ our object ipsets); never another daemon's chains,
+ *     never the built-in chains, never the whole table.
+ *
+ * S5. GEO DEFERS TO WARDEN. A geo object REFERENCES Warden's country set
+ *     rw_g_<cc> / rw_g6_<cc>; the engine never creates a parallel country set.
+ *     If Warden is not managing that country the geo match is not emitted (a
+ *     dead --match-set on a missing set) - the UI routes the operator to Warden.
+ *
+ * S6. SERIALIZE WITH THE BASE. Apply/rollback take the SAME file_lock("firewall")
+ *     the base rebuild uses, so we never interleave with a concurrent
+ *     start_firewall() and load a half-built chain set. (`iptables -w` is not
+ *     relied on - GK/Warden don't use it, so the lock is the real serialization.)
+ *
+ * nvram: reaper_fw_enable reaper_fw_confirm reaper_fw_obj reaper_fw_grp
+ *        reaper_fw_svc reaper_fw_zone reaper_fw_zpol reaper_fw_rules
+ *
+ * RECORD FORMATS (list separator '<', field separator '>'):
+ *   obj:   <name>type>value>comment           type = host|cidr|range|mac|fqdn|geo
+ *   grp:   <name>member,member,...>comment     members = object names
+ *   svc:   <name>proto>ports>comment           proto = tcp|udp|both|icmp
+ *   zone:  <name>iface,iface,...>comment        iface = br0|vlanN|eth0|tun+|wgc+...
+ *   zpol:  <srczone>dstzone>action              action = accept|drop|reject
+ *   rule:  <en>dir>action>szone>sobj>dzone>dobj>svc>sched>rate>log>order>comment
+ *          en=0|1  dir=in|out|fwd  action=accept|drop|reject|log
+ */
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <ctype.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+#include "rc.h"
+#include <shared.h>
+
+#define RFW_DIR      "/tmp/reaper_fw"
+#define RFW_APPLY    RFW_DIR "/apply.sh"          /* idempotent teardown+build (committed set) */
+#define RFW_CAND     RFW_DIR "/candidate.sh"      /* the armed candidate (staged set) */
+#define RFW_CC       RFW_DIR "/cc_check.sh"       /* cru-run deadline checker */
+#define RFW_ARMED    RFW_DIR "/armed"             /* single-arm CAS token (a directory: mkdir/rmdir are atomic) */
+#define RFW_DEADLINE RFW_DIR "/deadline"          /* absolute epoch the arm reverts at */
+#define RFW_ADMIN    RFW_DIR "/admin"             /* REMOTE_ADDR + transport of the arming session */
+#define RFW_CACHE    "/jffs/reaper_fw"
+#define RFW_LASTGOOD RFW_CACHE "/lastgood"        /* last-CONFIRMED config snapshot = the rollback source (S3) */
+
+#define RFW_CONFIRM_MIN  15                       /* commit-confirm floor, seconds (S3: never 0) */
+#define RFW_CONFIRM_DEF  60
+
+/* ipset object set names are rwfw_<name> (v4) / rwfw6_<name> (v6). The <name>
+ * is validated to [A-Za-z0-9_]{1,28} so the full set name stays within ipset's
+ * 31-char limit and can never break shell quoting (S2). */
+#define RFW_SET4  "rwfw_"
+#define RFW_SET6  "rwfw6_"
+#define RFW_NAME_MAX 28
+
+/* our owned chains */
+#define RFW_CHAIN_IN   "REAPER_FWI"
+#define RFW_CHAIN_FWD  "REAPER_FWF"
+#define RFW_CHAIN_OUT  "REAPER_FWO"
+
+/* ---------------------------------------------------------------------------
+ * S2 validators. Structural, not charset-only. Adapted from rc/rwarden.c's
+ * hardened set (rw_valid_cidr / rw_valid_cidr6 / rw_valid_cc) so the two
+ * subsystems reject identically; extended with name / mac / port / proto for
+ * the object model. Each returns 1 on valid, 0 on reject.
+ * ------------------------------------------------------------------------- */
+
+/* object / group / service / zone NAME: [A-Za-z0-9_], 1..RFW_NAME_MAX. This is
+ * the single most safety-relevant validator - the name becomes an ipset name
+ * AND a shell token in the generated script. No dot, no dash, no space. */
+static int rfw_valid_name(const char *s)
+{
+	const char *p;
+	size_t n = 0;
+	if (!s || !*s) return 0;
+	for (p = s; *p; p++, n++) {
+		if (n >= RFW_NAME_MAX) return 0;
+		if (!((*p >= 'A' && *p <= 'Z') || (*p >= 'a' && *p <= 'z') ||
+		      (*p >= '0' && *p <= '9') || *p == '_'))
+			return 0;
+	}
+	return 1;
+}
+
+/* single IPv4 address or CIDR: four octets 0-255, optional /0-32. */
+static int rfw_valid_cidr(const char *s)
+{
+	int oct = 0, val = -1, prefix = -1, seen_slash = 0;
+	const char *p;
+	if (!s || !*s || strlen(s) > 18) return 0;
+	for (p = s; *p; p++) {
+		if (*p >= '0' && *p <= '9') {
+			if (seen_slash) {
+				prefix = (prefix < 0 ? 0 : prefix) * 10 + (*p - '0');
+				if (prefix > 32) return 0;
+			} else {
+				val = (val < 0 ? 0 : val) * 10 + (*p - '0');
+				if (val > 255) return 0;
+			}
+			continue;
+		}
+		if (*p == '.') {
+			if (seen_slash || val < 0 || oct >= 3) return 0;
+			oct++; val = -1;
+			continue;
+		}
+		if (*p == '/') {
+			if (seen_slash || val < 0 || oct != 3) return 0;
+			seen_slash = 1;
+			continue;
+		}
+		return 0;
+	}
+	if (seen_slash) return (prefix >= 0);
+	return (oct == 3 && val >= 0);
+}
+
+/* single IPv6 address or CIDR, charset [0-9a-fA-F:/], >=2 colons. ipset parses. */
+static int rfw_valid_cidr6(const char *s)
+{
+	int colon = 0, slash = 0, prefix = -1;
+	const char *p;
+	if (!s || !*s || strlen(s) > 43) return 0;
+	for (p = s; *p; p++) {
+		if (*p == '/') { if (++slash > 1) return 0; continue; }
+		if (slash) {
+			if (*p >= '0' && *p <= '9') {
+				prefix = (prefix < 0 ? 0 : prefix) * 10 + (*p - '0');
+				if (prefix > 128) return 0;
+				continue;
+			}
+			return 0;
+		}
+		if ((*p >= '0' && *p <= '9') || (*p >= 'a' && *p <= 'f') ||
+		    (*p >= 'A' && *p <= 'F')) continue;
+		if (*p == ':') { colon++; continue; }
+		return 0;
+	}
+	if (slash && prefix < 0) return 0;
+	return (colon >= 2);
+}
+
+/* an IPv4 or IPv6 host/cidr (either family). */
+static int rfw_valid_ip(const char *s)
+{
+	return (s && strchr(s, ':')) ? rfw_valid_cidr6(s) : rfw_valid_cidr(s);
+}
+
+/* an address range "A-B", both ends the same family. Emitted to a hash:ip set
+ * (ipset accepts a range on add for hash:ip) or an -m iprange match. */
+static int rfw_valid_range(const char *s)
+{
+	char buf[92], *dash;
+	if (!s || strlen(s) >= sizeof(buf)) return 0;
+	strlcpy(buf, s, sizeof(buf));
+	dash = strchr(buf, '-');
+	if (!dash) return 0;
+	*dash = 0;
+	/* both ends must validate and be the same family (both have ':' or neither) */
+	if (!!strchr(buf, ':') != !!strchr(dash + 1, ':')) return 0;
+	return rfw_valid_ip(buf) && rfw_valid_ip(dash + 1);
+}
+
+/* a MAC address aa:bb:cc:dd:ee:ff (hex, colon-separated, 6 octets). */
+static int rfw_valid_mac(const char *s)
+{
+	int oct = 0, hexn = 0;
+	const char *p;
+	if (!s || strlen(s) != 17) return 0;
+	for (p = s; *p; p++) {
+		if (*p == ':') {
+			if (hexn != 2) return 0;
+			oct++; hexn = 0;
+			continue;
+		}
+		if (!isxdigit((int)*p)) return 0;
+		if (++hexn > 2) return 0;
+	}
+	return (oct == 5 && hexn == 2);
+}
+
+/* an FQDN for a dnsmasq ipset= directive: labels of [A-Za-z0-9-], dot-joined,
+ * no leading/trailing dot or hyphen per label. It flows into a single-quoted
+ * dnsmasq config token; the charset here also keeps it shell-safe. */
+static int rfw_valid_fqdn(const char *s)
+{
+	int label = 0, total = 0;
+	const char *p;
+	if (!s || !*s) return 0;
+	for (p = s; *p; p++, total++) {
+		if (total > 253) return 0;
+		if (*p == '.') {
+			if (label == 0) return 0;          /* empty label / leading dot */
+			label = 0;
+			continue;
+		}
+		if (*p == '-') {
+			if (label == 0) return 0;          /* leading hyphen in label */
+			label++;
+			continue;
+		}
+		if ((*p >= 'A' && *p <= 'Z') || (*p >= 'a' && *p <= 'z') ||
+		    (*p >= '0' && *p <= '9')) { label++; continue; }
+		return 0;
+	}
+	return (label > 0);                                 /* no trailing dot */
+}
+
+/* country code: exactly two ascii letters (references Warden's rw_g_<cc>). */
+static int rfw_valid_cc(const char *s)
+{
+	return s && strlen(s) == 2 && isalpha((int)s[0]) && isalpha((int)s[1]);
+}
+
+/* a port list/range for a service object: comma list of N or LOW:HIGH,
+ * 1..65535, LOW<HIGH. Charset [0-9,:] only; emitted into -m multiport / --dport.
+ * Returns 1 valid. Empty is valid (means "all ports"). */
+static int rfw_valid_ports(const char *s)
+{
+	const char *p;
+	int cur = -1, lo = -1, incolon = 0, ndigit = 0;
+	if (!s) return 0;
+	if (!*s) return 1;
+	if (strlen(s) > 128) return 0;
+	for (p = s; ; p++) {
+		if (*p >= '0' && *p <= '9') {
+			cur = (cur < 0 ? 0 : cur) * 10 + (*p - '0');
+			if (cur > 65535) return 0;
+			ndigit++;
+			continue;
+		}
+		if (*p == ':') {
+			if (incolon || ndigit == 0 || cur < 1) return 0;
+			lo = cur; cur = -1; ndigit = 0; incolon = 1;
+			continue;
+		}
+		if (*p == ',' || *p == 0) {
+			if (ndigit == 0 || cur < 1) return 0;
+			if (incolon && !(lo >= 1 && cur <= 65535 && lo < cur)) return 0;
+			if (*p == 0) break;
+			cur = -1; lo = -1; ndigit = 0; incolon = 0;
+			continue;
+		}
+		return 0;
+	}
+	return 1;
+}
+
+/* service protocol token. */
+static int rfw_valid_proto(const char *s)
+{
+	return s && (!strcmp(s, "tcp") || !strcmp(s, "udp") ||
+	             !strcmp(s, "both") || !strcmp(s, "icmp"));
+}
+
+/* rule direction / action tokens. */
+static int rfw_valid_dir(const char *s)
+{
+	return s && (!strcmp(s, "in") || !strcmp(s, "out") || !strcmp(s, "fwd"));
+}
+static int rfw_valid_action(const char *s)
+{
+	return s && (!strcmp(s, "accept") || !strcmp(s, "drop") ||
+	             !strcmp(s, "reject") || !strcmp(s, "log"));
+}
+static int rfw_valid_zpol_action(const char *s)
+{
+	return s && (!strcmp(s, "accept") || !strcmp(s, "drop") || !strcmp(s, "reject"));
+}
+
+/* an interface token for a zone. Kernel ifnames + a trailing '+' wildcard
+ * (iptables -i/-o accept "tun+"). Charset [A-Za-z0-9._+], '+' only last. */
+static int rfw_valid_iface(const char *s)
+{
+	const char *p;
+	size_t n = strlen(s ? s : "");
+	if (!s || n == 0 || n > IFNAMSIZ) return 0;
+	for (p = s; *p; p++) {
+		if (*p == '+') { if (p[1]) return 0; continue; }   /* wildcard, last only */
+		if (!((*p >= 'A' && *p <= 'Z') || (*p >= 'a' && *p <= 'z') ||
+		      (*p >= '0' && *p <= '9') || *p == '.' || *p == '_'))
+			return 0;
+	}
+	return 1;
+}
+
+/* ---- NOTE: the remainder of the engine is built in the next focused pass ----
+ * Still to add below (chain generation is the ORDERING-CRITICAL part and gets
+ * its own careful pass + the pre-build security review):
+ *   - record iterators over reaper_fw_obj/grp/svc/zone/zpol/rules
+ *   - object -> ipset materialization (host/cidr/range/mac/fqdn; geo -> Warden
+ *     rw_g_<cc> reference per S5) incl. dnsmasq ipset= plumbing for fqdn
+ *   - rfw_gen_apply(): REAPER_FWI/FWF/FWO build with the S1 protective head,
+ *     zone -i/-o matching, service/object matches, zpol matrix, final default;
+ *     dual-stack; fc flush; teardown-before-build (S4)
+ *   - anti-lockout preflight keyed off the arming session's REMOTE_ADDR (S1/S3)
+ *   - commit-confirm state machine: start_reaper_fw (apply+arm), reaper_fw_confirm,
+ *     reaper_fw_rollback; /jffs lastgood; cru deadline; atomic armed CAS;
+ *     fail-open last resort (S3); file_lock("firewall") (S6)
+ *   - dryrun mode (emit the exact iptables lines, no exec) for the CGI preview
+ *   - entry points + rc.h decls + services.c notify_rc + rc/Makefile OBJS
+ */
