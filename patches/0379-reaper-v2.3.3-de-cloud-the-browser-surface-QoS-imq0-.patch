+}
+function initKeyword(){
+  kwparse();kwrender();
+  $('kw_add').onclick=function(){
+    var v=$('kw_kw').value.trim();
+    if(!v){alert(`<#RFW_66#>`);return;}
+    if(kwBad(v)){alert(`<#RFW_90#> `+KWBLOCK.join(' '));return;}
