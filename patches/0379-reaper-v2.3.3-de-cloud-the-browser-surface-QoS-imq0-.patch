+  ipv6_fw_enable:'<% nvram_get("ipv6_fw_enable"); %>',
+  fw_lw_enable_x:'<% nvram_get("fw_lw_enable_x"); %>',
+  filter_lw_default_x:'<% nvram_get("filter_lw_default_x"); %>',
