+  filter_wllist:decodeURIComponent('<% nvram_char_to_ascii("", "filter_wllist"); %>'),
+  ipv6_fw_rulelist:decodeURIComponent('<% nvram_char_to_ascii("", "ipv6_fw_rulelist"); %>'),
