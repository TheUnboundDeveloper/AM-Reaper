 }
 
+/* reaper: the free-text export settings below are consumed by /tmp/rexport.sh.
+ * The SHELL side is clean - rexport_gen() fputs a CONSTANT script and every
+ * nvram value is read at run time into a double-quoted assignment, so there is
+ * no shell command injection (this is what the [P3] backlog item asked us to
+ * verify; it holds).
+ *
+ * The exposure is one layer over: that script builds a curl config file and
+ * feeds it with -K, writing lines of the form
+ *     url = "<value>"
+ *     header = "<value>"
+ * A double quote inside the value closes the quoted string, and curl reads the
+ * remainder of the line as further config directives. curl config accepts
+ * `output = <path>`, so a crafted URL turns an admin-authenticated save into an
+ * arbitrary file write as root (e.g. into /jffs/scripts) - persistence, not
+ * just exfiltration. Reachable post-auth and CSRF-guarded, which is the tier
+ * the backlog assumed, but it chains with any admin-session XSS.
+ *
+ * Reject rather than sanitise so a mangled value never silently half-applies;
+ * the field keeps its previous value, matching how an invalid "mode" is already
+ * handled. Backslash is deliberately included: curl treats it as an escape
+ * inside a quoted config value. */
+static int rexport_val_ok(const char *s)
+{
+	for (; *s; s++) {
+		unsigned char c = (unsigned char)*s;
+		if (c == '"' || c == '\\' || c < 0x20 || c == 0x7f)
+			return 0;
+	}
+	return 1;
+}
+
