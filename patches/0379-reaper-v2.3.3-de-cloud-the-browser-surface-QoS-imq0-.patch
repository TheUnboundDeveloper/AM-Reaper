+};
+var DAYNM=[`<#RFW_97#>`,`<#RFW_91#>`,`<#RFW_92#>`,`<#RFW_93#>`,`<#RFW_94#>`,`<#RFW_95#>`,`<#RFW_96#>`]; /* idx0=Sun */
+
+/* ---- generic helpers ---- */
+function xhr(url,cb){
+  var x=new XMLHttpRequest();
+  x.open('GET',url+(url.indexOf('?')<0?'?':'&')+'_='+Date.now(),true);
+  x.timeout=30000;
+  x.onreadystatechange=function(){
+    if(x.readyState!==4)return;
+    var j=null;
+    if(x.status===200){try{j=JSON.parse(x.responseText);}catch(e){j=null;}}
+    cb(j);
+  };
+  x.ontimeout=function(){cb(null);};
+  x.send();
+}
+function tgSet(el,on){el.classList.toggle('on',!!on);}
+function tgGet(el){return el.classList.contains('on')?'1':'0';}
+function showSaved(el,ok,msg){el.className='saved'+(ok?'':' err');el.textContent=msg;el.classList.remove('hidden');setTimeout(function(){el.classList.add('hidden');},4000);}
+
+/* dirty-only apply: writes the given nvram map, then restart_firewall */
+function fwApply(fields,overlayReload){
+  var f=$('fwform');
+  Array.prototype.slice.call(f.querySelectorAll('.dyn')).forEach(function(n){n.remove();});
+  for(var k in fields){
+    var i=document.createElement('input');i.type='hidden';i.className='dyn';i.name=k;i.value=fields[k];f.appendChild(i);
+  }
+  f.submit();
+  if(overlayReload!==false) setTimeout(function(){try{location.reload();}catch(e){}},7000);
+}
+
+/* port list: comma-list of N or LOW:HIGH (LOW<HIGH), 1-65535; also >N / <N shorthand */
+function normPort(v){
+  v=(v||'').replace(/\s+/g,'');
+  if(v==='')return '';
+  var parts=v.split(','),out=[];
+  for(var i=0;i<parts.length;i++){
+    var p=parts[i];
+    if(p==='')continue;
+    if(p.charAt(0)==='>'){p=(parseInt(p.slice(1),10))+':65535';}
+    else if(p.charAt(0)==='<'){p='1:'+parseInt(p.slice(1),10);}
+    p=p.replace(/[-~]/g,':');
+    if(p.indexOf(':')>=0){
+      var a=p.split(':'),lo=parseInt(a[0],10),hi=parseInt(a[1],10);
+      if(!(lo>=1&&hi<=65535&&lo<hi))return null;
+      out.push(lo+':'+hi);
+    }else{
+      var n=parseInt(p,10);
+      if(!(n>=1&&n<=65535))return null;
+      out.push(''+n);
+    }
+  }
+  return out.join(',');
+}
+/* extended blocklist closing the _fw_keyword_safe silent-drop gap (adds " ' ` $) */
+var KWBLOCK=['#','%','&','*','{','}','\\',':','<','>','?','/','+','"',"'",'`','$'];
+function kwBad(v){
+  for(var i=0;i<v.length;i++){var c=v.charCodeAt(i);if(c<32||c>126)return true;}
+  for(var j=0;j<KWBLOCK.length;j++){if(v.indexOf(KWBLOCK[j])>=0)return true;}
+  return false;
+}
+
+/* =================== rule-table model ===================
+   Each editor keeps an array of records; render + serialize on apply. */
+function rtEmpty(tbody,cols){tbody.innerHTML='<tr class="empty"><td colspan="'+cols+'">'+esc(`<#RFW_61#>`)+'</td></tr>';}
+function rtRow(cells,onDel){
+  var tr=document.createElement('tr');
+  for(var i=0;i<cells.length;i++){var td=document.createElement('td');td.textContent=cells[i];tr.appendChild(td);}
+  var td2=document.createElement('td');var b=document.createElement('button');b.className='del';b.textContent=`<#RFW_60#>`;b.onclick=onDel;td2.appendChild(b);tr.appendChild(td2);
+  return tr;
+}
+
+/* ---------- General: IPv4 inbound (filter_wllist) ---------- */
+/* entry: <PROTO>>SRCIP>>>DSTPORT  (6 slots, only 0/2/5 used) */
+var v4rules=[];
+function v4parse(){
+  v4rules=[];
+  var recs=NV.filter_wllist.split('<');
+  for(var i=0;i<recs.length;i++){
+    if(recs[i]==='')continue;
+    var f=recs[i].split('>');
+    v4rules.push({proto:f[0]||'',src:f[2]||'',port:f[5]||''});
+  }
+}
+function v4render(){
+  var tb=$('v4_tbl').getElementsByTagName('tbody')[0];tb.innerHTML='';
+  if(!v4rules.length){rtEmpty(tb,4);return;}
+  v4rules.forEach(function(r,idx){tb.appendChild(rtRow([r.src||'*',r.port||'*',r.proto],function(){v4rules.splice(idx,1);v4render();}));});
+}
+/* ---------- General: IPv6 inbound (ipv6_fw_rulelist) ---------- */
+/* entry: <DESC>REMOTE>LOCAL>PORT>PROTO */
+var v6rules=[];
+function v6parse(){
+  v6rules=[];
+  var recs=NV.ipv6_fw_rulelist.split('<');
+  for(var i=0;i<recs.length;i++){
+    if(recs[i]==='')continue;
+    var f=recs[i].split('>');
+    v6rules.push({desc:f[0]||'',rip:f[1]||'',lip:f[2]||'',port:f[3]||'',proto:f[4]||'TCP'});
+  }
+}
+function v6render(){
+  var tb=$('v6_tbl').getElementsByTagName('tbody')[0];tb.innerHTML='';
+  if(!v6rules.length){rtEmpty(tb,6);return;}
+  v6rules.forEach(function(r,idx){tb.appendChild(rtRow([r.desc,r.rip||'*',r.lip||'*',r.port||'*',r.proto],function(){v6rules.splice(idx,1);v6render();}));});
+}
+/* ---------- Network Services (filter_lwlist) ---------- */
+/* entry: <SRCIP>SRCPORT>DSTIP>DSTPORT>PROTO ; fields uppercased */
+var lwrules=[];
+function lwparse(){
+  lwrules=[];
+  var recs=NV.filter_lwlist.split('<');
+  for(var i=0;i<recs.length;i++){
+    if(recs[i]==='')continue;
+    var f=recs[i].split('>');
+    lwrules.push({sip:f[0]||'',sport:f[1]||'',dip:f[2]||'',dport:f[3]||'',proto:f[4]||'TCP'});
+  }
+}
+function lwrender(){
