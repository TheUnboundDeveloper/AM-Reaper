+    var sport=normPort($('lw_sport').value),dport=normPort($('lw_dport').value),proto=$('lw_proto').value;
+    if(sport===null||dport===null){alert(`<#RFW_67#>`);return;}
+    if(!sip&&!dip&&!sport&&!dport){alert(`<#RFW_66#>`);return;}
+    if(lwrules.length>=128){alert(`<#RFW_64#>`.replace('%N%','128'));return;}
+    lwrules.push({sip:sip,sport:sport,dip:dip,dport:dport,proto:proto});
+    $('lw_sip').value='';$('lw_sport').value='';$('lw_dip').value='';$('lw_dport').value='';lwrender();
+  };
+  $('n_apply').onclick=function(){
+    var anyday=false;var bm='';
+    for(var d=0;d<7;d++){var c=$('lwd'+d).checked;bm+=c?'1':'0';if(c)anyday=true;}
+    if($('n_en').classList.contains('on')&&!anyday){alert(`<#RFW_78#>`);return;}
+    function p4(v){v=(v||'').replace(/\D/g,'').slice(0,4);return (v+'0000').slice(0,4);}
