diff --git a/release/src/router/rmcpd/rmcpd.c b/release/src/router/rmcpd/rmcpd.c
index bcb2a431b9..ea6fe4c76a 100644
--- a/release/src/router/rmcpd/rmcpd.c
+++ b/release/src/router/rmcpd/rmcpd.c
@@ -487,11 +487,89 @@ static const char *SCRUB_FRAG[] = {
 	NULL
 };
 
+/* ------------------------------------------------------------------ */
+/* ASUS stores Wi-Fi credentials in '>'-delimited TUPLES, not as        */
+/* key=value, so the assignment scrubber below cannot see them:         */
+/*   apg1_security = <3>psk2>aes>ThePassphrase>1<13>psk2>aes>...        */
+/*   wl0_security  = ...>sae>aes+gcmp256>ThePassphrase>...              */
+/* The field AFTER <auth-mode> and <crypto> is the passphrase. The LAB  */
+/* build's exec tool can cat these straight out of nvram, which is how  */
+/* a live PSK reached an operator transcript on 2026-08-10 despite the  */
+/* structural scrub at the tools/call choke point.                      */
+/* Rule: at a '>' or '<' boundary, an auth-mode token followed by '>'   */
+/* means "step over the crypto field, redact the one after it".         */
+/* Longest tokens first so psk2sae/psk2 are not shadowed by psk; the    */
+/* trailing-'>' requirement makes the ordering belt-and-suspenders.     */
+/* ------------------------------------------------------------------ */
+
+static const char *SEC_AUTH[] = {
+	"psk2sae", "pskpsk2", "wpa2wpa3", "psk2", "sae", "wpa3", "wpa2",
+	"wpa", "psk", "radius", NULL
+};
+
+static void sb_scrub_sec_tuples(sbuf_t *in)
+{
+	sbuf_t out;
+	size_t i = 0;
+
+	if (!in->p || !in->len)
+		return;
+	sb_init(&out);
+	if (!out.p) {
+		/* same fail-closed contract as sb_scrub_secrets() */
+		in->len = 0;
+		in->p[0] = 0;
+		in->truncated = 0;
+		sb_puts(in, "(scrub unavailable - output withheld)");
+		return;
+	}
+	while (i < in->len) {
+		int f, matched = 0;
+		int at_bound = (i == 0 || in->p[i - 1] == '>' || in->p[i - 1] == '<');
+
+		for (f = 0; at_bound && SEC_AUTH[f] && !matched; f++) {
+			size_t fl = strlen(SEC_AUTH[f]);
+			size_t j;
+
+			if (i + fl >= in->len ||
+			    strncasecmp(in->p + i, SEC_AUTH[f], fl) != 0 ||
+			    in->p[i + fl] != '>')
+				continue;
+			/* step across the crypto field to its terminating '>' */
+			j = i + fl + 1;
+			while (j < in->len && in->p[j] != '>' &&
+			       in->p[j] != '<' && in->p[j] != '\n')
+				j++;
+			if (j >= in->len || in->p[j] != '>')
+				continue;		/* malformed - leave verbatim */
+			j++;
+			sb_add(&out, in->p + i, j - i);	/* "<auth>><crypto>>" */
+			sb_puts(&out, "<redacted>");
+			while (j < in->len && in->p[j] != '>' &&
+			       in->p[j] != '<' && in->p[j] != '\n')
+				j++;			/* drop the passphrase */
+			i = j;
+			matched = 1;
+		}
+		if (!matched) {
+			sb_add(&out, in->p + i, 1);
+			i++;
+		}
+	}
+	sb_free(in);
+	*in = out;
+}
+
 static void sb_scrub_secrets(sbuf_t *in)
 {
 	sbuf_t out;
 	size_t i = 0;
 
+	if (!in->p || !in->len)
+		return;
+	/* tuple-shaped credentials first: they carry no [:=] separator and so
+	 * are invisible to the assignment pass below */
+	sb_scrub_sec_tuples(in);
 	if (!in->p || !in->len)
 		return;
 	sb_init(&out);
@@ -707,6 +785,18 @@ static void tool_firewall(sbuf_t *s)
 {
