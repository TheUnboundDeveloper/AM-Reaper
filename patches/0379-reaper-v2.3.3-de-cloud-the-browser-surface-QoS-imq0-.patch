diff --git a/release/src/router/rc/qos.c b/release/src/router/rc/qos.c
index 658aab8607..7606d11aab 100644
--- a/release/src/router/rc/qos.c
+++ b/release/src/router/rc/qos.c
@@ -1088,11 +1088,29 @@ static int add_qos_rules(char *pcWANIF)
 	QOSDBG("[qos] qos_inuse=%d\n", inuse);
 
 	/* Ingress rules */
+	/* reaper: this block redirects every WAN-ingress packet to imq0 so a
+	 * software qdisc tree can shape the download direction. ONLY the
+	 * traditional (tc/HTB) engine ever builds that tree - the hardware engines
+	 * (qos_type 10/11) leave imq0 on the kernel default pfifo_fast, so the
+	 * redirect cannot shape anything; it just pushes software-path packets
+	 * through an extra netdev for nothing.
+	 *
+	 * Gated on qos_irates alone, it fired for type 11 on every apply. Metal
+	 * 2026-08-10: PREROUTING carried "IMQ --todev 0" on eth0 with 4,619 pkts /
+	 * 1,005 KB through imq0 while qos_ibw was EMPTY and qos_ipolicer=0 - so the
+	 * backlog [P2] entry's stated trigger ("stands up whenever qos_ibw > 0") was
+	 * wrong; qos_irates ships non-zero by default and is the real trigger.
+	 *
+	 * The paired PREROUTING restore-mark exists only to feed that qdisc. QOSO
+	 * opens with its own CONNMARK restore, and the QOSDL downstream stamp reads
+	 * conntrack directly (see the wmm_map comment above), so neither path
+	 * depends on it. Condition added inline rather than wrapping the loop so the
+	 * strdup/free pair around it stays exactly as it was. */
 	g = buf = strdup(nvram_safe_get("qos_irates"));
 	for (i = 0; i < 10; ++i) {
 		if ((!g) || ((p = strsep(&g, ",")) == NULL)) continue;
 		if ((inuse & (1 << i)) == 0) continue;
-		if (safe_atoi(p) > 0) {
+		if (safe_atoi(p) > 0 && !IS_HWQOS() && !IS_HWQOS_CLASSFUL()) {
 			fprintf(fn, "-A PREROUTING -i %s -j CONNMARK --restore-mark --mask 0x%x\n", pcWANIF, class_mask);
 #ifdef CLS_ACT
 			fprintf(fn, "-A PREROUTING -i %s -j IMQ --todev 0\n", pcWANIF);
