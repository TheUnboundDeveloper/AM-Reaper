+}
+/* ---------- URL (url_rulelist: <1>ALL>URL) ---------- */
+var urlrules=[];
+function urlparse(){
+  urlrules=[];
+  var recs=NV.url_rulelist.split('<');
+  for(var i=0;i<recs.length;i++){
+    if(recs[i]==='')continue;
+    var f=recs[i].split('>');
+    urlrules.push(f[2]||'');
+  }
+}
+function urlrender(){
+  var tb=$('url_tbl').getElementsByTagName('tbody')[0];tb.innerHTML='';
+  if(!urlrules.length){rtEmpty(tb,2);return;}
+  urlrules.forEach(function(u,idx){tb.appendChild(rtRow([u],function(){urlrules.splice(idx,1);urlrender();}));});
+}
+/* ---------- Keyword (keyword_rulelist: flat <KW) ---------- */
+var kwrules=[];
+function kwparse(){
+  kwrules=[];
+  var recs=NV.keyword_rulelist.split('<');
+  for(var i=0;i<recs.length;i++){if(recs[i]==='')continue;kwrules.push(recs[i]);}
+}
+function kwrender(){
+  var tb=$('kw_tbl').getElementsByTagName('tbody')[0];tb.innerHTML='';
+  if(!kwrules.length){rtEmpty(tb,2);return;}
+  kwrules.forEach(function(k,idx){tb.appendChild(rtRow([k],function(){kwrules.splice(idx,1);kwrender();}));});
+}
+
+/* =================== tab switching =================== */
+var TABS=['status','general','netsvc','url','keyword','logging'];
+var stTimer=null;
+function showTab(t){
+  if(TABS.indexOf(t)<0)t='status';
+  TABS.forEach(function(x){$('tab_'+x).classList.toggle('on',x===t);});
+  Array.prototype.slice.call(document.querySelectorAll('#wins .win')).forEach(function(w){w.classList.toggle('on',w.getAttribute('data-t')===t);});
+  try{localStorage.setItem('reaper_fw_tab',t);}catch(e){}
+  try{history.replaceState(null,'','?t='+t);}catch(e){}
+  if(t==='status'){loadStatus();startAuto();}else{stopAuto();}
+  if(t==='logging')loadDrops();
+}
+function initTab(){
+  var q=(location.search.match(/[?&]t=([a-z]+)/)||[])[1];
+  if(!q){try{q=localStorage.getItem('reaper_fw_tab');}catch(e){}}
+  showTab(q||'status');
+}
+
+/* =================== STATUS view =================== */
+var OWN=[
+  {re:/^(REAPER_WARDEN|RW_DROP|RW_)/,c:'warden',n:`<#RFW_11#>`},
+  {re:/^(REAPER_GK)/,c:'gk',n:`<#RFW_10#>`},
+  {re:/^(WGS|WGC|OVPNS|OVPNC|GRE|VPNC|IPSEC)/,c:'vpn',n:`<#RFW_27#>`},
+  {re:/^(MTWAN)/,c:'other',n:`<#RFW_28#>`},
+  {re:/^(URLF|NWFF|SDN_)/,c:'sdn',n:`<#RFW_29#>`},
+  {re:/^(IControls|PControls|WGNPControls|TIME_QUOTA|DNSFILTER)/,c:'ctrl',n:`<#RFW_26#>`},
+  {re:/^(PTCSRV|HNS-UFWD)/,c:'other',n:`<#RFW_30#>`},
+  {re:/^(INPUT|OUTPUT|FORWARD|SECURITY|logdrop|logaccept|INPUT_PING|INPUT_ICMP|FUPNP|ACCESS_RESTRICTION|ICMP_V6|UPNP|default_block)/,c:'core',n:`<#RFW_25#>`}
+];
+function ownerOf(name){for(var i=0;i<OWN.length;i++){if(OWN[i].re.test(name))return OWN[i];}return {c:'other',n:`<#RFW_31#>`};}
+/* parse `iptables -nvxL` text into chains */
+function parseIpt(txt){
+  var chains=[],cur=null,lines=(txt||'').split('\n');
+  for(var i=0;i<lines.length;i++){
+    var ln=lines[i];
+    var m=ln.match(/^Chain\s+(\S+)\s+\((.*)\)/);
+    if(m){cur={name:m[1],meta:m[2],rows:[]};chains.push(cur);continue;}
+    if(!cur)continue;
+    if(/^\s*pkts\s+bytes\s+target/.test(ln))continue;
+    var t=ln.replace(/^\s+/,'');
+    if(t==='')continue;
+    var parts=t.split(/\s+/);
+    if(parts.length<3||!/^\d+$/.test(parts[0]))continue;
+    cur.rows.push({pkts:parts[0],bytes:parts[1],rest:parts.slice(2)});
+  }
+  return chains;
+}
+function fmtNum(n){n=parseInt(n,10)||0;return n.toLocaleString?n.toLocaleString():''+n;}
+function renderChains(txt,into){
+  var chains=parseIpt(txt);
+  if(!chains.length){into.innerHTML='<div class="note muted">'+esc(`<#RFW_23#>`)+'</div>';return;}
+  var h='';
+  chains.forEach(function(c){
+    var o=ownerOf(c.name);
+    h+='<div class="chaincard"><div class="ch"><span class="nm">'+esc(c.name)+'</span><span class="pol">'+esc(c.meta)+'</span><span class="owner '+o.c+'">'+esc(o.n)+'</span></div>';
+    if(c.rows.length){
+      h+='<table class="ipt"><thead><tr><th><#RFW_14#></th><th><#RFW_15#></th><th><#RFW_16#></th><th>prot</th><th>in</th><th>out</th><th><#RFW_39#></th><th><#RFW_40#></th></tr></thead><tbody>';
+      c.rows.forEach(function(r){
+        var tgt=r.rest[0]||'',prot=r.rest[1]||'',din=r.rest[3]||'',dout=r.rest[4]||'',src=r.rest[5]||'',dst=r.rest[6]||'';
+        var hit=parseInt(r.pkts,10)>0?' hit':'';
+        h+='<tr><td class="n'+hit+'">'+esc(fmtNum(r.pkts))+'</td><td class="n">'+esc(fmtNum(r.bytes))+'</td><td>'+esc(tgt)+'</td><td>'+esc(prot)+'</td><td>'+esc(din)+'</td><td>'+esc(dout)+'</td><td>'+esc(src)+'</td><td>'+esc(dst)+'</td></tr>';
+      });
+      h+='</tbody></table>';
+    }
+    h+='</div>';
+  });
+  into.innerHTML=h;
+}
+function loadStatus(){
+  xhr('/reaper_fw.cgi?action=status&http_id='+encodeURIComponent(REAPER_HTTPID),function(j){
+    if(!j||!j.ok){$('st_grid').innerHTML='<div class="note muted">'+esc(`<#RFW_43#>`)+'</div>';return;}
+    var f=j.fw;
+    function kv(k,on,txt){return '<div class="kv"><span class="k">'+esc(k)+'</span><span class="v '+(on?'on':'off')+'">'+esc(txt)+'</span></div>';}
+    var onT=`<#RFW_98#>`,offT=`<#RFW_99#>`;
+    var g='';
+    g+=kv(`<#RFW_4#>`,f.enable,f.enable?onT:offT);
+    g+=kv(`<#RFW_5#>`,f.dos,f.dos?onT:offT);
+    g+=kv(`<#RFW_6#>`,f.ping,f.ping?onT:offT);
+    g+=kv(`<#RFW_7#>`,f.wl,f.wl?onT:offT);
+    g+=kv(`<#RFW_8#>`,f.v6fw,f.v6up?(f.v6fw?onT:offT):`<#RFW_23#>`);
+    g+=kv(`<#RFW_10#>`,f.gk,f.gk?onT:offT);
+    g+=kv(`<#RFW_11#>`,f.warden,f.warden?onT:offT);
+    g+=kv(`<#RFW_9#>`,f.log&&f.log!=='none',f.log==='none'?`<#RFW_100#>`:f.log);
+    $('st_grid').innerHTML=g;
+    setPill(f.enable);
+    renderChains(j.v4,$('st_v4'));
+    renderChains(j.v6,$('st_v6'));
+  });
+}
+function setPill(on){var p=$('pill');p.textContent=on?`<#RFW_98#>`:`<#RFW_99#>`;p.className='statuspill'+(on?'':' off');}
+function startAuto(){if($('st_auto').classList.contains('on')&&!stTimer)stTimer=setInterval(loadStatus,10000);}
+function stopAuto(){if(stTimer){clearInterval(stTimer);stTimer=null;}}
+
+/* =================== LOGGING view =================== */
+function classOf(line){
+  if(line.indexOf('REAPER-WARDEN')>=0)return {c:'warden',t:'WARDEN'};
+  if(/ ACCEPT IN=/.test(line))return {c:'accept',t:'ACCEPT'};
+  return {c:'drop',t:'DROP'};
+}
+function field(line,key){var m=line.match(new RegExp(key+'=(\\S+)'));return m?m[1]:'';}
+function loadDrops(){
+  $('l_log').value=NV.fw_log_x||'none';
+  $('l_off').classList.toggle('hidden',!(NV.fw_log_x==='none'||NV.fw_log_x===''||NV.fw_log_x==='accept'));
+  xhr('/reaper_fw.cgi?action=drops&http_id='+encodeURIComponent(REAPER_HTTPID),function(j){
+    if(!j||!j.ok){$('l_view').innerHTML='<div class="note muted">'+esc(`<#RFW_43#>`)+'</div>';$('l_top').innerHTML='';return;}
+    var lines=(j.log_lines||j.lines||'').split('\n').filter(function(x){return x.trim()!=='';});
+    $('l_count').textContent=(''+lines.length);
+    if(!lines.length){$('l_view').innerHTML='<div class="note muted">'+esc(`<#RFW_43#>`)+'</div>';$('l_top').innerHTML='<div class="note muted">'+esc(`<#RFW_43#>`)+'</div>';return;}
+    var rows=[],srcCount={};
+    for(var i=lines.length-1;i>=0;i--){
+      var ln=lines[i],cl=classOf(ln);
+      var tm=(ln.match(/^(\w{3}\s+\d+\s+[\d:]+)/)||[])[1]||'';
+      var src=field(ln,'SRC'),dst=field(ln,'DST'),proto=field(ln,'PROTO'),dpt=field(ln,'DPT'),inif=field(ln,'IN');
+      rows.push({cl:cl,tm:tm,inif:inif,src:src,dst:dst,proto:proto,dpt:dpt});
+      if(src)srcCount[src]=(srcCount[src]||0)+1;
+    }
+    var h='<table class="logtbl"><thead><tr><th><#RFW_36#></th><th><#RFW_37#></th><th><#RFW_38#></th><th><#RFW_39#></th><th><#RFW_40#></th><th>proto</th><th><#RFW_41#></th></tr></thead><tbody>';
+    rows.slice(0,300).forEach(function(r){
+      h+='<tr><td class="cls"><span class="cbadge '+r.cl.c+'">'+esc(r.cl.t)+'</span></td><td>'+esc(r.tm)+'</td><td>'+esc(r.inif)+'</td><td>'+esc(r.src)+'</td><td>'+esc(r.dst)+'</td><td>'+esc(r.proto)+'</td><td>'+esc(r.dpt)+'</td></tr>';
+    });
+    h+='</tbody></table>';
+    $('l_view').innerHTML=h;
+    var top=Object.keys(srcCount).map(function(k){return {ip:k,n:srcCount[k]};}).sort(function(a,b){return b.n-a.n;}).slice(0,15);
+    var th='<table class="logtbl"><thead><tr><th><#RFW_39#></th><th>#</th></tr></thead><tbody>';
+    top.forEach(function(s){th+='<tr><td>'+esc(s.ip)+'</td><td>'+esc(''+s.n)+'</td></tr>';});
+    th+='</tbody></table>';
+    $('l_top').innerHTML=th;
+  });
+}
+
+/* =================== init + wiring =================== */
+function initToggles(){
+  Array.prototype.slice.call(document.querySelectorAll('.tg[data-nv]')).forEach(function(el){
+    tgSet(el,NV[el.getAttribute('data-nv')]==='1');
+    el.onclick=function(){el.classList.toggle('on');};
+  });
+  Array.prototype.slice.call(document.querySelectorAll('.tg:not([data-nv])')).forEach(function(el){
+    el.onclick=function(){el.classList.toggle('on');};
