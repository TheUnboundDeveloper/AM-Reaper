+  $('gr_apply').onclick=function(){
+    var wl=v4rules.map(function(r){return '<'+r.proto+'>>'+r.src+'>>>'+r.port;}).join('');
+    var v6=v6rules.map(function(r){return '<'+r.desc+'>'+r.rip+'>'+r.lip+'>'+r.port+'>'+r.proto;}).join('');
+    fwApply({
+      fw_wl_enable_x:tgGet($('g_wl')),filter_wllist:wl,
+      ipv6_fw_enable:tgGet($('g_v6')),ipv6_fw_rulelist:v6
+    });
+  };
+}
+function initNetsvc(){
+  $('n_mode').value=(NV.filter_lw_default_x==='ACCEPT')?'ACCEPT':'DROP';
+  $('n_ntp').classList.toggle('hidden',NV.svc_ready!=='0');
+  lwparse();lwrender();
+  var dw=$('lw_days');dw.innerHTML='';
+  var bitmap=(NV.filter_lw_date_x&&NV.filter_lw_date_x.length===7)?NV.filter_lw_date_x:'1111111';
+  for(var d=0;d<7;d++){
+    var id='lwd'+d;
+    var lab=document.createElement('label');
+    lab.innerHTML='<input type="checkbox" id="'+id+'"'+(bitmap.charAt(d)==='1'?' checked':'')+'> '+esc(DAYNM[d]);
+    dw.appendChild(lab);
+  }
+  function hhmm(v){return v&&v.length===8?(v.slice(0,2)+':'+v.slice(2,4)):'00:00';}
+  function hhmm2(v){return v&&v.length===8?(v.slice(4,6)+':'+v.slice(6,8)):'23:59';}
+  $('lw_wd1').value=hhmm(NV.filter_lw_time_x);$('lw_wd2').value=hhmm2(NV.filter_lw_time_x);
+  $('lw_we1').value=hhmm(NV.filter_lw_time2_x);$('lw_we2').value=hhmm2(NV.filter_lw_time2_x);
+  $('lw_icmp').value=NV.filter_lw_icmp_x||'';
