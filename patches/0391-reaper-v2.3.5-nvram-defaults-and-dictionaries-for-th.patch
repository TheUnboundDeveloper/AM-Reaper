+	{ "rwarden_stats_save", "1", CKN_STR1, CKN_TYPE_DEFAULT, CKN_ACC_LEVEL_DEFAULT, CKN_ENC_DEFAULT, 0 },	/* 1 = persist block statistics to /jffs/rwarden/counters across reboot/reflash */
