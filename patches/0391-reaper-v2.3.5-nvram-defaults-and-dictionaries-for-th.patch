 	/* reaper v1.8.8: rwatch - WAN/DNS/Warden/accelerator watchdog (rc/rwatch.c). Cron probe, no daemon; first-hop only (no phone-home); syslog transitions + /jffs/rwatch incident dumps. */
 	{ "rwatch_enable", "1", CKN_STR1, CKN_TYPE_DEFAULT, CKN_ACC_LEVEL_DEFAULT, CKN_ENC_DEFAULT, 0 },	/* master switch (default ON - diagnostics only, no data-path effect) */
 	{ "rwatch_iv", "5", CKN_STR2, CKN_TYPE_DEFAULT, CKN_ACC_LEVEL_DEFAULT, CKN_ENC_DEFAULT, 0 },	/* probe interval, minutes (1-30) */
@@ -4138,7 +4145,11 @@ struct nvram_tuple router_defaults[] = {
 #endif
 	{ "upnp_min_port_int", "1024", CKN_STR_DEFAULT, CKN_TYPE_DEFAULT, CKN_ACC_LEVEL_DEFAULT, CKN_ENC_DEFAULT, 0 },
 	{ "upnp_max_port_int", "65535", CKN_STR_DEFAULT, CKN_TYPE_DEFAULT, CKN_ACC_LEVEL_DEFAULT, CKN_ENC_DEFAULT, 0 },
-	{ "upnp_min_port_ext", "1", CKN_STR_DEFAULT, CKN_TYPE_DEFAULT, CKN_ACC_LEVEL_DEFAULT, CKN_ENC_DEFAULT, 0 },
+	/* reaper 2026-08-11: was "1", which made start_upnp() emit "allow 1-65535" and let any
+	   LAN host claim a privileged external port. The else-branch in start_upnp() that says
+	   "by default allow only redirection of ports above 1024" was unreachable because all
+	   four of these nvrams are non-zero, so the documented safe default never applied. */
+	{ "upnp_min_port_ext", "1024", CKN_STR_DEFAULT, CKN_TYPE_DEFAULT, CKN_ACC_LEVEL_DEFAULT, CKN_ENC_DEFAULT, 0 },
 	{ "upnp_max_port_ext", "65535", CKN_STR_DEFAULT, CKN_TYPE_DEFAULT, CKN_ACC_LEVEL_DEFAULT, CKN_ENC_DEFAULT, 0 },
 	{ "mfp_ip_monopoly", "", CKN_STR_DEFAULT, CKN_TYPE_DEFAULT, CKN_ACC_LEVEL_DEFAULT, CKN_ENC_DEFAULT, 0 },
 #if defined(RTCONFIG_PPTPD) || defined(RTCONFIG_ACCEL_PPTPD)
@@ -5196,7 +5207,15 @@ struct nvram_tuple router_defaults[] = {
 // miniupnpd - PCP-related values
 	{ "upnp_min_lifetime", "120", CKN_STR6, CKN_TYPE_DEFAULT, CKN_ACC_LEVEL_DEFAULT, CKN_ENC_DEFAULT, 0 },
 	{ "upnp_max_lifetime", "86400", CKN_STR6, CKN_TYPE_DEFAULT, CKN_ACC_LEVEL_DEFAULT, CKN_ENC_DEFAULT, 0 },
+	/* IPv6 firewall pinholes (IGD:2 WANIPv6FirewallControl) - selects the miniupnpd-igdv2
+	   binary. Since 2026-08-11 the plain binary is ALSO built --igd2, so this no longer
+	   silently decides whether you get IGD:2 on IPv4; it means only what its name says. */
 	{ "upnp_pinhole_enable", "0", CKN_STR1, CKN_TYPE_DEFAULT, CKN_ACC_LEVEL_DEFAULT, CKN_ENC_DEFAULT, 0 },
+	/* reaper 2026-08-11: refuse UPnP/NAT-PMP/PCP mappings on ports the router itself
+	   listens on for inbound WAN traffic (OpenVPN, WireGuard, IPSec, SSH, web admin).
+	   VUPNP hooks nat/PREROUTING, ahead of the routing decision, so such a mapping
+	   intercepts traffic meant for the router. Default on; 0 restores stock behaviour. */
+	{ "upnp_protect_svc", "1", CKN_STR1, CKN_TYPE_DEFAULT, CKN_ACC_LEVEL_DEFAULT, CKN_ENC_DEFAULT, 0 },
 
 #ifdef RTCONFIG_BCMARM
 	{ "qos_overhead", "0", CKN_STR4, CKN_TYPE_DEFAULT, CKN_ACC_LEVEL_DEFAULT, CKN_ENC_DEFAULT, 0 }, // Overhead, in bytes
