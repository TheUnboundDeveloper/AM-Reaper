+  /* reaper 2026-08-13: distinguish the empty cases. "No nodes" and "the node
+     table could not be read" are different problems, and reporting both as one
+     message is what made the field reports ("some models show nodes, some do
+     not") impossible to act on. list.length of 0 means the shared client table
+     was empty - cfg_server has not synced, or this router is not a CAP. */
+  if(shown){
+    stat.innerHTML = '';
+    stat.style.display = 'none';
+  } else {
+    stat.innerHTML = list.length ? '<#RFWU_35#>' : '<#RFWU_40#>';
+    stat.style.display = '';
