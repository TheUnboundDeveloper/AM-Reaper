diff --git a/release/src/router/httpd/web.c b/release/src/router/httpd/web.c
index f46037cf882..6a08f589d41 100644
--- a/release/src/router/httpd/web.c
+++ b/release/src/router/httpd/web.c
@@ -24018,6 +24018,29 @@ do_reaper_fw_cgi(char *url, FILE *stream)
 	/* the master switch and the revert timer are ordinary settings, but the
 	 * timer is load-bearing (S3) so the floor is enforced here as well as in
 	 * the engine - the page must never be able to post a 0. */
+	/* reaper 2026-08-13 (v2.4.0): backup / restore.
+	 *
+	 * Export is read-only and returns the eight editable lists verbatim. There
+	 * is deliberately NO matching "import" action: the page restores by replaying
+	 * the ordinary per-list `save`, so an imported configuration passes exactly
+	 * the same length and charset checks an interactive edit does. A bespoke
+	 * import path would be a second, less-travelled way into the same nvram - and
+	 * the whole point of S2 is that there is only one. It also means an import
+	 * lands in the DRAFT, so commit-confirm still gates it becoming live. */
+	if (strcmp(action, "export") == 0) {
+		static const char *keys[] = { "obj", "grp", "svc", "zone", "zpol", "rules", "edef", "nat" };
+		char nv[32];
+		int i;
+		websWrite(stream, "{\"ok\":1,\"cfg\":{");
+		for (i = 0; i < (int)(sizeof(keys) / sizeof(keys[0])); i++) {
+			snprintf(nv, sizeof(nv), "reaper_fw_%s", keys[i]);
+			websWrite(stream, "%s\"%s\":", i ? "," : "", keys[i]);
+			gk_json_esc(stream, nvram_safe_get(nv));
+		}
+		websWrite(stream, "}}");
+		return;
+	}
+
 	if (strcmp(action, "opts") == 0) {
 		char *en = get_cgi("enable"), *cf = get_cgi("confirm");
 		/* reaper 2026-08-13 (field, v2.3.9): this used to set the nvram flag and
