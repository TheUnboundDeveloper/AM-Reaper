 	let code = '<th style="width:20%"><#Interface_target#></th>';
 	for(let i=0; i< wl_info.wl_if_total; i++){
 		if(!isSmartConnectSelifBand(bandList[i])){
-			code += `<td style="width:${80/parseInt(bandList.length)}%;" align="center">- -</td>`;
