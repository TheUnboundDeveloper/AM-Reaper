+# SPDX-License-Identifier: GPL-2.0-only
+# Copyright (C) 2026 the Reaper project maintainer
+# Part of the Reaper hardened Asuswrt-Merlin build. See LICENSE / LICENSE.reaper.
+#
+# wlcsm_bindfix.so - LD_PRELOAD workaround for the Broadcom WLCSM netlink
+# port-allocation defect in the closed libnvram.so. See wlcsm_bindfix.c for the
+# full disassembly-backed analysis.
+#
+# Deliberately minimal link: ONLY -ldl. This object is preloaded into every
+# process on the box, so it must not drag in libnvram/libshared - both of which
+# call into the very code path being wrapped.
+include ../common.mak
+
+CFLAGS  += -Os -Wall -Wextra $(EXTRACFLAGS)
+# Same exploit-mitigation set the other Reaper packages use (the BCM base ships
+# no canaries and only partial RELRO). -fPIC not -fPIE: this is a shared object.
+CFLAGS  += -D_FORTIFY_SOURCE=2 -fstack-protector-strong -Wformat -Wformat-security -fPIC
+LDFLAGS += -shared -Wl,-z,relro,-z,now -ldl
+
+OBJS = wlcsm_bindfix.o
+LIB  = wlcsm_bindfix.so
+
+all: $(LIB)
+
+$(LIB): $(OBJS)
+	@echo " [wlcsm_bindfix] CC -o $@"
+	$(CC) $(CFLAGS) -o $@ $(OBJS) $(LDFLAGS)
+	$(SIZECHECK)
+	$(CPTMP)
+
+clean:
+	rm -f $(LIB) *.o .*.depend
+
+install: all
+	@echo " [wlcsm_bindfix] Installing..."
+	install -D $(LIB) $(INSTALLDIR)/lib/$(LIB)
+	$(STRIP) $(INSTALLDIR)/lib/$(LIB)
+
+%.o: %.c
+	@echo " [wlcsm_bindfix] CC $@"
+	@$(CC) $(CFLAGS) -c $<
+
+.PHONY: all clean install
diff --git a/release/src/router/wlcsm_bindfix/wlcsm_bindfix.c b/release/src/router/wlcsm_bindfix/wlcsm_bindfix.c
new file mode 100644
index 0000000000..92e0a46199
--- /dev/null
+++ b/release/src/router/wlcsm_bindfix/wlcsm_bindfix.c
@@ -0,0 +1,197 @@
+/* SPDX-License-Identifier: GPL-2.0-only
+ * wlcsm_bindfix.c - LD_PRELOAD workaround for the Broadcom WLCSM netlink
+ *                  port-allocation defect in libnvram.so.
+ *
+ * THE BUG (BCM4916 / libnvram.so, disassembly-confirmed)
+ *   _wlcsm_init() stores getpid() into wlcsm_agent+0x18 and then passes the
+ *   ADDRESS OF THAT SAME FIELD to the internal socket allocator (+0x3930) as the
+ *   port-candidate out-parameter:
+ *       3bbc:  str r0, [r1, #24]!      ; saved_pid = getpid(); r1 = &saved_pid
+ *       3bc4:  bl  3930                ; alloc(&agent, &saved_pid, 0)
+ *   The allocator bind()s NETLINK protocol 31 with nl_pid = *candidate and, on
+ *   EADDRINUSE, walks up to 10 candidates - writing each one BACK through that
+ *   pointer:
+ *       39b8:  add r6, r6, #1
+ *       39bc:  str r6, [r5]            ; <-- mutates the caller's saved_pid
+ *   So after any collision, saved_pid != getpid(). The next entry to
+ *   _wlcsm_init() tests exactly that:
+ *       3c30:  cmp r4, r0              ; saved_pid vs getpid()
+ *       3c34:  bne 3ba8                ; "the PID changed" -> re-init
+ *   and the re-init path never close()s the previous fd. Each pass leaks one
+ *   netlink socket and drifts the candidate further, until all ten are burned
+ *   and _wlcsm_init() fails permanently. wlcsm_nvram_getall() then retries the
+ *   failing send forever (5b2c: bne 5b0c) WHILE HOLDING g_WLCSM_NVRAM_MUTEX, so
+ *   that process's nvram is wedged for good. Router stays up; the process does
+ *   not. Trigger in the field: PID reuse landing on a netlink port a long-lived
+ *   process (e.g. debug_monitor) already owns.
+ *
+ * THE FIX HERE
+ *   The whole chain is gated on the FIRST bind failing. If it succeeds, the
+ *   allocator never increments, saved_pid stays == getpid(), the false
+ *   "PID changed" branch never fires, nothing leaks, nothing spins.
+ *   So: on EADDRINUSE for a netlink socket, retry ONCE with nl_pid = 0, which
+ *   asks the kernel to autobind a free port - what this code should have done.
+ *   The caller's saved_pid is left alone (we copy the sockaddr), so its own
+ *   consistency check keeps passing.
+ *
+ * SCOPE / SAFETY
+ *   - Only AF_NETLINK, only when the real bind() already failed EADDRINUSE, and
+ *     only when the requested nl_pid was non-zero. Everything else is passed
+ *     straight through, untouched.
+ *   - Restricted to NETLINK protocol 31 when SO_PROTOCOL is readable, so other
+ *     netlink users (rtnetlink &c.) are never touched.
+ *   - Kill switch: WLCSM_BINDFIX=0 keeps the logging but stops the rewrite, so
+ *     you can A/B on a live box without pulling the preload.
+ *   - Touches no ASUS/Broadcom binary. This is our own code loaded beside it.
+ *
+ * RESIDUAL RISK (bench this before trusting it)
+ *   After autobind the socket's real port != getpid(). Nothing in the kernel
+ *   cares. The open question is whether the wlcsm daemon ever addresses this
+ *   process by a port it ASSUMES equals the PID. wlcsm_register_process()
+ *   exists, which suggests the daemon is told rather than assuming - but that is
+ *   inference. Watch for wlcsm unicast replies going missing after a rewrite
+ *   fires (the log line below tells you exactly when that happened).
+ *
+ * BUILD (target is 32-bit ARM EABI - libnvram.so is ELF32 ARM):
+ *   arm-buildroot-linux-gnueabi-gcc -shared -fPIC -O2 -Wall -Wextra \
+ *       -o wlcsm_bindfix.so wlcsm_bindfix.c -ldl
+ *
+ * USE
+ *   LD_PRELOAD=/jffs/wlcsm_bindfix.so <command>
+ *   ...or export it for a service before it starts. LD_PRELOAD is ignored for
+ *   setuid binaries, and a daemon that does not inherit the env will not pick it
+ *   up - check coverage per process.
+ */
+
+#define _GNU_SOURCE
+#include <dlfcn.h>
+#include <errno.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/socket.h>
+#include <syslog.h>
+#include <unistd.h>
+#include <linux/netlink.h>
+
+#ifndef SO_PROTOCOL
+#define SO_PROTOCOL 38
+#endif
+
+#define WLCSM_NETLINK_PROTO 31
+
+static int (*real_bind)(int, const struct sockaddr *, socklen_t);
+static unsigned long rewrites, passthru;
+
+static void resolve(void)
+{
+	if (!real_bind)
+		real_bind = dlsym(RTLD_NEXT, "bind");
+}
+
+/* Rewriting is on unless explicitly disabled. Read every call: cheap, and it
+ * lets you flip behaviour on a running box by restarting just one service. */
+static int rewrite_enabled(void)
+{
+	const char *e = getenv("WLCSM_BINDFIX");
+	return !(e && e[0] == '0');
+}
+
+/* Which netlink protocol to guard. Defaults to WLCSM's 31; overridable so the
+ * logic can be exercised on a bench kernel (protocol 31 only exists where
+ * wlcsm.ko is loaded), and so scope can be widened in the field without a
+ * rebuild if WLCSM ever moves. */
+static int target_proto(void)
+{
+	const char *e = getenv("WLCSM_BINDFIX_PROTO");
+	return (e && *e) ? atoi(e) : WLCSM_NETLINK_PROTO;
+}
+
+/* If SO_PROTOCOL is unreadable we proceed anyway - an EADDRINUSE on a netlink
+ * bind is this bug's signature regardless - but we say so in the log so it is
+ * never a silent assumption. */
+static int is_wlcsm_socket(int fd, int *proto_out)
+{
+	int proto = -1;
+	socklen_t len = sizeof(proto);
+
+	if (getsockopt(fd, SOL_SOCKET, SO_PROTOCOL, &proto, &len) != 0) {
+		*proto_out = -1;
+		return 1;
+	}
+	*proto_out = proto;
+	return proto == target_proto();
+}
+
+int bind(int sockfd, const struct sockaddr *addr, socklen_t addrlen)
+{
+	const struct sockaddr_nl *nl;
+	struct sockaddr_nl retry;
+	int rc, saved_errno, proto = -1;
+
+	resolve();
+	if (!real_bind) {              /* cannot happen in practice; fail safe */
+		errno = ENOSYS;
+		return -1;
+	}
+
+	rc = real_bind(sockfd, addr, addrlen);
+	if (rc == 0)
+		return 0;
+	saved_errno = errno;
+
+	/* Only the exact failure this bug produces. */
+	if (saved_errno != EADDRINUSE ||
+	    addr == NULL || addrlen < (socklen_t)sizeof(struct sockaddr_nl) ||
+	    addr->sa_family != AF_NETLINK) {
+		errno = saved_errno;
+		return rc;
+	}
+
+	nl = (const struct sockaddr_nl *)addr;
+	if (nl->nl_pid == 0) {         /* already autobind - nothing to rescue */
+		errno = saved_errno;
+		return rc;
+	}
+
+	if (!is_wlcsm_socket(sockfd, &proto)) {
+		passthru++;
+		errno = saved_errno;
+		return rc;
+	}
+
+	if (!rewrite_enabled()) {
+		syslog(LOG_DAEMON | LOG_WARNING,
+		       "wlcsm_bindfix: EADDRINUSE nl_pid=%u proto=%d pid=%d "
+		       "(rewrite DISABLED by WLCSM_BINDFIX=0)",
+		       (unsigned)nl->nl_pid, proto, (int)getpid());
+		errno = saved_errno;
+		return rc;
+	}
+
+	/* Copy - never mutate the caller's sockaddr. libnvram passes a pointer
+	 * into its own agent struct, and that storage doubles as its saved PID. */
+	memset(&retry, 0, sizeof(retry));
+	retry.nl_family = AF_NETLINK;
+	retry.nl_groups = nl->nl_groups;
+	retry.nl_pid    = 0;                   /* kernel picks a free port */
+
+	rc = real_bind(sockfd, (const struct sockaddr *)&retry, sizeof(retry));
+	if (rc == 0) {
+		rewrites++;
+		syslog(LOG_DAEMON | LOG_WARNING,
+		       "wlcsm_bindfix: nl_pid=%u was EADDRINUSE (proto=%d%s), "
+		       "rebound via kernel autobind - pid=%d, rewrites=%lu. "
+		       "Broadcom WLCSM would have leaked a socket here.",
+		       (unsigned)nl->nl_pid, proto,
+		       proto < 0 ? ", SO_PROTOCOL unreadable" : "",
+		       (int)getpid(), rewrites);
+		return 0;
+	}
+
+	syslog(LOG_DAEMON | LOG_ERR,
+	       "wlcsm_bindfix: autobind retry ALSO failed (%s) for nl_pid=%u "
+	       "pid=%d - passing the original EADDRINUSE back",
+	       strerror(errno), (unsigned)nl->nl_pid, (int)getpid());
+	errno = saved_errno;
+	return -1;
+}
