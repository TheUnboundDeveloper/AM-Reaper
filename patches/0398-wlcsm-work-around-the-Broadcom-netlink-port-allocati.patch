 }
 
+/* ===================================================================
+ * reaper 2026-08-12: activate the WLCSM netlink bind() shim.
+ *
+ * THE BUG IT WORKS AROUND (closed libnvram.so, disassembly-confirmed, and caught
+ * live on metal 2026-08-11): _wlcsm_init() stores getpid() into wlcsm_agent+0x18
+ * and hands the ADDRESS OF THAT SAME FIELD to the internal netlink allocator as
+ * the port-candidate out-parameter. On EADDRINUSE the allocator walks up to ten
+ * candidates, writing each one back through that pointer (0x39bc: str r6,[r5]),
+ * so the saved PID is corrupted. The next call sees saved_pid != getpid(),
+ * concludes the process forked, and re-initialises WITHOUT closing the previous
+ * socket. Each pass leaks one netlink socket and drifts further, until all ten
+ * candidates are gone - after which wlcsm_nvram_getall() spins on the failing
+ * send forever (0x5b2c: bne 5b0c) while holding g_WLCSM_NVRAM_MUTEX. That burns
+ * a core in syscalls, floods stderr, and the process never completes its nvram
+ * write. Trigger: PID reuse landing on a netlink port a long-lived process
+ * already owns. The leaked ports then squat, making the next collision likelier.
+ *
+ * The shim makes the FIRST bind succeed (kernel autobind on EADDRINUSE), which
+ * is the single gate the whole chain hangs off - no drift, no leak, no spin.
+ * Broadcom's own second WLCSM socket is already allocated with nl_pid = 0, so
+ * autobind is not a foreign concept to this subsystem.
+ *
+ * DEFAULT OFF. /etc/ld.so.preload is global - it applies to every dynamically
+ * linked process on the box - and this has not yet run on hardware. That is the
+ * same risk class as the /proc readers that caused the accel-experiment reboot
+ * loops, so it ships inert and is enabled deliberately:
+ *     nvram set wlcsm_bindfix=1 && nvram commit && reboot
+ * Setting it back to 0 removes the file on the next boot. Per-process opt-out
+ * without a reboot: WLCSM_BINDFIX=0 in that process's environment.
+ * =================================================================== */
+#define WLCSM_BINDFIX_LIB "/lib/wlcsm_bindfix.so"
+#define LD_SO_PRELOAD     "/etc/ld.so.preload"
+
+/* Only ever remove a preload file that is OURS. Nothing else in this firmware
+ * writes /etc/ld.so.preload today, but silently deleting someone else's would be
+ * a nasty surprise for an add-on. */
+static void wlcsm_bindfix_remove(void)
+{
+	char buf[256] = "";
+	FILE *f = fopen(LD_SO_PRELOAD, "r");
+
+	if (!f)
+		return;
+	if (fgets(buf, sizeof(buf), f) == NULL)
+		buf[0] = '\0';
+	fclose(f);
+	if (strstr(buf, "wlcsm_bindfix"))
+		unlink(LD_SO_PRELOAD);
+}
+
+void start_wlcsm_bindfix(void)
+{
+	FILE *f;
+
+	if (!nvram_match("wlcsm_bindfix", "1")) {
+		wlcsm_bindfix_remove();
+		return;
+	}
+	if (!f_exists(WLCSM_BINDFIX_LIB)) {
+		logmessage("wlcsm_bindfix", "enabled but %s is missing - NOT installing "
+			   "the preload (nvram wlcsm_bindfix=1 has no effect)",
+			   WLCSM_BINDFIX_LIB);
+		wlcsm_bindfix_remove();
+		return;
+	}
+	if ((f = fopen(LD_SO_PRELOAD, "w")) == NULL) {
+		logmessage("wlcsm_bindfix", "cannot write %s (%s) - shim NOT active",
+			   LD_SO_PRELOAD, strerror(errno));
+		return;
+	}
+	fprintf(f, "%s\n", WLCSM_BINDFIX_LIB);
+	fclose(f);
+	logmessage("wlcsm_bindfix", "netlink bind() shim armed via %s - WLCSM port "
+		   "collisions will be rescued by kernel autobind instead of leaking "
+		   "sockets (set wlcsm_bindfix=0 to disable)", LD_SO_PRELOAD);
+}
+
 /* reaper 2026-08-11: the IGDv2 build runs under a DIFFERENT process name
  * ("miniupnpd-igdv2", see the xstart() above), and pidof()/killall() are exact
  * strcmp() matches on the process name (shared/process.c:71). So a bare
@@ -13383,6 +13460,12 @@ start_services(void)
 
 	logmessage("services", "start_services: begin");
 
+	/* reaper: arm (or clear) the WLCSM netlink bind shim BEFORE any daemon is
+	 * spawned - /etc/ld.so.preload only affects processes started after it is
+	 * written, and the victims of the bug are the nvram users below plus any
+	 * `nvram` invoked from a script. No-op unless nvram wlcsm_bindfix=1. */
+	start_wlcsm_bindfix();
+
 #if 0
 #ifdef HND_ROUTER
 	start_jitterentropy();
