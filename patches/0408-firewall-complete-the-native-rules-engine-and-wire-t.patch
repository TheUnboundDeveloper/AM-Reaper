+/* copy field `idx` (0-based, '>'-separated) of `rec` into out. 1 on success. */
+static int rfw_field(const char *rec, int idx, char *out, size_t ol)
+{
+	const char *p = rec, *end;
+	int i;
+	if (!rec || !out || ol == 0) return 0;
+	out[0] = 0;
+	for (i = 0; i < idx; i++) {
