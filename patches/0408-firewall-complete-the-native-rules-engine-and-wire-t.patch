diff --git a/release/src/router/httpd/web.c b/release/src/router/httpd/web.c
index 2f30b58b2c..a2450fbd6e 100644
--- a/release/src/router/httpd/web.c
+++ b/release/src/router/httpd/web.c
@@ -23446,6 +23446,14 @@ fw_line_is_fwlog(const char *line)
 #define FW_DROPS_MAX	400
 #define FW_DROPS_LINE	640
 
+/* reaper v2.3.8 native firewall, Phase 1 draft-editing limits. The list cap is
+ * the nvram CKN_STR_MAX budget these keys were declared with; the confirm floor
+ * mirrors RFW_CONFIRM_MIN in rc/reaper_fw.c - the timer is the anti-lockout net
+ * (S3), so neither end may accept a 0. */
+#define RFW_LIST_MAX		8192
+#define RFW_CONFIRM_FLOOR	15
+#define RFW_CONFIRM_CEIL	3600
+
 static void
 fw_scan_syslog(const char *path, char *ring, int *head, int *count)
 {
@@ -23538,6 +23546,143 @@ do_reaper_fw_cgi(char *url, FILE *stream)
 		return;
 	}
 
+	/* ---------------- Phase 1: the object-model rules engine ----------------
+	 * Everything below edits the DRAFT only. Values land in nvram RAM and are
+	 * never committed here: the single path that writes flash is
+	 * reaper_fw_confirm(), after the operator has confirmed a ruleset that is
+	 * already live. That is what makes the commit-confirm window meaningful -
+	 * a box that reboots mid-window comes back on the last CONFIRMED config.
+	 */
+
+	/* the whole object model plus live commit-confirm state */
+	if (strcmp(action, "cfg") == 0) {
+		long left = 0;
+		if (nvram_match("reaper_fw_armed", "1")) {
+			FILE *df = fopen("/tmp/reaper_fw/deadline", "r");
+			long dl = 0;
+			if (df) {
+				if (fscanf(df, "%ld", &dl) != 1) dl = 0;
+				fclose(df);
+			}
+			left = dl - (long)time(NULL);
+			if (left < 0) left = 0;
+		}
+		websWrite(stream, "{\"ok\":1,\"enable\":%d,\"confirm\":%d,\"armed\":%d,\"left\":%ld",
+			nvram_match("reaper_fw_enable", "1") ? 1 : 0,
+			nvram_get_int("reaper_fw_confirm"),
+			nvram_match("reaper_fw_armed", "1") ? 1 : 0,
+			left);
+		websWrite(stream, ",\"warden\":%d,\"wgeo\":",
+			nvram_match("rwarden_enable", "1") ? 1 : 0);
+		gk_json_esc(stream, nvram_safe_get("rwarden_geo"));
+		websWrite(stream, ",\"err\":");
+		gk_json_esc(stream, nvram_safe_get("reaper_fw_err"));
+		websWrite(stream, ",\"obj\":");   gk_json_esc(stream, nvram_safe_get("reaper_fw_obj"));
+		websWrite(stream, ",\"grp\":");   gk_json_esc(stream, nvram_safe_get("reaper_fw_grp"));
+		websWrite(stream, ",\"svc\":");   gk_json_esc(stream, nvram_safe_get("reaper_fw_svc"));
+		websWrite(stream, ",\"zone\":");  gk_json_esc(stream, nvram_safe_get("reaper_fw_zone"));
+		websWrite(stream, ",\"zpol\":");  gk_json_esc(stream, nvram_safe_get("reaper_fw_zpol"));
+		websWrite(stream, ",\"rules\":"); gk_json_esc(stream, nvram_safe_get("reaper_fw_rules"));
+		websWrite(stream, "}");
+		return;
+	}
+
+	/* write one draft list. The engine is what validates records structurally
+	 * at generation time (rc/reaper_fw.c, S2) - what matters HERE is that the
+	 * bytes going into nvram are printable ASCII and bounded, so a hostile
+	 * value cannot smuggle a newline or a control character into the store,
+	 * the lastgood file or this page's own JSON. */
+	if (strcmp(action, "save") == 0) {
+		static const struct { const char *k; const char *nv; size_t max; } tbl[] = {
+			{ "obj",   "reaper_fw_obj",   RFW_LIST_MAX },
+			{ "grp",   "reaper_fw_grp",   RFW_LIST_MAX },
+			{ "svc",   "reaper_fw_svc",   2048 },
+			{ "zone",  "reaper_fw_zone",  2048 },
+			{ "zpol",  "reaper_fw_zpol",  2048 },
+			{ "rules", "reaper_fw_rules", RFW_LIST_MAX },
+		};
+		char *k = get_cgi("k"), *v = get_cgi("v");
+		const char *p;
+		int i;
+		if (!k || !v) {
+			websWrite(stream, "{\"ok\":0,\"error\":\"missing parameter\"}");
+			return;
+		}
+		for (i = 0; i < (int)(sizeof(tbl) / sizeof(tbl[0])); i++) {
+			if (strcmp(k, tbl[i].k) != 0) continue;
+			if (strlen(v) >= tbl[i].max) {
+				websWrite(stream, "{\"ok\":0,\"error\":\"list too long\"}");
+				return;
+			}
+			for (p = v; *p; p++) {
+				if ((unsigned char)*p < 0x20 || (unsigned char)*p > 0x7E) {
+					websWrite(stream, "{\"ok\":0,\"error\":\"unsupported character\"}");
+					return;
+				}
+			}
+			nvram_set(tbl[i].nv, v);           /* RAM only - see the note above */
+			websWrite(stream, "{\"ok\":1}");
+			return;
+		}
+		websWrite(stream, "{\"ok\":0,\"error\":\"unknown list\"}");
+		return;
+	}
+
+	/* the master switch and the revert timer are ordinary settings, but the
+	 * timer is load-bearing (S3) so the floor is enforced here as well as in
+	 * the engine - the page must never be able to post a 0. */
+	if (strcmp(action, "opts") == 0) {
+		char *en = get_cgi("enable"), *cf = get_cgi("confirm");
+		if (en && (!strcmp(en, "0") || !strcmp(en, "1")))
+			nvram_set("reaper_fw_enable", en);
+		if (cf) {
+			int n = atoi(cf);
+			char b[12];
+			if (n < RFW_CONFIRM_FLOOR) n = RFW_CONFIRM_FLOOR;
+			if (n > RFW_CONFIRM_CEIL)  n = RFW_CONFIRM_CEIL;
+			snprintf(b, sizeof(b), "%d", n);
+			nvram_set("reaper_fw_confirm", b);
+		}
+		websWrite(stream, "{\"ok\":1,\"confirm\":%d}", nvram_get_int("reaper_fw_confirm"));
+		return;
+	}
+
+	/* compile the draft to a preview without executing anything */
+	if (strcmp(action, "dryrun") == 0) {
+		notify_rc("start_reaper_fw_dryrun");
+		websWrite(stream, "{\"ok\":1}");
+		return;
+	}
+	if (strcmp(action, "preview") == 0) {
+		if (!f_exists("/tmp/reaper_fw/preview.txt")) {
+			websWrite(stream, "{\"ok\":0,\"pending\":1}");
+			return;
+		}
+		websWrite(stream, "{\"ok\":1,\"text\":");
+		fw_emit_cmd(stream, "cat /tmp/reaper_fw/preview.txt 2>/dev/null", 131072);
+		websWrite(stream, "}");
+		return;
+	}
+
+	/* the three commit-confirm verbs. Each is a distinct service so that the
+	 * notify_rc trail shows exactly which one ran. */
+	if (strcmp(action, "apply") == 0) {
+		nvram_unset("reaper_fw_err");
+		notify_rc("start_reaper_fw_apply");
+		websWrite(stream, "{\"ok\":1}");
+		return;
+	}
+	if (strcmp(action, "confirm") == 0) {
+		notify_rc("start_reaper_fw_confirm");
+		websWrite(stream, "{\"ok\":1}");
+		return;
+	}
+	if (strcmp(action, "rollback") == 0) {
+		notify_rc("start_reaper_fw_rollback");
+		websWrite(stream, "{\"ok\":1}");
+		return;
+	}
+
 	websWrite(stream, "{\"ok\":0,\"error\":\"unknown action\"}");
 }
 
