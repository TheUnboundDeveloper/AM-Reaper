diff --git a/release/src/router/rc/reaper_fw.c b/release/src/router/rc/reaper_fw.c
index 4d744c0d99..665ec948b5 100644
--- a/release/src/router/rc/reaper_fw.c
+++ b/release/src/router/rc/reaper_fw.c
@@ -85,7 +85,10 @@
 #include <stdlib.h>
 #include <string.h>
 #include <ctype.h>
+#include <stddef.h>
+#include <time.h>
 #include <sys/stat.h>
+#include <sys/types.h>
 #include <unistd.h>
 
 #include "rc.h"
@@ -101,15 +104,39 @@
 #define RFW_CACHE    "/jffs/reaper_fw"
 #define RFW_LASTGOOD RFW_CACHE "/lastgood"        /* last-CONFIRMED config snapshot = the rollback source (S3) */
 
+#define RFW_ROLLBACK RFW_DIR "/rollback.sh"       /* pre-generated lastgood ruleset (see S3) */
+#define RFW_RESOLVE  RFW_DIR "/resolve.sh"        /* periodic fqdn -> ipset refresh */
+#define RFW_PREVIEW  RFW_DIR "/preview.txt"       /* compile-preview output (never executed) */
+
 #define RFW_CONFIRM_MIN  15                       /* commit-confirm floor, seconds (S3: never 0) */
 #define RFW_CONFIRM_DEF  60
+#define RFW_CONFIRM_MAX  3600
+
+/* generation ceilings. These are not policy limits, they are blast-radius
+ * limits: a malformed or hostile config must not be able to make the generated
+ * script unbounded. Anything past them is dropped and logged, never truncated
+ * silently (a silently-dropped-but-believed-active entry was an ingredient of
+ * the 2026-07-29 Warden lockout). */
+#define RFW_MAX_OBJ        128
+#define RFW_MAX_RULES      256
+#define RFW_MAX_ZPOL        64
+#define RFW_MAX_IFACE        8    /* interfaces per zone actually matched */
+#define RFW_MAX_PORTS       15    /* -m multiport hard limit */
+#define RFW_MAX_PER_RULE    64    /* emitted iptables lines from one user rule */
 
 /* ipset object set names are rwfw_<name> (v4) / rwfw6_<name> (v6). The <name>
- * is validated to [A-Za-z0-9_]{1,28} so the full set name stays within ipset's
- * 31-char limit and can never break shell quoting (S2). */
+ * is validated to [A-Za-z0-9_]{1,RFW_NAME_MAX} so the full set name stays within
+ * ipset's 31-char usable limit (IPSET_MAXNAMELEN 32 incl. NUL) and can never
+ * break shell quoting (S2).
+ *
+ * The bound is set by the LONGER prefix: "rwfw6_" is 6 chars, so 31 - 6 = 25.
+ * (This was 28 in the Phase-1 foundation, which is wrong - a 26..28 char name
+ * produced a 32..34 char v6 set name that ipset rejects at create, leaving a
+ * rule pointing at a set that does not exist. Caught in review before the
+ * generator was written, so no shipped image was ever affected.) */
