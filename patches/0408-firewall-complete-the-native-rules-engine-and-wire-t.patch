+/* ---------------------------------------------------------------------------
+ * ipset materialization. Every non-geo address object becomes one v4 set and
+ * one v6 set (either may end up empty - an empty set simply never matches,
+ * which is the safe direction and avoids a rule referencing a missing set).
+ * `keep` accumulates the set names this config legitimately owns, so the
+ * generated script can destroy any leftover rwfw_* from a deleted object.
+ * ------------------------------------------------------------------------- */
+
+static void rfw_emit_one_set(FILE *f, const char *type, const char *name,
+                             const char *val, char *keep, size_t keeplen)
+{
+	const char *stype4 = "hash:net", *stype6 = "hash:net";
+	char *dup, *tok, *save = NULL;
+	int bad = 0;
+
+	if (!strcmp(type, "range")) { stype4 = "hash:ip"; stype6 = "hash:ip"; }
+	if (!strcmp(type, "mac"))   { stype4 = "hash:mac"; stype6 = "hash:mac"; }
+
+	fprintf(f, "ipset create %s%s %s -exist\n", RFW_SET4, name, stype4);
+	fprintf(f, "ipset flush %s%s\n", RFW_SET4, name);
+	if (strcmp(type, "mac") != 0) {
+		fprintf(f, "ipset create %s%s %s family inet6 -exist\n", RFW_SET6, name, stype6);
+		fprintf(f, "ipset flush %s%s\n", RFW_SET6, name);
+	}
+	strlcat(keep, " ", keeplen); strlcat(keep, RFW_SET4, keeplen); strlcat(keep, name, keeplen);
+	if (strcmp(type, "mac") != 0) {
+		strlcat(keep, " ", keeplen); strlcat(keep, RFW_SET6, keeplen); strlcat(keep, name, keeplen);
+	}
+
+	/* an fqdn object's members are resolved at run time by the refresh script,
+	 * not here - the set is created empty and filled below. */
+	if (!strcmp(type, "fqdn")) return;
+
+	if (!(dup = strdup(val))) return;
+	for (tok = strtok_r(dup, ",", &save); tok; tok = strtok_r(NULL, ",", &save)) {
+		int ok = 0, v6 = 0;
+		if (!strcmp(type, "mac")) {
+			ok = rfw_valid_mac(tok);
+		} else if (!strcmp(type, "range")) {
+			ok = rfw_valid_range(tok); v6 = (strchr(tok, ':') != NULL);
+		} else {                                    /* host | cidr */
+			ok = rfw_valid_ip(tok);   v6 = (strchr(tok, ':') != NULL);
+		}
+		if (!ok) { bad++; continue; }
+		/* S2: only tokens that passed a structural validator ever reach the
+		 * generated shell, and their charsets cannot break out of the line. */
+		fprintf(f, "ipset add %s%s %s -exist || logger -t reaper_fw "
+		           "'object %s: entry rejected by ipset: %s'\n",
+		        (v6 && strcmp(type, "mac")) ? RFW_SET6 : RFW_SET4, name, tok, name, tok);
+	}
+	free(dup);
+	if (bad)
+		logmessage("reaper_fw", "object %s: %d invalid value(s) IGNORED", name, bad);
+}
+
+/* create+fill every address object's sets, and remember the names we own. */
+static void rfw_emit_sets(FILE *f, const rfw_cfg_t *c, char *keep, size_t keeplen)
+{
+	char *dup, *tok, *save = NULL;
+	int n = 0;
+	if (!c->obj || !*c->obj) return;
+	if (!(dup = strdup(c->obj))) return;
+	for (tok = strtok_r(dup, "<", &save); tok; tok = strtok_r(NULL, "<", &save)) {
+		char name[RFW_NAME_MAX + 2], type[16], val[768];
+		if (++n > RFW_MAX_OBJ) {
+			logmessage("reaper_fw", "more than %d objects - the rest are IGNORED", RFW_MAX_OBJ);
+			break;
+		}
+		if (!rfw_field(tok, 0, name, sizeof(name)) ||
+		    !rfw_field(tok, 1, type, sizeof(type)) ||
+		    !rfw_field(tok, 2, val,  sizeof(val)))
+			continue;
+		if (!rfw_valid_name(name)) {
+			logmessage("reaper_fw", "object with invalid name IGNORED");
+			continue;
+		}
+		if (!strcmp(type, "geo")) continue;              /* S5: Warden owns it */
+		if (strcmp(type, "host") && strcmp(type, "cidr") && strcmp(type, "range") &&
+		    strcmp(type, "mac")  && strcmp(type, "fqdn")) {
+			logmessage("reaper_fw", "object %s: unknown type IGNORED", name);
+			continue;
+		}
+		rfw_emit_one_set(f, type, name, val, keep, keeplen);
+	}
+	free(dup);
