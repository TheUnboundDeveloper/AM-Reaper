+
+static void rfw_cfg_free(rfw_cfg_t *c)
+{
+	int i;
+	if (!c) return;
+	free(c->enable); free(c->confirm);
+	for (i = 0; i < RFW_NKEYS; i++) {
+		char **slot = (char **)((char *)c + rfw_keys[i].off);
+		free(*slot); *slot = NULL;
+	}
+	c->enable = c->confirm = NULL;
+}
