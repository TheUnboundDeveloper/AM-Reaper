+/* resolve an object OR group reference to a list of set names for `v6`. */
+static int rfw_resolve(const rfw_cfg_t *c, const char *ref, int v6,
+                       rfw_setname_t *out, int max)
+{
+	char rec[2048], members[1900];
+	int n = 0;
+
+	if (!ref || !*ref) return 0;
+	/* a group takes precedence only if no object of that name exists */
+	if (rfw_obj_set(c, ref, v6, out[0].name, sizeof(out[0].name)))
+		return 1;
+	if (!rfw_find(c->grp, ref, rec, sizeof(rec))) return 0;
+	if (!rfw_field(rec, 1, members, sizeof(members))) return 0;
+	{
+		char *dup = strdup(members), *tok, *save = NULL;
+		if (!dup) return 0;
+		for (tok = strtok_r(dup, ",", &save); tok && n < max; tok = strtok_r(NULL, ",", &save)) {
+			if (!rfw_valid_name(tok)) continue;
+			if (rfw_obj_set(c, tok, v6, out[n].name, sizeof(out[n].name))) n++;
+		}
+		free(dup);
+	}
+	return n;
