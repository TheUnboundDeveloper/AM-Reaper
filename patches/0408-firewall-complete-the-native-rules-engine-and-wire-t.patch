+	 * i.e. BELOW our inserted jump - so we must carry our own or the operator's
+	 * in-flight session (including the commit-confirm POST) dies on the first
+	 * restrictive rule. */
+	fprintf(f, "%s -A %s -m conntrack --ctstate ESTABLISHED,RELATED -j RETURN\n", ipt, ch);
+
+	if (!v6) {
+		fprintf(f, "%s -A %s -p udp --sport 67:68 --dport 67:68 -j RETURN\n", ipt, ch);
+	} else {
+		fprintf(f, "%s -A %s -p udp --sport 546:547 --dport 546:547 -j RETURN\n", ipt, ch);
+		for (i = 0; i < (int)(sizeof(rfw_icmp6_keep) / sizeof(rfw_icmp6_keep[0])); i++)
+			fprintf(f, "%s -A %s -p ipv6-icmp --icmpv6-type %d -j RETURN\n",
+			        ipt, ch, rfw_icmp6_keep[i]);
+	}
+
+	/* The operator's own management path. $ADM is the address of the session
+	 * that armed this ruleset (login_ip_str), matched only in its own family. */
+	fprintf(f,
+	  "if [ -n \"$ADM\" ] && [ \"$ADMV6\" = \"%d\" ]; then\n"
+	  "  %s -A %s %s \"$ADM\" -p tcp --dport \"$MGMT\" -j RETURN\n"
+	  "  [ \"$SSHEN\" != \"0\" ] && %s -A %s %s \"$ADM\" -p tcp --dport \"$SSHP\" -j RETURN\n"
+	  "fi\n",
+	  v6 ? 1 : 0,
+	  ipt, ch, (dir == RFW_D_OUT) ? "-d" : "-s",
+	  ipt, ch, (dir == RFW_D_OUT) ? "-d" : "-s");
+
+	/* Name resolution and DHCP for the LAN itself. The router is the LAN's
+	 * resolver; a blanket inbound drop that takes DNS with it looks exactly
+	 * like "the internet is down" on every client at once. Scoped to the LAN
+	 * subnet so this never opens the WAN side. */
+	if (dir == RFW_D_IN) {
+		if (!v6) {
+			fprintf(f, "%s -A %s -s \"$LANNET\" -p udp --dport 53 -j RETURN\n", ipt, ch);
+			fprintf(f, "%s -A %s -s \"$LANNET\" -p tcp --dport 53 -j RETURN\n", ipt, ch);
+		} else {
+			fprintf(f, "%s -A %s -s fe80::/10 -p udp --dport 53 -j RETURN\n", ipt, ch);
+			fprintf(f, "%s -A %s -s fc00::/7  -p udp --dport 53 -j RETURN\n", ipt, ch);
+		}
+	}
+}
+
+/* ---------------------------------------------------------------------------
+ * Rule emission.
+ * ------------------------------------------------------------------------- */
+
+/* zone -> interface list. Returns count; 0 means "no interface constraint". */
+static int rfw_zone_ifaces(const rfw_cfg_t *c, const char *zname,
+                           char ifs[][IFNAMSIZ + 2], int max)
+{
+	char rec[1024], list[768], *dup, *tok, *save = NULL;
+	int n = 0;
+	if (!zname || !*zname) return 0;
+	if (!rfw_find(c->zone, zname, rec, sizeof(rec))) return 0;
+	if (!rfw_field(rec, 1, list, sizeof(list))) return 0;
+	if (!(dup = strdup(list))) return 0;
+	for (tok = strtok_r(dup, ",", &save); tok && n < max; tok = strtok_r(NULL, ",", &save)) {
+		if (!rfw_valid_iface(tok)) continue;
+		strlcpy(ifs[n++], tok, IFNAMSIZ + 2);
+	}
+	free(dup);
+	return n;
+}
+
+static int rfw_count_ports(const char *p)
+{
+	int n = 1;
+	if (!p || !*p) return 0;
+	for (; *p; p++) if (*p == ',') n++;
+	return n;
+}
+
+/* build the -m time fragment from "DAYS|HH:MM|HH:MM". */
+static void rfw_sched_frag(const char *sched, char *out, size_t ol)
+{
+	char buf[96], *p1, *p2;
+	out[0] = 0;
+	if (!sched || !*sched || !rfw_valid_sched(sched)) return;
+	strlcpy(buf, sched, sizeof(buf));
+	p1 = strchr(buf, '|'); if (!p1) return; *p1++ = 0;
+	p2 = strchr(p1,  '|'); if (!p2) return; *p2++ = 0;
+	if (buf[0])
+		snprintf(out, ol, " -m time --timestart %s --timestop %s" DAYS_PARAM "%s", p1, p2, buf);
+	else
+		snprintf(out, ol, " -m time --timestart %s --timestop %s --kerneltz", p1, p2);
+}
+
+/* one fully-qualified iptables line. `pre` carries the interface + address +
+ * service matches; this adds schedule, rate, optional log and the target. */
+static void rfw_emit_line(FILE *f, const char *ipt, const char *ch, const char *pre,
+                          const char *schedfrag, const char *rate, const char *action,
+                          int dolog, int ridx, int v6)
+{
+	char ratefrag[160];
+	ratefrag[0] = 0;
+	if (rate && *rate && rfw_valid_rate(rate))
+		snprintf(ratefrag, sizeof(ratefrag),
+		         " -m hashlimit --hashlimit-above %s --hashlimit-mode srcip"
+		         " --hashlimit-name rfw%d --hashlimit-htable-expire 60000", rate, ridx);
+
+	/* A rate-qualified rule whose match module is unavailable must be SKIPPED,
+	 * never emitted without the qualifier: dropping the "-m hashlimit" from a
+	 * "drop above 20/sec" rule silently turns it into an unconditional drop. */
+	if (ratefrag[0]) fprintf(f, "if [ \"$RFW_HL\" = 1 ]; then\n");
+
+	if (dolog) {
+		/* rate-limited by construction: an unbounded LOG on a busy forward path
+		 * fills syslog (and, when the operator has pointed syslog at jffs, wears
+		 * flash) faster than anything else this engine can emit. */
+		fprintf(f, "%s -A %s%s%s%s -m limit --limit 6/min --limit-burst 12"
+		           " -j LOG --log-prefix \"REAPER-FW:%d \" --log-level 4\n",
+		        ipt, ch, pre, schedfrag, ratefrag, ridx);
+	}
+	if (!strcmp(action, "accept"))
+		fprintf(f, "%s -A %s%s%s%s -j ACCEPT\n", ipt, ch, pre, schedfrag, ratefrag);
+	else if (!strcmp(action, "drop"))
+		fprintf(f, "%s -A %s%s%s%s -j DROP\n", ipt, ch, pre, schedfrag, ratefrag);
+	else if (!strcmp(action, "reject"))
+		fprintf(f, "%s -A %s%s%s%s -j REJECT --reject-with %s\n", ipt, ch, pre,
+		        schedfrag, ratefrag, v6 ? "icmp6-adm-prohibited" : "icmp-admin-prohibited");
+	/* action "log" emits the LOG line above and nothing else - it observes and
+	 * lets the packet continue. */
+
+	if (ratefrag[0]) fprintf(f, "fi\n");
+}
+
+/* Emit every iptables line for ONE user rule, in ONE family, into ONE chain.
+ *
+ * `want` is the chain currently being built. A rule belongs to exactly one
+ * chain (its direction), and the generator walks the three chains in turn - so
+ * without this filter every rule would be emitted once per pass: three copies
+ * in the chain it belongs to, and on the passes where its chain has not been
+ * created yet the command simply fails. Caught by dumping the generated script
+ * rather than by reading the code. */
+static void rfw_emit_rule(FILE *f, const rfw_cfg_t *c, const char *rec, int ridx,
+                          int v6, int want)
+{
+	char en[4], dir[8], action[12], szone[RFW_NAME_MAX + 2], sobj[RFW_NAME_MAX + 2];
+	char dzone[RFW_NAME_MAX + 2], dobj[RFW_NAME_MAX + 2], svc[RFW_NAME_MAX + 2];
+	char sched[96], rate[20], logf[4];
+	char schedfrag[160];
+	const char *ipt = v6 ? "ip6tables" : "iptables";
+	const char *ch;
+	rfw_setname_t ssets[RFW_MAX_SETS], dsets[RFW_MAX_SETS];
+	char sifs[RFW_MAX_IFACE][IFNAMSIZ + 2], difs[RFW_MAX_IFACE][IFNAMSIZ + 2];
+	int nss, nds, nsi, ndi, d, emitted = 0;
+	int si, di, sf, df, pv;
+	char proto[2][12]; int nproto = 1;
+	char ports[160] = "";
+
+	if (!rfw_field(rec,  0, en,     sizeof(en))     || strcmp(en, "1") != 0) return;
+	if (!rfw_field(rec,  1, dir,    sizeof(dir))    || !rfw_valid_dir(dir)) return;
+	d = (!strcmp(dir, "in")) ? RFW_D_IN : (!strcmp(dir, "out")) ? RFW_D_OUT : RFW_D_FWD;
+	if (d != want) return;                    /* not this chain's pass */
+	if (!rfw_field(rec,  2, action, sizeof(action)) || !rfw_valid_action(action)) return;
+	rfw_field(rec, 3, szone, sizeof(szone));
+	rfw_field(rec, 4, sobj,  sizeof(sobj));
+	rfw_field(rec, 5, dzone, sizeof(dzone));
+	rfw_field(rec, 6, dobj,  sizeof(dobj));
+	rfw_field(rec, 7, svc,   sizeof(svc));
+	rfw_field(rec, 8, sched, sizeof(sched));
+	rfw_field(rec, 9, rate,  sizeof(rate));
+	rfw_field(rec, 10, logf, sizeof(logf));
+
+	/* rule-level rejections are reported once, on the v4 pass, so a single bad
+	 * rule does not produce a pair of identical syslog lines */
+	if (!rfw_valid_sched(sched)) {
+		if (!v6) logmessage("reaper_fw", "rule %d: invalid schedule - rule DROPPED", ridx);
+		return;
+	}
+	if (!rfw_valid_rate(rate)) {
+		if (!v6) logmessage("reaper_fw", "rule %d: invalid rate - rule DROPPED", ridx);
+		return;
+	}
+	ch = rfw_chain_of(d);
+
+	/* a MAC match only exists on an ingress path and only as a source */
+	if (sobj[0] && rfw_ref_is_mac(c, sobj) && d == RFW_D_OUT) {
+		if (!v6) logmessage("reaper_fw", "rule %d: MAC source is not matchable on output - rule DROPPED", ridx);
+		return;
+	}
+	if (dobj[0] && rfw_ref_is_mac(c, dobj)) {
+		if (!v6) logmessage("reaper_fw", "rule %d: MAC object cannot be a destination - rule DROPPED", ridx);
+		return;
+	}
+	/* hash:mac sets carry no address family, so ipset creates ONE set and the v6
+	 * stack has no set of its own to match. Rather than emit a match against a
+	 * set that was never created - which fails at load and leaves the operator
+	 * believing the rule is active - the rule is IPv4-only and says so. */
+	if (v6 && sobj[0] && rfw_ref_is_mac(c, sobj)) {
+		logmessage("reaper_fw", "rule %d: MAC source matches IPv4 only - no IPv6 rule generated", ridx);
+		return;
+	}
+
+	/* address objects -> set lists. A named reference that resolves to nothing
+	 * in this family means the rule simply does not apply here (e.g. a v4-only
+	 * object in the v6 pass, or a geo country Warden is not managing). */
+	nss = sobj[0] ? rfw_resolve(c, sobj, v6, ssets, RFW_MAX_SETS) : 0;
+	nds = dobj[0] ? rfw_resolve(c, dobj, v6, dsets, RFW_MAX_SETS) : 0;
+	if (sobj[0] && nss == 0) return;
+	if (dobj[0] && nds == 0) return;
+
+	nsi = rfw_zone_ifaces(c, szone, sifs, RFW_MAX_IFACE);
+	ndi = rfw_zone_ifaces(c, dzone, difs, RFW_MAX_IFACE);
+	if (szone[0] && nsi == 0) return;
+	if (dzone[0] && ndi == 0) return;
+	/* -i is meaningless in OUTPUT and -o is meaningless in INPUT */
+	if (d == RFW_D_OUT) nsi = 0;
+	if (d == RFW_D_IN)  ndi = 0;
+
+	/* service -> protocol(s) + ports */
+	proto[0][0] = 0;
+	if (svc[0]) {
+		char srec[512], sp[12], spo[160];
+		if (!rfw_find(c->svc, svc, srec, sizeof(srec))) {
+			logmessage("reaper_fw", "rule %d: unknown service '%s' - rule DROPPED", ridx, svc);
+			return;
+		}
+		if (!rfw_field(srec, 1, sp, sizeof(sp)) || !rfw_valid_proto(sp)) return;
+		if (!rfw_field(srec, 2, spo, sizeof(spo)) || !rfw_valid_ports(spo)) return;
+		if (rfw_count_ports(spo) > RFW_MAX_PORTS) {
+			logmessage("reaper_fw", "rule %d: service '%s' exceeds %d port entries - rule DROPPED",
+			           ridx, svc, RFW_MAX_PORTS);
+			return;
+		}
+		strlcpy(ports, spo, sizeof(ports));
+		if (!strcmp(sp, "both")) {
+			strlcpy(proto[0], "tcp", sizeof(proto[0]));
+			strlcpy(proto[1], "udp", sizeof(proto[1]));
+			nproto = 2;
+		} else if (!strcmp(sp, "icmp")) {
+			strlcpy(proto[0], v6 ? "ipv6-icmp" : "icmp", sizeof(proto[0]));
+			ports[0] = 0;                        /* icmp has no ports */
+		} else {
+			strlcpy(proto[0], sp, sizeof(proto[0]));
+		}
+	}
+
+	rfw_sched_frag(sched, schedfrag, sizeof(schedfrag));
+
+	for (si = 0; si < (nsi ? nsi : 1); si++)
+	for (di = 0; di < (ndi ? ndi : 1); di++)
+	for (sf = 0; sf < (nss ? nss : 1); sf++)
+	for (df = 0; df < (nds ? nds : 1); df++)
+	for (pv = 0; pv < nproto; pv++) {
+		char pre[768];
+		int n = 0;
+		if (++emitted > RFW_MAX_PER_RULE) {
+			logmessage("reaper_fw", "rule %d expands past %d lines - remainder DROPPED",
+			           ridx, RFW_MAX_PER_RULE);
+			return;
+		}
+		pre[0] = 0;
+		if (nsi) n += snprintf(pre + n, sizeof(pre) - n, " -i %s", sifs[si]);
+		if (ndi) n += snprintf(pre + n, sizeof(pre) - n, " -o %s", difs[di]);
+		if (nss) n += snprintf(pre + n, sizeof(pre) - n, " -m set --match-set %s src", ssets[sf].name);
+		if (nds) n += snprintf(pre + n, sizeof(pre) - n, " -m set --match-set %s dst", dsets[df].name);
+		if (proto[0][0]) {
+			n += snprintf(pre + n, sizeof(pre) - n, " -p %s", proto[pv]);
+			if (ports[0])
+				n += snprintf(pre + n, sizeof(pre) - n, " -m multiport --dports %s", ports);
+		}
+		if (n < 0 || n >= (int)sizeof(pre)) {
+			logmessage("reaper_fw", "rule %d: match too long - rule DROPPED", ridx);
+			return;
+		}
+		rfw_emit_line(f, ipt, ch, pre, schedfrag, rate, action,
+		              (logf[0] == '1'), ridx, v6);
+	}
+}
+
+/* the zone default-policy matrix, appended AFTER the user rules so an explicit
+ * rule always wins over a zone default. */
+static void rfw_emit_zpol(FILE *f, const rfw_cfg_t *c, int v6)
+{
+	const char *ipt = v6 ? "ip6tables" : "iptables";
+	char *dup, *tok, *save = NULL;
+	int n = 0;
+	if (!c->zpol || !*c->zpol) return;
+	if (!(dup = strdup(c->zpol))) return;
+	for (tok = strtok_r(dup, "<", &save); tok; tok = strtok_r(NULL, "<", &save)) {
+		char sz[RFW_NAME_MAX + 2], dz[RFW_NAME_MAX + 2], act[12];
+		char sifs[RFW_MAX_IFACE][IFNAMSIZ + 2], difs[RFW_MAX_IFACE][IFNAMSIZ + 2];
+		int nsi, ndi, i, j;
+		if (++n > RFW_MAX_ZPOL) break;
+		if (!rfw_field(tok, 0, sz,  sizeof(sz))  ||
+		    !rfw_field(tok, 1, dz,  sizeof(dz))  ||
+		    !rfw_field(tok, 2, act, sizeof(act)) || !rfw_valid_zpol_action(act))
+			continue;
+		nsi = rfw_zone_ifaces(c, sz, sifs, RFW_MAX_IFACE);
+		ndi = rfw_zone_ifaces(c, dz, difs, RFW_MAX_IFACE);
+		if (!nsi || !ndi) continue;
+		for (i = 0; i < nsi; i++)
+			for (j = 0; j < ndi; j++) {
+				if (!strcmp(sifs[i], difs[j])) continue;   /* intra-zone stays open */
+				if (!strcmp(act, "reject"))
+					fprintf(f, "%s -A %s -i %s -o %s -j REJECT --reject-with %s\n",
+					        ipt, RFW_CHAIN_FWD, sifs[i], difs[j],
+					        v6 ? "icmp6-adm-prohibited" : "icmp-admin-prohibited");
+				else
+					fprintf(f, "%s -A %s -i %s -o %s -j %s\n", ipt, RFW_CHAIN_FWD,
+					        sifs[i], difs[j], !strcmp(act, "drop") ? "DROP" : "ACCEPT");
+			}
+	}
+	free(dup);
+}
+
+/* ---------------------------------------------------------------------------
+ * The generator.
+ * ------------------------------------------------------------------------- */
+
+typedef struct { long order; int idx; char *rec; } rfw_sorted_t;
+
+static int rfw_cmp(const void *a, const void *b)
+{
+	const rfw_sorted_t *x = a, *y = b;
+	if (x->order != y->order) return (x->order < y->order) ? -1 : 1;
+	return x->idx - y->idx;                       /* stable within equal order */
+}
+
+static void rfw_emit_rules(FILE *f, const rfw_cfg_t *c, int v6, int want)
+{
+	rfw_sorted_t *arr;
+	char *dup, *tok, *save = NULL;
+	int n = 0, i;
+
+	if (!c->rules || !*c->rules) return;
+	if (!(arr = calloc(RFW_MAX_RULES, sizeof(*arr)))) return;
+	if (!(dup = strdup(c->rules))) { free(arr); return; }
+	for (tok = strtok_r(dup, "<", &save); tok && n < RFW_MAX_RULES; tok = strtok_r(NULL, "<", &save)) {
+		char ord[16];
+		arr[n].rec   = tok;
+		arr[n].idx   = n;
+		arr[n].order = rfw_field(tok, 11, ord, sizeof(ord)) ? strtol(ord, NULL, 10) : 0;
+		n++;
+	}
+	if (n == RFW_MAX_RULES && !v6 && want == RFW_D_IN)
+		logmessage("reaper_fw", "rule list is longer than %d - the rest are IGNORED", RFW_MAX_RULES);
+	qsort(arr, n, sizeof(*arr), rfw_cmp);
+	for (i = 0; i < n; i++)
+		rfw_emit_rule(f, c, arr[i].rec, arr[i].idx + 1, v6, want);
+	free(dup);
+	free(arr);
+}
+
+/* write the complete, idempotent teardown+build script for `c` to `path`.
+ * teardown_only forces the disabled path without touching nvram, so stop() and
+ * a disabled-by-config apply share one code path. */
+static int rfw_gen_apply(const char *path, const rfw_cfg_t *c, int teardown_only)
+{
+	FILE *f = fopen(path, "w");
+	/* worst case is RFW_MAX_OBJ objects x 2 families x (prefix + name + space);
+	 * strlcat truncates rather than overflows, but a truncated keep-list would
+	 * make the sweep try to destroy a set that is actually in use, so size it
+	 * past the real maximum instead of relying on that. */
+	char keep[RFW_MAX_OBJ * 2 * (sizeof(RFW_SET6) + RFW_NAME_MAX + 2)];
+	int d;
+
+	if (!f) return 0;
+	keep[0] = 0;
+
+	fprintf(f,
+	  "#!/bin/sh\n"
+	  "# generated by reaper_fw - do not edit; idempotent (teardown then rebuild)\n"
+	  "LANIF=\"$(nvram get lan_ifname)\"\n"
+	  "LANIP=\"$(nvram get lan_ipaddr)\"\n"
+	  "LANMASK=\"$(nvram get lan_netmask)\"\n"
+	  /* S2: these run-time values are spliced into root iptables commands.
+	   * Reject anything outside the expected charset before use. */
+	  "case \"$LANIF\" in ''|*[!A-Za-z0-9._-]*) logger -t reaper_fw 'bad lan_ifname'; exit 1;; esac\n"
+	  "case \"$LANIP\" in ''|*[!0-9.]*) logger -t reaper_fw 'lan not ready - deferred'; exit 1;; esac\n"
+	  "case \"$LANMASK\" in\n"
+	  "  255.255.255.0) LANNET=\"${LANIP%%.*}.0/24\";;\n"
+	  "  255.255.0.0)   LANNET=\"$(echo \"$LANIP\" | cut -d. -f1-2).0.0/16\";;\n"
+	  "  255.0.0.0)     LANNET=\"$(echo \"$LANIP\" | cut -d. -f1).0.0.0/8\";;\n"
+	  "  *)             LANNET=\"${LANIP%%.*}.0/24\";;\n"
+	  "esac\n"
+	  /* the arming session's address, written by the CGI (S1/S3) */
+	  "ADM=\"\"; ADMV6=0\n"
+	  "[ -f " RFW_ADMIN " ] && ADM=\"$(cat " RFW_ADMIN " 2>/dev/null)\"\n"
+	  "case \"$ADM\" in *[!0-9a-fA-F.:]*) ADM=\"\";; esac\n"
+	  "case \"$ADM\" in *:*) ADMV6=1;; esac\n"
+	  "MGMT=\"$(nvram get https_lanport)\"\n"
+	  "[ \"$(nvram get http_enable)\" = \"0\" ] && MGMT=\"$(nvram get http_lanport)\"\n"
+	  "case \"$MGMT\" in ''|0|*[!0-9]*) MGMT=443;; esac\n"
+	  "SSHEN=\"$(nvram get sshd_enable)\"\n"
+	  "SSHP=\"$(nvram get sshd_port)\"\n"
+	  "case \"$SSHP\" in ''|0|*[!0-9]*) SSHP=22;; esac\n"
+	  "\n");
+
+	/* ---- teardown (S4: only our own chains, never the table) ---- */
+	fprintf(f,
+	  "for T in iptables ip6tables; do\n"
+	  "  for P in INPUT:" RFW_CHAIN_IN " FORWARD:" RFW_CHAIN_FWD " OUTPUT:" RFW_CHAIN_OUT "; do\n"
+	  "    H=\"${P%%%%:*}\"; C=\"${P##*:}\"\n"
+	  /* loop: a previous apply that raced could have left more than one jump */
+	  "    while $T -D \"$H\" -j \"$C\" 2>/dev/null; do :; done\n"
+	  "    $T -F \"$C\" 2>/dev/null\n"
+	  "    $T -X \"$C\" 2>/dev/null\n"
+	  "  done\n"
+	  "done\n");
+
+	if (teardown_only || !c->enable || strcmp(c->enable, "1") != 0) {
+		/* disabled: teardown only. Leaves the base firewall untouched (S4). */
+		fprintf(f, "fc flush 2>/dev/null\nexit 0\n");
+		fclose(f);
+		return 1;
+	}
+
+	/* ---- rate-limit capability probe ----
+	 * xt_hashlimit is the one match this engine wants that is built as a MODULE
+	 * on this kernel, and nothing else on the box loads it. Probe once; rules
+	 * that need it are skipped (not degraded) when it is unavailable. */
+	fprintf(f,
+	  "RFW_HL=0\n"
+	  "modprobe xt_hashlimit 2>/dev/null\n"
+	  "if iptables -N RFW_PROBE 2>/dev/null; then\n"
+	  "  iptables -A RFW_PROBE -m hashlimit --hashlimit-above 1/sec --hashlimit-mode srcip"
+	  " --hashlimit-name rfwprobe -j RETURN 2>/dev/null && RFW_HL=1\n"
+	  "  iptables -F RFW_PROBE 2>/dev/null; iptables -X RFW_PROBE 2>/dev/null\n"
+	  "fi\n"
+	  "[ \"$RFW_HL\" = 1 ] || logger -t reaper_fw 'xt_hashlimit unavailable - rate-limited rules SKIPPED'\n\n");
+
+	rfw_emit_sets(f, c, keep, sizeof(keep));
+	fprintf(f, "\n");
+
+	for (d = RFW_D_IN; d <= RFW_D_OUT; d++) {
+		int v6;
+		for (v6 = 0; v6 <= 1; v6++) {
+			const char *ipt = v6 ? "ip6tables" : "iptables";
+			const char *ch  = rfw_chain_of(d);
+			fprintf(f, "%s -N %s 2>/dev/null; %s -F %s\n", ipt, ch, ipt, ch);
+			rfw_emit_head(f, v6, d);
+			rfw_emit_rules(f, c, v6, d);
+			if (d == RFW_D_FWD) rfw_emit_zpol(f, c, v6);
+			/* No final default: the chain RETURNs and the base firewall still
+			 * gets its say. This engine ADDS policy, it does not replace the
+			 * stock one - a "default deny" is expressed with a zone policy. */
+			fprintf(f, "%s -I %s -j %s\n\n", ipt, rfw_hook_of(d), ch);
+		}
+	}
+
+	/* ---- sweep sets belonging to objects that no longer exist ----
+	 * after the chains are rebuilt, so nothing still in use is destroyed. */
+	fprintf(f,
+	  "RFW_KEEP=\"%s\"\n"
+	  "ipset list -n 2>/dev/null | while read S; do\n"
+	  "  case \"$S\" in " RFW_SET4 "*|" RFW_SET6 "*) ;; *) continue;; esac\n"
+	  "  case \" $RFW_KEEP \" in *\" $S \"*) continue;; esac\n"
+	  "  ipset destroy \"$S\" 2>/dev/null\n"
+	  "done\n", keep);
+
+	/* Offloaded flows bypass a freshly-hooked chain in the hardware
+	 * accelerator, so an existing conversation keeps flowing until it ages out.
+	 * Same flush Warden and Gatekeeper do; a no-op when acceleration is off. */
+	fprintf(f, "fc flush 2>/dev/null\n");
+	fclose(f);
+	return 1;
+}
+
+/* ---------------------------------------------------------------------------
+ * Commit-confirm.
+ *
+ * R1: rollback REGENERATES our chains from the last confirmed config. It never
+ *     snapshots or restores the shared table, which would clobber Gatekeeper,
+ *     Warden and SDN.
+ * R3: the deadline belongs to a durable cru watcher, not a detached sleep
+ *     child - the failure this exists for is "the operator lost their route",
+ *     which is exactly when a best-effort child is least trustworthy. The
+ *     watcher runs a PRE-GENERATED rollback script, so it needs neither httpd
+ *     nor rc alive to recover the box.
+ * R5/R6: the armed token is a directory, so mkdir/rmdir are the compare-and-set.
+ * ------------------------------------------------------------------------- */
+
+/* Record the address the protective head must never cut off. login_ip_str is
+ * set by httpd for the authenticated session, so it covers a LAN, VPN or
+ * remote-admin operator equally - unlike lan_ipaddr, which only ever describes
+ * the router itself. */
+static void rfw_write_admin(void)
+{
+	FILE *f;
+	mkdir(RFW_DIR, 0700);
+	if ((f = fopen(RFW_ADMIN, "w")) == NULL) return;
+	fputs(nvram_safe_get("login_ip_str"), f);
+	fclose(f);
+	chmod(RFW_ADMIN, 0600);
+}
+
+static int rfw_confirm_secs(void)
+{
+	int n = nvram_get_int("reaper_fw_confirm");
+	if (n < RFW_CONFIRM_MIN) n = (n <= 0) ? RFW_CONFIRM_DEF : RFW_CONFIRM_MIN;
+	if (n > RFW_CONFIRM_MAX) n = RFW_CONFIRM_MAX;
+	return n;
+}
+
+/* persist the CONFIRMED config as the rollback source. One file per key so a
+ * restore can use "$(cat file)" and never re-parse operator free text. */
+static void rfw_write_lastgood(void)
+{
+	int i;
+	mkdir(RFW_CACHE, 0700);
+	mkdir(RFW_LASTGOOD, 0700);
+	for (i = 0; i < RFW_NKEYS; i++) {
+		char p[128];
+		FILE *f;
+		snprintf(p, sizeof(p), "%s/%s", RFW_LASTGOOD, rfw_keys[i].file);
+		if ((f = fopen(p, "w")) == NULL) continue;
+		fputs(nvram_safe_get(rfw_keys[i].nv), f);
+		fclose(f);
+		chmod(p, 0600);
+	}
+}
+
+/* the pre-generated recovery script: restore the last confirmed config into
+ * nvram (RAM), rebuild the chains from it, and disarm. Runs from cron. */
+static void rfw_gen_rollback(void)
+{
+	FILE *f;
+	rfw_cfg_t good;
+	int i;
+
+	if (!rfw_cfg_load(&good, 1)) return;
+	rfw_gen_apply(RFW_ROLLBACK ".rules", &good, 0);
+	rfw_cfg_free(&good);
+
+	if ((f = fopen(RFW_ROLLBACK, "w")) == NULL) return;
+	fprintf(f,
+	  "#!/bin/sh\n"
+	  "# generated by reaper_fw - commit-confirm recovery. Restores the last\n"
+	  "# CONFIRMED ruleset and disarms. Safe to run at any time.\n");
+	for (i = 0; i < RFW_NKEYS; i++)
+		/* "$(cat f)" is expanded once and never re-parsed, so an operator
+		 * comment containing shell metacharacters cannot execute (S2). */
+		fprintf(f, "[ -f %s/%s ] && nvram set %s=\"$(cat %s/%s)\"\n",
+		        RFW_LASTGOOD, rfw_keys[i].file, rfw_keys[i].nv,
+		        RFW_LASTGOOD, rfw_keys[i].file);
+	fprintf(f,
+	  "sh " RFW_ROLLBACK ".rules 2>/dev/null || {\n"
+	  /* S3 last resort: if even the known-good ruleset will not build, remove
+	   * our jumps so the base firewall alone governs the box. Fail OPEN for our
+	   * layer, never leave a half-built chain in the path. */
+	  "  logger -t reaper_fw 'rollback rebuild FAILED - removing our jumps (fail-open)'\n"
+	  "  for T in iptables ip6tables; do\n"
+	  "    for P in INPUT:" RFW_CHAIN_IN " FORWARD:" RFW_CHAIN_FWD " OUTPUT:" RFW_CHAIN_OUT "; do\n"
+	  "      H=\"${P%%%%:*}\"; C=\"${P##*:}\"\n"
+	  "      while $T -D \"$H\" -j \"$C\" 2>/dev/null; do :; done\n"
+	  "    done\n"
+	  "  done\n"
+	  "}\n"
+	  "rm -f " RFW_DEADLINE "\n"
+	  "rmdir " RFW_ARMED " 2>/dev/null\n"
+	  "cru d reaper_fw_cc 2>/dev/null\n"
+	  "nvram set reaper_fw_armed=0\n"
+	  "logger -t reaper_fw 'commit-confirm: reverted to the last confirmed ruleset'\n");
+	fclose(f);
+	chmod(RFW_ROLLBACK, 0700);
+}
+
+/* the per-minute deadline watcher (R3). */
+static void rfw_gen_cc(void)
+{
+	FILE *f = fopen(RFW_CC, "w");
+	if (!f) return;
+	fprintf(f,
+	  "#!/bin/sh\n"
+	  "[ -d " RFW_ARMED " ] || exit 0\n"
+	  "D=\"$(cat " RFW_DEADLINE " 2>/dev/null)\"\n"
+	  "case \"$D\" in ''|*[!0-9]*) exit 0;; esac\n"
+	  "N=\"$(date +%%s)\"\n"
+	  "[ \"$N\" -lt \"$D\" ] && exit 0\n"
+	  "sh " RFW_ROLLBACK "\n");
+	fclose(f);
+	chmod(RFW_CC, 0700);
+}
+
+/* S1/S3 preflight. The protective head already keeps the arming operator
+ * reachable, but that head can only be emitted if we KNOW their address. If we
+ * do not, a restrictive ruleset has no anti-lockout anchor at all - so refuse
+ * to arm one rather than rely on the timer alone. Returns 1 = safe to arm. */
+static int rfw_preflight(const rfw_cfg_t *c, char *why, size_t wl)
+{
+	char *dup, *tok, *save = NULL;
+	int restrictive = 0;
+
+	if (c->rules && *c->rules && (dup = strdup(c->rules)) != NULL) {
+		for (tok = strtok_r(dup, "<", &save); tok; tok = strtok_r(NULL, "<", &save)) {
+			char en[4], act[12];
+			if (!rfw_field(tok, 0, en, sizeof(en)) || strcmp(en, "1")) continue;
+			if (!rfw_field(tok, 2, act, sizeof(act))) continue;
+			if (!strcmp(act, "drop") || !strcmp(act, "reject")) { restrictive = 1; break; }
+		}
+		free(dup);
+	}
+	if (!restrictive && c->zpol && *c->zpol) {
+		if (strstr(c->zpol, ">drop") || strstr(c->zpol, ">reject")) restrictive = 1;
+	}
+	if (!restrictive) return 1;
+
+	if (!nvram_safe_get("login_ip_str")[0]) {
+		strlcpy(why, "no administrative session address is known, so no anti-lockout "
+		             "exemption can be generated for a restrictive ruleset", wl);
+		return 0;
+	}
+	return 1;
+}
+
+/* ---------------------------------------------------------------------------
+ * Entry points.
+ * ------------------------------------------------------------------------- */
+
+void stop_reaper_fw(void)
+{
+	rfw_cfg_t c;
+	int lock;
+	eval("cru", "d", "reaper_fw_cc");
+	eval("cru", "d", "reaper_fw_dns");
+	/* generate a teardown-only script from the current config and run it, so
+	 * the chain and set names come from exactly one place (S4). Takes the same
+	 * lock as apply (S6) - a teardown interleaved with a concurrent
+	 * start_firewall() rebuild is exactly as damaging as an interleaved build. */
+	if (rfw_cfg_load(&c, 0)) {
+		lock = file_lock("firewall");
+		if (rfw_gen_apply(RFW_APPLY, &c, 1)) {
+			chmod(RFW_APPLY, 0700);
+			system("sh " RFW_APPLY " 2>/dev/null");
+		}
+		file_unlock(lock);
+		rfw_cfg_free(&c);
+	}
+	unlink(RFW_APPLY);
+	unlink(RFW_CAND);
+	unlink(RFW_CC);
+	unlink(RFW_RESOLVE);
+	rmdir(RFW_ARMED);
+	unlink(RFW_DEADLINE);
+	nvram_set("reaper_fw_armed", "0");
+}
+
+/* Apply the COMMITTED ruleset. Boot, restart_firewall re-hook, and the enable
+ * toggle all land here. No arm: what is in flash has already been confirmed. */
+void start_reaper_fw(void)
+{
+	rfw_cfg_t c;
+	int lock;
+
+	if (!is_routing_enabled()) return;
+	if (!nvram_match("reaper_fw_enable", "1")) {
+		if (f_exists(RFW_APPLY) || nvram_match("reaper_fw_armed", "1"))
+			stop_reaper_fw();
+		return;
+	}
+	if (!rfw_cfg_load(&c, 0)) return;
+
+	mkdir(RFW_DIR, 0700);
+	/* S1: /tmp is a tmpfs, so the admin anchor written at arm time does not
+	 * survive a reboot - and commit-confirm does NOT cover the boot path, since
+	 * what boots is a ruleset that was already confirmed. Re-seed the anchor
+	 * from nvram so the protective head still names the operator on every cold
+	 * start; without this a confirmed-but-restrictive ruleset comes back after a
+	 * power cut with no exemption and no timer to undo it. */
+	rfw_write_admin();
+	lock = file_lock("firewall");                       /* S6 */
+	if (rfw_gen_apply(RFW_APPLY, &c, 0)) {
+		chmod(RFW_APPLY, 0700);
+		if (system("sh " RFW_APPLY) != 0)
+			logmessage("reaper_fw", "LAN not ready at boot - rules deferred, re-arm on the firewall hook");
+	}
+	file_unlock(lock);
+	rfw_gen_resolve(&c);
+	rfw_cfg_free(&c);
+}
+
+/* Apply the DRAFT (already in nvram RAM, not committed) and arm the revert. */
+void reaper_fw_apply(void)
+{
+	rfw_cfg_t c;
+	char why[192] = "";
+	int lock, secs;
+	FILE *f;
+
+	if (!rfw_cfg_load(&c, 0)) return;
+	if (!rfw_preflight(&c, why, sizeof(why))) {
+		logmessage("reaper_fw", "apply REFUSED: %s", why);
+		nvram_set("reaper_fw_err", why);
+		rfw_cfg_free(&c);
+		return;
+	}
+	mkdir(RFW_CACHE, 0700);
+	mkdir(RFW_DIR, 0700);
+
+	/* R5: single-arm compare-and-set. A second apply while one is pending is
+	 * refused rather than silently replacing the pending deadline. */
+	if (mkdir(RFW_ARMED, 0700) != 0) {
+		logmessage("reaper_fw", "apply REFUSED: a change is already awaiting confirmation");
+		nvram_set("reaper_fw_err", "a change is already awaiting confirmation");
+		rfw_cfg_free(&c);
+		return;
+	}
+	nvram_unset("reaper_fw_err");
+
+	/* record the operator we must not lock out, for the S1 head */
+	rfw_write_admin();
+
+	/* the recovery path is generated and on disk BEFORE the candidate is
+	 * applied - if the candidate is what breaks the box, nothing needs to be
+	 * generated afterwards. */
+	rfw_gen_rollback();
+	rfw_gen_cc();
+
+	secs = rfw_confirm_secs();
+	if ((f = fopen(RFW_DEADLINE, "w")) != NULL) {
+		fprintf(f, "%ld", (long)time(NULL) + secs);
+		fclose(f);
+	}
+	eval("cru", "a", "reaper_fw_cc", "* * * * * sh " RFW_CC);
+
+	lock = file_lock("firewall");
+	if (rfw_gen_apply(RFW_CAND, &c, 0)) {
+		chmod(RFW_CAND, 0700);
+		if (system("sh " RFW_CAND) != 0) {
+			file_unlock(lock);
+			logmessage("reaper_fw", "candidate ruleset FAILED to build - rolling back now");
+			system("sh " RFW_ROLLBACK " 2>/dev/null");
+			rfw_cfg_free(&c);
+			return;
+		}
+	}
+	file_unlock(lock);
+	rfw_gen_resolve(&c);
+	nvram_set("reaper_fw_armed", "1");
+	logmessage("reaper_fw", "ruleset applied - reverting in %ds unless confirmed", secs);
+	rfw_cfg_free(&c);
+}
+
+/* Operator confirmed: keep it. This is the ONLY path that writes flash. */
+void reaper_fw_confirm(void)
+{
+	/* R6: test-and-clear. If nothing was armed this is a no-op, not a commit -
+	 * a stray confirm must never persist a ruleset nobody applied. */
+	if (rmdir(RFW_ARMED) != 0) {
+		logmessage("reaper_fw", "confirm ignored - nothing is awaiting confirmation");
+		return;
+	}
+	eval("cru", "d", "reaper_fw_cc");
+	unlink(RFW_DEADLINE);
+	nvram_commit();
+	rfw_write_lastgood();
+	/* the confirmed candidate becomes the boot-time ruleset */
+	rename(RFW_CAND, RFW_APPLY);
+	nvram_set("reaper_fw_armed", "0");
+	logmessage("reaper_fw", "ruleset confirmed and saved");
+}
+
+/* Operator declined, or the deadline passed while rc was alive. */
+void reaper_fw_rollback(void)
+{
+	if (!f_exists(RFW_ROLLBACK)) {
+		logmessage("reaper_fw", "rollback requested but no recovery script exists");
+		return;
+	}
+	system("sh " RFW_ROLLBACK " 2>/dev/null");
+}
+
+/* Compile the draft and write the exact commands it WOULD run, without running
+ * any of them. This is what the page's "preview" shows, and it is deliberately
+ * the same generator the real apply uses - a preview produced by a second
+ * implementation would eventually disagree with reality, which is worse than
+ * no preview at all. The marker file is removed first so the reader can tell
+ * "not generated yet" from "generated and empty". */
+void reaper_fw_dryrun(void)
+{
+	rfw_cfg_t c;
+	unlink(RFW_PREVIEW);
+	if (!rfw_cfg_load(&c, 0)) return;
+	mkdir(RFW_DIR, 0700);
+	if (rfw_gen_apply(RFW_PREVIEW, &c, 0))
+		chmod(RFW_PREVIEW, 0600);           /* readable, deliberately NOT executable */
+	rfw_cfg_free(&c);
+}
