+/* find the record in `list` whose field 0 equals `name`. */
+static int rfw_find(const char *list, const char *name, char *out, size_t ol)
+{
+	char *dup, *tok, *save = NULL;
+	int found = 0;
+	if (!list || !*list || !name || !*name) return 0;
+	if (!(dup = strdup(list))) return 0;
+	for (tok = strtok_r(dup, "<", &save); tok; tok = strtok_r(NULL, "<", &save)) {
+		char f0[RFW_NAME_MAX + 2];
+		if (!rfw_field(tok, 0, f0, sizeof(f0))) continue;
+		if (strcmp(f0, name) != 0) continue;
+		if (strlen(tok) < ol) { strlcpy(out, tok, ol); found = 1; }
+		break;
