+	c->confirm = strdup(nvram_safe_get("reaper_fw_confirm"));
+	if (!c->enable || !c->confirm) { rfw_cfg_free(c); return 0; }
+	for (i = 0; i < RFW_NKEYS; i++) {
+		char **slot = (char **)((char *)c + rfw_keys[i].off);
+		if (from_lastgood) {
