+/* ---------------------------------------------------------------------------
+ * S1 PROTECTIVE HEAD. Emitted at the top of every owned chain, in every family,
+ * BEFORE any user rule. Nothing a user can express is able to precede these.
+ * ------------------------------------------------------------------------- */
+
+/* RFC 4890 "must not be dropped" set for a router, plus MLD. Without this a
+ * single user DROP on the v6 side kills Neighbour Discovery, Router
+ * Advertisement and Path-MTU discovery for the whole LAN - and it does so
+ * WITHOUT tripping commit-confirm, because the operator's own IPv4 session
+ * stays up and they confirm a ruleset that has quietly broken IPv6.
+ *   1,2,3,4       destination-unreachable / packet-too-big (PMTUD) /
+ *                 time-exceeded / parameter-problem
+ *   133..137      router+neighbour solicit/advert, redirect (ND)
+ *   130,131,132,143 MLD query/report/done/v2-report
+ * Echo (128/129) is deliberately NOT exempt, so "block IPv6 ping" stays a
+ * rule the operator can actually write. */
+static const int rfw_icmp6_keep[] = { 1, 2, 3, 4, 130, 131, 132, 133, 134, 135, 136, 137, 143 };
+
+#define RFW_D_IN   0
+#define RFW_D_FWD  1
+#define RFW_D_OUT  2
+
+static const char *rfw_chain_of(int dir)
+{
+	return (dir == RFW_D_IN) ? RFW_CHAIN_IN : (dir == RFW_D_OUT) ? RFW_CHAIN_OUT : RFW_CHAIN_FWD;
+}
+static const char *rfw_hook_of(int dir)
+{
+	return (dir == RFW_D_IN) ? "INPUT" : (dir == RFW_D_OUT) ? "OUTPUT" : "FORWARD";
+}
+
+static void rfw_emit_head(FILE *f, int v6, int dir)
+{
+	const char *ipt = v6 ? "ip6tables" : "iptables";
+	const char *ch  = rfw_chain_of(dir);
