+		 * emit when Warden is actually managing that country, else the match
+		 * would point at a set that does not exist and the whole restore fails. */
+		char cc[3], *hay;
+		if (!rfw_valid_cc(val)) return 0;
+		if (!nvram_match("rwarden_enable", "1")) return 0;
+		cc[0] = tolower((int)val[0]); cc[1] = tolower((int)val[1]); cc[2] = 0;
+		hay = strdup(nvram_safe_get("rwarden_geo"));
+		if (!hay) return 0;
+		{
+			char *tok, *save = NULL; int have = 0;
+			for (tok = strtok_r(hay, " ,<>", &save); tok; tok = strtok_r(NULL, " ,<>", &save)) {
+				if (strlen(tok) == 2 && tolower((int)tok[0]) == cc[0] &&
+				    tolower((int)tok[1]) == cc[1]) { have = 1; break; }
+			}
+			free(hay);
+			if (!have) return 0;
+		}
+		snprintf(out, ol, "rw_g%s_%s", v6 ? "6" : "", cc);
+		return 1;
+	}
+	/* a MAC set only has meaning on the source side of an ingress path; the
+	 * emitter enforces that. Here it is just our own set. */
+	snprintf(out, ol, "%s%s", v6 ? RFW_SET6 : RFW_SET4, name);
+	return 1;
+}
