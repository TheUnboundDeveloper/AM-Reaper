+static const struct { const char *nv; const char *file; size_t off; } rfw_keys[] = {
+	{ "reaper_fw_obj",   "obj",   offsetof(rfw_cfg_t, obj)   },
+	{ "reaper_fw_grp",   "grp",   offsetof(rfw_cfg_t, grp)   },
+	{ "reaper_fw_svc",   "svc",   offsetof(rfw_cfg_t, svc)   },
+	{ "reaper_fw_zone",  "zone",  offsetof(rfw_cfg_t, zone)  },
+	{ "reaper_fw_zpol",  "zpol",  offsetof(rfw_cfg_t, zpol)  },
+	{ "reaper_fw_rules", "rules", offsetof(rfw_cfg_t, rules) },
+};
