+       set - the engine refuses to emit a match against a set it did not create */
+    if(t==='geo'){
+      var cc=v.toLowerCase();
+      if(!/^[a-z]{2}$/.test(cc))return bad(`<#RFW_67#>`);
+      if(!RFW.warden||RFW.wgeo.toLowerCase().split(/[ ,<>]+/).indexOf(cc)<0){
+        $('ob_geowarn').classList.remove('hidden');return;
+      }
+      $('ob_geowarn').classList.add('hidden');
+    }
+    RFW.obj.push([n,t,v,c.replace(/[<>]/g,'')]);
+    $('ob_name').value='';$('ob_val').value='';$('ob_cmt').value='';
+    rfwRenderObj();rfwFillSelects();rfwSave('obj',RFW.obj,S);
+  };
+  $('gr_add').onclick=function(){
+    var n=$('gr_name').value.trim(),m=$('gr_mem').value.replace(/\s/g,''),c=$('gr_cmt').value.trim();
+    if(!rfwName(n))return bad(`<#RFW_157#>`);
+    if(!m)return bad(`<#RFW_66#>`);
+    var members=m.split(','),known=RFW.obj.map(function(r){return r[0];}),i;
+    for(i=0;i<members.length;i++)if(known.indexOf(members[i])<0)return bad(`<#RFW_67#>`);
+    if(RFW.grp.some(function(r){return r[0]===n;})||RFW.obj.some(function(r){return r[0]===n;}))return bad(`<#RFW_65#>`);
+    RFW.grp.push([n,m,c.replace(/[<>]/g,'')]);
+    $('gr_name').value='';$('gr_mem').value='';$('gr_cmt').value='';
+    rfwRenderGrp();rfwFillSelects();rfwSave('grp',RFW.grp,S);
+  };
+  $('sv_add').onclick=function(){
+    var n=$('sv_name').value.trim(),p=$('sv_proto').value,
+        po=(p==='icmp')?'':normPort($('sv_ports').value),c=$('sv_cmt').value.trim();
+    if(!rfwName(n))return bad(`<#RFW_157#>`);
+    if(po===null)return bad(`<#RFW_67#>`);
+    if(RFW.svc.some(function(r){return r[0]===n;}))return bad(`<#RFW_65#>`);
+    RFW.svc.push([n,p,po,c.replace(/[<>]/g,'')]);
+    $('sv_name').value='';$('sv_ports').value='';$('sv_cmt').value='';
+    rfwRenderSvc();rfwFillSelects();rfwSave('svc',RFW.svc,S);
+  };
+  $('zn_add').onclick=function(){
+    var n=$('zn_name').value.trim(),f=$('zn_if').value.replace(/\s/g,''),c=$('zn_cmt').value.trim();
+    if(!rfwName(n))return bad(`<#RFW_157#>`);
+    if(!f)return bad(`<#RFW_66#>`);
+    if(!/^[A-Za-z0-9._+,]+$/.test(f))return bad(`<#RFW_67#>`);
+    if(RFW.zone.some(function(r){return r[0]===n;}))return bad(`<#RFW_65#>`);
+    RFW.zone.push([n,f,c.replace(/[<>]/g,'')]);
+    $('zn_name').value='';$('zn_if').value='';$('zn_cmt').value='';
+    rfwRenderZone();rfwFillSelects();rfwSave('zone',RFW.zone,S);
+  };
+  $('zp_add').onclick=function(){
+    var s=$('zp_src').value,d=$('zp_dst').value,a=$('zp_act').value;
+    if(!s||!d)return bad(`<#RFW_66#>`);
+    if(RFW.zpol.some(function(r){return r[0]===s&&r[1]===d;}))return bad(`<#RFW_65#>`);
+    RFW.zpol.push([s,d,a]);
+    rfwRenderZpol();rfwSave('zpol',RFW.zpol,S);
+  };
+  $('rf_add').onclick=function(){
+    var r=['1',$('rf_dir').value,$('rf_act').value,
+           $('rf_szone').value,$('rf_sobj').value,
+           $('rf_dzone').value,$('rf_dobj').value,
+           $('rf_svc').value,$('rf_sched').value.replace(/\s/g,''),
+           $('rf_rate').value.replace(/\s/g,''),$('rf_log').value,'0',''];
+    if(r[8]&&!/^([A-Za-z]{3}(,[A-Za-z]{3})*)?\|\d{2}:\d{2}\|\d{2}:\d{2}$/.test(r[8]))return bad(`<#RFW_67#>`);
+    if(r[9]&&!/^\d+\/(sec|min|hour)$/.test(r[9]))return bad(`<#RFW_67#>`);
+    RFW.rules.push(r);
+    $('rf_sched').value='';$('rf_rate').value='';
+    rfwReorder();
+  };
+
+  $('rf_en').onclick=function(){
+    $('rf_en').classList.toggle('on');
+    fwcgi('action=opts&enable='+tgGet($('rf_en')),function(){});
+  };
+  $('rf_confirm').onchange=function(){
+    fwcgi('action=opts&confirm='+encodeURIComponent($('rf_confirm').value),function(j){
+      if(j&&j.ok)$('rf_confirm').value=j.confirm;
+    });
+  };
+
+  /* preview compiles the draft with the SAME generator the apply uses, then
+     reads the result back - a second implementation would eventually lie */
+  $('rf_preview').onclick=function(){
+    var pre=$('rf_prev');
+    pre.classList.remove('hidden');pre.textContent='...';
+    fwcgi('action=dryrun',function(){
+      var tries=0;
+      (function poll(){
+        fwcgi('action=preview',function(j){
+          if(j&&j.ok){pre.textContent=j.text||'';return;}
+          if(++tries<10){setTimeout(poll,600);return;}
+          pre.textContent='';showSaved(S,false,`<#RFW_155#>`);
+        });
+      })();
+    });
+  };
+  $('rf_apply').onclick=function(){
+    fwcgi('action=apply',function(){
+      showSaved(S,true,`<#RFW_154#>`);
+      setTimeout(function(){rfwLoad();},1500);
+    });
+  };
+  $('rf_keep').onclick=function(){
+    fwcgi('action=confirm',function(){setTimeout(function(){rfwLoad();},800);});
+  };
+  $('rf_revert').onclick=function(){
+    fwcgi('action=rollback',function(){setTimeout(function(){rfwLoad();},1500);});
+  };
+}
 
