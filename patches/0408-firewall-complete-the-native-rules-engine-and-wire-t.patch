diff --git a/release/src/router/rc/firewall.c b/release/src/router/rc/firewall.c
index aeba0a9cbf..54ff5bef8b 100644
--- a/release/src/router/rc/firewall.c
+++ b/release/src/router/rc/firewall.c
@@ -9405,6 +9405,19 @@ leave:
 	if (nvram_match("rwarden_enable", "1") && f_exists("/tmp/rwarden/apply.sh"))
 		system("sh /tmp/rwarden/apply.sh");
 
+	/* reaper v2.3.8 native firewall: the rules engine owns REAPER_FWI/FWF/FWO,
+	 * which this rebuild just unhooked. Re-run the generated script. If a change
+	 * is currently awaiting confirmation the ARMED candidate is the live one, so
+	 * re-apply that instead - otherwise a restart_firewall in the middle of a
+	 * commit-confirm window would silently reinstate the older ruleset while the
+	 * operator is still looking at the countdown for the new one. */
+	if (nvram_match("reaper_fw_enable", "1")) {
+		if (nvram_match("reaper_fw_armed", "1") && f_exists("/tmp/reaper_fw/candidate.sh"))
+			system("sh /tmp/reaper_fw/candidate.sh");
+		else if (f_exists("/tmp/reaper_fw/apply.sh"))
+			system("sh /tmp/reaper_fw/apply.sh");
+	}
+
 	return 0;
 }
 
