+static char *rfw_slurp(const char *path)
+{
+	FILE *f = fopen(path, "r");
+	long n;
+	char *b;
+	if (!f) return NULL;
+	if (fseek(f, 0, SEEK_END) != 0) { fclose(f); return NULL; }
+	n = ftell(f);
+	if (n < 0 || n > 65536) { fclose(f); return NULL; }
+	rewind(f);
+	if (!(b = malloc((size_t)n + 1))) { fclose(f); return NULL; }
+	if (fread(b, 1, (size_t)n, f) != (size_t)n) { free(b); fclose(f); return NULL; }
+	b[n] = 0;
+	while (n > 0 && (b[n - 1] == '\n' || b[n - 1] == '\r')) b[--n] = 0;
+	fclose(f);
+	return b;
+}
