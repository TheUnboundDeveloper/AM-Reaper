From ac485cfd4a561b8bdcffa0cc504f8251f38d4ae2 Mon Sep 17 00:00:00 2001
From: reaper <theunbounddeveloper@outlook.com>
Date: Thu, 13 Aug 2026 13:49:49 -0400
Subject: [PATCH] upnp: advertise IGD:1 in the device description again; theme
 the first-run Wi-Fi page

Two field reports from an RT-BE88U on v2.3.7_noMCP.

1. UPnP prevented a PS5 from connecting to Call of Duty, with IPv6 pinhole
   support either on or off.

   bdb0dd2024 added --igd2 to the DEFAULT miniupnpd build line, and that line is
   not inside the ifeq ($(RTCONFIG_IGD2),y) guard, so every build now defines
   IGD_V2 and upnpurns.h advertises InternetGatewayDevice:2 / WANConnectionDevice:2
   / WANIPConnection:2. That commit argued backward compatibility from minissdp.c,
   which is true for SSDP DISCOVERY - a non-strict M-SEARCH still gets an IGD:1 ST -
   but not for the DEVICE DESCRIPTION the client fetches immediately afterwards.
   upnphttp.c builds the IGD:1 description only when

       GETFLAG(FORCEIGDDESCV1MASK) || (h->respflags & FLAG_MS_CLIENT)

   i.e. upstream already force-downgrades the description for Microsoft clients,
   precisely because IGD:2 descriptions break real ones. A PS5 is not an MS client,
   so it was served WANIPConnection:2 only, matched no service type it knows, got
   no control URL, and could not create a mapping at all. Before v2.3.5 the plain
   daemon had no IGD_V2, so this path served IGD:1 to everyone and worked - and
   because both daemons are --igd2 now, the pinhole toggle no longer changes it,
   which is exactly what the report describes.

   New nvram upnp_igd2_desc (default 0) emits force_igd_desc_v1=yes into
   /etc/upnp/config. Description-only: the daemon still implements the IGD:2
   actions, so the sole cost is that clients are no longer offered
   AddAnyPortMapping / GetListOfPortMappings. Set it to 1 to advertise IGD:2.
   Emitted unguarded, because the --igd2 configure flag is unconditional and
   keying this off RTCONFIG_IGD2 would miss exactly the builds that need it; an
   option an IGD:1 binary does not know is non-fatal there (it logs "Unknown
   option in file" and does not return 1).

2. The setup wizard dropped to an unthemed stock wireless page.

   state.js gate 3 force-redirects the top window of a factory-clean box to
   Advanced_Wireless_Content.asp?firstboot=1, so that page cannot take the bounce:
   rewriting it into reaper_shell.asp re-fires the gate from inside the shell,
   which is the v1.6.6b dashboard<->firstboot loop. It was parked in reaper_skip[]
   for that reason - but skip means neither the bounce NOR the reaper_content.css
   <link>, so one step after the Reaper-themed credential gate the user got a fully
   stock page.

   Adds a third injection mode: CSS <link>, no bounce (reaper_css_only[], mode 3).
   Themed, still top-level, loop still fixed.

Co-Authored-By: Claude Opus 5 (1M context) <noreply@anthropic.com>
---
 release/src/router/httpd/reaper_inject.c | 53 +++++++++++++++++++-----
 release/src/router/rc/services.c         | 30 ++++++++++++++
 release/src/router/shared/defaults.c     | 11 +++++
 3 files changed, 84 insertions(+), 10 deletions(-)

diff --git a/release/src/router/httpd/reaper_inject.c b/release/src/router/httpd/reaper_inject.c
index b3ed6afda0..7587355d4f 100644
--- a/release/src/router/httpd/reaper_inject.c
+++ b/release/src/router/httpd/reaper_inject.c
@@ -106,6 +106,8 @@
 static const char REAPER_BLOCK[] = REAPER_CSS_LINK REAPER_BOUNCE_JS;
 /* reaper-native pages: bounce only, no reaper_content.css <link> (see reaper_native[]) */
 static const char REAPER_NATIVE_BLOCK[] = REAPER_BOUNCE_JS;
+/* first-run gate pages: reaper_content.css <link> only, NO bounce (see reaper_css_only[]) */
+static const char REAPER_CSSONLY_BLOCK[] = REAPER_CSS_LINK;
 
 #define REAPER_TAG	"</head>"
 #define REAPER_TAGLEN	7		/* strlen("</head>") */
@@ -139,13 +141,9 @@ static const char *reaper_skip[] = {
 	   QIS_* pages are also matched by the prefix check in reaper_should_inject().) */
 	"Main_Password.asp",
 	"QIS_wizard.htm",
-	/* state.js gate 3 (v1.6.6b fix): on a factory-clean box with sdn_rl still at
-	   default, state.js force-redirects TOP to Advanced_Wireless_Content.asp?firstboot=1
-	   for the first-run Wi-Fi setup. Without this skip entry the bounce rewrote it into
-	   reaper_shell.asp, whose state.js re-fired the same gate -> dashboard<->firstboot
-	   loop (no settings page reachable on a fresh flash). Keep it TOP-LEVEL so the
-	   first-run Wi-Fi page loads once; after setup sdn_rl != default and it never fires. */
-	"Advanced_Wireless_Content.asp",
+	/* NOTE: Advanced_Wireless_Content.asp (state.js gate 3) moved to
+	   reaper_css_only[] on 2026-08-13 - it must still stay TOP-LEVEL, but a full
+	   skip also cost it the theme. See the comment there. */
 	/* Reaper first-boot credential gate: reaper-native page with its own chrome,
 	   forced top-level by state.js on a factory-clean box (see Reaper_FirstBoot.asp). */
 	"Reaper_FirstBoot.asp",
@@ -196,6 +194,27 @@ static const char *reaper_native[] = {
 	NULL
 };
 
+/*
+ * Stock pages that must stay TOP-LEVEL (no bounce) but SHOULD still be themed.
+ *
+ * reaper 2026-08-13 field fix ("the setup wizard defaults to the stock wireless
+ * page"). state.js gate 3 force-redirects the top window of a factory-clean box
+ * (sdn_rl still at default) to Advanced_Wireless_Content.asp?firstboot=1 for the
+ * first-run Wi-Fi step. It cannot take the bounce: rewriting it into
+ * reaper_shell.asp re-fires the same gate from inside the shell, which is the
+ * v1.6.6b dashboard<->firstboot loop that leaves a fresh flash with no reachable
+ * settings page. It was therefore in reaper_skip[] - but skip means NEITHER the
+ * bounce NOR the reaper_content.css <link>, so the wizard handed the user a fully
+ * stock-looking page one step after the Reaper-themed credential gate.
+ *
+ * These pages get the CSS <link> and nothing else: themed, still top-level, loop
+ * still fixed. Matched on basename, case-insensitive.
+ */
+static const char *reaper_css_only[] = {
+	"Advanced_Wireless_Content.asp",
+	NULL
+};
+
 /* True when the (query-stripped) basename ends in .asp/.htm/.html. CGI
  * endpoints also answer as text/html but emit tiny redirect stubs
  * (login.cgi/login_v2.cgi meta-refresh, QIS_default.cgi, page_default.cgi);
@@ -267,6 +286,12 @@ static int reaper_should_inject(struct mime_handler *h, const char *file)
 		if (strcasecmp(name, reaper_native[i]) == 0)
 			return 2;
 
+	/* first-run gate pages that must stay top-level but still be themed: the
+	   reaper_content.css <link> WITHOUT the bounce. Signalled by return value 3. */
+	for (i = 0; reaper_css_only[i]; i++)
+		if (strcasecmp(name, reaper_css_only[i]) == 0)
+			return 3;
+
 	return 1;
 }
 
@@ -321,9 +346,17 @@ void reaper_output(struct mime_handler *handler, char *file, FILE *conn_fp)
 	}
 
 	/* mode 2 = reaper-native page: inject the bounce block WITHOUT the
-	 * reaper_content.css <link> (it would fight the page's own chrome). */
-	block    = (mode == 2) ? REAPER_NATIVE_BLOCK : REAPER_BLOCK;
-	blocklen = (mode == 2) ? sizeof(REAPER_NATIVE_BLOCK) - 1 : sizeof(REAPER_BLOCK) - 1;
+	 *          reaper_content.css <link> (it would fight the page's own chrome).
+	 * mode 3 = first-run gate page: the <link> WITHOUT the bounce, so it stays
+	 *          top-level (see reaper_css_only[]) but is still themed. */
+	switch (mode) {
+	case 2:
+		block = REAPER_NATIVE_BLOCK;  blocklen = sizeof(REAPER_NATIVE_BLOCK) - 1;  break;
+	case 3:
+		block = REAPER_CSSONLY_BLOCK; blocklen = sizeof(REAPER_CSSONLY_BLOCK) - 1; break;
+	default:
+		block = REAPER_BLOCK;         blocklen = sizeof(REAPER_BLOCK) - 1;         break;
+	}
 
 	mem = open_memstream(&body, &bodylen);
 	if (!mem) {				/* fail-open: serve unfiltered stock output */
diff --git a/release/src/router/rc/services.c b/release/src/router/rc/services.c
index 347a8ae07d..bec800e89a 100644
--- a/release/src/router/rc/services.c
+++ b/release/src/router/rc/services.c
@@ -7965,6 +7965,36 @@ void start_upnp(void)
 #endif
 					"/tmp/upnp.leases");
 
+				/* reaper 2026-08-13 field fix (v2.3.7: "UPnP stops Call of Duty
+				 * connecting on a PS5", with pinholes on OR off).
+				 *
+				 * Since 2026-08-11 BOTH daemons are configured --igd2, so IGD_V2 is
+				 * defined and upnpurns.h advertises InternetGatewayDevice:2 /
+				 * WANConnectionDevice:2 / WANIPConnection:2. That commit argued
+				 * backward compatibility from minissdp.c alone - true for SSDP
+				 * DISCOVERY (a non-strict M-SEARCH still gets an IGD:1 ST) but not
+				 * for the DEVICE DESCRIPTION that the client fetches next.
+				 * upnphttp.c generates the IGD:1 description only when
+				 *     GETFLAG(FORCEIGDDESCV1MASK) || (h->respflags & FLAG_MS_CLIENT)
+				 * i.e. upstream ALREADY force-downgrades the description for
+				 * Microsoft clients, because IGD:2 descriptions break real ones.
+				 * A PS5 is not an MS client: it received WANIPConnection:2 only,
+				 * matched no service it knows, got no control URL, and could not
+				 * create a mapping. Before v2.3.5 the plain daemon had no IGD_V2 at
+				 * all, so this path shipped IGD:1 to everyone and worked.
+				 *
+				 * Default back to an IGD:1 description for everyone. This is purely
+				 * what the rootDesc CLAIMS - the daemon still implements the IGD:2
+				 * actions - so the only cost is that clients stop being offered
+				 * AddAnyPortMapping / GetListOfPortMappings. Set upnp_igd2_desc=1 to
+				 * advertise IGD:2 again. Emitted unguarded on purpose: the --igd2
+				 * configure flag is unconditional in the router Makefile, so keying
+				 * this off RTCONFIG_IGD2 would miss exactly the builds that need it,
+				 * and an option an IGD:1 binary does not know is non-fatal (it only
+				 * logs "Unknown option in file", it does not return 1). */
+				if (!nvram_get_int("upnp_igd2_desc"))
+					fprintf(f, "force_igd_desc_v1=yes\n");
+
 				if (nvram_get_int("upnp_clean")) {
 					int interval = nvram_get_int("upnp_clean_interval");
 					if (interval < 60)
diff --git a/release/src/router/shared/defaults.c b/release/src/router/shared/defaults.c
index 6480580598..a3ec80164b 100644
--- a/release/src/router/shared/defaults.c
+++ b/release/src/router/shared/defaults.c
@@ -5229,6 +5229,17 @@ struct nvram_tuple router_defaults[] = {
 	   VUPNP hooks nat/PREROUTING, ahead of the routing decision, so such a mapping
 	   intercepts traffic meant for the router. Default on; 0 restores stock behaviour. */
 	{ "upnp_protect_svc", "1", CKN_STR1, CKN_TYPE_DEFAULT, CKN_ACC_LEVEL_DEFAULT, CKN_ENC_DEFAULT, 0 },
+	/* reaper 2026-08-13 field fix: which IGD version the DEVICE DESCRIPTION advertises.
+	   Both daemons are built --igd2 since 2026-08-11, and miniupnpd then serves an
+	   IGD:2 rootDesc (WANIPConnection:2) to every client except a detected Microsoft
+	   one (upnphttp.c: FORCEIGDDESCV1MASK || FLAG_MS_CLIENT). A PS5 is not an MS
+	   client, so it saw only WANIPConnection:2, found no control URL and could not
+	   map at all - field-reported as "UPnP breaks Call of Duty on PS5", identically
+	   with pinholes on or off. Default 0 = advertise IGD:1 (what shipped up to
+	   v2.3.4, and what upstream already forces for Xbox); 1 = advertise IGD:2 and
+	   regain AddAnyPortMapping / GetListOfPortMappings at the cost of such clients.
+	   This is DESCRIPTION-ONLY: the daemon still implements the IGD:2 actions. */
+	{ "upnp_igd2_desc", "0", CKN_STR1, CKN_TYPE_DEFAULT, CKN_ACC_LEVEL_DEFAULT, CKN_ENC_DEFAULT, 0 },
 
 #ifdef RTCONFIG_BCMARM
 	{ "qos_overhead", "0", CKN_STR4, CKN_TYPE_DEFAULT, CKN_ACC_LEVEL_DEFAULT, CKN_ENC_DEFAULT, 0 }, // Overhead, in bytes
