From 8f151129755ca2cc85db8d3ab3f243a73100f52d Mon Sep 17 00:00:00 2001
From: reaper <theunbounddeveloper@outlook.com>
Date: Thu, 13 Aug 2026 14:17:22 -0400
Subject: [PATCH] miniupnpd: log which IGD description version each control
 point was served

Groundwork for the per-client version choice, which is how upstream already
handles this: sendXMLdesc() picks the description version per REQUEST, from

    GETFLAG(FORCEIGDDESCV1MASK) || (h->respflags & FLAG_MS_CLIENT)

and FLAG_MS_CLIENT is set by a User-Agent substring match on "microsoft" or
"FDSSDP" (upnphttp.c, ParseHttpHeaders). So downgrading a specific problem
client to an IGD:1 description costs one more condition on that line - no
state, no timers, no daemon restart, and clients that cope with IGD:2 keep it.

The blocker is that nobody knows what string the affected clients send:
miniupnpd never logs the User-Agent, and the sniff discards it after testing.
That is the one missing fact behind the PS5 report, and it cannot be recovered
from the build tree.

So: keep the raw UA on the connection (bounded copy, stops at the first control
character so CR/LF cannot reach the log) and emit one LOG_INFO line when the
ROOT description is served, recording the version, the client, and the UA.
Root description only - sendXMLdesc() also serves the per-service SCPDs and
logging those would multiply every discovery by four for no added information.

Behaviour is otherwise unchanged; force_v1 is only hoisted into a local so it
can be both logged and passed. Default remains an IGD:1 description for every
client (upnp_igd2_desc=0), so this is purely diagnostic until we have a string
worth matching on.

Co-Authored-By: Claude Opus 5 (1M context) <noreply@anthropic.com>
---
 release/src/router/miniupnpd/upnphttp.c | 34 ++++++++++++++++++++++++-
 release/src/router/miniupnpd/upnphttp.h |  5 ++++
 2 files changed, 38 insertions(+), 1 deletion(-)

diff --git a/release/src/router/miniupnpd/upnphttp.c b/release/src/router/miniupnpd/upnphttp.c
index 97bc4d8095..7307fbaf56 100644
--- a/release/src/router/miniupnpd/upnphttp.c
+++ b/release/src/router/miniupnpd/upnphttp.c
@@ -312,6 +312,26 @@ ParseHttpHeaders(struct upnphttp * h)
 				if(strcasestr(line + 11, "microsoft") != NULL || strstr(line + 11, "FDSSDP") != NULL) {
 					h->respflags |= FLAG_MS_CLIENT;
 				}
+				/* reaper 2026-08-13: keep the raw UA. The sniff above is the ONLY
+				 * per-client input to the IGD version decision in sendXMLdesc(),
+				 * and upstream never records what a client actually sent - so when
+				 * a non-Microsoft control point (a PS5, in the field report that
+				 * prompted this) fails against an IGD:2 description, there is no
+				 * way to learn the string that would let us give it the same
+				 * carve-out Microsoft clients get. Copy it out, bounded, stopping
+				 * at the first control character so CR/LF never reach the log. */
+				{
+					const char *ua = line + 11;
+					size_t i = 0;
+
+					while(*ua == ' ' || *ua == '\t')
+						ua++;
+					while(i < sizeof(h->reaper_ua) - 1 && ua[i] >= ' ') {
+						h->reaper_ua[i] = ua[i];
+						i++;
+					}
+					h->reaper_ua[i] = '\0';
+				}
 			}
 #ifdef ENABLE_EVENTS
 			else if(strncasecmp(line, "Callback:", 9)==0)
@@ -468,11 +488,23 @@ sendXMLdesc(struct upnphttp * h, char * (f)(int *, int))
 	char * desc;
 	int len;
 #ifdef IGD_V2
+	int force_v1 = GETFLAG(FORCEIGDDESCV1MASK) || (h->respflags & FLAG_MS_CLIENT);
 #ifdef DEBUG
 	if(h->respflags & FLAG_MS_CLIENT)
 		syslog(LOG_DEBUG, "MS Client, forcing IGD v1");
 #endif /* DEBUG */
-	desc = f(&len, GETFLAG(FORCEIGDDESCV1MASK) || (h->respflags & FLAG_MS_CLIENT));
+	/* reaper 2026-08-13: record the version actually served, and to whom.
+	 * Root description only - sendXMLdesc() also serves the per-service SCPDs,
+	 * and logging all of them would multiply every discovery by four for no
+	 * extra information. This is the one line that tells us whether a control
+	 * point that later failed to map had been handed an IGD:2 description, and
+	 * what User-Agent it identifies itself by - the string needed to give it the
+	 * same per-client downgrade that upstream hardcodes for Microsoft clients. */
+	if(f == genRootDesc)
+		syslog(LOG_INFO, "IGD desc: served v%d to %s (User-Agent: %s)",
+		       force_v1 ? 1 : 2, h->clientaddr_str,
+		       h->reaper_ua[0] ? h->reaper_ua : "(none sent)");
+	desc = f(&len, force_v1);
 #else
 	desc = f(&len, 0);
 #endif
diff --git a/release/src/router/miniupnpd/upnphttp.h b/release/src/router/miniupnpd/upnphttp.h
index 3bc7215c46..9b3416eed6 100644
--- a/release/src/router/miniupnpd/upnphttp.h
+++ b/release/src/router/miniupnpd/upnphttp.h
@@ -62,6 +62,11 @@ struct upnphttp {
 	/* request */
 	char * req_buf;
 	char accept_language[8];
+	/* reaper 2026-08-13: raw User-Agent of the requesting control point, kept so
+	   sendXMLdesc() can record WHICH IGD description version each client was
+	   served. miniupnpd otherwise never logs the UA, which left us unable to tell
+	   why a given console failed. Zeroed by the memset() in New_upnphttp(). */
+	char reaper_ua[96];
 	int req_buflen;
 	int req_contentlen;
 	int req_contentoff;     /* header length */
-- 
2.25.1

