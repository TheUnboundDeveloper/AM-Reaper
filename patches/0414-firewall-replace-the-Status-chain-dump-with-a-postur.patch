diff --git a/release/src/router/httpd/web.c b/release/src/router/httpd/web.c
index a2450fbd6e..6835689c04 100644
--- a/release/src/router/httpd/web.c
+++ b/release/src/router/httpd/web.c
@@ -23471,6 +23471,31 @@ fw_scan_syslog(const char *path, char *ring, int *head, int *count)
 	fclose(f);
 }
 
+/* reaper 2026-08-13: number of records in an ASUS '<'-separated rulelist.
+ * Every such list is "<f>f>f<f>f>f", i.e. one leading '<' per record, so
+ * counting '<' counts records. Used by the Status view, which reports HOW MANY
+ * rules each filter holds rather than shipping the lists themselves. */
+static int fw_list_count(const char *s)
+{
+	int n = 0;
+	if (!s) return 0;
+	for (; *s; s++)
+		if (*s == '<') n++;
+	return n;
+}
+
+/* reaper 2026-08-13: the remote-admin port actually in use. http_enable:
+ * 0 = HTTP only, 1 = HTTPS only, 2 = both - report the TLS port whenever TLS
+ * answers, since that is the one an operator would be reaching. */
+static int fw_remote_admin_port(void)
+{
+#ifdef RTCONFIG_HTTPS
+	if (nvram_get_int("http_enable") != 0)
+		return nvram_get_int("misc_httpsport_x") ? : 8443;
+#endif
+	return nvram_get_int("misc_httpport_x") ? : 8080;
+}
+
 static void
 do_reaper_fw_cgi(char *url, FILE *stream)
 {
@@ -23511,11 +23536,75 @@ do_reaper_fw_cgi(char *url, FILE *stream)
 			nvram_match("rwarden_enable", "1") ? 1 : 0,
 			nvram_match("rwarden_log", "1") ? 1 : 0);
 		gk_json_esc(stream, nvram_safe_get("fw_log_x"));
-		websWrite(stream, "},\"v4\":");
-		fw_emit_cmd(stream, "iptables -nvxL 2>/dev/null", 98304);
-		websWrite(stream, ",\"v6\":");
-		fw_emit_cmd(stream, "ip6tables -nvxL 2>/dev/null", 65536);
-		websWrite(stream, "}");
+
+		/* reaper 2026-08-13: Status was a raw `iptables -nvxL` dump of EVERY
+		 * chain, v4 and v6, re-fetched every 10s by the auto-refresh. That is a
+		 * packet-filter debugger, not a status page: unreadable to anyone who
+		 * does not already speak iptables, and it shipped ~160 KB of chain text
+		 * per poll for the privilege. It now reports the POSTURE instead - which
+		 * features are on and what they are set to - so the two popen() calls
+		 * and their buffers are gone with it. Raw chains remain available over
+		 * the shell for anyone who actually wants them. */
+
+		/* the Reaper rules engine */
+		websWrite(stream,
+			",\"fwen\":%d,\"fwconfirm\":%d,\"fwarmed\":%d,"
+			"\"nrules\":%d,\"nobj\":%d,\"ngrp\":%d,\"nsvc\":%d,"
+			"\"nzone\":%d,\"nzpol\":%d",
+			nvram_match("reaper_fw_enable", "1") ? 1 : 0,
+			nvram_get_int("reaper_fw_confirm"),
+			nvram_match("reaper_fw_armed", "1") ? 1 : 0,
+			fw_list_count(nvram_safe_get("reaper_fw_rules")),
+			fw_list_count(nvram_safe_get("reaper_fw_obj")),
+			fw_list_count(nvram_safe_get("reaper_fw_grp")),
+			fw_list_count(nvram_safe_get("reaper_fw_svc")),
+			fw_list_count(nvram_safe_get("reaper_fw_zone")),
+			fw_list_count(nvram_safe_get("reaper_fw_zpol")));
+		websWrite(stream, ",\"fwerr\":");
+		gk_json_esc(stream, nvram_safe_get("reaper_fw_err"));
+
+		/* Warden detail (geo list + which direction it filters) */
+		websWrite(stream, ",\"wgeo\":");
+		gk_json_esc(stream, nvram_safe_get("rwarden_geo"));
+		websWrite(stream, ",\"wdir\":");
+		gk_json_esc(stream, nvram_safe_get("rwarden_dir"));
+
+		/* content filters: mode + how many rules each holds */
+		websWrite(stream, ",\"lwmode\":");
+		gk_json_esc(stream, nvram_safe_get("filter_lw_default_x"));
+		websWrite(stream, ",\"nlw\":%d,\"urlmode\":",
+			fw_list_count(nvram_safe_get("filter_lwlist")));
+		gk_json_esc(stream, nvram_safe_get("url_mode_x"));
+		websWrite(stream, ",\"nurl\":%d,\"nkw\":%d",
+			fw_list_count(nvram_safe_get("url_rulelist")),
+			fw_list_count(nvram_safe_get("keyword_rulelist")));
+
+		/* inbound exposure - what of this box is reachable from the WAN.
+		 * upnp: the MASTER key is what the GUI edits, but wan<N>_upnp_enable is
+		 * what actually starts the daemon (start_upnp gates on it), so report
+		 * both rather than let them disagree silently. */
+		websWrite(stream,
+			",\"nat\":%d,\"vts\":%d,\"nvts\":%d,\"autofw\":%d,\"nautofw\":%d",
+			nvram_match("wan0_nat_x", "1") ? 1 : 0,
+			nvram_match("vts_enable_x", "1") ? 1 : 0,
+			fw_list_count(nvram_safe_get("vts_rulelist")),
+			nvram_match("autofw_enable_x", "1") ? 1 : 0,
+			fw_list_count(nvram_safe_get("autofw_rulelist")));
+		websWrite(stream, ",\"dmz\":");
+		gk_json_esc(stream, nvram_safe_get("dmz_ip"));
+		websWrite(stream,
+			",\"upnp\":%d,\"upnpwan\":%d,\"upnppin\":%d,\"upnpprot\":%d,"
+			"\"upnpigd2\":%d,\"remadmin\":%d,\"remport\":%d,"
+			"\"sshwan\":%d,\"sshport\":%d}}",
+			nvram_match("upnp_enable", "1") ? 1 : 0,
+			nvram_match("wan0_upnp_enable", "1") ? 1 : 0,
+			nvram_match("upnp_pinhole_enable", "1") ? 1 : 0,
+			nvram_match("upnp_protect_svc", "0") ? 0 : 1,
+			nvram_match("upnp_igd2_desc", "1") ? 1 : 0,
+			nvram_get_int("misc_http_x") ? 1 : 0,
+			fw_remote_admin_port(),
+			(nvram_get_int("sshd_enable") == 1) ? 1 : 0,
+			nvram_get_int("sshd_port") ? : 22);
 		return;
 	}
 
