+}
+
+/* reaper 2026-08-13: push the firmware to every node, the way stock's own
+   AiMesh button does - "/apply.cgi?action_mode=firmware_upgrade" hands the job
+   to cfg_server, which distributes to all connected nodes. Model-independent,
+   and it needs no per-node URL (unlike opening a node's own page, which depends
+   on that node advertising local_access). */
+function upgradeNodes(btn){
+  if(!confirm('<#RFWU_41#>')) return;
+  btn.disabled = true;
+  var x = new XMLHttpRequest();
+  x.open('GET', '/apply.cgi?action_mode=firmware_upgrade&_=' + Date.now(), true);
+  x.timeout = 15000;
+  x.onreadystatechange = function(){
+    if(x.readyState !== 4) return;
+    $id('nodeStat').innerHTML = (x.status === 200) ? '<#RFWU_42#>' : '<#RFWU_43#>';
+    $id('nodeStat').style.display = '';
+    btn.disabled = false;
+    setTimeout(loadNodes, 5000);
+  };
+  x.ontimeout = function(){ btn.disabled = false; };
+  x.send();
 }
 
