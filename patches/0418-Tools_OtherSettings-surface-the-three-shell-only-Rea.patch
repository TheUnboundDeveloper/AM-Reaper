diff --git a/release/src/router/shared/defaults.c b/release/src/router/shared/defaults.c
index 5dbc6c96a7a..d5d3bf30785 100644
--- a/release/src/router/shared/defaults.c
+++ b/release/src/router/shared/defaults.c
@@ -3192,9 +3192,14 @@ struct nvram_tuple router_defaults[] = {
 	/* reaper 2026-08-12: activate the WLCSM netlink bind() shim (LD_PRELOAD of
 	   /lib/wlcsm_bindfix.so) that works around the Broadcom libnvram.so port-
 	   allocation defect - see start_wlcsm_bindfix() in rc/services.c.
-	   DEFAULT OFF: /etc/ld.so.preload is global and this has not run on metal
-	   yet. Enable with: nvram set wlcsm_bindfix=1 && nvram commit && reboot */
-	{ "wlcsm_bindfix", "0", CKN_STR1, CKN_TYPE_DEFAULT, CKN_ACC_LEVEL_DEFAULT, CKN_ENC_DEFAULT, 0 },
+	   DEFAULT ON as of 2026-08-16 (owner decision), and exposed as a toggle on
+	   Tools_OtherSettings.asp so it can be turned off without a shell.
+	   UNDERSTAND WHAT THIS SHIPS: /etc/ld.so.preload is GLOBAL - every
+	   dynamically linked binary on the box loads the shim, init included. A
+	   MISSING .so degrades safely (start_wlcsm_bindfix logs and removes the
+	   preload), but a PRESENT-AND-BROKEN one has no such guard. Revert is this
+	   one literal back to "0"; a user can also clear the toggle and reboot. */
+	{ "wlcsm_bindfix", "1", CKN_STR1, CKN_TYPE_DEFAULT, CKN_ACC_LEVEL_DEFAULT, CKN_ENC_DEFAULT, 0 },
 	/* reaper 2026-08-11: escape hatch for the server-side first-boot gate (httpd.c
 	   reaper_firstboot_pending). The gate opens on its own once the live conditions
 	   clear - this is NOT written by the wizard. It exists so an operator who gets
