diff --git a/release/src/router/httpd/web.c b/release/src/router/httpd/web.c
index 0b1c185420..0015d75a3a 100644
--- a/release/src/router/httpd/web.c
+++ b/release/src/router/httpd/web.c
@@ -23656,7 +23656,12 @@ do_reaper_fw_cgi(char *url, FILE *stream)
 			left = dl - (long)time(NULL);
 			if (left < 0) left = 0;
 		}
-		websWrite(stream, "{\"ok\":1,\"enable\":%d,\"confirm\":%d,\"armed\":%d,\"left\":%ld",
+		/* `active` is what the page polls after toggling the engine: `enable` is
+		 * what was ASKED for and flips the instant opts writes it, whereas
+		 * `active` is written by start/stop_reaper_fw() once the chains have
+		 * actually changed. Reporting the first as the second would be guessing. */
+		websWrite(stream, "{\"ok\":1,\"active\":%d,\"enable\":%d,\"confirm\":%d,\"armed\":%d,\"left\":%ld",
+			nvram_match("reaper_fw_active", "1") ? 1 : 0,
 			nvram_match("reaper_fw_enable", "1") ? 1 : 0,
 			nvram_get_int("reaper_fw_confirm"),
 			nvram_match("reaper_fw_armed", "1") ? 1 : 0,
diff --git a/release/src/router/rc/reaper_fw.c b/release/src/router/rc/reaper_fw.c
index 5fc5bc5dee..b2c4a076d2 100644
--- a/release/src/router/rc/reaper_fw.c
+++ b/release/src/router/rc/reaper_fw.c
@@ -1690,6 +1690,13 @@ void stop_reaper_fw(void)
 	rmdir(RFW_ARMED);
 	unlink(RFW_DEADLINE);
 	nvram_set("reaper_fw_armed", "0");
+	/* reaper 2026-08-13: completion marker, written LAST and only by the code
+	 * that did the work. The GUI toggle fires notify_rc(), which returns as soon
+	 * as rc has been signalled - so the page has no way to tell "the request was
+	 * accepted" from "the chains actually changed". Reporting the former as the
+	 * latter is the inferred-signal-as-measured-fact mistake, so the page polls
+	 * for THIS instead. Runtime state: deliberately not committed. */
+	nvram_set("reaper_fw_active", "0");
 }
 
 /* Apply the COMMITTED ruleset. Boot, restart_firewall re-hook, and the enable
@@ -1698,11 +1705,14 @@ void start_reaper_fw(void)
 {
 	rfw_cfg_t c;
 	int lock;
+	int applied = 0;
 
 	if (!is_routing_enabled()) return;
 	if (!nvram_match("reaper_fw_enable", "1")) {
 		if (f_exists(RFW_APPLY) || nvram_match("reaper_fw_armed", "1"))
-			stop_reaper_fw();
+			stop_reaper_fw();          /* clears reaper_fw_active itself */
+		else
+			nvram_set("reaper_fw_active", "0");  /* nothing to tear down, but say so */
 		return;
 	}
 	if (!rfw_cfg_load(&c, 0)) return;
@@ -1720,10 +1730,18 @@ void start_reaper_fw(void)
 		chmod(RFW_APPLY, 0700);
 		if (system("sh " RFW_APPLY) != 0)
 			logmessage("reaper_fw", "LAN not ready at boot - rules deferred, re-arm on the firewall hook");
+		else
+			applied = 1;
 	}
 	file_unlock(lock);
 	rfw_gen_resolve(&c);
 	rfw_cfg_free(&c);
+	/* See the note in stop_reaper_fw(). Set only when the generated script
+	 * actually RAN - writing it is not the same as applying it, and the deferred
+	 * "LAN not ready" path above is precisely a case where the engine is enabled
+	 * but no chain exists yet. Claiming active there would be the same lie in a
+	 * quieter form. */
+	nvram_set("reaper_fw_active", applied ? "1" : "0");
 }
 
 /* Apply the DRAFT (already in nvram RAM, not committed) and arm the revert. */
diff --git a/release/src/router/shared/defaults.c b/release/src/router/shared/defaults.c
index cd1de6bd2b..8639ce0965 100644
--- a/release/src/router/shared/defaults.c
+++ b/release/src/router/shared/defaults.c
@@ -3234,6 +3234,13 @@ struct nvram_tuple router_defaults[] = {
 	 * is deliberately volatile-by-convention (reset to 0 on every stop/confirm)
 	 * so a reboot mid-window can never leave the box believing it is still armed. */
 	{ "reaper_fw_armed", "0", CKN_STR1, CKN_TYPE_DEFAULT, CKN_ACC_LEVEL_DEFAULT, CKN_ENC_DEFAULT, 0 },	/* 1 = a change is awaiting confirmation */
+	/* 1 = the generated ruleset actually RAN and our chains are installed. Written last by
+	   start_reaper_fw()/stop_reaper_fw(), i.e. by the code that did the work - the GUI toggle
+	   fires notify_rc(), which returns as soon as rc is signalled, so the page cannot otherwise
+	   distinguish "request accepted" from "chains changed". NOT the same as reaper_fw_enable:
+	   enable is what the operator asked for, active is what is true. They differ while a restart
+	   is in flight, and on the deferred "LAN not ready at boot" path. */
+	{ "reaper_fw_active", "0", CKN_STR1, CKN_TYPE_DEFAULT, CKN_ACC_LEVEL_DEFAULT, CKN_ENC_DEFAULT, 0 },
 	{ "reaper_fw_err", "", CKN_STR256, CKN_TYPE_DEFAULT, CKN_ACC_LEVEL_DEFAULT, CKN_ENC_DEFAULT, 0 },	/* last refusal reason, surfaced by the page */
 	/* reaper v1.9.1: Device Identity Manager Rung B - unified long-term storage
 	 * (Reaper_Storage.asp, System Log group). reaper_store = durable location for
