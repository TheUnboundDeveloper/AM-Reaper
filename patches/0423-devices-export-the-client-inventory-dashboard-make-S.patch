+/* ---- Security Posture rows are links ------------------------------------
+ * Each row reports a setting but gave no way to reach it; the operator had to
+ * know which page owned it. Every row now carries data-go with its destination,
+ * and the two firewall rows deep-link to the tab that owns them
+ * (Reaper_Firewall.asp?t=general) rather than dropping the user on Status to
+ * hunt - the ask was "the page AND view".
+ *
+ * The dashboard is TOP-LEVEL, not framed (standing rule 39), so navigating means
+ * pointing at the shell with the page in the hash - the same form the rail links
+ * on this page already use. One delegated listener rather than 14 handlers, so a
+ * row added later only needs the attribute.
+ *
+ * tabindex/role are set here rather than in the markup: it keeps the 14 rows
+ * free of boilerplate, and a row that loses its data-go stops being focusable
+ * automatically. */
+(function(){
+  function go(el){
+    var p = el && el.getAttribute('data-go');
+    if (p) location.href = '/reaper_shell.asp#' + p;
+  }
+  function rowOf(t){
+    while (t && t !== document) {
+      if (t.classList && t.classList.contains('srow') && t.hasAttribute('data-go')) return t;
+      t = t.parentNode;
+    }
+    return null;
+  }
+  var rows = document.querySelectorAll('.srow[data-go]'), i;
+  for (i = 0; i < rows.length; i++) {
+    rows[i].setAttribute('tabindex', '0');
+    rows[i].setAttribute('role', 'link');
+  }
+  document.addEventListener('click', function(e){ go(rowOf(e.target)); });
+  document.addEventListener('keydown', function(e){
+    if (e.key !== 'Enter' && e.key !== ' ' && e.key !== 'Spacebar') return;
+    var r = rowOf(e.target);
+    if (r) { e.preventDefault(); go(r); }
+  });
+})();
 </script>
