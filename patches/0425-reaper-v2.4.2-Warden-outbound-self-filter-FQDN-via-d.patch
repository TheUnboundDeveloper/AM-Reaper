+/* reaper 2026-08-14, field report ("some Wi-Fi clients connected through AiMesh
+ * nodes are shown as Wired"):
+ *
+ * Neither of the two sources above can see a client that is associated to a
+ * MESH NODE. rdev_scan_wl() reads THIS router's assoclists, and the node's
+ * stations are not in them. rdev_scan_fdb() then places the client by the br0
+ * port its frames arrive on - which for a node is the backhaul: an eth port
+ * (wired backhaul) reads as kind=1 and marks the client Wired, and a wireless
+ * backhaul reads as kind=2 and marks it with the BACKHAUL's band rather than
+ * the band the client is actually on. The wired case is what was reported; the
+ * wireless-backhaul case is the same defect showing a plausible-but-wrong band.
+ *
+ * cfg_mnt already collects the answer. /tmp/allwclientlist.json is the wireless
+ * client list across every node, shaped { node_brmac: { band: { mac: {...} } } }
+ * - ASUS's own ej_get_wclientlist walks exactly this, and iterates the band keys
+ * generically rather than hardcoding names, so this does too.
+ *
+ * Deliberately narrow: it only promotes a device our own radios did NOT see, so
+ * a locally-associated client keeps the band its assoclist reported and this
+ * can never override first-hand data with second-hand data. The residual risk
+ * is staleness - a client that moves from a node's Wi-Fi onto a cable reads
+ * Wi-Fi until cfg_mnt prunes it - so the wired list is consulted first and wins.
+ */
+/* The cfg_mnt list paths and their file locks come from <cfg_wevent.h> /
+ * <cfg_clientlist.h>, which are only included under RTCONFIG_CFGSYNC - so this
+ * pass compiles away on a build without AiMesh sync, where there are no nodes
+ * for a client to be behind in the first place. */
+#ifdef RTCONFIG_CFGSYNC
+/* is this MAC listed as WIRED behind any node? /tmp/wiredclientlist.json is
+ * { node_brmac: { client_mac: {...} } }. Compared case-insensitively - the two
+ * cfg_mnt lists are not guaranteed to agree on MAC case. */
+static int rdev_amesh_is_wired(json_object *wired, const char *mac)
+{
+	json_object_object_foreach(wired, nodemac, macs) {
+		(void)nodemac;
+		if (!json_object_is_type(macs, json_type_object)) continue;
+		json_object_object_foreach(macs, wmac, wval) {
+			(void)wval;
+			if (!strcasecmp(wmac, mac)) return 1;
+		}
+	}
+	return 0;
+}
+
+static void rdev_scan_amesh(struct rdev *v, int *n)
+{
+	json_object *wl = NULL, *wired = NULL;
+	int lock;
+
+	lock = file_lock(ALLWEVENT_FILE_LOCK);
+	wl = json_object_from_file(ALLWCLIENT_LIST_JSON_PATH);
+	file_unlock(lock);
+	if (!wl) return;
+
+	lock = file_lock(WIREDCLIENTLIST_FILE_LOCK);
+	wired = json_object_from_file(WIRED_CLIENT_LIST_JSON_PATH);
+	file_unlock(lock);
+
+	/* node -> band -> client */
+	json_object_object_foreach(wl, nodemac, bands) {
+		(void)nodemac;
+		if (!json_object_is_type(bands, json_type_object)) continue;
+		json_object_object_foreach(bands, bandkey, stas) {
+			const char *bl;
+			int bit;
+			if (!json_object_is_type(stas, json_type_object)) continue;
+			/* band keys are "2G"/"5G"/"5G1"/"5G2"/"6G"/"6G1": the leading
+			 * digit is the band, any trailing radio index is irrelevant here */
+			switch (bandkey[0]) {
+			case '2': bl = "2.4"; bit = 1; break;
+			case '5': bl = "5";   bit = 2; break;
+			case '6': bl = "6";   bit = 4; break;
+			default:  continue;	/* a wired/unknown bucket - not ours */
+			}
+			json_object_object_foreach(stas, stamac, staval) {
+				int idx;
+				(void)staval;
+				idx = rdev_lookup(v, *n, (char *)stamac);
+				if (idx < 0) continue;
+				if (v[idx].wifi) continue;	/* our own radio already placed it */
+				/* listed as wired on a node too -> the wireless entry is
+				 * stale; believe the cable. */
+				if (wired && rdev_amesh_is_wired(wired, stamac)) continue;
+				v[idx].wifi = 1;
+				v[idx].wired = 0;
+				v[idx].online = 1;
+				if (!v[idx].mlo && !v[idx].bandmask) {
+					v[idx].bandmask |= bit;
+					if (!v[idx].band[0])
+						snprintf(v[idx].band, sizeof(v[0].band), "%s", bl);
+				}
+			}
+		}
+	}
+
+	if (wired) json_object_put(wired);
+	json_object_put(wl);
+}
+#else
+static void rdev_scan_amesh(struct rdev *v, int *n) { (void)v; (void)n; }
+#endif	/* RTCONFIG_CFGSYNC */
+
 /* the 2nd hex nibble x2 bit => locally-administered (randomized) MAC */
 static int rdev_is_rand(const char *mac)
 {
@@ -24274,6 +24380,11 @@ static void do_reaper_dev_cgi(char *url, FILE *stream)
 		/* bridge FDB is authoritative for wired/wireless + band (assoclist omits
 		 * some EHT/6GHz/pseudo-MLO stations, which used to read as "Wired"). */
 		rdev_scan_fdb(dev, &n);
+		/* AiMesh: a client associated to a NODE is in neither of the above -
+		 * the FDB places it on the backhaul port and it reads as Wired. Must
+		 * run after the FDB so it can correct that verdict, and before the
+		 * fallback below so it can pre-empt it. */
+		rdev_scan_amesh(dev, &n);
 		/* last resort: an online device the FDB never placed and no radio saw */
 		for (i = 0; i < n; i++)
 			if (dev[i].online && !dev[i].wifi && !dev[i].wired) dev[i].wired = 1;
