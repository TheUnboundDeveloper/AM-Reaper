diff --git a/release/src/router/www/Reaper_Traffic.asp b/release/src/router/www/Reaper_Traffic.asp
index ba2823c396..5df4d4d503 100644
--- a/release/src/router/www/Reaper_Traffic.asp
+++ b/release/src/router/www/Reaper_Traffic.asp
@@ -298,6 +298,42 @@ function classGate(){
 var CLSCOLOR = ['#71767b','#3987e5','#199e70','#c98500','#9085e9','#d95926','#e66767'];
 var CLSNAME  = (decodeURIComponent('<% nvram_char_to_ascii("", "qos_class_names"); %>')||'Q1,Q2,Q3,Q4,Q5').split(',');
 var NETCOLOR = ['#3987e5','#199e70','#c98500','#9085e9','#d95926','#e66767','#d55181','#71767b'];
+
+/* reaper 2026-08-14, field report: the per-network series are keyed by bridge
+   name (br0/br54/...) because that is the collector's stable, persisted key -
+   but a bridge number is not the VLAN number the owner configured, and on the
+   reporting box they differ (VLAN 52 is br54). rtrafd now ships a side table,
+   netlbl = { "br54": {vid:52, name:"Guests"} }, which is what these two helpers
+   render. Kept in a module-level cache because the live payload and a history
+   window are fetched separately and either may arrive first. */
+var NETLBL = {};
+function netCache(d){ if(d && d.netlbl) NETLBL = d.netlbl; }
+
+/* Legend text. Prefer the SDN's own name, fall back to the VLAN id, and fall
+   back again to the raw bridge for anything not in the SDN table (br0 on a box
+   with no SDN configured, or a bridge that has gone away but still has stored
+   history). The bridge always stays visible in the tooltip - the owner asked
+   for the VLAN shown ALONGSIDE the bridge name, not instead of it. */
+function netLabel(br){
+  var e = NETLBL[br];
+  if(!e) return br;
+  /* Show the VLAN id AND the bridge whenever both are known - the report was
+     specifically that "VLAN 52" and "br54" could not be connected, so a label
+     that carries only one of them does not answer it. */
+  if(e.name && e.vid > 0) return e.name + ' (VLAN ' + e.vid + ', ' + br + ')';
+  if(e.name)              return e.name + ' (' + br + ')';
+  if(e.vid > 0)           return 'VLAN ' + e.vid + ' (' + br + ')';
+  return br;
+}
+function netTitle(br){
+  var e = NETLBL[br], p = [br];
+  if(e && e.vid > 0) p.push('VLAN ' + e.vid);
+  if(e && e.name) p.push(e.name);
+  /* ASCII only (standing rule 1): the packaging pass strips non-ASCII from
+     .asp, and this lands in a title attribute where an entity would not be
+     decoded after esc() anyway. */
+  return p.join(' - ');
+}
 var curWin = 'live', liveTimer = null, pollMs = 1000, curStore = 'RAM';
