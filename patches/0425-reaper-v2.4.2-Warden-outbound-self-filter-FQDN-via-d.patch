-#define RFW_RESOLVE  RFW_DIR "/resolve.sh"        /* periodic fqdn -> ipset refresh */
+#define RFW_RESOLVE  RFW_DIR "/resolve.sh"        /* periodic fqdn -> ipset refresh (the floor) */
+/* RFW_DNSMASQ_CONF (rc.h) is the dnsmasq ipset= fragment - the accelerator. */
+#define RFW_FQDN_TTL 3600                         /* fqdn set expiry, seconds; must stay >> the resolver cron interval */
 #define RFW_PREVIEW  RFW_DIR "/preview.txt"       /* compile-preview output (never executed) */
 
 #define RFW_CONFIRM_MIN  15                       /* commit-confirm floor, seconds (S3: never 0) */
@@ -679,6 +681,40 @@ static void rfw_emit_one_set(FILE *f, const char *type, const char *name,
 	if (!strcmp(type, "range")) { stype4 = "hash:ip"; stype6 = "hash:ip"; }
 	if (!strcmp(type, "mac"))   { stype4 = "hash:mac"; stype6 = "hash:mac"; }
 
+	/* FQDN sets are filled at run time - by dnsmasq on every matching lookup
+	 * (rfw_gen_dnsmasq) and by the timer as a floor (rfw_gen_resolve) - so they
+	 * differ from the literal types in two ways:
+	 *
+	 *  - they carry a `timeout`. Nothing ever removes an address from them, and
+	 *    dnsmasq adds every answer it sees, so a name behind a large rotating
+	 *    CDN pool would grow its set without bound. An expiry makes the set
+	 *    self-pruning; re-adding an address that is still resolving simply
+	 *    refreshes its timer. The value must stay comfortably above the
+	 *    resolver's cron interval or the set would empty out between runs.
+	 *  - they are NOT flushed on apply. A flush would discard everything
+	 *    dnsmasq has accumulated, and dnsmasq's own cache would then suppress
+	 *    the re-adds until those TTLs expired - a silent hole in the middle of
+	 *    an unrelated firewall change. Expiry retires stale entries instead.
+	 *
+	 * An older set built before the timeout existed cannot be altered in place,
+	 * so it is destroyed first. That is safe exactly here: the chains were torn
+	 * down at the top of this script, so nothing references the set yet. */
+	if (!strcmp(type, "fqdn")) {
+		const char *s[2]; int i;
+		s[0] = RFW_SET4; s[1] = RFW_SET6;
+		for (i = 0; i < 2; i++) {
+			fprintf(f,
+			  "ipset list -t %s%s 2>/dev/null | grep -q '^Header:.*timeout' || "
+			  "ipset destroy %s%s 2>/dev/null\n", s[i], name, s[i], name);
+			fprintf(f, "ipset create %s%s %s%s timeout %d -exist\n",
+			        s[i], name, stype4, i ? " family inet6" : "", RFW_FQDN_TTL);
+			strlcat(keep, " ", keeplen);
+			strlcat(keep, s[i], keeplen);
+			strlcat(keep, name, keeplen);
+		}
+		return;
+	}
+
 	fprintf(f, "ipset create %s%s %s -exist\n", RFW_SET4, name, stype4);
 	fprintf(f, "ipset flush %s%s\n", RFW_SET4, name);
 	if (strcmp(type, "mac") != 0) {
@@ -690,10 +726,6 @@ static void rfw_emit_one_set(FILE *f, const char *type, const char *name,
 		strlcat(keep, " ", keeplen); strlcat(keep, RFW_SET6, keeplen); strlcat(keep, name, keeplen);
 	}
 
-	/* an fqdn object's members are resolved at run time by the refresh script,
-	 * not here - the set is created empty and filled below. */
-	if (!strcmp(type, "fqdn")) return;
-
 	if (!(dup = strdup(val))) return;
 	for (tok = strtok_r(dup, ",", &save); tok; tok = strtok_r(NULL, ",", &save)) {
 		int ok = 0, v6 = 0;
@@ -748,12 +780,119 @@ static void rfw_emit_sets(FILE *f, const rfw_cfg_t *c, char *keep, size_t keeple
 	free(dup);
 }
 
-/* the periodic FQDN resolver. dnsmasq's ipset= directive would be the better
- * mechanism, but /etc/dnsmasq.conf is regenerated wholesale on every
- * restart_dnsmasq and the only user hook (dnsmasq.postconf) belongs to the
- * operator - so this engine resolves names itself on a timer instead. The
- * trade-off is real and worth knowing: a host behind a large rotating CDN pool
- * will lag its current address set until the next refresh. */
+/* ---------------------------------------------------------------------------
+ * FQDN objects are populated two ways, and both are needed.
+ *
+ * dnsmasq's `ipset=` is the good one: the resolver drops every address it
+ * answers for a matching name straight into the object's sets, so the set holds
+ * exactly what the clients were told, including each member of a rotating CDN
+ * pool as it rotates. It is also cheap - no polling, no forked nslookup.
+ *
+ * It is not sufficient on its own. dnsmasq only populates on a live lookup that
+ * IT serves, which leaves four gaps: the sets are cold until something asks;
+ * names already in dnsmasq's cache are answered without a fresh add; a LAN
+ * resolver that forwards upstream by itself (AdGuard, Pi-hole) never consults
+ * dnsmasq at all; and a client doing DoH/DoT bypasses it entirely. So the timer
+ * below stays as the floor and `ipset=` rides on top as the accelerator.
+ *
+ * The plan recorded this as blocked on dnsmasq.conf being regenerated wholesale
+ * with dnsmasq.postconf belonging to the operator. It is not: rc owns the
+ * generator and emits these lines itself, immediately before the operator's
+ * hook, which still gets the last word. (It was also recorded as blocked on
+ * dnsmasq lacking ipset support - it has it; the binary's option banner reads
+ * "ipset", and config.h's NO_IPSET sits in the __APPLE__ branch.)
+ * ------------------------------------------------------------------------- */
+
+/* Write the `ipset=` fragment: one line per FQDN object listing all of its
+ * names and both of its sets. dnsmasq tries every listed set for each answer
+ * and silently skips the family that does not match (tables.c only logs on
+ * success), so naming the v4 and v6 sets together costs nothing. */
+static void rfw_gen_dnsmasq(const rfw_cfg_t *c)
+{
+	char tmp[sizeof(RFW_DNSMASQ_CONF) + 8];
+	FILE *f;
+	char *dup, *tok, *save = NULL;
+
+	/* stop_reaper_fw() reaches here too, and it has no mkdir of its own; an
+	 * absent directory would mean silently leaving the live directives in
+	 * place, which is the one outcome this function exists to prevent. */
+	mkdir(RFW_DIR, 0700);
+	snprintf(tmp, sizeof(tmp), "%s.tmp", RFW_DNSMASQ_CONF);
+	if (!(f = fopen(tmp, "w"))) return;
+	fprintf(f, "# generated by reaper_fw - fqdn objects; edit the objects, not this\n");
+
+	if (c->enable && !strcmp(c->enable, "1") && c->obj && *c->obj &&
+	    (dup = strdup(c->obj)) != NULL) {
+		for (tok = strtok_r(dup, "<", &save); tok; tok = strtok_r(NULL, "<", &save)) {
+			char name[RFW_NAME_MAX + 2], type[16], val[768], *d2, *t2, *s2 = NULL;
+			int n = 0;
+			if (!rfw_field(tok, 0, name, sizeof(name)) ||
+			    !rfw_field(tok, 1, type, sizeof(type)) ||
+			    !rfw_field(tok, 2, val,  sizeof(val))) continue;
+			if (strcmp(type, "fqdn") || !rfw_valid_name(name)) continue;
+			if (!(d2 = strdup(val))) continue;
+			for (t2 = strtok_r(d2, ",", &s2); t2; t2 = strtok_r(NULL, ",", &s2)) {
+				/* S2: rfw_valid_fqdn constrains this to letters, digits,
+				 * hyphen and dot - it cannot terminate the directive or
+				 * introduce another one. */
+				if (!rfw_valid_fqdn(t2)) continue;
+				if (n++ == 0) fprintf(f, "ipset=");
+				fprintf(f, "/%s", t2);
+			}
+			free(d2);
+			if (n) fprintf(f, "/%s%s,%s%s\n", RFW_SET4, name, RFW_SET6, name);
+		}
+		free(dup);
+	}
+	fclose(f);
+	rename(tmp, RFW_DNSMASQ_CONF);
+}
+
+/* Does the running /etc/dnsmasq.conf already carry exactly these lines?
+ * Compared against the LIVE config rather than the previous fragment, because
+ * /tmp is a tmpfs: after a reboot the fragment is always "new", and comparing
+ * against ourselves would restart dnsmasq on every single boot. Returns 1 when
+ * a restart is needed, 0 when the running config already agrees - and 0 when
+ * /etc/dnsmasq.conf does not exist yet, since dnsmasq has not been configured
+ * at all and will pick the fragment up when it first generates. */
+static int rfw_dnsmasq_stale(void)
+{
+	FILE *live, *frag;
+	char l[512], g[512];
+	int stale = 0;
+
+	if (!(live = fopen("/etc/dnsmasq.conf", "r"))) return 0;
+	if (!(frag = fopen(RFW_DNSMASQ_CONF, "r"))) { fclose(live); return 0; }
+	for (;;) {
+		char *lp = NULL, *gp = NULL;
+		/* walk both, considering only our own ipset= lines */
+		while (fgets(l, sizeof(l), live))
+			if (!strncmp(l, "ipset=", 6) && strstr(l, RFW_SET4)) { lp = l; break; }
+		while (fgets(g, sizeof(g), frag))
+			if (!strncmp(g, "ipset=", 6)) { gp = g; break; }
+		if (!lp && !gp) break;                       /* both exhausted: identical */
+		if (!lp || !gp || strcmp(lp, gp) != 0) { stale = 1; break; }
+	}
+	fclose(live);
+	fclose(frag);
+	return stale;
+}
+
+/* Regenerate the fragment and restart dnsmasq only if the running config no
+ * longer matches. Called from every path that commits a config, including the
+ * disabled/teardown path - where c yields an empty fragment, which is how the
+ * directives get removed again. */
+static void rfw_sync_dnsmasq(const rfw_cfg_t *c)
+{
+	rfw_gen_dnsmasq(c);
+	if (rfw_dnsmasq_stale()) {
+		logmessage("reaper_fw", "fqdn objects changed - restarting dnsmasq to reload ipset directives");
+		notify_rc("restart_dnsmasq");
+	}
+}
+
+/* the periodic FQDN resolver - the floor described above. Kept deliberately:
+ * see the four gaps dnsmasq's ipset= cannot cover. */
 static void rfw_gen_resolve(const rfw_cfg_t *c)
 {
 	FILE *f = fopen(RFW_RESOLVE, "w");
@@ -1687,6 +1826,14 @@ void stop_reaper_fw(void)
 	unlink(RFW_CAND);
 	unlink(RFW_CC);
 	unlink(RFW_RESOLVE);
+	/* Drop the ipset= directives too, and reload dnsmasq if they were live.
+	 * Leaving them behind would have dnsmasq filling sets the engine no longer
+	 * owns - and the set sweep destroys those sets, so every add would fail. */
+	{
+		rfw_cfg_t empty;
+		memset(&empty, 0, sizeof(empty));
+		rfw_sync_dnsmasq(&empty);
+	}
 	rmdir(RFW_ARMED);
 	unlink(RFW_DEADLINE);
