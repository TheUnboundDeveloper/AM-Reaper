diff --git a/release/src/router/rtrafd/rtrafd.c b/release/src/router/rtrafd/rtrafd.c
index 8098526f56..f71590f333 100644
--- a/release/src/router/rtrafd/rtrafd.c
+++ b/release/src/router/rtrafd/rtrafd.c
@@ -21,8 +21,17 @@
  *
  * Accounting caveats (documented in the UI FAQ): per-client numbers come from
  * conntrack, which the flow accelerator syncs periodically - short flows that
- * die between polls may undercount slightly. IPv6 flows count toward interface
- * totals but are not client-attributed in v1.
+ * die between polls may undercount slightly.
+ *
+ * IPv6 is attributed per-device as of v2.4.4. v4 finds the device by looking the
+ * LAN source up in /proc/net/arp; v6 has no such file and no NAT, so the client
+ * may be either end of the flow - both are resolved against the kernel's IPv6
+ * neighbour cache (netlink RTM_GETNEIGH, bridge ports only) and credited to the
+ * MAC, which is the same key the v4 path uses. A dual-stack device therefore
+ * lands in ONE row. Before this, a v6 flow counted toward the WAN and interface
+ * totals but no device, so a client whose traffic was mostly v6 - an iPhone on
+ * an IPv6-first CDN, say - could show a few hundred kb/s against a saturated
+ * WAN line.
  */
 
 #include <stdio.h>
@@ -45,6 +54,9 @@
 #include <netinet/ip_icmp.h>
 #include <sys/ioctl.h>
 #include <net/if.h>
+#include <linux/netlink.h>
+#include <linux/rtnetlink.h>
+#include <linux/neighbour.h>
 
 #include <bcmnvram.h>
 #include <shutils.h>
@@ -318,7 +330,7 @@ static uint64_t lv_net_rx[NNET], lv_net_tx[NNET];	/* per-network rate (fcache ti
 
 /* current live snapshot (for live.json) */
 typedef struct {
-	char src[16], dst[46];
+	char src[46], dst[46];	/* src widened for a v6 client (v2.4.4) */
 	int dport, proto;	/* proto: 6/17/other */
 	uint64_t rate;		/* bytes/sec both dirs */
 	uint64_t up, dn;	/* delta bytes this poll */
@@ -502,6 +514,19 @@ static int cli_index_get(const char *key)
 	return -1;
 }
 
+/* v2.4.4: claim a MAC-keyed slot WITHOUT touching its display label. cli_t.ip
+ * is a 16-byte IPv4 field living inside the persisted dbhdr_t, so a v6 literal
+ * neither fits nor can be made to fit without changing the on-disk layout and
+ * discarding every saved history file (the DB_VER 1->2 precedent). A dual-stack
+ * device keeps its v4 address as the label; a v6-only device keeps whatever the
+ * network map gives it. The row is keyed on the MAC either way. */
+static int cli_slot(const char *key, const char *ip);
+static int cli_slot_keep(const char *key)
+{
+	int i = cli_index_get(key);
+	return cli_slot(key, i >= 0 ? cli[i].ip : "");
+}
+
 static int cli_slot(const char *key, const char *ip)
 {
 	int i, oldest = 0;
@@ -586,6 +611,135 @@ static int arp_mac(const char *ip, char *mac, size_t maclen)
 	return 0;
 }
 
+/* IPv6 neighbour cache (v2.4.4). /proc/net/arp has no IPv6 counterpart, so a
+ * netlink dump is the only fork-free way to turn a LAN IPv6 address into the
+ * MAC the device rows are keyed on. Addresses are held in BINARY and compared
+ * with memcmp: conntrack prints %pI6c and inet_ntop would agree today, but
+ * comparing the 16 bytes removes any dependence on textual form.
+ * Only neighbours on a BRIDGE are kept - a neighbour on ppp0/eth0 is the ISP's
+ * router, not a client, and giving it a device row would be wrong. NND is sized
+ * for NCLI devices holding several addresses each (SLAAC + privacy + link-local). */
+#define NND	768
+static struct { unsigned char ip[16]; char mac[24]; char br[16]; } nd_tbl[NND];
+static int nd_n = 0;
+
+/* Any failure here leaves the table empty. That degrades to the pre-v2.4.4
+ * behaviour - v6 simply unattributed - never to a wrong attribution. */
+static void nd_refresh(void)
+{
+	struct { struct nlmsghdr nh; struct ndmsg nd; } req;
+	struct timeval tv;
+	char buf[16384];
+	int fd, len;
+
+	nd_n = 0;
+	if ((fd = socket(AF_NETLINK, SOCK_RAW, NETLINK_ROUTE)) < 0) return;
+	tv.tv_sec = 1; tv.tv_usec = 0;
+	setsockopt(fd, SOL_SOCKET, SO_RCVTIMEO, &tv, sizeof(tv));
+
+	memset(&req, 0, sizeof(req));
+	req.nh.nlmsg_len   = NLMSG_LENGTH(sizeof(struct ndmsg));
+	req.nh.nlmsg_type  = RTM_GETNEIGH;
+	req.nh.nlmsg_flags = NLM_F_REQUEST | NLM_F_DUMP;
+	req.nh.nlmsg_seq   = 1;
+	req.nd.ndm_family  = AF_INET6;
+	if (send(fd, &req, req.nh.nlmsg_len, 0) < 0) { close(fd); return; }
+
+	while ((len = recv(fd, buf, sizeof(buf), 0)) > 0) {
+		struct nlmsghdr *nh = (struct nlmsghdr *)buf;
+		for (; NLMSG_OK(nh, (unsigned int)len); nh = NLMSG_NEXT(nh, len)) {
+			struct ndmsg *ndm;
+			struct rtattr *rta;
+			const unsigned char *dst = NULL, *lla = NULL;
+			char ifn[IF_NAMESIZE];
+			int rlen, llalen = 0;
+
+			if (nh->nlmsg_type == NLMSG_DONE || nh->nlmsg_type == NLMSG_ERROR)
+				goto done;
+			if (nh->nlmsg_type != RTM_NEWNEIGH) continue;
+			ndm = (struct ndmsg *)NLMSG_DATA(nh);
+			if (ndm->ndm_family != AF_INET6) continue;
+			/* FAILED/INCOMPLETE carry no usable link address */
+			if (!(ndm->ndm_state & (NUD_REACHABLE | NUD_STALE | NUD_DELAY |
+						NUD_PROBE | NUD_PERMANENT)))
+				continue;
+			if (!if_indextoname(ndm->ndm_ifindex, ifn)) continue;
+			if (strncmp(ifn, "br", 2) != 0) continue;	/* LAN side only */
+
+			rta  = (struct rtattr *)((char *)ndm + NLMSG_ALIGN(sizeof(*ndm)));
+			rlen = nh->nlmsg_len - NLMSG_LENGTH(sizeof(*ndm));
+			for (; RTA_OK(rta, rlen); rta = RTA_NEXT(rta, rlen)) {
+				if (rta->rta_type == NDA_DST && RTA_PAYLOAD(rta) == 16)
+					dst = RTA_DATA(rta);
+				else if (rta->rta_type == NDA_LLADDR) {
+					lla = RTA_DATA(rta);
+					llalen = RTA_PAYLOAD(rta);
+				}
+			}
+			if (!dst || !lla || llalen != 6) continue;
+			if (nd_n >= NND) goto done;
+			memcpy(nd_tbl[nd_n].ip, dst, 16);
+			snprintf(nd_tbl[nd_n].mac, sizeof(nd_tbl[0].mac),
+				 "%02x:%02x:%02x:%02x:%02x:%02x",
+				 lla[0], lla[1], lla[2], lla[3], lla[4], lla[5]);
+			strlcpy(nd_tbl[nd_n].br, ifn, sizeof(nd_tbl[0].br));
+			nd_n++;
+		}
+	}
+done:
+	close(fd);
+}
+
+/* v6 address -> MAC + the bridge it sits behind (linear scan, as arp_mac) */
+static int nd_lookup(const unsigned char *ip6, char *mac, size_t maclen,
+		     const char **br)
+{
+	int i;
+	for (i = 0; i < nd_n; i++)
+		if (memcmp(nd_tbl[i].ip, ip6, 16) == 0) {
+			strlcpy(mac, nd_tbl[i].mac, maclen);
+			if (br) *br = nd_tbl[i].br;
+			return 1;
+		}
+	return 0;
+}
+
+/* The router's own IPv6 addresses, so router-sourced v6 lands in the Router
+ * bucket instead of a client row - the v6 counterpart of the lan_ip test. */
+#define NSELF6	32
+static unsigned char self6_tbl[NSELF6][16];
+static int self6_n = 0;
+
+static void self6_refresh(void)
+{
+	FILE *f = fopen("/proc/net/if_inet6", "r");
+	char line[192], hex[48];
+	self6_n = 0;
+	if (!f) return;
+	while (fgets(line, sizeof(line), f) && self6_n < NSELF6) {
+		int i;
+		if (sscanf(line, "%47s", hex) != 1) continue;
+		if (strlen(hex) != 32) continue;	/* 16 bytes, no colons */
+		for (i = 0; i < 16; i++) {
+			unsigned int b;
+			char t[3];
+			t[0] = hex[i * 2]; t[1] = hex[i * 2 + 1]; t[2] = '\0';
+			if (sscanf(t, "%2x", &b) != 1) break;
+			self6_tbl[self6_n][i] = (unsigned char)b;
+		}
+		if (i == 16) self6_n++;
+	}
+	fclose(f);
+}
+
+static int is_self6(const unsigned char *ip6)
+{
+	int i;
+	for (i = 0; i < self6_n; i++)
+		if (memcmp(self6_tbl[i], ip6, 16) == 0) return 1;
+	return 0;
+}
+
 /* ---------- pollers ---------- */
 
 /* Read a single unsigned counter out of a sysfs file, holding the fd open across
@@ -664,7 +818,7 @@ static void poll_classes(const char *wanif)
 }
 
 static void top_note(const char *src, const char *dst, int dport, int proto,
-		     uint64_t up, uint64_t dn)
+		     uint64_t up, uint64_t dn, const char *smac)
 {
 	/* top_note is only called from poll_fcache, whose deltas span one flow-cache
 	 * sample interval (FCACHE_SECS), not one base tick - divide by that. */
@@ -685,7 +839,9 @@ put:
 	 * poll_fcache and poll_conntrack call arp_refresh() before their top_note
 	 * loop). write_live() then just prints it, instead of re-scanning the whole
 	 * ARP table for every top row on every 10 Hz live write. */
-	if (!arp_mac(src, top[i].smac, sizeof(top[0].smac)))
+	if (smac && *smac)
+		strlcpy(top[i].smac, smac, sizeof(top[0].smac));	/* v6: resolved from nd_tbl */
+	else if (!arp_mac(src, top[i].smac, sizeof(top[0].smac)))
 		top[i].smac[0] = '\0';
 }
 
@@ -922,16 +1078,21 @@ static void poll_conntrack(void)
 	flowgen++;
 	ntop = 0;
 	arp_refresh();		/* load /proc/net/arp ONCE per poll, not per flow */
+	nd_refresh();		/* ...and the v6 neighbour cache, same deal */
+	self6_refresh();
 	brsub_refresh();	/* bridges can appear when a guest network is created */
 	netlbl_refresh();	/* ...and their VLAN/SDN identity with them (cached 30 s) */
 	while (fgets(line, sizeof(line), f)) {
 		char proto[16] = "", src[64] = "", dst[64] = "";
 		char rsrc[64] = "";
 		unsigned long long ob = 0, rb = 0;
-		int sport = 0, dport = 0, pnum = 0;
+		int sport = 0, dport = 0, pnum = 0, v6;
 		char *p;
 
-		if (strncmp(line, "ipv4", 4) != 0) continue;	/* v1: v4 attribution only */
+		if (strncmp(line, "ipv4", 4) == 0)      v6 = 0;
+		else if (strncmp(line, "ipv6", 4) == 0) v6 = 1;
+		else continue;
+		/* the family word and its number are skipped, so one scan serves both */
 		if (sscanf(line, "%*s %*d %15s %d", proto, &pnum) != 2) continue;
 
 		/* original direction: first src=/dst=/sport=/dport=/bytes= */
@@ -960,17 +1121,41 @@ static void poll_conntrack(void)
 
 			uint32_t sip;
 			const char *br;
-
-			if (inet_aton(src, &a) == 0) continue;
-			sip = ntohl(a.s_addr);
-			/* any LAN bridge, not just br0 - guest/SDN clients live on their
-			   own subnets and used to be dropped here entirely */
-			if ((br = ip_bridge(sip)) == NULL) continue;
-			/* the router's own LAN address is not a client. It reaches here via
-			   the health probe and any router-sourced LAN traffic; crediting it
-			   as a device is the "router appears as a device row" backlog item.
-			   Bucket it with the router instead. */
-			if (lan_ip && sip == lan_ip) br = NULL;
+			int cli_dst = 0;	/* the device is the REPLY side of the flow */
+
+			mac[0] = '\0';
+			if (!v6) {
+				if (inet_aton(src, &a) == 0) continue;
+				sip = ntohl(a.s_addr);
+				/* any LAN bridge, not just br0 - guest/SDN clients live on their
+				   own subnets and used to be dropped here entirely */
+				if ((br = ip_bridge(sip)) == NULL) continue;
+				/* the router's own LAN address is not a client. It reaches here via
+				   the health probe and any router-sourced LAN traffic; crediting it
+				   as a device is the "router appears as a device row" backlog item.
+				   Bucket it with the router instead. */
+				if (lan_ip && sip == lan_ip) br = NULL;
+			} else {
+				/* v6 is not translated, so both ends are routable and either
+				   may be the local device - a subnet test cannot tell them
+				   apart the way ip_bridge() does for v4. The neighbour cache
+				   is the authority on "this address is a client of mine"; a
+				   flow with neither end in it is the router's own or transit. */
+				unsigned char s6[16], d6[16];
+
+				if (inet_pton(AF_INET6, src, s6) != 1) continue;
+				if (inet_pton(AF_INET6, dst, d6) != 1) continue;
+				if (s6[0] == 0xff || d6[0] == 0xff) continue;	/* multicast */
+				if (nd_lookup(s6, mac, sizeof(mac), &br)) {
+					/* device originated: orig=upload, reply=download */
+				} else if (nd_lookup(d6, mac, sizeof(mac), &br)) {
+					cli_dst = 1;
+				} else if (is_self6(s6) || is_self6(d6)) {
+					br = NULL;		/* the router's own */
+				} else {
+					continue;		/* not attributable */
+				}
+			}
 
 			snprintf(kbuf, sizeof(kbuf), "%d/%s/%s/%d/%d", pnum, src, dst, sport, dport);
 			key = fnv64(kbuf);
@@ -1008,6 +1193,17 @@ static void poll_conntrack(void)
 
 			if (dob == 0 && drb == 0) continue;
 
+			/* The key and the deltas above are built from the RAW conntrack
+			 * tuple and stay that way whichever end we credit. That is
+			 * deliberate: if the key tracked the credited end, a neighbour
+			 * entry expiring would change it, the `fl->key == key` test would
+			 * miss, and the flow's WHOLE cumulative byte count would be
+			 * credited as a single delta - a 100 GB spike on one sample.
+			 * Only the presentation is swapped, and only here. */
+			if (cli_dst) {
+				uint64_t t = dob; dob = drb; drb = t;
+			}
+
 			/* per-network (br0 / guest bridges / Router), from the same complete
 			   source as the per-device numbers - so br0 now reconciles with the
 			   WAN line instead of showing accelerated flows only */
@@ -1024,18 +1220,27 @@ static void poll_conntrack(void)
 				ring_add(r_cli[ci], drb, dob);
 				lv_cli_rx[ci] += drb * 8 / FCACHE_SECS;
 				lv_cli_tx[ci] += dob * 8 / FCACHE_SECS;
-				top_note(src, dst, dport, pnum, dob, drb);
+				top_note(src, dst, dport, pnum, dob, drb, NULL);
 				continue;
 			}
-			if (!arp_mac(src, mac, sizeof(mac)))
-				strlcpy(mac, src, sizeof(mac));
-			ci = cli_slot(mac, src);
+			if (!v6) {
+				if (!arp_mac(src, mac, sizeof(mac)))
+					strlcpy(mac, src, sizeof(mac));
+				ci = cli_slot(mac, src);
+			} else {
+				/* mac came from the neighbour cache above; keep the label */
+				ci = cli_slot_keep(mac);
+			}
 			ring_add(r_cli[ci], drb, dob);	/* rx=download(reply), tx=upload(orig) */
 			/* live per-device rates, same bits/sec convention as the rings.
 			 * The caller zeroes the lv_* accumulators before this pass. */
 			lv_cli_rx[ci] += drb * 8 / FCACHE_SECS;
 			lv_cli_tx[ci] += dob * 8 / FCACHE_SECS;
-			top_note(src, dst, dport, pnum, dob, drb);
+			/* show the DEVICE end as the row's source, and the port that names
+			 * the service, whichever direction the flow was opened from */
+			top_note(cli_dst ? dst : src, cli_dst ? src : dst,
+				 cli_dst ? sport : dport, pnum, dob, drb,
+				 v6 ? mac : NULL);
 		}
 	}
 	fclose(f);
diff --git a/release/src/router/www/BR.dict b/release/src/router/www/BR.dict
index 04b046ee41..021030580d 100644
--- a/release/src/router/www/BR.dict
+++ b/release/src/router/www/BR.dict
@@ -5550,7 +5550,7 @@ RTRF_41=Guia do Analisador de Tráfego
 RTRF_42=Onde meu histórico é armazenado?
 RTRF_43=Escolha em Configurações: <b>RAM</b> (padrão, limpo ao reiniciar), <b>JFFS</b> (flash interna, sobrevive à reinicialização) ou <b>USB</b> (um disco conectado, mais espaço). Qualquer coisa mais longa que a visão ao vivo precisa de JFFS ou USB se você quiser que sobreviva a uma reinicialização. O coletor grava um snapshot a cada hora, então um desligamento abrupto perde no máximo a última hora.
 RTRF_44=Quão precisos são os números por dispositivo?
-RTRF_45=Eles vêm da tabela do <b>acelerador de fluxo por hardware</b> do roteador &mdash; o mesmo motor que encaminha seu tráfego &mdash; então fluxos descarregados (a maior parte da taxa de transferência neste roteador) são contados com precisão, não perdidos. Os totais são exatos dentro de um intervalo de sondagem; um fluxo muito curto que abre e fecha entre sondagens pode ser subcontado ligeiramente. Dispositivos aparecem como um IP puro até que o mapa de rede os nomeie. IPv6 conta para o total da WAN mas ainda não é dividido por dispositivo.
+RTRF_45=They come from the kernel's <b>connection tracking</b> table, which on this router already includes the bytes the hardware accelerator forwarded &mdash; so offloaded flows (the bulk of throughput here) are counted, not missed. Totals are exact to within a poll interval; a very short flow that opens and closes between polls can undercount slightly. Devices show as a bare IP until the network map names them. <b>IPv4 and IPv6 are both counted per-device</b>: a dual-stack device is one row, matched on its MAC address rather than on either of its addresses.
 RTRF_46=Por que o gráfico por classe está vazio?
 RTRF_47=Dados por classe só existem enquanto o <b>QoS HW Classful</b> (Traffic Manager) for o motor ativo &mdash; é isso que cria as cinco filas de upload que este lê. Em qualquer outro modo de QoS o gráfico de classe fica em branco; todo o resto continua funcionando.
 RTRF_48=O que são ”maiores consumidores”?
@@ -6581,3 +6581,5 @@ RFW_251=Example: a device cannot reach a service and you do not know which rule
 RDEV_88=Export list
 RDEV_89=Export
 RDEV_90=The file contains real device names, MAC and IP addresses. Keep it somewhere private - it is not safe to post in a forum or attach to a bug report.
+RTRF_75=Upload only
+RTRF_76=The QoS engine classifies and shapes the upload direction only, so download traffic never reaches these queues and does not appear in this chart.
diff --git a/release/src/router/www/CN.dict b/release/src/router/www/CN.dict
index 34212ea4f7..2a2681d470 100644
--- a/release/src/router/www/CN.dict
+++ b/release/src/router/www/CN.dict
