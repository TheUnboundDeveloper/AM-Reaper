@@ -123,6 +123,11 @@ h1,h2{font-family:var(--hdr);letter-spacing:.04em;color:var(--bone);margin:0}
       <span class="stat ok" id="schedStat" style="margin-top:0;display:none">&#10003;</span>
     </div>
     <p class="note"><#RFWU_15#></p>
+    <div class="tgl" id="schedTimeRow" style="display:none;margin-top:10px">
+      <label for="schedHour" class="note" style="margin-top:0"><#RFWU_45#></label>
+      <select id="schedHour" onchange="schedSave()"></select>
+    </div>
+    <p class="note" id="schedTimeNote" style="display:none"><#RFWU_47#></p>
   </div>
 </div>
 
@@ -186,6 +191,7 @@ var FW = {
   upd:  '<% nvram_get("webs_state_update"); %>'
 };
 var CHK_EN = '<% nvram_get("firmware_check_enable"); %>';
+var CHK_HR = '<% nvram_get("firmware_check_hour"); %>';
 /* the noMCP build stamps "_noMCP" into EXTENDNO (same signal the backend
    scripts read from the filesystem) - no extra probe needed */
 var IS_MCP = EXTENDNO.indexOf('_noMCP') < 0;
@@ -632,9 +638,37 @@ function pollBack(tries, wentDown){
 
 /* ---------------- scheduled check ---------------- */
 
+/* The hour picker only means anything while the check is enabled, so it rides
+   the same toggle and the same save. '' = automatic, which the watchdog reads as
+   "keep 2 am + the random offset"; 0-23 pins the hour, and the minute inside it
+   stays random either way (auto_firmware_check_reaper, rc/watchdog.c). */
+function schedTimeVis(){
+  var on = $id('schedChk').checked;
+  $id('schedTimeRow').style.display  = on ? 'flex' : 'none';
+  $id('schedTimeNote').style.display = on ? ''     : 'none';
+}
+
+function schedFill(){
+  var s = $id('schedHour'), i, o;
+  if(!s || s.options.length) return;
+  o = document.createElement('option');
+  o.value = ''; o.textContent = `<#RFWU_46#>`;
+  s.appendChild(o);
+  for(i = 0; i < 24; i++){
+    o = document.createElement('option');
+    o.value = String(i);
+    o.textContent = (i < 10 ? '0' : '') + i + ':00';
+    s.appendChild(o);
+  }
+  s.value = CHK_HR || '';
