+
+  <!-- Breakdown of the "Blocked hits" total, plus the window it covers.
+       Filled by rwRenderBreakdown(); stays hidden until there is something
+       to show. Sits here because these numbers reconcile against the table
+       below, not against the big total in the stat card. -->
+  <div class="bdown" id="s_bdown"></div>
+
   <table class="toptbl" id="toptbl">
     <thead><tr><th style="width:44px">#</th><th><#RWDN_47#></th><th class="cnt"><#RWDN_48#></th></tr></thead>
     <tbody id="topbody"><tr><td colspan="3" class="empty"><#RWDN_49#></td></tr></tbody>
@@ -354,6 +365,25 @@ function rwAgo(ep){
   return Math.floor(d/86400) + ` <#RGK_48#>`;
 }
 
+/* One label/value pair for the breakdown strip above the country table.
+   Built as DOM nodes with textContent, never innerHTML: these labels are dict
+   values, and a translation is not a place to trust for markup safety. */
+function rwBdItem(label, value, isWindow){
+  var d = document.createElement('div');
+  d.className = isWindow ? 'bd win' : 'bd';
+  var k = document.createElement('span');
+  k.className = 'bk';
+  k.textContent = label;
+  d.appendChild(k);
+  if(value !== ''){
+    var v = document.createElement('span');
+    v.className = 'bv';
+    v.textContent = value;
+    d.appendChild(v);
+  }
+  return d;
+}
+
 function rwToggleMaster(){
   var el = document.getElementById('tgmaster');
   var on = el.className.indexOf('on') >= 0;
@@ -483,34 +513,32 @@ function rwStats(){
     var b = j.blocked || {};
     document.getElementById('s_blocked').textContent =
       (typeof b.total === 'number') ? b.total.toLocaleString() : '\u2014';
