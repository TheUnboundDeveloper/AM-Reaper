+    var bd = document.getElementById('s_bdown');
+    if(bd){
+      var pairs = [];
       if(typeof b.geo === 'number'){
-        var parts = [];
-        parts.push(`<#RWDN_73#>` + ' ' + Number(b.geo||0).toLocaleString());
-        parts.push(`<#RWDN_74#>` + ' ' + Number(b.threat||0).toLocaleString());
-        if(b.ban  > 0) parts.push(`<#RWDN_75#>` + ' ' + Number(b.ban).toLocaleString());
-        if(b.uncl > 0) parts.push(`<#RWDN_76#>` + ' ' + Number(b.uncl).toLocaleString());
-        /* ASCII separator (standing rule 1) - this is textContent, so an
-           HTML entity would render literally. */
-        sp.textContent = parts.join('  |  ');
-      } else sp.textContent = '';
+        pairs.push([`<#RWDN_73#>`, Number(b.geo||0).toLocaleString(), 0]);
+        pairs.push([`<#RWDN_74#>`, Number(b.threat||0).toLocaleString(), 0]);
