-    if(sc){
-      if(j.save === 0){ sc.textContent = `<#RWDN_68#>`; }
-      else if(b.since > 0){ sc.textContent = `<#RWDN_67#>` + ' ' + new Date(b.since*1000).toLocaleDateString(); }
-      else { sc.textContent = ''; }
