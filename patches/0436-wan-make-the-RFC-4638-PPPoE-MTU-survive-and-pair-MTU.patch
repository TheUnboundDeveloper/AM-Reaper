+*/
 		});
 	}
 	else{
@@ -500,8 +511,6 @@ function display_upnp_options(){
 	document.getElementById("upnp_range_int").style.display = (document.form.wan_upnp_enable[0].checked) ? "" : "none";
 	document.getElementById("upnp_range_ext").style.display = (document.form.wan_upnp_enable[0].checked) ? "" : "none";
 	document.getElementById("upnp_secure_tr").style.display = (document.form.wan_upnp_enable[0].checked) ? "" : "none";
-	/* reaper 2026-08-11: router-service-port protection follows the master UPnP switch */
-	document.getElementById("upnp_protect_svc_tr").style.display = (document.form.wan_upnp_enable[0].checked) ? "" : "none";
 	if (igd2_support) {
 		document.getElementById("upnp_pinhole").style.display = (document.form.wan_upnp_enable[0].checked) ? "" : "none";
 	} else {
@@ -2193,6 +2202,20 @@ function updatDNSListOnline(){
 				return local_data[e];
 		});
 		Update_DNS_status();
+/*
+		$.getJSON("https://nw-dlcdnet.asus.com/plugin/js/DNS_List.json",
+			function(cloud_data){
+				if(JSON.stringify(local_data) != JSON.stringify(cloud_data)){
+					if(Object.keys(cloud_data).length > 0){
+						DNSService = Object.keys(cloud_data).map(function(e){
+							return cloud_data[e];
+						});
+						Update_DNS_status();
+					}
+				}
+			}
+		);
+*/
 	});
 }
 
@@ -2611,21 +2634,11 @@ function get_default_wan_name(){
 									<input type="radio" name="wan_upnp_enable" class="input" value="0" onclick="display_upnp_options();return change_common_radio(this, 'LANHostConfig', 'wan_upnp_enable', '0')" <% nvram_match("wan_upnp_enable", "0", "checked"); %>><#checkbox_No#>
 								</td>
 							</tr>
-							<!-- reaper 2026-08-11: this row used to read "Enable IGDv2 (IPv6 pinhole
-							     support)" and it bundled two unrelated things - it selected the
-							     miniupnpd-igdv2 binary, so turning it OFF also silently dropped the
-							     router to IGD:1 on IPv4 and gave up AddAnyPortMapping (the "port
-							     already taken, give me any free one" action that stops two consoles
-							     or two torrent clients from colliding) and GetListOfPortMappings.
-							     The plain daemon is now built with --igd2 as well, so IGD:2 is always
-							     on and this switch controls only what its name says: the IPv6
-							     firewall-pinhole service (WANIPv6FirewallControl). -->
 							<tr id="upnp_pinhole">
-								<th><a class="hintstyle" href="javascript:void(0);" onClick="openHint(50,5);">UPnP: Allow IPv6 pinholes (IGD:2 firewall control)</a></th>
+								<th><a class="hintstyle" href="javascript:void(0);" onClick="openHint(50,5);">Enable IGDv2 (IPv6 pinhole support)</a></th>
 								<td>
 									<input type="radio" name="upnp_pinhole_enable" class="input" value="1" onclick="display_upnp_options();" <% nvram_match("upnp_pinhole_enable", "1", "checked"); %>><#checkbox_Yes#>
 									<input type="radio" name="upnp_pinhole_enable" class="input" value="0" onclick="display_upnp_options();" <% nvram_match("upnp_pinhole_enable", "0", "checked"); %>><#checkbox_No#>
-									<div style="color:#FFCC00;font-size:11px;margin-top:3px;">Lets IPv6 clients open a firewall hole straight to themselves. IPv4 port mapping and PCP are unaffected by this setting.</div>
 								</td>
 							</tr>
 							<tr id="upnp_secure_tr">
@@ -2635,20 +2648,6 @@ function get_default_wan_name(){
 									<input type="radio" name="upnp_secure" class="input" value="0" <% nvram_match_x("", "upnp_secure", "0", "checked"); %>><#checkbox_No#>
 								</td>
 							</tr>
-							<!-- reaper 2026-08-11: VUPNP hooks nat/PREROUTING, which is evaluated
-							     before the routing decision, so a UPnP/PCP mapping on one of the
-							     router's OWN inbound ports takes that traffic away from the router
-							     entirely. secure_mode does not help - mapping the VPN port to
-							     yourself IS the attack. Default on; exposed so it can be turned off
-							     if someone deliberately wants a LAN host to take one of these over. -->
-							<tr id="upnp_protect_svc_tr">
-								<th>UPnP: Protect router service ports</th>
-								<td>
-									<input type="radio" name="upnp_protect_svc" class="input" value="1" <% nvram_match_x("", "upnp_protect_svc", "1", "checked"); %>><#checkbox_Yes#>
-									<input type="radio" name="upnp_protect_svc" class="input" value="0" <% nvram_match_x("", "upnp_protect_svc", "0", "checked"); %>><#checkbox_No#>
-									<div style="color:#FFCC00;font-size:11px;margin-top:3px;">Refuses UPnP/PCP requests for the ports this router listens on itself &mdash; OpenVPN, WireGuard, IPSec, SSH and web admin &mdash; so a LAN device cannot intercept inbound traffic meant for the router.</div>
-								</td>
-							</tr>
 							<tr id="upnp_range_int">
 								<th>UPNP: Allowed internal port range</th>
 									<td>
