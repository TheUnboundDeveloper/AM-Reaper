From e2e8085348cde5ddfc85db99878e5848b98d1fe9 Mon Sep 17 00:00:00 2001
From: reaper <theunbounddeveloper@outlook.com>
Date: Sun, 16 Aug 2026 06:00:12 -0400
Subject: [PATCH] www: tokenize the last hardcoded strings on three Reaper
 pages

A visible string that is not a <#KEY#> ignores preferred_lang entirely. Sweeping
the Reaper pages found four left: the Drop/Accept options and the Both option on
the two firewall logging selects, the QoS diagnostics page title, and two topbar
button titles on the shell. Drop/Accept/the titles reuse keys that already exist;
Both needed one new key.

Co-Authored-By: Claude Opus 5 (1M context) <noreply@anthropic.com>
---
 release/src/router/www/Reaper_Firewall.asp | 12 ++++++------
 release/src/router/www/Reaper_QoSDiag.asp  |  2 +-
 release/src/router/www/reaper_shell.asp    |  4 ++--
 3 files changed, 9 insertions(+), 9 deletions(-)

diff --git a/release/src/router/www/Reaper_Firewall.asp b/release/src/router/www/Reaper_Firewall.asp
index 924006510c..602ec8b46d 100644
--- a/release/src/router/www/Reaper_Firewall.asp
+++ b/release/src/router/www/Reaper_Firewall.asp
@@ -208,9 +208,9 @@ table.ipt td.hit{color:var(--amber)}
       <span class="lbl"><#RFW_48#></span>
       <select class="fld s" id="g_log">
         <option value="none"><#RFW_100#></option>
-        <option value="drop">Drop</option>
-        <option value="accept">Accept</option>
-        <option value="both">Both</option>
+        <option value="drop"><#RFW_139#></option>
+        <option value="accept"><#RFW_138#></option>
+        <option value="both"><#RFW_252#></option>
       </select>
     </div>
     <div class="row" style="margin-top:14px">
@@ -567,9 +567,9 @@ table.ipt td.hit{color:var(--amber)}
       <span>
         <select class="fld s" id="l_log">
           <option value="none"><#RFW_100#></option>
-          <option value="drop">Drop</option>
-          <option value="accept">Accept</option>
-          <option value="both">Both</option>
+          <option value="drop"><#RFW_139#></option>
+          <option value="accept"><#RFW_138#></option>
+          <option value="both"><#RFW_252#></option>
         </select>
         <button class="btn sm" id="l_apply" style="margin-left:8px"><#RFW_62#></button>
         <span class="saved hidden" id="l_saved"></span>
diff --git a/release/src/router/www/Reaper_QoSDiag.asp b/release/src/router/www/Reaper_QoSDiag.asp
index 571e9b8ead..d3665df00c 100644
--- a/release/src/router/www/Reaper_QoSDiag.asp
+++ b/release/src/router/www/Reaper_QoSDiag.asp
@@ -4,7 +4,7 @@
 <meta charset="utf-8">
 <meta name="viewport" content="width=device-width, initial-scale=1">
 <meta name="reaper-native" content="1">
-<title>REAPER &mdash; QoS Diagnostics</title>
+<title>REAPER &mdash; <#RQD_00#></title>
 <style>
 @font-face{font-family:'Rajdhani';font-weight:600;font-display:swap;src:url('/fonts/rajdhani-600.woff2') format('woff2')}@font-face{font-family:'Rajdhani';font-weight:700;font-display:swap;src:url('/fonts/rajdhani-700.woff2') format('woff2')}@font-face{font-family:'Inter';font-weight:400;font-display:swap;src:url('/fonts/inter-400.woff2') format('woff2')}@font-face{font-family:'Inter';font-weight:500;font-display:swap;src:url('/fonts/inter-500.woff2') format('woff2')}@font-face{font-family:'Inter';font-weight:600;font-display:swap;src:url('/fonts/inter-600.woff2') format('woff2')}
 :root{--bg:#08080a;--panel:#0f0f12;--panel2:#141418;--raised:#17171c;
diff --git a/release/src/router/www/reaper_shell.asp b/release/src/router/www/reaper_shell.asp
index c233320c03..29032b16b0 100644
--- a/release/src/router/www/reaper_shell.asp
+++ b/release/src/router/www/reaper_shell.asp
@@ -138,7 +138,7 @@ a.item.on::before{content:"";position:absolute;left:0;top:7px;bottom:7px;width:2
 <body>
 <div class="app">
   <header class="top">
-    <a class="brand" href="/Main_ReaperDash.asp" title="REAPER dashboard"><img src="/images/RT-96U_REAPER_Header.png" alt="REAPER"></a>
+    <a class="brand" href="/Main_ReaperDash.asp" title="REAPER <#Reaper_c_dashboard#>"><img src="/images/RT-96U_REAPER_Header.png" alt="REAPER"></a>
     <div class="pills">
       <div class="pill"><span class="dot" id="p_wan_dot"></span><span class="k"><#menu5_3#></span><span class="v" id="p_wan">&mdash;</span></div>
       <div class="pill"><span class="k"><#DSL_Mode#></span><span class="v" id="i_opmode">&mdash;</span></div>
@@ -162,7 +162,7 @@ a.item.on::before{content:"";position:absolute;left:0;top:7px;bottom:7px;width:2
   </aside>
   <main class="stage">
     <div id="tabbar"></div>
-    <iframe id="page_frame" name="reaper_frame" title="settings page" scrolling="no"></iframe>
+    <iframe id="page_frame" name="reaper_frame" title="<#Settings#>" scrolling="no"></iframe>
   </main>
 </div>
 
