-RWDN_74=Threat feeds:
-RWDN_75=Manual blocks:
-RWDN_76=Unclassified:
+RWDN_73=Países:
+RWDN_74=Feeds de ameaças:
+RWDN_75=Bloqueios manuais:
+RWDN_76=Não classificados:
 RDST_64=Não salvo
 RFB_15=Defina a senha do Wi-Fi
 RFB_16=A rede sem fio ainda usa a senha de fábrica. Defina uma nova abaixo para concluir a configuração.
@@ -6583,3 +6583,4 @@ RDEV_89=Export
 RDEV_90=The file contains real device names, MAC and IP addresses. Keep it somewhere private - it is not safe to post in a forum or attach to a bug report.
 RTRF_75=Upload only
 RTRF_76=The QoS engine classifies and shapes the upload direction only, so download traffic never reaches these queues and does not appear in this chart.
+RFW_252=Both
