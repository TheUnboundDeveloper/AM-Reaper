     <script>(function(){var us="<% uptime(); %>";var nf=us.substring(8,11)+" "+us.substring(5,7)+" "+us.substring(17,25)+" "+us.substring(12,16);var b=Date.parse(nf);var et=document.getElementById('rc_time'),ed=document.getElementById('rc_date');if(!et||isNaN(b))return;var t0=Date.now();var DW=[`<#date_Sun_itemdesc#>`,`<#date_Mon_itemdesc#>`,`<#date_Tue_itemdesc#>`,`<#date_Wed_itemdesc#>`,`<#date_Thu_itemdesc#>`,`<#date_Fri_itemdesc#>`,`<#date_Sat_itemdesc#>`],MO=[`<#Reaper_c_mon_0#>`,`<#Reaper_c_mon_1#>`,`<#Reaper_c_mon_2#>`,`<#Reaper_c_mon_3#>`,`<#Reaper_c_mon_4#>`,`<#Reaper_c_mon_5#>`,`<#Reaper_c_mon_6#>`,`<#Reaper_c_mon_7#>`,`<#Reaper_c_mon_8#>`,`<#Reaper_c_mon_9#>`,`<#Reaper_c_mon_10#>`,`<#Reaper_c_mon_11#>`];function p2(n){return(n<10?'0':'')+n;}function tk(){var d=new Date(b+(Date.now()-t0));et.innerHTML=p2(d.getHours())+':'+p2(d.getMinutes())+':<span class="rc-sec">'+p2(d.getSeconds())+'</span>';if(ed)ed.textContent=DW[d.getDay()]+' '+d.getDate()+' '+MO[d.getMonth()]+' '+d.getFullYear();}tk();setInterval(tk,1000);})();</script>
