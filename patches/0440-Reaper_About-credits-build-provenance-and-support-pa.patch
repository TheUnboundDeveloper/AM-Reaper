+<script>
+/* Provenance comes from /reaper_provenance.js, which the BUILD stamps - never
+   hardcoded here, or the page would confidently show the wrong patch count one
+   release after somebody forgot to edit it. Absent or empty renders as a dash,
+   which is honest; a stale number is not. */
+(function(){
+	var P = (typeof REAPER_PROV === 'object' && REAPER_PROV) ? REAPER_PROV : {};
+	function put(id, v){
+		var el = document.getElementById(id);
+		if(el && v) el.textContent = v;          /* textContent: never innerHTML */
+	}
+	put('p_ver', P.version);
+	put('p_var', P.variant);
+	put('p_patches', P.patches);
+	put('p_built', P.built);
+	if(P.base){
+		put('p_base', String(P.base).substring(0, 10));
+		put('p_base2', String(P.base).substring(0, 10));
+	}
+})();
+</script>
