+.railabout{margin-top:auto;padding-top:13px;border-top:1px solid var(--line-soft);
+  display:flex;align-items:center;gap:10px;text-decoration:none}
+.railabout .sig{flex:0 0 auto;width:38px;height:38px;border-radius:10px;display:grid;place-items:center;
+  background:var(--panel-2);border:1px solid var(--line-soft);
+  transition:border-color .16s,background .16s}
+.railabout .sig svg{width:22px;height:22px;display:block}
+.railabout .sig .bl{fill:#E10600;fill-opacity:.85;transition:fill-opacity .16s}
+.railabout .sig .sh{stroke:#ECE7DB;stroke-opacity:.66;transition:stroke-opacity .16s}
+.railabout:hover .sig{border-color:var(--crimson);background:var(--panel-3)}
+.railabout:hover .sig .bl{fill-opacity:1}
+.railabout:hover .sig .sh{stroke-opacity:1}
+.railabout .t{display:block;font-family:var(--hdr);font-weight:600;font-size:12px;
+  letter-spacing:.13em;text-transform:uppercase;color:var(--bone-dim);line-height:1.15}
+.railabout:hover .t{color:var(--bone)}
+.railabout .v{display:block;font-size:10.5px;color:var(--steel);margin-top:2px;
+  font-variant-numeric:tabular-nums}
 .grp{font-family:var(--hdr);text-transform:uppercase;letter-spacing:.2em;font-size:10px;color:var(--steel);padding:12px 10px 4px}
 a.item{display:flex;align-items:center;gap:12px;height:38px;border-radius:9px;color:var(--steel);
   text-decoration:none;padding:0 12px;position:relative;transition:.15s;
@@ -159,6 +175,13 @@ a.item.on::before{content:"";position:absolute;left:0;top:7px;bottom:7px;width:2
