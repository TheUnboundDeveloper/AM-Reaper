+++ b/release/src/router/www/reaper_shell.asp
@@ -317,6 +317,9 @@ var ICONS = {
   menu_OpenNAT:        '<svg viewBox="0 0 24 24"><path d="M7 8l-4 4 4 4M17 8l4 4-4 4M14 6l-4 12"/></svg>',
   menu_APP:            '<svg viewBox="0 0 24 24"><rect x="4" y="5" width="16" height="14" rx="2"/><path d="M8 5v14"/></svg>',
   menu_ReaperDevices:  '<svg viewBox="0 0 24 24"><rect x="4" y="4" width="7" height="7" rx="1"/><rect x="13" y="4" width="7" height="7" rx="1"/><rect x="4" y="13" width="7" height="7" rx="1"/><rect x="13" y="13" width="7" height="7" rx="1"/></svg>',
+  /* same puzzle-piece glyph Main_ReaperDash.asp draws for its addon rail group,
+     so an addon looks identical on the dashboard and inside the shell */
+  menu_Addons:         '<svg viewBox="0 0 24 24"><path d="M10 4h4v3a2 2 0 0 0 2 2h3v4h-3a2 2 0 0 0-2 2v3h-4v-3a2 2 0 0 0-2-2H5V9h3a2 2 0 0 0 2-2z"/></svg>',
   menu_AiCloud:        '<svg viewBox="0 0 24 24"><path d="M7 17a4 4 0 0 1 .6-8 5 5 0 0 1 9.6 1.4A3.5 3.5 0 0 1 17 17z"/></svg>',
   menu_Tool:           '<svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 11v5M12 8h.01"/></svg>',
   menu_Wireless:       '<svg viewBox="0 0 24 24"><path d="M4 9a12 12 0 0 1 16 0M7 12a8 8 0 0 1 10 0M10 15a4 4 0 0 1 4 0"/><circle cx="12" cy="18" r="1"/></svg>',
@@ -448,6 +451,38 @@ function buildRail(menuTree){
     if(exMenus.indexOf(m.index)!==-1) continue;
     if(m.index==='menu_QIS') continue;
     if(m.index==='menu_Split'){ h+='<div class="grp">'+esc(m.menuName)+'</div>'; continue; }
+    /* reaper 2026-08-17 field fix: "addons are listed individually on the
+       dashboard but collapse to one 'Addons' entry on every other page".
+
+       Installed addons are TABS under a single menu_Addons menu, so the
+       one-item-per-menu rule below renders the whole set as a lone link, while
+       Main_ReaperDash.asp - the one top-level page with its own rail, which
+       parses menuTree.js itself - lists each addon. Expand them here so the
+       rail is the same everywhere: a group header plus one entry per addon,
+       matching the shape the dashboard already produces.
+
+       menuTree.js is the file third-party addons BIND-MOUNT over, so nothing
+       here is trusted: labels go through esc(), and a target that is not a
+       bare same-origin page is opened in a new tab by isExternalUrl() rather
+       than framed - the same treatment the tab bar gives these entries. If no
+       tab survives filtering, nothing is emitted, not even the header, so a
+       box with no addons keeps the rail exactly as it ships. */
+    if(m.index==='menu_Addons'){
+      var ai='', ta, an;
+      for(var a=0;a<(m.tab||[]).length;a++){
+        ta=m.tab[a];
+        if(!ta||!ta.url||ta.url==='NULL') continue;
+        if(exTabs.indexOf(ta.url)!==-1) continue;
+        if(ta.tabName==='__HIDE__'||ta.tabName==='__INHERIT__') continue;
+        an=ta.tabName||ta.url;
+        if(isExternalUrl(ta.url))
+          ai+='<a class="item" href="'+esc(ta.url)+'" target="_blank" rel="noopener noreferrer">'+ICONS.menu_Addons+'<span class="rtip">'+esc(an)+'</span></a>';
+        else
+          ai+='<a class="item" href="/reaper_shell.asp#'+esc(ta.url)+'" data-page="'+esc(ta.url)+'" data-pages="'+esc(ta.url)+'">'+ICONS.menu_Addons+'<span class="rtip">'+esc(an)+'</span></a>';
+      }
+      if(ai) h+='<div class="grp">'+esc(m.menuName)+'</div>'+ai;
+      continue;
+    }
     var first=-1, pages=[];
     for(var j=0;j<(m.tab||[]).length;j++){
       var t=m.tab[j];
