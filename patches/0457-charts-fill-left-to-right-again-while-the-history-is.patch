@@ -170,7 +170,7 @@ canvas{display:block;width:100%;height:120px}
   "use strict";
   var ENDPOINT="/reaper_qdiag.cgi";
   var COLORS=["#4FB286","#7EA6C9","#E0A93B","#E10600","#C77DFF","#5AD1C4","#B7B1A4","#8894a0"];
-  var HIST=45, state={objs:[],selObj:null,selQ:null,qos:{},prev:{},occHist:{},dropHist:[]};
+  var HIST=45, state={objs:[],selObj:null,selQ:null,qos:{},prev:{},occHist:{},dropHist:[],t0:null};
 
   /* ---- live chart engine (v2.4.6) ---------------------------------------
      Same treatment as Reaper_Traffic.asp got in v2.4.5, for the same reason.
@@ -333,6 +333,9 @@ canvas{display:block;width:100%;height:120px}
     // history - time-stamped [t, value]; the frame loop places x from t, so the
     // ring is trimmed by age rather than by a fixed sample count.
     var tn=nowMs();
+    /* first sample of this run: anchors the left edge until the ring has a
+       full window of history - see the tx computation in liveFrame(). */
+    if(state.t0==null) state.t0=tn;
     o.queues.forEach(function(q){ var h=state.occHist[q.qid]=state.occHist[q.qid]||[]; pushSamp(h,tn,q.pct||0); });
     var td=0; o.queues.forEach(function(q){ td+=q.dropRate; }); pushSamp(state.dropHist,tn,td);
   }
@@ -363,7 +366,7 @@ canvas{display:block;width:100%;height:120px}
       document.getElementById("pselwrap").innerHTML= state.objs.length?('<select id="psel">'+state.objs.map(function(x){
         return '<option value="'+x.index+'"'+(x.index===state.selObj?" selected":"")+'>'+esc(x.port)+' &middot; '+(x.dir==="us"?`<#CTL_upload#>`:`<#InternetSpeed_Download#>`)+(x.shaped?` &middot; <#RQD_44#>`:"")+'</option>';}).join("")+'</select>'):"";
       ps=document.getElementById("psel");
-      if(ps)ps.onchange=function(){state.selObj=+ps.value;state.selQ=null;state.occHist={};state.dropHist=[];fetchOnce();};
+      if(ps)ps.onchange=function(){state.selObj=+ps.value;state.selQ=null;state.occHist={};state.dropHist=[];state.t0=null;fetchOnce();};
     }else if(ps&&document.activeElement!==ps&&ps.value!==String(state.selObj)){ ps.value=String(state.selObj); }
     document.getElementById("qtag").innerHTML= o?("egress_tm/index="+o.index+" &middot; "+esc(o.port)):"rdpa egress_tm";
     document.getElementById("stag").textContent= o?modeName(o.mode):"";
@@ -447,24 +450,24 @@ canvas{display:block;width:100%;height:120px}
   window.addEventListener("resize",function(){ for(var k in cvCache) cvCache[k].dirty=true; });
   function grid(x,w,h){ x.clearRect(0,0,w,h); x.strokeStyle="rgba(236,231,219,.06)"; x.lineWidth=1; for(var i=1;i<4;i++){var y=h*i/4;x.beginPath();x.moveTo(0,y);x.lineTo(w,y);x.stroke();} }
 
-  function drawOcc(t1,span){
+  function drawOcc(t1,span,tx){
     var c=setupCanvas(document.getElementById("occcv")); grid(c.x,c.w,c.h);
     var o=cur(); if(!o) return;
     o.queues.slice().sort(function(a,b){return a.qid-b.qid;}).forEach(function(q){
       var pts=clipSamples(state.occHist[q.qid]||[],t1-span,t1); if(pts.length<2)return;
       c.x.beginPath();
-      pts.forEach(function(p,i){ var X=xAt(p[0],t1,span,c.w),Y=c.h-(p[1]/100)*c.h; i?c.x.lineTo(X,Y):c.x.moveTo(X,Y); });
+      pts.forEach(function(p,i){ var X=xAt(p[0],tx,span,c.w),Y=c.h-(p[1]/100)*c.h; i?c.x.lineTo(X,Y):c.x.moveTo(X,Y); });
       c.x.strokeStyle=COLORS[q.qid%8]; c.x.lineWidth=q.qid===state.selQ?2.4:1.2;
       c.x.globalAlpha=q.qid===state.selQ?1:.6; c.x.stroke(); c.x.globalAlpha=1; });
   }
-  function drawDrops(t1,span,dt){
+  function drawDrops(t1,span,dt,tx){
     var c=setupCanvas(document.getElementById("dropcv")); grid(c.x,c.w,c.h);
     var pts=clipSamples(state.dropHist,t1-span,t1); if(pts.length<2)return;
     var raw=0,i; for(i=0;i<pts.length;i++) if(pts[i][1]>raw) raw=pts[i][1];
     var mx=dropScale.step(raw,t1,dt);
     function trace(){ c.x.beginPath();
-      pts.forEach(function(p,i){ var X=xAt(p[0],t1,span,c.w),Y=c.h-(p[1]/mx)*c.h*.92; i?c.x.lineTo(X,Y):c.x.moveTo(X,Y); }); }
-    trace(); c.x.lineTo(xAt(pts[pts.length-1][0],t1,span,c.w),c.h); c.x.lineTo(xAt(pts[0][0],t1,span,c.w),c.h); c.x.closePath();
+      pts.forEach(function(p,i){ var X=xAt(p[0],tx,span,c.w),Y=c.h-(p[1]/mx)*c.h*.92; i?c.x.lineTo(X,Y):c.x.moveTo(X,Y); }); }
+    trace(); c.x.lineTo(xAt(pts[pts.length-1][0],tx,span,c.w),c.h); c.x.lineTo(xAt(pts[0][0],tx,span,c.w),c.h); c.x.closePath();
     var g=c.x.createLinearGradient(0,0,0,c.h); g.addColorStop(0,"rgba(225,6,0,.34)"); g.addColorStop(1,"rgba(225,6,0,0)"); c.x.fillStyle=g; c.x.fill();
     trace(); c.x.strokeStyle="#E10600"; c.x.lineWidth=1.6; c.x.stroke();
   }
@@ -476,7 +479,18 @@ canvas{display:block;width:100%;height:120px}
     rafId=requestAnimationFrame(liveFrame);
     var t=nowMs(), dt=lastFrame?Math.min(500,t-lastFrame):16; lastFrame=t;
     var span=windowMs(), t1=t-lagMs();
-    drawOcc(t1,span); drawDrops(t1,span,dt);
+    /* reaper 2026-08-17: fill LEFT TO RIGHT while the ring is still short.
+       xAt() maps the right edge to t1, so anchoring t1 to "now" from the
+       first sample onward draws that sample at the right edge and grows the
+       trace leftward - the chart appeared to load from the wrong side. The
+       index-based code this replaced started at x=0 and grew rightward.
+       Holding the x-axis edge at t0+span until a full window has elapsed
+       restores that: oldest sample at x=0, newest at w*(elapsed/span),
+       reaching the right edge exactly when the window fills, after which tx
+       IS t1 and the window slides as before. t1 itself is left alone so the
+       drop-scale easing keeps using real time. */
+    var tx=(state.t0!=null && t1-state.t0<span) ? state.t0+span : t1;
+    drawOcc(t1,span,tx); drawDrops(t1,span,dt,tx);
   }
   function startDraw(){ if(rafId==null){ lastFrame=0; rafId=requestAnimationFrame(liveFrame); } }
   function stopDraw(){ if(rafId!=null){ cancelAnimationFrame(rafId); rafId=null; } }
diff --git a/release/src/router/www/Tools_Sysinfo.asp b/release/src/router/www/Tools_Sysinfo.asp
index 6dcbc8b15e..4d83840d5f 100644
--- a/release/src/router/www/Tools_Sysinfo.asp
+++ b/release/src/router/www/Tools_Sysinfo.asp
@@ -294,11 +294,19 @@ var temp_times = [];
 function temp_points(arr){
 	var pts = [], n = arr.length, m = temp_times.length, base = temp_times[m-1];
 	if (!m) return pts;
+	/* reaper 2026-08-17: fill LEFT TO RIGHT while the ring is still short.
+	   Pinning the newest sample to TEMP_SPAN_S put the very first reading at
+	   the right edge and grew the trace leftward, so the graph appeared to
+	   load from the wrong side; the 20-slot category axis it replaced started
+	   at the left and grew rightward. Scaling to the history actually held
+	   restores that - oldest at x=0, newest at the elapsed offset - and once
+	   the buffer spans the full window this is identical to TEMP_SPAN_S. */
+	var used = Math.min(TEMP_SPAN_S, (base - temp_times[0]) / 1000);
 	for (var i = 0; i < n; i++) {
 		var ti = m - n + i;
 		if (ti < 0) continue;
 		var age = (base - temp_times[ti]) / 1000;
-		pts.push({x: Math.max(0, TEMP_SPAN_S - age), y: arr[i]});
+		pts.push({x: Math.max(0, used - age), y: arr[i]});
 	}
 	return pts;
 }
