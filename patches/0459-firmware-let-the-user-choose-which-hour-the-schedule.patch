diff --git a/release/src/router/rc/watchdog.c b/release/src/router/rc/watchdog.c
index cee8439330..e34c819b12 100644
--- a/release/src/router/rc/watchdog.c
+++ b/release/src/router/rc/watchdog.c
@@ -12312,6 +12312,8 @@ void auto_firmware_check_reaper()
 	time_t now;
 	struct tm local;
 	static int rand_hr, rand_min;
+	int sched_hr;
+	const char *sched_hv;
 
 	if (!nvram_get_int("ntp_ready")){
 		return;
@@ -12335,7 +12337,18 @@ void auto_firmware_check_reaper()
 	time(&now);
 	localtime_r(&now, &local);
 
-	if(local.tm_hour == (2 + rand_hr) && local.tm_min == rand_min) { //at 2 am + random offset to check
+	/* reaper 2026-08-17: firmware_check_hour pins the HOUR when set to 0-23;
+	 * empty or out of range keeps the original 2 am + random offset. The
+	 * minute stays rand_min in BOTH cases on purpose: the check pulls a
+	 * GitHub-hosted manifest, so letting every router name the same exact
+	 * minute would concentrate the fleet into one request window. Pinning the
+	 * hour is what a user actually wants ("check overnight, not mid-day");
+	 * the minute within it is noise to them and load-spreading to us. */
+	sched_hv = nvram_get("firmware_check_hour");
+	sched_hr = (sched_hv && *sched_hv) ? atoi(sched_hv) : -1;
+	if (sched_hr < 0 || sched_hr > 23)
+		sched_hr = 2 + rand_hr;
+	if(local.tm_hour == sched_hr && local.tm_min == rand_min) {
 		periodic_check = 1;
 		period_retry = 0;
 	}
diff --git a/release/src/router/shared/defaults.c b/release/src/router/shared/defaults.c
index 86b47b5ea7..a73dedeb70 100644
--- a/release/src/router/shared/defaults.c
+++ b/release/src/router/shared/defaults.c
@@ -5295,6 +5295,13 @@ struct nvram_tuple router_defaults[] = {
 
 #ifdef RTCONFIG_MERLINUPDATE
 	{ "firmware_check_enable", "0", CKN_STR1, CKN_TYPE_DEFAULT, CKN_ACC_LEVEL_DEFAULT, CKN_ENC_DEFAULT, 0 },
+	/* reaper 2026-08-17: which HOUR the scheduled update check runs in. Empty =
+	   automatic, which is the behaviour that shipped before this key existed:
+	   02:00 plus a random 0-3 h offset drawn at boot. A value of 0-23 pins the
+	   hour; the MINUTE stays random either way, deliberately - the check fetches
+	   a GitHub-hosted manifest, and an exact shared time would put every router
+	   on the same minute. See auto_firmware_check_reaper() in rc/watchdog.c. */
+	{ "firmware_check_hour", "", CKN_STR2, CKN_TYPE_DEFAULT, CKN_ACC_LEVEL_DEFAULT, CKN_ENC_DEFAULT, 0 },
 #endif
 
 #ifdef RTCONFIG_SSH
