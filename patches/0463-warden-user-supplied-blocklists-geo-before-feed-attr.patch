 	{ "rwarden_feeds", "", CKN_STR512, CKN_TYPE_DEFAULT, CKN_ACC_LEVEL_DEFAULT, CKN_ENC_DEFAULT, 0 },	/* enabled threat-feed ids (space/comma list): firehol1 feodo spamhaus dshield */
+	{ "rwarden_cfeeds", "", CKN_STR_MAX, CKN_TYPE_DEFAULT, CKN_ACC_LEVEL_DEFAULT, CKN_ENC_DEFAULT, 0 },	/* user-supplied feeds: '<'-sep records of name>url>url6; url re-validated in rwarden.c before it reaches the generated fetcher */
 	{ "rwarden_geo", "", CKN_STR512, CKN_TYPE_DEFAULT, CKN_ACC_LEVEL_DEFAULT, CKN_ENC_DEFAULT, 0 },	/* 2-letter country codes to block (ipdeny), space/comma list */
 	{ "rwarden_dir", "in", CKN_STR4, CKN_TYPE_DEFAULT, CKN_ACC_LEVEL_DEFAULT, CKN_ENC_DEFAULT, 0 },	/* enforcement direction: in | out | both */
