  * single-quoted curl arg in the generated updater, and is a fixed literal here
  * (never user data). Country lists come from ipdeny (CC-BY). */
 struct rw_feed { const char *id; const char *url; const char *url6; };
+
+/* User-supplied ("custom") feeds. rwarden_cfeeds holds '<'-separated records of
+ * name>url>url6 (url6 optional). Bounds are deliberately small: this data is
+ * re-validated on every generation and a hostile value must not be able to make
+ * the generated script large or slow either. */
+#define RW_CFEED_MAX       8
+#define RW_CFEED_NAME_MAX  24
+#define RW_CFEED_URL_MAX   200
 static const struct rw_feed rw_feeds[] = {
 	{ "firehol1", "https://raw.githubusercontent.com/firehol/blocklist-ipsets/master/firehol_level1.netset", NULL },
 	{ "feodo",    "https://feodotracker.abuse.ch/downloads/ipblocklist.txt", NULL },
@@ -190,6 +200,80 @@ static int rw_valid_sched(const char *s)
 	return 1;
 }
 
+/* one '>'-separated field out of a '<'-separated record. Returns 0 when the
+ * field is absent or does not fit; the caller validates the contents. */
+static int rw_field(const char *rec, int idx, char *out, size_t ol)
+{
+	const char *p = rec, *e;
+	size_t n;
+	int i;
+
+	if (!rec || !out || !ol) return 0;
+	for (i = 0; i < idx; i++) {
+		if (!(p = strchr(p, '>'))) return 0;
+		p++;
+	}
+	e = strchr(p, '>');
+	n = e ? (size_t)(e - p) : strlen(p);
+	if (n >= ol) return 0;
+	memcpy(out, p, n);
+	out[n] = 0;
+	return 1;
+}
+
+/* A custom feed's NAME. Label only - it reaches the generated script solely
+ * inside a double-quoted logger message, and the charset below cannot terminate
+ * that string either. */
+static int rw_valid_feedname(const char *s)
+{
+	int n = 0;
+
+	if (!s || !*s) return 0;
+	for (; *s; s++, n++) {
+		if (n >= RW_CFEED_NAME_MAX) return 0;
+		if (isalnum((unsigned char)*s)) continue;
+		if (*s == ' ' || *s == '-' || *s == '_' || *s == '.') continue;
+		return 0;
+	}
+	return 1;
+}
+
+/* A custom feed's URL. THIS IS THE ONLY USER DATA THAT REACHES THE GENERATED
+ * SHELL SCRIPT - it is emitted into a single-quoted curl argument, exactly where
+ * the curated table's fixed literals go. The charset is therefore a security
+ * boundary, not a tidiness check:
+ *   '   would CLOSE the single quote and hand the caller a shell;
+ *   \ ` " $  are excluded belt-and-braces though inert inside single quotes;
+ *   whitespace and controls are excluded so one URL can never become two args;
+ *   ; # ( ) ! *  are excluded too. They are inert inside single quotes, so
+ *            this is defence in depth, not a live hole - but the quoting is the
+ *            only thing making them safe, and a future edit that emits this URL
+ *            anywhere else would turn ';' into a command separator and '#' into
+ *            a comment. No real blocklist URL uses them, so the charset carries
+ *            the guarantee instead of the quoting. ('&' and '=' are kept: query
+ *            strings genuinely need them, and they are inert unquoted anyway.)
+ *   < >      are excluded because they are our own record separators;
+ *   @        is excluded so https://trusted.example@evil.example cannot be
+ *            stored and then misread by a human as the trusted host.
+ * https only, and not negotiable: whatever is fetched is loaded straight into a
+ * DROP set, so an on-path attacker rewriting a plaintext feed would be choosing
+ * what the router blocks - including, without the bogon filter below, the LAN. */
+static int rw_valid_feedurl(const char *s)
+{
+	static const char ok[] = "-._~:/?&=%+,[]";
+	int n = 0;
+
+	if (!s || strncmp(s, "https://", 8) != 0) return 0;
+	if (!s[8]) return 0;
+	for (; *s; s++, n++) {
+		if (n >= RW_CFEED_URL_MAX) return 0;
+		if (isalnum((unsigned char)*s)) continue;
+		if (strchr(ok, *s)) continue;
+		return 0;
+	}
+	return 1;
+}
+
 /* feed id from nvram must match a known feed (prevents arbitrary ids). */
 static const struct rw_feed *rw_feed_by_id(const char *id)
 {
@@ -333,12 +417,16 @@ static void rw_emit_dst_group(FILE *f, const char *ipt, const char *chain,
 {
 	fprintf(f,
 	  "%s -A %s -m set --match-set %s dst -j RETURN\n"
-	  "%s -A %s -m set --match-set %s dst -j %s\n"
 	  "%s -A %s -m set --match-set %s dst -j %s\n",
 	  ipt, chain, v6 ? "rw_allow6" : "rw_allow",
-	  ipt, chain, v6 ? "rw_ban6"    : "rw_ban",    drop,
-	  ipt, chain, v6 ? "rw_threat6" : "rw_threat", drop);
+	  ipt, chain, v6 ? "rw_ban6"    : "rw_ban",    drop);
+	/* Geo BEFORE the feed - attribution only; see the ATTRIBUTION ORDER note in
+	 * rw_gen_apply(). Kept identical on the dst side so inbound and outbound
+	 * counters mean the same thing. */
 	rw_emit_country_rules(f, ipt, chain, "dst", drop, v6);
+	fprintf(f,
+	  "%s -A %s -m set --match-set %s dst -j %s\n",
+	  ipt, chain, v6 ? "rw_threat6" : "rw_threat", drop);
 }
 
 /* RW_SELF: the same destination logic applied to traffic the ROUTER originates
@@ -496,8 +584,26 @@ static void rw_gen_apply(void)
 	 *   6. ban src RW_DROP        - manual ban beats the LAN shield on purpose
