+ *
+ * The 0243 ordering placed rule 7 dead last (after the src drops), on the
 	 * false premise that feeds never carry LAN addresses; FireHOL level1 ships
 	 * fullbogons (192.168/16, 10/8, 127/8, 0/8, ...) and that armed the
 	 * 2026-07-29 field lockout the moment the whitelist was emptied.
@@ -564,9 +670,10 @@ static void rw_gen_apply(void)
 	fprintf(f,
 	  "iptables -A REAPER_WARDEN -m set --match-set rw_allow src -j RETURN\n"
 	  "iptables -A REAPER_WARDEN -m set --match-set rw_ban src -j RW_DROP\n"
-	  "iptables -A REAPER_WARDEN -s $LANNET -j RETURN\n"
-	  "iptables -A REAPER_WARDEN -m set --match-set rw_threat src -j RW_DROP\n");
+	  "iptables -A REAPER_WARDEN -s $LANNET -j RETURN\n");
 	rw_emit_country_rules(f, "iptables", "REAPER_WARDEN", "src", "RW_DROP", 0);
+	fprintf(f,
+	  "iptables -A REAPER_WARDEN -m set --match-set rw_threat src -j RW_DROP\n");
 	fprintf(f,
 	  "iptables -I INPUT -j REAPER_WARDEN\n"
 	  "iptables -I FORWARD -j REAPER_WARDEN\n");
@@ -602,15 +709,16 @@ static void rw_gen_apply(void)
 		fprintf(f, "ip6tables -A REAPER_WARDEN -j RW_OUT\n");
 	/* v6 anti-lockout (same slot-7 position as the v4 LAN RETURN): link-local +
 	 * ULA always exempt, plus the delegated LAN prefix when present - BEFORE
-	 * the feed/geo src drops, AFTER the dst group (L2). */
+	 * the geo/feed src drops, AFTER the dst group (L2). */
 	fprintf(f,
 	  "ip6tables -A REAPER_WARDEN -m set --match-set rw_allow6 src -j RETURN\n"
 	  "ip6tables -A REAPER_WARDEN -m set --match-set rw_ban6 src -j RW_DROP\n"
 	  "ip6tables -A REAPER_WARDEN -s fe80::/10 -j RETURN\n"
 	  "ip6tables -A REAPER_WARDEN -s fc00::/7 -j RETURN\n"
-	  "[ -n \"$V6LAN\" ] && ip6tables -A REAPER_WARDEN -s \"$V6LAN\" -j RETURN\n"
-	  "ip6tables -A REAPER_WARDEN -m set --match-set rw_threat6 src -j RW_DROP\n");
+	  "[ -n \"$V6LAN\" ] && ip6tables -A REAPER_WARDEN -s \"$V6LAN\" -j RETURN\n");
 	rw_emit_country_rules(f, "ip6tables", "REAPER_WARDEN", "src", "RW_DROP", 1);
+	fprintf(f,
+	  "ip6tables -A REAPER_WARDEN -m set --match-set rw_threat6 src -j RW_DROP\n");
 	fprintf(f,
 	  "ip6tables -I INPUT -j REAPER_WARDEN\n"
 	  "ip6tables -I FORWARD -j REAPER_WARDEN\n");
@@ -634,7 +742,25 @@ static void rw_gen_update(void)
 	fprintf(f,
 	  "#!/bin/sh\n"
 	  "# generated by start_rwarden - fetch feeds -> ipset, cache to jffs\n"
-	  "CURL='curl -fsSL --retry 2 --max-time 40'\n"
+	  /* --max-filesize: /tmp is tmpfs, i.e. RAM. Without a cap, one oversized
+	   * or hostile list is a memory-exhaustion event on the router, and custom
+	   * feeds put that URL under user control. 32 MiB is ~20x the largest
+	   * curated feed. */
+	  "CURL='curl -fsSL --max-filesize 33554432 --retry 2 --max-time 40'\n"
+	  /* https-only INCLUDING across redirects. -L follows redirects and curl
+	   * permits https->http by default, so an https feed that 302s to http was
+	   * still followed - and whatever came back is loaded straight into a DROP
+	   * set, which hands an on-path attacker the choice of what the router
+	   * blocks. Probed rather than assumed: a curl without --proto-redir must
+	   * still fetch, because failing closed here means no threat data at all,
+	   * which is worse than an unpinned redirect. Every URL this script fetches
+	   * is https today (both curated feeds and ipdeny), so nothing legitimate
+	   * is refused by the pin. */
+	  "if curl --proto-redir =https --version >/dev/null 2>&1; then\n"
+	  "  CURL=\"$CURL --proto =https --proto-redir =https\"\n"
+	  "else\n"
+	  "  logger -t rwarden \"curl has no --proto-redir; feed fetches are not redirect-pinned\"\n"
+	  "fi\n"
 	  "TMP=/tmp/rwarden/feed.$$\n"
 	  "# Reserved/special ranges must NEVER enter a block set (2026-07-29 LAN\n"
 	  "# lockout: FireHOL level1 ships fullbogons - 192.168/16, 10/8, 127/8,\n"
@@ -669,6 +795,56 @@ static void rw_gen_update(void)
 		}
 		free(list);
 	}
+	/* ---- user-supplied custom feeds ------------------------------------
+	 * Re-validated HERE as well as on save. nvram is not a trust boundary: a
+	 * value written by any other path - a restore, a script, a future import -
+	 * must not be able to break out of the single-quoted curl argument. A
+	 * record that fails is skipped and logged, never emitted.
+	 *
+	 * Output goes into the SAME $NEW/$NEW6 as the curated feeds, so custom
+	 * entries land in rw_threat/rw_threat6 and inherit the bogon/LAN filter
+	 * (rw_f4/rw_f6 - the 2026-07-29 lockout guard, and the reason a hostile or
+	 * simply careless list cannot blackhole the user's own network), the atomic
+	 * swap, the jffs cache, the existing rules and the existing counters. No
+	 * new set, no new chain, no change to rule ordering. */
+	list = strdup(nvram_safe_get("rwarden_cfeeds"));
+	if (list) {
+		int nrec = 0;
+		for (tok = strtok_r(list, "<", &save); tok; tok = strtok_r(NULL, "<", &save)) {
+			char nm[RW_CFEED_NAME_MAX + 2];
+			char u4[RW_CFEED_URL_MAX + 2], u6[RW_CFEED_URL_MAX + 2];
+
+			/* Bound RECORDS PARSED, not feeds emitted. Counting only successes
+			 * made the cap cosmetic: a value full of junk records was walked in
+			 * full before anything stopped it (2001 records = 2001 iterations,
+			 * measured). The UI never stores more than 8 valid rows, so this
+			 * only ever bites hand-written nvram - which is exactly the case
+			 * the cap exists for. */
+			if (++nrec > RW_CFEED_MAX) {
+				logmessage("rwarden", "more than %d custom-feed records - the rest are IGNORED",
+					   RW_CFEED_MAX);
+				break;
+			}
+			if (!rw_field(tok, 0, nm, sizeof(nm)) || !rw_valid_feedname(nm))
+				continue;
+			if (!rw_field(tok, 1, u4, sizeof(u4)) || !rw_valid_feedurl(u4)) {
+				logmessage("rwarden", "custom feed \"%s\": URL rejected, feed SKIPPED", nm);
+				continue;
+			}
+			fprintf(f,
+			  "if $CURL '%s' -o $TMP 2>/dev/null; then\n"
+			  "  grep -oE '([0-9]{1,3}\\.){3}[0-9]{1,3}(/[0-9]{1,2})?' $TMP | rw_f4 >> $NEW\n"
+			  "else\n"
+			  "  logger -t rwarden \"custom feed fetch FAILED: %s\"\n"
+			  "fi\n", u4, nm);
+			if (rw_field(tok, 2, u6, sizeof(u6)) && *u6 && rw_valid_feedurl(u6))
+				fprintf(f,
+				  "if $CURL '%s' -o $TMP 2>/dev/null; then\n"
+				  "  grep -oiE '([0-9a-f]{0,4}:){2,7}[0-9a-f]{0,4}(/[0-9]{1,3})?' $TMP | rw_f6 >> $NEW6\n"
+				  "fi\n", u6);
+		}
+		free(list);
+	}
 	/* rebuild rw_threat / rw_threat6 atomically via swap sets.
 	 * Backlog 2026-08-02: the old `while read n; do ipset add ...` was one
 	 * fork per CIDR - a large feed meant tens of thousands of execs every
