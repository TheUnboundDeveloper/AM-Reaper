index 641eb6a70e..3a8213b8fe 100644
--- a/release/src/router/gkd/gkd.c
+++ b/release/src/router/gkd/gkd.c
@@ -56,7 +56,8 @@ typedef struct {
 	char ip[46];
 	char host[33];
 	char band[8];          /* "2.4", "5", "6" or "" */
-	int wired;
+	int wired;             /* derived in scan_wl(): never seen on any wl BSS */
+	int wl_hit;            /* transient: seen in THIS wl sweep. Not in seen.tsv */
 	long first;
 	long last;
 	int online;
@@ -202,7 +203,9 @@ static void scan_wl(void)
 	/* every wl BSS (base + VIF - MULTILAN puts user networks on VIFs) */
 	DIR *dh = opendir("/sys/class/net");
 	struct dirent *e;
+	int i;
 	if (!dh) return;
+	for (i = 0; i < ndev; i++) devs[i].wl_hit = 0;
 	while ((e = readdir(dh)) != NULL) {
 		int unit = -1, sub = -1;
 		char cmd[128], line[128];
@@ -228,12 +231,29 @@ static void scan_wl(void)
 				if (d) {
 					snprintf(d->band, sizeof(d->band), "%s", unit_band(unit));
 					d->wired = 0;
+					d->wl_hit = 1;
 				}
 			}
 		}
 		pclose(p);
 	}
 	closedir(dh);
+
+	/* Derive `wired`. It was memset to 0 and the only assignment set it to 0,
+	 * so it could never be 1: the TSV column was a constant and the Gatekeeper
+	 * UI labelled every device - Ethernet clients included - as wireless.
+	 *
+	 * A device in the ARP table but on no wl BSS is wired. This runs after a
+	 * COMPLETED sweep of every BSS, so a miss here is a real absence rather
+	 * than an unscanned interface. Only claim it for a device that has never
+	 * carried a band: a wireless client that is merely dozing drops off
+	 * assoclist while its ARP entry lingers, and its band persists (across
+	 * restarts too, now that load_seen keeps it), so it stays wireless. A new
+	 * wireless client joining between sweeps reads wired until the next one,
+	 * then corrects itself. */
+	for (i = 0; i < ndev; i++)
+		if (devs[i].online && !devs[i].wl_hit && !devs[i].band[0])
+			devs[i].wired = 1;
 }
 
 static void write_seen(void)
@@ -290,6 +310,14 @@ static void load_seen(void)
 		memset(d, 0, sizeof(*d));
 		snprintf(d->mac, sizeof(d->mac), "%s", fld[0]);
 		norm_mac(d->mac);
+		/* Restore ip/host/band/wired too. These were parsed and then dropped,
+		 * so every restart blanked the band and hostname columns until the next
+		 * sweep refilled them - and band is what the wired derivation below
+		 * keys on, so dropping it reset that as well. */
+		snprintf(d->ip,   sizeof(d->ip),   "%s", fld[1]);
+		snprintf(d->host, sizeof(d->host), "%s", fld[2]);
+		snprintf(d->band, sizeof(d->band), "%s", fld[3]);
+		d->wired = (strtol(fld[4], NULL, 10) != 0);
 		d->first = strtol(fld[5], NULL, 10);
 		d->last  = strtol(fld[6], NULL, 10);
 		d->logged = 1;	/* known before restart - suppress duplicate new-device log */
