+/* D4 (code review 2026-08-18): the canonical HTML-text escaper.
+ *
+ * There were EIGHT textually distinct copies of this across the Reaper pages and
+ * they did not agree. Four rendered a null or undefined value as the literal
+ * text "null"/"undefined" (Main_ReaperDash, Traffic, WiFiPro, Wireless) while
+ * the rest rendered empty; one (Wireless) emitted numeric entities where the
+ * others emitted named ones. None of the differences was exploitable - every
+ * copy escaped the same five characters - but a security review should have one
+ * implementation to reason about rather than eight, which is why this landed
+ * before the vulnerability pass rather than after it.
+ *
+ * null and undefined render as EMPTY: that is what nine of the thirteen callers
+ * already did, and printing the word "null" into a UI is never right. */
+window.ReaperEsc = function(s){
+  return String(s == null ? '' : s).replace(/[&<>"']/g, function(c){
+    return { '&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;', "'":'&#39;' }[c];
+  });
+};
+/* pages call it unqualified; keep the short name they already use */
+window.esc = window.ReaperEsc;
