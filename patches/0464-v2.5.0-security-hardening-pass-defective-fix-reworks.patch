+if [ -n "$rem_sha" ]; then
+	case "$rem_sha" in *[!0-9a-fA-F]*) bad=1 ;; esac
+	[ ${#rem_sha} -eq 64 ] || bad=1
+fi
+case "$rem_size" in *[!0-9]*) rem_size="" ;; esac
+if [ -n "$bad" ]; then
+	echo "---- manifest entry REJECTED: malformed field(s) ----" >> "$LOG"
