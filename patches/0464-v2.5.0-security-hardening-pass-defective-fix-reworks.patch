 static int rexport_val_ok(const char *s)
 {
+	/* charset AND length: these free-text fields (url/token/engine/metrics/
+	   index/source) are otherwise unbounded, so a huge value bloats nvram and
+	   can fail the commit. 512 is well above any real collector URL or token. */
+	if (strlen(s) > 512)
+		return 0;
 	for (; *s; s++) {
 		unsigned char c = (unsigned char)*s;
 		if (c == '"' || c == '\\' || c < 0x20 || c == 0x7f)
@@ -25088,10 +25113,43 @@ do_reaper_metrics_cgi(char *url, FILE *stream)
 	const char *want = nvram_safe_get("reaper_export_scrape_token");
 	FILE *f;
 	char line[512];
-	if (!want[0] || !tok || strcmp(tok, want) != 0) {
+	/* Phase 3 #4: constant-time compare, matching every other Reaper secret
+	 * check. Length-guard first so CRYPTO_memcmp reads no OOB. */
+	if (!want[0] || !tok || strlen(tok) != strlen(want) ||
+	    CRYPTO_memcmp(tok, want, strlen(want)) != 0) {
 		websWrite(stream, "# unauthorized: a valid ?token= is required\n");
 		return;
 	}
+	/* P2-H11: refuse to serve a snapshot the collector is no longer updating.
+	 * These samples carry no timestamp of their own, so Prometheus stamps them
+	 * at scrape time and a frozen file is indistinguishable from live data on
+	 * the dashboard. stop_rtraf() now unlinks the file, which covers the
+	 * ordinary "collector turned off" case; this covers an unclean exit, where
+	 * the file is left behind. */
+	{
+		/* The freshness bound tracks the collector's own health cadence
+		 * (rtraf_hint, clamped 10..600 s in rtrafd) times a generous factor,
+		 * so a slow interval or a couple of skipped cycles is not misread as
+		 * a dead collector. rtrafd also re-stamps this file when it defers a
+		 * cycle during a >300 Mbit transfer, so an intentional speed-test
+		 * back-off never trips this either. */
+		struct stat mst;
+		int hint = nvram_get_int("rtraf_hint");
+		time_t maxage, age;
+		if (hint < 10) hint = 60;	/* rtrafd default when unset/too low */
+		if (hint > 600) hint = 600;	/* rtrafd H_MAX_IV */
+		maxage = (time_t)hint * 3;
+		if (maxage < 600) maxage = 600;
+		if (stat("/tmp/rtraf/metrics.prom", &mst) == 0) {
+			age = time(NULL) - mst.st_mtime;
+			if (age > maxage) {	/* a negative age (clock step) is never stale */
+				websWrite(stream, "# stale: no sample in %ld seconds"
+				                  " (collector idle beyond %ld s)\n",
+				                  (long)age, (long)maxage);
+				return;
+			}
+		}
+	}
