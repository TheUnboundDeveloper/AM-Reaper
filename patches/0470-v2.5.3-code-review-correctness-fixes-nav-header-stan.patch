 		if (!rfw_field(tok, 3, iip, sizeof(iip)) || !rfw_valid_ip(iip)) { logmessage("reaper_fw", "forward: invalid internal IP - DROPPED"); continue; }
 		if (!rfw_field(tok, 4, iport, sizeof(iport)) || !rfw_valid_ports(iport)) { logmessage("reaper_fw", "forward: invalid internal port - DROPPED"); continue; }
 		if (!rfw_field(tok, 5, sobj, sizeof(sobj))) sobj[0] = 0;
@@ -1500,9 +1515,9 @@ static void rfw_emit_nat(FILE *f, const rfw_cfg_t *c)
 			continue;
 		}
 		/* an internal port must be a single port or a contiguous range - DNAT
-		 * cannot map a comma list to a target */
-		if (strchr(iport, ',')) {
-			logmessage("reaper_fw", "forward %s: internal port cannot be a list - DROPPED", eport);
+		 * cannot map a comma list (or an empty value) to a target */
+		if (!*iport || strchr(iport, ',')) {
+			logmessage("reaper_fw", "forward %s: internal port must be a single port or range - DROPPED", eport);
 			continue;
 		}
 		/* DNAT --to-destination wants a HYPHEN between the low and high port of a
diff --git a/release/src/router/rc/rexport.c b/release/src/router/rc/rexport.c
index e4a42a0f52..066a9c70d9 100644
--- a/release/src/router/rc/rexport.c
+++ b/release/src/router/rc/rexport.c
@@ -52,6 +52,16 @@ static void rexport_gen(void)
 	  "# generated by start_rexport - do not edit\n"
 	  "H=/tmp/rtraf/health.json\n"
 	  "[ -r \"$H\" ] || exit 0\n"
+	  /* P2-H11 residual: stop_rtraf() sweeps these files on a CLEAN stop, but a
+	   * CRASHED rtrafd leaves health.json frozen in tmpfs, and without this we
+	   * would keep POSTing the same snapshot to Splunk/Datadog forever as if it
+	   * were live. health.json carries no timestamp, so gate on its mtime: if it
+	   * has not been rewritten in 3 min the collector is gone - skip the push.
+	   * 'test' (Test Connection) bypasses so an endpoint can still be validated.
+	   * If find(1) lacks -mmin the subshell is empty and the gate simply no-ops. */
+	  "if [ \"$1\" != test ] && [ -n \"$(find \"$H\" -mmin +3 2>/dev/null)\" ]; then\n"
+	  "  logger -t rexport \"health.json stale (>3m) - collector down, not pushing\"; exit 0\n"
+	  "fi\n"
 	  "if [ \"$1\" != test ]; then\n"		/* 'test' bypasses the mode gate (Test Connection) */
 	  "  case \"$(nvram get reaper_export_mode)\" in both|exportonly) ;; *) exit 0 ;; esac\n"
 	  "fi\n"
diff --git a/release/src/router/rc/rwarden.c b/release/src/router/rc/rwarden.c
index dfc006cff0..60e38bebc7 100644
--- a/release/src/router/rc/rwarden.c
+++ b/release/src/router/rc/rwarden.c
@@ -517,7 +517,7 @@ static void rw_emit_self_chain(FILE *f, const char *ipt, int v6)
 
 static void rw_gen_apply(void)
 {
-	FILE *f = fopen(RW_APPLY, "w");
+	FILE *f = fopen(RW_APPLY ".tmp", "w");
 	int do_out, do_self;
 	if (!f) return;
 	do_out = (nvram_match("rwarden_dir", "out") || nvram_match("rwarden_dir", "both"));
@@ -760,6 +760,13 @@ static void rw_gen_apply(void)
 	fprintf(f, "fc flush 2>/dev/null\n");
 	rw_emit_ban_conntrack(f);	/* sever live flows to freshly-banned hosts */
 	fclose(f);
+	/* atomic publish: start_firewall() execs this script after releasing the
+	 * firewall lock, so a concurrent rebuild must never see a half-written
+	 * apply.sh whose opening act is the chain teardown. (The later
+	 * chmod(RW_APPLY) in the caller then no-ops on the finished file.) */
+	chmod(RW_APPLY ".tmp", 0700);
+	if (rename(RW_APPLY ".tmp", RW_APPLY) != 0)
+		unlink(RW_APPLY ".tmp");
 }
 
 /* The updater: fetches enabled feeds + country CIDRs (v4+v6) over HTTPS into
@@ -1047,6 +1054,12 @@ static void rw_gen_fold(void)
 	  "# not armed -> nothing to bank or reset. This is the normal case at boot and\n"
 	  "# right after the C teardown, so it must be a silent no-op.\n"
 	  "iptables -nL RW_DROP >/dev/null 2>&1 || exit 0\n"
+	  /* Serialize the read -> bank -> zero critical section against stats.sh's
+	   * banked+live read: without it a 30 s poll landing mid-checkpoint can read
+	   * the banked $CTR before the mv and the live counters after the -Z, showing
+	   * the total dip backward for one tick. Same lock file as stats.sh (which
+	   * takes it shared); best-effort 5 s wait, proceed either way. */
+	  "exec 9>/tmp/rwarden/ctr.lock; flock -w 5 9 2>/dev/null\n"
 	  "NOW=$(date +%s)\n"
 	  "mkdir -p \"$DIR\" 2>/dev/null\n"
 	  "# one-time migration from the v2.2.1 single-value baseline (no per-country\n"
@@ -1162,6 +1175,11 @@ static void rw_gen_stats(void)
 	  "SV=1; [ \"$(nvram get rwarden_stats_save)\" = 0 ] && SV=0\n"
 	  "RI=$(nvram get rwarden_reset)\n"
 	  "case \"$RI\" in 24h|7d|30d|90d) ;; *) RI=off;; esac\n"
+	  /* Shared lock (see fold.sh): hold it across the banked $CTR reads and the
+	   * live counter reads so a fold.sh checkpoint cannot mv+zero between them and
+	   * produce a one-tick backward dip. Reader-shared so concurrent 30 s polls
+	   * do not serialize; best-effort 5 s wait. */
+	  "exec 9>/tmp/rwarden/ctr.lock; flock -w 5 -s 9 2>/dev/null\n"
 	  "BASE=0; SINCE=0\n"
 	  "if [ \"$SV\" = 1 ] && [ -f \"$CTR\" ]; then\n"
 	  "  BASE=$(awk '$1==\"TOTAL\"{print $2+0; exit}' \"$CTR\" 2>/dev/null); [ -n \"$BASE\" ] || BASE=0\n"
