-	  ipt, ch, (dir == RFW_D_OUT) ? "-d" : "-s",
-	  ipt, ch, (dir == RFW_D_OUT) ? "-d" : "-s");
+	 * that armed this ruleset (login_ip_str), matched only in its own family.
+	 * Management traffic is inbound to the ROUTER, so this exemption belongs on
+	 * INPUT only. On FORWARD it would RETURN every forwarded :MGMT/:SSH packet
+	 * from the admin address - i.e. exempt all of the admin's HTTPS/SSH to the
+	 * whole internet from the firewall (over-broad); on OUTPUT it is the wrong
+	 * direction. The ESTABLISHED,RELATED RETURN above already keeps the arming
+	 * session's in-flight replies alive on every chain, so anti-lockout is
+	 * unaffected by scoping this to INPUT. */
+	if (dir == RFW_D_IN) {
+		fprintf(f,
+		  "if [ -n \"$ADM\" ] && [ \"$ADMV6\" = \"%d\" ]; then\n"
+		  "  RFWR %s -A %s -s \"$ADM\" -p tcp --dport \"$MGMT\" -j RETURN\n"
+		  "  [ \"$SSHEN\" != \"0\" ] && RFWR %s -A %s -s \"$ADM\" -p tcp --dport \"$SSHP\" -j RETURN\n"
+		  "fi\n",
+		  v6 ? 1 : 0,
+		  ipt, ch,
+		  ipt, ch);
+	}
 
 	/* Name resolution and DHCP for the LAN itself. The router is the LAN's
 	 * resolver; a blanket inbound drop that takes DNS with it looks exactly
@@ -1490,6 +1499,12 @@ static void rfw_emit_nat(FILE *f, const rfw_cfg_t *c)
 		if (!rfw_field(tok, 0, en, sizeof(en)) || strcmp(en, "1") != 0) continue;
 		if (!rfw_field(tok, 1, proto, sizeof(proto)) || !rfw_valid_proto(proto)) { logmessage("reaper_fw", "forward: invalid protocol - DROPPED"); continue; }
 		if (!rfw_field(tok, 2, eport, sizeof(eport)) || !rfw_valid_ports(eport)) { logmessage("reaper_fw", "forward: invalid external port - DROPPED"); continue; }
+		/* the external port is spliced into --dport with NO -m multiport, and a
+		 * DNAT needs a concrete target port, so it must be a single port or a
+		 * contiguous range. rfw_valid_ports() also passes empty and comma lists;
+		 * an empty value word-splits the rule apart and a comma list is rejected
+		 * by iptables at load - reject both here. */
