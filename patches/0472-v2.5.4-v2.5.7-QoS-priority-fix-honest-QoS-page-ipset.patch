@@ -22562,23 +22565,18 @@ static void rwifi_scan_worker(int unit)
 
 	aborted = !rwifi_scan_alive();
 
-	/* reaper: a CLEAN sweep locks in its winner; an aborted or stopped one puts
-	 * back exactly what was there before. r[order[0]].cs is the chanspec the radio
-	 * actually ran during the sweep, so it applies verbatim - ranked and applied
-	 * cannot disagree. Committed, so the choice survives a reboot.
-	 * SIDE EFFECT (stated on the page): this pins the radio. A radio joins
-	 * acs_ifnames only while wlN_chanspec is "0", so auto-channel is off for it
-	 * until the operator sets Control Channel back to Auto. */
+	/* reaper: a sweep RANKS and REPORTS - it never commits the winner. The radio is
+	 * always restored to exactly the chanspec/bw it ran before the sweep (the sweep
+	 * probes each candidate live, so the running channel must be put back regardless of
+	 * outcome). Pinning is the explicit "Pin best" action (scanPin -> pinTarget); a scan
+	 * run purely to look therefore never changes a committed configuration and never
+	 * silently disables auto-channel (a radio joins acs_ifnames only while wlN_chanspec
+	 * is "0"). Owner decision 2026-08-13, reversing the v2.3.7 "winner auto-locked"
+	 * behaviour; this now matches Reaper_Wireless.asp's own description of the flow. */
 	snprintf(nvk, sizeof(nvk), "wl%d_chanspec", unit);
-	if (!aborted && n > 0) {
-		nvram_set(nvk, r[order[0]].cs);
-		snprintf(nvk, sizeof(nvk), "wl%d_bw", unit);
-		nvram_set(nvk, rwifi_bw_of(r[order[0]].cs));
-	} else {
-		nvram_set(nvk, orig_cs);
-		snprintf(nvk, sizeof(nvk), "wl%d_bw", unit);
-		nvram_set(nvk, orig_bw);
-	}
+	nvram_set(nvk, orig_cs);
+	snprintf(nvk, sizeof(nvk), "wl%d_bw", unit);
+	nvram_set(nvk, orig_bw);
 	nvram_commit();
 	notify_rc("restart_wireless");
 
@@ -23132,7 +23130,18 @@ gk_baseline_snapshot(void)
 	lf = open("/tmp/gk/rl.lock", O_CREAT | O_RDWR, 0600);
 	if (lf >= 0) flock(lf, LOCK_EX);
 	rl = nvram_safe_get("gk_rl");
-	if (rl[0] && strlen(rl) + 1 < cap)
+	/* A1-SEC-003: if gk_rl is too large to load into the fixed baseline buffer,
+	 * do NOT proceed - `before` would stay 0, the smaller fresh seed would win
+	 * the `n > before` test, and gk_rl would be OVERWRITTEN with a partial list,
+	 * silently de-authorizing every dropped device. Skip (fail-safe no-op) + log
+	 * instead of quietly truncating. Unreachable in practice (16K ~ 700 entries). */
+	if (rl[0] && strlen(rl) + 1 >= cap) {
+		logmessage("gatekeeper", "enable baseline skipped: gk_rl too large (%u bytes) - existing authorizations preserved", (unsigned)strlen(rl));
+		if (lf >= 0) { flock(lf, LOCK_UN); close(lf); }
+		free(out);
+		return;
+	}
+	if (rl[0])
 		strlcpy(out, rl, cap);
 	for (q = out; (q = strchr(q, '<')) != NULL; q++)
 		before++;
@@ -25654,6 +25663,12 @@ do_reaper_mcp_cgi(char *url, FILE *stream)
 				websWrite(stream, "{\"ok\":0,\"error\":\"enrolled USB key not found - insert your key to arm\",\"ek\":\"RADVE_17\"}");
 				return;
 			}
+			/* A1-SEC-004: mirror the client= defense-in-depth below. A USB mount
+			 * directory name may contain CR/LF (any byte but '/' and NUL), which
+			 * would inject extra key=value lines into the newline-delimited session
+			 * file that rmcpd + the boot sweep parse. Strip them; a truncated path
+			 * simply fails the key-watch (fail-closed), never a valid legit key. */
+			kp[strcspn(kp, "\r\n")] = '\0';
 			snprintf(usbkey_line, sizeof(usbkey_line), "usbkey=%s\n", kp);
 		}
 		/* success: mint a session token and start the daemon */
@@ -33599,6 +33614,13 @@ static int ej_safely_remove_disk(int eid, webs_t wp, int argc, char_t **argv){
 	if(disk_port == NULL)
 		goto END;
 
+	/* B1-SEC-006: disk_port is passed as argv to /sbin/ejusb. The UI only ever
+	 * sends "all" or a numeric port; constrain it so a value beginning with '-'
+	 * cannot be misread by ejusb as an option flag (arg-injection hardening). */
+	if (strcmp(disk_port, "all") != 0 &&
+	    (disk_port[0] == '\0' || strspn(disk_port, "0123456789") != strlen(disk_port)))
+		goto END;
+
 	int part_num = 0;
 	char *fn = "safely_remove_disk_error";
 
