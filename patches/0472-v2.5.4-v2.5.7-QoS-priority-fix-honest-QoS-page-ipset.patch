@@ -226,7 +226,43 @@ static void rwatch_gen(void)
 	  "  echo OK > $STATE\n"
 	  "fi\n"
 	  "\n"
-	  "# ================= reaper v1.9.1: long-term history writer =================\n"
+	  "# ============ reaper v1.9.2: one-shot PPPoE stale-session bounce ===========\n"
+  "# Field 2026-08-20 (GT-BE98): on some carriers, after a COLD router boot the\n"
+  "# OLT keeps the PREVIOUS PPPoE session marked active and black-holes the\n"
+  "# router's new dial - the link stays UP (wanX_state_t==2) but NO packets reach\n"
+  "# the internet, until the user manually power-cycles their ONT. wanduck DETECTS\n"
+  "# this (its 'no internet activity' aux-state) but by design takes no action on\n"
+  "# it. Fill that gap: when we see link-up-but-no-real-internet on a PPPoE WAN,\n"
+  "# force ONE pppd re-dial (SIGHUP - the least-disruptive redial; keeps NAT,\n"
+  "# firewall and routes intact) so the OLT tears down the stale session and\n"
+  "# accepts the new one. At most once per boot (tmpfs latch, self-clears on\n"
+  "# reboot). Opt out with reaper_wanbounce_enable=0. Runs AFTER the watchdog\n"
+  "# state machine so a fault here cannot affect it. Uses its OWN real-internet\n"
