diff --git a/release/src/router/rc/qos.c b/release/src/router/rc/qos.c
index 391a3f4e9c..9dc946fb0d 100644
--- a/release/src/router/rc/qos.c
+++ b/release/src/router/rc/qos.c
@@ -3401,22 +3401,53 @@ int start_hwqos_classful(void)
 				crate[i] = (crate[i] * QOS_MINRATE_BUDGET_PCT) / mtot;
 	}
 
+	/* P2-H6 fix (metal-verified RT-BE96U 2026-08-20): correct the strict-priority
+	 * inversion. tmctl priority is a rank where a HIGHER value is served first
+	 * ("priority = <0,7>, lower value, lower priority"), but the class queues
+	 * shipped with priority == qid, so class 1 (qid 1 - the page's top, "served
+	 * first" row) held the second-lowest rank and every lower class outranked it:
+	 * the more a user classified, the worse it got. Reassign so the class queues
+	 * descend qid 1..5 -> priority 5..1, leaving the reserved qid 0 (unclassified)
+	 * and qid 6 (LAN/multicast) at their stock ranks 0 and 6:
+	 *     priority = 6 - qid   ->   q1=5 q2=4 q3=3 q4=2 q5=1
+	 * A priority cannot be changed in place (libtmctl rejects "Priority already in
+	 * use"), so all five class queues are deleted then recreated - the only order
+	 * the TM accepts, and the recreated priority survives the later setqdropalg /
+	 * setqshaper (all verified on metal). qsize is platform-tuned: read back first
+	 * and preserved, and the whole block is skipped if any read fails rather than
+	 * write a zero qsize or leave a queue deleted.
+	 * qos_sched WRR weights are deliberately NOT honoured: the SP_WRR single-level
+	 * scheduler has no free queue index for a WRR queue in this 7-queue layout
+	 * ("No place for new WRR queue" - the pre-fix code's own WRR setqcfg failed the
+	 * same way on metal), so every class runs strict priority. */
+	{
+		int wrr_req = 0;
+		for (i = 0; i < 5; i++) if (sched_w[i] > 0) wrr_req = 1;
+		fprintf(f, "\tQ1=$(tmctl getqcfg --devtype 0 --if $WANIF --qid 1 | grep qsize | awk '{print $3}')\n");
+		fprintf(f, "\tQ2=$(tmctl getqcfg --devtype 0 --if $WANIF --qid 2 | grep qsize | awk '{print $3}')\n");
+		fprintf(f, "\tQ3=$(tmctl getqcfg --devtype 0 --if $WANIF --qid 3 | grep qsize | awk '{print $3}')\n");
+		fprintf(f, "\tQ4=$(tmctl getqcfg --devtype 0 --if $WANIF --qid 4 | grep qsize | awk '{print $3}')\n");
+		fprintf(f, "\tQ5=$(tmctl getqcfg --devtype 0 --if $WANIF --qid 5 | grep qsize | awk '{print $3}')\n");
+		fprintf(f, "\tif [ -n \"$Q1\" ] && [ -n \"$Q2\" ] && [ -n \"$Q3\" ] && [ -n \"$Q4\" ] && [ -n \"$Q5\" ]; then\n");
+		fprintf(f, "\t\tfor q in 1 2 3 4 5; do tmctl delqcfg --devtype 0 --if $WANIF --qid $q; done\n");
+		fprintf(f, "\t\ttmctl setqcfg --devtype 0 --if $WANIF --qid 1 --priority 5 --qsize $Q1 --schedmode 1 --weight 1 --l4s %d\n", l4s ? 1 : 0);
+		fprintf(f, "\t\ttmctl setqcfg --devtype 0 --if $WANIF --qid 2 --priority 4 --qsize $Q2 --schedmode 1 --weight 1 --l4s %d\n", l4s ? 1 : 0);
+		fprintf(f, "\t\ttmctl setqcfg --devtype 0 --if $WANIF --qid 3 --priority 3 --qsize $Q3 --schedmode 1 --weight 1 --l4s %d\n", l4s ? 1 : 0);
+		fprintf(f, "\t\ttmctl setqcfg --devtype 0 --if $WANIF --qid 4 --priority 2 --qsize $Q4 --schedmode 1 --weight 1 --l4s %d\n", l4s ? 1 : 0);
+		fprintf(f, "\t\ttmctl setqcfg --devtype 0 --if $WANIF --qid 5 --priority 1 --qsize $Q5 --schedmode 1 --weight 1 --l4s %d\n", l4s ? 1 : 0);
+		fprintf(f, "\telse\n\t\tlogger -t hwqos \"class-queue priority correction skipped (queue readback failed)\"\n\tfi\n");
+		if (wrr_req)
+			fprintf(f, "\tlogger -t hwqos \"qos_sched requested WRR weights; not supported on this queue layout - using strict priority\"\n");
+	}
+
 	for (i = 0; i < 5; ++i) {
 		if (!cvalid[i]) continue;
 		rate = crate[i];
 		ceil = cceil[i];
 		qid = i + 1;
-		/* v4: setqcfg FIRST - like setqdropalg it rewrites the whole queue
-		 * config (the v1 ordering lesson), so scheduler mode must land before
-		 * drop-alg and shaper. qsize is platform-tuned, so it is read back at
-		 * run time and preserved; if the read fails the setqcfg is skipped
-		 * (never write a zero qsize). Only emitted when the class actually
-		 * departs from the SP default, so v3 scripts stay byte-identical. */
-		if (sched_w[i] > 0 || l4s) {
-			fprintf(f, "\tQS=$(tmctl getqcfg --devtype 0 --if $WANIF --qid %d | awk '/qsize/{print $3}')\n", qid);
-			fprintf(f, "\t[ -n \"$QS\" ] && tmctl setqcfg --devtype 0 --if $WANIF --qid %d --priority %d --qsize $QS --schedmode %d --weight %d --l4s %d\n",
-				qid, qid, sched_w[i] > 0 ? 2 : 1, sched_w[i] > 0 ? sched_w[i] : 1, l4s ? 1 : 0);
-		}
+		/* Per-class scheduler mode + priority is set once, before this loop, in the
+		 * P2-H6 correction block above (all five class queues, delete-then-recreate).
+		 * This loop only programs each class's drop-alg and shaper. */
 		/* obw is guaranteed > 0 here - the function returns -1 above when
 		 * qos_obw is empty - so the obw > 0 guards below are belt-and-suspenders,
 		 * not the branch selector the old comment implied. */
@@ -3485,15 +3516,25 @@ int start_hwqos_classful(void)
 	 * kernel ERR (_drv_policer_clear_profile, metal-observed on first apply
 	 * after boot) - skip the clear when the readback already shows (0, 0, 0) */
 	fprintf(f, "\ttmctl getportrxrate --devtype 0 --if $WANIF 2>/dev/null | grep -q '(0, 0, 0)' || tmctl setportrxrate --devtype 0 --if $WANIF --shapingrate 0 --burstsize 0\n");
-	/* v4: restore strict priority on any queue this script reconfigured
-	 * (setqcfg first, mirroring the start ordering; weight 1 is the lowest
-	 * legal value and is ignored in SP mode - the tool rejects weight 0) */
-	for (i = 0; i < 5; i++) {
-		if (sched_w[i] > 0 || l4s) {
-			fprintf(f, "\tQS=$(tmctl getqcfg --devtype 0 --if $WANIF --qid %d | awk '/qsize/{print $3}')\n", i + 1);
-			fprintf(f, "\t[ -n \"$QS\" ] && tmctl setqcfg --devtype 0 --if $WANIF --qid %d --priority %d --qsize $QS --schedmode 1 --weight 1 --l4s 0\n", i + 1, i + 1);
-		}
-	}
+	/* P2-H6: start reassigned every class-queue priority (delete-then-recreate,
+	 * priority = 6 - qid), so stop returns all five to the stock priority == qid
+	 * layout the same way - an in-place rewrite would hit the same "already in use"
+	 * collision. Same qsize-readback guard; all-or-nothing so a queue is never left
+	 * deleted. The recreated priority survives the setqdropalg/setqshaper reset that
+	 * follows (verified on metal). */
+	fprintf(f, "\tQ1=$(tmctl getqcfg --devtype 0 --if $WANIF --qid 1 | grep qsize | awk '{print $3}')\n");
+	fprintf(f, "\tQ2=$(tmctl getqcfg --devtype 0 --if $WANIF --qid 2 | grep qsize | awk '{print $3}')\n");
+	fprintf(f, "\tQ3=$(tmctl getqcfg --devtype 0 --if $WANIF --qid 3 | grep qsize | awk '{print $3}')\n");
+	fprintf(f, "\tQ4=$(tmctl getqcfg --devtype 0 --if $WANIF --qid 4 | grep qsize | awk '{print $3}')\n");
+	fprintf(f, "\tQ5=$(tmctl getqcfg --devtype 0 --if $WANIF --qid 5 | grep qsize | awk '{print $3}')\n");
+	fprintf(f, "\tif [ -n \"$Q1\" ] && [ -n \"$Q2\" ] && [ -n \"$Q3\" ] && [ -n \"$Q4\" ] && [ -n \"$Q5\" ]; then\n");
+	fprintf(f, "\t\tfor q in 1 2 3 4 5; do tmctl delqcfg --devtype 0 --if $WANIF --qid $q; done\n");
+	fprintf(f, "\t\ttmctl setqcfg --devtype 0 --if $WANIF --qid 1 --priority 1 --qsize $Q1 --schedmode 1 --weight 1 --l4s 0\n");
+	fprintf(f, "\t\ttmctl setqcfg --devtype 0 --if $WANIF --qid 2 --priority 2 --qsize $Q2 --schedmode 1 --weight 1 --l4s 0\n");
+	fprintf(f, "\t\ttmctl setqcfg --devtype 0 --if $WANIF --qid 3 --priority 3 --qsize $Q3 --schedmode 1 --weight 1 --l4s 0\n");
+	fprintf(f, "\t\ttmctl setqcfg --devtype 0 --if $WANIF --qid 4 --priority 4 --qsize $Q4 --schedmode 1 --weight 1 --l4s 0\n");
+	fprintf(f, "\t\ttmctl setqcfg --devtype 0 --if $WANIF --qid 5 --priority 5 --qsize $Q5 --schedmode 1 --weight 1 --l4s 0\n");
+	fprintf(f, "\tfi\n");
 	for (qid = 0; qid <= 6; qid++) {
 		/* reset minrate along with the ceiling - a bare "--shapingrate 0"
 		 * would leave a stale committed rate configured on the queue */
diff --git a/release/src/router/rc/rc.h b/release/src/router/rc/rc.h
index c5295ed36e..2f89f9a97b 100644
--- a/release/src/router/rc/rc.h
+++ b/release/src/router/rc/rc.h
@@ -2994,6 +2994,11 @@ extern void reaper_fw_apply(void);
 extern void reaper_fw_confirm(void);
 extern void reaper_fw_rollback(void);
 extern void reaper_fw_dryrun(void);
+/* reaper v2.5.x ipset policy routing (rc/reaper_pbr.c): marks ipset/selector
+ * matches in mangle and steers them via `ip rule fwmark lookup <tunnel>`, BELOW
+ * VPN Director's pref band so it overrides. Inert unless reaper_pbr_enable=1. */
+extern void stop_reaper_pbr(void);
+extern void start_reaper_pbr(void);
 /* The dnsmasq `ipset=` fragment reaper_fw generates for its FQDN objects, so
  * the resolver drops matching answers straight into the object's ipsets.
  * reaper_fw.c writes it; services.c splices it into /etc/dnsmasq.conf just
diff --git a/release/src/router/rc/reaper_pbr.c b/release/src/router/rc/reaper_pbr.c
new file mode 100644
index 0000000000..76b9bafe24
--- /dev/null
+++ b/release/src/router/rc/reaper_pbr.c
@@ -0,0 +1,295 @@
+/*
+ * rc/reaper_pbr.c - Reaper ipset-based Policy Routing ("VPN Director" PBR)
+ * (RT-BE96U "reaper", v2.5.x MVP). Companion to Merlin's source/dest VPN
+ * Director (libovpn/amvpn_routing.c), which this SITS BESIDE and OVERRIDES for
+ * the flows it names - it never edits VPN Director's rules or tables.
+ *
+ * WHAT THIS IS
+ *   Policy routing keyed on an ipset/domain/src/mac SELECTOR -> a VPN tunnel,
+ *   the WAN, or a block. Merlin VPN Director can only match a literal src/dst
+ *   CIDR; this lets a rule say "send everything in ipset rwfw_streaming out the
+ *   WAN even though all traffic is tunnelled", or "route ipset rwfw_work through
+ *   OVPN2". The matching half already exists: reaper_fw's FQDN/address objects
+ *   populate rwfw_<name> / rwfw6_<name> sets (dnsmasq ipset= + resolver floor).
+ *   This adds the routing half: a mangle MARK on the set match, then an
+ *   `ip rule fwmark ... lookup <tunnel-table>`.
+ *
+ * ================= THE MARK / PRIORITY CONTRACT (see memory) =================
+ *   fwmark field  : bits 16-19, mask PPBR_MASK 0x000F0000. The only free nibble
+ *                   on BE96U - bits 0-10 are QoS/guest, 24-31 are MTWAN, bit 0
+ *                   is WG accel. bwdpi/Adaptive QoS (soft-owns 8-31) is compiled
+ *                   OUT (# RTCONFIG_BWDPI is not set), so this nibble is
+ *                   unconditionally ours.
+ *   ip rule pref  : PPBR_PRIO_BASE 9000. BELOW VPN Director's 10000 band on
+ *                   purpose - an explicit PBR rule is evaluated FIRST and thus
+ *                   OVERRIDES VPN Director's broad from/to rules (the intended
+ *                   precedence: PBR is the specific override).
+ *   tables        : the EXISTING per-tunnel tables ovpnc1..5 (VPN Director owns
+ *                   them); WAN = table main; BLOCK = prohibit. No new tables.
+ *
+ * ============================ INVARIANTS ============================
+ * P1. TOUCH ONLY WHAT WE OWN. Apply/teardown only ever create/flush the
+ *     PPBR_CHAIN mangle chain (+ its one PREROUTING jump) and delete ip rules
+ *     in the 9000-9199 pref band. Never another chain, table, or rule.
+ * P2. INPUT IS UNTRUSTED. Every field from reaper_pbr_rulelist that reaches the
+ *     generated root shell is charset-validated in C first; a bad record is
+ *     DROPPED and logged, never emitted half-formed.
+ * P3. FAIL CLOSED. A tunnel target also emits a lower-priority `prohibit` rule
+ *     for its mark, so when the tunnel drops (its table is flushed) the flow is
+ *     blocked, not silently leaked out the WAN. WAN-force and unmatched traffic
+ *     are unaffected.
+ * P4. SERIALIZE WITH THE BASE. Apply/teardown take file_lock("firewall") like
+ *     reaper_fw / GK / Warden, so we never interleave with a start_firewall()
+ *     rebuild.
+ * P5. INERT BY DEFAULT. Does nothing unless reaper_pbr_enable=1. No enable ->
+ *     teardown only.
+ *
+ * KNOWN LIMIT (MVP): WireGuard (WGC*) targets are DEFERRED. On BE96U the WG
+ * data path is hardware-offloaded; the accelerator ignores an `ip rule` unless
+ * the destination is fed to hnd_skip_wg_network() - and that takes static CIDRs,
+ * not a dynamic ipset. Supporting WG PBR needs a mark-aware accel skip that must
+ * be designed against on-box offload behaviour. Until then a WGC target is
+ * parsed, logged, and SKIPPED (never silently "supported"). OVPN is a tun path
+ * and is not fast-pathed the same way, so it works with the plain ip rule.
+ * IPv4-first: v6 selectors are deferred with WG.
+ *
+ * nvram: reaper_pbr_enable  reaper_pbr_rulelist
+ * RECORD (list sep '<', field sep '>'):
+ *   <en>desc>seltype>selval>proto>port>target
+ *   en=0|1  seltype=ipset|domain|src|mac  target=OVPN1..5|WGC1..5|WAN|BLOCK
+ *   (proto/port parsed but not emitted in the MVP - deferred to v2)
+ */
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <ctype.h>
+#include <unistd.h>
+#include <sys/stat.h>
+
+#include "rc.h"
+#include <shared.h>
+
+#define PPBR_DIR        "/tmp/reaper_pbr"
+#define PPBR_APPLY      PPBR_DIR "/apply.sh"
+#define PPBR_CHAIN      "REAPER_PBR"
+#define PPBR_MASK       "0x000F0000"        /* bits 16-19 */
+#define PPBR_PRIO_BASE  9000                 /* lookup rules: 9000+code */
+#define PPBR_PRIO_KS    9100                 /* fail-closed prohibit: 9100+code */
+#define PPBR_MAX_RULES  50                   /* blast-radius cap, not policy */
+#define PPBR_NAME_MAX   32
+
+/* Resolve a target token to (mark code, routing action). Returns 1 on success
+ * and fills *code (1-15, the nibble value pre-shift) plus *table (NULL => this
+ * code is realised as a `prohibit`, i.e. BLOCK) and *failclosed (emit a
+ * kill-switch prohibit below the lookup). Returns 0 for an unknown target and
+ * -1 for a recognised-but-deferred target (WGC*) so the caller can log it
+ * distinctly. */
+static int ppbr_target(const char *t, int *code, const char **table, int *failclosed)
+{
+	*table = NULL; *failclosed = 0;
+	if (!strncmp(t, "OVPN", 4) && t[4] >= '1' && t[4] <= '5' && t[5] == '\0') {
+		static const char *ov[] = { "ovpnc1","ovpnc2","ovpnc3","ovpnc4","ovpnc5" };
+		*code = t[4] - '0';                 /* 1..5 */
+		*table = ov[t[4] - '1'];
+		*failclosed = 1;
+		return 1;
+	}
+	if (!strncmp(t, "WGC", 3) && t[3] >= '1' && t[3] <= '5' && t[4] == '\0')
+		return -1;                          /* deferred - see KNOWN LIMIT */
+	if (!strcmp(t, "WAN")) { *code = 11; *table = "main"; *failclosed = 0; return 1; }
+	if (!strcmp(t, "BLOCK")) { *code = 15; *table = NULL; *failclosed = 0; return 1; }
+	return 0;
+}
+
+/* charset gate for a value that will be spliced into a root shell command (P2). */
+static int ppbr_ok(const char *s, const char *allowed, int maxlen)
+{
+	int n = 0;
+	if (!s || !*s) return 0;
+	for (; *s; s++, n++) {
+		if (n >= maxlen) return 0;
+		if (!strchr(allowed, *s)) return 0;
+	}
+	return 1;
+}
+
+/* Build the selector match fragment for one rule into buf. Returns 1 if the
+ * selector is valid & supported (v4), 0 to drop the rule. */
+static int ppbr_selector(char *buf, size_t buflen, const char *seltype, const char *selval)
+{
+	if (!strcmp(seltype, "ipset") || !strcmp(seltype, "domain")) {
+		/* reaper_fw object name -> its v4 set rwfw_<name>; destination match. */
+		if (!ppbr_ok(selval, "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_", PPBR_NAME_MAX))
+			return 0;
+		snprintf(buf, buflen, "-m set --match-set rwfw_%s dst", selval);
+		return 1;
+	}
+	if (!strcmp(seltype, "src")) {
+		if (!ppbr_ok(selval, "0123456789./", 32)) return 0;
+		snprintf(buf, buflen, "-s %s", selval);
+		return 1;
+	}
+	if (!strcmp(seltype, "mac")) {
+		if (!ppbr_ok(selval, "0123456789abcdefABCDEF:", 17)) return 0;
+		snprintf(buf, buflen, "-m mac --mac-source %s", selval);
+		return 1;
+	}
+	return 0;   /* unknown selector type (or a v6-only one) - drop */
+}
+
+/* Emit the idempotent teardown+build script. teardown_only=1 stops after the
+ * teardown block (used by stop_reaper_pbr and by the disabled path). */
+static int ppbr_gen(const char *path, int teardown_only)
+{
+	FILE *f;
+	char tmp[160];
+	char *list, *listp, *rec;
+	int nrules = 0, i;
+	int used[16];                /* used[code] => this mark code needs an ip rule */
+	const char *used_tbl[16];    /* table for that code (NULL => prohibit/BLOCK) */
+	int used_fc[16];             /* fail-closed for that code */
+
+	memset(used, 0, sizeof(used));
+	memset(used_fc, 0, sizeof(used_fc));
+	for (i = 0; i < 16; i++) used_tbl[i] = NULL;
+
+	snprintf(tmp, sizeof(tmp), "%s.tmp", path);
+	f = fopen(tmp, "w");
+	if (!f) return 0;
+
+	fprintf(f,
+	  "#!/bin/sh\n"
+	  "# generated by reaper_pbr - do not edit; idempotent (teardown then rebuild)\n"
+	  "MASK=" PPBR_MASK "\n"
+	  "\n"
+	  "# ---- teardown (P1: only our chain + our pref band) ----\n"
+	  "while iptables -t mangle -D PREROUTING -j " PPBR_CHAIN " 2>/dev/null; do :; done\n"
+	  "iptables -t mangle -F " PPBR_CHAIN " 2>/dev/null\n"
+	  "iptables -t mangle -X " PPBR_CHAIN " 2>/dev/null\n"
+	  "for P in 9001 9002 9003 9004 9005 9011 9015 "
+	  "9101 9102 9103 9104 9105 9111 9115; do\n"
+	  "  while ip rule del pref $P 2>/dev/null; do :; done\n"
+	  "done\n"
+	  "\n");
+
+	if (teardown_only) {
+		fprintf(f, "exit 0\n");
+		fclose(f);
+		if (rename(tmp, path) != 0) { unlink(tmp); return 0; }
+		return 1;
+	}
+
+	/* ---- build: the chain, marked from the ipset/selector matches ---- */
+	fprintf(f,
+	  "iptables -t mangle -N " PPBR_CHAIN " 2>/dev/null\n"
+	  "iptables -t mangle -F " PPBR_CHAIN "\n"
+	  /* restore a prior verdict so only the first packet of a flow is matched */
+	  "iptables -t mangle -A " PPBR_CHAIN " -j CONNMARK --restore-mark --nfmask $MASK --ctmask $MASK\n"
+	  "iptables -t mangle -A " PPBR_CHAIN " -m mark ! --mark 0x0/$MASK -j RETURN\n");
+
+	list = strdup(nvram_safe_get("reaper_pbr_rulelist"));
+	if (list) {
+		listp = list;
+		while ((rec = strsep(&listp, "<")) != NULL) {
+			char *en, *desc, *seltype, *selval, *proto, *port, *target;
+			char sel[128];
+			int code, fc, tr;
+			const char *tbl;
+
+			if (!*rec) continue;                    /* empty record between separators */
+			if (nrules >= PPBR_MAX_RULES) {
+				logmessage("reaper_pbr", "rule cap (%d) reached - extra rules dropped", PPBR_MAX_RULES);
+				break;
+			}
+			/* split on '>' into exactly 7 fields; vstrsep PRESERVES empty fields
+			 * (strtok would collapse them and misalign the record). */
+			if (vstrsep(rec, ">", &en, &desc, &seltype, &selval, &proto, &port, &target) != 7)
+				continue;
+			(void)desc; (void)proto; (void)port;   /* MVP: proto/port deferred */
+			if (strcmp(en, "1") != 0) continue;     /* disabled */
+
+			tr = ppbr_target(target, &code, &tbl, &fc);
+			if (tr == -1) {
+				logmessage("reaper_pbr", "WGC target '%s' is not supported yet (HW-offload accel skip needed) - rule skipped", target);
+				continue;
+			}
+			if (tr == 0) {
+				logmessage("reaper_pbr", "unknown target '%s' - rule dropped", target);
+				continue;
+			}
+			if (!ppbr_selector(sel, sizeof(sel), seltype, selval)) {
+				logmessage("reaper_pbr", "bad selector %s/%s - rule dropped", seltype, selval);
+				continue;
+			}
+			fprintf(f,
+			  "iptables -t mangle -A " PPBR_CHAIN " %s -j MARK --set-xmark 0x%X0000/$MASK\n",
+			  sel, code);
+			used[code] = 1;
+			used_tbl[code] = tbl;
+			used_fc[code] = fc;
+			nrules++;
+		}
+		free(list);
+	}
+
+	fprintf(f,
+	  "iptables -t mangle -A " PPBR_CHAIN " -j CONNMARK --save-mark --nfmask $MASK --ctmask $MASK\n");
+
+	if (nrules > 0)
+		fprintf(f, "iptables -t mangle -A PREROUTING -j " PPBR_CHAIN "\n");
+
+	/* one ip rule per used mark code (P3 fail-closed for tunnel targets) */
+	for (i = 1; i < 16; i++) {
+		if (!used[i]) continue;
+		if (used_tbl[i]) {
+			fprintf(f, "ip rule add fwmark 0x%X0000/$MASK lookup %s pref %d\n",
+			        i, used_tbl[i], PPBR_PRIO_BASE + i);
+			if (used_fc[i])
+				fprintf(f, "ip rule add fwmark 0x%X0000/$MASK prohibit pref %d\n",
+				        i, PPBR_PRIO_KS + i);
+		} else {
+			/* BLOCK */
+			fprintf(f, "ip rule add fwmark 0x%X0000/$MASK prohibit pref %d\n",
+			        i, PPBR_PRIO_BASE + i);
+		}
+	}
+
+	fprintf(f, "exit 0\n");
+	fclose(f);
+	if (rename(tmp, path) != 0) { unlink(tmp); return 0; }
+	return 1;
+}
+
+void stop_reaper_pbr(void)
+{
+	int lock;
+	mkdir(PPBR_DIR, 0700);
+	if (ppbr_gen(PPBR_APPLY, 1)) {
+		lock = file_lock("firewall");           /* P4 */
+		chmod(PPBR_APPLY, 0700);
+		system("sh " PPBR_APPLY " 2>/dev/null");
+		file_unlock(lock);
+	}
+	unlink(PPBR_APPLY);
+	nvram_set("reaper_pbr_active", "0");
+}
+
+/* Apply the ruleset. Boot, the restart_firewall re-hook, and the enable toggle
+ * all land here. Inert unless reaper_pbr_enable=1 (P5). */
+void start_reaper_pbr(void)
+{
+	int lock;
+
+	if (!is_routing_enabled()) return;
+	if (!nvram_match("reaper_pbr_enable", "1")) {
+		stop_reaper_pbr();
+		return;
+	}
+	mkdir(PPBR_DIR, 0700);
+	if (!ppbr_gen(PPBR_APPLY, 0)) return;
+	lock = file_lock("firewall");                   /* P4 */
+	chmod(PPBR_APPLY, 0700);
+	system("sh " PPBR_APPLY " 2>/dev/null");
+	file_unlock(lock);
+	nvram_set("reaper_pbr_active", "1");
+}
