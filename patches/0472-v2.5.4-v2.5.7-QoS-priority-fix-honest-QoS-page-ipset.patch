+<body>
+
+<div class="pagehead">
+  <h1><#RVR_00#></h1>
+  <span class="ver"><#RVR_01#> &middot; v1.0</span>
+  <span class="statuspill off" id="pill"><#RVR_04#></span>
+  <span class="mastertg"><#RVR_05#> <span class="tg" id="tgmaster" onclick="pbrToggle()"></span></span>
+</div>
+<p class="lede"><#RVR_02#>
+  <a class="helpdot" id="help" href="https://github.com/TheUnboundDeveloper/AM-Reaper/blob/main/docs/VPN-ROUTING-GUIDE.md" target="_blank" rel="noopener noreferrer" title="<#RVR_33#>">?</a>
+</p>
+
+<div class="offbanner" id="offbanner"><b><#RVR_00#></b> &mdash; <#RVR_06#></div>
+
+<div class="card">
+  <h2><#RVR_09#> &middot; <span class="cnt" id="rulecnt">0</span></h2>
+  <div class="tabintro">
+    <p><#RVR_07#></p>
+    <p class="ex"><#RVR_08#></p>
+  </div>
+  <div class="tblwrap">
+  <table>
+    <thead><tr><th><#RVR_10#></th><th><#RVR_11#></th><th><#RVR_12#></th><th><#RVR_13#></th><th></th></tr></thead>
+    <tbody id="rulerows"></tbody>
+  </table>
+  </div>
+</div>
+
+<div class="card">
+  <h2><#RVR_14#></h2>
+  <div class="editor">
+    <div class="fld"><label><#RVR_15#></label><input type="text" id="e_desc" maxlength="48" placeholder="<#RVR_15#>"></div>
+    <div class="fld"><label><#RVR_16#></label>
+      <select id="e_type" onchange="pbrTypeChange()">
+        <option value="ipset"><#RVR_17#></option>
+        <option value="src"><#RVR_19#></option>
+        <option value="mac"><#RVR_20#></option>
+      </select>
+    </div>
+    <div class="fld"><label><#RVR_21#></label>
+      <select id="e_obj"><option value=""><#RVR_26#></option></select>
+      <input type="text" id="e_val" style="display:none" placeholder="">
+    </div>
+    <div class="fld"><label><#RVR_22#></label>
+      <select id="e_target">
+        <option value="OVPN1">OpenVPN 1</option>
+        <option value="OVPN2">OpenVPN 2</option>
+        <option value="OVPN3">OpenVPN 3</option>
+        <option value="OVPN4">OpenVPN 4</option>
+        <option value="OVPN5">OpenVPN 5</option>
+        <option value="WAN"><#RVR_23#></option>
+        <option value="BLOCK"><#RVR_24#></option>
+      </select>
+    </div>
+    <div class="fld"><label>&nbsp;</label><button class="btn" onclick="pbrAdd()"><#RVR_25#></button></div>
+  </div>
+  <div class="hint" id="objhint" style="display:none"><#RVR_27#></div>
+</div>
+
+<div class="applybar">
+  <button class="btn" onclick="applyPBR()"><#RVR_30#></button>
+  <span class="note"><#RVR_17b#></span>
+</div>
+
+<div class="applying" id="applying"><#RVR_31#></div>
+
+<form method="post" name="form" action="/start_apply.htm" target="hidden_frame">
+  <input type="hidden" name="current_page" value="Reaper_VPNRouting.asp">
+  <input type="hidden" name="next_page" value="Reaper_VPNRouting.asp">
+  <input type="hidden" name="action_mode" value="apply">
+  <input type="hidden" name="action_script" value="">
+  <input type="hidden" name="action_wait" value="10">
+  <input type="hidden" name="reaper_pbr_enable" value="" disabled>
+  <input type="hidden" name="reaper_pbr_rulelist" value="" disabled>
+</form>
+<iframe name="hidden_frame" id="hidden_frame" width="0" height="0" frameborder="0" style="display:none"></iframe>
+
+<script>
+var NV = {
+  enable:   '<% nvram_get("reaper_pbr_enable"); %>',
+  active:   '<% nvram_get("reaper_pbr_active"); %>',
+  rulelist: decodeURIComponent('<% nvram_char_to_ascii("", "reaper_pbr_rulelist"); %>')
+};
+var masterOn = (NV.enable === '1');
+var ROWS = [];
+
+function esc(s){ return String(s==null?'':s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }
+
+function parseRules(){
+  ROWS = [];
+  var recs = NV.rulelist.split('<');
+  for(var i=0;i<recs.length;i++){
+    if(!recs[i]) continue;
+    var f = recs[i].split('>');
+    if(f.length < 7) continue;
+    ROWS.push({ en:f[0]==='1', desc:f[1], seltype:f[2], selval:f[3], proto:f[4], port:f[5], target:f[6] });
+  }
+}
+
+var TGTLBL = { OVPN1:'OpenVPN 1',OVPN2:'OpenVPN 2',OVPN3:'OpenVPN 3',OVPN4:'OpenVPN 4',OVPN5:'OpenVPN 5',
+  WAN:`<#RVR_23#>`, BLOCK:`<#RVR_24#>` };
+
+function selText(r){
+  if(r.seltype==='src') return `<#RVR_19#>` + ': ' + esc(r.selval);
+  if(r.seltype==='mac') return `<#RVR_20#>` + ': ' + esc(r.selval);
+  return `<#RVR_17#>` + ': ' + esc(r.selval);   // ipset/domain -> object
+}
+function tgtClass(t){ return t==='WAN'?'wan':(t==='BLOCK'?'block':'vpn'); }
+
+function render(){
+  var tb = document.getElementById('rulerows'); tb.innerHTML='';
+  for(var i=0;i<ROWS.length;i++){ (function(idx){
+    var r = ROWS[idx];
+    var tr = document.createElement('tr');
+    tr.innerHTML =
+      '<td><span class="tg'+(r.en?' on':'')+'" data-i="'+idx+'"></span></td>'+
+      '<td>'+ (r.desc? esc(r.desc) : '<span style="color:var(--steel)">&mdash;</span>') +'</td>'+
+      '<td class="sel">'+ selText(r) +'</td>'+
+      '<td><span class="tgt '+tgtClass(r.target)+'">'+ esc(TGTLBL[r.target]||r.target) +'</span></td>'+
+      '<td><button class="rowdel" data-d="'+idx+'">&times;</button></td>';
+    tb.appendChild(tr);
+  })(i); }
+  document.getElementById('rulecnt').textContent = ROWS.length;
+  // wire row toggles + deletes
+  var tgs = tb.querySelectorAll('.tg');
+  for(var a=0;a<tgs.length;a++) tgs[a].onclick=function(){ var i=+this.getAttribute('data-i'); ROWS[i].en=!ROWS[i].en; render(); };
+  var dels = tb.querySelectorAll('.rowdel');
+  for(var b=0;b<dels.length;b++) dels[b].onclick=function(){ ROWS.splice(+this.getAttribute('data-d'),1); render(); };
+}
+
+function pbrTypeChange(){
+  var t = document.getElementById('e_type').value;
+  var sel = document.getElementById('e_obj'), val = document.getElementById('e_val');
+  var hint = document.getElementById('objhint');
+  if(t==='ipset'){ sel.style.display=''; val.style.display='none'; hint.style.display=''; }
+  else { sel.style.display='none'; val.style.display=''; hint.style.display='none';
+    val.placeholder = (t==='src') ? `<#RVR_28#>` : `<#RVR_29#>`; }
+}
+
+function pbrAdd(){
+  var t = document.getElementById('e_type').value;
+  var desc = document.getElementById('e_desc').value.trim();
+  var val = (t==='ipset') ? document.getElementById('e_obj').value : document.getElementById('e_val').value.trim();
+  var target = document.getElementById('e_target').value;
+  if(!val){ alert(`<#RVR_32b#>`); return; }
+  if(/[<>]/.test(desc)||/[<>]/.test(val)){ alert('< >'); return; }
+  ROWS.push({ en:true, desc:desc, seltype:t, selval:val, proto:'', port:'', target:target });
+  document.getElementById('e_desc').value=''; document.getElementById('e_val').value='';
+  render();
+}
+
+function pbrToggle(){ masterOn=!masterOn; syncMaster(); }
+function syncMaster(){
+  document.getElementById('tgmaster').className = 'tg'+(masterOn?' on':'');
+  var pill=document.getElementById('pill');
+  var live = masterOn && (NV.active==='1');
+  pill.textContent = masterOn ? `<#RVR_03#>` : `<#RVR_04#>`;
+  pill.className = 'statuspill'+(masterOn?'':' off');
+  document.getElementById('offbanner').style.display = masterOn?'none':'block';
+}
+
+function serialize(){
+  var out=[];
+  for(var i=0;i<ROWS.length;i++){ var r=ROWS[i];
+    out.push([(r.en?1:0), r.desc, r.seltype, r.selval, r.proto||'', r.port||'', r.target].join('>'));
+  }
+  return out.join('<');
+}
+
+function applyPBR(){
+  var f=document.form;
+  f.reaper_pbr_enable.disabled=false;   f.reaper_pbr_enable.value = masterOn?'1':'0';
+  f.reaper_pbr_rulelist.disabled=false; f.reaper_pbr_rulelist.value = serialize();
+  f.action_script.value = 'restart_reaper_pbr';
+  f.action_wait.value = '10';
+  document.getElementById('applying').className='applying show';
+  f.submit();
+  setTimeout(function(){ location.reload(); }, 14000);
+}
+
+// Populate the object dropdown from the Firewall engine's object list (rwfw_<name>).
+function loadObjects(){
+  try{
+    var x = new XMLHttpRequest();
+    x.open('GET','/reaper_fw.cgi?action=cfg',true);
+    x.onreadystatechange=function(){
+      if(x.readyState!==4) return;
+      var names=[];
+      try{ var j=JSON.parse(x.responseText);
+        var raw = (j.obj||'').split('<');
+        for(var i=0;i<raw.length;i++){ if(!raw[i])continue; var n=raw[i].split('>')[0]; if(n)names.push(n); }
+        var grp=(j.grp||'').split('<');
+        for(var k=0;k<grp.length;k++){ if(!grp[k])continue; var g=grp[k].split('>')[0]; if(g)names.push(g); }
+      }catch(e){}
+      var sel=document.getElementById('e_obj');
+      var h='<option value="">'+esc(`<#RVR_26#>`)+'</option>';
+      for(var m=0;m<names.length;m++) h+='<option value="'+esc(names[m])+'">'+esc(names[m])+'</option>';
+      sel.innerHTML=h;
+    };
+    x.send();
+  }catch(e){}
+}
+
+(function init(){
+  parseRules();
+  render();
+  syncMaster();
+  pbrTypeChange();
+  loadObjects();
+})();
+</script>
+</body>
+</html>
