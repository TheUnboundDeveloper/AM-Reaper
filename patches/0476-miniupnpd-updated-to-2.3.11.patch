diff --git a/release/src/router/miniupnpd-igdv2/Changelog.txt b/release/src/router/miniupnpd-igdv2/Changelog.txt
index 3eb086d1d4..3ff2af1a9b 100644
--- a/release/src/router/miniupnpd-igdv2/Changelog.txt
+++ b/release/src/router/miniupnpd-igdv2/Changelog.txt
@@ -1,5 +1,14 @@
 $Id: Changelog.txt,v 1.535 2025/04/26 13:07:53 nanard Exp $
 
+VERSION 2.3.11 : released on 2026/08/12
+
+2026/08/11:
+  fix READNU32 by casting to uint32_t
+  filter out non printable characters in description for lease file
+
+2026/08/09:
+  check for the return value of snprintf() : overflow or error
+
 2026/06/16:
   nftables: Avoid building too long rule with
     nftnl_rule_nlmsg_build_payload() by triming description to 256 chars.
