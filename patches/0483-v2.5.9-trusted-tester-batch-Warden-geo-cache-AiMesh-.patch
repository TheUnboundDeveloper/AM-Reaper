-/* reaper 2026-08-19 (field report: "mesh nodes show as Wired even when the
- * wireless mesh backhaul is in use"). is_re_node() consults the cfg_mnt shared
- * client table and returns 1 for an ACTIVE AiMesh RE node. Wrapped so the
- * device-classification fallback stays build-agnostic: on a non-cfgsync build
- * (or a box with no mesh) it is a constant 0 and nothing changes. */
+/* reaper 2026-08-19 / 2026-08-21 (field report, twice: "the wireless AiMesh
+ * node still shows up as Wired"). The first fix called is_re_node() with the
+ * node's LAN MAC - but that helper only matches a node's BACKHAUL STATION MACs
+ * (sta2g/sta5g), and with check_path=1 it additionally insisted on
+ * activePath==1, which is the WIRED uplink code. It could never fire for the
+ * row this page lists (keyed by the LAN MAC from the lease/ARP), so every node
+ * fell through to the Wired default. The cfg_mnt shared client table carries
+ * both halves of what is needed, so read it directly:
+ *   realMacAddr[i]  = the node's LAN MAC  -> "is this row a node?"
+ *   activePath[i]   = re_path             -> HOW it is uplinked:
+ *                     1/16/32/64 wired port, 2 = 2.4 GHz, 4/8 = 5 GHz,
+ *                     128 = 6 GHz, 512 = MLO backhaul, 0 = not connected
+ *                     (the same table the stock AiMesh page decodes in
+ *                     device-map/amesh.asp)
+ *   sta2g/5g/6g[i]  = the node's backhaul station MACs, which our own radios
+ *                     DO see in the assoclist and which therefore appear as a
+ *                     phantom lease-less Wi-Fi "device" next to the node.
+ * rdev_node_classify() walks that table once per request and (a) stamps each
+ * node row with its re_path + the matching band, (b) marks the backhaul STA
+ * rows so the emitter can fold them. Build-agnostic: a no-op without cfgsync. */
 #ifdef RTCONFIG_CFGSYNC
-static int rdev_is_re_node(const char *mac)
-{
-	char m[18];
-	snprintf(m, sizeof(m), "%s", mac);	/* is_re_node() takes a non-const char* */
-	return is_re_node(m, 1);		/* check_path=1: only an active node */
+static void rdev_node_classify(struct rdev *v, int n)
+{
+	int shm_id, i, k;
+	P_CM_CLIENT_TABLE tbl;
+	void *shm;
+
+	shm_id = shmget((key_t)KEY_SHM_CFG, sizeof(CM_CLIENT_TABLE), 0666|IPC_CREAT);
+	if (shm_id == -1) return;
+	shm = shmat(shm_id, (void *)0, 0);
+	if (shm == (void *)-1) return;
+	tbl = (P_CM_CLIENT_TABLE)shm;
+
+	for (k = 0; k < n; k++) {
+		unsigned char mb[6] = {0};
+		ether_atoe(v[k].mac, mb);
+		for (i = 1; i < tbl->count; i++) {		/* index 0 = this router (the CAP) */
+			if (memcmp(tbl->realMacAddr[i], mb, 6) == 0) {
+				int path = tbl->activePath[i];
+				v[k].node = path > 0 ? path : -1;	/* -1: a node, uplink unknown/down */
+				if (path == 2)        { v[k].wifi = 1; v[k].wired = 0; snprintf(v[k].band, sizeof(v[k].band), "2.4"); v[k].bandmask |= 1; }
+				else if (path == 4 || path == 8) { v[k].wifi = 1; v[k].wired = 0; snprintf(v[k].band, sizeof(v[k].band), "5"); v[k].bandmask |= 2; }
+				else if (path == 128) { v[k].wifi = 1; v[k].wired = 0; snprintf(v[k].band, sizeof(v[k].band), "6"); v[k].bandmask |= 4; }
+				else if (path == 512) { v[k].wifi = 1; v[k].wired = 0; v[k].mlo = 1;
+					/* the table does not say which links an MLO backhaul
+					 * uses; report the radios whose backhaul STA exists */
+					if (tbl->sta2g[i][0] | tbl->sta2g[i][1] | tbl->sta2g[i][2] | tbl->sta2g[i][3] | tbl->sta2g[i][4] | tbl->sta2g[i][5]) v[k].bandmask |= 1;
+					if (tbl->sta5g[i][0] | tbl->sta5g[i][1] | tbl->sta5g[i][2] | tbl->sta5g[i][3] | tbl->sta5g[i][4] | tbl->sta5g[i][5]) v[k].bandmask |= 2;
+					if (tbl->sta6g[i][0] | tbl->sta6g[i][1] | tbl->sta6g[i][2] | tbl->sta6g[i][3] | tbl->sta6g[i][4] | tbl->sta6g[i][5]) v[k].bandmask |= 4;
+				}
+				else if (path == 1 || path == 16 || path == 32 || path == 64) { v[k].wired = 1; v[k].wifi = 0; v[k].band[0] = '\0'; }
+				break;
+			}
+			if (memcmp(tbl->sta2g[i], mb, 6) == 0 || memcmp(tbl->sta5g[i], mb, 6) == 0 ||
+			    memcmp(tbl->sta6g[i], mb, 6) == 0) {
+				v[k].bh_sta = 1;
+				break;
+			}
+		}
+	}
+	shmdt(shm);
 }
 #else
-static int rdev_is_re_node(const char *mac) { (void)mac; return 0; }
+static void rdev_node_classify(struct rdev *v, int n) { (void)v; (void)n; }
 #endif
 
