 window.esc = window.ReaperEsc;
+
+/* ---------------------------------------------------------------------------
+ * Addons menu - ONE parser for BOTH rails (2026-08-21 field report: "the Addons
+ * menu still has 2 variants - one on the Dashboard, and the Merlin one
+ * everywhere else"). reaper_shell.asp had its own expansion over the live
+ * require() module and Main_ReaperDash.asp its own regex parse over the
+ * fetched menuTree.js text; they disagreed on detection (the dashboard also
+ * accepted the user<N>.asp page-name convention, the shell only the exact
+ * menu_Addons index), on external entries (dropped on the dashboard, new-tab
+ * on the shell) and on what to do when nothing survives. This is the single
+ * set of rules; each rail only supplies its own markup.
+ *
+ *   ReaperAddons.isAddonMenu(menu)            -> bool
+ *   ReaperAddons.entries(menu, excludedTabs)  -> [{url,label,external}]
+ *   ReaperAddons.fromText(menuTreeSource)     -> {label, entries} | null
+ *
+ * menuTree.js is the file third-party addons bind-mount over, so nothing here
+ * is trusted: callers must esc() every label and url. An entry is either a
+ * bare same-origin page (framed) or an http(s)/mailto link (external, new
+ * tab); anything else is dropped. */
+window.ReaperAddons = (function(){
+  var PAGE = /^[A-Za-z0-9_.-]+\.(asp|htm|html)$/;
+  function isExternal(u){ return /^(https?:)?\/\//i.test(u) || /^mailto:/i.test(u); }
+  function isAddonMenu(m){
+    if(!m) return false;
+    if(m.index === 'menu_Addons') return true;
+    var t = m.tab || [], i;
+    for(i = 0; i < t.length; i++)
+      if(t[i] && /^user\d*\.asp$/i.test(String(t[i].url || ''))) return true;
+    return false;
+  }
+  function entries(m, exTabs){
+    var out = [], t = (m && m.tab) || [], i, ta, u, n;
+    exTabs = exTabs || [];
+    for(i = 0; i < t.length; i++){
+      ta = t[i];
+      if(!ta || !ta.url || ta.url === 'NULL') continue;
+      u = String(ta.url); n = String(ta.tabName || '');
+      if(exTabs.indexOf(u) !== -1) continue;
+      if(!n || n === '__HIDE__' || n === '__INHERIT__') continue;
+      if(isExternal(u)) out.push({ url: u, label: n, external: true });
+      else if(PAGE.test(u)) out.push({ url: u, label: n, external: false });
+      /* anything else (scheme-less path, query string, traversal) is dropped */
+    }
+    return out;
+  }
+  /* Balanced {...} that starts at `s`, skipping string literals. '' if unbalanced. */
+  function blockFrom(txt, s){
+    var d = 0, q = '', i, c;
+    for(i = s; i < txt.length; i++){
+      c = txt.charAt(i);
+      if(q){ if(c === q && txt.charAt(i-1) !== '\\') q = ''; continue; }
+      if(c === '"' || c === "'" || c === '`'){ q = c; continue; }
+      if(c === '{') d++;
+      else if(c === '}'){ d--; if(!d) return txt.slice(s, i + 1); }
+    }
+    return '';
+  }
+  /* The MENU object enclosing `at`: walk outward from the innermost block until
+     one carries a tab:[ list (a url match lands inside a TAB object first). */
+  function menuBlockAround(txt, at){
+    var s = txt.lastIndexOf('{', at), blk, hops = 0;
+    while(s >= 0 && hops < 4){
+      blk = blockFrom(txt, s);
+      if(blk && /\btab\s*:\s*\[/.test(blk)) return blk;
+      s = txt.lastIndexOf('{', s - 1); hops++;
+    }
+    return '';
+  }
+  function fromText(txt){
+    txt = String(txt || '');
+    var m = /index\s*:\s*["']menu_Addons["']/i.exec(txt)
+         || /url\s*:\s*["']user\d*\.asp["']/i.exec(txt);
+    if(!m) return null;
+    var blk = menuBlockAround(txt, m.index);
+    if(!blk) return null;
+    var label = (/menuName\s*:\s*["']([^"']*)["']/.exec(blk) || [])[1] || 'Addons';
+    var tabs = [], re = /\{\s*url\s*:\s*["']([^"']*)["']\s*,\s*tabName\s*:\s*["']([^"']*)["'][^{}]*\}/g, r;
+    while((r = re.exec(blk))) tabs.push({ url: r[1], tabName: r[2] });
+    return { label: label, entries: entries({ tab: tabs }, []) };
+  }
+  return { isAddonMenu: isAddonMenu, entries: entries, fromText: fromText, isExternal: isExternal };
+})();
