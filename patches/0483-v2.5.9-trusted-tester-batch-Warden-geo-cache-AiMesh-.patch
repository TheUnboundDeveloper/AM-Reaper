@@ -24510,22 +24562,18 @@ static void do_reaper_dev_cgi(char *url, FILE *stream)
 		 * run after the FDB so it can correct that verdict, and before the
 		 * fallback below so it can pre-empt it. */
 		rdev_scan_amesh(dev, &n);
-		/* last resort: an online device the FDB never placed and no radio saw
-		 * is Wired - UNLESS it is an AiMesh RE node. A node reaches us over a
-		 * backhaul interface that is frequently neither eth* nor wl*-named
-		 * (WDS/dpsta), so rdev_scan_fdb() leaves it unclassified; a node that a
-		 * real ethernet port did NOT already place Wired is on a wireless
-		 * backhaul (field report 2026-08-19). Conservative: only fires for a
-		 * device the three passes above could not place, so a cabled node
-		 * (Wired via its eth FDB port) is untouched, and on a non-mesh box
-		 * rdev_is_re_node() is always 0 -> every such device is Wired as before. */
+		/* AiMesh NODES (the node device itself, not its clients): the cfg_mnt
+		 * table knows each node by LAN MAC and carries its uplink type
+		 * (re_path), so that verdict is authoritative and OVERRIDES the FDB
+		 * guess - a node reaches us over a backhaul interface that is neither
+		 * eth*- nor wl*-named (WDS/dpsta) and otherwise lands on the Wired
+		 * default below. See rdev_node_classify() for the 2026-08-19 miss. */
+		rdev_node_classify(dev, n);
+		/* last resort: an online device nothing above could place is Wired. */
 		for (i = 0; i < n; i++) {
 			if (!(dev[i].online && !dev[i].wifi && !dev[i].wired))
 				continue;
-			if (rdev_is_re_node(dev[i].mac))
-				dev[i].wifi = 1;	/* wireless-backhaul node */
-			else
-				dev[i].wired = 1;
+			dev[i].wired = 1;
 		}
 
 		/* 4. dhcp_staticlist reservations: <MAC>IP>DNS>HOST */
@@ -24628,6 +24676,14 @@ static void do_reaper_dev_cgi(char *url, FILE *stream)
 				for (j = 0; j < n; j++)
 					if (j != i && dev[j].resv && rdev_ip2u(dev[j].resv_ip) == rip) { dup = 1; break; }
 
+			/* a node's backhaul station is the node's uplink radio, not a
+			 * device; the node itself is listed under its LAN MAC. Fold it
+			 * unless the operator has named/reserved/gated that MAC on purpose. */
+			if (d->bh_sta && !d->resv && d->gk_state < 0) {
+				gk_client_name(d->mac, uname, sizeof(uname));
+				if (!uname[0]) continue;
+			}
+
 			gk_client_name(d->mac, uname, sizeof(uname));
 			have_user = uname[0] ? 1 : 0;
 			src = have_user ? "user" : (d->host[0] ? "lease" : "");
@@ -24651,8 +24707,8 @@ static void do_reaper_dev_cgi(char *url, FILE *stream)
 				if (d->bandmask & 1) strlcat(bands, "2.4", sizeof(bands));
 				if (d->bandmask & 2) { if (bands[0]) strlcat(bands, "+", sizeof(bands)); strlcat(bands, "5", sizeof(bands)); }
 				if (d->bandmask & 4) { if (bands[0]) strlcat(bands, "+", sizeof(bands)); strlcat(bands, "6", sizeof(bands)); }
-				websWrite(stream, ",\"rand\":%d,\"orphan\":%d,\"dup\":%d,\"nolease\":%d,\"mlo_link\":%d,\"mlo\":%d,\"bands\":\"%s\"}",
-					rdev_is_rand(d->mac), orphan, dup, nolease, mlo_link, d->mlo, bands);
+				websWrite(stream, ",\"rand\":%d,\"orphan\":%d,\"dup\":%d,\"nolease\":%d,\"mlo_link\":%d,\"mlo\":%d,\"bands\":\"%s\",\"node\":%d}",
+					rdev_is_rand(d->mac), orphan, dup, nolease, d->node ? 0 : mlo_link, d->mlo, bands, d->node ? 1 : 0);
 			}
 		}
 		websWrite(stream, "]}");
