diff --git a/release/src/router/rc/reaper_nv.h b/release/src/router/rc/reaper_nv.h
new file mode 100644
index 0000000000..8383df77e2
--- /dev/null
+++ b/release/src/router/rc/reaper_nv.h
@@ -0,0 +1,35 @@
+/*
+ * reaper_nv.h - reaper v2.6.1: the `_nv` shell helper emitted into every
+ * generated Reaper shell script (Warden apply/fold/stats/update, rwatch).
+ *
+ * WHY: libnvram can block forever inside a netlink recv (the wlcsm port-
+ * aliasing bug, see docs/ and memory "wlcsm-netlink-bug"). A bare
+ * `$(nvram get x)` in a cron script then pins that script - and anything it
+ * holds, e.g. fold.sh's ctr.lock - until reboot. Observed live 2026-08-21 on
+ * v2.6.0: `nvram get rwarden_stats_save` asleep in __skb_wait_for_more_packets
+ * for five hours with wlcsm_bindfix=1.
+ *
+ * The helper runs `nvram get` in the background and polls it at 20 ms for up
+ * to 5 s (250 ticks); a hung reader is SIGKILLed and logged (tag reaper-nv),
+ * and the caller sees an empty value - every emitter already treats empty as
+ * "unset/default". Cost on the normal path is one 20 ms tick. busybox here has
+ * usleep but no `timeout`, hence the hand-rolled loop.
+ *
+ * Emit this string right after the "#!/bin/sh" line of each generated script
+ * and write `$(_nv name)` instead of `$(nvram get name)`. Plain fputs-safe
+ * (no % characters).
+ */
+#ifndef REAPER_NV_H
+#define REAPER_NV_H
+#define REAPER_NV_HELPER \
+	"# _nv: nvram get with a 5 s ceiling (libnvram netlink wait-forever guard)\n" \
+	"_nv() {\n" \
+	"  _f=/tmp/.nv.$$.$1; nvram get \"$1\" >\"$_f\" 2>/dev/null & _p=$!; _i=0\n" \
+	"  while kill -0 \"$_p\" 2>/dev/null; do\n" \
+	"    _i=$((_i+1))\n" \
+	"    if [ \"$_i\" -gt 250 ]; then kill -9 \"$_p\" 2>/dev/null; logger -t reaper-nv \"nvram get $1 hung >5 s - killed (netlink wait)\"; break; fi\n" \
+	"    usleep 20000\n" \
+	"  done\n" \
+	"  wait \"$_p\" 2>/dev/null; cat \"$_f\" 2>/dev/null; rm -f \"$_f\"\n" \
+	"}\n"
+#endif
