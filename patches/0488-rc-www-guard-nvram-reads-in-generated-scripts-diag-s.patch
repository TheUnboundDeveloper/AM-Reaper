+sec "17. RWATCH (self-monitor state + durable store)"
+nvram show 2>/dev/null | grep -E '^(rwatch_|reaper_store)' | sort | sed 's/^/  /'
+# reaper v2.6.1: resolve the durable store the way rwatch.sh / rdev_store_base()
+# do, and report the syslog mirror. The old section only looked at /jffs/rwatch,
+# which is the INCIDENT-DUMP dir (created on first incident) - "none" there was
+# read as "rwatch broken / no mirror" twice during triage when the mirror was
+# sitting on the USB store the whole time.
+RS_BASE=/tmp/reaper
+case "$(nvram get reaper_store 2>/dev/null)" in
+  jffs) [ -d /jffs/reaper ] && RS_BASE=/jffs/reaper ;;
+  usb)  for d in /tmp/mnt/*/; do [ -d "$d" ] || continue; m="${d%/}"; grep -qF " $m " /proc/mounts 2>/dev/null || continue; [ -d "${d}.reaper" ] && { RS_BASE="${d}.reaper"; break; }; done ;;
+esac
+echo "  durable store     : $RS_BASE$( [ "$RS_BASE" = /tmp/reaper ] && echo ' (VOLATILE - lost at reboot)')"
+echo "  datastore opt-ins : $(nvram get reaper_store_ds 2>/dev/null)"
+if [ -s "$RS_BASE/syslog.mirror" ]; then
+  echo "  syslog mirror     : $RS_BASE/syslog.mirror $(wc -c < "$RS_BASE/syslog.mirror" 2>/dev/null) bytes, $(wc -l < "$RS_BASE/syslog.mirror" 2>/dev/null) lines"
+  echo "     spans          : $(head -1 "$RS_BASE/syslog.mirror" 2>/dev/null | cut -c1-15) .. $(tail -1 "$RS_BASE/syslog.mirror" 2>/dev/null | cut -c1-15)"
+  [ -s "$RS_BASE/syslog.mirror.1" ] && echo "     rotated        : syslog.mirror.1 $(wc -c < "$RS_BASE/syslog.mirror.1" 2>/dev/null) bytes"
+else
+  echo "  syslog mirror     : none (needs 'slog' in reaper_store_ds and a non-volatile store)"
+fi
+for h in devhist.log chqhist.log healthhist.log; do
+  [ -s "$RS_BASE/$h" ] && echo "  $h : $(wc -l < "$RS_BASE/$h" 2>/dev/null) lines"
+done
+RW_DUMP=/jffs/rwatch; case ",$(nvram get reaper_store_ds 2>/dev/null)," in *,watch,*) [ "$RS_BASE" != /tmp/reaper ] && RW_DUMP="$RS_BASE/rwatch";; esac
+if [ -d "$RW_DUMP" ] && [ -n "$(ls -A "$RW_DUMP" 2>/dev/null)" ]; then
+  echo "  -- captured failure bundles ($RW_DUMP) --"; ls -l "$RW_DUMP" 2>/dev/null | sed 's/^/     /'
 else
-  echo "  /jffs/rwatch : none"
+  echo "  incident bundles  : none ($RW_DUMP is created on the first incident - absence is healthy)"
 fi
 
