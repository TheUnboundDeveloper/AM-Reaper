  * straight past the arming timeout and past a USB-key removal. An ephemeral,
  * session-scoped daemon must not have an unbounded wait anywhere in it.
  */
+/* Append the lines of `path` whose prefix is one of the NUL-separated,
+ * double-NUL-terminated `prefixes`, in file order, up to `cap` bytes. The
+ * in-process replacement for "grep -E '^(A|B|C):' file" (v2.6.2). */
+static void sb_addfile_lines(sbuf_t *s, const char *path, const char *prefixes, size_t cap)
+{
+	FILE *f = fopen(path, "r");
+	char line[512];
+	size_t got = 0;
+	if (!f) { sb_puts(s, "(unavailable)"); return; }
+	while (fgets(line, sizeof(line), f)) {
+		const char *pfx = prefixes;
+		size_t n = strlen(line), match = 0;
+		for (; *pfx; pfx += strlen(pfx) + 1)
+			if (strncmp(line, pfx, strlen(pfx)) == 0) { match = 1; break; }
+		if (!match) continue;
+		if (got + n > cap) n = cap - got;
+		sb_add(s, line, n);
+		got += n;
+		if (got >= cap) break;
+	}
+	fclose(f);
+}
+
 static void sb_addcmd(sbuf_t *s, const char *cmd, size_t cap)
 {
 	FILE *p;
@@ -685,7 +708,11 @@ static void tool_overview(sbuf_t *s)
