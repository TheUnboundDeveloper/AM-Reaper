 		if (t.p) { char *nl = strchr(t.p, '\n'); if (nl) *nl = 0; } sb_json_str(s, t.p ? t.p : ""); sb_free(&t); }
-	sb_puts(s, ",\"meminfo\":"); { sbuf_t t; sb_init(&t); sb_puts(&t, ""); sb_addcmd(&t, "grep -E '^(MemTotal|MemFree|MemAvailable):' /proc/meminfo", 256);
+	sb_puts(s, ",\"meminfo\":"); { sbuf_t t; sb_init(&t); sb_puts(&t, "");
+		/* v2.6.2: the three lines read in-process (was a grep fork per call);
+		 * output byte-identical to the grep: matching lines, file order,
+		 * trailing newlines kept, capped at 256 bytes like the old sb_addcmd. */
+		sb_addfile_lines(&t, "/proc/meminfo", "MemTotal:\0MemFree:\0MemAvailable:\0", 256);
 		sb_json_str(s, t.p ? t.p : ""); sb_free(&t); }
