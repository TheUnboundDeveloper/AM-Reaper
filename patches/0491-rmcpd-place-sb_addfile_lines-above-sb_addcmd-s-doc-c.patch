From 4171c807108c0a79d644b980527e54c4f163f03c Mon Sep 17 00:00:00 2001
From: reaper <theunbounddeveloper@outlook.com>
Date: Fri, 21 Aug 2026 22:31:27 -0400
Subject: [PATCH] rmcpd: place sb_addfile_lines above sb_addcmd's doc comment

(cherry picked from commit 42a3824807586dd6bc39b9786b7d6a9dc1df7797)
---
 release/src/router/rmcpd/rmcpd.c | 18 +++++++++---------
 1 file changed, 9 insertions(+), 9 deletions(-)

diff --git a/release/src/router/rmcpd/rmcpd.c b/release/src/router/rmcpd/rmcpd.c
index 53a1126cf7..c718ce0f44 100644
--- a/release/src/router/rmcpd/rmcpd.c
+++ b/release/src/router/rmcpd/rmcpd.c
@@ -397,15 +397,6 @@ static FILE *popen_pid(const char *cmd, pid_t *pid_out)
 	}
 }
 
-/* Run a command, append its stdout, bounded in BOTH size and time.
- *
- * cap bounds the bytes; CMD_TIMEOUT_MS bounds the wall clock. Without the time
- * bound a single tool call could park the daemon for as long as its child felt
- * like running - a wl query against a wedged driver, a pipeline that never
- * closes stdout, a loaded box - and outlive the very session that authorised it,
- * straight past the arming timeout and past a USB-key removal. An ephemeral,
- * session-scoped daemon must not have an unbounded wait anywhere in it.
- */
 /* Append the lines of `path` whose prefix is one of the NUL-separated,
  * double-NUL-terminated `prefixes`, in file order, up to `cap` bytes. The
  * in-process replacement for "grep -E '^(A|B|C):' file" (v2.6.2). */
@@ -429,6 +420,15 @@ static void sb_addfile_lines(sbuf_t *s, const char *path, const char *prefixes,
 	fclose(f);
 }
 
+/* Run a command, append its stdout, bounded in BOTH size and time.
+ *
+ * cap bounds the bytes; CMD_TIMEOUT_MS bounds the wall clock. Without the time
+ * bound a single tool call could park the daemon for as long as its child felt
+ * like running - a wl query against a wedged driver, a pipeline that never
+ * closes stdout, a loaded box - and outlive the very session that authorised it,
+ * straight past the arming timeout and past a USB-key removal. An ephemeral,
+ * session-scoped daemon must not have an unbounded wait anywhere in it.
+ */
 static void sb_addcmd(sbuf_t *s, const char *cmd, size_t cap)
 {
 	FILE *p;
