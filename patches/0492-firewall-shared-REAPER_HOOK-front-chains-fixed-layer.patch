diff --git a/release/src/router/rc/reaper_hook.c b/release/src/router/rc/reaper_hook.c
new file mode 100644
index 0000000000..5b6fcf0d4e
--- /dev/null
+++ b/release/src/router/rc/reaper_hook.c
@@ -0,0 +1,73 @@
+/*
+ * reaper_hook.c - v2.6.2 shared front chains for the Reaper firewall layers.
+ * Rationale and contract: reaper_hook.h.
+ */
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <unistd.h>
+#include "rc.h"
+#include <shared.h>
+#include "reaper_hook.h"
+
+void reaper_hook_gen(void)
+{
+	FILE *f;
+	struct stat st;
+
+	if (stat(REAPER_HOOK_SH, &st) == 0 && S_ISREG(st.st_mode) && st.st_size > 0)
+		return;
+	mkdir(REAPER_HOOK_DIR, 0700);
+	f = fopen(REAPER_HOOK_SH ".tmp", "w");
+	if (!f) return;
+	fputs(
+	  "#!/bin/sh\n"
+	  "# generated by reaper_hook_gen - do not edit. See rc/reaper_hook.h.\n"
+	  "# Rebuilds the Reaper front chains in the FIXED order\n"
+	  "#   Warden -> Gatekeeper -> rules engine\n"
+	  "# and pins one jump per base chain at position 1. Idempotent; called by\n"
+	  "# every layer's apply.sh at its tail, so the order converges no matter\n"
+	  "# which layer restarted.\n"
+	  "GKIFS=\"\"; [ -r " GK_IFS_FILE " ] && GKIFS=\"$(head -c 512 " GK_IFS_FILE " 2>/dev/null)\"\n"
+	  /* charset gate: interface names only (the file is ours, but it is on tmpfs) */
+	  "[ -n \"$(printf '%s' \"$GKIFS\" | tr -d -- '-A-Za-z0-9_. ')\" ] && GKIFS=\"\"\n"
+	  "if [ -z \"$GKIFS\" ] && iptables -nL REAPER_GKF >/dev/null 2>&1; then logger -t reaper 'hook: Gatekeeper chains present but no interface list - gkd self-heal will re-apply'; fi\n"
+	  "for T in iptables ip6tables; do\n"
+	  "  for P in INPUT:" REAPER_HOOK_IN " FORWARD:" REAPER_HOOK_FWD " OUTPUT:" REAPER_HOOK_OUT "; do\n"
+	  "    H=\"${P%%:*}\"; C=\"${P##*:}\"\n"
+	  "    $T -N \"$C\" 2>/dev/null; $T -F \"$C\" 2>/dev/null\n"
+	  "    case \"$H\" in\n"
+	  "      INPUT)\n"
+	  "        $T -nL REAPER_WARDEN >/dev/null 2>&1 && $T -A \"$C\" -j REAPER_WARDEN\n"
+	  "        if $T -nL REAPER_GKI >/dev/null 2>&1; then for I in $GKIFS; do $T -A \"$C\" -i \"$I\" -j REAPER_GKI; done; fi\n"
+	  "        $T -nL REAPER_FWI >/dev/null 2>&1 && $T -A \"$C\" -j REAPER_FWI\n"
+	  "        ;;\n"
+	  "      FORWARD)\n"
+	  "        $T -nL REAPER_WARDEN >/dev/null 2>&1 && $T -A \"$C\" -j REAPER_WARDEN\n"
+	  "        if $T -nL REAPER_GKF >/dev/null 2>&1; then for I in $GKIFS; do $T -A \"$C\" -i \"$I\" -j REAPER_GKF; done; fi\n"
+	  "        $T -nL REAPER_FWF >/dev/null 2>&1 && $T -A \"$C\" -j REAPER_FWF\n"
+	  "        ;;\n"
+	  "      OUTPUT)\n"
+	  "        $T -nL RW_SELF >/dev/null 2>&1 && $T -A \"$C\" -j RW_SELF\n"
+	  "        $T -nL REAPER_FWO >/dev/null 2>&1 && $T -A \"$C\" -j REAPER_FWO\n"
+	  "        ;;\n"
+	  "    esac\n"
+	  "    # delete-all-then-insert: -C is position-blind, and a raced apply\n"
+	  "    # could have left two jumps\n"
+	  "    while $T -D \"$H\" -j \"$C\" 2>/dev/null; do :; done\n"
+	  "    $T -I \"$H\" 1 -j \"$C\" 2>/dev/null || logger -t reaper \"hook: $T -I $H -j $C FAILED\"\n"
+	  "  done\n"
+	  "done\n"
+	  "exit 0\n", f);
+	fclose(f);
+	chmod(REAPER_HOOK_SH ".tmp", 0700);
+	if (rename(REAPER_HOOK_SH ".tmp", REAPER_HOOK_SH) != 0)
+		unlink(REAPER_HOOK_SH ".tmp");
+}
+
+void reaper_hook_rebuild(void)
+{
+	reaper_hook_gen();
+	system("sh " REAPER_HOOK_SH);
+}
diff --git a/release/src/router/rc/reaper_hook.h b/release/src/router/rc/reaper_hook.h
new file mode 100644
index 0000000000..08348eabdb
--- /dev/null
+++ b/release/src/router/rc/reaper_hook.h
@@ -0,0 +1,57 @@
+/*
+ * reaper_hook.h - v2.6.2: ONE front chain per base chain for every Reaper
+ * firewall layer, with a FIXED evaluation order.
+ *
+ * THE DEFECT THIS CLOSES (backlog "[HIGH] Firewall layer ordering"): Warden,
+ * Gatekeeper and the rules engine each hooked their own chain with
+ * `-I <base> 1`, so whichever layer applied LAST sat on top. reaper_fw is the
+ * only layer that emits a terminal ACCEPT (user allow rules, zone policy,
+ * egress defaults, the DNAT companion) - the other two only DROP or RETURN.
+ * An ACCEPT inside a chain jumped from INPUT/FORWARD ends traversal of the
+ * whole table, so with reaper_fw on top (cold boot and every restart_firewall)
+ * a single allow rule silently re-admitted every threat-feed / geo-blocked
+ * source and every quarantined device. The same race existed on OUTPUT
+ * (REAPER_FWO vs RW_SELF) and the order changed with every restart_gk /
+ * restart_rwarden / gkd self-heal.
+ *
+ * THE FIX: the base chains carry exactly one Reaper jump each -
+ *   INPUT   -> REAPER_HOOK
+ *   FORWARD -> REAPER_HOOK_F
+ *   OUTPUT  -> REAPER_HOOK_O
+ * and inside each front chain the layers are appended in the invariant order
+ *   Warden (REAPER_WARDEN / RW_SELF)  ->  Gatekeeper (REAPER_GKI/GKF, per -i)
+ *   ->  rules engine (REAPER_FWI/FWF/FWO)
+ * i.e. every deny-only layer before the one allow-capable layer. A layer's
+ * RETURN now lands back in the front chain and continues to the next layer;
+ * a DROP/ACCEPT inside a layer chain is exactly as terminal as before.
+ *
+ * MECHANISM: rc generates /tmp/reaper/hook.sh once (reaper_hook_gen). Every
+ * layer's apply script calls it at its tail, so the order converges no matter
+ * which service restarted; it flushes the front chains, appends a jump for
+ * each layer chain that currently EXISTS (a disabled layer has no chain), then
+ * re-inserts the base jump with delete-all-then-`-I 1`. Never `-C || -I`:
+ * `-C` is position-blind. Gatekeeper's per-interface list is read from
+ * /tmp/gk/ifs, written by its own apply.sh.
+ *
+ * Teardowns strip a layer's jumps from the front chains (and still strip the
+ * pre-v2.6.2 direct base-chain jumps, so an upgrade from a running box cleans
+ * itself on the first apply). nat PREROUTING (REAPER_FWN / REAPER_GKN),
+ * ebtables and mangle are different tables and are NOT routed through this.
+ */
+#ifndef REAPER_HOOK_H
+#define REAPER_HOOK_H
+
+#define REAPER_HOOK_DIR  "/tmp/reaper"
+#define REAPER_HOOK_SH   REAPER_HOOK_DIR "/hook.sh"
+#define REAPER_HOOK_IN   "REAPER_HOOK"
+#define REAPER_HOOK_FWD  "REAPER_HOOK_F"
+#define REAPER_HOOK_OUT  "REAPER_HOOK_O"
