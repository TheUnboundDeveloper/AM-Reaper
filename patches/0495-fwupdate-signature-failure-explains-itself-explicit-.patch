diff --git a/release/src/router/rom/webs_scripts/reaper_webs_update.sh b/release/src/router/rom/webs_scripts/reaper_webs_update.sh
index 8c76bb3f728..32040d14858 100644
--- a/release/src/router/rom/webs_scripts/reaper_webs_update.sh
+++ b/release/src/router/rom/webs_scripts/reaper_webs_update.sh
@@ -85,15 +85,31 @@ if [ "$?" = "0" ] && [ -s "$SIGB64" ]; then
 	fi
 fi
 rm -f "$SIGB64" "$SIGBIN" "$PUBKEY"
+# One-shot, admin-explicit override (v2.7.3): the page sets this ONLY from a
+# type-to-confirm dialog after the signature failure was shown. It is consumed
+# here whether or not it was needed, so it can never linger armed. An
+# overridden check is loudly logged - it means the operator chose to trust an
+# update list the router could not authenticate.
+SIG_OVERRIDE="$(nvram get reaper_fwsig_override)"
+[ "$SIG_OVERRIDE" = "1" ] && nvram set reaper_fwsig_override=0
 if [ "$sig_ok" != "1" ]; then
-	echo "---- manifest signature MISSING or INVALID - refusing (fail closed) ----" >> "$LOG"
-	logger -t reaper-fw "update check: manifest signature missing or invalid - refusing the manifest"
-	rm -f "$TMP"
-	nvram set webs_state_error=1
-	nvram set webs_state_update=1
-	exit 0
+	if [ "$SIG_OVERRIDE" = "1" ]; then
+		echo "---- manifest signature MISSING/INVALID but ADMIN OVERRIDE is set - proceeding UNVERIFIED ----" >> "$LOG"
+		logger -t reaper-fw "update check: SIGNATURE OVERRIDE - proceeding with an UNVERIFIED manifest at the admin's explicit request"
+	else
+		echo "---- manifest signature MISSING or INVALID - refusing (fail closed) ----" >> "$LOG"
+		logger -t reaper-fw "update check: manifest signature missing or invalid - refusing the manifest"
+		rm -f "$TMP"
+		# error 9 = OUR code (stock uses 1-3): the page shows the authentication
+		# explanation instead of the generic "check failed", so the user knows
+		# WHY nothing is offered and what it can mean.
+		nvram set webs_state_error=9
+		nvram set webs_state_update=1
+		exit 0
+	fi
+else
+	echo "---- manifest signature verified ----" >> "$LOG"
 fi
-echo "---- manifest signature verified ----" >> "$LOG"
 
 # manifest line: MODEL#VARIANT#X.Y.Z#<download-url>[#SHA256[#SIZE]]
 # (fields 5/6 arrived with Phase 2; older manifests lack them - the page then
