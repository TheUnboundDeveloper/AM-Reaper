index 0000000000..d738e20044
--- /dev/null
+++ b/release/src/router/shared/gk_rl.c
@@ -0,0 +1,127 @@
+/*
+ * gk_rl.c - reaper v2.6.3: the Gatekeeper device-rule list lives on /jffs,
+ * not in nvram.
+ *
+ * FIELD REPORT (RT-BE88U, v2.6.0, 2026-08-22): the 46th approved device and
+ * every one after it "succeeded" in the UI and the audit log but never
+ * persisted - gk_rl stayed at 45 entries / 990 bytes. Root cause: on the HND
+ * platform the kernel nvram store (bcm_knvram, wlcsm_nvram.c) rejects any
+ * name+value tuple over WLCSM_NAMEVALUEPAIR_MAX = 1024 bytes with
+ * WLCSM_GEN_ERR, and libnvram surfaces nothing to the caller. Merlin's
+ * JFFS_NVRAM mechanism only rescues a fixed whitelist of names baked into
+ * the prebuilt libnvram.so (custom_clientlist, dhcp_staticlist, ...) - a
+ * Reaper variable cannot be added to it. So nvram_set("gk_rl", ...) silently
+ * does nothing once the list passes ~45 devices (22 bytes each).
+ *
+ * The list is Reaper-owned end to end (httpd, rc/gatekeeper.c, gkd are the
+ * only readers/writers), so it moves to a plain file:
+ *     /jffs/gatekeeper/rl      "<MAC>state>expiry<MAC>state>expiry..."
+ * same wire format, no size limit that matters (256 devices = 5.6 KB),
+ * atomic replace (tmp + rename), 0600. Callers keep the /tmp/gk/rl.lock
+ * flock discipline they already had around the read-modify-write.
+ *
+ * Migration: gk_rl_migrate() (called from start_gk) copies a non-empty
+ * nvram gk_rl into the file once, then clears the nvram copy so no stale
+ * value can shadow the file. Until that runs, gk_rl_get() falls back to
+ * nvram, so every reader behaves on an un-migrated box.
+ *
+ * Factory reset wipes /jffs = the list is gone, which is the correct
+ * default-deny outcome. Settings backup (nvram) no longer carries it.
+ */
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+#include <sys/stat.h>
+#include <bcmnvram.h>
+#include <shutils.h>
+#include "shared.h"
+
+#ifndef GK_RL_DIR
+#define GK_RL_DIR   "/jffs/gatekeeper"
+#endif
+#define GK_RL_FILE  GK_RL_DIR "/rl"
+#define GK_RL_MAX   (256 * 1024)	/* sanity cap on a read, far above any real list */
+
+static char *gk_rl_buf;	/* last value returned by gk_rl_get(); replaced on each call */
+
+char *gk_rl_get(void)
+{
+	FILE *f = fopen(GK_RL_FILE, "r");
+	char *nb = NULL;
+	size_t n = 0;
+
+	if (f) {
+		struct stat st;
+		if (fstat(fileno(f), &st) == 0 && S_ISREG(st.st_mode) && st.st_size >= 0 && st.st_size < GK_RL_MAX) {
+			nb = malloc((size_t)st.st_size + 1);
+			if (nb) {
+				n = fread(nb, 1, (size_t)st.st_size, f);
+				nb[n] = 0;
+				/* strip a trailing newline an editor may have left */
+				while (n && (nb[n - 1] == '\n' || nb[n - 1] == '\r')) nb[--n] = 0;
+			}
+		}
+		fclose(f);
+		if (!nb) nb = strdup("");
+	} else {
+		/* not migrated yet (or /jffs absent): the nvram copy is authoritative */
+		nb = strdup(nvram_safe_get("gk_rl"));
+	}
+	if (!nb) return "";
+	free(gk_rl_buf);
+	gk_rl_buf = nb;
+	return gk_rl_buf;
+}
+
+int gk_rl_set(const char *v)
+{
+	FILE *f;
+	size_t len = v ? strlen(v) : 0;
+
+	mkdir(GK_RL_DIR, 0700);
+	f = fopen(GK_RL_FILE ".tmp", "w");
+	if (!f) {
+		logmessage("gatekeeper", "cannot write " GK_RL_FILE ".tmp - device list NOT saved");
+		return -1;
+	}
+	if (len && fwrite(v, 1, len, f) != len) {
+		fclose(f); unlink(GK_RL_FILE ".tmp");
+		logmessage("gatekeeper", "short write to " GK_RL_FILE " - device list NOT saved");
+		return -1;
+	}
+	if (fflush(f) != 0 || fsync(fileno(f)) != 0) {
+		fclose(f); unlink(GK_RL_FILE ".tmp");
+		logmessage("gatekeeper", "flush of " GK_RL_FILE " failed - device list NOT saved");
+		return -1;
+	}
+	fclose(f);
+	chmod(GK_RL_FILE ".tmp", 0600);
+	if (rename(GK_RL_FILE ".tmp", GK_RL_FILE) != 0) {
+		unlink(GK_RL_FILE ".tmp");
+		logmessage("gatekeeper", "rename of " GK_RL_FILE " failed - device list NOT saved");
+		return -1;
+	}
+	return 0;
+}
+
+/* one-shot: nvram gk_rl -> file, then clear nvram so nothing stale shadows it */
+void gk_rl_migrate(void)
+{
+	const char *nv = nvram_safe_get("gk_rl");
+	struct stat st;
+
+	if (stat(GK_RL_FILE, &st) == 0) {
+		/* file exists: a leftover nvram value must not be re-imported later */
+		if (nv[0]) { nvram_unset("gk_rl"); nvram_commit(); }
+		return;
+	}
+	if (!nv[0]) return;
+	if (gk_rl_set(nv) == 0) {
+		int n = 0; const char *q;
+		for (q = nv; (q = strchr(q, '<')) != NULL; q++) n++;
+		logmessage("gatekeeper", "device list migrated from nvram to " GK_RL_FILE " (%d entries; nvram held a 1 KB cap)", n);
+		nvram_unset("gk_rl");
+		nvram_commit();
+	}
+}
