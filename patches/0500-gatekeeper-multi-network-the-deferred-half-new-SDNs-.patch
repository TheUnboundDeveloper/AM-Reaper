index 91c40ade31..9d7594f65d 100644
--- a/release/src/router/rc/services.c
+++ b/release/src/router/rc/services.c
@@ -20246,10 +20246,12 @@ check_ddr_done:
 			start_fbwifi();
 		}
 #endif
+		gk_refresh();	/* reaper v2.6.5: a new/edited SDN must be hooked now, not at the next restart_gk */
 	}
 	else if(strcmp(script, "sdn_del") == 0)
 	{
 		remove_sdn();
+		gk_refresh();	/* reaper v2.6.5 */
 	}
 	else if(strcmp(script, "sdn_del") == 0)
 	{
