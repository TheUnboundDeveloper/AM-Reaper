 extern void start_gk(void);
+extern void gk_refresh(void);	/* v2.6.5: re-apply after an SDN add/remove/edit */
 extern void gk_teardown_rules(void);
 extern int pidof_upnp(void);	/* reaper: pid of miniupnpd OR miniupnpd-igdv2 (exact-name pidof misses the latter) */
 extern void start_wlcsm_bindfix(void);	/* reaper: arm/clear the WLCSM netlink bind() shim via /etc/ld.so.preload */
