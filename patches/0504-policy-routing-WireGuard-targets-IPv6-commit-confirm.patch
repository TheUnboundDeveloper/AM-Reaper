+/* ===================================================================
+ * reaper v2.6.7: Policy Routing commit-confirm (Reaper_VPNRouting.asp).
+ *
+ * Mirrors do_reaper_fw_cgi's three verbs. Everything here edits the DRAFT
+ * only: `apply` writes the two lists into nvram RAM and never commits; the
+ * single path that writes flash is reaper_pbr_confirm() in rc, after the
+ * operator has confirmed rules that are already live. See rc/reaper_pbr.c P7.
+ * =================================================================== */
+#define RPBR_LIST_MAX	8192
+
+static void
+do_reaper_pbr_cgi(char *url, FILE *stream)
+{
+	char *action = get_cgi("action");
+
+	if (!action) action = "cfg";
+
+	{
+		char *hid = get_cgi("http_id"), *want = nvram_safe_get("http_id");
+		if (!hid || !want[0] || strcmp(hid, want) != 0) {
+			websWrite(stream, "{\"ok\":0,\"error\":\"invalid request token\",\"ek\":\"RDEVE_1\"}");
+			return;
+		}
+	}
+
+	/* the lists plus live commit-confirm state. `active` is what the page
+	 * polls after an apply: `enable` is what was asked for, `active` is written
+	 * by rc once the chain actually changed (rule 42). */
+	if (strcmp(action, "cfg") == 0) {
+		long left = 0;
+		if (nvram_match("reaper_pbr_armed", "1")) {
+			FILE *df = fopen("/tmp/reaper_pbr/deadline", "r");
+			long dl = 0;
+			if (df) {
+				if (fscanf(df, "%ld", &dl) != 1) dl = 0;
+				fclose(df);
+			}
+			left = dl - (long)time(NULL);
+			if (left < 0) left = 0;
+		}
+		websWrite(stream, "{\"ok\":1,\"active\":%d,\"enable\":%d,\"confirm\":%d,\"armed\":%d,\"left\":%ld,\"wg\":[%d,%d,%d,%d,%d]",
+			nvram_match("reaper_pbr_active", "1") ? 1 : 0,
+			nvram_match("reaper_pbr_enable", "1") ? 1 : 0,
+			nvram_get_int("reaper_fw_confirm"),
+			nvram_match("reaper_pbr_armed", "1") ? 1 : 0,
+			left,
+			nvram_get_int("wgc1_enable"), nvram_get_int("wgc2_enable"), nvram_get_int("wgc3_enable"),
+			nvram_get_int("wgc4_enable"), nvram_get_int("wgc5_enable"));
+		websWrite(stream, ",\"err\":");
+		gk_json_esc(stream, nvram_safe_get("reaper_pbr_err"));
+		websWrite(stream, ",\"rulelist\":");
+		gk_json_esc(stream, nvram_safe_get("reaper_pbr_rulelist"));
+		websWrite(stream, "}");
+		return;
+	}
+
+	/* stage the draft (RAM only) and arm. The engine validates every record
+	 * structurally at generation time (rc/reaper_pbr.c P2); what matters HERE
+	 * is that the bytes are printable ASCII and bounded. */
+	if (strcmp(action, "apply") == 0) {
+		char *en = get_cgi("enable"), *rl = get_cgi("rulelist");
+		const char *p;
+		if (!en || !rl || (strcmp(en, "0") && strcmp(en, "1"))) {
+			websWrite(stream, "{\"ok\":0,\"error\":\"missing parameter\"}");
+			return;
+		}
+		if (strlen(rl) >= RPBR_LIST_MAX) {
+			websWrite(stream, "{\"ok\":0,\"error\":\"list too long\"}");
+			return;
+		}
+		for (p = rl; *p; p++) {
+			if ((unsigned char)*p < 0x20 || (unsigned char)*p > 0x7E) {
+				websWrite(stream, "{\"ok\":0,\"error\":\"unsupported character\"}");
+				return;
+			}
+		}
+		if (nvram_match("reaper_pbr_armed", "1")) {
+			websWrite(stream, "{\"ok\":0,\"error\":\"a change is already awaiting confirmation\"}");
+			return;
+		}
+		nvram_set("reaper_pbr_enable", en);       /* RAM only - see the note above */
+		nvram_set("reaper_pbr_rulelist", rl);
+		nvram_unset("reaper_pbr_err");
+		notify_rc("start_reaper_pbr_apply");
+		websWrite(stream, "{\"ok\":1}");
+		return;
+	}
+	if (strcmp(action, "confirm") == 0) {
+		notify_rc("start_reaper_pbr_confirm");
+		websWrite(stream, "{\"ok\":1}");
+		return;
+	}
+	if (strcmp(action, "rollback") == 0) {
+		notify_rc("start_reaper_pbr_rollback");
+		websWrite(stream, "{\"ok\":1}");
+		return;
+	}
+
+	websWrite(stream, "{\"ok\":0,\"error\":\"unknown action\"}");
+}
