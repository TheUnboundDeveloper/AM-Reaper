+static int ppbr_lastgood_ok(void)
+{
+	char probe[128];
+	snprintf(probe, sizeof(probe), "%s/.committed", PPBR_LASTGOOD);
+	return f_exists(probe);
+}
+
+/* persist the CONFIRMED config as the rollback + boot source: per-key temp
+ * file, fsync, rename, then a .committed marker (same discipline as
+ * reaper_fw's rfw_write_lastgood - a half-written snapshot must never boot). */
+static int ppbr_write_lastgood(void)
+{
+	int i, ok = 1;
+	char marker[128];
+	mkdir(PPBR_CACHE, 0700);
+	mkdir(PPBR_LASTGOOD, 0700);
+	snprintf(marker, sizeof(marker), "%s/.committed", PPBR_LASTGOOD);
+	unlink(marker);
+	for (i = 0; i < PPBR_NKEYS; i++) {
+		char p[128], tmp[140];
+		FILE *f;
+		const char *val = nvram_safe_get(ppbr_keys[i].nv);
+		snprintf(p, sizeof(p), "%s/%s", PPBR_LASTGOOD, ppbr_keys[i].file);
+		snprintf(tmp, sizeof(tmp), "%s.tmp", p);
+		if ((f = fopen(tmp, "w")) == NULL) { ok = 0; break; }
+		if (fputs(val, f) == EOF || fflush(f) != 0 || fsync(fileno(f)) != 0) { fclose(f); unlink(tmp); ok = 0; break; }
+		if (fclose(f) != 0) { unlink(tmp); ok = 0; break; }
+		chmod(tmp, 0600);
+		if (rename(tmp, p) != 0) { unlink(tmp); ok = 0; break; }
+	}
+	if (ok) {
+		FILE *m = fopen(marker, "w");
+		if (!m) ok = 0;
+		else {
+			if (fputs("1\n", m) == EOF || fflush(m) != 0 || fsync(fileno(m)) != 0) ok = 0;
+			if (fclose(m) != 0) ok = 0;
+			if (ok) chmod(marker, 0600);
+			else unlink(marker);
+		}
+	}
+	if (!ok)
+		logmessage("reaper_pbr", "lastgood snapshot incomplete - boot will fall back to nvram");
+	return ok;
+}
