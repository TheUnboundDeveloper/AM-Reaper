+/* the per-minute deadline watcher */
+static void ppbr_gen_cc(void)
+{
+	FILE *f = fopen(PPBR_CC, "w");
+	if (!f) return;
+	fprintf(f,
+	  "#!/bin/sh\n"
+	  "[ -d " PPBR_ARMED " ] || exit 0\n"
+	  "D=\"$(cat " PPBR_DEADLINE " 2>/dev/null)\"\n"
+	  "case \"$D\" in ''|*[!0-9]*) exit 0;; esac\n"
+	  "N=\"$(date +%%s)\"\n"
+	  "[ \"$N\" -lt \"$D\" ] && exit 0\n"
+	  "sh " PPBR_ROLLBACK "\n");
+	fclose(f);
+	chmod(PPBR_CC, 0700);
+}
