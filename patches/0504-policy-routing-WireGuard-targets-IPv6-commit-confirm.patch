+/* ---------------------------------------------------------------------------
+ * Config load: from nvram (the draft) or from the lastgood snapshot (P7).
+ * ------------------------------------------------------------------------- */
+static int ppbr_cfg_load(ppbr_cfg_t *c, int from_good)
+{
+	memset(c, 0, sizeof(*c));
+	if (from_good) {
+		char p[128], *buf;
+		int i;
+		for (i = 0; i < PPBR_NKEYS; i++) {
+			snprintf(p, sizeof(p), "%s/%s", PPBR_LASTGOOD, ppbr_keys[i].file);
+			buf = NULL;
+			if (f_read_alloc_string(p, &buf, 65536) < 0 || !buf) { free(c->rulelist); c->rulelist = NULL; return 0; }
+			buf[strcspn(buf, "\r\n")] = 0;
+			if (i == 0) { c->enable = (strcmp(buf, "1") == 0); free(buf); }
+			else c->rulelist = buf;
+		}
+		return 1;
+	}
+	c->enable = nvram_match("reaper_pbr_enable", "1");
+	c->rulelist = strdup(nvram_safe_get("reaper_pbr_rulelist"));
+	return c->rulelist != NULL;
+}
+
+static void ppbr_cfg_free(ppbr_cfg_t *c)
+{
+	free(c->rulelist);
+	c->rulelist = NULL;
+}
