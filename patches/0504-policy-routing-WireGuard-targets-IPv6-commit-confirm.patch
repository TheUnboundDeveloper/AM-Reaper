+	if (n < PPBR_CONFIRM_MIN) n = (n <= 0) ? PPBR_CONFIRM_DEF : PPBR_CONFIRM_MIN;
+	if (n > PPBR_CONFIRM_MAX) n = PPBR_CONFIRM_MAX;
+	return n;
+}
