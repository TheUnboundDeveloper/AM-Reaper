+/* the pre-generated recovery script: restore lastgood into nvram (RAM),
+ * rebuild from it, disarm. Runs from cron with neither httpd nor rc needed. */
+static int ppbr_gen_rollback(void)
+{
+	FILE *f;
+	ppbr_cfg_t good;
+	int i;
+
+	if (!ppbr_cfg_load(&good, 1)) return 0;
+	if (!ppbr_gen(PPBR_ROLLBACK ".rules", !good.enable, &good)) { ppbr_cfg_free(&good); return 0; }
+	ppbr_cfg_free(&good);
+
+	if ((f = fopen(PPBR_ROLLBACK, "w")) == NULL) return 0;
+	fprintf(f,
+	  "#!/bin/sh\n"
+	  "# generated by reaper_pbr - commit-confirm recovery. Restores the last\n"
+	  "# CONFIRMED policy-routing config and disarms. Safe to run at any time.\n");
+	for (i = 0; i < PPBR_NKEYS; i++)
+		/* "$(cat f)" is expanded once and never re-parsed (operator text cannot execute) */
+		fprintf(f, "[ -f %s/%s ] && nvram set %s=\"$(cat %s/%s)\"\n",
+		        PPBR_LASTGOOD, ppbr_keys[i].file, ppbr_keys[i].nv,
+		        PPBR_LASTGOOD, ppbr_keys[i].file);
+	fprintf(f,
+	  "sh " PPBR_ROLLBACK ".rules 2>/dev/null\n"
+	  "[ \"$(nvram get reaper_pbr_enable)\" = 1 ] && nvram set reaper_pbr_active=1 || nvram set reaper_pbr_active=0\n"
+	  "rm -f " PPBR_DEADLINE " " PPBR_CAND "\n"
+	  "rmdir " PPBR_ARMED " 2>/dev/null\n"
+	  "cru d reaper_pbr_cc 2>/dev/null\n"
+	  "nvram set reaper_pbr_armed=0\n"
+	  "logger -t reaper_pbr 'commit-confirm: reverted to the last confirmed routing rules'\n");
+	fclose(f);
+	chmod(PPBR_ROLLBACK, 0700);
+	chmod(PPBR_ROLLBACK ".rules", 0700);
+	return 1;
+}
