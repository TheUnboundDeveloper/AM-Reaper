-static int ppbr_selector(char *buf, size_t buflen, const char *seltype, const char *selval)
+/* Normalise a v4 "a.b.c.d[/n]" into the form the kernel's skip-list READ
+ * prints ("A.B.C.D/n", network address masked) so the generated script can
+ * tell "already listed" from "listed by us". Returns 0 on a bad value. */
+static int ppbr_norm_v4(const char *s, char *out, size_t outlen)
+{
+	char ip[32];
+	struct in_addr a;
+	unsigned long pl = 32;
+	const char *sl = strchr(s, '/');
+	size_t n = sl ? (size_t)(sl - s) : strlen(s);
+	if (n == 0 || n >= sizeof(ip)) return 0;
+	memcpy(ip, s, n); ip[n] = 0;
+	if (inet_pton(AF_INET, ip, &a) != 1) return 0;
+	if (sl) {
+		char *e;
+		pl = strtoul(sl + 1, &e, 10);
+		if (*e || pl < 1 || pl > 32) return 0;
+	}
+	if (pl < 32) a.s_addr &= htonl(0xFFFFFFFFu << (32 - pl));
+	snprintf(out, outlen, "%s/%lu", inet_ntoa(a), pl);
+	return 1;
+}
