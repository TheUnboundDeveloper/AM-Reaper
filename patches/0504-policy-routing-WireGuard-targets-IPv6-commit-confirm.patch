+/* run a generated script under the firewall lock; returns the exit code */
+static int ppbr_run(const char *path)
+{
+	char cmd[200];
+	int lock, rc;
+	snprintf(cmd, sizeof(cmd), "sh %s 2>/dev/null", path);
+	lock = file_lock("firewall");                   /* P4 */
+	chmod(path, 0700);
+	rc = system(cmd);
+	file_unlock(lock);
+	return (rc == -1) ? -1 : WEXITSTATUS(rc);
+}
