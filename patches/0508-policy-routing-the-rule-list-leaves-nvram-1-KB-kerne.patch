@@ -0,0 +1,104 @@
+/*
+ * reaper_jfile.c - reaper v2.6.7: a tiny durable text-value store for lists
+ * that must NOT live in nvram.
+ *
+ * WHY. On the HND platform the kernel nvram store rejects any name+value tuple
+ * over WLCSM_NAMEVALUEPAIR_MAX = 1024 bytes - silently, even for a RAM-only
+ * nvram_set() - and Merlin's JFFS_NVRAM whitelist is baked into the prebuilt
+ * libnvram.so, so a Reaper name cannot be added to it. The Gatekeeper device
+ * list hit that wall at 45 devices (shared/gk_rl.c, v2.6.3); the Policy
+ * Routing rule list hits it at ~15 rules. This is the gk_rl store shape made
+ * reusable: read a whole file, write it atomically (tmp + fsync + rename,
+ * 0600), strip a trailing newline an editor may have left.
+ *
+ * Callers own their paths, their locking and their migration; this only does
+ * the bytes. Values are opaque printable text; nothing here parses them.
+ */
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+#include <sys/stat.h>
+#include <bcmnvram.h>
+#include <shutils.h>
+#include "shared.h"
+
+#define RJF_MAX (256 * 1024)	/* sanity cap on a read, far above any real list */
+
+static char *rjf_buf;	/* last value returned by rjf_get(); replaced on each call */
+
+/* returns "" when the file is absent or empty; -1 via *exists when absent */
+char *rjf_get(const char *path, int *exists)
+{
+	FILE *f = fopen(path, "r");
+	char *nb = NULL;
+	size_t n = 0;
+
+	if (exists) *exists = (f != NULL);
+	if (f) {
+		struct stat st;
+		if (fstat(fileno(f), &st) == 0 && S_ISREG(st.st_mode) && st.st_size >= 0 && st.st_size < RJF_MAX) {
+			nb = malloc((size_t)st.st_size + 1);
+			if (nb) {
+				n = fread(nb, 1, (size_t)st.st_size, f);
+				nb[n] = 0;
+				while (n && (nb[n - 1] == '\n' || nb[n - 1] == '\r')) nb[--n] = 0;
+			}
+		}
+		fclose(f);
+	}
+	if (!nb) nb = strdup("");
+	if (!nb) return "";
+	free(rjf_buf);
+	rjf_buf = nb;
+	return rjf_buf;
+}
+
+int rjf_set(const char *path, const char *v, const char *tag)
+{
+	FILE *f;
+	char tmp[256], dir[256], *sl;
+	size_t len = v ? strlen(v) : 0;
+
+	/* the parent directory, created if missing (one level - that is all our callers need) */
+	strlcpy(dir, path, sizeof(dir));
+	if ((sl = strrchr(dir, '/')) != NULL && sl != dir) { *sl = 0; mkdir(dir, 0700); }
+	snprintf(tmp, sizeof(tmp), "%s.tmp", path);
+	f = fopen(tmp, "w");
+	if (!f) {
+		logmessage(tag, "cannot write %s - NOT saved", tmp);
+		return -1;
+	}
+	if (len && fwrite(v, 1, len, f) != len) {
+		fclose(f); unlink(tmp);
+		logmessage(tag, "short write to %s - NOT saved", path);
+		return -1;
+	}
+	if (fflush(f) != 0 || fsync(fileno(f)) != 0) {
+		fclose(f); unlink(tmp);
+		logmessage(tag, "flush of %s failed - NOT saved", path);
+		return -1;
+	}
+	fclose(f);
+	chmod(tmp, 0600);
+	if (rename(tmp, path) != 0) {
+		unlink(tmp);
+		logmessage(tag, "rename of %s failed - NOT saved", path);
+		return -1;
+	}
+	return 0;
+}
+
+/* ---- Policy Routing rule list (rc/reaper_pbr.c + httpd share this) ----
+ * Resolution order: the staged draft (an apply awaiting confirmation), then
+ * the last CONFIRMED list, then - on a box that has not migrated yet - the
+ * old nvram value. */
+char *reaper_pbr_rl_get(void)
+{
+	int ex;
+	char *v = rjf_get(REAPER_PBR_DRAFT, &ex);
+	if (ex) return v;
+	v = rjf_get(REAPER_PBR_RL, &ex);
+	if (ex) return v;
+	return nvram_safe_get("reaper_pbr_rulelist");
+}
