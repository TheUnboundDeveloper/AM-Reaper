diff --git a/release/src/router/Makefile b/release/src/router/Makefile
index 77323d9673..340b7565aa 100644
--- a/release/src/router/Makefile
+++ b/release/src/router/Makefile
@@ -5196,10 +5196,10 @@ ifneq ($(NO_MKTOOLS),y)
 #	install -D e2fsprogs/misc/tune2fs $(INSTALLDIR)/e2fsprogs/usr/sbin/tune2fs
 	ln -sf mke2fs $(INSTALLDIR)/e2fsprogs/usr/sbin/mkfs.ext2
 	ln -sf mke2fs $(INSTALLDIR)/e2fsprogs/usr/sbin/mkfs.ext3
-ifeq ($(RTCONFIG_EXT4FS),y)
+# reaper v2.6.8: same as the fsck.ext4 note above - mke2fs handles ext4, the
+# link was only ever gated on RTCONFIG_EXT4FS (hard-set n).
 	ln -sf mke2fs $(INSTALLDIR)/e2fsprogs/usr/sbin/mkfs.ext4
 endif
-endif
 else ifeq ($(RTCONFIG_EXT4FS),y)
 	install -D e2fsprogs/e2fsck/e2fsck $(INSTALLDIR)/e2fsprogs/usr/sbin/fsck.ext4
 ifneq ($(NO_MKTOOLS),y)
diff --git a/release/src/router/rc/usb.c b/release/src/router/rc/usb.c
index 78e0f13ec5..c1cb19f066 100644
--- a/release/src/router/rc/usb.c
+++ b/release/src/router/rc/usb.c
@@ -4744,6 +4744,16 @@ static void start_diskformat(char *port_path)
 		char *tntfs_cmd[] = {"mkntfs", "-F", "-L", disk_label, "-v", devpath, NULL };
 		char *thfsplus_cmd[] = { "newfs_hfs", "-v", disk_label, devpath, NULL };
 #endif
+		/* reaper v2.6.8: ext2 / ext3 / ext4. e2fsprogs' mke2fs ships in the
+		 * image (its default profile is compiled in, so -t works without an
+		 * /etc/mke2fs.conf) and the mount path already handles all three
+		 * (ext4 driver, CONFIG_EXT4_USE_FOR_EXT2). -F: a whole device, not a
+		 * partition, same as the Tuxera tools above. -m 1: one percent
+		 * reserved for root instead of five - this is a data disk. Label max
+		 * is 16 for ext; the page caps it at 11 (the FAT limit), within that. */
+		char *ext2_cmd[] = { "mke2fs", "-F", "-t", "ext2", "-m", "1", "-L", disk_label, devpath, NULL };
+		char *ext3_cmd[] = { "mke2fs", "-F", "-t", "ext3", "-m", "1", "-L", disk_label, devpath, NULL };
+		char *ext4_cmd[] = { "mke2fs", "-F", "-t", "ext4", "-m", "1", "-L", disk_label, devpath, NULL };
 		// format partition.
 		snprintf(devpath, sizeof(devpath), "/dev/%s", di->device);
 		dbg("disk_format: prepare device %s ...\n", di->device);
@@ -4770,6 +4780,16 @@ static void start_diskformat(char *port_path)
 		}
 		else
 #endif
+		if (!strcmp(disk_system, "ext4") && f_exists("/usr/sbin/mke2fs")) {
+			cmd = ext4_cmd;
+		}
+		else if (!strcmp(disk_system, "ext3") && f_exists("/usr/sbin/mke2fs")) {
+			cmd = ext3_cmd;
+		}
+		else if (!strcmp(disk_system, "ext2") && f_exists("/usr/sbin/mke2fs")) {
+			cmd = ext2_cmd;
+		}
+		else
 		{
 			dbg("disk_format: Can't format [%s] as filesystem [%s] w/o tool.\n", devpath, disk_system);
 			logmessage("disk_format", "Can't format %s as filesystem %s w/o tool.", devpath, disk_system);
