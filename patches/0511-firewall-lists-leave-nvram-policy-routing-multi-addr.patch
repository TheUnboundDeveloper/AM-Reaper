+/* v2.6.9: the eight lists live in files (see shared/reaper_jfile.c). First
+ * boot on this build seeds the confirmed snapshot from nvram and clears the
+ * nvram copies; runs whether or not the engine is enabled, because the object
+ * lists are read by policy routing too. Returns 1 when a committed snapshot
+ * exists afterwards. */
+static int rfw_migrate_lists(void)
+{
+	char probe[128];
+	int from_good;
+	snprintf(probe, sizeof(probe), "%s/.committed", RFW_LASTGOOD);
+	from_good = f_exists(probe) ? 1 : 0;
+	/* v2.6.9: first boot on this build - what nvram holds IS the confirmed
+	 * config. Seed the snapshot from it (rfw_write_lastgood reads through the
+	 * resolver, which falls back to nvram while no snapshot exists), then
+	 * clear the nvram copies so nothing stale shadows the files - the gk_rl /
+	 * reaper_pbr migration shape. A leftover nvram value on a migrated box (a
+	 * settings restore) is dropped the same way. */
+	if (!from_good) {
+		int i, n = 0;
+		for (i = 0; i < RFW_NKEYS; i++) if (nvram_safe_get(rfw_keys[i].nv)[0]) n++;
+		if (rfw_write_lastgood()) {
+			for (i = 0; i < RFW_NKEYS; i++) nvram_unset(rfw_keys[i].nv);
+			if (n) { nvram_commit(); logmessage("reaper_fw", "%d list(s) migrated from nvram to %s (nvram held a 1 KB cap per list)", n, RFW_LASTGOOD); }
+			from_good = 1;
+		}
+	} else {
+		int i, n = 0;
+		for (i = 0; i < RFW_NKEYS; i++) if (nvram_safe_get(rfw_keys[i].nv)[0]) { nvram_unset(rfw_keys[i].nv); n++; }
+		if (n) nvram_commit();
+	}
+	/* (no draft cleanup here: /tmp is tmpfs so none survives a boot, and this
+	 * also runs on the enable toggle, where an unsaved edit must be kept) */
+	return from_good;
+}
+
+/* Policy routing confirmed: the object / group lists it edits become
+ * confirmed too. With the engine OFF nothing else would ever persist them
+ * (they would live in the tmpfs draft and vanish at reboot); with it ON only
+ * the two additive lists are promoted - a set existing filters nothing - and
+ * never while the engine's own change is awaiting confirmation. */
+void reaper_fw_promote_objects(void)
+{
+	static const char *keys[] = { "obj", "grp" };
+	int i;
+	if (d_exists(RFW_ARMED)) {
+		logmessage("reaper_fw", "object lists left in the draft - a firewall change is awaiting confirmation");
+		return;
+	}
+	if (!nvram_match("reaper_fw_enable", "1")) {
+		if (rfw_write_lastgood()) eval("rm", "-rf", REAPER_FW_DRAFT_DIR);
+		return;
+	}
+	for (i = 0; i < 2; i++) {
+		char d[128], p[128];
+		int ex;
+		char *v;
+		snprintf(d, sizeof(d), REAPER_FW_DRAFT_DIR "/%s", keys[i]);
+		v = rjf_get(d, &ex);
+		if (!ex) continue;
+		snprintf(p, sizeof(p), "%s/%s", RFW_LASTGOOD, keys[i]);
+		if (rjf_set(p, v, "reaper_fw") == 0) unlink(d);
+	}
+}
