+/* ---- Firewall engine lists (rc/reaper_fw.c + httpd share this) ----
+ * key = obj|grp|svc|zone|zpol|rules|edef|nat. Resolution order as for the
+ * routing list: the staged draft (httpd `save`, an edit not yet applied or
+ * applied-and-awaiting-confirm), then the last CONFIRMED list (/jffs, written
+ * only by reaper_fw_confirm), then - on a box that has not migrated - the old
+ * nvram value. The eight lists hit the same 1 KB kernel cap the device and
+ * routing lists did (v2.6.3 / v2.6.7): a 40-domain object silently never
+ * saved. */
+char *reaper_fw_list_get(const char *key)
+{
+	char p[128], nv[40];
+	int ex;
+	char *v;
+	snprintf(p, sizeof(p), REAPER_FW_DRAFT_DIR "/%s", key);
+	v = rjf_get(p, &ex);
+	if (ex) return v;
+	snprintf(p, sizeof(p), REAPER_FW_LASTGOOD_DIR "/.committed");
+	if (f_exists(p)) {
+		snprintf(p, sizeof(p), REAPER_FW_LASTGOOD_DIR "/%s", key);
+		v = rjf_get(p, &ex);
+		if (ex) return v;
+		return "";		/* a committed snapshot with no file for this key = empty list */
+	}
+	snprintf(nv, sizeof(nv), "reaper_fw_%s", key);
+	return nvram_safe_get(nv);
+}
+
+int reaper_fw_list_stage(const char *key, const char *v)
+{
+	char p[128];
+	snprintf(p, sizeof(p), REAPER_FW_DRAFT_DIR "/%s", key);
+	return rjf_set(p, v, "reaper_fw");
+}
