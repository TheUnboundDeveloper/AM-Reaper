+
+/* v2.6.10: Reaper-wide settings backup. Export = a JSON file the browser
+   saves; import = the same file posted back, replayed through each feature's
+   own save path (firewall / routing lists land as drafts - apply + keep them
+   on their pages; Gatekeeper + Warden restart at once). */
+(function(){
+  var HTTPID_CFG = '<% nvram_get("http_id"); %>';
+  function cfgMsg(ok, t){ var m=document.getElementById('cfg_msg'); if(!m) return; m.textContent=t; m.style.color = ok ? 'var(--jade)' : 'var(--danger)'; }
+  var ex = document.getElementById('cfg_export');
+  if(ex) ex.onclick = function(){
+    var x = new XMLHttpRequest();
+    x.open('GET', '/reaper_cfg.cgi?action=export&http_id=' + encodeURIComponent(HTTPID_CFG) + '&_=' + Date.now(), true);
+    x.onreadystatechange = function(){
+      if(x.readyState !== 4) return;
+      var j = null; try{ j = JSON.parse(x.responseText); }catch(e){}
+      if(!j || !j.ok){ cfgMsg(false, `<#RDST_74#>`); return; }
+      var name = 'reaper-settings-' + String(j.model||'router').replace(/[^A-Za-z0-9_-]/g,'') + '-' + String(j.version||'').replace(/[^A-Za-z0-9_.-]/g,'') + '-' + new Date().toISOString().slice(0,10) + '.json';
+      var blob = new Blob([JSON.stringify(j, null, 1)], {type:'application/json'});
+      var a = document.createElement('a'); a.href = URL.createObjectURL(blob); a.download = name;
+      document.body.appendChild(a); a.click(); setTimeout(function(){ URL.revokeObjectURL(a.href); a.remove(); }, 2000);
+      cfgMsg(true, `<#RDST_73#>` + ' ' + name);
+    };
+    x.send();
+  };
+  var fi = document.getElementById('cfg_file');
+  if(fi) fi.onchange = function(){
+    var f = fi.files && fi.files[0]; if(!f) return;
+    if(f.size > 300000){ cfgMsg(false, `<#RDST_75#>`); fi.value=''; return; }
+    var rd = new FileReader();
+    rd.onload = function(){
+      var txt = String(rd.result||''), j = null;
+      try{ j = JSON.parse(txt); }catch(e){}
+      if(!j || !j.reaper_cfg){ cfgMsg(false, `<#RDST_75#>`); fi.value=''; return; }
+      if(!confirm(`<#RDST_76#>`)){ fi.value=''; return; }
+      var x = new XMLHttpRequest();
+      x.open('POST', '/reaper_cfg.cgi', true);
+      x.setRequestHeader('Content-Type', 'application/x-www-form-urlencoded');
+      x.onreadystatechange = function(){
+        if(x.readyState !== 4) return;
+        var r = null; try{ r = JSON.parse(x.responseText); }catch(e){}
+        fi.value = '';
+        if(!r || !r.ok){ cfgMsg(false, (r && r.error) || `<#RDST_74#>`); return; }
+        cfgMsg(true, `<#RDST_77#>`.replace('%1', r.flags).replace('%2', r.lists).replace('%3', r.rejected));
+      };
+      x.send('action=import&http_id=' + encodeURIComponent(HTTPID_CFG) + '&cfg=' + encodeURIComponent(JSON.stringify(j)));
+    };
+    rd.readAsText(f);
+  };
+})();
