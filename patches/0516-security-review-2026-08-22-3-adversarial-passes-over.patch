+  else if (cls=="USR")  { cU++; LMAP[v]="[U\001SER-" cU "]" }
+  else if (cls=="SSID") { cW++; LMAP[v]="[S\001SID-" cW "]" }
+  else { cH++; LMAP[v]="[H\001OST-" cH "]" }
