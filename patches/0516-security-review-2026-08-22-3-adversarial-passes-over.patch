  * client-side. No request input is consumed (url ignored). On failure the
  * body starts with ERROR: which the page JS surfaces instead of saving. */
+
+/* ---------------------------------------------------------------------------
+ * reaper security review 2026-08-22 (F1): the http_id the Reaper CGIs check
+ * was ASUS's factory constant (shared/defaults.c), identical on every unit -
+ * a cross-site page could drive any Reaper action by a top-level GET. Two
+ * fixes: rc now generates http_id per boot (start_httpd), and every Reaper
+ * CGI additionally requires that, WHEN the browser sent a Referer, its host
+ * is this router (the Host header of this very request, else the LAN
+ * address). A cross-site navigation carries the attacker's origin as Referer
+ * (browsers' default referrer policy), so it is refused; same-origin pages
+ * always pass. No Referer at all is allowed through (curl, scripts) - the
+ * per-boot token is the defence there. Stock pages are unaffected: this is
+ * only called from the Reaper handlers.
+ * ------------------------------------------------------------------------- */
+static int reaper_referer_ok(void)
+{
+	const char *r = referer_url, *h, *e;
+	char rhost[128], want[128];
+	size_t n;
+	if (!r[0]) return 1;
+	h = strstr(r, "://");
+	h = h ? h + 3 : r;
+	e = h + strcspn(h, "/?#");
+	n = (size_t)(e - h);
+	if (n == 0 || n >= sizeof(rhost)) return 0;
+	memcpy(rhost, h, n); rhost[n] = 0;
+	/* bracketed IPv6 literal: compare as-is */
+	strlcpy(want, host_name[0] ? host_name : referer_host, sizeof(want));
+	if (!want[0]) return 1;
+	if (strcasecmp(rhost, want) == 0) return 1;
+	/* allow host without port vs host:port either way */
+	{
+		char a[128], b[128], *p;
+		strlcpy(a, rhost, sizeof(a)); strlcpy(b, want, sizeof(b));
+		if (a[0] != '[' && (p = strrchr(a, ':')) != NULL) *p = 0;
+		if (b[0] != '[' && (p = strrchr(b, ':')) != NULL) *p = 0;
+		if (strcasecmp(a, b) == 0) return 1;
+	}
+	logmessage("httpd", "reaper: cross-site request refused (referer host %s, expected %s)", rhost, want);
+	return 0;
+}
