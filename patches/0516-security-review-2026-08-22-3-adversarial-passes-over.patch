+# v1.3.5 (security review): hostnames that are no longer in a lease file still
+# sit in the syslog tail (DHCPACK, gatekeeper "new device"), and gatekeeper
+# logs only the first 32 characters - so seed from those lines too and add the
+# 32-character prefix of every long literal.
+grep -hE 'DHCPACK\(|gatekeeper: new device' /tmp/syslog.log /tmp/syslog.log-1 2>/dev/null | \
+  awk '/DHCPACK\(/ { h=$NF; if (h !~ /^[0-9a-f:]{17}$/ && length(h) >= 5) print "HOST\t" h }
+       /gatekeeper: new device/ { for (i=1;i<=NF;i++) if ($i=="host") { h=$(i+1); gsub(/^\(|\)$/,"",h); if (length(h) >= 5) print "HOST\t" h } }' >> "$SLIST" 2>/dev/null
+awk -F'\t' 'length($2) > 32 { print $1 "\t" substr($2, 1, 32) }' "$SLIST" >> "$SLIST" 2>/dev/null
 # longest-first so partial overlaps can not leak (dedupe must PRESERVE that order).
 # v1.0.1 protect list: never treat the model name or the ASUS brand as a secret
