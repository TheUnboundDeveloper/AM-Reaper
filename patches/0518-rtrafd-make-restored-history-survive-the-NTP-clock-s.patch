 {
@@ -2141,11 +2335,19 @@ int main(int argc, char **argv)
 	 * until then keep retrying from the main loop for STORE_RETRY_SECS, and NEVER
 	 * save over a file we did not load (see the clobber guard at the save site). */
 	cli_index_clear();	/* v2.2.3: empty the O(1) client index before any cli_slot / db_load */
+	/* seed the cursors BEFORE any restore - db_align() re-seeds them from the
+	 * db's own timestamp when a file is loaded */
+	slots_periods_for(time(NULL), &i5cur, &ihcur, &idcur, &imcur,
+			  &p5cur, &phcur, &pdcur, &pmcur);
+	pt_cur = time(NULL);
 	store = resolve_store(dbpath, sizeof(dbpath));
 	set_store_dir(dbpath);
 	if (dbpath[0]) {
-		if (db_load(dbpath) < 0)
+		int lr = db_load(dbpath);
+		if (lr < 0)
 			db_park_prev(dbpath);	/* unreadable/foreign file: never save over it */
+		else if (lr > 0)
+			db_align();
 		db_attached = 1;
 	} else if (nvram_safe_get("rtraf_path")[0]) {
 		syslog(LOG_NOTICE,
@@ -2154,7 +2356,6 @@ int main(int argc, char **argv)
 	}
 	boot_t = time(NULL);
 	last_save = time(NULL);
-	slots_for(time(NULL), &i5cur, &ihcur, &idcur, &imcur);
 	refresh_cfg();		/* seed cached config before the first live write */
 	/* LOG_NOTICE so it clears the default syslog threshold and shows in logread */
 	syslog(LOG_NOTICE, "rtrafd: started (store=%s wan=%s lan=%s/%08x)",
@@ -2170,62 +2371,13 @@ int main(int argc, char **argv)
 	int h_phase = HP_IDLE;			/* v2.2.4 health-cycle phase (was: single h_open flag) */
 	while (running) {
 		time_t now = time(NULL);
-		int n5, nh, nd, nm;
 		uint64_t wrx0, wtx0;
 		struct timespec t0, tsamp, tcls;
 
 		clock_gettime(CLOCK_MONOTONIC, &t0);
 
 		/* history boundary - fires every 5 min regardless of tick rate */
-		slots_for(now, &n5, &nh, &nd, &nm);
-		if (n5 != i5cur) {
-			static int hrot = 0;	/* H4: which slow window is due this boundary */
-			static int hfirst = 1;	/* publish all four once, so none is missing */
-			probe_close_bucket();
-			/* Republish EVERY window at each 5-min boundary, not just the ones
-			 * whose index happened to roll over. Gating the writes on their own
-			 * index (nh/nd/nm) meant day.json was rewritten once per 24 h and
-			 * month.json once per calendar month - so the 1y and month views
-			 * served stale or absent data for up to a day / a month after boot,
-			 * even though the rings behind them had been updating all along.
-			 * Four small JSON files every 5 minutes is nothing.
-			 * The all_zero_slot() calls below STAY index-gated: those clear a
-			 * newly-entered slot and must fire only on an actual rollover. */
-			/* H4: those four writes together cost ~212,000 fprintf calls at a
-			 * full client table (json_ring emits one per slot: 288 + 336 + 366
-			 * + 24 slots across ~209 rings), inside a loop budgeted at 100 ms.
-			 * The result was a 150-350 ms stall every 5 minutes that dropped
-			 * live samples - the graph the user is watching pausing so that
-			 * windows nobody has open can be rewritten.
-			 *
-			 * m5 still goes out every boundary: it is the window that actually
-			 * changes at this cadence and the one the page opens on. The three
-			 * slow windows take turns, so each is refreshed at least every 15
-			 * minutes - far inside a single bucket of its own step (1 h, 1 d,
-			 * 1 month), so nothing renders any staler than it did. This keeps
-			 * the republish-everything behaviour described above, which exists
-			 * because index-gating these writes left the 1y and month views
-			 * empty for up to a day or a month after boot; it only spreads the
-			 * cost out. The first boundary still writes all four, so no window
-			 * is missing while the rotation gets going. */
-			write_hist(0, "m5.json", 300);
-			if (hfirst) {
-				write_hist(1, "hour.json", 3600);
-				write_hist(2, "day.json", 86400);
-				write_hist(3, "month.json", 0);
-				hfirst = 0;
-			} else {
-				if (hrot == 0)      write_hist(1, "hour.json", 3600);
-				else if (hrot == 1) write_hist(2, "day.json", 86400);
-				else                write_hist(3, "month.json", 0);
-				hrot = (hrot + 1) % 3;
-			}
-			all_zero_slot(0, n5);
-			if (nh != ihcur) all_zero_slot(1, nh);
-			if (nd != idcur) all_zero_slot(2, nd);
-			if (nm != imcur) all_zero_slot(3, nm);
-			i5cur = n5; ihcur = nh; idcur = nd; imcur = nm;
-		}
+		hist_tick(now, tick);
 
 		/* WAN: every tick (the lively graph). Rate = this-tick delta scaled
 		 * to bits/sec by the MEASURED interval since the previous sample.
@@ -2359,8 +2511,11 @@ int main(int argc, char **argv)
 					store = resolve_store(dbpath, sizeof(dbpath));
 					set_store_dir(dbpath);
 					if (dbpath[0]) {
-						if (db_load(dbpath) < 0)
+						int lr = db_load(dbpath);
+						if (lr < 0)
 							db_park_prev(dbpath);
