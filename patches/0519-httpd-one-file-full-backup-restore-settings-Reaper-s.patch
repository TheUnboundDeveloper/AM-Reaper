+/* ===================================================================
+ * reaper v2.7.2: FULL backup / restore (backlog P2 "one backup that
+ * carries both halves").
+ *
+ * The stock Save-setting file is only the nvram blob; every Reaper list
+ * moved to /jffs (v2.6.3-v2.6.9) so a stock backup+reset+restore silently
+ * loses them all. The full backup is one additive archive:
+ *
+ *   REAPER-BACKUP 1\n
+ *   {"model":...,"fw":...,"when":...,"cfg":N,"rcfg":N,"fqdn":N}\n
+ *   <N bytes: the stock Settings .CFG, byte-identical format (HDR2+JCFG),
+ *             produced the same way prf_file does - still restorable by
+ *             stock/Merlin if carved out>
+ *   <N bytes: the v2.7.0 reaper_cfg export JSON>
+ *   <N bytes: the fqdn ipset cache - "#set <name>" + that set's add-lines,
+ *             so domain objects come back populated before the resolver's
+ *             first pass>
+ *
+ * Restore validates everything FIRST (magic, meta, model vs productid,
+ * /jffs health, the CFG part's own HDR magic) and only then writes: the
+ * JSON is parked at RCFG_PENDING (the fw/pbr drafts it stages live on
+ * tmpfs and would not survive the reboot - the operator completes that
+ * half with one click after logging back in), the fqdn cache files are
+ * laid back down, the CFG part goes to /tmp/settings_u.prf and the stock
+ * do_upload_config() path replays it exactly as the stock Restore button
+ * would (jffs cfgs + nvram restore + commit + reboot). A failed check
+ * changes nothing.
+ * =================================================================== */
+#define RBK_MAGIC	"REAPER-BACKUP 1\n"
+#define RBK_TMP_CFG	"/tmp/reaper_full.cfg"
+#define RBK_UPLOAD	"/tmp/reaper_restore.rbk"
+#define RBK_SETDIR	"/jffs/reaper_fw/sets"	/* = rc's RFW_SETCACHE */
+#define RBK_CFG_MAX	(8 * 1024 * 1024)
+#define RBK_FQDN_MAX	(512 * 1024)
+#define RBK_SET_MAX	(64 * 1024)
+#define RBK_META_MAX	512
+
+static int rbk_setname_ok(const char *n)
+{
+	const char *p;
+	if (strncmp(n, "rwfw_", 5) != 0 && strncmp(n, "rwfw6_", 6) != 0) return 0;
+	if (strlen(n) > 40) return 0;
+	for (p = n; *p; p++)
+		if (!(isalnum((unsigned char)*p) || strchr("_.-", *p))) return 0;
+	return 1;
+}
+
+/* the fqdn set cache as one text part; add-lines only, same filter the
+ * resolver's persist step applies */
+static char *rbk_fqdn_part(size_t *lenp)
+{
+	char *buf = NULL;
+	size_t blen = 0;
+	FILE *o = open_memstream(&buf, &blen);
+	DIR *d;
+	struct dirent *e;
+
+	*lenp = 0;
+	if (!o) return NULL;
+	if ((d = opendir(RBK_SETDIR)) != NULL) {
+		while ((e = readdir(d)) != NULL) {
+			char p[160], line[512];
+			FILE *f;
+			int fd;
+			size_t got = 0;
+			if (!rbk_setname_ok(e->d_name)) continue;
+			snprintf(p, sizeof(p), RBK_SETDIR "/%s", e->d_name);
+			fd = open(p, O_RDONLY | O_NOFOLLOW);
+			if (fd < 0 || (f = fdopen(fd, "r")) == NULL) { if (fd >= 0) close(fd); continue; }
+			fprintf(o, "#set %s\n", e->d_name);
+			while (fgets(line, sizeof(line), f) && got < RBK_SET_MAX && blen + got < RBK_FQDN_MAX) {
+				if (strncmp(line, "add ", 4) != 0) continue;
+				fputs(line, o);
+				got += strlen(line);
+			}
+			fclose(f);
+			fflush(o);
+			if (blen >= RBK_FQDN_MAX) break;
+		}
+		closedir(d);
+	}
+	fclose(o);
+	*lenp = blen;
+	return buf;	/* caller frees; may be empty (no cache = empty part) */
+}
+
+/* produce the stock Settings .CFG at `path`, replicating prf_file's default
+ * branch (Router mode, passwords kept, DDNS not transferred) so the embedded
+ * file is byte-format-identical to the stock download */
+static int rbk_make_cfg(const char *path)
+{
+	char ddns_hostname_tmp[128];
+#if defined(RTCONFIG_SAVEJFFS)
+	char *lists[] = {
+#if defined(RTCONFIG_PERMISSION_MANAGEMENT)
+		".sys/Permission",
+#endif
+#if defined(RTCONFIG_COOVACHILLI)
+		"customized_splash",
+#endif
+#if defined(RTCONFIG_JFFS2USERICON)
+		"usericon",
+#endif
+#ifdef RTCONFIG_HTTPS
+		"cert.tgz",
+		".cert",
+#ifdef RTCONFIG_LETSENCRYPT
+		".le",
+#endif
+#endif
+		NULL
+	};
+#endif
+	struct stat st;
+
+	snprintf(ddns_hostname_tmp, sizeof(ddns_hostname_tmp), "%s", nvram_safe_get("ddns_hostname_x"));
+	nvram_set("ddns_transfer", "");
+	nvram_set("ddns_hostname_x", "");
+	nvram_unset("asus_device_list");
+	httpd_nvram_commit();
+	unlink(path);
+	sys_download((char *)path);
+	nvram_set("ddns_hostname_x", ddns_hostname_tmp);
+	httpd_nvram_commit();
+#if defined(RTCONFIG_SAVEJFFS)
+	if (lists[0] != NULL) {
+		int i, r;
+		FILE *fp;
+		char cmd[512];
+		snprintf(cmd, sizeof(cmd), "tar czvf - -C /jffs");
+		for (i = 0; i < ARRAY_SIZE(lists) && lists[i] != NULL; ++i) {
+			strlcat(cmd, " ", sizeof(cmd));
+			strlcat(cmd, lists[i], sizeof(cmd));
+		}
+		fp = popen(cmd, "r");
+		if (fp != NULL) {
+			r = append_jffs_cfgs(fp, (char *)path);
+			pclose(fp);
+			if (r != 0)
+				logmessage("reaper_cfg", "full backup: /jffs cfg append failed (%d)", r);
+		}
+	}
+#endif
+	if (stat(path, &st) != 0 || !S_ISREG(st.st_mode) || st.st_size < 8 || st.st_size > RBK_CFG_MAX)
+		return -1;
+	return (int)st.st_size;
+}
+
+/* GET /REAPER_<model>_<ver>_settings.rbk?http_id=... - the one-file backup */
+static void
+do_reaper_fullbak_file(char *url, FILE *stream)
+{
+	char *buf_rcfg = NULL, *buf_fqdn = NULL;
+	size_t len_rcfg = 0, len_fqdn = 0;
+	int len_cfg;
+	FILE *m, *cf;
+	{
+		char *hid = get_cgi("http_id"), *want = nvram_safe_get("http_id");
+		if (!hid || !want[0] || strcmp(hid, want) != 0 || !reaper_referer_ok()) {
+			websWrite(stream, "invalid request token");
+			return;
+		}
+	}
+	if ((len_cfg = rbk_make_cfg(RBK_TMP_CFG)) < 0) {
+		websWrite(stream, "settings snapshot failed");
+		return;
+	}
+	m = open_memstream(&buf_rcfg, &len_rcfg);
+	if (m) { rcfg_export_json(m); fclose(m); }
+	buf_fqdn = rbk_fqdn_part(&len_fqdn);
+
+	websWrite(stream, "%s", RBK_MAGIC);
+	websWrite(stream, "{\"model\":");
+	gk_json_esc(stream, nvram_safe_get("productid"));
+	websWrite(stream, ",\"fw\":");
+	gk_json_esc(stream, nvram_safe_get("extendno"));
+	websWrite(stream, ",\"when\":%ld,\"cfg\":%d,\"rcfg\":%zu,\"fqdn\":%zu}\n",
+		  (long)time(NULL), len_cfg, len_rcfg, len_fqdn);
+	if ((cf = fopen(RBK_TMP_CFG, "r")) != NULL) {
+		char cbuf[4096];
+		size_t n;
+		while ((n = fread(cbuf, 1, sizeof(cbuf), cf)) > 0)
+			fwrite(cbuf, 1, n, stream);
+		fclose(cf);
+	}
+	if (buf_rcfg) fwrite(buf_rcfg, 1, len_rcfg, stream);
+	if (buf_fqdn) fwrite(buf_fqdn, 1, len_fqdn, stream);
+	free(buf_rcfg);
+	free(buf_fqdn);
+	unlink(RBK_TMP_CFG);
+	logmessage("reaper_cfg", "full backup downloaded (cfg %d, reaper %zu, fqdn %zu bytes)",
+		   len_cfg, len_rcfg, len_fqdn);
+}
