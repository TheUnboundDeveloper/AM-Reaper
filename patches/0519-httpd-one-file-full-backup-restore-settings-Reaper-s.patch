+/* upload state handed from the POST half to the reply half (httpd serves one
+ * request at a time, same pattern as do_upload_post's F_SETOWN channel but
+ * with room for the parsed meta) */
+static struct {
+	int err;		/* 0 ok; else the ek the reply half reports */
+	char hid[80];
+	char model[32];
+	long cfg, rcfg, fqdn;
+} rbk_up;
+
+static void
+do_reaper_restore_post(char *url, FILE *stream, int len, char *boundary)
+{
+	char buf[1024];
+	FILE *fifo = NULL;
+	long want;
+	int ch, count;
+	json_object *meta = NULL, *jv;
+
+	memset(&rbk_up, 0, sizeof(rbk_up));
+	rbk_up.err = 1;	/* "file" until everything below succeeds */
+
+	/* walk the parts: capture http_id, stop at the file */
+	while (len > 0) {
+		if (!fgets(buf, MIN(len + 1, (int)sizeof(buf)), stream)) goto out;
+		len -= strlen(buf);
+		if (strncasecmp(buf, "Content-Disposition:", 20) != 0) continue;
+		if (strstr(buf, "name=\"file\"")) break;
+		if (strstr(buf, "name=\"http_id\"")) {
+			/* blank line then the value line */
+			while (len > 0) {
+				if (!fgets(buf, MIN(len + 1, (int)sizeof(buf)), stream)) goto out;
+				len -= strlen(buf);
+				if (!strcmp(buf, "\n") || !strcmp(buf, "\r\n")) break;
+			}
+			if (len > 0 && fgets(buf, MIN(len + 1, (int)sizeof(buf)), stream)) {
+				len -= strlen(buf);
+				buf[strcspn(buf, "\r\n")] = '\0';
+				strlcpy(rbk_up.hid, buf, sizeof(rbk_up.hid));
+			}
+		}
+	}
+	if (len <= 0) goto out;
+
+	/* skip the file part's remaining headers */
+	while (len > 0) {
+		if (!fgets(buf, MIN(len + 1, (int)sizeof(buf)), stream)) goto out;
+		len -= strlen(buf);
+		if (!strcmp(buf, "\n") || !strcmp(buf, "\r\n")) break;
+	}
+
+	/* magic line, then the meta line (both short text) */
+	if (len <= 0 || !fgets(buf, MIN(len + 1, (int)sizeof(buf)), stream)) goto out;
+	len -= strlen(buf);
+	if (strcmp(buf, RBK_MAGIC) != 0) goto out;
+	if (len <= 0 || !fgets(buf, MIN(len + 1, (int)sizeof(buf)), stream)) goto out;
+	len -= strlen(buf);
+	if (strlen(buf) >= RBK_META_MAX) goto out;
+	meta = json_tokener_parse(buf);
+	if (!meta || json_object_get_type(meta) != json_type_object) goto out;
+	if (json_object_object_get_ex(meta, "model", &jv)) {
+		const char *mv = json_object_get_string(jv);
+		strlcpy(rbk_up.model, mv ? mv : "", sizeof(rbk_up.model));
+	}
+	rbk_up.cfg = json_object_object_get_ex(meta, "cfg", &jv) ? json_object_get_int64(jv) : -1;
+	rbk_up.rcfg = json_object_object_get_ex(meta, "rcfg", &jv) ? json_object_get_int64(jv) : -1;
+	rbk_up.fqdn = json_object_object_get_ex(meta, "fqdn", &jv) ? json_object_get_int64(jv) : -1;
+	if (rbk_up.cfg < 8 || rbk_up.cfg > RBK_CFG_MAX ||
+	    rbk_up.rcfg < 2 || rbk_up.rcfg > RCFG_PENDING_MAX ||
+	    rbk_up.fqdn < 0 || rbk_up.fqdn > RBK_FQDN_MAX)
+		goto out;
+
+	/* stream exactly the declared bytes to the staging file */
+	want = rbk_up.cfg + rbk_up.rcfg + rbk_up.fqdn;
+	unlink(RBK_UPLOAD);
+	{
+		int ufd = open(RBK_UPLOAD, O_CREAT | O_EXCL | O_WRONLY | O_NOFOLLOW, 0600);
+		if (ufd < 0 || (fifo = fdopen(ufd, "w")) == NULL) { if (ufd >= 0) close(ufd); goto out; }
+	}
+	while (len > 0 && want > 0) {
+#ifdef RTCONFIG_HTTPS
+		if (do_ssl) {
+			if (waitfor(ssl_stream_fd, (len >= 0x4000) ? 3 : 1) <= 0) break;
+		} else
+#endif
+		if (waitfor(fileno(stream), 10) <= 0) break;
+		{
+			long chunk = want;
+			if (chunk > (long)sizeof(buf)) chunk = (long)sizeof(buf);
+			if (chunk > (long)len) chunk = (long)len;
+			count = fread(buf, 1, (size_t)chunk, stream);
+		}
+		if (count <= 0) goto out;
+		len -= count;
+		want -= count;
+		fwrite(buf, 1, count, fifo);
+	}
+	if (want > 0) goto out;	/* short body */
+	fclose(fifo);
+	fifo = NULL;
+	rbk_up.err = 0;
+out:
+	if (meta) json_object_put(meta);
+	if (fifo) { fclose(fifo); unlink(RBK_UPLOAD); }
+	/* slurp the trailing boundary + anything else */
+	while (len-- > 0)
+		if ((ch = fgetc(stream)) == EOF) break;
+}
