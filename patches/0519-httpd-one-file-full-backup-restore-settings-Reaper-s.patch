diff --git a/release/src/router/www/Reaper_BackupCard.asp b/release/src/router/www/Reaper_BackupCard.asp
new file mode 100644
index 0000000000..2f878b49b2
--- /dev/null
+++ b/release/src/router/www/Reaper_BackupCard.asp
@@ -0,0 +1,44 @@
+<!-- SPDX-License-Identifier: GPL-2.0-only -->
+<!-- Reaper v2.7.2: full-backup card, fetched by the injected script and
+     inserted into the stock Administration > Restore/Save/Upload page.
+     This is a FRAGMENT (no head/body): tokens resolve server-side through
+     do_ej, all behavior JS lives in reaper_inject.c's block (scripts inside
+     innerHTML never execute), and every string the JS needs is carried in a
+     hidden span so no translation ever sits inside an attribute or a JS
+     string. Listed in reaper_skip[] - served pristine, never re-injected. -->
+<div id="rbk_card">
+<style>
+#rbk_card{margin:0 auto 14px;width:760px;max-width:96%;border:1px solid #3a3a3e;border-radius:6px;padding:14px 18px;background:#101012;color:#ECE7DB;font-family:Arial,Helvetica,sans-serif;text-align:left}
+#rbk_card .rbk_h{font-size:15px;font-weight:bold;color:#ECE7DB;margin:0 0 6px}
+#rbk_card .rbk_h em{font-style:normal;color:#E10600}
+#rbk_card .rbk_d{font-size:12px;line-height:1.55;color:#b8b3a7;margin:0 0 10px}
+#rbk_card .rbk_row{margin:0 0 8px}
+#rbk_card button{background:#1c1c1f;color:#ECE7DB;border:1px solid #555;border-radius:4px;padding:7px 14px;font-size:12px;cursor:pointer;margin-right:8px}
+#rbk_card button:hover{border-color:#E10600}
+#rbk_card .rbk_note{font-size:11px;color:#8d897f;line-height:1.5;margin:6px 0 0}
+#rbk_card #rbk_pending{display:none;margin:10px 0 2px;padding:8px 10px;border:1px solid #E10600;border-radius:4px;background:#1a0d0d;font-size:12px}
+#rbk_card #rbk_msg{display:none;margin:8px 0 0;font-size:12px}
+#rbk_card .rbk_ok{color:#4FB286}
+#rbk_card .rbk_err{color:#E10600}
+</style>
+<div class="rbk_h"><em>REAPER</em> &middot; <#RBKP_1#></div>
+<div class="rbk_d"><#RBKP_2#></div>
+<div class="rbk_row">
+  <button id="rbk_dl" type="button"><#RBKP_3#></button>
+  <button id="rbk_up" type="button"><#RBKP_4#></button>
+  <input id="rbk_file" type="file" accept=".rbk" style="display:none">
+</div>
+<div class="rbk_note"><#RBKP_5#></div>
+<div id="rbk_pending"><span><#RBKP_6#></span> <button id="rbk_complete" type="button"><#RBKP_7#></button></div>
+<div id="rbk_msg"></div>
+<span id="rbk_hid" style="display:none"><% nvram_get("http_id"); %></span>
+<span id="rbk_model" style="display:none"><% nvram_get("productid"); %></span>
+<span id="rbk_ver" style="display:none"><% nvram_get("extendno"); %></span>
+<span id="rbk_s_badfile" style="display:none"><#RBKP_12#></span>
+<span id="rbk_s_model" style="display:none"><#RBKP_8#></span>
+<span id="rbk_s_jffs" style="display:none"><#RBKP_9#></span>
+<span id="rbk_s_reboot" style="display:none"><#RBKP_10#></span>
+<span id="rbk_s_done" style="display:none"><#RBKP_11#></span>
+<span id="rbk_s_confirm" style="display:none"><#RBKP_13#></span>
+<span id="rbk_s_fail" style="display:none"><#RBKP_14#></span>
+</div>
diff --git a/release/src/router/www/Reaper_Storage.asp b/release/src/router/www/Reaper_Storage.asp
index 1eb8c3c500..d1ff1ef2d6 100644
--- a/release/src/router/www/Reaper_Storage.asp
+++ b/release/src/router/www/Reaper_Storage.asp
@@ -105,6 +105,13 @@ td.dssince{color:var(--bone-dim);white-space:nowrap}
     <span class="note" id="cfg_msg" style="margin:0"></span>
   </div>
   <p class="note"><#RDST_72#></p>
+  <!-- v2.7.2: a full-backup restore (Administration page) leaves its Reaper half
+       pending across the reboot; surface it here too so the operator finds it
+       wherever they land first -->
+  <div id="cfg_pending" style="display:none;margin-top:10px;padding:8px 12px;border:1px solid var(--crimson);border-radius:6px">
+    <span class="note" style="margin:0"><#RBKP_6#></span>
+    <button class="btn" id="cfg_complete" style="margin-left:10px"><#RBKP_7#></button>
+  </div>
 </div>
 
 <div class="card">
@@ -345,6 +352,33 @@ else document.addEventListener('DOMContentLoaded', boot);
     };
     rd.readAsText(f);
   };
+  /* v2.7.2: full-backup restore pending across the reboot (written by
+     reaper_restore.cgi) - offer to complete it here as well as on the
+     Administration page card */
+  (function(){
+    var x = new XMLHttpRequest();
+    x.open('GET', '/reaper_cfg.cgi?action=pending&http_id=' + encodeURIComponent(HTTPID_CFG) + '&_=' + Date.now(), true);
+    x.onload = function(){
+      var j = null; try{ j = JSON.parse(x.responseText); }catch(e){}
+      if(j && j.ok && j.pending){ var b = document.getElementById('cfg_pending'); if(b) b.style.display = ''; }
+    };
+    x.send();
+  })();
+  var cp = document.getElementById('cfg_complete');
+  if(cp) cp.onclick = function(){
+    cp.disabled = true;
+    var x = new XMLHttpRequest();
+    x.open('POST', '/reaper_cfg.cgi', true);
+    x.setRequestHeader('Content-Type', 'application/x-www-form-urlencoded');
+    x.onloadend = function(){
+      var r = null; try{ r = JSON.parse(x.responseText); }catch(e){}
+      cp.disabled = false;
+      if(!r || !r.ok){ cfgMsg(false, (r && r.error) || `<#RBKP_14#>`); return; }
+      var b = document.getElementById('cfg_pending'); if(b) b.style.display = 'none';
+      cfgMsg(true, `<#RBKP_11#>`.replace('%1', r.flags).replace('%2', r.lists).replace('%3', r.rejected));
+    };
+    x.send('action=import_pending&http_id=' + encodeURIComponent(HTTPID_CFG));
+  };
 })();
 </script>
 </body>
