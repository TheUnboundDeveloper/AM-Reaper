+/* the /jffs gate the backlog item requires: mounted, writable, not
+ * critically full - mirrors reaper_diag section 14's checks */
+static int rbk_jffs_ok(void)
+{
+	struct statvfs sf;
+	char t[] = "/jffs/.rbk_wtest";
+	int fd;
+	if (statvfs("/jffs", &sf) != 0) return 0;
+	if ((long long)sf.f_bavail * sf.f_frsize < 2LL * 1024 * 1024) return 0;
+	unlink(t);
+	fd = open(t, O_CREAT | O_EXCL | O_WRONLY | O_NOFOLLOW, 0600);
+	if (fd < 0) return 0;
+	if (write(fd, "x", 1) != 1) { close(fd); unlink(t); return 0; }
+	close(fd);
+	unlink(t);
+	return 1;
+}
+
+static void
+do_reaper_restore_cgi(char *url, FILE *stream)
+{
+	FILE *in = NULL, *out = NULL;
+	char buf[4096];
+	char *rcfg = NULL, *fqdn = NULL;
+	long left;
+	size_t n;
+	int ok = 0;
+
+	/* same CSRF discipline as every Reaper control (the token traveled as a
+	 * multipart field, captured by the POST half) */
+	{
+		char *want = nvram_safe_get("http_id");
+		if (!want[0] || strcmp(rbk_up.hid, want) != 0 || !reaper_referer_ok()) {
+			websWrite(stream, "{\"ok\":0,\"error\":\"invalid request token\",\"ek\":\"RDEVE_1\"}");
+			goto done;
+		}
+	}
+	if (rbk_up.err) { websWrite(stream, "{\"ok\":0,\"ek\":\"file\"}"); goto done; }
+	if (strcmp(rbk_up.model, nvram_safe_get("productid")) != 0) {
+		websWrite(stream, "{\"ok\":0,\"ek\":\"model\"}");
+		goto done;
+	}
+	if (!rbk_jffs_ok()) { websWrite(stream, "{\"ok\":0,\"ek\":\"jffs\"}"); goto done; }
+
+	if ((in = fopen(RBK_UPLOAD, "r")) == NULL) { websWrite(stream, "{\"ok\":0,\"ek\":\"file\"}"); goto done; }
+
+	/* ---- validate everything before writing anything ---- */
+	/* the CFG part must itself carry the stock profile magic */
+	if (fread(buf, 1, 8, in) != 8 ||
+	    (strncmp(buf, PROFILE_HEADER, 4) != 0 && strncmp(buf, PROFILE_HEADER_NEW, 4) != 0)) {
+		websWrite(stream, "{\"ok\":0,\"ek\":\"file\"}");
+		goto done;
+	}
+	/* the Reaper JSON must parse and be ours */
+	if (fseek(in, rbk_up.cfg, SEEK_SET) != 0 ||
+	    (rcfg = malloc(rbk_up.rcfg + 1)) == NULL ||
+	    fread(rcfg, 1, rbk_up.rcfg, in) != (size_t)rbk_up.rcfg) {
+		websWrite(stream, "{\"ok\":0,\"ek\":\"file\"}");
+		goto done;
+	}
+	rcfg[rbk_up.rcfg] = '\0';
+	{
+		json_object *jr = json_tokener_parse(rcfg), *jv;
+		int good = (jr && json_object_get_type(jr) == json_type_object &&
+			    json_object_object_get_ex(jr, "reaper_cfg", &jv));
+		if (jr) json_object_put(jr);
+		if (!good) { websWrite(stream, "{\"ok\":0,\"ek\":\"file\"}"); goto done; }
+	}
+	/* the fqdn part must be well-formed (set headers + add lines only) */
+	if (rbk_up.fqdn > 0) {
+		char *p, *line;
+		if ((fqdn = malloc(rbk_up.fqdn + 1)) == NULL ||
+		    fread(fqdn, 1, rbk_up.fqdn, in) != (size_t)rbk_up.fqdn) {
+			websWrite(stream, "{\"ok\":0,\"ek\":\"file\"}");
+			goto done;
+		}
+		fqdn[rbk_up.fqdn] = '\0';
+		for (line = fqdn; line && *line; line = p ? p + 1 : NULL) {
+			p = strchr(line, '\n');
+			if (p) *p = '\0';
+			if (line[0] == '\0') { if (p) *p = '\n'; continue; }
+			if (strncmp(line, "#set ", 5) == 0) {
+				if (!rbk_setname_ok(line + 5)) { websWrite(stream, "{\"ok\":0,\"ek\":\"file\"}"); goto done; }
+			} else if (strncmp(line, "add ", 4) != 0) {
+				websWrite(stream, "{\"ok\":0,\"ek\":\"file\"}");
+				goto done;
+			}
+			if (p) *p = '\n';
+		}
+	}
+
+	/* ---- all checks passed: lay the pieces down ---- */
+	/* 1. the Reaper half, parked to survive the reboot */
+	mkdir("/jffs/reaper", 0700);
+	unlink(RCFG_PENDING);
+	{
+		int pfd = open(RCFG_PENDING, O_CREAT | O_EXCL | O_WRONLY | O_NOFOLLOW, 0600);
+		if (pfd < 0 || (out = fdopen(pfd, "w")) == NULL) {
+			if (pfd >= 0) close(pfd);
+			websWrite(stream, "{\"ok\":0,\"ek\":\"jffs\"}");
+			goto done;
+		}
+		fwrite(rcfg, 1, rbk_up.rcfg, out);
+		fclose(out);
+		out = NULL;
+	}
+	/* 2. the fqdn set cache */
+	if (fqdn && rbk_up.fqdn > 0) {
+		char *p, *line, path[160];
+		mkdir(RBK_SETDIR, 0700);
+		for (line = fqdn; line && *line; line = p ? p + 1 : NULL) {
+			p = strchr(line, '\n');
+			if (p) *p = '\0';
+			if (strncmp(line, "#set ", 5) == 0) {
+				if (out) fclose(out);
+				out = NULL;
+				snprintf(path, sizeof(path), RBK_SETDIR "/%s", line + 5);
+				unlink(path);
+				{
+					int sfd = open(path, O_CREAT | O_EXCL | O_WRONLY | O_NOFOLLOW, 0600);
+					if (sfd >= 0 && (out = fdopen(sfd, "w")) == NULL) close(sfd);
+				}
+			} else if (out && line[0]) {
+				fputs(line, out);
+				fputc('\n', out);
+			}
+			if (p) *p = '\n';
+		}
+		if (out) { fclose(out); out = NULL; }
+	}
+	/* 3. the stock CFG, staged where the stock restore path expects it */
+	if (fseek(in, 0, SEEK_SET) != 0) { websWrite(stream, "{\"ok\":0,\"ek\":\"file\"}"); goto done; }
+	{
+		FILE *cf = fopen("/tmp/settings_u.prf", "w");
+		if (!cf) { websWrite(stream, "{\"ok\":0,\"ek\":\"file\"}"); goto done; }
+		left = rbk_up.cfg;
+		while (left > 0 && (n = fread(buf, 1, MIN(left, (long)sizeof(buf)), in)) > 0) {
+			fwrite(buf, 1, n, cf);
+			left -= n;
+		}
+		fclose(cf);
+		if (left > 0) { unlink("/tmp/settings_u.prf"); websWrite(stream, "{\"ok\":0,\"ek\":\"file\"}"); goto done; }
+	}
+	ok = 1;
+	logmessage("reaper_cfg", "full-backup restore: settings staged, Reaper half parked at %s - restoring and rebooting", RCFG_PENDING);
+	websWrite(stream, "{\"ok\":1,\"reboot\":1}");
+done:
+	if (in) fclose(in);
+	if (out) fclose(out);
+	free(rcfg);
+	free(fqdn);
+	unlink(RBK_UPLOAD);
+	if (ok) {
+		/* mirror do_upload_cgi: get the reply out, then hand the CFG to the
+		 * stock restore path (jffs cfgs + nvram restore + commit + reboot) */
+		fflush(stream);
+#ifdef RTCONFIG_HTTPS
+		if (do_ssl)
+			shutdown(ssl_stream_fd, SHUT_RDWR);
+		else
+#endif
+			shutdown(fileno(stream), SHUT_RDWR);
+		do_upload_config();
+	}
+}
