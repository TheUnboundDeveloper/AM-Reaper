+/* v2.7.2 full-backup card (backlog P2): injected ONLY into the stock
+ * Administration > Restore/Save/Upload page (mode 4). The stock file stays
+ * byte-pristine; this script fetches the tokenized fragment
+ * Reaper_BackupCard.asp (do_ej resolves its dict tokens server-side) and
+ * inserts it above the stock form, then wires the buttons. All user-visible
+ * strings live in the fragment's hidden spans - this block is pure logic, so
+ * i18n rule 24 is satisfied without putting a single literal here. Scripts
+ * inside innerHTML never execute, which is exactly why the wiring lives here.
+ *
+ * NOTE: every line must end in a backslash, comments included (see the
+ * REAPER_BOUNCE_JS note above). */
+#define REAPER_BKCARD_JS \
+	"<script>(function(){" \
+	"function t(i){var e=document.getElementById(i);return e?e.textContent:\"\";}" \
+	"function msg(ok,s){var m=document.getElementById(\"rbk_msg\");if(!m)return;" \
+	"m.style.display=\"\";m.className=ok?\"rbk_ok\":\"rbk_err\";m.textContent=s;}" \
+	"function wire(){" \
+	"var hid=t(\"rbk_hid\"),model=t(\"rbk_model\"),ver=t(\"rbk_ver\");" \
+	"var dl=document.getElementById(\"rbk_dl\");" \
+	"if(dl)dl.onclick=function(){location.href=\"/REAPER_\"+model.replace(/[^A-Za-z0-9._-]/g,\"\")+\"_\"+ver.replace(/[^A-Za-z0-9._-]/g,\"\")+\"_settings.rbk?http_id=\"+encodeURIComponent(hid);};" \
+	"var up=document.getElementById(\"rbk_up\"),fi=document.getElementById(\"rbk_file\");" \
+	"if(up&&fi){up.onclick=function(){fi.click();};" \
+	"fi.onchange=function(){" \
+	"var f=fi.files&&fi.files[0];if(!f)return;" \
+	"if(f.size>16777216||f.size<64){msg(0,t(\"rbk_s_badfile\"));fi.value=\"\";return;}" \
+	"var rd=new FileReader();" \
+	"rd.onload=function(){" \
+	"var head=String(rd.result||\"\");" \
+	"if(head.indexOf(\"REAPER-BACKUP 1\\n\")!==0){msg(0,t(\"rbk_s_badfile\"));fi.value=\"\";return;}" \
+	"var meta=null;try{meta=JSON.parse(head.split(\"\\n\")[1]);}catch(e){}" \
+	"if(!meta){msg(0,t(\"rbk_s_badfile\"));fi.value=\"\";return;}" \
+	"if(String(meta.model)!==model){msg(0,t(\"rbk_s_model\"));fi.value=\"\";return;}" \
+	"if(!confirm(t(\"rbk_s_confirm\"))){fi.value=\"\";return;}" \
+	"var fd=new FormData();fd.append(\"http_id\",hid);fd.append(\"file\",f);" \
+	"var p=new XMLHttpRequest();p.open(\"POST\",\"/reaper_restore.cgi\",true);" \
+	"p.onloadend=function(){" \
+	"var r=null;try{r=JSON.parse(p.responseText);}catch(e){}" \
+	"fi.value=\"\";" \
+	"if(!r||!r.ok){var ek=r&&r.ek;" \
+	"msg(0,ek===\"model\"?t(\"rbk_s_model\"):ek===\"jffs\"?t(\"rbk_s_jffs\"):ek===\"file\"?t(\"rbk_s_badfile\"):t(\"rbk_s_fail\"));return;}" \
+	"msg(1,t(\"rbk_s_reboot\"));};" \
+	"p.send(fd);};" \
+	"rd.readAsText(f.slice(0,2048));};}" \
+	"var x2=new XMLHttpRequest();" \
+	"x2.open(\"GET\",\"/reaper_cfg.cgi?action=pending&http_id=\"+encodeURIComponent(hid)+\"&_=\"+Date.now(),true);" \
+	"x2.onload=function(){var j=null;try{j=JSON.parse(x2.responseText);}catch(e){}" \
+	"if(j&&j.ok&&j.pending){var b=document.getElementById(\"rbk_pending\");if(b)b.style.display=\"\";}};" \
+	"x2.send();" \
+	"var cp=document.getElementById(\"rbk_complete\");" \
+	"if(cp)cp.onclick=function(){cp.disabled=true;" \
+	"var q=new XMLHttpRequest();q.open(\"POST\",\"/reaper_cfg.cgi\",true);" \
+	"q.setRequestHeader(\"Content-Type\",\"application/x-www-form-urlencoded\");" \
+	"q.onloadend=function(){var r=null;try{r=JSON.parse(q.responseText);}catch(e){}" \
+	"cp.disabled=false;" \
+	"if(!r||!r.ok){msg(0,t(\"rbk_s_fail\"));return;}" \
+	"var b=document.getElementById(\"rbk_pending\");if(b)b.style.display=\"none\";" \
+	"msg(1,t(\"rbk_s_done\").replace(\"%1\",r.flags).replace(\"%2\",r.lists).replace(\"%3\",r.rejected));};" \
+	"q.send(\"action=import_pending&http_id=\"+encodeURIComponent(hid));};" \
+	"}" \
+	"function boot(){" \
+	"var x=new XMLHttpRequest();" \
+	"x.open(\"GET\",\"/Reaper_BackupCard.asp\",true);" \
+	"x.onload=function(){" \
+	"if(x.status!==200)return;" \
+	"var host=document.createElement(\"div\");host.innerHTML=x.responseText;" \
+	"var a=document.getElementById(\"FormTitle\")||document.forms[0]||null;" \
+	"if(a&&a.parentNode)a.parentNode.insertBefore(host,a);else document.body.insertBefore(host,document.body.firstChild);" \
+	"wire();};" \
+	"x.send();}" \
+	"if(document.readyState===\"loading\")document.addEventListener(\"DOMContentLoaded\",boot);else boot();" \
+	"})();</script>"
