+/* v2.7.2: the Reaper half of a full-backup restore, parked on /jffs by
+ * reaper_restore.cgi so it survives the nvram-restore reboot (the firewall /
+ * routing drafts it stages live on tmpfs and would not). The operator
+ * completes it with one click after logging back in. */
+#define RCFG_PENDING	"/jffs/reaper/restore_pending.json"
+#define RCFG_PENDING_MAX	(256 * 1024)
+
+static void
+do_reaper_cfg_cgi(char *url, FILE *stream)
+{
+	char *action = get_cgi("action");
+	if (!action) action = "export";
+	{
+		char *hid = get_cgi("http_id"), *want = nvram_safe_get("http_id");
+		if (!hid || !want[0] || strcmp(hid, want) != 0 || !reaper_referer_ok()) {
+			websWrite(stream, "{\"ok\":0,\"error\":\"invalid request token\",\"ek\":\"RDEVE_1\"}");
+			return;
+		}
+	}
+
+	if (strcmp(action, "export") == 0) {
+		rcfg_export_json(stream);
+		return;
+	}
+
+	if (strcmp(action, "import") == 0) {
+		char *body = get_cgi("cfg");
+		int nflags = 0, nlists = 0, rejected = 0, r;
+		if (!body || !*body) {
+			websWrite(stream, "{\"ok\":0,\"error\":\"missing parameter\"}");
+			return;
+		}
+		r = rcfg_import_json(body, &nflags, &nlists, &rejected);
+		if (r == -1) { websWrite(stream, "{\"ok\":0,\"error\":\"not a settings file\"}"); return; }
+		if (r == -2) { websWrite(stream, "{\"ok\":0,\"error\":\"not a Reaper settings file\"}"); return; }
+		websWrite(stream, "{\"ok\":1,\"flags\":%d,\"lists\":%d,\"rejected\":%d}", nflags, nlists, rejected);
+		return;
+	}
+
+	if (strcmp(action, "pending") == 0) {
+		struct stat st;
+		int p = (lstat(RCFG_PENDING, &st) == 0 && S_ISREG(st.st_mode) &&
+			 st.st_size > 0 && st.st_size <= RCFG_PENDING_MAX);
+		websWrite(stream, "{\"ok\":1,\"pending\":%d}", p ? 1 : 0);
+		return;
+	}
+
+	if (strcmp(action, "import_pending") == 0) {
+		struct stat st;
+		char *body;
+		FILE *f;
+		int nflags = 0, nlists = 0, rejected = 0, r;
+		int fd = open(RCFG_PENDING, O_RDONLY | O_NOFOLLOW);
+		if (fd < 0 || fstat(fd, &st) != 0 || !S_ISREG(st.st_mode) ||
+		    st.st_size <= 0 || st.st_size > RCFG_PENDING_MAX) {
+			if (fd >= 0) close(fd);
+			websWrite(stream, "{\"ok\":0,\"error\":\"nothing pending\"}");
+			return;
+		}
+		if ((body = malloc(st.st_size + 1)) == NULL) { close(fd); websWrite(stream, "{\"ok\":0,\"error\":\"out of memory\"}"); return; }
+		f = fdopen(fd, "r");
+		if (!f || fread(body, 1, st.st_size, f) != (size_t)st.st_size) {
