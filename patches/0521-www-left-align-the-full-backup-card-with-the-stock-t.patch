From 4554122f36157ac94671859e0213290f823c8c87 Mon Sep 17 00:00:00 2001
From: reaper <theunbounddeveloper@outlook.com>
Date: Sun, 23 Aug 2026 06:33:53 -0400
Subject: [PATCH] www: left-align the full-backup card with the stock table
 below it

Owner report (v2.7.2 on metal): the card floated centered while the stock
FormTitle table under it is left-aligned. margin:0 auto -> margin:0 (the
reaper-ui rule-32 lesson: never center inside the shell iframe), and
box-sizing:border-box so the 760px card matches the 760px stock table
instead of overhanging it by the padding.
---
 release/src/router/www/Reaper_BackupCard.asp | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/release/src/router/www/Reaper_BackupCard.asp b/release/src/router/www/Reaper_BackupCard.asp
index 2f878b49b2..8b73188822 100644
--- a/release/src/router/www/Reaper_BackupCard.asp
+++ b/release/src/router/www/Reaper_BackupCard.asp
@@ -8,7 +8,7 @@
      string. Listed in reaper_skip[] - served pristine, never re-injected. -->
 <div id="rbk_card">
 <style>
-#rbk_card{margin:0 auto 14px;width:760px;max-width:96%;border:1px solid #3a3a3e;border-radius:6px;padding:14px 18px;background:#101012;color:#ECE7DB;font-family:Arial,Helvetica,sans-serif;text-align:left}
+#rbk_card{margin:0 0 14px;width:760px;max-width:96%;box-sizing:border-box;border:1px solid #3a3a3e;border-radius:6px;padding:14px 18px;background:#101012;color:#ECE7DB;font-family:Arial,Helvetica,sans-serif;text-align:left}
 #rbk_card .rbk_h{font-size:15px;font-weight:bold;color:#ECE7DB;margin:0 0 6px}
 #rbk_card .rbk_h em{font-style:normal;color:#E10600}
 #rbk_card .rbk_d{font-size:12px;line-height:1.55;color:#b8b3a7;margin:0 0 10px}
