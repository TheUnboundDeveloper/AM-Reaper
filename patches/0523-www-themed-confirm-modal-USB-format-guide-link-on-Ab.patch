diff --git a/release/src/router/www/Reaper_USB.asp b/release/src/router/www/Reaper_USB.asp
index ac484d19a1..ccb31de6a1 100644
--- a/release/src/router/www/Reaper_USB.asp
+++ b/release/src/router/www/Reaper_USB.asp
@@ -235,21 +235,27 @@ function dkFormat(port){
   if(dkBusy) return;
   var fsSel = document.getElementById('dkfs_' + port), lb = document.getElementById('dklb_' + port);
   if(!fsSel) return;
-  if(!confirm(`<#RDST_46#>`)) return;
-  dkBusy = 1;
-  delete dkLog[port];   /* the disk is changing: any prior scan result is stale */
-  delete dkVerdict[port];
-  dkSetStat(port, esc(`<#format_formatting#>`) + '&hellip;');
-  dkPost({ action_script: 'start_diskformat',
-           diskmon_usbport: port,
-           diskformat_file_system: fsSel.value,
-           diskformat_label: (lb && lb.value) ? lb.value.replace(/[^0-9A-Za-z_-]/g, '') : 'USBDISK' });
-  setTimeout(function(){ dkPoll(port, 'fmt', 0); }, 3000);
+  /* v2.7.3 (owner): the browser-chrome confirm() looked stock - the themed
+     modal (reaper_util.js) replaces it. Destructive, so danger styling and
+     no Enter-to-confirm. */
+  reaperConfirm(`<#RDST_46#>`, { danger: true, okLabel: `<#CTL_format#>`, cancelLabel: `<#CTL_Cancel#>` }, function(go){
+    if(!go || dkBusy) return;
+    dkBusy = 1;
+    delete dkLog[port];   /* the disk is changing: any prior scan result is stale */
+    delete dkVerdict[port];
+    dkSetStat(port, esc(`<#format_formatting#>`) + '&hellip;');
+    dkPost({ action_script: 'start_diskformat',
+             diskmon_usbport: port,
+             diskformat_file_system: fsSel.value,
+             diskformat_label: (lb && lb.value) ? lb.value.replace(/[^0-9A-Za-z_-]/g, '') : 'USBDISK' });
+    setTimeout(function(){ dkPoll(port, 'fmt', 0); }, 3000);
+  });
 }
 
 function dkEject(port){
   if(dkBusy) return;
-  if(!confirm(`<#Safelyremovedisk_confirm#>`)) return;
+  reaperConfirm(`<#Safelyremovedisk_confirm#>`, { okLabel: `<#CTL_ok#>`, cancelLabel: `<#CTL_Cancel#>` }, function(go){
+  if(!go || dkBusy) return;
   var x = new XMLHttpRequest();
   x.open('GET', '/device-map/safely_remove_disk.asp?disk=' + encodeURIComponent(port) + '&http_id=<% nvram_get("http_id"); %>&_=' + Date.now(), true);
   x.onreadystatechange = function(){
@@ -262,6 +268,7 @@ function dkEject(port){
     setTimeout(function(){ dkFresh(renderDisks); }, 1500);
   };
   x.send();
+  });
 }
 
 function renderDisks(){
