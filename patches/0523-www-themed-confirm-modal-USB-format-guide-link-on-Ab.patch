@@ -547,9 +547,14 @@ document.addEventListener('keydown', function(e){
   if($id('veil').style.display === 'flex' && a && a.style.display !== 'none') veilDismiss();
 });
 /* An uncaught error used to kill a poll chain silently and leave the veil up
-   forever. Now it surfaces the hatch instead. */
+   forever. Now it surfaces the hatch instead. v2.7.3 (backlog "Cancel leaves
+   the buttons dead"): a harness run over every Cancel path shows each one
+   leaves the page live, so the only way left to wedge it is an uncaught throw
+   AFTER busy=1 but BEFORE the veil paints - the buttons then all no-op with
+   nothing on screen to dismiss. Clear the gate in that case too. */
 window.addEventListener('error', function(){
   if($id('veil') && $id('veil').style.display === 'flex') veilEscape(true);
+  else busy = 0;
 });
 
