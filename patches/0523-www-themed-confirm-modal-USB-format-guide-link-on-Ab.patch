 window.esc = window.ReaperEsc;
 
+/* ---------------------------------------------------------------------------
+ * v2.7.3: themed confirm modal - replaces the browser-chrome confirm() dialog
+ * on reaper-native pages (field ask: the USB format confirm looked stock).
+ *
+ *   reaperConfirm(message, opts, cb)  ->  cb(true|false)
+ *   opts: { okLabel, cancelLabel, danger }
+ *
+ * Label strings come from the CALLER (dict tokens resolve in the caller's
+ * markup context; the bare 'OK'/'Cancel' here are last-resort fallbacks, not
+ * UI copy - always pass tokens). The backdrop carries class "ovl" so the
+ * shell re-anchors it to the visible slice of a framed page (reaper-ui rule
+ * 35: position:fixed alone centres on the whole grown document). message is
+ * rendered with textContent - never HTML. A danger dialog does not accept
+ * Enter as confirmation; destruction takes a deliberate click. */
+window.reaperConfirm = function(msg, opts, cb){
+  opts = opts || {};
+  var old = document.getElementById('rcfm');
+  if(old && old.parentNode) old.parentNode.removeChild(old);
+  var ov = document.createElement('div');
+  ov.id = 'rcfm'; ov.className = 'ovl';
+  ov.style.cssText = 'position:fixed;top:0;left:0;right:0;bottom:0;z-index:9999;display:flex;align-items:center;justify-content:center;background:rgba(4,4,6,.72)';
+  var p = document.createElement('div');
+  p.style.cssText = 'width:430px;max-width:92%;background:#101012;border:1px solid #3a3a3e;border-radius:8px;padding:20px 22px;color:#ECE7DB;font:400 13px/1.6 Inter,Arial,sans-serif;box-shadow:0 18px 60px rgba(0,0,0,.55)';
+  var m = document.createElement('div');
+  m.style.cssText = 'margin:0 0 16px;white-space:pre-line';
+  m.textContent = String(msg == null ? '' : msg);
+  var row = document.createElement('div');
+  row.style.cssText = 'display:flex;justify-content:flex-end;gap:10px';
+  function mkbtn(label, primary){
+    var b = document.createElement('button');
+    b.type = 'button';
+    b.textContent = String(label || '');
+    b.style.cssText = 'padding:8px 16px;border-radius:5px;font:600 12px Inter,Arial,sans-serif;cursor:pointer;border:1px solid ' +
+      (primary ? (opts.danger ? '#E10600;background:#E10600;color:#fff'
+                              : '#666;background:#26262a;color:#ECE7DB')
+               : '#444;background:transparent;color:#b8b3a7');
+    return b;
+  }
+  var bC = mkbtn(opts.cancelLabel || 'Cancel', false);
+  var bO = mkbtn(opts.okLabel || 'OK', true);
+  function done(v){
+    document.removeEventListener('keydown', onkey, true);
+    if(ov.parentNode) ov.parentNode.removeChild(ov);
+    if(cb) cb(!!v);
+  }
+  function onkey(e){
+    if(e.key === 'Escape'){ e.stopPropagation(); done(false); }
+    else if(e.key === 'Enter' && !opts.danger){ e.stopPropagation(); done(true); }
+  }
+  bC.onclick = function(){ done(false); };
+  bO.onclick = function(){ done(true); };
+  ov.onclick = function(e){ if(e.target === ov) done(false); };
+  document.addEventListener('keydown', onkey, true);
+  row.appendChild(bC); row.appendChild(bO);
+  p.appendChild(m); p.appendChild(row);
+  ov.appendChild(p);
+  document.body.appendChild(ov);
+  (opts.danger ? bC : bO).focus();
+};
