diff --git a/release/src/router/www/Reaper_Warden.asp b/release/src/router/www/Reaper_Warden.asp
index a101f112cb..a711e39325 100644
--- a/release/src/router/www/Reaper_Warden.asp
+++ b/release/src/router/www/Reaper_Warden.asp
@@ -596,9 +596,25 @@ function rwStats(){
   var x = new XMLHttpRequest();
   x.open('GET','/reaper_warden.cgi?action=status&http_id='+encodeURIComponent('<% nvram_get("http_id"); %>'),true);
   x.timeout = 8000;
+  /* v2.7.6 (field: "Warden crashed" on a box running Skynet + Diversion): the
+     status CGI runs stats.sh synchronously inside single-process httpd, and
+     stats.sh waits on the counter lock that fold.sh holds during every apply -
+     under a firewall-start storm the request timed out, JSON.parse threw, and
+     this handler returned having updated NOTHING. The page then sat on its
+     static placeholders: "-" blocked, a grey "not armed" pill, an empty table -
+     which reads as a crash while iptables shows a healthy chain. Say so instead
+     (and keep polling); one-shot guard per rule 34. */
+  var fired = false;
+  function unavailable(){
+    if(fired) return; fired = true;
+    var pill = document.getElementById('livepill');
+    if(pill){ pill.className = 'livepill stale'; pill.textContent = '\u25cf ' + `<#RWDN_91#>`; }
+  }
+  x.ontimeout = unavailable; x.onerror = unavailable;
   x.onreadystatechange = function(){
     if(x.readyState !== 4) return;
-    var j; try{ j = JSON.parse(x.responseText); }catch(e){ return; }
+    var j; try{ j = JSON.parse(x.responseText); }catch(e){ unavailable(); return; }
+    fired = true;
     /* no-JFFS disclosure: Warden enforces fine from RAM, but with /jffs off or
        read-only the feed cache can't persist (no cross-reboot / no-internet-boot
        protection). Surface it whenever Warden is enabled but jffs isn't writable. */
