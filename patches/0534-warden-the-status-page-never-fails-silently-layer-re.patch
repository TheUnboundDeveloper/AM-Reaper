diff --git a/release/src/router/rc/firewall.c b/release/src/router/rc/firewall.c
index b9b37dcc50..fa4adc680c 100644
--- a/release/src/router/rc/firewall.c
+++ b/release/src/router/rc/firewall.c
@@ -9423,6 +9423,15 @@ leave:
 	 * before any of them runs. Each apply.sh calls it at its tail. */
 	reaper_hook_gen();
 
+	/* v2.7.6: firewall-start (addon hooks such as Skynet) is forked and NOT
+	 * waited on, and this block runs after the firewall lock was released - so
+	 * the layer re-applies below could interleave with rwatch's reaper_lockrun
+	 * (which does take the lock) on an iptables that never uses -w, losing
+	 * individual rules. Take the lock for the whole block; none of the generated
+	 * scripts calls back into rc, and none sleeps. */
+	{
+	int llock = file_lock("firewall");
+
 	/* reaper v1.6.8 Gatekeeper: this rebuild just deleted our chains - re-apply
 	 * immediately (gkd's 10s self-heal is only the backstop, not the primary). */
 	if (nvram_match("gk_enable", "1") && f_exists("/tmp/gk/apply.sh"))
@@ -9446,6 +9455,8 @@ leave:
 		else if (f_exists("/tmp/reaper_fw/apply.sh"))
 			system("sh /tmp/reaper_fw/apply.sh");
 	}
+	file_unlock(llock);
+	}
 
 	/* reaper v2.5.x ipset policy routing: our mangle PREROUTING jump can be
 	 * unhooked by this rebuild - re-run the idempotent generated script. v2.6.7:
diff --git a/release/src/router/rc/reaper_pbr.c b/release/src/router/rc/reaper_pbr.c
index 6c24055501..48eba25054 100644
--- a/release/src/router/rc/reaper_pbr.c
+++ b/release/src/router/rc/reaper_pbr.c
@@ -345,7 +345,13 @@ static int ppbr_gen(const char *path, int teardown_only, const ppbr_cfg_t *cfg)
 	  "for V in -4 -6; do\n"
 	  "  for P in 9001 9002 9003 9004 9005 9006 9007 9008 9009 9010 9011 9015 "
 	  "9101 9102 9103 9104 9105 9106 9107 9108 9109 9110 9111 9115; do\n"
-	  "    while ip $V rule del pref $P 2>/dev/null; do :; done\n"
+	  /* v2.7.6 (field: a box also running an addon that manages its own ip
+	   * rules): `rule del pref P` is owner-blind - it removed whatever sat at
+	   * our pref. Only delete a rule that carries OUR fwmark form (bits 16-19,
+	   * mask 0xf0000); anything else at that pref is somebody else's and stays. */
+	  "    while ip $V rule show 2>/dev/null | grep -Eq \"^$P:.*fwmark 0x[0-9a-fA-F]+/0x0*[fF]0000\"; do\n"
+	  "      ip $V rule del pref $P 2>/dev/null || break\n"
+	  "    done\n"
 	  "  done\n"
 	  "done\n"
 	  "pbr_skip_del_ours\n"
diff --git a/release/src/router/rc/rwarden.c b/release/src/router/rc/rwarden.c
index 0a5bddfe88..3571399ff4 100644
--- a/release/src/router/rc/rwarden.c
+++ b/release/src/router/rc/rwarden.c
@@ -1266,8 +1266,11 @@ static void rw_gen_stats(void)
 	  /* Shared lock (see fold.sh): hold it across the banked $CTR reads and the
 	   * live counter reads so a fold.sh checkpoint cannot mv+zero between them and
 	   * produce a one-tick backward dip. Reader-shared so concurrent 30 s polls
-	   * do not serialize; best-effort 5 s wait. */
-	  "exec 9>/tmp/rwarden/ctr.lock; flock -w 5 -s 9 2>/dev/null\n"
+	   * do not serialize; best-effort wait. v2.7.6: 5 s -> 2 s. httpd runs this
+	   * synchronously in its single process, so every second waited here is a
+	   * second the whole GUI is frozen; a checkpoint holding the exclusive lock
+	   * that long is the rare case, and a one-tick dip beats a dead page. */
+	  "exec 9>/tmp/rwarden/ctr.lock; flock -w 2 -s 9 2>/dev/null\n"
 	  "BASE=0; SINCE=0\n"
 	  "if [ \"$SV\" = 1 ] && [ -f \"$CTR\" ]; then\n"
 	  "  BASE=$(awk '$1==\"TOTAL\"{print $2+0; exit}' \"$CTR\" 2>/dev/null); [ -n \"$BASE\" ] || BASE=0\n"
