@@ -9416,8 +9416,6 @@ add_mtwan:
 leave:
 	file_unlock(lock);
 
-	run_custom_script("firewall-start", 0, wan_if, NULL);
-
 	/* reaper v2.6.2: the three layers below register into shared front chains
 	 * (rc/reaper_hook.h); make sure the generator script exists on this tmpfs
 	 * before any of them runs. Each apply.sh calls it at its tail. */
@@ -9476,6 +9474,12 @@ leave:
 		file_unlock(plock);
 	}
 
+	/* reaper (#4): run addon firewall-start LAST, after Reaper's front chains
+	 * and layer re-applies are in place, so an addon (Skynet/Diversion) lays its
+	 * rules on top with nothing racing it - the stock "runs last" contract.
+	 * Still forked/non-blocking. */
+	run_custom_script("firewall-start", 0, wan_if, NULL);
+
 	return 0;
 }
 
diff --git a/release/src/router/rc/reaper_pbr.c b/release/src/router/rc/reaper_pbr.c
index 48eba25054..da842075e5 100644
--- a/release/src/router/rc/reaper_pbr.c
+++ b/release/src/router/rc/reaper_pbr.c
@@ -290,8 +290,13 @@ static void ppbr_emit_skip_helpers(FILE *f)
 	  "pbr_rule() { NEXPECT=$((NEXPECT+1)); \"$@\" || { NFAIL=$((NFAIL+1)); logger -t reaper_pbr \"rule failed: $*\"; }; }\n"
 	  "pbr_skip_add() {\n"
 	  "  [ -w \"$SKIP\" ] || return 0\n"
+	  "  if [ -n \"$2\" ] && [ ! -d /sys/class/net/\"$2\" ]; then logger -t reaper_pbr \"WireGuard iface $2 down - $1 skip-bypass not installed\"; return 0; fi\n"
 	  "  if grep -qsx -- \"$1\" \"$SKIP\"; then echo \"$1 pre\" >> \"$SKIPREC\"; return 0; fi\n"
-	  "  echo \"add $1\" > \"$SKIP\" 2>/dev/null\n"
+	  "  _u=$(grep -cE '[0-9]' \"$SKIP\" 2>/dev/null); [ -n \"$_u\" ] || _u=0\n"
+	  "  if [ \"$_u\" -ge 8 ]; then\n"
+	  "    logger -t reaper_pbr \"blog skip table full ($_u/8) - WireGuard rule for $1 not installed (free a VPN Director/WireGuard slot)\"; return 0\n"
+	  "  fi\n"
+	  "  printf 'add %%s' \"$1\" > \"$SKIP\" 2>/dev/null\n"
 	  "  if grep -qsx -- \"$1\" \"$SKIP\"; then echo \"$1 new\" >> \"$SKIPREC\"\n"
 	  "  else logger -t reaper_pbr \"blog skip table full - WireGuard rule for $1 may be bypassed by accelerated flows\"; fi\n"
 	  "}\n");
@@ -358,7 +363,7 @@ static int ppbr_gen(const char *path, int teardown_only, const ppbr_cfg_t *cfg)
 	  "\n");
 
 	if (teardown_only) {
-		fprintf(f, "rm -f " PPBR_DIR "/expect " PPBR_DIR "/failcount\n" "exit 0\n");
+		fprintf(f, "rm -f " PPBR_DIR "/expect " PPBR_DIR "/expect_rules " PPBR_DIR "/failcount\n" "exit 0\n");
 		fclose(f);
 		if (rename(tmp, path) != 0) { unlink(tmp); return 0; }
 		return 1;
@@ -429,7 +434,7 @@ static int ppbr_gen(const char *path, int teardown_only, const ppbr_cfg_t *cfg)
 					        sel6, code);
 				}
 				if (wg) {
-					if (skipnet[0]) fprintf(f, "pbr_skip_add %s\n", skipnet);
+					if (skipnet[0]) fprintf(f, "pbr_skip_add %s %s\n", skipnet, tbl);
 					else            wg_lanwide = 1;
 				}
 				nent++;
@@ -499,6 +504,7 @@ static int ppbr_gen(const char *path, int teardown_only, const ppbr_cfg_t *cfg)
 
 	fprintf(f,
 	  "echo $NEXPECT > " PPBR_DIR "/expect\n"
+	  "ip -4 rule show 2>/dev/null | grep -cE 'fwmark 0x[0-9a-fA-F]+/0x0*[fF]0000' > " PPBR_DIR "/expect_rules\n"
 	  "echo $NFAIL > " PPBR_DIR "/failcount\n"
 	  "[ \"$NFAIL\" -gt 0 ] && logger -t reaper_pbr \"$NFAIL of $NEXPECT mark rule(s) failed to load - the watchdog will retry\"\n"
 	  "exit 0\n");
@@ -695,7 +701,8 @@ void start_reaper_pbr(void)
 		 * can shadow the file, exactly as gk_rl did in v2.6.3. */
 		const char *nv = nvram_safe_get("reaper_pbr_rulelist");
 		char *legacy = strdup(nv);
-		if (legacy && ppbr_write_lastgood(legacy) && legacy[0]) {
+		if (legacy) ppbr_write_lastgood(legacy);   /* always seed a baseline: empty = "PBR off" = a valid rollback target, so the first Apply is never deadlocked */
+		if (legacy && legacy[0]) {
 			int n = 0; const char *q;
 			for (q = legacy; (q = strchr(q, '<')) != NULL; q++) n++;
 			logmessage("reaper_pbr", "rule list migrated from nvram to " REAPER_PBR_RL " (%d rules; nvram held a 1 KB cap)", n);
@@ -813,6 +820,7 @@ void reaper_pbr_confirm(void)
 	}
 	eval("cru", "d", "reaper_pbr_cc");
 	unlink(PPBR_DEADLINE);
+	nvram_set("reaper_pbr_armed", "0");   /* clear BEFORE commit: flash must never persist armed=1 (phantom "awaiting confirmation" after reboot) */
 	nvram_commit();                             /* reaper_pbr_enable */
 	{
 		/* the confirmed list = the staged draft (or, for an enable-only
@@ -829,7 +837,6 @@ void reaper_pbr_confirm(void)
 		unlink(PPBR_CAND);
 		unlink(PPBR_APPLY);
 	}
-	nvram_set("reaper_pbr_armed", "0");
 	logmessage("reaper_pbr", "routing rules confirmed and saved");
 }
 
diff --git a/release/src/router/rc/rwatch.c b/release/src/router/rc/rwatch.c
index 70c6445d39..5370e42c90 100644
--- a/release/src/router/rc/rwatch.c
+++ b/release/src/router/rc/rwatch.c
@@ -118,6 +118,17 @@ static void rwatch_gen(void)
 	  "    rc reaper_lockrun \"$_sh\" >/dev/null 2>&1\n"
 	  "  fi\n"
 	  "fi\n"
+	  "if [ \"$(_nv reaper_pbr_active)\" = 1 ] && [ -s /tmp/reaper_pbr/expect_rules ]; then\n"
+	  "  _exr=$(cat /tmp/reaper_pbr/expect_rules 2>/dev/null); case \"$_exr\" in ''|*[!0-9]*) _exr=0;; esac\n"
+	  "  _shr=/tmp/reaper_pbr/apply.sh; [ -d /tmp/reaper_pbr/armed ] && [ -f /tmp/reaper_pbr/candidate.sh ] && _shr=/tmp/reaper_pbr/candidate.sh\n"
+	  "  _lvr=$(ip -4 rule show 2>/dev/null | grep -cE 'fwmark 0x[0-9a-fA-F]+/0x0*[fF]0000')\n"
+	  "  _lstr=$(cat /tmp/reaper_pbr/heal.at 2>/dev/null || echo 0)\n"
+	  "  if [ \"$_exr\" -gt 0 ] && [ \"$_lvr\" -lt \"$_exr\" ] && [ $((UP-_lstr)) -ge 120 ] && [ -x \"$_shr\" ]; then\n"
+	  "    echo $UP > /tmp/reaper_pbr/heal.at\n"
+	  "    logger -t rwatch \"policy routing: $_lvr of $_exr ip rule(s) live - re-applying\"\n"
+	  "    rc reaper_lockrun \"$_shr\" >/dev/null 2>&1\n"
+	  "  fi\n"
+	  "fi\n"
 	  "\n"
 	  "# boot grace: the WAN is legitimately down for the first minutes\n"
 	  "[ \"$UP\" -lt 300 ] && exit 0\n"
