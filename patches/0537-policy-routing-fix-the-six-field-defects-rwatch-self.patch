-			nvram_get_int("wgc4_enable"), nvram_get_int("wgc5_enable"));
+			nvram_get_int("wgc4_enable"), nvram_get_int("wgc5_enable"),
+		nvram_safe_get("vpn_client1_addr")[0]?1:0, nvram_safe_get("vpn_client2_addr")[0]?1:0, nvram_safe_get("vpn_client3_addr")[0]?1:0,
