diff --git a/release/src/router/rc/services.c b/release/src/router/rc/services.c
index a14977b2ae..2784db28f1 100644
--- a/release/src/router/rc/services.c
+++ b/release/src/router/rc/services.c
@@ -7930,6 +7930,72 @@ void start_spectrum(void)
 
 // TODO: so far, support wan0 only
 
+/* reaper 2026-08-25: SINGLE SOURCE OF TRUTH for "is UPnP on, and on which WAN".
+ *
+ * Field bug, confirmed on two boxes desynced in OPPOSITE directions:
+ *   RT-BE88U v2.7.6 - daemon up, real console mappings in VUPNP (udp 3074/9308),
+ *     but no "-A VSERVER -j VUPNP": not one packet DNATed, so the console sat
+ *     on NAT type Moderate while every status surface reported UPnP healthy.
+ *   RT-BE96U v2.7.6 - the jump installed and passing traffic, but the daemon
+ *     never started, no /tmp/upnp.leases, VUPNP empty.
+ *
+ * Cause: UPnP was gated by TWO different nvram keys with nothing keeping them
+ * in sync. start_upnp() read the per-unit wan<N>_upnp_enable; nat_setting(),
+ * nat_setting2() and the mangle builders read the bare upnp_enable - which is
+ * wan_upnp_enable with the family prefix stripped (wan_defaults(), init.c).
+ * wan_defaults() cannot resync them: it is "assign none-exist value" and writes
+ * the DEFAULTS-TABLE value, not the current setting, so once wan<N>_upnp_enable
+ * exists it is frozen. The only writer is httpd's wan_ propagation, which is
+ * gated on unit != -1 and on a validator that lives in a closed blob.
+ *
+ * Every consumer now derives from these two helpers, so the daemon and the
+ * rules cannot disagree by construction. Do NOT reintroduce a bare
+ * nvram_get_int("upnp_enable") gate anywhere in the enable path.
+ *
+ * The unit-selection body is lifted VERBATIM from start_upnp(), including the
+ * upstream oddity that the loop builds prefix from 'unit' rather than 'i'.
+ * That is preserved deliberately - changing it would change which WAN
+ * miniupnpd binds on a failed-over dual-WAN box, a separate question that
+ * needs its own field evidence. */
+int upnp_wan_unit(void)
+{
+	char tmp[100], prefix[sizeof("wanXXXXXXXXXX_")];
+	int unit;
+
+	unit = wan_primary_ifunit();
+#ifdef RTCONFIG_DUALWAN
+	if (get_dualwan_by_unit(unit) == WANS_DUALWAN_IF_NONE || !is_wan_connect(unit)) {
+		int i;
+		for (i = WAN_UNIT_FIRST; i < WAN_UNIT_MAX; i++) {
+			if (get_dualwan_by_unit(i) == WANS_DUALWAN_IF_NONE || !is_wan_connect(i))
+				continue;
+			snprintf(prefix, sizeof(prefix), "wan%d_", unit);
+			if (nvram_match(strcat_r(prefix, "proto", tmp), "static")) {
+				snprintf(tmp, sizeof(tmp), i ? "link_wan%d" : "link_wan", i);
+				if (!nvram_get_int(tmp))
+					continue;
+			}
+			if (nvram_get_int(strcat_r(prefix, "upnp_enable", tmp))) {
+				unit = i;
+				break;
+			}
+		}
+	}
+#endif
+	return unit;
+}
+
+/* Non-zero when UPnP/NAT-PMP/PCP is enabled for the WAN miniupnpd would serve.
+ * The firewall builders gate their VUPNP/PUPNP hooks on this so the rules and
+ * the daemon are always in step. */
+int upnp_enabled(void)
+{
+	char tmp[100], prefix[sizeof("wanXXXXXXXXXX_")];
+
+	snprintf(prefix, sizeof(prefix), "wan%d_", upnp_wan_unit());
+	return nvram_get_int(strcat_r(prefix, "upnp_enable", tmp)) ? 1 : 0;
+}
+
 void start_upnp(void)
 {
 	FILE *f;
@@ -7963,30 +8029,13 @@ void start_upnp(void)
 	if (!is_routing_enabled())
 		return;
 
-	unit = wan_primary_ifunit();
-#ifdef RTCONFIG_DUALWAN
-	if (get_dualwan_by_unit(unit) == WANS_DUALWAN_IF_NONE || !is_wan_connect(unit)) {
-		int i;
-		for (i = WAN_UNIT_FIRST; i < WAN_UNIT_MAX; i++) {
-			if (get_dualwan_by_unit(i) == WANS_DUALWAN_IF_NONE || !is_wan_connect(i))
-				continue;
-			snprintf(prefix, sizeof(prefix), "wan%d_", unit);
-			if (nvram_match(strcat_r(prefix, "proto", tmp), "static")) {
-				snprintf(tmp, sizeof(tmp), i ? "link_wan%d" : "link_wan", i);
-				if (!nvram_get_int(tmp))
-					continue;
-			}
-			if (nvram_get_int(strcat_r(prefix, "upnp_enable", tmp))) {
-				unit = i;
-				break;
-			}
-		}
-	}
-#endif
+	/* reaper: both of these now come from the shared helpers above, so this
+	 * function and the firewall builders can never disagree about UPnP. */
+	unit = upnp_wan_unit();
 	snprintf(prefix, sizeof(prefix), "wan%d_", unit);
 	upnp_mnp_enable = nvram_get_int("upnp_mnp");
 
-	if (nvram_get_int(strcat_r(prefix, "upnp_enable", tmp)))
+	if (upnp_enabled())
 		run_upnpd = 1;
 #if defined(RTCONFIG_AURASYNC)
 	if (run_upnpd) {
