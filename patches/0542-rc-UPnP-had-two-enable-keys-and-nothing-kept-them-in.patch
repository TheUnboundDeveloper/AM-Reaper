index bf27c8d369..c678b29883 100644
--- a/release/src/router/rc/rc.h
+++ b/release/src/router/rc/rc.h
@@ -2950,6 +2950,8 @@ extern int start_lltdc(void);
 #endif
 extern int stop_wps(void);
 extern int start_wps(void);
