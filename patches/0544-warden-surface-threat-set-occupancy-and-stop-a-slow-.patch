diff --git a/release/src/router/rc/rwarden.c b/release/src/router/rc/rwarden.c
index 3571399ff4..c1cf314c51 100644
--- a/release/src/router/rc/rwarden.c
+++ b/release/src/router/rc/rwarden.c
@@ -89,6 +89,13 @@
 #define RW_CCTMP  "/tmp/rwarden/cc.live"	/* scratch: live per-country deltas being folded */
 #define RW_CHTMP  "/tmp/rwarden/ch.live"	/* scratch: one chain listing, read by every bucket */
 #define RW_SAVE   "/jffs/rwarden/sets.ipset"
+/* The threat sets' ceiling. Was a bare literal repeated at six ipset-create
+ * sites AND implicitly assumed by the UI, so "surface the count against the
+ * limit" had no single number to quote. One definition, string form for the
+ * script text, and it is emitted in the stats JSON so the page can never
+ * drift from what the sets are actually built with. */
+#define RW_THREAT_MAXELEM   524288
+#define RW_THREAT_MAXELEM_S "524288"
 #define RW_GEO_MAXELEM   262144		/* per-country sets; the default 65536 truncates the biggest zones */
 #define RW_GEO_MAXELEM_S "262144"	/* same value, for string-pasted script text */
 
@@ -625,8 +632,8 @@ static void rw_gen_apply(void)
 	fprintf(f,
 	  "for s in rw_allow rw_ban; do ipset create $s hash:net -exist; done\n"
 	  "for s in rw_allow6 rw_ban6; do ipset create $s hash:net family inet6 -exist; done\n"
-	  "ipset create rw_threat hash:net maxelem 524288 -exist\n"
-	  "ipset create rw_threat6 hash:net family inet6 maxelem 524288 -exist\n");
+	  "ipset create rw_threat hash:net maxelem " RW_THREAT_MAXELEM_S " -exist\n"
+	  "ipset create rw_threat6 hash:net family inet6 maxelem " RW_THREAT_MAXELEM_S " -exist\n");
 	rw_emit_country_creates(f);
 	/* restore cached feed sets from jffs (boot without internet still protected).
 	 *
@@ -849,6 +856,16 @@ static void rw_gen_update(void)
 	   * feeds put that URL under user control. 32 MiB is ~20x the largest
 	   * curated feed. */
 	  "CURL='curl -fsSL --max-filesize 33554432 --retry 2 --max-time 40'\n"
+	  /* CURLC: the same fetch, on a much shorter leash, for USER-supplied
+	   * feeds only. The curated feeds are known-good hosts and are worth
+	   * waiting on; a custom URL is not, and eight of them at --retry 2
+	   * --max-time 40 is 8x3x40s = up to 16 minutes of one update window
+	   * spent on hosts that may simply be gone. --retry 1 --max-time 15
+	   * caps the same eight at 8x2x15s = 4 minutes. A slow custom feed now
+	   * loses its own turn instead of stalling everyone else's; the fetch
+	   * still logs FAILED, and the previous set is kept (swap-if-nonempty),
+	   * so a timeout degrades to "no refresh", never to "no data". */
+	  "CURLC='curl -fsSL --max-filesize 33554432 --retry 1 --max-time 15'\n"
 	  /* https-only INCLUDING across redirects. -L follows redirects and curl
 	   * permits https->http by default, so an https feed that 302s to http was
 	   * still followed - and whatever came back is loaded straight into a DROP
@@ -860,6 +877,7 @@ static void rw_gen_update(void)
 	   * is refused by the pin. */
 	  "if curl --proto-redir =https --version >/dev/null 2>&1; then\n"
 	  "  CURL=\"$CURL --proto =https --proto-redir =https\"\n"
+	  "  CURLC=\"$CURLC --proto =https --proto-redir =https\"\n"
 	  "else\n"
 	  "  logger -t rwarden \"curl has no --proto-redir; feed fetches are not redirect-pinned\"\n"
 	  "fi\n"
@@ -873,8 +891,8 @@ static void rw_gen_update(void)
 	  "# unspecified/loopback, link-local fe80-febf, ULA fc/fd, multicast ff.\n"
 	  "rw_f4() { grep -vE '^(0\\.|10\\.|127\\.|169\\.254\\.|192\\.168\\.|172\\.(1[6-9]|2[0-9]|3[01])\\.|100\\.(6[4-9]|[7-9][0-9]|1[01][0-9]|12[0-7])\\.|22[4-9]\\.|2[34][0-9]\\.|25[0-5]\\.)'; }\n"
 	  "rw_f6() { grep -viE '^(::|0{1,4}:|fe[89ab]|f[cd]|ff)'; }\n"
-	  "ipset create rw_threat hash:net maxelem 524288 -exist\n"
-	  "ipset create rw_threat6 hash:net family inet6 maxelem 524288 -exist\n"
+	  "ipset create rw_threat hash:net maxelem " RW_THREAT_MAXELEM_S " -exist\n"
+	  "ipset create rw_threat6 hash:net family inet6 maxelem " RW_THREAT_MAXELEM_S " -exist\n"
 	  "NEW=/tmp/rwarden/threat.new; : > $NEW\n"
 	  "NEW6=/tmp/rwarden/threat6.new; : > $NEW6\n"
 	  "OK=0\n");
@@ -937,7 +955,7 @@ static void rw_gen_update(void)
 				continue;
 			}
 			fprintf(f,
-			  "if $CURL '%s' -o $TMP 2>/dev/null; then\n"
+			  "if $CURLC '%s' -o $TMP 2>/dev/null; then\n"
 			  "  grep -oE '([0-9]{1,3}\\.){3}[0-9]{1,3}(/[0-9]{1,2})?' $TMP | rw_f4 >> $NEW\n"
 			  "  OK=1\n"
 			  "else\n"
@@ -945,7 +963,7 @@ static void rw_gen_update(void)
 			  "fi\n", u4, nm);
 			if (rw_field(tok, 2, u6, sizeof(u6)) && *u6 && rw_valid_feedurl(u6))
 				fprintf(f,
-				  "if $CURL '%s' -o $TMP 2>/dev/null; then\n"
+				  "if $CURLC '%s' -o $TMP 2>/dev/null; then\n"
 				  "  grep -oiE '([0-9a-f]{0,4}:){2,7}[0-9a-f]{0,4}(/[0-9]{1,3})?' $TMP | rw_f6 >> $NEW6\n"
 				  "  OK=1\n"
 				  "fi\n", u6);
@@ -961,7 +979,7 @@ static void rw_gen_update(void)
 	 * never cost the rest of the set. */
 	fprintf(f,
 	  "if [ -s $NEW ]; then\n"
-	  "  ipset create rw_threat_tmp hash:net maxelem 524288 -exist; ipset flush rw_threat_tmp\n"
+	  "  ipset create rw_threat_tmp hash:net maxelem " RW_THREAT_MAXELEM_S " -exist; ipset flush rw_threat_tmp\n"
 	  "  sort -u $NEW | sed 's/^/add rw_threat_tmp /' > $TMP.rst\n"
 	  "  if ! ipset restore -! < $TMP.rst 2>/dev/null; then\n"
 	  "    logger -t rwarden \"threat v4 batch restore hit a bad entry - per-entry fallback\"\n"
@@ -971,7 +989,7 @@ static void rw_gen_update(void)
 	  "  ipset swap rw_threat_tmp rw_threat; ipset destroy rw_threat_tmp\n"
 	  "fi\n"
 	  "if [ -s $NEW6 ]; then\n"
-	  "  ipset create rw_threat6_tmp hash:net family inet6 maxelem 524288 -exist; ipset flush rw_threat6_tmp\n"
+	  "  ipset create rw_threat6_tmp hash:net family inet6 maxelem " RW_THREAT_MAXELEM_S " -exist; ipset flush rw_threat6_tmp\n"
 	  "  sort -u $NEW6 | sed 's/^/add rw_threat6_tmp /' > $TMP.rst\n"
 	  "  if ! ipset restore -! < $TMP.rst 2>/dev/null; then\n"
 	  "    logger -t rwarden \"threat v6 batch restore hit a bad entry - per-entry fallback\"\n"
@@ -1332,7 +1350,7 @@ static void rw_gen_stats(void)
 	  "UNCL=$((TOTAL-GEO-THREAT-BAN)); [ \"$UNCL\" -lt 0 ] && UNCL=0\n"
 	  "rm -f \"$CH\"\n"
 	  "JP=0; [ -w /jffs ] && JP=1\n"
-	  "printf '{\"enable\":%d,\"armed\":%d,\"v6\":%d,\"lastupd\":%d,\"threat_n\":%d,\"geo_n\":%d,\"geo_e\":%d,\"geo_empty\":%d,"
+	  "printf '{\"enable\":%d,\"armed\":%d,\"v6\":%d,\"lastupd\":%d,\"threat_n\":%d,\"threat_max\":" RW_THREAT_MAXELEM_S ",\"geo_n\":%d,\"geo_e\":%d,\"geo_empty\":%d,"
 	  "\"blocked\":{\"total\":%d,\"since\":%d,\"top\":[%s],"
 	  "\"geo\":%d,\"threat\":%d,\"ban\":%d,\"uncl\":%d},"
 	  "\"save\":%d,\"reset\":\"%s\",\"jffs\":%d,"
