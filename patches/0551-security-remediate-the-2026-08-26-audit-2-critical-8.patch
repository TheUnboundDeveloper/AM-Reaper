 		}
 		for (i = 0; i < 17; i++) umac[i] = toupper((unsigned char)mac[i]);
 		umac[17] = 0;
+		/* Refuse to block the device this request came from. REAPER_GKI sits at
+		 * INPUT position 1, above the stock lo ACCEPT, so a self-DROP takes the
+		 * admin UI, SSH and LAN together - and the captive page with them, so
+		 * there is no in-band way back. The page offers Block on rows it has
+		 * itself flagged as unknown, which is exactly when a randomized MAC is
+		 * the operator's own laptop. An unresolvable peer is allowed through
+		 * here; the admin-port RETURN now emitted ahead of the per-device rules
+		 * is the backstop for that case. */
+		if (state == 0) {
+			char self[18];
+			if (reaper_requester_mac(self, sizeof(self)) && !strcasecmp(self, umac)) {
+				websWrite(stream, "{\"ok\":0,\"error\":\"that is the device you are using - block it from a different device\",\"ek\":\"RDEVE_SELF\"}");
+				return;
+			}
+		}
 		if (state == 3) {
 			int h = nvram_get_int("gk_guest_hours");
 			if (h < 1 || h > 168) h = 24;
@@ -23458,6 +23498,35 @@ do_reaper_gk_cgi(char *url, FILE *stream)
  * lives here (config flows through apply.cgi -> restart_rwarden), so no CSRF
