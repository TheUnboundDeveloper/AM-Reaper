+/* MAC of the host that issued this request, from the ARP table. Returns 0 when
+ * the peer cannot be resolved - callers must read that as "unknown", never as
+ * "not the caller", so an unresolvable peer never silently loses the guard. */
+static int
+reaper_requester_mac(char *out, size_t n)
+{
+	char ip[46], line[256], addr[46], mac[32], dev[32];
+	FILE *fp;
+	int got = 0;
+
+	if (!out || n < 18) return 0;
+	out[0] = 0;
+	if (!safe_uaddr_ntop(&login_uip_tmp, ip, sizeof(ip)) || !ip[0]) return 0;
+	if ((fp = fopen("/proc/net/arp", "r")) == NULL) return 0;
+	while (fgets(line, sizeof(line), fp)) {
+		if (sscanf(line, "%45s %*s %*s %31s %*s %31s", addr, mac, dev) != 3) continue;
+		if (strcmp(addr, ip) != 0 || !gk_valid_mac(mac)) continue;
+		strlcpy(out, mac, n);
+		got = 1;
+		break;
+	}
+	fclose(fp);
+	return got;
+}
