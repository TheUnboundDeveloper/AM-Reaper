diff --git a/release/src/router/gkd/gkd.c b/release/src/router/gkd/gkd.c
index ed4d0d876f..fbfd6515a7 100644
--- a/release/src/router/gkd/gkd.c
+++ b/release/src/router/gkd/gkd.c
@@ -415,10 +415,39 @@ static void expire_guests(void)
  *  2. ASUS rebuilt SDN_FI and our captive-admit rule is gone -> sdnfi.sh
  *  3. a bridge's delegated IPv6 prefix set changed since apply.sh ran -> re-run
  * One shell fork per cycle; each action is logged and throttled. */
+/* The heal throttle CANNOT be a process-local static: the action it throttles is
+ * notify_rc("restart_gk"), which kills and respawns this very gkd, so the
+ * replacement starts with the counter back at 0 and the 120 s guard is true
+ * again on its first armed tick. A persistent MISS therefore produced an
+ * unbounded restart loop - full chain rebuild plus an `fc flush` every 10-30 s
+ * for the life of the box. Both stamps live in tmpfs and survive the respawn. */
+#define GK_HEAL_AT      GK_DIR "/heal.at"
+#define GK_HEAL_N       GK_DIR "/heal.n"
+#define GK_HEAL_STRIKES 5
+
+static long gk_stamp_get(const char *path)
+{
+	FILE *f = fopen(path, "r");
+	long v = 0;
+	if (!f) return 0;
+	if (fscanf(f, "%ld", &v) != 1) v = 0;
+	fclose(f);
+	return v;
+}
+
+static void gk_stamp_set(const char *path, long v)
+{
+	FILE *f = fopen(path, "w");
+	if (!f) return;
+	fprintf(f, "%ld\n", v);
+	fclose(f);
+}
+
 static void heal_networks(void)
 {
-	static time_t last_restart = 0, last_v6 = 0;
+	static time_t last_v6 = 0;
 	static int sdnfi_logged = 0;
+	static int heal_gaveup = 0;
 	char out[512] = "";
 	char cmd[2048], nvbuf[64];
 	FILE *p;
@@ -442,11 +471,29 @@ static void heal_networks(void)
 	if (!p) return;
 	while (fgets(out, sizeof(out), p)) {
 		char *nl = strchr(out, '\n'); if (nl) *nl = 0;
-		if (!strncmp(out, "MISS=", 5) && out[5] && out[6]) {
-			if (now - last_restart >= 120) {
-				last_restart = now;
-				logmessage("gatekeeper", "bridge(s)%s carry an address but are not hooked - re-applying on every network", out + 5);
-				notify_rc("restart_gk");	/* kills+respawns this gkd after the regen */
+		if (!strncmp(out, "MISS=", 5)) {
+			if (out[5] && out[6]) {
+				long at = gk_stamp_get(GK_HEAL_AT);
+				long strikes = gk_stamp_get(GK_HEAL_N);
+				if (strikes >= GK_HEAL_STRIKES) {
+					/* Some bridges never converge - /tmp/gk/ifs is built only
+					 * from ENABLED sdn_rl records, so a disabled-but-addressed
+					 * SDN bridge or an addon-created br-* is permanently a
+					 * MISS. Stop re-arming instead of thrashing for ever. */
+					if (!heal_gaveup) {
+						logmessage("gatekeeper", "bridge(s)%s still not hooked after %d re-applies - giving up until the next Gatekeeper restart", out + 5, GK_HEAL_STRIKES);
+						heal_gaveup = 1;
+					}
+				} else if ((long)now - at >= 120) {
+					gk_stamp_set(GK_HEAL_AT, (long)now);
+					gk_stamp_set(GK_HEAL_N, strikes + 1);
+					logmessage("gatekeeper", "bridge(s)%s carry an address but are not hooked - re-applying on every network", out + 5);
+					notify_rc("restart_gk");	/* kills+respawns this gkd after the regen */
+				}
+			} else {
+				/* converged: give a genuinely new drift its full allowance */
+				if (gk_stamp_get(GK_HEAL_N) != 0) gk_stamp_set(GK_HEAL_N, 0);
+				heal_gaveup = 0;
 			}
 		} else if (!strcmp(out, "SDNFI=missing")) {
 			if (!sdnfi_logged) { logmessage("gatekeeper", "captive admit rule missing from SDN_FI (SDN rules rebuilt) - re-inserting"); sdnfi_logged = 1; }
@@ -554,6 +601,9 @@ static void amas_watch(long now)
 	static int have_sig = 0;
 	static long last_regen = 0;
 	static int ob_open = -1;	/* -1 = unknown at startup: clean up once */
+	static long ob_start = 0;	/* when this window opened (0 = closed) */
+	static int ob_capped = 0;	/* window hit its local deadline */
+#define GK_OB_MAX_SECS 900
 	unsigned long cur = relist_sig();
 	const char *ob = nvram_safe_get("cfg_obstatus");
 	int active;
@@ -571,7 +621,23 @@ static void amas_watch(long now)
 		}
 	}
 
-	active = !nvram_match("gk_default", "1") && ob[0] && strcmp(ob, "1") != 0;
+	/* cfg_onboarding.h: 1=OFF 2=AVAILABLE 3=REQ 4=LOCKED. The window used to
+	 * open on anything except 1, which includes AVAILABLE - the ordinary AiMesh
+	 * SEARCH an admin runs from Network Map. Nothing is joining in that state,
+	 * so hold the gate open only once a node actually asks (REQ) or is being
+	 * onboarded (LOCKED). */
+	active = !nvram_match("gk_default", "1") && (!strcmp(ob, "3") || !strcmp(ob, "4"));
+	/* cfg_obstatus is written by the closed cfg_server and has no defaults.c
+	 * entry, so a stuck value would hold the gate open for ever while the UI
+	 * still reported armed. Cap the window locally; it re-arms when the status
+	 * returns to idle. */
+	if (!active) { ob_start = 0; ob_capped = 0; }
+	else if (!ob_start) ob_start = now;
+	else if (!ob_capped && now - ob_start > GK_OB_MAX_SECS) {
+		logmessage("gatekeeper", "AiMesh onboarding window open %ld s - closing the quarantine gate; restart onboarding if a node is still joining", (long)GK_OB_MAX_SECS);
+		ob_capped = 1;
+	}
+	if (ob_capped) active = 0;
 	if (active) {
 		/* re-asserted every tick while active: an apply.sh rebuild mid-window
 		 * flushes the chain and the -C guard re-inserts within POLL_SECS */
