+
+/* defined with the settings import/export below; the Warden save reuses its
+ * "printable ASCII, bounded" gate rather than inventing a second one */
+static int rcfg_ok(const char *v, size_t max);
+
+#define RW_LIST_MAX 8192	/* /jffs-backed now, so no longer the 1 KB nvram ceiling */
+
+/* The page used to read these with <% nvram_get("rwarden_ban") %>. They are not
+ * in nvram any more, so serve them from the store - percent-encoded, because
+ * cfeeds carries URLs and the page already decodeURIComponent()s that field. */
+static int
+ej_rwarden_list(int eid, webs_t wp, int argc, char_t **argv)
+{
+	char *name, *v, *p;
+
+	if (ejArgs(argc, argv, "%s", &name) < 1) return 0;
+	if (strcmp(name, "ban") && strcmp(name, "allow") && strcmp(name, "cfeeds")) return 0;
+	if ((v = rw_list_get(name)) == NULL) return 0;
+	for (p = v; *p; p++) {
+		unsigned char c = (unsigned char)*p;
+		if (isalnum(c) || c == '-' || c == '_' || c == '.' || c == '~')
+			websWrite(wp, "%c", c);
+		else
+			websWrite(wp, "%%%02X", c);
+	}
+	free(v);
+	return 0;
+}
