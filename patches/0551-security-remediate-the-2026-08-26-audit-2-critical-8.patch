+		char nv[40];
+		const char *cur;
+		snprintf(nv, sizeof(nv), "rwarden_%s", names[i]);
+		cur = nvram_safe_get(nv);
+		if (rw_list_set(names[i], cur) != 0) return;	/* leave the marker unwritten; retry next boot */
+		if (cur[0]) n++;
+	}
+	if (rjf_set(marker, "1", "rwarden") != 0) return;
+	for (i = 0; names[i]; i++) {
+		char nv[40];
+		snprintf(nv, sizeof(nv), "rwarden_%s", names[i]);
+		nvram_unset(nv);
+	}
+	nvram_commit();
+	logmessage("rwarden", "%d list(s) migrated from nvram to %s (nvram held a silent 1 KB cap per list)", n, REAPER_RW_DIR);
+}
