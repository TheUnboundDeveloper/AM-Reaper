diff --git a/release/src/router/gkd/gkd.c b/release/src/router/gkd/gkd.c
index fbfd6515a7..77d8c9acc8 100644
--- a/release/src/router/gkd/gkd.c
+++ b/release/src/router/gkd/gkd.c
@@ -107,8 +107,27 @@ static dev_t_gk *touch_dev(const char *mac, long now)
 	 * up. Online-tracking and enforcement are unaffected either way. */
 	int clock_ok = nvram_get_int("ntp_ready");
 	if (!d) {
-		if (ndev >= MAX_DEV) return NULL;
-		d = &devs[ndev++];
+		if (ndev >= MAX_DEV) {
+			/* Refusing the insert meant a full table silently stopped showing
+			 * NEW devices - including the admin's own - until an entry aged out
+			 * at DEV_TTL (24h). Entries mint from any completed ARP entry, and a
+			 * quarantined device still reaches the router at L2, so ~500 spoofed
+			 * MACs could blind the pending list and the new-device alerts for a
+			 * day. Enforcement was never affected (the quarantine catch-all
+			 * still holds), so this is a visibility DoS - but visibility is the
+			 * whole point of the pending list. Evict the least-recently-seen
+			 * OFFLINE entry instead; if every slot is genuinely online, keep the
+			 * old refusal rather than evict a live device. */
+			int i, victim = -1;
+			for (i = 0; i < ndev; i++) {
+				if (devs[i].online) continue;
+				if (victim < 0 || devs[i].last < devs[victim].last) victim = i;
+			}
+			if (victim < 0) return NULL;
+			d = &devs[victim];
+		} else {
+			d = &devs[ndev++];
+		}
 		memset(d, 0, sizeof(*d));
 		snprintf(d->mac, sizeof(d->mac), "%s", mac);
 		norm_mac(d->mac);
@@ -381,6 +400,14 @@ static void expire_guests(void)
 	 * inside the lock - never the poll-start snapshot, which is seconds stale
 	 * after the blocking scans and would clobber an admin approve/block that
 	 * landed during this poll. */
+	/* Pre-NTP, setup_timezone() pins time() to RC_BUILDTIME, so `now` here is
+	 * years in the past and every real expiry looks unreached - then the moment
+	 * NTP steps the clock forward, every pass granted in that window expires at
+	 * once. touch_dev() already gates its stamping on ntp_ready; this did not.
+	 * Do nothing until the clock is real: a pass outliving its deadline by one
+	 * poll is harmless, revoking every guest simultaneously is not. */
+	if (!nvram_get_int("ntp_ready")) return;
+
 	lf = open(GK_DIR "/rl.lock", O_CREAT | O_RDWR, 0600);
 	if (lf >= 0) flock(lf, LOCK_EX);
 	rl = strdup(gk_rl_get());
diff --git a/release/src/router/httpd/web.c b/release/src/router/httpd/web.c
index 1314ca3749..5edb851c86 100644
--- a/release/src/router/httpd/web.c
+++ b/release/src/router/httpd/web.c
@@ -21917,6 +21917,21 @@ do_reaper_conn_cgi(char *url, FILE *stream)
 	struct rc_ctst { uint32_t s, d; unsigned sp, dp; char st[16]; } *ctv = NULL;
 	int ctn = 0, ctcap = 0;
 
+	/* A1-SEC-002: every other Reaper reader is token-gated because these
+	 * handlers are subprocess/scan amplifiers a cross-site GET can drive. This
+	 * one was missed - and it is the most expensive of them: an uncapped read of
+	 * the whole conntrack table (ct_max defaults to 300000) followed by a linear
