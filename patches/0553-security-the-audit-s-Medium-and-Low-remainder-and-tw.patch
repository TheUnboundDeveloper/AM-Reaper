--- a/release/src/router/rc/gatekeeper.c
+++ b/release/src/router/rc/gatekeeper.c
@@ -274,6 +274,13 @@ static void gk_emit_relist(FILE *f)
 			if (!gk_valid_mac(mac)) continue;
 			for (i = 0; i < nseen; i++)
 				if (strcasecmp(seen[i], mac) == 0) { dup = 1; break; }
+			if (!dup && nseen >= 64)
+				/* The registry outgrew the exemption table. Beyond this the
+				 * remaining node STA MACs fall through to the quarantine tail -
+				 * which is exactly the AiMesh incident this function exists to
+				 * prevent - and it used to happen with no diagnostic at all.
+				 * Owner decision (2026-08-26): keep the cap, log the truncation. */
+				logmessage("gatekeeper", "cfg_relist exemption table full at 64 - AiMesh MAC %s NOT exempted (a large tri-band mesh can exceed this)", mac);
 			if (!dup && nseen < 64) {
 				strlcpy(seen[nseen], mac, sizeof(seen[0]));
