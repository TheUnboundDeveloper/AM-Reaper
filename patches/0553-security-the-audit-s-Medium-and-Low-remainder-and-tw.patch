+	{
+		char *hid = get_cgi("http_id"), *want = nvram_safe_get("http_id");
+		if (!hid || !want[0] || strcmp(hid, want) != 0 || !reaper_referer_ok()) {
+			websWrite(stream, "{\"error\":\"invalid request token\",\"ek\":\"RDEVE_1\"}");
+			return;
+		}
+	}
+
 	if (inet_aton(nvram_safe_get("lan_ipaddr"), &ia)) lan_net = ntohl(ia.s_addr);
 	if (inet_aton(nvram_safe_get("lan_netmask"), &ia)) lan_mask = ntohl(ia.s_addr);
 	lan_net &= lan_mask;
@@ -23333,7 +23348,14 @@ do_reaper_gk_cgi(char *url, FILE *stream)
 		websWrite(stream, "{\"now\":%ld,\"enable\":%d,\"armed\":%d,\"def\":%d,\"guest_hours\":%d,\"captive\":%d,\"notify\":%d",
 			(long)time(NULL),
 			nvram_match("gk_enable", "1") ? 1 : 0,
-			f_exists("/tmp/gk/chains.ok") ? 1 : 0,
+			/* The stamp alone is not proof: gkd creates /tmp/gk/chains.ok and
+			 * nothing ever deletes it, and NOTHING SUPERVISES gkd - it has no
+			 * watchdog.c entry and is only started by start_gk(). If it dies,
+			 * guest passes stop expiring, the chains stop self-healing and an
+			 * open AiMesh window is never withdrawn, while this page keeps
+			 * reporting a healthy green "enforcing". Require the daemon to
+			 * actually be alive as well. */
+			(f_exists("/tmp/gk/chains.ok") && pids("gkd")) ? 1 : 0,
 			nvram_match("gk_default", "1") ? 1 : 0,
 			nvram_get_int("gk_guest_hours") > 0 ? nvram_get_int("gk_guest_hours") : 24,
 			nvram_match("gk_captive", "0") ? 0 : 1,
@@ -23431,11 +23453,19 @@ do_reaper_gk_cgi(char *url, FILE *stream)
 		}
 		if (state == 3) {
 			int h = nvram_get_int("gk_guest_hours");
+			/* An absolute deadline computed against the pre-NTP clock
+			 * (RC_BUILDTIME) is not the duration the admin asked for, and it
+			 * expires the instant the clock steps. Refuse rather than issue a
+			 * pass that quietly means something else. */
+			if (!nvram_get_int("ntp_ready")) {
+				websWrite(stream, "{\"ok\":0,\"error\":\"the router's clock is not set yet - try again once it has synced\",\"ek\":\"RDEVE_NTP\"}");
+				return;
+			}
 			if (h < 1 || h > 168) h = 24;
 			expiry = (long)time(NULL) + (long)h * 3600;
 		}
 		gk_rl_update(umac, state, expiry);	/* v2.6.3: persisted by gk_rl_set, no nvram_commit */
-		notify_rc("restart_gk");
+		notify_rc("start_gk_refresh");	/* regen+re-apply; full restart_gk is for enable/disable */
 		reaper_audit("gatekeeper", "set-access", umac);
 		websWrite(stream, "{\"ok\":1}");
 		return;
@@ -23782,6 +23812,20 @@ do_reaper_fw_cgi(char *url, FILE *stream)
 		 * fwactive = reaper_fw_active (written LAST by start/stop_reaper_fw once the
 		 *   chains actually exist). A deferred boot leaves fwen=1, fwactive=0, so the
 		 *   page needs both to tell "On" from "enabled but no chains yet". */
+		/* Each list resolved into its OWN statement. reaper_fw_list_get()
+		 * returns rjf_get()'s single process-wide static, which the NEXT call
+		 * free()s - so six of them stacked as unsequenced arguments to one
+		 * websWrite() was a use-after-free waiting on an evaluation order. It
+		 * does not fire on the shipped gcc-10.3 (verified by disassembling
+		 * web.o: each list_get is followed immediately by its count), but that
+		 * is a codegen accident, not a guarantee. */
+		{
+		int n_rules = fw_list_count(reaper_fw_list_get("rules"));
+		int n_obj   = fw_list_count(reaper_fw_list_get("obj"));
+		int n_grp   = fw_list_count(reaper_fw_list_get("grp"));
+		int n_svc   = fw_list_count(reaper_fw_list_get("svc"));
+		int n_zone  = fw_list_count(reaper_fw_list_get("zone"));
+		int n_zpol  = fw_list_count(reaper_fw_list_get("zpol"));
 		websWrite(stream,
 			",\"fwen\":%d,\"fwactive\":%d,\"fwconfirm\":%d,\"fwarmed\":%d,"
 			"\"nrules\":%d,\"nobj\":%d,\"ngrp\":%d,\"nsvc\":%d,"
@@ -23790,12 +23834,8 @@ do_reaper_fw_cgi(char *url, FILE *stream)
 			nvram_match("reaper_fw_active", "1") ? 1 : 0,
 			nvram_get_int("reaper_fw_confirm"),
 			nvram_match("reaper_fw_armed", "1") ? 1 : 0,
-			fw_list_count(reaper_fw_list_get("rules")),
-			fw_list_count(reaper_fw_list_get("obj")),
-			fw_list_count(reaper_fw_list_get("grp")),
-			fw_list_count(reaper_fw_list_get("svc")),
-			fw_list_count(reaper_fw_list_get("zone")),
-			fw_list_count(reaper_fw_list_get("zpol")));
+			n_rules, n_obj, n_grp, n_svc, n_zone, n_zpol);
+		}
 		websWrite(stream, ",\"fwerr\":");
 		gk_json_esc(stream, nvram_safe_get("reaper_fw_err"));
 
@@ -25960,11 +26000,19 @@ static void do_reaper_dev_cgi(char *url, FILE *stream)
 		}
 		if (state == 3) {
 			int h = nvram_get_int("gk_guest_hours");
+			/* An absolute deadline computed against the pre-NTP clock
+			 * (RC_BUILDTIME) is not the duration the admin asked for, and it
+			 * expires the instant the clock steps. Refuse rather than issue a
+			 * pass that quietly means something else. */
+			if (!nvram_get_int("ntp_ready")) {
+				websWrite(stream, "{\"ok\":0,\"error\":\"the router's clock is not set yet - try again once it has synced\",\"ek\":\"RDEVE_NTP\"}");
+				return;
+			}
 			if (h < 1 || h > 168) h = 24;
 			expiry = (long)time(NULL) + (long)h * 3600;
 		}
 		gk_rl_update(umac, state, expiry);	/* same format authority as GK; persisted by gk_rl_set */
-		notify_rc("restart_gk");
+		notify_rc("start_gk_refresh");	/* regen+re-apply; full restart_gk is for enable/disable */
 		{ char sd[8]; snprintf(sd, sizeof(sd), "%d", state); rdev_audit("access", umac, sd); }
 		websWrite(stream, "{\"ok\":1}");
 		return;
@@ -26159,9 +26207,16 @@ static void gen_scrape_token(char *out, size_t n)
 	unsigned char r[16];
 	FILE *f;
 	size_t i;
-	strlcpy(out, "rpx_", n);
+	/* Fail CLOSED. This used to seed out="rpx_" and then fill entropy in - so an
+	 * unopenable /dev/urandom or a short read left the literal 4-char string
+	 * "rpx_" as the token, and do_reaper_metrics_cgi (auth = NULL) accepts any
+	 * non-empty stored token: GET /reaper_metrics.cgi?token=rpx_ would return
+	 * the full per-device health snapshot with no session. Emit nothing unless
+	 * all 16 bytes arrived; the caller then leaves the stored key untouched. */
+	out[0] = '\0';
 	if ((f = fopen("/dev/urandom", "r")) != NULL) {
 		if (fread(r, 1, sizeof(r), f) == sizeof(r)) {
+			strlcpy(out, "rpx_", n);
 			for (i = 0; i < sizeof(r) && (4 + i * 2 + 1) < n; i++) {
 				out[4 + i * 2]     = hex[r[i] >> 4];
 				out[4 + i * 2 + 1] = hex[r[i] & 0xf];
@@ -26277,7 +26332,10 @@ do_reaper_export_cgi(char *url, FILE *stream)
 		if ((v = get_cgi("source")) && rexport_val_ok(v))   nvram_set("reaper_export_source", v);
 		if ((v = get_cgi("maskmac")))  nvram_set("reaper_export_maskmac", strcmp(v, "1") ? "0" : "1");
 		if ((v = get_cgi("regen_scrape")) && !strcmp(v, "1")) {
-			char t[40]; gen_scrape_token(t, sizeof(t)); nvram_set("reaper_export_scrape_token", t);
+			char t[40];
+			gen_scrape_token(t, sizeof(t));
+			if (t[0]) nvram_set("reaper_export_scrape_token", t);
+			else logmessage("rexport", "scrape token NOT regenerated - /dev/urandom unavailable; the previous token stands");
 		}
 		/* export requires the per-device health probe to have data to send */
 		if (!nvram_match("reaper_export_mode", "off")) nvram_set("rtraf_hprobe", "1");
diff --git a/release/src/router/rc/gatekeeper.c b/release/src/router/rc/gatekeeper.c
