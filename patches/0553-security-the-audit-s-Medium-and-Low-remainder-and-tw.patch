diff --git a/release/src/router/rc/rc.h b/release/src/router/rc/rc.h
index d0adcb6d6d..3d6c703ce6 100644
--- a/release/src/router/rc/rc.h
+++ b/release/src/router/rc/rc.h
@@ -2221,7 +2221,11 @@ extern int pc_reward_main(int argc, char *argv[]);
 
 // common.c
 extern void usage_exit(const char *cmd, const char *help) __attribute__ ((noreturn));
-#define xstart(args...)	_xstart(args, NULL)
+/* (char *)NULL, not NULL: _xstart is variadic and reads the sentinel with
+ * va_arg(.., char *). A bare NULL that expands to a plain 0 is an int in the
+ * varargs list and is undefined behaviour on any ABI where int and char* are
+ * not the same width. Harmless as built today; correct now regardless. */
+#define xstart(args...)	_xstart(args, (char *)NULL)
 extern int _xstart(const char *cmd, ...);
 extern void run_nvscript(const char *nv, const char *arg1, int wtime);
 extern void run_userfile (char *folder, char *extension, const char *arg1, int wtime);
diff --git a/release/src/router/rc/reaper_fw.c b/release/src/router/rc/reaper_fw.c
index 2e7780012a..21830b7869 100644
--- a/release/src/router/rc/reaper_fw.c
+++ b/release/src/router/rc/reaper_fw.c
@@ -758,9 +758,24 @@ static void rfw_emit_one_set(FILE *f, const char *type, const char *name,
 		return;
 	}
 
+	/* `-exist` forgives a set that already exists, but NOT one whose TYPE no
+	 * longer matches (same_set() compares typename and family). The object
+	 * editor lets a type be changed under the same name, and the old set then
+	 * survives: create fails, flush succeeds, every add is rejected, and the
+	 * set sits there EMPTY. Rules naming it still load, so there is no failure
+	 * count and no error - a DROP keyed on it silently matches nothing. The
+	 * fqdn branch above already destroys-on-mismatch; do the same here. The
+	 * chains were torn down at the top of this script, so nothing references
+	 * the set and the destroy is safe. */
+	fprintf(f, "if ipset list -t %s%s 2>/dev/null | grep -q '^Type: ' && "
+	           "! ipset list -t %s%s 2>/dev/null | grep -qx 'Type: %s'; then ipset destroy %s%s 2>/dev/null; fi\n",
+	        RFW_SET4, name, RFW_SET4, name, stype, RFW_SET4, name);
 	fprintf(f, "ipset create %s%s %s -exist\n", RFW_SET4, name, stype);
 	fprintf(f, "ipset flush %s%s\n", RFW_SET4, name);
 	if (strcmp(type, "mac") != 0) {
+		fprintf(f, "if ipset list -t %s%s 2>/dev/null | grep -q '^Type: ' && "
+		           "! ipset list -t %s%s 2>/dev/null | grep -qx 'Type: %s'; then ipset destroy %s%s 2>/dev/null; fi\n",
+		        RFW_SET6, name, RFW_SET6, name, stype, RFW_SET6, name);
 		fprintf(f, "ipset create %s%s %s family inet6 -exist\n", RFW_SET6, name, stype);
 		fprintf(f, "ipset flush %s%s\n", RFW_SET6, name);
 	}
@@ -1570,7 +1585,19 @@ static void rfw_emit_nat(FILE *f, const rfw_cfg_t *c)
 		 * an empty value word-splits the rule apart and a comma list is rejected
 		 * by iptables at load - reject both here. */
 		if (!*eport || strchr(eport, ',')) { logmessage("reaper_fw", "forward: external port must be a single port or range - DROPPED"); continue; }
-		if (!rfw_field(tok, 3, iip, sizeof(iip)) || !rfw_valid_ip(iip)) { logmessage("reaper_fw", "forward: invalid internal IP - DROPPED"); continue; }
+		/* A DNAT target must be a SINGLE v4 host. rfw_valid_ip() also accepts
+		 * a.b.c.d/n and any IPv6 literal, and the CGI only length- and
+		 * charset-checks this list, so an edited backup replayed through the
+		 * same `save` action reaches here with a CIDR. iptables then rejects
+		 * the DNAT while its companion FORWARD ACCEPT - emitted from the same
+		 * record - loads cleanly, leaving an unconditional WAN-inbound ACCEPT
