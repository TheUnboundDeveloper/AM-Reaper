@@ -21708,6 +21708,71 @@ static int reaper_referer_ok(void)
 	return 0;
 }
 
+/* ---------------------------------------------------------------------------
+ * reaper 2026-08-27: the gate above answered "invalid request token" for three
+ * unrelated failures, and a field report on the Warden save proved how badly
+ * that misdirects. The page had been POSTing a FormData object - so
+ * multipart/form-data - into do_html_post_and_get, which is url-encoded-only
+ * and reads the body with a single fgets(): it got the boundary line, which
+ * carries no '=', so init_cgi() registered ZERO variables and http_id was
+ * simply never there. The user read "invalid request token" as a dead session
+ * and logged out and back in twice before the report reached us.
+ *
+ * Classify instead. cgi_nvars() == 0 with no http_id means the request body
+ * never reached the parser - a client/transport bug, not a credential one -
+ * and it gets its own message and ek suffix so the next report names itself.
+ * The SECURITY decision is unchanged: anything but RGATE_OK is refused.
+ * ------------------------------------------------------------------------- */
+#define RGATE_OK	0
+#define RGATE_NODATA	1	/* body never parsed (wrong Content-Type, empty POST) */
+#define RGATE_TOKEN	2	/* http_id absent or wrong */
+#define RGATE_XSITE	3	/* Referer belongs to another host */
+
+/* hid: the token as this handler obtained it (get_cgi, get_cgi_json, or a
+ * multipart field the POST half captured), or NULL if it was not supplied. */
+static int reaper_gate_hid(const char *hid)
+{
+	const char *want = nvram_safe_get("http_id");
+
+	if (!hid && cgi_nvars() == 0) return RGATE_NODATA;
+	if (!hid || !want[0] || strcmp(hid, want) != 0) return RGATE_TOKEN;
+	if (!reaper_referer_ok()) return RGATE_XSITE;
+	return RGATE_OK;
+}
+
+static int reaper_gate(void)
+{
+	return reaper_gate_hid(get_cgi("http_id"));
+}
+
+static const char *reaper_gate_msg(int why)
+{
+	switch (why) {
+	case RGATE_NODATA: return "request carried no parameters";
+	case RGATE_XSITE:  return "cross-site request refused";
+	default:           return "invalid request token";
+	}
+}
+
+/* ek suffix appended to the page's namespace, so a screenshot of the alert
+ * identifies WHICH of the three refusals fired. "_1" stays what it always was
+ * (a genuine token mismatch) - existing help text keeps its meaning. */
+static const char *reaper_gate_ek(int why)
+{
+	switch (why) {
+	case RGATE_NODATA: return "_1B";
+	case RGATE_XSITE:  return "_1C";
+	default:           return "_1";
+	}
+}
+
+/* {"ok":0,...} refusal for the JSON CGIs; ns is the page's ek namespace. */
+static void reaper_gate_deny(FILE *stream, int why, const char *ns)
+{
+	websWrite(stream, "{\"ok\":0,\"error\":\"%s\",\"ek\":\"%s%s\"}",
+		reaper_gate_msg(why), ns, reaper_gate_ek(why));
+}
