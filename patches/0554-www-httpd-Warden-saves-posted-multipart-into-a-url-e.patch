+/* reaper 2026-08-27: how many name=value pairs the LAST init_cgi() actually
+ * parsed out of this request. A body the parser could not read at all (the
+ * Warden save posted multipart/form-data into this url-encoded parser, so
+ * do_html_post_and_get's fgets handed over nothing but the boundary line)
+ * leaves this at 0 - which is what lets the Reaper CSRF gates say "no form
+ * data" instead of blaming the token. See reaper_gate() in web.c. */
+static int cgi_nvars_parsed = 0;
+
+int
+cgi_nvars(void)
+{
+	return cgi_nvars_parsed;
+}
+
 void
 init_cgi(char *query)
 {
 	int len, nel;
 	char *q, *name, *value;
 
+	cgi_nvars_parsed = 0;
+
 	/* Clear variables */
 	if (!query) {
 		hdestroy_r(&htab);
@@ -193,6 +209,7 @@ init_cgi(char *query)
 		if (value) {
 			//printf("set_cgi: name=%s, value=%s.\n", name , value);	// N12 test
 			set_cgi(name, value);
+			cgi_nvars_parsed++;
 		}
 	}
 }
