 	{
-		char *hid = get_cgi("http_id"), *want = nvram_safe_get("http_id");
-		if (!hid || !want[0] || strcmp(hid, want) != 0 || !reaper_referer_ok()) {
-			websWrite(stream, "ERROR: invalid request token.\n");
+		int why = reaper_gate();
+		if (why != RGATE_OK) {
+			websWrite(stream, "ERROR: %s.\n", reaper_gate_msg(why));
 			return;
 		}
 	}
@@ -21844,9 +21909,9 @@ do_reaper_qdiag_cgi(char *url, FILE *stream)
 	 * the http_id CSRF token (Reaper_QoSDiag.asp now sends it) so a cross-site GET
