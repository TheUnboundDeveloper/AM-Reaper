diff --git a/release/src/router/rc/dnsfilter.c b/release/src/router/rc/dnsfilter.c
index 2d2fb3d380..8a85ab6830 100644
--- a/release/src/router/rc/dnsfilter.c
+++ b/release/src/router/rc/dnsfilter.c
@@ -163,6 +163,135 @@ int get_dns_filter(int proto, int mode, dnsf_srv_entry_t *dnsfsrv)
 }
 
 
+/* v2.8.5: AdGuard was removed from the DNS filter service list in v2.7.6, which
+ * blanked entries 19 and 20 of server_table[]/server6_table[]. Nothing broke by
+ * that alone - get_dns_filter() returns a count of non-empty servers and every
+ * caller guards on it, so a blank entry emits no DNAT rule at all and DNS keeps
+ * working (the discontinued Norton entries 2-4 have behaved exactly that way
+ * upstream for years).
+ *
+ * What DID happen is quieter: a client the user had pinned to AdGuard is now
+ * silently UNFILTERED. They believe ads are being blocked, nothing says
+ * otherwise, and because the UI no longer offers those values the dropdown
+ * shows an out-of-range selection.
+ *
+ * Rewrite the stored mode to Unfiltered - which is what the box is ALREADY
+ * doing - so the record matches reality and the UI is coherent, and say so in
+ * the log so the user can choose a replacement. Deliberately NOT substituting
+ * another provider: silently redirecting someone's DNS to a third party we
+ * picked would be a bigger surprise than telling them their filter is gone.
+ *
+ * Idempotent - once rewritten nothing matches - so it is safe at every boot and
+ * needs no "done" flag, and nvram is written only if something really changed.
+ */
+#define DNSF_SRV_GONE_ADGUARD		19
+#define DNSF_SRV_GONE_ADGUARD_FAMILY	20
+
+static int dnsf_mode_is_gone(int mode)
+{
+	return (mode == DNSF_SRV_GONE_ADGUARD || mode == DNSF_SRV_GONE_ADGUARD_FAMILY);
+}
+
+void dnsfilter_migrate_removed(void)
+{
+	char *nv, *nvp, *rule, *out;
+	size_t olen = 255 * 6 + 1, used = 0;
+	int listchg = 0, truncated = 0;
+
+	/* the network-wide default */
+	if (dnsf_mode_is_gone(nvram_get_int("dnsfilter_mode"))) {
+		nvram_set_int("dnsfilter_mode", DNSF_SRV_UNFILTERED);
+		logmessage("dnsfilter", "the network-wide DNS filter was set to a service that has since been removed - it is now Unfiltered; choose a replacement on the DNS Director page");
+	}
+
+	/* the per-client list */
+#ifdef HND_ROUTER
+	nv = nvp = malloc(olen);
+	if (nv) nvram_split_get("dnsfilter_rulelist", nv, olen, 5);
+#else
+	nv = nvp = strdup(nvram_safe_get("dnsfilter_rulelist"));
+#endif
+	if (nv == NULL)
+		return;
+
+	if ((out = malloc(olen)) == NULL) {
+		free(nv);
+		return;
+	}
+	out[0] = '\0';
+
+	/* Records are '<'-separated and the mode is the LAST '>'-delimited field,
+	 * so rewriting just that tail leaves every other field byte-identical -
+	 * safer than reparsing and rebuilding a record whose full shape we do not
+	 * own (a 4th field would survive a tail rewrite but not a rebuild). */
+	while ((rule = strsep(&nvp, "<")) != NULL) {
+		char *tail;
+		int w;
+
+		if (*rule == '\0')
+			continue;		/* the list's leading '<' */
+
+		tail = strrchr(rule, '>');
+		if (tail && dnsf_mode_is_gone(atoi(tail + 1))) {
+			char rec[192], *rname, *rmac, *rmode;
+
+			strlcpy(rec, rule, sizeof(rec));
+			if (vstrsep(rec, ">", &rname, &rmac, &rmode) == 3)
+				logmessage("dnsfilter", "client %s was set to a DNS filter service that has since been removed - it is now Unfiltered", rmac);
+			w = snprintf(out + used, olen - used, "<%.*s>%d",
+				     (int)(tail - rule), rule, DNSF_SRV_UNFILTERED);
+			listchg++;
+		} else {
+			w = snprintf(out + used, olen - used, "<%s", rule);
+		}
+
+		/* snprintf reports what it WOULD have written; a short buffer here
+		 * would silently drop clients' settings, so bail and keep the
+		 * original rather than store a truncated list. */
+		if (w < 0 || (size_t)w >= olen - used) {
+			truncated = 1;
+			break;
+		}
+		used += w;
+	}
+
+	if (truncated) {
+		logmessage("dnsfilter", "dnsfilter_rulelist did not fit while migrating removed filter services - left unchanged");
+	} else if (listchg) {
+#ifdef HND_ROUTER
+		nvram_split_set("dnsfilter_rulelist", out, 255, 5);
+#else
+		nvram_set("dnsfilter_rulelist", out);
+#endif
+		nvram_commit();
+	}
+
+	free(out);
+	free(nv);
+
+#ifdef RTCONFIG_MULTILAN_CFG
+	/* An SDN profile can carry its own filter index too. That lives inside the
+	 * dense positional sdn_rl record, where a mis-placed field would corrupt a
+	 * whole profile, so report it and let the user re-pick rather than rewrite
+	 * it here. Same end state as above: the profile is already unfiltered. */
+	{
+		MTLAN_T *pmtl;
+		size_t mtl_sz = 0, i;
+
+		if ((pmtl = (MTLAN_T *)INIT_MTLAN(sizeof(MTLAN_T))) != NULL) {
+			if (get_mtlan(pmtl, &mtl_sz)) {
+				for (i = 1; i < mtl_sz; ++i) {
+					if (pmtl[i].enable && dnsf_mode_is_gone(pmtl[i].sdn_t.dnsf_idx))
+						logmessage("dnsfilter", "SDN network %d uses a DNS filter service that has since been removed - it is unfiltered; choose a replacement in that network's settings",
+							   pmtl[i].sdn_t.sdn_idx);
+				}
+			}
+			FREE_MTLAN((void *)pmtl);
+		}
+	}
+#endif
+}
+
 void dnsfilter_settings(FILE *fp) {
 	char *name, *mac, *mode;
 	unsigned char ea[ETHER_ADDR_LEN];
