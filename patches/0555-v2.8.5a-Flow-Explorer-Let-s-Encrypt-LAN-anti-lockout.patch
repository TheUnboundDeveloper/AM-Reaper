+	  "    case $_o in 255) _plen=$((_plen+8));; 254) _plen=$((_plen+7));; 252) _plen=$((_plen+6));;\n"
+	  "      248) _plen=$((_plen+5));; 240) _plen=$((_plen+4));; 224) _plen=$((_plen+3));;\n"
+	  "      192) _plen=$((_plen+2));; 128) _plen=$((_plen+1));; 0) ;; *) _plen=-1;; esac\n"
