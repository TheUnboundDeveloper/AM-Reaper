diff --git a/release/src/router/httpd/reaper_inject.c b/release/src/router/httpd/reaper_inject.c
index 0ecbc91982..df20c02ef3 100644
--- a/release/src/router/httpd/reaper_inject.c
+++ b/release/src/router/httpd/reaper_inject.c
@@ -145,6 +145,39 @@
 	"msg(1,t(\"rbk_s_reboot\"));};" \
 	"p.send(fd);};" \
 	"rd.readAsText(f.slice(0,2048));};}" \
+	"var cx=document.getElementById(\"rbk_cx\");" \
+	"if(cx)cx.onclick=function(){" \
+	"var g=new XMLHttpRequest();" \
+	"g.open(\"GET\",\"/reaper_cfg.cgi?action=export&http_id=\"+encodeURIComponent(hid)+\"&_=\"+Date.now(),true);" \
+	"g.onloadend=function(){" \
+	"var j=null;try{j=JSON.parse(g.responseText);}catch(e){}" \
+	"if(!j||!j.ok){msg(0,t(\"rbk_s_cfail\"));return;}" \
+	"var name=\"reaper-settings-\"+String(j.model||\"router\").replace(/[^A-Za-z0-9_-]/g,\"\")+\"-\"+String(j.version||\"\").replace(/[^A-Za-z0-9_.-]/g,\"\")+\"-\"+new Date().toISOString().slice(0,10)+\".json\";" \
+	"var blob=new Blob([JSON.stringify(j,null,1)],{type:\"application/json\"});" \
+	"var a=document.createElement(\"a\");a.href=URL.createObjectURL(blob);a.download=name;" \
+	"document.body.appendChild(a);a.click();" \
+	"setTimeout(function(){URL.revokeObjectURL(a.href);a.remove();},2000);" \
+	"msg(1,t(\"rbk_s_saved\")+\" \"+name);};" \
+	"g.send();};" \
+	"var ci=document.getElementById(\"rbk_ci\"),cf=document.getElementById(\"rbk_cfile\");" \
+	"if(ci&&cf){ci.onclick=function(){cf.click();};" \
+	"cf.onchange=function(){" \
+	"var f=cf.files&&cf.files[0];if(!f)return;" \
+	"if(f.size>60000){msg(0,t(\"rbk_s_cbad\"));cf.value=\"\";return;}" \
+	"var rd=new FileReader();" \
+	"rd.onload=function(){" \
+	"var j=null;try{j=JSON.parse(String(rd.result||\"\"));}catch(e){}" \
+	"if(!j||!j.reaper_cfg){msg(0,t(\"rbk_s_cbad\"));cf.value=\"\";return;}" \
+	"if(!confirm(t(\"rbk_s_cconfirm\"))){cf.value=\"\";return;}" \
+	"var p2=new XMLHttpRequest();p2.open(\"POST\",\"/reaper_cfg.cgi\",true);" \
+	"p2.setRequestHeader(\"Content-Type\",\"application/x-www-form-urlencoded\");" \
+	"p2.onloadend=function(){" \
+	"var r=null;try{r=JSON.parse(p2.responseText);}catch(e){}" \
+	"cf.value=\"\";" \
+	"if(!r||!r.ok){msg(0,t(\"rbk_s_cfail\"));return;}" \
+	"msg(1,t(\"rbk_s_cdone\").replace(\"%1\",r.flags).replace(\"%2\",r.lists).replace(\"%3\",r.rejected));};" \
+	"p2.send(\"action=import&http_id=\"+encodeURIComponent(hid)+\"&cfg=\"+encodeURIComponent(JSON.stringify(j)));};" \
+	"rd.readAsText(f);};}" \
 	"var x2=new XMLHttpRequest();" \
 	"x2.open(\"GET\",\"/reaper_cfg.cgi?action=pending&http_id=\"+encodeURIComponent(hid)+\"&_=\"+Date.now(),true);" \
 	"x2.onload=function(){var j=null;try{j=JSON.parse(x2.responseText);}catch(e){}" \
