diff --git a/release/src/router/rc/amaspark.c b/release/src/router/rc/amaspark.c
index 8fc5b314c7a..6bb7052140d 100644
--- a/release/src/router/rc/amaspark.c
+++ b/release/src/router/rc/amaspark.c
@@ -28,6 +28,13 @@
  *           and, as a backstop, if cfg_obstatus sticks non-idle for 20 min.
  *   Only what THIS daemon parked is ever released: a radio the operator or a
  *   schedule turned off is left alone, and a radio with wlN_radio=0 is skipped.
+ *   FIELD 2026-09-04 (owner's BE96U, mld_enable=1): the three primaries form
+ *   the backhaul MLO link set, so parking wl0 took wl1 AND wl2 down with it,
+ *   and a release that raised only wl0 left the other two down. The daemon
+ *   therefore snapshots every primary before it parks, claims any that dropped
+ *   alongside (6 GHz included - that is the driver's doing, not ours, and the
+ *   6 GHz client network stayed up with its clients throughout), logs each as
+ *   a linked drop, and raises the whole set on release.
  *   Every park and release is one syslog line naming the interface, the band
  *   and the reason. A wireless restart brings the primaries back up by itself;
  *   the next tick (5 s) parks them again, which is why this is a daemon and
@@ -123,7 +130,7 @@ int amaspark_main(int argc, char *argv[])
 {
 	char parked[AP_MAXU] = { 0 };
 	char ifn[AP_MAXU][IFNAMSIZ];
-	int nband[AP_MAXU];
+	int nband[AP_MAXU], before[AP_MAXU], radio[AP_MAXU];
 	int last_enabled = -1, last_window = 0, ob_capped = 0;
 	long ob_start = 0;
 	(void)argc; (void)argv;
@@ -135,6 +142,8 @@ int amaspark_main(int argc, char *argv[])
 
 	memset(ifn, 0, sizeof(ifn));
 	memset(nband, 0, sizeof(nband));
+	memset(before, 0, sizeof(before));
+	memset(radio, 0, sizeof(radio));
 
 	/* adopt what a previous instance left parked (restart_amaspark, or it
 	 * died): those carriers are ours to release when the rules say so */
@@ -203,32 +212,49 @@ int amaspark_main(int argc, char *argv[])
 		}
 		last_window = window;
 
+		/* the radios, and where every primary stands before we touch anything */
 		for (u = 0; u < AP_MAXU; u++) {
 			char key[24], *v;
-			int st, radio;
 			snprintf(key, sizeof(key), "wl%d_ifname", u);
 			v = nvram_safe_get(key);
-			if (!*v) { ifn[u][0] = 0; continue; }
+			if (!*v) { ifn[u][0] = 0; before[u] = -1; continue; }
 			strlcpy(ifn[u], v, sizeof(ifn[u]));
 			snprintf(key, sizeof(key), "wl%d_nband", u);
 			nband[u] = nvram_get_int(key);
-			if (nband[u] == 4) continue;		/* 6 GHz: never */
 			snprintf(key, sizeof(key), "wl%d_radio", u);
 			v = nvram_safe_get(key);
-			radio = *v ? atoi(v) : 1;
-			if (!radio) { if (parked[u]) { parked[u] = 0; changed = 1; } continue; }
+			radio[u] = *v ? atoi(v) : 1;
+			before[u] = radio[u] ? bss_state(ifn[u]) : -1;
+			if (!radio[u] && parked[u]) { parked[u] = 0; changed = 1; }
+		}
 
-			if (want) {
-				if (parked[u]) continue;
-				st = bss_state(ifn[u]);
-				if (st != 1) continue;	/* down already (not ours) or unknown */
+		if (want) {
+			int acted = 0;
+			for (u = 0; u < AP_MAXU; u++) {
+				if (!ifn[u][0] || !radio[u] || parked[u]) continue;
+				if (nband[u] == 4) continue;		/* 6 GHz: never by our hand */
+				if (before[u] != 1) continue;		/* down already (not ours) or unknown */
 				bss_set(ifn[u], 0);
 				parked[u] = 1;
-				changed = 1;
+				changed = acted = 1;
 				logmessage(AP_TAG, "parked %s (%s backhaul carrier): %s", ifn[u], band_name(nband[u]), why_park);
-			} else if (parked[u]) {
-				st = bss_state(ifn[u]);
-				if (st == 0) bss_set(ifn[u], 1);
+			}
+			/* MLO: the link set went down together. Claim what dropped with us so
+			 * the release raises all of it, and say so - silence here is what
+			 * left two carriers down in the field. */
+			if (acted) {
+				for (u = 0; u < AP_MAXU; u++) {
+					if (!ifn[u][0] || !radio[u] || parked[u] || before[u] != 1) continue;
+					if (bss_state(ifn[u]) != 0) continue;
+					parked[u] = 1;
+					changed = 1;
+					logmessage(AP_TAG, "%s (%s backhaul carrier) went down with the parked link - the carriers form one MLO link set; it will be raised with the rest", ifn[u], band_name(nband[u]));
+				}
+			}
+		} else {
+			for (u = 0; u < AP_MAXU; u++) {
+				if (!parked[u]) continue;
+				if (ifn[u][0] && radio[u] && bss_state(ifn[u]) == 0) bss_set(ifn[u], 1);
 				parked[u] = 0;
 				changed = 1;
 				logmessage(AP_TAG, "released %s (%s backhaul carrier): %s", ifn[u], band_name(nband[u]), why_rel);
