diff --git a/release/src/router/rc/reaper_fw.c b/release/src/router/rc/reaper_fw.c
index 212b0cae95..2643fec699 100644
--- a/release/src/router/rc/reaper_fw.c
+++ b/release/src/router/rc/reaper_fw.c
@@ -80,6 +80,12 @@
  *   zpol:  <srczone>dstzone>action              action = accept|drop|reject
  *   rule:  <en>dir>action>szone>sobj>dzone>dobj>svc>sched>rate>log>order>comment
  *          en=0|1  dir=in|out|fwd  action=accept|drop|reject|log
+ *   nat:   <en>proto>eport>iip>iport>sobj>log>sched>mode>szone>exempt>snat
+ *          mode=forward|intercept|redirect   snat=auto|on|off
+ *          Fields 8-11 are APPEND-ONLY and optional: a record written before
+ *          Service Intercept existed has no field 8, rfw_field() returns false
+ *          and it defaults to mode=forward, which is exactly its old meaning.
+ *          Never renumber or reuse 0-7.
  */
 #include <stdio.h>
 #include <stdlib.h>
@@ -163,6 +169,15 @@
  * forwards. It is a SEPARATE table, so S4 ("we touch only what we own") needs
  * the teardown to cover nat as well - the filter-table sweep would not. */
 #define RFW_CHAIN_NAT  "REAPER_FWN"
+/* Service Intercept (2026-08-29): the return path for a hairpin intercept. When
+ * a client's traffic is DNAT'd to a server that sits on the SAME segment the
+ * client is on, the server answers the client DIRECTLY from its own address and
+ * the client discards the reply - it was expecting the address it originally
+ * addressed. Masquerading the translated packet forces the answer back through
+ * the router, which then un-does both translations. Lives in nat POSTROUTING,
+ * so it needs its own chain, its own hook and its own teardown; the PREROUTING
+ * sweep below cannot reach it and a stray MASQUERADE would survive a rollback. */
+#define RFW_CHAIN_MASQ "REAPER_FWM"
 
 #define RFW_MAX_EDEF        64    /* per-device egress defaults (Phase 2) */
 #define RFW_MAX_NAT         64    /* hardened forwards (Phase 3) */
@@ -1593,6 +1608,12 @@ static void rfw_emit_nat(FILE *f, const rfw_cfg_t *c)
 		rfw_setname_t sets[RFW_MAX_SETS];
 		int ns = 0, pv;
 		const char *protos[2]; int nproto = 1;
+		/* Service Intercept additions */
+		char mode[12], szone[RFW_NAME_MAX + 2], exempt[RFW_NAME_MAX + 2], snat[8];
+		char ifs[RFW_MAX_IFACE][IFNAMSIZ + 2];
+		char exfrag[512] = "", selffrag[160] = "";
+		rfw_setname_t exsets[RFW_MAX_SETS];
+		int nif = 0, nex = 0, ifi, fwdmode, redir;
 
 		if (++n > RFW_MAX_NAT) {
 			logmessage("reaper_fw", "more than %d forwards - the rest are IGNORED", RFW_MAX_NAT);
@@ -1615,9 +1636,32 @@ static void rfw_emit_nat(FILE *f, const rfw_cfg_t *c)
 		 * record - loads cleanly, leaving an unconditional WAN-inbound ACCEPT
 		 * above the zone default-policy matrix. The two are only "emitted
 		 * together" at generation time, not at load time. */
-		if (!rfw_field(tok, 3, iip, sizeof(iip)) || !rfw_valid_ip(iip) ||
-		    strchr(iip, '/') || strchr(iip, ':')) {
-			logmessage("reaper_fw", "forward: internal IP must be a single IPv4 host - DROPPED");
+		/* mode first: it decides whether iip is required or forbidden. An absent
+		 * field 8 is a pre-Service-Intercept record and means "forward". An
+		 * unknown value is a record from a NEWER build than this firmware: drop
+		 * it rather than falling back to "forward", which would silently emit a
+		 * WAN-inbound DNAT nobody asked for. Fail closed. */
+		if (!rfw_field(tok, 8, mode, sizeof(mode)) || !*mode)
+			strlcpy(mode, "forward", sizeof(mode));
+		if (strcmp(mode, "forward") && strcmp(mode, "intercept") && strcmp(mode, "redirect")) {
+			logmessage("reaper_fw", "nat: unknown mode '%s' - DROPPED", mode);
+			continue;
+		}
+		fwdmode = !strcmp(mode, "forward");
+		redir   = !strcmp(mode, "redirect");
+
+		if (redir) {
+			/* REDIRECT goes to the router itself and takes no destination
+			 * address; a target here would be silently ignored, so refuse it
+			 * rather than let the record read as something it is not. */
+			if (rfw_field(tok, 3, iip, sizeof(iip)) && *iip) {
+				logmessage("reaper_fw", "redirect %s: must not carry a target IP - DROPPED", eport);
+				continue;
+			}
+			iip[0] = 0;
+		} else if (!rfw_field(tok, 3, iip, sizeof(iip)) || !rfw_valid_ip(iip) ||
+		           strchr(iip, '/') || strchr(iip, ':')) {
+			logmessage("reaper_fw", "%s: internal IP must be a single IPv4 host - DROPPED", mode);
 			continue;
 		}
 		if (!rfw_field(tok, 4, iport, sizeof(iport)) || !rfw_valid_ports(iport)) { logmessage("reaper_fw", "forward: invalid internal port - DROPPED"); continue; }
@@ -1631,9 +1675,65 @@ static void rfw_emit_nat(FILE *f, const rfw_cfg_t *c)
 		/* an internal port must be a single port or a contiguous range - DNAT
 		 * cannot map a comma list (or an empty value) to a target */
 		if (!*iport || strchr(iport, ',')) {
-			logmessage("reaper_fw", "forward %s: internal port must be a single port or range - DROPPED", eport);
+			logmessage("reaper_fw", "%s %s: internal port must be a single port or range - DROPPED", mode, eport);
 			continue;
 		}
+
+		if (!rfw_field(tok,  9, szone,  sizeof(szone)))  szone[0]  = 0;
+		if (!rfw_field(tok, 10, exempt, sizeof(exempt))) exempt[0] = 0;
+		if (!rfw_field(tok, 11, snat,   sizeof(snat)))   snat[0]   = 0;
+		if (!*snat) strlcpy(snat, "auto", sizeof(snat));
+		if (strcmp(snat, "auto") && strcmp(snat, "on") && strcmp(snat, "off")) {
+			logmessage("reaper_fw", "%s %s: unknown return-path mode '%s' - DROPPED", mode, eport, snat);
+			continue;
+		}
+
+		/* Which interfaces does this record match on? A classic forward is
+		 * WAN-inbound and resolves its interface at apply time from $WANIF; an
+		 * intercept/redirect names a source zone, and a zone that resolves to
+		 * nothing would otherwise emit an UNBOUND rule matching every interface
+		 * on the router - including the WAN. Fail closed. */
+		if (!fwdmode) {
+			if (!*szone) {
+				logmessage("reaper_fw", "%s %s: a source zone is required - DROPPED", mode, eport);
+				continue;
+			}
+			nif = rfw_zone_ifaces(c, szone, ifs, RFW_MAX_IFACE);
+			if (!nif) {
+				logmessage("reaper_fw", "%s %s: source zone %s resolved to no interface - DROPPED",
+				           mode, eport, szone);
+				continue;
+			}
+		}
+
+		/* Exemptions. Two of them, and both matter:
+		 *  - the user's optional object/group. An exemption that does not
+		 *    resolve is dropped WITH the record: applying an intercept without
+		 *    the exemption it was designed around is worse than not applying it.
+		 *  - the target itself, always, automatically. Without this the server's
+		 *    OWN upstream query is intercepted straight back to itself, so it can
+		 *    never reach the outside and the fallback the whole arrangement
+		 *    exists for is dead. The user cannot be asked to remember this.
+		 * The router needs no exemption: PREROUTING never sees locally
+		 * generated traffic, which is also why its own service keeps working. */
+		exfrag[0] = selffrag[0] = 0;
+		if (*exempt) {
+			int xi;
+			nex = rfw_resolve(c, exempt, 0, exsets, RFW_MAX_SETS);
+			if (!nex) {
+				logmessage("reaper_fw", "%s %s: exemption %s did not resolve - DROPPED",
+				           mode, eport, exempt);
+				continue;
+			}
+			for (xi = 0; xi < nex; xi++) {
+				char one[128];	/* set name is 40 - leave no room to truncate */
+				snprintf(one, sizeof(one), " -m set ! --match-set %s src", exsets[xi].name);
+				if (strlen(exfrag) + strlen(one) >= sizeof(exfrag)) break;
+				strlcat(exfrag, one, sizeof(exfrag));
+			}
+		}
+		if (!fwdmode && !redir && *iip)
+			snprintf(selffrag, sizeof(selffrag), " ! -s %s ! -d %s", iip, iip);
 		/* DNAT --to-destination wants a HYPHEN between the low and high port of a
 		 * range (ip:lo-hi), whereas iptables --dport takes the COLON form (lo:hi).
 		 * iport arrives colon-separated and comma-free (checked just above), so
@@ -1665,26 +1765,69 @@ static void rfw_emit_nat(FILE *f, const rfw_cfg_t *c)
 
 		for (pv = 0; pv < nproto; pv++) {
 			int si, lim = ns ? ns : 1;
-			for (si = 0; si < lim; si++) {
-				srcfrag[0] = 0;
-				if (ns)
-					snprintf(srcfrag, sizeof(srcfrag), " -m set --match-set %s src", sets[si].name);
-
-				if (logf[0] == '1')
-					fprintf(f, "[ -n \"$WANIF\" ] && RFWR iptables -t nat -A " RFW_CHAIN_NAT
-					           " -i \"$WANIF\" -p %s --dport %s%s%s"
-					           " -j LOG --log-prefix \"REAPER-FWD \" --log-level 6\n",
-					        protos[pv], eport, srcfrag, schedfrag);
-
-				fprintf(f, "[ -n \"$WANIF\" ] && RFWR iptables -t nat -A " RFW_CHAIN_NAT
-				           " -i \"$WANIF\" -p %s --dport %s%s%s"
-				           " -j DNAT --to-destination %s:%s\n",
-				        protos[pv], eport, srcfrag, schedfrag, iip, toport);
-
-				/* the companion filter ACCEPT - see the header comment */
-				fprintf(f, "[ -n \"$WANIF\" ] && RFWR iptables -A " RFW_CHAIN_FWD
-				           " -i \"$WANIF\" -p %s -d %s --dport %s%s%s -j ACCEPT\n",
-				        protos[pv], iip, iport, srcfrag, schedfrag);
+			/* one pass per matching interface: the WAN for a forward (resolved
+			 * at apply time, hence the guard), each source-zone interface for an
+			 * intercept or redirect. */
+			for (ifi = 0; ifi < (fwdmode ? 1 : nif); ifi++) {
+				const char *guard = fwdmode ? "[ -n \"$WANIF\" ] && " : "";
+				const char *ifx   = fwdmode ? "\"$WANIF\"" : ifs[ifi];
+
+				for (si = 0; si < lim; si++) {
+					srcfrag[0] = 0;
+					if (ns)
+						snprintf(srcfrag, sizeof(srcfrag), " -m set --match-set %s src", sets[si].name);
+
+					if (logf[0] == '1')
+						fprintf(f, "%sRFWR iptables -t nat -A " RFW_CHAIN_NAT
+						           " -i %s -p %s --dport %s%s%s%s%s"
+						           " -j LOG --log-prefix \"REAPER-%s \" --log-level 6\n",
+						        guard, ifx, protos[pv], eport, selffrag, exfrag, srcfrag, schedfrag,
+						        fwdmode ? "FWD" : "ICPT");
+
+					if (redir)
+						fprintf(f, "%sRFWR iptables -t nat -A " RFW_CHAIN_NAT
+						           " -i %s -p %s --dport %s%s%s%s"
+						           " -j REDIRECT --to-ports %s\n",
+						        guard, ifx, protos[pv], eport, exfrag, srcfrag, schedfrag, toport);
+					else
+						fprintf(f, "%sRFWR iptables -t nat -A " RFW_CHAIN_NAT
+						           " -i %s -p %s --dport %s%s%s%s%s"
+						           " -j DNAT --to-destination %s:%s\n",
+						        guard, ifx, protos[pv], eport, selffrag, exfrag, srcfrag, schedfrag,
+						        iip, toport);
+
+					/* The companion filter ACCEPT, keyed on the TRANSLATED
+					 * destination - see the header comment. A redirect lands on
+					 * the router itself (INPUT), not through FORWARD, so it gets
+					 * none: Reaper's chains RETURN rather than deny, so it works
+					 * unless the operator has written an explicit INPUT drop for
+					 * the service, which is documented on the page. */
+					if (!redir)
+						fprintf(f, "%sRFWR iptables -A " RFW_CHAIN_FWD
+						           " -i %s -p %s -d %s --dport %s%s%s -j ACCEPT\n",
+						        guard, ifx, protos[pv], iip, iport, srcfrag, schedfrag);
+				}
+
+				/* Return path for a hairpin intercept. `auto` asks the LIVE
+				 * routing table whether the translated packet would leave by the
+				 * interface it arrived on; only then is the reply going to reach
+				 * the client directly and be discarded. Same-segment is the
+				 * common case and the one that silently fails without this;
+				 * a target on another VLAN routes back through us already and
+				 * must NOT be masqueraded, or the server loses the client's
+				 * address for nothing. */
+				if (!fwdmode && !redir && strcmp(snat, "off")) {
+					if (!strcmp(snat, "on"))
+						fprintf(f, "RFWR iptables -t nat -A " RFW_CHAIN_MASQ
+						           " -o %s -p %s -d %s --dport %s -j MASQUERADE\n",
+						        ifs[ifi], protos[pv], iip, toport);
+					else
+						fprintf(f,
+						  "RFW_HP=$(ip route get %s 2>/dev/null | sed -n 's/.* dev \\([^ ]*\\).*/\\1/p' | head -1)\n"
+						  "[ \"$RFW_HP\" = \"%s\" ] && RFWR iptables -t nat -A " RFW_CHAIN_MASQ
+						  " -o %s -p %s -d %s --dport %s -j MASQUERADE\n",
+						  iip, ifs[ifi], ifs[ifi], protos[pv], iip, toport);
+				}
 			}
 		}
 	}
@@ -1827,7 +1970,14 @@ static int rfw_gen_apply(const char *path, const rfw_cfg_t *c, int teardown_only
 	   * engine was disabled or rolled back. v4 only, matching the emitter. */
 	  "while iptables -t nat -D PREROUTING -j " RFW_CHAIN_NAT " 2>/dev/null; do :; done\n"
 	  "iptables -t nat -F " RFW_CHAIN_NAT " 2>/dev/null\n"
-	  "iptables -t nat -X " RFW_CHAIN_NAT " 2>/dev/null\n");
+	  "iptables -t nat -X " RFW_CHAIN_NAT " 2>/dev/null\n"
+	  /* and the intercept return path, in POSTROUTING. This runs on the
+	   * teardown AND rollback paths: a MASQUERADE left behind after an
+	   * auto-revert would keep rewriting the source address of traffic to a
+	   * server whose intercept no longer exists. */
+	  "while iptables -t nat -D POSTROUTING -j " RFW_CHAIN_MASQ " 2>/dev/null; do :; done\n"
+	  "iptables -t nat -F " RFW_CHAIN_MASQ " 2>/dev/null\n"
+	  "iptables -t nat -X " RFW_CHAIN_MASQ " 2>/dev/null\n");
 
 	if (teardown_only || !c->enable || strcmp(c->enable, "1") != 0) {
 		/* disabled: teardown only. Leaves the base firewall untouched (S4). */
@@ -1898,7 +2048,9 @@ static int rfw_gen_apply(const char *path, const rfw_cfg_t *c, int teardown_only
 	 * explicit about the ordering rather than relying on it. */
 	if (c->nat && *c->nat)
 		fprintf(f, "iptables -t nat -N " RFW_CHAIN_NAT " 2>/dev/null; "
-		           "RFWH iptables -t nat -F " RFW_CHAIN_NAT "\n\n");
+		           "RFWH iptables -t nat -F " RFW_CHAIN_NAT "\n"
+		           "iptables -t nat -N " RFW_CHAIN_MASQ " 2>/dev/null; "
+		           "RFWH iptables -t nat -F " RFW_CHAIN_MASQ "\n\n");
 
 	for (d = RFW_D_IN; d <= RFW_D_OUT; d++) {
 		int v6;
@@ -1929,7 +2081,12 @@ static int rfw_gen_apply(const char *path, const rfw_cfg_t *c, int teardown_only
 	/* Phase 3: hook the nat chain only after it is fully populated, so a
 	 * PREROUTING jump never exists while the chain is half-built. */
 	if (c->nat && *c->nat)
-		fprintf(f, "RFWH iptables -t nat -I PREROUTING -j " RFW_CHAIN_NAT "\n\n");
+		fprintf(f, "RFWH iptables -t nat -I PREROUTING -j " RFW_CHAIN_NAT "\n"
+		           /* POSTROUTING is APPENDED, not inserted: the return-path
+		            * MASQUERADE must run after the stock WAN masquerade has had
+		            * its say, and it only matches traffic already aimed at an
+		            * intercept target, so it cannot shadow anything. */
+		           "RFWH iptables -t nat -A POSTROUTING -j " RFW_CHAIN_MASQ "\n\n");
 
 	/* ---- sweep sets belonging to objects that no longer exist ----
 	 * after the chains are rebuilt, so nothing still in use is destroyed. */
diff --git a/release/src/router/www/BR.dict b/release/src/router/www/BR.dict
index 2201029280..22158824d6 100644
--- a/release/src/router/www/BR.dict
+++ b/release/src/router/www/BR.dict
@@ -6748,3 +6748,18 @@ RBKP_15=Backup e restauração
 RBKP_16=Duas ferramentas para dois trabalhos. O backup completo é o arquivo a guardar antes de um reset de fábrica, um reflash ou uma troca de hardware: ele captura este roteador por completo, restaura apenas no mesmo modelo e reinicia uma vez. O arquivo de configurações é pequeno e portátil: carrega apenas a configuração dos recursos do Reaper, transita entre roteadores e versões de firmware e nunca reinicia.
 RBKP_17=Tudo - configurações do roteador + dados do Reaper
 RBKP_18=Apenas recursos do Reaper - sem reinício
+RFW_258=Service Intercept
+RFW_259=Send a service to a server of your choosing, wherever the device thought it was sending it. Useful for devices that ignore what DHCP tells them and have a public server hard-coded - the classic case is time (NTP). Traffic the router itself sends is never intercepted, so the router keeps its own fallback.
+RFW_260=Mode
+RFW_261=Send to a server
