From 16e0a91ab3d8adb032c3dc86c80713b93c8b8f9f Mon Sep 17 00:00:00 2001
From: reaper <theunbounddeveloper@outlook.com>
Date: Sat, 29 Aug 2026 00:32:50 -0400
Subject: [PATCH] version: open the v2.8.9 rung

Five changes sit on top of the v2.8.8 cut and a v2.8.8 MCP test image is already
flashed, so building at that stamp would produce a second, different image with
an identical filename. Bump so the test image is identifiable:

  e2fa471b5c  fqdn sets no longer poisoned with the DNS server address
  0de6654f42  shell WAN poll survives a failed request
  2f539292ed  rtrafd cadence thresholds stated in seconds
  1a253475ac  stubby/DoT crash-restart restored
  735864f65b  Service Intercept

Co-Authored-By: Claude Opus 5 (1M context) <noreply@anthropic.com>
---
 release/src-rt/version.conf | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/release/src-rt/version.conf b/release/src-rt/version.conf
index 41de0e0e09..1d8705465c 100644
--- a/release/src-rt/version.conf
+++ b/release/src-rt/version.conf
@@ -4,6 +4,6 @@ KERNEL_VER_AM=$(subst .,,$(KERNEL_VER))
 FS_VER_AM=$(subst .,,$(FS_VER))
 
 SERIALNO=102.8
-EXTENDNO=Reaper_v2.8.8
+EXTENDNO=Reaper_v2.8.9
 
 RCNO=0
-- 
2.25.1

