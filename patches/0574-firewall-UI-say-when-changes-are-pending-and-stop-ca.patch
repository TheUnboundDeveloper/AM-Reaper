diff --git a/release/src/router/httpd/web.c b/release/src/router/httpd/web.c
index db8c2d9c0c..72749429c2 100644
--- a/release/src/router/httpd/web.c
+++ b/release/src/router/httpd/web.c
@@ -24009,6 +24009,26 @@ do_reaper_fw_cgi(char *url, FILE *stream)
 			nvram_get_int("reaper_fw_confirm"),
 			nvram_match("reaper_fw_armed", "1") ? 1 : 0,
 			left);
+		/* `dirty` = at least one list is STAGED but not yet committed. The draft
+		 * file's existence IS the signal: reaper_fw_list_get() resolves
+		 * draft > lastgood > legacy nvram, and the confirm path deletes the
+		 * whole draft dir once it has been consumed into lastgood
+		 * (rc/reaper_fw.c "v2.6.9: consumed into lastgood"), so a leftover file
+		 * can only mean unapplied or unconfirmed work.
+		 * Added 2026-08-29: every tab except Rules saves to the draft with no
+		 * apply control of its own, and nothing told the operator their edit was
+		 * inactive or where Apply lived. Reported from the field as "do Zones and
+		 * Forwards apply automatically? I don't see an apply button." */
+		{
+			static const char *dkeys[] = { "obj","grp","svc","zone","zpol","rules","edef","nat" };
+			char dp[128];
+			int di, dirty = 0;
+			for (di = 0; di < (int)(sizeof(dkeys)/sizeof(dkeys[0])); di++) {
+				snprintf(dp, sizeof(dp), REAPER_FW_DRAFT_DIR "/%s", dkeys[di]);
+				if (f_exists(dp)) { dirty = 1; break; }
+			}
+			websWrite(stream, ",\"dirty\":%d", dirty);
+		}
 		websWrite(stream, ",\"warden\":%d,\"wgeo\":",
 			nvram_match("rwarden_enable", "1") ? 1 : 0);
 		gk_json_esc(stream, nvram_safe_get("rwarden_geo"));
diff --git a/release/src/router/www/BR.dict b/release/src/router/www/BR.dict
index 22158824d6..b41cad7e3c 100644
--- a/release/src/router/www/BR.dict
+++ b/release/src/router/www/BR.dict
@@ -6763,3 +6763,6 @@ RFW_269=Auto
 RFW_270=Always
 RFW_271=Never
 RFW_272=The server you send traffic to is always exempt from its own rule, so it can still reach the outside - that is what keeps a fallback working. Add an Exempt object for anything else that should be left alone. Return path: leave it on Auto. Auto adds address translation only when the server sits on the same network as the clients, which is the case where a reply would otherwise never reach them. Always adds it everywhere, which hides the client's address from your server; Never omits it.
+RFW_273=Your changes are saved but NOT in effect yet. Firewall edits on every tab are held as a draft until you apply them together, on the Rules tab.
+RFW_274=A change has been applied and is waiting for you to keep it. If you do nothing it reverts on its own.
+RFW_275=Go to Rules
