-/* ===================================================================
- * reaper 2026-08-11: SERVER-SIDE first-boot / factory-reset gate.
- *
- * Until this build, first-boot enforcement was entirely client-side: state.js
- * redirects plus per-page <head> guards. That leaks badly - only 128 of the 245
- * .asp pages carry a state.js <script src> at all, so typing the URL of any of
- * the other 117 walked straight past the wizard. Worse, the credential step ended
- * by sending the browser to Main_ReaperDash.asp, which deliberately does NOT load
- * state.js (it carries its own credential guard instead) - so the Wi-Fi step that
- * state.js is supposed to force was simply never reached. That is why a box could
- * come up on a factory Wi-Fi password with the admin credentials already changed,
- * and why this kept being reported as "still not working".
- *
- * Enforcement therefore moves to where it cannot be routed around. The GUI is a
- * static page set - the only chokepoint that sees every request is httpd itself.
- *
- * SAFETY (this gate can lock a user out of their own router if it misfires):
- *   - it only ever fires while the box is genuinely unconfigured, from LIVE state
- *     (default admin password, operator-forced change, or wireless never set up);
- *     an upgraded box that is already configured never sees it;
- *   - it applies ONLY to .asp/.htm page loads - never to CGIs, assets, or the
- *     polling endpoints, so the wizard, login and AiMesh onboarding keep working;
- *   - `reaper_fbdone=1` is an unconditional escape hatch: an operator who somehow
- *     gets stuck can clear the gate over SSH with
- *       nvram set reaper_fbdone=1 && nvram commit
- *     It is deliberately NOT written by the wizard - the gate opens on its own when
- *     the live conditions clear, so there is no new write path to get wrong. */
-static int
-reaper_firstboot_pending(void)
-{
-	const char *ri = nvram_get("reaper_inject");
-
-	/* Reaper UI killed -> stock owns first boot; do not interfere. */
-	if (ri && *ri && atoi(ri) == 0)
-		return 0;
-	/* operator escape hatch */
-	if (nvram_match("reaper_fbdone", "1"))
-		return 0;
-	if (!check_if_file_exist("/www/Reaper_FirstBoot.asp"))
-		return 0;
-	if (nvram_get_int("force_chgpass"))
-		return 1;
-	if (is_passwd_default())
-		return 1;
-	/* Wireless never configured. w_Setting is stock's own "wireless has been set up"
-	 * flag - factory default 0 (restored to stock by the AiMesh-node fix), auto-set
-	 * to 1 by the stock wireless apply. Using stock's flag rather than a Reaper one
-	 * means the gate opens through the PROVEN apply path: this box is MULTILAN_MWL,
-	 * where the main Wi-Fi is SDN-driven, so a hand-rolled PSK write would be exactly
-	 * the kind of change that silently does not stick.
-	 *
-	 * Router and AP modes only (sw_mode 1 / 3), mirroring state.js's own wireless
-	 * gate. A repeater or media bridge does not run its own wireless config, so
-	 * w_Setting legitimately stays 0 there - gating on it would wedge those boxes out
-	 * of their GUI permanently, which is exactly the failure this must not cause. */
-	{
-		int sw = nvram_get_int("sw_mode");
-		if ((sw == 1 || sw == 3) && nvram_match("w_Setting", "0"))
-			return 1;
-	}
-	return 0;
-}
-
-/* Pages that must stay reachable while the gate is closed. Substring match: the
- * wizard itself, the login/logout surfaces it bounces through, device discovery,
- * the stock wireless page (the wizard FRAMES it for its Wi-Fi step, so it must
- * load), and the QIS/onboarding pages AiMesh runs framed. */
-static int
