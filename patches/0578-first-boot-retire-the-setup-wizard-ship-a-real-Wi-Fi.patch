new file mode 100644
index 0000000000..b53476b7da
--- /dev/null
+++ b/release/src/router/www/Reaper_SecBanner.asp
@@ -0,0 +1,46 @@
+<!--
+	Reaper_SecBanner.asp - unsecured-router notice FRAGMENT (v2.9.1)
+
+	Not a page: no <head>, no chrome. Fetched by the injected loader
+	(REAPER_SECBANNER_JS in httpd/reaper_inject.c) and inserted at the top of
+	<body> on every top-level admin surface.
+
+	WHY A FRAGMENT AND NOT MARKUP IN EACH PAGE
+	  do_ej resolves <#TOKEN#> server-side against the language in preferred_lang
+	  (httpd/ej.c:108 kw_mark1/kw_mark2, load_dictionary at :275), so everything
+	  below arrives already translated. One definition, so the banner cannot drift
+	  between the dashboard, the shell and the stock pages.
+
+	WHY THE STRINGS SIT IN HIDDEN SPANS
+	  Scripts inside innerHTML never execute, so the loader - not this file - builds
+	  the banner. Keeping every literal here means the loader stays pure logic and
+	  carries no English (i18n standing rule 24). Same split as Reaper_BackupCard.asp.
+
+	STATE
+	  #rsec_state carries the two live conditions. Both are computed server-side on
+	  every render, which is what makes this notice un-dismissable: there is no
+	  client state to clear and no cookie to drop. data-pw is stock's own
+	  check_pw() (1 = admin password still factory); data-wifi is reaper_wifi_default()
+	  (1 = at least one radio still on the factory key).
+
+	NEVER SERVED PRE-AUTH. The loader is injected only into authenticated admin
+	surfaces - never Main_Login.asp, Captive_Portal*, blocking.asp or the offline
+	pages. Telling an unauthenticated visitor or a quarantined guest that the router
+	still has factory credentials hands the fact to exactly the wrong person.
+-->
+<div id="rsec_state" data-pw="<% check_pw(); %>" data-wifi="<% reaper_wifi_default(); %>"></div>
+
+<div id="rsec_i18n" style="display:none">
+	<span id="rsec_t_head_both"><#RSEC_1#></span>
+	<span id="rsec_t_head_one"><#RSEC_2#></span>
+	<span id="rsec_t_body_both"><#RSEC_3#></span>
+	<span id="rsec_t_body_pw"><#RSEC_4#></span>
+	<span id="rsec_t_body_wifi"><#RSEC_5#></span>
+	<span id="rsec_t_pw_todo"><#RSEC_6#></span>
+	<span id="rsec_t_pw_done"><#RSEC_7#></span>
+	<span id="rsec_t_pw_cta"><#RSEC_8#></span>
+	<span id="rsec_t_wifi_todo"><#RSEC_9#></span>
+	<span id="rsec_t_wifi_done"><#RSEC_10#></span>
+	<span id="rsec_t_wifi_cta"><#RSEC_11#></span>
+	<span id="rsec_t_why"><#RSEC_12#></span>
+</div>
