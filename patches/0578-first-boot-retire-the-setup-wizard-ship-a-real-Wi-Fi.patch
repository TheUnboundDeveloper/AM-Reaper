+/*
+ * reaper v2.9.1: is ANY radio still on the factory Wi-Fi key?
+ *
+ * The banner (Reaper_SecBanner.asp) needs a Wi-Fi answer the way check_pw() gives
+ * a password answer. It deliberately does NOT reuse w_Setting: that flag means
+ * "the wireless page was applied at least once", not "the key is no longer the
+ * factory one" - a user who applies the page without touching the password would
+ * clear the banner while still on "admin". Keying a notice's clear-condition off
+ * different state than its fire-condition is what produced the v2.7.3 BE92U
+ * nav-flash, so both conditions here read the same nvram they judge.
+ *
+ * Answers 1 (still factory) if ANY radio's key equals the compiled-in default.
+ * A radio whose key is empty or absent - disabled, or an auth mode with no PSK -
+ * is NOT counted as factory: it cannot be "still admin", and counting it would
+ * hold the banner open forever on a box with a radio switched off.
+ *
+ * The PSK itself is never emitted to the page; only this boolean crosses.
+ */
+static int
+ej_reaper_wifi_default(int eid, webs_t wp, int argc, char_t **argv)
+{
+	char *def = nvram_default_get("wl_wpa_psk");
+	char key[32];
+	int unit, n;
+
+	/* No compiled-in default means nothing to compare against - report secured
+	 * rather than nagging forever about a condition that cannot be cleared. */
+	if (!def || !*def)
+		return websWrite(wp, "0");
+
+	n = num_of_wl_if();
+	if (n > MAX_NR_WL_IF)
+		n = MAX_NR_WL_IF;
+
+	for (unit = 0; unit < n; unit++) {
+		char *psk;
+
+		snprintf(key, sizeof(key), "wl%d_wpa_psk", unit);
+		psk = nvram_safe_get(key);
+		if (psk && *psk && !strcmp(psk, def))
+			return websWrite(wp, "1");
+	}
+
+	return websWrite(wp, "0");
+}
