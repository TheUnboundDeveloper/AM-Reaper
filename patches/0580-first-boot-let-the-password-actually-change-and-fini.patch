 		if (strcasecmp(name, reaper_skip[i]) == 0)
 			return 0;
@@ -531,12 +551,6 @@ static int reaper_should_inject(struct mime_handler *h, const char *file)
 		if (strcasecmp(name, reaper_native[i]) == 0)
 			return 2;
 
