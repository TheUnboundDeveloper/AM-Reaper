diff --git a/release/src/router/httpd/web.c b/release/src/router/httpd/web.c
index 903b14237a..5e155d9e57 100644
--- a/release/src/router/httpd/web.c
+++ b/release/src/router/httpd/web.c
@@ -24944,6 +24944,26 @@ static int rbk_jffs_ok(void)
 }
 
 static void
+/* reaper v2.9.2: every failure below used to answer ek:"file", so ten distinct
+ * causes - wrong magic, a truncated CFG, an unparseable Reaper JSON, a full
+ * /jffs - collapsed into one message that blamed the user's file. A field
+ * report could not tell them apart. ek keeps the coarse family (the client's
+ * message mapping is unchanged); ec names the exact cause:
+ *   magic    the archive is not a .rbk at all - no "REAPER-BACKUP 1" header,
+ *            bad meta line, or part lengths that do not fit the file. This is
+ *            what a Reaper settings JSON export or a stock .CFG looks like when
+ *            it is handed to the FULL-BACKUP importer instead of its own one.
+ *   stage    the staged upload could not be reopened from /tmp
+ *   cfghdr   the embedded stock CFG carries no PROFILE_HEADER (truncated, or
+ *            the part offsets are wrong)
+ *   rcfgread/rcfgjson   the Reaper JSON half is unreadable / not ours
+ *   fqdnread/fqdnname/fqdnline   the fqdn ipset cache is malformed
+ *   cfgseek/cfgtmp/cfgshort      staging /tmp/settings_u.prf failed; cfgshort
+ *            means the archive ended early - a truncated download
+ *   jffsfull /jffs failed its health gate (space or a write test)
+ *   jffswrite  the pending-restore file could not be created
+ * The code is surfaced in the UI in brackets and is the first thing to ask for
+ * in any restore report. */
 do_reaper_restore_cgi(char *url, FILE *stream)
 {
 	FILE *in = NULL, *out = NULL;
@@ -24965,27 +24985,27 @@ do_reaper_restore_cgi(char *url, FILE *stream)
 			goto done;
 		}
 	}
-	if (rbk_up.err) { websWrite(stream, "{\"ok\":0,\"ek\":\"file\"}"); goto done; }
+	if (rbk_up.err) { websWrite(stream, "{\"ok\":0,\"ek\":\"file\",\"ec\":\"magic\"}"); goto done; }
 	if (strcmp(rbk_up.model, nvram_safe_get("productid")) != 0) {
 		websWrite(stream, "{\"ok\":0,\"ek\":\"model\"}");
 		goto done;
 	}
-	if (!rbk_jffs_ok()) { websWrite(stream, "{\"ok\":0,\"ek\":\"jffs\"}"); goto done; }
+	if (!rbk_jffs_ok()) { websWrite(stream, "{\"ok\":0,\"ek\":\"jffs\",\"ec\":\"jffsfull\"}"); goto done; }
 
-	if ((in = fopen(RBK_UPLOAD, "r")) == NULL) { websWrite(stream, "{\"ok\":0,\"ek\":\"file\"}"); goto done; }
+	if ((in = fopen(RBK_UPLOAD, "r")) == NULL) { websWrite(stream, "{\"ok\":0,\"ek\":\"file\",\"ec\":\"stage\"}"); goto done; }
 
 	/* ---- validate everything before writing anything ---- */
 	/* the CFG part must itself carry the stock profile magic */
 	if (fread(buf, 1, 8, in) != 8 ||
 	    (strncmp(buf, PROFILE_HEADER, 4) != 0 && strncmp(buf, PROFILE_HEADER_NEW, 4) != 0)) {
-		websWrite(stream, "{\"ok\":0,\"ek\":\"file\"}");
+		websWrite(stream, "{\"ok\":0,\"ek\":\"file\",\"ec\":\"cfghdr\"}");
 		goto done;
 	}
 	/* the Reaper JSON must parse and be ours */
 	if (fseek(in, rbk_up.cfg, SEEK_SET) != 0 ||
 	    (rcfg = malloc(rbk_up.rcfg + 1)) == NULL ||
 	    fread(rcfg, 1, rbk_up.rcfg, in) != (size_t)rbk_up.rcfg) {
-		websWrite(stream, "{\"ok\":0,\"ek\":\"file\"}");
+		websWrite(stream, "{\"ok\":0,\"ek\":\"file\",\"ec\":\"rcfgread\"}");
 		goto done;
 	}
 	rcfg[rbk_up.rcfg] = '\0';
@@ -24994,14 +25014,14 @@ do_reaper_restore_cgi(char *url, FILE *stream)
 		int good = (jr && json_object_get_type(jr) == json_type_object &&
 			    json_object_object_get_ex(jr, "reaper_cfg", &jv));
 		if (jr) json_object_put(jr);
-		if (!good) { websWrite(stream, "{\"ok\":0,\"ek\":\"file\"}"); goto done; }
+		if (!good) { websWrite(stream, "{\"ok\":0,\"ek\":\"file\",\"ec\":\"rcfgjson\"}"); goto done; }
 	}
 	/* the fqdn part must be well-formed (set headers + add lines only) */
 	if (rbk_up.fqdn > 0) {
 		char *p, *line;
 		if ((fqdn = malloc(rbk_up.fqdn + 1)) == NULL ||
 		    fread(fqdn, 1, rbk_up.fqdn, in) != (size_t)rbk_up.fqdn) {
-			websWrite(stream, "{\"ok\":0,\"ek\":\"file\"}");
+			websWrite(stream, "{\"ok\":0,\"ek\":\"file\",\"ec\":\"fqdnread\"}");
 			goto done;
 		}
 		fqdn[rbk_up.fqdn] = '\0';
@@ -25010,9 +25030,9 @@ do_reaper_restore_cgi(char *url, FILE *stream)
 			if (p) *p = '\0';
 			if (line[0] == '\0') { if (p) *p = '\n'; continue; }
 			if (strncmp(line, "#set ", 5) == 0) {
-				if (!rbk_setname_ok(line + 5)) { websWrite(stream, "{\"ok\":0,\"ek\":\"file\"}"); goto done; }
+				if (!rbk_setname_ok(line + 5)) { websWrite(stream, "{\"ok\":0,\"ek\":\"file\",\"ec\":\"fqdnname\"}"); goto done; }
 			} else if (strncmp(line, "add ", 4) != 0) {
-				websWrite(stream, "{\"ok\":0,\"ek\":\"file\"}");
+				websWrite(stream, "{\"ok\":0,\"ek\":\"file\",\"ec\":\"fqdnline\"}");
 				goto done;
 			}
 			if (p) *p = '\n';
@@ -25027,7 +25047,7 @@ do_reaper_restore_cgi(char *url, FILE *stream)
 		int pfd = open(RCFG_PENDING, O_CREAT | O_EXCL | O_WRONLY | O_NOFOLLOW, 0600);
 		if (pfd < 0 || (out = fdopen(pfd, "w")) == NULL) {
 			if (pfd >= 0) close(pfd);
-			websWrite(stream, "{\"ok\":0,\"ek\":\"jffs\"}");
+			websWrite(stream, "{\"ok\":0,\"ek\":\"jffs\",\"ec\":\"jffswrite\"}");
 			goto done;
 		}
 		fwrite(rcfg, 1, rbk_up.rcfg, out);
@@ -25059,17 +25079,17 @@ do_reaper_restore_cgi(char *url, FILE *stream)
 		if (out) { fclose(out); out = NULL; }
 	}
 	/* 3. the stock CFG, staged where the stock restore path expects it */
-	if (fseek(in, 0, SEEK_SET) != 0) { websWrite(stream, "{\"ok\":0,\"ek\":\"file\"}"); goto done; }
+	if (fseek(in, 0, SEEK_SET) != 0) { websWrite(stream, "{\"ok\":0,\"ek\":\"file\",\"ec\":\"cfgseek\"}"); goto done; }
 	{
 		FILE *cf = fopen("/tmp/settings_u.prf", "w");
-		if (!cf) { websWrite(stream, "{\"ok\":0,\"ek\":\"file\"}"); goto done; }
+		if (!cf) { websWrite(stream, "{\"ok\":0,\"ek\":\"file\",\"ec\":\"cfgtmp\"}"); goto done; }
 		left = rbk_up.cfg;
 		while (left > 0 && (n = fread(buf, 1, MIN(left, (long)sizeof(buf)), in)) > 0) {
 			fwrite(buf, 1, n, cf);
 			left -= n;
 		}
 		fclose(cf);
-		if (left > 0) { unlink("/tmp/settings_u.prf"); websWrite(stream, "{\"ok\":0,\"ek\":\"file\"}"); goto done; }
+		if (left > 0) { unlink("/tmp/settings_u.prf"); websWrite(stream, "{\"ok\":0,\"ek\":\"file\",\"ec\":\"cfgshort\"}"); goto done; }
 	}
 	ok = 1;
 	logmessage("reaper_cfg", "full-backup restore: settings staged, Reaper half parked at %s - restoring and rebooting", RCFG_PENDING);
@@ -38838,22 +38858,42 @@ ej_reaper_wifi_default(int eid, webs_t wp, int argc, char_t **argv)
 		n = MAX_NR_WL_IF;
 
 	for (unit = 0; unit < n; unit++) {
-		char *psk, *def;
+		char *psk, *def, *auth;
 
-		snprintf(key, sizeof(key), "wl%d_wpa_psk", unit);
-		/* Each radio is judged against ITS OWN compiled default, not the
-		 * generic wl_wpa_psk template. router_defaults[] carries an explicit
-		 * per-unit entry and nvram_default_get() returns the FIRST match, so
-		 * the per-unit value is the one this radio was actually seeded from.
-		 * Comparing against the template would judge a radio by a value it
-		 * never held - which is how the first cut of this shipped a banner
-		 * that cleared itself on a factory box. */
-		def = nvram_default_get(key);
-		if (!def || !*def)
+		/* A radio that is switched off cannot be insecure, and counting it
+		 * would nag forever on a box that deliberately runs 2 of 3 bands. */
+		snprintf(key, sizeof(key), "wl%d_radio", unit);
+		if (nvram_get(key) && nvram_get_int(key) == 0)
 			continue;
 
+		/* THE FACTORY STATE IS AN OPEN NETWORK (owner decision, v2.9.2): a
+		 * reset box broadcasts with no key until someone sets one, so "open"
+		 * and "owe" ARE the unsecured state and must be what this reports.
+		 * The previous cut compared only the PSK and deliberately skipped an
+		 * empty one - which on an open factory box read as SECURED and cleared
+		 * the banner's Wi-Fi row on exactly the boxes that needed it. Judge the
+		 * auth mode first; the PSK comparison below only matters if a shipped
+		 * default key is ever reintroduced. */
+		snprintf(key, sizeof(key), "wl%d_auth_mode_x", unit);
+		auth = nvram_safe_get(key);
+		if (!auth || !*auth || !strcmp(auth, "open") || !strcmp(auth, "owe"))
+			return websWrite(wp, "1");
+
+		snprintf(key, sizeof(key), "wl%d_wpa_psk", unit);
 		psk = nvram_safe_get(key);
-		if (psk && *psk && !strcmp(psk, def))
+
+		/* A keyed auth mode carrying no key at all is unsecured, not "unset". */
+		if (!psk || !*psk)
+			return websWrite(wp, "1");
+
+		/* Still sitting on whatever key the firmware shipped. nvram_default_get()
+		 * falls through fix_name() ("wl0_x" -> "wl_x") to the generic template
+		 * when no per-unit entry exists - and on this fleet none does, the
+		 * per-unit block in router_defaults[] is inside #if EBG15 || EBG19 and
+		 * never compiles. Inert while the factory PSK is empty; kept so a future
+		 * default key is caught without touching this function again. */
+		def = nvram_default_get(key);
+		if (def && *def && !strcmp(psk, def))
 			return websWrite(wp, "1");
 	}
 
