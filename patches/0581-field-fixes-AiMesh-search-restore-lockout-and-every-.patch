+/* reaper v2.9.3: the IP of the client on the CURRENT request, captured in
+ * handle_request(). Needed outside httpd.c so a CGI can identify the operator
+ * who issued it - specifically the settings restore, which must never lock out
+ * the admin performing it (see do_reaper_restore_cgi). */
+char reaper_client_ip[128] = "";
+
+/* reaper v2.9.3: resolve the current request's client to a LAN MAC. Returns 1
+ * and fills mac on success. Thin wrapper so gk_ip_to_mac can stay static. */
+int
+reaper_client_mac(char *mac, size_t maclen)
+{
+	if (!reaper_client_ip[0] || !mac || maclen < 18)
+		return 0;
+	return gk_ip_to_mac(reaper_client_ip, mac, maclen);
+}
+
 /* is mac listed (any state) in gk_rl "<MAC>state>expiry..."? */
