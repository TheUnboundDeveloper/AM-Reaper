+++ b/release/src/router/www/js/reaper_clock.js
@@ -0,0 +1,59 @@
+/* reaper v2.9.4: the nav-rail clock, with re-sync.
+ *
+ * The old per-page inline script seeded its base ONCE from <% uptime(); %> at
+ * render and extrapolated forever. This board has no battery RTC, so every boot
+ * and every NTP correction is a clock STEP (observed on metal 2026-08-30: a ~4 h
+ * jump mid-syslog) - a shell tab left open across one showed the wrong time
+ * until reloaded. The two page copies were also byte-identical twins destined
+ * to drift apart; the logic now lives here once.
+ *
+ * Contract: the page defines window.RP_CLK = { seed, dw[7], mo[12] } BEFORE
+ * loading this file (seed = <% uptime(); %>; dw/mo carry the page's translated
+ * day/month names - dict tokens stay in the .asp, this file is deliberately
+ * token-free). Re-sync fetches /Reaper_SecBanner.asp - a request the banner
+ * loader already makes on every admin page - and reads its data-now attribute.
+ * Rule-34 shape: one guarded completion; any failure leaves the clock ticking
+ * on its current base. Corrections under 2 s are ignored (jitter), larger ones
+ * snap (the NTP-step case this exists for). */
+(function(){
+	var C = window.RP_CLK;
+	if (!C || !C.seed || !C.dw || !C.mo) return;
+	var et = document.getElementById('rc_time'), ed = document.getElementById('rc_date');
+	if (!et) return;
+
+	function parse(us){
+		if (!us || us.length < 25) return NaN;
+		return Date.parse(us.substring(8,11)+" "+us.substring(5,7)+" "+us.substring(17,25)+" "+us.substring(12,16));
+	}
+	var b = parse(C.seed), t0 = Date.now();
+	if (isNaN(b)) return;
+
+	function p2(n){ return (n<10?'0':'')+n; }
+	function tk(){
+		var d = new Date(b + (Date.now()-t0));
+		et.innerHTML = p2(d.getHours())+':'+p2(d.getMinutes())+':<span class="rc-sec">'+p2(d.getSeconds())+'</span>';
+		if (ed) ed.textContent = C.dw[d.getDay()]+' '+d.getDate()+' '+C.mo[d.getMonth()]+' '+d.getFullYear();
+	}
+	function resync(){
+		try{
+			var x = new XMLHttpRequest(), done = false;
