diff --git a/release/src/router/httpd/web.c b/release/src/router/httpd/web.c
index b7cfd8c8b9..b883b05202 100644
--- a/release/src/router/httpd/web.c
+++ b/release/src/router/httpd/web.c
@@ -23809,6 +23809,41 @@ static int fw_list_count(const char *s)
 	return n;
 }
 
+/* reaper v2.9.4: split the nat store by record mode so the Status tab can report
+ * forwards and Service Intercepts separately - the posture page listed neither,
+ * so two live enforcement surfaces were invisible (owner, metal, 2026-08-29).
+ * Records are '<'-separated, fields '>'-separated, and MODE IS POSITIONAL FIELD 8:
+ * an absent field 8 is a pre-Service-Intercept record and means "forward"
+ * (mirrors rc/reaper_fw.c, which also fails closed on an unknown value - such a
+ * record is dropped by the loader, so it is counted as neither here). */
+static void fw_nat_mode_counts(const char *s, int *fwd, int *icpt)
+{
+	char mode[16];
+	int fi = -1, mi = 0, started = 0;
+
+	*fwd = *icpt = 0;
+	if (!s) return;
+	mode[0] = '\0';
+	for (;; s++) {
+		if (*s == '<' || *s == '\0') {
+			if (started) {
+				mode[mi] = '\0';
+				if (!strcmp(mode, "intercept") || !strcmp(mode, "redirect"))
+					(*icpt)++;
+				else if (fi < 8 || !*mode || !strcmp(mode, "forward"))
+					(*fwd)++;	/* absent/empty field 8 = legacy forward */
+				/* anything else: loader drops it - count as neither */
+			}
+			if (*s == '\0') break;
+			started = 1; fi = 0; mi = 0; mode[0] = '\0';
+		} else if (started && *s == '>') {
+			fi++;
+		} else if (started && fi == 8 && mi < (int)sizeof(mode) - 1) {
+			mode[mi++] = *s;
+		}
+	}
+}
+
 /* reaper 2026-08-13: the remote-admin port actually in use. http_enable:
  * 0 = HTTP only, 1 = HTTPS only, 2 = both - report the TLS port whenever TLS
  * answers, since that is the one an operator would be reaching. */
@@ -23899,6 +23934,13 @@ do_reaper_fw_cgi(char *url, FILE *stream)
 			nvram_get_int("reaper_fw_confirm"),
 			nvram_match("reaper_fw_armed", "1") ? 1 : 0,
 			n_rules, n_obj, n_grp, n_svc, n_zone, n_zpol);
+		/* nat resolved LAST and consumed immediately: reaper_fw_list_get()
+		 * returns a static the NEXT call frees (see the note above). */
+		{
+			int n_fwd = 0, n_icpt = 0;
+			fw_nat_mode_counts(reaper_fw_list_get("nat"), &n_fwd, &n_icpt);
+			websWrite(stream, ",\"nfwd\":%d,\"nicpt\":%d", n_fwd, n_icpt);
+		}
 		}
 		websWrite(stream, ",\"fwerr\":");
 		gk_json_esc(stream, nvram_safe_get("reaper_fw_err"));
