 }
 
 /* Show the explanation under the tables only when something is actually hidden. */
@@ -962,10 +962,30 @@ function isSmartConnectEnabled(){
 	return parseInt(variable['smart_connect_x']) > 0;
 }
 
+/* reaper v2.9.4: once cfg_server has performed the SDN migration (main network
+   on the MAINFH subunit-1 profiles), band membership is owned by the Network
+   page and the classic smart_connect_x/selif pair no longer drives anything -
+   the old toggle set nvram, fired a bare restart_wireless, and the per-band
+   profiles came back unchanged: a dead switch (owner, metal, 2026-08-30).
+   Rewriting sdn_rl from this classic page is NOT attempted - mis-serializing it
+   takes down every SSID; the SDN app owns that write. Detect the state from
+   sdn_rl itself (enum/numeric fields only, no user text). */
+var RP_SDN_MIGRATED = `<% nvram_get("sdn_rl"); %>`.indexOf('MAINFH') >= 0;
+var RP_NETPAGE = '/reaper_shell.asp#SDN.asp';
+
 function setupSmartConnectToggle(){
 	var btn = document.getElementById('smartConnectToggle');
 	if(!btn) return;
 
+	if(RP_SDN_MIGRATED){
+		/* not a dead switch, not a hand-forged sdn_rl: point at the owner */
+		btn.value = 'Manage on Network page';
+		btn.title = 'In this firmware state the main network\'s band membership is managed on the Network page - open the main network there and choose its Wi-Fi bands.';
+		var hintEl = document.getElementById('scWhereHint');
+		if(hintEl) hintEl.innerHTML = 'Choose which radios take part on the <b>Network</b> page &mdash; open the main network and pick its Wi-Fi bands.';
+		return;
+	}
+
 	if(isSmartConnectEnabled()){
 		btn.value = 'Disable Smart Connect';
 		btn.title = 'Turn off Smart Connect (band steering) for all radios';
@@ -990,6 +1010,12 @@ function setupSmartConnectToggle(){
 }
 
 function toggleSmartConnect(){
+	if(RP_SDN_MIGRATED){
+		/* v2.9.4: the classic pair is inert here - go where the control lives */
+		top.location = RP_NETPAGE;
+		return;
+	}
+
 	var setObj = {};
 
 	if(isSmartConnectEnabled()){
@@ -1083,7 +1109,7 @@ function toggleSmartConnect(){
 			     re-shown the moment the band is added back. Shown only when a column is
 			     actually suppressed - see genSmartConnectExcludedNote(). -->
 			<div id="sc_excluded_note" class="formfontdesc" style="display:none;line-height:18px;margin:10px 5px;padding:8px 10px;border:1px solid #6b8fa3;border-radius:4px;background:rgba(107,143,163,0.10);">
-				<b>Some bands show &ldquo;- -&rdquo;.</b> Those radios are not part of the Smart Connect group, so there are no steering rules to display for them. Nothing has been lost &mdash; each band keeps its own policy and it reappears here as soon as the band is added back. Choose which radios take part under <b>Wireless &gt; General</b>.
+				<b>Some bands show &ldquo;- -&rdquo;.</b> Those radios are not part of the Smart Connect group, so there are no steering rules to display for them. Nothing has been lost &mdash; each band keeps its own policy and it reappears here as soon as the band is added back. <span id="scWhereHint">Choose which radios take part under <b>Wireless &gt; General</b>.</span>
