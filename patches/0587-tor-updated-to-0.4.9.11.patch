+static bool
+subproto_requests_in_order(const trn_subproto_request_t *a,
+                           const trn_subproto_request_t *b)
+{
+  if (a->protocol_id < b->protocol_id) {
+    return true;
+  } else if (a->protocol_id == b->protocol_id) {
+    return (a->proto_cap_number < b->proto_cap_number);
+  } else {
+    return false;
+  }
+}
