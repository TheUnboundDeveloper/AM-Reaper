+{
+  const uint8_t iv[16] = {0};
+  size_t aes_key_bytes = aesbits / 8;
+  memset(prf,0, sizeof(*prf));
+  prf->k = aes_new_cipher(key, iv, aesbits);
+  polyval_key_init(&prf->b, key + aes_key_bytes);
+  return 0;
+}
