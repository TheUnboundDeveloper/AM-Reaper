+/**
+ * Release any storage held in 'prf'.
+ *
+ * This _doesn't_ wipe 'prf'; that's done from a higher-level function.
+ */
+STATIC void
+cgo_prf_clear(cgo_prf_t *prf)
+{
+  aes_cipher_free(prf->k);
+}
