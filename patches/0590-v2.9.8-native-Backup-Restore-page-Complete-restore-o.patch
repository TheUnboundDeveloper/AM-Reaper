+    <h2><#Setting_factorydefault_itemname#></h2>
+    <div class="tag"><#Setting_factorydefault_itemname#></div>
+    <label class="chk"><input type="checkbox" id="fd_init" checked><span><#Setting_initialize_desc#></span></label>
+    <div class="row" style="margin-top:12px">
+      <button class="btn danger" id="fd_go" type="button"><#CTL_restore#></button>
