+
+<div class="ovl" id="ovl"><div class="box"><div class="t" id="ovl_t"></div><div class="s" id="ovl_s"></div><div class="beat"><i></i></div></div></div>
+
+<script src="/reaper_util.js"></script>
+<script>
+var HID = '<% nvram_get("http_id"); %>';
+var MODEL = '<% nvram_get("productid"); %>';
+var VER = '<% nvram_get("extendno"); %>';
+var LAN_IP = '<% nvram_get("lan_ipaddr"); %>';
+var DEF_IP = '<% nvram_default_get("lan_ipaddr"); %>';
+var JFFS_ON = '<% nvram_get("jffs2_on"); %>';
+var DDNS_EN = '<% nvram_get("ddns_enable_x"); %>';
+var DDNS_SRV = '<% nvram_get("ddns_server_x"); %>';
+var PREF_LANG = '<% nvram_get("preferred_lang"); %>';
+var FIRMVER = '<% nvram_get("firmver"); %>';
+var busy = 0;
+
+function $id(i){ return document.getElementById(i); }
+function setStat(i, txt, cls){ var n = $id(i); if(!n) return; n.className = 'stat' + (cls ? ' ' + cls : ''); n.textContent = txt; n.style.display = txt ? 'block' : 'none'; }
+/* rule 34: a failed XHR fires BOTH readystatechange(4) and error - every
+   completion path below runs through once() so no chain can ever double. */
+function once(fn){ var done = 0; return function(a){ if(done) return; done = 1; fn(a); }; }
+function veil(t, s){ $id('ovl_t').textContent = t; $id('ovl_s').textContent = s || ''; $id('ovl').className = 'ovl on'; }
+function veilSub(s){ $id('ovl_s').textContent = s; }
+function veilOff(){ $id('ovl').className = 'ovl'; }
+function gotoLogin(){ try{ (window.top || window).location.href = '/Main_Login.asp'; }catch(e){ location.href = '/Main_Login.asp'; } }
+function clean(s){ return String(s).replace(/[^A-Za-z0-9._-]/g, ''); }
+
+/* wait for the router to go DOWN then answer again -> back to login.
+   If it never goes down within noDownCap ticks, call onNeverDown (the upload
+   was rejected and nothing is rebooting). If it never comes BACK, show
+   capMsg - after a factory reset the LAN IP usually changed, so this origin
+   may simply never answer again and that message is the real exit. */
+function pollBack(tries, wentDown, noDownCap, onNeverDown, capMsg){
+  if(!wentDown && noDownCap && tries > noDownCap){ onNeverDown(); return; }
+  if(tries > 450){ veilSub(capMsg); return; }
+  var x = new XMLHttpRequest();
+  var next = once(function(down){ setTimeout(function(){ pollBack(tries + 1, down || wentDown, noDownCap, onNeverDown, capMsg); }, 2000); });
+  x.open('GET', '/httpd_check.xml?_=' + Date.now(), true);
+  x.timeout = 3000;
+  x.onreadystatechange = function(){
+    if(x.readyState !== 4) return;
+    if(x.status === 200){
+      if(wentDown){ gotoLogin(); return; }
+      next(0);
+    } else next(1);
+  };
+  x.onerror = x.ontimeout = x.onabort = function(){ next(1); };
+  x.send();
+}
+
+/* ---------------- pending-restore banner ---------------- */
+function pendingCheck(){
+  var x = new XMLHttpRequest();
+  x.open('GET', '/reaper_cfg.cgi?action=pending&http_id=' + encodeURIComponent(HID) + '&_=' + Date.now(), true);
+  x.timeout = 8000;
+  x.onload = function(){
+    var j = null; try{ j = JSON.parse(x.responseText); }catch(e){}
+    if(j && j.ok && j.pending) $id('rbk_pending').style.display = 'flex';
+  };
+  x.send();
+}
+function pendingComplete(){
+  var b = $id('rbk_complete'); b.disabled = true;
+  var q = new XMLHttpRequest();
+  q.open('POST', '/reaper_cfg.cgi', true);
+  q.setRequestHeader('Content-Type', 'application/x-www-form-urlencoded');
+  q.onloadend = function(){
+    var r = null; try{ r = JSON.parse(q.responseText); }catch(e){}
+    b.disabled = false;
+    if(!r || !r.ok){ setStat('st_rbk', `<#RBKP_14#>`, 'err'); return; }
+    $id('rbk_pending').style.display = 'none';
+    setStat('st_rbk', `<#RBKP_11#>`.replace('%1', r.flags).replace('%2', r.lists).replace('%3', r.rejected), 'ok');
+  };
+  q.send('action=import_pending&http_id=' + encodeURIComponent(HID));
+}
+
+/* ---------------- full backup (.rbk) ---------------- */
+function rbkDownload(){ location.href = '/REAPER_' + clean(MODEL) + '_' + clean(VER) + '_settings.rbk?http_id=' + encodeURIComponent(HID); }
+function rbkRestore(f){
+  if(f.size > 16777216 || f.size < 64){ setStat('st_rbk', `<#RBKP_12#>`, 'err'); return; }
+  var rd = new FileReader();
+  rd.onload = function(){
+    var head = String(rd.result || '');
+    if(head.indexOf('REAPER-BACKUP 1\n') !== 0){ setStat('st_rbk', `<#RBKP_12#>`, 'err'); return; }
+    var meta = null; try{ meta = JSON.parse(head.split('\n')[1]); }catch(e){}
+    if(!meta){ setStat('st_rbk', `<#RBKP_12#>`, 'err'); return; }
+    if(String(meta.model) !== MODEL){ setStat('st_rbk', `<#RBKP_8#>`, 'err'); return; }
+    reaperConfirm(`<#RBKP_13#>`, { danger: true, okLabel: `<#CTL_restore#>`, cancelLabel: `<#CTL_Cancel#>` }, function(go){
+      if(!go || busy) return;
+      busy = 1;
+      setStat('st_rbk', '', '');
+      var fd = new FormData();
+      fd.append('http_id', HID);
+      fd.append('file', f);
+      var p = new XMLHttpRequest();
+      p.open('POST', '/reaper_restore.cgi', true);
+      p.onloadend = function(){
+        var r = null; try{ r = JSON.parse(p.responseText); }catch(e){}
+        if(!r || !r.ok){
+          busy = 0;
+          var ek = r && r.ek;
+          var em = ek === 'model' ? `<#RBKP_8#>` : ek === 'jffs' ? `<#RBKP_9#>` : ek === 'file' ? `<#RBKP_12#>` : `<#RBKP_14#>`;
+          if(r && r.ec) em += ' [' + r.ec + ']';
+          setStat('st_rbk', em, 'err');
+          return;
+        }
+        veil(`<#RBKP_15#>`, `<#RBKP_10#>`);
+        pollBack(0, 0, 0, function(){}, `<#Main_alert_proceeding_desc3#> <#LANConfig_ChangedLANIP#>`);
+      };
+      p.send(fd);
+    });
+  };
+  rd.readAsText(f.slice(0, 2048));
+}
+
+/* ---------------- Reaper settings JSON ---------------- */
+function cfgExport(){
+  var g = new XMLHttpRequest();
+  g.open('GET', '/reaper_cfg.cgi?action=export&http_id=' + encodeURIComponent(HID) + '&_=' + Date.now(), true);
+  g.onloadend = function(){
+    var j = null; try{ j = JSON.parse(g.responseText); }catch(e){}
+    if(!j || !j.ok){ setStat('st_cfg', `<#RDST_74#>`, 'err'); return; }
+    var name = 'reaper-settings-' + String(j.model || 'router').replace(/[^A-Za-z0-9_-]/g, '') + '-' + String(j.version || '').replace(/[^A-Za-z0-9_.-]/g, '') + '-' + new Date().toISOString().slice(0, 10) + '.json';
+    var blob = new Blob([JSON.stringify(j, null, 1)], { type: 'application/json' });
+    var a = document.createElement('a');
+    a.href = URL.createObjectURL(blob); a.download = name;
+    document.body.appendChild(a); a.click();
+    setTimeout(function(){ URL.revokeObjectURL(a.href); a.remove(); }, 2000);
+    setStat('st_cfg', `<#RDST_73#>` + ' ' + name, 'ok');
+  };
+  g.send();
+}
+function cfgImport(f){
+  if(f.size > 60000){ setStat('st_cfg', `<#RDST_75#>`, 'err'); return; }
+  var rd = new FileReader();
+  rd.onload = function(){
+    var j = null; try{ j = JSON.parse(String(rd.result || '')); }catch(e){}
+    if(!j || !j.reaper_cfg){ setStat('st_cfg', `<#RDST_75#>`, 'err'); return; }
+    reaperConfirm(`<#RDST_76#>`, { okLabel: `<#CTL_ok#>`, cancelLabel: `<#CTL_Cancel#>` }, function(go){
+      if(!go) return;
+      var p = new XMLHttpRequest();
+      p.open('POST', '/reaper_cfg.cgi', true);
+      p.setRequestHeader('Content-Type', 'application/x-www-form-urlencoded');
+      p.onloadend = function(){
+        var r = null; try{ r = JSON.parse(p.responseText); }catch(e){}
+        if(!r || !r.ok){ setStat('st_cfg', `<#RDST_74#>`, 'err'); return; }
+        setStat('st_cfg', `<#RDST_77#>`.replace('%1', r.flags).replace('%2', r.lists).replace('%3', r.rejected), 'ok');
+      };
+      p.send('action=import&http_id=' + encodeURIComponent(HID) + '&cfg=' + encodeURIComponent(JSON.stringify(j)));
+    });
+  };
+  rd.readAsText(f);
+}
+
+/* ---------------- stock router settings (.CFG) ---------------- */
+function cfgSave(){
+  var flag = 0;
+  if(DDNS_EN === '1'){
+    if(DDNS_SRV !== 'WWW.ASUS.COM') flag = 1;
+    else flag = $id('transfer_ddns').checked ? 1 : 0;
+  }
+  var rp = $id('remove_passwd').checked ? 1 : 0;
+  location.href = '/Settings_' + clean(MODEL) + '.CFG?path=' + flag + '&remove_passwd=' + rp;
+}
+function cfgRestore(f){
+  var nm = String(f.name || '').toUpperCase();
+  if(nm.length < 5 || nm.lastIndexOf('.CFG') !== nm.length - 4){ setStat('st_scfg', `<#Setting_upload_hint#>`, 'err'); return; }
+  var rd = new FileReader();
+  rd.onload = function(){
+    var head = String(rd.result || '');
+    if(head.indexOf('HDR1') !== 0 && head.indexOf('HDR2') !== 0){ setStat('st_scfg', `<#Setting_upload_hint#>`, 'err'); return; }
+    reaperConfirm(`<#RBKP_26#>`, { danger: true, okLabel: `<#CTL_restore#>`, cancelLabel: `<#CTL_Cancel#>` }, function(go){
+      if(!go || busy) return;
+      busy = 1;
+      setStat('st_scfg', '', '');
+      veil(`<#Setting_upload_itemname#>`, `<#SET_ok_desc#>`);
+      var fd = new FormData();
+      fd.append('current_page', 'Reaper_Backup.asp');
+      fd.append('next_page', '');
+      fd.append('action_mode', '');
+      fd.append('action_script', '');
+      fd.append('action_wait', '');
+      fd.append('productid', MODEL);
+      fd.append('preferred_lang', PREF_LANG);
+      fd.append('firmver', FIRMVER);
+      fd.append('file', f, f.name);
+      var x = new XMLHttpRequest();
+      x.open('POST', '/upload.cgi', true);
+      /* the box reboots into the restored settings; liveness is the verdict -
+         if it never goes down, the file was rejected (stock UploadError path) */
+      var handed = once(function(){
+        veilSub(`<#SAVE_restart_desc#>`);
+        pollBack(0, 0, 90, function(){
+          busy = 0; veilOff();
+          setStat('st_scfg', `<#Setting_upload_hint#>`, 'err');
+        }, `<#Main_alert_proceeding_desc3#> <#LANConfig_ChangedLANIP#>`);
+      });
+      x.onload = handed;
+      x.onerror = x.ontimeout = x.onabort = handed;
+      x.send(fd);
+    });
+  };
+  rd.readAsText(f.slice(0, 8));
+}
+
+/* ---------------- JFFS partition ---------------- */
+function jffsSave(){ location.href = '/backup_jffs_' + clean(MODEL) + '.tar'; }
+function jffsRestore(f){
+  var nm = String(f.name || '');
+  if(nm.length < 5 || nm.toLowerCase().lastIndexOf('.tar') !== nm.length - 4){ setStat('st_jffs', `<#RBKP_22#>`, 'err'); return; }
+  reaperConfirm(`<#RBKP_21#>` + '\n' + `<#Setting_factorydefault_hint2#>`, { danger: true, okLabel: `<#CTL_restore#>`, cancelLabel: `<#CTL_Cancel#>` }, function(go){
+    if(!go || busy) return;
+    busy = 1;
+    setStat('st_jffs', `<#RBKP_23#>`, 'ok');
+    var fd = new FormData();
+    fd.append('file2', f, f.name);
+    var x = new XMLHttpRequest();
+    x.open('POST', '/jffsupload.cgi', true);
+    var fin = once(function(okish){
+      busy = 0;
+      if(okish) setStat('st_jffs', `<#RBKP_24#>`, 'ok');
+      else setStat('st_jffs', `<#RDST_74#>`, 'err');
+    });
+    x.onload = function(){ fin(x.status === 200); };
+    x.onerror = x.ontimeout = x.onabort = function(){ fin(0); };
+    x.send(fd);
+  });
+}
+
+/* ---------------- factory default ---------------- */
+function factoryReset(){
+  var init = $id('fd_init').checked;
+  var msg = init ? `<#Setting_initialize_hint1#>` : `<#Setting_factorydefault_hint1#>`;
+  if(LAN_IP !== DEF_IP) msg += '\n' + `<#Setting_factorydefault_iphint#>`.replace('192.168.1.1', DEF_IP) + '\n';
+  msg += '\n' + `<#Setting_factorydefault_hint2#>`;
+  reaperConfirm(msg, { danger: true, okLabel: `<#CTL_restore#>`, cancelLabel: `<#CTL_Cancel#>` }, function(go){
+    if(!go || busy) return;
+    busy = 1;
+    veil(`<#Setting_factorydefault_itemname#>`, `<#SAVE_restart_desc#>`);
+    var x = new XMLHttpRequest();
+    x.open('POST', '/apply.cgi', true);
+    x.setRequestHeader('Content-Type', 'application/x-www-form-urlencoded');
+    var handed = once(function(){
+      pollBack(0, 0, 0, function(){}, `<#Main_alert_proceeding_desc3#> <#LANConfig_ChangedLANIP#>`);
+    });
+    x.onload = handed;
+    x.onerror = x.ontimeout = x.onabort = handed;
+    x.send('action_mode=' + (init ? 'restore_erase' : 'Restore') + '&next_page=');
+  });
+}
+
+/* ---------------- boot ---------------- */
+function boot(){
+  if(DDNS_EN === '1' && DDNS_SRV === 'WWW.ASUS.COM') $id('ddns_row').style.display = 'flex';
+  if(JFFS_ON !== '1') $id('jffs_card').style.display = 'none';
+  $id('rbk_dl').onclick = rbkDownload;
+  $id('rbk_up').onclick = function(){ $id('rbk_file').click(); };
+  $id('rbk_file').onchange = function(){ var f = this.files && this.files[0]; this.value = ''; if(f) rbkRestore(f); };
+  $id('rbk_complete').onclick = pendingComplete;
+  $id('rbk_cx').onclick = cfgExport;
+  $id('rbk_ci').onclick = function(){ $id('rbk_cfile').click(); };
+  $id('rbk_cfile').onchange = function(){ var f = this.files && this.files[0]; this.value = ''; if(f) cfgImport(f); };
+  $id('cfg_save').onclick = cfgSave;
+  $id('cfg_up').onclick = function(){ $id('cfg_file').click(); };
+  $id('cfg_file').onchange = function(){ var f = this.files && this.files[0]; this.value = ''; if(f) cfgRestore(f); };
+  $id('jffs_save').onclick = jffsSave;
+  $id('jffs_up').onclick = function(){ $id('jffs_file').click(); };
+  $id('jffs_file').onchange = function(){ var f = this.files && this.files[0]; this.value = ''; if(f) jffsRestore(f); };
+  $id('fd_go').onclick = factoryReset;
+  pendingCheck();
+}
+if(document.readyState !== 'loading') boot();
+else document.addEventListener('DOMContentLoaded', boot);
+</script>
+</body>
+</html>
