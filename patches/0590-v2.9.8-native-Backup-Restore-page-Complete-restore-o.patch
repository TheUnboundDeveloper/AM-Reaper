 <body>
+<!-- reaper v2.9.8: pending-restore banner (twin of the reaper_shell.asp copy -
+     the dashboard is the post-login landing page, so the one click that
+     finishes a full-backup restore must be visible here first). -->
+<style>
+.rpb{display:none;align-items:center;gap:12px;flex-wrap:wrap;padding:10px 16px;font-size:12.5px;color:#ECE7DB;background:linear-gradient(180deg,rgba(225,6,0,.16),rgba(225,6,0,.06)),#120b0b;border-bottom:1px solid rgba(225,6,0,.45);box-shadow:inset 3px 0 0 #E10600}
+.rpb.on{display:flex}
+.rpb.done{border-bottom-color:rgba(79,178,134,.45);box-shadow:inset 3px 0 0 #4FB286}
+.rpb button{font-family:'Rajdhani',system-ui,sans-serif;font-weight:600;letter-spacing:.07em;text-transform:uppercase;font-size:11.5px;color:#ECE7DB;background:#B3000C;border:1px solid #B3000C;border-radius:7px;padding:6px 13px;cursor:pointer;margin-left:auto}
+.rpb button:hover{background:#E10600}
+.rpb button[disabled]{opacity:.5;cursor:not-allowed}
+</style>
+<div class="rpb" id="rpb"><span id="rpb_txt"><#RBKP_6#></span><button id="rpb_go" type="button"><#RBKP_7#></button></div>
+<script>(function(){
+  var hid='<% nvram_get("http_id"); %>';
+  var bar=document.getElementById('rpb'),txt=document.getElementById('rpb_txt'),go=document.getElementById('rpb_go');
+  var x=new XMLHttpRequest();
+  x.open('GET','/reaper_cfg.cgi?action=pending&http_id='+encodeURIComponent(hid)+'&_='+Date.now(),true);
+  x.timeout=8000;
+  x.onload=function(){
+    var j=null;try{j=JSON.parse(x.responseText);}catch(e){}
+    if(j&&j.ok&&j.pending)bar.className='rpb on';
+  };
+  x.send();
+  go.onclick=function(){
+    go.disabled=true;
+    var q=new XMLHttpRequest();
+    q.open('POST','/reaper_cfg.cgi',true);
+    q.setRequestHeader('Content-Type','application/x-www-form-urlencoded');
+    q.onloadend=function(){
+      var r=null;try{r=JSON.parse(q.responseText);}catch(e){}
+      if(!r||!r.ok){go.disabled=false;txt.textContent=`<#RBKP_14#>`;return;}
+      bar.className='rpb on done';go.style.display='none';
+      txt.textContent=`<#RBKP_11#>`.replace('%1',r.flags).replace('%2',r.lists).replace('%3',r.rejected);
+    };
+    q.send('action=import_pending&http_id='+encodeURIComponent(hid));
+  };
+})();</script>
