+
+  <div class="card" id="jffs_card">
+    <h2><#RDSH_12#></h2>
+    <div class="tag"><#RBKP_25#></div>
+    <div class="desc"><#RBKP_21#></div>
+    <div class="row">
+      <button class="btn" id="jffs_save" type="button"><#CTL_onlysave#></button>
+      <button class="btn" id="jffs_up" type="button"><#CTL_upload#></button>
+      <input id="jffs_file" type="file" accept=".tar" style="display:none">
+    </div>
