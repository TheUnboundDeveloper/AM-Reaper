+.btn.doom{border-color:rgba(225,6,0,.55);color:var(--crimson)}
+.btn.doom:hover{background:var(--crimson-deep);color:var(--bone);border-color:var(--crimson-deep)}
 .btn[disabled]{opacity:.4;cursor:not-allowed}
-.stat{display:none;font-size:12px;margin-top:10px}
+
+/* ---------- vault grid ---------- */
+.tier{font-family:var(--hdr);font-weight:600;font-size:11.5px;letter-spacing:.16em;text-transform:uppercase;
+  color:var(--steel);display:flex;align-items:center;gap:12px;margin:24px 0 12px}
+.tier::after{content:"";flex:1;height:1px;background:var(--line-soft)}
+.tier .tn{color:#3a3a40;font-variant-numeric:tabular-nums}
+.grid{display:grid;grid-template-columns:1.35fr 1fr;gap:15px}
+.grid.even{grid-template-columns:1fr 1fr}
+@media (max-width:900px){.grid,.grid.even{grid-template-columns:1fr}}
+.card{position:relative;background:var(--panel);border:1px solid var(--line-soft);border-radius:14px;
+  padding:18px 20px;display:flex;flex-direction:column;min-width:0}
+.card.hero{border-color:var(--line-crimson);
+  background:radial-gradient(90% 120% at 8% 0%,rgba(225,6,0,.10),transparent 55%),var(--panel)}
+.card.hero::before{content:"";position:absolute;left:0;top:14px;bottom:14px;width:3px;border-radius:3px;background:var(--crimson)}
+.chead{display:flex;align-items:center;gap:13px;margin-bottom:4px}
+.cico{width:38px;height:38px;flex:0 0 auto;border-radius:10px;border:1px solid var(--line-soft);
+  background:var(--panel-2);display:flex;align-items:center;justify-content:center}
+.cico svg{width:20px;height:20px;stroke:var(--bone-dim);fill:none;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round}
+.card.hero .cico{border-color:var(--line-crimson)}
+.card.hero .cico svg{stroke:var(--crimson)}
+.card h2{font-family:var(--hdr);font-weight:700;font-size:17px;letter-spacing:.04em;color:var(--bone)}
+.ctag{font-family:var(--hdr);font-weight:600;font-size:10px;letter-spacing:.14em;text-transform:uppercase;color:var(--steel);
+  margin:2px 0 12px 51px;padding-bottom:10px;border-bottom:1px solid var(--line-soft)}
+.card p{font-size:12.3px;line-height:1.6;color:var(--bone-dim);margin-bottom:13px;max-width:66ch}
+.acts{display:flex;gap:9px;flex-wrap:wrap;align-items:center;margin-top:auto;padding-top:4px}
+.fine{font-size:11px;color:var(--steel);line-height:1.55;margin-top:11px;max-width:70ch}
+.chk{display:flex;gap:9px;align-items:flex-start;font-size:11.3px;color:var(--bone-dim);margin-top:11px;max-width:66ch}
+.chk input{margin-top:2px;accent-color:#71767b}
+.stat{display:none;font-size:12px;margin-top:11px}
 .stat.ok{display:block;color:var(--jade)}
 .stat.err{display:block;color:var(--danger)}
+
+/* ---------- danger quarantine ---------- */
+.dzone{margin-top:24px;border:1px solid rgba(225,6,0,.4);border-radius:14px;background:var(--panel);overflow:hidden}
+.dz-stripe{height:8px;background:repeating-linear-gradient(-45deg,var(--crimson-deep) 0 12px,#1a0b0b 12px 24px);opacity:.75}
+.dz-body{display:flex;gap:18px;align-items:flex-start;padding:16px 20px 18px;flex-wrap:wrap}
+.dz-ico{width:38px;height:38px;flex:0 0 auto;border-radius:10px;border:1px solid rgba(225,6,0,.4);
+  background:rgba(225,6,0,.08);display:flex;align-items:center;justify-content:center;
+  font:700 19px/1 var(--hdr);color:var(--crimson)}
+.dz-t{flex:1 1 340px;min-width:0}
+.dz-t h2{font-family:var(--hdr);font-weight:700;font-size:16.5px;letter-spacing:.05em;color:var(--bone);text-transform:uppercase}
+.dz-t p{font-size:12.3px;color:var(--bone-dim);margin-top:5px;max-width:72ch}
+.dz-act{display:flex;flex-direction:column;gap:10px;align-items:flex-end;margin-left:auto}
+
+/* ---------- overlay (rule 35 class) ---------- */
 .ovl{display:none;position:fixed;inset:0;z-index:1000;background:rgba(4,4,5,.88);align-items:center;justify-content:center;text-align:center}
 .ovl.on{display:flex}
 .ovl .box{max-width:520px;padding:28px 30px}
