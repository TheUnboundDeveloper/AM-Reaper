+var RP_SDN_MIGRATED = (httpApi.nvramGet(["sdn_rl"]).sdn_rl || '').indexOf('MAINFH') >= 0;
 var RP_NETPAGE = '/reaper_shell.asp#SDN.asp';
 
 function setupSmartConnectToggle(){
diff --git a/release/src/router/www/Reaper_Devices.asp b/release/src/router/www/Reaper_Devices.asp
index 02ed86e9e4..39cd7a7d1b 100644
--- a/release/src/router/www/Reaper_Devices.asp
+++ b/release/src/router/www/Reaper_Devices.asp
@@ -236,6 +236,11 @@ function expRows(){
 }
 function csvCell(s){
   s = String(s == null ? '' : s);
+  /* Neutralize spreadsheet formula injection: a device/DHCP hostname is
+     attacker-chosen (a LAN client names itself), and a cell beginning = + - @
+     or a tab/CR is executed as a formula by Excel/Sheets. Prefix a single
+     quote so the cell is read as text. Do this BEFORE RFC-4180 quoting. */
+  if (/^[=+\-@\t\r]/.test(s)) s = "'" + s;
   return /[",\r\n]/.test(s) ? '"' + s.replace(/"/g, '""') + '"' : s;   /* RFC 4180 */
 }
 function expBuild(fmt, rows, stamp){
