diff --git a/release/src/router/httpd/web.c b/release/src/router/httpd/web.c
index be7d80f916..7c9080795c 100644
--- a/release/src/router/httpd/web.c
+++ b/release/src/router/httpd/web.c
@@ -24918,18 +24918,18 @@ do_reaper_restore_post(char *url, FILE *stream, int len, char *boundary)
 
 	/* walk the parts: capture http_id, stop at the file */
 	while (len > 0) {
-		if (!fgets(buf, MIN(len + 1, (int)sizeof(buf)), stream)) goto out;
+		if (!fgets(buf, MIN(len + 1, sizeof(buf)), stream)) goto out;
 		len -= strlen(buf);
 		if (strncasecmp(buf, "Content-Disposition:", 20) != 0) continue;
 		if (strstr(buf, "name=\"file\"")) break;
 		if (strstr(buf, "name=\"http_id\"")) {
 			/* blank line then the value line */
 			while (len > 0) {
-				if (!fgets(buf, MIN(len + 1, (int)sizeof(buf)), stream)) goto out;
+				if (!fgets(buf, MIN(len + 1, sizeof(buf)), stream)) goto out;
 				len -= strlen(buf);
 				if (!strcmp(buf, "\n") || !strcmp(buf, "\r\n")) break;
 			}
-			if (len > 0 && fgets(buf, MIN(len + 1, (int)sizeof(buf)), stream)) {
+			if (len > 0 && fgets(buf, MIN(len + 1, sizeof(buf)), stream)) {
 				len -= strlen(buf);
 				buf[strcspn(buf, "\r\n")] = '\0';
 				strlcpy(rbk_up.hid, buf, sizeof(rbk_up.hid));
@@ -24941,18 +24941,18 @@ do_reaper_restore_post(char *url, FILE *stream, int len, char *boundary)
 	/* skip the file part's remaining headers */
 	why = "file-part-headers";
 	while (len > 0) {
-		if (!fgets(buf, MIN(len + 1, (int)sizeof(buf)), stream)) goto out;
+		if (!fgets(buf, MIN(len + 1, sizeof(buf)), stream)) goto out;
 		len -= strlen(buf);
 		if (!strcmp(buf, "\n") || !strcmp(buf, "\r\n")) break;
 	}
 
 	/* magic line, then the meta line (both short text) */
 	why = "magic";
-	if (len <= 0 || !fgets(buf, MIN(len + 1, (int)sizeof(buf)), stream)) goto out;
+	if (len <= 0 || !fgets(buf, MIN(len + 1, sizeof(buf)), stream)) goto out;
 	len -= strlen(buf);
 	if (strcmp(buf, RBK_MAGIC) != 0) goto out;
 	why = "meta";
-	if (len <= 0 || !fgets(buf, MIN(len + 1, (int)sizeof(buf)), stream)) goto out;
+	if (len <= 0 || !fgets(buf, MIN(len + 1, sizeof(buf)), stream)) goto out;
 	len -= strlen(buf);
 	if (strlen(buf) >= RBK_META_MAX) goto out;
 	meta = json_tokener_parse(buf);
@@ -39373,6 +39373,34 @@ ej_dns_status(int eid, webs_t wp, int argc, char_t **argv)
 	return 0;
 }
 
+/* reaper v3.0.0 (security review): the three DNS-stat wrappers below fed
+ * client/mode/dura/date straight into dns_sqlite_Stat_hook() ("SELECT %s ...
+ * WHERE mac=\"%s\"") with no validation, unlike their sibling ej_dns_status.
+ * A CSRF'd admin (these pages carry no Referer whitelist entry) could inject
+ * SQL through the blob. Mirror ej_dns_status: MAC-or-empty client, enum-token
+ * mode, whitelisted dura, timestamp-or-empty date. Anything out of spec emits
+ * an empty array, exactly as ej_dns_status does on a failed check. */
+static int
+reaper_dns_stat_args_ok(char *client, char *mode, char *dura, char *date)
+{
+	char *p;
+
+	if (*client != '\0' && !isValidMacAddress(client))
+		return 0;
+	if (*mode == '\0')
+		return 0;
+	for (p = mode; *p; p++)
+		if (!((*p >= 'A' && *p <= 'Z') || (*p >= 'a' && *p <= 'z') ||
+		      (*p >= '0' && *p <= '9') || *p == '_'))
+			return 0;
+	if (strcmp(dura, "realtime") && strcmp(dura, "month") &&
+	    strcmp(dura, "week") && strcmp(dura, "day"))
+		return 0;
+	if (*date != '\0' && !isValidtimestamp_noletter(date))
+		return 0;
+	return 1;
+}
+
 static int
 ej_dns_appStat(int eid, webs_t wp, int argc, char_t **argv)
 {
@@ -39384,6 +39412,10 @@ ej_dns_appStat(int eid, webs_t wp, int argc, char_t **argv)
         dura = websGetVar(wp, "dura", "");
         date = websGetVar(wp, "date", "");
 
+        if (!reaper_dns_stat_args_ok(client, mode, dura, date)) {
+                websWrite(wp, "[]");
+                return 0;
+        }
         // 0: app, 1: mac
         dns_sqlite_Stat_hook(0, client, mode, dura, date, &retval, wp);
 
@@ -39401,6 +39433,10 @@ ej_dns_wanStat(int eid, webs_t wp, int argc, char_t **argv)
         dura = websGetVar(wp, "dura", "");
         date = websGetVar(wp, "date", "");
 
+        if (!reaper_dns_stat_args_ok(client, mode, dura, date)) {
+                websWrite(wp, "[]");
+                return 0;
+        }
         // 0: app, 1: mac
         dns_sqlite_Stat_hook(1, client, mode, dura, date, &retval, wp);
 
@@ -39418,6 +39454,10 @@ ej_dns_wanStat_detail(int eid, webs_t wp, int argc, char_t **argv)
 	dura = websGetVar(wp, "dura", "");
 	date = websGetVar(wp, "date", "");
 
+	if (!reaper_dns_stat_args_ok(client, mode, dura, date)) {
+		websWrite(wp, "[]");
+		return 0;
+	}
 	// 0: app, 1: mac
 	dns_sqlite_Stat_hook(2, client, mode, dura, date, &retval, wp);
 
