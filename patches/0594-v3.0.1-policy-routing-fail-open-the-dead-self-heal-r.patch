+++ b/release/src/router/httpd/web.c
@@ -23748,10 +23748,18 @@ fw_emit_cmd(FILE *stream, const char *cmd, size_t cap)
 }
 
 /* a syslog line belongs to the drops viewer iff klogd tagged it kernel:
- * and it carries one of the three firewall LOG prefixes this build can
- * emit (complete inventory, rc/ grep 2026-08-10): "DROP " / "ACCEPT "
- * (fw_log_x target chains, --state NEW only) and "REAPER-WARDEN "
- * (rwarden_log=1, every packet). Gatekeeper drops emit no LOG rules. */
+ * and it carries one of the firewall LOG prefixes this build can emit:
+ * "DROP " / "ACCEPT " (fw_log_x target chains, --state NEW only) and the
+ * Warden family (rwarden_log=1, every packet) - "REAPER-WARDEN ",
+ * "REAPER-WARDEN-OUT " and "REAPER-WARDEN-SELF ", emitted by rwarden.c.
+ * Gatekeeper drops emit no LOG rules.
+ * The Warden test is deliberately WITHOUT a trailing space so it admits the
+ * whole family: matching "REAPER-WARDEN " could never match the -OUT/-SELF
+ * prefixes (the next character is '-'), so from v2.4.2 - which gave outbound
+ * drops their own prefix - to v3.0.0 every outbound block was dropped here
+ * before it reached the browser, and the page looked like outbound logging
+ * had been switched off. Keep any new prefix a strict extension of this one,
+ * or update reaper_static_checks.py's warden-log-prefix-contract with it. */
 static int
 fw_line_is_fwlog(const char *line)
 {
@@ -23759,7 +23767,7 @@ fw_line_is_fwlog(const char *line)
 	if (!k) return 0;
 	return (strstr(k, "DROP IN=") != NULL ||
 		strstr(k, "ACCEPT IN=") != NULL ||
-		strstr(k, "REAPER-WARDEN ") != NULL);
+		strstr(k, "REAPER-WARDEN") != NULL);
 }
 
 #define FW_DROPS_MAX	400
diff --git a/release/src/router/others/reaper_diag b/release/src/router/others/reaper_diag
index 2ba6cee217..5598080a66 100644
--- a/release/src/router/others/reaper_diag
+++ b/release/src/router/others/reaper_diag
@@ -48,7 +48,7 @@
 #  are one-shot cats. Do not add an unbounded command here.
 # ============================================================================
 PATH=/sbin:/bin:/usr/sbin:/usr/bin
-VER="REAPER-DIAG v1.3.10"
+VER="REAPER-DIAG v1.3.11"
 T0="$(date +%s 2>/dev/null)"
 MODEL="$(nvram get productid 2>/dev/null)"
 EXTNO="$(nvram get extendno 2>/dev/null)"
@@ -612,6 +612,9 @@ echo "  policy routing    : reaper_pbr_enable=$(nvram get reaper_pbr_enable 2>/d
 echo "  exporter          : reaper_export_mode=$(nvram get reaper_export_mode 2>/dev/null)"
 echo "  -- cron (cru l) --"; cru l 2>/dev/null | sed 's/^/  /'
 [ "$(nvram get rwarden_enable 2>/dev/null)" = 1 ] && ! iptables -nL REAPER_WARDEN >/dev/null 2>&1 && finding WARN "Warden enabled but REAPER_WARDEN chain absent"
+_wdir="$(nvram get rwarden_dir 2>/dev/null)"
+[ "$(nvram get rwarden_enable 2>/dev/null)" = 1 ] && { [ "$_wdir" = both ] || [ "$_wdir" = out ]; } && ! iptables -nL RW_ODROP >/dev/null 2>&1 && finding WARN "Warden outbound enforcement is configured (rwarden_dir=$_wdir) but the RW_ODROP chain is absent - outbound blocks are neither dropped nor logged (see 14)"
+[ "$(nvram get rwarden_enable 2>/dev/null)" = 1 ] && [ "$(nvram get rwarden_log 2>/dev/null)" = 1 ] && iptables -nL RW_ODROP >/dev/null 2>&1 && [ "$(iptables -S RW_ODROP 2>/dev/null | grep -c 'j LOG')" = 0 ] && finding WARN "Warden logging is on and the outbound chain exists, but RW_ODROP carries no LOG rule - outbound blocks are dropped silently (see 14)"
 [ "$(nvram get rwatch_enable 2>/dev/null)" = 1 ] && [ "$(cru l 2>/dev/null | grep -c '#rwatch#')" = 0 ] && finding WARN "rwatch enabled but its cron line is missing"
 
 sec "13. ADDONS / JFFS"
@@ -727,6 +730,11 @@ ip -4 rule list 2>/dev/null | awk -F: '$1+0>=9000 && $1+0<=9199' | sed 's/^/
 ip -6 rule list 2>/dev/null | awk -F: '$1+0>=9000 && $1+0<=9199' | sed 's/^/    rule6 /'
 [ -r /proc/blog/skip_wireguard_network ] && echo "  wg accel bypass   : $(grep -c . /proc/blog/skip_wireguard_network 2>/dev/null) net(s) listed ($(awk '$2=="new"' /tmp/reaper_pbr/skipnets 2>/dev/null | wc -l) added by policy routing)"
 [ "$(nvram get reaper_pbr_enable 2>/dev/null)" = 1 ] && [ "$(iptables -t mangle -S PREROUTING 2>/dev/null | grep -c 'j REAPER_PBR')" = 0 ] && finding WARN "policy routing is enabled but its PREROUTING jump is missing (see 14e)"
+_pbrx="$(cat /tmp/reaper_pbr/expect_rules 2>/dev/null)"; case "$_pbrx" in ''|*[!0-9]*) _pbrx=0;; esac
+_pbrl="$(ip -4 rule show 2>/dev/null | grep -cE 'fwmark 0x[0-9a-fA-F]+/0x0*[fF]0000')"; case "$_pbrl" in ''|*[!0-9]*) _pbrl=0;; esac
+[ "$(nvram get reaper_pbr_enable 2>/dev/null)" = 1 ] && [ "$_pbrx" -gt 0 ] && [ "$_pbrl" = 0 ] && finding WARN "policy routing marks are being set but NO ip rules are live ($_pbrl of $_pbrx) - IPv4 traffic pinned to a tunnel is following the main table OUT OF THE WAN and BLOCK rules are not blocking; something flushed the rule table and it was not re-asserted (see 14e)"
+[ -f /tmp/reaper_pbr/heal.rgaveup ] && finding WARN "the policy-routing ip-rule self-heal gave up after 5 attempts - the rules are still missing (see 14e)"
+[ -f /tmp/reaper_pbr/heal.gaveup ] && finding WARN "the policy-routing mark self-heal gave up after 5 attempts - the mangle chain is still short (see 14e)"
 echo "  -- ip rule bands (9000-9999 = Reaper PBR, 10000+ = VPN Director) --"
 ip rule list 2>/dev/null | awk '$1+0 >= 9000 && $1+0 < 20000' | sed 's/^/  /' | head -40
 echo "  -- tunnels --"
diff --git a/release/src/router/rc/Makefile b/release/src/router/rc/Makefile
index 41ff47808f..0cb9492cf2 100644
--- a/release/src/router/rc/Makefile
+++ b/release/src/router/rc/Makefile
@@ -1784,6 +1784,12 @@ ifeq ($(CONFIG_BCMWL5),y)
 	@cd $(INSTALLDIR)/sbin && ln -sf rc setup_dnsmq
 endif
 	@cd $(INSTALLDIR)/sbin && ln -sf rc add_multi_routes
+# reaper: rc dispatches applets by argv[0] basename ONLY. The argv shift for an
+# `rc <applet>` invocation is #if 0 in rc.c and DEBUG_RCTEST maps a bare "rc" to
+# rctest_main, so without this symlink reaper_lockrun_main is unreachable and every
+# rwatch self-heal (policy routing AND the Warden CRITICAL heal) silently does
+# nothing - which is exactly what happened from v2.7.3 to v3.0.0.
+	@cd $(INSTALLDIR)/sbin && ln -sf rc reaper_lockrun
 
 	@cd $(INSTALLDIR)/sbin && ln -sf rc free_caches
 	@cd $(INSTALLDIR)/sbin && ln -sf rc get_phy_status
diff --git a/release/src/router/rc/rc.c b/release/src/router/rc/rc.c
index 944645f301..31ea27c28f 100644
--- a/release/src/router/rc/rc.c
+++ b/release/src/router/rc/rc.c
@@ -5038,10 +5038,17 @@ int main(int argc, char **argv)
 	}
 #endif
 	else if (!strcmp(base, "add_multi_routes")) {
-		if(argc == 2)
-			return add_multi_routes(safe_atoi(argv[1]), -1);
-		else
-			return add_multi_routes(0, -1);
+		int amr_rc;
+		amr_rc = (argc == 2) ? add_multi_routes(safe_atoi(argv[1]), -1)
+				     : add_multi_routes(0, -1);
+		/* the applet flushes the IPv4 rule table exactly like the in-process
+		 * callers do - see the note in wan_up(). Without this re-assert the
+		 * whole PBR pref band stays gone until the next UI Apply, which is a
+		 * FAIL-OPEN: marks keep being set with no rule left to select on.
+		 * (The amvpn_set_kilswitch_rules_all() below sits after the returns
+		 * this replaces and is unreachable upstream dead code; left as-is.) */
+		reaper_pbr_reassert();
+		return amr_rc;
 #if defined(RTCONFIG_WIREGUARD) || defined(RTCONFIG_OPENVPN)
 		amvpn_set_kilswitch_rules_all();
 #endif
