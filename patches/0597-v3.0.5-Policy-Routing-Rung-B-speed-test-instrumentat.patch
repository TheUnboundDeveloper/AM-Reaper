+   log line. Escaped: it is the engine's text, shown inside our HTML alert. */
+function last_engine_error(){
+	var i, e, s = "";
+	for(i = speedTest_result.length - 1; i >= 0; i--){
+		e = speedTest_result[i];
+		if(!e) continue;
+		if(typeof e.error == "string" && e.error){ s = e.error; break; }
+		if(e.level == "error" && typeof e.message == "string" && e.message){ s = e.message; break; }
+	}
+	if(!s) return "-";
+	return $("<div>").text(s.substring(0, 160)).html();
+}
