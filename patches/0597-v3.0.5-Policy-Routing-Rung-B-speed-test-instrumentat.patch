 }
 
+/* reaper v3.0.5: say what QoS caps this connection at, where the number is
+   read. Any enabled QoS engine shapes the WAN below line rate by design, and
+   that ceiling sits ABOVE every socket or CPU limit a speed test could hit -
+   on a 10G WAN with a 2.2 Gbit/s plan every result reads ~2.2 Gbit/s however
+   the sockets are tuned (metal, 2026-09-01). Per engine, mirroring rc/qos.c:
+   type 1 shapes both ways at the entered figures; type 9 (cake) applies the
+   90% headroom to both; type 11 upload = qos_obw (the port shaper; class
+   queues sit at 90-95% of it) and download = 90% of qos_ibw when the policer
+   is on; type 10 shapes upload only (qid0). */
+function show_qos_cap_hint(){
+	var q = httpApi.nvramGet(["qos_enable", "qos_type", "qos_obw", "qos_ibw", "qos_ipolicer"], true);
+	var obw = parseInt(q.qos_obw, 10) || 0, ibw = parseInt(q.qos_ibw, 10) || 0, t = String(q.qos_type);
+	if(q.qos_enable != "1" || obw <= 0) return;
+	var up = obw, down = 0;
+	if(t == "9"){ up = obw - Math.floor(obw / 10); down = ibw - Math.floor(ibw / 10); }
+	else if(t == "11"){ down = (q.qos_ipolicer != "0") ? ibw - Math.floor(ibw / 10) : 0; }
+	else if(t == "1"){ down = ibw; }
+	var mbps = function(k){ return (k / 1000).toFixed(0) + " <#InternetSpeed_Mbps#>"; };
+	var parts = [];
+	if(down > 0) parts.push(mbps(down) + " <#InternetSpeed_Download#>");
+	parts.push(mbps(up) + " <#InternetSpeed_Upload#>");
+	$("#qos_cap_text").text(`<#RSPD_1#>`.replace("%1", parts.join(", ")));
+	$("#qos_cap_hint").css("display", "flex");
+	/* one line, clipped; the full sentence rides on a hover tooltip only while
+	   it is actually clipped (measured after the pill is shown) */
+	var e = document.getElementById("qos_cap_text");
+	if(e.scrollWidth > e.clientWidth + 1) e.title = e.textContent; else e.removeAttribute("title");
+}
