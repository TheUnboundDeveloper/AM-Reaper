-UPR="$(awk '/^nameserver/{print $2}' /tmp/resolv.dnsmasq 2>/dev/null | tr '\n' ' ')"
-[ -n "$UPR" ] || UPR="$(nvram get wan0_dns 2>/dev/null) (from wan0_dns; dnsmasq not forwarding upstream)"
-echo "  upstream resolvers: $UPR"
+# v1.3.13: /tmp/resolv.dnsmasq is dnsmasq's SERVERS-FILE (rc/wan.c wan_add_resolv_dnsmasq
+# writes `server=<ip>` and `server=/<domain>/<ip>` lines), NOT a resolv.conf - the old
+# `nameserver` match could never hit, so EVERY report said "dnsmasq not forwarding
+# upstream" while the syslog plainly showed "using nameserver X#53". In router mode
+# dnsmasq runs no-resolv, so this file IS its complete upstream list.
+UPR="$(sed -n 's/^server=\([^/][^# ]*\).*/\1/p' /tmp/resolv.dnsmasq 2>/dev/null | sort -u | tr '\n' ' ')"
+UPRD="$(grep -c '^server=/' /tmp/resolv.dnsmasq 2>/dev/null)"; case "$UPRD" in ''|*[!0-9]*) UPRD=0;; esac
+if [ -n "$UPR" ]; then
+  echo "  upstream resolvers: $UPR(dnsmasq servers-file; $UPRD domain-scoped entries)"
+else
+  echo "  upstream resolvers: NONE in /tmp/resolv.dnsmasq (wan0_dns=$(nvram get wan0_dns 2>/dev/null)) - dnsmasq is forwarding nowhere; the syslog 'using nameserver' lines in 19 are the truth"
+  [ "$(nvram get wan0_state_t 2>/dev/null)" = 2 ] && finding INFO "dnsmasq has no upstream resolver in its servers-file while the WAN is up (see 5)"
+fi
 echo "  dns-over-tls      : dnspriv_enable=$(nvram get dnspriv_enable 2>/dev/null)"
 echo "  wanduck           : link_internet=$(nvram get link_internet 2>/dev/null) wandog=$(nvram get wandog_enable 2>/dev/null)"
