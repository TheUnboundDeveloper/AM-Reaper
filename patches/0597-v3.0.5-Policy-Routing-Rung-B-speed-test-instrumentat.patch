   done
 fi
 
+# v1.3.13: an enabled QoS engine shapes the WAN below line rate BY DESIGN, and that
+# ceiling sits ABOVE every socket/CPU limit a speed test could otherwise hit. Metal
+# 2026-09-01: a 10G WAN with type-11 qos_obw=qos_ibw=2200000 read ~2.0-2.2 Gbit/s on
+# every test and no socket-buffer work could move it. Name the ceiling up front.
+_qo="$(nvram get qos_obw 2>/dev/null)"; case "$_qo" in ''|*[!0-9]*) _qo=0;; esac
+_qi="$(nvram get qos_ibw 2>/dev/null)"; case "$_qi" in ''|*[!0-9]*) _qi=0;; esac
+if [ "$QE" = 1 ] && [ "$_qo" -gt 0 ]; then
+  _ls="$(cat /sys/class/net/$WANIF/speed 2>/dev/null)"; case "$_ls" in ''|*[!0-9]*) _ls=0;; esac
+  _qp=""; if [ "$QT" = 9 ] || { [ "$QT" = 11 ] && [ "$(nvram get qos_ipolicer 2>/dev/null)" != 0 ]; }; then _qp=" (policed at 90%)"; fi
+  _qd=""; [ "$_qi" -gt 0 ] && [ "$QT" != 10 ] && _qd=" / $((_qi/1000)) Mbit/s down$_qp"
+  _ql=""; [ "$_ls" -gt 0 ] && _ql=" - the link itself negotiated $_ls Mbit/s"
+  finding INFO "QoS (type $QT) caps the WAN at $((_qo/1000)) Mbit/s up$_qd; no speed test - built-in or through the router - can read above that while QoS is on$_ql (see 10)"
+fi
+
+sec "10b. INTERNET SPEED TEST (engine, host-TCP offload, last run - addresses never printed)"
+# v1.3.13 (2026-09-02, the 10 Gbit/s field reports): what a failing run leaves behind. Stock and
+# Reaper ship the SAME engine, config, kernel and RT budget (verified against the stock GPL
+# drops and an inflated stock kernel); no stock model carries a speed-test driver. Multi-gigabit
+# is reachable only because host TCP rides the Runner (GDX/HTOA, license-gated), so the offload
+# state comes first. The engine's stderr was discarded until v3.0.5 (ookla_run keeps it).
+OK_DIR=/jffs/.sys/OOKLA; [ -d /tmp/OOKLA ] && [ ! -d "$OK_DIR" ] && OK_DIR=/tmp/OOKLA
+echo "  engine            : v$(grep -a -o -m1 -E '3\.[0-9]+\.[0-9]+\.[0-9]+' /usr/sbin/ookla 2>/dev/null || echo ?)  $(ls -l /usr/sbin/ookla 2>/dev/null | awk '{print $5}') bytes  launcher=$([ -x /usr/sbin/ookla_run ] && echo ookla_run || echo direct)  rc_support ookla=$(nvram get rc_support 2>/dev/null | grep -c -w ookla)"
+echo "  ookla_state       : $(nvram get ookla_state 2>/dev/null)  (0 idle, 1 running, 2 wan-down, 3 timeout, 4 engine-error, 5 launch-failed)"
+_hl="$(dmesg 2>/dev/null | grep -o 'HTOA license[^*]*' | tail -1)"
+echo "  host tcp offload  : ${_hl:-license line no longer in the kernel ring buffer - read /proc/gdx/stats below}"
+echo "  gdx blogtcp_local : $(awk '/blogtcp_local/{f=1} f&&/dev_tx_pkts/{print "tx_pkts=" $3; exit}' /proc/gdx/stats 2>/dev/null) $(awk '/blogtcp_local/{f=1} f&&/dev_rx_pkts/{print "rx_pkts=" $3; exit}' /proc/gdx/stats 2>/dev/null)  (a multi-gigabit run adds millions here; 0 = host TCP is NOT offloaded)"
+echo "  conntrack hwaccel : $(grep -c 'hwaccel=[1-9]' /proc/net/nf_conntrack 2>/dev/null) of $(wc -l < /proc/net/nf_conntrack 2>/dev/null) flows"
+echo "  rt budget         : sched_rt_runtime_us=$(cat /proc/sys/kernel/sched_rt_runtime_us 2>/dev/null) of period $(cat /proc/sys/kernel/sched_rt_period_us 2>/dev/null)   'RT throttling activated' this boot: $(dmesg 2>/dev/null | grep -c 'RT throttling')"
+if [ -f "$OK_DIR/ookla_result" ]; then
+  echo "  -- last run: $OK_DIR/ookla_result ($(ls -l "$OK_DIR/ookla_result" 2>/dev/null | awk '{print $6, $7, $8}')) --"
+  echo "  entries by type   : $(grep -o '"type":"[a-zA-Z]*"' "$OK_DIR/ookla_result" 2>/dev/null | sed 's/"type"://; s/"//g' | sort | uniq -c | awk '{printf "%s=%s ", $2, $1}')"
+  echo "  error lines       : level=error $(grep -c '"level":"error"' "$OK_DIR/ookla_result" 2>/dev/null)   fatal {\"error\"} $(grep -c '^{"error"' "$OK_DIR/ookla_result" 2>/dev/null)"
+  _r="$(grep '"type":"result"' "$OK_DIR/ookla_result" 2>/dev/null | tail -1)"
+  if [ -n "$_r" ]; then
+    echo "  result            : down=$(echo "$_r" | sed -n 's/.*"download":{"bandwidth":\([0-9]*\).*/\1/p') B/s  up=$(echo "$_r" | sed -n 's/.*"upload":{"bandwidth":\([0-9]*\).*/\1/p') B/s  ping=$(echo "$_r" | sed -n 's/.*"latency":\([0-9.]*\).*/\1/p') ms"
+  else
+    echo "  result            : NONE - the run never produced a result entry"
+  fi
+  echo "  -- engine messages (last 8, error/warning level; the engine's own words) --"
+  grep -E '"level":"(error|warning)"' "$OK_DIR/ookla_result" 2>/dev/null | tail -8 | sed -n 's/.*"message":"\([^"]*\)".*/     \1/p'
+  grep '^{"error"' "$OK_DIR/ookla_result" 2>/dev/null | tail -2 | cut -c1-200 | sed 's/^/     /'
+else
+  echo "  -- last run: no result file under $OK_DIR (never run, or /jffs/.sys wiped) --"
+fi
+if [ -s "$OK_DIR/ookla_stderr" ]; then echo "  -- engine stderr (tail) --"; tail -8 "$OK_DIR/ookla_stderr" | cut -c1-200 | sed 's/^/     /'; else echo "  engine stderr     : empty, or not kept (pre-v3.0.5 build)"; fi
+case "$(nvram get ookla_state 2>/dev/null)" in
+  3) finding WARN "the last Internet speed test TIMED OUT (ookla_state=3) - see 10b for the engine's last messages";;
+  4) finding WARN "the last Internet speed test ended on an ENGINE ERROR (ookla_state=4) - see 10b for its message";;
+  5) finding WARN "the last Internet speed test could not START its engine (ookla_state=5) - see 10b";;
+esac
+[ "$(dmesg 2>/dev/null | grep -c 'RT throttling')" -gt 0 ] && finding INFO "the kernel throttled Broadcom's real-time packet threads at least once this boot ('RT throttling activated') - normal during a multi-gigabit speed test; correlate with a failed run (see 10b)"
+
 sec "11. DHCP LEASES (identities pseudonymized)"
 for LF in /var/lib/misc/dnsmasq.leases /tmp/var/lib/misc/dnsmasq.leases; do
   if [ -f "$LF" ]; then
@@ -562,6 +624,17 @@ for k in nf_conntrack_tcp_timeout_established nf_conntrack_tcp_timeout_time_wait
   printf "  %-40s %s\n" "$k" "$(cat /proc/sys/net/netfilter/$k 2>/dev/null)"
 done
 echo "  ct_tcp_timeout (nvram) : $(nvram get ct_tcp_timeout 2>/dev/null)"
+# v1.3.13: the socket-buffer ceilings. net.core.rmem_max/wmem_max cap any socket that
+# sets SO_RCVBUF/SO_SNDBUF explicitly (throughput tools, the Ookla engine); the stock
+# 212992 holds a single explicit-buffer stream near 85 Mbit/s over a 20 ms path. Since
+# v3.0.3 rc raises both to 16 MB (and netdev_max_backlog to 4096) when the firewall
+# starts. The diag never printed them, so that change was unverifiable in the field.
+echo "  -- socket / queue ceilings (v3.0.3+: rmem_max=wmem_max=16777216, backlog 4096) --"
+for k in core/rmem_max core/wmem_max core/rmem_default core/wmem_default core/netdev_max_backlog core/somaxconn ipv4/tcp_rmem ipv4/tcp_wmem ipv4/tcp_congestion_control; do
+  printf "  %-40s %s\n" "net.$(echo $k | tr / .)" "$(cat /proc/sys/net/$k 2>/dev/null | tr '\t' ' ')"
+done
+_rmx="$(cat /proc/sys/net/core/rmem_max 2>/dev/null)"; case "$_rmx" in ''|*[!0-9]*) _rmx=0;; esac
+[ "$_rmx" -lt 16777216 ] && finding INFO "net.core.rmem_max is $_rmx, below the 16 MB Reaper sets at firewall start since v3.0.3 - an older build, or start_firewall has not run this boot; a single stream to the router itself is capped accordingly (see 11b)"
 
 sec "12. PROCESSES / LISTENING SOCKETS"
 ps w 2>/dev/null | sed 's/^/  /'
@@ -604,7 +677,15 @@ svc() { # name knob expected-running-when
   printf "  %-8s %-22s running=%s\n" "$1" "$2=${_on:-unset}" "$_run"
   if [ "$_on" = "$3" ] && [ "$_run" = 0 ]; then finding WARN "$1 is enabled ($2=$3) but not running"; fi
 }
-svc rtrafd rtraf_enable 1; svc gkd gk_enable 1; svc rchqd rchq_enable 1; svc rmcpd rmcp_port x
+svc rtrafd rtraf_enable 1; svc gkd gk_enable 1; svc rchqd rchq_enable 1
+# v1.3.13: rmcpd is NOT switch-driven. It is never launched at boot; it starts only on an
+# explicit ARM from the Advisor page (httpd writes /tmp/reaper_mcp/session, rc start_rmcp
+# refuses without it) and exits on the arming timeout or Disable. running=0 with no
+# session is the DESIGNED idle state - the old line made it read like a dead service.
+_ms=none; [ -f /tmp/reaper_mcp/session ] && _ms=ARMED
+_mr="$(pidof rmcpd 2>/dev/null | wc -w)"
+printf "  %-8s %-22s running=%s  session=%s (arm-gated: idle=0 is normal)\n" rmcpd "rmcp_port=$(nvram get rmcp_port 2>/dev/null)" "$_mr" "$_ms"
+[ "$_ms" = ARMED ] && [ "$_mr" = 0 ] && finding WARN "an Advisor session is armed (/tmp/reaper_mcp/session) but rmcpd is not running - the daemon exited uncleanly; re-arm from the Advisor page (see 12c)"
