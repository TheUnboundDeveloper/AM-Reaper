From ba8d98b8c3e91244fb3762062c1d6daf7f603b04 Mon Sep 17 00:00:00 2001
From: reaper <theunbounddeveloper@outlook.com>
Date: Wed, 2 Sep 2026 17:45:00 -0400
Subject: [PATCH] v3.0.5: stamp the real version.conf, restore the src-rt
 version.conf symlink

release/src-rt-5.04behnd.4916/version.conf is a symlink to
../src-rt/version.conf; the previous commit had replaced it with a plain
file (sed -i without --follow-symlinks) and left the real file at v3.0.4,
which is the one the build reads.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 release/src-rt-5.04behnd.4916/version.conf | 10 +---------
 release/src-rt/version.conf                |  2 +-
 2 files changed, 2 insertions(+), 10 deletions(-)
 mode change 100644 => 120000 release/src-rt-5.04behnd.4916/version.conf

diff --git a/release/src-rt-5.04behnd.4916/version.conf b/release/src-rt-5.04behnd.4916/version.conf
deleted file mode 100644
index 9ad201f58c..0000000000
--- a/release/src-rt-5.04behnd.4916/version.conf
+++ /dev/null
@@ -1,9 +0,0 @@
-KERNEL_VER=3.0
-FS_VER=0.6
-KERNEL_VER_AM=$(subst .,,$(KERNEL_VER))
-FS_VER_AM=$(subst .,,$(FS_VER))
-
-SERIALNO=102.8
-EXTENDNO=Reaper_v3.0.5
-
-RCNO=0
diff --git a/release/src-rt-5.04behnd.4916/version.conf b/release/src-rt-5.04behnd.4916/version.conf
new file mode 120000
index 0000000000..d98cc20cad
--- /dev/null
+++ b/release/src-rt-5.04behnd.4916/version.conf
@@ -0,0 +1 @@
+../src-rt/version.conf
\ No newline at end of file
diff --git a/release/src-rt/version.conf b/release/src-rt/version.conf
index c915f344e3..9ad201f58c 100644
--- a/release/src-rt/version.conf
+++ b/release/src-rt/version.conf
@@ -4,6 +4,6 @@ KERNEL_VER_AM=$(subst .,,$(KERNEL_VER))
 FS_VER_AM=$(subst .,,$(FS_VER))
 
 SERIALNO=102.8
-EXTENDNO=Reaper_v3.0.4
+EXTENDNO=Reaper_v3.0.5
 
 RCNO=0
-- 
2.25.1

