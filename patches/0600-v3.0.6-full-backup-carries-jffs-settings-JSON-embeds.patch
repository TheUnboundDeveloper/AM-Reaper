+/* reaper v3.0.6: is /jffs a real mount? A bare directory on the rootfs would
+ * tar to nothing useful, and the restore must never wipe it either. */
+static int rbk_jffs_mounted(void)
+{
+	FILE *f = fopen("/proc/mounts", "r");
+	char line[512], dev[128], mnt[128];
+	int found = 0;
+	if (!f) return 0;
+	while (fgets(line, sizeof(line), f)) {
+		if (sscanf(line, "%127s %127s", dev, mnt) == 2 && strcmp(mnt, "/jffs") == 0) { found = 1; break; }
+	}
+	fclose(f);
+	return found;
+}
+
+/* reaper v3.0.6: the whole /jffs partition as one gzip tar at `path` - the
+ * stock JFFS backup's members (tar -C /jffs .), gzip'd. The tar's own exit
+ * status is not trusted (busybox complains about files that change under it)
+ * - the archive is judged by a list pass instead. Returns its size, 0 when
+ * /jffs is not mounted (no part), -1 when the tar is unusable or over the cap
+ * (no part, logged). */
+static long rbk_make_jffs(const char *path)
+{
+	struct stat st;
+	char cmd[300];
+	unlink(path);
+	if (!rbk_jffs_mounted()) {
+		logmessage("reaper_cfg", "full backup: /jffs is not mounted - archive carries settings only");
+		return 0;
+	}
+	snprintf(cmd, sizeof(cmd), "tar czf %s -C /jffs . 2>/dev/null", path);
+	system(cmd);
+	if (stat(path, &st) != 0 || !S_ISREG(st.st_mode) || st.st_size < 64) {
+		logmessage("reaper_cfg", "full backup: /jffs tar failed - archive carries settings only");
+		unlink(path);
+		return -1;
+	}
+	if (st.st_size > RBK_JFFS_MAX) {
+		logmessage("reaper_cfg", "full backup: /jffs tar is %lld bytes, over the %ld MB cap - archive carries settings only",
+			   (long long)st.st_size, RBK_JFFS_MAX / (1024 * 1024));
+		unlink(path);
+		return -1;
+	}
+	snprintf(cmd, sizeof(cmd), "tar -tzf %s >/dev/null 2>&1", path);
+	if (system(cmd) != 0) {
+		logmessage("reaper_cfg", "full backup: /jffs tar does not list cleanly - archive carries settings only");
+		unlink(path);
+		return -1;
+	}
+	return (long)st.st_size;
+}
