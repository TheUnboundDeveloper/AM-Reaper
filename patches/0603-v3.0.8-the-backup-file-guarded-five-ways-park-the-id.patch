+	if (!json_object_object_get_ex(meta, "iv", &jv) || (sv = json_object_get_string(jv)) == NULL ||
+	    strlen(sv) > 20 || base64_decode(sv, tmp, strlen(sv)) != RBK_SEAL_IV) goto done;
