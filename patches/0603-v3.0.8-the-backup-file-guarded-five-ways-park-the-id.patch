+	if (fread(tag, 1, RBK_SEAL_TAG, in) != RBK_SEAL_TAG) goto done;
+	if (EVP_CIPHER_CTX_ctrl(ctx, EVP_CTRL_GCM_SET_TAG, RBK_SEAL_TAG, tag) != 1) goto done;
+	if (EVP_DecryptFinal_ex(ctx, obuf, &outl) != 1) { ret = 1; goto done; }
