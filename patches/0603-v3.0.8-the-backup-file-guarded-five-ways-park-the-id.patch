diff --git a/release/src/router/rc/amaspark.c b/release/src/router/rc/amaspark.c
new file mode 100644
index 0000000000..8fc5b314c7
--- /dev/null
+++ b/release/src/router/rc/amaspark.c
@@ -0,0 +1,274 @@
+/*
+ * SPDX-License-Identifier: GPL-2.0-only
+ * Copyright (C) 2026 the Reaper project maintainer
+ *
+ * reaper v3.0.8: park the AiMesh backhaul carriers while no node is paired.
+ *
+ * Measured on the owner's RT-BE96U (2026-09-04, no node ever paired): the
+ * primary BSS on every band is up, hidden, and carries the AiMesh backhaul
+ * SSID. On 2.4 and 5 GHz each BSS beacons on its own, so the idle carrier is
+ * a full 10/s beacon stream (a third of the beacon load, ~2 % of 2.4 GHz
+ * airtime at the basic rate) AND a WPA network, on the air around the clock,
+ * whose key the owner never chose. On 6 GHz the co-located BSSs share one
+ * beacon and the primary is the transmitter, so there is nothing to save
+ * there and parking it could take the whole set down - 6 GHz is never touched.
+ * `wl -i wl1 bss down` was proven to leave wl1.1/wl1.2 serving every client.
+ *
+ * Rules (opt-in, nvram amas_bh_park=1):
+ *   PARK    the 2.4/5 GHz primaries when this router is the AiMesh primary
+ *           (router mode, not a node), the paired-node registry is empty
+ *           (cfg_relist + cfg_relist_x, the same registry Gatekeeper exempts)
+ *           and no search/onboarding is running (cfg_obstatus idle = "1").
+ *   RELEASE the moment a search or onboarding starts (cfg_obstatus leaves
+ *           "1": 2 = search, 3 = a node asked, 4 = onboarding) - the node
+ *           must be able to find and join the carrier - or a node becomes
+ *           paired, or the feature is switched off, or this daemon stops.
+ *   RE-PARK when the window closes with the registry still empty (the search
+ *           found nothing, or timed out - cfg_server's own 120/300 s timers),
+ *           and, as a backstop, if cfg_obstatus sticks non-idle for 20 min.
+ *   Only what THIS daemon parked is ever released: a radio the operator or a
+ *   schedule turned off is left alone, and a radio with wlN_radio=0 is skipped.
+ *   Every park and release is one syslog line naming the interface, the band
+ *   and the reason. A wireless restart brings the primaries back up by itself;
+ *   the next tick (5 s) parks them again, which is why this is a daemon and
+ *   not a one-shot at wireless start.
+ *
+ * Runs as an rc applet (/sbin/amaspark -> rc). Started from start_services()
+ * in router mode; restart_amaspark is the service the Wireless page fires.
+ * The daemon keeps running while the feature is off (one nvram read every
+ * 30 s) so a disable releases through the same path as everything else.
+ */
+#include "rc.h"
+#include <signal.h>
+#include <net/if.h>
+#include <sys/sysinfo.h>
+
+#define AP_TAG		"amaspark"
+#define AP_POLL_ON	5		/* s, feature enabled: a search must be answered fast */
+#define AP_POLL_OFF	30		/* s, feature disabled: only the switch is watched */
+#define AP_OB_MAX	1200		/* s, a stuck non-idle cfg_obstatus is treated as closed */
+#define AP_STATE	"/tmp/amaspark.state"
+#define AP_MAXU		3
+
+static volatile sig_atomic_t g_stop;
+static void on_sig(int s) { (void)s; g_stop = 1; }
+
+static long now_s(void)
+{
+	struct sysinfo si;
+	return sysinfo(&si) == 0 ? (long)si.uptime : (long)time(NULL);
+}
+
+/* 1 = up, 0 = down, -1 = unknown (no such interface, wl unavailable) */
+static int bss_state(const char *ifn)
+{
+	char cmd[80], buf[32] = "";
+	FILE *p;
+	snprintf(cmd, sizeof(cmd), "wl -i %s bss 2>/dev/null", ifn);
+	if ((p = popen(cmd, "r")) == NULL) return -1;
+	if (!fgets(buf, sizeof(buf), p)) buf[0] = 0;
+	pclose(p);
+	if (!strncmp(buf, "up", 2)) return 1;
+	if (!strncmp(buf, "down", 4)) return 0;
+	return -1;
+}
+
+static void bss_set(const char *ifn, int up)
+{
+	eval("wl", "-i", (char *)ifn, "bss", up ? "up" : "down");
+}
+
+static const char *band_name(int nband)
+{
+	switch (nband) {
+	case 2: return "2.4 GHz";
+	case 1: return "5 GHz";
+	case 4: return "6 GHz";
+	default: return "?";
+	}
+}
+
+/* the paired-node registry: cfg_server's own list of the STA MACs nodes
+ * connect with. Non-empty = at least one node is paired. */
+static int nodes_paired(void)
+{
+	char *a = get_cfg_relist(0), *b = get_cfg_relist(1);
+	int r = (a && *a) || (b && *b);
+	free(a);
+	free(b);
+	return r;
+}
+
+static void state_write(const char parked[AP_MAXU], char ifn[AP_MAXU][IFNAMSIZ], const char *why)
+{
+	char line[160] = "";
+	int u, n = 0;
+	for (u = 0; u < AP_MAXU; u++) {
+		if (!parked[u]) continue;
+		if (n++) strlcat(line, " ", sizeof(line));
+		strlcat(line, ifn[u], sizeof(line));
+	}
+	if (n) {
+		char st[200];
+		f_write_string(AP_STATE, line, 0, 0);
+		snprintf(st, sizeof(st), "parked: %s", line);
+		nvram_set("amas_bh_state", st);
+	} else {
+		unlink(AP_STATE);
+		nvram_set("amas_bh_state", why ? why : "released");
+	}
+}
+
+int amaspark_main(int argc, char *argv[])
+{
+	char parked[AP_MAXU] = { 0 };
+	char ifn[AP_MAXU][IFNAMSIZ];
+	int nband[AP_MAXU];
+	int last_enabled = -1, last_window = 0, ob_capped = 0;
+	long ob_start = 0;
+	(void)argc; (void)argv;
+
+	signal(SIGTERM, on_sig);
+	signal(SIGINT, on_sig);
+	signal(SIGHUP, SIG_IGN);
+	if (daemon(1, 0) < 0) return 1;
+
+	memset(ifn, 0, sizeof(ifn));
+	memset(nband, 0, sizeof(nband));
+
+	/* adopt what a previous instance left parked (restart_amaspark, or it
+	 * died): those carriers are ours to release when the rules say so */
+	{
+		char prev[160] = "";
+		if (f_read_string(AP_STATE, prev, sizeof(prev)) > 0) {
+			int u;
+			for (u = 0; u < AP_MAXU; u++) {
+				char key[24], *v;
+				snprintf(key, sizeof(key), "wl%d_ifname", u);
+				v = nvram_safe_get(key);
+				if (*v && strstr(prev, v) && bss_state(v) == 0)
+					parked[u] = 1;
+			}
+		}
+	}
+	logmessage(AP_TAG, "started - AiMesh backhaul parking %s", nvram_get_int("amas_bh_park") ? "ENABLED" : "disabled");
+
+	while (!g_stop) {
+		int enabled = nvram_get_int("amas_bh_park");
+		int cap = nvram_get_int("sw_mode") == 1 && nvram_get_int("re_mode") != 1;
+		int paired = 0, window = 0, want, u, changed = 0, i, poll;
+		const char *ob = "", *why_park = NULL, *why_rel = NULL;
+		char obv[8] = "";
+		long now = now_s();
+
+		if (enabled != last_enabled) {
+			if (last_enabled >= 0 || enabled)
+				logmessage(AP_TAG, enabled
+					? "ENABLED: the 2.4/5 GHz AiMesh backhaul carriers will be parked while no node is paired and no search is running; 6 GHz is never touched; every change is logged here"
+					: "DISABLED: parked carriers are being released; the backhaul stays on the air as stock");
+			last_enabled = enabled;
+		}
+
+		if (enabled && cap) {
+			paired = nodes_paired();
+			ob = nvram_safe_get("cfg_obstatus");
+			strlcpy(obv, ob, sizeof(obv));
+			window = obv[0] && strcmp(obv, "1") != 0;
+			/* cfg_onboarding.h: 1 = idle, 2 = search (AVAILABLE), 3 = a node
+			 * asked (REQ), 4 = onboarding (LOCKED). No defaults.c entry, so a
+			 * stuck value would keep the carriers up for ever: cap it. */
+			if (!window) { ob_start = 0; ob_capped = 0; }
+			else if (!ob_start) ob_start = now;
+			else if (!ob_capped && now - ob_start > AP_OB_MAX) {
+				logmessage(AP_TAG, "cfg_obstatus has been %s for %ld s with no node paired - treating the search window as closed", obv, (long)AP_OB_MAX);
+				ob_capped = 1;
+			}
+			if (ob_capped) window = 0;
+		}
+		want = enabled && cap && !paired && !window;
+
+		if (want) {
+			if (last_window) why_park = "the search/onboarding window closed with no node paired";
+			else if (ob_capped) why_park = "the search window was stuck open and has been treated as closed";
+			else why_park = "no AiMesh node is paired and no search or onboarding is running";
+		} else {
+			if (!enabled) why_rel = "backhaul parking was switched off";
+			else if (!cap) why_rel = "this router is not the AiMesh primary";
+			else if (paired) why_rel = "an AiMesh node is paired - it needs the carrier to reconnect";
+			else {
+				static char wbuf[96];
+				snprintf(wbuf, sizeof(wbuf), "an AiMesh search or onboarding started (cfg_obstatus=%s)", obv);
+				why_rel = wbuf;
+			}
+		}
+		last_window = window;
+
+		for (u = 0; u < AP_MAXU; u++) {
+			char key[24], *v;
+			int st, radio;
+			snprintf(key, sizeof(key), "wl%d_ifname", u);
+			v = nvram_safe_get(key);
+			if (!*v) { ifn[u][0] = 0; continue; }
+			strlcpy(ifn[u], v, sizeof(ifn[u]));
+			snprintf(key, sizeof(key), "wl%d_nband", u);
+			nband[u] = nvram_get_int(key);
+			if (nband[u] == 4) continue;		/* 6 GHz: never */
+			snprintf(key, sizeof(key), "wl%d_radio", u);
+			v = nvram_safe_get(key);
+			radio = *v ? atoi(v) : 1;
+			if (!radio) { if (parked[u]) { parked[u] = 0; changed = 1; } continue; }
+
+			if (want) {
+				if (parked[u]) continue;
+				st = bss_state(ifn[u]);
+				if (st != 1) continue;	/* down already (not ours) or unknown */
+				bss_set(ifn[u], 0);
+				parked[u] = 1;
+				changed = 1;
+				logmessage(AP_TAG, "parked %s (%s backhaul carrier): %s", ifn[u], band_name(nband[u]), why_park);
+			} else if (parked[u]) {
+				st = bss_state(ifn[u]);
+				if (st == 0) bss_set(ifn[u], 1);
+				parked[u] = 0;
+				changed = 1;
+				logmessage(AP_TAG, "released %s (%s backhaul carrier): %s", ifn[u], band_name(nband[u]), why_rel);
+			}
+		}
+		if (changed) state_write(parked, ifn, why_rel);
+
+		poll = enabled ? AP_POLL_ON : AP_POLL_OFF;
+		for (i = 0; i < poll && !g_stop; i++) sleep(1);
+	}
+
+	/* stopping (service stop, reboot, restart_amaspark): hand the carriers
+	 * back so the stock picture is restored whatever comes next */
+	{
+		int u, n = 0;
+		for (u = 0; u < AP_MAXU; u++) {
+			if (!parked[u] || !ifn[u][0]) continue;
+			if (bss_state(ifn[u]) == 0) bss_set(ifn[u], 1);
+			logmessage(AP_TAG, "released %s (%s backhaul carrier): the parking service is stopping", ifn[u], band_name(nband[u]));
+			parked[u] = 0;
+			n++;
+		}
+		(void)n;
+		unlink(AP_STATE);
+		nvram_set("amas_bh_state", "");
+	}
+	logmessage(AP_TAG, "stopped");
+	return 0;
+}
+
+void stop_amaspark(void)
+{
+	if (pids("amaspark"))
+		killall_tk("amaspark");
+}
+
+void start_amaspark(void)
+{
+	stop_amaspark();
+	if (!is_routing_enabled())
+		return;
+	xstart("amaspark");
+}
