-/* GET /REAPER_<model>_<ver>_settings.rbk?http_id=... - the one-file backup */
+/* reaper v3.0.8 guard 3: the address of the client behind the current request */
+static const char *rbk_peer(void)
+{
+	static char ip[64];
+	const char *p = safe_uaddr_ntop(&login_uip_tmp, ip, sizeof(ip));
+	if (reaper_client_ip[0]) return reaper_client_ip;
+	return (p && *p) ? p : "?";
+}
+
+/* reaper v3.0.8 guard 2: the admin password, again, for THIS request.
+ * 0 = ok, 1 = wrong, 2 = locked after too many wrong answers. */
+static int rbk_pwfail = 0;
+static time_t rbk_pwlock = 0;
+static int rbk_reauth(const char *pw, const char *what)
+{
+	time_t now = time(NULL);
+	char user[64];
+	int ok = 0;
+
+	strlcpy(user, nvram_safe_get("http_username"), sizeof(user));
+	if (rbk_pwlock && now < rbk_pwlock) {
+		logmessage("reaper_cfg", "%s REFUSED from %s: exports locked after %d wrong admin passwords (%ld s left)",
+		           what, rbk_peer(), RBK_PW_LOCK_AFTER, (long)(rbk_pwlock - now));
+		return 2;
+	}
+	rbk_pwlock = 0;
+	if (pw && *pw && strlen(pw) <= 64) {
+		ok = compare_passwd_in_shadow(user, pw);
+		/* mirror the login page: an unconfigured box compares the first 16 chars */
+		if (!ok && !nvram_get_int("p_Setting") && strlen(pw) > 16) {
+			char t[17];
+			strlcpy(t, pw, sizeof(t));
+			ok = compare_passwd_in_shadow(user, t);
+		}
+	}
+	if (!ok) {
+		if (++rbk_pwfail >= RBK_PW_LOCK_AFTER) {
+			rbk_pwlock = now + RBK_PW_LOCK_SECS;
+			rbk_pwfail = 0;
+		}
+		logmessage("reaper_cfg", "%s REFUSED from %s: wrong admin password", what, rbk_peer());
+		return 1;
+	}
+	rbk_pwfail = 0;
+	return 0;
+}
+
+/* reaper v3.0.8 guard 1: the sealed container - writer side (rbk_seal_t is
+ * declared beside rcfg_export_json, which the settings export needs first) */
+static int rbk_seal_kdf(const char *pass, const unsigned char *salt, long n, long r, long p, unsigned char key[32])
+{
+	return EVP_PBE_scrypt(pass, strlen(pass), salt, RBK_SEAL_SALT,
+			      (uint64_t)n, (uint64_t)r, (uint64_t)p, (uint64_t)RBK_SCRYPT_MEM, key, 32) == 1;
+}
+
+/* header + cipher init. Nothing is written on failure. */
+static int rbk_seal_begin(rbk_seal_t *sl, FILE *out, const char *pass, const char *kind, long plain_len)
+{
+	unsigned char salt[RBK_SEAL_SALT], iv[RBK_SEAL_IV], key[32];
+	char b64s[32], b64i[24];
+	char *hbuf = NULL;
+	size_t hlen = 0;
+	FILE *m;
+	int outl = 0, ok = 0;
+
+	memset(sl, 0, sizeof(*sl));
+	sl->out = out;
+	if (RAND_bytes(salt, sizeof(salt)) != 1 || RAND_bytes(iv, sizeof(iv)) != 1) return 0;
+	if (!rbk_seal_kdf(pass, salt, RBK_SCRYPT_N, RBK_SCRYPT_R, RBK_SCRYPT_P, key)) return 0;
+	b64s[base64_encode(salt, b64s, sizeof(salt))] = 0;
+	b64i[base64_encode(iv, b64i, sizeof(iv))] = 0;
+	if ((m = open_memstream(&hbuf, &hlen)) == NULL) goto done;
+	fputs(RBK_SEAL_MAGIC, m);
+	fputs("{\"model\":", m);
+	gk_json_esc(m, nvram_safe_get("productid"));
+	fputs(",\"fw\":", m);
+	gk_json_esc(m, nvram_safe_get("extendno"));
+	fprintf(m, ",\"when\":%ld,\"kind\":\"%s\",\"kdf\":\"scrypt\",\"n\":%d,\"r\":%d,\"p\":%d,\"salt\":\"%s\",\"iv\":\"%s\",\"len\":%ld}\n",
+		(long)time(NULL), kind, RBK_SCRYPT_N, RBK_SCRYPT_R, RBK_SCRYPT_P, b64s, b64i, plain_len);
+	fclose(m);
+	if (!hbuf || hlen == 0 || hlen >= RBK_SEAL_HDR_MAX) goto done;
+	if ((sl->ctx = EVP_CIPHER_CTX_new()) == NULL) goto done;
+	if (EVP_EncryptInit_ex(sl->ctx, EVP_aes_256_gcm(), NULL, NULL, NULL) != 1 ||
+	    EVP_CIPHER_CTX_ctrl(sl->ctx, EVP_CTRL_GCM_SET_IVLEN, RBK_SEAL_IV, NULL) != 1 ||
+	    EVP_EncryptInit_ex(sl->ctx, NULL, NULL, key, iv) != 1 ||
+	    EVP_EncryptUpdate(sl->ctx, NULL, &outl, (const unsigned char *)hbuf, (int)hlen) != 1)
+		goto done;
+	fwrite(hbuf, 1, hlen, out);
+	ok = 1;
+done:
+	OPENSSL_cleanse(key, sizeof(key));
+	free(hbuf);
+	if (!ok && sl->ctx) { EVP_CIPHER_CTX_free(sl->ctx); sl->ctx = NULL; }
+	return ok;
+}
+
+static void rbk_seal_write(rbk_seal_t *sl, const void *p, size_t n)
+{
+	unsigned char obuf[4096 + 32];
+	const unsigned char *q = p;
+	while (n > 0 && !sl->err) {
+		int take = n > 4096 ? 4096 : (int)n, outl = 0;
+		if (EVP_EncryptUpdate(sl->ctx, obuf, &outl, q, take) != 1) { sl->err = 1; break; }
+		if (outl > 0) fwrite(obuf, 1, outl, sl->out);
+		q += take;
+		n -= take;
+	}
+}
+
+static int rbk_seal_end(rbk_seal_t *sl)
+{
+	unsigned char obuf[32], tag[RBK_SEAL_TAG];
+	int outl = 0, ok = !sl->err;
+	if (ok && EVP_EncryptFinal_ex(sl->ctx, obuf, &outl) != 1) ok = 0;
+	if (ok && outl > 0) fwrite(obuf, 1, outl, sl->out);
+	if (ok && EVP_CIPHER_CTX_ctrl(sl->ctx, EVP_CTRL_GCM_GET_TAG, RBK_SEAL_TAG, tag) != 1) ok = 0;
+	if (ok) fwrite(tag, 1, RBK_SEAL_TAG, sl->out);
+	EVP_CIPHER_CTX_free(sl->ctx);
+	sl->ctx = NULL;
+	return ok;
+}
+
+/* one writer for both shapes of download: straight to the socket, or through the seal */
+typedef struct { FILE *stream; rbk_seal_t *seal; } rbk_out_t;
+static void rbk_out(rbk_out_t *o, const void *p, size_t n)
+{
+	if (o->seal) rbk_seal_write(o->seal, p, n);
+	else fwrite(p, 1, n, o->stream);
+}
+static void rbk_out_file(rbk_out_t *o, const char *path)
+{
+	FILE *f = fopen(path, "r");
+	char b[4096];
+	size_t n;
+	if (!f) return;
+	while ((n = fread(b, 1, sizeof(b), f)) > 0)
+		rbk_out(o, b, n);
+	fclose(f);
+}
+
+/* reaper v3.0.8 guard 5: a member laid down THROUGH an earlier symlink member
+ * would land wherever that link points - the one traversal busybox does not
+ * strip. Relative or absolute, a link that nothing is written through is just
+ * a link the user had (addon boxes carry them), so only the write-through is
+ * refused. Parses `tar -tv`: "<mode> <uid/gid> <size> <date> <time> <name>[ -> <target>]". */
+static int rbk_tar_links_ok(const char *path)
+{
+	char cmd[256], line[1024];
+	char (*links)[256] = NULL;
+	int nl = 0, cap = 0, ok = 1;
+	FILE *p;
+
+	snprintf(cmd, sizeof(cmd), "tar -tvzf %s 2>/dev/null", path);
+	if ((p = popen(cmd, "r")) == NULL) return 0;
+	while (fgets(line, sizeof(line), p)) {
+		char *name = line, *arrow;
+		int i;
+		for (i = 0; i < 5 && name; i++) {
+			name = strchr(name, ' ');
+			while (name && *name == ' ') name++;
+		}
+		if (!name || !*name) continue;
+		name[strcspn(name, "\r\n")] = 0;
+		if ((arrow = strstr(name, " -> ")) != NULL) *arrow = 0;
+		while (!strncmp(name, "./", 2)) name += 2;
+		if (!*name) continue;
+		for (i = 0; i < nl; i++) {
+			size_t ln = strlen(links[i]);
+			if (ln && !strncmp(name, links[i], ln) && name[ln] == '/') {
+				logmessage("reaper_cfg", "full-backup restore: /jffs archive writes '%s' through the symlink member '%s' - REFUSED", name, links[i]);
+				ok = 0;
+				break;
+			}
+		}
+		if (!ok) break;
+		if (line[0] == 'l') {
+			if (nl >= cap) {
+				void *nb;
+				if (cap >= 4096) { ok = 0; break; }	/* nobody has 4096 symlinks on /jffs */
+				cap = cap ? cap * 2 : 64;
+				if ((nb = realloc(links, (size_t)cap * sizeof(*links))) == NULL) { ok = 0; break; }
+				links = nb;
+			}
+			strlcpy(links[nl++], name, sizeof(*links));
+		}
+	}
+	pclose(p);
+	free(links);
+	return ok;
+}
+
