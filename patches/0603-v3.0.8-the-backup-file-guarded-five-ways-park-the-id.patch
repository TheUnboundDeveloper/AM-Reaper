+/* ===================================================================
+ * reaper v3.0.8: the backup file as a data-harvesting surface (owner
+ * review 2026-09-04). Five independent guards, one per compromise path:
+ *   1. SEALED backups - either export can be wrapped in an AES-256-GCM
+ *      container keyed from a passphrase (scrypt). Protects the file AT
+ *      REST - a backup in a synced folder or a forum post is the whole
+ *      network in the clear: Wi-Fi keys, the reversibly scrambled admin
+ *      password, VPN/TLS/SSH private keys, the traffic and web history
+ *      databases - and gives INTEGRITY: a tampered or attacker-supplied
+ *      archive fails authentication before a byte of it is parsed.
+ *   2. RE-AUTHENTICATION on export - the admin password travels with the
+ *      request, on top of the session and the http_id/referer gate. A
+ *      stolen session or an XSS foothold is no longer one fetch away from
+ *      the whole network. Five wrong answers lock exports for a minute
+ *      (httpd is single-threaded; an in-memory counter is enough).
+ *   3. The CLIENT ADDRESS in every export and refusal line, so syslog
+ *      says WHICH machine pulled, or tried to pull, the file.
+ *   4. The page names the credentials the file carries (RBKP_37).
+ *   5. RESTORE refuses a /jffs tar in which a later member is written
+ *      THROUGH an earlier symlink member - the one way a crafted archive
+ *      reaches outside /jffs (busybox already strips "/" and "..").
+ *
+ * Container (byte-exact):
+ *   REAPER-SEALED 1\n
+ *   {"model":..,"fw":..,"when":N,"kind":"rbk"|"json","kdf":"scrypt",
+ *    "n":32768,"r":8,"p":1,"salt":<b64 16 B>,"iv":<b64 12 B>,"len":N}\n
+ *   <N bytes: AES-256-GCM ciphertext of the UNSEALED file, byte-identical
+ *    to what the plain download would have been><16-byte GCM tag>
+ * The two header lines are the GCM additional data, so the meta is
+ * authenticated too. The outer "model" lets a wrong-model file be refused
+ * before the passphrase is asked for; the inner, authenticated model check
+ * still runs after decryption. The passphrase is never stored.
+ * =================================================================== */
+#define RBK_SEAL_MAGIC	"REAPER-SEALED 1\n"
+#define RBK_UPLOAD_SEAL	"/tmp/reaper_restore.sealed"
+#define RBK_SEAL_TAG	16
+#define RBK_SEAL_SALT	16
+#define RBK_SEAL_IV	12
+#define RBK_SCRYPT_N	32768
+#define RBK_SCRYPT_R	8
+#define RBK_SCRYPT_P	1
+#define RBK_SCRYPT_MEM	(64L * 1024 * 1024)
+#define RBK_JSON_MAX	(4L * 1024 * 1024)	/* a sealed settings file, decrypted */
+#define RBK_SEAL_HDR_MAX	768
+#define RBK_SEAL_PLAIN_MAX	(RBK_CFG_MAX + RCFG_PENDING_MAX + RBK_FQDN_MAX + RBK_JFFS_MAX + 4096L)
+#define RBK_PW_LOCK_AFTER	5
+#define RBK_PW_LOCK_SECS	60
+
