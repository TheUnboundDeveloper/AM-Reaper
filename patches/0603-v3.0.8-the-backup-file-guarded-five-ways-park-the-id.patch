+	if (!rbk_seal_kdf(rbk_up.pass, rbk_up.salt, rbk_up.n, rbk_up.r, rbk_up.p, key)) goto done;
+	if ((in = fopen(RBK_UPLOAD_SEAL, "r")) == NULL) goto done;
+	ofd = open(RBK_UPLOAD, O_CREAT | O_EXCL | O_WRONLY | O_NOFOLLOW, 0600);
+	if (ofd < 0 || (out = fdopen(ofd, "w")) == NULL) { if (ofd >= 0) close(ofd); goto done; }
+	if ((ctx = EVP_CIPHER_CTX_new()) == NULL) goto done;
+	if (EVP_DecryptInit_ex(ctx, EVP_aes_256_gcm(), NULL, NULL, NULL) != 1 ||
+	    EVP_CIPHER_CTX_ctrl(ctx, EVP_CTRL_GCM_SET_IVLEN, RBK_SEAL_IV, NULL) != 1 ||
