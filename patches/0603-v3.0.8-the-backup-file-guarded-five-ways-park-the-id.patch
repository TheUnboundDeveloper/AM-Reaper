+/* one multipart text field (the blank line, then the value line) */
+static void rbk_mp_value(FILE *stream, int *len, char *dst, size_t dstlen)
+{
+	char buf[1024];
+	dst[0] = 0;
+	while (*len > 0) {
+		if (!fgets(buf, MIN(*len + 1, (int)sizeof(buf)), stream)) return;
+		*len -= strlen(buf);
+		if (!strcmp(buf, "\n") || !strcmp(buf, "\r\n")) break;
+	}
+	if (*len > 0 && fgets(buf, MIN(*len + 1, (int)sizeof(buf)), stream)) {
+		*len -= strlen(buf);
+		buf[strcspn(buf, "\r\n")] = 0;
+		strlcpy(dst, buf, dstlen);
+	}
