+/* the sealed container's meta line -> kind, kdf cost, salt, iv, len, outer model. 1 = parsed and sane. */
+static int rbk_seal_meta(const char *line)
+{
+	json_object *meta = json_tokener_parse(line), *jv;
+	const char *sv;
+	unsigned char tmp[32];
