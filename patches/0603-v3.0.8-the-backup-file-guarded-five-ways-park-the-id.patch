+/* reaper v3.0.8 guard 1, reader side: authenticate and decrypt RBK_UPLOAD_SEAL
+ * into RBK_UPLOAD. 0 = ok; 1 = wrong passphrase or altered file (the tag did
+ * not verify - nothing decrypted is kept); 2 = could not run. */
+static int rbk_unseal(void)
+{
+	unsigned char key[32], ibuf[4096], obuf[4096 + 32], tag[RBK_SEAL_TAG];
+	EVP_CIPHER_CTX *ctx = NULL;
