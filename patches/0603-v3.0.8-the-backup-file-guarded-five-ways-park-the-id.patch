+static int rbk_meta_ranges_ok(void)
+{
+	return !(rbk_up.cfg < 8 || rbk_up.cfg > RBK_CFG_MAX ||
+		 rbk_up.rcfg < 2 || rbk_up.rcfg > RCFG_PENDING_MAX ||
+		 rbk_up.fqdn < 0 || rbk_up.fqdn > RBK_FQDN_MAX ||
+		 rbk_up.jffs < 0 || rbk_up.jffs > RBK_JFFS_MAX);
