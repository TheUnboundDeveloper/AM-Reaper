+	if (json_object_object_get_ex(meta, "model", &jv) && (sv = json_object_get_string(jv)) != NULL)
+		strlcpy(rbk_up.model, sv, sizeof(rbk_up.model));
+	if (!json_object_object_get_ex(meta, "kind", &jv) || (sv = json_object_get_string(jv)) == NULL) goto done;
+	if (strcmp(sv, "rbk") != 0 && strcmp(sv, "json") != 0) goto done;
+	strlcpy(rbk_up.kind, sv, sizeof(rbk_up.kind));
+	if (!json_object_object_get_ex(meta, "kdf", &jv) || (sv = json_object_get_string(jv)) == NULL || strcmp(sv, "scrypt") != 0) goto done;
+	rbk_up.n = json_object_object_get_ex(meta, "n", &jv) ? json_object_get_int64(jv) : 0;
+	rbk_up.r = json_object_object_get_ex(meta, "r", &jv) ? json_object_get_int64(jv) : 0;
+	rbk_up.p = json_object_object_get_ex(meta, "p", &jv) ? json_object_get_int64(jv) : 0;
+	if (rbk_up.n < 1024 || rbk_up.n > (1L << 20) || (rbk_up.n & (rbk_up.n - 1)) ||
