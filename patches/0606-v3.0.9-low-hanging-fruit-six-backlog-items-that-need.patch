diff --git a/release/src/router/httpd/web.c b/release/src/router/httpd/web.c
index 068b1e2cc0..0e13134806 100644
--- a/release/src/router/httpd/web.c
+++ b/release/src/router/httpd/web.c
@@ -23382,6 +23382,9 @@ reaper_requester_mac(char *out, size_t n)
 	return got;
 }
 
+#ifdef RTCONFIG_CFGSYNC
+static int rdev_amesh_is_wired(json_object *wired, const char *mac);	/* defined with the Devices page classifier below */
+#endif
 static void
 do_reaper_gk_cgi(char *url, FILE *stream)
 {
@@ -23404,6 +23407,27 @@ do_reaper_gk_cgi(char *url, FILE *stream)
 		int ns = gk_load_seen(seen, GK_SEEN_MAX);
 		int i, first;
 		char *buf, *tok, *sp = NULL;
+#ifdef RTCONFIG_CFGSYNC
+		/* v3.0.9 (backlog "Gatekeeper labels a wireless client Wired"): seen.tsv is
+		 * gkd's snapshot from the moment the device was FIRST seen - a client that
+		 * reached DHCP before the station table caught up, a roamer, a client
+		 * behind a node - is recorded band="" wired=1 and shows as Wired until the
+		 * file is rewritten. The Devices page beside this one reads the live
+		 * cfg_mnt lists instead. Do the same here, once per request: a MAC found
+		 * in the wireless list (and not in the wired list) is Wireless, whatever
+		 * the snapshot said. Display only - enforcement is by MAC. */
+		json_object *gk_wl = NULL, *gk_wired = NULL;
+		{
+			int lock = file_lock(ALLWEVENT_FILE_LOCK);
+			gk_wl = json_object_from_file(ALLWCLIENT_LIST_JSON_PATH);
+			file_unlock(lock);
+			if (gk_wl && !json_object_is_type(gk_wl, json_type_object)) { json_object_put(gk_wl); gk_wl = NULL; }
+			lock = file_lock(WIREDCLIENTLIST_FILE_LOCK);
+			gk_wired = json_object_from_file(WIRED_CLIENT_LIST_JSON_PATH);
+			file_unlock(lock);
+			if (gk_wired && !json_object_is_type(gk_wired, json_type_object)) { json_object_put(gk_wired); gk_wired = NULL; }
+		}
+#endif
 
 		/* reaper v1.7.3: "armed" reflects whether the enforcement chains are
 		 * actually present (gkd stamps /tmp/gk/chains.ok when they are). It can
@@ -23459,6 +23483,30 @@ do_reaper_gk_cgi(char *url, FILE *stream)
 					snprintf(off.mac, sizeof(off.mac), "%s", mac);
 					d = &off;
 				}
+#ifdef RTCONFIG_CFGSYNC
+				/* v3.0.9: a live wireless signal beats the cached wired flag (see above).
+				 * Work on a copy - `seen` is static and must keep gkd's own record. */
+				if (gk_wl && (d->wired || !d->band[0]) && !(gk_wired && rdev_amesh_is_wired(gk_wired, mac))) {
+					const char *bl = NULL;
+					json_object_object_foreach(gk_wl, nodemac, bands) {
+						(void)nodemac;
+						if (bl || !json_object_is_type(bands, json_type_object)) continue;
+						json_object_object_foreach(bands, bandkey, stas) {
+							if (bl || !json_object_is_type(stas, json_type_object)) continue;
+							if (bandkey[0] != '2' && bandkey[0] != '5' && bandkey[0] != '6') continue;
+							json_object_object_foreach(stas, stamac, staval) {
+								(void)staval;
+								if (!bl && !strcasecmp(stamac, mac)) bl = bandkey[0] == '2' ? "2.4" : bandkey[0] == '5' ? "5" : "6";
+							}
+						}
+					}
+					if (bl) {
+						if (d != &off) { off = *d; d = &off; }
+						snprintf(d->band, sizeof(d->band), "%s", bl);
+						d->wired = 0;
+					}
+				}
+#endif
 				if (!first) websWrite(stream, ",");
 				first = 0;
 				websWrite(stream, "{\"mac\":\"%s\",\"state\":%d,\"expiry\":%ld,\"ip\":", d->mac, st, exp);
@@ -23479,6 +23527,10 @@ do_reaper_gk_cgi(char *url, FILE *stream)
 			}
 			free(buf);
 		}
+#ifdef RTCONFIG_CFGSYNC
+		if (gk_wl) json_object_put(gk_wl);
+		if (gk_wired) json_object_put(gk_wired);
+#endif
 		websWrite(stream, "]}");
 		return;
 	}
diff --git a/release/src/router/rc/amaspark.c b/release/src/router/rc/amaspark.c
index 6bb7052140..2aa87ae8d5 100644
--- a/release/src/router/rc/amaspark.c
+++ b/release/src/router/rc/amaspark.c
@@ -55,7 +55,7 @@
 #define AP_POLL_OFF	30		/* s, feature disabled: only the switch is watched */
 #define AP_OB_MAX	1200		/* s, a stuck non-idle cfg_obstatus is treated as closed */
 #define AP_STATE	"/tmp/amaspark.state"
-#define AP_MAXU		3
+#define AP_MAXU		4		/* radios: the GT-BE98 family has four (2.4, 5-1, 5-2, 6); the band comes from wlN_nband, never the unit number */
 
 static volatile sig_atomic_t g_stop;
 static void on_sig(int s) { (void)s; g_stop = 1; }
diff --git a/release/src/router/rc/rexport.c b/release/src/router/rc/rexport.c
index 59717bce48..4fd69b572e 100644
--- a/release/src/router/rc/rexport.c
+++ b/release/src/router/rc/rexport.c
@@ -95,11 +95,16 @@ static void rexport_gen(void)
 	  "# optional MAC-hash for privacy: replace each MAC with a short salted digest\n"
 	  "if [ \"$MASK\" = 1 ]; then\n"
 	  "  cp \"$H\" /tmp/rexport.src 2>/dev/null || exit 0\n"
+	  /* v3.0.9 (code-review tail): one sed script applied once, not one whole-
+	   * file rewrite per MAC. The md5 forks stay (busybox awk has no hash). */
+	  "  : > /tmp/rexport.sed\n"
 	  "  for m in $(grep -o '\"mac\":\"[^\"]*\"' /tmp/rexport.src | sed 's/\"mac\":\"//;s/\"$//' | sort -u); do\n"
 	  "    [ -n \"$m\" ] || continue\n"
 	  "    hh=$(printf 'reaper:%s' \"$m\" | md5sum | cut -c1-12)\n"
-	  "    sed -i \"s/$m/$hh/g\" /tmp/rexport.src 2>/dev/null\n"
+	  "    echo \"s/$m/$hh/g\" >> /tmp/rexport.sed\n"
 	  "  done\n"
+	  "  [ -s /tmp/rexport.sed ] && sed -i -f /tmp/rexport.sed /tmp/rexport.src 2>/dev/null\n"
+	  "  rm -f /tmp/rexport.sed\n"
 	  "  SRCF=/tmp/rexport.src\n"
 	  "fi\n"
 	  "\n"
diff --git a/release/src/router/rc/rwatch.c b/release/src/router/rc/rwatch.c
index 2d314886e5..5eb1b4633e 100644
--- a/release/src/router/rc/rwatch.c
+++ b/release/src/router/rc/rwatch.c
@@ -246,6 +246,23 @@ static void rwatch_gen(void)
 	  "  echo \"$SD\" > /tmp/rwatch_selfdrop 2>/dev/null\n"
 	  "fi\n"
 	  "\n"
+	  /* v3.0.9 (backlog "Warden crash on the BE92U addon box", the held defensive
+	   * fix): the canary above heals a POISONED chain, nothing healed an ABSENT
+	   * one - the end state of the only code-plausible path (apply.sh bailed
+	   * "lan not ready" after the flush while nvram was wedged). Same lock, same
+	   * boot grace, at most once per 10 min, and it says so in the log. */
+	  "# 3c) Warden chain missing while Warden is enabled: re-apply (once per 10 min)\n"
+	  "if [ \"$(_nv rwarden_enable)\" = 1 ] && [ -f /tmp/rwarden/apply.sh ] && [ \"$UP\" -ge \"$HEALGRACE\" ] \\\n"
+	  "   && ! iptables -nL REAPER_WARDEN >/dev/null 2>&1; then\n"
+	  "  _wl=$(cat /tmp/rwarden/heal.at 2>/dev/null || echo 0); case \"$_wl\" in ''|*[!0-9]*) _wl=0;; esac\n"
+	  "  if [ $((UP - _wl)) -ge 600 ]; then\n"
+	  "    echo $UP > /tmp/rwarden/heal.at 2>/dev/null\n"
+	  "    logger -t rwatch \"Warden chain REAPER_WARDEN is MISSING while Warden is enabled - re-applying (the apply may have bailed before the LAN was ready)\"\n"
+	  "    reaper_lockrun /tmp/rwarden/apply.sh >/dev/null 2>&1\n"
+	  "    FAIL=\"$FAIL warden-chain-missing\"\n"
+	  "  fi\n"
+	  "fi\n"
+	  "\n"
 	  "# 4) GDX host-TCP pool: 0 available = the silent accelerator-wedge\n"
 	  "#    signature. OPT-IN (rwatch_gdx=1): reads a kernel accelerator /proc\n"
 	  "#    surface every tick; default-off until skb_idx is field-proven non-\n"
