diff --git a/release/src/router/www/Reaper_Wireless.asp b/release/src/router/www/Reaper_Wireless.asp
index 32c351d6c8..7c1dfa907e 100644
--- a/release/src/router/www/Reaper_Wireless.asp
+++ b/release/src/router/www/Reaper_Wireless.asp
@@ -416,7 +416,29 @@ function submitApply(unit,cs,bw){
   e1.disabled=false; e1.value=cs;
   e2.disabled=false; e2.value=bw;
   f.submit();
-  setTimeout(function(){fetchStatus();},18000);
+  /* v3.0.9 (backlog "refresh after Lock/Unlock"): the radio restart drops the
+     admin's own band for ~20 s, so the old single 18 s fetch landed mid-outage
+     and the table kept the pre-lock channel until a manual reload. Poll a
+     lightweight endpoint until the router answers again, then repaint. Rule 34:
+     every completion path runs through once(), a still-down router keeps the
+     last-known view. */
+  refreshWhenBack(12000, 0);
+}
+function onceFn(fn){ var done=0; return function(a){ if(done) return; done=1; fn(a); }; }
+function refreshWhenBack(delay, tries){
+  setTimeout(function(){
+    var x=new XMLHttpRequest();
+    var next=onceFn(function(ok){
+      if(ok){ fetchStatus(); setTimeout(function(){fetchStatus();},6000); return; }   /* twice: the chanspec settles after httpd does */
+      if(tries>=20){ showToast(`<#RWIF_94#>`); return; }
+      refreshWhenBack(Math.min(Math.round(delay*1.5),15000), tries+1);
+    });
+    x.open("GET","/httpd_check.xml?_="+Date.now(),true);
+    x.timeout=4000;
+    x.onreadystatechange=function(){ if(x.readyState===4) next(x.status===200); };
+    x.onerror=x.ontimeout=x.onabort=function(){ next(false); };
+    x.send();
+  }, delay);
 }
 
