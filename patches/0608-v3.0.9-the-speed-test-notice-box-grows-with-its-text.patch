From e078c95e0a7351ed88c130795d3e400083aa1793 Mon Sep 17 00:00:00 2001
From: reaper <theunbounddeveloper@outlook.com>
Date: Sat, 5 Sep 2026 11:22:41 -0400
Subject: [PATCH] v3.0.9: the speed-test notice box grows with its text

Stock fixes .alert_notification at 200 px, sized for its own three-line text.
The v3.0.5 failure reason (RSPD_2/3/5/6) is a fifth line and the engine's
socket error wraps to a sixth, past the box - a 10 Gbit/s user saw
"Cannot read:" and nothing after it. On desktop (min-width 721 px) the box
now grows with its text; the phone layout already used height:100%. The
stock css is untouched (byte-identical rule).
---
 .../router/www/reaper/internet_speed_reaper.css   | 15 +++++++++++++++
 1 file changed, 15 insertions(+)

diff --git a/release/src/router/www/reaper/internet_speed_reaper.css b/release/src/router/www/reaper/internet_speed_reaper.css
index ef8da95536..b08668b270 100644
--- a/release/src/router/www/reaper/internet_speed_reaper.css
+++ b/release/src/router/www/reaper/internet_speed_reaper.css
@@ -80,3 +80,18 @@ a:hover{ color: #ff453f !important; }
 ::-webkit-scrollbar{ width: 8px; height: 8px; }
 ::-webkit-scrollbar-thumb{ background: #E10600 !important; border-radius: 4px; }
 ::-webkit-scrollbar-track{ background: #141419; }
+
+/* ---- notice box (v3.0.9): stock fixes .alert_notification at 200px, sized
+        for its own three-line text. The v3.0.5 failure reason (RSPD_2/3/5/6)
+        is a fifth line and the engine's socket error wraps to a sixth, past
+        the box - a 10 Gbit/s user saw "Cannot read:" and nothing after it.
+        Let the box grow with its text on desktop; the phone layout
+        (max-width 720px in internetSpeed.css) already uses height:100%. ---- */
+@media (min-width: 721px){
+	.alert_notification{
+		height: auto !important;
+		min-height: 200px;
+		padding-bottom: 24px;
+		box-sizing: border-box;
+	}
+}
-- 
