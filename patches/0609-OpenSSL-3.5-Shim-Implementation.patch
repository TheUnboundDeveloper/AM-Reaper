+++ b/release/src/router/openssl11-compat/ssl_compat.c
@@ -0,0 +1,283 @@
+#define _GNU_SOURCE
+#include <dlfcn.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+
+#define SSL_CTX_set_options SSL_CTX_set_options__openssl3_decl
