diff --git a/release/src/router/httpd/web.c b/release/src/router/httpd/web.c
index 0e13134806..61af58eaee 100644
--- a/release/src/router/httpd/web.c
+++ b/release/src/router/httpd/web.c
@@ -21773,6 +21773,106 @@ static void reaper_gate_deny(FILE *stream, int why, const char *ns)
 		reaper_gate_msg(why), ns, reaper_gate_ek(why));
 }
 
+/*
+ * reaper_wifisetup.cgi - the first-boot box (Reaper_WiFiSetup.asp), v3.1.0.
+ *
+ * Writes, for every radio, exactly what the stock Advanced_Wireless_Content.asp
+ * apply writes when Smart Connect is on: one SSID and key on all bands, psk2sae
+ * on 2.4/5 GHz, sae on 6 GHz (mandatory there), protected management frames,
+ * the crypto suite the radio's WiFi 7 mode selects, hidden off, Smart Connect
+ * on with the interface mask computed by the same rule as js/asus.js
+ * (bit 0 = 2g1, 1 = 5g1, 2 = 5g2, 3 = 6g1, 4 = 6g2 - the RT-BE96U yields 11).
+ * cfg_server then performs the fronthaul/backhaul split off the same
+ * restart_wireless the stock page fires; nothing about that path is touched.
+ *
+ * nvram + commit ONLY. The page fires the restart itself, chained behind the
+ * password apply ("saveNvram;restart_chpass;restart_wireless"), so the radios
+ * never restart with a half-applied box. Gated on http_id like every other
+ * state-changing Reaper CGI; the caller must already be authenticated (do_auth).
+ *
+ * The key bound is enforced HERE as well as in the page: hostapd accepts
+ * 8..63 characters or 64 hex and otherwise emits NO key line, which kills
+ * every band on this platform (v2.9.1). A too-short key never reaches nvram.
+ */
+static int rwfs_printable(const char *s, int allow_space)
+{
+	for (; *s; s++) {
+		unsigned char c = (unsigned char)*s;
+		if (c < 0x20 || c > 0x7e) return 0;
+		if (!allow_space && c == ' ') return 0;
+	}
+	return 1;
+}
+
+static void
+do_reaper_wifisetup_cgi(char *url, FILE *stream)
+{
+	char *ssid = get_cgi("ssid");
+	char *psk = get_cgi("psk");
+	char prefix[16], buf[16];
+	int unit, n, len, i, blank = 1, n5 = 0, n6 = 0, selif = 0, why;
+
+	why = reaper_gate();
+	if (why != RGATE_OK) {
+		reaper_gate_deny(stream, why, "RWFS");
+		return;
+	}
+	if (!ssid || !psk) {
+		websWrite(stream, "{\"ok\":0,\"error\":\"ssid and psk are required\",\"ek\":\"RWFS_1\"}");
+		return;
+	}
+	len = strlen(ssid);
+	for (i = 0; i < len; i++) if (ssid[i] != ' ') { blank = 0; break; }
+	if (len < 1 || len > 32 || blank || !rwfs_printable(ssid, 1)) {
+		websWrite(stream, "{\"ok\":0,\"error\":\"network name must be 1 to 32 printable characters\",\"ek\":\"RWFS_2\"}");
+		return;
+	}
+	len = strlen(psk);
+	if (len == 64) {
+		for (i = 0; i < 64; i++) if (!isxdigit((unsigned char)psk[i])) break;
+		if (i < 64) {
+			websWrite(stream, "{\"ok\":0,\"error\":\"a 64-character key must be hexadecimal\",\"ek\":\"RWFS_3\"}");
+			return;
+		}
+	} else if (len < 8 || len > 63 || !rwfs_printable(psk, 1)) {
+		websWrite(stream, "{\"ok\":0,\"error\":\"Wi-Fi password must be 8 to 63 printable characters\",\"ek\":\"RWFS_4\"}");
+		return;
+	}
+
+	n = num_of_wl_if();
+	if (n > MAX_NR_WL_IF) n = MAX_NR_WL_IF;
+	if (n < 1) {
+		websWrite(stream, "{\"ok\":0,\"error\":\"no radios\",\"ek\":\"RWFS_5\"}");
+		return;
+	}
+	for (unit = 0; unit < n; unit++) {
+		const char *auth, *mfp;
+		int bit;
+		snprintf(prefix, sizeof(prefix), "wl%d_", unit);
+		if (is_6g(unit)) {
+			auth = "sae"; mfp = "2"; bit = 3 + (n6 < 1 ? 0 : 1); n6++;
+		} else if (nvram_pf_match(prefix, "nband", "1")) {
+			auth = "psk2sae"; mfp = "1"; bit = 1 + (n5 < 1 ? 0 : 1); n5++;
+		} else {
+			auth = "psk2sae"; mfp = "1"; bit = 0;
+		}
+		nvram_pf_set(prefix, "ssid", ssid);
+		nvram_pf_set(prefix, "auth_mode_x", auth);
+		nvram_pf_set(prefix, "wpa_psk", psk);
+		nvram_pf_set(prefix, "crypto", nvram_pf_match(prefix, "11be", "1") ? "aes+gcmp256" : "aes");
+		nvram_pf_set(prefix, "mfp", mfp);
+		nvram_pf_set(prefix, "closed", "0");
+		selif |= (1 << bit);
+	}
+	nvram_set("smart_connect_x", "1");
+	snprintf(buf, sizeof(buf), "%d", selif);
+	nvram_set("smart_connect_selif_x", buf);
+	nvram_set("w_Setting", "1");
+	nvram_commit();
+	logmessage("reaper", "wifisetup: network name and key set on %d radio(s), Smart Connect on (selif %d); restart follows the password apply", n, selif);
+	websWrite(stream, "{\"ok\":1,\"radios\":%d,\"selif\":%d}", n, selif);
+}
+
 static void
 do_reaper_diag_cgi(char *url, FILE *stream)
 {
@@ -35414,6 +35514,7 @@ struct mime_handler mime_handlers[] =
 #ifdef RTCONFIG_AUPNPC
 	{ "get_upnpc_redirection_list.cgi", "text/html", no_cache_IE7, do_html_post_and_get, get_upnpc_redirection_list_cgi, do_auth },
 #endif
+	{ "reaper_wifisetup.cgi*", "application/json", no_cache_IE7, do_html_post_and_get, do_reaper_wifisetup_cgi, do_auth },
 	{ "chpass.cgi*", "text/html", no_cache_IE7, do_html_post_and_get, do_chpass_cgi, do_auth },
 	{ "get_cta_info.cgi*", "text/html", no_cache_IE7, do_html_post_and_get, do_get_cta_info_cgi, NULL },
 	{ "upload_config_sync.cgi*", "text/html", no_cache_IE7, do_upload_config_sync_post, do_upload_config_sync_cgi, do_auth },
