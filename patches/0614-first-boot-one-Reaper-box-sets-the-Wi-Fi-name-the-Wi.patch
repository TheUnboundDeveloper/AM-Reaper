diff --git a/release/src/router/www/Reaper_WiFiSetup.asp b/release/src/router/www/Reaper_WiFiSetup.asp
new file mode 100644
index 0000000000..44f9e6303e
--- /dev/null
+++ b/release/src/router/www/Reaper_WiFiSetup.asp
@@ -0,0 +1,589 @@
+<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
+<html xmlns="http://www.w3.org/1999/xhtml">
+<!--
+	Reaper_WiFiSetup.asp - first-boot setup box (v3.1.0)
+
+	One step for a factory box: Wi-Fi network name, Wi-Fi password, router login
+	password. Replaces the stock Advanced_Wireless_Content.asp as the security
+	banner's Wi-Fi target. That page shows the PRIMARY BSS settings; on this
+	build the primaries become the hidden AiMesh backhaul and the user's network
+	lives on the wlN.1 fronthaul VIFs, both rebuilt by cfg_server after a plain
+	wireless apply. This box does not reimplement that: reaper_wifisetup.cgi
+	writes exactly what the stock page's apply writes (one SSID on every radio,
+	psk2sae on 2.4/5 GHz, sae on 6 GHz, Smart Connect on) and the form fires the
+	same restart_wireless, so the fronthaul/backhaul split is the same code path.
+
+	CREDENTIALS follow Main_Password.asp exactly (reaper-ui rule 28): the
+	synchronous httpApi.chpass() call (it supplies http_id itself), then the
+	start_apply form with action_script "saveNvram;restart_chpass" so the new
+	password is committed and reaches /etc/shadow. restart_wireless is appended
+	to that chain so the radios restart AFTER the password is persisted, and only
+	when both halves were accepted.
+
+	ORDER MATTERS: chpass first (it needs the CURRENT session), then the Wi-Fi
+	CGI (nvram only, no restart), then the single form submit that restarts both.
+	A refused password stops everything; a refused Wi-Fi setting still persists
+	the password change so the box is never left half-done.
+
+	i18n: RWFS_* tokens (English-seeded, 25 packs) plus reused stock tokens.
+	Tokens appear only in double-quoted or backtick JS strings (rule 29) and in
+	HTML text. ASCII only (rule 1). Rendered with the reaper theme via
+	reaper_css_only[] and never bounced (reaper_skip[]), like Main_Password.asp.
+-->
+<head>
+<meta http-equiv="X-UA-Compatible" content="IE=Edge"/>
+<meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
+<meta HTTP-EQUIV="Pragma" CONTENT="no-cache">
+<meta HTTP-EQUIV="Expires" CONTENT="-1">
+<meta name="viewport" content="width=device-width, initial-scale=1, user-scalable=no">
+<link rel="shortcut icon" href="images/favicon.png">
+<link rel="icon" href="images/favicon.png">
+<title>Reaper</title>
+<script language="JavaScript" type="text/javascript" src="/js/jquery.js"></script>
+<script type="text/javascript" src="/js/httpApi.js"></script>
+<script type="text/javascript" src="/js/https_redirect/https_redirect.js"></script>
+<style>
+body{
+	font-family: Arial, MS UI Gothic, MS P Gothic, Microsoft Yahei UI, sans-serif;
+}
+.wrapper{
+	background:#1F1F1F url(images/New_ui/login_bg.png) no-repeat center center fixed;
+	background-size: cover;
+}
+.button{
+	background-color: #279FD9;
+	border: 0px;
+	border-radius: 4px ;
+	transition: visibility 0s linear 0.218s,opacity 0.218s,background-color 0.218s;
+	height: 48px;
+	width: 260px;
+	font-size: 14pt;
+	color:#fff;
+	text-align:center;
+	vertical-align:center;
+	cursor:pointer;
+}
+.form_input{
+	background-color:rgba(255,255,255,0.2);
+	background-color:#576D73\9;
+	border-radius: 4px;
+	padding:13px 11px;
+	width: 380px;
+	border: 0;
+	height:25px;
+	color:#fff;
+	font-size:16px
+}
+.main_content{
+	width: 100%;
+	max-width: 640px;
+	color: #FFF;
+}
+.main_content > div{
+	position: relative;
+	margin: 22px 0px 0px 78px;
+}
+.main_content .title_name{
+	font-size: 30pt;
+	color:#93d2d9;
+}
+.main_content .title_name:before{
+	position: absolute;
+	content: "";
+	background-image: url(/images/New_ui/icon_titleName.png);
+	width: 73px;
+	height: 73px;
+	background-repeat: no-repeat;
+	left: -73px;
+	background-position: 0% 50%;
+}
+.main_content .sub_title_name{
+	font-size: 14pt;
+	color: #fff;
+	margin-top: 12px;
+}
+.main_content .sect{
+	margin-top: 26px;
+	font-size: 15pt;
+	color:#93d2d9;
+}
+.main_content .lbl{
+	margin-top: 14px;
+	font-size: 12pt;
+}
+.main_content .hint{
+	margin-top: 6px;
+	font-size: 10.5pt;
+	color: #b9c4c7;
+	max-width: 420px;
+}
+.main_content .show_row{
+	margin-top: 12px;
+	font-size: 11pt;
+}
+.main_content #error_status_field{
+	color: rgb(255, 204, 0);
+	margin: 12px 0px -10px 78px;
+	display: none;
+	max-width: 420px;
+}
+.main_content #done_field{
+	color: #7fd9a3;
+	margin: 12px 0px -10px 78px;
+	display: none;
+	max-width: 420px;
+	font-size: 12pt;
+	line-height: 1.5;
+}
+.main_content .btn_bg{
+	display: flex;
+	justify-content: flex-end;
+	height: 68px;
+}
+.main_content .btn_bg #loadingIcon{
+	background-image: url(/images/InternetScan.gif);
+	width: 300px;
+	background-repeat: no-repeat;
+	background-size: 35px 35px;
+	background-position: 50%;
+	display: none;
+}
+.main_content .btn_bg > div{
+	margin-right: 8px;
+	height: 100%;
+}
+/*for mobile device*/
+@media screen and (max-width: 1000px){
+	.main_content{
+		max-width: initial;
+		padding: 0px 10px;
+	}
+	.main_content > div{
+		margin: 16px 0px 0px 0px;
+	}
+	.main_content .title_name:before{
+		display: none;
+	}
+	.main_content #error_status_field, .main_content #done_field{
+		margin: 10px 0px -10px 0px;
+	}
+	.main_content .btn_bg{
+		justify-content: center;
+	}
+	.main_content .btn_bg > div{
+		width: 100%;
+		margin-right: initial;
+	}
+	.form_input{
+		padding: 10px 11px;
+		width: 100%;
+		height: 30px;
+		font-size: 16px;
+	}
+	.button{
+		height: 50px;
+		font-size: 14pt;
+		width: calc(100% - -22px);
+	}
+}
+</style>
+<script>
+String.prototype.repeat = function(times) {
+	return (new Array(times + 1)).join(this);
+};
+String.prototype.strReverse = function() {
+	var newstring = "";
+	for (var s=0; s < this.length; s++) {
+		newstring = this.charAt(s) + newstring;
+	}
+	return newstring;
+};
+var is_AA_sku = (function(){
+	var ttc = '<% nvram_get("territory_code"); %>';
+	return (ttc.search("AA") == -1) ? false : true;
+})();
+var is_KR_sku = (function(){
+	var ttc = '<% nvram_get("territory_code"); %>';
+	return (ttc.search("KR") == -1) ? false : true;
+})();
+var is_SG_sku = (function(){
+	var ttc = '<% nvram_get("territory_code"); %>';
+	return (ttc.search("SG") == -1) ? false : true;
+})();
+var defaultPass = ("<% check_pw(); %>" == "1");
+var secure_default = isSupport("secure_default");
+function isSupport(_ptn){
+	var ui_support = [<% get_ui_support(); %>][0];
+	return (ui_support[_ptn]) ? ui_support[_ptn] : 0;
+}
+function initial(){
+	top.name = "";
+	var windowHeight = (function(){
+		if(window.innerHeight)
+			return window.innerHeight;
+		else if(document.body && document.body.clientHeight)
+			return document.body.clientHeight;
+		else if(document.documentElement && document.documentElement.clientHeight)
+			return document.documentElement.clientHeight;
+		else
+			return 800;
+	})();
+	document.getElementById("loginTable").style.minHeight = (windowHeight-16) + "px";
+	document.getElementById("loginTable").style.display = "";
+	if(is_KR_sku || is_SG_sku || is_AA_sku || secure_default)
+		$("#KRHint").show();
+	/* a box whose admin password is already set needs the current one for
+	   do_chpass (401 without it) - same rule as Main_Password.asp */
+	if(!defaultPass){
+		document.getElementById("cur_password_tr").style.display = "";
+		document.getElementById("cur_password_field").style.display = "";
+	}
+	document.getElementById("wifi_ssid").focus();
+	var order = ["wifi_ssid", "wifi_psk", "http_username_x", "http_passwd_x"];
+	for(var i = 0; i < order.length; i++){
+		(function(idx){
+			document.getElementById(order[idx]).onkeyup = function(e){
+				if(e.keyCode == 13){
+					if(idx + 1 < order.length) document.getElementById(order[idx + 1]).focus();
+					else submitForm();
+				}
+			};
+		})(i);
+	}
+}
+function toggleShow(){
+	var t = document.getElementById("show_pw").checked ? "text" : "password";
+	document.getElementById("wifi_psk").type = t;
+	document.getElementById("http_passwd_x").type = t;
+	var c = document.getElementById("http_passwd_cur");
+	if(c) c.type = t;
+}
+function check_common_string(pwd, flag){
+	var termAlphas = "abcdefghijklmnopqrstuvwxyz";
+	var termNumerics = "01234567890";
+	var termSymbols = "~!@#$%^&*()_+";
+	var termKeyboards1 = "qwertyuiop";
+	var termKeyboards2 = "asdfghjkl";
+	var termKeyboards3 = "zxcvbnm";
+	var termCommon5 = ["123123","abc123","letmein","master","qazwsx","admin"];
+	var termCommon8 = ["adminpassword","loginpassword","passw0rd","password","useradmin","userpassword"];
+	var nSeqString = 0;
+	if(termAlphas.toLowerCase().indexOf(pwd) != -1 || termAlphas.strReverse().toLowerCase().indexOf(pwd) != -1) { nSeqString++; }
+	if(termNumerics.toLowerCase().indexOf(pwd) != -1 || termNumerics.strReverse().toLowerCase().indexOf(pwd) != -1) { nSeqString++; }
+	if(termSymbols.toLowerCase().indexOf(pwd) != -1 || termSymbols.strReverse().toLowerCase().indexOf(pwd) != -1) { nSeqString++; }
+	if(termKeyboards1.toLowerCase().indexOf(pwd) != -1 || termKeyboards1.strReverse().toLowerCase().indexOf(pwd) != -1) { nSeqString++; }
+	if(termKeyboards2.toLowerCase().indexOf(pwd) != -1 || termKeyboards2.strReverse().toLowerCase().indexOf(pwd) != -1) { nSeqString++; }
+	if(flag == "httpd_password"){
+		if(termKeyboards3.toLowerCase().indexOf(pwd) != -1 || termKeyboards3.strReverse().toLowerCase().indexOf(pwd) != -1) { nSeqString++; }
+		for(var s=0;s<termCommon5.length;s++){ if(pwd == termCommon5[s]) { nSeqString++; } }
+	}
+	for(var t=0;t<termCommon8.length;t++){ if(pwd == termCommon8[t]) { nSeqString++; } }
+	if(pwd == pwd.charAt(0).repeat(pwd.length)) { nSeqString++; }
+	return nSeqString > 0;
+}
+function printableAscii(s, allowSpace){
+	for(var i = 0; i < s.length; i++){
+		var c = s.charCodeAt(i);
+		if(c < 32 || c > 126) return false;
+		if(!allowSpace && c == 32) return false;
+	}
+	return true;
+}
+function validSsid(obj){
+	var v = obj.value;
+	/* 1..32 bytes, not blank, printable - the same bounds the wireless page's
+	   validator.stringSSID enforces */
+	if(v.length < 1 || v.length > 32 || v.replace(/ /g, "").length == 0 || !printableAscii(v, true)){
+		showError("<#RWFS_10#>");
+		obj.focus(); obj.select();
+		return false;
+	}
+	return true;
+}
+function validPsk(obj){
+	var v = obj.value;
+	/* 8..63 printable characters, or a 64-hex raw key. hostapd rejects anything
+	   else and then runs with NO key line, which is fatal for every band on this
+	   platform (the v2.9.1 lesson) - so the bound is enforced here AND in the CGI. */
+	var hex64 = (v.length == 64 && /^[0-9a-fA-F]{64}$/.test(v));
+	if(!hex64 && (v.length < 8 || v.length > 63 || !printableAscii(v, true))){
+		showError("<#RWFS_9#>");
+		obj.focus(); obj.select();
+		return false;
+	}
+	return true;
+}
+function validForm(){
+	if(!defaultPass && $("#http_passwd_cur").val().length == 0){
+		showError("<#Input_Current_Password#>");
+		$("#http_passwd_cur").focus();
+		return false;
+	}
+	if(!validSsid(document.getElementById("wifi_ssid"))) return false;
+	if(!validPsk(document.getElementById("wifi_psk"))) return false;
+	if(!validator.chkLoginId(document.form.http_username_x)) return false;
+	if(is_KR_sku || is_SG_sku || is_AA_sku || secure_default){
+		if(!validator.chkLoginPw_KR(document.form.http_passwd_x)) return false;
+		if(document.form.http_passwd_x.value == document.form.http_username_x.value){
+			showError("<#JS_validLoginPWD_same#>");
+			document.form.http_passwd_x.focus(); document.form.http_passwd_x.select();
+			return false;
+		}
+	}
+	else{
+		if(!validator.chkLoginPw(document.form.http_passwd_x)) return false;
+	}
+	if(document.form.http_passwd_x.value == '<% nvram_default_get("http_passwd"); %>'){
+		showError("<#QIS_adminpass_confirm0#>");
+		document.form.http_passwd_x.value = "";
+		document.form.http_passwd_x.focus(); document.form.http_passwd_x.select();
+		return false;
+	}
+	if(check_common_string(document.form.http_passwd_x.value, "httpd_password")){
+		if(!confirm("<#JS_common_passwd#>")){
+			document.form.http_passwd_x.focus(); document.form.http_passwd_x.select();
+			return false;
+		}
+	}
+	if(check_common_string(document.getElementById("wifi_psk").value, "wpa_key")){
+		if(!confirm("<#JS_common_passwd#>")){
+			document.getElementById("wifi_psk").focus(); document.getElementById("wifi_psk").select();
+			return false;
+		}
+	}
+	if(document.getElementById("wifi_psk").value == document.form.http_passwd_x.value){
+		if(!confirm("<#RWFS_13#>")){
+			document.form.http_passwd_x.focus(); document.form.http_passwd_x.select();
+			return false;
+		}
+	}
+	return true;
+}
+/* nvram only - no restart. Returns the parsed JSON reply or null. */
+function applyWifi(ssid, psk){
+	var body = "ssid=" + encodeURIComponent(ssid) + "&psk=" + encodeURIComponent(psk)
+	         + "&http_id=" + encodeURIComponent("<% nvram_get("http_id"); %>");
+	var x = new XMLHttpRequest();
+	x.open("POST", "/reaper_wifisetup.cgi", false);
+	x.setRequestHeader("Content-Type", "application/x-www-form-urlencoded");
+	try{ x.send(body); }catch(e){ return null; }
+	if(x.status != 200) return null;
+	try{ return JSON.parse(x.responseText); }catch(e){ return null; }
+}
+var busy = false;
+function submitForm(){
+	if(busy) return;
+	if(!validForm()) return;
+	busy = true;
+	$("#error_status_field").hide();
+	$("#btn_modify").hide();
+	$("#loadingIcon").show();
+
+	var ssid = document.getElementById("wifi_ssid").value;
+	var psk = document.getElementById("wifi_psk").value;
+	var postData = {
+		"restart_httpd": "0",
+		"new_username": document.form.http_username_x.value,
+		"new_passwd": document.form.http_passwd_x.value,
+		"defpass_enable": "0"
+	};
+	if(!defaultPass){
+		postData.cur_username = '<% nvram_get("http_username"); %>';
+		postData.cur_passwd = $("#http_passwd_cur").val();
+	}
+
+	setTimeout(function(){
+		/* 1. the login password, synchronously, against the CURRENT session.
+		   httpApi.chpass hashes both to hexMD5 and adds http_id itself. */
+		var rc = httpApi.chpass(postData);
+		if(rc != "200"){
+			var msg = "<#Fail_change_password#>";
+			if(rc == "401") msg = "<#Wrong_current_password#>";
+			else if(rc == "402") msg = "<#Five_attempts_logout_hint#>";
+			fail(msg);
+			return;
+		}
+		/* 2. the Wi-Fi settings - nvram + commit only, nothing restarts yet */
+		var r = applyWifi(ssid, psk);
+		if(!r || r.ok != 1){
+			/* persist the password change regardless (rule 28), report the Wi-Fi refusal */
+			document.form.action_script.value = "saveNvram;restart_chpass";
+			document.form.submit();
+			fail("<#RWFS_12#> " + (r && r.error ? r.error : "HTTP"));
+			return;
+		}
+		/* 3. one apply: commit, rebuild shadow, then restart the radios */
+		document.form.action_script.value = "saveNvram;restart_chpass;restart_wireless";
+		document.form.submit();
+		$("#loadingIcon").hide();
+		var done = `<#RWFS_11#>`.replace("%1$@", ssid.replace(/</g, "&lt;").replace(/>/g, "&gt;"));
+		$("#done_field").html(done).show();
+		setTimeout(function(){ location.href = "/"; }, 12000);
+	}, 100);
+}
+function fail(msg){
+	busy = false;
+	$("#loadingIcon").hide();
+	$("#btn_modify").show();
+	showError(msg);
+}
+var validator = {
+	chkLoginId: function(obj){
+		var re = new RegExp("^[a-zA-Z0-9][a-zA-Z0-9\-\_]+$","gi");
+		if(obj.value == ""){
+			showError("<#File_Pop_content_alert_desc1#>");
+			obj.focus(); obj.select();
+			return false;
+		}
+		else if(re.test(obj.value)){
+			if(obj.value == "root" || obj.value == "guest" || obj.value == "anonymous"){
+				showError("<#USB_Application_account_alert#>");
+				obj.focus(); obj.select();
+				return false;
+			}
+			return true;
+		}
+		else{
+			if(obj.value.length < 2) showError("<#JS_short_username#>");
+			else showError("<#JS_validhostname#>");
+			obj.focus(); obj.select();
+			return false;
+		}
+	},
+	chkLoginPw: function(obj){
+		if(obj.value.length > 0 && obj.value.length < 5){
+			showError("<#JS_short_password#> <#JS_password_length#>");
+			obj.focus(); obj.select();
+			return false;
+		}
+		if(obj.value.length > 32){
+			var str_valid_max_password = `<#JS_max_password_var#>`;
+			str_valid_max_password = str_valid_max_password.replace("%1$@", "5");
+			showError(str_valid_max_password);
+			obj.focus(); obj.select();
+			return false;
+		}
+		if(obj.value.charAt(0) == '"'){
+			showError("<#JS_validstr1#> [\"]");
+			obj.focus(); obj.select();
+			return false;
+		}
+		else if(obj.value.charAt(obj.value.length - 1) == '"'){
+			showError("<#JS_validstr3#> [\"]");
+			obj.focus(); obj.select();
+			return false;
+		}
+		else{
+			var invalid_char = "";
+			for(var i = 0; i < obj.value.length; ++i){
+				if(obj.value.charAt(i) < ' ' || obj.value.charAt(i) > '~'){
+					invalid_char = invalid_char+obj.value.charAt(i);
+				}
+			}
+			if(invalid_char != ""){
+				showError("<#JS_validstr2#> '"+invalid_char+"' !");
+				obj.focus(); obj.select();
+				return false;
+			}
+		}
+		return true;
+	},
+	chkLoginPw_KR: function(obj){
+		var string_length = obj.value.length;
+		if(!/[A-Za-z]/.test(obj.value) || !/[0-9]/.test(obj.value) || string_length < 10
+				|| !/[\!\"\#\$\%\&\'\(\)\*\+\,\-\.\/\:\;\<\=\>\?\@\[\\\]\^\_\`\{\|\}\~]/.test(obj.value)){
+			showError("Password must contain at least 10 characters in length, including 1 letter, 1 special character, and 1 numeric character.");
+			obj.focus(); obj.select();
+			return false;
+		}
+		if(obj.value.length > 32){
+			var str_valid_max_password = `<#JS_max_password_var#>`;
+			str_valid_max_password = str_valid_max_password.replace("%1$@", "10");
+			showError(str_valid_max_password);
+			obj.focus(); obj.select();
+			return false;
+		}
+		var invalid_char = "";
+		for(var i = 0; i < obj.value.length; ++i){
+			if(obj.value.charAt(i) <= ' ' || obj.value.charAt(i) > '~'){
+				invalid_char = invalid_char+obj.value.charAt(i);
+			}
+		}
+		if(invalid_char != ""){
+			showError("<#JS_validstr2#> '"+invalid_char+"' !");
+			obj.focus(); obj.select();
+			return false;
+		}
+		return true;
+	}
+};
+function showError(str){
+	$("#error_status_field").show();
+	$("#error_status_field").html(str);
+}
+</script>
