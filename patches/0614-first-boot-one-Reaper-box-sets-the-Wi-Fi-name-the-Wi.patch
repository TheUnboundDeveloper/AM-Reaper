+					<input type="password" id="wifi_psk" tabindex="2" class="form_input" maxlength="64" value="" autocapitalize="off" autocomplete="off" placeholder="<#RWFS_3#>">
+				</div>
+				<div class="hint"><#RWFS_4#></div>
+
+				<div class="sect"><#PASS_changepasswd#></div>
+				<div id="cur_password_tr" class="lbl" style="display:none"><#Current_Login_Password#></div>
+				<div id="cur_password_field" style="display:none">
+					<input type="password" autocapitalize="off" autocomplete="off" value="" id="http_passwd_cur" class="form_input" maxlength="33" placeholder="<#Current_Login_Password#>">
+				</div>
+				<div class="lbl"><#Router_Login_Name#></div>
+				<div>
+					<input type="text" name="http_username_x" id="http_username_x" tabindex="3" class="form_input" maxlength="32" value="<% nvram_get("http_username"); %>" autocapitalize="off" autocomplete="off" placeholder="<#Router_Login_Name#>">
+				</div>
+				<div class="lbl"><#RWFS_5#></div>
+				<div>
+					<input type="password" autocapitalize="off" autocomplete="off" value="" name="http_passwd_x" id="http_passwd_x" tabindex="4" class="form_input" maxlength="33" placeholder="<#RWFS_5#>">
+				</div>
+				<div class="hint"><#RWFS_6#></div>
+				<div id="KRHint" class="hint" style="display:none">Password must contain at least 10 characters in length, including 1 letter, 1 special character, and 1 numeric character.</div>
+				<div class="show_row"><label><input type="checkbox" id="show_pw" onchange="toggleShow()" style="vertical-align:middle;margin-right:8px"><#RWFS_7#></label></div>
+
+				<div id="error_status_field"></div>
+				<div id="done_field"></div>
+				<div class="btn_bg">
+					<div id="loadingIcon"></div>
+					<div><input id="btn_modify" type="button" class="button" onclick="submitForm();" value="<#RWFS_8#>"></div>
+				</div>
+			</div>
