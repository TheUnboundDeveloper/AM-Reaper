+					<!-- no name= attributes on the Wi-Fi fields: they must not ride the
+					     start_apply form POST; reaper_wifisetup.cgi is their only path -->
+					<input type="text" id="wifi_ssid" tabindex="1" class="form_input" maxlength="32" value="" autocapitalize="off" autocomplete="off" placeholder="<#QIS_finish_wireless_item1#>">
+				</div>
