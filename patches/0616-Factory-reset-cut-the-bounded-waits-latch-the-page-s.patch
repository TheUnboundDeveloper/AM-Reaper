diff --git a/release/src/router/httpd/web.c b/release/src/router/httpd/web.c
index 61af58eaee..4dd12d9765 100644
--- a/release/src/router/httpd/web.c
+++ b/release/src/router/httpd/web.c
@@ -12958,8 +12958,18 @@ prepare_restore(webs_t wp){
 	 * Don't stop 3G/4G here.  If yes and end-user connect to
 	 * administrative page through 3G/4G, he/she can't see Restarting.asp
 	 */
-	if (!notify_rc_and_wait_2min("stop_app"))
-		_dprintf("%s: send stop_app rc_service fail!\n", __func__);
+	/* reaper v3.1.0 (factory-reset timing): this round trip is a synchronous
+	 * rc_service wait - up to two minutes for rc to go idle and up to two
+	 * more for completion - and rc's stop_app() returns -1 at once unless a
+	 * USB application is mounted (apps_dev + apps_mounted_path, its own
+	 * precondition). Send it only when it has work; log the decision so the
+	 * reset has a timestamp in the syslog. */
+	logmessage("reaper", "factory reset: request accepted, preparing");
+	if (*nvram_safe_get("apps_dev") && *nvram_safe_get("apps_mounted_path")) {
+		if (!notify_rc_and_wait_2min("stop_app"))
+			_dprintf("%s: send stop_app rc_service fail!\n", __func__);
+	} else
+		logmessage("reaper", "factory reset: no USB application mounted, stop_app skipped");
 
 	/* Enlarge reboot_time temporarily. */
 	nvram_set_int("reboot_time", nvram_get_int("reboot_time") + offset);
@@ -13576,14 +13586,20 @@ apply_cgi(webs_t wp, char_t *urlPrefix, char_t *webDir, int arg,
 	else if (!strcmp(action_mode, "Restore")||!strcmp(action_mode, "restore"))
 	{
 		prepare_restore(wp);
-		sys_default();
+		/* reaper v3.1.0: notify_rc() gives the event up after 15 s if rc is
+		 * busy and the reset silently never happens; the waiting form holds
+		 * for up to two minutes. The client already has Restarting.asp. */
+		if (!notify_rc_and_wait_2min("resetdefault"))
+			logmessage("reaper", "factory reset: rc did not accept resetdefault");
 
 		remove_all_uploaded_cert_from_jffs();
 	}
 	else if (!strcmp(action_mode, "restore_erase"))
 	{
 		prepare_restore(wp);
-		sys_default_erase();
+		/* reaper v3.1.0: same waiting form as the plain reset above. */
+		if (!notify_rc_and_wait_2min("resetdefault_erase"))
+			logmessage("reaper", "factory reset: rc did not accept resetdefault_erase");
 
 		remove_all_uploaded_cert_from_jffs();
 	}
diff --git a/release/src/router/rc/services.c b/release/src/router/rc/services.c
index d62787da2d..75aa02858d 100644
--- a/release/src/router/rc/services.c
+++ b/release/src/router/rc/services.c
@@ -16141,11 +16141,20 @@ void check_services(void)
 
 void factory_reset(void)
 {
+	unsigned long _fr_t0 = uptime();	/* reaper v3.1.0: syslog timers */
 #ifdef RTCONFIG_CONCURRENTREPEATER
 	nvram_set_int("led_status", LED_FACTORY_RESET);
 #endif
 	g_reboot = 1;
 	f_write_string("/tmp/reboot", "1", 0, 0);
+	/* reaper v3.1.0 (factory-reset timing): mirror the "reboot" handler.
+	 * Holding ACT_REBOOT from pid 1 makes every later wait_action_idle()
+	 * caller stop at once (nvram_commit included - nothing may commit over
+	 * the erase anyway) and lets shutdn() skip its 30-second busy loop when
+	 * a daemon dies holding the action lock mid-commit. */
+	logmessage("reaper", "factory reset: begin");
+	if (wait_action_idle(10))
+		set_action(ACT_REBOOT);
 #ifdef RTCONFIG_REALTEK
 /* [MUST] : Need to Clarify ... */
 	set_led(LED_BLINK_SLOW, LED_BLINK_SLOW);
@@ -16209,6 +16218,7 @@ void factory_reset(void)
 #endif
 
 	sleep(3);
+	logmessage("reaper", "factory reset: wan/usb stopped (%lu s)", (unsigned long)uptime() - _fr_t0);
 	nvram_set(ASUS_STOP_COMMIT, "1");
 	if(nvram_contains_word("rc_support", "nandflash"))	/* RT-AC56S,U/RT-AC68U/RT-N18U */
 	{
@@ -16237,6 +16247,7 @@ void factory_reset(void)
 	eval("mtd-erase", "-d", "plc");
 #endif
 
+	logmessage("reaper", "factory reset: nvram erased, handing off to init (%lu s)", (unsigned long)uptime() - _fr_t0);
 	nvram_set("sys_reboot_reason", "rc_func_fact_rst");
 	kill(1, SIGTERM);
 }
