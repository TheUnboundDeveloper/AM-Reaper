diff --git a/release/src/router/rom/webs_scripts/reaper_webs_note.sh b/release/src/router/rom/webs_scripts/reaper_webs_note.sh
index ef64a11340..417f1c6ec4 100755
--- a/release/src/router/rom/webs_scripts/reaper_webs_note.sh
+++ b/release/src/router/rom/webs_scripts/reaper_webs_note.sh
@@ -28,10 +28,26 @@ fi
 ver=$(echo "$info" | sed 's/.*Reaper_v//; s/[^0-9.].*//')
 [ -z "$ver" ] && { nvram set cfg_note=2; exit 0; }
 
-/usr/sbin/wget $wget_options "$RAW_BASE/Reaper_v${ver}.txt" -O "$NOTE_PATH"
-if [ "$?" != "0" ] || [ ! -s "$NOTE_PATH" ]; then
+# v3.1.0: a beta offer (webs_state_channel=beta, set by the update check)
+# reads the beta note first - the Dev-branch publish writes Reaper_v<ver>-beta.txt
+# - and falls back to the plain note of the same number, then to the pointer.
+chan=$(nvram get webs_state_channel)
+got=0
+if [ "$chan" = "beta" ]; then
+	/usr/sbin/wget $wget_options "$RAW_BASE/Reaper_v${ver}-beta.txt" -O "$NOTE_PATH"
+	[ "$?" = "0" ] && [ -s "$NOTE_PATH" ] && got=1
+fi
+if [ "$got" != "1" ]; then
+	/usr/sbin/wget $wget_options "$RAW_BASE/Reaper_v${ver}.txt" -O "$NOTE_PATH"
+	[ "$?" = "0" ] && [ -s "$NOTE_PATH" ] && got=1
+fi
+if [ "$got" != "1" ]; then
 	# no per-version note published; point at the GitHub release page instead
-	echo "Reaper v${ver} is available." > "$NOTE_PATH"
+	if [ "$chan" = "beta" ]; then
+		echo "Reaper v${ver} (beta, Dev branch) is available." > "$NOTE_PATH"
+	else
+		echo "Reaper v${ver} is available." > "$NOTE_PATH"
+	fi
 	echo "" >> "$NOTE_PATH"
 	echo "Release notes: https://github.com/TheUnboundDeveloper/AM-Reaper/releases" >> "$NOTE_PATH"
 fi
diff --git a/release/src/router/rom/webs_scripts/reaper_webs_update.sh b/release/src/router/rom/webs_scripts/reaper_webs_update.sh
index 7a8d93a34f..1873adfc39 100755
--- a/release/src/router/rom/webs_scripts/reaper_webs_update.sh
+++ b/release/src/router/rom/webs_scripts/reaper_webs_update.sh
@@ -6,6 +6,14 @@
 # stock webs_state_* nvram the firmware page already renders. It NEVER downloads
 # or flashes an image (Phase 1). Opt-in: rc only runs this when the user has
 # enabled the check (firmware_check_enable=1; default 0).
+#
+# v3.1.0: a BETA channel. The manifest may carry a second line per model and
+# variant, MODEL#VARIANT-beta#..., written by the Dev-branch publish. It is
+# read only when the admin opted in (reaper_fwbeta=1), and a beta is offered
+# only to a router that is already on the newest stable release and only when
+# the beta carries a HIGHER number than that stable; a beta with the stable's
+# own number is never offered. Firmware older than v3.1.0 anchors its grep on
+# "VARIANT#" and so never sees the beta line at all.
 
 wget_options="-q -t 2 -T 30"
 MANIFEST_URL="https://raw.githubusercontent.com/TheUnboundDeveloper/AM-Reaper/main/updates/manifest_3006.txt"
@@ -18,6 +26,7 @@ nvram set webs_state_error=0
 nvram set webs_state_url=""
 nvram set webs_state_sha256=""
 nvram set webs_state_size=""
+nvram set webs_state_channel=""
 
 echo "---- reaper update check $(date) ----" > "$LOG"
 
@@ -125,38 +134,48 @@ else
 	echo "---- manifest signature enforcement disabled in this build ----" >> "$LOG"
 fi
 
-# manifest line: MODEL#VARIANT#X.Y.Z#<download-url>[#SHA256[#SIZE]]
+# manifest lines: MODEL#VARIANT#X.Y.Z#<download-url>[#SHA256[#SIZE]]       stable
+#                 MODEL#VARIANT-beta#X.Y.Z#<download-url>#SHA256#SIZE       beta (v3.1.0)
 # (fields 5/6 arrived with Phase 2; older manifests lack them - the page then
 # offers notify-only and the upgrade script refuses to flash unverified)
 line=$(grep "^${model}#${variant}#" "$TMP" | head -1)
+beta_line=""
+BETA_EN="$(nvram get reaper_fwbeta)"
+if [ "$BETA_EN" = "1" ]; then
+	beta_line=$(grep "^${model}#${variant}-beta#" "$TMP" | head -1)
+	echo "---- beta channel enabled ($([ -n "$beta_line" ] && echo "beta entry present" || echo "no beta entry")) ----" >> "$LOG"
+fi
+rm -f "$TMP"
 if [ -z "$line" ]; then
 	echo "---- no manifest entry for ${model}#${variant} ----" >> "$LOG"
 	nvram set webs_state_error=1
 	nvram set webs_state_update=1
-	rm -f "$TMP"
 	exit 0
 fi
 
-rem_ver=$(echo "$line" | cut -d'#' -f3)
-rem_url=$(echo "$line" | cut -d'#' -f4)
-rem_sha=$(echo "$line" | cut -d'#' -f5)
-rem_size=$(echo "$line" | cut -d'#' -f6)
-rm -f "$TMP"
+# parse_entry LINE: fills rem_ver/rem_url/rem_sha/rem_size, fails on ANY
+# malformed field. The manifest is fetched over the network; its fields land
+# in nvram, are rendered in the admin GUI, and (url) are handed to the
+# downloader, so a tampered or spoofed entry is rejected whole rather than
+# trusted in part. GitHub-hosted URLs use only [A-Za-z0-9._:/-].
+parse_entry() {
+	rem_ver=$(echo "$1" | cut -d'#' -f3)
+	rem_url=$(echo "$1" | cut -d'#' -f4)
+	rem_sha=$(echo "$1" | cut -d'#' -f5)
+	rem_size=$(echo "$1" | cut -d'#' -f6)
+	bad=
+	case "$rem_ver" in ''|*[!0-9.]*) bad=1 ;; esac
+	case "$rem_url" in https://*) ;; *) bad=1 ;; esac
+	case "$rem_url" in *[!A-Za-z0-9._:/-]*) bad=1 ;; esac
+	if [ -n "$rem_sha" ]; then
+		case "$rem_sha" in *[!0-9a-fA-F]*) bad=1 ;; esac
+		[ ${#rem_sha} -eq 64 ] || bad=1
+	fi
+	case "$rem_size" in *[!0-9]*) rem_size="" ;; esac
+	[ -z "$bad" ]
+}
 
-# The manifest is fetched over the network; its fields land in nvram, are
-# rendered in the admin GUI, and (url) are handed to the downloader. Reject
-# the whole entry on ANY malformed field rather than trust a tampered or
-# spoofed manifest. GitHub-hosted URLs use only [A-Za-z0-9._:/-].
-bad=
-case "$rem_ver" in ''|*[!0-9.]*) bad=1 ;; esac
-case "$rem_url" in https://*) ;; *) bad=1 ;; esac
-case "$rem_url" in *[!A-Za-z0-9._:/-]*) bad=1 ;; esac
-if [ -n "$rem_sha" ]; then
-	case "$rem_sha" in *[!0-9a-fA-F]*) bad=1 ;; esac
-	[ ${#rem_sha} -eq 64 ] || bad=1
-fi
-case "$rem_size" in *[!0-9]*) rem_size="" ;; esac
-if [ -n "$bad" ]; then
+if ! parse_entry "$line"; then
 	echo "---- manifest entry REJECTED: malformed field(s) ----" >> "$LOG"
 	nvram set webs_state_error=1
 	nvram set webs_state_update=1
@@ -166,12 +185,31 @@ fi
 # numeric compare: X.Y.Z -> XXXYYYZZZ (zero-padded), integer -gt
 ver_num() { echo "$1" | awk -F. '{printf "%d%03d%03d\n", $1+0, $2+0, $3+0}'; }
 cur_n=$(ver_num "$cur_ver")
-rem_n=$(ver_num "$rem_ver")
-
-echo "---- published=$rem_ver ($rem_n) running=$cur_ver ($cur_n) ----" >> "$LOG"
+s_n=$(ver_num "$rem_ver")
+
+echo "---- published=$rem_ver ($s_n) running=$cur_ver ($cur_n) ----" >> "$LOG"
+
+offer=""
+if [ "$s_n" -gt "$cur_n" ] 2>/dev/null; then
+	offer=stable
+elif [ -n "$beta_line" ]; then
+	# The stable branch above did not fire, so this router is on (or past) the
+	# newest stable. Offer the beta only when it is newer than BOTH what is
+	# running and that stable - the same number as the stable is never a beta.
+	if parse_entry "$beta_line"; then
+		b_n=$(ver_num "$rem_ver")
+		echo "---- beta=$rem_ver ($b_n) ----" >> "$LOG"
+		if [ "$b_n" -gt "$cur_n" ] 2>/dev/null && [ "$b_n" -gt "$s_n" ] 2>/dev/null; then
+			offer=beta
+		fi
+	else
+		echo "---- beta entry IGNORED: malformed field(s) ----" >> "$LOG"
+	fi
+fi
 
-if [ "$rem_n" -gt "$cur_n" ] 2>/dev/null; then
-	echo "---- update available: Reaper v$rem_ver ----" >> "$LOG"
+case "$offer" in
+stable|beta)
+	echo "---- update available: Reaper v$rem_ver ($offer) ----" >> "$LOG"
 	nvram set webs_state_flag=1
 	# firmware-string shape the page renders; keeps the Reaper version visible
 	nvram set webs_state_info="3006.102.8_Reaper_v${rem_ver}"
@@ -179,9 +217,14 @@ if [ "$rem_n" -gt "$cur_n" ] 2>/dev/null; then
 	nvram set webs_state_url="$rem_url"
 	nvram set webs_state_sha256="$rem_sha"
 	nvram set webs_state_size="$rem_size"
-else
+	# the page and the dashboard badge label a beta; the note script fetches
+	# the beta note
+	[ "$offer" = "beta" ] && nvram set webs_state_channel=beta
+	;;
+*)
 	echo "---- up to date ----" >> "$LOG"
 	nvram set webs_state_flag=0
-fi
+	;;
+esac
 
 nvram set webs_state_update=1
