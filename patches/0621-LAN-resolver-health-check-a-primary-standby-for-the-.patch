diff --git a/release/src/router/rc/rdnshc.c b/release/src/router/rc/rdnshc.c
new file mode 100644
index 0000000000..e9132e770a
--- /dev/null
+++ b/release/src/router/rc/rdnshc.c
@@ -0,0 +1,395 @@
+/*
+ * SPDX-License-Identifier: GPL-2.0-only
+ * Copyright (C) 2026 the Reaper project maintainer
+ *
+ * reaper v3.1.1: LAN resolver health check - a primary/standby the resolver
+ * itself does not have.
+ *
+ * dnsmasq (2.93 here) keeps no memory of an upstream that stopped answering.
+ * In strict-order mode every fresh query starts at the first server again and
+ * only a CLIENT retransmission moves a query to the next one; dnsmasq's own
+ * fast retries (on with DNSSEC) re-send to the same server; silence is never
+ * treated as failure, only SERVFAIL/REFUSED is. So with a LAN resolver such as
+ * AdGuard or Pi-hole listed first and a WAN resolver second, an outage of the
+ * LAN box costs every uncached name a client timeout (1 s on Windows, 5 s on
+ * Linux/Android), and a client that also lists the router second needs THREE
+ * attempts before dnsmasq's second server answers - which on Linux/Android
+ * can outlive dnsmasq's 10-s query lifetime and fail outright.
+ *
+ * This daemon probes ONE server the admin names (nvram reaper_dnshc_target)
+ * with a real DNS query every reaper_dnshc_interval seconds. After
+ * reaper_dnshc_fail consecutive misses it moves that server's lines to the END
+ * of /tmp/resolv.dnsmasq (dnsmasq's servers-file) and /tmp/resolv.conf (the
+ * router's own libc resolver) and reloads dnsmasq, so the first server tried
+ * is one that answers. After reaper_dnshc_recover consecutive hits it rebuilds
+ * both files through the firmware's own writer, update_resolvconf(), which
+ * restores the stock order, and reloads again. While demoted it re-asserts
+ * the order every tick, because wan_up() and the VPN clients rewrite the file
+ * whenever they feel like it. Every transition is one syslog line.
+ *
+ * NOT the ASUS "Network Monitoring" DNS probe (wanduck): that one resolves a
+ * name THROUGH the router to decide whether the WAN counts as connected, and
+ * feeds nothing but WAN state and dual-WAN failover.
+ *
+ * Runs as an rc applet (/sbin/rdnshc -> rc), started from start_services()
+ * in router mode; restart_rdnshc is the service the System page fires. The
+ * daemon keeps running while the feature is off (one nvram read every 30 s)
+ * so a disable restores the stock order through the same path as a recovery.
+ */
+#include "rc.h"
+#include <signal.h>
+#include <errno.h>
+#include <sys/socket.h>
+#include <sys/select.h>
+#include <sys/time.h>
+#include <sys/sysinfo.h>
+#include <netinet/in.h>
+#include <arpa/inet.h>
+#ifdef RTCONFIG_MULTILAN_CFG
+#include "sdn.h"
+#endif
+
+#define HC_TAG		"rdnshc"
+#define HC_POLL_OFF	30		/* s, feature disabled: only the switch is watched */
+#define HC_STATE	"/tmp/rdnshc.state"	/* "<target>" while demoted, so a restart adopts it */
+#define HC_DNSMASQ	"/tmp/resolv.dnsmasq"
+#define HC_RESOLV	"/tmp/resolv.conf"
+#define HC_MAXLINES	256
+#define HC_LINE		256
+
+struct hc_cfg {
+	int enable;
+	char target[INET_ADDRSTRLEN];
+	char name[128];
+	int interval;		/* s */
+	int timeout_ms;
+	int fail;
+	int recover;
+	int strict;		/* 1 = a reply must be NOERROR with at least one record */
+};
+
+static volatile sig_atomic_t g_stop;
+static void on_sig(int s) { (void)s; g_stop = 1; }
+
+static long now_s(void)
+{
+	struct sysinfo si;
+	return sysinfo(&si) == 0 ? (long)si.uptime : (long)time(NULL);
+}
+
+static int clamp(int v, int lo, int hi, int dflt)
+{
+	if (v == 0) return dflt;
+	return v < lo ? lo : (v > hi ? hi : v);
+}
+
+static void cfg_read(struct hc_cfg *c)
+{
+	const char *p;
+	struct in_addr a;
+	size_t i;
+
+	memset(c, 0, sizeof(*c));
+	c->enable = nvram_get_int("reaper_dnshc_enable");
+	p = nvram_safe_get("reaper_dnshc_target");
+	if (*p && inet_pton(AF_INET, p, &a) == 1)
+		strlcpy(c->target, p, sizeof(c->target));
+	p = nvram_safe_get("reaper_dnshc_name");
+	strlcpy(c->name, (*p ? p : "localhost"), sizeof(c->name));
+	for (i = 0; c->name[i]; i++) {
+		char ch = c->name[i];
+		if (!((ch >= 'a' && ch <= 'z') || (ch >= 'A' && ch <= 'Z') || (ch >= '0' && ch <= '9') || ch == '-' || ch == '.' || ch == '_')) {
+			strlcpy(c->name, "localhost", sizeof(c->name));
+			break;
+		}
+	}
+	c->interval = clamp(nvram_get_int("reaper_dnshc_interval"), 3, 300, 10);
+	c->timeout_ms = clamp(nvram_get_int("reaper_dnshc_timeout"), 200, 5000, 1000);
+	c->fail = clamp(nvram_get_int("reaper_dnshc_fail"), 1, 10, 3);
+	c->recover = clamp(nvram_get_int("reaper_dnshc_recover"), 1, 10, 3);
+	c->strict = nvram_get_int("reaper_dnshc_strict");
+}
+
+/* One UDP query for <name> A IN, sent straight to target:53 (never through
+ * dnsmasq). 1 = a reply with our id came back (strict: NOERROR + >=1 record),
+ * 0 = silence, an error, or a reply that does not qualify. */
+static int probe(const struct hc_cfg *c)
+{
+	unsigned char pkt[512];
+	unsigned char *q;
+	const char *lab, *dot;
+	struct sockaddr_in sa;
+	struct timeval tv;
+	fd_set rf;
+	unsigned short id;
+	int fd, len, r, n, ok = 0;
+
+	id = (unsigned short)((getpid() << 4) ^ (unsigned)now_s() ^ (unsigned)rand());
+	memset(pkt, 0, sizeof(pkt));
+	pkt[0] = id >> 8; pkt[1] = id & 0xff;
+	pkt[2] = 0x01;				/* RD */
+	pkt[5] = 1;				/* QDCOUNT */
+	q = pkt + 12;
+	lab = c->name;
+	while (*lab) {
+		dot = strchr(lab, '.');
+		n = dot ? (int)(dot - lab) : (int)strlen(lab);
+		if (n <= 0 || n > 63 || (q - pkt) + n + 1 > (int)sizeof(pkt) - 8) return 0;
+		*q++ = (unsigned char)n;
+		memcpy(q, lab, n);
+		q += n;
+		lab = dot ? dot + 1 : lab + n;
+	}
+	*q++ = 0;
+	*q++ = 0; *q++ = 1;			/* QTYPE A */
+	*q++ = 0; *q++ = 1;			/* QCLASS IN */
+	len = (int)(q - pkt);
+
+	memset(&sa, 0, sizeof(sa));
+	sa.sin_family = AF_INET;
+	sa.sin_port = htons(53);
+	if (inet_pton(AF_INET, c->target, &sa.sin_addr) != 1) return 0;
+
+	if ((fd = socket(AF_INET, SOCK_DGRAM, 0)) < 0) return 0;
+	if (connect(fd, (struct sockaddr *)&sa, sizeof(sa)) < 0 || send(fd, pkt, len, 0) != len) {
+		close(fd);
+		return 0;
+	}
+	FD_ZERO(&rf);
+	FD_SET(fd, &rf);
+	tv.tv_sec = c->timeout_ms / 1000;
+	tv.tv_usec = (c->timeout_ms % 1000) * 1000;
+	do {
+		r = select(fd + 1, &rf, NULL, NULL, &tv);
+	} while (r < 0 && errno == EINTR && !g_stop);
+	if (r > 0) {
+		r = recv(fd, pkt, sizeof(pkt), 0);
+		if (r >= 12 && pkt[0] == (id >> 8) && pkt[1] == (id & 0xff) && (pkt[2] & 0x80)) {
+			if (!c->strict)
+				ok = 1;
+			else {
+				int rcode = pkt[3] & 0x0f;
+				int ancount = (pkt[6] << 8) | pkt[7];
+				ok = (rcode == 0 && ancount > 0);
+			}
+		}
+	}
+	close(fd);
+	return ok;
+}
+
+/* Does this line name the target as a plain upstream? For the servers-file
+ * that is "server=<ip>" or "server=<ip>#port" (a "server=/domain/<ip>" line
+ * is a domain route and is left where it is); for resolv.conf it is
+ * "nameserver <ip>". */
+static int line_is_target(const char *line, const char *prefix, const char *target)
+{
+	size_t pl = strlen(prefix), tl = strlen(target);
+	if (strncmp(line, prefix, pl) != 0) return 0;
+	if (strncmp(line + pl, target, tl) != 0) return 0;
+	return line[pl + tl] == 0 || line[pl + tl] == '\n' || line[pl + tl] == '#' || line[pl + tl] == ' ' || line[pl + tl] == '\t';
+}
+
+/* A plain upstream of the same kind (used to decide whether the target is
+ * already last among them). */
+static int line_is_upstream(const char *line, const char *prefix)
+{
+	size_t pl = strlen(prefix);
+	if (strncmp(line, prefix, pl) != 0) return 0;
+	return line[pl] != '/';
+}
+
+/* Move the target's plain-upstream line(s) to the end of the file. Returns
+ * 1 if the file was rewritten, 0 if there was nothing to do (no such line,
+ * or it is already the last upstream), -1 on error. Caller holds the lock. */
+static int demote_file(const char *path, const char *prefix, const char *target, int *n_upstreams)
+{
+	static char lines[HC_MAXLINES][HC_LINE];
+	int n = 0, i, last_other = -1, last_target = -1, first_target = -1, nup = 0;
+	FILE *fp;
+
+	if (!(fp = fopen(path, "r"))) return -1;
+	while (n < HC_MAXLINES && fgets(lines[n], HC_LINE, fp)) {
+		if (line_is_target(lines[n], prefix, target)) {
+			if (first_target < 0) first_target = n;
+			last_target = n;
+			nup++;
+		} else if (line_is_upstream(lines[n], prefix)) {
+			last_other = n;
+			nup++;
+		}
+		n++;
+	}
+	fclose(fp);
+	if (n_upstreams) *n_upstreams = nup;
+	if (first_target < 0) return 0;
+	if (last_other < first_target) return 0;	/* already last among the upstreams */
+	if (!(fp = fopen(path, "w"))) return -1;
+	for (i = 0; i < n; i++)
+		if (!line_is_target(lines[i], prefix, target))
+			fputs(lines[i], fp);
+	for (i = 0; i < n; i++)
+		if (line_is_target(lines[i], prefix, target))
+			fputs(lines[i], fp);
+	fclose(fp);
+	(void)last_target;
+	return 1;
+}
+
+static void hc_reload(void)
+{
+#ifdef RTCONFIG_MULTILAN_CFG
+	reload_dnsmasq(ALL_SDN);
+#else
+	reload_dnsmasq();
+#endif
+}
+
+/* returns the number of plain upstreams dnsmasq has, so the log can say when
+ * there is nothing to fall back to */
+static int demote(const char *target, int *changed)
+{
+	int lock, a, b, nup = 0;
+	lock = file_lock("resolv");
+	a = demote_file(HC_DNSMASQ, "server=", target, &nup);
+	b = demote_file(HC_RESOLV, "nameserver ", target, NULL);
+	file_unlock(lock);
+	if (changed) *changed = (a == 1 || b == 1);
+	if (a == 1) hc_reload();
+	return nup;
+}
+
+static void restore(void)
+{
+	update_resolvconf();	/* takes the resolv lock itself; rebuilds both files in stock order */
+	hc_reload();
+}
+
+static void state_set(const char *what, long since, int alive)
+{
+	char st[64];
+	if (!*what) { nvram_set("reaper_dnshc_state", ""); return; }
+	snprintf(st, sizeof(st), "%s %ld %d", what, since > 0 ? now_s() - since : 0, alive);
+	nvram_set("reaper_dnshc_state", st);
+}
+
+int rdnshc_main(int argc, char *argv[])
+{
+	struct hc_cfg c;
+	char watched[INET_ADDRSTRLEN] = "";
+	int down = 0, misses = 0, hits = 0, last_enabled = -1, i, alive = -1;
+	long since = 0;
+	(void)argc; (void)argv;
+
+	signal(SIGTERM, on_sig);
+	signal(SIGINT, on_sig);
+	signal(SIGHUP, SIG_IGN);
+	if (daemon(1, 0) < 0) return 1;
+	srand((unsigned)(getpid() ^ time(NULL)));
+
+	/* adopt a demotion a previous instance left in place (restart_rdnshc, or
+	 * it died): that order is ours to restore when the rules say so */
+	{
+		char prev[INET_ADDRSTRLEN + 2] = "";
+		if (f_read_string(HC_STATE, prev, sizeof(prev)) > 0) {
+			char *nl = strchr(prev, '\n');
+			if (nl) *nl = 0;
+			if (*prev) {
+				strlcpy(watched, prev, sizeof(watched));
+				down = 1;
+				since = now_s();
+			}
+		}
+	}
+	cfg_read(&c);
+	logmessage(HC_TAG, "started - LAN resolver health check %s%s%s", c.enable && *c.target ? "ENABLED, watching " : "disabled",
+		c.enable && *c.target ? c.target : "", down ? " (adopting a demotion left by the previous instance)" : "");
+
+	while (!g_stop) {
+		int enabled, poll;
+		cfg_read(&c);
+		enabled = c.enable && *c.target;
+
+		if (enabled != last_enabled) {
+			if (last_enabled >= 0 || enabled)
+				logmessage(HC_TAG, enabled
+					? "ENABLED: %s is probed every %d s (%s, %d ms, %s reply counts); after %d misses it is moved to the end of the router's DNS list, after %d hits it is put back first; every switch is logged here"
+					: "DISABLED: the router's DNS list is left in its stock order",
+					c.target, c.interval, c.name, c.timeout_ms, c.strict ? "only a real" : "any", c.fail, c.recover);
+			last_enabled = enabled;
+		}
+
+		/* the watched server changed (or the feature went off) while a
+		 * demotion is in place: give the old one its place back first */
+		if (down && (!enabled || strcmp(watched, c.target) != 0)) {
+			restore();
+			logmessage(HC_TAG, "%s put back in its stock place: %s", watched, enabled ? "a different server is being watched now" : "the health check was switched off");
+			down = 0; misses = hits = 0; since = 0;
+			unlink(HC_STATE);
+		}
+
+		if (!enabled) {
+			state_set("off", 0, -1);
+			for (i = 0; i < HC_POLL_OFF && !g_stop; i++) sleep(1);
+			continue;
+		}
+		strlcpy(watched, c.target, sizeof(watched));
+
+		alive = probe(&c);
+		if (alive) { hits++; misses = 0; } else { misses++; hits = 0; }
+
+		if (!down && misses >= c.fail) {
+			int changed = 0, nup;
+			down = 1; since = now_s(); hits = 0;
+			nup = demote(c.target, &changed);
+			f_write_string(HC_STATE, c.target, 0, 0);
+			if (nup <= 1)
+				logmessage(HC_TAG, "%s is NOT answering (%d misses of %d ms) - it is the only upstream in the router's DNS list, so there is nothing to fall back to; queries keep going to it", c.target, misses, c.timeout_ms);
+			else
+				logmessage(HC_TAG, "%s is NOT answering (%d misses of %d ms) - moved to the END of the router's DNS list (%d upstreams); dnsmasq reloaded, lookups now go to the next server at once", c.target, misses, c.timeout_ms, nup);
+		} else if (down && hits >= c.recover) {
+			down = 0; misses = 0;
+			restore();
+			unlink(HC_STATE);
+			logmessage(HC_TAG, "%s is answering again (%d hits) after %ld s - put back FIRST in the router's DNS list; dnsmasq reloaded", c.target, hits, now_s() - since);
+			since = now_s();
+		} else if (down) {
+			/* wan_up(), a VPN client or a DNS apply may have rewritten the
+			 * files in stock order meanwhile: re-assert, quietly when there
+			 * was nothing to do */
+			int changed = 0;
+			demote(c.target, &changed);
+			if (changed)
+				logmessage(HC_TAG, "%s is still not answering and the router's DNS list was rewritten in stock order - moved to the end again", c.target);
+		}
+		state_set(down ? "down" : "up", since ? since : (since = now_s()), alive);
+
+		poll = c.interval;
+		for (i = 0; i < poll && !g_stop; i++) sleep(1);
+	}
+
+	/* stopping (service stop, reboot, restart_rdnshc): if we adopted or made
+	 * a demotion, leave it recorded for the next instance rather than
+	 * flipping the order back and forth across a restart; a real stop of the
+	 * feature is handled by the loop above before we get here */
+	if (down)
+		logmessage(HC_TAG, "stopped while %s is demoted - the order is kept and the next instance adopts it", watched);
+	else
+		logmessage(HC_TAG, "stopped");
+	state_set("", 0, -1);
+	return 0;
+}
+
+void stop_rdnshc(void)
+{
+	if (pids("rdnshc"))
+		killall_tk("rdnshc");
+}
+
+void start_rdnshc(void)
+{
+	stop_rdnshc();
+	if (!is_routing_enabled())
+		return;
+	xstart("rdnshc");
+}
