diff --git a/release/src/router/rc/services.c b/release/src/router/rc/services.c
index 87bc78d22b..1536c38d8d 100644
--- a/release/src/router/rc/services.c
+++ b/release/src/router/rc/services.c
@@ -1822,7 +1822,17 @@ void start_dnsmasq(void)
 		    "no-negcache\n"		// don't cace nxdomain
 		    "cache-size=%u\n"		// dns cache size
 		    "min-port=%u\n",		// min port used for random src port
-		dmservers, 1500, nvram_get_int("dns_minport") ? : 4096);
+		dmservers, nvram_get_int("reaper_dns_nocache") ? 0 : 1500, nvram_get_int("dns_minport") ? : 4096);
+	/* reaper v3.1.1: "Do not cache DNS answers on the router" (cache-size=0
+	 * above): with every client sent through dnsmasq to a LAN filter such as
+	 * AdGuard or Pi-hole, a router-side cache would answer client B from a
+	 * decision made for client A and hide every cached hit from the filter's
+	 * statistics. The filter keeps its own cache. And "Pass client addresses
+	 * to the DNS server": EDNS Client Subnet with the full client address, so
+	 * the filter still knows which client asked (AdGuard Home: "Use EDNS
+	 * Client Subnet"; Pi-hole FTL: EDNS0_ECS, on by default). */
+	if (nvram_get_int("reaper_dns_ecs"))
+		fprintf(fp, "add-subnet=32,128\n");
 	/* reaper v3.1.1: ask the upstreams in the listed order and move on only
 	 * when one does not answer, instead of dnsmasq's default of probing all
 	 * of them every 50 queries / 20 s and sticking with the fastest - which
