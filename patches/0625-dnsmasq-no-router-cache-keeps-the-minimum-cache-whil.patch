diff --git a/release/src/router/rc/services.c b/release/src/router/rc/services.c
index 1536c38d8d..1a362932cc 100644
--- a/release/src/router/rc/services.c
+++ b/release/src/router/rc/services.c
@@ -1606,6 +1606,27 @@ void gen_apmode_dnsmasq(void)
 #endif
 
 #ifdef RTCONFIG_MULTILAN_CFG
+/* reaper v3.1.1: the router-side cache size. "Do not cache DNS answers on the
+ * router" means cache-size=0 - except that dnsmasq refuses to start with a
+ * cache below its default (CACHESIZ, 150) while it VALIDATES DNSSEC ("cannot
+ * reduce cache size from default when DNSSEC enabled", dnsmasq.c), which took
+ * the owner's resolver down on 2026-09-06. proxy-dnssec (DoT + dnssec_enable
+ * 2) is not validation and has no such rule. */
+static int reaper_dns_cachesize(void)
+{
+	int validating = 0;
+	if (!nvram_get_int("reaper_dns_nocache"))
+		return 1500;
+#ifdef RTCONFIG_DNSSEC
+	validating = nvram_get_int("dnssec_enable") != 0;
+#ifdef RTCONFIG_DNSPRIVACY
+	if (nvram_get_int("dnspriv_enable") && nvram_get_int("dnssec_enable") == 2)
+		validating = 0;
+#endif
+#endif
+	return validating ? 150 : 0;
+}
+
 void start_dnsmasq(const int sdn_idx)
 #else
 void start_dnsmasq(void)
@@ -1822,7 +1843,7 @@ void start_dnsmasq(void)
 		    "no-negcache\n"		// don't cace nxdomain
 		    "cache-size=%u\n"		// dns cache size
 		    "min-port=%u\n",		// min port used for random src port
-		dmservers, nvram_get_int("reaper_dns_nocache") ? 0 : 1500, nvram_get_int("dns_minport") ? : 4096);
+		dmservers, reaper_dns_cachesize(), nvram_get_int("dns_minport") ? : 4096);
 	/* reaper v3.1.1: "Do not cache DNS answers on the router" (cache-size=0
 	 * above): with every client sent through dnsmasq to a LAN filter such as
 	 * AdGuard or Pi-hole, a router-side cache would answer client B from a
diff --git a/release/src/router/www/Advanced_System_Content.asp b/release/src/router/www/Advanced_System_Content.asp
index ef591c970d..903a31d98b 100644
--- a/release/src/router/www/Advanced_System_Content.asp
+++ b/release/src/router/www/Advanced_System_Content.asp
@@ -1880,6 +1880,9 @@ function rdhcInit(){
 	else txt = `<#RDHC_14#>` + " (" + (parseInt(st[1]) || 0) + " s)";
 	el.textContent = txt;
 	if(st[0] == "down") el.style.color = "#E10600";
+	/* dnsmasq keeps a minimum cache while it validates DNSSEC: say so */
+	var dn = document.getElementById("rdhc_dnssec_note");
+	if(dn && dn.getAttribute("data-dnssec") != "" && dn.getAttribute("data-dnssec") != "0") dn.style.display = "";
 }
 function rdhcValid(){
 	if(!document.form.reaper_dnshc_chk.checked) return true;
@@ -3001,6 +3004,7 @@ function Get_Component_reboot_schedule_ui(config){
 					<td>
 						<input type="checkbox" name="reaper_dns_nocache_chk" value="" <% nvram_match("reaper_dns_nocache", "1", "checked"); %>><div style="display: inline-block; vertical-align: middle; margin-bottom: 2px;"><#RDHC_24#></div>
 						<div style="margin-top:6px;line-height:1.45;color:#ECE7DB;opacity:.85"><#RDHC_25#></div>
+						<div id="rdhc_dnssec_note" style="margin-top:6px;line-height:1.45;color:#ECE7DB;opacity:.85;display:none" data-dnssec="<% nvram_get("dnssec_enable"); %>"><#RDHC_26#></div>
 					</td>
 				</tr>
 				<script>rdhcInit();</script>
