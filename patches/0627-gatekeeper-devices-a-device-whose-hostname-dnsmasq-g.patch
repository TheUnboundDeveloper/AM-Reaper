diff --git a/release/src/router/shared/reaper_dhcpname.c b/release/src/router/shared/reaper_dhcpname.c
new file mode 100644
index 0000000000..2211c1d324
--- /dev/null
+++ b/release/src/router/shared/reaper_dhcpname.c
@@ -0,0 +1,215 @@
+/*
+ * reaper_dhcpname.c - reaper v3.1.1: the hostname a DHCP client ANNOUNCED,
+ * kept per MAC, independent of the dnsmasq lease file.
+ *
+ * FIELD REPORT (owner RT-BE96U, v3.1.1, 2026-09-07): Gatekeeper listed device
+ * after device as "Unknown device", and an approved device stayed unknown.
+ * Every Reaper name reader (gkd's seen table, the Gatekeeper and Devices CGIs)
+ * takes the self-reported name from /var/lib/misc/dnsmasq.leases. dnsmasq lets
+ * ONE lease hold a given hostname at a time (lease.c lease_set_hostname: the
+ * newest claimant wins and kill_name() blanks the other lease, so a name maps
+ * to one address in DNS). Several iPhones on that LAN all announce "iPhone",
+ * so at any moment all but one of them read "*" in the lease file - dnsmasq
+ * logged "DHCPACK ... iPhone" for the very MAC whose lease line was "*". A
+ * device that announces no hostname at all (a printer, a Fire TV, a Lutron
+ * hub) never had a lease name; the stock network map labels those by vendor.
+ *
+ * dnsmasq hands the lease-change script (dhcp-script=/sbin/dhcpc_lease, an rc
+ * applet) the RAW option-12 value as DNSMASQ_SUPPLIED_HOSTNAME on every add/old
+ * event, untouched by the uniqueness rule. rc records it here; gkd and httpd
+ * read it as the fallback after the lease file and before the vendor label.
+ *
+ *     /var/lib/misc/reaper_hostnames    mac \t hostname \t vendor-class \t epoch
+ *
+ * tmpfs (refilled by the renewals after a boot), one row per MAC, newest last,
+ * capped at RDN_MAX rows (oldest dropped), atomic replace under a flock so the
+ * main and SDN dnsmasq instances cannot interleave. Hostnames are client-
+ * controlled input: reduced to printable ASCII (no tab), 32 bytes - the clamp
+ * gkd's seen table already applies - and JSON-escaped again on the way out.
+ */
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <strings.h>
+#include <ctype.h>
+#include <unistd.h>
+#include <fcntl.h>
+#include <time.h>
+#include <sys/stat.h>
+#include <sys/file.h>
+#include "shared.h"
+
+#define RDN_FILE     "/var/lib/misc/reaper_hostnames"
+#define RDN_TMP      RDN_FILE ".tmp"
+#define RDN_LOCK     RDN_FILE ".lock"
+#define RDN_MAX      1024		/* rows kept; far above any real LAN */
+#define RDN_LINE     256
+#define RDN_NAME_MAX 32
+#define RDN_VC_MAX   48
+
+/* "aa:bb:cc:dd:ee:ff" in any case -> uppercase; 0 when it is not a MAC
+ * (DHCPv6 events carry a DUID in that slot and are not recorded). */
+static int rdn_norm_mac(const char *in, char *out)
+{
+	int i;
+	if (!in || strlen(in) != 17) return 0;
+	for (i = 0; i < 17; i++) {
+		unsigned char c = (unsigned char)in[i];
+		if ((i % 3) == 2) { if (c != ':') return 0; out[i] = ':'; continue; }
+		if (!isxdigit(c)) return 0;
+		out[i] = (char)toupper(c);
+	}
+	out[17] = 0;
+	return 1;
+}
+
+/* printable ASCII only (bytes outside 0x20..0x7e are dropped, so a UTF-8
+ * apostrophe simply disappears), trimmed, capped; "*" (dnsmasq's "no name")
+ * and an empty result both come back as "". */
+static void rdn_clean(const char *in, char *out, size_t cap)
+{
+	size_t n = 0;
+	char *p;
+	out[0] = 0;
+	if (!in) return;
+	while (*in && n + 1 < cap) {
+		unsigned char c = (unsigned char)*in++;
+		if (c < 0x20 || c > 0x7e) continue;
+		out[n++] = (char)c;
+	}
+	out[n] = 0;
+	while (n && out[n - 1] == ' ') out[--n] = 0;
+	for (p = out; *p == ' '; p++) ;
+	if (p != out) memmove(out, p, strlen(p) + 1);
+	if (!strcmp(out, "*")) out[0] = 0;
+}
+
+/* writer (rc, from the dnsmasq lease-change script). A field the new event
+ * lacks keeps the previous row's value - an "old" event fired by kill_name()
+ * arrives with the lease name gone but the supplied name still set; a bare
+ * renewal without option 12 must not erase what an earlier event recorded. */
+int reaper_dhcpname_record(const char *macraw, const char *host, const char *vendor)
+{
+	char mac[18], h[RDN_NAME_MAX + 1], vc[RDN_VC_MAX + 1];
+	char oldh[RDN_NAME_MAX + 1] = "", oldvc[RDN_VC_MAX + 1] = "";
+	char *lines[RDN_MAX];
+	int nl = 0, i, lf, rc = -1, start;
+	FILE *f;
+
+	if (!rdn_norm_mac(macraw, mac)) return -1;
+	rdn_clean(host, h, sizeof(h));
+	rdn_clean(vendor, vc, sizeof(vc));
+
+	lf = open(RDN_LOCK, O_WRONLY | O_CREAT | O_CLOEXEC, 0600);
+	if (lf >= 0) flock(lf, LOCK_EX);
+
+	f = fopen(RDN_FILE, "r");
+	if (f) {
+		char line[RDN_LINE];
+		while (fgets(line, sizeof(line), f)) {
+			char *tab;
+			line[strcspn(line, "\n")] = 0;
+			tab = strchr(line, '\t');
+			if (!tab) continue;
+			if ((tab - line) == 17 && !strncasecmp(line, mac, 17)) {
+				char *f2 = tab + 1, *f3 = strchr(f2, '\t');
+				if (f3) *f3 = 0;
+				snprintf(oldh, sizeof(oldh), "%s", f2);
+				if (f3) {
+					f2 = f3 + 1; f3 = strchr(f2, '\t');
+					if (f3) *f3 = 0;
+					snprintf(oldvc, sizeof(oldvc), "%s", f2);
+				}
+				continue;		/* replaced by the row appended below */
+			}
+			if (nl < RDN_MAX) {
+				char *cp = strdup(line);
+				if (cp) lines[nl++] = cp;
+			}
+		}
+		fclose(f);
+	}
+	if (!h[0]) snprintf(h, sizeof(h), "%s", oldh);
+	if (!vc[0]) snprintf(vc, sizeof(vc), "%s", oldvc);
+
+	if (!h[0] && !vc[0]) {
+		rc = 0;				/* nothing to remember, nothing to rewrite */
+	} else if ((f = fopen(RDN_TMP, "w")) != NULL) {
+		start = (nl >= RDN_MAX) ? nl - (RDN_MAX - 1) : 0;	/* keep the newest */
+		for (i = start; i < nl; i++) fprintf(f, "%s\n", lines[i]);
+		fprintf(f, "%s\t%s\t%s\t%ld\n", mac, h, vc, (long)time(NULL));
+		if (fclose(f) == 0) {
+			chmod(RDN_TMP, 0600);
+			if (rename(RDN_TMP, RDN_FILE) == 0) rc = 0;
+		}
+		if (rc != 0) unlink(RDN_TMP);
+	}
+	for (i = 0; i < nl; i++) free(lines[i]);
+	if (lf >= 0) { flock(lf, LOCK_UN); close(lf); }
+	return rc;
+}
+
+/* reader (gkd once per device per tick, httpd once per device per request):
+ * the file is parsed into a MAC->name index once and re-read only when it
+ * changed (mtime or size), the same shape as httpd's custom_clientlist index.
+ * Returns 1 and the name (<= 32 bytes) when the MAC has one, else 0 and "". */
+int reaper_dhcpname_get(const char *macraw, char *out, size_t n)
+{
+	static char *buf = NULL;
+	static char **macs = NULL, **names = NULL;
+	static int nent = 0;
+	static time_t cmtime = 0;
+	static off_t csize = -1;
+	char mac[18];
+	struct stat st;
+	int i, hit = -1;
+
+	if (!out || n < 2) return 0;
+	out[0] = 0;
+	if (!rdn_norm_mac(macraw, mac)) return 0;
+	if (stat(RDN_FILE, &st) != 0 || !S_ISREG(st.st_mode) || st.st_size <= 0) return 0;
+
+	if (!buf || st.st_mtime != cmtime || st.st_size != csize) {
+		FILE *f;
+		size_t len, cap = 1;
+		char *p;
+		free(buf); free(macs); free(names);
+		buf = NULL; macs = names = NULL; nent = 0;
+		cmtime = st.st_mtime; csize = st.st_size;
+		if (st.st_size > (off_t)(RDN_MAX * RDN_LINE)) return 0;	/* not ours */
+		f = fopen(RDN_FILE, "r");
+		if (!f) return 0;
+		buf = malloc((size_t)st.st_size + 1);
+		if (!buf) { fclose(f); return 0; }
+		len = fread(buf, 1, (size_t)st.st_size, f);
+		fclose(f);
+		buf[len] = 0;
+		for (p = buf; *p; p++) if (*p == '\n') cap++;
+		macs  = malloc(cap * sizeof(*macs));
+		names = malloc(cap * sizeof(*names));
+		if (!macs || !names) {
+			free(buf); free(macs); free(names);
+			buf = NULL; macs = names = NULL;
+			return 0;
+		}
+		for (p = buf; *p; ) {
+			char *nl = strchr(p, '\n'), *next = nl ? nl + 1 : p + strlen(p), *t1, *t2;
+			if (nl) *nl = 0;
+			t1 = strchr(p, '\t');
+			if (t1 && (t1 - p) == 17 && (size_t)nent < cap) {
+				*t1 = 0;
+				t2 = strchr(t1 + 1, '\t');
+				if (t2) *t2 = 0;
+				macs[nent] = p;
+				names[nent] = t1 + 1;
+				nent++;
+			}
+			p = next;
+		}
+	}
+	for (i = 0; i < nent; i++)
+		if (!strcasecmp(macs[i], mac)) hit = i;	/* newest row last */
+	if (hit < 0 || !names[hit][0]) return 0;
+	snprintf(out, n, "%.32s", names[hit]);
+	return 1;
+}
