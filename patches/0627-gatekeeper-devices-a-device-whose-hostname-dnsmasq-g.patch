diff --git a/release/src/router/httpd/web.c b/release/src/router/httpd/web.c
index 4dd12d9765..fb3256ef47 100644
--- a/release/src/router/httpd/web.c
+++ b/release/src/router/httpd/web.c
@@ -23275,6 +23275,57 @@ gk_client_name(const char *mac, char *name, size_t nlen)
 	}
 }
 
+/* v3.1.1: networkmap's own label for a MAC - /jffs/nmp_cl_json.js "name", which
+ * is the lease hostname when it has one, else the DHCP vendor class, else the OUI
+ * vendor: the name the stock network map shows for a device that announces no
+ * hostname (a printer, a Fire TV, a hub). The LAST fallback, after the user's
+ * name, the lease file and the announced-name store. The file is re-parsed only
+ * when networkmap rewrote it (mtime/size), one parse per change not per device. */
+static int
+gk_nmp_name(const char *mac, char *out, size_t n)
+{
+	static json_object *cache = NULL;
+	static time_t cmtime = 0;
+	static off_t csize = -1;
+	struct stat st;
+	json_object *ent = NULL, *nm = NULL;
+	const char *s;
+	char umac[18];
+	int i;
+
+	if (!out || n < 2) return 0;
+	out[0] = 0;
+	if (!mac || strlen(mac) != 17) return 0;
+	if (stat(NMP_CL_JSON_FILE, &st) != 0 || !S_ISREG(st.st_mode)) return 0;
+	if (!cache || st.st_mtime != cmtime || st.st_size != csize) {
+		if (cache) json_object_put(cache);
+		cache = json_object_from_file(NMP_CL_JSON_FILE);
+		cmtime = st.st_mtime;
+		csize = st.st_size;
+		if (cache && !json_object_is_type(cache, json_type_object)) { json_object_put(cache); cache = NULL; }
+	}
+	if (!cache) return 0;
+	for (i = 0; i < 17; i++) umac[i] = toupper((unsigned char)mac[i]);
+	umac[17] = 0;
+	if (!json_object_object_get_ex(cache, umac, &ent) || !ent) return 0;
+	if (!json_object_object_get_ex(ent, "name", &nm) || !nm) return 0;
+	s = json_object_get_string(nm);
+	if (!s || !*s) return 0;
+	snprintf(out, n, "%.32s", s);
+	return 1;
+}
+
+/* the display chain for a Gatekeeper row: the user's name, the lease / seen-
+ * table hostname, the announced hostname, then networkmap's vendor label */
+static void
+gk_display_name(const char *mac, const char *host, char *name, size_t nlen)
+{
+	gk_client_name(mac, name, nlen);
+	if (!name[0] && host && host[0]) snprintf(name, nlen, "%s", host);
+	if (!name[0]) reaper_dhcpname_get(mac, name, nlen);
+	if (!name[0]) gk_nmp_name(mac, name, nlen);
+}
+
 #define GK_SEEN_TSV "/tmp/gk/seen.tsv"
 #define GK_SEEN_MAX 512	/* v2.6.3: was 256 - matches gkd MAX_DEV */
 
@@ -23328,9 +23379,9 @@ gk_emit_seen(FILE *stream, struct gk_seen *d, int rand_flag)
 {
 	char name[40];
 	/* unified naming: the user-assigned name (custom_clientlist) wins on every
-	 * page; the device's self-reported DHCP hostname is only a fallback */
-	gk_client_name(d->mac, name, sizeof(name));
-	if (!name[0] && d->host[0]) snprintf(name, sizeof(name), "%s", d->host);
+	 * page; the device's self-reported DHCP hostname is only a fallback, and
+	 * v3.1.1 adds the announced name + networkmap's vendor label behind it */
+	gk_display_name(d->mac, d->host, name, sizeof(name));
 	websWrite(stream, "{\"mac\":\"%s\",\"ip\":", d->mac);
 	gk_json_esc(stream, d->ip);
 	websWrite(stream, ",\"host\":");
@@ -23631,9 +23682,9 @@ do_reaper_gk_cgi(char *url, FILE *stream)
 				{
 					char name[40];
 					/* unified naming: custom_clientlist first, self-reported
-					 * hostname as fallback (matches every other page) */
-					gk_client_name(d->mac, name, sizeof(name));
-					if (!name[0] && d->host[0]) snprintf(name, sizeof(name), "%s", d->host);
+					 * hostname as fallback (matches every other page), then the
+					 * announced name and networkmap's vendor label (v3.1.1) */
+					gk_display_name(d->mac, d->host, name, sizeof(name));
 					gk_json_esc(stream, name);
 				}
 				websWrite(stream, ",\"band\":");
@@ -26230,6 +26281,7 @@ struct rdev {
 	int  bandmask;		/* bands linked on: 1=2.4 2=5 4=6 */
 	int  node;		/* AiMesh RE node: its re_path (uplink type), 0 = not a node */
 	int  bh_sta;		/* this MAC is a node's BACKHAUL station, not a device - folded */
+	int  host_vendor;	/* host is networkmap's vendor label, not a hostname (v3.1.1) */
 };
 
 /* dotted-quad -> host-order u32; 0 on parse failure (0.0.0.0 is never a host) */
@@ -26898,6 +26950,18 @@ static void do_reaper_dev_cgi(char *url, FILE *stream)
 				snprintf(dev[idx].ip, sizeof(dev[0].ip), "%s", seen[i].ip);
 		}
 
+		/* 7. v3.1.1: a host the lease file could not give - the announced hostname
+		 * (a device that lost a name clash reads "*" in the leases), then
+		 * networkmap's vendor label for a device that announces no name at all.
+		 * Same chain as the Gatekeeper page; the vendor case is flagged so the
+		 * page labels its source honestly. */
+		for (i = 0; i < n; i++) {
+			if (dev[i].host[0]) continue;
+			if (reaper_dhcpname_get(dev[i].mac, dev[i].host, sizeof(dev[0].host))) continue;
+			if (gk_nmp_name(dev[i].mac, dev[i].host, sizeof(dev[0].host)))
+				dev[i].host_vendor = 1;
+		}
+
 		/* ---- pool / store facts + next free out-of-pool host ---- */
 		{
 			char *sl = nvram_safe_get("dhcp_staticlist");
@@ -26960,7 +27024,7 @@ static void do_reaper_dev_cgi(char *url, FILE *stream)
 
 			gk_client_name(d->mac, uname, sizeof(uname));
 			have_user = uname[0] ? 1 : 0;
-			src = have_user ? "user" : (d->host[0] ? "lease" : "");
+			src = have_user ? "user" : (d->host[0] ? (d->host_vendor ? "vendor" : "lease") : "");
 
 			if (!first) websWrite(stream, ",");
 			first = 0;
