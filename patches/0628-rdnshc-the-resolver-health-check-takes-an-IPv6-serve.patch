diff --git a/release/src/router/rc/rdnshc.c b/release/src/router/rc/rdnshc.c
index e008b626c0..b6b9fa7c00 100644
--- a/release/src/router/rc/rdnshc.c
+++ b/release/src/router/rc/rdnshc.c
@@ -64,7 +64,9 @@
 
 struct hc_cfg {
 	int enable;
-	char target[INET_ADDRSTRLEN];
+	char target[INET6_ADDRSTRLEN];	/* canonical spelling (inet_ntop) of what the admin typed */
+	int af;			/* AF_INET / AF_INET6; 0 = no valid target */
+	int v6_off;		/* an IPv6 target while IPv6 is disabled on the router: idle */
 	char name[128];
 	int interval;		/* s */
 	int timeout_ms;
@@ -91,14 +93,30 @@ static int clamp(int v, int lo, int hi, int dflt)
 static void cfg_read(struct hc_cfg *c)
 {
 	const char *p;
-	struct in_addr a;
+	struct in_addr a4;
+	struct in6_addr a6;
 	size_t i;
 
 	memset(c, 0, sizeof(*c));
 	c->enable = nvram_get_int("reaper_dnshc_enable");
 	p = nvram_safe_get("reaper_dnshc_target");
-	if (*p && inet_pton(AF_INET, p, &a) == 1)
-		strlcpy(c->target, p, sizeof(c->target));
+	/* IPv4 or IPv6 (v3.1.1), kept in its canonical spelling so the log shows one
+	 * form and the resolver-file match (by value, line_is_target) is exact. An
+	 * IPv6 target is honoured only while IPv6 is enabled on the router: with
+	 * IPv6 off there is no route to it and the router's DNS list holds no IPv6
+	 * upstream to move, so the check idles and says so once. */
+	if (*p && inet_pton(AF_INET, p, &a4) == 1) {
+		c->af = AF_INET;
+		inet_ntop(AF_INET, &a4, c->target, sizeof(c->target));
+	} else if (*p && inet_pton(AF_INET6, p, &a6) == 1) {
+		c->af = AF_INET6;
+		inet_ntop(AF_INET6, &a6, c->target, sizeof(c->target));
+#ifdef RTCONFIG_IPV6
+		c->v6_off = ipv6_enabled() ? 0 : 1;
+#else
+		c->v6_off = 1;
+#endif
+	}
 	p = nvram_safe_get("reaper_dnshc_name");
 	strlcpy(c->name, (*p ? p : "localhost"), sizeof(c->name));
 	for (i = 0; c->name[i]; i++) {
@@ -123,7 +141,8 @@ static int probe(const struct hc_cfg *c)
 	unsigned char pkt[512];
 	unsigned char *q;
 	const char *lab, *dot;
-	struct sockaddr_in sa;
+	struct sockaddr_storage ss;
+	socklen_t slen;
 	struct timeval tv;
 	fd_set rf;
 	unsigned short id;
@@ -150,13 +169,23 @@ static int probe(const struct hc_cfg *c)
 	*q++ = 0; *q++ = 1;			/* QCLASS IN */
 	len = (int)(q - pkt);
 
-	memset(&sa, 0, sizeof(sa));
-	sa.sin_family = AF_INET;
-	sa.sin_port = htons(53);
-	if (inet_pton(AF_INET, c->target, &sa.sin_addr) != 1) return 0;
+	memset(&ss, 0, sizeof(ss));
+	if (c->af == AF_INET6) {
+		struct sockaddr_in6 *s6 = (struct sockaddr_in6 *)&ss;
+		s6->sin6_family = AF_INET6;
+		s6->sin6_port = htons(53);
+		if (inet_pton(AF_INET6, c->target, &s6->sin6_addr) != 1) return 0;
+		slen = sizeof(*s6);
+	} else {
+		struct sockaddr_in *s4 = (struct sockaddr_in *)&ss;
+		s4->sin_family = AF_INET;
+		s4->sin_port = htons(53);
+		if (inet_pton(AF_INET, c->target, &s4->sin_addr) != 1) return 0;
+		slen = sizeof(*s4);
+	}
 
-	if ((fd = socket(AF_INET, SOCK_DGRAM, 0)) < 0) return 0;
-	if (connect(fd, (struct sockaddr *)&sa, sizeof(sa)) < 0 || send(fd, pkt, len, 0) != len) {
+	if ((fd = socket(c->af == AF_INET6 ? AF_INET6 : AF_INET, SOCK_DGRAM, 0)) < 0) return 0;
+	if (connect(fd, (struct sockaddr *)&ss, slen) < 0 || send(fd, pkt, len, 0) != len) {
 		close(fd);
 		return 0;
 	}
@@ -187,12 +216,24 @@ static int probe(const struct hc_cfg *c)
  * that is "server=<ip>" or "server=<ip>#port" (a "server=/domain/<ip>" line
  * is a domain route and is left where it is); for resolv.conf it is
  * "nameserver <ip>". */
-static int line_is_target(const char *line, const char *prefix, const char *target)
+static int line_is_target(const char *line, const char *prefix, const struct hc_cfg *c)
 {
-	size_t pl = strlen(prefix), tl = strlen(target);
+	size_t pl = strlen(prefix), al;
+	char addr[INET6_ADDRSTRLEN + 8];
+	unsigned char bin[16], tbin[16];
+	const char *p;
 	if (strncmp(line, prefix, pl) != 0) return 0;
-	if (strncmp(line + pl, target, tl) != 0) return 0;
-	return line[pl + tl] == 0 || line[pl + tl] == '\n' || line[pl + tl] == '#' || line[pl + tl] == ' ' || line[pl + tl] == '\t';
+	p = line + pl;
+	if (*p == '/') return 0;			/* domain route */
+	/* the address ends at a #port, a %zone, blank or end of line; compared by
+	 * VALUE so "2001:DB8::1", "2001:db8:0:0::1" and "2001:db8::1#53" are all
+	 * the one server (an IPv4 spelling has no such variants; same code) */
+	al = strcspn(p, "#% \t\r\n");
+	if (al == 0 || al >= sizeof(addr)) return 0;
+	memcpy(addr, p, al);
+	addr[al] = 0;
+	if (inet_pton(c->af, addr, bin) != 1 || inet_pton(c->af, c->target, tbin) != 1) return 0;
+	return memcmp(bin, tbin, c->af == AF_INET6 ? 16 : 4) == 0;
 }
 
 /* A plain upstream of the same kind (used to decide whether the target is
@@ -207,7 +248,7 @@ static int line_is_upstream(const char *line, const char *prefix)
 /* Move the target's plain-upstream line(s) to the end of the file. Returns
  * 1 if the file was rewritten, 0 if there was nothing to do (no such line,
  * or it is already the last upstream), -1 on error. Caller holds the lock. */
-static int demote_file(const char *path, const char *prefix, const char *target, int *n_upstreams)
+static int demote_file(const char *path, const char *prefix, const struct hc_cfg *c, int *n_upstreams)
 {
 	static char lines[HC_MAXLINES][HC_LINE];
 	int n = 0, i, last_other = -1, last_target = -1, first_target = -1, nup = 0;
@@ -215,7 +256,7 @@ static int demote_file(const char *path, const char *prefix, const char *target,
 
 	if (!(fp = fopen(path, "r"))) return -1;
 	while (n < HC_MAXLINES && fgets(lines[n], HC_LINE, fp)) {
-		if (line_is_target(lines[n], prefix, target)) {
+		if (line_is_target(lines[n], prefix, c)) {
 			if (first_target < 0) first_target = n;
 			last_target = n;
 			nup++;
@@ -231,10 +272,10 @@ static int demote_file(const char *path, const char *prefix, const char *target,
 	if (last_other < first_target) return 0;	/* already last among the upstreams */
 	if (!(fp = fopen(path, "w"))) return -1;
 	for (i = 0; i < n; i++)
-		if (!line_is_target(lines[i], prefix, target))
+		if (!line_is_target(lines[i], prefix, c))
 			fputs(lines[i], fp);
 	for (i = 0; i < n; i++)
-		if (line_is_target(lines[i], prefix, target))
+		if (line_is_target(lines[i], prefix, c))
 			fputs(lines[i], fp);
 	fclose(fp);
 	(void)last_target;
@@ -252,12 +293,12 @@ static void hc_reload(void)
 
 /* returns the number of plain upstreams dnsmasq has, so the log can say when
  * there is nothing to fall back to */
-static int demote(const char *target, int *changed)
+static int demote(const struct hc_cfg *c, int *changed)
 {
 	int lock, a, b, nup = 0;
 	lock = file_lock("resolv");
-	a = demote_file(HC_DNSMASQ, "server=", target, &nup);
-	b = demote_file(HC_RESOLV, "nameserver ", target, NULL);
+	a = demote_file(HC_DNSMASQ, "server=", c, &nup);
+	b = demote_file(HC_RESOLV, "nameserver ", c, NULL);
 	file_unlock(lock);
 	if (changed) *changed = (a == 1 || b == 1);
 	if (a == 1) hc_reload();
@@ -281,8 +322,8 @@ static void state_set(const char *what, long since, int alive)
 int rdnshc_main(int argc, char *argv[])
 {
 	struct hc_cfg c;
-	char watched[INET_ADDRSTRLEN] = "";
-	int down = 0, misses = 0, hits = 0, last_enabled = -1, i, alive = -1;
+	char watched[INET6_ADDRSTRLEN] = "";
+	int down = 0, misses = 0, hits = 0, last_enabled = -1, i, alive = -1, v6_warned = 0;
 	long since = 0;
 	(void)argc; (void)argv;
 
@@ -295,7 +336,7 @@ int rdnshc_main(int argc, char *argv[])
 	/* adopt a demotion a previous instance left in place (restart_rdnshc, or
 	 * it died): that order is ours to restore when the rules say so */
 	{
-		char prev[INET_ADDRSTRLEN + 2] = "";
+		char prev[INET6_ADDRSTRLEN + 2] = "";
 		if (f_read_string(HC_STATE, prev, sizeof(prev)) > 0) {
 			char *nl = strchr(prev, '\n');
 			if (nl) *nl = 0;
@@ -311,7 +352,13 @@ int rdnshc_main(int argc, char *argv[])
 	while (!g_stop) {
 		int enabled, poll;
 		cfg_read(&c);
-		enabled = c.enable && *c.target;
+		enabled = c.enable && *c.target && !c.v6_off;
+		if (c.enable && *c.target && c.v6_off) {
+			if (!v6_warned)
+				logmessage(HC_TAG, "DNS Health Check: %s is an IPv6 address but IPv6 is disabled on the router - the check stays idle until IPv6 is enabled or an IPv4 server is named", c.target);
+			v6_warned = 1;
+		} else
+			v6_warned = 0;
 
 		if (enabled != last_enabled) {
 			if (enabled)
@@ -345,7 +392,7 @@ int rdnshc_main(int argc, char *argv[])
 		if (!down && misses >= c.fail) {
 			int changed = 0, nup;
 			down = 1; since = now_s(); hits = 0;
-			nup = demote(c.target, &changed);
+			nup = demote(&c, &changed);
 			f_write_string(HC_STATE, c.target, 0, 0);
 			if (nup <= 1)
 				logmessage(HC_TAG, "DNS Health Check FAILOVER: %s is down (%d misses) but it is the only upstream in the router's DNS list - nothing to fall back to, queries keep going to it", c.target, misses);
@@ -362,7 +409,7 @@ int rdnshc_main(int argc, char *argv[])
 			 * files in stock order meanwhile: re-assert, quietly when there
 			 * was nothing to do */
 			int changed = 0;
-			demote(c.target, &changed);
+			demote(&c, &changed);
 			if (changed)
 				logmessage(HC_TAG, "DNS Health Check FAILOVER re-applied: the router's DNS list was rewritten in stock order while %s is still down - moved to the end again", c.target);
 		}
