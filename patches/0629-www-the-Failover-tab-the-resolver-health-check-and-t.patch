+.helpq:hover{border-color:var(--crimson);color:var(--bone)}
+
+/* ---------- watch / fail over / restore strip ---------- */
+.life{display:flex;align-items:stretch;margin:22px 0 18px;border:1px solid var(--line-soft);
+  border-radius:12px;background:var(--panel);overflow:hidden}
+.lstep{flex:1 1 0;display:flex;gap:13px;align-items:center;padding:12px 18px;position:relative;min-width:0}
+.lstep + .lstep{border-left:1px solid var(--line-soft)}
+.lstep .n{font-family:var(--hdr);font-weight:700;font-size:21px;color:#2c2c31;line-height:1;font-variant-numeric:tabular-nums}
+.lstep .t{min-width:0}
+.lstep .k{font-family:var(--hdr);font-weight:600;font-size:12px;letter-spacing:.12em;text-transform:uppercase;color:var(--bone-dim);white-space:nowrap}
+.lstep .d{display:block;font-size:11px;color:var(--steel);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
+.lstep.live .n{color:var(--jade)} .lstep.live .k{color:var(--bone)}
+.lstep.armed{background:linear-gradient(180deg,rgba(225,6,0,.12),rgba(225,6,0,.03))}
+.lstep.armed .n{color:var(--crimson)} .lstep.armed .k{color:var(--bone)}
