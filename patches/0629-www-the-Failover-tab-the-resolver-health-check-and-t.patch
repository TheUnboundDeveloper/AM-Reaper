+  <div class="card">
+    <div class="chead">
+      <span class="cico" aria-hidden="true"><svg viewBox="0 0 24 24"><ellipse cx="12" cy="6" rx="7" ry="3"/><path d="M5 6v6c0 1.7 3.1 3 7 3s7-1.3 7-3V6"/><path d="M5 12v6c0 1.7 3.1 3 7 3s7-1.3 7-3v-6"/><path d="M4 4l16 16"/></svg></span>
+      <h2><#RDHC_23#></h2>
+      <label class="sw"><input type="checkbox" id="nocache" <% nvram_match("reaper_dns_nocache", "1", "checked"); %>><span class="tr"></span></label>
+    </div>
+    <p><b style="color:var(--bone);font-weight:600"><#RDHC_24#></b></p>
+    <p><#RDHC_25#></p>
+    <p id="dnssec_note" style="display:none;color:var(--amber)"><#RDHC_26#></p>
+  </div>
+</div>
+
+<div class="bar">
+  <span class="msg" id="msg"></span>
+  <button class="btn hot" id="apply" type="button"><#CTL_apply#></button>
+</div>
+
+</div>
+<div class="ovl" id="ovl"><div class="box"><div class="t" id="ovl_t"></div><div class="s" id="ovl_s"></div><div class="beat"><i></i></div></div></div>
+<iframe name="fo_hidden" style="display:none" title="apply"></iframe>
+
+<script src="/reaper_util.js"></script>
+<script>
+var IPV6 = '<% nvram_get("ipv6_service"); %>';
+var DNSSEC = '<% nvram_get("dnssec_enable"); %>';
+var ORIG = {
+  enable: '<% nvram_get("reaper_dnshc_enable"); %>',
+  target: '<% nvram_get("reaper_dnshc_target"); %>',
+  name: '<% nvram_get("reaper_dnshc_name"); %>',
+  interval: '<% nvram_get("reaper_dnshc_interval"); %>',
+  timeout: '<% nvram_get("reaper_dnshc_timeout"); %>',
+  fail: '<% nvram_get("reaper_dnshc_fail"); %>',
+  recover: '<% nvram_get("reaper_dnshc_recover"); %>',
+  strict: '<% nvram_get("reaper_dnshc_strict"); %>',
+  dnsstrict: '<% nvram_get("reaper_dns_strict"); %>',
+  ecs: '<% nvram_get("reaper_dns_ecs"); %>',
+  nocache: '<% nvram_get("reaper_dns_nocache"); %>',
+  state: '<% nvram_get("reaper_dnshc_state"); %>'
+};
+var T = {
+  off: `<#RDHC_37#>`, up: `<#RDHC_38#>`, down: `<#RDHC_39#>`,
+  notRunning: `<#RDHC_13#>`, answering: `<#RDHC_14#>`, notAnswering: `<#RDHC_15#>`,
+  badIp: `<#JS_validip#>`, v6off: `<#RDHC_27#>`, blank: `<#JS_fieldblank#>`,
+  applying: `<#RDHC_36#>`, apply: `<#CTL_apply#>`
+};
+var V6ON = (IPV6 !== '' && IPV6 !== 'disabled');
+var busy = 0, pollT = null;
+
+function $id(i){ return document.getElementById(i); }
+function on(id){ return $id(id).checked ? '1' : '0'; }
+function held(s){
+  s = parseInt(s) || 0;
+  if(s < 60) return s + ' s';
+  if(s < 3600) return Math.floor(s / 60) + ' min';
+  if(s < 86400) return Math.floor(s / 3600) + ' h ' + Math.floor((s % 3600) / 60) + ' min';
+  return Math.floor(s / 86400) + ' d ' + Math.floor((s % 86400) / 3600) + ' h';
+}
+
+/* ---- live state: "up <s> <alive>" / "down <s> <alive>" / "off" ---- */
+function render(state, enable){
+  var st = String(state || '').split(' '), mode = st[0], chip = $id('chip_state');
+  var running = (enable === '1' && mode !== '' && mode !== 'off');
+  var v = $id('st_v'), h = $id('st_held');
+  $id('ls1').className = 'lstep' + (running ? ' live' : '');
+  $id('ls2').className = 'lstep' + (running && mode === 'down' ? ' armed' : '');
+  $id('ls3').className = 'lstep' + (running && mode === 'down' ? ' live' : '');
+  if(!running){
+    chip.className = 'chip'; $id('chip_state_v').textContent = T.off;
+    v.className = 'v'; v.textContent = T.notRunning; h.textContent = '';
+  } else if(mode === 'down'){
+    chip.className = 'chip down'; $id('chip_state_v').textContent = T.down;
+    v.className = 'v down'; v.textContent = T.notAnswering; h.textContent = held(st[1]);
+  } else {
+    chip.className = 'chip up'; $id('chip_state_v').textContent = T.up;
+    v.className = 'v'; v.textContent = T.answering; h.textContent = held(st[1]);
+  }
+  var tg = ORIG.target || '\u2014';
+  $id('chip_target_v').textContent = tg; $id('chip_target_v').title = tg;
+}
+function poll(){
+  var x = new XMLHttpRequest(), done = 0;
+  function fin(){ if(done) return; done = 1; pollT = setTimeout(poll, 5000); }
+  x.open('GET', '/appGet.cgi?hook=nvram_get(reaper_dnshc_state)&_=' + Date.now(), true);
+  x.onreadystatechange = function(){
+    if(x.readyState !== 4) return;
+    if(x.status === 200){
+      try{ var j = JSON.parse(x.responseText); if(j && typeof j.reaper_dnshc_state === 'string') render(j.reaper_dnshc_state, ORIG.enable); }catch(e){}
+    }
+    fin();
+  };
+  x.onerror = fin;
+  x.send(null);
+}
+
+/* ---- form ---- */
+function syncEnable(){ $id('hc').className = 'card hero' + ($id('en').checked ? '' : ' off'); }
+function isV4(s){ return /^(25[0-5]|2[0-4]\d|1\d\d|[1-9]?\d)(\.(25[0-5]|2[0-4]\d|1\d\d|[1-9]?\d)){3}$/.test(s); }
+function isV6(s){
+  if(!/^[0-9A-Fa-f:.]+$/.test(s) || s.indexOf(':') < 0) return false;
+  var dc = s.split('::').length - 1; if(dc > 1) return false;
+  var parts = s.split(':'), i;
+  if(parts.length > 8 || (dc === 0 && parts.length !== 8)) return false;
+  for(i = 0; i < parts.length; i++){
+    if(parts[i] === '') continue;
+    if(parts[i].indexOf('.') >= 0){ if(i !== parts.length - 1 || !isV4(parts[i])) return false; continue; }
+    if(!/^[0-9A-Fa-f]{1,4}$/.test(parts[i])) return false;
+  }
+  return true;
+}
+function inRange(id, lo, hi){ var n = $id(id), v = parseInt(n.value, 10); if(!/^\d+$/.test(n.value) || v < lo || v > hi){ n.focus(); return false; } return true; }
+function msg(t, err){ var m = $id('msg'); m.className = 'msg' + (err ? ' err' : ''); m.textContent = t; }
+function valid(){
+  if(!$id('en').checked) return true;
+  var t = $id('target'), s = t.value.replace(/\s+/g, '');
+  t.value = s;
+  if(!isV4(s) && !(V6ON && isV6(s))){
+    msg(s + ' ' + T.badIp + ((!V6ON && s.indexOf(':') >= 0) ? ' ' + T.v6off : ''), 1);
+    t.focus(); return false;
+  }
+  var n = $id('qname');
+  if(n.value === '' || !/^[A-Za-z0-9._-]+$/.test(n.value)){ msg(T.blank, 1); n.focus(); return false; }
+  if(!inRange('interval', 3, 300) || !inRange('timeout', 200, 5000) || !inRange('fail', 1, 10) || !inRange('recover', 1, 10)){ msg(T.badIp, 1); return false; }
+  return true;
+}
+/* stock apply flow (start_apply.htm in the hidden frame) */
+function post(fields){
+  var f = document.createElement('form'), k;
+  f.method = 'POST'; f.action = '/start_apply.htm'; f.target = 'fo_hidden'; f.style.display = 'none';
+  fields.action_mode = 'apply';
+  for(k in fields){
+    var i = document.createElement('input');
+    i.type = 'hidden'; i.name = k; i.value = fields[k]; f.appendChild(i);
+  }
+  document.body.appendChild(f); f.submit();
+  setTimeout(function(){ f.parentNode && f.parentNode.removeChild(f); }, 4000);
+}
+function apply(){
+  if(busy) return;
+  msg('');
+  if(!valid()) return;
+  var v = {
+    reaper_dnshc_enable: on('en'), reaper_dnshc_target: $id('target').value, reaper_dnshc_name: $id('qname').value,
+    reaper_dnshc_interval: $id('interval').value, reaper_dnshc_timeout: $id('timeout').value,
+    reaper_dnshc_fail: $id('fail').value, reaper_dnshc_recover: $id('recover').value, reaper_dnshc_strict: on('strict'),
+    reaper_dns_strict: on('dstrict'), reaper_dns_ecs: on('ecs'), reaper_dns_nocache: on('nocache')
+  };
+  var svc = '';
+  if(v.reaper_dnshc_enable !== ORIG.enable || v.reaper_dnshc_target !== ORIG.target || v.reaper_dnshc_name !== ORIG.name
+     || v.reaper_dnshc_interval !== ORIG.interval || v.reaper_dnshc_timeout !== ORIG.timeout || v.reaper_dnshc_fail !== ORIG.fail
+     || v.reaper_dnshc_recover !== ORIG.recover || v.reaper_dnshc_strict !== ORIG.strict) svc += 'restart_rdnshc;';
+  if(v.reaper_dns_strict !== ORIG.dnsstrict || v.reaper_dns_ecs !== ORIG.ecs || v.reaper_dns_nocache !== ORIG.nocache) svc += 'restart_dnsmasq;';
+  if(!svc) return;
+  busy = 1; $id('apply').disabled = true;
+  if(pollT){ clearTimeout(pollT); pollT = null; }
+  v.action_script = svc; v.action_wait = svc.indexOf('restart_dnsmasq') >= 0 ? '6' : '3';
+  $id('ovl_t').textContent = T.apply; $id('ovl_s').textContent = T.applying; $id('ovl').className = 'ovl on';
+  post(v);
+  setTimeout(function(){ location.reload(); }, svc.indexOf('restart_dnsmasq') >= 0 ? 8000 : 5000);
+}
+
+(function init(){
+  $id('en').addEventListener('change', syncEnable);
+  $id('apply').addEventListener('click', apply);
+  var ids = ['target','qname','interval','timeout','fail','recover'], i;
+  for(i = 0; i < ids.length; i++) $id(ids[i]).addEventListener('keydown', function(e){ if(e.key === 'Enter'){ e.preventDefault(); apply(); } });
+  $id('v6note').style.display = V6ON ? '' : 'none';
+  if(DNSSEC !== '' && DNSSEC !== '0') $id('dnssec_note').style.display = '';
+  syncEnable();
+  render(ORIG.state, ORIG.enable);
+  poll();
+})();
+</script>
+</body>
+</html>
