+.idtxt{min-width:0;flex:1 1 380px}
+.idtxt h1{font-family:var(--hdr);font-weight:700;font-size:26px;letter-spacing:.05em;color:var(--bone);text-transform:uppercase}
+.idtxt .sub{font-size:12.3px;color:var(--steel);margin-top:2px;max-width:78ch}
