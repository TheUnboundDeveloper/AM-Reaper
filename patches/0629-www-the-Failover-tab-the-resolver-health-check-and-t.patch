+.chip{font-family:var(--hdr);font-weight:600;font-size:11px;letter-spacing:.1em;text-transform:uppercase;
+  color:var(--bone-dim);border:1px solid var(--line-soft);border-radius:6px;padding:5px 10px;background:var(--panel);
+  font-variant-numeric:tabular-nums;white-space:nowrap;display:inline-flex;align-items:center;gap:7px;max-width:100%}
+.chip b{color:var(--bone);font-weight:600;overflow:hidden;text-overflow:ellipsis;max-width:26ch}
+.chip .dot{width:8px;height:8px;border-radius:50%;background:var(--steel);flex:0 0 auto}
+.chip.up .dot{background:var(--jade);box-shadow:0 0 0 0 rgba(79,178,134,.5);animation:pulse 2s ease-out infinite}
+.chip.down{border-color:var(--line-crimson)}
