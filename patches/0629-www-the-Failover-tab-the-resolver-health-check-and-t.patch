+/* ---------- cards ---------- */
+.tier{font-family:var(--hdr);font-weight:600;font-size:11.5px;letter-spacing:.16em;text-transform:uppercase;
+  color:var(--steel);display:flex;align-items:center;gap:12px;margin:24px 0 12px}
+.tier::after{content:"";flex:1;height:1px;background:var(--line-soft)}
+.card{position:relative;background:var(--panel);border:1px solid var(--line-soft);border-radius:14px;
+  padding:18px 20px;display:flex;flex-direction:column;min-width:0}
