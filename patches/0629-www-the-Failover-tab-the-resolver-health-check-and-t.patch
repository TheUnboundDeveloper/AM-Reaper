+.fld input[type=text]{display:block;width:100%;padding:9px 11px;background:#0b0b0d;border:1px solid #3a3a3e;border-radius:7px;color:var(--bone);
+  font:600 13.5px var(--body);letter-spacing:.03em;font-variant-numeric:tabular-nums}
