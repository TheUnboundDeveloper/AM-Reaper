diff --git a/release/src/router/rc/services.c b/release/src/router/rc/services.c
index 4d543a972f..119d02d724 100644
--- a/release/src/router/rc/services.c
+++ b/release/src/router/rc/services.c
@@ -1849,9 +1849,16 @@ void start_dnsmasq(void)
 	 * AdGuard or Pi-hole, a router-side cache would answer client B from a
 	 * decision made for client A and hide every cached hit from the filter's
 	 * statistics. The filter keeps its own cache. And "Pass client addresses
-	 * to the DNS server": EDNS Client Subnet with the full client address, so
-	 * the filter still knows which client asked (AdGuard Home: "Use EDNS
-	 * Client Subnet"; Pi-hole FTL: EDNS0_ECS, on by default). */
+	 * to the DNS server": EDNS Client Subnet carries the full client address.
+	 *
+	 * Pi-hole FTL READS it (EDNS0_ECS, on by default) and keeps filtering per
+	 * client. AdGuard Home does NOT: it resolves a client ClientID -> source
+	 * IP -> CIDR -> MAC and only LOGS the ECS value, never matches on it. So
+	 * while dnsmasq proxies, every per-client rule on an AdGuard target is
+	 * inert however this switch is set - ECS cannot recover an identity the
+	 * proxy already erased. Asked for upstream twice and declined:
+	 * AdGuardHome issues #4383 and #6104. The help text said otherwise until
+	 * 2026-09-08; do not restate the filters half. */
 	if (nvram_get_int("reaper_dns_ecs"))
 		fprintf(fp, "add-subnet=32,128\n");
 	/* reaper v3.1.1: ask the upstreams in the listed order and move on only
diff --git a/release/src/router/www/BR.dict b/release/src/router/www/BR.dict
index f1d1fb259d..0c534389b0 100644
--- a/release/src/router/www/BR.dict
+++ b/release/src/router/www/BR.dict
@@ -6886,7 +6886,7 @@ RDHC_18=Ordem dos upstreams
 RDHC_19=Ordem estrita (strict-order do dnsmasq)
 RDHC_20=Endereços dos clientes
 RDHC_21=Passar os endereços dos clientes ao servidor DNS (EDNS Client Subnet)
-RDHC_22=Com todos os clientes passando pelo roteador, o servidor DNS veria apenas o roteador. Isto anexa o endereço do cliente a cada consulta encaminhada, para que o AdGuard Home (com a opção "Use EDNS Client Subnet" ativa) ou o Pi-hole (ativo por padrão) continuem a mostrar e filtrar por cliente.
+RDHC_22=Com todos os clientes passando pelo roteador, o servidor DNS enxerga apenas o roteador. Isto anexa o endereço do cliente que perguntou a cada consulta encaminhada. O Pi-hole lê esse endereço e continua mostrando e filtrando por cliente. O AdGuard Home o exibe no registro de consultas, mas não o utiliza para escolher quais regras se aplicam, portanto suas regras por cliente permanecem inativas enquanto o roteador encaminha.
 RDHC_23=Cache DNS do roteador
 RDHC_24=Não armazenar respostas DNS em cache no roteador
 RDHC_25=O roteador normalmente guarda as respostas por um tempo. Com filtragem por cliente no servidor, uma resposta em cache decidida para um cliente seria entregue a outro, e o filtro não veria as consultas em cache. Desativado, o roteador apenas encaminha e o servidor DNS mantém o cache.
