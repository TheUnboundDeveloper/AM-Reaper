 }catch(e){ railFallback(); }
 
-/* ---- Firewall rail badge: the red count, on every page ---------------------
-   A broken promise used to be discoverable only by opening the Firewall page -
-   the one place a user has to already suspect something before they look. The
-   count now rides the rail, which the shell draws around every framed page, so
-   it is in front of the user wherever they are until it clears.
-
-   NOTHING is shown at zero. An always-present "0" trains people to ignore the
-   spot the number will appear in; an empty rail is the honest resting state.
-
-   Cheap by construction: the shell outlives every page navigation (pages load
-   into the iframe, the chrome does not reload), so this is ONE 60 s poll for a
-   whole session however many pages are visited - not one per page. It reads the
-   CACHED report (action=witness with no run=1); rwatch re-walks every 5 minutes
-   on its own, so the badge can never trigger a table walk. */
-/* The rail is built ASYNCHRONOUSLY - menuTree.js arrives over require(), and
-   railFallback() can be as late as its 4 s timer - while this poll starts at
-   load. The first reading therefore usually lands BEFORE the badge element it
-   wants to write to exists, and without the cache below the count would then be
-   invisible until the next poll 60 s later. So remember the last reading and
-   re-apply it whenever the rail is (re)drawn. */
+/* ---- Firewall rail badge -----------------------------------------------------
+   Until 2026-09-16 this carried the walker's red count on every page and
+   polled the witness report once a minute for it. ADVISORY now (owner's
+   decision): the walker's rows are information, not an alarm, and a number
+   on the menu is an alarm - so the badge is never lit and the poll is gone.
+   The element and the CSS above stay so the rail keeps its shape and
+   railFallback()'s re-apply call still has a setter to call. Read the report
+   on the Firewall page's Rule Status tab or the dashboard's posture card. */
 var FW_RED=null;
-function setFwBadge(red){
-  FW_RED=red;
-  var b=document.querySelectorAll('[data-fwred]');
-  for(var i=0;i<b.length;i++){
-    if(red>0){ b[i].textContent=String(red); b[i].className='nbadge on'; }
-    else { b[i].textContent=''; b[i].className='nbadge'; }
-  }
-}
-(function(){
-  var HID='<% nvram_get("http_id"); %>';
-  function poll(){
-    var x=new XMLHttpRequest(), fired=false;
-    function fin(ok){
-      if(fired) return; fired=true;
-      /* a failed fetch leaves the badge as it was: a request that did not land
-         is not evidence that the firewall is healthy */
-      if(ok){
-        try{
-          var j=JSON.parse(x.responseText);
-          if(j&&j.ok&&j.summary) setFwBadge(j.skeleton ? (j.summary.red||j.summary.total||0) : (j.summary.red||0));
-        }catch(e){}
-      }
-      setTimeout(poll, 60000);
-    }
-    x.open('GET','/reaper_fw.cgi?action=witness&http_id='+encodeURIComponent(HID)+'&_='+Date.now(),true);
-    x.timeout=8000;
-    /* ONE completion path per request (standing rule 34) */
-    x.onreadystatechange=function(){ if(x.readyState===4) fin(x.status===200); };
-    x.onerror=x.ontimeout=x.onabort=function(){ fin(false); };
-    x.send();
-  }
-  poll();
-})();
+function setFwBadge(red){ FW_RED=red; }
 
