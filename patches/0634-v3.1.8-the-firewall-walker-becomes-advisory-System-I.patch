+/* Warden's BAN list, read the same way Warden's own emitter reads it.
+ * rw_list_get() resolves the /jffs store first and falls back to legacy
+ * nvram rwarden_ban, so the host mapping below is that same fallback name
+ * rather than an invention. Caller does NOT free: the router branch keeps
+ * the one allocation in a static, because the generator reads it once. */
+static const char *banlist(void)
+{
+#ifdef FWSIM_HOST
+	return nv_get("rwarden_ban");
+#else
+	static char *cached = NULL;
+	if (!cached) cached = rw_list_get("ban");
+	return cached ? cached : "";
+#endif
+}
+
 /* copy '>'-separated field `idx` of `rec`. Returns 0 for absent AND for "does
  * not fit" - the same contract rfw_field() settled on in 2026-08-21, because a
  * truncated value would otherwise read as "no constraint" and silently widen
@@ -428,6 +497,60 @@ static int rec_byname(const char *list, const char *name, char *out, size_t ol)
  * fqdn and geo objects resolve at RUN time into an ipset, so there is no
  * literal here to aim a packet at: they return 0 and the rule is skipped
  * rather than witnessed against a guess. Returns 1 = ip, 2 = mac, 0 = no. */
+/* The first entry of the ban list that can be aimed at: E1/E2/E3 need ONE
+ * address that is genuinely in rw_ban. Returns 0 when there is none, which
+ * is a perfectly ordinary state (an empty ban list) and must stay silent
+ * rather than emitting a row that could only ever be red.
+ *
+ * A hash:net member answers `ipset test` on its own network address, so an
+ * entry written as a CIDR is reduced to that address; v6 entries belong to
+ * rw_ban6 and are skipped here. */
+static int ban_pick(char *out, size_t ol)
+{
+	char dup[512], *tok, *save = NULL;
+	struct addr ba;
+	const char *bl = banlist();
+
+	if (!out || !ol) return 0;
+	out[0] = 0;
+	if (!bl || !bl[0]) return 0;
+	/* the list can exceed this; the first usable entry is all we want, and
+	 * a truncated TAIL cannot mislead us the way a truncated value would */
+	snprintf(dup, sizeof(dup), "%s", bl);
+	/* same separators rw_emit_cidrs() splits on */
+	for (tok = strtok_r(dup, " ,<>", &save); tok; tok = strtok_r(NULL, " ,<>", &save)) {
+		if (strchr(tok, ':')) continue;	/* v6 lives in rw_ban6 */
+		if (addr_parse(tok, 4, &ba) != 0) continue;
+		addr_str(&ba, out, ol);
+		return out[0] ? 1 : 0;
+	}
+	return 0;
+}
