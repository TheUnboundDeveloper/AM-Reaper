+/* ------------------------------------------------------------------ */
+/* listening sockets - the one input that is not a table              */
+/* ------------------------------------------------------------------ */
+/* F7 needs to know whether the router is actually bound to the port a
+ * REDIRECT sends traffic to. Both builds parse the same /proc/net/{tcp,udp}
+ * format so the host suite exercises this parser and not a stand-in.
+ *
+ * `lsn_known` matters as much as the contents: if no socket table could be
+ * read at all, an F7 row must be n/a, never red. Reporting 'nothing is
+ * listening' because we could not look is exactly the lie the whole feature
+ * exists to avoid. */
+struct listener { int proto; int port; };
+static struct listener *lsn = NULL; static int nlsn = 0, lsn_known = 0;
+
+static void lsn_add(int proto, int port)
+{
+	int i;
+	for (i = 0; i < nlsn; i++) if (lsn[i].proto == proto && lsn[i].port == port) return;
+	lsn = xrealloc(lsn, sizeof(*lsn) * (nlsn + 1));
+	lsn[nlsn].proto = proto; lsn[nlsn].port = port; nlsn++;
+}
+
+/* /proc/net/{tcp,tcp6,udp,udp6}: `sl local_address rem_address st ...`,
+ * local_address being HEX_ADDR:HEX_PORT. TCP is listening at st 0A; UDP has
+ * no listen state, a bound socket sits at st 07. */
+static void load_listeners(const char *path, int proto)
+{
+	FILE *f = fopen(path, "r"); char line[512];
+	if (!f) return;
+	if (!fgets(line, sizeof(line), f)) { fclose(f); return; }	/* header */
+	lsn_known = 1;
+	while (fgets(line, sizeof(line), f)) {
+		char la[80], st[8]; char *colon; unsigned long port;
+		if (sscanf(line, "%*s %79s %*s %7s", la, st) != 2) continue;
+		colon = strrchr(la, ':');
+		if (!colon) continue;
+		port = strtoul(colon + 1, NULL, 16);
+		if (!port || port > 65535) continue;
+		if (proto == 6 && strcmp(st, "0A")) continue;
+		if (proto == 17 && strcmp(st, "07")) continue;
+		lsn_add(proto, (int)port);
+	}
+	fclose(f);
+}
+
+static int lsn_has(int proto, int port)
+{
+	int i;
+	for (i = 0; i < nlsn; i++) if (lsn[i].proto == proto && lsn[i].port == port) return 1;
+	return 0;
+}
 /* ------------------------------------------------------------------ */
 /* the routing policy database (`ip rule`) - the walker's fourth input  */
 /* ------------------------------------------------------------------ */
@@ -385,6 +438,22 @@ static const char *pbrlist(void)
 #endif
