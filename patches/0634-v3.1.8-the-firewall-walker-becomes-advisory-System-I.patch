+				while ((at = strstr(buf2, masks[j])) != NULL) {
+					snprintf(t2, sizeof(t2), "%.*s[WAN-IP]%s", (int)(at - buf2), buf2, at + ml);
+					snprintf(buf2, sizeof(buf2), "%s", t2);
+				}
+			}
+			/* a newline in a value would break the key=value fixture format */
+			if (strchr(buf2, '\n')) continue;
+			fprintf(f, "%s=%s\n", dump_keys[i], buf2);
+		}
+		fclose(f);
+	}
+
+	snprintf(path, sizeof(path), "%s/topology.txt", dir);
+	f = fopen(path, "w");
+	if (f) {
+		fprintf(f, "# reaper_fwsim %s fixture\n# model %s / firmware %s\n# lan %s wan %s\n",
+			FWSIM_VER, nv_get("productid"), nv_get("buildno"), lan_ifname, wan_ifname);
+		fprintf(f, "# the WAN addresses are masked as [WAN-IP]\n");
+		for (i = 0; i < nown; i++) {
+			char s[48]; addr_str(&own[i].a, s, sizeof(s));
+			fprintf(f, "%s %s/%d%s\n", own[i].ifname, s, own[i].a.plen, own[i].scope_link ? " (link)" : "");
+		}
+		fclose(f);
+	}
+	fprintf(stderr, "fixture written to %s - review it before sharing\n", dir);
+	return 0;
+}
