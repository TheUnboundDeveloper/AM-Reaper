diff --git a/release/src/router/www/Reaper_Sysinfo.asp b/release/src/router/www/Reaper_Sysinfo.asp
new file mode 100644
index 00000000000..463d7bcfa32
--- /dev/null
+++ b/release/src/router/www/Reaper_Sysinfo.asp
@@ -0,0 +1,514 @@
+<!-- SPDX-License-Identifier: GPL-2.0-only
+     Copyright (C) 2026 the Reaper project maintainer
+     Part of the Reaper hardened Asuswrt-Merlin build. See LICENSE / LICENSE.reaper.
+
+     Reaper_Sysinfo.asp - the native System Information page, replacing stock
+     Tools_Sysinfo.asp (which stays byte-pristine on disk; reaper_inject.c's SUP{}
+     map bounces it here, so the rollback is one line).
+
+     SAME DATA, REORGANISED. Every figure the stock page carried is here. What
+     changed is the grouping: stock arranged its tables by where the numbers come
+     from (a "Router" table, a "CPU" table, an "Internal Storage" table that also
+     held RAM). This page groups by the question a person is actually asking -
+     what is this box, is it struggling, am I running out, how loaded is it, what
+     can it do - because that is the order someone reads it in.
+
+     NO NEW BACKEND. It reads the same two endpoints the stock page does:
+     /ajax_sysinfo.asp (memory, CPU load, connections, per-radio client counts)
+     and /ajax_coretmp.asp (CPU and per-radio temperatures), plus ejs statics.
+
+     ONE DELIBERATE DIFFERENCE IN HOW THEY ARE READ. The stock page pulls
+     /ajax_sysinfo.asp with jQuery `dataType:'script'`, i.e. it EXECUTES the
+     response. This page parses it instead, the same choice Main_ReaperDash.asp
+     documents for the stock status endpoints: an unexpected or tampered response
+     can then only ever become inert data, never executable code.
+
+     BAND LABELS COME FROM wlX_nband, NOT A MODEL NAME. Stock remaps radio
+     indices with a hardcoded switch on based_modelid (GT-AXE16000 / GT-BE98 /
+     GT-BE98_PRO), so a model not in that list gets its bands mislabelled. The
+     WL[] construction below is the dashboard's: filter by nband, label by band,
+     disambiguate duplicates. It is right per model without another edit here. -->
+<!DOCTYPE html>
+<html lang="en">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width, initial-scale=1">
+<meta name="reaper-native" content="1">
+<title>REAPER &mdash; <#RSYS_00#></title>
+<style>
+@font-face{font-family:'Rajdhani';font-weight:600;font-display:swap;src:url('/fonts/rajdhani-600.woff2') format('woff2')}
+@font-face{font-family:'Rajdhani';font-weight:700;font-display:swap;src:url('/fonts/rajdhani-700.woff2') format('woff2')}
+@font-face{font-family:'Inter';font-weight:400;font-display:swap;src:url('/fonts/inter-400.woff2') format('woff2')}
+@font-face{font-family:'Inter';font-weight:600;font-display:swap;src:url('/fonts/inter-600.woff2') format('woff2')}
+:root{
+  --bg:#08080a; --panel:#0f0f12; --panel-2:#141418;
+  --line:rgba(225,6,0,.16); --line-soft:rgba(255,255,255,.06);
+  --crimson:#E10600; --crimson-deep:#B3000C;
+  --bone:#ECE7DB; --bone-dim:#B7B1A4; --steel:#71767b;
+  --jade:#4FB286; --amber:#E0A93B; --danger:#FF3B30;
+  --hdr:'Rajdhani','Oswald',system-ui,sans-serif;
+  --body:'Inter',system-ui,-apple-system,'Segoe UI',sans-serif;
+}
+*{box-sizing:border-box;margin:0}
+html,body{background:var(--bg)}
+body{font-family:var(--body);color:var(--bone-dim);font-size:13.5px;line-height:1.55;padding:20px 22px 48px}
+h1,h2,h3{font-family:var(--hdr);letter-spacing:.04em;color:var(--bone);margin:0}
+.pagehead{display:flex;align-items:center;gap:16px;flex-wrap:wrap;margin-bottom:4px;max-width:1560px}
+.pagehead h1{font-size:24px;font-weight:700}
+.statuspill{font-family:var(--hdr);font-weight:600;font-size:11px;letter-spacing:.1em;text-transform:uppercase;border-radius:20px;padding:4px 12px;border:1px solid var(--line);color:var(--jade)}
+.lede{max-width:82ch;margin:6px 0 16px}
+.lede b{color:var(--bone);font-weight:600}
+.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px;max-width:1560px;align-items:start}
+@media(max-width:980px){.grid{grid-template-columns:1fr}}
+.card{background:var(--panel);border:1px solid var(--line-soft);border-radius:12px;padding:16px 18px}
+.card.span{grid-column:1/-1}
+.card>h2{font-size:14px;text-transform:uppercase;letter-spacing:.1em;margin-bottom:12px;padding-bottom:8px;border-bottom:1px solid var(--line-soft)}
+/* key/value rows: the label column is fixed so every card's values line up */
+.kv{display:grid;grid-template-columns:minmax(120px,34%) 1fr;gap:6px 14px;align-items:baseline}
+.kv dt{color:var(--steel);font-size:12px}
+.kv dd{color:var(--bone);margin:0;overflow-wrap:anywhere}
+.mono{font-family:ui-monospace,Consolas,monospace;font-size:12px}
+.sub{color:var(--steel);font-size:11.5px}
+.note{font-size:12px;color:var(--steel);line-height:1.55;margin-top:10px}
+.note b{color:var(--bone-dim)}
+/* a labelled proportion bar, used for memory, nvram and jffs */
+.meter{margin:10px 0 4px}
+.meter .top{display:flex;justify-content:space-between;align-items:baseline;font-size:12px;margin-bottom:5px}
+.meter .top .l{color:var(--steel)}
+.meter .top .r{color:var(--bone)}
+.bar{height:8px;border-radius:5px;background:var(--panel-2);overflow:hidden;display:flex}
+.bar span{display:block;height:100%}
+.bar .used{background:var(--crimson)}
+.bar .buff{background:rgba(225,6,0,.38)}
+.bar .cach{background:rgba(225,6,0,.18)}
+.legend{display:flex;gap:14px;flex-wrap:wrap;margin-top:8px;font-size:11.5px;color:var(--steel)}
+.legend i{display:inline-block;width:9px;height:9px;border-radius:2px;margin-right:5px;vertical-align:baseline}
+/* per-core usage */
+.cores{display:flex;gap:5px;margin-top:6px}
+.cores i{flex:1;height:22px;border-radius:3px;background:var(--panel-2);position:relative;overflow:hidden}
+.cores i b{position:absolute;left:0;bottom:0;width:100%;display:block;background:var(--crimson);transition:height .3s}
+.temps{display:flex;gap:18px;flex-wrap:wrap;margin-top:4px}
+.temps div{font-size:12px}
+.temps .v{font-family:var(--hdr);font-weight:700;font-size:18px;color:var(--bone)}
+.temps .v.warm{color:var(--amber)}
+.temps .v.hot{color:var(--danger)}
+/* rc_support, as chips instead of a space-separated blob */
+.chips{display:flex;flex-wrap:wrap;gap:6px}
+.chips span{font-size:11px;font-family:ui-monospace,Consolas,monospace;border:1px solid var(--line-soft);
+  border-radius:12px;padding:2px 9px;color:var(--bone-dim);background:var(--panel-2)}
+table.wl{width:100%;border-collapse:collapse;font-size:12.5px;margin-top:2px}
+table.wl th{text-align:left;font-size:10px;letter-spacing:.12em;text-transform:uppercase;color:var(--steel);padding:4px 8px 6px;border-bottom:1px solid var(--line-soft)}
+table.wl th.num,table.wl td.num{text-align:right}
+table.wl td{padding:6px 8px;border-top:1px solid var(--line-soft);color:var(--bone)}
+.hidden{display:none}
+</style>
+</head>
+<body>
+
+<div class="pagehead">
+  <h1><#RSYS_00#>
+    <a href="https://github.com/TheUnboundDeveloper/AM-Reaper/blob/main/docs/REAPER-GUIDE.md" target="_blank" rel="noopener noreferrer" title="<#RABT_43#>" style="display:inline-flex;align-items:center;justify-content:center;width:22px;height:22px;margin-left:8px;border-radius:50%;border:1px solid #4a4a4e;color:#8d897f;font:700 13px Arial,sans-serif;text-decoration:none;vertical-align:middle">?</a>
+  </h1>
+  <span class="statuspill" id="up_pill">&mdash;</span>
+</div>
+<p class="lede"><#RSYS_01#></p>
+
+<div class="grid">
+
+  <!-- ---------------------------------------------------- this router -->
+  <div class="card">
+    <h2><#RSYS_02#></h2>
+    <dl class="kv">
+      <dt><#RABT_06#></dt>          <dd id="s_model">&mdash;</dd>
+      <dt><#RSYS_09#></dt>          <dd class="mono" id="s_serial">&mdash;</dd>
+      <dt><#RSYS_10#></dt>          <dd class="mono" id="s_lanmac">&mdash;</dd>
+      <dt><#Reaper_c_firmware#></dt><dd class="mono" id="s_fw">&mdash;</dd>
+      <dt><#RSYS_11#></dt>          <dd class="mono sub" id="s_build">&mdash;</dd>
+      <dt><#RSYS_12#></dt>          <dd class="mono" id="s_cfe">&mdash;</dd>
+      <dt><#RSYS_13#></dt>          <dd class="mono" id="s_wldrv">&mdash;</dd>
+      <dt><#menu5_6_1#></dt>        <dd id="s_opmode">&mdash;</dd>
+      <dt><#General_x_SystemUpTime_itemname#></dt><dd id="s_uptime">&mdash;</dd>
+    </dl>
+  </div>
+
+  <!-- ------------------------------------------------------ processor -->
+  <div class="card">
+    <h2><#RSYS_03#></h2>
+    <dl class="kv">
+      <dt><#Status_CPU#></dt>  <dd id="s_cpu">&mdash;</dd>
+      <dt><#RSYS_14#></dt>     <dd id="s_cores">&mdash;</dd>
+      <dt><#RSYS_15#></dt>     <dd id="s_freq">&mdash;</dd>
+      <dt><#RSYS_16#></dt>     <dd><span class="mono" id="s_load">&mdash;</span> <span class="sub" id="s_loadmeans"></span></dd>
+    </dl>
+    <div class="meter">
+      <div class="top"><span class="l"><#RSYS_18#></span></div>
+      <div class="cores" id="s_cores_bars"></div>
+    </div>
+    <div class="meter">
+      <div class="top"><span class="l"><#RSYS_19#></span></div>
+      <div class="temps" id="s_temps"><span class="sub">&mdash;</span></div>
+    </div>
+  </div>
+
+  <!-- --------------------------------------------------------- memory -->
+  <div class="card">
+    <h2><#RSYS_04#></h2>
+    <div class="meter">
+      <div class="top"><span class="l"><#Status_RAM#></span><span class="r" id="s_mem_top">&mdash;</span></div>
+      <div class="bar"><span class="used" id="s_mem_used"></span><span class="buff" id="s_mem_buff"></span><span class="cach" id="s_mem_cach"></span></div>
+      <div class="legend">
+        <span><i class="used" style="background:var(--crimson)"></i><#Status_Used#> <b id="s_mem_used_v">&mdash;</b></span>
+        <span><i style="background:rgba(225,6,0,.38)"></i><#RSYS_21#> <b id="s_mem_buff_v">&mdash;</b></span>
+        <span><i style="background:rgba(225,6,0,.18)"></i><#RSYS_22#> <b id="s_mem_cach_v">&mdash;</b></span>
+        <span><i style="background:var(--panel-2)"></i><#Status_Free#> <b id="s_mem_free_v">&mdash;</b></span>
+      </div>
+    </div>
+    <dl class="kv" style="margin-top:12px">
+      <dt><#Status_Total#></dt> <dd id="s_mem_total">&mdash;</dd>
+      <dt><#RSYS_20#></dt>      <dd><b id="s_mem_avail">&mdash;</b></dd>
+      <dt><#RSYS_23#></dt>      <dd id="s_swap">&mdash;</dd>
+    </dl>
+    <p class="note"><#RSYS_25#></p>
+  </div>
+
+  <!-- -------------------------------------------------------- storage -->
+  <div class="card">
+    <h2><#RSYS_05#></h2>
+    <div class="meter">
+      <div class="top"><span class="l"><#RSYS_26#></span><span class="r" id="s_nvram_top">&mdash;</span></div>
+      <div class="bar"><span class="used" id="s_nvram_bar"></span></div>
+    </div>
+    <div class="meter">
+      <div class="top"><span class="l"><#RSYS_27#></span><span class="r" id="s_jffs_top">&mdash;</span></div>
+      <div class="bar"><span class="used" id="s_jffs_bar"></span></div>
+    </div>
+    <p class="note"><#RSYS_28#></p>
+  </div>
+
+  <!-- ----------------------------------------------- network capacity
+       Full width: the add-on board card beside it is hidden on every router
+       that has no such board, which is most of them, and a half-width card with
+       an empty column next to it reads as something failing to load. The client
+       table wants the room anyway. -->
+  <div class="card span">
+    <h2><#RSYS_06#></h2>
+    <dl class="kv">
+      <dt><#RCON_01#></dt>  <dd><span id="s_conn">&mdash;</span> <span class="sub" id="s_conn_head"></span></dd>
+      <dt><#RSYS_31#></dt>  <dd class="mono" id="s_accel">&mdash;</dd>
+    </dl>
+    <div class="meter">
+      <div class="top"><span class="l"><#RSYS_33#></span></div>
+      <table class="wl">
+        <thead><tr><th>&nbsp;</th><th class="num"><#RSYS_34#></th><th class="num"><#RSYS_35#></th><th class="num"><#RSYS_36#></th></tr></thead>
+        <tbody id="s_wl"></tbody>
+      </table>
+    </div>
+  </div>
+
+  <!-- ---------------------------------------------------- add-on board -->
+  <div class="card hidden" id="s_ai_card">
+    <h2><#RSYS_08#></h2>
+    <dl class="kv">
+      <dt><#RABT_06#></dt>          <dd id="s_ai_model">&mdash;</dd>
+      <dt><#RSYS_39#></dt>          <dd id="s_ai_hw">&mdash;</dd>
+      <dt><#Reaper_c_firmware#></dt><dd class="mono" id="s_ai_fw">&mdash;</dd>
+      <dt><#RSYS_40#></dt>          <dd class="mono" id="s_ai_ip">&mdash;</dd>
+    </dl>
+  </div>
+
+  <!-- --------------------------------------------------- capabilities -->
+  <div class="card span">
+    <h2><#RSYS_07#></h2>
+    <div class="chips" id="s_caps"></div>
+    <p class="note"><#RSYS_37#></p>
+  </div>
+
+</div>
+
+<script>
+/* ---------------------------------------------------------------- statics
+   Read once at render. Everything live is polled below. */
+var SI = {
+  model:   '<% nvram_get("productid"); %>',
+  serial:  '<% nvram_get("serial_no"); %>',
+  lanmac:  '<% get_lan_hwaddr(); %>',
+  firmver: '<% nvram_get("firmver"); %>',
+  buildno: '<% nvram_get("buildno"); %>',
+  extendno:'<% nvram_get("extendno"); %>',
+  buildinfo: decodeURIComponent('<% nvram_char_to_ascii("", "buildinfo"); %>'),
+  cfe:     '<% sysinfo("cfe_version"); %>',
+  cpu:     '<% sysinfo("cpu.model"); %>',
+  freq:    '<% sysinfo("cpu.freq"); %>',
+  connmax: '<% sysinfo("conn.max"); %>',
+  nvtotal: '<% sysinfo("nvram.total"); %>',
+  jffstot: '<% sysinfo("jffs.total"); %>',
+  runner:  '<% sysinfo("hwaccel.runner"); %>',
+  fcache:  '<% sysinfo("hwaccel.fc"); %>',
+  caps:    '<% nvram_get("rc_support"); %>',
+  drv:    ['<% sysinfo("driver_version.0"); %>','<% sysinfo("driver_version.1"); %>',
+           '<% sysinfo("driver_version.2"); %>','<% sysinfo("driver_version.3"); %>']
+};
+/* per-radio, band-driven (see the header note): nband decides the label, not a
+   hardcoded model name, so a new model is right without another edit here. */
+var WL = [
+  {idx:0, nband:'<% nvram_get("wl0_nband"); %>'},
+  {idx:1, nband:'<% nvram_get("wl1_nband"); %>'},
+  {idx:2, nband:'<% nvram_get("wl2_nband"); %>'},
+  {idx:3, nband:'<% nvram_get("wl3_nband"); %>'}
+].filter(function(w){ return w.nband; });
+(function(){
+  function base(nb){ return nb==='2'?'2.4 GHz':(nb==='4'?'6 GHz':'5 GHz'); }
+  var seen={};
+  for(var i=0;i<WL.length;i++){ var b=base(WL[i].nband); seen[b]=(seen[b]||0)+1;
+    WL[i].label=(seen[b]>1)?(b+' ('+seen[b]+')'):b; }
+})();
+
+/* operation mode: get_operation_mode() emits a BARE token, so it is wrapped the
+   way Main_ReaperDash.asp wraps it. The code is turned into words here rather
+   than shown raw - "ap" means nothing to a reader. */
+var OPMODE = [<% get_operation_mode(); %>][0];
+/* the dashboard's map, verbatim - all eight modes, every token already proven to
+   exist, and the same words for the same mode on both pages. A partial map here
+   would have left ew2/ew5/hs/wisp showing a raw code. */
+var OPNAMES={rt:`<#Reaper_c_opmode_rt#>`,rp:`<#Clientlist_Repeater#>`,ap:`<#Device_type_03_AP#>`,mb:`<#OP_MB_item#>`,ew2:`<#RDSH_30#>`,ew5:`<#RDSH_31#>`,hs:`<#Reaper_c_opmode_hs#>`,wisp:`<#Reaper_c_opmode_wisp#>`};
+var OPNAME = OPNAMES[OPMODE] || String(OPMODE||'').toUpperCase();
+
+function $id(i){return document.getElementById(i);}
+function txt(i,v){var e=$id(i); if(e) e.textContent=(v===''||v==null)?'-':v;}
+function esc(s){return String(s==null?'':s).replace(/[&<>"']/g,function(c){
+  return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];});}
+function mb(n){ n=Number(n)||0; return n.toLocaleString()+' MB'; }
+function pct(a,b){ b=Number(b)||0; return b>0?Math.max(0,Math.min(100,Number(a)/b*100)):0; }
+
+/* ------------------------------------------------------------- identity */
+(function(){
+  txt('s_model', SI.model);
+  txt('s_serial', SI.serial);
+  txt('s_lanmac', SI.lanmac);
+  var fw=(SI.firmver||'').replace(/\./g,'')+'.'+SI.buildno;
+  if(SI.extendno && SI.extendno!=='0') fw+='_'+SI.extendno.charAt(0).toUpperCase()+SI.extendno.slice(1);
+  txt('s_fw', fw);
+  txt('s_build', SI.buildinfo);
+  txt('s_cfe', SI.cfe);
+  txt('s_opmode', OPNAME);
+  txt('s_cpu', SI.cpu.replace(/&nbsp;/g,' '));
+  txt('s_freq', SI.freq ? SI.freq+' MHz' : '');
+  /* the driver version is per RADIO; show one line per radio we actually have,
+     labelled by band rather than by index */
+  var d=[]; for(var i=0;i<WL.length;i++){ var v=SI.drv[WL[i].idx]; if(v) d.push(WL[i].label+': '+v); }
+  var el=$id('s_wldrv'); if(el) el.innerHTML = d.length ? d.map(esc).join('<br>') : '-';
+  /* cores: sysinfo prints "... (Cores: N)" - the dashboard reads it the same way */
+  var mc=(SI.cpu||'').match(/Cores:\s*([0-9]+)/);
+  window.NCORE = mc ? Number(mc[1]) : 0;
+  txt('s_cores', NCORE || '');
+  /* rc_support is a space-separated blob of feature tokens; as chips it is at
+     least scannable. Sorted, because the firmware's own order is arbitrary. */
+  var caps=(SI.caps||'').split(/\s+/).filter(Boolean).sort();
+  var cel=$id('s_caps');
+  if(cel) cel.innerHTML = caps.length ? caps.map(function(c){return '<span>'+esc(c)+'</span>';}).join('') : '-';
+})();
+
+/* --------------------------------------------------------------- uptime
+   /proc/uptime via sysinfo, ticked locally so it stays honest between polls. */
+(function(){
+  /* sysuptime() returns prose ("N days, HH:MM:SS since boot"), so it is parsed
+     the same way Main_ReaperDash.asp parses it, then ticked locally - that is
+     offset-proof and survives the string's format varying by uptime. */
+  var UPSTR = "<% sysuptime(); %>";
+  function relSec(x){
+    var b=0, dm=x.match(/(\d+)\s*d/i); if(dm) b+=(+dm[1])*86400;
+    var cm=x.match(/(\d+):(\d{2})(?::(\d{2}))?/);
+    if(cm) return b+(+cm[1])*3600+(+cm[2])*60+(+(cm[3]||0));
+    function g(re){ var m=x.match(re); return m?+m[1]:0; }
+    return b+g(/(\d+)\s*h/i)*3600+g(/(\d+)\s*m(?!o)/i)*60+g(/(\d+)\s*s/i);
+  }
+  var up = relSec(String(UPSTR).replace(/\s*since boot\s*$/i,'').trim());
+  if(!(up > 0)) return;
+  var t0 = Date.now();
+  function p2(n){ return (n<10?'0':'')+n; }
+  function tick(){
+    var s = up + Math.floor((Date.now()-t0)/1000);
+    var d = Math.floor(s/86400), h = Math.floor(s%86400/3600), m = Math.floor(s%3600/60);
+    var v = d+'d '+p2(h)+':'+p2(m)+':'+p2(Math.floor(s%60));
+    txt('s_uptime', v); txt('up_pill', v);
+  }
+  tick(); setInterval(tick, 1000);
+})();
+
+/* ------------------------------------------------------- live: sysinfo
+   Same endpoint the stock page uses. PARSED, not executed - see the header. */
+function parseArr(text, name){
+  var m = text.match(new RegExp(name + '\\s*=\\s*\\[([^\\]]*)\\]'));
+  if(!m) return null;
+  return m[1].split(',').map(function(s){ return s.trim().replace(/^"|"$/g,''); });
+}
+function renderSysinfo(t){
+  var mem  = parseArr(t,'mem_stats_arr'),
+      cpu  = parseArr(t,'cpu_stats_arr'),
+      conn = parseArr(t,'conn_stats_arr');
+
+  if(cpu){
+    txt('s_load', cpu[0]+', '+cpu[1]+', '+cpu[2]);
+    /* a load average means nothing without the core count beside it */
+    if(NCORE>0) txt('s_loadmeans', `<#RSYS_17#>`.replace('%1', NCORE));
+  }
+  if(mem){
+    var total=+mem[0], free=+mem[1], buff=+mem[2], cach=+mem[3],
+        swapu=+mem[4], swapt=+mem[5], nvused=+mem[6], jffsfree=+mem[7],
+        used=+mem[8], avail=+mem[9];
+    txt('s_mem_total', mb(total));
+    txt('s_mem_avail', mb(avail));
+    txt('s_mem_top', mb(used)+' / '+mb(total));
+    txt('s_mem_used_v', mb(used)); txt('s_mem_buff_v', mb(buff));
+    txt('s_mem_cach_v', mb(cach)); txt('s_mem_free_v', mb(free));
+    var b;
+    if((b=$id('s_mem_used'))) b.style.width=pct(used,total).toFixed(1)+'%';
+    if((b=$id('s_mem_buff'))) b.style.width=pct(buff,total).toFixed(1)+'%';
+    if((b=$id('s_mem_cach'))) b.style.width=pct(cach,total).toFixed(1)+'%';
+    txt('s_swap', swapt>0 ? (mb(swapu)+' / '+mb(swapt)) : `<#RSYS_24#>`);
+
+    /* nvram.total / jffs.total are static; used/free arrive here */
+    var nvt=+SI.nvtotal;
+    if(nvt>0){ txt('s_nvram_top', nvused.toLocaleString()+' / '+nvt.toLocaleString()+' B');
+      if((b=$id('s_nvram_bar'))) b.style.width=pct(nvused,nvt).toFixed(1)+'%'; }
+    var jt=+SI.jffstot;
+    if(jt>0){ var ju=jt-jffsfree;
+      txt('s_jffs_top', mb(ju)+' / '+mb(jt));
+      if((b=$id('s_jffs_bar'))) b.style.width=pct(ju,jt).toFixed(1)+'%'; }
+  }
+  if(conn){
+    var cmax=+SI.connmax||0, active=+conn[1]||0, tot=+conn[0]||0;
+    txt('s_conn', tot.toLocaleString()+' \u00b7 '+active.toLocaleString()+' '+`<#RSYS_29#>`);
+    if(cmax>0) txt('s_conn_head', `<#RSYS_30#>`.replace('%1', cmax.toLocaleString())
+                    + ' \u00b7 ' + (100-pct(tot,cmax)).toFixed(0) + '% ' + `<#RSYS_41#>`);
+  }
+  /* per-radio client counts, band-labelled */
+  var rows='';
+  for(var i=0;i<WL.length;i++){
+    var a=parseArr(t,'wlc_'+WL[i].idx+'_arr');
+    if(!a) continue;
+    rows+='<tr><td>'+esc(WL[i].label)+'</td><td class="num">'+esc(a[0])+
+          '</td><td class="num">'+esc(a[1])+'</td><td class="num">'+esc(a[2])+'</td></tr>';
+  }
+  var w=$id('s_wl'); if(w) w.innerHTML = rows || '<tr><td colspan="4" class="sub">-</td></tr>';
+}
+function pollSysinfo(){
+  var x=new XMLHttpRequest(), done=false;
+  function fin(ok){
+    if(done) return; done=true;
+    if(ok){ try{ renderSysinfo(x.responseText); }catch(e){} }
+    setTimeout(pollSysinfo, 3000);
+  }
+  x.open('GET','/ajax_sysinfo.asp?_='+Date.now(), true);
+  x.timeout=8000;
+  /* ONE completion path per request (standing rule 34) */
+  x.onreadystatechange=function(){ if(x.readyState===4) fin(x.status===200); };
+  x.onerror=x.ontimeout=x.onabort=function(){ fin(false); };
+  x.send();
+}
+pollSysinfo();
+
+/* --------------------------------------------- live: temperatures + cores */
+function pollTemp(){
+  var x=new XMLHttpRequest(), done=false;
+  function fin(ok){
+    if(done) return; done=true;
+    if(ok) try{
+      var t=x.responseText, out=[];
+      var c=t.match(/curr_cpuTemp\s*=\s*"?([0-9.]+)/);
+      if(c) out.push([`<#Status_CPU#>`, parseFloat(c[1])]);
+      for(var i=0;i<WL.length;i++){
+        /* the router quotes only curr_coreTmp_wlN_RAW - the unsuffixed name is a
+           JS expression there, not a literal - so _raw is what has to be read.
+           It carries the word "disabled" for a radio that is off, and stripping
+           that to digits yields a nonsense temperature (a "2.4GHz disabled"
+           string becomes 2 degrees), so it is tested for before parsing. The
+           optional suffix also matches the mock, which emits only the cleaned
+           name. */
+        var m=t.match(new RegExp('curr_coreTmp_wl'+WL[i].idx+'(?:_raw)?\\s*=\\s*"([^"]*)"'));
+        if(!m) continue;
+        var s1=String(m[1]);
+        if(/disabled/i.test(s1)) continue;
+        var v=parseFloat(s1.replace(/[^0-9.]/g,''));
+        if(v>0) out.push([WL[i].label, v]);
+      }
+      var el=$id('s_temps');
+      if(el) el.innerHTML = out.length ? out.map(function(p){
+        var cls = p[1]>=85 ? ' hot' : (p[1]>=70 ? ' warm' : '');
+        return '<div><div class="v'+cls+'">'+p[1].toFixed(0)+'\u00b0C</div><div class="sub">'+esc(p[0])+'</div></div>';
+      }).join('') : '<span class="sub">-</span>';
+    }catch(e){}
+    setTimeout(pollTemp, 5000);
+  }
+  x.open('GET','/ajax_coretmp.asp?_='+Date.now(), true);
+  x.timeout=8000;
+  x.onreadystatechange=function(){ if(x.readyState===4) fin(x.status===200); };
+  x.onerror=x.ontimeout=x.onabort=function(){ fin(false); };
+  x.send();
+}
+pollTemp();
+
+/* per-core usage, from the same endpoint the dashboard uses */
+var _prevCores=null;
+function pollCores(){
+  var x=new XMLHttpRequest(), done=false;
+  function fin(ok){
+    if(done) return; done=true;
+    if(ok) try{
+      var m=x.responseText.match(/cpuInfo\s*=\s*(\{.*\})\s*;/);
+      if(m){
+        var ci=JSON.parse(m[1]), per=[];
+        for(var k in ci){ if(ci[k]&&ci[k].total!=null) per.push({t:+ci[k].total,u:+ci[k].usage}); }
+        var box=$id('s_cores_bars');
+        if(box && per.length){
+          if(box.children.length!==per.length){
+            box.innerHTML=''; for(var i=0;i<per.length;i++) box.appendChild(document.createElement('i')).appendChild(document.createElement('b'));
+            if(!NCORE){ window.NCORE=per.length; txt('s_cores', per.length); }
+          }
+          if(_prevCores && _prevCores.length===per.length){
+            var bars=box.getElementsByTagName('b');
+            for(var j=0;j<per.length && j<bars.length;j++){
+              var dt=per[j].t-_prevCores[j].t, du=per[j].u-_prevCores[j].u;
+              var p=dt>0?Math.max(0,Math.min(100,du/dt*100)):0;
+              bars[j].style.height=p.toFixed(0)+'%';
+            }
+          }
+          _prevCores=per;
+        }
+      }
+    }catch(e){}
+    setTimeout(pollCores, 2500);
+  }
+  x.open('GET','/cpu_ram_status.asp?_='+Date.now(), true);
+  x.timeout=8000;
+  x.onreadystatechange=function(){ if(x.readyState===4) fin(x.status===200); };
+  x.onerror=x.ontimeout=x.onabort=function(){ fin(false); };
+  x.send();
+}
+pollCores();
+
+/* ------------------------------------------------------------ accelerator
+   Stock names the engine from the CPU model: BCM67xx is Archer, everything
+   else on this platform is Runner. Same rule, same source. */
+(function(){
+  var name = (SI.cpu||'').search('BCM67')!==-1 ? 'Archer' : 'Runner';
+  var v = name+': '+(SI.runner||'-')+'   \u00b7   '+`<#RSYS_32#>`+': '+(SI.fcache||'-');
+  txt('s_accel', v);
+})();
+
+/* ------------------------------------------------------------ add-on board
+   Only shown where the board exists - on a router without one the stock page
+   still drew an empty table. */
+(function(){
+  var model='<% nvram_get("ai_productid"); %>';
+  if(!model) return;                       /* no board: the card stays hidden */
+  var c=$id('s_ai_card'); if(c) c.classList.remove('hidden');
+  var hw='<% nvram_get("ai_sys_hw_version"); %>', rev='<% nvram_get("ai_sys_hw_revision"); %>';
+  txt('s_ai_model', model);
+  txt('s_ai_hw',   hw ? (hw + (rev ? ' rev. '+rev : '')) : '');
+  txt('s_ai_fw',   '<% nvram_get("ai_sys_fw_version"); %>');
+  txt('s_ai_ip',   '<% nvram_get("ai_sys_ip_address"); %>');
+})();
+</script>
+</body>
+</html>
diff --git a/release/src/router/www/SL.dict b/release/src/router/www/SL.dict
index 8a8d019eed9..d2d023d21ea 100644
--- a/release/src/router/www/SL.dict
+++ b/release/src/router/www/SL.dict
@@ -7022,7 +7022,7 @@ RVR_73=Inactive
 RVR_74=Killswitch
 RFW_290=Rule Status
 RFW_291=Each feature owns a few witness packets: an ingress interface, addresses, a protocol and port, a connection state, and the verdict it promises. After every firewall change the router walks them through the live tables in kernel order and names the rule that decided each one. OK means the promise holds; Unsuccessful means the tables do not deliver it.
-RFW_292=Example: a Gatekeeper-blocked device must not reach the WAN (drop) but must still resolve names at the router (accept). If that second row comes back Unsuccessful, the DNS carve-out sits behind the block - the rule column names what caught it.
+RFW_292=Example: a port forward has two rows - translated, then passes FORWARD. If the second comes back Unsuccessful with filter/FORWARD policy DROP in the rule column, no rule accepts the translated flow: the forward exists and nothing reaches the host.
 RFW_293=The filter table is the boot-time skeleton: the full ruleset never loaded. Port forwards, VPN server chains and the DoS guard are not in force.
 RFW_294=Re-check now
 RFW_295=Rows marked Inconclusive sit behind a match the walker does not model (string, u32, time, policy): nothing is known to be wrong with them, they are simply not judged. Not applicable means the router has no such network yet. Nothing on this tab changes the firewall.
@@ -7049,3 +7049,47 @@ RFW_315=No witnesses were generated for this configuration.
 RFW_316=Firewall witnesses against the ruleset that is live now:
 RFW_317=unsuccessful
 RFW_318=open Rule Status
+RFW_319=Advisory
+RFW_320=Advisory only. This tab reports what the live tables do with each feature's witness packets. A row marked Unsuccessful is something to check, not a fault the router has confirmed - the witness address or a match the walker does not model can be the reason - and nothing here changes a rule.
+RSYS_00=System Information
+RSYS_01=Everything this router knows about itself. Grouped by the question being asked rather than by where the number comes from: what this box is, whether it is struggling, whether it is running out of anything, and how loaded it is. Nothing on this page changes a setting.
+RSYS_02=This router
+RSYS_03=Processor
+RSYS_04=Memory
+RSYS_05=Storage
+RSYS_06=Network capacity
+RSYS_07=Capabilities
+RSYS_08=Add-on board
+RSYS_09=Serial number
+RSYS_10=LAN MAC address
+RSYS_11=Build
+RSYS_12=Bootloader
+RSYS_13=Wireless driver
+RSYS_14=Cores
+RSYS_15=Clock
+RSYS_16=Load average
+RSYS_17=over 1, 5 and 15 minutes, against %1 cores
+RSYS_18=Per-core usage
+RSYS_19=Temperatures
+RSYS_20=Available
+RSYS_21=Buffers
+RSYS_22=Cache
+RSYS_23=Swap
+RSYS_24=No swap is configured
+RSYS_25=Available is the figure that matters, not Free. Buffers and cache are memory the router is USING but would hand back the moment something needed it, so a low Free number on a busy router is normal and not a warning. Available is what a new process could actually take.
+RSYS_26=Settings (NVRAM)
+RSYS_27=Scripts and add-ons (JFFS)
+RSYS_28=NVRAM holds every setting and is small and fixed; JFFS is the writable partition that scripts, add-ons and their data live on. Filling NVRAM is what stops settings saving.
+RSYS_29=active
+RSYS_30=of a maximum of %1
+RSYS_31=Hardware acceleration
+RSYS_32=Flow Cache
+RSYS_33=Wireless clients
+RSYS_34=Associated
+RSYS_35=Authorised
+RSYS_36=Authenticated
+RSYS_37=The feature flags this firmware was built with. They decide which pages and options exist at all, which is why a setting someone else has may simply be absent here.
+RSYS_38=Not available
+RSYS_39=Hardware
+RSYS_40=IP address
+RSYS_41=headroom
