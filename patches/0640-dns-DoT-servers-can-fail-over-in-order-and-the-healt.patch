+	{ "reaper_dnshc_target6", "", CKN_STR64, CKN_TYPE_DEFAULT, CKN_ACC_LEVEL_DEFAULT, CKN_ENC_DEFAULT, 0 },	/* v3.1.2: the SAME server's IPv6 address, so the check prefers v6 and falls back to the v4 above instead of idling */
 	{ "reaper_dnshc_name", "localhost", CKN_STR255, CKN_TYPE_DEFAULT, CKN_ACC_LEVEL_DEFAULT, CKN_ENC_DEFAULT, 0 },	/* name queried; any reply counts unless _strict */
 	{ "reaper_dnshc_interval", "10", CKN_STR3, CKN_TYPE_DEFAULT, CKN_ACC_LEVEL_DEFAULT, CKN_ENC_DEFAULT, 0 },	/* s, 3-300 */
 	{ "reaper_dnshc_timeout", "1000", CKN_STR4, CKN_TYPE_DEFAULT, CKN_ACC_LEVEL_DEFAULT, CKN_ENC_DEFAULT, 0 },	/* ms, 200-5000 */
