diff --git a/release/src/router/rc/rdnshc.c b/release/src/router/rc/rdnshc.c
index b6b9fa7c00..dd0d988047 100644
--- a/release/src/router/rc/rdnshc.c
+++ b/release/src/router/rc/rdnshc.c
@@ -66,7 +66,9 @@ struct hc_cfg {
 	int enable;
 	char target[INET6_ADDRSTRLEN];	/* canonical spelling (inet_ntop) of what the admin typed */
 	int af;			/* AF_INET / AF_INET6; 0 = no valid target */
-	int v6_off;		/* an IPv6 target while IPv6 is disabled on the router: idle */
+	char alt[INET6_ADDRSTRLEN];	/* v3.1.2: the same server's other address */
+	int alt_af;		/* AF_INET6 for reaper_dnshc_target6; 0 = none */
+	int v6_off;		/* IPv6 is the ONLY address we have and it cannot be used: idle */
 	char name[128];
 	int interval;		/* s */
 	int timeout_ms;
@@ -90,6 +92,23 @@ static int clamp(int v, int lo, int hi, int dflt)
 	return v < lo ? lo : (v > hi ? hi : v);
 }
 
+/* Can an IPv6 probe possibly work right now? Two local nvram reads, no socket
+ * and no wait, so a router with IPv6 switched off or with nothing delegated by
+ * the ISP never spends a millisecond probing over v6. ipv6_rtr_addr is the
+ * right second test: multi_wan_ipv6.c CLEARS it when the WAN loses IPv6, so
+ * empty means "we have no address", not merely "the service is on".
+ * connect() is the backstop for the gap between these reads and reality - on a
+ * UDP socket it is a routing-table lookup, so a route that vanished a moment
+ * ago fails instantly instead of costing the timeout. */
+static int hc_v6_usable(void)
+{
+#ifdef RTCONFIG_IPV6
+	return ipv6_enabled() && *nvram_safe_get("ipv6_rtr_addr");
+#else
+	return 0;
+#endif
+}
+
 static void cfg_read(struct hc_cfg *c)
 {
 	const char *p;
@@ -111,12 +130,20 @@ static void cfg_read(struct hc_cfg *c)
 	} else if (*p && inet_pton(AF_INET6, p, &a6) == 1) {
 		c->af = AF_INET6;
 		inet_ntop(AF_INET6, &a6, c->target, sizeof(c->target));
-#ifdef RTCONFIG_IPV6
-		c->v6_off = ipv6_enabled() ? 0 : 1;
-#else
-		c->v6_off = 1;
-#endif
 	}
+	/* v3.1.2: the same server's IPv6 address, so the check can prefer v6 and
+	 * fall back to v4 instead of idling. Ignored unless it parses as IPv6 and
+	 * the main field is not already an IPv6 address. */
+	p = nvram_safe_get("reaper_dnshc_target6");
+	if (*p && c->af != AF_INET6 && inet_pton(AF_INET6, p, &a6) == 1) {
+		c->alt_af = AF_INET6;
+		inet_ntop(AF_INET6, &a6, c->alt, sizeof(c->alt));
+	}
+	/* Idle only when there is nothing we could probe at all: the one address we
+	 * have is IPv6 and IPv6 cannot carry it. With an IPv4 address as well there
+	 * is always something to watch, so the check runs. */
+	if (c->af == AF_INET6 && !c->alt_af && !hc_v6_usable())
+		c->v6_off = 1;
 	p = nvram_safe_get("reaper_dnshc_name");
 	strlcpy(c->name, (*p ? p : "localhost"), sizeof(c->name));
 	for (i = 0; c->name[i]; i++) {
@@ -136,7 +163,7 @@ static void cfg_read(struct hc_cfg *c)
 /* One UDP query for <name> A IN, sent straight to target:53 (never through
  * dnsmasq). 1 = a reply with our id came back (strict: NOERROR + >=1 record),
  * 0 = silence, an error, or a reply that does not qualify. */
-static int probe(const struct hc_cfg *c)
+static int probe_addr(const struct hc_cfg *c, const char *addr, int af)
 {
 	unsigned char pkt[512];
 	unsigned char *q;
@@ -170,21 +197,21 @@ static int probe(const struct hc_cfg *c)
 	len = (int)(q - pkt);
 
 	memset(&ss, 0, sizeof(ss));
-	if (c->af == AF_INET6) {
+	if (af == AF_INET6) {
 		struct sockaddr_in6 *s6 = (struct sockaddr_in6 *)&ss;
 		s6->sin6_family = AF_INET6;
 		s6->sin6_port = htons(53);
-		if (inet_pton(AF_INET6, c->target, &s6->sin6_addr) != 1) return 0;
+		if (inet_pton(AF_INET6, addr, &s6->sin6_addr) != 1) return 0;
 		slen = sizeof(*s6);
 	} else {
 		struct sockaddr_in *s4 = (struct sockaddr_in *)&ss;
 		s4->sin_family = AF_INET;
 		s4->sin_port = htons(53);
-		if (inet_pton(AF_INET, c->target, &s4->sin_addr) != 1) return 0;
+		if (inet_pton(AF_INET, addr, &s4->sin_addr) != 1) return 0;
 		slen = sizeof(*s4);
 	}
 
-	if ((fd = socket(c->af == AF_INET6 ? AF_INET6 : AF_INET, SOCK_DGRAM, 0)) < 0) return 0;
+	if ((fd = socket(af == AF_INET6 ? AF_INET6 : AF_INET, SOCK_DGRAM, 0)) < 0) return 0;
 	if (connect(fd, (struct sockaddr *)&ss, slen) < 0 || send(fd, pkt, len, 0) != len) {
 		close(fd);
 		return 0;
@@ -216,11 +243,18 @@ static int probe(const struct hc_cfg *c)
  * that is "server=<ip>" or "server=<ip>#port" (a "server=/domain/<ip>" line
  * is a domain route and is left where it is); for resolv.conf it is
  * "nameserver <ip>". */
+static int addr_matches(const char *addr, const char *want, int af)
+{
+	unsigned char bin[16], tbin[16];
+	if (!want || !*want) return 0;
+	if (inet_pton(af, addr, bin) != 1 || inet_pton(af, want, tbin) != 1) return 0;
+	return memcmp(bin, tbin, af == AF_INET6 ? 16 : 4) == 0;
+}
+
 static int line_is_target(const char *line, const char *prefix, const struct hc_cfg *c)
 {
 	size_t pl = strlen(prefix), al;
 	char addr[INET6_ADDRSTRLEN + 8];
-	unsigned char bin[16], tbin[16];
 	const char *p;
 	if (strncmp(line, prefix, pl) != 0) return 0;
 	p = line + pl;
@@ -232,8 +266,13 @@ static int line_is_target(const char *line, const char *prefix, const struct hc_
 	if (al == 0 || al >= sizeof(addr)) return 0;
 	memcpy(addr, p, al);
 	addr[al] = 0;
-	if (inet_pton(c->af, addr, bin) != 1 || inet_pton(c->af, c->target, tbin) != 1) return 0;
-	return memcmp(bin, tbin, c->af == AF_INET6 ? 16 : 4) == 0;
+	/* v3.1.2: one server, up to two addresses. A line naming EITHER of them is
+	 * this server's line, so a failover moves both and dnsmasq is not left
+	 * hammering the surviving one while the server is down. inet_pton against
+	 * the wrong family simply fails, which is the family filter. */
+	if (c->af && addr_matches(addr, c->target, c->af)) return 1;
+	if (c->alt_af && addr_matches(addr, c->alt, c->alt_af)) return 1;
+	return 0;
 }
 
 /* A plain upstream of the same kind (used to decide whether the target is
@@ -324,6 +363,7 @@ int rdnshc_main(int argc, char *argv[])
 	struct hc_cfg c;
 	char watched[INET6_ADDRSTRLEN] = "";
 	int down = 0, misses = 0, hits = 0, last_enabled = -1, i, alive = -1, v6_warned = 0;
+	int last_fam = 0, v6skip_warned = 0;
 	long since = 0;
 	(void)argc; (void)argv;
 
@@ -355,7 +395,7 @@ int rdnshc_main(int argc, char *argv[])
 		enabled = c.enable && *c.target && !c.v6_off;
 		if (c.enable && *c.target && c.v6_off) {
 			if (!v6_warned)
-				logmessage(HC_TAG, "DNS Health Check: %s is an IPv6 address but IPv6 is disabled on the router - the check stays idle until IPv6 is enabled or an IPv4 server is named", c.target);
+				logmessage(HC_TAG, "DNS Health Check: %s is an IPv6 address, and the router has no usable IPv6 (disabled, or no address from the ISP) - the check stays idle until IPv6 comes back, or until the server's IPv4 address is filled in as well", c.target);
 			v6_warned = 1;
 		} else
 			v6_warned = 0;
@@ -384,10 +424,37 @@ int rdnshc_main(int argc, char *argv[])
 		}
 		strlcpy(watched, c.target, sizeof(watched));
 
-		alive = probe(&c);
+		/* IPv6 first, then IPv4 - but only over a family that can actually
+		 * carry a query. hc_v6_usable() is two local nvram reads, so a router
+		 * with IPv6 off or nothing delegated skips v6 without a socket and
+		 * without a wait; it never costs the timeout. A miss is counted only
+		 * when EVERY family we could try failed: a broken v6 path must not
+		 * fail over a server that is answering perfectly well on v4. */
+		{
+			const char *a6 = (c.af == AF_INET6) ? c.target : (c.alt_af == AF_INET6 ? c.alt : NULL);
+			const char *a4 = (c.af == AF_INET) ? c.target : NULL;
+			int fam = 0, v6_ready = a6 && hc_v6_usable();
+
+			if (a6 && !v6_ready && a4 && !v6skip_warned) {
+				logmessage(HC_TAG, "DNS Health Check: skipping the IPv6 address %s - the router has no usable IPv6 right now (disabled, or no address from the ISP); watching %s over IPv4 instead", a6, a4);
+				v6skip_warned = 1;
+			} else if (v6_ready)
+				v6skip_warned = 0;
+
+			alive = 0;
+			if (v6_ready && probe_addr(&c, a6, AF_INET6)) { alive = 1; fam = 6; }
+			if (!alive && a4 && probe_addr(&c, a4, AF_INET)) { alive = 1; fam = 4; }
+
+			if (alive && fam != last_fam) {
+				if (last_fam && a6 && a4)
+					logmessage(HC_TAG, "DNS Health Check: %s is answering over IPv%d now", c.target, fam);
+				last_fam = fam;
+			} else if (!alive)
+				last_fam = 0;
+		}
 		if (alive) { hits++; misses = 0; } else { misses++; hits = 0; }
 		if (!alive && !down)
-			logmessage(HC_TAG, "DNS Health Check: %s did not answer within %d ms (miss %d of %d)", c.target, c.timeout_ms, misses, c.fail);
+			logmessage(HC_TAG, "DNS Health Check: %s did not answer within %d ms on any configured address (miss %d of %d)", c.target, c.timeout_ms, misses, c.fail);
 
 		if (!down && misses >= c.fail) {
 			int changed = 0, nup;
diff --git a/release/src/router/rc/sdn.c b/release/src/router/rc/sdn.c
index 1ae1bea439..d52598bc64 100644
--- a/release/src/router/rc/sdn.c
+++ b/release/src/router/rc/sdn.c
@@ -425,13 +425,22 @@ void _start_sdn_stubby(const MTLAN_T *pmtl, char *config_file, const size_t path
 	}
 #endif
 
-	/* Connection settings */
+	/* Connection settings.
+	 * reaper v3.1.2: stubby ships round_robin_upstreams: 1, which rotates
+	 * every configured DoT server per query - so a list of them SHARES the
+	 * traffic rather than holding one in reserve, and there is no failover
+	 * order at all. reaper_dot_strict writes 0 instead, which makes the list
+	 * an ordered primary and standby: the first server is used until it stops
+	 * answering. Default 0 keeps stock behaviour. Note DoT REPLACES the WAN
+	 * DNS list (wan.c: dnspriv_enable breaks out), so a LAN filter is out of
+	 * the path either way unless it is itself one of these servers. */
 	fprintf(fp,
-		"round_robin_upstreams: 1\n"
+		"round_robin_upstreams: %d\n"
 		"idle_timeout: 9000\n"
 		"tls_connection_retries: 2\n"
 		"tls_backoff_time: 900\n"
-		"timeout: 3000\n");
+		"timeout: 3000\n",
+		nvram_get_int("reaper_dot_strict") ? 0 : 1);
 
 	/* Limit number of outstanding requests */
 	max_queries = nvram_get_int("max_dns_queries");
