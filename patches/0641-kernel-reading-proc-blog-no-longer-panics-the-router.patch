+    {
+        return -EFAULT;
+    }
+    proc_data[cnt] = '\0';
     pdata = proc_data;
 
     while ( (token = strsep(&pdata, " ")) != NULL )
@@ -398,23 +408,31 @@ skip_wg_port_proc_write(struct file *file, const char __user *buf, size_t cnt,
     return cnt;
 }
 
