+    var h=`<table class="logtbl"><thead><tr><th><#RFW_37#></th><th><#RFW_36#></th><th><#wan_interface#></th><th><#RFW_39#></th><th><#RFW_40#></th><th><#RFW_54#></th><th><#RFW_41#></th></tr></thead><tbody>`;
