 /* =================== LOGGING view =================== */
 function classOf(line){
+  /* Warden emits three distinct prefixes - REAPER-WARDEN (inbound source
+     drops), REAPER-WARDEN-OUT (the destination side, direction=out/both) and
+     REAPER-WARDEN-SELF (traffic the router itself originated). They were
+     given separate prefixes in v2.4.4 precisely so an operator could tell an
+     outbound block from an inbound one; matching only the common stem here
+     collapsed all three back into one badge, which is the same question the
+     prefixes were added to answer. Longest prefix first - the other two are
+     substrings of it. */
+  if(line.indexOf('REAPER-WARDEN-OUT')>=0)return {c:'warden',t:'WARDEN-OUT'};
+  if(line.indexOf('REAPER-WARDEN-SELF')>=0)return {c:'warden',t:'WARDEN-SELF'};
   if(line.indexOf('REAPER-WARDEN')>=0)return {c:'warden',t:'WARDEN'};
   if(/ ACCEPT IN=/.test(line))return {c:'accept',t:`<#RFW_138#>`};
   return {c:'drop',t:`<#RFW_139#>`};
@@ -1310,7 +1320,7 @@ function loadDrops(){
