 		*wg = 1;
 		return 1;
 	}
@@ -775,6 +788,32 @@ void reaper_pbr_reassert(void)
 	file_unlock(lock);
 }
 
+/* Regenerate and re-run the COMMITTED ruleset from the current config. The
+ * `vpnrouting` restart that a VPN client's Killswitch save fires (services.c)
+ * lands here, because since v3.1.3 the per-target `prohibit` follows that
+ * switch (P3) and reaper_pbr_reassert() only re-executes the script that was
+ * generated last. Unlike start_reaper_pbr() this never touches the draft, the
+ * arm state or nvram. While a commit-confirm candidate is armed it steps
+ * aside and says so: the candidate is about to be kept or reverted, and the
+ * next apply reads the switch. */
+void reaper_pbr_regen(void)
+{
+	ppbr_cfg_t c;
+
+	if (!is_routing_enabled() || !nvram_match("reaper_pbr_enable", "1")) return;
+	if (nvram_match("reaper_pbr_armed", "1")) {
+		logmessage("reaper_pbr", "a VPN client's Killswitch changed while a routing change is awaiting confirmation - the rules follow it on the next apply");
+		return;
+	}
+	if (!ppbr_cfg_load(&c, ppbr_lastgood_ok())) return;
+	if (c.enable) {
+		reaper_fw_sets_only();                 /* the sets the chain matches (see start_reaper_pbr) */
+		if (ppbr_gen(PPBR_APPLY, 0, &c))
+			ppbr_run(PPBR_APPLY, 1);
+	}
+	ppbr_cfg_free(&c);
+}
+
 void start_reaper_pbr(void)
 {
 	ppbr_cfg_t c;
@@ -811,7 +850,14 @@ void start_reaper_pbr(void)
 		from_good = ppbr_lastgood_ok();
 	} else if (nvram_safe_get("reaper_pbr_rulelist")[0]) {
 		/* migrated box with a leftover nvram value (settings restore): the
-		 * file is authoritative, drop the shadow */
+		 * file is authoritative, drop the shadow.
+		 * SAY SO (v3.1.3c). This discards something an operator - or a
+		 * settings restore - deliberately put there, and it used to do it
+		 * without a word: a list staged in nvram on a box that already had a
+		 * snapshot simply vanished, no rules and no log, while the caller
+		 * still saw "Done." Only fires when there was actually something to
+		 * drop, so a normal boot stays quiet. */
+		logmessage("reaper_pbr", "a rule list was left in nvram - ignoring it, " REAPER_PBR_RL " is authoritative; edit the rules on the Policy Routing page");
 		nvram_unset("reaper_pbr_rulelist");
 		nvram_commit();
 	}
@@ -820,9 +866,18 @@ void start_reaper_pbr(void)
 		logmessage("reaper_pbr", "boot: the %s config could not be read - policy routing NOT started", from_good ? "confirmed" : "nvram");
 		return;
 	}
-	if (from_good)
-		/* what is live must be what the page shows (RAM only) */
-		nvram_set("reaper_pbr_enable", c.enable ? "1" : "0");
+	if (from_good) {
+		/* what is live must be what the page shows (RAM only).
+		 * SAY SO when it actually differs (v3.1.3c): this silently overwrote
+		 * an operator's enable=1 with the snapshot's 0, which - together with
+		 * the dropped nvram list above - is how a hand-staged configuration
+		 * disappeared with no record. Logs only on a real divergence. */
+		const char *want = c.enable ? "1" : "0";
+		if (!nvram_match("reaper_pbr_enable", want))
+			logmessage("reaper_pbr", "nvram said policy routing was %s but the confirmed snapshot says %s - following the snapshot",
+			           nvram_match("reaper_pbr_enable", "1") ? "ON" : "OFF", c.enable ? "ON" : "OFF");
+		nvram_set("reaper_pbr_enable", want);
+	}
 
 	if (!c.enable) {
 		ppbr_cfg_free(&c);
