diff --git a/release/src/router/rc/services.c b/release/src/router/rc/services.c
index 63874104b4..32cab365e2 100644
--- a/release/src/router/rc/services.c
+++ b/release/src/router/rc/services.c
@@ -1848,19 +1848,20 @@ void start_dnsmasq(void)
 	 * above): with every client sent through dnsmasq to a LAN filter such as
 	 * AdGuard or Pi-hole, a router-side cache would answer client B from a
 	 * decision made for client A and hide every cached hit from the filter's
-	 * statistics. The filter keeps its own cache. And "Pass client addresses
-	 * to the DNS server": EDNS Client Subnet carries the full client address.
+	 * statistics. The filter keeps its own cache.
 	 *
-	 * Pi-hole FTL READS it (EDNS0_ECS, on by default) and keeps filtering per
-	 * client. AdGuard Home does NOT: it resolves a client ClientID -> source
-	 * IP -> CIDR -> MAC and only LOGS the ECS value, never matches on it. So
-	 * while dnsmasq proxies, every per-client rule on an AdGuard target is
-	 * inert however this switch is set - ECS cannot recover an identity the
-	 * proxy already erased. Asked for upstream twice and declined:
-	 * AdGuardHome issues #4383 and #6104. The help text said otherwise until
-	 * 2026-09-08; do not restate the filters half. */
-	if (nvram_get_int("reaper_dns_ecs"))
-		fprintf(fp, "add-subnet=32,128\n");
+	 * The companion "Pass client addresses to the DNS server" switch
+	 * (reaper_dns_ecs -> add-subnet=32,128) was REMOVED - page, emitter, nvram
+	 * default and dict tokens. EDNS Client Subnet carried the FULL client
+	 * address, and nothing it bought covered that. AdGuard Home only LOGS the
+	 * value and never matches rules on it (asked upstream twice and declined:
+	 * AdGuardHome #4383 and #6104), so per-client rules on an AdGuard target
+	 * stayed inert however the switch was set; and dnsmasq attaches the option
+	 * at RECEIVE time, before upstream selection, so a failover to a public
+	 * resolver carried the client's address out of the network with nothing in
+	 * the path able to strip it. Reintroducing this would need a per-upstream
+	 * strip at dnsmasq's server_send(); do not add the switch back without one.
+	 */
 	/* reaper v3.1.1: ask the upstreams in the listed order and move on only
 	 * when one does not answer, instead of dnsmasq's default of probing all
 	 * of them every 50 queries / 20 s and sticking with the fastest - which
