diff --git a/release/src/router/rc/reaper_pbr.c b/release/src/router/rc/reaper_pbr.c
index b8b7f95a3f..a1cc4344b9 100644
--- a/release/src/router/rc/reaper_pbr.c
+++ b/release/src/router/rc/reaper_pbr.c
@@ -52,6 +52,12 @@
  *     unaffected; BLOCK is still realised solely as `prohibit`. The switch is
  *     read at generation time, so the `vpnrouting` restart that the VPN
  *     client page fires on a Killswitch save calls reaper_pbr_regen().
+ *     v3.1.5 (reviewer): the switch counts only while that client is ENABLED,
+ *     exactly the condition VPN Director puts on its own prohibit
+ *     (amvpn_routing.c: `killswitch == 0 || !enabled -> return`). A client
+ *     that is switched off installs no prohibit, so its rules fall through to
+ *     `main` (WAN) - the page's Status column says "Inactive - WAN" for it.
+ *     The enable toggle fires the same `vpnrouting` restart, so no new hook.
  * P4. SERIALIZE WITH THE BASE. Apply/teardown take file_lock("firewall") like
  *     reaper_fw / GK / Warden, so we never interleave with a start_firewall()
  *     rebuild.
@@ -112,6 +118,7 @@
 #include "rc.h"
 #include <shared.h>
 #include "reaper_nv.h"	/* _nv: nvram get with a 5 s ceiling (security review 2026-08-22 F2) */
+#include <openvpn_control.h>	/* ovpn_is_client_enabled(): the Killswitch counts only for an enabled client (P3, v3.1.5) */
 
 #define PPBR_DIR        "/tmp/reaper_pbr"
 #define PPBR_APPLY      PPBR_DIR "/apply.sh"       /* the committed ruleset */
@@ -162,7 +169,7 @@ static int ppbr_target(const char *t, int *code, const char **table, int *failcl
 		*table = ov[t[4] - '1'];
 		/* P3: the client's Killswitch, the same key VPN Director reads */
 		snprintf(nv, sizeof(nv), "vpn_client%c_enforce", t[4]);
-		*failclosed = nvram_get_int(nv) ? 1 : 0;
+		*failclosed = (nvram_get_int(nv) && ovpn_is_client_enabled(t[4] - '0')) ? 1 : 0;
 		return 1;
 	}
 	if (!strncmp(t, "WGC", 3) && t[3] >= '1' && t[3] <= '5' && t[4] == '\0') {
@@ -171,6 +178,8 @@ static int ppbr_target(const char *t, int *code, const char **table, int *failcl
 		*table = wgt[t[3] - '1'];
 		snprintf(nv, sizeof(nv), "wgc%c_enforce", t[3]);
 		*failclosed = nvram_get_int(nv) ? 1 : 0;   /* P3 */
+		snprintf(nv, sizeof(nv), "wgc%c_enable", t[3]);
+		if (!nvram_get_int(nv)) *failclosed = 0;   /* P3 v3.1.5: only an enabled client's Killswitch counts */
 		*wg = 1;
 		return 1;
 	}
