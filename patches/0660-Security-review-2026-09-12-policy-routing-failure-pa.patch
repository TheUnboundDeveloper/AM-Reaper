+sec "14f. PORT FORWARDING (stock virtual server - ports and LAN targets only, WAN address never printed)"
+# v1.3.15 (review R15, 2026-09-12): a field report of "no DNAT entry exists at
+# all" rested on `iptables -t nat -L PREROUTING | grep <port>` - which cannot
+# see the DNAT lines: they live in the VSERVER chain that PREROUTING jumps to
+# BY WAN ADDRESS (`-A PREROUTING -d <wan_ip> -j VSERVER`, rc/firewall.c
+# nat_setting). Print the truth in one place: the switches, whether the hook
+# exists (it needs a WAN address at firewall-build time), the chain, and every
+# saved rule checked against the live table by port. Ports and RFC1918 targets
+# are the payload; a source restriction that is public goes through the
+# sanitizer like everything else.
+_vts="$(nvram get vts_enable_x 2>/dev/null)"; _rl="$(nvram get vts_rulelist 2>/dev/null)"
+_nrules=$(printf '%s' "$_rl" | tr -cd '<' | wc -c)
+echo "  vts_enable_x=$_vts  wan0_nat_x=$(nvram get wan0_nat_x 2>/dev/null)  sw_mode=$(nvram get sw_mode 2>/dev/null)  saved rules=$_nrules  wan0_ipaddr=$( [ -n "$(nvram get wan0_ipaddr 2>/dev/null)" ] && echo SET || echo EMPTY )  wan0_state_t=$(nvram get wan0_state_t 2>/dev/null)"
+_hook=$(iptables -t nat -S PREROUTING 2>/dev/null | grep -c -- '-j VSERVER$')
+echo "  nat PREROUTING -> VSERVER hooks : $_hook  (-> GAME_VSERVER: $(iptables -t nat -S PREROUTING 2>/dev/null | grep -c -- '-j GAME_VSERVER$'); VSERVER -> VUPNP: $(iptables -t nat -S VSERVER 2>/dev/null | grep -c -- '-j VUPNP$'))"
+_dnat=$(iptables -t nat -S VSERVER 2>/dev/null | grep -c -- '-j DNAT')
+echo "  nat VSERVER DNAT lines          : $_dnat   (VUPNP: $(iptables -t nat -S VUPNP 2>/dev/null | grep -c -- '-j DNAT'))"
+echo "  FORWARD ctstate DNAT accept     : $(iptables -S FORWARD 2>/dev/null | grep -c -- '--ctstate DNAT -j ACCEPT')"
+_pfm=0; _pfn=0
+if [ -n "$_rl" ]; then
+  printf '%s' "$_rl" | tr '<' '\n' > "$RAW.pf"
+  while IFS='>' read -r _d _port _dst _lport _proto _src; do
+    [ -n "$_port" ] || continue
+    _pfn=$((_pfn+1))
+    _live=0
+    for _p in $(printf '%s' "$_port" | tr ',' ' '); do
+      _live=$(( _live + $(iptables -t nat -S VSERVER 2>/dev/null | grep -- "--dport $_p " | grep -c -- "$_dst") ))
+    done
+    [ "$_live" = 0 ] && _pfm=$((_pfm+1))
+    echo "  rule $_pfn: $_proto $_port -> $_dst${_lport:+:$_lport}${_src:+ from $_src}  live DNAT=$_live"
+  done < "$RAW.pf"
+  rm -f "$RAW.pf"
+fi
+[ "$_vts" = 1 ] && [ "$_nrules" -gt 0 ] && [ "$_hook" = 0 ] && finding WARN "port forwarding is ON but nat/PREROUTING has no jump to VSERVER - the WAN address was unknown when the firewall was built, or something rebuilt the nat table without it; forwards cannot work until the hook exists (see 14f)"
+[ "$_vts" = 1 ] && [ "$_pfm" -gt 0 ] && finding WARN "port forwarding: $_pfm of $_pfn saved rule(s) have NO DNAT line in VSERVER - the rule was dropped at emission (charset gate) or the chain was flushed (see 14f)"
+[ "$_vts" = 1 ] && [ "$_nrules" -gt 0 ] && [ "$_hook" -gt 0 ] && [ "$_pfm" = 0 ] && [ "$(iptables -S FORWARD 2>/dev/null | grep -c -- '--ctstate DNAT -j ACCEPT')" = 0 ] && finding WARN "port forwarding: DNAT lines are live but FORWARD has no ctstate-DNAT accept - forwarded flows are translated and then dropped (see 14f)"
