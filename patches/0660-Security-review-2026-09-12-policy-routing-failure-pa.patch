+/* v3.1.5 (review R15, found by build-scripts/check_vts_emitter.py on its first run):
+ * _fw_field_safe() blocks INJECTION - after _fw_strip_spaces() no byte can start a
+ * new argument - but not a MALFORMED port. "80 -j ACCEPT" space-strips to
+ * "80-jACCEPT", every byte of which the charset allows, and it is emitted as
+ * `--dport 80-jACCEPT`. iptables-restore then rejects the line - and with it
+ * the WHOLE *nat table (one file, one COMMIT, atomic): no VSERVER, no VUPNP,
+ * and no MASQUERADE either, so one bad nvram value is an internet outage, not
+ * a dead forward. A port field must therefore be what the emitter can use: for
+ * TCP/UDP/BOTH one or more comma-separated N or N:M (the GUI already rewrites
+ * "-" and "~" to ":"), 1-65535, low <= high; for OTHER the raw protocol name or
+ * number the `-p %s` line takes (the emitter drops anything after ':'). A rule
+ * that fails is dropped and named in syslog, and the rest of the table loads. */
+static int __attribute__((unused)) _fw_ports_ok(const char *ports, const char *proto)
+{
+	char buf[256], *p = buf, *tok;
+	if (!ports || !*ports || strlen(ports) >= sizeof(buf)) return 0;
+	snprintf(buf, sizeof(buf), "%s", ports);
+	while ((tok = strsep(&p, ",")) != NULL) {
+		const char *q;
+		if (!*tok) return 0;
+		if (proto && strcmp(proto, "OTHER") == 0) {
+			for (q = tok; *q && *q != ':'; q++)
+				if (!((*q >= '0' && *q <= '9') || ((*q | 0x20) >= 'a' && (*q | 0x20) <= 'z') || *q == '-'))
+					return 0;
+			if (q == tok) return 0;
+			continue;
+		}
+		{
+			char *e, *e2;
+			long a = strtol(tok, &e, 10), b;
+			if (e == tok || a < 1 || a > 65535) return 0;
+			if (*e == ':') {
+				b = strtol(e + 1, &e2, 10);
+				if (e2 == e + 1 || *e2 || b < a || b > 65535) return 0;
+			} else if (*e)
+				return 0;
+		}
+	}
+	return 1;
+}
