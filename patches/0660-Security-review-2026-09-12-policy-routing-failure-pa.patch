+/* v3.1.5 (review R06): what an ipset/domain selector NAMES. The object layer
+ * creates rwfw_<name>/rwfw6_<name> for host/cidr/range/fqdn objects ONLY: a
+ * geo object references Warden's country set (reaper_fw S5) and a MAC object
+ * is a source-side thing, so a rule naming either matched nothing - the
+ * `ipset list -n` guard skipped the mark rule silently, the code's ip rule
+ * still went in and the page said Active. A group has no set of its own
+ * either. So: an object is checked for a routable type, a group is expanded
+ * into its routable members (one mark rule each), and anything else drops the
+ * rule with a syslog line that says why. Object records are
+ * <name>type>value>comment, group records <name>member,member>comment. */
+static int ppbr_obj_routable(const char *type)
+{
+	return !strcmp(type, "host") || !strcmp(type, "cidr") ||
+	       !strcmp(type, "range") || !strcmp(type, "fqdn");
+}
+
+static int ppbr_obj_type(const char *name, char *type, size_t tl)
+{
+	char *copy = strdup(reaper_fw_list_get("obj")), *p, *rec;
+	int found = 0;
+	if (!copy) return 0;
+	p = copy;
+	while ((rec = strsep(&p, "<")) != NULL) {
+		char *n = strsep(&rec, ">"), *t = strsep(&rec, ">");
+		if (n && t && !strcmp(n, name)) { snprintf(type, tl, "%s", t); found = 1; break; }
+	}
+	free(copy);
+	return found;
+}
+
+/* Returns the number of object names written to `out` (comma-separated), or
+ * -1 with `out` holding the reason the rule cannot be honoured. */
+static int ppbr_resolve_object(const char *name, char *out, size_t ol)
+{
+	char type[16], *grp, *p, *rec, *members = NULL, *tok, *save = NULL;
+	size_t len = 0;
+	int n = 0;
+
+	if (ppbr_obj_type(name, type, sizeof(type))) {
+		if (ppbr_obj_routable(type)) { snprintf(out, ol, "%s", name); return 1; }
+		if (!strcmp(type, "geo"))
+			snprintf(out, ol, "object %s is a country (geo) object - Warden owns the country sets and Policy Routing cannot select on them; use a firewall rule", name);
+		else
+			snprintf(out, ol, "object %s is a %s object, which has no destination set to select on", name, type);
+		return -1;
+	}
+	grp = strdup(reaper_fw_list_get("grp"));
+	if (!grp) { snprintf(out, ol, "object list unreadable"); return -1; }
+	p = grp;
+	while ((rec = strsep(&p, "<")) != NULL) {
+		char *gn = strsep(&rec, ">"), *gm = strsep(&rec, ">");
+		if (gn && gm && !strcmp(gn, name)) { members = gm; break; }
+	}
+	if (!members) { free(grp); snprintf(out, ol, "object %s does not exist", name); return -1; }
+	out[0] = 0;
+	for (tok = strtok_r(members, ",", &save); tok; tok = strtok_r(NULL, ",", &save)) {
+		if (!ppbr_obj_type(tok, type, sizeof(type)) || !ppbr_obj_routable(type)) {
+			logmessage("reaper_pbr", "group %s: member %s skipped (not a host/cidr/range/fqdn object)", name, tok);
+			continue;
+		}
+		if (len + strlen(tok) + 2 > ol) break;
+		len += snprintf(out + len, ol - len, "%s%s", n ? "," : "", tok);
+		n++;
+	}
+	free(grp);
+	if (!n) snprintf(out, ol, "group %s has no member Policy Routing can select on", name);
+	return n ? n : -1;
+}
