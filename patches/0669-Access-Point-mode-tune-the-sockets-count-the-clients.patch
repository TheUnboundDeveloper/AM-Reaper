         var v6=(c.ip6_prefix&&String(c.ip6_prefix).length)?c.ip6_prefix:(c.ip6||'');   /* global v6, else link-local */
         b[k].push({n:nm, ip:(c.ip&&c.ip!=='offline')?c.ip:'\u2014', ip6:String(v6).split('/')[0], m:macs[i]});
       }
