-		fclose(fp);
-	}
+	/* the socket-buffer ceilings, unchanged and in the same place - see
+	 * reaper_socket_ceilings() above, which the non-routing return path at
+	 * the top of this function also calls. */
+	reaper_socket_ceilings();
 
