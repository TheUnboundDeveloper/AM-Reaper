 PATH=/sbin:/bin:/usr/sbin:/usr/bin
-VER="REAPER-DIAG v1.3.16"
+VER="REAPER-DIAG v1.3.17"
 T0="$(date +%s 2>/dev/null)"
 MODEL="$(nvram get productid 2>/dev/null)"
 EXTNO="$(nvram get extendno 2>/dev/null)"
@@ -695,8 +695,22 @@ done | sort -rn | head -5 | awk '{printf "  %6ss  %-20s pid=%s\n", $1, $2, $3}'
 echo "  -- memory --"; grep -E '^(MemFree|MemAvailable|Slab|Committed_AS|SwapTotal|SwapFree)' /proc/meminfo 2>/dev/null | sed 's/^/  /'
 
 sec "12c. REAPER SERVICES vs. THEIR SWITCHES"
+# v1.3.17: every daemon svc() covers is started behind !is_routing_enabled()
+# (start_rtraf, start_gk, start_rchqd), and rtrafd in particular accounts off
+# conntrack, which a bridging box never populates. In Access Point (sw_mode=3)
+# or repeater/media-bridge (2) mode, running=0 with the knob on is the DESIGNED
+# state, not a dead service - the GT-BE19000 tester's capture (sw_mode=3) raised
+# exactly that false WARN for rtrafd on 2026-09-13. Same correction as the rmcpd
+# line below. Only the two known non-routing modes flip this: an unreadable
+# sw_mode keeps the old, louder behaviour rather than silencing a real fault.
+_ROUTING=1
+case "$(nvram get sw_mode 2>/dev/null)" in 2|3) _ROUTING=0;; esac
 svc() { # name knob expected-running-when
   _on="$(nvram get $2 2>/dev/null)"; _run="$(pidof $1 2>/dev/null | wc -w)"
+  if [ "$_ROUTING" = 0 ]; then
+    printf "  %-8s %-22s running=%s  (routing-only: idle=0 is normal in this mode)\n" "$1" "$2=${_on:-unset}" "$_run"
+    return
+  fi
   printf "  %-8s %-22s running=%s\n" "$1" "$2=${_on:-unset}" "$_run"
   if [ "$_on" = "$3" ] && [ "$_run" = 0 ]; then finding WARN "$1 is enabled ($2=$3) but not running"; fi
 }
diff --git a/release/src/router/rc/firewall.c b/release/src/router/rc/firewall.c
index 8fd3912a90..52019e3303 100644
--- a/release/src/router/rc/firewall.c
+++ b/release/src/router/rc/firewall.c
@@ -9207,6 +9207,42 @@ void add_mtppp_rules(char *logaccept, char *logdrop)
 }
 #endif
 
+/* reaper: raise the EXPLICIT socket-buffer ceilings. net.core.*mem_max
+ * caps any socket that calls setsockopt(SO_RCVBUF/SO_SNDBUF) - which is
+ * what throughput tools (and the Ookla engine) do. The stock 212992 caps a
+ * single stream at roughly 85 Mbit/s over a 20 ms path, which is a hard
+ * ceiling no other tuning can lift. These are ceilings, not allocations.
+ *
+ * tcp_rmem/tcp_wmem are deliberately NOT set: the kernel autotunes them up
+ * to ~6 MB already, and ASUS's block in start_firewall() (commented out,
+ * kept for reference) pins their max to 262144 - BELOW the default.
+ * Uncommenting that block verbatim would slow a multi-gigabit WAN down.
+ *
+ * v3.1.6: lifted out of start_firewall()'s body so the non-routing path can
+ * reach it. These are not firewall state, and start_firewall() returns at
+ * !is_routing_enabled() long before the block was reached - so an Access
+ * Point, repeater or media-bridge box kept the stock ceiling no matter how
+ * often the firewall was restarted. Measured on a GT-BE19000 in AP mode:
+ * rmem_max 524288 and netdev_max_backlog 1000 after three restart_firewall
+ * calls. The code is shared, so every model in a non-routing mode had it. */
+static void reaper_socket_ceilings(void)
+{
+	FILE *fp;
+
+	if ((fp = fopen("/proc/sys/net/core/rmem_max", "w+"))) {
+		fputs("16777216", fp);
+		fclose(fp);
+	}
+	if ((fp = fopen("/proc/sys/net/core/wmem_max", "w+"))) {
+		fputs("16777216", fp);
+		fclose(fp);
+	}
+	if ((fp = fopen("/proc/sys/net/core/netdev_max_backlog", "w+"))) {
+		fputs("4096", fp);
+		fclose(fp);
+	}
+}
+
 //int start_firewall(char *wan_if, char *wan_ip, char *lan_if, char *lan_ip)
 int start_firewall(int wanunit, int lanunit)
 {
@@ -9224,8 +9260,14 @@ int start_firewall(int wanunit, int lanunit)
 	int lock;
 	char rp_if[32] = {0};
 
-	if (!is_routing_enabled())
+	if (!is_routing_enabled()) {
+		/* Nothing below this point applies without a WAN to filter - but
+		 * the socket ceilings do: a bridging box moves the same traffic
+		 * through the same sockets. Router and hotspot mode are untouched
+		 * and still take the call in place further down. */
+		reaper_socket_ceilings();
 		return -1;
+	}
 
 	if (getpid() != 1 && getuid() != 0) {
 		snprintf(tmp, sizeof(tmp), "start_firewall %d %d", wanunit, lanunit);
@@ -9465,28 +9507,10 @@ add_mtwan:
 	handle_sdn_feature(ALL_SDN, SDN_FEATURE_ALL_FIREWALL, RC_SERVICE_START);
 #endif
 
