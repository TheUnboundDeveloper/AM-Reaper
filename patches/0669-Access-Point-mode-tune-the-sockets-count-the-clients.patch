+/* v3.1.6: the same tiles on a box that is not routing. get_clientlist() is
+   networkmap's view, and its isOnline flag is derived from the DHCP lease
+   table and conntrack - both structurally empty in Access Point, repeater and
+   media-bridge mode. Every row failed the isOnline test, so the dashboard
+   showed 0 clients while the Devices page listed all 16 of them (GT-BE19000
+   tester, 2026-09-13). Reaper's own reaper_dev.cgi builds presence from the
+   wl assoclists, the bridge FDB and the ARP table, none of which need a lease
+   or a conntrack entry, and it carries the band the tiles bucket on.
+   Deliberately slower than the networkmap poll: action=status popen()s wl per
+   radio, VIF and station on a single-flight httpd, which is why the Devices
+   page reads it on demand and never on a timer. */
+function pollClientsDev(){
+  var x=new XMLHttpRequest();
+  x.open('GET','/reaper_dev.cgi?action=status&http_id='+encodeURIComponent(HTTPID)+'&_='+(new Date()).getTime(),true);
+  x.onreadystatechange=function(){
+    if(x.readyState!==4||x.status!==200) return;
+    try{
+      var j=JSON.parse(x.responseText), dv=(j&&j.devices)||[];
+      var b={'6':[],'5':[],'24':[],'eth':[]};
+      for(var i=0;i<dv.length;i++){
+        var d=dv[i];
+        /* an affiliated MLO link is one radio link of a device already in the
+           list, and an AiMesh node is not a client - the Devices page folds
+           both, and a tile that double-counted them would be its own bug */
+        if(!d.online || d.mlo_link || d.node) continue;
+        var k=(d.band==='2.4')?'24':(d.band==='5')?'5':(d.band==='6')?'6':'eth';
+        var nm=(d.name&&String(d.name).length)?d.name:((d.host&&String(d.host).length)?d.host:d.mac);
+        b[k].push({n:nm, ip:(d.ip&&String(d.ip).length)?d.ip:'\u2014', ip6:'', m:d.mac});
+      }
+      paintClients(b);
     }catch(e){}
   };
   x.send();
 }
 (function(){ var sel=$id('cl_filter'); if(sel){ sel.addEventListener('change',renderClients); renderClients(); } })();
-pollClients(); setInterval(pollClients, 10000);
+var clientTick = ROUTING ? pollClients : pollClientsDev;
+clientTick(); setInterval(clientTick, ROUTING ? 10000 : 30000);
 
