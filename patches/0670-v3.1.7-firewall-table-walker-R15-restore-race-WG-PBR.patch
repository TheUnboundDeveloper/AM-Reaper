+/* v3.1.7 (field): how recently a device must have been seen to be offered
+ * as "pending approval". gkd RETAINS a device in seen.tsv for DEV_TTL (24 h)
+ * after its last sighting so the approved-device list can still show its
+ * hostname, band and first/last-seen - but retention is not presence, and
+ * pending was reading it as if it were. A device removed by the admin while
+ * it was merely RETAINED came straight back on the next poll. Presence is a
+ * much shorter window than retention: long enough to ride out a stale ARP
+ * entry or a missed sweep, far short of the hours that made removal look
+ * broken. Note the online flag is checked SEPARATELY and not folded into
+ * this window: before the first NTP sync gkd leaves last=0 (touch_dev only
+ * stamps against a real clock), so a genuinely-online device would fail a
+ * pure age test on a just-booted router. */
+#define GK_PEND_TTL 900L	/* 15 min */
 
 struct gk_seen {
 	char mac[18], ip[46], host[40], band[8];
@@ -23620,6 +23633,7 @@ do_reaper_gk_cgi(char *url, FILE *stream)
