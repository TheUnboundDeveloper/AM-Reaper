+/* Copy the rules of `src` to `out`, leaving out every rule the kernel will
+ * not take - by the registry first (a match/target it does not list), then by
+ * the probe (one per distinct set of names). Each dropped rule is logged
+ * verbatim when `loud`; `first` (may be NULL) receives what sank the first
+ * one. The table and chain lines go out FIRST, in their own order, and the
+ * rules after them: a declaration that sat behind a rule jumping to it (see
+ * reaper_nf_forward_refs) is ahead of it in `out`; *hoisted (may be NULL)
+ * receives how many chains that concerned, and `hoistnames` (may be NULL)
+ * their names. Returns the number dropped, -1 when src cannot be read. */
+static int reaper_nf_copy_supported(const char *src, FILE *out, int v6, int loud, char *first, size_t firstlen,
