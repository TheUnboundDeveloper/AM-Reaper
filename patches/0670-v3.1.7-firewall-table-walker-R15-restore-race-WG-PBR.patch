+			/* 2. the probe, once per distinct set of names */
+			if (!sink && cnt > 0) {
+				size_t at = 0;
+				sig[0] = '\0';
+				for (i = 0; i < cnt && at < sizeof(sig) - 1; i++)
+					at += snprintf(sig + at, sizeof(sig) - at, "%s%s", i ? "," : "", names[i] + 2);
+				for (k = 0; k < nsig; k++)
