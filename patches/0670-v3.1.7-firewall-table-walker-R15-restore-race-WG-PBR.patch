 pollPorts(); setInterval(pollPorts, 5000);
 
+/* v3.1.8 P2 discoverability: the firewall walker's verdict, on the dashboard.
+   Every surface the walker fed was one the operator had to be looking at already
+   (the Rule Status tab, syslog, the diag bundle), so a red witness could stand
+   for days unseen. This reads the CACHED report - action=witness with NO run=1 -
+   because rwatch 3g re-walks every 5 min past HEALGRACE; the dashboard costs a
+   file read and never a table walk. skeleton (the boot-skeleton filter table,
+   R15) outranks a red count: with the full ruleset never loaded the witnesses
+   are judging a stub. */
+function pollWit(){
+  var x=new XMLHttpRequest();
+  x.open('GET','/reaper_fw.cgi?action=witness&http_id='+encodeURIComponent(HTTPID)+'&_='+(new Date()).getTime(),true);
+  x.timeout=8000;
+  x.onreadystatechange=function(){
+    if(x.readyState!==4) return;
+    var tag=$id('s_wit_tag'), sub=$id('s_wit_sub');
+    if(!tag||!sub) return;
+    var j=null; if(x.status===200){ try{ j=JSON.parse(x.responseText); }catch(e){} }
+    /* no report yet is not a fault: the walker runs after the first apply */
+    if(!j||!j.ok||!j.summary){ tag.textContent='\u2014'; tag.className='tag ok'; sub.textContent='\u2014'; sub.removeAttribute('title'); return; }
+    var s=j.summary, red=s.red||0, skel=!!j.skeleton;
+    /* RDSH_74 'Partial' - a boot-skeleton filter table IS a partly-loaded ruleset,
+       and the pill is nowrap/uppercase, so it has to be one word */
+    tag.textContent = skel ? `<#RDSH_74#>` : (red>0 ? (red+' '+`<#RFW_317#>`) : `<#RFW_304#>`);
+    tag.className = 'tag '+((skel||red>0) ? 'danger' : 'ok');
+    var t = (s.green||0)+' '+`<#RFW_304#>`+' \u00b7 '+red+' '+`<#RFW_305#>`
+          + (j.ts ? (' \u00b7 '+`<#RFW_309#>`+' '+new Date(j.ts*1000).toLocaleTimeString()) : '');
+    if(skel) t = `<#RFW_293#>`;
+    /* .sub2 clips with an ellipsis (standing rule 41) - carry the full text in a title */
+    sub.textContent=t; sub.title=t;
+  };
+  x.send();
+}
+pollWit(); setInterval(pollWit, 60000);
+
