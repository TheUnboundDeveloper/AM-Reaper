+/* 1 = `name` is on the registry `proc`; 0 = it is not; -1 = no registry to
+ * ask (no proc file - treat as supported: never strip on a guess). */
+static int reaper_nf_listed(const char *proc, const char *name)
+{
+	FILE *fp;
+	char line[64];
+	int found = 0;
+
+	if ((fp = fopen(proc, "r")) == NULL)
+		return -1;
+	while (fgets(line, sizeof(line), fp)) {
+		line[strcspn(line, "\r\n")] = '\0';
+		if (strcmp(line, name) == 0) {
+			found = 1;
+			break;
+		}
+	}
+	fclose(fp);
+	return found;
+}
+
+/* Does this kernel register `name` as a match (is_target 0) or target (1)
+ * for the v4 (v6 0) or v6 table family? A name not on the registry gets one
+ * modprobe of its xt_/ipt_/ip6t_ module and is asked for again. Returns 1
+ * supported, 0 not, -1 unknowable. */
+static int reaper_nf_supported(int v6, int is_target, const char *name)
+{
+	const char *proc = v6 ? (is_target ? REAPER_NF_TARGETS6 : REAPER_NF_MATCHES6)
+	                      : (is_target ? REAPER_NF_TARGETS4 : REAPER_NF_MATCHES4);
+	char mod[80];
+	int r;
+
+	if ((r = reaper_nf_listed(proc, name)) != 0)
+		return r;
+	snprintf(mod, sizeof(mod), "xt_%s", name);
+	eval("modprobe", "-q", mod);
+	snprintf(mod, sizeof(mod), "%s_%s", v6 ? "ip6t" : "ipt", name);
+	eval("modprobe", "-q", mod);
+	return reaper_nf_listed(proc, name) == 1 ? 1 : 0;
+}
