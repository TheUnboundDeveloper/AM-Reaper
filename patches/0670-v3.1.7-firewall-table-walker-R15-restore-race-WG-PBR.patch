+/* ------------------------------------------------------------------ */
+/* output                                                              */
+/* ------------------------------------------------------------------ */
+static void json_str(FILE *f, const char *s)
+{
+	fputc('"', f);
+	for (; *s; s++) {
+		unsigned char ch = (unsigned char)*s;
+		if (ch == '"' || ch == '\\') { fputc('\\', f); fputc(ch, f); }
+		else if (ch < 0x20) fprintf(f, "\\u%04x", ch);
+		else fputc(ch, f);
+	}
+	fputc('"', f);
+}
+
+static void write_json(const char *path, int skeleton)
+{
+	char tmp[300]; FILE *f; int i, green = 0, red = 0, dep = 0, na = 0; long up = 0;
+	{ FILE *u = fopen("/proc/uptime", "r"); if (u) { double d = 0; if (fscanf(u, "%lf", &d) == 1) up = (long)d; fclose(u); } }
+	for (i = 0; i < nwit; i++) { if (wit[i].na) na++; else if (wit[i].dep) dep++; else if (wit[i].ok) green++; else red++; }
+	snprintf(tmp, sizeof(tmp), "%s.tmp", path);
+	f = fopen(tmp, "w");
+	if (!f) { fprintf(stderr, "cannot write %s: %s\n", tmp, strerror(errno)); return; }
+	fprintf(f, "{\"ok\":1,\"ver\":\"%s\",\"ts\":%ld,\"uptime\":%ld,\"family\":%d,\"skeleton\":%d,\"v4\":%d,\"v6\":%d,"
+		   "\"summary\":{\"total\":%d,\"green\":%d,\"red\":%d,\"depends\":%d,\"na\":%d},\"witnesses\":[",
+		FWSIM_VER, (long)time(NULL), up, opt_family, skeleton, fw4.loaded, fw6.loaded, nwit, green, red, dep, na);
+	for (i = 0; i < nwit; i++) {
+		struct witness *w = &wit[i]; char wtxt[400];
+		if (w->shape) snprintf(wtxt, sizeof(wtxt), "%s", w->pred);
+		else snprintf(wtxt, sizeof(wtxt), "%s %s -> %s %s%s%s %s%s%s", w->in, w->src, w->dst, w->proto, w->port[0] ? ":" : "", w->port, w->ct, w->mac[0] ? " mac " : "", w->mac);
+		fprintf(f, "%s{\"id\":", i ? "," : ""); json_str(f, w->id);
+		fprintf(f, ",\"feature\":"); json_str(f, w->feature);
+		fprintf(f, ",\"family\":%d,\"witness\":", w->fam); json_str(f, wtxt);
+		fprintf(f, ",\"expect\":"); json_str(f, w->expect);
+		fprintf(f, ",\"verdict\":"); json_str(f, w->verdict);
+		fprintf(f, ",\"state\":\"%s\"", w->na ? "na" : w->dep ? "depends" : w->ok ? "green" : "red");
+		fprintf(f, ",\"rule\":"); json_str(f, w->decide);
+		fprintf(f, ",\"path\":"); json_str(f, w->path);
+		fprintf(f, ",\"note\":"); json_str(f, w->note);
+		fprintf(f, "}");
+	}
+	fprintf(f, "]}\n");
+	fclose(f);
+	if (rename(tmp, path) != 0) { fprintf(stderr, "cannot rename %s: %s\n", tmp, strerror(errno)); unlink(tmp); }
+}
+
+static void print_text(int skeleton)
+{
+	int i, green = 0, red = 0, dep = 0, na = 0;
+	for (i = 0; i < nwit; i++) { if (wit[i].na) na++; else if (wit[i].dep) dep++; else if (wit[i].ok) green++; else red++; }
+	printf("reaper_fwsim %s: %d witnesses - %d green, %d red, %d depends, %d n/a%s\n", FWSIM_VER, nwit, green, red, dep, na, skeleton ? " - FILTER TABLE IS THE BOOT SKELETON" : "");
+	for (i = 0; i < nwit; i++) {
+		struct witness *w = &wit[i];
+		printf("  %-7s %-5s %-6s %s\n", w->id, w->na ? "n/a" : w->dep ? "DEP" : w->ok ? "ok" : "RED", w->fam == 6 ? "v6" : "v4", w->feature);
+		if (w->na) { if (w->note[0]) printf("          %s\n", w->note); continue; }
+		printf("          expect %s, got %s\n", w->expect, w->verdict);
+		if (w->decide[0]) printf("          rule: %s\n", w->decide);
+		if (opt_print > 1 && w->path[0]) printf("          path: %s\n", w->path);
+	}
+}
+
+static void dump_witnesses(const char *path)
+{
+	FILE *f = fopen(path, "w"); int i;
+	if (!f) return;
+	fprintf(f, "# reaper_fwsim witnesses as generated on this router (id|feature|fam|in|src|dst|proto|port|ct|expect|out|mac)\n");
+	for (i = 0; i < nwit; i++) {
+		struct witness *w = &wit[i];
+		if (w->shape) fprintf(f, "%s|%s|%d|shape|%s|||||%s\n", w->id, w->feature, w->fam, w->pred, w->expect);
+		else fprintf(f, "%s|%s|%d|%s|%s|%s|%s|%s|%s|%s|%s|%s\n", w->id, w->feature, w->fam, w->in, w->src, w->dst, w->proto, w->port, w->ct, w->expect, w->out, w->mac);
+	}
+	fclose(f);
+}
