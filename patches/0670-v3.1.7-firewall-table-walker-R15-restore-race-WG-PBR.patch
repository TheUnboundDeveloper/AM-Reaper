+/* ------------------------------------------------------------------ */
+/* inputs on the router                                                */
+/* ------------------------------------------------------------------ */
+#ifndef FWSIM_HOST
+static int run_to(const char *path, char *const argv[])
+{
+	char redir[200];
+	snprintf(redir, sizeof(redir), ">%s", path);
+	return _eval((char **)argv, redir, 15, NULL);
+}
+
+static void router_inputs(void)
+{
+	char *a4[] = { "iptables-save", NULL }, *a6[] = { "ip6tables-save", NULL };
+	char *ad4[] = { "ip", "-4", "-o", "addr", NULL }, *ad6[] = { "ip", "-6", "-o", "addr", NULL };
+	mkdir(FWSIM_DIR, 0755);
+	if (opt_family & 1) { run_to(FWSIM_TMP4, a4); load_save(&fw4, FWSIM_TMP4, 4); unlink(FWSIM_TMP4); }
+	if (opt_family & 2) { run_to(FWSIM_TMP6, a6); load_save(&fw6, FWSIM_TMP6, 6); unlink(FWSIM_TMP6); }
+	run_to(FWSIM_TMPA, ad4); load_addrs(FWSIM_TMPA);
+	run_to(FWSIM_TMPA, ad6); load_addrs(FWSIM_TMPA);
+	unlink(FWSIM_TMPA);
+	/* the WAN interface: what the firewall was built for */
+	{
+		static char wbuf[20]; const char *proto = nv_get("wan0_proto"), *ifn;
+		if (!strcmp(proto, "pppoe") || !strcmp(proto, "pptp") || !strcmp(proto, "l2tp")) ifn = nv_get("wan0_pppoe_ifname");
+		else ifn = nv_get("wan0_ifname");
+		if (ifn && ifn[0]) { snprintf(wbuf, sizeof(wbuf), "%s", ifn); wan_ifname = wbuf; }
+	}
+	{ static char lbuf[20]; const char *l = nv_get("lan_ifname"); if (l && l[0]) { snprintf(lbuf, sizeof(lbuf), "%s", l); lan_ifname = lbuf; } }
+}
+#endif
+
+static void usage(void)
+{
+	fprintf(stderr,
+		"reaper_fwsim %s - walk witness packets through the live firewall tables\n"
+		"  --run                 read the live tables, generate witnesses, write %s\n"
+		"  --print [--print]     text report (twice: with the walk path)\n"
+		"  --family 4|6|both     which tables (default both)\n"
+		"  --json FILE           output file (default %s)\n"
+		"  --delay N             sleep N s first (for the post-apply run)\n"
+		"  --witness FILE        take witnesses from FILE instead of generating\n"
+		"  --static FILE         the static witness file (default %s)\n"
+		"  --dump FILE           write the generated witnesses to FILE\n"
+		"  host mode: --save4 FILE --save6 FILE --addr FILE --members FILE --nv FILE\n"
+		"             --wan IF --lan IF\n", FWSIM_VER, FWSIM_JSON, FWSIM_JSON, FWSIM_STATIC);
+}
+
+int main(int argc, char **argv)
+{
+	int i, do_run = 0, skeleton = 0;
+	for (i = 1; i < argc; i++) {
+		const char *a = argv[i], *v = (i + 1 < argc) ? argv[i+1] : NULL;
+		if (!strcmp(a, "--run")) do_run = 1;
+		else if (!strcmp(a, "--print")) opt_print++;
+		else if (!strcmp(a, "--family") && v) { opt_family = !strcmp(v, "4") ? 1 : !strcmp(v, "6") ? 2 : 3; i++; }
+		else if (!strcmp(a, "--json") && v) { opt_json = v; i++; }
+		else if (!strcmp(a, "--delay") && v) { opt_delay = atoi(v); i++; }
+		else if (!strcmp(a, "--witness") && v) { opt_witness = v; i++; }
+		else if (!strcmp(a, "--static") && v) { opt_static = v; i++; }
+		else if (!strcmp(a, "--dump") && v) { opt_dump = v; i++; }
+		else if (!strcmp(a, "--save4") && v) { opt_save4 = v; i++; }
+		else if (!strcmp(a, "--save6") && v) { opt_save6 = v; i++; }
+		else if (!strcmp(a, "--addr") && v) { opt_addr = v; i++; }
+		else if (!strcmp(a, "--members") && v) { opt_members = v; i++; }
+		else if (!strcmp(a, "--nv") && v) { opt_nv = v; i++; }
+		else if (!strcmp(a, "--wan") && v) { wan_ifname = v; i++; }
+		else if (!strcmp(a, "--lan") && v) { lan_ifname = v; i++; }
+		else if (!strcmp(a, "-h") || !strcmp(a, "--help")) { usage(); return 0; }
+		else { usage(); return 2; }
+	}
+	if (opt_delay > 0) sleep((unsigned)opt_delay);
+
+#ifdef FWSIM_HOST
+	if (opt_nv) load_nv(opt_nv);
+	if (opt_save4) load_save(&fw4, opt_save4, 4);
+	if (opt_save6) load_save(&fw6, opt_save6, 6);
+	if (opt_addr) load_addrs(opt_addr);
+	if (opt_members) load_members(opt_members);
+	if (!opt_save4 && !opt_save6) { usage(); return 2; }
+	(void)do_run;
+#else
+	if (!do_run && !opt_print) { usage(); return 2; }
+	router_inputs();
+#endif
+	if (!fw4.loaded && !fw6.loaded) { fprintf(stderr, "no tables loaded\n"); return 1; }
+
+	/* the boot skeleton is reported before anything is walked */
+	if (fw4.loaded) { struct table *t = table_get(&fw4, "filter", 0); skeleton = t && !chain_get(t, "INPUT_ICMP", 0) && !chain_get(t, "SECURITY", 0) && nv_is("sw_mode", "1"); }
+
+	if (opt_witness) { sub_set("LANIF", lan_ifname); sub_set("WANIF", wan_ifname); load_witness_file(opt_witness, 0); }
+	else gen_witnesses();
+	eval_all();
+	if (opt_dump) dump_witnesses(opt_dump);
+	write_json(opt_json, skeleton);
+	if (opt_print) print_text(skeleton);
+	return 0;
+}
