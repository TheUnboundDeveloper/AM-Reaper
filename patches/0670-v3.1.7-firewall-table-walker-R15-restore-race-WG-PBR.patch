 iptables -t mangle -S REAPER_PBR 2>/dev/null | grep 'MARK --set' | sed 's/^/    v4 /'
+# v1.3.18: the counters - a mark rule that never matched a packet is the "traffic is not being
+# marked" half of a routing report; the addresses in these lines go through the sanitizer.
+iptables -t mangle -nvxL REAPER_PBR 2>/dev/null | awk '/MARK set/ {printf "    v4 pkts=%s bytes=%s  %s -> %s  %s\n", $1, $2, $8, $9, substr($0, index($0,$10))}'
 ip -4 rule list 2>/dev/null | awk -F: '$1+0>=9000 && $1+0<=9199' | sed 's/^/    rule /'
 ip -6 rule list 2>/dev/null | awk -F: '$1+0>=9000 && $1+0<=9199' | sed 's/^/    rule6 /'
 [ -r /proc/blog/skip_wireguard_network ] && echo "  wg accel bypass   : $(grep -c . /proc/blog/skip_wireguard_network 2>/dev/null) net(s) listed ($(awk '$2=="new"' /tmp/reaper_pbr/skipnets 2>/dev/null | wc -l) added by policy routing)"
@@ -877,7 +880,18 @@ for i in 1 2; do S="$(nvram get vpn_server${i}_state 2>/dev/null)"; [ -n "$S" ]
 for i in 1 2 3 4 5; do
   E="$(nvram get wgc${i}_enable 2>/dev/null)"; [ "$E" = 1 ] || continue
   echo "  wgc$i               : enable=1 iface=$( [ -d /sys/class/net/wgc$i ] && echo up || echo down ) peers=$(have wg && wg show wgc$i peers 2>/dev/null | wc -l)"
+  # v1.3.18 (WireGuard policy-routing report, 2026-09-14): what a `lookup wgcN` actually finds,
+  # and whether the tunnel has ever completed a handshake (age only - the peer key is identity).
+  _rt="$(ip -4 route show table wgc$i 2>/dev/null)"; _rtn=$(printf '%s\n' "$_rt" | grep -c .); _rtd=$(printf '%s\n' "$_rt" | grep -cE '^(default|0\.0\.0\.0/1) ')
+  echo "    table wgc$i       : $_rtn route(s), default-covering $_rtd (0 = a policy-routing lookup finds nothing here and falls through)"
+  have wg && echo "    last handshake   : $(wg show wgc$i latest-handshakes 2>/dev/null | awk -v n="$(date +%s)" 'NR==1{ if ($2+0==0) print "never"; else print n-$2 "s ago" }')"
+  [ "$(nvram get reaper_pbr_enable 2>/dev/null)" = 1 ] && grep -q ">WGC$i\(<\|$\)" /jffs/reaper_pbr/lastgood/rulelist 2>/dev/null && [ "$_rtd" = 0 ] && finding WARN "policy routing: a rule targets WGC$i but table wgc$i has no default-covering route ($_rtn route(s)) - marked traffic falls through (WAN with the Killswitch off, blocked with it on); check the client's Allowed IPs and whether the tunnel is up (see 14d)"
 done
+# v1.3.18: the bypass record the apply script keeps - `new` = installed by policy routing,
+# `pre` = already there (VPN Director/WG server), `pending` = the interface was down at apply
+# time (start_wgc re-runs the apply since v3.1.7). Counts only; the nets are in the sanitized list above.
+[ -f /tmp/reaper_pbr/skipnets ] && echo "  bypass record     : new=$(awk '$2=="new"' /tmp/reaper_pbr/skipnets | wc -l) pre=$(awk '$2=="pre"' /tmp/reaper_pbr/skipnets | wc -l) pending=$(awk '$2=="pending"' /tmp/reaper_pbr/skipnets | wc -l)"
+[ "$(awk '$2=="pending"' /tmp/reaper_pbr/skipnets 2>/dev/null | wc -l)" -gt 0 ] && finding WARN "policy routing: $(awk '$2=="pending"' /tmp/reaper_pbr/skipnets | wc -l) WireGuard flow-cache bypass entry(ies) are PENDING - the client interface was down when the rules were applied; accelerated flows from those sources may miss the tunnel until the client (re)starts (see 14d)"
 [ "$(nvram get wgs_enable 2>/dev/null)" = 1 ] && echo "  wg server          : enable=1 iface=$( [ -d /sys/class/net/wgs1 ] && echo up || echo down ) peers=$(have wg && wg show wgs1 peers 2>/dev/null | wc -l)"
 echo "  ipsec             : server=$(nvram get ipsec_server_enable 2>/dev/null) charon=$(pidof charon 2>/dev/null | wc -w)"
 echo "  tunnel ifaces     : $(ls /sys/class/net 2>/dev/null | grep -E '^(tun|tap|wg)' | tr '\n' ' ')"
@@ -909,6 +923,27 @@ _skel=0; { iptables -nL INPUT_ICMP >/dev/null 2>&1 || iptables -nL SECURITY >/de
 echo "  filter table                    : $( [ "$_skel" = 1 ] && echo 'BOOT SKELETON ONLY - INPUT_ICMP/SECURITY absent, the full ruleset never loaded' || echo 'full - INPUT_ICMP/SECURITY present' )"
 echo "  /tmp/err_rules                  : $( ls /tmp/err_rules 2>/dev/null | tr '\n' ' ' | sed 's/ *$//' )"
 for _e in /tmp/err_rules/*.err; do [ -f "$_e" ] && echo "    $(basename "$_e"): $(head -1 "$_e" | cut -c1-160)"; done
+# v1.3.18 (RT-BE88U, 2026-09-14): a KERNEL refusal is reported at the COMMIT line, which names
+# nothing. The kernel does list what it registers, so say which match/target names the newest
+# refused copy uses that this kernel does not - names only, no rule text, no addresses.
+_rf=""; for _r in /tmp/err_rules/filter_rules_[0-9]*; do [ -f "$_r" ] && _rf="$_r"; done
+if [ -n "$_rf" ] && [ -r /proc/net/ip_tables_matches ]; then
+  _miss=""
+  for _m in $(grep -oE -- '-m [a-z0-9_]+' "$_rf" 2>/dev/null | awk '{print $2}' | sort -u); do grep -qx "$_m" /proc/net/ip_tables_matches || _miss="$_miss match:$_m"; done
+  for _j in $(grep -oE -- '-j [A-Z][A-Z0-9_]+' "$_rf" 2>/dev/null | awk '{print $2}' | sort -u); do
+    case "$_j" in ACCEPT|DROP|RETURN|QUEUE) continue;; esac
+    grep -q "^:$_j " "$_rf" && continue
+    grep -qx "$_j" /proc/net/ip_tables_targets 2>/dev/null || _miss="$_miss target:$_j"
+  done
+  echo "  kernel registry vs $(basename "$_rf"): $( [ -n "$_miss" ] && echo "NOT registered by this kernel:$_miss" || echo 'every match and target the file uses is registered - the refusal is something else' )"
+  [ -n "$_miss" ] && finding WARN "firewall: the refused ruleset uses match/target(s) this kernel does not register ($_miss) - from v3.1.7 the restore leaves those rules out and loads the rest; before it the whole table was refused (see 14f)"
+  # a chain used (appended to, or jumped to) BEFORE its declaration: iptables-restore 1.4.15 refuses
+  # the rule where it reads it ("Couldn't load target ... Error occurred at line: N"); v3.1.7 moves
+  # the declarations first instead of dropping the rule
+  _fwd="$(awk '/^:/{n=substr($1,2); decl[n]=NR} /^-[AI] /{for(i=1;i<NF;i++) if($i=="-j"||$i=="-A"||$i=="-I"){t=$(i+1); if(!(t in decl) && !(t in pend)) pend[t]=NR}} END{for(t in pend) if((t in decl) && decl[t]>pend[t]) printf "%s ", t}' "$_rf" 2>/dev/null | sed 's/ *$//')"
+  echo "  chains declared after first use : ${_fwd:-none}"
+  [ -n "$_fwd" ] && finding WARN "firewall: the refused ruleset uses chain(s) [$_fwd] before declaring them - iptables-restore refuses such a rule where it reads it; v3.1.7 moves the declarations first (see 14f)"
+fi
 _pfm=0; _pfn=0
 if [ -n "$_rl" ]; then
   printf '%s' "$_rl" | tr '<' '\n' > "$RAW.pf"
@@ -929,6 +964,31 @@ fi
 [ "$_vts" = 1 ] && [ "$_nrules" -gt 0 ] && [ "$_hook" -gt 0 ] && [ "$_pfm" = 0 ] && [ "$(iptables -S FORWARD 2>/dev/null | grep -c -- '--ctstate DNAT -j ACCEPT')" = 0 ] && finding WARN "port forwarding: DNAT lines are live but FORWARD has no ctstate-DNAT accept - forwarded flows are translated and then dropped (see 14f)"
 [ "$_skel" = 1 ] && [ "$(nvram get sw_mode 2>/dev/null)" = 1 ] && finding WARN "firewall: the filter table is the boot-time skeleton only - the full ruleset never loaded (one line was refused; see 14f, the firewall: lines in 19 and /tmp/err_rules); port forwards, VPN server chains and the DoS guard are NOT in force"
 
+sec "14g. FIREWALL WITNESSES (reaper_fwsim - each feature's promise walked through the live tables)"
+# v1.3.19: the walker pushes witness packets (ingress interface, addresses,
+# protocol/port, conntrack state) through the LIVE tables in kernel order and
+# names the rule that decides each one. RED = the tables do not deliver what
+# the feature promises; DEP = a match the walker does not model (string, u32,
+# time, policy) sits on the path - not judged, never guessed; n/a = the router
+# has no such network (no IPv6, no WAN address yet). Witness addresses are the
+# router's own LAN/guest prefixes with a synthetic host and documentation
+# ranges on the WAN side; the report goes through the sanitizer like the rest.
+if [ -x /usr/bin/reaper_fwsim ]; then
+  _fwd=/tmp/reaper/fwsim_diag.txt
+  /usr/bin/reaper_fwsim --run --print > "$_fwd" 2>&1
+  head -1 "$_fwd" | sed 's/^/  /'
+  _red=$(head -1 "$_fwd" | sed -n 's/.* \([0-9]*\) red.*/\1/p')
+  _dep=$(head -1 "$_fwd" | sed -n 's/.* \([0-9]*\) depends.*/\1/p')
+  echo "  -- red / depends rows (green rows omitted; the JSON at /tmp/reaper/fwstatus.json has them all) --"
+  grep -A2 '^  [A-Za-z0-9.]* *\(RED\|DEP\) ' "$_fwd" | grep -v '^--$' | sed 's/^/  /' | head -90
