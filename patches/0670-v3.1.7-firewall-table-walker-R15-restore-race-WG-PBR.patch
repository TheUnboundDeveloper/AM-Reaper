+/* v3.1.7 (2026-09-14): iptables-restore 1.4.15 resolves `-j NAME` when it
+ * READS the rule; a jump to a chain whose `:NAME` line comes LATER in the file
+ * is refused on the spot ("Couldn't load target `NAME':No such file or
+ * directory ... Error occurred at line: N" - measured on the RT-BE88U), not at
+ * COMMIT. The closed blob writes its chain declarations in the rules section,
+ * ahead of the rules that jump to them on every file seen so far, but nothing
+ * guarantees that for another build of private.o; a declaration is order-free,
+ * so such a jump is fixed by moving the declaration up, never by dropping the
+ * rule. The chains a file declares after the first rule that jumps to them, as
+ * a count and a comma list. */
+static int reaper_nf_forward_refs(const char *src, char *names, size_t len)
+{
+	FILE *fp;
+	char buf[4096], decl[128][40], *tok, *save, *prev;
+	int dline[128], late[128], ndecl = 0, lineno = 0, cnt = 0, i;
+	size_t at = 0;
+
+	if (names && len)
+		names[0] = '\0';
+	if ((fp = fopen(src, "r")) == NULL)
+		return 0;
+	while (fgets(buf, sizeof(buf), fp)) {
+		lineno++;
+		if (buf[0] != ':' || ndecl >= 128)
+			continue;
+		buf[strcspn(buf, " \t\r\n")] = '\0';
+		snprintf(decl[ndecl], 40, "%s", buf + 1);
+		dline[ndecl] = lineno;
+		late[ndecl++] = 0;
+	}
+	rewind(fp);
+	lineno = 0;
+	while (fgets(buf, sizeof(buf), fp)) {
+		lineno++;
+		if (buf[0] != '-' || (buf[1] != 'A' && buf[1] != 'I'))
+			continue;
+		prev = NULL;
+		for (tok = strtok_r(buf, " \t\r\n", &save); tok; tok = strtok_r(NULL, " \t\r\n", &save)) {
+			/* the chain a rule is appended to, and the one it jumps to */
+			if (prev && (strcmp(prev, "-j") == 0 || strcmp(prev, "-A") == 0 || strcmp(prev, "-I") == 0)) {
+				for (i = 0; i < ndecl; i++)
+					if (strcmp(decl[i], tok) == 0)
+						break;
+				if (i < ndecl && dline[i] > lineno && !late[i]) {
+					late[i] = 1;     /* each chain counted and named once */
+					if (names && at < len)
+						at += snprintf(names + at, len - at, "%s%s", cnt ? "," : "", tok);
+					cnt++;
+				}
+			}
+			prev = tok;
+		}
+	}
+	fclose(fp);
+	return cnt;
+}
