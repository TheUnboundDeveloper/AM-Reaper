+				for (k = 0; k < nbad; k++) if (!strcmp(bad[k], names[i])) { sink = bad[k]; known = 1; break; }
+				if (known) break;
+				for (k = 0; k < ngood; k++) if (!strcmp(good[k], names[i])) { known = 1; break; }
+				if (known) continue;
+				if (reaper_nf_supported(v6, names[i][0] == 'j', names[i] + 2) == 0) {
+					if (nbad < REAPER_NF_MAXNAMES) snprintf(bad[nbad++], 40, "%s", names[i]);
+					sink = names[i];
+				} else if (ngood < REAPER_NF_MAXNAMES)
+					snprintf(good[ngood++], 40, "%s", names[i]);
+			}
