+	/* reaper v3.1.7 (field): recover a stuck "Applying Settings" overlay.
+
+	   An apply that restarts networking frequently kills its own HTTP reply, and
+	   nvramSet's error path used to swallow that silently - leaving showLoading()
+	   up with no countdown and no way out but closing the browser. This does NOT
+	   invoke the caller's handler (success-only is the contract 75 call sites are
+	   written against); it only gets the operator unstuck, by waiting for httpd to
+	   come back and reloading - the same recovery the SDN page performs on applies
+	   it KNOWS will drop the link. Silent, as before, when no overlay is showing:
+	   background nvramSet calls must not start reloading pages. */
+	"applyStuckRecover": function(postData){
+		try{
+			if(!postData || (postData.action_mode != "apply" && !postData.rc_service)) return;
+			var ov = document.getElementById("Loading");
+			/* hideLoading() toggles visibility, so this is the live test for
+			   "an overlay is actually in front of the user right now" */
+			if(!ov || ov.style.visibility != "visible") return;
+			if(httpApi._stuckPoll) return;   /* one recovery at a time */
+			var tries = 0;
+			httpApi._stuckPoll = setInterval(function(){
+				tries++;
+				if(tries > 40){   /* ~2 min: stop waiting and let the page re-read state */
+					clearInterval(httpApi._stuckPoll); httpApi._stuckPoll = 0;
+					location.reload();
+					return;
+				}
+				$.ajax({
+					url: "/httpd_check.xml",
+					dataType: "xml",
+					timeout: 3000,
+					cache: false,
+					success: function(){
+						clearInterval(httpApi._stuckPoll); httpApi._stuckPoll = 0;
+						location.reload();
+					},
+					error: function(){}   /* still down - the interval retries */
+				});
+			}, 3000);
+		}catch(e){}
+	},
+
