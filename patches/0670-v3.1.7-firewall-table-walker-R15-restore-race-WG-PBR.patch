 	sb_puts(s, "}");
 }
 
+/* v3.1.7: the firewall witness report (reaper_fwsim). Read-only by
+ * construction - the walker runs iptables-save / ip addr / ipset test and
+ * writes one tmpfs file. Re-walked here when the file is absent or older than
+ * 60 s, bounded by the same alarm the diag probes use. The JSON is the
+ * walker's own (already escaped) and is embedded verbatim. */
+static void tool_fwstatus(sbuf_t *s)
+{
+	struct stat st; time_t now = time(NULL);
+	if (access("/usr/bin/reaper_fwsim", X_OK) == 0 &&
+	    (stat("/tmp/reaper/fwstatus.json", &st) != 0 || now - st.st_mtime > 60)) {
+		char *argv[] = { "/usr/bin/reaper_fwsim", "--run", NULL };
+		_eval(argv, NULL, 12, NULL);
+	}
+	{
+		sbuf_t t; sb_init(&t);
+		sb_addcmd(&t, "cat /tmp/reaper/fwstatus.json 2>/dev/null", 262144);
+		if (t.p && t.p[0] == '{') sb_puts(s, t.p);
+		else sb_puts(s, "{\"ok\":0,\"error\":\"no witness report - reaper_fwsim has not run\"}");
+		sb_free(&t);
+	}
+}
+
 static void tool_nvram(sbuf_t *s)
 {
 	int i, first = 1;
@@ -1149,6 +1171,7 @@ static int run_tool(const char *name, struct json_object *args, sbuf_t *out)
 		return 0;
 	}
 	if (!strcmp(name, "get_firewall_summary")) { tool_firewall(out); return 0; }
+	if (!strcmp(name, "get_firewall_status")) { tool_fwstatus(out); return 0; }
 	if (!strcmp(name, "get_nvram"))            { tool_nvram(out); return 0; }
 	if (!strcmp(name, "get_logs"))             { tool_logs(out); return 0; }
 	if (!strcmp(name, "get_settings_audit"))   { tool_audit(out); return 0; }
@@ -1172,6 +1195,7 @@ static const char *TOOLS_CATALOG =
 "{\"name\":\"get_qos\",\"description\":\"QoS engine, type, and bandwidth configuration.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{}}},"
 "{\"name\":\"get_traffic\",\"description\":\"Traffic Analyzer snapshot for a window.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"window\":{\"type\":\"string\",\"enum\":[\"live\",\"m5\",\"hour\",\"day\",\"month\"]}}}},"
 "{\"name\":\"get_firewall_summary\",\"description\":\"Firewall summary: iptables + ip6tables filter rules, per-rule hit counters (packets/bytes), and NAT forwards.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{}}},"
+"{\"name\":\"get_firewall_status\",\"description\":\"Firewall Rule Status: each feature's witness packets walked through the live iptables/ip6tables tables by reaper_fwsim - verdict, expected verdict, state (green/red/depends/na) and the deciding rule per witness. Red = the tables do not deliver what the feature promises. Read-only.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{}}},"
 "{\"name\":\"get_nvram\",\"description\":\"Curated non-secret configuration keys (secrets are never included).\",\"inputSchema\":{\"type\":\"object\",\"properties\":{}}},"
 "{\"name\":\"get_logs\",\"description\":\"Recent system log lines, secrets redacted.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{}}},"
 "{\"name\":\"get_settings_audit\",\"description\":\"Composed security-posture snapshot for auditing and explanation.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{}}}";
