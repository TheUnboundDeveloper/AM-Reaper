+/* Does the kernel take this rule? Alone, in a scratch chain, with --noflush so
+ * the live table is untouched; the chain is removed again. 1 = yes; 0 =
+ * refused; 1 also when the probe itself cannot run (never strip on a guess). */
+static int reaper_nf_probe(int v6, const char *rule)
+{
+	FILE *fp;
+	char *argv[4];
+	int ret;
