+	char buf[4096], probe[4096], declared[2048], names[16][40], sig[256];
+	static char bad[REAPER_NF_MAXNAMES][40], good[REAPER_NF_MAXNAMES][40];
+	static char sigs[REAPER_NF_MAXSIGS][256];
