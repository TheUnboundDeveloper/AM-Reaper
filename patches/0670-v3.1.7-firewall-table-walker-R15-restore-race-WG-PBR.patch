+					if (nsig < REAPER_NF_MAXSIGS) {
+						snprintf(sigs[nsig], sizeof(sigs[0]), "%s", sig);
+						sigok[nsig++] = okp;
+					}
+					if (!okp) { sink = sig; why = "refuses"; }
+				} else if (!sigok[k]) {
+					sink = sigs[k];
+					why = "refuses";
+				}
+			}
+		}
+		if (sink) {
+			buf[strcspn(buf, "\r\n")] = '\0';
+			if (loud) {
+				if (why[0] == 'h')
+					logmessage("firewall", "kernel has no '%s' %s - dropped: %s",
+						   sink + 2, sink[0] == 'j' ? "target" : "match", buf);
+				else
+					logmessage("firewall", "kernel refuses a rule using '%s' (probed alone in a scratch chain) - dropped: %s",
+						   sink, buf);
+			}
+			if (first && !first[0])
+				snprintf(first, firstlen, "%s", why[0] == 'h' ? sink + 2 : sink);
+			dropped++;
+			continue;
+		}
+		fputs(buf, out);
+	}
+	fclose(in);
+	return dropped;
+}
