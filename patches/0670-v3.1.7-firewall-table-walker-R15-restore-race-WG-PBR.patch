+#define REAPER_NF_MATCHES4 "/proc/net/ip_tables_matches"
+#define REAPER_NF_TARGETS4 "/proc/net/ip_tables_targets"
+#define REAPER_NF_MATCHES6 "/proc/net/ip6_tables_matches"
+#define REAPER_NF_TARGETS6 "/proc/net/ip6_tables_targets"
+#define REAPER_NF_PROBE_CHAIN "REAPER_PROBE"
+#define REAPER_NF_PROBE_FILE "/tmp/reaper_nf_probe.rules"
+#define REAPER_NF_MAXNAMES 64
+#define REAPER_NF_MAXSIGS 48
