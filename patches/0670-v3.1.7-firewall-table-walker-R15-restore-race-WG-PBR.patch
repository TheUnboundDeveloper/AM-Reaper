+/* The chains a restore file declares, as "\nNAME\n" runs (so a strstr on
+ * "\nNAME\n" is exact). */
+static void reaper_nf_declared(const char *path, char *out, size_t len)
+{
+	FILE *fp;
+	char buf[4096];
+	size_t at = 1;
+
+	out[0] = '\n';
+	out[1] = '\0';
+	if ((fp = fopen(path, "r")) == NULL)
+		return;
+	while (fgets(buf, sizeof(buf), fp)) {
+		if (buf[0] != ':')
+			continue;
+		buf[strcspn(buf, " \t\r\n")] = '\0';
+		if (at + strlen(buf + 1) + 2 >= len)
+			break;
+		at += snprintf(out + at, len - at, "%s\n", buf + 1);
+	}
+	fclose(fp);
+}
+
+/* The names a rule line uses: every `-m <name>` and a `-j <NAME>` that is a
+ * target module - not a chain the file declares, not a built-in verdict.
+ * Fills `names` (at most n) with "m:<name>" / "j:<NAME>"; returns the count. */
+static int reaper_nf_rule_names(const char *line, const char *declared, char names[][40], int n)
+{
+	char buf[4096], key[48], *tok, *save, *prev = NULL;
+	int cnt = 0;
+
+	snprintf(buf, sizeof(buf), "%s", line);
+	for (tok = strtok_r(buf, " \t\r\n", &save); tok && cnt < n; tok = strtok_r(NULL, " \t\r\n", &save)) {
+		if (prev && strcmp(prev, "-m") == 0) {
+			snprintf(names[cnt++], 40, "m:%s", tok);
+		} else if (prev && strcmp(prev, "-j") == 0) {
+			snprintf(key, sizeof(key), "\n%s\n", tok);
+			if (strcmp(tok, "ACCEPT") && strcmp(tok, "DROP") && strcmp(tok, "RETURN")
+			    && strcmp(tok, "QUEUE") && !strstr(declared, key))
+				snprintf(names[cnt++], 40, "j:%s", tok);
+		}
+		prev = tok;
+	}
+	return cnt;
+}
+
+/* The rule as the probe runs it: appended to the scratch chain, and a jump to
+ * a chain the file declares becomes DROP - the question is the matches and
+ * the target module, not the chain. Returns 0 when the line is not a rule. */
+static int reaper_nf_probe_form(const char *line, const char *declared, char *out, size_t len)
+{
+	char buf[4096], key[48], *tok, *save, *prev = NULL, *orig;
+	size_t at;
+	int n, first = 1;
+
+	snprintf(buf, sizeof(buf), "%s", line);
+	tok = strtok_r(buf, " \t\r\n", &save);
+	if (!tok || (strcmp(tok, "-A") && strcmp(tok, "-I")))
+		return 0;
+	if (strtok_r(NULL, " \t\r\n", &save) == NULL)          /* the chain */
+		return 0;
+	at = snprintf(out, len, "-A " REAPER_NF_PROBE_CHAIN);
+	while ((tok = strtok_r(NULL, " \t\r\n", &save)) != NULL) {
+		orig = tok;
+		if (first && strspn(tok, "0123456789") == strlen(tok)) {   /* -I CHAIN <rulenum> */
+			first = 0;
+			continue;
+		}
+		first = 0;
+		if (prev && strcmp(prev, "-j") == 0) {
+			snprintf(key, sizeof(key), "\n%s\n", tok);
+			if (strstr(declared, key))
+				tok = "DROP";
+		}
+		n = snprintf(out + at, len - at, " %s", tok);
+		if (n < 0 || (size_t)n >= len - at)
+			return 0;
+		at += n;
+		prev = orig;
+	}
+	return 1;
+}
