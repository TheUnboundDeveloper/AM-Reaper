+	if ((fp = fopen(REAPER_NF_PROBE_FILE, "w")) == NULL)
+		return 1;
+	fprintf(fp, "*filter\n:" REAPER_NF_PROBE_CHAIN " - [0:0]\n%s\nCOMMIT\n", rule);
+	fclose(fp);
+	argv[0] = v6 ? "ip6tables-restore" : "iptables-restore";
+	argv[1] = "--noflush";
+	argv[2] = REAPER_NF_PROBE_FILE;
+	argv[3] = NULL;
+	ret = _eval(argv, ">/dev/null", 0, NULL);
+	eval(v6 ? "ip6tables" : "iptables", "-F", REAPER_NF_PROBE_CHAIN);
+	eval(v6 ? "ip6tables" : "iptables", "-X", REAPER_NF_PROBE_CHAIN);
+	unlink(REAPER_NF_PROBE_FILE);
+	return ret == 0;
+}
