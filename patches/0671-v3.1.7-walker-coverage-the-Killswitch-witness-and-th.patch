+.wt tbody tr:hover{background:rgba(255,255,255,.022)}
+/* overflow-wrap:anywhere, NOT word-break:break-all. break-all splits at whatever
+   character lands on the edge, which is why the table read "ESTA BLISHED",
+   "ACC EPT" and "u dp": it breaks words that had a perfectly good space to wrap
+   at. `anywhere` wraps at spaces first and only splits a token when the token
+   itself cannot fit - which is what a 60-character iptables rule needs. */
+.wt .rl{font-family:ui-monospace,Consolas,monospace;font-size:11px;color:var(--steel);overflow-wrap:anywhere;line-height:1.45}
+/* the id under the feature name, and the verdict under its pill, are captions
+   for the line above them - not second values competing with it */
+.wt td .rl{margin-top:3px}
+.wt .exp{font-size:11.5px;letter-spacing:.03em;color:var(--bone-dim);white-space:nowrap}
 .wpill{display:inline-block;padding:1px 9px;border-radius:9px;font-size:11px;font-weight:600;letter-spacing:.04em}
 .wpill.g{background:rgba(79,178,134,.16);color:var(--jade)}
 .wpill.r{background:rgba(255,59,48,.16);color:var(--danger)}
