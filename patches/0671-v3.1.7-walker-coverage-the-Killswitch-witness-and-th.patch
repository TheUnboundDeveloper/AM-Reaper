 		     uint64_t up, uint64_t dn, const char *smac)
 {
@@ -1025,6 +1038,35 @@ static void top_note(const char *src, const char *dst, int dport, int proto,
 	uint64_t rate = (up + dn) / FCACHE_SECS;
 	int i, worst = 0;
 	if (rate == 0) return;
+
+	/* v3.1.7 (owner, screenshot): THE ROUTER IS NOT A TALKER. Every open admin
+	 * page holds several parallel connections to lan_ip:8443, so merely looking
+	 * at the traffic page manufactured the traffic the page then reported - and
+	 * because each connection took a slot of its own (below), a browser sitting
+	 * on the dashboard could fill the entire table and evict everything real.
+	 * The per-network view has excluded the Router bucket since it was written
+	 * (`if (nm==="Router") continue`); this is that same rule applied to the one
+	 * place it was missed. DNS and NTP to the router go with it, deliberately:
+	 * "top talkers" means traffic going somewhere, and the network view already
+	 * draws that line in the same spot. */
+	if (top_is_self(dst)) return;
+
+	/* ...and NTOP is 20 SLOTS, which is not the same thing as 20 talkers. One
+	 * conversation opened over eleven parallel connections used to occupy eleven
+	 * of them: a wrong reading (the panel promises a per-destination-port
+	 * bucket, and showed eleven identical rows instead), and a real loss, since
+	 * the genuine talkers those slots would have held never appeared at all.
+	 * Fold by the tuple the panel claims to group by. Safe to accumulate: ntop
+	 * is reset to 0 at the top of every poll, so these sums span one sample. */
+	for (i = 0; i < ntop; i++)
+		if (top[i].dport == dport && top[i].proto == proto &&
+		    !strcmp(top[i].src, src) && !strcmp(top[i].dst, dst)) {
+			top[i].up += up;
+			top[i].dn += dn;
+			top[i].rate += rate;
+			return;
+		}
+
 	if (ntop < NTOP) { i = ntop++; goto put; }
 	for (i = 1; i < NTOP; i++)
 		if (top[i].rate < top[worst].rate) worst = i;
