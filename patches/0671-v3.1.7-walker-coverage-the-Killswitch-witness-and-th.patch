+	int has_limit;
 	char depends[28];
 	char target[36];
 	char targs[160];
@@ -466,7 +656,7 @@ static int parse_rule(struct fw *fw, struct table *t, char *line)
 		else if (!strcmp(o, "--dst-type")) { const char *v = NEXT(); if (!strcmp(v, "LOCAL") && !neg) r->has_addrtype_local = 1; else set_depends(r, "addrtype"); }
 		else if (!strcmp(o, "--src-type")) { (void)NEXT(); set_depends(r, "addrtype"); }
 		else if (!strcmp(o, "--comment")) { (void)NEXT(); }
-		else if (!strcmp(o, "--limit") || !strcmp(o, "--limit-burst")) { (void)NEXT(); }	/* first packet always passes a limit */
+		else if (!strcmp(o, "--limit") || !strcmp(o, "--limit-burst")) { (void)NEXT(); r->has_limit = 1; }	/* first packet always passes a limit */
 		else if (!strcmp(o, "-j") || !strcmp(o, "-g")) {
 			int k;
 			snprintf(r->target, sizeof(r->target), "%s", NEXT());
@@ -844,13 +1034,39 @@ static struct fw *fw_for(int fam) { return fam == 6 ? &fw6 : &fw4; }
 
 static int r_isplain(const struct rule *r);
 
-/* shape predicates: EXISTS t/c  ABSENT t/c  LASTDROP t/c  HASTARGET t/c/T  SKELETON  SETNOT set/addr  SETHAS set/addr */
+/* shape predicates: EXISTS t/c  ABSENT t/c  LASTDROP t/c  HASTARGET t/c/T
+ * MATCHSET t/c/set  LIMITED t/c  BEFORE t/c/setA setB  SKELETON
+ * SETNOT set/addr  SETHAS set/addr  PROHIBIT mark/mask  NOTE <free text> */
 static void eval_shape(struct witness *w)
 {
 	char kind[16], a[80], b[48], t2[12], c2[40], tg[40]; struct fw *fw = fw_for(w->fam); struct table *t; struct chain *ch;
 	kind[0] = a[0] = b[0] = 0;
 	sscanf(w->pred, "%15s %79s %47s", kind, a, b);
 	w->ok = 0;
+	/* NOTE carries prose, not a predicate: it is how a row states that the
+	 * question is outside what a table walk can answer. Always n/a - never
+	 * green (nothing was checked) and never red (nothing is wrong). */
+	if (!strcmp(kind, "NOTE")) {
+		const char *txt = w->pred + 4;
+		while (*txt == ' ') txt++;
+		w->na = 1;
+		snprintf(w->verdict, sizeof(w->verdict), "not checked");
+		snprintf(w->note, sizeof(w->note), "%s", txt);
+		return;
+	}
+	if (!strcmp(kind, "PROHIBIT")) {
+		char *sl = strchr(a, '/'); unsigned mk, mask; const struct iprule *r;
+		int have = (w->fam == 6) ? iprule_loaded6 : iprule_loaded4;
+		if (!sl) { w->na = 1; snprintf(w->note, sizeof(w->note), "bad predicate"); return; }
+		if (!have) { w->na = 1; snprintf(w->note, sizeof(w->note), "no %s rule database", w->fam == 6 ? "ip -6" : "ip -4"); return; }
+		parse_mark(a, &mk, &mask);
