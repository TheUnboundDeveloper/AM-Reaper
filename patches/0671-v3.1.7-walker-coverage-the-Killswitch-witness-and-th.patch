+/* ---- Security posture: refresh on the clock, not on a page reload ----------
+   THE PROBLEM. Every row in the posture card comes from SSI, which is a
+   server-rendered snapshot of ~20 nvram keys taken when the page was built. Open
+   the dashboard while the router is still coming up and the card freezes at
+   whatever was true then - and the Rule Status row is worse than frozen, because
+   the walker stamps its report with time(NULL): before the clock is set that is
+   a boot-epoch time, so the row reads "Checked" with a timestamp from 1970 (or
+   1969 local). Nothing corrects either of them short of a manual F5.
+
+   THE TRIGGER. NTP sync is the right moment to re-read (owner, 2026-09-15): it
+   is the point where the clock becomes true, and on a cold boot it lands after
+   the services whose state this card reports have settled. `ntp_ready` is set to
+   0 by init/ntp restart and to 1 when the clock steps (rc/ntp.c, rc/ntpd.c).
+
+   THE COST, WHICH IS THE POINT. The watcher is armed ONLY if the clock is
+   already unset when the page renders. On a router that has been up for more
+   than a minute - every ordinary page load - `ntp_ready` is already 1, nothing
+   is scheduled, and this costs exactly zero requests for the life of the page.
+   When it IS armed it is self-terminating: it stops on the transition, having
+   fired once. The cap is there for the box that never syncs (no DNS, blocked
+   123/udp) so a clockless router cannot leave a poll running for the session -
+   the same trap the WAN poll documents above. */
+(function(){
+  if(String(SSI.ntp_ready)==='1') return;      /* clock already true: nothing to watch */
+  var EVERY=10000, GIVEUP=30*60*1000, t0=Date.now(), timer=null;
+  function stop(){ if(timer){ clearTimeout(timer); timer=null; } }
+  function done(){
+    stop();
+    /* re-read the posture keys and repaint just this card. pollWit() is called
+       too, not because its data went stale but because its TIMESTAMP did: the
+       cached report it renders was written against the pre-sync clock. */
+    refreshPosture();
+    pollWit();
+  }
+  function tick(){
+    var x=new XMLHttpRequest(), fired=false;
+    function fin(ok){
+      if(fired) return; fired=true;
+      var ready=false;
+      if(ok){ try{ ready=(JSON.parse(x.responseText).ntp_ready==='1'); }catch(e){} }
+      if(ready){ done(); return; }
+      if(Date.now()-t0 > GIVEUP){ stop(); return; }
+      timer=setTimeout(tick, EVERY);
+    }
+    x.open('GET','/appGet.cgi?hook=nvram_get(ntp_ready)&_='+(new Date()).getTime(),true);
+    x.timeout=8000;
+    /* ONE completion path per request (standing rule 34): a failed request fires
+       readystatechange(4, status 0) AND error, and rescheduling from both would
+       double the chain every round. */
+    x.onreadystatechange=function(){ if(x.readyState===4) fin(x.status===200); };
+    x.onerror=x.ontimeout=x.onabort=function(){ fin(false); };
+    x.send();
+  }
+  timer=setTimeout(tick, EVERY);
+})();
+
+/* Re-read the nvram behind the posture card and repaint it. One request for the
+   whole card: appGet.cgi takes a ';'-separated hook list, so this is the same
+   round trip the WAN poll already uses, not twenty of them. The per-radio keys
+   are included because Wi-Fi encryption is a posture row too and a radio that
+   came up after the page did would otherwise stay "off" until a reload. */
+function refreshPosture(){
+  var keys=['fw_enable_x','ipv6_fw_enable','wan0_upnp_enable','wps_enable','qos_enable','qos_type',
+            'sshd_enable','fw_dos_x','http_enable','misc_http_x','enable_cloudsync','jffs2_on',
+            'jffs2_scripts','mld_enable','dns_norebind','dnssec_enable','gk_enable','rwarden_enable'];
+  var i, hook=[];
+  for(i=0;i<keys.length;i++) hook.push('nvram_get('+keys[i]+')');
+  for(i=0;i<WL.length;i++){ hook.push('nvram_get(wl'+WL[i].idx+'_radio)'); hook.push('nvram_get(wl'+WL[i].idx+'_auth_mode_x)'); }
+  var x=new XMLHttpRequest(), fired=false;
+  function fin(ok){
+    if(fired) return; fired=true;
+    if(!ok) return;                                   /* keep the last good paint */
+    var j; try{ j=JSON.parse(x.responseText); }catch(e){ return; }
+    /* SSI keeps its own short names, so the mapping is explicit rather than a
+       loop over j - a renamed nvram key should fail visibly here, not silently
+       blank a row. A key the hook did not return is left at its rendered value. */
+    var map={fw4:'fw_enable_x',fw6:'ipv6_fw_enable',upnp:'wan0_upnp_enable',wps:'wps_enable',
+             qos_en:'qos_enable',qos_type:'qos_type',ssh:'sshd_enable',dos:'fw_dos_x',
+             http_en:'http_enable',wan_admin:'misc_http_x',cloud:'enable_cloudsync',
+             jffs:'jffs2_on',jffs_sc:'jffs2_scripts',mlo:'mld_enable',norebind:'dns_norebind',
+             dnssec:'dnssec_enable',gk:'gk_enable',warden:'rwarden_enable'};
+    for(var k in map){ if(j[map[k]]!=null) SSI[k]=String(j[map[k]]); }
+    for(var w=0; w<WL.length; w++){
+      var r=j['wl'+WL[w].idx+'_radio'], a=j['wl'+WL[w].idx+'_auth_mode_x'];
+      if(r!=null) WL[w].radio=String(r);
+      if(a!=null) WL[w].auth=String(a);
+    }
+    paintPosture();
+  }
+  x.open('GET','/appGet.cgi?hook='+encodeURIComponent(hook.join(';'))+'&_='+(new Date()).getTime(),true);
+  x.timeout=8000;
+  x.onreadystatechange=function(){ if(x.readyState===4) fin(x.status===200); };
+  x.onerror=x.ontimeout=x.onabort=function(){ fin(false); };
+  x.send();
+}
