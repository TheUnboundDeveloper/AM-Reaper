+/* ------------------------------------------------------------------ */
+/* the routing policy database (`ip rule`) - the walker's fourth input  */
+/* ------------------------------------------------------------------ */
+/* The VPN-client Killswitch is the one promise the firewall makes that never
+ * touches iptables: reaper_pbr realises it SOLELY as `ip rule ... prohibit` at
+ * priority 9100+code (9000+code for a BLOCK target). Walking the tables can
+ * therefore never see it, and a Killswitch that silently failed to install is
+ * exactly the failure the feature exists to prevent - so the rule database is
+ * read as an input of its own and witnessed with a predicate of its own.
+ * READ-ONLY, like everything else here: `ip rule show`, nothing more. */
+static void parse_mark(const char *s, unsigned *v, unsigned *m);	/* the ruleset section below */
+
+struct iprule { int fam, pref, has_mark; unsigned mark, mask; char action[16]; char table[36]; };
+static struct iprule *iprules = NULL; static int niprules = 0;
+static int iprule_loaded4 = 0, iprule_loaded6 = 0;
+
+/* "9101:\tfrom all fwmark 0x10000/0xf0000 prohibit"
+ * "9001:\tfrom all fwmark 0x10000/0xf0000 lookup ovpnc1"                 */
+static void load_iprules(const char *path, int fam)
+{
+	FILE *f = fopen(path, "r"); char line[400], *tok[32]; int n, i;
+	if (!f) return;
+	if (fam == 6) iprule_loaded6 = 1; else iprule_loaded4 = 1;
+	while (fgets(line, sizeof(line), f)) {
+		struct iprule r;
+		trim(line);
+		n = tokenize(line, tok, 32);
+		if (n < 2 || !isdigit((unsigned char)tok[0][0])) continue;
+		memset(&r, 0, sizeof(r));
+		r.fam = fam; r.pref = atoi(tok[0]); r.mask = 0xffffffffu;
+		snprintf(r.action, sizeof(r.action), "%s", tok[n-1]);
+		for (i = 1; i < n; i++) {
+			if (!strcmp(tok[i], "fwmark") && i + 1 < n) { parse_mark(tok[++i], &r.mark, &r.mask); r.has_mark = 1; }
+			else if (!strcmp(tok[i], "lookup") && i + 1 < n) { snprintf(r.action, sizeof(r.action), "lookup"); snprintf(r.table, sizeof(r.table), "%s", tok[++i]); }
+		}
+		iprules = xrealloc(iprules, sizeof(*iprules) * (niprules + 1));
+		iprules[niprules++] = r;
+	}
+	fclose(f);
+}
+
+/* the first rule of this family whose fwmark selector covers `mark` and whose
+ * action refuses the packet. prohibit, blackhole and unreachable all fail
+ * closed - which is the promise - so any of the three satisfies it. */
+static const struct iprule *iprule_refuses(int fam, unsigned mark, unsigned mask)
+{
+	int i;
+	for (i = 0; i < niprules; i++) {
+		const struct iprule *r = &iprules[i];
+		if (r->fam != fam || !r->has_mark) continue;
+		if ((r->mark & mask) != (mark & mask) || (r->mask & mask) != mask) continue;
+		if (!strcmp(r->action, "prohibit") || !strcmp(r->action, "blackhole") || !strcmp(r->action, "unreachable")) return r;
+	}
+	return NULL;
+}
+
 /* ------------------------------------------------------------------ */
 /* nvram (real on the router, a key=value file on the host)            */
 /* ------------------------------------------------------------------ */
@@ -287,6 +349,130 @@ static const char *nv_get(const char *k) { return nvram_safe_get((char *)k); }
 #endif
 static int nv_is(const char *k, const char *v) { return strcmp(nv_get(k), v) == 0; }
 
+/* ------------------------------------------------------------------ */
+/* the rules engine's own lists (F1) - '<' between records, '>' between */
+/* fields, exactly as rc/reaper_fw.c documents them.                    */
+/* ------------------------------------------------------------------ */
+static const char *fwlist(const char *key)
+{
+#ifdef FWSIM_HOST
+	/* host mode: the nvram fixture file carries the list under its nvram
+	 * name, so a test can hand us rules without a /jffs store */
+	static char k[64];
+	snprintf(k, sizeof(k), "reaper_fw_%s", key);
+	return nv_get(k);
+#else
+	/* on the router the lists live in the /jffs store - they exceed nvram's
+	 * 1 KB cap - and libshared's reader already does draft > confirmed >
+	 * legacy nvram, which is the same precedence the engine itself applies */
+	char *v = reaper_fw_list_get((char *)key);
+	return v ? v : "";
+#endif
+}
+
+/* the policy-routing rule list, same precedence the engine itself applies
+ * (draft > confirmed > legacy nvram). Read for C6 from the SAVED list rather
+ * than from the live `ip rule` output for the same reason F1 reads the saved
+ * firewall rules: the question is whether what was ASKED for is installed, and
+ * a witness derived from the installed state can only ever agree with itself. */
+static const char *pbrlist(void)
+{
+#ifdef FWSIM_HOST
+	return nv_get("reaper_pbr_rulelist");
+#else
+	char *v = reaper_pbr_rl_get();
+	return v ? v : "";
+#endif
+}
+
+/* copy '>'-separated field `idx` of `rec`. Returns 0 for absent AND for "does
+ * not fit" - the same contract rfw_field() settled on in 2026-08-21, because a
+ * truncated value would otherwise read as "no constraint" and silently widen
+ * the witness. */
+static int rec_field(const char *rec, int idx, char *out, size_t ol)
+{
+	const char *p = rec, *end; int i; size_t n;
+	if (!rec || !out || !ol) return 0;
+	out[0] = 0;
+	for (i = 0; i < idx; i++) { p = strchr(p, '>'); if (!p) return 0; p++; }
+	end = strchr(p, '>');
+	n = end ? (size_t)(end - p) : strlen(p);
+	if (n >= ol) return 0;
+	memcpy(out, p, n); out[n] = 0;
+	return 1;
+}
+
+/* the record in `list` whose field 0 equals `name` */
+static int rec_byname(const char *list, const char *name, char *out, size_t ol)
+{
+	const char *p = list; char nm[72];
+	if (!list || !name || !*name) { if (ol) out[0] = 0; return 0; }
+	while (*p) {
+		const char *e; size_t n;
+		while (*p == '<') p++;
+		if (!*p) break;
+		e = strchr(p, '<');
+		n = e ? (size_t)(e - p) : strlen(p);
+		if (n < ol) {
+			memcpy(out, p, n); out[n] = 0;
+			if (rec_field(out, 0, nm, sizeof(nm)) && !strcmp(nm, name)) return 1;
+		}
+		if (!e) break;
+		p = e;
+	}
+	if (ol) out[0] = 0;
+	return 0;
+}
+
+/* One concrete address for an object, or a MAC when the object IS a MAC.
+ * fqdn and geo objects resolve at RUN time into an ipset, so there is no
+ * literal here to aim a packet at: they return 0 and the rule is skipped
+ * rather than witnessed against a guess. Returns 1 = ip, 2 = mac, 0 = no. */
+static int obj_pick(const char *objs, const char *name, char *ip, size_t il, char *mac, size_t ml)
+{
+	char rec[600], type[16], val[288], *q;
+	ip[0] = 0; mac[0] = 0;
+	if (!rec_byname(objs, name, rec, sizeof(rec))) return 0;
+	if (!rec_field(rec, 1, type, sizeof(type))) return 0;
+	if (!rec_field(rec, 2, val, sizeof(val))) return 0;
+	/* refuse rather than truncate: a cut address is not a narrower witness,
+	 * it is a witness aimed at a DIFFERENT host. Same reason rec_field()
+	 * treats "does not fit" as "absent". */
+	if (!strcmp(type, "mac")) {
+		if (strlen(val) >= ml) return 0;
+		memcpy(mac, val, strlen(val) + 1); return 2;
+	}
+	if (strlen(val) >= il) return 0;
+	if (!strcmp(type, "host")) { memcpy(ip, val, strlen(val) + 1); return 1; }
+	if (!strcmp(type, "range")) { memcpy(ip, val, strlen(val) + 1); if ((q = strchr(ip, '-')) != NULL) *q = 0; return 1; }
+	if (!strcmp(type, "cidr")) {
+		memcpy(ip, val, strlen(val) + 1);
+		if ((q = strchr(ip, '/')) != NULL) *q = 0;
+		/* a network address is a poor probe - an ipset holding the net will
+		 * match it, but a rule written host-wise will not - so aim at .1 */
+		q = strrchr(ip, '.');
+		if (q && !strcmp(q, ".0")) { q[1] = '1'; q[2] = 0; }
+		return 1;
+	}
+	return 0;
+}
+
+/* proto + one port for a service object. "both" probes tcp; icmp has no port
+ * to aim at, so it is skipped rather than witnessed on a made-up one. */
+static int svc_pick(const char *svcs, const char *name, char *proto, size_t pl, char *port, size_t ql)
+{
+	char rec[600], pr[16], po[160], *q;
+	if (!rec_byname(svcs, name, rec, sizeof(rec))) return 0;
+	if (!rec_field(rec, 1, pr, sizeof(pr))) return 0;
+	if (!rec_field(rec, 2, po, sizeof(po))) return 0;
+	if (!strcmp(pr, "icmp")) return 0;
+	snprintf(proto, pl, "%s", !strcmp(pr, "udp") ? "udp" : "tcp");
+	if ((q = strpbrk(po, ",:-")) != NULL) *q = 0;
+	if (strlen(po) >= ql) return 0;			/* same refuse-don't-truncate rule */
+	memcpy(port, po, strlen(po) + 1);
+	return port[0] ? 1 : 0;
+}
+
 /* ------------------------------------------------------------------ */
 /* the ruleset                                                         */
 /* ------------------------------------------------------------------ */
@@ -311,6 +497,10 @@ struct rule {
 	int has_icmp, icmp_neg, icmp_type;
 	int has_dscp, dscp_neg, dscp;
