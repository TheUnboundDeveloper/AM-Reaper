+/* Is this address the router itself? The v4 half is the lan_ip test used all
+ * through poll_fcache; the v6 half is is_self6(). Takes the printed form because
+ * that is what top_note is handed, and it runs at most once per flow per sample. */
+static int top_is_self(const char *ip)
+{
+	struct in_addr a;
+	unsigned char b[16];
+	if (!ip || !*ip) return 0;
+	if (strchr(ip, ':'))
+		return inet_pton(AF_INET6, ip, b) == 1 ? is_self6(b) : 0;
+	return (lan_ip && inet_aton(ip, &a)) ? (ntohl(a.s_addr) == lan_ip) : 0;
+}
+
