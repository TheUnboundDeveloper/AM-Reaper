+			fprintf(f, "%s %s/%d%s\n", own[i].ifname, s, own[i].a.plen, own[i].scope_link ? " (link)" : "");
+		}
+		fclose(f);
+	}
+	fprintf(stderr, "fixture written to %s - review it before sharing\n", dir);
+	return 0;
+}
