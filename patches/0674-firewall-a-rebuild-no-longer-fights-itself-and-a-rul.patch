 release/src/router/rc/gatekeeper.c  |  32 +++++++++
 release/src/router/rc/rdnshc.c      |  17 +++++
 release/src/router/rc/reaper_fw.c   | 102 ++++++++++++++++++++++++++--
 release/src/router/rc/reaper_hook.c |  49 ++++++++++++-
 release/src/router/rc/reaper_hook.h |   9 +++
 release/src/router/rc/rwarden.c     | 101 ++++++++++++++++++++-------
 release/src/router/rc/rwatch.c      |  46 ++++++++++---
 8 files changed, 349 insertions(+), 40 deletions(-)

diff --git a/release/src/router/gkd/gkd.c b/release/src/router/gkd/gkd.c
index ee98c56eb7..fb7492c9db 100644
--- a/release/src/router/gkd/gkd.c
+++ b/release/src/router/gkd/gkd.c
@@ -550,6 +550,38 @@ static void heal_networks(void)
 	pclose(p);
 }
 
+/* 2026-09-17: rules that did not load. apply.sh now retries every add once and
+ * leaves the number that still failed in /tmp/gk/failcount (rc/gatekeeper.c).
+ * A non-zero count with the chains "armed" is the state the r4 boot was in:
+ * present, hooked, and missing an internet-only device's RETURN. Re-apply,
+ * at most once per two minutes and three times per streak, and say so - a
+ * count that never clears is a real error to read in the log, not a loop. */
+static void heal_lost_rules(void)
+{
+	static time_t last = 0;
+	static int strikes = 0, gaveup = 0;
+	FILE *f = fopen(GK_DIR "/failcount", "r");
+	long n = 0;
+	time_t now = time(NULL);
+
+	if (!f) return;
+	if (fscanf(f, "%ld", &n) != 1) n = 0;
+	fclose(f);
+	if (n <= 0) { strikes = 0; gaveup = 0; return; }
+	if (strikes >= 3) {
+		if (!gaveup) {
+			logmessage("gatekeeper", "%ld rule(s) still fail to load after 3 re-applies - giving up until the next Gatekeeper restart; read the 'rule add failed twice' lines", n);
+			gaveup = 1;
+		}
+		return;
+	}
+	if (now - last < 120) return;
+	last = now;
+	strikes++;
+	logmessage("gatekeeper", "%ld rule(s) failed to load in the last apply (a concurrent iptables writer) - re-applying (%d of 3)", n, strikes);
+	system("sh " APPLY_SH);
+}
+
 static void self_heal(void)
 {
 	/* start_firewall rebuilds iptables wholesale (user chains deleted) and
@@ -600,6 +632,7 @@ static void self_heal(void)
 			last_armed = 1;
 		}
 		heal_networks();	/* v2.6.5: only meaningful once the base set is armed */
+		heal_lost_rules();	/* 2026-09-17: armed is not the same as complete */
 		return;
 	}
 	unlink(CHAIN_STAMP);
diff --git a/release/src/router/rc/gatekeeper.c b/release/src/router/rc/gatekeeper.c
index 447c1a67b2..104b01a928 100644
--- a/release/src/router/rc/gatekeeper.c
+++ b/release/src/router/rc/gatekeeper.c
@@ -114,6 +114,22 @@ static void gk_emit_mac(FILE *f, const char *mac, int state, int quarantine)
 		 * the main LAN's AdGuard/Pi-hole, which is exactly a routed br1 -> br0
 		 * flow and must keep working (same intent as the 2026-08-06 bridge
 		 * carve-out below, one layer up). Everything else on-LAN is sealed. */
+		/* 2026-09-17 (owner BE96U, apply-window incident): DNS the ROUTER itself
+		 * redirected. A Service Intercept - or any nat DNAT - that sends port 53 to
+		 * a resolver on ANOTHER network (the owner's AdGuard on its own VLAN) turns
+		 * a query the client addressed to the router into br0 -> br55 FORWARDED
+		 * traffic, and the per-network DROP below took DNS away from every
+		 * internet-only device. The advertised-resolver RETURNs that follow cannot
+		 * see it: the client asked .1, which is INPUT; only the translated packet
+		 * reaches FORWARD. Match the conntrack DNAT state on the ORIGINAL port, so
+		 * this is exactly "a DNS query we chose to redirect" and nothing else,
+		 * whatever port the target listens on. It replaces the out-of-tree
+		 * REAPER_DNSV carve-out that had to sit ahead of the Reaper hook to work,
+		 * and with it the fight over FORWARD position 1 (rc/reaper_hook.h). */
+		fprintf(f, "for T in iptables ip6tables; do\n"
+			   "  $T -A REAPER_GKF -m mac --mac-source %s -p udp -m conntrack --ctstate DNAT --ctorigdstport 53 -j RETURN\n"
+			   "  $T -A REAPER_GKF -m mac --mac-source %s -p tcp -m conntrack --ctstate DNAT --ctorigdstport 53 -j RETURN\n"
+			   "done\n", mac, mac);
 		fprintf(f, "for N in $GKNETS; do\n"
 			   "  gk_net_fields \"$N\"\n"
 			   "  for D in $ND1 $ND2; do\n"
@@ -386,6 +402,21 @@ static void gk_gen_apply(void)
 	fprintf(f, "#!/bin/sh\n"
 		   "# generated by start_gk - do not edit; idempotent (teardown+rebuild)\n"
 		   REAPER_NV_HELPER
+	  /* 2026-09-17 (owner BE96U, v3.1.8_BETA_r4 boot): this iptables 1.4.x has
+	   * no xtables lock, so an add can fail with EAGAIN whenever anything else
+	   * edits the table in the same instant, and this script never checked its
+	   * ~200 adds. Two rules of 126 were lost at boot; one was an internet-only
+	   * device's final RETURN, so it fell to the chain-end DROP and had no
+	   * internet until a re-apply. A lost DROP would be the opposite and worse.
+	   * The three tools are shadowed by functions: an -A/-I is retried once
+	   * after 50 ms, counted and logged if it still fails; every other verb
+	   * (-C/-D/-nL/-F/-X, which fail by design in the idempotent flow) passes
+	   * straight through. The count is left in a file for the watchdog. */
+	  "GK_FAIL=0\n"
+	  "_rt_add() { \"$@\" 2>/dev/null && return 0; usleep 50000 2>/dev/null; \"$@\" 2>/dev/null && return 0; GK_FAIL=$((GK_FAIL+1)); logger -t gatekeeper \"rule add failed twice: $*\"; return 1; }\n"
+	  "iptables()  { case \" $* \" in *\" -A \"*|*\" -I \"*) _rt_add /usr/sbin/iptables \"$@\";;  *) /usr/sbin/iptables \"$@\";; esac; }\n"
+	  "ip6tables() { case \" $* \" in *\" -A \"*|*\" -I \"*) _rt_add /usr/sbin/ip6tables \"$@\";; *) /usr/sbin/ip6tables \"$@\";; esac; }\n"
+	  "ebtables()  { case \" $* \" in *\" -A \"*|*\" -I \"*) _rt_add /usr/sbin/ebtables \"$@\";;  *) /usr/sbin/ebtables \"$@\";; esac; }\n"
 		   "LANIF=\"$(_nv lan_ifname)\"\n"
 		   "LANIP=\"$(_nv lan_ipaddr)\"\n"
 		   /* Admin escape-hatch port. With HTTPS admin present (http_enable != 0) a
@@ -569,6 +600,7 @@ static void gk_gen_apply(void)
 		    * re-apply when a bridge's delegated prefix changes */
 		   "{ for N in $GKNETS; do gk_net_fields \"$N\"; gk_v6pfx \"$NIF\"; done; } 2>/dev/null | sort -u | tr '\\n' ' ' > " GK_DIR "/v6pfx\n"
 		   "# offloaded flows must re-traverse the fresh rules\n"
+		   "echo $GK_FAIL > " GK_DIR "/failcount\n"
 		   "fc flush 2>/dev/null\n"
 		   /* v2.8.5: a script's exit status is its LAST command's, and
 		    * start_gk()/gk_refresh() read any non-zero as the cold-boot LAN
diff --git a/release/src/router/rc/rdnshc.c b/release/src/router/rc/rdnshc.c
index dd0d988047..f0abb3433f 100644
--- a/release/src/router/rc/rdnshc.c
+++ b/release/src/router/rc/rdnshc.c
@@ -344,6 +344,20 @@ static int demote(const struct hc_cfg *c, int *changed)
 	return nup;
 }
 
+/* 2026-09-17: the rules engine's resolver-health gate (rc/reaper_fw.c,
+ * RFW_HCGATE): an intercept aimed at the watched resolver is closed while it
+ * is demoted and reopened when it answers again, so redirected DNS fails OPEN
+ * to dnsmasq instead of into a dead host. The script reads HC_STATE itself
+ * and runs under the firewall lock like every other Reaper rule change. */
+static void hc_gate(void)
+{
+	int lock;
+	if (!f_exists("/tmp/reaper_fw/hcgate.sh")) return;
+	lock = file_lock("firewall");
+	system("sh /tmp/reaper_fw/hcgate.sh");
+	file_unlock(lock);
+}
+
 static void restore(void)
 {
 	update_resolvconf();	/* takes the resolv lock itself; rebuilds both files in stock order */
@@ -415,6 +429,7 @@ int rdnshc_main(int argc, char *argv[])
 			logmessage(HC_TAG, "DNS Health Check RESTORED %s to its stock place in the router's DNS list: %s", watched, enabled ? "a different server is being watched now" : "the check was switched off");
 			down = 0; misses = hits = 0; since = 0;
 			unlink(HC_STATE);
+			hc_gate();
 		}
 
 		if (!enabled) {
@@ -461,6 +476,7 @@ int rdnshc_main(int argc, char *argv[])
 			down = 1; since = now_s(); hits = 0;
 			nup = demote(&c, &changed);
 			f_write_string(HC_STATE, c.target, 0, 0);
+			hc_gate();
 			if (nup <= 1)
 				logmessage(HC_TAG, "DNS Health Check FAILOVER: %s is down (%d misses) but it is the only upstream in the router's DNS list - nothing to fall back to, queries keep going to it", c.target, misses);
 			else
@@ -469,6 +485,7 @@ int rdnshc_main(int argc, char *argv[])
 			down = 0; misses = 0;
 			restore();
 			unlink(HC_STATE);
+			hc_gate();
 			logmessage(HC_TAG, "DNS Health Check RESTORED: %s is answering again (%d hits) after %ld s down - back in its stock place in the router's DNS list, dnsmasq reloaded", c.target, hits, now_s() - since);
 			since = now_s();
 		} else if (down) {
diff --git a/release/src/router/rc/reaper_fw.c b/release/src/router/rc/reaper_fw.c
index 60dc4a9e9a..f601ad484d 100644
--- a/release/src/router/rc/reaper_fw.c
+++ b/release/src/router/rc/reaper_fw.c
@@ -101,12 +101,16 @@
 #include "rc.h"
 #include <shared.h>
 #include "reaper_hook.h"
+#include <arpa/inet.h>
 #include "reaper_nv.h"	/* _nv: nvram get with a 5 s ceiling (security review 2026-08-22 F2) */
 
 #define RFW_DIR      "/tmp/reaper_fw"
 #define RFW_APPLY    RFW_DIR "/apply.sh"          /* idempotent teardown+build (committed set) */
 #define RFW_FAILCOUNT RFW_DIR "/failcount"    /* P2-H3: rules that did not load */
 #define RFW_CAND     RFW_DIR "/candidate.sh"      /* the armed candidate (staged set) */
+#define RFW_HCGATE   RFW_DIR "/hcgate.sh"         /* 2026-09-17: resolver-health gate on DNS intercepts (rc/rdnshc.c runs it) */
+#define RFW_CHAIN_HC "REAPER_FWHC"                /* nat: intercepts aimed at the watched resolver, closed while /tmp/rdnshc.state exists */
+#define RFW_HC_STATE "/tmp/rdnshc.state"          /* rc/rdnshc.c HC_STATE: present while the watched resolver is demoted */
 /* RFW_SETS (object sets ONLY - policy routing with the firewall engine off) is
  * defined in rc.h: reaper_pbr's apply.sh runs it too. */
 #define RFW_CC       RFW_DIR "/cc_check.sh"       /* cru-run deadline checker */
@@ -1593,12 +1597,35 @@ static void rfw_emit_edef(FILE *f, const rfw_cfg_t *c, int v6)
  * path translates the packet and then drops it - the classic "port forward does
  * nothing" bug. They are emitted together so they cannot drift apart.
  * ------------------------------------------------------------------------- */
+/* 2026-09-17: which intercept target, if any, is the resolver rdnshc watches.
+ * An intercept aimed at it is emitted into REAPER_FWHC, a chain rdnshc can
+ * close with one RETURN when that resolver is down, so redirected DNS fails
+ * OPEN to the router's own dnsmasq instead of into a dead host. This is the
+ * in-tree form of the owner's /jffs reaper_dnsi watcher (Variant A, 2026-09-08),
+ * which the firewall rebuild wiped and a 5-second poll restored. */
+static char rfw_hc_ports[256];	/* " proto:port" per gated record, for the conntrack flush in hcgate.sh */
+
+static int rfw_hc_target(char *out, size_t n)
+{
+	struct in_addr a;
+	const char *p;
+	if (nvram_get_int("reaper_dnshc_enable") != 1) return 0;
+	p = nvram_safe_get("reaper_dnshc_target");
+	if (!*p || inet_pton(AF_INET, p, &a) != 1) return 0;
+	if (!inet_ntop(AF_INET, &a, out, n)) return 0;
+	return 1;
+}
+
 static void rfw_emit_nat(FILE *f, const rfw_cfg_t *c)
 {
 	char *dup, *tok, *save = NULL;
 	int n = 0;
+	char hct[INET_ADDRSTRLEN] = "";
+	int hc, hcjump = 0;
 
+	rfw_hc_ports[0] = 0;
 	if (!c->nat || !*c->nat) return;
+	hc = rfw_hc_target(hct, sizeof(hct));
 	if (!(dup = strdup(c->nat))) return;
 
 	for (tok = strtok_r(dup, "<", &save); tok; tok = strtok_r(NULL, "<", &save)) {
@@ -1614,6 +1641,8 @@ static void rfw_emit_nat(FILE *f, const rfw_cfg_t *c)
 		char exfrag[512] = "", selffrag[160] = "";
 		rfw_setname_t exsets[RFW_MAX_SETS];
 		int nif = 0, nex = 0, ifi, fwdmode, redir;
+		int gated = 0;
+		const char *natch = RFW_CHAIN_NAT;
 
 		if (++n > RFW_MAX_NAT) {
 			logmessage("reaper_fw", "more than %d forwards - the rest are IGNORED", RFW_MAX_NAT);
@@ -1760,6 +1789,24 @@ static void rfw_emit_nat(FILE *f, const rfw_cfg_t *c)
 		}
 		rfw_sched_frag(sched, schedfrag, sizeof(schedfrag));
 
+		/* 2026-09-17: an intercept aimed at the resolver rdnshc watches goes into
+		 * the gated chain (rfw_hc_target); the jump from REAPER_FWN sits where the
+		 * first such record sits, so the operator's order is kept. */
+		gated = (!fwdmode && !redir && hc && strcmp(iip, hct) == 0);
+		natch = gated ? RFW_CHAIN_HC : RFW_CHAIN_NAT;
+		if (gated) {
+			char pp[48];
+			if (!hcjump) {
+				fprintf(f, "RFWR iptables -t nat -A " RFW_CHAIN_NAT " -j " RFW_CHAIN_HC "\n");
+				hcjump = 1;
+			}
+			if (!strchr(eport, ':')) {	/* a single port: conntrack -D --dport takes no range */
+				snprintf(pp, sizeof(pp), " %s:%s", proto, eport);
+				if (strlen(rfw_hc_ports) + strlen(pp) < sizeof(rfw_hc_ports))
+					strcat(rfw_hc_ports, pp);
+			}
+		}
+
 		if (!strcmp(proto, "both")) { protos[0] = "tcp"; protos[1] = "udp"; nproto = 2; }
 		else                        { protos[0] = proto; }
 
@@ -1778,10 +1825,10 @@ static void rfw_emit_nat(FILE *f, const rfw_cfg_t *c)
 						snprintf(srcfrag, sizeof(srcfrag), " -m set --match-set %s src", sets[si].name);
 
 					if (logf[0] == '1')
-						fprintf(f, "%sRFWR iptables -t nat -A " RFW_CHAIN_NAT
+						fprintf(f, "%sRFWR iptables -t nat -A %s"
 						           " -i %s -p %s --dport %s%s%s%s%s"
 						           " -j LOG --log-prefix \"REAPER-%s \" --log-level 6\n",
-						        guard, ifx, protos[pv], eport, selffrag, exfrag, srcfrag, schedfrag,
+						        guard, natch, ifx, protos[pv], eport, selffrag, exfrag, srcfrag, schedfrag,
 						        fwdmode ? "FWD" : "ICPT");
 
 					if (redir)
@@ -1790,10 +1837,10 @@ static void rfw_emit_nat(FILE *f, const rfw_cfg_t *c)
 						           " -j REDIRECT --to-ports %s\n",
 						        guard, ifx, protos[pv], eport, exfrag, srcfrag, schedfrag, toport);
 					else
-						fprintf(f, "%sRFWR iptables -t nat -A " RFW_CHAIN_NAT
+						fprintf(f, "%sRFWR iptables -t nat -A %s"
 						           " -i %s -p %s --dport %s%s%s%s%s"
 						           " -j DNAT --to-destination %s:%s\n",
-						        guard, ifx, protos[pv], eport, selffrag, exfrag, srcfrag, schedfrag,
+						        guard, natch, ifx, protos[pv], eport, selffrag, exfrag, srcfrag, schedfrag,
 						        iip, toport);
 
 					/* The companion filter ACCEPT, keyed on the TRANSLATED
@@ -1971,6 +2018,8 @@ static int rfw_gen_apply(const char *path, const rfw_cfg_t *c, int teardown_only
 	  "while iptables -t nat -D PREROUTING -j " RFW_CHAIN_NAT " 2>/dev/null; do :; done\n"
 	  "iptables -t nat -F " RFW_CHAIN_NAT " 2>/dev/null\n"
 	  "iptables -t nat -X " RFW_CHAIN_NAT " 2>/dev/null\n"
+	  "iptables -t nat -F " RFW_CHAIN_HC " 2>/dev/null\n"
+	  "iptables -t nat -X " RFW_CHAIN_HC " 2>/dev/null\n"
 	  /* and the intercept return path, in POSTROUTING. This runs on the
 	   * teardown AND rollback paths: a MASQUERADE left behind after an
 	   * auto-revert would keep rewriting the source address of traffic to a
@@ -2049,6 +2098,7 @@ static int rfw_gen_apply(const char *path, const rfw_cfg_t *c, int teardown_only
 	if (c->nat && *c->nat)
 		fprintf(f, "iptables -t nat -N " RFW_CHAIN_NAT " 2>/dev/null; "
 		           "RFWH iptables -t nat -F " RFW_CHAIN_NAT "\n"
+		           "iptables -t nat -N " RFW_CHAIN_HC " 2>/dev/null; RFWH iptables -t nat -F " RFW_CHAIN_HC "\n"
 		           "iptables -t nat -N " RFW_CHAIN_MASQ " 2>/dev/null; "
 		           "RFWH iptables -t nat -F " RFW_CHAIN_MASQ "\n\n");
 
@@ -2086,7 +2136,11 @@ static int rfw_gen_apply(const char *path, const rfw_cfg_t *c, int teardown_only
 		            * MASQUERADE must run after the stock WAN masquerade has had
 		            * its say, and it only matches traffic already aimed at an
 		            * intercept target, so it cannot shadow anything. */
-		           "RFWH iptables -t nat -A POSTROUTING -j " RFW_CHAIN_MASQ "\n\n");
+		           "RFWH iptables -t nat -A POSTROUTING -j " RFW_CHAIN_MASQ "\n"
+		           /* 2026-09-17: the gate. Closed (one RETURN at its head) while
+		            * rdnshc has the watched resolver demoted; hcgate.sh toggles it
+		            * on FAILOVER / RESTORED so the intercept fails OPEN. */
+		           "[ -e " RFW_HC_STATE " ] && iptables -t nat -nL " RFW_CHAIN_HC " >/dev/null 2>&1 && RFWR iptables -t nat -I " RFW_CHAIN_HC " 1 -j RETURN\n\n");
 
 	/* ---- sweep sets belonging to objects that no longer exist ----
 	 * after the chains are rebuilt, so nothing still in use is destroyed. */
@@ -2119,6 +2173,44 @@ static int rfw_gen_apply(const char *path, const rfw_cfg_t *c, int teardown_only
 	  "fi\n");
 	fclose(f);
 	if (rename(tmp, path) != 0) { unlink(tmp); return 0; }
+	/* 2026-09-17: the gate script rdnshc runs (under the firewall lock) when the
+	 * watched resolver goes down or comes back. Direction comes from the state
+	 * file, so no caller can get it wrong; a flush of the intercepted ports'
+	 * conntrack entries makes the switch take effect for queries in flight.
+	 * Every LIVE ruleset owns it - the committed apply, the armed candidate
+	 * (confirm renames candidate.sh into apply.sh without regenerating, so the
+	 * candidate must already have written it) and the rollback script (which
+	 * rebuilds the last-good chains); only the dry-run preview does not. No
+	 * gated record = no script. */
+	if (!teardown_only && strcmp(path, RFW_PREVIEW) != 0) {
+		if (!rfw_hc_ports[0])
+			unlink(RFW_HCGATE);
+		else if ((f = fopen(RFW_HCGATE ".tmp", "w")) != NULL) {
+			fprintf(f,
+			  "#!/bin/sh\n"
+			  "# generated by reaper_fw - do not edit. Closes/opens the resolver-health gate on DNS intercepts (see rc/rdnshc.c).\n"
+			  "iptables -t nat -nL " RFW_CHAIN_HC " >/dev/null 2>&1 || exit 0\n"
+			  "if [ -e " RFW_HC_STATE " ]; then\n"
+			  "  iptables -t nat -C " RFW_CHAIN_HC " -j RETURN 2>/dev/null && exit 0\n"
+			  "  iptables -t nat -I " RFW_CHAIN_HC " 1 -j RETURN\n"
+			  "  logger -t reaper_fw \"intercept gate CLOSED: the watched resolver is down (rdnshc) - intercepted ports%s fall through to the router's own DNS until it answers again\"\n"
+			  "else\n"
+			  "  iptables -t nat -C " RFW_CHAIN_HC " -j RETURN 2>/dev/null || exit 0\n"
+			  "  while iptables -t nat -D " RFW_CHAIN_HC " -j RETURN 2>/dev/null; do :; done\n"
+			  "  logger -t reaper_fw \"intercept gate OPEN: the watched resolver answers again (rdnshc) - intercepted ports%s are redirected once more\"\n"
+			  "fi\n"
+			  "CT=$(which conntrack 2>/dev/null)\n"
+			  "[ -n \"$CT\" ] || exit 0\n"
