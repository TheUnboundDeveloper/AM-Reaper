From f97d172a94fa6d45606504856b596ab864e67fd2 Mon Sep 17 00:00:00 2001
From: reaper <theunbounddeveloper@outlook.com>
Date: Thu, 17 Sep 2026 13:29:50 -0400
Subject: [PATCH] reaper_fwsim: the WAN-bound witness destination is a
 candidate list

1.1.1.1:443 was a constant, and the moment the operator blocked DNS-over-HTTPS
to Cloudflare every "reaches the WAN" row went red (24 on the owner's box),
decided by that block instead of the feature it asked about. wandst_pick()
mirrors wansrc_pick(): every destination set in the live tables is probed and
the first unclaimed candidate is used (1.1.1.1 first, so fixtures are
unchanged), reported as wandst/wandst_note. The static catalog rows A1, A2 and
A9 carried the address as text and now use $WANDST.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 .../src/router/reaper_fwsim/reaper_fwsim.c    | 66 ++++++++++++++++---
 .../src/router/reaper_fwsim/witness.static    |  6 +-
 2 files changed, 60 insertions(+), 12 deletions(-)

diff --git a/release/src/router/reaper_fwsim/reaper_fwsim.c b/release/src/router/reaper_fwsim/reaper_fwsim.c
index 6e46a20863..27fc2810dd 100644
--- a/release/src/router/reaper_fwsim/reaper_fwsim.c
+++ b/release/src/router/reaper_fwsim/reaper_fwsim.c
@@ -1577,6 +1577,52 @@ static const char *wansrc_pick(int fam)
 	snprintf(why, 120, "every candidate source is in a source set - WAN rows witness from %s", cand[0]);
 	return cand[0];
 }
+/* 2026-09-17: the WAN-side witness DESTINATION, by the same reasoning as the
+ * source above. 1.1.1.1:443 was a constant, and the moment the operator
+ * blocked DNS-over-HTTPS to Cloudflare - a destination set holding 1.1.1.1
+ * and 1.0.0.1, ports 443/853 - every "reaches the WAN" row went red at once
+ * (24 on the owner's box), decided by that block instead of the feature it
+ * asked about. Every set the live tables match on the DESTINATION side is
+ * collected and the first candidate no set claims is used. 1.1.1.1 stays
+ * first, so a box that does not block it keeps the fixtures' exact witness
+ * text; the alternatives are other public resolvers and the documentation
+ * ranges. Same non-bypass argument as the source: a row that MEANS "to a
+ * blocked destination" names its own address and never uses this. */
+static char wandst_why[120];
+static const char *wandst_pick(void)
+{
+	static const char *c4[] = { "1.1.1.1", "9.9.9.9", "8.8.8.8", "208.67.222.222", "198.51.100.7", "203.0.113.99" };
+	const int nc = 6;
+	struct fw *fw = &fw4; char *why = wandst_why;
+	char sets[32][40]; int ns = 0, ci, si, ti, tj, tk;
+	struct addr a;
+
+	why[0] = 0;
+	for (ti = 0; ti < fw->nt; ti++) {
+		struct table *t = &fw->t[ti];
+		for (tj = 0; tj < t->n; tj++) {
+			struct chain *ch = &t->c[tj];
+			for (tk = 0; tk < ch->n; tk++) {
+				struct rule *r = &ch->r[tk];
+				if (!r->has_set || r->set_dir != 2 || r->set_neg) continue;
+				for (si = 0; si < ns; si++) if (!strcmp(sets[si], r->set)) break;
+				if (si < ns || ns >= 32) continue;
+				snprintf(sets[ns++], sizeof(sets[0]), "%s", r->set);
+			}
+		}
+	}
+	for (ci = 0; ci < nc; ci++) {
+		int claimed = 0;
+		if (addr_parse(c4[ci], 4, &a) != 0) continue;
+		for (si = 0; si < ns && !claimed; si++) if (set_test(sets[si], &a)) claimed = 1;
+		if (!claimed) {
+			if (ci) snprintf(why, 120, "%s is in a destination set - WAN-bound rows witness to %s", c4[0], c4[ci]);
+			return c4[ci];
+		}
+	}
+	snprintf(why, 120, "every candidate destination is in a destination set - WAN-bound rows witness to %s", c4[0]);
+	return c4[0];
+}
 /* The admin access restriction also gates WAN web/SSH: the first enabled v4
  * entry OUTSIDE the LAN is the only WAN address the admin allowed. */
