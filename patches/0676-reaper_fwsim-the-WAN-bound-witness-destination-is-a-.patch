 	if (lan4) { addr_str(lan4, rtr, sizeof(rtr)); host_in_subnet(lan4, 123, lanhost, sizeof(lanhost)); lanhost_pick(lan4, lanhost, sizeof(lanhost)); sub_set("RTR", rtr); sub_set("LANHOST", lanhost); }
 	else { rtr[0] = lanhost[0] = 0; }
