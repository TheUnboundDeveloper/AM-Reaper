-				wit_pkt(id, feat, 4, lan_ifname, lanhost, "1.1.1.1", "tcp", "443", "NEW", "DROP", "", r->mac);
+				wit_pkt(id, feat, 4, lan_ifname, lanhost, wandst, "tcp", "443", "NEW", "DROP", "", r->mac);
