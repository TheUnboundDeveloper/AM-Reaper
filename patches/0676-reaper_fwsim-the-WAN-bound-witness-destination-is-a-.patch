 			snprintf(id, sizeof(id), "G2.%d", k); snprintf(feat, sizeof(feat), "Guest network %s: reaches the WAN", own[i].ifname);
-			wit_pkt(id, feat, 4, own[i].ifname, gh, "1.1.1.1", "tcp", "443", "NEW", "ACCEPT", "", lanmac);
+			wit_pkt(id, feat, 4, own[i].ifname, gh, wandst, "tcp", "443", "NEW", "ACCEPT", "", lanmac);
 			snprintf(id, sizeof(id), "G4.%d", k); snprintf(feat, sizeof(feat), "Guest network %s: DNS at its gateway", own[i].ifname);
