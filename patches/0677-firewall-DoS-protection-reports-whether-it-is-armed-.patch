 /* =================== init + wiring =================== */
+/* 2026-09-17 field ("DoS protection not enabled when toggled on"): the engine hooks
+   the SECURITY chain only while the firewall master switch is on (and the box
+   routes), so a DoS toggle under a switched-off firewall saves fine and arms
+   nothing. Dim it and say why; the status strip below reads the armed state. */
+function dosGate(){
+  var fe=document.querySelector('.tg[data-nv="fw_enable_x"]'),fd=document.querySelector('.tg[data-nv="fw_dos_x"]');
+  if(!fe||!fd)return;
+  var off=!fe.classList.contains('on');
+  fd.classList.toggle('dis',off);
+  if(off)fd.title=`<#RFW_321#>`;else fd.removeAttribute('title');
+}
 function initToggles(){
   Array.prototype.slice.call(document.querySelectorAll('.tg[data-nv]')).forEach(function(el){
     tgSet(el,NV[el.getAttribute('data-nv')]==='1');
-    el.onclick=function(){el.classList.toggle('on');};
+    el.onclick=function(){el.classList.toggle('on');if(el.getAttribute('data-nv')==='fw_enable_x')dosGate();};
   });
+  dosGate();
 }
 function initGeneral(){
   $('g_log').value=NV.fw_log_x||'none';
