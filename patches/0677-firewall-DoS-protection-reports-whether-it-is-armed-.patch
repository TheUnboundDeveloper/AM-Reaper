index 95152d54f4..383f5e1d17 100644
--- a/release/src/router/httpd/web.c
+++ b/release/src/router/httpd/web.c
@@ -24166,11 +24166,14 @@ do_reaper_fw_cgi(char *url, FILE *stream)
 		v6up = ipv6_enabled() ? 1 : 0;
 #endif
 		websWrite(stream,
-			"{\"ok\":1,\"fw\":{\"enable\":%d,\"dos\":%d,\"ping\":%d,"
+			"{\"ok\":1,\"fw\":{\"enable\":%d,\"dos\":%d,\"dos_armed\":%d,\"ping\":%d,"
 			"\"wl\":%d,\"lw\":%d,\"url\":%d,\"kw\":%d,"
 			"\"v6up\":%d,\"v6fw\":%d,\"gk\":%d,\"warden\":%d,\"wlog\":%d,\"log\":",
 			nvram_match("fw_enable_x", "1") ? 1 : 0,
 			nvram_match("fw_dos_x", "1") ? 1 : 0,
+			/* 2026-09-17 field: the setting is not the state - rc/firewall.c hooks
+			 * SECURITY only when fw_enable_x is also on, and never in AP mode */
+			(nvram_match("fw_dos_x", "1") && nvram_match("fw_enable_x", "1") && nvram_get_int("sw_mode") == 1) ? 1 : 0,
 			nvram_match("misc_ping_x", "1") ? 1 : 0,
 			nvram_match("fw_wl_enable_x", "1") ? 1 : 0,
 			nvram_match("fw_lw_enable_x", "1") ? 1 : 0,
diff --git a/release/src/router/reaper_fwsim/reaper_fwsim.c b/release/src/router/reaper_fwsim/reaper_fwsim.c
index 27fc2810dd..cf381740ec 100644
--- a/release/src/router/reaper_fwsim/reaper_fwsim.c
+++ b/release/src/router/reaper_fwsim/reaper_fwsim.c
@@ -2356,6 +2356,15 @@ static void gen_witnesses(void)
 	 * any single packet's point of view. */
 	if (nv_is("sw_mode", "1"))
 		wit_shape("H1", "Flood guard: the SECURITY chain is rate limited", 4, "LIMITED filter/SECURITY", "OK");
+	/* H1b - 2026-09-17 field ("DoS protection not enabled when toggled on"). H1
+	 * looks at the chain's own rules, which are always emitted; the HOOK is what
+	 * rc/firewall.c withholds while the firewall master switch is off. So when
+	 * the setting says on, the row asks the table whether the WAN actually
+	 * jumps to the guard - and names the master switch when it cannot. */
+	if (nv_is("sw_mode", "1") && nv_is("fw_dos_x", "1"))
+		wit_shape("H1b", nv_is("fw_enable_x", "1") ? "DoS protection: the SECURITY guard is hooked on the WAN"
+		          : "DoS protection is switched on but the firewall master switch is off, so nothing hooks the guard",
+		          4, "HASTARGET filter/FORWARD/SECURITY", "OK");
 
 	/* H6 - the honesty row. The page should say what it does NOT know, in the
 	 * same list as everything it does, rather than leaving a reader to assume
@@ -2406,7 +2415,7 @@ static const char *dump_keys[] = {
 	"sw_mode", "lan_ifname", "lan_ipaddr", "wan0_ifname", "wan0_proto",
 	"wan0_pppoe_ifname", "wan0_ipaddr", "wan1_primary", "wan1_ifname", "wan1_proto", "wan1_pppoe_ifname",
 	"dmz_ip", "sdn_access_rl",
-	"https_lanport", "misc_http_x", "misc_httpsport_x", "misc_ping_x",
+	"https_lanport", "misc_http_x", "misc_httpsport_x", "misc_ping_x", "fw_enable_x", "fw_dos_x",
 	"sshd_enable", "sshd_wan", "sshd_port",
 	"vts_enable_x", "vts_rulelist",
 	"gk_enable", "gk_default", "rwarden_enable", "rwarden_dir", "rwarden_geo",
