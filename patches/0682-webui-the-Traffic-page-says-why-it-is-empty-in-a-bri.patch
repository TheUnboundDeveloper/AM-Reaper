--- a/release/src/router/www/Reaper_Traffic.asp
+++ b/release/src/router/www/Reaper_Traffic.asp
@@ -62,6 +62,8 @@ a{color:var(--bone-dim)} a:hover{color:var(--bone)}
 .grid{display:grid;grid-template-columns:1fr 1fr;gap:16px}
 @media(max-width:1100px){.grid{grid-template-columns:1fr}}
 .panel{background:var(--panel);border:1px solid var(--line-soft);border-radius:14px;padding:16px 18px;margin-bottom:16px}
+.opnote{border:1px solid var(--line-soft);border-left:3px solid var(--amber);background:var(--panel);
+  color:var(--bone-dim);border-radius:10px;padding:12px 15px;margin-bottom:16px;font-size:12.5px;line-height:1.55}
 .panel.span{grid-column:1/-1}
 .panel h2{font-size:14px;font-weight:700;text-transform:uppercase;letter-spacing:.12em;margin-bottom:2px}
 .panel .sub{font-size:12px;color:var(--steel);margin:2px 0 12px;line-height:1.5}
@@ -158,6 +160,8 @@ table.ta .num{text-align:right;font-variant-numeric:tabular-nums;color:var(--bon
   <button type="button" class="btn ghost" onclick="gotoSettings()"><#Settings#></button>
 </div>
 
+<div class="opnote" id="opnote" style="display:none"></div>
+
 <div class="tiles" id="tiles"></div>
 
 <div class="wins" id="wins">
@@ -296,6 +300,22 @@ function classGate(){
   }
   return on;
 }
+/* rtrafd is deliberately not started outside a routing mode: start_rtraf() returns at
+   !is_routing_enabled() (services.c), which is sw_mode 2 and 3 - and per-device accounting
+   off a conntrack table a bridging box never populates would report nothing whatever it did.
+   Say so rather than leaving the page silently blank. The decision reads sw_mode alone, the
+   same value the daemon's own guard reads; get_operation_mode() only supplies the name. An
+   unreadable sw_mode shows no note rather than one that may be wrong. */
+var SWMODE = '<% nvram_get("sw_mode"); %>';
+var OPMODE = [<% get_operation_mode(); %>][0];
+var OPNAMES = {rp:`<#Clientlist_Repeater#>`,ap:`<#Device_type_03_AP#>`,mb:`<#OP_MB_item#>`,ew2:`<#RDSH_30#>`,ew5:`<#RDSH_31#>`};
+function opmodeGate(){
+  if(SWMODE!=='2' && SWMODE!=='3') return true;
+  var el=document.getElementById('opnote');
+  el.textContent = `<#RTRF_77#>`.replace('%1', OPNAMES[OPMODE]||`<#Device_type_03_AP#>`);
+  el.style.display='';
+  return false;
+}
 var CLSCOLOR = ['#71767b','#3987e5','#199e70','#c98500','#9085e9','#d95926','#e66767'];
 var CLSNAME  = (decodeURIComponent('<% nvram_char_to_ascii("", "qos_class_names"); %>')||'Q1,Q2,Q3,Q4,Q5').split(',');
 var NETCOLOR = ['#3987e5','#199e70','#c98500','#9085e9','#d95926','#e66767','#d55181','#71767b'];
@@ -828,6 +848,7 @@ document.getElementById('tg_enable').checked = (NV.enable!=='0');
   document.getElementById('set_path_ro').textContent = LOC[NV.path||''] || LOC['']; })();
 document.getElementById('set_probe').value = NV.probe||'';
 document.getElementById('set_cap').value = NV.cap||'0';
+opmodeGate();
 loadWin();
 </script>
 </body>
diff --git a/release/src/router/www/SL.dict b/release/src/router/www/SL.dict
index 94d3a9ea9f..f443b61e25 100644
--- a/release/src/router/www/SL.dict
+++ b/release/src/router/www/SL.dict
@@ -6938,7 +6938,6 @@ RFW_314=Deciding rule
 RFW_315=No witnesses were generated for this configuration.
 RFW_316=Firewall witnesses against the ruleset that is live now:
 RFW_317=unsuccessful
-RFW_318=open Rule Status
 RFW_319=Advisory
 RFW_320=Advisory only. This tab reports what the live tables do with each feature's witness packets. A row marked Unsuccessful is something to check, not a fault the router has confirmed - the witness address or a match the walker does not model can be the reason - and nothing here changes a rule.
 RSYS_00=System Information
@@ -6985,3 +6984,4 @@ RSYS_40=IP address
 RSYS_41=headroom
 RFW_321=not armed: the firewall master switch is off (or the router is in access-point mode)
 RFW_322=Stand-in addresses, used to walk the rules - not devices on your network
+RTRF_77=Per-device accounting is not available in %1 mode. The Traffic Analyzer accounts from the connection tracking table, which a bridging router never populates, so the collector is deliberately left idle. This is not a fault.
