From cbea8928f68e30cc611cb82efc0f88116243d963 Mon Sep 17 00:00:00 2001
From: reaper <theunbounddeveloper@outlook.com>
Date: Sat, 19 Sep 2026 13:07:13 -0400
Subject: [PATCH] version: Reaper_v3.2.0

Version stamp for the v3.2.0 rung: the Professional page drops WiFi 7 Mode and Wireless Mode, the Traffic page names the operation mode when per-device accounting is idle in a bridging mode, and the Storage and Analytics help buttons point at the live guide heading.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 release/src-rt/version.conf | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/release/src-rt/version.conf b/release/src-rt/version.conf
index 8c6ae9a44c..2859216032 100644
--- a/release/src-rt/version.conf
+++ b/release/src-rt/version.conf
@@ -4,6 +4,6 @@ KERNEL_VER_AM=$(subst .,,$(KERNEL_VER))
 FS_VER_AM=$(subst .,,$(FS_VER))
 
 SERIALNO=102.8
-EXTENDNO=Reaper_v3.1.9
+EXTENDNO=Reaper_v3.2.0
 
 RCNO=0
