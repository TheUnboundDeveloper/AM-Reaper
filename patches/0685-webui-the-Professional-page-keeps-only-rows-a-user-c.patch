From 5f9bc5bf75fad45c84b73033203d840bc17aa1f1 Mon Sep 17 00:00:00 2001
From: reaper <theunbounddeveloper@outlook.com>
Date: Sat, 19 Sep 2026 17:52:48 -0400
Subject: [PATCH] webui: the Professional page keeps only rows a user can
 safely change, and links the ones other tabs also drive

Rows removed (owner ruling): WMM (bring-up forces it on in Auto, the only
mode now), MU-MIMO (derived from the OFDMA choice at apply, as stock does),
explicit/universal beamforming, modulation scheme, AMPDU aggregation and
Bluetooth coexistence (stock hides all of them on Wi-Fi 7; rc consumes several).
Roaming assistant takes stock's range, -90..-40 with 0 = off.

Links to the surfaces that also drive a radio: the MLO tab (a radio that is on
cannot be switched off while mld_enable=1, stock check_mlo_status parity), the
wireless scheduler (a scheduled radio wears a chip; wlN_timesched added to the
httpd snapshot, read-only), AiMesh (Apply confirms before a radio goes 1->0).
AMPDU RTS disabled greys and parks that radio's RTS and Fragmentation inputs.
wlpro_nv_fields[] trimmed to the rows that remain.
---
 release/src/router/httpd/web.c            |  16 ++-
 release/src/router/www/Reaper_WiFiPro.asp | 140 ++++++++++++++++++----
 2 files changed, 129 insertions(+), 27 deletions(-)

diff --git a/release/src/router/httpd/web.c b/release/src/router/httpd/web.c
index 383f5e1d17..23512c838a 100644
--- a/release/src/router/httpd/web.c
+++ b/release/src/router/httpd/web.c
@@ -41047,13 +41047,19 @@ ej_wl_nband_info(int eid, webs_t wp, int argc, char_t **argv)
  * runs on - exactly as ej_wl_nband_info() above already does. Radios that do not
  * exist are simply absent from the object; the page's only reader already treats
  * a missing key as "" (dv = NV[nm]; if (dv == null) dv = "").
+ *
+ * reaper 2026-09-19: "timesched" added. The page never writes it; it marks a
+ * radio the wireless scheduler owns so the radio toggle can say so. Same day,
+ * trimmed to what the page still renders (rows removed 2026-09-18/19: 11be,
+ * nmode_x, gmode_protection, turbo_qam, ampdu_mpdu, btc_mode, txbf, itxbf,
+ * wme) - every wlN_* read here is a wlcsm round trip, so unread keys cost.
+ * "mumimo" stays: the page derives it from ofdma and compares before writing.
  */
 static const char *wlpro_nv_fields[] = {
-	"11be", "ampdu_mpdu", "ampdu_rts", "atf", "bcn", "bss_maxassoc",
-	"btc_mode", "dtim", "frag", "frameburst", "gmode_protection", "igs",
-	"itxbf", "mbo_enable", "mumimo", "nmode_x", "ofdma", "plcphdr",
-	"radio", "rateset", "rts", "turbo_qam", "twt", "txbf", "txpower",
-	"user_rssi", "wme", "wme_apsd", "wme_no_ack", NULL
+	"ampdu_rts", "atf", "bcn", "bss_maxassoc", "dtim", "frag", "frameburst",
+	"igs", "mbo_enable", "mumimo", "ofdma", "plcphdr", "radio", "rateset",
+	"rts", "timesched", "twt", "txpower", "user_rssi", "wme_apsd",
+	"wme_no_ack", NULL
 };
 
 static int
