+++ b/release/src/router/httpd/web.c
@@ -41051,15 +41051,17 @@ ej_wl_nband_info(int eid, webs_t wp, int argc, char_t **argv)
  * reaper 2026-09-19: "timesched" added. The page never writes it; it marks a
  * radio the wireless scheduler owns so the radio toggle can say so. Same day,
  * trimmed to what the page still renders (rows removed 2026-09-18/19: 11be,
- * nmode_x, gmode_protection, turbo_qam, ampdu_mpdu, btc_mode, txbf, itxbf,
- * wme) - every wlN_* read here is a wlcsm round trip, so unread keys cost.
+ * gmode_protection, turbo_qam, ampdu_mpdu, btc_mode, txbf, itxbf, wme) -
+ * every wlN_* read here is a wlcsm round trip, so unread keys cost.
  * "mumimo" stays: the page derives it from ofdma and compares before writing.
+ * "nmode_x" is back (owner, 2026-09-19) and "11ax" rides with it read-only:
+ * the page writes 11ax=1 when a mode that allows HE is applied over a stored 0.
  */
