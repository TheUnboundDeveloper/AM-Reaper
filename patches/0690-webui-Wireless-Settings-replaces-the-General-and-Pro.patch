-     {name:`<#WLANConfig11b_TxPower_itemname#>`,key:"txpower",type:"sel",options:[["100",`<#RWFP_27#>`],["88",`<#RWFP_28#>`],["50",`<#RWFP_29#>`],["25",`<#RWFP_30#>`],["10",`<#RWFP_31#>`]]}
-   ]}
