  * "nmode_x" is back (owner, 2026-09-19) and "11ax" rides with it read-only:
  * the page writes 11ax=1 when a mode that allows HE is applied over a stored 0.
  */
+/*
+ * reaper 2026-09-20 (owner): the page became Wireless > Settings, the ONE tab that
+ * replaces the stock General tab and both Professional pages. The General tab's
+ * radio rows (bw, bw_160, chanspec, nctrlsb, wpa_gtk_rekey) and every manual row
+ * the 2026-09-19 trim had removed are back; "sched_v2" is read for the scheduler
+ * grid (this build is WL_SCHED_V2/V3, rc/watchdog.c reads wlN_sched_v2).
+ * 37 keys per radio, one pass, still the only reader of this emitter.
+ */
 static const char *wlpro_nv_fields[] = {
-	"11ax", "ampdu_rts", "atf", "bcn", "bss_maxassoc", "dtim", "frag",
-	"frameburst", "igs", "mbo_enable", "mumimo", "nmode_x", "ofdma",
-	"plcphdr", "radio", "rateset", "rts", "timesched", "twt", "txpower",
-	"user_rssi", "wme_apsd", "wme_no_ack", NULL
+	"11ax", "ampdu_mpdu", "ampdu_rts", "ap_isolate", "atf", "bcn", "bss_maxassoc",
+	"btc_mode", "bw", "bw_160", "chanspec", "dtim", "frag", "frameburst", "igs",
+	"itxbf", "mbo_enable", "mrate_x", "mumimo", "nctrlsb", "nmode_x", "ofdma",
+	"plcphdr", "radio", "rateset", "rts", "sched_v2", "timesched", "turbo_qam",
+	"twt", "txbf", "txpower", "user_rssi", "wme", "wme_apsd", "wme_no_ack",
+	"wpa_gtk_rekey", NULL
 };
 
 static int
@@ -41108,6 +41118,46 @@ ej_wlpro_nvram(int eid, webs_t wp, int argc, char_t **argv)
 	return ret;
 }
 
+/*
+ * reaper 2026-09-20: the driver's valid chanspec list per radio for Wireless > Settings
+ * (Reaper_WiFiSettings.asp), ONE JSON object keyed by wlN:
+ *   {"wl0":["1","1l","1u",...],"wl1":["36","36l","36/80","36/160",...],"wl2":["6g1",...]}
+ * Stock's General tab fetches the same data per band through hookGet("chanspecs_2g") and
+ * friends (one round trip per band) and builds its channel tables from it in js/asus.js;
+ * the page does the same from this one object. The list is nvram wlN_chansps, filled by
+ * the prebuilt ej_wl_chanspecs() when called without a writer - the exact pattern
+ * ej_get_wl_bandwidth() uses. Emitted in wl_ifnames order like ej_wlpro_nvram() above.
+ * A chanspec is [0-9a-z/-] only; anything else in the list is dropped, never echoed.
+ */
+static int
+ej_wlpro_chanspecs(int eid, webs_t wp, int argc, char_t **argv)
+{
+	char word[256], *next, prefix[16], chansps[4096], cs[64], *csnext;
+	int unit = 0, first, ret = 0;
+
+	ret += websWrite(wp, "{");
+	foreach (word, nvram_safe_get("wl_ifnames"), next) {
+		snprintf(prefix, sizeof(prefix), "wl%d_", unit);
+		strlcpy(chansps, nvram_pf_safe_get(prefix, "chansps"), sizeof(chansps));
+		if (chansps[0] == '\0') {
+			ej_wl_chanspecs(0, NULL, 1, NULL, unit);
+			strlcpy(chansps, nvram_pf_safe_get(prefix, "chansps"), sizeof(chansps));
+		}
+		ret += websWrite(wp, "%s\"wl%d\":[", unit ? "," : "", unit);
+		first = 1;
+		foreach (cs, chansps, csnext) {
+			if (strspn(cs, "0123456789abcdefghijklmnopqrstuvwxyz/-") != strlen(cs))
+				continue;
+			ret += websWrite(wp, "%s\"%s\"", first ? "" : ",", cs);
+			first = 0;
+		}
+		ret += websWrite(wp, "]");
+		unit++;
+	}
+	ret += websWrite(wp, "}");
+	return ret;
+}
+
 int gen_wl_nband_array()
 {
 	int i = 0;
@@ -50070,6 +50120,7 @@ struct ej_handler ej_handlers[] = {
 #endif
 	{ "wl_nband_info", ej_wl_nband_info},
 	{ "wlpro_nvram", ej_wlpro_nvram},
+	{ "wlpro_chanspecs", ej_wlpro_chanspecs},
 	{ "rwarden_list", ej_rwarden_list},
 	{ "wl_nband_list", ej_wl_nband_list},
 #ifdef RTCONFIG_GEOIP
