-  function render(){
-    RADIOS=buildRadios(NBAND);
-    document.documentElement.style.setProperty("--bands",RADIOS.length);
-    var bh='<div class="hint"></div>'+RADIOS.map(function(r){
-      return '<div class="bh"><span class="bh-dot" style="background:'+(DOT[r.unit]||"var(--steel)")+'"></span>'+
-             '<div><div class="bh-name">'+esc(r.label)+'</div><div class="bh-sub">'+esc(r.ifn)+'</div></div></div>';
