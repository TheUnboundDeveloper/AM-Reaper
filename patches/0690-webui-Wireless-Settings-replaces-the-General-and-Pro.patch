-    var opts=list.map(function(o){ return '<option value="'+esc(o[0])+'"'+(o[2]?' data-lockonly="1"':'')+'>'+esc(o[1])+'</option>'; }).join("");
-    return '<div class="cell"><div class="selwrap"><select class="sel" data-name="'+nm+'" data-nv="'+esc(dv)+'">'+opts+'</select></div></div>';
-  }
