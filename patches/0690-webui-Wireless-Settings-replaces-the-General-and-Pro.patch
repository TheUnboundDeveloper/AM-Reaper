-  var MLO_ON=("<% nvram_get("mld_enable"); %>"==="1");
-  /* AiMesh router/AP mode (sw_mode 1/3): the stock page confirms a radio going off
-     because the setting reaches the nodes (AiMesh_confirm_msg "Wireless_Radio"). */
-  var AMESH_CAP=(["1","3"].indexOf("<% nvram_get("sw_mode"); %>")!==-1);
-
-  var BAND_LABEL={"2":"2.4 GHz","1":"5 GHz","4":"6 GHz"};
-  var BAND_TYPE ={"2":"2.4","1":"5","4":"6"};
-  var DOT=["var(--jade)","var(--amber)","var(--red)","var(--ice)"];
