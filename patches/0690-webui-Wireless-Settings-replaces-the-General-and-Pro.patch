+     /* wlN_timesched + wlN_sched_v2 (this build is WL_SCHED_V2/V3: rc/watchdog.c reads _sched_v2 and
+        rules are OFF-time windows, "W1<dayhex>HHMMHHMM" joined by "<"). MLO writes timesched=0. */
+     {name:`<#WLANConfig11b_x_SchedEnable_itemname#>`,key:"timesched",type:"sched",help:`<#WLANConfig11b_x_SchedEnable_itemdesc#>`},
+     {name:`<#WLANConfig11b_x_Mode_itemname#>`,key:"nmode_x",type:"sel",help:`<#RWFP_47#>`,options:MODES}
+   ]},
+   {sec:`<#RWFP_46#>`,rows:[
+     /* options come from the driver's chanspec list per radio (which widths exist) */
+     {name:`<#WLANConfig11b_ChannelBW_itemname#>`,key:"bw",type:"sel",help:`<#WLANConfig11b_ChannelBW_itemdesc#>`,options:"bw"},
+     {name:`<#WLANConfig11b_ChannelBW_Enable160M#>`,key:"bw_160",type:"sel",bands:["5"],help:`<#RWFP_48#>`,options:ED},
+     {name:`<#WLANConfig11b_Channel_itemname#>`,key:"@chan",type:"sel",help:`<#WLANConfig11b_Channel_itemdesc#>`,options:"chan"},
+     {name:`<#WLANConfig_BW320_Channel_Range#>`,key:"@range",type:"sel",bands:["6"],options:"range"},
+     {name:`<#WLANConfig11b_EChannel_itemname#>`,key:"@ext",type:"sel",bands:["2.4"],help:`<#WLANConfig11b_EChannel_itemdesc#>`,options:[["l",`<#WLANConfig11b_EChannelAbove#>`],["u",`<#WLANConfig11b_EChannelBelow#>`]]},
+     {name:`<#RWFP_66#>`,key:"acs",type:"chks",global:true,help:`<#RWFP_49#>`,
+      chk:{"2.4":[["acs_ch13",`<#WLANConfig11b_EChannel_acs_ch13#>`]],"5":[["acs_dfs",`<#WLANConfig11b_EChannel_dfs#>`],["acs_unii4",`<#WLANConfig11b_EChannel_U-NII-4#>`]],"6":[["psc6g",`<#RWFP_50#>`]]}}
+   ]},
+   {sec:`<#RWFP_3#>`,rows:[
+     {name:`<#WLANConfig11b_x_client_limit_max#>`,key:"bss_maxassoc",type:"num",min:1,max:128,help:`<#WLANConfig11b_x_client_limit_itemdesc#>`},
+     /* stock validForm: 0 = off, otherwise -90..-40 */
+     {name:`<#Roaming_assistant#>`,key:"user_rssi",type:"rssi",min:-90,max:-40,help:`<#RWFP_65#>`},
+     {name:`<#WLANConfig11b_AgileMultiband_itemdesc#>`,key:"mbo_enable",type:"sel",options:ED,help:`<#RWFP_51#>`},
+     {name:`<#WLANConfig11b_WakeTime_itemname#>`,key:"twt",type:"sel",options:ED,help:`<#RWFP_52#>`},
+     {name:`<#WLANConfig11b_x_IsolateAP_itemname#>`,key:"ap_isolate",type:"sel",options:YN,help:`<#WLANConfig11b_x_IsolateAP_itemdesc#>`},
+     {name:`<#WLANConfig11b_x_Rekey_itemname#>`,key:"wpa_gtk_rekey",type:"num",min:0,max:2592000,unit:"s",help:`<#WLANConfig11b_x_Rekey_itemdesc#>`}
+   ]},
+   {sec:`<#RWFP_4#>`,rows:[
+     /* Disable-802.11b (rateset) is the MASTER of the preamble row: while "ofdm" the preamble shows its
+        lock-only "0" (the value stock derives rateset from) and is locked (owner request 2026-08-05) */
+     {name:`<#WLANConfig11n_PremblesType_itemname#>`,key:"plcphdr",type:"sel",bands:["2.4"],help:`<#WLANConfig11n_PremblesType_itemdesc#>`,options:[["long",`<#WLANConfig11n_PremblesType_long#>`],["short",`<#WLANConfig11n_PremblesType_short#>`],["0",`<#RWFP_13#>`,1]]},
+     {name:`<#RWFP_13#>`,key:"rateset",type:"sel",bands:["2.4"],help:`<#RWFP_60#>`,options:[["default",`<#RWFP_25#>`],["ofdm",`<#RWFP_13#>`]]},
+     {name:`<#WLANConfig11b_MultiRateAll_itemname#>`,key:"mrate_x",type:"sel",options:MRATE,help:`<#WLANConfig11b_MultiRateAll_itemdesc#>`},
+     {name:`<#WLANConfig11b_x_ModulationScheme#>`,key:"turbo_qam",type:"sel",options:QAM,help:`<#RWFP_57#>`},
+     {name:`<#WLANConfig11b_x_AMPDU#>`,key:"ampdu_mpdu",type:"sel",options:ED,help:`<#RWFP_58#>`},
+     {name:"AMPDU RTS",key:"ampdu_rts",type:"sel",options:ED,help:`<#RWFP_59#>`},
+     {name:`<#WLANConfig11b_x_RTS_itemname#>`,key:"rts",type:"num",min:0,max:2347,help:`<#WLANConfig11b_x_RTS_itemdesc#>`},
+     {name:`<#WLANConfig11b_x_Frag_itemname#>`,key:"frag",type:"num",min:256,max:2346,help:`<#WLANConfig11b_x_Frag_itemdesc#>`}
+   ]},
+   {sec:`<#RWFP_5#>`,rows:[
+     {name:`<#OFDMA_title#>`,key:"ofdma",type:"sel",help:`<#RWFP_53#>`,options:[["0",`<#WLANConfig11b_WirelessCtrl_buttonname#>`],["1","DL OFDMA"],["2","DL / UL OFDMA"],["3","DL/UL OFDMA + MU-MIMO"]]},
+     {name:`<#WLANConfig11b_MUMIMO_itemdesc#>`,key:"mumimo",type:"sel",options:ED,help:`<#RWFP_54#>`},
+     {name:`<#WLANConfig11b_x_ExpBeam#>`,key:"txbf",type:"sel",options:ED,help:`<#RWFP_55#>`},
+     {name:`<#WLANConfig11b_x_uniBeam#>`,key:"itxbf",type:"sel",options:ED,help:`<#RWFP_56#>`}
+   ]},
+   {sec:`<#RWFP_6#>`,rows:[
+     {name:`<#WLANConfig11b_x_BTCoexistence_itemname#>`,key:"btc_mode",type:"sel",bands:["2.4"],help:`<#WLANConfig11b_x_BTCoexistence_itemdesc#>`,options:[["0",`<#WLANConfig11b_WirelessCtrl_buttonname#>`],["1",`<#WLANConfig11b_WirelessCtrl_button1name#>`],["2",`<#WLANConfig11b_x_BTCoexistence_pre-emptive#>`]]},
+     {name:`<#WLANConfig11b_x_IgmpSnEnable_itemname#>`,key:"igs",type:"sel",options:ED,help:`<#WLANConfig11b_x_IgmpSnEnable_itemdesc#>`},
+     /* one global key (usb_usb3, the System page's USB Mode), shown in the 2.4 GHz column it affects;
+        a change reboots (stock System page needReboot) */
+     {name:`<#RWFP_61#>`,key:"usb_usb3",type:"sel",global:true,bands:["2.4"],help:`<#RWFP_62#>`,options:[["0",`<#RWFP_63#>`],["1",`<#RWFP_64#>`]],show:function(){ return USB3_SUPPORT; }}
+   ]},
+   {sec:`<#RWFP_7#>`,rows:[
+     {name:`<#WLANConfig11b_x_WMM_itemname#>`,key:"wme",type:"sel",help:`<#WLANConfig11b_x_WMM_itemdesc#>`,options:[["auto",`<#Auto#>`],["on",`<#WLANConfig11b_WirelessCtrl_button1name#>`],["off",`<#WLANConfig11b_WirelessCtrl_buttonname#>`]]},
+     {name:`<#WLANConfig11b_x_NOACK_itemname#>`,key:"wme_no_ack",type:"sel",options:[["off",`<#WLANConfig11b_WirelessCtrl_buttonname#>`],["on",`<#WLANConfig11b_WirelessCtrl_button1name#>`]],help:`<#WLANConfig11b_x_NOACK_itemdesc#>`},
+     {name:`<#WLANConfig11b_x_APSD_itemname#>`,key:"wme_apsd",type:"sel",options:[["on",`<#WLANConfig11b_WirelessCtrl_button1name#>`],["off",`<#WLANConfig11b_WirelessCtrl_buttonname#>`]],help:`<#WLANConfig11b_x_APSD_itemdesc#>`},
+     {name:`<#WLANConfig11b_x_Airtime_Fairness#>`,key:"atf",type:"sel",options:ED,help:`<#WLANConfig11b_x_Airtime_Fairness_itemdesc#>`}
+   ]},
+   {sec:`<#RWFP_8#>`,rows:[
+     {name:`<#WLANConfig11b_x_DTIM_itemname#>`,key:"dtim",type:"num",min:1,max:255,help:`<#WLANConfig11b_x_DTIM_brcm_itemdesc#>`},
+     {name:`<#WLANConfig11b_x_Beacon_itemname#>`,key:"bcn",type:"num",min:20,max:1000,unit:"ms",help:`<#WLANConfig11b_x_Beacon_itemdesc#>`},
+     {name:`<#WLANConfig11b_x_TxBurst_itemname#>`,key:"frameburst",type:"sel",options:ONOFF,help:`<#WLANConfig11b_x_TxBurst_itemdesc#>`}
+   ]},
+   {sec:`<#RWFP_9#>`,rows:[
+     /* stock slider stops; the lowest writes 0 (stock "Power Saving"), no longer 10 */
+     {name:`<#WLANConfig11b_TxPower_itemname#>`,key:"txpower",type:"sel",help:`<#WLANConfig11b_TxPower_help1#>`,options:[["100",`<#RWFP_27#>`],["88",`<#RWFP_28#>`],["50",`<#RWFP_29#>`],["25",`<#RWFP_30#>`],["0",`<#RWFP_31#>`]]}
+   ]}
+  ];
+
+  /* ---- chanspec model (stock js/asus.js tables, per radio) ----
+     A chanspec is "36", "36l"/"40u" (40 MHz, control sideband), "36/80", "36/160", "6g5/80",
+     "6g5/320-1". Tables keyed by control channel per width; chans = every channel seen. */
+  function buildTables(list){
+    var T={c20:{},c40:{},c80:{},c160:{},c320:{},chans:[],widths:[]}, all={};
+    (list||[]).forEach(function(e){
+      if(e==="0") return;
+      var ch=e.split("u")[0].split("l")[0].split("/")[0]; if(ch.indexOf("6g")===0) ch=ch.slice(2);
+      var k=(e.indexOf("/320")!==-1)?"c320":(e.indexOf("/160")!==-1)?"c160":(e.indexOf("/80")!==-1)?"c80":
+            (e.indexOf("u")!==-1||e.indexOf("l")!==-1||e.indexOf("/40")!==-1)?"c40":"c20";
+      (T[k][ch]=T[k][ch]||[]).push(e); all[ch]=1;
+    });
+    T.chans=Object.keys(all).map(Number).sort(function(a,b){ return a-b; }).map(String);
+    [["c20","20"],["c40","40"],["c80","80"],["c160","160"],["c320","320"]].forEach(function(p){ if(Object.keys(T[p[0]]).length) T.widths.push(p[1]); });
+    return T;
+  }
+  function parseChanspec(cs){
+    var r={ch:"0",w:"",ext:"",range:""}; if(!cs||cs==="0") return r;
+    var s=String(cs); if(s.indexOf("6g")===0) s=s.slice(2);
+    var m=s.match(/^(\d+)(l|u)?(?:\/(\d+)(-\d)?)?$/); if(!m) return r;
+    r.ch=m[1]; r.w="20"; if(m[2]){ r.ext=m[2]; r.w="40"; } if(m[3]){ r.w=m[3]; if(m[3]==="320") r.range="320"+(m[4]||"-1"); }
+    return r;
+  }
+  function isPSC(c){ return ((+c)-5)%16===0; }
+  var BWCODE={"20":"1","40":"2","80":"3","160":"5","320":"6"};
+  function bwOptions(T){
+    var o=[["0",T.widths.join("/")+" MHz"]];
+    T.widths.forEach(function(w){ o.push([BWCODE[w],w+" MHz"]); });
+    return o;
+  }
+
+  var RADIOS=[], TB={};
+  function esc(s){ return String(s==null?"":s).replace(/[&<>"']/g,function(c){ return {"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]; }); }
+  function nv(u,k){ var v=NV["wl"+u+"_"+k]; return v==null?"":String(v); }
+  function optsFor(row,u){
+    var b=RADIOS[u].band, T=TB[u];
+    if(row.options==="bw") return bwOptions(T);
+    if(row.options==="chan") return chanOptions(u);
+    if(row.options==="range") return rangeOptions(u);
+    return Array.isArray(row.options)?row.options:(row.options?row.options[b]:null);
+  }
+  function applies(row,u){ var b=RADIOS[u].band; if(row.show&&!row.show(u)) return false; return !row.bands||row.bands.indexOf(b)!==-1; }
+  function q(u,k){ return document.querySelector('[data-name="wl'+u+'_'+k+'"]'); }
+  function curVal(u,k){ var el=q(u,k); return el?getVal(el):nv(u,k); }
+  function isTog(el){ return el.classList.contains("tog"); }
+  function getVal(el){ return isTog(el)?(el.classList.contains("on")?"1":"0"):String(el.value); }
+
+  /* ---- channel options depend on the band, the chosen bandwidth and (6 GHz) PSC-only ---- */
+  function chanOptions(u){
+    var b=RADIOS[u].band, T=TB[u], bw=curVal(u,"bw"), psc=gval("psc6g");
+    var list=T.chans.filter(function(c){
+      switch(bw){ case "2": return !!T.c40[c]; case "3": return !!T.c80[c]; case "5": return !!T.c160[c]; case "6": return !!T.c320[c]; default: return true; } });
+    if(b==="6"&&psc==="1") list=list.filter(isPSC);
+    return [["0",`<#Auto#>`]].concat(list.map(function(c){
+      var lab=c; if(b==="5"&&+c>=52&&+c<=144) lab+=" (DFS)"; if(b==="6"&&isPSC(c)) lab+=" (PSC)"; return [c,lab]; }));
+  }
+  function rangeOptions(u){
+    var T=TB[u], ch=curVal(u,"@chan"), seen={}, o=[];
+    var pool=(ch!=="0"&&T.c320[ch])?T.c320[ch]:[].concat.apply([],Object.keys(T.c320).map(function(c){ return T.c320[c]; }));
+    pool.forEach(function(e){ var m=e.match(/\/(320-\d)$/); if(m&&!seen[m[1]]){ seen[m[1]]=1; o.push([m[1],m[1]]); } });
+    if(!o.length) o.push(["320-1","320-1"]);
+    return o;
+  }
+  /* the chanspec Apply writes, from the four controls - stock's General tab logic (its
+     postObject[key_chanspec]) with the tables standing in for its ch20/40/80/160/320 maps */
+  function composeChanspec(u){
+    var b=RADIOS[u].band, T=TB[u], ch=curVal(u,"@chan"), bw=curVal(u,"bw");
