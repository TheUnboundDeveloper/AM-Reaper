+     ("D" rules = every day; other rule types are left untouched). Empty = never off. The grid
+     shows ON hours; dark hours become one W rule per day per contiguous run. */
+  var SCHED={}, schedU=-1, schedArr=null, DAYS=[`<#date_Sun_itemdesc#>`,`<#date_Mon_itemdesc#>`,`<#date_Tue_itemdesc#>`,`<#date_Wed_itemdesc#>`,`<#date_Thu_itemdesc#>`,`<#date_Fri_itemdesc#>`,`<#date_Sat_itemdesc#>`];
+  function schedToArr(str){
+    var a=[],i,j; for(i=0;i<7;i++){ a.push([]); for(j=0;j<24;j++) a[i].push(1); }
+    String(str||"").split("<").forEach(function(w){
+      if(!w) return;
+      var type=w.charAt(0), en, dow, sh, sm, eh, em;
+      if(type==="W"&&w.length>=12){ en=w.charAt(1); dow=parseInt(w.substr(2,2),16); sh=+w.substr(4,2); sm=+w.substr(6,2); eh=+w.substr(8,2); em=+w.substr(10,2); }
+      else if(type==="D"&&w.length>=10){ en=w.charAt(1); dow=0x7F; sh=+w.substr(2,2); sm=+w.substr(4,2); eh=+w.substr(6,2); em=+w.substr(8,2); }
+      else return;
+      if(en!=="1"||isNaN(dow)) return;
+      var from=sh, to=eh+(em>0?1:0); if(to>24) to=24;
+      for(i=0;i<7;i++){ if(!(dow&(1<<i))) continue; for(j=from;j<to;j++) a[i][j]=0; }
+    });
+    return a;
+  }
+  function arrToSched(a){
+    var out=[], i, j, p=function(n){ return n<10?"0"+n:String(n); }, hx=function(n){ var s=n.toString(16).toUpperCase(); return s.length<2?"0"+s:s; };
+    for(i=0;i<7;i++){ var start=-1;
+      for(j=0;j<=24;j++){ var off=(j<24&&a[i][j]===0);
+        if(off&&start<0) start=j;
+        else if(!off&&start>=0){ out.push("W1"+hx(1<<i)+p(start)+"00"+p(j)+"00"); start=-1; } } }
+    return out.join("<");
+  }
+  function openSched(u){
+    schedU=u; schedArr=schedToArr(SCHED[u]!==undefined?SCHED[u]:nv(u,"sched_v2"));
+    document.getElementById("schedTitle").textContent=`<#Time_Scheduling#>`+" - "+RADIOS[u].label;
+    drawSched(); document.getElementById("schedModal").classList.add("show");
+  }
+  function drawSched(){
+    var h='<div></div>', i, j;
+    for(j=0;j<24;j++) h+='<div class="h" data-h="'+j+'">'+j+'</div>';
+    for(i=0;i<7;i++){ h+='<div class="d" data-d="'+i+'">'+esc(DAYS[i])+'</div>'; for(j=0;j<24;j++) h+='<div class="c'+(schedArr[i][j]?' on':'')+'" data-d="'+i+'" data-h="'+j+'"></div>'; }
+    document.getElementById("schedGrid").innerHTML=h;
+  }
+  document.getElementById("schedGrid").addEventListener("click",function(e){
+    var el=e.target, d=el.getAttribute("data-d"), h=el.getAttribute("data-h"), i, j;
+    if(el.classList.contains("c")) schedArr[+d][+h]=schedArr[+d][+h]?0:1;
+    else if(el.classList.contains("d")){ var all=schedArr[+d].every(function(x){ return x===1; }); for(j=0;j<24;j++) schedArr[+d][j]=all?0:1; }
+    else if(el.classList.contains("h")){ var allh=schedArr.every(function(r){ return r[+h]===1; }); for(i=0;i<7;i++) schedArr[i][+h]=allh?0:1; }
+    else return;
+    drawSched();
+  });
+  document.getElementById("schedAllOn").onclick=function(){ schedArr=schedArr.map(function(d){ return d.map(function(){ return 1; }); }); drawSched(); };
+  document.getElementById("schedCancel").onclick=function(){ document.getElementById("schedModal").classList.remove("show"); };
+  document.getElementById("schedSave").onclick=function(){
+    if(schedArr.every(function(d){ return d.every(function(x){ return x===0; }); })){ alert(`<#RWFP_45#>`); return; }
+    SCHED[schedU]=arrToSched(schedArr);
+    var c=q(schedU,"timesched").closest(".cell"); if(c) c.classList.toggle("dirty",SCHED[schedU]!==nv(schedU,"sched_v2")||getVal(q(schedU,"timesched"))!==q(schedU,"timesched")._base);
+    document.getElementById("schedModal").classList.remove("show"); recountSched();
+  };
+  function schedDirty(u){ return SCHED[u]!==undefined&&SCHED[u]!==nv(u,"sched_v2"); }
+  function recountSched(){ var n=recount(); RADIOS.forEach(function(r){ if(schedDirty(r.unit)&&getVal(q(r.unit,"timesched"))===q(r.unit,"timesched")._base) n++; }); chgN.textContent=n; btn.disabled=n===0; }
+
+  /* ---- apply: every pending change for every radio in ONE restart_wireless ---- */
+  btn.addEventListener("click",function(){
+    var bad=null;
+    document.querySelectorAll(".num").forEach(function(el){
+      if(el.closest("[hidden]")) return;
+      if(getVal(el)===el._base||el._hardLock) return;
+      var v=parseInt(el.value,10), lo=+el.getAttribute("data-min"), hi=+el.getAttribute("data-max");
+      if(v===0 && el.getAttribute("data-name").slice(-10)==="_user_rssi") return;
+      if(isNaN(v)||v<lo||v>hi||String(v)!==String(el.value).trim()) bad=bad||el;
+    });
+    if(bad){ bad.focus(); bad.closest(".cell").classList.add("dirty");
+      alert(`<#RWFP_37#> `+bad.getAttribute("data-name")+` (`+bad.getAttribute("data-min")+` <#RWFP_38#> `+bad.getAttribute("data-max")+`).`); return; }
+    /* AiMesh parity (stock applyRule -> AiMesh_confirm_msg("Wireless_Radio")) */
+    if(AMESH_CAP){
+      var radioOff=false;
+      document.querySelectorAll('.tog[data-name$="_radio"]').forEach(function(t){ if(t._base==="1"&&getVal(t)==="0") radioOff=true; });
+      if(radioOff && !confirm(`<#AiMesh_confirm_msg5#>\n<#AiMesh_confirm_msg0#>`)) return;
+    }
+    var f=document.getElementById("applyform");
+    Array.prototype.slice.call(f.querySelectorAll(".dyn")).forEach(function(n){ n.remove(); });
+    var n=0, add=function(name,value){ var i=document.createElement("input"); i.type="hidden"; i.className="dyn"; i.name=name; i.value=value; f.appendChild(i); n++; };
+    var reboot=false;
+    document.querySelectorAll("[data-name],[data-g]").forEach(function(el){
+      if(el.closest("[hidden]")) return;
+      var nm=el.getAttribute("data-name")||"", g=el.getAttribute("data-g");
+      if(g){ var gv=(el.type==="checkbox")?(el.checked?"1":"0"):String(el.value); if(el._hardLock||gv===el._base) return; add(g,gv); if(g==="usb_usb3") reboot=true; return; }
+      if(/_@(chan|ext|range)$/.test(nm)) return;   /* folded into chanspec below */
+      var v=getVal(el); if(v===el._base||lockSuppressed(el)) return;
+      add(nm,v);
+    });
+    RADIOS.forEach(function(r){ var u=r.unit, b=r.band;
+      /* chanspec + (2.4 GHz) nctrlsb from the channel rows, exactly as stock's General tab posts them */
+      var cs=composeChanspec(u);
+      if(cs!==nv(u,"chanspec")){ add(r.ifn+"_chanspec",cs);
+        if(b==="2.4"){ var side=cs.slice(-1); if(side==="l"||side==="u"){ var nc=(side==="u")?"upper":"lower"; if(nc!==nv(u,"nctrlsb")) add(r.ifn+"_nctrlsb",nc); } } }
+      if(schedDirty(u)) add(r.ifn+"_sched_v2",SCHED[u]);
+      /* 11ax heal: every mode but 0/8/9 makes bring-up write wl<unit>_11ax=0, and nothing writes
+         it back (rc/init.c:2624 seeds it only when unset). Whenever the mode being applied allows
+         HE and the stored 11ax is not 1, write it. */
+      var m=q(u,"nmode_x"); if(m && HE_OK(String(m.value)) && nv(u,"11ax")!=="1") add(r.ifn+"_11ax","1");
+    });
+    if(n===0) return;
+    /* derived heals ride along with a real apply, never on their own: a value a rule FORCES
+       (WMM on outside Legacy, MU-MIMO from OFDMA, TX bursting off under pre-emptive BT, explicit
+       beamforming under MU-MIMO, scheduler off under MLO) is written when nvram disagrees */
+    document.querySelectorAll("[data-name]").forEach(function(el){
+      if(el.closest("[hidden]")||!el._hardLock||!el._forced) return;
+      var nm=el.getAttribute("data-name"); if(/_@(chan|ext|range)$/.test(nm)) return;
+      var v=getVal(el); if(v!==el._base) add(nm,v);
+    });
+    /* a USB 3.0 interference change needs a reboot (stock System page needReboot) */
+    if(reboot){ if(!confirm(`<#AiMesh_Node_Reboot#>`)) return; f.action_script.value="reboot"; f.action_wait.value=REBOOT_WAIT||"90"; }
+    else { f.action_script.value="restart_wireless"; f.action_wait.value="10"; }
+    document.getElementById("overlay").classList.add("show");
+    f.submit();
+    setTimeout(function(){ try{ location.reload(); }catch(e){} },reboot?((parseInt(REBOOT_WAIT,10)||90)*1000+5000):13000);
+  });
+
+  render();
+})();
+</script>
+</body>
+</html>
