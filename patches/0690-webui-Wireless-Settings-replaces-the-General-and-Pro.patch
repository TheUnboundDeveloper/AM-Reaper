+  MRATE["6"]=MRATE["5"];
+  /* stock turbo_qam sets (QAM1024_support): 2.4 GHz MCS 7/9/11, 5 GHz up MCS 9/11 */
+  var QAM={"2.4":[["0","Up to MCS 7 (802.11n)"],["1","Up to MCS 9 (TurboQAM/256-QAM)"],["2","Up to MCS 11 (NitroQAM/1024-QAM)"]],
