-    var total={}; nb.forEach(function(v){ total[v]=(total[v]||0)+1; });
-    var seen={};
-    return nb.map(function(v,i){
-      var base=BAND_LABEL[v]||("wl"+i), label=base;
-      if(total[v]>1){ seen[v]=(seen[v]||0)+1; label=base+"-"+seen[v]; }
-      return {unit:i, ifn:"wl"+i, band:BAND_TYPE[v]||String(v), label:label};
-    });
-  }
