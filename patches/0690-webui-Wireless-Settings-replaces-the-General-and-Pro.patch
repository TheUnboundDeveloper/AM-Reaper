-  var chgN=document.getElementById("chgN"), btn=document.getElementById("applyAll");
-  function isTog(el){ return el.classList.contains("tog"); }
-  function getVal(el){ return isTog(el)?(el.classList.contains("on")?"1":"0"):String(el.value); }
-
-  /* ---- Preamble lock (owner request 2026-08-05) ----
-     While a 2.4 GHz radio's Disable-802.11b select (rateset) shows "ofdm", that
-     radio's Preamble select (plcphdr) is forced to its Disable-802.11b option
-     ("0" - the value the STOCK page derives rateset from) and locked. Switching
-     back to "Allow 802.11b" unlocks it and restores the pre-lock selection (a
-     queued preamble change is parked while locked, not lost). */
-  function pairedSel(el,from,to){
-    var nm=el.getAttribute("data-name"); if(nm.slice(-from.length)!==from) return null;
-    return document.querySelector('[data-name="'+nm.slice(0,-from.length)+to+'"]');
-  }
-  /* a LOCKED plcphdr is staged only when its rateset is itself a staged change:
-     the (ofdm,0) pair is written together. If nvram already held rateset=ofdm
-     (lock engaged at render), the forced "0" is display-only - never submitted -
-     so an inconsistent stored pair does not surface as a phantom pending change. */
-  function lockSuppressed(el){
-    if(el._hardLock) return true;   /* greyed out by its master (syncRtsLock): parked, never sent */
-    if(!el._locked) return false;
-    var rsel=pairedSel(el,"_plcphdr","_rateset");
-    /* a rateset change that is itself parked (mode lock) is not a staged change */
-    return !(rsel && !rsel._hardLock && getVal(rsel)!==rsel._base);
-  }
-  /* ---- master/slave locks (owner requests 2026-09-19) ----
-     Computed per radio from ALL masters at once, so two masters can share a slave:
-       AMPDU RTS "0"            -> RTS Threshold + Fragmentation Threshold parked
-       Wireless Mode "2" Legacy -> AMPDU RTS + RTS Threshold parked (stock check_ampdu_rts)
-       Wireless Mode not 0/8/9  -> OFDMA parked (the mode drops HE; nothing to schedule)
-       Wireless Mode not "0"    -> Disable 802.11b parked on 2.4 GHz (stock wl_mode_change)
-     A parked control is disabled + greyed; its value stays in place, is excluded from
-     the pending count, the range check and the apply, and returns the moment its
-     master releases it. */
-  function HE_OK(m){ return m==="0"||m==="8"||m==="9"; }
-  function setHardLock(el,locked){
-    if(!el) return;
-    el._hardLock=locked; el.disabled=locked;
-    var w=el.closest(".numwrap")||el.closest(".selwrap");
-    if(w){ w.classList.toggle("locked",locked); if(w._sync) w._sync(); }
-    var b=w?w.querySelector(".csel"):null;
-    if(b){ if(locked) b.setAttribute("aria-disabled","true"); else b.removeAttribute("aria-disabled"); }
-  }
