+             "6":[["0",`<#Auto#>`],["9","AX only"]]};
+  /* stock mcast_rates (Broadcom rows only; CCK rows are 2.4 GHz only) */
+  var MRATE={"2.4":[["0",`<#Auto#>`],["1","CCK 1"],["2","CCK 2"],["3","CCK 5.5"],["6","CCK 11"],["4","OFDM 6"],["5","OFDM 9"],["7","OFDM 12"],["8","OFDM 18"],["9","OFDM 24"],["10","OFDM 36"],["11","OFDM 48"],["12","OFDM 54"]],
