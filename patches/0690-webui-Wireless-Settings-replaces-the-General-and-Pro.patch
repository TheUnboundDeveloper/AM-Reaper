-     {name:`<#WLANConfig11b_x_APSD_itemname#>`,key:"wme_apsd",type:"sel",options:[["on",`<#WLANConfig11b_WirelessCtrl_button1name#>`],["off",`<#WLANConfig11b_WirelessCtrl_buttonname#>`]]},
