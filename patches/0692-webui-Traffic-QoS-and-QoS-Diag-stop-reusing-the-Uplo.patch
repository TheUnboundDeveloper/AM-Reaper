From d1045a4e95669bb3b416020fdccd3e6672ac9787 Mon Sep 17 00:00:00 2001
From: reaper <theunbounddeveloper@outlook.com>
Date: Sun, 20 Sep 2026 14:08:49 -0400
Subject: [PATCH] webui: Traffic, QoS and QoS Diag stop reusing the Upload
 button token as a label

CTL_upload is the stock file-upload button verb and InternetSpeed_Download
carries the same Russian verb, so the Russian legend showed one word twice
(field report). The three pages use RTRF_78/79 (Download / Upload nouns)
instead: Reaper_Traffic 4 uses, Reaper_QoS 4, Reaper_QoSDiag 6.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 release/src/router/www/Reaper_QoS.asp     | 8 ++++----
 release/src/router/www/Reaper_QoSDiag.asp | 6 +++---
 release/src/router/www/Reaper_Traffic.asp | 6 +++---
 3 files changed, 10 insertions(+), 10 deletions(-)

diff --git a/release/src/router/www/Reaper_QoS.asp b/release/src/router/www/Reaper_QoS.asp
index baa2d9aa6a..6ea83b5c47 100644
--- a/release/src/router/www/Reaper_QoS.asp
+++ b/release/src/router/www/Reaper_QoS.asp
@@ -267,8 +267,8 @@ if (self === top) location.href = '/reaper_shell.asp#Reaper_QoS.asp';
     <thead><tr>
       <th style="width:52px"><#Reaper_c_on#></th>
       <th><#Clientlist_device#></th>
-      <th style="width:160px"><#InternetSpeed_Download#> (Mb/s)</th>
-      <th style="width:160px"><#CTL_upload#> (Mb/s)</th>
+      <th style="width:160px"><#RTRF_78#> (Mb/s)</th>
+      <th style="width:160px"><#RTRF_79#> (Mb/s)</th>
       <th style="width:44px"></th>
     </tr></thead>
     <tbody id="bwltbody"></tbody>
@@ -277,8 +277,8 @@ if (self === top) location.href = '/reaper_shell.asp#Reaper_QoS.asp';
     <div class="f"><label><#NetworkTools_target#></label>
       <input class="dev" id="bwl_dev" list="bwl_clients" placeholder="AA:BB:CC:DD:EE:FF" maxlength="17" autocomplete="off">
       <datalist id="bwl_clients"></datalist></div>
-    <div class="f"><label><#InternetSpeed_Download#></label><input class="num" id="bwl_dn" maxlength="7" placeholder="Mb/s"></div>
-    <div class="f"><label><#CTL_upload#></label><input class="num" id="bwl_up" maxlength="7" placeholder="Mb/s"></div>
+    <div class="f"><label><#RTRF_78#></label><input class="num" id="bwl_dn" maxlength="7" placeholder="Mb/s"></div>
+    <div class="f"><label><#RTRF_79#></label><input class="num" id="bwl_up" maxlength="7" placeholder="Mb/s"></div>
     <button type="button" class="btn" onclick="bwlAdd()"><#CTL_add#></button>
   </div>
   <div class="hint" style="margin-top:12px"><#RQOS_111#></div>
diff --git a/release/src/router/www/Reaper_QoSDiag.asp b/release/src/router/www/Reaper_QoSDiag.asp
index ca72f2ed49..796f0b9f3f 100644
--- a/release/src/router/www/Reaper_QoSDiag.asp
+++ b/release/src/router/www/Reaper_QoSDiag.asp
@@ -286,7 +286,7 @@ canvas{display:block;width:100%;height:120px}
   function qLabel(o,q){
     if(state.qos.qos_type===11){ if(q.qid===0)return{n:`<#RQD_24#>`,s:`<#RQD_25#>`}; if(q.qid>=1&&q.qid<=5)return{n:`<#RQD_26#>`+" "+q.qid,s:q.qid===1?`<#RQD_27#>`:""}; if(q.qid===6)return{n:`LAN / <#RWAC_11#>`,s:""}; return{n:`<#RQOS_22#>`+" "+q.qid,s:""}; }
     if(q.af>0)return{n:`<#CTL_Default#>`,s:`<#RQD_28#>`};
-    return {n:`<#RQOS_22#>`+" "+q.qid,s:o.dir==="us"?`<#CTL_upload#>`:`<#InternetSpeed_Download#>`};
+    return {n:`<#RQOS_22#>`+" "+q.qid,s:o.dir==="us"?`<#RTRF_79#>`:`<#RTRF_78#>`};
   }
   function shaperBps(o,q){ if(q.af>0)return q.af; if(o.dir==="us"&&state.qos.qos_obw)return (+state.qos.qos_obw)*1000; return 0; }
 
@@ -365,7 +365,7 @@ canvas{display:block;width:100%;height:120px}
     if(state.pselSig!==psig&&(!ps||document.activeElement!==ps)){
       state.pselSig=psig;
       document.getElementById("pselwrap").innerHTML= state.objs.length?('<select id="psel">'+state.objs.map(function(x){
-        return '<option value="'+x.index+'"'+(x.index===state.selObj?" selected":"")+'>'+esc(x.port)+' &middot; '+(x.dir==="us"?`<#CTL_upload#>`:`<#InternetSpeed_Download#>`)+(x.shaped?` &middot; <#RQD_44#>`:"")+'</option>';}).join("")+'</select>'):"";
+        return '<option value="'+x.index+'"'+(x.index===state.selObj?" selected":"")+'>'+esc(x.port)+' &middot; '+(x.dir==="us"?`<#RTRF_79#>`:`<#RTRF_78#>`)+(x.shaped?` &middot; <#RQD_44#>`:"")+'</option>';}).join("")+'</select>'):"";
       ps=document.getElementById("psel");
       if(ps)ps.onchange=function(){state.selObj=+ps.value;state.selQ=null;state.occHist={};state.dropHist=[];state.t0=null;fetchOnce();};
     }else if(ps&&document.activeElement!==ps&&ps.value!==String(state.selObj)){ ps.value=String(state.selObj); }
@@ -416,7 +416,7 @@ canvas{display:block;width:100%;height:120px}
     var q=curQ(); if(!q){ document.getElementById("detail").innerHTML=""; return; }
     var lab=qLabel(o,q), p=Math.round(q.pct||0), sb=shaperBps(o,q);
     document.getElementById("detail").innerHTML=
-      '<div class="dhd"><div class="k">'+`<#RQOS_22#>`+' '+q.qid+' '+`<#RQD_54#>`+'</div><div class="n">'+lab.n+' <small>'+esc(o.port)+' '+(o.dir==="us"?`<#CTL_upload#>`:`<#InternetSpeed_Download#>`)+'</small></div></div>'+
+      '<div class="dhd"><div class="k">'+`<#RQOS_22#>`+' '+q.qid+' '+`<#RQD_54#>`+'</div><div class="n">'+lab.n+' <small>'+esc(o.port)+' '+(o.dir==="us"?`<#RTRF_79#>`:`<#RTRF_78#>`)+'</small></div></div>'+
       '<div class="dbig"><div class="ring" style="background:radial-gradient(closest-side,var(--panel) 79%,transparent 80% 100%),conic-gradient('+occColor(p)+' '+p+'%,rgba(236,231,219,.08) 0)"><b>'+p+'%<small>'+`<#RQD_47#>`+'</small></b></div>'+
         '<div class="dl">'+
           drow(`<#RQD_55#>`,(q.op||0))+drow(`<#WANTCPMSSOptionComm1Text#>`,fmtBytes(q.ob))+drow(`<#RQD_56#>`,fmtBytes(q.size))+
diff --git a/release/src/router/www/Reaper_Traffic.asp b/release/src/router/www/Reaper_Traffic.asp
index 3fe8b7cb29..3d96409381 100644
--- a/release/src/router/www/Reaper_Traffic.asp
+++ b/release/src/router/www/Reaper_Traffic.asp
@@ -176,8 +176,8 @@ table.ta .num{text-align:right;font-variant-numeric:tabular-nums;color:var(--bon
   <h2><#RTRF_12#></h2>
   <div class="sub"><#RTRF_13#> <span id="probe_note"></span></div>
   <div class="legend">
-    <span><i style="background:var(--jade)"></i><#InternetSpeed_Download#></span>
-    <span><i style="background:var(--crimson)"></i><#CTL_upload#></span>
+    <span><i style="background:var(--jade)"></i><#RTRF_78#></span>
+    <span><i style="background:var(--crimson)"></i><#RTRF_79#></span>
     <span id="lat_leg" style="display:none"><i style="background:var(--amber)"></i><#RTRF_14#></span>
   </div>
   <div class="chart-wrap"><svg id="wanchart" width="100%" height="230" viewBox="0 0 1000 230" preserveAspectRatio="none"></svg></div>
@@ -626,7 +626,7 @@ function renderLive(d){
   var _nowMs=Date.now(); var drawTbl=(_nowMs-(renderLive.lastTbl||0)>=900); if(drawTbl) renderLive.lastTbl=_nowMs;
   var wan=d.wan||{rx_bps:0,tx_bps:0};
   /* tiles + top talkers update in any window */
-  var tiles=[[`<#InternetSpeed_Download#>`,fmtBps(wan.rx_bps),'dn'],[`<#CTL_upload#>`,fmtBps(wan.tx_bps),'up']];
+  var tiles=[[`<#RTRF_78#>`,fmtBps(wan.rx_bps),'dn'],[`<#RTRF_79#>`,fmtBps(wan.tx_bps),'up']];
   if(d.probe&&d.probe.rtt_us){ tiles.push([`<#RTRF_60#>`,(d.probe.rtt_us/1000).toFixed(1)+' <small>ms</small>','']); tiles.push([`<#RTRF_61#>`,d.probe.loss+' <small>%</small>','']); }
   var q=d.quota||{}; if(q.cap_gb>0){ tiles.push([`<#RTRF_62#>`,fmtBytes(q.used)+' <small>/ '+q.cap_gb+' GB</small>','']); }
   var th=''; for(var i=0;i<tiles.length;i++) th+='<div class="tile"><div class="k">'+tiles[i][0]+'</div><div class="v '+tiles[i][2]+'">'+tiles[i][1]+'</div></div>';
