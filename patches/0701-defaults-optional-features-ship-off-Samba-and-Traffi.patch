From b1a9fdbd59c341fe847635544bde7ca4be33996d Mon Sep 17 00:00:00 2001
From: reaper <theunbounddeveloper@outlook.com>
Date: Wed, 23 Sep 2026 15:41:47 -0400
Subject: [PATCH] defaults: optional features ship off - Samba and Traffic
 Analyzer

enable_samba 1->0 and smbd_enable 1->0: stock started an SMB server on the
LAN as soon as a disk was plugged in, which caused a field problem. The
switch is USB Application > Network Place.

rtraf_enable 1->0: the Traffic Analyzer collector is opt-in; the Traffic
page carries its own toggle.

Each key occurs once in defaults.c (enable_samba under RTCONFIG_USB, set
on every fleet model), so the change carries to all siblings through the
normal port. Factory reset / fresh nvram only: an upgraded box keeps its
current values.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 release/src/router/shared/defaults.c | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/release/src/router/shared/defaults.c b/release/src/router/shared/defaults.c
index f6942828c6..1e24596b13 100644
--- a/release/src/router/shared/defaults.c
+++ b/release/src/router/shared/defaults.c
@@ -3131,7 +3131,7 @@ struct nvram_tuple router_defaults[] = {
 	{ "qos_ipolicer", "0", CKN_STR1, CKN_TYPE_DEFAULT, CKN_ACC_LEVEL_DEFAULT, CKN_ENC_DEFAULT, 0 },	/* v5 download cap: WAN ingress RX policer at qos_ibw; default OFF (opt-in) */
 
 	/* reaper v1.3.0 traffic collector (rtrafd) */
-	{ "rtraf_enable", "1", CKN_STR1, CKN_TYPE_DEFAULT, CKN_ACC_LEVEL_DEFAULT, CKN_ENC_DEFAULT, 0 },	/* collector on/off (no listener) */
+	{ "rtraf_enable", "0", CKN_STR1, CKN_TYPE_DEFAULT, CKN_ACC_LEVEL_DEFAULT, CKN_ENC_DEFAULT, 0 },	/* collector on/off (no listener); reaper 2026-09-23: optional features default OFF (Traffic page toggle) */
 	{ "rtraf_path", "", CKN_STR16, CKN_TYPE_DEFAULT, CKN_ACC_LEVEL_DEFAULT, CKN_ENC_DEFAULT, 0 },	/* history store: "" = RAM, "jffs", "usb" (rstats_path-style choice) */
 	{ "rtraf_probe", "", CKN_STR64, CKN_TYPE_DEFAULT, CKN_ACC_LEVEL_DEFAULT, CKN_ENC_DEFAULT, 0 },	/* opt-in WAN latency probe target (empty = off; no forced outbound) */
 	{ "rtraf_cap_gb", "0", CKN_STR8, CKN_TYPE_DEFAULT, CKN_ACC_LEVEL_DEFAULT, CKN_ENC_DEFAULT, 0 },	/* monthly WAN quota in GB (0 = off); warns via syslog at 80/100% */
@@ -3599,7 +3599,7 @@ struct nvram_tuple router_defaults[] = {
 	{ "usb_automount", "1", CKN_STR_DEFAULT, CKN_TYPE_DEFAULT, CKN_ACC_LEVEL_DEFAULT, CKN_ENC_DEFAULT, 0 },
 	{ "script_usbhotplug", "", CKN_STR_DEFAULT, CKN_TYPE_DEFAULT, CKN_ACC_LEVEL_DEFAULT, CKN_ENC_DEFAULT, 0 },
 
-	{ "smbd_enable", "1", CKN_STR_DEFAULT, CKN_TYPE_DEFAULT, CKN_ACC_LEVEL_DEFAULT, CKN_ENC_DEFAULT, 0 },
+	{ "smbd_enable", "0", CKN_STR_DEFAULT, CKN_TYPE_DEFAULT, CKN_ACC_LEVEL_DEFAULT, CKN_ENC_DEFAULT, 0 },	/* reaper 2026-09-23: follows enable_samba (off) */
 //	{ "smbd_autoshare", "1" },
 	{ "smbd_cpage", "", CKN_STR_DEFAULT, CKN_TYPE_DEFAULT, CKN_ACC_LEVEL_DEFAULT, CKN_ENC_DEFAULT, 0 },
 	{ "smbd_cset", "utf8", CKN_STR_DEFAULT, CKN_TYPE_DEFAULT, CKN_ACC_LEVEL_DEFAULT, CKN_ENC_DEFAULT, 0 },
@@ -3663,7 +3663,7 @@ struct nvram_tuple router_defaults[] = {
 #endif
 	{ "ftp_pasvport", "57530", CKN_STR5, CKN_TYPE_DEFAULT, CKN_ACC_LEVEL_DEFAULT, CKN_ENC_DEFAULT, 0 },
 #endif
-	{ "enable_samba", "1", CKN_STR1, CKN_TYPE_DEFAULT, CKN_ACC_LEVEL_DEFAULT, CKN_ENC_DEFAULT, 0 },
+	{ "enable_samba", "0", CKN_STR1, CKN_TYPE_DEFAULT, CKN_ACC_LEVEL_DEFAULT, CKN_ENC_DEFAULT, 0 },	/* reaper 2026-09-23: SMB file sharing is opt-in (USB Application > Network Place); stock ships 1 */
 	{ "enable_samba_tuxera", "0", CKN_STR_DEFAULT, CKN_TYPE_DEFAULT, CKN_ACC_LEVEL_DEFAULT, CKN_ENC_DEFAULT, 0 },
 	{ "st_max_user", "5", CKN_STR2, CKN_TYPE_DEFAULT, CKN_ACC_LEVEL_DEFAULT, CKN_ENC_DEFAULT, 0 },
 	{ "computer_name", "", CKN_STR15, CKN_TYPE_DEFAULT, CKN_ACC_LEVEL_DEFAULT, CKN_ENC_DEFAULT, 0 },
-- 
