From 9c5ce9ab72704635c5e163aca2865da570b3c4d4 Mon Sep 17 00:00:00 2001
From: Eric Sauvageau <merlin@asuswrt-merlin.net>
Date: Fri, 14 Aug 2026 02:20:32 -0400
Subject: [PATCH] build: parallelize libimobiledevice compilation

(cherry picked from commit c64925a68156c8738941a950a9caf4855270be8e)
---
 release/src/router/Makefile | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/release/src/router/Makefile b/release/src/router/Makefile
index e4af114e1a..4562df862d 100644
--- a/release/src/router/Makefile
+++ b/release/src/router/Makefile
@@ -11796,7 +11796,7 @@ libimobiledevice-1.3.0/Makefile:
 	$(MAKE) libimobiledevice-1.3.0-configure
 
 libimobiledevice-1.3.0: libimobiledevice-1.3.0/Makefile
-	$(MAKE) -C $@ && $(MAKE) $@-stage
+	$(MAKE) -C $@ $(PARALLEL_BUILD) && $(MAKE) $@-stage
 
 libimobiledevice-1.3.0-install: libimobiledevice-1.3.0
 	install -D libimobiledevice-1.3.0/tools/idevicebackup $(INSTALLDIR)/libimobiledevice-1.3.0/usr/bin/idevicebackup
-- 
2.25.1

