+/* one field ("result=", "cs=") of a /tmp/reaper_punct.state line, [0-9a-z/-] only */
+static void wlpro_punct_field(const char *line, const char *tag, char *out, size_t len)
+{
+	const char *p = strstr(line, tag);
+	size_t n = 0;
+
+	out[0] = 0;
+	if (!p)
+		return;
+	p += strlen(tag);
+	while (p[n] && n + 1 < len && strchr("0123456789abcdefghijklmnopqrstuvwxyz/-", p[n]))
+		n++;
+	memcpy(out, p, n);
+	out[n] = 0;
+}
