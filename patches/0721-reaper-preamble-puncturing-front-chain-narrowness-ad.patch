+ML="$(nvram get message_loglevel 2>/dev/null)"; LL="$(nvram get log_level 2>/dev/null)"
+echo "  log level         : message_loglevel=${ML:-?} log_level=${LL:-?} (syslogd keeps only lines more urgent than log_level)"
+case "$ML$LL" in *[!0-9]*|"") ;; *) [ "$ML" -ge "$LL" ] && finding INFO "rc/wanduck log lines are being DROPPED (message_loglevel=$ML >= log_level=$LL): on the System Log page set 'Log only messages more urgent than' to all before reproducing a WAN issue (see 5)";; esac
+# v1.3.22: dual WAN (field 2026-09-26, GT-BE98: DHCP primary + USB tether, reconnect loop). The
