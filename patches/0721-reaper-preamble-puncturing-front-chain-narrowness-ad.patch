+    echo "  wan$u: proto=$(nvram get wan${u}_proto 2>/dev/null) ifname=$(nvram get wan${u}_ifname 2>/dev/null) state=$(nvram get wan${u}_state_t 2>/dev/null) sbstate=$(nvram get wan${u}_sbstate_t 2>/dev/null) auxstate=$(nvram get wan${u}_auxstate_t 2>/dev/null) ip=$([ -n "$UIP" ] && [ "$UIP" != "0.0.0.0" ] && echo SET || echo NONE) gw=$([ -n "$(nvram get wan${u}_gateway 2>/dev/null)" ] && echo SET || echo NONE) dns=$(nvram get wan${u}_dns 2>/dev/null | wc -w) link_wan$u=$(nvram get link_wan$u 2>/dev/null)"
+  done
+  DR="$(ip route show default 2>/dev/null | sed 's/via [0-9.]* /via [gw] /' | tr '\n' ';')"
+  echo "  default route     : ${DR:-NONE}"
+  [ -z "$DR" ] && finding WARN "dual WAN is on and there is NO default route right now - wanduck treats a connected line without one as disconnected and switches (see 5)"
+  [ "$(nvram get wan0_auxstate_t 2>/dev/null)" = "2" ] && finding INFO "wan0 auxstate=2: wanduck judged the primary 'no internet activity' - its decision lines need the log level raised (see 5)"
+fi
 WSPD="$(cat /sys/class/net/$WANIF/speed 2>/dev/null)"
 case "$WSPD" in 10|100) finding WARN "WAN link is at ${WSPD} Mb/s - check the cable/ONT negotiation (see 5 and 8)";; esac
 
