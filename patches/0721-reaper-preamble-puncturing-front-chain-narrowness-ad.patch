@@ -290,6 +290,41 @@ echo "  uname: $(uname -a)"
 for k in productid model odmpid build_name firmver buildno extendno territory_code sw_mode re_mode; do
   echo "  $k = $(nvram get $k 2>/dev/null)"
 done
+# v1.3.23: the hardware, stated rather than inferred. One model name covers more
+# than one board: the GT-BE98 ships as GT-BE98 (Realtek RTL8372 LAN switch),
+# GT-BE98_BCM (Broadcom PHYs, no Realtek switch) and GT-BE98_ICP; the RT-BE96U
+# has a B0 board. rc switches its port handling on that board ID, so a report
+# must carry it. The SoC name is read from the chip-ID register (/proc/socinfo),
+# so it is the silicon, not the build. All reads are proc files and wl ioctls.
+echo "  -- hardware --"
+if [ -r /proc/socinfo ]; then
+  awk -F: '/^SoC Name/{s=$2} /^Revision/{r=$2} /^CPU Clock/{c=$2} /^DDR Clock/{dc=$2} /^DDR Size/{ds=$2}
+    END{gsub(/^ +| +$/,"",s); printf "  soc      : %s rev %s, CPU %s, DDR %s @ %s\n", s, r, c, ds, dc}' /proc/socinfo 2>/dev/null
+else
+  echo "  soc      : /proc/socinfo absent"
+fi
+BOARD="$(cat /proc/nvram/boardid 2>/dev/null | tr -d '\000\r\n ')"
+echo "  board    : ${BOARD:-unreadable}   (the boot loader's board ID = the device tree it booted)"
+if pidof rtkmonitor >/dev/null 2>&1; then _sw="Realtek RTL8372 switch (rtkmonitor running)"
+elif pidof mxlmonitor >/dev/null 2>&1; then _sw="MaxLinear PHYs (mxlmonitor running)"
+else _sw="Broadcom switch/PHYs only (no Realtek or MaxLinear monitor running)"; fi
+echo "  lan chips: $_sw"
+_rl=""
+for _w in $(nvram get wl_ifnames 2>/dev/null); do
+  _ri="$(wl -i "$_w" revinfo 2>/dev/null)"
+  _cn="$(echo "$_ri" | awk '$1=="chipnum"{print $2; exit}')"; _cr="$(echo "$_ri" | awk '$1=="chiprev"{print $2; exit}')"
+  _rl="$_rl${_rl:+ | }$_w ${_cn:-?} rev ${_cr:-?}"
+done
+echo "  radios   : ${_rl:-none found}"
+if [ -n "$BOARD" ] && [ -n "$MODEL" ] && [ "$BOARD" != "$MODEL" ]; then
+  case "$BOARD" in
+    *_BCM) _bv="Broadcom PHYs instead of the Realtek RTL8372 LAN switch - LAN port handling differs from the original board" ;;
+    *_ICP) _bv="the ICP board (pressure sensor, different LED pins)" ;;
+    *_B0)  _bv="the B0 board revision" ;;
+    *)     _bv="a board revision this diag does not describe" ;;
+  esac
+  finding INFO "hardware: board $BOARD, not the base $MODEL board - $_bv (read port and LED reports with this in mind)"
+fi
 
