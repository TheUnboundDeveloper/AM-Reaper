+		if (!strncmp(nvram_safe_get(key), "dyn", 3))
+			return 1;
+	}
+	return 0;
+}
+
+void
+start_rpunctd(void)
+{
+	stop_rpunctd();
+	if (!rpunctd_wanted()) return;
+	xstart("rpunctd");
+}
