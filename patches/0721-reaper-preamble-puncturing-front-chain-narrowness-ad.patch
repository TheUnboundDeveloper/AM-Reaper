+  echo "  wandog: enable=$(nvram get wandog_enable 2>/dev/null) interval=$(nvram get wandog_interval 2>/dev/null) maxfail=$(nvram get wandog_maxfail 2>/dev/null) fb_count=$(nvram get wandog_fb_count 2>/dev/null) target=$([ -n "$(nvram get wandog_target 2>/dev/null)" ] && echo SET || echo EMPTY)  dns_probe: enable=$(nvram get dns_probe_enable 2>/dev/null) host=$([ -n "$(nvram get dns_probe_host 2>/dev/null)" ] && echo SET || echo EMPTY)"
