diff --git a/release/src/router/rpunctd/Makefile b/release/src/router/rpunctd/Makefile
new file mode 100644
index 0000000000..32103f1a5a
--- /dev/null
+++ b/release/src/router/rpunctd/Makefile
@@ -0,0 +1,47 @@
+# SPDX-License-Identifier: GPL-2.0-only
+# Copyright (C) 2026 the Reaper project maintainer
+# Part of the Reaper hardened Asuswrt-Merlin build. See LICENSE / LICENSE.reaper.
+# rpunctd - dynamic preamble puncturing controller (v3.2.8). Built like rchqd;
+# punct_host.c is the build-host driver for the tests and is NOT built here.
+include ../common.mak
+
+CFLAGS	+= -Os -Wall $(EXTRACFLAGS)
+CFLAGS	+= -I$(SRCBASE)/include -I$(TOP)/shared
+# exploit-mitigation hardening (matches rtrafd/rmcpd/rchqd): FORTIFY + strong canaries
+# + format-security + PIE; the BCM base ships neither by default.
+CFLAGS	+= -D_FORTIFY_SOURCE=2 -fstack-protector-strong -Wformat -Wformat-security -fPIE
+LDFLAGS	= -L$(TOP_PLATFORM)/nvram$(BCMEX)$(EX7) -lnvram -L$(TOP)/shared -lshared
+ifeq ($(RTCONFIG_BCM_502L07P2),y)
+LDFLAGS += -L$(TOP_PLATFORM)/ethctl_lib -lethctl
+endif
+ifeq ($(HND_ROUTER),y)
+LDFLAGS += -L$(TOP_PLATFORM)/wlcsm -lwlcsm
+endif
+LDFLAGS += -pie -Wl,-z,relro,-z,now
+
+ifeq ($(RTCONFIG_BCMARM),y)
+CFLAGS += -I$(SRCBASE)/shared/bcmwifi/include -DTYPEDEF_FLOAT_T
+CFLAGS += -I$(SRCBASE)/common/include
+endif
+
+OBJS = rpunctd.o punct_core.o
+
+all: rpunctd
+
+rpunctd: $(OBJS)
+	@echo " [rpunctd] CC -o $@"
+	@$(CC) -o $@ $(OBJS) $(LDFLAGS)
+
+%.o: %.c punct_core.h
+	@echo " [rpunctd] CC $@"
+	@$(CC) $(CFLAGS) -c $< -o $@
+
+install: all
+	@echo " [rpunctd] Installing..."
+	install -D rpunctd $(INSTALLDIR)/bin/rpunctd
+	$(STRIP) $(INSTALLDIR)/bin/rpunctd
+
+clean:
+	rm -f rpunctd *.o
+
+.PHONY: all install clean
diff --git a/release/src/router/rpunctd/punct_core.c b/release/src/router/rpunctd/punct_core.c
new file mode 100644
index 0000000000..d0215d6146
--- /dev/null
+++ b/release/src/router/rpunctd/punct_core.c
@@ -0,0 +1,525 @@
+/*
+ * SPDX-License-Identifier: GPL-2.0-only
+ * Copyright (C) 2026 the Reaper project maintainer
+ *
+ * punct_core - the decision layer of dynamic preamble puncturing. See the
+ * header for the model. No I/O, no clock, no allocation: the caller owns time.
+ */
+#include <stdio.h>
+#include <string.h>
+#include "punct_core.h"
+
+/* ---- presets: firmware policy defaults, one table, easy to tune ---- */
+static const pc_params_t presets[3] = {
+	/* trigger restore hold_bad hold_good min_gain min_interval eval cooldown idle_own */
+	{ 800, 350,  60, 240, 200, 300, 60, 900, 100 },	/* Conservative (default) */
+	{ 650, 350,  30, 120, 150, 180, 45, 600, 100 },	/* Balanced */
+	{ 500, 300,  15,  60, 100,  60, 30, 300, 100 },	/* Aggressive */
+};
+#define PC_EFF_ONE_SLICE	970	/* permille: MRU efficiency of a punctured PPDU */
+#define PC_SCAN_TTL_S		300	/* a scan reading stays usable this long */
+#define PC_ERR_AFTER_S		60	/* no valid window for this long = ERROR */
+#define PC_FALLBACK_S		1800	/* FALLBACK holds this long */
+#define PC_MAX_REFUSALS		3
+#define PC_MAX_DISRUPTIONS	2
+#define PC_PROBE_WINDOW_MULT	3	/* a restore undone within eval*this counts as failed */
+#define PC_RESTORE_BACKOFF_MAX	8
+
+const pc_params_t *pc_preset_params(enum pc_preset p)
+{
+	return &presets[(p >= 0 && p <= 2) ? p : 0];
+}
+
+const char *pc_state_name(enum pc_state s)
+{
+	static const char *n[] = { "disabled", "monitoring", "candidate", "confirming",
+		"applying", "holding", "restore", "error", "fallback" };
+	return (s >= 0 && s <= PC_FALLBACK) ? n[s] : "?";
+}
+
+int pc_ceil_pct(int permille)
+{
+	return (permille + 5) / 10;
+}
+
+static int popcount(unsigned m)
+{
+	int n = 0;
+	while (m) { n += m & 1; m >>= 1; }
+	return n;
+}
+
+static void params_effective(pc_radio_t *r)
+{
+	r->p = *pc_preset_params(r->preset);
+	if (r->gain_override > 0) r->p.min_gain = r->gain_override;
+	if (r->hold_override > 0) r->p.min_interval_s = r->hold_override;
+	if (r->slow) {
+		r->p.hold_good_s *= 3;
+		r->p.min_interval_s *= 3;
+		r->p.scan_cooldown_s *= 3;
+	}
+}
+
+void pc_init(pc_radio_t *r, enum pc_preset preset, enum pc_tier tier, int gain_override, int hold_override)
+{
+	memset(r, 0, sizeof(*r));
+	r->preset = preset;
+	r->tier = tier;
+	r->gain_override = gain_override;
+	r->hold_override = hold_override;
+	r->scan_ttl_s = PC_SCAN_TTL_S;
+	r->restore_backoff = 1;
+	r->last_change_s = -1;
+	r->last_scan_s = -1;
+	params_effective(r);
+	r->state = PC_DISABLED;
+}
+
+/* the sub-channels each counter group covers, from the primary's position */
+static void group_masks(int n20, int p, unsigned g[G_N])
+{
+	int i;
+	memset(g, 0, sizeof(unsigned) * G_N);
+	if (n20 < 4) return;
+	g[G_PRI] = 1u << p;
+	g[G_SEC20] = 1u << (p ^ 1);
+	g[G_SEC40] = (1u << (p ^ 2)) | (1u << (p ^ 3));
+	if (n20 >= 8)
+		for (i = 0; i < 4; i++) g[G_SEC80] |= 1u << (((p ^ 4) & ~3) + i);
+	if (n20 >= 16)
+		for (i = 0; i < 16; i++) if (i / 8 != p / 8) g[G_FAR] |= 1u << i;
+}
+
+void pc_set_geometry(pc_radio_t *r, int width, int primary, long now)
+{
+	int i;
+	r->width = width;
+	r->n20 = width / 20;
+	r->primary = primary;
+	group_masks(r->n20, primary, r->gmask);
+	r->have_stats = 0;
+	memset(r->ewma_s, 0, sizeof(r->ewma_s)); memset(r->ewma_l, 0, sizeof(r->ewma_l));
+	memset(r->bad_since, 0, sizeof(r->bad_since)); memset(r->clean_since, 0, sizeof(r->clean_since));
+	for (i = 0; i < PC_MAX20; i++) { r->scan_busy[i] = -1; r->scan_at[i] = 0; }
+	r->scan_pending = 0;
+	r->nbl = 0;
+	r->cur = 0; r->want = 0; r->cand = 0; r->cand_since_s = 0;
+	r->last_eval_s = now; r->last_sample_s = 0; r->first_sample_s = 0;
+	r->hold_until_s = 0; r->restore_at_s = 0;
+	r->last_change_s = -1; r->last_scan_s = -1;
+	r->state = (width >= 80 && r->n20 <= PC_MAX20) ? PC_MONITORING : PC_DISABLED;
+	if (r->state == PC_FALLBACK) r->state = PC_MONITORING;
+	snprintf(r->last_reason, sizeof(r->last_reason), "geometry %d MHz primary %d", width, primary);
+}
+
+/* legal single-slice bitmaps, measured 2026-09-25: 80 -> one 20 not the primary;
+ * 160 -> one 20 or one 40 outside the primary 80; 320 -> one aligned 40 or 80
+ * outside the primary 80. Mirrors rc/reaper_punct.c shape_ok() and the page. */
+int pc_legal_masks(int width, int primary, unsigned out[], int max)
+{
+	int n20 = width / 20, n = 0, len, s;
+	unsigned pri80 = 0, m;
+	int i, sizes[2] = { 0, 0 };
+
+	if (width == 80) { sizes[0] = 1; }
+	else if (width == 160) { sizes[0] = 1; sizes[1] = 2; }
+	else if (width == 320) { sizes[0] = 2; sizes[1] = 4; }
+	else return 0;
+	if (width == 80) pri80 = 1u << primary;
+	else for (i = 0; i < 4; i++) pri80 |= 1u << ((primary & ~3) + i);
+	for (i = 0; i < 2 && sizes[i]; i++) {
+		len = sizes[i];
+		for (s = 0; s + len <= n20; s += len) {
+			m = ((1u << len) - 1) << s;
+			if (m & pri80) continue;
+			if (n < max) out[n++] = m;
+		}
+	}
+	return n;
+}
+
+static int blacklisted(const pc_radio_t *r, unsigned m)
+{
+	int i;
+	for (i = 0; i < r->nbl; i++) if (r->blacklist[i] == m) return 1;
+	return 0;
+}
+
+/* the smallest counter group covering a bitmap, -1 if none */
+static int group_of(const pc_radio_t *r, unsigned m)
+{
+	int g;
+	for (g = G_SEC20; g < G_N; g++)
+		if (r->gmask[g] && (m & ~r->gmask[g]) == 0) return g;
+	return -1;
+}
+
+/* a scan reading covers every sub-channel of the bitmap and is fresh */
+static int scan_covers(const pc_radio_t *r, unsigned m, long now)
+{
+	int i;
+	for (i = 0; i < r->n20; i++)
+		if ((m >> i) & 1) {
+			if (r->scan_busy[i] < 0) return 0;
+			if (now - r->scan_at[i] > r->scan_ttl_s) return 0;
+		}
+	return 1;
+}
+
+/* resolved = the counters measure exactly this slice, or a fresh scan does */
+static int resolved(const pc_radio_t *r, unsigned m, long now)
+{
+	int g = group_of(r, m);
+	if (g >= G_SEC20 && g <= G_SEC80 && r->gmask[g] == m) return 1;
+	return scan_covers(r, m, now);
+}
+
+/* expected usable capacity of a bitmap, in 20 MHz-slots x permille.
+ * A wide frame needs every kept sub-channel free at once, so the busy that
+ * costs airtime is the union over the kept sub-channels: the primary's own
+ * busy plus the exclusive busy of every counter group not switched off. The
+ * far 160 counts by its scan readings when fresh, else by the remainder. */
+/* optimistic = a candidate the counters do not resolve: assume the group's
+ * busy sits entirely inside the candidate slice. That is the figure that
+ * decides whether a confirmation scan is worth its off-channel time; the
+ * scan's own readings decide the apply. */
+static int score_ex(const pc_radio_t *r, unsigned mask, int optimistic)
+{
+	int kept = r->n20 - popcount(mask), g, union_b, i, mx, eff;
+	long now = r->last_sample_s;
+
+	if (kept <= 0) return 0;
+	union_b = r->ewma_s[G_PRI];
+	for (g = G_SEC20; g <= G_FAR; g++) {
+		unsigned gk;
+		if (!r->gmask[g]) continue;
+		gk = r->gmask[g] & ~mask;
+		if (gk == 0) continue;					/* whole group switched off */
+		if (gk != r->gmask[g] && scan_covers(r, gk, now)) {
+			mx = 0;						/* part off: the kept part by its scan readings */
+			for (i = 0; i < r->n20; i++)
+				if (((gk >> i) & 1) && r->scan_busy[i] > mx) mx = r->scan_busy[i];
+			union_b += mx;
+		} else if (gk == r->gmask[g] && g == G_FAR && scan_covers(r, gk, now)) {
+			mx = 0;						/* the far 160 untouched, by scan */
+			for (i = 0; i < r->n20; i++)
+				if (((gk >> i) & 1) && r->scan_busy[i] > mx) mx = r->scan_busy[i];
+			union_b += mx;
+		} else if (gk != r->gmask[g] && optimistic)
+			;						/* assume the busy is in the candidate */
+		else
+			union_b += r->ewma_s[g];
+	}
+	if (union_b > 1000) union_b = 1000;
+	eff = mask ? PC_EFF_ONE_SLICE : 1000;
+	return kept * (1000 - union_b) * eff / 1000;
+}
+
+int pc_score(const pc_radio_t *r, unsigned mask)
+{
+	return score_ex(r, mask, 0);
+}
+
+static void ewma(int *v, int x, int div, int first)
+{
+	if (first) *v = x;
+	else *v += (x - *v) / div;
+}
+
+static void absorb(pc_radio_t *r, const pc_sample_t *s, long now)
+{
+	int x[G_N], g, first = !r->have_stats;
+
+	x[G_PRI] = s->pri; x[G_SEC20] = s->sec20; x[G_SEC40] = s->sec40; x[G_SEC80] = s->sec80;
+	x[G_FAR] = s->total - s->pri - s->sec20 - s->sec40 - s->sec80;
+	if (x[G_FAR] < 0) x[G_FAR] = 0;
+	for (g = 0; g < G_N; g++) {
+		if (x[g] > 1000) x[g] = 1000;
+		if (x[g] < 0) x[g] = 0;
+		ewma(&r->ewma_s[g], x[g], 3, first);
+		ewma(&r->ewma_l[g], x[g], 30, first);
+		if (r->ewma_s[g] >= r->p.trigger) { if (!r->bad_since[g]) r->bad_since[g] = now; }
+		else r->bad_since[g] = 0;
+		if (r->ewma_s[g] <= r->p.restore) { if (!r->clean_since[g]) r->clean_since[g] = now; }
+		else r->clean_since[g] = 0;
+	}
+	ewma(&r->own_s, s->own, 6, first);
+	r->have_stats = 1;
+	r->last_sample_s = now;
+	if (!r->first_sample_s) r->first_sample_s = now;
+}
+
+static const char *gname(int g)
+{
+	static const char *n[] = { "pri", "sec20", "sec40", "sec80", "far" };
+	return (g >= 0 && g < G_N) ? n[g] : "?";
+}
+
+static int busy_text(const pc_radio_t *r, char *b, int len)
+{
+	int g, n = 0;
+	for (g = 0; g < G_N && n < len; g++)
+		if (r->gmask[g])
+			n += snprintf(b + n, len - n, "%s%s %d%%", n ? " " : "", gname(g), pc_ceil_pct(r->ewma_s[g]));
+	return n;
+}
+
+static void set_text(pc_decision_t *d, pc_radio_t *r, const char *tail)
+{
+	char bt[128];
+	busy_text(r, bt, sizeof(bt));
+	snprintf(d->text, sizeof(d->text), "bmp 0x%x | busy %s own %d%% | %s", r->cur, bt, pc_ceil_pct(r->own_s), tail);
+	strncpy(r->last_reason, d->text, sizeof(r->last_reason) - 1);
+	r->last_reason[sizeof(r->last_reason) - 1] = 0;
+}
+
+/* the group whose persistence is the evidence for a candidate */
+static int evidence_group(const pc_radio_t *r, unsigned m)
+{
+	return group_of(r, m);
+}
+
+/* seconds since an event; an event that never happened is infinitely old */
+static long since(long now, long t)
+{
+	return t < 0 ? 1000000000L : now - t;
+}
+
+/* permille gain of a score over the current one; with nothing usable now,
+ * any usable capacity is a full gain, ordered by the score itself */
+static int gain_of(int sc, int sc_cur)
+{
+	if (sc_cur > 0) return (int)((long)(sc - sc_cur) * 1000 / sc_cur);
+	return sc > 0 ? 1000 + sc : 0;
+}
+
+static void evaluate(pc_radio_t *r, long now, pc_decision_t *d)
+{
+	unsigned cands[PC_CAND_MAX], best = 0, bres = 0, bunres = 0;
+	int n, i, sc_cur, sc, gain, best_gain = 0, best_res = 0, g;
+	int bres_gain = -1000000, bres_sc = 0, bunres_gain = -1000000, bunres_sc = 0;
+	int persisted_any = 0;
+	unsigned unresolved_mask = 0;
+	char tail[200];
+
+	sc_cur = pc_score(r, r->cur);
+	r->last_score_cur = sc_cur;
+	n = pc_legal_masks(r->width, r->primary, cands, PC_CAND_MAX);
+
+	/* candidates: legal, not blacklisted, not what is on, with persistent evidence.
+	 * The best RESOLVED candidate is preferred whenever its gain clears the
+	 * minimum: act on what the counters measure. Unresolved candidates are
+	 * scored optimistically and only decide whether a scan is worth running. */
+	for (i = 0; i < n; i++) {
+		unsigned m = cands[i];
+		int res;
+		if (m == r->cur || blacklisted(r, m)) continue;
+		g = evidence_group(r, m);
+		if (g < 0 || !r->bad_since[g] || now - r->bad_since[g] < r->p.hold_bad_s) continue;
+		persisted_any = 1;
+		res = resolved(r, m, now);
+		sc = score_ex(r, m, !res);
+		gain = gain_of(sc, sc_cur);
+		if (res) {
+			if (gain > bres_gain) { bres_gain = gain; bres = m; bres_sc = sc; }
+		} else if (gain > bunres_gain) {
+			bunres_gain = gain; bunres = m; bunres_sc = sc; unresolved_mask = r->gmask[g];
+		}
+	}
+	if (bres && (bres_gain >= r->p.min_gain || !bunres)) {
+		best = bres; best_gain = bres_gain; best_res = 1; r->last_score_cand = bres_sc;
+	} else if (bunres) {
+		best = bunres; best_gain = bunres_gain; best_res = 0; r->last_score_cand = bunres_sc;
+	} else
+		r->last_score_cand = 0;
+	r->last_gain = best ? best_gain : 0;
+	r->cand = best;
+	if (best && !r->cand_since_s) r->cand_since_s = now;
+	if (!best) r->cand_since_s = 0;
+
+	/* restoration: the slice we switched off has stayed clean */
+	if (r->cur) {
+		g = evidence_group(r, r->cur);
+		int clean_ok = (g >= 0 && r->clean_since[g] && now - r->clean_since[g] >= r->p.hold_good_s * r->restore_backoff);
+		if (clean_ok && !best) {
+			int sc0 = pc_score(r, 0);
+			gain = gain_of(sc0, sc_cur);
+			r->last_score_cand = sc0; r->last_gain = gain;
+			if (gain >= r->p.min_gain && since(now, r->last_change_s) >= r->p.min_interval_s) {
+				if (r->tier != PC_TIER_PASSIVE && !scan_covers(r, r->cur, now) &&
+				    since(now, r->last_scan_s) >= r->p.scan_cooldown_s &&
+				    (r->tier == PC_TIER_ACTIVE_SCAN || r->own_s <= r->p.idle_own)) {
+					/* let a scan of the switched-off channels confirm before restoring */
+					d->act = PC_ACT_SCAN; d->mask = r->cur; r->scan_pending = r->cur;
+					r->state = PC_CONFIRMING;
+					snprintf(tail, sizeof(tail), "restore candidate: %s clean %lds, scanning the switched-off channels first", gname(g), now - r->clean_since[g]);
+					set_text(d, r, tail); return;
+				}
+				d->act = PC_ACT_CLEAR; d->mask = 0; r->want = 0; r->state = PC_RESTORE;
+				snprintf(tail, sizeof(tail), "%s clean %lds | full width score %d -> %d (%+d.%d%%) | RESTORE",
+					gname(g), now - r->clean_since[g], sc_cur, sc0, gain / 10, (gain < 0 ? -gain : gain) % 10);
+				set_text(d, r, tail); return;
+			}
+			snprintf(tail, sizeof(tail), "%s clean %lds | full width score %d -> %d (%+d.%d%%) | KEEP: %s",
+				gname(g), now - r->clean_since[g], sc_cur, sc0, gain / 10, (gain < 0 ? -gain : gain) % 10,
+				gain < r->p.min_gain ? "gain below minimum" : "change interval not expired");
+			set_text(d, r, tail); return;
+		}
+	}
+
+	if (!best) {
+		if (persisted_any) snprintf(tail, sizeof(tail), "candidates persisted but none legal or unblacklisted | HOLD");
+		else snprintf(tail, sizeof(tail), "no persistent interference | MONITOR");
+		set_text(d, r, tail);
+		if (r->state == PC_CANDIDATE) r->state = PC_MONITORING;
+		return;
+	}
+	g = evidence_group(r, best);
+	if (best_gain < r->p.min_gain) {
+		snprintf(tail, sizeof(tail), "persistent %s %lds | candidate 0x%x score %d -> %d (%+d.%d%%) | REJECT: gain below %d.%d%%",
+			gname(g), now - r->bad_since[g], best, sc_cur, r->last_score_cand, best_gain / 10, (best_gain < 0 ? -best_gain : best_gain) % 10,
+			r->p.min_gain / 10, r->p.min_gain % 10);
+		set_text(d, r, tail); r->state = PC_CANDIDATE; return;
+	}
+	if (since(now, r->last_change_s) < r->p.min_interval_s) {
+		snprintf(tail, sizeof(tail), "persistent %s %lds | candidate 0x%x (%+d.%d%%) | WAIT: change interval (%lds left)",
+			gname(g), now - r->bad_since[g], best, best_gain / 10, best_gain % 10, r->p.min_interval_s - (since(now, r->last_change_s)));
+		set_text(d, r, tail); r->state = PC_CANDIDATE; return;
+	}
+	if (!best_res) {
+		if (r->tier == PC_TIER_PASSIVE) {
+			snprintf(tail, sizeof(tail), "persistent %s %lds | candidate inside 0x%x needs a confirmation scan; monitoring source is Passive | HOLD",
+				gname(g), now - r->bad_since[g], unresolved_mask);
+			set_text(d, r, tail); r->state = PC_CANDIDATE; return;
+		}
+		if (since(now, r->last_scan_s) < r->p.scan_cooldown_s) {
+			snprintf(tail, sizeof(tail), "persistent %s %lds | candidate inside 0x%x | WAIT: scan cooldown (%lds left)",
+				gname(g), now - r->bad_since[g], unresolved_mask, r->p.scan_cooldown_s - (since(now, r->last_scan_s)));
+			set_text(d, r, tail); r->state = PC_CANDIDATE; return;
+		}
+		if (r->tier == PC_TIER_IDLE_SCAN && r->own_s > r->p.idle_own) {
+			snprintf(tail, sizeof(tail), "persistent %s %lds | candidate inside 0x%x | WAIT: own airtime %d%% above idle %d%%",
+				gname(g), now - r->bad_since[g], unresolved_mask, pc_ceil_pct(r->own_s), pc_ceil_pct(r->p.idle_own));
+			set_text(d, r, tail); r->state = PC_CANDIDATE; return;
+		}
+		d->act = PC_ACT_SCAN; d->mask = unresolved_mask; r->scan_pending = unresolved_mask; r->state = PC_CONFIRMING;
+		snprintf(tail, sizeof(tail), "persistent %s %lds | candidate inside 0x%x | SCAN to resolve", gname(g), now - r->bad_since[g], unresolved_mask);
+		set_text(d, r, tail); return;
+	}
+	d->act = PC_ACT_APPLY; d->mask = best; r->want = best; r->state = PC_APPLYING;
+	snprintf(tail, sizeof(tail), "persistent %s %lds | candidate 0x%x score %d -> %d (%+d.%d%%) | APPLY",
+		gname(g), now - r->bad_since[g], best, sc_cur, r->last_score_cand, best_gain / 10, best_gain % 10);
+	set_text(d, r, tail);
+}
+
+void pc_step(pc_radio_t *r, const pc_sample_t *s, long now, pc_decision_t *d)
+{
+	d->act = PC_ACT_NONE; d->mask = 0; d->text[0] = 0;
+	if (r->state == PC_DISABLED) return;
+
+	if (s && s->valid) {
+		absorb(r, s, now);
+		if (r->state == PC_ERROR) { r->state = r->cur ? PC_HOLDING : PC_MONITORING; }
+	} else if (r->last_sample_s && now - r->last_sample_s >= PC_ERR_AFTER_S && r->state != PC_ERROR && r->state != PC_FALLBACK) {
+		r->state = PC_ERROR; r->error_at_s = now;
+		set_text(d, r, "no usable telemetry window for 60 s | ERROR: holding the current pattern");
+		return;
+	}
+
+	if (r->state == PC_FALLBACK) {
+		if (now - r->fallback_at_s >= PC_FALLBACK_S) { r->state = PC_MONITORING; r->refusals = 0; r->last_eval_s = now; }
+		return;
+	}
+	if (r->state == PC_ERROR || r->state == PC_APPLYING || r->state == PC_CONFIRMING || r->state == PC_RESTORE)
+		return;					/* waiting on the applier or a scan */
+	if (r->state == PC_HOLDING && now >= r->hold_until_s) r->state = PC_MONITORING;
+	if (r->state == PC_HOLDING) return;
+	if (!r->have_stats) return;
+	if (now - r->last_eval_s < r->p.eval_s) return;
+	r->last_eval_s = now;
+	evaluate(r, now, d);
+}
+
+void pc_report_apply(pc_radio_t *r, enum pc_apply_result res, long now)
+{
+	unsigned w = r->want;
+	int was_restore = (r->state == PC_RESTORE);
+
+	if (r->state != PC_APPLYING && r->state != PC_RESTORE) return;
+	switch (res) {
+	case PC_APPLY_OK:
+		if (was_restore) {
+			r->restores++;
+			/* a restore that follows a puncture too closely means the slice was
+			 * not really clean: back off the next restore hold */
+			r->restore_at_s = now;
+			r->cur = 0;
+		} else {
+			r->applies++;
+			if (r->restore_at_s && now - r->restore_at_s <= (long)r->p.eval_s * PC_PROBE_WINDOW_MULT + r->p.min_interval_s) {
+				if (r->restore_backoff < PC_RESTORE_BACKOFF_MAX) r->restore_backoff *= 2;
+			} else
+				r->restore_backoff = 1;
+			r->cur = w;
+		}
+		r->last_change_s = now;
+		r->hold_until_s = now + r->p.min_interval_s;
+		r->state = PC_HOLDING;
+		r->refusals = 0;
+		break;
+	case PC_APPLY_REFUSED:
+		if (!was_restore && r->nbl < PC_BL_MAX) r->blacklist[r->nbl++] = w;
+		r->refusals++;
+		r->state = r->cur ? PC_HOLDING : PC_MONITORING;
+		r->hold_until_s = now + r->p.eval_s;
+		if (r->refusals >= PC_MAX_REFUSALS) { r->state = PC_FALLBACK; r->fallback_at_s = now; }
+		break;
+	case PC_APPLY_DISRUPTIVE:
+		r->disruptions++;
+		r->slow = 1;
+		params_effective(r);
+		r->cur = was_restore ? 0 : w;	/* it did go on; the caller clears it next */
+		r->last_change_s = now;
+		r->state = (r->disruptions >= PC_MAX_DISRUPTIONS) ? PC_FALLBACK : PC_HOLDING;
+		r->fallback_at_s = now;
+		r->hold_until_s = now + r->p.min_interval_s;
+		break;
+	default:
+		r->state = r->cur ? PC_HOLDING : PC_MONITORING;
+		r->hold_until_s = now + r->p.eval_s;
+		break;
+	}
+	r->want = r->cur;
+	r->cand_since_s = 0;
+}
+
+/* The caller found the radio no longer carries `cur` (a wireless restart the
+ * applier could not redo, a refusal on a new channel, a clear by hand): the
+ * belief goes, the statistics and the blacklist stay, and the change interval
+ * still counts from the last change - a re-apply is not a free flip. */
+void pc_report_lost(pc_radio_t *r, long now)
+{
+	if (r->state == PC_DISABLED || !r->cur) return;
+	r->cur = 0; r->want = 0; r->cand = 0; r->cand_since_s = 0;
+	r->scan_pending = 0;
+	r->hold_until_s = 0;
+	if (r->state != PC_FALLBACK && r->state != PC_ERROR) r->state = PC_MONITORING;
+	r->last_eval_s = now;
+	snprintf(r->last_reason, sizeof(r->last_reason), "slice no longer on the radio | monitoring afresh");
+}
+
+void pc_report_scan(pc_radio_t *r, const int busy20[PC_MAX20], long now)
+{
+	int i;
+	for (i = 0; i < r->n20 && i < PC_MAX20; i++)
+		if (busy20[i] >= 0) { r->scan_busy[i] = busy20[i] > 1000 ? 1000 : busy20[i]; r->scan_at[i] = now; }
+	r->last_scan_s = now;
+	r->scans++;
+	r->scan_pending = 0;
+	if (r->state == PC_CONFIRMING) {
+		r->state = r->cur ? PC_HOLDING : PC_MONITORING;
+		r->hold_until_s = 0;
+		r->last_eval_s = now - r->p.eval_s;	/* evaluate on the next step with the fresh readings */
+	}
+}
