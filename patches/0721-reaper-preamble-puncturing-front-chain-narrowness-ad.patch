+/* v3.2.8 (crawl 2026-09-26, F3): what counts as NARROW - the one definition for
+ * the two generated scripts that judge a rule sitting ahead of the Reaper front
+ * chains (hook.sh _front_pos, rwatch 3d). One macro, two emitters: the compiler
+ * is the lockstep. Extended regular expressions, applied to `iptables -S` text.
+ *
+ * INPUT and OUTPUT: a port or a destination bounds the rule to one service or
+ * one host - the router's own services, the lab's `-i br0 --dport 5219`.
+ * FORWARD: only a destination does. A port-only ACCEPT there passes every
+ * device to every host on that port past Warden, Gatekeeper and the rules
+ * engine, and an interface-only one (`-i br0`) passes every LAN device - the
+ * blanket bypass this check exists to catch. Same reasoning that keeps `-s`
+ * out everywhere: bounding WHO, or WHICH SERVICE, does not bound WHERE they
+ * reach. A negated match (`! -d`, `! --dport`) never narrows anything.
+ * A jump to a user chain is narrow when the chain's own ACCEPTs are; a RETURN
+ * inside a user chain resumes the base chain, where our jump is next, so it
+ * cannot bypass us and is not counted (F3b - it used to be, which judged a
+ * whitelist chain broad and re-pinned ahead of it). */
+#define REAPER_FCNARROW_IO   "(--dport|--sport|-d [0-9])"
+#define REAPER_FCNARROW_FWD  "-d [0-9]"
+
 /* shell line for the tail of a generated apply script (never fails the script) */
 #define REAPER_HOOK_RUN  "if [ -x " REAPER_HOOK_SH " ]; then sh " REAPER_HOOK_SH "; else logger -t reaper 'hook.sh missing - layer chain built but not hooked'; fi\n"
 
diff --git a/release/src/router/rc/reaper_punct.c b/release/src/router/rc/reaper_punct.c
new file mode 100644
index 0000000000..43cea86163
--- /dev/null
+++ b/release/src/router/rc/reaper_punct.c
@@ -0,0 +1,377 @@
+/*
+ * SPDX-License-Identifier: GPL-2.0-only
+ * Copyright (C) 2026 the Reaper project maintainer
+ *
+ * reaper: static preamble puncturing (802.11be "disabled subchannels").
+ *
+ * A Wi-Fi 7 radio can switch off one busy slice of a wide channel and keep the
+ * rest, instead of dropping the whole channel to a narrower width. Broadcom's
+ * DYNAMIC puncturing (punct_features) is compiled out of this SDK
+ * (WIFI7_SDK_20231126); the STATIC form is in the driver as
+ * `wl eht dissubchan <bitmap>` and nothing in the stock firmware ever calls it -
+ * not wlconf, acsd2, hostapd, rc or libshared, and not the OFDMA/MU-MIMO
+ * setting either (that only sets eht_features 0x8-0x40). This applet is the
+ * caller.
+ *
+ * Measured on the owner's RT-BE96U, 2026-09-25 (driver 17.10.369.39012):
+ *   - the bitmap is relative to the channel block, bit 0 = its lowest 20 MHz
+ *     (6g69/320-1 spans ch 65-125, so the primary 69 is bit 1);
+ *   - it applies instantly, with no radio restart, and the beacon's EHT
+ *     Operation element gains the Disabled Subchannel Bitmap; when the slice is
+ *     inside the 160 MHz that Wi-Fi 6 clients use, the driver narrows the HE
+ *     Operation width by itself;
+ *   - the driver refuses (rc=211, state untouched) anything but ONE slice: at
+ *     320 an aligned 40 or 80 outside the primary 80, at 80 one 20 that is not
+ *     the primary; 160 was not measured;
+ *   - restart_wireless CLEARS it, so this must run after every wireless start;
+ *   - a primary BSS parked by amaspark does not matter - the setting is per
+ *     radio and shows in the VIFs' beacons - so readiness is "the radio is up
+ *     and one of its VIFs is up", never the primary BSS.
+ *
+ * Setting: nvram wlN_punct = "<key>|0x<bitmap>", empty = off.
+ *   key = a chanspec ("6g69/320-1")  FIXED: only on that exact channel;
+ *   key = "w<width>" ("w320")         FOLLOW: on any channel of that width, so
+ *                                     it survives acsd and DFS moves;
+ *   "dyn|..."                         DYNAMIC: the controller (rpunctd) picks
+ *                                     the bitmap and writes it to
+ *                                     /tmp/reaper_punct.dyn ("wlN 0x<bitmap>");
+ *                                     this applier treats it as FOLLOW on the
+ *                                     live width. No line, or 0x0 = nothing
+ *                                     chosen: clear what we set, result dyn-idle.
+ * The driver is the final judge of legality (which slice is the primary is
+ * its business); this applet only rejects shapes no width allows.
+ *
+ * One-shot per run. Started by start_reaper_punct() at boot, after every
+ * wireless start, from the Settings page (rc_service reaper_punct) and from the
+ * rwatch tick, which also moves a FOLLOW pattern after a channel change - acsd2
+ * is closed, so there is no channel-change hook to use instead. With every
+ * wlN_punct empty and nothing of ours on the air, it issues no wl command at
+ * all. It only ever clears a pattern it set itself (the state file says which).
+ * rc logmessage() lines can be filtered by the syslog level on some boxes; the
+ * state file is the record: /tmp/reaper_punct.state, one line per radio.
+ */
+#include "rc.h"
+#include <signal.h>
+#include <sys/sysinfo.h>
+
+#define PU_TAG		"reaper_punct"
+#define PU_STATE	"/tmp/reaper_punct.state"
+#define PU_DYN		"/tmp/reaper_punct.dyn"		/* rpunctd's choice, "wlN 0x<bitmap> ..." per line */
+#define PU_MAXU		4		/* radios: the GT-BE98 family has four; the band comes from wlN_nband */
+#define PU_WAIT		60		/* s, bounded wait for a radio after a wireless restart */
+
+static long up_s(void)
+{
+	struct sysinfo si;
+	return sysinfo(&si) == 0 ? (long)si.uptime : (long)time(NULL);
+}
+
+/* an interface name as it goes into the popen() below: the nvram value is ours,
+ * but it becomes a shell word, so it is gated first (fleet audit 2026-07, C11) */
+static int ifname_ok(const char *s)
+{
+	size_t n = strlen(s);
+	return n > 0 && n < IFNAMSIZ &&
+	       strspn(s, "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789._-") == n;
+}
+
+/* first line of `wl -i <ifn> <args>`, 0 = got one */
+static int wl_line(const char *ifn, const char *args, char *buf, size_t len)
+{
+	char cmd[96];
+	FILE *p;
+	int ok;
+
+	buf[0] = 0;
+	snprintf(cmd, sizeof(cmd), "wl -i %s %s 2>/dev/null", ifn, args);
+	if ((p = popen(cmd, "r")) == NULL)
+		return -1;
+	ok = fgets(buf, len, p) != NULL;
+	pclose(p);
+	if (!ok)
+		return -1;
+	buf[strcspn(buf, "\r\n")] = 0;
+	return 0;
+}
+
+/* the live pattern: "Puncture pattern: 0x<hex>" */
+static int live_bitmap(const char *ifn, unsigned int *out)
+{
+	char buf[96], *p;
+
+	if (wl_line(ifn, "eht dissubchan", buf, sizeof(buf)) < 0)
+		return -1;
+	if ((p = strstr(buf, "0x")) == NULL)
+		return -1;
+	*out = (unsigned int)strtoul(p, NULL, 16);
+	return 0;
+}
+
+/* the live chanspec as the driver prints it ("6g69/320-1 (0x7042)" -> "6g69/320-1") */
+static int live_chanspec(const char *ifn, char *cs, size_t len)
+{
+	char buf[64];
+
+	if (wl_line(ifn, "chanspec", buf, sizeof(buf)) < 0)
+		return -1;
+	buf[strcspn(buf, " \t")] = 0;
+	if (!buf[0])
+		return -1;
+	strlcpy(cs, buf, len);
+	return 0;
+}
+
+/* 20/40 MHz chanspecs carry no "/<width>" ("149", "36l"), so they read as 0 = too narrow */
+static int chanspec_width(const char *cs)
+{
+	const char *s = strchr(cs, '/');
+	return s ? atoi(s + 1) : 0;
+}
+
+/* the radio is up and at least one of its client networks (wlN_vifs) is up */
+static int radio_ready(int u, const char *ifn)
+{
+	char buf[32], key[24], vifs[128], word[32], *next;
+
+	if (wl_line(ifn, "isup", buf, sizeof(buf)) < 0 || atoi(buf) != 1)
+		return 0;
+	if (wl_line(ifn, "bss", buf, sizeof(buf)) == 0 && !strncmp(buf, "up", 2))
+		return 1;
+	snprintf(key, sizeof(key), "wl%d_vifs", u);
+	strlcpy(vifs, nvram_safe_get(key), sizeof(vifs));
+	foreach (word, vifs, next) {
+		if (!ifname_ok(word))
+			continue;
+		if (wl_line(word, "bss", buf, sizeof(buf)) == 0 && !strncmp(buf, "up", 2))
+			return 1;
+	}
+	return 0;
+}
+
+/* one contiguous, aligned run of 20 MHz slices whose size this width allows:
+ * 80 -> one 20; 160 -> one 20 or one 40; 320 -> one 40 or one 80 */
+static int shape_ok(int width, unsigned int b)
+{
+	int n = width / 20, start, len;
+
+	if (b == 0 || n <= 0 || n > 16 || (n < 16 && (b >> n)))
+		return 0;
+	for (start = 0; !(b & (1u << start)); start++)
+		;
+	for (len = 0; start + len < 16 && (b & (1u << (start + len))); len++)
+		;
+	if (b >> (start + len))
+		return 0;		/* more than one run */
+	if (start % len)
+		return 0;		/* not aligned to its own size */
+	switch (width) {
+	case 80:  return len == 1;
+	case 160: return len == 1 || len == 2;
+	case 320: return len == 2 || len == 4;
+	}
+	return 0;
+}
+
+/* what the previous run applied, per radio ("set=0x.." in the state file) */
+static void state_read(unsigned int prev[PU_MAXU])
+{
+	FILE *f;
+	char line[256], *p;
+	int u;
+
+	memset(prev, 0, sizeof(unsigned int) * PU_MAXU);
+	if ((f = fopen(PU_STATE, "r")) == NULL)
+		return;
+	while (fgets(line, sizeof(line), f)) {
+		if (sscanf(line, "wl%d ", &u) != 1 || u < 0 || u >= PU_MAXU)
+			continue;
+		if ((p = strstr(line, " set=0x")) != NULL)
+			prev[u] = (unsigned int)strtoul(p + 5, NULL, 16);
+	}
+	fclose(f);
+}
+
+/* the bitmap the dynamic controller chose for this radio, 0 = none */
+static unsigned int dyn_choice(int u)
+{
+	FILE *f;
+	char line[128];
+	int lu;
+	unsigned int b = 0, v;
+
+	if ((f = fopen(PU_DYN, "r")) == NULL)
+		return 0;
+	while (fgets(line, sizeof(line), f))
+		if (sscanf(line, "wl%d 0x%x", &lu, &v) == 2 && lu == u) { b = v; break; }
+	fclose(f);
+	return b;
+}
+
+static int set_bitmap(const char *ifn, unsigned int b)
+{
+	char hex[16];
+
+	snprintf(hex, sizeof(hex), "0x%x", b);
+	return eval("wl", "-i", (char *)ifn, "eht", "dissubchan", hex);
+}
+
+int reaper_punct_main(int argc, char *argv[])
+{
+	unsigned int prev[PU_MAXU];
+	char out[PU_MAXU][224];
+	long deadline;
+	int u, any = 0;
+	FILE *f;
+	(void)argc; (void)argv;
+
+	signal(SIGHUP, SIG_IGN);
+	state_read(prev);
+	for (u = 0; u < PU_MAXU; u++) {
+		char key[24];
+		snprintf(key, sizeof(key), "wl%d_punct", u);
+		if (*nvram_safe_get(key) || prev[u])
+			any = 1;
+	}
+	if (!any) {
+		unlink(PU_STATE);
+		return 0;	/* off, and nothing of ours on the air: not a single wl command */
+	}
+
+	deadline = up_s() + PU_WAIT;
+	for (u = 0; u < PU_MAXU; u++) {
+		char key[24], ifn[IFNAMSIZ], want[64], wkey[48], cs[48] = "-";
+		const char *result = "off";
+		unsigned int b = 0, live = 0, set = 0;
+		int nband, width, have_live = 0, dyn = 0;
+		char *bar;
+
+		out[u][0] = 0;
+		snprintf(key, sizeof(key), "wl%d_ifname", u);
+		strlcpy(ifn, nvram_safe_get(key), sizeof(ifn));
+		if (!ifn[0])
+			continue;
+		if (!ifname_ok(ifn)) {
+			snprintf(out[u], sizeof(out[u]), "wl%d if=? want=- cs=- live=- set=0x0 result=skipped-ifname", u);
+			continue;
+		}
+		snprintf(key, sizeof(key), "wl%d_punct", u);
+		strlcpy(want, nvram_safe_get(key), sizeof(want));
+		snprintf(key, sizeof(key), "wl%d_nband", u);
+		nband = nvram_get_int(key);
+
+		if (!want[0] && !prev[u]) {
+			snprintf(out[u], sizeof(out[u]), "wl%d if=%s want=- cs=- live=- set=0x0 result=off", u, ifn);
+			continue;
+		}
+
+		/* parse "<key>|0x<bitmap>", or take the dynamic controller's choice */
+		wkey[0] = 0;
+		if (want[0] && !strncmp(want, "dyn", 3)) {
+			dyn = 1;
+			b = dyn_choice(u);
+		} else if (want[0] && (bar = strchr(want, '|')) != NULL) {
+			*bar = 0;
+			strlcpy(wkey, want, sizeof(wkey));
+			b = (unsigned int)strtoul(bar + 1, NULL, 16);
+			*bar = '|';
+		}
+
+		snprintf(key, sizeof(key), "wl%d_radio", u);
+		if (nband != 1 && nband != 4)
+			result = want[0] ? "skipped-band" : "off";
+		else if (nvram_match(key, "0"))
+			result = "skipped-radio-off";
+		else {
+			snprintf(key, sizeof(key), "wl%d_11be", u);
+			if (want[0] && !nvram_match(key, "1"))
+				result = "skipped-no-wifi7";
+			else if (want[0] && !dyn && (!wkey[0] || !b))
+				result = "skipped-malformed";
+			else if (dyn && !b)
+				result = "dyn-idle";		/* nothing chosen: clear anything of ours below */
+			else {
+				while (!radio_ready(u, ifn) && up_s() < deadline)
+					sleep(2);
+				if (!radio_ready(u, ifn))
+					result = "waiting";
+				else if (live_bitmap(ifn, &live) < 0 || live_chanspec(ifn, cs, sizeof(cs)) < 0)
+					result = "error-read";
+				else {
+					have_live = 1;
+					width = chanspec_width(cs);
+					if (dyn)
+						snprintf(wkey, sizeof(wkey), "w%d", width);	/* the controller's choice follows the live width */
+					if (!want[0])
+						result = "off";
+					else if (wkey[0] == 'w' ? atoi(wkey + 1) != width : strcmp(wkey, cs) != 0)
+						result = "stale";
+					else if (!shape_ok(width, b))
+						result = "skipped-shape";
+					else if (live == b) {
+						result = "applied";
+						set = b;
+					} else {
+						set_bitmap(ifn, b);
+						if (live_bitmap(ifn, &live) == 0 && live == b) {
+							result = "applied";
+							set = b;
+							logmessage(PU_TAG, "%s: slice 0x%x switched off on %s (%s)", ifn, b, cs,
+								dyn ? "chosen dynamically" : wkey[0] == 'w' ? "follows the channel" : "fixed channel");
+						} else {
+							result = "refused";
+							logmessage(PU_TAG, "%s: the driver refused slice 0x%x on %s - the primary 80 MHz and odd shapes cannot be punctured", ifn, b, cs);
+						}
+					}
+				}
+			}
+		}
+
+		/* a Dynamic radio with nothing chosen still reports the live channel and
+		 * pattern in its state line (the page and the diag read them) */
+		if (dyn && !b && !have_live && live_bitmap(ifn, &live) == 0 && live_chanspec(ifn, cs, sizeof(cs)) == 0)
+			have_live = 1;
+
+		/* anything we set earlier that is no longer wanted here comes off - but only if
+		 * the driver still carries exactly what we set (never a pattern it chose) */
+		if (!set && prev[u]) {
+			if (!have_live && live_bitmap(ifn, &live) == 0)
+				have_live = 1;
+			if (have_live && live == prev[u]) {
+				set_bitmap(ifn, 0);
+				live_bitmap(ifn, &live);
+				logmessage(PU_TAG, "%s: cleared slice 0x%x (%s)", ifn, prev[u], result);
+			}
+		}
+
+		snprintf(out[u], sizeof(out[u]), "wl%d if=%s want=%s cs=%s live=%s0x%x set=0x%x result=%s%s",
+			u, ifn, want[0] ? want : "-", cs, have_live ? "" : "?", live, set, result, dyn ? " src=dyn" : "");
+	}
+
+	if ((f = fopen(PU_STATE ".tmp", "w")) != NULL) {
+		for (u = 0; u < PU_MAXU; u++)
+			if (out[u][0])
+				fprintf(f, "%s\n", out[u]);
+		fclose(f);
+		rename(PU_STATE ".tmp", PU_STATE);
+	}
+	return 0;
+}
+
+/* boot, every wireless start, the Settings page and the rwatch tick. Nothing
+ * configured and nothing of ours on the air = nothing started. */
+void start_reaper_punct(void)
+{
+	char key[24];
+	int u, want = 0;
+
+	for (u = 0; u < PU_MAXU && !want; u++) {
+		snprintf(key, sizeof(key), "wl%d_punct", u);
+		if (*nvram_safe_get(key))
+			want = 1;
+	}
+	if (!want && !f_exists(PU_STATE))
+		return;
+	if (pids("reaper_punct"))
+		killall_tk("reaper_punct");
+	xstart("reaper_punct");
+}
