+ *
+ * punct_core - the decision layer of dynamic preamble puncturing.
+ *
+ * Pure logic, no I/O, no clock of its own: the caller (rpunctd on the router,
+ * punct_host on a build host) feeds it telemetry windows and a monotonic
+ * second count, and executes the actions it returns through the ONE applier
+ * (rc/reaper_punct.c). Everything that decides WHETHER a slice is switched off
+ * lives here so it can be exercised on a build host with synthetic telemetry
+ * before a radio ever sees it (build-scripts/tests/test_punct_dyn.py).
+ *
+ * Principle: dynamic selection, static application. A bitmap changes only
+ * when the problem is sustained, the candidate is legal, the primary stays,
+ * the candidate is meaningfully better, and the change interval has expired.
+ *
+ * Telemetry model (measured on the RT-BE96U, 2026-09-26): a timed
+ * `chanim_stats us` window gives carrier-sense time on the primary 20
+ * (pri20), the other 20 of the primary 40 (sec20), the other 40 of the primary
+ * 80 (sec40) and the other 80 of the primary 160 (sec80), plus the whole
+ * channel's busy time. At 320 MHz the far 160 is only a remainder. Slices the
+ * counters do not resolve (the far 160, the halves of a group) can be resolved
+ * by a passive scan of their 20 MHz channels, which the scan tiers request.
+ */
+#ifndef PUNCT_CORE_H
+#define PUNCT_CORE_H
+
+#define PC_MAX20	16		/* 320 MHz = 16 x 20 MHz */
+#define PC_TEXT		320		/* one decision line */
+#define PC_BL_MAX	8		/* refused bitmaps remembered per geometry */
+#define PC_CAND_MAX	16
+
+enum pc_state {
+	PC_DISABLED = 0, PC_MONITORING, PC_CANDIDATE, PC_CONFIRMING, PC_APPLYING,
+	PC_HOLDING, PC_RESTORE, PC_ERROR, PC_FALLBACK
+};
+enum pc_tier { PC_TIER_PASSIVE = 0, PC_TIER_IDLE_SCAN, PC_TIER_ACTIVE_SCAN };
+enum pc_preset { PC_CONSERVATIVE = 0, PC_BALANCED, PC_AGGRESSIVE };
+enum pc_action { PC_ACT_NONE = 0, PC_ACT_APPLY, PC_ACT_CLEAR, PC_ACT_SCAN };
+enum pc_apply_result { PC_APPLY_OK = 0, PC_APPLY_REFUSED, PC_APPLY_DISRUPTIVE, PC_APPLY_FAILED };
+
+/* the counter groups a window resolves; FAR is the unresolved remainder at 320 */
+enum pc_group { G_PRI = 0, G_SEC20, G_SEC40, G_SEC80, G_FAR, G_N };
+
+/* every threshold the presets set; permille for busy figures, seconds for times */
+typedef struct {
+	int trigger;		/* busy at/above which a slice is a problem */
+	int restore;		/* busy at/below which a punctured slice counts as clean */
+	int hold_bad_s;		/* the problem must persist this long */
+	int hold_good_s;	/* a punctured slice must stay clean this long */
+	int min_gain;		/* permille score gain a change must bring */
+	int min_interval_s;	/* between two configuration changes */
+	int eval_s;		/* between evaluations */
+	int scan_cooldown_s;	/* between two confirmation scans */
+	int idle_own;		/* own airtime at/below which the idle scan tier may scan */
+} pc_params_t;
+
+/* one telemetry window, already reduced to permille of its duration */
+typedef struct {
+	int valid;		/* 0 = the window carried nothing, discard */
+	int pri, sec20, sec40, sec80;	/* carrier sense per counter group */
+	int total;		/* whole-channel busy */
+	int own;		/* own airtime (tx + inbss) */
+} pc_sample_t;
+
+typedef struct {
+	enum pc_action act;
+	unsigned mask;		/* APPLY: the bitmap; SCAN: the 20 MHz sub-channels to scan */
+	char text[PC_TEXT];	/* why, in the log's words */
+} pc_decision_t;
+
+typedef struct {
+	/* configuration */
+	pc_params_t p;		/* effective parameters (preset, overrides, slow mode) */
+	enum pc_preset preset;
+	enum pc_tier tier;
+	int gain_override, hold_override;
+	int slow;		/* set after a disruptive apply: timers x3 */
+	/* geometry: bitmap-relative, bit 0 = the lowest 20 MHz of the block */
+	int width, n20, primary;
+	unsigned gmask[G_N];	/* sub-channels each counter group covers (0 = absent) */
+	/* rolling statistics per group, permille */
+	int have_stats;
+	int ewma_s[G_N], ewma_l[G_N];
+	int own_s;
+	long bad_since[G_N], clean_since[G_N];	/* 0 = not currently so */
+	long last_sample_s, first_sample_s;
+	/* scan tier: per sub-channel busy from the last confirmation scan */
+	int scan_busy[PC_MAX20];	/* permille, -1 = none */
+	long scan_at[PC_MAX20];
+	int scan_ttl_s;
+	long last_scan_s;
+	unsigned scan_pending;	/* sub-channels a requested scan will cover */
+	/* state */
+	enum pc_state state;
+	unsigned cur;		/* the bitmap we believe is on the radio */
+	unsigned want;		/* the bitmap an APPLY/CLEAR is carrying */
+	unsigned cand;
+	long last_change_s, last_eval_s, hold_until_s, fallback_at_s, error_at_s;
+	long restore_at_s;	/* when the last restore happened (probe backoff) */
+	int restore_backoff;	/* multiplier on hold_good after a restore that did not hold */
+	unsigned blacklist[PC_BL_MAX];
+	int nbl;
+	int refusals, disruptions, applies, restores, scans;
+	/* last figures, for the JSON snapshot */
+	int last_score_cur, last_score_cand, last_gain;
+	long cand_since_s;
+	char last_reason[PC_TEXT];
+} pc_radio_t;
+
+void pc_init(pc_radio_t *r, enum pc_preset preset, enum pc_tier tier, int gain_override, int hold_override);
+/* (re)geometry: width in MHz, primary = index of the primary 20 in the block. Resets stats + state. */
+void pc_set_geometry(pc_radio_t *r, int width, int primary, long now);
+/* feed one window (sample may be NULL = no window this tick); evaluates when due */
+void pc_step(pc_radio_t *r, const pc_sample_t *s, long now, pc_decision_t *d);
+/* the applier's verdict for the last APPLY/CLEAR */
+void pc_report_apply(pc_radio_t *r, enum pc_apply_result res, long now);
+/* the bitmap we believed was on the radio is not there any more: forget it, monitor afresh */
+void pc_report_lost(pc_radio_t *r, long now);
+/* per-sub-channel busy (permille, -1 = not scanned) from a confirmation scan */
+void pc_report_scan(pc_radio_t *r, const int busy20[PC_MAX20], long now);
+
+/* helpers shared with the tests */
+int pc_legal_masks(int width, int primary, unsigned out[], int max);
+int pc_score(const pc_radio_t *r, unsigned mask);
+const char *pc_state_name(enum pc_state s);
+const pc_params_t *pc_preset_params(enum pc_preset p);
+int pc_ceil_pct(int permille);
+
+#endif
diff --git a/release/src/router/rpunctd/punct_host.c b/release/src/router/rpunctd/punct_host.c
new file mode 100644
index 0000000000..faf155c6f4
--- /dev/null
+++ b/release/src/router/rpunctd/punct_host.c
@@ -0,0 +1,82 @@
+/*
+ * SPDX-License-Identifier: GPL-2.0-only
+ * Copyright (C) 2026 the Reaper project maintainer
+ *
+ * punct_host - drives punct_core with a scenario file on a build host. Not
+ * built for the router. One command per line:
+ *   init <c|b|a> <p|i|a> [gain_permille] [hold_s]
+ *   geom <width> <primary> <now>
+ *   t <now> <pri> <sec20> <sec40> <sec80> <total> <own>      one valid window (permille)
+ *   x <now>                                                  a tick with no usable window
+ *   scan <now> b0 b1 ... b(n20-1)                            scan busy per sub-channel (-1 none)
+ *   apply <ok|refused|disruptive|failed> <now>
+ *   lost <now>                                               the slice is no longer on the radio
+ *   legal <width> <primary>                                  print the legal bitmaps
+ *   score <mask>                                             print pc_score at the last state
+ * Every decision that is not NONE prints "<now> <ACTION> <mask> <text>"; state
+ * changes print "<now> STATE <name>".
+ */
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include "punct_core.h"
+
+int main(int argc, char **argv)
+{
+	FILE *f = (argc > 1) ? fopen(argv[1], "r") : stdin;
+	pc_radio_t r;
+	pc_decision_t d;
+	char line[512], w1[16], w2[16];
+	enum pc_state last = PC_DISABLED;
+	long now;
+
+	if (!f) { perror("scenario"); return 2; }
+	pc_init(&r, PC_CONSERVATIVE, PC_TIER_PASSIVE, 0, 0);
+	while (fgets(line, sizeof(line), f)) {
+		if (line[0] == '#' || line[0] == '\n') continue;
+		if (!strncmp(line, "init ", 5)) {
+			int gain = 0, hold = 0;
+			sscanf(line + 5, "%15s %15s %d %d", w1, w2, &gain, &hold);
+			pc_init(&r, w1[0] == 'b' ? PC_BALANCED : w1[0] == 'a' ? PC_AGGRESSIVE : PC_CONSERVATIVE,
+				w2[0] == 'i' ? PC_TIER_IDLE_SCAN : w2[0] == 'a' ? PC_TIER_ACTIVE_SCAN : PC_TIER_PASSIVE, gain, hold);
+		} else if (!strncmp(line, "geom ", 5)) {
+			int wd, p; sscanf(line + 5, "%d %d %ld", &wd, &p, &now);
+			pc_set_geometry(&r, wd, p, now);
+		} else if (!strncmp(line, "t ", 2)) {
+			pc_sample_t s; s.valid = 1;
+			sscanf(line + 2, "%ld %d %d %d %d %d %d", &now, &s.pri, &s.sec20, &s.sec40, &s.sec80, &s.total, &s.own);
+			pc_step(&r, &s, now, &d);
+			if (d.act != PC_ACT_NONE) printf("%ld %s 0x%x %s\n", now, d.act == PC_ACT_APPLY ? "APPLY" : d.act == PC_ACT_CLEAR ? "CLEAR" : "SCAN", d.mask, d.text);
+			else if (d.text[0] && getenv("PUNCT_VERBOSE")) printf("%ld NOTE %s\n", now, d.text);
+		} else if (!strncmp(line, "x ", 2)) {
+			sscanf(line + 2, "%ld", &now);
+			pc_step(&r, NULL, now, &d);
+			if (d.text[0]) printf("%ld %s 0x%x %s\n", now, d.act == PC_ACT_NONE ? "NOTE" : "ACT", d.mask, d.text);
+		} else if (!strncmp(line, "scan ", 5)) {
+			int b[PC_MAX20], i, n; char *p = line + 5;
+			for (i = 0; i < PC_MAX20; i++) b[i] = -1;
+			now = strtol(p, &p, 10);
+			for (i = 0; i < PC_MAX20 && sscanf(p, "%d%n", &b[i], &n) == 1; i++) p += n;
+			pc_report_scan(&r, b, now);
+		} else if (!strncmp(line, "apply ", 6)) {
+			sscanf(line + 6, "%15s %ld", w1, &now);
+			pc_report_apply(&r, w1[0] == 'o' ? PC_APPLY_OK : w1[0] == 'r' ? PC_APPLY_REFUSED : w1[0] == 'd' ? PC_APPLY_DISRUPTIVE : PC_APPLY_FAILED, now);
+		} else if (!strncmp(line, "lost ", 5)) {
+			sscanf(line + 5, "%ld", &now);
+			pc_report_lost(&r, now);
+		} else if (!strncmp(line, "legal ", 6)) {
+			int wd, p, n, i; unsigned m[PC_CAND_MAX];
+			sscanf(line + 6, "%d %d", &wd, &p);
+			n = pc_legal_masks(wd, p, m, PC_CAND_MAX);
+			printf("legal %d %d:", wd, p);
+			for (i = 0; i < n; i++) printf(" 0x%x", m[i]);
+			printf("\n");
+		} else if (!strncmp(line, "score ", 6)) {
+			unsigned m = strtoul(line + 6, NULL, 0);
+			printf("score 0x%x %d\n", m, pc_score(&r, m));
+		}
+		if (r.state != last) { printf("%ld STATE %s\n", now, pc_state_name(r.state)); last = r.state; }
+	}
+	if (f != stdin) fclose(f);
+	return 0;
+}
diff --git a/release/src/router/rpunctd/rpunctd.c b/release/src/router/rpunctd/rpunctd.c
new file mode 100644
index 0000000000..093c274557
--- /dev/null
+++ b/release/src/router/rpunctd/rpunctd.c
@@ -0,0 +1,724 @@
+/*
+ * SPDX-License-Identifier: GPL-2.0-only
+ * Copyright (C) 2026 the Reaper project maintainer
+ *
+ * rpunctd - dynamic preamble puncturing controller (firmware v3.2.8).
+ *
+ * Dynamic selection, static application. Every RP_TICK it asks each Dynamic
+ * radio's driver for one timed `chanim_stats us` window (measured 2026-09-26:
+ * only a timed window fills the per-sub-band carrier-sense counters), reduces
+ * it to permille, and hands it to punct_core, which decides slowly (rolling
+ * averages, persistence holds, a minimum gain, a minimum interval between
+ * changes). A decision is executed through the ONE applier, rc/reaper_punct.c:
+ * this daemon never calls `wl eht dissubchan` itself. It writes its choice to
+ * /tmp/reaper_punct.dyn and runs /sbin/reaper_punct, which keeps the
+ * readiness wait, the shape check, the state file and the "clear only what
+ * we set" rule; the rwatch tick and the wireless-start hook re-run that
+ * applier, so a wireless restart puts the daemon's current choice back.
+ *
+ * The .dyn file is the one contract with the applier, and it always says what
+ * this daemon believes is on the radio - never a bitmap the driver refused or
+ * an apply that did not happen (crawl 2026-09-26, F1: a refused bitmap left in
+ * the file was sent again by every rwatch tick). Each tick the applier's own
+ * record (/tmp/reaper_punct.state, "set=") is read back against that belief
+ * and the two are reconciled; a bitmap that fell off the radio is forgotten, a
+ * bitmap the daemon did not choose is taken off.
+ *
+ * Confirmation scans (the Passive + idle / Active sources) are a passive
+ * `escan` of the candidate's own 20 MHz channels (about a second off-channel
+ * for four channels, measured), read back through `chanim_stats all`.
+ *
+ * It logs through syslog() directly (rc logmessage lines are dropped on boxes
+ * whose log level is "debug"), tag rpunctd, one line per decision that says
+ * why. /tmp/reaper_punct.dyn.json mirrors the state for the GUI.
+ *
+ * Off by default: it runs only while some wlN_punct reads "dyn|...", exits by
+ * itself when none does, never restarts wireless, and holds the current
+ * pattern when telemetry fails.
+ */
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <stdint.h>
+#include <unistd.h>
+#include <time.h>
+#include <signal.h>
+#include <syslog.h>
+#include <ctype.h>
+#include <sys/stat.h>
+#include <sys/types.h>
+#include <sys/wait.h>
+
+#include <bcmnvram.h>
+#include <shutils.h>
+#include <shared.h>
+
+#include "punct_core.h"
+
+#define RP_TICK		10		/* s between windows */
+#define RP_WINDOW_MS	4000		/* the timed chanim window */
+#define RP_MAXU		4
+#define RP_DYN		"/tmp/reaper_punct.dyn"
+#define RP_JSON		"/tmp/reaper_punct.dyn.json"
+#define RP_DYNSTATE	"/tmp/reaper_punct.dyn.state"	/* one flat line per radio: the diag and httpd read this */
+#define RP_STATE	"/tmp/reaper_punct.state"
+#define RP_APPLIER	"/sbin/reaper_punct"
+#define RP_APPLIER_NAME	"reaper_punct"		/* its process name, for pids() */
+#define RP_APPLIER_WAIT	70		/* s; the applier's own readiness wait is 60 */
+#define RP_LOG_REPEAT_S	900		/* an unchanged evaluation line repeats at most this often */
+
+/* ---- the driver's structures, mirrored from impl103 wlioctl.h (v2) so this
+ * file needs no Broadcom header chain; the sizes are what the driver sends ---- */
+#define WL_CHANIM_BUF_LEN		(8 * 1024)
+#define WL_CHANIM_STATS_US_VERSION	2
+#define WL_CHANIM_US_DUR		0xfa	/* arm a window of `dur` ms (a GET, measured) */
+#define WL_CHANIM_US_DUR_GET		0xfb	/* read the last closed window */
+#define CCASTATS_MAX			9
+enum { CCA_TXDUR = 0, CCA_INBSS, CCA_OBSS, CCA_NOCTG, CCA_NOPKT, CCA_DOZE, CCA_TXOP, CCA_GDTXDUR, CCA_BDTXDUR };
+
+typedef struct {
+	uint64_t total_tm, busy_tm;
+	uint64_t ccastats_us[CCASTATS_MAX];
+	uint64_t rxcrs_pri20, rxcrs_sec20, rxcrs_sec40, rxcrs_sec80;
+	uint16_t chanspec;
+} chanim_stats_us_v2_t;
+
+typedef struct {
+	uint32_t buflen, version, count, dur;
+	chanim_stats_us_v2_t stats_us_v2[];
+} wl_chanim_stats_us_v2_t;
+
+extern int wl_iovar_getbuf(char *ifname, char *iovar, void *param, int paramlen, void *bufptr, int buflen);
+extern int wl_iovar_getint(char *ifname, char *iovar, int *val);
+
+struct radio {
+	int unit, nband, dyn;
+	char ifn[16], cfg[40], vifs[128];
+	pc_radio_t pc;
+	char cs[32];		/* live chanspec as the driver prints it */
+	int raw_cs;		/* the driver's raw chanspec at the last geometry read (an iovar, no fork) */
+	int width, start, is6g;
+	int armed, misses, geom_ok;
+	int seed_pending;	/* a geometry change waits for the applier to finish before the seed */
+	int ifn_bad;		/* the interface name was rejected (said once) */
+	long last_log_s;
+	char last_logged[PC_TEXT];
+	char last_apply_note[128];
+	unsigned dyn_bitmap;	/* what the .dyn file carries for this radio */
+	long last_scan_epoch, last_change_epoch;
+};
+
+static volatile sig_atomic_t running = 1;
+static void on_term(int sig) { (void)sig; running = 0; }
+static struct radio R[RP_MAXU];
+static char iobuf[WL_CHANIM_BUF_LEN];
+
+static long mono_s(void)
+{
+	struct timespec ts;
+	if (clock_gettime(CLOCK_MONOTONIC, &ts) != 0) return (long)time(NULL);
+	return ts.tv_sec + 1;		/* never 0: the core reads 0 as "never" */
+}
+
+/* an interface name as this daemon will hand it to a shell: the nvram value is
+ * ours, but it goes into popen() strings, so it is gated before use (the
+ * project's rule since the 2026-07 fleet audit, C11) */
+static int ifname_ok(const char *s)
+{
+	size_t n = strlen(s);
+	return n > 0 && n < 16 &&
+	       strspn(s, "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789._-") == n;
+}
+
+/* first line of a command, "" on failure */
+static int cmd_line(const char *cmd, char *buf, size_t len)
+{
+	FILE *p = popen(cmd, "r");
+	int ok;
+	buf[0] = 0;
+	if (!p) return 0;
+	ok = fgets(buf, len, p) != NULL;
+	pclose(p);
+	if (ok) buf[strcspn(buf, "\r\n")] = 0;
+	return ok;
+}
+
+static int wl_line(const char *ifn, const char *args, char *buf, size_t len)
+{
+	char cmd[160];
+	snprintf(cmd, sizeof(cmd), "/usr/sbin/wl -i %s %s 2>/dev/null", ifn, args);
+	return cmd_line(cmd, buf, len);
+}
+
+/* the pattern the radio carries right now: "Puncture pattern: 0x<hex>" */
+static int live_bitmap(struct radio *r, unsigned *out)
+{
+	char buf[96], *p;
+	if (!wl_line(r->ifn, "eht dissubchan", buf, sizeof(buf)) || (p = strstr(buf, "0x")) == NULL) return 0;
+	*out = (unsigned)strtoul(p, NULL, 16);
+	return 1;
+}
+
+/* ---- configuration: wlN_punct = "dyn|<c|b|a>|<p|i|a>|<gain %>|<hold s>" ---- */
+static int parse_cfg(const char *v, enum pc_preset *pre, enum pc_tier *tier, int *gain, int *hold)
+{
+	char f[5][16];
+	int n = 0, i;
+	const char *p = v;
+
+	if (strncmp(v, "dyn", 3)) return 0;
+	for (i = 0; i < 5; i++) f[i][0] = 0;
+	while (n < 5 && *p) {
+		size_t l = strcspn(p, "|");
+		if (l >= sizeof(f[n])) l = sizeof(f[n]) - 1;
+		memcpy(f[n], p, l); f[n][l] = 0; n++;
+		p += l; if (*p == '|') p++;
+	}
+	*pre = f[1][0] == 'b' ? PC_BALANCED : f[1][0] == 'a' ? PC_AGGRESSIVE : PC_CONSERVATIVE;
+	*tier = f[2][0] == 'i' ? PC_TIER_IDLE_SCAN : f[2][0] == 'a' ? PC_TIER_ACTIVE_SCAN : PC_TIER_PASSIVE;
+	*gain = atoi(f[3]) * 10;			/* percent -> permille */
+	if (*gain < 0 || *gain > 1000) *gain = 0;
+	*hold = atoi(f[4]);
+	if (*hold < 0 || *hold > 86400) *hold = 0;
+	return 1;
+}
+
+/* ---- geometry: the channel block and where the primary sits in it ---- */
+static const int p5_80[] = { 36, 52, 100, 116, 132, 149, 165, 0 };
+static const int p5_160[] = { 36, 100, 149, 0 };
+
+static int block_start(int is6g, int ch, int width, int range2)
+{
+	int i;
+	if (!is6g) {
+		const int *l = width == 160 ? p5_160 : width == 80 ? p5_80 : NULL;
+		if (!l) return -1;
+		for (i = 0; l[i]; i++)
+			if (ch >= l[i] && ch <= l[i] + width / 5 - 4) return l[i];
+		return -1;
+	}
+	if (width == 80) return 1 + 16 * ((ch - 1) / 16);
+	if (width == 160) return 1 + 32 * ((ch - 1) / 32);
+	if (width == 320) return range2 ? (ch < 33 ? -1 : 33 + 64 * ((ch - 33) / 64)) : 1 + 64 * ((ch - 1) / 64);
+	return -1;
+}
+
+/* "6g69/320-1 (0x7042)" / "149/80 (0xe09b)" / "10 (0x100a)" -> width, block, primary index.
+ * The raw chanspec is an iovar read (no fork) and decides whether anything
+ * moved; the printed form, which the parser wants, is fetched only then. */
+static int read_geometry(struct radio *r, long now, int *changed)
+{
+	char buf[64], *s, *sl;
+	int ch, width = 0, range2 = 0, start, primary, raw = 0;
+
+	*changed = 0;
+	if (wl_iovar_getint(r->ifn, "chanspec", &raw) != 0) raw = 0;
+	if (raw && raw == r->raw_cs && r->cs[0]) return 1;
+	if (!wl_line(r->ifn, "chanspec", buf, sizeof(buf))) return 0;
+	buf[strcspn(buf, " \t")] = 0;
+	r->raw_cs = raw;
+	if (!strcmp(buf, r->cs)) return 1;	/* same channel, whatever its width: nothing to re-read */
+	*changed = 1;
+	strlcpy(r->cs, buf, sizeof(r->cs));
+	s = buf; r->is6g = 0;
+	if (!strncmp(s, "6g", 2)) { r->is6g = 1; s += 2; }
+	ch = atoi(s);
+	if ((sl = strchr(s, '/')) != NULL) { width = atoi(sl + 1); if (strstr(sl, "320-2")) range2 = 1; }
+	r->width = width;
+	if (width < 80 || ch <= 0 || (start = block_start(r->is6g, ch, width, range2)) < 0) {
+		r->geom_ok = 0;
+		pc_set_geometry(&r->pc, 0, 0, now);	/* disabled until a wide channel */
+		return 1;
+	}
+	primary = (ch - start) / 4;
+	r->start = start;
+	r->geom_ok = 1;
+	pc_set_geometry(&r->pc, width, primary, now);
+	return 1;
+}
+
+/* ---- telemetry: arm a window, read it back later ---- */
+static int chanim_req(struct radio *r, uint32_t count, uint32_t dur)
+{
+	wl_chanim_stats_us_v2_t p;
+	memset(&p, 0, sizeof(p));
+	p.buflen = WL_CHANIM_BUF_LEN; p.version = WL_CHANIM_STATS_US_VERSION; p.count = count; p.dur = dur;
+	return wl_iovar_getbuf(r->ifn, "chanim_stats", &p, sizeof(p), iobuf, sizeof(iobuf));
+}
+
+static void arm_window(struct radio *r)
+{
+	r->armed = (chanim_req(r, WL_CHANIM_US_DUR, RP_WINDOW_MS) == 0);
+}
+
+/* the window as permille figures: foreign energy per sub-band, own airtime */
+static int read_window(struct radio *r, pc_sample_t *s)
+{
+	wl_chanim_stats_us_v2_t *rep = (wl_chanim_stats_us_v2_t *)iobuf;
+	chanim_stats_us_v2_t *w;
+	uint64_t T, tx, inbss, foreign, pri;
+
+	memset(s, 0, sizeof(*s));
+	if (!r->armed || chanim_req(r, WL_CHANIM_US_DUR_GET, 0) != 0) return 0;
+	r->armed = 0;
+	if (rep->version != WL_CHANIM_STATS_US_VERSION || rep->count < 1) return 0;
+	w = &rep->stats_us_v2[0];
+	T = w->total_tm;
+	if (T < (uint64_t)RP_WINDOW_MS * 900) return 0;		/* not a full window */
+	tx = w->ccastats_us[CCA_TXDUR]; inbss = w->ccastats_us[CCA_INBSS];
+	if (w->busy_tm == 0 && tx == 0 && w->ccastats_us[CCA_TXOP] == 0) return 0;	/* an empty window (measured to happen) */
+	foreign = w->busy_tm > tx + inbss ? w->busy_tm - tx - inbss : 0;
+	pri = w->rxcrs_pri20 > inbss ? w->rxcrs_pri20 - inbss : 0;	/* our own clients' frames are not interference */
+	s->valid = 1;
+	s->pri = (int)(pri * 1000 / T);
+	s->sec20 = (int)(w->rxcrs_sec20 * 1000 / T);
+	s->sec40 = (int)(w->rxcrs_sec40 * 1000 / T);
+	s->sec80 = (int)(w->rxcrs_sec80 * 1000 / T);
+	s->total = (int)(foreign * 1000 / T);
+	s->own = (int)((tx + inbss) * 1000 / T);
+	return 1;
+}
+
+/* ---- the applier: write the choice, run it, read its verdict ----
+ * The .dyn line is "wlN 0x<bitmap> <chanspec>": the bitmap this daemon
+ * believes is on the radio and the channel it was chosen on. The applier reads
+ * the first two fields; the third lets a restarted daemon tell a choice made on
+ * this channel from one made on another. */
+static void dyn_write(void)
+{
+	FILE *f = fopen(RP_DYN ".tmp", "w");
+	int u;
+	if (!f) return;
+	for (u = 0; u < RP_MAXU; u++)
+		if (R[u].dyn)
+			fprintf(f, "wl%d 0x%x %s\n", u, R[u].dyn_bitmap, R[u].cs[0] ? R[u].cs : "-");
+	fclose(f);
+	rename(RP_DYN ".tmp", RP_DYN);
+}
+
+static int assoc_count(struct radio *r)
+{
+	char cmd[200], buf[64], word[32], *next, vifs[128];
+	int n = 0;
+
+	strlcpy(vifs, r->vifs, sizeof(vifs));
+	snprintf(cmd, sizeof(cmd), "/usr/sbin/wl -i %s assoclist 2>/dev/null | wc -l", r->ifn);
+	if (cmd_line(cmd, buf, sizeof(buf))) n += atoi(buf);
+	foreach (word, vifs, next) {
+		snprintf(cmd, sizeof(cmd), "/usr/sbin/wl -i %s assoclist 2>/dev/null | wc -l", word);
+		if (cmd_line(cmd, buf, sizeof(buf))) n += atoi(buf);
+	}
+	return n;
+}
+
+static int csa_flag(struct radio *r)
+{
+	char cmd[160], line[96];
+	FILE *p;
+	int csa = 0;
+	snprintf(cmd, sizeof(cmd), "/usr/sbin/wl -i %s eht dissubchan 2>/dev/null", r->ifn);
+	if ((p = popen(cmd, "r")) == NULL) return 0;
+	while (fgets(line, sizeof(line), p))
+		if (strstr(line, "CSA") && strstr(line, "TRUE")) csa = 1;
+	pclose(p);
+	return csa;
+}
+
+/* One applier at a time. The rwatch tick and the wireless-start hook run the
+ * same one-shot, and it reads the .dyn file BEFORE its readiness wait: a run
+ * of ours overlapping one of theirs could see its choice undone by a bitmap
+ * read a minute earlier (crawl 2026-09-26, F2). Wait for an idle applier
+ * first, bounded a little above its own wait. */
+static int run_applier(void)
+{
+	int i, st;
+	for (i = 0; i < RP_APPLIER_WAIT && pids(RP_APPLIER_NAME); i++)
+		sleep(1);
+	st = system(RP_APPLIER " >/dev/null 2>&1");
+	return st == -1 ? -1 : WEXITSTATUS(st);
+}
+
+/* the applier's line for this radio: result and what it set */
+static void applier_verdict(struct radio *r, char *result, size_t rlen, unsigned *set)
+{
+	FILE *f = fopen(RP_STATE, "r");
+	char line[256], *p;
+	int u;
+	result[0] = 0; *set = 0;
+	while (f && fgets(line, sizeof(line), f)) {
+		if (sscanf(line, "wl%d ", &u) != 1 || u != r->unit) continue;
+		if ((p = strstr(line, " result=")) != NULL) {
+			size_t n = strcspn(p + 8, " \r\n");
+			if (n >= rlen) n = rlen - 1;
+			memcpy(result, p + 8, n); result[n] = 0;
+		}
+		if ((p = strstr(line, " set=0x")) != NULL) *set = (unsigned)strtoul(p + 5, NULL, 16);
+	}
+	if (f) fclose(f);
+}
+
+static void execute_apply(struct radio *r, unsigned want, long now)
+{
+	char result[32], before_cs[32];
+	unsigned set, live = 0;
+	int before, after, csa, rc, have_live;
+	enum pc_apply_result res;
+
+	before = assoc_count(r);
+	strlcpy(before_cs, r->cs, sizeof(before_cs));
+	r->dyn_bitmap = want;
+	dyn_write();
+	rc = run_applier();
+	applier_verdict(r, result, sizeof(result), &set);
+	have_live = live_bitmap(r, &live);
+	after = assoc_count(r);
+	csa = csa_flag(r);
+	{
+		char buf[64];
+		if (wl_line(r->ifn, "chanspec", buf, sizeof(buf))) buf[strcspn(buf, " \t")] = 0;
+		else buf[0] = 0;
+		/* the radio is the judge: what it carries now decides; the applier's
+		 * word says why it did or did not get there */
+		if (have_live && live == want) res = PC_APPLY_OK;
+		else if (!strcmp(result, "refused")) res = PC_APPLY_REFUSED;
+		else res = PC_APPLY_FAILED;
+		if (res == PC_APPLY_OK) {
+			int disruptive = csa || (buf[0] && strcmp(buf, before_cs)) ||
+				(before >= 2 && before - after >= 2) || (before >= 1 && after == 0);
+			if (disruptive) res = PC_APPLY_DISRUPTIVE;
+			snprintf(r->last_apply_note, sizeof(r->last_apply_note), "%s: clients %d -> %d, csa %s, chanspec %s",
+				disruptive ? "DISRUPTIVE" : "seamless", before, after, csa ? "yes" : "no",
+				(buf[0] && strcmp(buf, before_cs)) ? "moved" : "held");
+		} else
+			snprintf(r->last_apply_note, sizeof(r->last_apply_note), "applier: %s (rc %d, set 0x%x, radio %s0x%x)",
+				result[0] ? result : "no verdict", rc, set, have_live ? "" : "?", live);
+	}
+	syslog(res == PC_APPLY_OK ? LOG_NOTICE : LOG_WARNING, "rpunctd: %s %s bitmap 0x%x -> %s",
+		r->ifn, want ? "applied" : "cleared", want, r->last_apply_note);
+	pc_report_apply(&r->pc, res, now);
+	r->last_change_epoch = (long)time(NULL);
+	if (res == PC_APPLY_DISRUPTIVE && want) {
+		/* it went on and it hurt: take it off again, the core has slowed itself down */
+		r->dyn_bitmap = 0;
+		dyn_write();
+		run_applier();
+		r->pc.cur = 0;
+		syslog(LOG_WARNING, "rpunctd: %s bitmap 0x%x taken off again after a disruptive apply; timers x3 from now", r->ifn, want);
+	}
+	/* the file says what the core believes is on the radio - a refused or failed
+	 * apply must not leave its bitmap there for the next applier run to send again */
+	if (r->dyn_bitmap != r->pc.cur) {
+		r->dyn_bitmap = r->pc.cur;
+		dyn_write();
+	}
+}
+
+/* Every tick: the applier's record (set=) against the core's belief (cur). They
+ * part when something other than this daemon ran the applier - the rwatch
+ * tick, the wireless-start hook - or when a slice fell off the radio. Only
+ * while the applier is idle: a run in progress has no verdict yet. */
+static void reconcile(struct radio *r, long now)
+{
+	char result[32];
+	unsigned set;
+
+	if (pids(RP_APPLIER_NAME)) return;
+	applier_verdict(r, result, sizeof(result), &set);
+	if (!result[0] || set == r->pc.cur) return;
+	if (set == 0) {
+		syslog(LOG_NOTICE, "rpunctd: %s bitmap 0x%x is no longer on the radio (applier: %s) - monitoring afresh",
+			r->ifn, r->pc.cur, result);
+		pc_report_lost(&r->pc, now);
+		r->dyn_bitmap = 0;
+		dyn_write();
+		return;
+	}
+	syslog(LOG_NOTICE, "rpunctd: %s radio carries 0x%x, which this controller did not choose (it holds 0x%x) - taking it off",
+		r->ifn, set, r->pc.cur);
+	r->dyn_bitmap = r->pc.cur;
+	dyn_write();
+	run_applier();
+}
+
+/* ---- a confirmation scan of the candidate's own 20 MHz channels ---- */
+static void execute_scan(struct radio *r, unsigned mask, long now)
+{
+	char list[200], cmd[300], line[256], name[24];
+	int busy[PC_MAX20], i, n = 0, before, after;
+	FILE *p;
+
+	for (i = 0; i < PC_MAX20; i++) busy[i] = -1;
+	list[0] = 0;
+	for (i = 0; i < r->pc.n20; i++)
+		if ((mask >> i) & 1) {
+			snprintf(name, sizeof(name), "%s%s%d", n ? "," : "", r->is6g ? "6g" : "", r->start + 4 * i);
+			strlcat(list, name, sizeof(list)); n++;
+		}
+	if (!n) { pc_report_scan(&r->pc, busy, now); return; }
+	before = assoc_count(r);
+	snprintf(cmd, sizeof(cmd), "/usr/sbin/wl -i %s escanresults -t passive -c %s >/dev/null 2>&1", r->ifn, list);
+	if (system(cmd) != 0)
+		syslog(LOG_INFO, "rpunctd: %s scan command returned an error; reading whatever the driver holds", r->ifn);
+	snprintf(cmd, sizeof(cmd), "/usr/sbin/wl -i %s chanim_stats all 2>/dev/null", r->ifn);
+	if ((p = popen(cmd, "r")) != NULL) {
+		while (fgets(line, sizeof(line), p)) {
+			char cs[24]; int tx, inbss, obss, nocat, nopkt, doze, txop, goodtx, badtx, glitch, badplcp, knoise, idle, b, ch, idx;
+			if (sscanf(line, "%23s %d %d %d %d %d %d %d %d %d %d %d %d %d %d", cs, &tx, &inbss, &obss, &nocat, &nopkt,
+				&doze, &txop, &goodtx, &badtx, &glitch, &badplcp, &knoise, &idle, &b) != 15) continue;
+			ch = atoi(cs[0] == '6' && cs[1] == 'g' ? cs + 2 : cs);
+			if (ch < r->start || (ch - r->start) % 4) continue;
+			idx = (ch - r->start) / 4;
+			if (idx >= r->pc.n20 || !((mask >> idx) & 1)) continue;
+			busy[idx] = b * 10;
+		}
+		pclose(p);
+	}
+	after = assoc_count(r);
+	r->armed = 0;						/* the scan reset the driver's window */
+	r->last_scan_epoch = (long)time(NULL);
+	{
+		char rd[160]; int k = 0;
+		for (i = 0; i < r->pc.n20 && k < (int)sizeof(rd) - 12; i++)
+			if ((mask >> i) & 1) k += snprintf(rd + k, sizeof(rd) - k, " %d:%d%%", r->start + 4 * i, busy[i] < 0 ? -1 : pc_ceil_pct(busy[i]));
+		syslog(LOG_NOTICE, "rpunctd: %s scanned %d channel(s) passive (clients %d -> %d):%s", r->ifn, n, before, after, rd);
+	}
+	pc_report_scan(&r->pc, busy, now);
+}
+
+/* ---- the JSON snapshot for the GUI ---- */
+static void j_str(FILE *f, const char *s)
+{
+	int i;
+	fputc('"', f);
+	for (i = 0; s && s[i]; i++) {
+		unsigned char c = (unsigned char)s[i];
+		if (c == '"' || c == '\\') { fputc('\\', f); fputc(c, f); }
+		else if (c < 0x20) fputc(' ', f);
+		else if (c == '<') fputs("\\u003c", f);
+		else fputc(c, f);
+	}
+	fputc('"', f);
+}
+
+static void write_json(void)
+{
+	FILE *f = fopen(RP_JSON ".tmp", "w");
+	int u, first = 1, i, k;
+	if (!f) return;
+	fprintf(f, "{\"tick\":%d,\"radios\":[", RP_TICK);
+	for (u = 0; u < RP_MAXU; u++) {
+		struct radio *r = &R[u];
+		pc_radio_t *c = &r->pc;
+		if (!r->dyn) continue;
+		fprintf(f, "%s{\"unit\":%d,\"ifname\":", first ? "" : ",", u); j_str(f, r->ifn);
+		fprintf(f, ",\"chanspec\":"); j_str(f, r->cs);
+		fprintf(f, ",\"cfg\":"); j_str(f, r->cfg);
+		fprintf(f, ",\"state\":\"%s\",\"width\":%d,\"start\":%d,\"primary\":%d,\"bitmap\":\"0x%x\",\"channels\":[",
+			pc_state_name(c->state), r->width, r->start, c->primary, c->cur);
+		for (i = 0, k = 0; i < c->n20; i++) if ((c->cur >> i) & 1) fprintf(f, "%s%d", k++ ? "," : "", r->start + 4 * i);
+		fprintf(f, "],\"busy\":{");
+		{
+			static const char *gn[G_N] = { "pri", "sec20", "sec40", "sec80", "far" };
+			int g, kk = 0;
+			for (g = 0; g < G_N; g++)
+				if (c->gmask[g]) fprintf(f, "%s\"%s\":%d", kk++ ? "," : "", gn[g], pc_ceil_pct(c->ewma_s[g]));
+		}
+		fprintf(f, "},\"own\":%d,\"candidate\":\"0x%x\",\"candidate_s\":%ld,\"score_cur\":%d,\"score_cand\":%d,\"gain\":%d,",
+			pc_ceil_pct(c->own_s), c->cand, c->cand_since_s ? mono_s() - c->cand_since_s : 0,
+			c->last_score_cur, c->last_score_cand, c->last_gain);
+		fprintf(f, "\"last_change\":%ld,\"last_scan\":%ld,\"applies\":%d,\"restores\":%d,\"scans\":%d,\"refusals\":%d,\"disruptions\":%d,\"slow\":%d,\"reason\":",
+			r->last_change_epoch, r->last_scan_epoch, c->applies, c->restores, c->scans, c->refusals, c->disruptions, c->slow);
+		j_str(f, c->last_reason);
+		fprintf(f, ",\"apply_note\":"); j_str(f, r->last_apply_note);
+		fprintf(f, ",\"scan_fresh\":[");
+		for (i = 0, k = 0; i < c->n20; i++) if (c->scan_busy[i] >= 0) fprintf(f, "%s[%d,%d]", k++ ? "," : "", r->start + 4 * i, pc_ceil_pct(c->scan_busy[i]));
+		fprintf(f, "]}");
+		first = 0;
+	}
+	fprintf(f, "],\"ts\":%ld}", (long)time(NULL));
+	if (fclose(f) == 0) rename(RP_JSON ".tmp", RP_JSON);
+	else unlink(RP_JSON ".tmp");
+
+	/* the flat twin: "wlN state=<s> bitmap=0x<b> channels=<c,c> changes=<a>/<r>/<s> reason=<text>" */
+	if ((f = fopen(RP_DYNSTATE ".tmp", "w")) != NULL) {
+		for (u = 0; u < RP_MAXU; u++) {
+			struct radio *r = &R[u];
+			pc_radio_t *c = &r->pc;
+			if (!r->dyn) continue;
+			fprintf(f, "wl%d if=%s cs=%s state=%s bitmap=0x%x channels=", u, r->ifn, r->cs, pc_state_name(c->state), c->cur);
+			for (i = 0, k = 0; i < c->n20; i++) if ((c->cur >> i) & 1) fprintf(f, "%s%d", k++ ? "," : "", r->start + 4 * i);
+			fprintf(f, " changes=%d/%d/%d reason=%s\n", c->applies, c->restores, c->scans, c->last_reason);
+		}
+		if (fclose(f) == 0) rename(RP_DYNSTATE ".tmp", RP_DYNSTATE);
+		else unlink(RP_DYNSTATE ".tmp");
+	}
+}
+
+/* ---- configuration sweep: which radios are Dynamic, and did a setting change ---- */
+static int sweep_config(void)
+{
+	int u, any = 0;
+	char key[24], ifn[16];
+
+	for (u = 0; u < RP_MAXU; u++) {
+		struct radio *r = &R[u];
+		const char *v;
+		enum pc_preset pre; enum pc_tier tier; int gain, hold;
+
+		snprintf(key, sizeof(key), "wl%d_ifname", u);
+		strlcpy(ifn, nvram_safe_get(key), sizeof(ifn));
+		snprintf(key, sizeof(key), "wl%d_punct", u);
+		v = nvram_safe_get(key);
+		if (!ifn[0] || !parse_cfg(v, &pre, &tier, &gain, &hold)) {
+			if (r->dyn) { syslog(LOG_NOTICE, "rpunctd: %s no longer Dynamic", r->ifn); r->dyn = 0; r->dyn_bitmap = 0; }
+			continue;
+		}
+		if (!ifname_ok(ifn)) {
+			if (!r->ifn_bad)
+				syslog(LOG_WARNING, "rpunctd: wl%d: the interface name in nvram wl%d_ifname is not one - radio skipped", u, u);
+			r->ifn_bad = 1;
+			if (r->dyn) { r->dyn = 0; r->dyn_bitmap = 0; }
+			continue;
+		}
+		r->ifn_bad = 0;
+		snprintf(key, sizeof(key), "wl%d_radio", u);
+		if (nvram_match(key, "0")) { if (r->dyn) { r->dyn = 0; syslog(LOG_NOTICE, "rpunctd: %s radio off", ifn); } continue; }
+		snprintf(key, sizeof(key), "wl%d_nband", u);
+		r->nband = nvram_get_int(key);
+		if (r->nband != 1 && r->nband != 4) continue;
+		snprintf(key, sizeof(key), "wl%d_11be", u);
+		if (!nvram_match(key, "1")) continue;
+		any = 1;
+		if (!r->dyn || strcmp(v, r->cfg) || strcmp(ifn, r->ifn)) {
+			char raw[128], word[32], *next;
+			r->unit = u; r->dyn = 1;
+			strlcpy(r->ifn, ifn, sizeof(r->ifn));
+			strlcpy(r->cfg, v, sizeof(r->cfg));
+			/* the client networks' interfaces, each name gated like the radio's */
+			snprintf(key, sizeof(key), "wl%d_vifs", u);
+			strlcpy(raw, nvram_safe_get(key), sizeof(raw));
+			r->vifs[0] = 0;
+			foreach (word, raw, next) {
+				if (!ifname_ok(word)) continue;
+				if (r->vifs[0]) strlcat(r->vifs, " ", sizeof(r->vifs));
+				strlcat(r->vifs, word, sizeof(r->vifs));
+			}
+			pc_init(&r->pc, pre, tier, gain, hold);
+			r->cs[0] = 0; r->raw_cs = 0; r->geom_ok = 0; r->armed = 0; r->misses = 0; r->seed_pending = 0;
+			r->last_logged[0] = 0; r->last_log_s = 0;
+			syslog(LOG_NOTICE, "rpunctd: %s Dynamic: %s preset, %s source, min gain %d%%, min interval %d s",
+				r->ifn, pre == PC_BALANCED ? "Balanced" : pre == PC_AGGRESSIVE ? "Aggressive" : "Conservative",
+				tier == PC_TIER_IDLE_SCAN ? "passive + idle scan" : tier == PC_TIER_ACTIVE_SCAN ? "active scan" : "passive",
+				r->pc.p.min_gain / 10, r->pc.p.min_interval_s);
+		}
+	}
+	return any;
+}
+
+/* The .dyn file survives a daemon restart; a wireless restart clears the
+ * driver, and the wireless-start hook runs the applier, which puts the file's
+ * bitmap back. Resume with that bitmap only when it is on the radio AND the
+ * channel is the one it was chosen on - a choice made on another channel is
+ * stale (the rolling statistics belonged to it) and comes off. Returns 0 while
+ * the applier is still running: its verdict is not in yet, try next tick. */
+static int seed_from_driver(struct radio *r)
+{
+	char buf[96], fcs[32] = "";
+	unsigned live = 0, want = 0;
+	FILE *f = fopen(RP_DYN, "r");
+	int u;
+
+	while (f && fgets(buf, sizeof(buf), f)) {
+		fcs[0] = 0;
+		if (sscanf(buf, "wl%d 0x%x %31s", &u, &want, fcs) >= 2 && u == r->unit) break;
+		want = 0;
+	}
+	if (f) fclose(f);
+	if (!want) return 1;
+	if (pids(RP_APPLIER_NAME)) return 0;
+	if (!live_bitmap(r, &live)) live = 0;
+	if (live == want && !strcmp(fcs, r->cs)) {
+		r->pc.cur = want; r->pc.want = want; r->dyn_bitmap = want;
+		r->pc.state = PC_MONITORING;
+		syslog(LOG_NOTICE, "rpunctd: %s resumes with bitmap 0x%x already on the radio", r->ifn, want);
+		return 1;
+	}
+	r->dyn_bitmap = 0;
+	dyn_write();
+	if (live == want)
+		run_applier();		/* on the air from another channel: the applier takes off what it set */
+	syslog(LOG_NOTICE, "rpunctd: %s forgets bitmap 0x%x chosen on %s (now %s, radio carries 0x%x) - monitoring afresh",
+		r->ifn, want, fcs[0] ? fcs : "?", r->cs, live);
+	return 1;
+}
+
+int main(int argc, char **argv)
+{
+	(void)argc; (void)argv;
+	if (daemon(0, 0) < 0) return 1;
+	openlog("rpunctd", LOG_PID, LOG_DAEMON);
+	signal(SIGTERM, on_term);
+	signal(SIGINT, on_term);
+	memset(R, 0, sizeof(R));
+	syslog(LOG_NOTICE, "rpunctd: started (dynamic preamble puncturing controller)");
+
+	while (running) {
+		long t0 = mono_s(), now;
+		int u, changed;
+
+		if (!sweep_config()) {
+			syslog(LOG_NOTICE, "rpunctd: no radio set to Dynamic, exiting");
+			break;
+		}
+		/* geometry, then arm every radio's window in the same second */
+		for (u = 0; u < RP_MAXU; u++) {
+			struct radio *r = &R[u];
+			if (!r->dyn) continue;
+			if (!read_geometry(r, t0, &changed)) { r->armed = 0; continue; }
+			if (changed) {
+				if (r->geom_ok) {
+					syslog(LOG_NOTICE, "rpunctd: %s on %s: %d MHz, block from channel %d, primary slot %d - monitoring afresh",
+						r->ifn, r->cs, r->width, r->start, r->pc.primary);
+					r->seed_pending = 1;
+				} else
+					syslog(LOG_NOTICE, "rpunctd: %s on %s: below 80 MHz, nothing to puncture", r->ifn, r->cs);
+			}
+			if (r->geom_ok && r->seed_pending && seed_from_driver(r))
+				r->seed_pending = 0;
+			if (r->geom_ok) arm_window(r);
+		}
+		usleep((RP_WINDOW_MS + 600) * 1000);
+		now = mono_s();
+		for (u = 0; u < RP_MAXU && running; u++) {
+			struct radio *r = &R[u];
+			pc_sample_t s;
+			pc_decision_t d;
+			if (!r->dyn || !r->geom_ok) continue;
+			if (!read_window(r, &s)) { s.valid = 0; r->misses++; }
+			else r->misses = 0;
+			if (!r->seed_pending) reconcile(r, now);
+			pc_step(&r->pc, &s, now, &d);
+			if (d.text[0]) {
+				int urgent = d.act != PC_ACT_NONE;
+				if (urgent || strcmp(d.text, r->last_logged) || now - r->last_log_s >= RP_LOG_REPEAT_S) {
+					syslog(urgent ? LOG_NOTICE : LOG_INFO, "rpunctd: %s %s | %s", r->ifn, r->cs, d.text);
+					strlcpy(r->last_logged, d.text, sizeof(r->last_logged));
+					r->last_log_s = now;
+				}
+			}
+			if (d.act == PC_ACT_APPLY) execute_apply(r, d.mask, now);
+			else if (d.act == PC_ACT_CLEAR) execute_apply(r, 0, now);
+			else if (d.act == PC_ACT_SCAN) execute_scan(r, d.mask, now);
+		}
+		write_json();
+		{
+			long spent = mono_s() - t0, left = RP_TICK - spent, i;
+			for (i = 0; i < left && running; i++) sleep(1);
+		}
+	}
+	unlink(RP_JSON);
+	unlink(RP_DYNSTATE);
+	syslog(LOG_NOTICE, "rpunctd: stopped");
+	closelog();
+	return 0;
+}
