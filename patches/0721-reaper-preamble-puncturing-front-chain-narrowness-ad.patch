+/* reaper v3.2.8: dynamic preamble puncturing controller (rpunctd). Runs only
+ * while some radio's wlN_punct reads "dyn|..."; it exits by itself when none
+ * does, and it hands every bitmap to the static applier (reaper_punct). Not
+ * gated on routing mode: puncturing is a radio matter and the four-radio
+ * tester runs in Access Point mode. */
+void
+stop_rpunctd(void)
+{
+	if (pids("rpunctd"))
+		killall_tk("rpunctd");
+}
+
+static int rpunctd_wanted(void)
+{
+	char key[24];
+	int u;
