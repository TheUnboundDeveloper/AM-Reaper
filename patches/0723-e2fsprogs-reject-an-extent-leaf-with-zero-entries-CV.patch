From f0d80952fb66e358e129b67ab67f08af6f8c49b2 Mon Sep 17 00:00:00 2001
From: reaper <theunbounddeveloper@outlook.com>
Date: Tue, 29 Sep 2026 13:42:56 -0400
Subject: [PATCH] e2fsprogs: reject an extent leaf with zero entries
 (CVE-2022-1304)

An extent-tree leaf with zero entries sent libext2fs out of bounds, so
the disk check (e2fsck at USB app-disk mount, from the USB page and on
schedule) could be attacked with a crafted disk. Upstream ab51d587bb9b
(e2fsprogs 1.46.6) applied to the vendored 1.45.6.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 release/src/router/e2fsprogs/lib/ext2fs/extent.c | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/release/src/router/e2fsprogs/lib/ext2fs/extent.c b/release/src/router/e2fsprogs/lib/ext2fs/extent.c
index ac3dbfec90..a1b1905cd2 100644
--- a/release/src/router/e2fsprogs/lib/ext2fs/extent.c
+++ b/release/src/router/e2fsprogs/lib/ext2fs/extent.c
@@ -495,6 +495,10 @@ retry:
 			ext2fs_le16_to_cpu(eh->eh_entries);
 		newpath->max_entries = ext2fs_le16_to_cpu(eh->eh_max);
 
+		/* Make sure there is at least one extent present */
+		if (newpath->left <= 0)
+			return EXT2_ET_EXTENT_NO_DOWN;
+
 		if (path->left > 0) {
 			ix++;
 			newpath->end_blk = ext2fs_le32_to_cpu(ix->ei_block);
@@ -1630,6 +1634,10 @@ errcode_t ext2fs_extent_delete(ext2_extent_handle_t handle, int flags)
 
 	cp = path->curr;
 
+	/* Sanity check before memmove() */
+	if (path->left < 0)
+		return EXT2_ET_EXTENT_LEAF_BAD;
+
 	if (path->left) {
 		memmove(cp, cp + sizeof(struct ext3_extent_idx),
 			path->left * sizeof(struct ext3_extent_idx));
-- 
2.25.1

