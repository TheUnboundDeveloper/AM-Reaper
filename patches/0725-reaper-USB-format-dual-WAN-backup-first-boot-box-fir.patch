diff --git a/release/src/router/others/reaper_diag b/release/src/router/others/reaper_diag
old mode 100755
new mode 100644
index 8892b55eb2..91b3a114db
--- a/release/src/router/others/reaper_diag
+++ b/release/src/router/others/reaper_diag
@@ -1,6 +1,6 @@
 #!/bin/sh
 # ============================================================================
-#  REAPER-DIAG v1.3.23 (2026-09-26) - sanitized one-shot diagnostic bundle
+#  REAPER-DIAG v1.3.24 (2026-09-28) - sanitized one-shot diagnostic bundle
 #  Runs on ANY Reaper model (RT-BE96U / RT-BE86U / RT-BE88U / GT-BE98 /
 #  GT-BE98_PRO) - radios, ports and features are discovered at runtime.
 #
@@ -48,7 +48,7 @@
 #  are one-shot cats. Do not add an unbounded command here.
 # ============================================================================
 PATH=/sbin:/bin:/usr/sbin:/usr/bin
-VER="REAPER-DIAG v1.3.23"
+VER="REAPER-DIAG v1.3.24"
 T0="$(date +%s 2>/dev/null)"
 MODEL="$(nvram get productid 2>/dev/null)"
 EXTNO="$(nvram get extendno 2>/dev/null)"
@@ -495,6 +495,15 @@ V6="$(ifconfig br0 2>/dev/null | grep -c 'Scope:Global')"
 echo "  br0 global IPv6: $( [ "${V6:-0}" -gt 0 ] && echo "PRESENT x$V6 (redacted)" || echo none )"
 
 sec "7. WIRELESS (radios discovered at runtime)"
+# v1.3.24: the settings that explain overnight client drops (RT-BE88U field diag
+# 2026-09-27 could neither confirm nor rule them out). roamast's [EXAP] deauth is
+# gated per band by wlN_user_rssi and globally by disable_exap; roamast_disable
+# stops the daemon. Schedules and DFS follow per radio, auth/PMF per VIF.
+if pidof roamast >/dev/null 2>&1; then RAST=running; else RAST=not-running; fi
+echo "  roaming assistant : roamast=$RAST  roamast_disable=$(nvram get roamast_disable 2>/dev/null)  disable_exap=$(nvram get disable_exap 2>/dev/null)"
+APGS=""
+for k in $(nvram show 2>/dev/null | grep -E '^apg[0-9]+_timesched=1$' | cut -d_ -f1); do APGS="$APGS $k"; done
+echo "  SDN access-time schedules on:${APGS:- none}"
 u=0; while [ $u -le 3 ]; do
   IFN="$(nvram get wl${u}_ifname 2>/dev/null)"
   [ -z "$IFN" ] && { u=$((u+1)); continue; }
@@ -503,6 +512,15 @@ u=0; while [ $u -le 3 ]; do
   echo "  -- unit $u  ifname=$IFN  band=$BAND --"
   echo "     radio_on=$(nvram get wl${u}_radio 2>/dev/null)  closed=$(nvram get wl${u}_closed 2>/dev/null)  country=$(nvram get wl${u}_country_code 2>/dev/null)"
   echo "     chanspec: $(wl -i $IFN chanspec 2>/dev/null)"
+  # v1.3.24: Roaming Assistant threshold (0 = off for this band), the Wireless
+  # Scheduler (timesched=1 turns the radio off on its schedule; only the length
+  # of the schedule string is printed) and, on 5 GHz, the DFS state.
+  WSV="$(nvram get wl${u}_sched_v2 2>/dev/null)"
+  echo "     roaming: user_rssi=$(nvram get wl${u}_user_rssi 2>/dev/null)   scheduler: timesched=$(nvram get wl${u}_timesched 2>/dev/null) sched_v2_len=${#WSV}"
+  if [ "$NB" = 1 ]; then
+    wl -i $IFN dfs_status 2>/dev/null | head -3 | sed 's/^/     dfs: /'
+  fi
+  echo "     auth: $(nvram get wl${u}_auth_mode_x 2>/dev/null) crypto=$(nvram get wl${u}_crypto 2>/dev/null) pmf=$(nvram get wl${u}_mfp 2>/dev/null)"
   # v1.3.20: static preamble puncturing (rc/reaper_punct.c) - the saved setting, what the
   # driver carries now, and the applier's last result. 5/6 GHz only (2.4 GHz cannot puncture).
   if [ "$NB" = 1 ] || [ "$NB" = 4 ]; then
@@ -545,7 +563,7 @@ u=0; while [ $u -le 3 ]; do
     # v1.3.10: tr -d newline before wc -c - nvram get appends one, so every
     # VIF ssid_len read +1 (live report: 7 for a 6-char SSID, 33 for the
     # 32-hex onboarding BSS). The primary-radio path was already exact.
-    echo "     vif $VIF: up=$(ifconfig $VIF 2>/dev/null | grep -c UP) stations=${VAC:-0} ssid_len=$(nvram get ${VIF}_ssid 2>/dev/null | tr -d "\n" | wc -c)"
+    echo "     vif $VIF: up=$(ifconfig $VIF 2>/dev/null | grep -c UP) stations=${VAC:-0} ssid_len=$(nvram get ${VIF}_ssid 2>/dev/null | tr -d "\n" | wc -c) auth=$(nvram get ${VIF}_auth_mode_x 2>/dev/null) crypto=$(nvram get ${VIF}_crypto 2>/dev/null) pmf=$(nvram get ${VIF}_mfp 2>/dev/null)"
     wl -i $VIF assoclist 2>/dev/null | awk '{print $2}' | while read M; do
       echo "     .. sta $M (on $VIF):"
       wl -i $VIF sta_info "$M" 2>/dev/null | grep -E "rate of last|rssi|smoothed|PS :|idle|in network|flags|link bandwidth|tx pkts:|tx failures" | sed 's/^/        /'
@@ -1107,6 +1125,11 @@ case "$(nvram get reaper_store 2>/dev/null)" in
   usb)  for d in /tmp/mnt/*/; do [ -d "$d" ] || continue; m="${d%/}"; grep -qF " $m " /proc/mounts 2>/dev/null || continue; [ -d "${d}.reaper" ] && { RS_BASE="${d}.reaper"; break; }; done ;;
 esac
 echo "  durable store     : $RS_BASE$( [ "$RS_BASE" = /tmp/reaper ] && echo ' (VOLATILE - lost at reboot)')"
+# v1.3.24: a RAM store beside a mounted USB disk means the history a field report
+# needs (the syslog mirror above all) is lost at the next reboot for no reason.
+if [ "$RS_BASE" = /tmp/reaper ] && grep -q ' /tmp/mnt/' /proc/mounts 2>/dev/null; then
+  finding WARN "Reaper's durable store is RAM although a USB disk is mounted - log history is lost at every reboot; set the store to USB - see 17"
+fi
 echo "  datastore opt-ins : $(nvram get reaper_store_ds 2>/dev/null)"
 # v1.3.7: the one-shot PPPoE stale-session bounce (rwatch_gen, v1.9.2) is armed
 # by DEFAULT - its test is `!= 0`, so an UNSET key counts as enabled - and it
@@ -1200,6 +1223,13 @@ function pe(m,d,t){split(t,T,":");return mn[m]*2629800+d*86400+T[1]*3600+T[2]*60
     finding INFO "station $2 on ${3%:} disassociated $1 times (~$RATE) - assoc/deauth loop; Gatekeeper cannot stop this, a wireless MAC filter can (see 19b)"
   fi
   echo "  deauthorize -30   : $(cat $SLF 2>/dev/null | grep -c 'DEAUTHORIZE error')   ocv_cap unsupported: $(cat $SLF 2>/dev/null | grep -c 'ocv_cap unsupported')"
+  # v1.3.24: drops the ROUTER initiated, counted next to the disassociations above.
+  # roamast logs "[EXAP]Deauth old sta" and then a (misleading) "weak signal
+  # strength" line for the same kick; radar/channel-switch lines explain a whole
+  # 5 GHz band dropping at once.
+  EXAPN="$(grep -c 'roamast: .*\[EXAP\]Deauth' "$SNAP" 2>/dev/null)"
+  echo "  roamast kicks     : exap_deauth=${EXAPN:-0}   weak_signal=$(grep -c 'roamast: .*weak signal' "$SNAP" 2>/dev/null)   radar=$(grep -ciE 'radar[^a-z]*(detect|found)' "$SNAP" 2>/dev/null)   channel_switch=$(grep -ciE 'channel switch|[^a-z]csa[^a-z]' "$SNAP" 2>/dev/null)"
+  [ "${EXAPN:-0}" -gt 0 ] && finding INFO "roamast [EXAP] deauthed ${EXAPN} station(s) - nvram disable_exap=1 stops that path only (Roaming Assistant keeps working) - see 7/19b"
   echo "  -- dhcp: top DISCOVER sources --"
   cat $SLF 2>/dev/null | grep 'DHCPDISCOVER' | awk '{print $NF}' | sort | uniq -c | sort -rn | head -5 | awk '{printf "  %6d %s\n", $1, $2}'
   echo "  -- reaper events --"
