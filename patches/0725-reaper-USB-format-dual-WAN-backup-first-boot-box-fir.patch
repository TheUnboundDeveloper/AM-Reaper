+ * limits at save time (RFW_323-325). */
+#define RFW_CAPLOG_SETS  0x1
+#define RFW_CAPLOG_IFACE 0x2
+#define RFW_CAPLOG_ZPOL  0x4
+static unsigned rfw_caplog;
+
 typedef struct { char name[40]; } rfw_setname_t;
 
 /* resolve one OBJECT (not a group) to its set name for `v6`. Returns 0 when the
@@ -703,6 +715,10 @@ static int rfw_resolve(const rfw_cfg_t *c, const char *ref, int v6,
 			if (!rfw_valid_name(tok)) continue;
 			if (rfw_obj_set(c, tok, v6, out[n].name, sizeof(out[n].name))) n++;
 		}
+		if (tok && !(rfw_caplog & RFW_CAPLOG_SETS)) {
+			rfw_caplog |= RFW_CAPLOG_SETS;
+			logmessage("reaper_fw", "group '%s' resolves to more than %d sets - the rest are IGNORED (split the group)", ref, max);
+		}
 		free(dup);
 	}
 	return n;
@@ -1215,6 +1231,10 @@ static int rfw_zone_ifaces(const rfw_cfg_t *c, const char *zname,
 		if (!rfw_valid_iface(tok)) continue;
 		strlcpy(ifs[n++], tok, IFNAMSIZ + 2);
 	}
+	if (tok && !(rfw_caplog & RFW_CAPLOG_IFACE)) {
+		rfw_caplog |= RFW_CAPLOG_IFACE;
+		logmessage("reaper_fw", "zone '%s' lists more than %d interfaces - the rest are IGNORED", zname, max);
+	}
 	free(dup);
 	return n;
 }
@@ -1481,7 +1501,13 @@ static void rfw_emit_zpol(FILE *f, const rfw_cfg_t *c, int v6)
 		char sz[RFW_NAME_MAX + 2], dz[RFW_NAME_MAX + 2], act[12];
 		char sifs[RFW_MAX_IFACE][IFNAMSIZ + 2], difs[RFW_MAX_IFACE][IFNAMSIZ + 2];
 		int nsi, ndi, i, j;
-		if (++n > RFW_MAX_ZPOL) break;
+		if (++n > RFW_MAX_ZPOL) {
+			if (!(rfw_caplog & RFW_CAPLOG_ZPOL)) {
+				rfw_caplog |= RFW_CAPLOG_ZPOL;
+				logmessage("reaper_fw", "more than %d zone policies - the rest are IGNORED", RFW_MAX_ZPOL);
+			}
+			break;
+		}
 		if (!rfw_field(tok, 0, sz,  sizeof(sz))  ||
 		    !rfw_field(tok, 1, dz,  sizeof(dz))  ||
 		    !rfw_field(tok, 2, act, sizeof(act)) || !rfw_valid_zpol_action(act))
@@ -1585,7 +1611,8 @@ static void rfw_emit_edef(FILE *f, const rfw_cfg_t *c, int v6)
  * adds forwards that can be restricted to a source object - including a geo
