@@ -24390,10 +24401,11 @@ do_reaper_fw_cgi(char *url, FILE *stream)
 	}
 
 	/* ---------------- Phase 1: the object-model rules engine ----------------
-	 * Everything below edits the DRAFT only. Values land in nvram RAM and are
-	 * never committed here: the single path that writes flash is
-	 * reaper_fw_confirm(), after the operator has confirmed a ruleset that is
-	 * already live. That is what makes the commit-confirm window meaningful -
+	 * Everything below edits the DRAFT only. Since v2.6.9 the lists are staged
+	 * as files under /tmp/reaper_fw/draft/ (tmpfs) and never reach /jffs here:
+	 * the confirmed snapshot is written by reaper_fw_confirm(), after the
+	 * operator has confirmed a ruleset that is already live (and, for obj/grp
+	 * only, by reaper_fw_promote_objects() on a Policy Routing confirm). That is what makes the commit-confirm window meaningful -
 	 * a box that reboots mid-window comes back on the last CONFIRMED config.
