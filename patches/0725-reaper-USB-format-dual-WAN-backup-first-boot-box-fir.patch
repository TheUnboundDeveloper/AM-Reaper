 	file_unlock(lock);
 #if defined(RTCONFIG_CONCURRENTREPEATER)
 	nvram_set_int("led_status", LED_RESTART_WL_DONE);
diff --git a/release/src/router/rc/reaper_fw.c b/release/src/router/rc/reaper_fw.c
index f601ad484d..5223586af0 100644
--- a/release/src/router/rc/reaper_fw.c
+++ b/release/src/router/rc/reaper_fw.c
@@ -614,6 +614,18 @@ static int rfw_find(const char *list, const char *name, char *out, size_t ol)
 
 #define RFW_MAX_SETS 16
 
+/* 2026-09-28 (backlog rfw-silent-caps): the group-set, zone-interface and
+ * zone-policy caps dropped the overflow with no log line, unlike every other
+ * cap here - so a DROP rule or zone policy silently left part of what the
+ * operator named unmatched. Each now logs, once per generated ruleset (the
+ * resolvers run per rule and per family, so an unguarded line would repeat
