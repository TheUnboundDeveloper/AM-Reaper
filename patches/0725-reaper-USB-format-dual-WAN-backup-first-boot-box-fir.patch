@@ -1941,6 +1968,7 @@ static int rfw_gen_apply(const char *path, const rfw_cfg_t *c, int teardown_only
 	f = fopen(tmp, "w");
 	if (!f) return 0;
 	keep[0] = 0;
+	rfw_caplog = 0;		/* each cap logs once per generated ruleset */
 
 	fprintf(f,
 	  "#!/bin/sh\n" REAPER_NV_HELPER
@@ -2255,15 +2283,25 @@ static int rfw_confirm_secs(void)
 /* P2-H2: the confirmed snapshot is BOTH the boot-time ruleset and the rollback
  * source, so a half-written one is a security event - a truncated zpol reads as
  * "no zone policy" (default-deny gone) yet boot would still mark the engine
- * active. Write each key to a temp file, fsync it, atomically rename it into
- * place, and only THEN write a .committed marker (also fsync'd). Boot trusts the
- * snapshot only when that marker is present, so a full /jffs or a power cut
- * mid-write leaves no marker and boot falls back to nvram - which, after the
- * confirm path's nvram_commit(), holds this very config. Returns 1 on a
+ * active. Each key goes to a temp file (fsync'd), then is renamed into place,
+ * and only THEN is the .committed marker written (also fsync'd).
+ *
+ * 2026-09-28 (backlog rfw-lastgood-snapshot): the marker used to be unlinked
+ * BEFORE the first temp write, on the premise that boot would fall back to
+ * nvram "which holds this very config". That premise died in v2.6.9, whose
+ * migration unsets the reaper_fw_<key> nvram lists - so a write that failed
+ * part-way (a full /jffs is the ordinary way) left no marker, boot loaded
+ * eight EMPTY lists with the engine enabled, and rfw_migrate_lists() then
+ * wrote those empties back as a freshly-blessed snapshot over the good files.
+ * Now all eight temp files are written first; a failure there removes them
+ * and leaves the previous snapshot AND its marker untouched. The marker only
+ * goes away for the renames, which need no new data blocks. If one of those
+ * fails anyway, every file on disk is still a whole list (rename is atomic per
+ * file), and boot re-adopts them - see rfw_readopt_lastgood(). Returns 1 on a
  * complete durable write. */
 static int rfw_write_lastgood(void)
 {
-	int i, ok = 1;
+	int i, ok = 1, staged = 0;
 	char marker[128];
 	mkdir(RFW_CACHE, 0700);
 	mkdir(RFW_LASTGOOD, 0700);
@@ -2288,22 +2326,45 @@ static int rfw_write_lastgood(void)
 		vals[i] = strdup(cur);
 		if (!vals[i]) { while (i--) free(vals[i]); logmessage("reaper_fw", "lastgood snapshot: out of memory"); return 0; }
 	}
-	unlink(marker);		/* invalidate the old marker until this one completes */
+	/* stage: every key to <key>.tmp. Nothing confirmed is touched yet. */
 	for (i = 0; i < RFW_NKEYS; i++) {
-		char p[128], tmp[140];
+		char tmp[140];
 		FILE *f;
-		const char *val = vals[i];
-		snprintf(p, sizeof(p), "%s/%s", RFW_LASTGOOD, rfw_keys[i].file);
-		snprintf(tmp, sizeof(tmp), "%s.tmp", p);
+		snprintf(tmp, sizeof(tmp), "%s/%s.tmp", RFW_LASTGOOD, rfw_keys[i].file);
