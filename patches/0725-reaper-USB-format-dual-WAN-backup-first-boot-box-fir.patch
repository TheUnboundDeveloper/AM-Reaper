  * side, leaving only a gateway on the WAN face). */
+/* reaper 2026-09-28 (dual-WAN field report): the Internet card read wan0 only,
+ * so a fail-over to the second line painted "Disconnected" while traffic flowed
+ * over it. Read the PRIMARY unit (wan_primary / get_wan_unit()); in load-balance
+ * either line being up means the router is online. `v` carries wanN_state_t,
+ * wanN_ipaddr, wanN_gateway and wanN_dns for both units. Shared by the initial
+ * render and the live poll, so it lives at top level like v6Up(). */
+function wanPick(v, prim, lb){
+  function up(u){ var st=v['wan'+u+'_state_t'], ip=v['wan'+u+'_ipaddr']; return st==='2' && !!ip && ip!=='0.0.0.0'; }
+  var u=(String(prim)==='1')?1:0;
+  if(!up(u) && lb && up(1-u)) u=1-u;
+  return {unit:u, st:v['wan'+u+'_state_t']||'', ip:v['wan'+u+'_ipaddr']||'',
+          gw:v['wan'+u+'_gateway']||'', dns:v['wan'+u+'_dns']||''};
+}
