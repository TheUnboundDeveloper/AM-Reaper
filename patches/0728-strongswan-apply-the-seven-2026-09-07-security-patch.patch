@@ -132,8 +144,11 @@ static status_t start_phase2_auth(private_eap_peap_server_t *this)
 /**
  * If configured, start EAP-TNC protocol
  */
-static status_t start_phase2_tnc(private_eap_peap_server_t *this)
+static status_t start_phase2_tnc(private_eap_peap_server_t *this,
