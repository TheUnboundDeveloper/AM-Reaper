@@ -77,6 +79,16 @@ struct private_eap_peap_server_t {
 	 */
 	eap_method_t *ph2_method;
 
+	/**
+	 * Type of the completed phase 2 EAP method
+	 */
+	eap_type_t phase2_type;
+
+	/**
+	 * Auth data for phase 2 method
