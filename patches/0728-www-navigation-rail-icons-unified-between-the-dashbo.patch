From 8bb856bb75e8d6c1e65542444910212a8adf52db Mon Sep 17 00:00:00 2001
From: reaper <theunbounddeveloper@outlook.com>
Date: Sun, 11 Oct 2026 12:03:34 -0400
Subject: [PATCH] www: navigation rail icons unified between the dashboard and
 the shell

The shell's ICONS map is keyed by menu entry and had no key for the Reaper
menus httpd injects (Gatekeeper, Warden, Advisor, System Info, IPv6), so
they fell to the _default circle-dot on every framed page while the
dashboard rail drew proper glyphs. One glyph per menu now, the same glyphs
as Main_ReaperDash.asp's rail; the stock entries the dashboard also lists
(New Dashboard, UU, Tencent, SMS, Alexa/IFTTT) get their own, and Traffic
Manager draws the dashboard's bars on both menu indices (menu_QoS and
menu_BandwidthMonitor differ per model). The line chart stays Traffic
Analyzer's alone. Lean: tests/test_nav_icons.py.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 release/src/router/www/reaper_shell.asp | 21 ++++++++++++++++++---
 1 file changed, 18 insertions(+), 3 deletions(-)

diff --git a/release/src/router/www/reaper_shell.asp b/release/src/router/www/reaper_shell.asp
index 4aa8aa4fe79..eea8f5a048a 100644
--- a/release/src/router/www/reaper_shell.asp
+++ b/release/src/router/www/reaper_shell.asp
@@ -446,9 +446,25 @@ var ICONS = {
   menu_GuestNetwork:   '<svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c3 3 3 15 0 18M12 3c-3 3-3 15 0 18"/></svg>',
   menu_AiProtection:   '<svg viewBox="0 0 24 24"><path d="M12 3l8 4v5c0 5-3.5 8-8 9-4.5-1-8-4-8-9V7z"/><path d="M9 12l2 2 4-4"/></svg>',
   menu_ParentalControl:'<svg viewBox="0 0 24 24"><circle cx="9" cy="8" r="2.5"/><circle cx="16" cy="9" r="2"/><path d="M4 19a5 5 0 0 1 10 0M13 19a4 4 0 0 1 7-3"/></svg>',
+  /* reaper 2026-10-10: Traffic Manager is menu_QoS on stock trees and
+     menu_BandwidthMonitor on Reaper's (Reaper_QoS.asp); both draw the bars the
+     dashboard uses. The line chart belongs to Traffic Analyzer alone. */
   menu_QoS:            '<svg viewBox="0 0 24 24"><path d="M4 18v-5M9 18V7M14 18v-8M19 18v-12"/></svg>',
+  menu_BandwidthMonitor:'<svg viewBox="0 0 24 24"><path d="M4 18v-5M9 18V7M14 18v-8M19 18v-12"/></svg>',
   menu_TrafficAnalyzer:'<svg viewBox="0 0 24 24"><path d="M3 16l5-6 4 4 5-7 4 5"/></svg>',
-  menu_BandwidthMonitor:'<svg viewBox="0 0 24 24"><path d="M3 16l5-6 4 4 5-7 4 5"/></svg>',
+  /* reaper 2026-10-10: the Reaper menus menuTrees/menuTree.js adds had no key here
+     and fell to _default (the circle-dot); same glyphs as Main_ReaperDash.asp's rail */
+  menu_ReaperGK:       '<svg viewBox="0 0 24 24"><path d="M12 3l8 3.5v6c0 4.5-3.2 7.5-8 8.5-4.8-1-8-4-8-8.5v-6z"/><path d="M9 11v-1.5a3 3 0 0 1 6 0V11"/><rect x="9" y="11" width="6" height="5" rx="1"/></svg>',
+  menu_ReaperWarden:   '<svg viewBox="0 0 24 24"><path d="M12 3l8 3.5v6c0 4.5-3.2 7.5-8 8.5-4.8-1-8-4-8-8.5v-6z"/><path d="M8.5 12.5l2.5 2.5 4.5-5"/></svg>',
+  menu_ReaperAdvisor:  '<svg viewBox="0 0 24 24"><path d="M12 3a5 5 0 0 1 5 5c0 2-1 3-2 4s-1 2-1 3H10c0-1 0-2-1-3S7 10 7 8a5 5 0 0 1 5-5z"/><path d="M10 20h4"/></svg>',
+  menu_Sysinfo:        '<svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 11v5M12 8h.01"/></svg>',
+  menu_IPv6:           '<svg viewBox="0 0 24 24"><path d="M12 3l8 4.5v9L12 21l-8-4.5v-9z"/><path d="M9 14h.01M12 12v3M15 11v4"/></svg>',
+  /* stock menus a model may still show (exclude.menus() decides); none is on the
+     dashboard rail, each gets its own glyph so nothing falls to _default */
+  menu_NewDashboard:   '<svg viewBox="0 0 24 24"><path d="M4 17a8 8 0 1 1 16 0"/><path d="M12 17l4-5"/></svg>',
+  menu_UU:             '<svg viewBox="0 0 24 24"><path d="M13 3L5 14h6l-1 7 8-11h-6z"/></svg>',
+  menu_TencentAcceleration:'<svg viewBox="0 0 24 24"><path d="M5 6l6 6-6 6M13 6l6 6-6 6"/></svg>',
+  menu_SMS:            '<svg viewBox="0 0 24 24"><rect x="3" y="6" width="18" height="12" rx="2"/><path d="M3 7l9 6 9-6"/></svg>',
   menu_GameBoost:      '<svg viewBox="0 0 24 24"><rect x="3" y="8" width="18" height="9" rx="4"/><path d="M8 12v-2M7 12h2M15.5 12h.01M18 13.5h.01"/></svg>',
   menu_OpenNAT:        '<svg viewBox="0 0 24 24"><path d="M7 8l-4 4 4 4M17 8l4 4-4 4M14 6l-4 12"/></svg>',
   menu_APP:            '<svg viewBox="0 0 24 24"><rect x="4" y="5" width="16" height="14" rx="2"/><path d="M8 5v14"/></svg>',
@@ -457,11 +473,10 @@ var ICONS = {
      so an addon looks identical on the dashboard and inside the shell */
   menu_Addons:         '<svg viewBox="0 0 24 24"><path d="M10 4h4v3a2 2 0 0 0 2 2h3v4h-3a2 2 0 0 0-2 2v3h-4v-3a2 2 0 0 0-2-2H5V9h3a2 2 0 0 0 2-2z"/></svg>',
   menu_AiCloud:        '<svg viewBox="0 0 24 24"><path d="M7 17a4 4 0 0 1 .6-8 5 5 0 0 1 9.6 1.4A3.5 3.5 0 0 1 17 17z"/></svg>',
-  menu_Tool:           '<svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 11v5M12 8h.01"/></svg>',
   menu_Wireless:       '<svg viewBox="0 0 24 24"><path d="M4 9a12 12 0 0 1 16 0M7 12a8 8 0 0 1 10 0M10 15a4 4 0 0 1 4 0"/><circle cx="12" cy="18" r="1"/></svg>',
   menu_LAN:            '<svg viewBox="0 0 24 24"><rect x="3" y="10" width="18" height="8" rx="2"/><path d="M7 10V6h10v4"/></svg>',
   menu_WAN:            '<svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a15 15 0 0 1 0 18"/><path d="M16 4l4 2-2 4"/></svg>',
-  menu_Alexa_IFTTT:    '<svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="8"/><circle cx="12" cy="12" r="2.5"/></svg>',
+  menu_Alexa_IFTTT:    '<svg viewBox="0 0 24 24"><path d="M4 5h16v10H9l-5 4z"/></svg>',
   menu_VPN:            '<svg viewBox="0 0 24 24"><path d="M12 3l8 4v5c0 5-3.5 8-8 9-4.5-1-8-4-8-9V7z"/><path d="M12 9v6M9 12h6"/></svg>',
   menu_Firewall:       '<svg viewBox="0 0 24 24"><path d="M4 5h16v6c0 5-4 8-8 9-4-1-8-4-8-9z"/><path d="M4 9h16M9 5v4M15 5v4"/></svg>',
   menu_Setting:        '<svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"/><path d="M12 3v3M12 18v3M3 12h3M18 12h3M5 5l2 2M17 17l2 2M19 5l-2 2M7 17l-2 2"/></svg>',
