diff --git a/release/src/router/httpd/web.c b/release/src/router/httpd/web.c
index 49c1b7dada..6a8cb63612 100644
--- a/release/src/router/httpd/web.c
+++ b/release/src/router/httpd/web.c
@@ -21802,17 +21802,18 @@ static void reaper_gate_deny(FILE *stream, int why, const char *ns)
  * cfg_server then performs the fronthaul/backhaul split off the same
  * restart_wireless the stock page fires; nothing about that path is touched.
  *
- * v3.2.9: the box also runs the SDN reconcile every stock SDN writer runs
- * (create_sdn_mwl_profile, the guest-network apply, rc's check_sdn_onoff):
- * sync_apgx_to_wlunit() before the commit, restart_sdn after restart_wireless
- * in the page's chain. Without it a factory box stayed on the one DEFAULT
- * sdn_rl row until some later SDN apply, and the Network page's main card
- * could not be opened - adding a guest network was the field workaround,
- * because that apply is exactly this reconcile.
+ * v3.3.1 (supersedes the v3.2.9 note): a factory box has one DEFAULT sdn_rl
+ * row and no main network, so the Network page's main card cannot be opened.
+ * The main network is created only at BOOT by the closed init_apg() ->
+ * check_mwl_convert(), and only when x_Setting=1. v3.2.9 ran
+ * sync_apgx_to_wlunit() + restart_sdn instead, which only syncs rows that
+ * already exist and so could not fix it. The box now sets x_Setting=1 and the
+ * page's chain ends in reboot (GT-BE98_ICP field report, 2026-09-30: a WAN
+ * apply set x_Setting, the box rebooted, the mains appeared).
  *
- * nvram + commit ONLY. The page fires the restart itself, chained behind the
- * password apply ("saveNvram;restart_chpass;restart_wireless"), so the radios
- * never restart with a half-applied box. Gated on http_id like every other
+ * nvram + commit ONLY. The page fires the reboot itself, chained behind the
+ * password apply ("saveNvram;restart_chpass;reboot"), so the box never
+ * restarts with a half-applied setup. Gated on http_id like every other
  * state-changing Reaper CGI; the caller must already be authenticated (do_auth).
  *
  * The key bound is enforced HERE as well as in the page: hostapd accepts
@@ -21893,11 +21894,21 @@ do_reaper_wifisetup_cgi(char *url, FILE *stream)
 	snprintf(buf, sizeof(buf), "%d", selif);
 	nvram_set("smart_connect_selif_x", buf);
 	nvram_set("w_Setting", "1");
+	/* v3.3.1: "router configured" - what stock QIS sets on finishing. The main
+	 * network (MAINFH row + apm profile) is built from the wlN_* values above
+	 * ONLY by the closed init_apg() -> check_mwl_convert() at BOOT, and only
+	 * when x_Setting=1 (disassembled amas_apg.o, 2026-09-30). The page's chain
+	 * therefore ends in reboot. Set here rather than trusting validate_apply()
+	 * to do it on the page's start_apply. */
+	nvram_set("x_Setting", "1");
 #ifdef RTCONFIG_MULTILAN_CFG
-	sync_apgx_to_wlunit(NULL);	/* v3.2.9: the reconcile a guest-network apply runs */
+	/* Syncs EXISTING SDN rows only; it cannot create the main network (v3.2.9
+	 * assumed it could). Kept: harmless on a factory box, keeps a re-run of the
+	 * box consistent with whatever rows already exist. */
+	sync_apgx_to_wlunit(NULL);
 #endif
 	nvram_commit();
-	logmessage("reaper", "wifisetup: network name and key set on %d radio(s), Smart Connect on (selif %d), SDN synced; restart follows the password apply", n, selif);
+	logmessage("reaper", "wifisetup: network name and key set on %d radio(s), Smart Connect on (selif %d), x_Setting=1; reboot follows the password apply", n, selif);
 	websWrite(stream, "{\"ok\":1,\"radios\":%d,\"selif\":%d}", n, selif);
 }
 
@@ -40321,6 +40332,17 @@ ej_reaper_wifi_default(int eid, webs_t wp, int argc, char_t **argv)
 		def = nvram_default_get(key);
 		if (def && *def && !strcmp(psk, def))
 			return websWrite(wp, "1");
+
+		/* The printed-label key. A unit that carries one ("wifi_psk", added to
+		 * rc_support as "defpsk") resets through restore_defaults_wifi() to
+		 * psk2 + that key + w_Setting=1, never to open - so both tests above
+		 * read it as secured, the Wi-Fi row never showed, the setup box never
+		 * ran, and its SDN reconcile with it (GT-BE98_ICP field report,
+		 * 2026-09-30: main-network cards missing until an unrelated apply).
+		 * Same nvram restore_defaults_wifi() read; the value never leaves here. */
+		def = nvram_safe_get("wifi_psk");
+		if (*def && !strcmp(psk, def))
+			return websWrite(wp, "1");
 	}
 
 	return websWrite(wp, "0");
diff --git a/release/src/router/rc/init.c b/release/src/router/rc/init.c
index a04639a6a2..8c9969a0ce 100644
--- a/release/src/router/rc/init.c
+++ b/release/src/router/rc/init.c
@@ -1446,7 +1446,15 @@ restore_defaults_wifi(int all)
 #if defined(EBG15) || defined(EBG19)
 	char psk[32];
 #endif
-	int defpsk = strlen(nvram_safe_get("wifi_psk")) && nvram_contains_word("rc_support", "defpsk");
+	/* Reaper: the printed-label key is NOT applied. Stock would, on a unit with
+	 * "wifi_psk" + rc_support "defpsk", overwrite every radio with psk2 + that
+	 * key + the label SSID and set w_Setting=1 - so label units reset secured
+	 * while the rest reset open, and the first-boot banner judged them apart
+	 * (GT-BE98_ICP field report, 2026-09-30). One factory state on every unit:
+	 * admin/admin + the open template Wi-Fi (owner, v2.9.2), secured through
+	 * the setup box. rc_support "defpsk" itself is left alone - firewall.c and
+	 * ntpclient.c read it for unrelated behaviour. */
+	int defpsk = 0;
 	char word[256], *next;
 	int unit, subunit;
 	unsigned int max_mssid;
