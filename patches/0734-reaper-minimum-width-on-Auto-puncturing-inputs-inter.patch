+/* reaper v3.3.1: the node card on a box that is not routing.
+   The card counts clientList rows whose isOnline is true and whose amesh_papMac
+   is the node. genClientList() builds both from get_clientlist(), networkmap's
+   view, whose online flag comes from DHCP leases and conntrack - both empty in
+   Access Point, repeater and media-bridge mode, so every node card read 0
+   (GT-BE19000 tester). Same cause the v3.1.6 dashboard tiles fixed; same cure:
+   Reaper's own store (reaper_dev.cgi) builds presence from the radio assoc
+   lists, the bridge FDB, ARP and cfg_mnt's per-node client lists, and names the
+   node each device hangs off ("via"). A routing box never takes this path.
+   The store is read asynchronously and cached 30 s: action=status popen()s wl
+   per radio, VIF and station on a single-flight httpd, and the tree refreshes
+   every 10 s. Rows networkmap already placed are left alone. */
+var reaperAp = {
+	on: (typeof sw_mode != "undefined") && !(sw_mode == "1" || sw_mode == "4"),
+	t: 0, busy: false, dev: null
+};
+function reaper_ap_apply(){
+	if(!reaperAp.on || !reaperAp.dev || typeof clientList != "object") return;
+	var nodes = (typeof aimesh_data == "object" && aimesh_data.cfg_clientlist) ? aimesh_data.cfg_clientlist : [];
+	var spell = {}, cap = "";
+	for(var k = 0; k < nodes.length; k++){
+		if(nodes[k] && nodes[k].mac){
+			spell[String(nodes[k].mac).toUpperCase()] = nodes[k].mac;
+			if(k == 0) cap = String(nodes[k].mac).toUpperCase();
+		}
+	}
+	var wl = {"2.4": 1, "5": 2, "6": 4};
+	for(var i = 0; i < reaperAp.dev.length; i++){
+		var d = reaperAp.dev[i];
+		/* an affiliated MLO link is one radio link of a device already listed,
+		   and an AiMesh node is not a client - fold both, as the tiles do */
+		if(!d || !d.online || d.mlo_link || d.node || !d.mac || !d.via) continue;
+		var mac = String(d.mac).toUpperCase();
+		var via = String(d.via).toUpperCase();
+		var c = clientList[mac];
+		if(typeof c == "undefined"){
+			clientList.push(mac);
+			c = clientList[mac] = new setClientAttr();
+			c.mac = mac;
+			c.from = "reaper_dev";
+		}
+		else if(c.isOnline && c.amesh_papMac != "")
+			continue;	/* networkmap placed it: first-hand data wins */
+		c.isOnline = true;
+		if(c.name == "") c.name = (d.name && String(d.name).length) ? d.name : ((d.host && String(d.host).length) ? d.host : mac);
+		if(c.nickName == "" && d.name) c.nickName = d.name;
+		c.ip = (d.ip && String(d.ip).length) ? d.ip : "";
+		c.isWL = wl[d.band] || 0;
+		c.amesh_isReClient = (via != cap);
+		c.amesh_papMac = spell[via] || via;
+	}
+}
+function reaper_ap_fetch(){
+	if(!reaperAp.on || reaperAp.busy || typeof REAPER_HTTPID == "undefined") return;
+	if(reaperAp.t && (Date.now() - reaperAp.t) < 30000) return;
+	reaperAp.busy = true;
+	reaperAp.t = Date.now();
+	$.ajax({
+		url: "/reaper_dev.cgi",
+		data: {action: "status", http_id: REAPER_HTTPID, _: Date.now()},
+		dataType: "json",
+		timeout: 20000,
+		success: function(j){
+			if(!j || !j.devices) return;
+			reaperAp.dev = j.devices;
+			reaper_ap_apply();
+			if(current_click_mac != "" && $("#client_block").is(":visible"))
+				client_set_tab(current_client_click_type);
+		},
+		complete: function(){ reaperAp.busy = false; }
+	});
+}
+function reaper_gen_client_list(){
+	genClientList();
+	reaper_ap_apply();
+	reaper_ap_fetch();
+}
