+/* the operating width a client's traffic used: txbw is MHz summed per acked packet */
+static int width_class(const struct sacc *c)
+{
+	static const int w[5] = { 20, 40, 80, 160, 320 };
+	unsigned long long avg;
+	int i, best = -1, bd = 0;
+	if (!c->acked) return -1;
+	avg = c->bw / c->acked;
+	if (avg < 10 || avg > 400) return -1;
+	for (i = 0; i < 5; i++) {
+		int d = (int)avg > w[i] ? (int)avg - w[i] : w[i] - (int)avg;
+		if (best < 0 || d < bd) { best = i; bd = d; }
+	}
+	return best;
+}
