+/* the part of `cur` that is new since `prev`, read `elapsed` s earlier, into b1 (and b2) */
+static void sta_fresh(const struct stasnap *prev, const struct stasnap *cur, long elapsed, struct sbucket *b1, struct sbucket *b2)
+{
+	unsigned long long el_us = elapsed > 0 ? (unsigned long long)elapsed * 1000000ULL : 0;
+	int i;
+
+	for (i = 0; i < cur->n; i++) {
+		const struct sta *y = &cur->s[i], *x = (prev && prev->ok) ? sta_find(prev, y->mac) : NULL;
+		unsigned long long a, rt, rs, w;
+		if (x && y->acked >= x->acked && y->retry >= x->retry && y->rate >= x->rate && y->bw >= x->bw &&
+		    (!cur->has_td || y->td >= el_us)) {
+			a = y->acked - x->acked; rt = y->retry - x->retry; rs = y->rate - x->rate; w = y->bw - x->bw;	/* no reset between */
+		} else if (cur->has_td && y->td < el_us) {
+			a = y->acked; rt = y->retry; rs = y->rate; w = y->bw;					/* reset since prev: all new */
+		} else
+			continue;										/* cannot place it */
+		if (!a && !rt) continue;
+		bucket_add(b1, y->mac, a, rt, rs, w);
+		if (b2) bucket_add(b2, y->mac, a, rt, rs, w);
+	}
+}
