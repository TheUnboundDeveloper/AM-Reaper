+static int sta_read_if(const char *ifn, struct stasnap *sn, char *hdr, size_t hlen)
+{
+	char cmd[160];
+	FILE *p;
+	int rc;
+
+	snprintf(cmd, sizeof(cmd), "/usr/sbin/wl -i %s bs_data -noreset -raw -comma -noidle -nooverall 2>/dev/null", ifn);
+	if ((p = popen(cmd, "r")) == NULL) return 0;
+	rc = sta_parse(p, sn, hdr, hlen);
+	pclose(p);
+	return rc;
