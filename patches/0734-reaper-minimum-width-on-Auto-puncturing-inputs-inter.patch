+/* ---- v3.3.1 r6/r7: the station table ----
+ * `wl bs_data -noreset -raw -comma -noidle -nooverall` on the radio and each client network.
+ * -noreset is not optional: a plain read clears the counters, and bsd reads the same table.
+ * Metal (RT-BE96U, 2026-09-30) - the raw header and a row:
+ *   "  Station Address,retry_dro   rtsfail     retry txrate_ma txrate_su     acked throughpu
+ *    time_delt   airtime      txbw     txmcs     txnss        ru        mu"
+ *   "54:07:7D:84:9F:3F,        0         0         0         0     97217        99 ..."
+ * Every counter is a running total since the table's last reset - txbw too, in MHz per
+ * acked packet (7920 / 99 = 80) - and time_delt is that reset's age in microseconds. Another
+ * reader resets the table every few seconds (1.75 s on every station), so a read is mostly a
+ * short window of its own: sta_fresh() takes the delta against the previous read only when
+ * time_delt shows no reset in between, the whole read when it does, and nothing it cannot
+ * place. Columns are found by header name; a table this code does not understand turns
+ * client evidence off for the radio, once, with the header in the log. */
+static int sta_parse(FILE *p, struct stasnap *sn, char *hdr, size_t hlen)
+{
+	char line[512], buf[512];
+	int ia = -1, ir = -1, it = -1, ib = -1, id = -1, ncol = 0, got_hdr = 0, bad = 0;
+
+	while (fgets(line, sizeof(line), p)) {
+		char *tok, *sp = NULL, *q;
+		line[strcspn(line, "\r\n")] = 0;
+		if (!got_hdr && strstr(line, "Station")) {
+			int c = 0;
+			strlcpy(buf, line, sizeof(buf));
+			strlcpy(hdr, line, hlen);
+			for (tok = strtok_r(buf, " \t,", &sp); tok; tok = strtok_r(NULL, " \t,", &sp)) {
+				if (!strcmp(tok, "Station") || !strcmp(tok, "Address") || tok[0] == '(') continue;
+				if (!strcmp(tok, "acked")) ia = c;
+				else if (!strcmp(tok, "retry")) ir = c;
+				else if (!strncmp(tok, "txrate_s", 8)) it = c;
+				else if (!strcmp(tok, "txbw")) ib = c;
+				else if (!strncmp(tok, "time_del", 8)) id = c;
+				c++;
+			}
+			ncol = c; got_hdr = 1;
+			if (ia < 0 || ir < 0 || it < 0) bad = 1;
+			if (id < 0) sn->has_td = 0;
+			continue;
+		}
+		if (!got_hdr || bad) continue;
+		q = line;
+		while (*q == ' ' || *q == '\t') q++;
+		if (strlen(q) < 17 || q[2] != ':' || q[5] != ':' || q[14] != ':') continue;	/* not a station row */
+		if (sn->n >= RP_STA_MAX) continue;
+		{
+			struct sta *st = &sn->s[sn->n];
+			unsigned long long v[32];
+			char *e, *o, *sp2 = NULL;
+			int c = 0, i;
+			for (i = 0; i < 17; i++) st->mac[i] = toupper((unsigned char)q[i]);
+			st->mac[17] = 0;
+			q += 17;
+			if ((o = strchr(q, '(')) != NULL && (e = strchr(o, ')')) != NULL) q = e + 1;	/* "(-45dBm)" */
+			for (tok = strtok_r(q, ", \t", &sp2); tok && c < 32; tok = strtok_r(NULL, ", \t", &sp2)) {
+				if (!isdigit((unsigned char)tok[0])) { c = -1; break; }
+				v[c++] = strtoull(tok, NULL, 10);
+			}
+			if (c != ncol) {
+				snprintf(hdr, hlen, "row has %d values for %d columns", c, ncol);
+				bad = 1; continue;
+			}
+			st->acked = v[ia]; st->retry = v[ir]; st->rate = v[it];
+			st->bw = ib >= 0 ? v[ib] : 0; st->td = id >= 0 ? v[id] : 0;
+			sn->n++;
+		}
+	}
+	return bad ? -1 : 1;
+}
