diff --git a/release/src/router/rc/reaper_bwfloor.c b/release/src/router/rc/reaper_bwfloor.c
new file mode 100644
index 0000000000..909387d118
--- /dev/null
+++ b/release/src/router/rc/reaper_bwfloor.c
@@ -0,0 +1,686 @@
+/*
+ * SPDX-License-Identifier: GPL-2.0-only
+ * Copyright (C) 2026 the Reaper project maintainer
+ *
+ * reaper v3.3.1: minimum channel width on Auto ("80/160 MHz" on 5 GHz,
+ * "80/160/320 MHz" on 6 GHz), opt-in per radio with wlN_bwfloor=1.
+ *
+ * WHY. With Channel bandwidth on Auto the closed channel picker (acsd2) chooses
+ * the width as well as the channel, and it narrows to 40 or 20 MHz when it
+ * judges part of a wide channel busy. Preamble puncturing (rc/reaper_punct.c,
+ * rpunctd) only exists at 80 MHz and wider, so every such narrowing also takes
+ * away the one state in which puncturing could have handled the busy part.
+ * The floor keeps the picker at 80 MHz or wider; puncturing then cuts the busy
+ * 20 out instead of the whole channel shrinking.
+ *
+ * HOW (no closed code touched). acsd2 never picks a chanspec listed in
+ * wlN_acs_excl_chans. rc rebuilds that list at every boot and wireless restart
+ * (set_acs_ifnames(), rc/sysdeps/init-broadcom.c); reaper_bwfloor_excl() runs at
+ * its end and appends every chanspec of the radio narrower than the floor,
+ * taken from the radio itself (`wl chanspecs -b <band> -w <width>`, so the
+ * country and the radio's own range decide, e.g. the GT-BE98's split 5 GHz
+ * radios). Only entries that were not already excluded are added, and they are
+ * recorded so exactly those - never a stock DFS or user exclusion - can be
+ * taken out again. acs_excl_chans is on the libnvram JFFS whitelist (stored as
+ * a file under /jffs/nvram, uncapped), so the 1 KB nvram tuple wall does not
+ * apply to it - and for the same reason it SURVIVES A REBOOT.
+ *
+ * STRIP FIRST, ADD LAST (review 2026-09-30). Stock does NOT rewrite every
+ * radio's list on every run: on EU/AU/JP/AA/TW/KR territories the 6 GHz list is
+ * left as it was. So (1) the record of what we added lives on /jffs too
+ * (/jffs/reaper_bwfloor/wlN.added, /tmp fallback), and (2) reaper_bwfloor_strip()
+ * runs at the START of set_acs_ifnames() and removes our entries before any
+ * stock code reads the list. Without (2) the stock merge add_cfgexcl_2_acsexcl()
+ * would read our ~90 6 GHz entries into its fixed MAX_CHANS array, which writes
+ * one slot past the end when full. Our entries are removed only while ALL of
+ * them are still present: stock regenerating a list drops some of them (it
+ * never excludes every narrow chanspec), and then the list is stock's own and
+ * is left untouched - so a stock DFS exclusion can never be taken out.
+ *
+ * NEVER AN EMPTY PICKER. acsd2 answers a list that excludes everything by
+ * invalidating the WHOLE list ("invalidating exclude channels"), stock DFS
+ * exclusions included. So the floor is only applied when at least one chanspec
+ * at or above it is still allowed after the stock exclusions; otherwise it is
+ * reported "unavailable" and nothing is added.
+ *
+ * RADAR ESCAPE (this daemon, /sbin/reaper_bwfloor -> rc). A radar hit makes the
+ * driver vacate the channel, and with the floor armed the picker may have no
+ * wide channel left to return to for the 30-minute non-occupancy period. The
+ * daemon watches the OUTCOME rather than radar internals: every 15 s, per armed
+ * radio, the live width (chanspec iovar) and whether the radio is up.
+ *   - below the floor for 120 s (a radar move, or anything else that keeps it
+ *     narrow), or
+ *   - down for 180 s outside a DFS channel availability check (up to 11 min
+ *     of CAC is allowed: weather channels take 10) and not on a Wi-Fi schedule
+ *     (a scheduled off-period is expected, not a fault),
+ * lifts the floor for that radio (removes exactly its entries, restarts acsd2
+ * so it re-reads the list) for 30 min - the DFS non-occupancy period - doubling
+ * on a repeat within 2 h, capped at 4 h. When the hold ends and the radio is
+ * up, the floor is re-armed the same way. One syslog line per lift / re-arm.
+ * The lift is recorded in /tmp/reaper_bwfloor/escape, which set_acs_ifnames()
+ * honours too, so a wireless restart during the hold does not re-arm early.
+ *
+ * Inactive (reported, nothing added): radio off, a fixed channel (acsd2 does
+ * not run for it), a fixed width, not an access point, an AiMesh node, 2.4 GHz.
+ */
+#include "rc.h"
+#include <signal.h>
+#include <stdarg.h>
+#include <sys/stat.h>
+#include <sys/sysinfo.h>
+#include <wlutils.h>
+
+#define BF_DIR		"/tmp/reaper_bwfloor"
+#define BF_STATE	BF_DIR "/state"
+#define BF_ESC		BF_DIR "/escape"
+#define BF_REC		"/jffs/reaper_bwfloor"	/* what we added, per radio: must outlive a reboot like the list does */
+#define BF_MAXU		4		/* radios: the GT-BE98 family has four; the band comes from wlN_nband */
+#define BF_TICK		15		/* s */
+#define BF_BELOW	120		/* s narrower than the floor before it is lifted */
+#define BF_DARK		180		/* s down (outside a CAC) before it is lifted */
+#define BF_CACMAX	660		/* s of channel availability check tolerated (weather channels: 600) */
+#define BF_HOLD		1800		/* s, first lift = the DFS non-occupancy period */
+#define BF_HOLDMAX	14400		/* s */
+#define BF_REPEAT	7200		/* s, a lift within this of the previous one doubles the hold */
+#define BF_LISTMAX	4000		/* sanity bound on the list we write */
+
+static volatile sig_atomic_t g_stop;
+static void on_sig(int s) { (void)s; g_stop = 1; }
+
+static long up_s(void)
+{
+	struct sysinfo si;
+	return sysinfo(&si) == 0 ? (long)si.uptime : (long)time(NULL);
+}
+
+/* the nvram value becomes a shell word in the popen() below: gate it first */
+static int ifname_ok(const char *s)
+{
+	size_t n = strlen(s);
+	return n > 0 && n < IFNAMSIZ &&
+	       strspn(s, "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789._-") == n;
+}
+
+static int unit_ifname(int u, char *ifn, size_t len)
+{
+	char key[24];
+	snprintf(key, sizeof(key), "wl%d_ifname", u);
+	strlcpy(ifn, nvram_safe_get(key), len);
+	return ifn[0] && ifname_ok(ifn);
+}
+
+static const char *unit_get(int u, const char *k)
+{
+	char key[40];
+	snprintf(key, sizeof(key), "wl%d_%s", u, k);
+	return nvram_safe_get(key);
+}
+
+/* 80 on 5 GHz and on 6 GHz - the narrowest width puncturing exists at. The
+ * option label lists what the picker may then choose ("80/160 MHz", "80/160/320
+ * MHz"); each client uses what it supports within that. 0 = no floor (2.4 GHz). */
+static int floor_of(int u)
+{
+	const char *nb = unit_get(u, "nband");
+	return (!strcmp(nb, "1") || !strcmp(nb, "4")) ? 80 : 0;
+}
+
+static int configured(int u) { return !strcmp(unit_get(u, "bwfloor"), "1"); }
+
+/* NULL = the floor can apply to this radio now, else why not */
+static const char *inactive_reason(int u)
+{
+	char ifn[IFNAMSIZ];
+
+	if (!floor_of(u))				return "band";
+	if (!unit_ifname(u, ifn, sizeof(ifn)))		return "ifname";
+	if (nvram_match("re_mode", "1"))		return "node";
+	if (!strcmp(unit_get(u, "radio"), "0"))		return "radio-off";
+	if (strcmp(unit_get(u, "mode"), "ap"))		return "not-ap";
+	if (strcmp(unit_get(u, "chanspec"), "0"))	return "fixed-channel";
+	if (strcmp(unit_get(u, "bw"), "0"))		return "fixed-width";
+	return NULL;
+}
+
+/* ---- the lift record: "wlN until=<uptime s> n=<count> at=<uptime s> reason=<r>" ---- */
+struct esc { long until, at; int n; char reason[24]; };
+
+static void esc_load(struct esc e[BF_MAXU])
+{
+	FILE *f;
+	char line[160];
+	int u;
+
+	memset(e, 0, sizeof(struct esc) * BF_MAXU);
+	if ((f = fopen(BF_ESC, "r")) == NULL)
+		return;
+	while (fgets(line, sizeof(line), f)) {
+		struct esc t;
+		memset(&t, 0, sizeof(t));
+		if (sscanf(line, "wl%d until=%ld n=%d at=%ld reason=%23s", &u, &t.until, &t.n, &t.at, t.reason) >= 4 &&
+		    u >= 0 && u < BF_MAXU)
+			e[u] = t;
+	}
+	fclose(f);
+}
+
+static void esc_save(const struct esc e[BF_MAXU])
+{
+	FILE *f;
+	int u;
+
+	mkdir(BF_DIR, 0755);
+	if ((f = fopen(BF_ESC ".tmp", "w")) == NULL)
+		return;
+	for (u = 0; u < BF_MAXU; u++)
+		if (e[u].n)
+			fprintf(f, "wl%d until=%ld n=%d at=%ld reason=%s\n", u, e[u].until, e[u].n, e[u].at,
+				e[u].reason[0] ? e[u].reason : "-");
+	fclose(f);
+	rename(BF_ESC ".tmp", BF_ESC);
+}
+
+static int escaped(int u)
+{
+	struct esc e[BF_MAXU];
+	esc_load(e);
+	return e[u].until > up_s();
+}
+
+/* ---- chanspec lists: comma-separated "0x...." as stock writes them ---- */
+static int list_has(const char *list, unsigned int cs)
+{
+	const char *p = list;
+	char *end;
+
+	while (*p) {
+		unsigned long v = strtoul(p, &end, 16);
+		if (end != p && v == cs)
+			return 1;
+		p = strchr(p, ',');
+		if (!p)
+			break;
+		p++;
+	}
+	return 0;
+}
+
+static void list_add(char *list, size_t len, unsigned int cs)
+{
+	char t[12];
+	snprintf(t, sizeof(t), "%s0x%04x", list[0] ? "," : "", cs);
+	strlcat(list, t, len);
+}
+
+/* every chanspec the radio offers at one width, as "0x....," (from its "(0x....)" column) */
+static int radio_chanspecs(const char *ifn, int band, int width, char *out, size_t len)
+{
+	char cmd[96], line[96], *p;
+	FILE *pp;
+	int n = 0;
+
+	out[0] = 0;
+	snprintf(cmd, sizeof(cmd), "wl -i %s chanspecs -b %d -w %d 2>/dev/null", ifn, band, width);
+	if ((pp = popen(cmd, "r")) == NULL)
+		return -1;
+	while (fgets(line, sizeof(line), pp))
+		if ((p = strstr(line, "(0x")) != NULL) {
+			list_add(out, len, (unsigned int)strtoul(p + 1, NULL, 16));
+			n++;
+		}
+	pclose(pp);
+	return n;
+}
+
+static void res_write(int u, const char *fmt, ...)
+{
+	char path[48], buf[96];
+	va_list ap;
+	FILE *f;
+
+	va_start(ap, fmt);
+	vsnprintf(buf, sizeof(buf), fmt, ap);
+	va_end(ap);
+	mkdir(BF_DIR, 0755);
+	snprintf(path, sizeof(path), BF_DIR "/wl%d.res", u);
+	if ((f = fopen(path, "w")) != NULL) {
+		fprintf(f, "%s\n", buf);
+		fclose(f);
+	}
+}
+
+static void res_read(int u, char *out, size_t len)
+{
+	char path[48];
+	FILE *f;
+
+	out[0] = 0;
+	snprintf(path, sizeof(path), BF_DIR "/wl%d.res", u);
+	if ((f = fopen(path, "r")) != NULL) {
+		if (fgets(out, len, f))
+			out[strcspn(out, "\r\n")] = 0;
+		fclose(f);
+	}
+}
+
+/* ---- the record of what we added: /jffs first (it must outlive a reboot, as the
+ * list itself does), /tmp when /jffs is not writable (not mounted yet) ---- */
+static void rec_read(int u, char *out, size_t len)
+{
+	char path[48];
+	FILE *f;
+
+	out[0] = 0;
+	snprintf(path, sizeof(path), BF_REC "/wl%d.added", u);
+	if ((f = fopen(path, "r")) == NULL) {
+		snprintf(path, sizeof(path), BF_DIR "/wl%d.added", u);
+		f = fopen(path, "r");
+	}
+	if (f) {
+		if (!fgets(out, len, f))
+			out[0] = 0;
+		fclose(f);
+	}
+	out[strcspn(out, "\r\n")] = 0;
+}
+
+static void rec_drop(int u)
+{
+	char path[48];
+	snprintf(path, sizeof(path), BF_REC "/wl%d.added", u);
+	unlink(path);
+	snprintf(path, sizeof(path), BF_DIR "/wl%d.added", u);
+	unlink(path);
+}
+
+static void rec_write(int u, const char *added)
+{
+	char path[48], tmp[56];
+	FILE *f;
+
+	rec_drop(u);
+	mkdir(BF_REC, 0755);
+	snprintf(path, sizeof(path), BF_REC "/wl%d.added", u);
+	snprintf(tmp, sizeof(tmp), "%s.tmp", path);
+	if ((f = fopen(tmp, "w")) != NULL) {
+		fprintf(f, "%s\n", added);
+		fclose(f);
+		if (rename(tmp, path) == 0)
+			return;
+		unlink(tmp);
+	}
+	mkdir(BF_DIR, 0755);
+	snprintf(path, sizeof(path), BF_DIR "/wl%d.added", u);
+	if ((f = fopen(path, "w")) != NULL) {
+		fprintf(f, "%s\n", added);
+		fclose(f);
+	}
+}
+
+/*
+ * Take our entries out of wlN_acs_excl_chans - only while EVERY one of them is
+ * still there. If any is missing, stock has regenerated the list since we added
+ * them (it never excludes every narrow chanspec), so the list is stock's own and
+ * is left alone: removing "our" values from it could take out a stock DFS
+ * exclusion that happens to share a value. Either way the record is dropped.
+ */
+static void strip_unit(int u)
+{
+	static char cur[BF_LISTMAX + 1024], out[BF_LISTMAX + 1024], added[2048];
+	char key[40];
+	const char *p;
+	char *end;
+	int all = 1;
+
+	rec_read(u, added, sizeof(added));
+	if (!added[0])
+		return;
+	snprintf(key, sizeof(key), "wl%d_acs_excl_chans", u);
+	strlcpy(cur, nvram_safe_get(key), sizeof(cur));
+	for (p = added; *p; ) {
+		unsigned long v = strtoul(p, &end, 16);
+		if (end != p && !list_has(cur, (unsigned int)v)) { all = 0; break; }
+		p = strchr(p, ',');
+		if (!p)
+			break;
+		p++;
+	}
+	if (all) {
+		out[0] = 0;
+		for (p = cur; *p; ) {
+			unsigned long v = strtoul(p, &end, 16);
+			if (end != p && !list_has(added, (unsigned int)v))
+				list_add(out, sizeof(out), (unsigned int)v);
+			p = strchr(p, ',');
+			if (!p)
+				break;
+			p++;
+		}
+		nvram_set(key, out);
+	}
+	rec_drop(u);
+}
+
+/* called at the START of set_acs_ifnames(), before any stock code reads the lists */
+void reaper_bwfloor_strip(void)
+{
+	int u;
+	for (u = 0; u < BF_MAXU; u++)
+		strip_unit(u);
+}
+
+/*
+ * Bring wlN_acs_excl_chans in line for one radio: take our previous entries
+ * out (a no-op right after reaper_bwfloor_strip), then add the floor if it
+ * applies. Returns 1 applied, 2 unavailable, 0 off/inactive/lifted, -1 error.
+ */
+static int excl_unit(int u)
+{
+	static char cur[BF_LISTMAX + 1024], added[2048], lst[2048];
+	char key[40], ifn[IFNAMSIZ];
+	const char *why;
+	int fl, band, avail = 0, n = 0, i;
+	int wide[3], narrow[2], nw, nn;
+
+	if (!unit_ifname(u, ifn, sizeof(ifn)))
+		return 0;
+	strip_unit(u);
+	snprintf(key, sizeof(key), "wl%d_acs_excl_chans", u);
+	strlcpy(cur, nvram_safe_get(key), sizeof(cur));
+
+	why = configured(u) ? inactive_reason(u) : "off";
+	if (!why && escaped(u))
+		why = "lifted";
+	if (why) {
+		res_write(u, "%s", why);
+		return 0;
+	}
+
+	fl = floor_of(u);
+	band = !strcmp(unit_get(u, "nband"), "4") ? 6 : 5;
+	narrow[0] = 20; narrow[1] = 40; nn = 2;		/* below the 80 MHz floor */
+	wide[0] = 80; wide[1] = 160; nw = 2;		/* at or above it; 6 GHz adds 320 */
+	if (band == 6) wide[nw++] = 320;
+
+	/* 2. at least one chanspec at or above the floor must stay allowed */
+	for (i = 0; i < nw; i++) {
+		const char *p;
+		char *end;
+		if (radio_chanspecs(ifn, band, wide[i], lst, sizeof(lst)) <= 0)
+			continue;
+		for (p = lst; *p; ) {
+			unsigned long v = strtoul(p, &end, 16);
+			if (end != p && !list_has(cur, (unsigned int)v))
+				avail++;
+			p = strchr(p, ',');
+			if (!p)
+				break;
+			p++;
+		}
+	}
+	if (!avail) {
+		res_write(u, "unavailable");
+		logmessage("reaper_bwfloor", "wl%d: no %d MHz or wider channel is left after the existing exclusions (DFS off?) - the minimum width is not applied", u, fl);
+		return 2;
+	}
+
+	/* 3. exclude every narrower chanspec that is not excluded already */
+	added[0] = 0;
+	for (i = 0; i < nn; i++) {
+		const char *p;
+		char *end;
+		if (radio_chanspecs(ifn, band, narrow[i], lst, sizeof(lst)) < 0)
+			continue;
+		for (p = lst; *p; ) {
+			unsigned long v = strtoul(p, &end, 16);
+			if (end != p && !list_has(cur, (unsigned int)v)) {
+				list_add(cur, sizeof(cur), (unsigned int)v);
+				list_add(added, sizeof(added), (unsigned int)v);
+				n++;
+			}
+			p = strchr(p, ',');
+			if (!p)
+				break;
+			p++;
+		}
+	}
+	if (strlen(cur) > BF_LISTMAX) {
+		res_write(u, "error-long");
+		logmessage("reaper_bwfloor", "wl%d: the exclusion list would exceed %d bytes - the minimum width is not applied", u, BF_LISTMAX);
+		return -1;
+	}
+	if (n == 0) {
+		res_write(u, "applied n=0");	/* every narrower chanspec was excluded already */
+		return 1;
+	}
+	nvram_set(key, cur);
+	rec_write(u, added);
+	res_write(u, "applied n=%d", n);
+	return 1;
+}
+
+/* called at the END of set_acs_ifnames(), after the stock list and the user's cfg exclusions */
+void reaper_bwfloor_excl(void)
+{
+	int u;
+	for (u = 0; u < BF_MAXU; u++)
+		excl_unit(u);
+}
+
+static void restart_picker(void)
+{
+	notify_rc("restart_acsd");
+}
+
+/* the live width from the raw chanspec (WL_CHANSPEC_BW_* in bits 11-13), 0 = unknown */
+static int live_width(const char *ifn, unsigned int *csout)
+{
+	int cs = 0;
+
+	if (wl_iovar_getint((char *)ifn, "chanspec", &cs) < 0 || cs == 0)
+		return 0;
+	*csout = (unsigned int)cs & 0xffff;
+	switch (cs & 0x3800) {
+	case 0x1000: return 20;
+	case 0x1800: return 40;
+	case 0x2000: return 80;
+	case 0x2800: return 160;
+	case 0x3000: return 320;
+	}
+	return 0;
+}
+
+static int wl_first_line(const char *ifn, const char *args, char *buf, size_t len)
+{
+	char cmd[96];
+	FILE *p;
+	int ok;
+
+	buf[0] = 0;
+	snprintf(cmd, sizeof(cmd), "wl -i %s %s 2>/dev/null", ifn, args);
+	if ((p = popen(cmd, "r")) == NULL)
+		return -1;
+	ok = fgets(buf, len, p) != NULL;
+	pclose(p);
+	return ok ? 0 : -1;
+}
+
+static int radio_up(const char *ifn)
+{
+	char b[16];
+	return wl_first_line(ifn, "isup", b, sizeof(b)) == 0 && atoi(b) == 1;
+}
+
+/* "state PRE-ISM Channel Availability Check(CAC) ..." / "... In-Service Monitoring(ISM) ..." */
+static int in_cac(const char *ifn)
+{
+	char b[160];
+	return wl_first_line(ifn, "dfs_status", b, sizeof(b)) == 0 && strstr(b, "(CAC)") != NULL;
+}
+
+static void lift(int u, struct esc e[BF_MAXU], const char *reason, int fl)
+{
+	long now = up_s(), hold = BF_HOLD;
+	int k;
+
+	e[u].n = (e[u].at && now - e[u].at < BF_REPEAT) ? e[u].n + 1 : 1;
+	for (k = 1; k < e[u].n && hold < BF_HOLDMAX; k++)
+		hold *= 2;
+	if (hold > BF_HOLDMAX)
+		hold = BF_HOLDMAX;
+	e[u].at = now;
+	e[u].until = now + hold;
+	strlcpy(e[u].reason, reason, sizeof(e[u].reason));
+	esc_save(e);
+	excl_unit(u);		/* escaped() is now true: strips our entries and adds nothing */
+	restart_picker();
+	logmessage("reaper_bwfloor", "wl%d: the %d MHz minimum width could not be held (%s) - lifted for %ld min so the radio can use any width; it re-arms by itself",
+		u, fl, reason, hold / 60);
+}
+
+int reaper_bwfloor_main(int argc, char *argv[])
+{
+	struct esc e[BF_MAXU];
+	int below[BF_MAXU] = {0}, dark[BF_MAXU] = {0}, cac[BF_MAXU] = {0};
+	int pend[BF_MAXU] = {0};	/* re-armed while already wide: the acsd2 restart waits (see the re-arm) */
+	(void)argc; (void)argv;
+
+	signal(SIGHUP, SIG_IGN);
+	signal(SIGTERM, on_sig);
+	signal(SIGINT, on_sig);
+	mkdir(BF_DIR, 0755);
+
+	while (!g_stop) {
+		char lines[BF_MAXU][200];
+		int u, any = 0;
+		long now = up_s();
+		FILE *f;
+
+		esc_load(e);
+		for (u = 0; u < BF_MAXU; u++) {
+			char ifn[IFNAMSIZ], res[64];
+			const char *why;
+			unsigned int cs = 0;
+			int fl = floor_of(u), w;
+
+			lines[u][0] = 0;
+			if (!configured(u)) { below[u] = dark[u] = cac[u] = 0; continue; }
+			any = 1;
+			if ((why = inactive_reason(u)) != NULL) {
+				below[u] = dark[u] = cac[u] = 0;
+				snprintf(lines[u], sizeof(lines[u]), "wl%d floor=%d state=inactive reason=%s", u, fl, why);
+				continue;
+			}
+			unit_ifname(u, ifn, sizeof(ifn));
+			if (e[u].until > now) {
+				snprintf(lines[u], sizeof(lines[u]), "wl%d floor=%d state=lifted remain=%ld reason=%s", u, fl, e[u].until - now, e[u].reason);
+				continue;
+			}
+			if (e[u].until) {
+				/* the hold is over: re-arm once the radio is up */
+				if (!radio_up(ifn)) {
+					snprintf(lines[u], sizeof(lines[u]), "wl%d floor=%d state=lifted remain=0 reason=waiting-radio", u, fl);
+					continue;
+				}
+				e[u].until = 0;
+				esc_save(e);
+				below[u] = dark[u] = cac[u] = 0;
+				if (excl_unit(u) == 1) {
+					/* metal 2026-10-01: restarting acsd2 here made it pick the channel again from
+					 * scratch (wl1 40/160 -> 157/80 -> 40/160, two clients dropped) although the
+					 * radio already met the floor. acsd2 reads the exclusions only when it starts,
+					 * so while the radio is wide the restart waits until it narrows - a channel
+					 * change is under way at that moment anyway (below). */
+					w = live_width(ifn, &cs);
+					if (w >= fl) {
+						pend[u] = 1;
+						logmessage("reaper_bwfloor", "wl%d: the %d MHz minimum width is re-armed (the radio is at %d MHz; the channel picker takes it at its next restart)", u, fl, w);
+					} else {
+						restart_picker();
+						logmessage("reaper_bwfloor", "wl%d: the %d MHz minimum width is re-armed", u, fl);
+					}
+				}
+			}
+			res_read(u, res, sizeof(res));
+			if (strncmp(res, "applied", 7)) {
+				/* never applied (unavailable / error / not yet built): nothing to supervise */
+				below[u] = dark[u] = cac[u] = 0;
+				snprintf(lines[u], sizeof(lines[u]), "wl%d floor=%d state=%s", u, fl, res[0] ? res : "pending");
+				continue;
+			}
+			w = live_width(ifn, &cs);
+			if (w >= fl && radio_up(ifn)) {
+				below[u] = dark[u] = cac[u] = 0;
+				snprintf(lines[u], sizeof(lines[u]), "wl%d floor=%d state=armed width=%d cs=0x%04x%s", u, fl, w, cs,
+					pend[u] ? " note=picker-pending" : "");
+				continue;
+			}
+			if (fl == 80 && cac[u] < BF_CACMAX && in_cac(ifn)) {
+				cac[u] += BF_TICK;
+				snprintf(lines[u], sizeof(lines[u]), "wl%d floor=%d state=armed width=%d cs=0x%04x note=cac", u, fl, w, cs);
+				continue;
+			}
+			if (pend[u] && radio_up(ifn)) {
+				/* narrowed while acsd2 still holds the list from before the re-arm: restart it
+				 * now so it reads the floor, instead of counting toward a lift */
+				pend[u] = 0;
+				below[u] = 0;
+				restart_picker();
+				logmessage("reaper_bwfloor", "wl%d: narrowed to %d MHz with the minimum width re-armed - the channel picker restarts to apply it", u, w);
+				snprintf(lines[u], sizeof(lines[u]), "wl%d floor=%d state=armed width=%d cs=0x%04x note=picker", u, fl, w, cs);
+				continue;
+			}
+			if (radio_up(ifn)) {
+				dark[u] = 0;
+				below[u] += BF_TICK;
+				if (below[u] >= BF_BELOW) { lift(u, e, "below-floor", fl); below[u] = cac[u] = 0; }
+			} else if (!strcmp(unit_get(u, "timesched"), "1")) {
+				/* a radio on a Wi-Fi schedule is expected to go down: not a fault */
+				below[u] = dark[u] = 0;
+			} else {
+				below[u] = 0;
+				dark[u] += BF_TICK;
+				if (dark[u] >= BF_DARK) { lift(u, e, "off-air", fl); dark[u] = cac[u] = pend[u] = 0; }
+			}
+			if (e[u].until > now)
+				snprintf(lines[u], sizeof(lines[u]), "wl%d floor=%d state=lifted remain=%ld reason=%s", u, fl, e[u].until - now, e[u].reason);
+			else
+				snprintf(lines[u], sizeof(lines[u]), "wl%d floor=%d state=armed width=%d cs=0x%04x note=%s", u, fl, w, cs,
+					below[u] ? "narrow" : "down");
+		}
+
+		if (!any) {
+			unlink(BF_STATE);
+			break;		/* no radio configured: nothing to watch */
+		}
+		if ((f = fopen(BF_STATE ".tmp", "w")) != NULL) {
+			for (u = 0; u < BF_MAXU; u++)
+				if (lines[u][0])
+					fprintf(f, "%s\n", lines[u]);
+			fclose(f);
+			rename(BF_STATE ".tmp", BF_STATE);
+		}
+		sleep(BF_TICK);
+	}
+	return 0;
+}
+
+void stop_reaper_bwfloor(void)
+{
+	if (pids("reaper_bwfloor"))
+		killall_tk("reaper_bwfloor");
+}
+
+void start_reaper_bwfloor(void)
+{
+	int u, want = 0;
+
+	stop_reaper_bwfloor();
+	for (u = 0; u < BF_MAXU; u++)
+		if (configured(u))
+			want = 1;
+	if (want)
+		xstart("reaper_bwfloor");
+	else
+		unlink(BF_STATE);
+}
diff --git a/release/src/router/rc/reaper_punct.c b/release/src/router/rc/reaper_punct.c
index 43cea86163..88463b73cb 100644
--- a/release/src/router/rc/reaper_punct.c
+++ b/release/src/router/rc/reaper_punct.c
@@ -49,6 +49,10 @@
  * all. It only ever clears a pattern it set itself (the state file says which).
  * rc logmessage() lines can be filtered by the syslog level on some boxes; the
  * state file is the record: /tmp/reaper_punct.state, one line per radio.
+ *
+ * reaper v3.3.1: the same applet runs a second, independent pass for the
