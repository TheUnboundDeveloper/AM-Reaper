 #!/bin/sh
 # ============================================================================
-#  REAPER-DIAG v1.3.24 (2026-09-28) - sanitized one-shot diagnostic bundle
+#  REAPER-DIAG v1.3.25 (2026-09-30) - sanitized one-shot diagnostic bundle
