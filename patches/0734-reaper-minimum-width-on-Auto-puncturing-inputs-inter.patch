+		for (i = 0; hdr[i]; i++) if ((unsigned char)hdr[i] < 0x20 || hdr[i] == '"') hdr[i] = ' ';
+		syslog(LOG_NOTICE, "rpunctd: %s station table not understood (%.120s) - client evidence off for this radio", r->ifn, hdr);
