+static void bucket_add(struct sbucket *b, const char *mac, unsigned long long acked, unsigned long long retry,
+	unsigned long long rate, unsigned long long bw)
+{
+	int i;
+	for (i = 0; i < b->n; i++) if (!strcmp(b->c[i].mac, mac)) break;
+	if (i == b->n) {
+		if (b->n >= RP_STA_MAX) return;
+		memset(&b->c[i], 0, sizeof(b->c[i]));
+		strlcpy(b->c[i].mac, mac, sizeof(b->c[i].mac));
+		b->n++;
+	}
+	b->c[i].acked += acked; b->c[i].retry += retry; b->c[i].rate += rate; b->c[i].bw += bw;
+}
