 		unlink(PU_STATE);
-		return 0;	/* off, and nothing of ours on the air: not a single wl command */
+		mit_pass(up_s() + PU_WAIT);
+		return 0;	/* puncturing off and nothing of ours on the air: no puncturing wl command */
 	}
 
 	deadline = up_s() + PU_WAIT;
@@ -354,6 +528,7 @@ int reaper_punct_main(int argc, char *argv[])
 		fclose(f);
 		rename(PU_STATE ".tmp", PU_STATE);
 	}
+	mit_pass(deadline);
 	return 0;
 }
 
