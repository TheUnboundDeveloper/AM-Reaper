+/* v3.3.1: record the node a device hangs off. Only a well-formed MAC is kept,
+ * uppercased, so the value can go into the JSON unescaped. */
+static void rdev_set_via(struct rdev *d, const char *mac)
+{
+	char m[18];
+	int i;
+	if (!d || !mac || strlen(mac) != 17) return;
+	for (i = 0; i < 17; i++) m[i] = toupper((unsigned char)mac[i]);
+	m[17] = 0;
+	if (!gk_valid_mac(m)) return;
+	snprintf(d->via, sizeof(d->via), "%s", m);
+}
