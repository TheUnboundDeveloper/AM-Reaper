 		snprintf(key, sizeof(key), "wl%d_punct", u);
 		if (*nvram_safe_get(key))
 			want = 1;
+		snprintf(key, sizeof(key), "wl%d_rmit", u);	/* v3.3.1: the mitigation pass */
