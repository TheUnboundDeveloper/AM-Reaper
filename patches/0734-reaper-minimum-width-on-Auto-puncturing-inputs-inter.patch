+static int read_phy(struct radio *r)
+{
+	char cmd[128], line[256], cs[32];
+	int tx, inbss, obss, nocat, nopkt, doze, txop, goodtx, badtx, gl, bp, kn, idle, busy, ok = 0;
+	FILE *p;
+
+	snprintf(cmd, sizeof(cmd), "/usr/sbin/wl -i %s chanim_stats 2>/dev/null", r->ifn);
+	if ((p = popen(cmd, "r")) == NULL) return 0;
+	while (fgets(line, sizeof(line), p))
+		if (sscanf(line, "%31s %d %d %d %d %d %d %d %d %d %d %d %d %d %d", cs, &tx, &inbss, &obss, &nocat,
+			&nopkt, &doze, &txop, &goodtx, &badtx, &gl, &bp, &kn, &idle, &busy) == 15) { ok = 1; break; }
+	pclose(p);
+	if (ok && (gl < 0 || bp < 0 || gl > 1000000 || bp > 1000000)) ok = 0;
+	if (!ok) {
+		if (!r->phy_warned)
+			syslog(LOG_NOTICE, "rpunctd: %s PHY figures not readable from chanim_stats - the impairment trigger is idle", r->ifn);
+		r->phy_warned = 1; r->phy_ok = 0;
+		return 0;
+	}
+	if (kn > -20 || kn < -120) kn = 0;		/* not a noise figure: the noise term stays out */
+	r->phy_gl = gl; r->phy_bp = bp; r->phy_noise = kn;
+	/* r7: the noise term is the rise above this radio's own quiet baseline on this channel,
+	 * not above a fixed -95 dBm. The whole-channel figure grows with the width (metal: 6 GHz
+	 * at 320 MHz -79 dBm at rest, 5 GHz at 160 MHz -93), so a fixed floor read a clean wide
+	 * channel as ~50 % impaired. The baseline follows a quieter reading at once and a louder
+	 * one over about an hour, so a lasting change of environment becomes the new normal. */
+	r->phy_imp = impair_of(gl, bp, kn, noise_floor(&r->nbase_mdb, &r->nbase_ok, kn));
+	r->phy_ok = 1;
+	return 1;
+}
