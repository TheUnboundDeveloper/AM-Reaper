+/* the radio's own interface plus its client networks; -1 = a table this code does not understand */
+static int sta_read(struct radio *r, struct stasnap *sn, long now)
+{
+	char hdr[160] = "", vifs[128], word[32], *next;
+
+	sn->n = 0; sn->ok = 0; sn->has_td = 1; sn->at = now;
+	if (sta_read_if(r->ifn, sn, hdr, sizeof(hdr)) < 0) goto bad;
+	strlcpy(vifs, r->vifs, sizeof(vifs));
+	foreach (word, vifs, next)
