  */
 #include "rc.h"
 #include <signal.h>
@@ -215,6 +219,175 @@ static int set_bitmap(const char *ifn, unsigned int b)
 	return eval("wl", "-i", (char *)ifn, "eht", "dissubchan", hex);
 }
 
+/* ---- reaper v3.3.1: interference mitigation (wlN_rmit) ----
+ * The driver's receiver-side interference mitigation (`wl interference`, an
+ * ACPHY bit mask) is ON by default on every radio: mode 75 = glitch desense (1)
+ * + HW-ACI packet-gain limit (2) + preemption (8) + HW-OBSS (64), measured on
+ * the owner's RT-BE96U 2026-10-01. wlN_rmit = "hwaci" adds bit 16, HW-ACI
+ * mitigation, to whatever the driver runs; "" (Driver default) leaves the
+ * driver alone and issues no wl command at all. The mode takes effect live:
+ * no channel switch, no radio restart, clients kept (same metal trial, every
+ * band). Like the puncture pattern, only what this pass set is ever undone:
+ * the mode the driver ran before is kept in the state file and written back.
+ * State: "wlN if=<if> want=<w> base=<m> live=<m> set=<m> result=<r>",
+ * result applied | driver (it already runs it) | refused | waiting | off |
+ * error-read | skipped-*.
+ */
+#define MIT_STATE	"/tmp/reaper_wlmit.state"
+#define MIT_HWACI	16
+
+/* the live mode: `wl interference` prints "Mode = <n>. ..." after a blank line */
+static int live_mitmode(const char *ifn, int *out)
+{
+	char cmd[96], buf[160];
+	FILE *p;
+	int ok = -1;
+
+	snprintf(cmd, sizeof(cmd), "wl -i %s interference 2>/dev/null", ifn);
+	if ((p = popen(cmd, "r")) == NULL)
+		return -1;
+	while (fgets(buf, sizeof(buf), p))
+		if (ok < 0 && sscanf(buf, "Mode = %d", out) == 1)
+			ok = 0;
+	pclose(p);
+	return ok;
+}
+
+static int set_mitmode(const char *ifn, int m)
+{
+	char v[12];
+
+	snprintf(v, sizeof(v), "%d", m);
+	return eval("wl", "-i", (char *)ifn, "interference", v);
+}
+
+static void mit_state_read(int set[PU_MAXU], int base[PU_MAXU])
+{
+	FILE *f;
+	char line[256], *p;
+	int u;
+
+	for (u = 0; u < PU_MAXU; u++)
+		set[u] = base[u] = -1;
+	if ((f = fopen(MIT_STATE, "r")) == NULL)
+		return;
+	while (fgets(line, sizeof(line), f)) {
+		if (sscanf(line, "wl%d ", &u) != 1 || u < 0 || u >= PU_MAXU)
+			continue;
+		if ((p = strstr(line, " set=")) != NULL && p[5] != '-')
+			set[u] = atoi(p + 5);
+		if ((p = strstr(line, " base=")) != NULL && p[6] != '-')
+			base[u] = atoi(p + 6);
+	}
+	fclose(f);
+}
+
+static const char *num_or_dash(int v, char *buf, size_t len)
+{
+	if (v < 0)
+		return "-";
+	snprintf(buf, len, "%d", v);
+	return buf;
+}
+
+static void mit_pass(long deadline)
+{
+	int set[PU_MAXU], base[PU_MAXU], u, any = 0;
+	char out[PU_MAXU][192];
+	FILE *f;
+
+	mit_state_read(set, base);
+	for (u = 0; u < PU_MAXU; u++) {
+		char key[24];
+		snprintf(key, sizeof(key), "wl%d_rmit", u);
+		if (*nvram_safe_get(key) || set[u] >= 0)
+			any = 1;
+	}
+	if (!any) {
+		unlink(MIT_STATE);
+		return;		/* Driver default everywhere and nothing of ours on the air */
+	}
+	for (u = 0; u < PU_MAXU; u++) {
+		char key[24], ifn[IFNAMSIZ], want[16], b1[12], b2[12], b3[12];
+		const char *result = "off";
+		int live = -1, nset = set[u], nbase = base[u];
+
+		out[u][0] = 0;
+		snprintf(key, sizeof(key), "wl%d_ifname", u);
+		strlcpy(ifn, nvram_safe_get(key), sizeof(ifn));
+		if (!ifn[0])
+			continue;
+		if (!ifname_ok(ifn)) {
+			snprintf(out[u], sizeof(out[u]), "wl%d if=? want=- base=- live=- set=- result=skipped-ifname", u);
+			continue;
+		}
+		snprintf(key, sizeof(key), "wl%d_rmit", u);
+		strlcpy(want, nvram_safe_get(key), sizeof(want));
+		if (!want[0] && set[u] < 0)
+			continue;	/* Driver default and nothing of ours here: no line, no wl command */
+
+		snprintf(key, sizeof(key), "wl%d_radio", u);
+		if (want[0] && strcmp(want, "hwaci"))
+			result = "skipped-malformed";
+		else if (nvram_match(key, "0"))
+			result = "skipped-radio-off";
+		else {
+			while (!radio_ready(u, ifn) && up_s() < deadline)
+				sleep(2);
+			if (!radio_ready(u, ifn))
+				result = "waiting";
+			else if (live_mitmode(ifn, &live) < 0 || live < 0)
+				result = "error-read";
+			else if (want[0]) {
+				int target;
+				/* the base is the driver's own mode: the one recorded before our write,
+				 * unless the driver no longer carries our write (a wireless restart
+				 * reloads it), in which case what it runs now */
+				if (set[u] < 0 || live != set[u])
+					nbase = live;
+				target = nbase | MIT_HWACI;
+				if (target == nbase) {
+					result = "driver";	/* it already runs HW-ACI mitigation: nothing to do */
+					nset = -1;
+				} else if (live == target) {
+					result = "applied";
+					nset = target;
+				} else {
+					set_mitmode(ifn, target);
+					if (live_mitmode(ifn, &live) == 0 && live == target) {
+						result = "applied";
+						nset = target;
+						logmessage(PU_TAG, "%s: interference mitigation %d -> %d (hardware ACI mitigation added)", ifn, nbase, target);
+					} else {
+						result = "refused";
+						nset = -1;
+						logmessage(PU_TAG, "%s: the driver refused interference mitigation mode %d", ifn, target);
+					}
+				}
+			} else {
+				/* back to Driver default: undo only a write of ours the driver still carries */
+				if (live == set[u] && base[u] >= 0) {
+					set_mitmode(ifn, base[u]);
+					live_mitmode(ifn, &live);
+					logmessage(PU_TAG, "%s: interference mitigation back to the driver's mode %d", ifn, base[u]);
+				}
+				result = "off";
+				nset = nbase = -1;
+			}
+		}
+		snprintf(out[u], sizeof(out[u]), "wl%d if=%s want=%s base=%s live=%s set=%s result=%s",
+			u, ifn, want[0] ? want : "-", num_or_dash(nbase, b1, sizeof(b1)),
+			num_or_dash(live, b2, sizeof(b2)), num_or_dash(nset, b3, sizeof(b3)), result);
+	}
+	if ((f = fopen(MIT_STATE ".tmp", "w")) != NULL) {
+		for (u = 0; u < PU_MAXU; u++)
+			if (out[u][0])
+				fprintf(f, "%s\n", out[u]);
+		fclose(f);
+		rename(MIT_STATE ".tmp", MIT_STATE);
+	}
+}
+
 int reaper_punct_main(int argc, char *argv[])
 {
 	unsigned int prev[PU_MAXU];
