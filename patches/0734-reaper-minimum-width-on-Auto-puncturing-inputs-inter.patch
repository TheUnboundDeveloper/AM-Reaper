+  # v1.3.25: receiver interference mitigation and the driver's EDCRS_HI escape. The mode is a bit
+  # mask the driver runs by itself (75 on the owner's BE96U); wlN_rmit=hwaci adds 16 through the
+  # puncturing applier's mitigation pass. edcrs -1 = AUTO (by band and regulation); status 3 =
+  # events and an in-driver channel change are live (6 GHz) - an unexplained channel move can be it.
+  MMD="$(wl -i $IFN interference 2>/dev/null | sed -n 's/^Mode = \([0-9-]*\).*/\1/p' | head -1)"
+  MNV="$(nvram get wl${u}_rmit 2>/dev/null)"
+  MST="$(grep "^wl$u " /tmp/reaper_wlmit.state 2>/dev/null | sed 's/.* result=//')"
+  echo "     interference: mode=${MMD:-?}  setting=${MNV:-driver-default}  applier=${MST:--}  edcrs=$(wl -i $IFN edcrs_hi_event_mode 2>/dev/null)/$(wl -i $IFN edcrs_hi_event_status 2>/dev/null)  sr=$(wl -i $IFN sr_config options 2>/dev/null | awk '{print $2}')"
+  [ -n "$MNV" ] && case "$MST" in refused|waiting|skipped*|error*) finding INFO "interference mitigation is set on $IFN but not active (applier: $MST) - see 7";; esac
   # v1.3.20: static preamble puncturing (rc/reaper_punct.c) - the saved setting, what the
   # driver carries now, and the applier's last result. 5/6 GHz only (2.4 GHz cannot puncture).
   if [ "$NB" = 1 ] || [ "$NB" = 4 ]; then
@@ -538,6 +570,16 @@ u=0; while [ $u -le 3 ]; do
       echo "     dynamic puncturing: daemon=$DR  ${DL:-no state yet}"
       [ "$DR" = running ] || finding WARN "dynamic puncturing is set on $IFN but rpunctd is not running (rwatch restarts it within its tick) - see 7";;
     esac
+    # v1.3.25: minimum width on Auto (rc/reaper_bwfloor.c) - the switch, how many narrow
+    # chanspecs it excluded, and the watcher's line (armed / lifted after radar / inactive).
+    if [ "$(nvram get wl${u}_bwfloor 2>/dev/null)" = 1 ]; then
+      BFR="$(cat /tmp/reaper_bwfloor/wl$u.res 2>/dev/null)"
+      BFL="$(grep "^wl$u " /tmp/reaper_bwfloor/state 2>/dev/null | cut -c1-200)"
+      if pidof reaper_bwfloor >/dev/null 2>&1; then BFD=running; else BFD=NOT-running; fi
+      echo "     min width: on  excl=${BFR:--}  watcher=$BFD  ${BFL:-no state yet}"
+      case "$BFL" in *state=lifted*) finding INFO "the minimum width on $IFN is lifted (the radio could not hold it - radar or no wide channel); it re-arms by itself - see 7";; esac
+      [ "$BFD" = running ] || finding WARN "a minimum width is set on $IFN but reaper_bwfloor is not running (rwatch restarts it within its tick) - see 7"
+    fi
   fi
   S="$(nvram get wl${u}_ssid 2>/dev/null)"
   SL=${#S}
