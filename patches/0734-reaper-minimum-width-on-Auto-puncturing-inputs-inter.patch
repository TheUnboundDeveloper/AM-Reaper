+/* ---- v3.3.1 r6: the radio's own PHY figures on its operating channel ----
+ * `wl chanim_stats` prints the current chanspec's record: tx inbss obss nocat nopkt doze
+ * txop goodtx badtx glitch badplcp knoise idle busy (the format rchqd has parsed every
+ * 10 s since v1.6.4). Per the vendor header (chanim_stats_t), glitch and bad PLCP are
+ * normalized per-second counts and knoise is the background noise in dBm. Read after the
+ * timed window has closed, never while one is armed. */
+static int impair_of(int glitch, int badplcp, int knoise, int floor_dbm);
+
+/* r7: fold a noise reading into the baseline (milli-dB) and return the floor to measure it
+ * against: a quieter reading is taken at once, a louder one over RP_NBASE_TC ticks. kn == 0
+ * = no reading (the noise term stays out: the floor is then irrelevant). */
+static int noise_floor(long *base_mdb, int *ok, int kn)
+{
+	if (kn) {
+		long k = (long)kn * 1000;
+		if (!*ok || k < *base_mdb) { *base_mdb = k; *ok = 1; }
+		else *base_mdb += (k - *base_mdb) / RP_NBASE_TC;
+	}
+	return *ok ? (int)(*base_mdb / 1000) : kn;
+}
