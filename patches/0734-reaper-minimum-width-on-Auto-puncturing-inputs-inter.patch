-VER="REAPER-DIAG v1.3.24"
+VER="REAPER-DIAG v1.3.25"
 T0="$(date +%s 2>/dev/null)"
 MODEL="$(nvram get productid 2>/dev/null)"
 EXTNO="$(nvram get extendno 2>/dev/null)"
@@ -493,6 +493,29 @@ sec "6. IPV6"
 echo "  ipv6_service = $(nvram get ipv6_service 2>/dev/null)"
 V6="$(ifconfig br0 2>/dev/null | grep -c 'Scope:Global')"
 echo "  br0 global IPv6: $( [ "${V6:-0}" -gt 0 ] && echo "PRESENT x$V6 (redacted)" || echo none )"
+# v1.3.25: the LAN address mode and the IPv6 firewall switch (GT-BE98 field diag
+# 2026-10-01: "some devices get IPv6, some don't" could not be answered from here).
+# Stateful without SLAAC = clients lacking a DHCPv6 address client (Android, most IoT)
+# never get an address. Addresses are never printed - only the dnsmasq mode words.
+V6S="$(nvram get ipv6_service 2>/dev/null)"
+V6A="$(nvram get ipv6_autoconf_type 2>/dev/null)"
+V6F="$(nvram get ipv6_fw_enable 2>/dev/null)"
+case "$V6A" in 1) V6AN=stateful;; 0|"") V6AN=stateless;; *) V6AN="type $V6A";; esac
+echo "  ipv6_autoconf_type = ${V6A:-unset} ($V6AN)  ipv6_radvd = $(nvram get ipv6_radvd 2>/dev/null)  ipv6_dhcp_pd = $(nvram get ipv6_dhcp_pd 2>/dev/null)"
+V6R="$(grep '^dhcp-range=lan,.*:' /etc/dnsmasq.conf 2>/dev/null | head -1)"
+V6M=""
+for w in slaac ra-stateless ra-only ra-names ra-advrouter; do
+  case ",$V6R," in *,$w,*) V6M="$V6M $w";; esac
+done
+[ -n "$V6R" ] && [ -z "$V6M" ] && V6M=" dhcpv6-only (no SLAAC)"
+echo "  lan dhcpv6 range mode :${V6M:- none (no IPv6 range in dnsmasq.conf)}"
+V6L="$(grep -c '^[0-9]* [0-9]* [0-9a-fA-F:]*:' /var/lib/misc/dnsmasq.leases 2>/dev/null)"
+echo "  dhcpv6 leases          : ${V6L:-0}"
+echo "  ipv6_fw_enable = ${V6F:-unset}   ip6tables policy: $(ip6tables -S INPUT 2>/dev/null | head -1) / $(ip6tables -S FORWARD 2>/dev/null | head -1)"
+if [ -n "$V6S" ] && [ "$V6S" != disabled ]; then
+  [ "$V6F" = 1 ] || finding WARN "IPv6 is on ($V6S) and the IPv6 firewall is OFF - every LAN device with a global IPv6 address is reachable from the internet; Firewall > General > Enable IPv6 Firewall (see 6)"
+  case "$V6M" in *"no SLAAC"*) finding INFO "LAN IPv6 is DHCPv6-only (no SLAAC) - devices without a DHCPv6 client (Android, most IoT) get no IPv6 address; IPv6 > Auto Configuration Setting > Stateless fixes it (see 6)";; esac
+fi
 
 sec "7. WIRELESS (radios discovered at runtime)"
 # v1.3.24: the settings that explain overnight client drops (RT-BE88U field diag
@@ -521,6 +544,15 @@ u=0; while [ $u -le 3 ]; do
