+static void bucket_merge(struct sbucket *dst, const struct sbucket *src)
+{
+	int i;
+	for (i = 0; i < src->n; i++)
+		bucket_add(dst, src->c[i].mac, src->c[i].acked, src->c[i].retry, src->c[i].rate, src->c[i].bw);
