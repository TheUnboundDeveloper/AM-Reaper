From be42942a37ab19815a3f5dc09f4cb6140cfc8cd9 Mon Sep 17 00:00:00 2001
From: reaper <theunbounddeveloper@outlook.com>
Date: Thu, 1 Oct 2026 22:07:12 -0400
Subject: [PATCH] www: Tools_Sysinfo quad-band gates name the BQ16 (inert on
 every other model)

The ZenWiFi BQ16 orders its radios like the GT-BE98 (wl0 5 GHz-1, wl1 5 GHz-2,
wl2 6 GHz, wl3 2.4 GHz; rc/init.c MODEL_BQ16), so the three based_modelid gates
that remap client counts, temperatures and the driver-version rows for that
order take the BQ16 too. Lives in canon rather than only on the bq16 branch so
no future port can clobber it - the GT-BE98 lost the same gates that way once.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 release/src/router/www/Tools_Sysinfo.asp | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/release/src/router/www/Tools_Sysinfo.asp b/release/src/router/www/Tools_Sysinfo.asp
index 4d83840d5f..afbc9c2675 100644
--- a/release/src/router/www/Tools_Sysinfo.asp
+++ b/release/src/router/www/Tools_Sysinfo.asp
@@ -552,7 +552,7 @@ function update_temperatures(){
 			update_temperatures();
 		},
 		success: function(response){
-			if (based_modelid === 'GT-AXE16000' || based_modelid === 'GT-BE98') {
+			if (based_modelid === 'GT-AXE16000' || based_modelid === 'GT-BE98' || based_modelid === 'BQ16') {
 				curr_coreTmp_24_raw = curr_coreTmp_wl3_raw;
 				curr_coreTmp_5_raw = curr_coreTmp_wl0_raw;
 				curr_coreTmp_52_raw = curr_coreTmp_wl1_raw;
@@ -650,7 +650,7 @@ function showbootTime(){
 function show_connstate(){
 	document.getElementById("conn_td").innerHTML = conn_stats_arr[0] + " / <% sysinfo("conn.max"); %>&nbsp;&nbsp;-&nbsp;&nbsp;" + conn_stats_arr[1] + " active";
 
-	if (based_modelid === 'GT-AXE16000' || based_modelid === 'GT-BE98') {
+	if (based_modelid === 'GT-AXE16000' || based_modelid === 'GT-BE98' || based_modelid === 'BQ16') {
 		wlc_24_arr = wlc_3_arr;
 		wlc_51_arr = wlc_0_arr;
 		wlc_52_arr = wlc_1_arr;
@@ -743,7 +743,7 @@ function show_wifi_version() {
 		buf += "<br><% sysinfo("driver_version.1"); %>";
 	if (wl_info.band5g_2_support || wl_info.band6g_support)
 		buf += "<br><% sysinfo("driver_version.2"); %>";
-	if (based_modelid === 'GT-AXE16000' || based_modelid === 'GT-BE98' || based_modelid === 'GT-BE98_PRO')
+	if (based_modelid === 'GT-AXE16000' || based_modelid === 'GT-BE98' || based_modelid === 'GT-BE98_PRO' || based_modelid === 'BQ16')
 		buf += "<br><% sysinfo("driver_version.3"); %>";
 	buf += "</td>";
 
