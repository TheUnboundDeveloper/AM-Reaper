+.ntip{position:fixed;z-index:310;left:16px;top:60px;max-width:min(320px,calc(100vw - 32px));padding:10px 12px;
+  border:1px solid var(--line-soft);border-radius:10px;background:var(--panel);color:var(--bone-dim);
+  font-size:12px;line-height:1.5;box-shadow:0 8px 24px rgba(0,0,0,.55);overflow-wrap:anywhere;white-space:normal}
+.ntip[hidden]{display:none}
+.ntip .r{display:block}
+.ntip .r + .r{margin-top:4px}
