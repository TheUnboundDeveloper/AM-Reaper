+    return {up:ok(u), ip:ok(u) ? v['wan'+u+'_ipaddr'] : ''};
+  }
+  function wanUpPick(v, prim){ return wanPickIp(v, prim).up; }
+  /* ---- 2026-10-11: the Internet status tooltip, carried from Main_ReaperDash.asp ----
+     The amber LAN-names state (rc/rdnshc.c, nvram reaper_landns_state) and the tooltip
+     that explains it lived on the dashboard only; every other page is framed in this
+     shell, whose header had the pill but not the tooltip. Same box, same readings,
+     same colours, same open/close rules (hover for a mouse, focus or tap opens, a
+     click pins, Esc / tap elsewhere / scroll / resize close); the one addition is
+     that focus leaving for the framed page closes a pinned box, because a click
