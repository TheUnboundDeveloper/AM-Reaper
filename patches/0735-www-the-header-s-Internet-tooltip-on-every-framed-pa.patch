+     test_landns_check.py compares the shared functions verbatim. */
+  var OPNAMES={rt:`<#Reaper_c_opmode_rt#>`,ap:`<#Device_type_03_AP#>`,rp:`<#Clientlist_Repeater#>`,mb:`<#OP_MB_item#>`,ew2:`<#Reaper_c_opmode_ew#>`,ew5:`<#Reaper_c_opmode_ew#>`,hs:`<#Reaper_c_opmode_hs#>`,wisp:`<#Reaper_c_opmode_wisp#>`};
+  var OPMODE=[<% get_operation_mode(); %>][0];
+  var OPNAME=OPNAMES[OPMODE] || String(OPMODE||'').toUpperCase();
+  var ROUTING=!(OPMODE==='ap'||OPMODE==='rp'||OPMODE==='mb'||OPMODE==='ew2'||OPMODE==='ew5');
+  var WAN6 = <% wan_ipv6_network(); %>;   /* {status, Connection_Type, IPv6_Address, Link_Local_Address, IPv6_Gateway, DNS_Servers} */
+  var NET={v4:false, v6:false, ip:'', lan:'<% nvram_get("reaper_landns_state"); %>'};
+  var NT={
+    inet:`<#Internet#>`, conn:`<#Connected#>`, disc:`<#Disconnected#>`,
+    lan:`<#RDSH_91#>`, working:`<#RDSH_92#>`, failing:`<#RDSH_93#>`, unk:`<#RDSH_94#>`,
+    off:`<#RDSH_95#>`, held:`<#RDSH_96#>`, svc:`<#RDSH_97#>`, fail:`<#RDSH_98#>`,
+    silent:`<#RDSH_99#>`, dfail:`<#RDSH_100#>`, every:`<#RDSH_101#>`, noaddr:`<#RDSH_102#>`,
+    upall:`<#RDSH_103#>`
+  };
+  var TIP={el:null, open:null, pinned:false};
+  function v6Up(){
+    if(!(WAN6 && WAN6.status==='1')) return false;
+    var a=String((WAN6.IPv6_Address)||'').split('/')[0];
+    var gw=String((WAN6.IPv6_Gateway)||'');
+    return !!(a || gw);
+  }
+  function landnsGet(){
+    var p=String(NET.lan||'').split(' ');
+    return {st:p[0]||'', s:parseInt(p[1],10)||0, silent:(p[2] && p[2]!=='-') ? p[2] : ''};
+  }
+  function landnsBad(st){ return st==='fail' || st==='svc' || st==='dfail'; }
+  function durTxt(s){
+    if(s<60) return s+' s';
+    if(s<3600) return Math.floor(s/60)+' min';
+    if(s<86400) return Math.floor(s/3600)+' h '+Math.floor((s%3600)/60)+' min';
+    return Math.floor(s/86400)+' d '+Math.floor((s%86400)/3600)+' h';
+  }
+  /* Runs right after either WAN paint (first render, live poll). Amber only while
+     the WAN is up; otherwise it hands the inline colours back to the CSS so a
+     cleared warning does not linger. A WAN that is down was painted red by the
+     caller and is left alone. */
+  function netPaint(){
+    var any=NET.v4 || NET.v6, amber=any && landnsBad(landnsGet().st);
+    if(any){
+      ['p_wan_dot'].forEach(function(id){ var e=$id(id); if(!e) return;
+        e.style.background = amber ? 'var(--amber)' : ''; e.style.boxShadow = amber ? '0 0 0 3px rgba(224,169,59,.18)' : ''; });
+      ['p_wan'].forEach(function(id){ var e=$id(id); if(e) e.style.color = amber ? 'var(--amber)' : ''; });
+    }
+    if(TIP.open) tipFill();
+  }
+  function tipRow(cls, parts){
+    var r=document.createElement('span'); r.className='r'+(cls ? ' '+cls : '');
+    parts.forEach(function(p){ if(p===null || p===undefined || p==='') return; r.appendChild(typeof p==='string' ? document.createTextNode(p) : p); });
+    return r;
+  }
+  function tipB(t){ var b=document.createElement('b'); b.textContent=t; return b; }
+  function tipFill(){
+    var t=TIP.el; if(!t) return;
+    while(t.firstChild) t.removeChild(t.firstChild);
+    var any=NET.v4 || NET.v6, d=landnsGet(), st=d.st, line, cls='', why='';
+    t.appendChild(tipRow(any ? 'ok' : 'bad', [NT.inet+': ', tipB(any ? NT.conn : NT.disc),
+      any ? ((NET.v4 && NET.ip) ? ' ('+NET.ip+')' : (NET.v6 ? ' (IPv6)' : '')) : '']));
+    if(!any){ t.appendChild(tipRow('dim', [NT.noaddr])); return; }
+    if(landnsBad(st)){
+      line=NT.failing+' ('+durTxt(d.s)+')'; cls='warn';
+      why = (st==='svc') ? NT.svc : ((st==='dfail') ? NT.dfail : (d.silent ? NT.fail : NT.upall));
+    } else if(st==='ok'){ line=NT.working; cls='ok'; }
+    else if(st==='off') line=NT.off;
+    else if(st==='wan') line=NT.held;
+    else line=NT.unk;
+    t.appendChild(tipRow(cls, [NT.lan+': ', tipB(line)]));
+    if(why) t.appendChild(tipRow('', [why]));
+    if(landnsBad(st) && d.silent) t.appendChild(tipRow('', [NT.silent+' ', tipB(d.silent.split(',').join(', '))]));
+    if(st!=='off') t.appendChild(tipRow('dim', [NT.every]));
   }
-  var up=wanUpPick({wan0_state_t:'<% nvram_get("wan0_state_t"); %>', wan0_ipaddr:'<% nvram_get("wan0_ipaddr"); %>',
-                    wan1_state_t:'<% nvram_get("wan1_state_t"); %>', wan1_ipaddr:'<% nvram_get("wan1_ipaddr"); %>'},
-                   '<% get_wan_unit(); %>');
-  $t('p_wan', up?`<#Connected#>`:`<#Disconnected#>`);
-  var dot=$id('p_wan_dot'); if(dot && !up){ dot.style.background='#E10600'; dot.style.boxShadow='0 0 0 3px rgba(225,6,0,.15)'; }
+  function tipPlace(a){
+    var t=TIP.el, r=a.getBoundingClientRect(), w=t.offsetWidth, h=t.offsetHeight;
+    var vw=window.innerWidth, vh=window.innerHeight;
+    var left=Math.min(Math.max(16, r.left), Math.max(16, vw-16-w));
+    var top=r.bottom+8;
+    if(top+h > vh-8 && r.top-8-h >= 8) top=r.top-8-h;
+    t.style.left=left+'px'; t.style.top=top+'px';
+  }
+  function tipShow(a){ if(!TIP.el) return; tipFill(); TIP.el.hidden=false; TIP.open=a; tipPlace(a); }
+  function tipHide(){ if(!TIP.el) return; TIP.el.hidden=true; TIP.open=null; TIP.pinned=false; }
+  /* hover opens for a mouse only (a tap also fires pointerenter); focus opens for
+     the keyboard and for a tap; a click or tap pins it open, a second one closes */
+  function tipBind(id){
+    var a=$id(id); if(!a) return;
+    a.addEventListener('pointerenter', function(e){ if(e.pointerType==='mouse' && TIP.open!==a) tipShow(a); });
+    a.addEventListener('pointerleave', function(e){ if(e.pointerType==='mouse' && TIP.open===a && !TIP.pinned) tipHide(); });
+    a.addEventListener('focus', function(){ if(TIP.open!==a) tipShow(a); });
+    a.addEventListener('blur', function(){ if(TIP.open===a && !TIP.pinned) tipHide(); });
+    a.addEventListener('click', function(e){
+      e.stopPropagation();
+      if(TIP.open===a && TIP.pinned){ tipHide(); return; }
+      if(TIP.open!==a) tipShow(a);
+      TIP.pinned=true;
+    });
+    a.addEventListener('keydown', function(e){ if(e.key==='Enter' || e.key===' '){ e.preventDefault(); a.click(); } });
+  }
+  (function(){
+    TIP.el=$id('ntip');
+    var ids=['p_wan_pill'];
+    if(!ROUTING || !TIP.el){
+      /* no WAN to describe (AP / repeater / bridge): the pill is plain text again */
+      ids.forEach(function(id){ var a=$id(id); if(!a) return;
+        a.removeAttribute('tabindex'); a.removeAttribute('role'); a.removeAttribute('aria-describedby'); a.classList.remove('tipa'); });
+      return;
+    }
+    ids.forEach(tipBind);
+    document.addEventListener('click', function(e){ if(TIP.open && !TIP.el.contains(e.target)) tipHide(); });
+    document.addEventListener('keydown', function(e){ if(e.key==='Escape' && TIP.open) tipHide(); });
+    window.addEventListener('scroll', function(){ if(TIP.open) tipHide(); }, true);
+    window.addEventListener('resize', function(){ if(TIP.open) tipHide(); });
+    /* focus moving into the framed page: the top window blurs, the box closes */
+    window.addEventListener('blur', function(){ if(TIP.open) tipHide(); });
+  })();
+  /* One painter for the first render and the live poll: the word, the dot (jade
+     up / danger down - the dashboard's colours) and then netPaint() for the amber
+     state and the tooltip readings. Without a WAN of its own (AP / repeater /
+     bridge) the pill names the mode in a neutral colour, as the dashboard does,
+     instead of a structural "Disconnected" (wan0_state_t is 0 in those modes). */
+  function paintWan(p){
+    if(!ROUTING){
+      $t('p_wan', OPNAME);
+      var n=$id('p_wan_dot'); if(n){ n.style.background='var(--steel)'; n.style.boxShadow='none'; }
+      return true;
+    }
+    var v6=v6Up(), any=p.up||v6;
+    $t('p_wan', any?`<#Connected#>`:`<#Disconnected#>`);
+    var d=$id('p_wan_dot');
+    if(d){ if(any){ d.style.background=''; d.style.boxShadow=''; } else { d.style.background='var(--danger)'; d.style.boxShadow='none'; } }
+    NET.v4=p.up; NET.v6=v6; NET.ip=p.up ? p.ip : '';
+    netPaint();
+    return any;
+  }
+  paintWan(wanPickIp({wan0_state_t:'<% nvram_get("wan0_state_t"); %>', wan0_ipaddr:'<% nvram_get("wan0_ipaddr"); %>',
+                      wan1_state_t:'<% nvram_get("wan1_state_t"); %>', wan1_ipaddr:'<% nvram_get("wan1_ipaddr"); %>'},
+                     '<% get_wan_unit(); %>'));
