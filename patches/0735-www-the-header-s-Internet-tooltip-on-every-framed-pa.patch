-      if(d){ if(u){ d.style.background=''; d.style.boxShadow=''; } else { d.style.background='#E10600'; d.style.boxShadow='0 0 0 3px rgba(225,6,0,.15)'; } }
-      return u;
-    }
+    /* 2026-10-11: the poll paints through paintWan() too (one painter, see above) */
+    function apply(p){ return paintWan(p); }
     var timer=null;
     function schedule(ms){ if(timer) clearTimeout(timer); timer=setTimeout(tick, ms); }
     function tick(){
@@ -1074,11 +1232,14 @@ window.addEventListener("hashchange",function(){var p=(location.hash||"").replac
                /* wan_primary each poll, so a fail-over or fail-back while the
                   shell is open moves the pill to the live line */
                var pu=(j.wan_primary!==undefined && j.wan_primary!=='')?j.wan_primary:'<% get_wan_unit(); %>';
-               up=apply(wanUpPick(j, pu)); }catch(e){}
+               /* 2026-10-11: the tooltip's inputs ride the same request */
+               if(j.wan_ipv6_network && typeof j.wan_ipv6_network==='object') WAN6=j.wan_ipv6_network;
+               if(typeof j.reaper_landns_state==='string') NET.lan=j.reaper_landns_state;
+               up=apply(wanPickIp(j, pu)); }catch(e){}
         }
         schedule(up?SLOW:FAST);
       }
-      x.open('GET','/appGet.cgi?hook=nvram_get(wan_primary)%3bnvram_get(wan0_state_t)%3bnvram_get(wan0_ipaddr)%3bnvram_get(wan1_state_t)%3bnvram_get(wan1_ipaddr)&_='+(new Date()).getTime(),true);
+      x.open('GET','/appGet.cgi?hook=nvram_get(wan_primary)%3bnvram_get(wan0_state_t)%3bnvram_get(wan0_ipaddr)%3bnvram_get(wan1_state_t)%3bnvram_get(wan1_ipaddr)%3bnvram_get(reaper_landns_state)%3bwan_ipv6_network()&_='+(new Date()).getTime(),true);
       x.timeout=8000;
       x.onreadystatechange=function(){ if(x.readyState===4) fin(x.status===200); };
       x.onerror=x.ontimeout=x.onabort=function(){ fin(false); };
@@ -1086,10 +1247,8 @@ window.addEventListener("hashchange",function(){var p=(location.hash||"").replac
     }
     schedule(FAST);
   })();
-  /* operation mode */
-  var opNames={rt:`<#Reaper_c_opmode_rt#>`,ap:`<#Device_type_03_AP#>`,rp:`<#Clientlist_Repeater#>`,mb:`<#OP_MB_item#>`,ew2:`<#Reaper_c_opmode_ew#>`,ew5:`<#Reaper_c_opmode_ew#>`,hs:`<#Reaper_c_opmode_hs#>`,wisp:`<#Reaper_c_opmode_wisp#>`};
-  var op=[<% get_operation_mode(); %>][0];
-  $t('i_opmode', opNames[op]||String(op||'').toUpperCase());
+  /* operation mode (OPNAME is derived above, with the tooltip block) */
+  $t('i_opmode', OPNAME);
   /* uptime (client-side ticked) - robust parser mirrors Main_ReaperDash so a
      sub-24h or word-form sysuptime string still populates instead of showing "-" */
   function relSec(s){ var b=0; var dm=s.match(/(\d+)\s*d/i); if(dm)b+=(+dm[1])*86400; var cm=s.match(/(\d+):(\d{2})(?::(\d{2}))?/); if(cm){ b+=(+cm[1])*3600+(+cm[2])*60+(+(cm[3]||0)); return b; } function g(re){var m=s.match(re);return m?+m[1]:0;} return b+g(/(\d+)\s*h/i)*3600+g(/(\d+)\s*m(?!o)/i)*60+g(/(\d+)\s*s/i); }
