 <iframe name="hidden_frame" id="hidden_frame" style="display:none" title="hidden"></iframe>
 <form method="post" name="rebootForm" action="apply.cgi" target="hidden_frame">
   <input type="hidden" name="action_mode" value="reboot">
@@ -1029,27 +1050,164 @@ window.addEventListener("hashchange",function(){var p=(location.hash||"").replac
      load-balance either line being up means online. `v` carries
      wanN_state_t / wanN_ipaddr for both units. */
   var WANS_LB=('<% nvram_get("wans_mode"); %>'==='lb');
-  function wanUpPick(v, prim){
+  /* 2026-10-11: the picked unit's address too, for the tooltip's Internet line */
+  function wanPickIp(v, prim){
     function ok(u){ var st=v['wan'+u+'_state_t'], ip=v['wan'+u+'_ipaddr']; return st==='2' && !!ip && ip!=='0.0.0.0'; }
     var u=(String(prim)==='1')?1:0;
-    return ok(u) || (WANS_LB && ok(1-u));
