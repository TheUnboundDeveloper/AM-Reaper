+.ntip .ok b{color:var(--jade)} .ntip .warn b{color:var(--amber)} .ntip .bad b{color:var(--danger)}
+.ntip .dim{color:var(--steel)}
 /* Rail badge: the count of firewall promises that are NOT holding, carried on
