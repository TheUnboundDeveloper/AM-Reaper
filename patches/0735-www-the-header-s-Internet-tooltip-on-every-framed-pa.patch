    one page a user would have to already be on to learn it. Hidden entirely at
@@ -285,7 +303,7 @@ a.item .cnt{font-size:11px;color:var(--steel);margin-left:4px}
   <header class="top">
     <a class="brand" href="/Main_ReaperDash.asp" title="REAPER <#Reaper_c_dashboard#>"><img src="/images/RT-96U_REAPER_Header.png" alt="REAPER"></a>
     <div class="pills">
-      <div class="pill"><span class="dot" id="p_wan_dot"></span><span class="k"><#menu5_3#></span><span class="v" id="p_wan">&mdash;</span></div>
