diff --git a/release/src/router/rc/reaper_usbrel.c b/release/src/router/rc/reaper_usbrel.c
new file mode 100644
index 0000000000..119499164a
--- /dev/null
+++ b/release/src/router/rc/reaper_usbrel.c
@@ -0,0 +1,195 @@
+/*
+ * reaper_usbrel.c - release every USB volume before a firmware flash ejects it.
+ *
+ * reaper v3.3.2. Field report (RT-BE86U, Entware on a USB SSD, firmware upgraded
+ * from the GUI): every flash path ejects USB FIRST - httpd's upload handlers, the
+ * rc "upgrade" service and the update-check script all run `ejusb -1 0` before
+ * anything else is stopped. Stock's unmount stops only the NAS services and the
+ * ASUS apps, so whatever else holds a file on the volume keeps it busy: Entware's
+ * daemons (they stop from /jffs/scripts/services-stop, which only the normal
+ * reboot path runs), a dnsmasq writing its log under /opt, rtrafd with its
+ * history store on the stick. ejusb retries for ~40 s, falls back to a lazy
+ * detach, and the router flashes with the filesystem never cleanly unmounted - so
+ * the next boot mounts it late (journal replay, fsck) and anything started from
+ * /opt before that fails; on the reporter's box dnsmasq could not open its log
+ * and the LAN had no DNS.
+ *
+ * This applet runs just before ejusb in those paths and does what a reboot would
+ * have done first: the user's services-stop, rtrafd (it saves on SIGTERM), then a
+ * sweep for any process that still has a file, its working directory, its
+ * executable or a mapped library under /tmp/mnt/ - SIGTERM, a grace period,
+ * SIGKILL. The router is about to be flashed; nothing it stops is needed again.
+ * It is a no-op while no USB volume is mounted, and the GUI's own "eject" does
+ * NOT call it (that must not stop Entware). Runs more than once per flash
+ * (httpd's eject, then the upgrade service's): services-stop runs only the
+ * first time.
+ *
+ * The two helpers above reaper_usb_release_main() use libc only, so the test
+ * (build-scripts/tests/test_usb_flash_release.py) compiles them on the host and
+ * runs them against a real holder process.
+ */
+#include "rc.h"
+#include <dirent.h>
+#include <signal.h>
+#include <limits.h>
+
+/* 1 when the process is a zombie or gone (neither holds anything) */
+static int usbrel_gone(pid_t pid)
+{
+	char p[64], buf[512], *s;
+	FILE *f;
+	int gone = 1;
+
+	snprintf(p, sizeof(p), "/proc/%d/stat", (int)pid);
+	if ((f = fopen(p, "r")) == NULL)
+		return 1;
+	if (fgets(buf, sizeof(buf), f) && (s = strrchr(buf, ')')) != NULL && s[1] == ' ')
+		gone = (s[2] == 'Z' || s[2] == 'X');
+	fclose(f);
+	return gone;
+}
+
+/* 1 when pid has its cwd, root, executable, an open file or a mapping under prefix */
+static int usbrel_holds(pid_t pid, const char *prefix)
+{
+	static const char *links[] = { "cwd", "root", "exe" };
+	char p[64], fp[320], t[PATH_MAX], line[PATH_MAX + 128], *s;
+	size_t n = strlen(prefix);
+	struct dirent *e;
+	ssize_t r;
+	DIR *d;
+	FILE *f;
+	int i, hit = 0;
+
+	for (i = 0; i < 3 && !hit; i++) {
+		snprintf(p, sizeof(p), "/proc/%d/%s", (int)pid, links[i]);
+		if ((r = readlink(p, t, sizeof(t) - 1)) > 0) {
+			t[r] = '\0';
+			hit = !strncmp(t, prefix, n);
+		}
+	}
+	snprintf(p, sizeof(p), "/proc/%d/fd", (int)pid);
+	if (!hit && (d = opendir(p)) != NULL) {
+		while (!hit && (e = readdir(d)) != NULL) {
+			if (e->d_name[0] == '.')
+				continue;
+			snprintf(fp, sizeof(fp), "%s/%s", p, e->d_name);
+			if ((r = readlink(fp, t, sizeof(t) - 1)) > 0) {
+				t[r] = '\0';
+				hit = !strncmp(t, prefix, n);
+			}
+		}
+		closedir(d);
+	}
+	snprintf(p, sizeof(p), "/proc/%d/maps", (int)pid);
+	if (!hit && (f = fopen(p, "r")) != NULL) {
+		while (!hit && fgets(line, sizeof(line), f))
+			hit = ((s = strchr(line, '/')) != NULL && !strncmp(s, prefix, n));
+		fclose(f);
+	}
+	return hit;
+}
+
+/* Stop every process (but pid 1, this one and its parent) that holds anything
+ * under prefix: SIGTERM, up to grace_s seconds, then SIGKILL. Returns how many
+ * were found; *killed = how many needed SIGKILL; names = their comm, ' '-joined. */
+int reaper_kill_usb_holders(const char *prefix, int grace_s, char *names, size_t nsz, int *killed)
+{
+	pid_t self = getpid(), parent = getppid(), pid, pids[256];
+	char p[64], comm[32];
+	struct dirent *e;
+	int n = 0, i, alive, tick;
+	size_t len;
+	DIR *d;
+	FILE *f;
+
+	if (names && nsz)
+		names[0] = '\0';
+	if (killed)
+		*killed = 0;
+	if ((d = opendir("/proc")) == NULL)
+		return 0;
+	while ((e = readdir(d)) != NULL && n < (int)(sizeof(pids) / sizeof(pids[0]))) {
+		pid = (pid_t)strtol(e->d_name, NULL, 10);
+		if (pid <= 1 || pid == self || pid == parent || usbrel_gone(pid))
+			continue;
+		if (usbrel_holds(pid, prefix))
+			pids[n++] = pid;
+	}
+	closedir(d);
+
+	for (i = 0; i < n; i++) {
+		if (names && nsz) {
+			snprintf(p, sizeof(p), "/proc/%d/comm", (int)pids[i]);
+			comm[0] = '\0';
+			if ((f = fopen(p, "r")) != NULL) {
+				if (fgets(comm, sizeof(comm), f))
+					comm[strcspn(comm, "\n")] = '\0';
+				fclose(f);
+			}
+			len = strlen(names);
+			snprintf(names + len, nsz - len, "%s%s", len ? " " : "", comm[0] ? comm : "?");
+		}
+		kill(pids[i], SIGTERM);
+	}
+	for (tick = 0; tick < grace_s * 10; tick++) {
+		for (alive = 0, i = 0; i < n; i++)
+			if (pids[i] && !usbrel_gone(pids[i]))
+				alive++;
+			else
+				pids[i] = 0;
+		if (!alive)
+			break;
+		usleep(100000);
+	}
+	for (i = 0; i < n; i++)
+		if (pids[i] && !usbrel_gone(pids[i])) {
+			kill(pids[i], SIGKILL);
+			if (killed)
+				(*killed)++;
+		}
+	return n;
+}
+
+/* 1 when a filesystem is mounted under /tmp/mnt/ */
+static int usbrel_volume_mounted(void)
+{
+	char line[PATH_MAX + 128];
+	FILE *f;
+	int hit = 0;
+
+	if ((f = fopen("/proc/mounts", "r")) == NULL)
+		return 0;
+	while (!hit && fgets(line, sizeof(line), f))
+		hit = (strstr(line, " /tmp/mnt/") != NULL);
+	fclose(f);
+	return hit;
+}
+
+int reaper_usb_release_main(int argc, char *argv[])
+{
+	char names[256];
+	int n, killed = 0, first;
+
+	if (!usbrel_volume_mounted())
+		return 0;
+
+	/* watchdog's dnsmasq_check stands down while this exists: a dnsmasq it restarts
+	 * would reopen a log under /opt and hold the volume again. tmpfs - gone after
+	 * the reboot the flash ends in. */
+	first = !f_exists(REAPER_USBREL_FLAG);
+	f_write_string(REAPER_USBREL_FLAG, "1", 0, 0);
+
+	if (first) {
+		logmessage("reaper", "flash: releasing USB volumes before the eject");
+		run_custom_script("services-stop", 60, NULL, NULL);
+	}
+	stop_rtraf();
+
+	n = reaper_kill_usb_holders("/tmp/mnt/", 5, names, sizeof(names), &killed);
+	if (n)
+		logmessage("reaper", "flash: stopped %d process(es) still holding USB files: %s%s",
+			n, names, killed ? " (some needed SIGKILL)" : "");
+	sync();
+	return 0;
+}
