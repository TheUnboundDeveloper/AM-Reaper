+/* reaper v3.3.3: a `log-facility=/path` whose directory is missing or not writable
+ * makes dnsmasq exit "cannot open log" - and with it LAN DNS and DHCP. The usual way
+ * to get one is a dnsmasq.postconf pointing the log at a USB volume: the stock boot
+ * order loads the storage drivers (start_usb) AFTER start_services, so the volume is
+ * never there for the first start, and a disk that fails to enumerate keeps the
+ * resolver down for good. v3.3.3: `conf-file=/path` and `conf-dir=/dir[,...]` into
+ * the same volume die the same way ("cannot read", "cannot access directory",
+ * dnsmasq/src/option.c), so they are judged too. Rewrite `conf` without such lines.
+ * Returns the number dropped (0 = nothing to do, file untouched; -1 = could not read
+ * or write); `dropped` gets one "<kind> <path>\n" line per drop that fits (kind L =
+ * log, F = conf-file, D = conf-dir) - the watchdog reads it back. Only `/`-paths are
+ * judged: `-` (stderr) and syslog facility names pass through. libc only - host-tested
+ * (build-scripts/tests/test_usb_boot_mount.py). */
+static int reaper_logdir_unusable(const char *path)
+{
+	char dir[1024], *slash;
+	struct stat st;
+
+	strlcpy(dir, path, sizeof(dir));
+	if ((slash = strrchr(dir, '/')) == NULL)
+		return 0;
+	*slash = '\0';
+	if (!dir[0])
+		strcpy(dir, "/");
+	return stat(dir, &st) != 0 || !S_ISDIR(st.st_mode) || access(dir, W_OK) != 0;
+}
+
+/* 1 when dnsmasq would die on this dependency now. Shared with the watchdog
+ * (reaper_dnsmasq_logdrop_check) so both sides judge alike and a restart can
+ * never be followed by the same drop. */
+int reaper_dnsmasq_dep_missing(char kind, const char *path)
+{
+	struct stat st;
+
+	switch (kind) {
+	case 'L':
+		return reaper_logdir_unusable(path);
+	case 'F':
+		return access(path, R_OK) != 0;
+	case 'D':
+		return stat(path, &st) != 0 || !S_ISDIR(st.st_mode) || access(path, R_OK | X_OK) != 0;
+	}
+	return 0;
+}
+
+static int reaper_dnsmasq_log_guard(const char *conf, char *dropped, size_t dsz)
+{
+	static const struct { const char *key; char kind; } deps[] = {
+		{ "log-facility=/", 'L' }, { "conf-file=/", 'F' }, { "conf-dir=/", 'D' },
+	};
+	FILE *in, *out;
+	char tmp[128], line[1024], val[1024];
+	int n = 0, pass;
+	size_t i, used = 0;
+
+	if (dsz)
+		dropped[0] = '\0';
+	/* pass 0 counts, pass 1 rewrites - a conf with nothing to drop is not touched */
+	for (pass = 0; pass < 2; pass++) {
+		if ((in = fopen(conf, "r")) == NULL)
+			return -1;
+		out = NULL;
+		if (pass) {
+			snprintf(tmp, sizeof(tmp), "%s.rlg", conf);
+			if ((out = fopen(tmp, "w")) == NULL) {
+				fclose(in);
+				return -1;
+			}
+			fchmod(fileno(out), 0644);	/* rc runs umask 0 */
+		}
+		while (fgets(line, sizeof(line), in)) {
+			const char *v = line;
+			int drop = 0;
+			while (*v == ' ' || *v == '\t')
+				v++;
+			for (i = 0; i < sizeof(deps) / sizeof(deps[0]); i++) {
+				size_t kl = strlen(deps[i].key);
+				if (strncmp(v, deps[i].key, kl))
+					continue;
+				strlcpy(val, v + kl - 1, sizeof(val));
+				/* conf-dir=/dir,.bak,*.conf: the directory is the first field */
+				val[strcspn(val, deps[i].kind == 'D' ? ",\r\n" : "\r\n")] = '\0';
+				if (reaper_dnsmasq_dep_missing(deps[i].kind, val)) {
+					drop = 1;
+					if (!pass) {
+						int w = dsz > used ? snprintf(dropped + used, dsz - used, "%c %s\n", deps[i].kind, val) : -1;
+						if (w > 0 && (size_t)w < dsz - used)
+							used += w;
+						else if (dsz > used)
+							dropped[used] = '\0';	/* drop the partial line */
+						n++;
+					}
+				}
+				break;
+			}
+			if (drop)
+				continue;	/* drop the line */
+			if (out)
+				fputs(line, out);
+		}
+		fclose(in);
+		if (!pass && n == 0)
+			return 0;
+		if (out && (fclose(out) != 0 || rename(tmp, conf) != 0)) {
+			unlink(tmp);
+			return -1;
+		}
+	}
+	return n;
+}
