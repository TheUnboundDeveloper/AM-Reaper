diff --git a/release/src/router/rc/init.c b/release/src/router/rc/init.c
index e15b7bab02..4247ca117a 100644
--- a/release/src/router/rc/init.c
+++ b/release/src/router/rc/init.c
@@ -25932,6 +25932,17 @@ def_boot_reinit:
 	// autoreboot after kernel panic
 	f_write_string("/proc/sys/kernel/panic", "3", 0, 0);
 	f_write_string("/proc/sys/kernel/panic_on_oops", "3", 0, 0);
+	/* reaper v3.3.3: this kernel is built with BOOTPARAM_SOFTLOCKUP_PANIC=y, so a CPU
+	 * that does not schedule for 2 x watchdog_thresh (20 s) PANICS, and PANIC_TIMEOUT=5
+	 * reboots it with nothing kept (no pstore, no console on a shipped box). That turns
+	 * a long I/O stall - a 1 GB box doing swap I/O to a USB disk through the post-mount
+	 * boot storm, RT-BE86U field 2026-10-02 - into a reboot loop. Mainline defaults
+	 * this to 0: the stall logs "BUG: soft lockup" and the box carries on once the I/O
+	 * drains. A box that is truly hung is still reset - wdtd stops feeding the hardware
+	 * watchdog and it fires at 30 s. panic_on_oops above is unchanged.
+	 * v3.3.3: held at 0 only through boot and around USB mounts - rc/watchdog.c
+	 * puts the stock panic back once the box has settled (rc.h REAPER_SLP_*). */
+	f_write_string("/proc/sys/kernel/softlockup_panic", "0", 0, 0);
 
 	// be precise about vm commit
 #ifdef CONFIG_BCMWL5
@@ -26927,6 +26938,17 @@ int init_main(int argc, char *argv[])
 
 #ifdef RTCONFIG_DSL_TCLINUX
 			system("req_dsl_drv reboot &");
+#endif
+#ifdef RTCONFIG_USB
+			/* reaper v3.3.3: stop_services() starts services-stop in the background
+			 * and remove_storage_main(1) below then finds Entware still holding /opt -
+			 * busy retries, a lazy detach, a dirty volume on the next boot (field:
+			 * fine after a flash, failing after a GUI reboot). Release the volumes
+			 * first, synchronously, while every daemon is still up (rc/reaper_usbrel.c;
+			 * a no-op with nothing mounted). Reboot and halt only - SIGHUP restarts
+			 * services and keeps the volumes. */
+			if (state == SIGTERM /* REBOOT */ || state == SIGQUIT /* HALT */)
+				eval("/sbin/reaper_usb_release", "reboot");
 #endif
 			stop_services();
 
@@ -27151,7 +27173,18 @@ logmessage("ATE", "boot/continue fail= %d/%d\n", nvram_get_int("Ate_boot_fail"),
 #endif
 
 #ifdef CONFIG_BCMWL5
-			slabdbg();
+			/* reaper 2026-10-03: stock called the closed-source slabdbg() here on
+			   every boot - ~230 syslog lines tagged "dbg" (meminfo, free, the whole
+			   slabinfo, bpm status), a quarter of the 1 MB ring, with no gate inside
+			   rc/broadcom.o. It is a developer aid: keep it behind the stock "dbg"
+			   nvram flag that already gates the other debug prints (watchdog DST
+			   check, dump_ledtable). The one line logged when it IS enabled says
+			   where the dump comes from and is the rung marker for this gate.
+			   memleakdbg() stays on mem_chk_period. */
+			if (nvram_match("dbg", "1")) {
+				logmessage("dbg", "slabdbg: nvram dbg=1, dumping memory statistics");
+				slabdbg();
+			}
 			if (restore_defaults_g)
 			{
 				restore_defaults_g = 0;
diff --git a/release/src/router/rc/rc.h b/release/src/router/rc/rc.h
index 363ea08195..900a042f30 100644
--- a/release/src/router/rc/rc.h
+++ b/release/src/router/rc/rc.h
@@ -3007,6 +3007,26 @@ extern void start_reaper_fw(void);
  * start_wan, measured 2026-09-20) protected nothing. */
 #define REAPER_FW_BUILT_MARK	"/tmp/.reaper_firewall_built"
 #define REAPER_USBREL_FLAG	"/tmp/.reaper_usb_release"	/* v3.3.2: a flash is releasing the USB volumes; watchdog leaves dnsmasq alone */
+#define REAPER_DNSMASQ_LOGDROP_FLAG	"/tmp/.reaper_dnsmasq_logdrop"	/* v3.3.3: start_dnsmasq dropped a log-facility/conf-file/conf-dir that was missing; one "<kind> <path>" line each; watchdog restarts dnsmasq once one exists */
+extern int reaper_dnsmasq_dep_missing(char kind, const char *path);	/* rc/services.c */
+/* v3.3.3: the soft-lockup panic (kernel BOOTPARAM_SOFTLOCKUP_PANIC=y) is held at 0 by
+ * rc/init.c through boot and by rc/usb.c around every USB mount - the storm that
+ * followed a mount on a 1 GB box was a 20 s stall, and a panic there is a reboot loop
+ * with no trace. rc/watchdog.c arms it once the box has been up REAPER_SLP_FLOOR_SECS
+ * and no mount has been active for REAPER_SLP_GRACE_SECS. The stamp holds the uptime
+ * (seconds) of the last mount_partition entry or post-mount return. */
+#define REAPER_USB_MOUNT_STAMP	"/tmp/.reaper_usb_mount_at"
+#define REAPER_SLP_FLOOR_SECS	600
+#define REAPER_SLP_GRACE_SECS	300
+extern void reaper_usb_mount_stamp(void);	/* rc/usb.c */
+/* v3.3.3: the USB mount watchdog (rc/reaper_usbmon.c): re-sends a lost mount event,
+ * gives the volumes back after an aborted flash, re-enumerates a disk-less bus once. */
+#define REAPER_USB_MOUNTED_MARK	"/tmp/.reaper_usb_mounted_"	/* + partition: mounted at least once since boot - never retried (a GUI eject stays ejected) */
+#define REAPER_USB_RETRY_MARK	"/tmp/.reaper_usb_retry_"	/* + partition: mount events re-sent so far */
+#define REAPER_USB_RETRY_MAX	3
+extern void reaper_usbmon_check(void);
+extern void reaper_usb_mounted_mark(const char *part);
+extern int reaper_slp_should_arm(unsigned long up, unsigned long stamp, int have_stamp, unsigned long floor, unsigned long grace);	/* rc/watchdog.c, libc only */
 /* v2.6.2 shared REAPER_HOOK front chains (rc/reaper_hook.c) */
 extern void reaper_hook_gen(void);
 extern void reaper_fwsim_kick(int delay);
diff --git a/release/src/router/rc/reaper_usbmon.c b/release/src/router/rc/reaper_usbmon.c
new file mode 100644
index 0000000000..5a59fa0554
--- /dev/null
+++ b/release/src/router/rc/reaper_usbmon.c
@@ -0,0 +1,453 @@
+/*
+ * reaper_usbmon.c - the USB mount watchdog.
+ *
+ * reaper v3.3.3. Three holes the stock hotplug flow leaves open, found in the
+ * end-to-end review of the mount lifecycle (2026-10-02):
+ *
+ *  1. A partition's mount is asked for exactly once, by the kernel's add event.
+ *     If that one attempt fails (the device still held by a disk check, the EBUSY
+ *     wait exhausted, the event dropped because the action lock was busy) nothing
+ *     ever asks again; the volume stays unmounted until a replug. Stock re-sends
+ *     the events only on `rc restart`. This file re-sends the same block event, to
+ *     the same handler, for a partition that is attached, has NEVER been mounted
+ *     since boot (rc/usb.c marks every successful mount - so a volume the user
+ *     ejected from the GUI is never touched) and is not mounted now, while no
+ *     mount is in progress (the hotplug's usb lock is free). Three tries, 30 s
+ *     apart, within 30 min of boot or of the last mount activity.
+ *
+ *  2. A firmware flash releases and ejects the volumes first (rc/reaper_usbrel.c),
+ *     then httpd hands the image to rc. If rc never takes it (upgrade_rc("start")
+ *     fails three times) the box stays up with its volumes ejected, its release
+ *     flag set - so the watchdog's dnsmasq check stands down and stop_services()
+ *     skips services-stop - and nothing puts that right until a reboot. Here: a
+ *     flag older than 10 min with no image waiting gives the volumes back.
+ *
+ *  3. RT-BE96U and RT-BE86U have no USB power control (pwr_usb_gpio = 0xff), so
+ *     a UAS enclosure wedged by a crash reset is not power-cycled at boot and the
+ *     kernel may never see a disk at all (RT-BE86U field: two of five boots). Once,
+ *     10 min after boot, on a box that expects a volume (/jffs/scripts/post-mount
+ *     exists) and has no USB WAN: a storage-class USB device that produced no disk
+ *     is re-enumerated (authorized 0/1); no USB device at all and the xhci host
+ *     controller is unbound and bound again. Both are UNTESTED on metal and say so
+ *     in their log line - they run only when the USB subsystem is already useless.
+ *
+ * The helpers up to the "rc side" marker use libc only and are compiled on the
+ * host by build-scripts/tests/test_usb_late_mount.py against fake sysfs trees.
+ */
+#include "rc.h"
+#include <ctype.h>
+#include <dirent.h>
+#include <fcntl.h>
+#include <limits.h>
+
+/* ---- libc only, from here to the rc side (host-compiled by the test) ---- */
+
+static int usbmon_is_disk(const char *name)
+{
+	return name[0] == 's' && name[1] == 'd' && name[2] >= 'a' && name[2] <= 'z' && name[3] == '\0';
+}
+
+/* 1 when /dev/<name> is the device of a line in a /proc/mounts-shaped file */
+static int usbmon_mounted(const char *mounts, const char *name)
+{
+	char line[PATH_MAX + 128], dev[64], want[64];
+	FILE *f;
+	int hit = 0;
+
+	snprintf(want, sizeof(want), "/dev/%s", name);
+	if ((f = fopen(mounts, "r")) == NULL)
+		return 0;
+	while (!hit && fgets(line, sizeof(line), f))
+		if (sscanf(line, "%63s", dev) == 1 && !strcmp(dev, want))
+			hit = 1;
+	fclose(f);
+	return hit;
+}
+
+static void usbmon_consider(const char *mounts, const char *markprefix, const char *name,
+			    char *out, size_t nsz, size_t *used, int *n)
+{
+	char mark[PATH_MAX];
+	int w;
+
+	snprintf(mark, sizeof(mark), "%s%s", markprefix, name);
+	if (access(mark, F_OK) == 0 || usbmon_mounted(mounts, name))
+		return;
+	w = nsz > *used ? snprintf(out + *used, nsz - *used, "%s\n", name) : -1;
+	if (w > 0 && (size_t)w < nsz - *used)
+		*used += w;
+	else if (nsz > *used)
+		out[*used] = '\0';
+	(*n)++;
+}
+
+/* The sd* partitions under sysblock (the disk itself when it has none) that have
+ * never been mounted since boot - no <markprefix><name> file - and are not mounted
+ * now: one name per line into out. Returns how many; *ndisks = how many sd* disks
+ * exist at all. */
+int reaper_usbmon_candidates(const char *sysblock, const char *mounts, const char *markprefix,
+			     char *out, size_t nsz, int *ndisks)
+{
+	char path[PATH_MAX];
+	DIR *d, *dd;
+	struct dirent *e, *ee;
+	size_t used = 0, dl;
+	int n = 0, parts;
+
+	if (nsz)
+		out[0] = '\0';
+	*ndisks = 0;
+	if ((d = opendir(sysblock)) == NULL)
+		return 0;
+	while ((e = readdir(d)) != NULL) {
+		if (!usbmon_is_disk(e->d_name))
+			continue;
+		(*ndisks)++;
+		dl = strlen(e->d_name);
+		snprintf(path, sizeof(path), "%s/%s", sysblock, e->d_name);
+		parts = 0;
+		if ((dd = opendir(path)) != NULL) {
+			while ((ee = readdir(dd)) != NULL) {
+				if (strncmp(ee->d_name, e->d_name, dl) || !isdigit((unsigned char)ee->d_name[dl]))
+					continue;
+				parts++;
+				usbmon_consider(mounts, markprefix, ee->d_name, out, nsz, &used, &n);
+			}
+			closedir(dd);
+		}
+		if (!parts)
+			usbmon_consider(mounts, markprefix, e->d_name, out, nsz, &used, &n);
+	}
+	closedir(d);
+	return n;
+}
+
+/* The SCSI host a disk hangs off: the hostN element of <sysblock>/<disk>/device's
+ * link target. 1 with host set, 0 (host empty) when it cannot be told. */
+int reaper_usbmon_host_of(const char *sysblock, const char *disk, char *host, size_t hsz)
+{
+	char path[PATH_MAX], target[PATH_MAX], *p;
+	ssize_t len;
+
+	if (hsz)
+		host[0] = '\0';
+	snprintf(path, sizeof(path), "%s/%s/device", sysblock, disk);
+	if ((len = readlink(path, target, sizeof(target) - 1)) <= 0)
+		return 0;
+	target[len] = '\0';
+	for (p = target; (p = strstr(p, "/host")) != NULL; p++)
+		if (isdigit((unsigned char)p[5])) {
+			snprintf(host, hsz, "%d", atoi(p + 5));
+			return 1;
+		}
+	return 0;
+}
+
+/* The minor number of a partition (or of the disk when part == disk) from its
+ * sysfs dev file ("8:17"); -1 when unknown. */
+int reaper_usbmon_minor_of(const char *sysblock, const char *disk, const char *part)
+{
+	char path[PATH_MAX], buf[32];
+	int ma, mi = -1;
+	FILE *f;
+
+	if (strcmp(disk, part))
+		snprintf(path, sizeof(path), "%s/%s/%s/dev", sysblock, disk, part);
+	else
+		snprintf(path, sizeof(path), "%s/%s/dev", sysblock, disk);
+	if ((f = fopen(path, "r")) == NULL)
+		return -1;
+	if (!fgets(buf, sizeof(buf), f) || sscanf(buf, "%d:%d", &ma, &mi) != 2)
+		mi = -1;
+	fclose(f);
+	return mi;
+}
+
+/* a two-digit hex sysfs class file; -1 when absent */
+static int usbmon_read_hex(const char *path)
+{
+	char buf[16];
+	FILE *f;
+	long v;
+
+	if ((f = fopen(path, "r")) == NULL)
+		return -1;
+	v = fgets(buf, sizeof(buf), f) ? strtol(buf, NULL, 16) : -1;
+	fclose(f);
+	return (int)v;
+}
+
+/* What hangs off the USB bus, from a /sys/bus/usb/devices-shaped tree: 0 = nothing
+ * but root hubs and hubs, 1 = a storage-class interface (its device's name in dev),
+ * 2 = other devices only. */
+int reaper_usbmon_usb_state(const char *usbdevs, char *dev, size_t dsz)
+{
+	char path[PATH_MAX], *colon;
+	DIR *d;
+	struct dirent *e;
+	int storage = 0, other = 0, cls;
+	size_t l;
+
+	if (dsz)
+		dev[0] = '\0';
+	if ((d = opendir(usbdevs)) == NULL)
+		return 0;
+	while ((e = readdir(d)) != NULL) {
+		if (e->d_name[0] == '.' || !strncmp(e->d_name, "usb", 3))
+			continue;	/* . .. and the root hubs usbN */
+		if ((colon = strchr(e->d_name, ':')) != NULL) {	/* an interface, B-P:C.I */
+			snprintf(path, sizeof(path), "%s/%s/bInterfaceClass", usbdevs, e->d_name);
+			if (usbmon_read_hex(path) == 0x08 && !storage) {
+				storage = 1;
+				if (dsz) {
+					l = (size_t)(colon - e->d_name);
+					if (l >= dsz)
+						l = dsz - 1;
+					memcpy(dev, e->d_name, l);
+					dev[l] = '\0';
+				}
+			}
+			continue;
+		}
+		snprintf(path, sizeof(path), "%s/%s/bDeviceClass", usbdevs, e->d_name);
+		cls = usbmon_read_hex(path);
+		if (cls >= 0 && cls != 0x09)
+			other = 1;
+	}
+	closedir(d);
+	return storage ? 1 : (other ? 2 : 0);
+}
+
+/* 1 when a POSIX write lock is held on lockfile by anyone - the hotplug holds
+ * /var/lock/usb.lock (shared/files.c _file_lock, F_WRLCK) for a whole mount or
+ * unmount, so a busy lock means a mount IS in progress and no retry is wanted. */
+int reaper_usbmon_lock_busy(const char *lockfile)
+{
+	struct flock fl;
+	int fd, busy;
+
+	if ((fd = open(lockfile, O_RDONLY)) < 0)
+		return 0;
+	memset(&fl, 0, sizeof(fl));
+	fl.l_type = F_WRLCK;
+	fl.l_whence = SEEK_SET;
+	busy = fcntl(fd, F_GETLK, &fl) == 0 && fl.l_type != F_UNLCK;
+	close(fd);
+	return busy;
+}
+
+/* ---- rc side ---- */
+
+#define USBMON_EVERY_SECS	30	/* the check runs on the 1 s watchdog tick; acts this often */
+#define USBMON_WINDOW_SECS	1800	/* retries within this long of boot or of the last mount activity */
+#define USBMON_FLASH_WAIT_SECS	600	/* a release flag this old with no image waiting = an aborted flash */
+#define USBMON_RECOVER_AT_SECS	600	/* the no-disk recovery runs once, not before this uptime */
+
+/* rc/usb.c mount_partition(): this partition has been mounted at least once since
+ * boot. The retry never touches a marked partition - a GUI eject is the user's. */
+void reaper_usb_mounted_mark(const char *part)
+{
+	char p[128];
+
+	snprintf(p, sizeof(p), REAPER_USB_MOUNTED_MARK "%s", part);
+	f_write_string(p, "1", 0, 0);
+}
+
+static int usbmon_retry_count(const char *part, int bump)
+{
+	char p[128], buf[16];
+	int c = 0;
+
+	snprintf(p, sizeof(p), REAPER_USB_RETRY_MARK "%s", part);
+	if (f_read_string(p, buf, sizeof(buf)) > 0)
+		c = atoi(buf);
+	if (bump) {
+		snprintf(buf, sizeof(buf), "%d\n", c + 1);
+		f_write_string(p, buf, 0, 0);
+	}
+	return c;
+}
+
+/* 1 when the partition carries something mount_partition() would mount: not swap,
+ * not an EFI/unknown blob, not the partition table itself */
+static int usbmon_mountable(const char *part)
+{
+	char dev[64], label[128], uuid[40], *type = NULL;
+
+	snprintf(dev, sizeof(dev), "/dev/%s", part);
+	if (probe_fs(dev, &type, label, uuid) < 0 || type == NULL)
+		return 0;
+	return strcmp(type, "swap") && strcmp(type, "unknown") && strcmp(type, "mbr") && strcmp(type, "apple_efi");
+}
+
+/* The event hotplug2 delivered the first time, re-sent to the same handler
+ * (rc/usb.c hotplug_usb, the block branch) in the background: pre-mount, the
+ * EBUSY wait and post-mount can take minutes and the watchdog must not. */
+static void usbmon_resend_add(const char *part)
+{
+	char disk[32], host[16], minor[16];
+	char *argv[] = { "/sbin/hotplug", "block", NULL };
+	int pid, mi;
+	size_t l;
+
+	strlcpy(disk, part, sizeof(disk));
+	for (l = strlen(disk); l > 0 && isdigit((unsigned char)disk[l - 1]); l--)
+		disk[l - 1] = '\0';
+	if (!reaper_usbmon_host_of("/sys/block", disk, host, sizeof(host)))
+		strlcpy(host, "-1", sizeof(host));	/* hotplug_usb tolerates an unknown host */
+	mi = reaper_usbmon_minor_of("/sys/block", disk, part);
+	snprintf(minor, sizeof(minor), "%d", mi >= 0 ? mi : (strcmp(disk, part) ? 1 : 0));
+	setenv("SUBSYSTEM", "block", 1);
+	setenv("ACTION", "add", 1);
+	setenv("DEVICENAME", part, 1);
+	setenv("MAJOR", "8", 1);	/* SCSI disk */
+	setenv("MINOR", minor, 1);
+	setenv("SCSI_HOST", host, 1);
+	_eval(argv, NULL, 0, &pid);
+	unsetenv("SUBSYSTEM");
+	unsetenv("ACTION");
+	unsetenv("DEVICENAME");
+	unsetenv("MAJOR");
+	unsetenv("MINOR");
+	unsetenv("SCSI_HOST");
+}
+
+/* Hole 2: the release flag is set by a flash that then did not happen. */
+static void usbmon_aborted_flash_check(void)
+{
+	struct stat st;
+	long age;
+
+	if (stat(REAPER_USBREL_FLAG, &st) != 0)
+		return;
+	age = (long)(time(NULL) - st.st_mtime);
+	if (age < USBMON_FLASH_WAIT_SECS || f_exists("/tmp/linux.trx"))
+		return;
+	logmessage("reaper", "a firmware flash released the USB volumes %ld min ago and never happened - giving them back", age / 60);
+	unlink(REAPER_USBREL_FLAG);
+	start_rtraf();
+	add_remove_usbhost("-1", 1);	/* the remount stock runs on `rc restart` */
+}
+
+/* every device bound to an xhci platform driver: unbind, 1 s, bind. Names are
+ * collected first - unbinding edits the directory being read. */
+static int usbmon_xhci_rebind(void)
+{
+	char drv[PATH_MAX], p[PATH_MAX], names[8][64];
+	DIR *d, *dd;
+	struct dirent *e, *ee;
+	struct stat st;
+	int n = 0, k, i;
+
+	if ((d = opendir("/sys/bus/platform/drivers")) == NULL)
+		return 0;
+	while ((e = readdir(d)) != NULL) {
+		if (!strstr(e->d_name, "xhci"))
+			continue;
+		snprintf(drv, sizeof(drv), "/sys/bus/platform/drivers/%s", e->d_name);
+		if ((dd = opendir(drv)) == NULL)
+			continue;
+		for (k = 0; (ee = readdir(dd)) != NULL && k < 8; ) {
+			if (ee->d_name[0] == '.')
+				continue;
+			snprintf(p, sizeof(p), "%s/%s", drv, ee->d_name);
+			if (lstat(p, &st) != 0 || !S_ISLNK(st.st_mode))
+				continue;	/* bound devices are the symlinks; bind/unbind/uevent/module are not */
+			strlcpy(names[k++], ee->d_name, sizeof(names[0]));
+		}
+		closedir(dd);
+		for (i = 0; i < k; i++) {
+			snprintf(p, sizeof(p), "%s/unbind", drv);
+			f_write_string(p, names[i], 0, 0);
+			sleep(1);
+			snprintf(p, sizeof(p), "%s/bind", drv);
+			f_write_string(p, names[i], 0, 0);
+			n++;
+		}
+	}
+	closedir(d);
+	return n;
+}
+
+/* Hole 3: no disk at all on a box that expects one. Once per boot. */
+static void usbmon_recover_bus(void)
+{
+	char dev[32], path[PATH_MAX];
+	int n;
+
+	switch (reaper_usbmon_usb_state("/sys/bus/usb/devices", dev, sizeof(dev))) {
+	case 1:
+		logmessage("reaper", "USB device %s is a storage device the kernel never turned into a disk - re-enumerating it once (authorized 0/1). UNTESTED recovery: tell the maintainer whether the disk appeared", dev);
+		snprintf(path, sizeof(path), "/sys/bus/usb/devices/%s/authorized", dev);
+		f_write_string(path, "0", 0, 0);
+		sleep(1);
+		f_write_string(path, "1", 0, 0);
+		break;
+	case 0:
+		n = usbmon_xhci_rebind();
+		if (n)
+			logmessage("reaper", "no USB device at all on a box with a post-mount script - reset %d host controller(s) once (xhci unbind/bind). UNTESTED recovery: tell the maintainer whether the disk appeared", n);
+		else
+			logmessage("reaper", "no USB device at all on a box with a post-mount script, and no xhci platform driver to reset - power-cycle the disk");
+		break;
+	default:
+		logmessage("reaper", "no USB disk %d min after boot, but other USB devices are present - leaving the bus alone", USBMON_RECOVER_AT_SECS / 60);
+		break;
+	}
+}
+
+/* The watchdog's 1 s tick (rc/watchdog.c). */
+void reaper_usbmon_check(void)
+{
+	static unsigned long last = 0;
+	static int recovered = 0;
+	unsigned long up = (unsigned long)uptime(), stamp = 0;
+	char list[1024], buf[32], *p, *e;
+	int n, ndisks = 0, have_stamp = 0, in_window, c;
+
+	if (up - last < USBMON_EVERY_SECS)
+		return;
+	last = up;
+
+	usbmon_aborted_flash_check();
+	if (f_exists(REAPER_USBREL_FLAG))
+		return;	/* a flash is releasing the volumes - nothing is to be mounted now */
+	if (!nvram_get_int("usb_enable") || !nvram_get_int("usb_storage") || !nvram_get_int("usb_automount"))
+		return;
+	if (check_action() != ACT_IDLE)
+		return;
+
+	if (f_read_string(REAPER_USB_MOUNT_STAMP, buf, sizeof(buf)) > 0) {
+		stamp = strtoul(buf, NULL, 10);
+		have_stamp = 1;
+	}
+	n = reaper_usbmon_candidates("/sys/block", "/proc/mounts", REAPER_USB_MOUNTED_MARK, list, sizeof(list), &ndisks);
+
+	if (n > 0) {
+		/* hole 1 */
+		in_window = (up >= 120 && up <= USBMON_WINDOW_SECS)
+			 || (have_stamp && up > stamp && up - stamp >= 60 && up - stamp <= USBMON_WINDOW_SECS);
+		if (!in_window)
+			return;
+		if (reaper_usbmon_lock_busy("/var/lock/usb.lock"))
+			return;	/* a mount or unmount is running - that IS the attempt; wait */
+		for (p = list; *p && (e = strchr(p, '\n')) != NULL; p = e + 1) {
+			*e = '\0';
+			if ((c = usbmon_retry_count(p, 0)) >= REAPER_USB_RETRY_MAX || !usbmon_mountable(p))
+				continue;
+			usbmon_retry_count(p, 1);
+			logmessage("reaper", "USB %s is attached but not mounted (%lu s up) - sending its mount event again (try %d of %d)",
+				p, up, c + 1, REAPER_USB_RETRY_MAX);
+			usbmon_resend_add(p);
+			return;	/* one per tick; the next tick sees the lock busy while it runs */
+		}
+		return;
+	}
+
+	/* hole 3 */
+	if (ndisks == 0 && !recovered && up >= USBMON_RECOVER_AT_SECS
+	    && f_exists("/jffs/scripts/post-mount") && !strstr(nvram_safe_get("wans_dualwan"), "usb")) {
+		recovered = 1;
+		usbmon_recover_bus();
+	}
+}
