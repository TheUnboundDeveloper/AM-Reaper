+/* v3.3.3: the swap files under prefix, from a /proc/swaps-shaped file, one path
+ * per line into out (NUL-terminated, truncated at nsz). Returns how many. A swap
+ * file is the holder no process sweep can clear - umount() is EBUSY while it is
+ * active, and it survives shutdn()'s kill -1 - so a lazily detached volume with
+ * swap on it reboots dirty. The usual case is amtm's myswap.swp; its own swapoff
+ * runs from a user hook that can fail ENOMEM while Entware is still up. The
+ * caller swapoffs each one after the holders are gone (RAM freed). libc only. */
+static int usbrel_swaps_under(const char *swaps_file, const char *prefix, char *out, size_t nsz)
+{
+	char line[PATH_MAX + 128], path[PATH_MAX];
