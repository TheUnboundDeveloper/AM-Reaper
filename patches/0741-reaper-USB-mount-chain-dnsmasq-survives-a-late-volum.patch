+	if (f_read_string(REAPER_DNSMASQ_LOGDROP_FLAG, buf, sizeof(buf)) <= 0)
+		return;
+	for (p = buf; *p && !ready; p = e ? e + 1 : p + strlen(p)) {
+		if ((e = strchr(p, '\n')) != NULL)
+			*e = '\0';
+		if (p[0] && p[1] == ' ' && p[2] == '/' && !reaper_dnsmasq_dep_missing(p[0], p + 2))
+			ready = p + 2;
+	}
+	if (!ready)
+		return;
+	logmessage("reaper", "dnsmasq: %s is available now - restarting dnsmasq to pick it up", ready);
+	unlink(REAPER_DNSMASQ_LOGDROP_FLAG);
