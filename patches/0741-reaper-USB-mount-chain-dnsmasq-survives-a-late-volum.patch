+/* reaper v3.3.3: wait for `pid` - an _eval() child, so a session leader whose pgid is
+ * its pid - up to `timeout` s. At the cap TERM the whole group, give it `grace` s,
+ * then KILL what is left. kill(-pgid, 0) probes the group as a whole, so grandchildren
+ * we cannot waitpid() (an e2fsck the script ran) are covered; the leader is reaped as
+ * soon as it goes so a zombie does not hold the probe. 0 = exited in time (a child it
+ * left behind is left alone), 1 = timed out and the group was stopped. libc only -
+ * host-tested (build-scripts/tests/test_usb_boot_mount.py). */
+int reaper_wait_pgrp(pid_t pid, int timeout, int grace)
+{
+	int st, i, reaped = 0;
+	pid_t w;
+
+	for (i = 0; i < timeout * 10; i++) {
+		w = waitpid(pid, &st, WNOHANG);
+		if (w == pid || (w < 0 && errno == ECHILD))
+			return 0;
+		usleep(100000);
+	}
+	kill(-pid, SIGTERM);		/* e2fsck handles TERM: it cancels and exits cleanly */
+	for (i = 0; i < grace * 10; i++) {
+		if (!reaped && waitpid(pid, &st, WNOHANG) != 0)
+			reaped = 1;
+		if (kill(-pid, 0) != 0)
+			return 1;
+		usleep(100000);
+	}
+	kill(-pid, SIGKILL);
+	for (i = 0; i < 50; i++) {
+		if (!reaped && waitpid(pid, &st, WNOHANG) != 0)
+			reaped = 1;
+		if (kill(-pid, 0) != 0)
+			break;
+		usleep(100000);
+	}
+	return 1;
+}
+
+/* reaper v3.3.3: run_custom_script() whose cap stops the script and everything it
+ * started. Stock caps with alarm(timeout) in the child, which kills the SHELL only: a
+ * pre-mount still inside e2fsck (amtm's disk check waits for NTP first) left the check
+ * orphaned, holding the device open O_EXCL, so the mount that followed failed EBUSY
+ * and nothing retried it (RT-BE86U field, 2026-10-02). Only pre-mount uses this: a
+ * hook may legitimately leave daemons behind (post-mount starts Entware), a pre-mount
+ * by contract may not - the volume is not mounted yet. Returns 1 if it timed out. */
+int run_custom_script_bounded(char *name, int timeout, char *arg1, char *arg2)
+{
+	char script[120];
+	char *cmd[4];
+	int pid = 0;
+	struct stat st;
+
+	snprintf(script, sizeof(script), "/jffs/scripts/%s", name);
+	if (stat(script, &st) != 0)
+		return 0;
+	if (nvram_match("jffs2_scripts", "0") || !(st.st_mode & (S_IXUSR | S_IXGRP | S_IXOTH))) {
+		run_custom_script(name, timeout, arg1, arg2);	/* logs the refusal the stock way */
+		return 0;
+	}
+	logmessage("custom_script", "Running %s (args: %s%s%s)", script, arg1 ? arg1 : "", arg2 ? " " : "", arg2 ? arg2 : "");
+	cmd[0] = script;
+	cmd[1] = arg1;
+	cmd[2] = arg2;
+	cmd[3] = NULL;
+	if (_eval(cmd, NULL, 0, &pid) != 0 || pid <= 0)
+		return 0;
+	if (reaper_wait_pgrp(pid, timeout, 10)) {
+		logmessage("custom_script", "%s did not finish in %d s - stopped it and everything it started", script, timeout);
+		return 1;
+	}
+	return 0;
+}
