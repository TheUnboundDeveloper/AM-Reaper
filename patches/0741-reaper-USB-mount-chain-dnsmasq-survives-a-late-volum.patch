+/* reaper v3.3.3: when the soft-lockup panic may be on (rc.h). Pure, host-tested
+ * (build-scripts/tests/test_usb_boot_mount.py): never before `floor` seconds of
+ * uptime, never within `grace` seconds of USB mount activity, and a stamp from
+ * the future (a clock the watchdog cannot make sense of) counts as activity. */
+int reaper_slp_should_arm(unsigned long up, unsigned long stamp, int have_stamp, unsigned long floor, unsigned long grace)
+{
+	if (up < floor)
+		return 0;
+	if (have_stamp && (stamp > up || up - stamp < grace))
+		return 0;
+	return 1;
+}
+
+/* The arm/disarm itself. rc/init.c writes 0 at boot and rc/usb.c writes 0 at
+ * every mount, so the sysctl is already right when this first runs; `armed`
+ * tracks what WE last wrote, and a mount after the arm shows up as a fresh stamp
+ * that flips it back (the 0 was written by usb.c already - this just logs it). */
+static void reaper_softlockup_arm_check(void)
+{
+	static int armed = 0;
+	char buf[32];
+	unsigned long up = (unsigned long)uptime(), stamp = 0;
+	int have = 0, want;
+
+	if (f_read_string(REAPER_USB_MOUNT_STAMP, buf, sizeof(buf)) > 0) {
+		stamp = strtoul(buf, NULL, 10);
+		have = 1;
+	}
+	want = reaper_slp_should_arm(up, stamp, have, REAPER_SLP_FLOOR_SECS, REAPER_SLP_GRACE_SECS);
+	if (want == armed)
+		return;
+	f_write_string("/proc/sys/kernel/softlockup_panic", want ? "1" : "0", 0, 0);
+	armed = want;
+	if (want)
+		logmessage("reaper", "soft-lockup panic armed: up %lu s, no USB mount activity for %lu s (a CPU stuck 20 s now reboots the router)",
+			up, have ? up - stamp : up);
+	else
+		logmessage("reaper", "soft-lockup panic disarmed for a USB mount; re-arms %d s after it settles", REAPER_SLP_GRACE_SECS);
+}
