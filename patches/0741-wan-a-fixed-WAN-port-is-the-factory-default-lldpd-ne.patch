From ad41933d1d409d7a38821b08cde2b2b166cdb523 Mon Sep 17 00:00:00 2001
From: reaper <theunbounddeveloper@outlook.com>
Date: Tue, 13 Oct 2026 19:07:52 -0400
Subject: [PATCH] wan: a fixed WAN port is the factory default; lldpd never
 binds a WAN interface

Stock autowan_enable=1 (Auto) can only find the WAN by bridging every
candidate port into the LAN, so a new or factory-reset router joined its
ISP port to the LAN once at first setup (owner, 2026-10-12). The factory
default is now the port labelled WAN (wan_ifname_x) with Auto off; Auto
stays a choice on the WAN Ports page, and an upgraded router keeps its
stored value - a default reaches factory-reset / fresh nvram only.
gen_lldpd_if(): with a fixed port or Dual WAN, stock bound lldpd to every
candidate port, the ISP-facing one included (only the Auto-detected port
was skipped); in router mode a candidate that is a WAN interface is skipped
now, and an Auto search in progress keeps the stock behaviour.
rc/reaper_wanpin.c's header says the same. Lean: tests/test_factory_defaults_off.py.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 release/src/router/rc/reaper_wanpin.c |  6 ++++--
 release/src/router/rc/services.c      | 10 ++++++++++
 release/src/router/shared/defaults.c  |  7 ++++++-
 3 files changed, 20 insertions(+), 3 deletions(-)

diff --git a/release/src/router/rc/reaper_wanpin.c b/release/src/router/rc/reaper_wanpin.c
index 869af46ad69..7f3c0ab1c9b 100644
--- a/release/src/router/rc/reaper_wanpin.c
+++ b/release/src/router/rc/reaper_wanpin.c
@@ -30,8 +30,10 @@
  * Moving the ISP cable is a deliberate act: choose the port on the WAN page (that
  * turns auto-detection off, which clears the pin) or run Detect again
  * (`service start_reaper_wanredetect`), which clears the pin and runs stock detection once.
- * No user setting is changed: autowan_enable stays what the user set. A new or
- * factory-reset router still detects once, bridged, at first setup.
+ * No user setting is changed: autowan_enable stays what the user set. From v3.4.2 the
+ * factory default is a fixed WAN port (autowan_enable=0, wan_ifname_x = the port labelled
+ * WAN; owner, 2026-10-12), so a new or factory-reset router never runs the bridged search
+ * unless the user chooses Auto on the WAN Ports page. An upgraded router keeps its value.
  */
 #include "rc.h"
 
diff --git a/release/src/router/rc/services.c b/release/src/router/rc/services.c
index f3cd9de6734..27a5435e210 100644
--- a/release/src/router/rc/services.c
+++ b/release/src/router/rc/services.c
@@ -24430,6 +24430,16 @@ void gen_lldpd_if(char *bind_ifnames)
 					_dprintf("%s: skip binding interface %s for lldpd\n", __func__, word);
 					continue;
 				}
+				/* reaper v3.4.2: with a fixed WAN port (the factory default from v3.4.2) or
+				 * Dual WAN, stock bound lldpd to every candidate port, the ISP-facing one
+				 * included - only the Auto-detected port was skipped above. In router mode a
+				 * candidate that is a WAN interface is not a LAN port. An Auto search in
+				 * progress (state 1) keeps the stock behaviour. */
+				if(is_router_mode() && is_auto_wanport_enabled() != 1
+						&& find_in_list(nvram_safe_get("wan_ifnames"), word)){
+					_dprintf("%s: skip binding the fixed WAN %s for lldpd\n", __func__, word);
+					continue;
+				}
 
 				if (i == 0)
 					i = 1;
diff --git a/release/src/router/shared/defaults.c b/release/src/router/shared/defaults.c
index 42407182e11..470e25a2c64 100644
--- a/release/src/router/shared/defaults.c
+++ b/release/src/router/shared/defaults.c
@@ -7048,7 +7048,12 @@ struct nvram_tuple router_defaults[] = {
 	{ "s2s_oauth_linklist", "", CKN_STR4096, CKN_TYPE_DEFAULT, CKN_ACC_LEVEL_DEFAULT, CKN_ENC_DEFAULT, 0 },
 #endif
 #ifdef RTCONFIG_AUTO_WANPORT
-	{ "autowan_enable", "1", CKN_STR1, CKN_TYPE_DEFAULT, CKN_ACC_LEVEL_DEFAULT, CKN_ENC_DEFAULT, 0 },
+	/* reaper v3.4.2 (owner, 2026-10-12): stock "1" = Auto, which can only find the WAN by
+	 * bridging every candidate port into the LAN (rc/reaper_wanpin.c). The factory default
+	 * is now the fixed port in wan_ifname_x (the one labelled WAN); Auto stays a choice on
+	 * the WAN Ports page. A default reaches factory-reset / fresh nvram only - an upgraded
+	 * router keeps its stored value. */
+	{ "autowan_enable", "0", CKN_STR1, CKN_TYPE_DEFAULT, CKN_ACC_LEVEL_DEFAULT, CKN_ENC_DEFAULT, 0 },
 #endif
 	{"forget_it", "", CKN_STR_DEFAULT, CKN_TYPE_DEFAULT, CKN_ACC_LEVEL_DEFAULT, CKN_ENC_SVR, 0 },
 	{"app_mnt", "0", CKN_STR8, CKN_TYPE_DEFAULT, CKN_ACC_LEVEL_DEFAULT, CKN_ENC_DEFAULT, 0 },
-- 
