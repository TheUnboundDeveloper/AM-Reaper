+/* v3.3.3: the device store's merged snapshot, ONE collector for reaper_dev.cgi
+ * (action=status) and ej_get_clientlist() on a box that is not routing. Steps
+ * 1-7 were the body of the status action until v3.3.2 and are unchanged; the
+ * network resolve at the end is new. Cached because the client-list hook is
+ * polled every 10 s by several pages and the scan popen()s wl per VIF and brctl
+ * per bridge on a single-flight httpd; the status action always takes a fresh
+ * pass, as it did. */
+#define RDEV_TTL 10	/* s */
+static struct rdev rdev_tab[RDEV_MAX];
+static int rdev_tab_n = 0, rdev_tab_mlo = 0;
+static time_t rdev_tab_t = 0;
+
+static void rdev_collect(void)
+{
+	struct rdev *dev = rdev_tab;
+	static struct gk_seen seen[GK_SEEN_MAX];
+	int n = 0, ns, i, mlo_on;
+	char line[512];
+	FILE *f;
+	char *buf, *tok, *sp = NULL;
+
+	/* MLO fronthaul active? mld_enable is the master switch (same flag the
+	 * stock Wireless page reads); a non-empty mld{0,1,2}_ifnames means a
+	 * Multi-Link Device is actually formed. When on, a client's per-link
+	 * affiliated MACs each appear in a radio assoclist as a locally-
+	 * administered, lease-less station - NOT a separate device. */
+	mlo_on = (nvram_match("mld_enable", "1") &&
+	          (*nvram_safe_get("mld0_ifnames") || *nvram_safe_get("mld1_ifnames") ||
+	           *nvram_safe_get("mld2_ifnames"))) ? 1 : 0;
+
+	/* 1. DHCP leases: known devices (ip + self-reported host) */
+	f = fopen("/var/lib/misc/dnsmasq.leases", "r");
+	if (f) {
+		while (fgets(line, sizeof(line), f)) {
+			char mac[64], ip[64], host[64];
+			int idx;
+			/* fmt: <expiry> <mac> <ip> <host> <clientid> */
+			if (sscanf(line, "%*s %63s %63s %63s", mac, ip, host) < 2) continue;
+			idx = rdev_find(dev, &n, mac);
+			if (idx < 0) continue;
+			if (!dev[idx].ip[0]) snprintf(dev[idx].ip, sizeof(dev[0].ip), "%s", ip);
+			if (host[0] && strcmp(host, "*") && !dev[idx].host[0])
+				snprintf(dev[idx].host, sizeof(dev[0].host), "%s", host);
+		}
+		fclose(f);
+	}
+
+	/* 2. ARP: currently-talking devices on the LAN bridge (=> online) */
+	f = fopen("/proc/net/arp", "r");
+	if (f) {
+		char ip[64], hw[64], dif[32];
+		unsigned flags;
+		if (fgets(line, sizeof(line), f)) { /* header */ }
+		while (fgets(line, sizeof(line), f)) {
+			int idx;
+			if (sscanf(line, "%63s 0x%*x 0x%x %63s %*s %31s", ip, &flags, hw, dif) != 4)
+				continue;
+			if (!(flags & 2) || strncmp(dif, "br", 2)) continue;
+			idx = rdev_find(dev, &n, hw);
+			if (idx < 0) continue;
+			dev[idx].online = 1;
+			if (!dev[idx].ip[0]) snprintf(dev[idx].ip, sizeof(dev[0].ip), "%s", ip);
+		}
+		fclose(f);
+	}
+
+	/* 3. wireless assoclists (band + wifi + online) */
+	rdev_scan_wl(dev, &n, mlo_on);
+	/* bridge FDB is authoritative for wired/wireless + band (assoclist omits
+	 * some EHT/6GHz/pseudo-MLO stations, which used to read as "Wired"). */
+	rdev_scan_fdb(dev, &n);
+	/* AiMesh: a client associated to a NODE is in neither of the above -
+	 * the FDB places it on the backhaul port and it reads as Wired. Must
+	 * run after the FDB so it can correct that verdict, and before the
+	 * fallback below so it can pre-empt it. */
+	rdev_scan_amesh(dev, &n);
+	/* AiMesh NODES (the node device itself, not its clients): the cfg_mnt
+	 * table knows each node by LAN MAC and carries its uplink type
+	 * (re_path), so that verdict is authoritative and OVERRIDES the FDB
+	 * guess - a node reaches us over a backhaul interface that is neither
+	 * eth*- nor wl*-named (WDS/dpsta) and otherwise lands on the Wired
+	 * default below. See rdev_node_classify() for the 2026-08-19 miss. */
+	rdev_node_classify(dev, n);
+	/* last resort: an online device nothing above could place is Wired. */
+	for (i = 0; i < n; i++) {
+		if (!(dev[i].online && !dev[i].wifi && !dev[i].wired))
+			continue;
+		dev[i].wired = 1;
+	}
+	/* v3.3.1: a present device no mesh list placed behind a node hangs off
+	 * this router - the same default stock applies to an empty pap_mac
+	 * (client_function.js: amesh_papMac "" -> get_lan_hwaddr()). */
+	{
+		const char *self = get_lan_hwaddr();
+		for (i = 0; i < n; i++)
+			if (dev[i].online && !dev[i].via[0] && !dev[i].node)
+				rdev_set_via(&dev[i], self);
+	}
+
+	/* 4. dhcp_staticlist reservations: <MAC>IP>DNS>HOST */
+	buf = strdup(nvram_safe_get("dhcp_staticlist"));
+	if (buf) {
+		for (tok = strtok_r(buf, "<", &sp); tok; tok = strtok_r(NULL, "<", &sp)) {
+			char rmac[64], rip[64];
+			int idx;
+			rip[0] = 0;
+			if (sscanf(tok, "%63[^>]>%63[^>]", rmac, rip) < 1) continue;
+			idx = rdev_find(dev, &n, rmac);
+			if (idx < 0) continue;
+			dev[idx].resv = 1;
+			snprintf(dev[idx].resv_ip, sizeof(dev[0].resv_ip), "%s", rip);
+		}
+		free(buf);
+	}
+
+	/* 5. gk_rl access states (also surfaces offline gk-listed devices) */
+	buf = strdup(gk_rl_get());
+	sp = NULL;
+	if (buf) {
+		for (tok = strtok_r(buf, "<", &sp); tok; tok = strtok_r(NULL, "<", &sp)) {
+			char gmac[64];
+			int st = -1, idx; long exp = 0;
+			if (sscanf(tok, "%63[^>]>%d>%ld", gmac, &st, &exp) < 2) continue;
+			if (st < 0 || st > 3) continue;
+			idx = rdev_find(dev, &n, gmac);
+			if (idx < 0) continue;
+			dev[idx].gk_state = st;
+			dev[idx].gk_expiry = exp;
+		}
+		free(buf);
+	}
+
+	/* 6. seen.tsv enrichment (first/last/band/online) when gkd has it fresh */
+	ns = gk_load_seen(seen, GK_SEEN_MAX);
+	for (i = 0; i < ns; i++) {
+		int idx = rdev_find(dev, &n, seen[i].mac);
+		if (idx < 0) continue;
+		if (seen[i].online) dev[idx].online = 1;
+		if (seen[i].last > dev[idx].last) dev[idx].last = seen[i].last;
+		if (!dev[idx].band[0] && seen[i].band[0])
+			snprintf(dev[idx].band, sizeof(dev[0].band), "%s", seen[i].band);
+		if (!dev[idx].host[0] && seen[i].host[0])
+			snprintf(dev[idx].host, sizeof(dev[0].host), "%s", seen[i].host);
+		if (!dev[idx].ip[0] && seen[i].ip[0])
+			snprintf(dev[idx].ip, sizeof(dev[0].ip), "%s", seen[i].ip);
+	}
+
+	/* 7. v3.1.1: a host the lease file could not give - the announced hostname
+	 * (a device that lost a name clash reads "*" in the leases), then
+	 * networkmap's vendor label for a device that announces no name at all.
+	 * Same chain as the Gatekeeper page; the vendor case is flagged so the
+	 * page labels its source honestly. */
+	for (i = 0; i < n; i++) {
+		if (dev[i].host[0]) continue;
+		if (reaper_dhcpname_get(dev[i].mac, dev[i].host, sizeof(dev[0].host))) continue;
+		if (gk_nmp_name(dev[i].mac, dev[i].host, sizeof(dev[0].host)))
+			dev[i].host_vendor = 1;
+	}
+
+	/* v3.3.3: which network each present device is on (Network page cards) */
+	rdev_sdn_resolve(dev, n);
+	rdev_tab_n = n;
+	rdev_tab_mlo = mlo_on;
+	rdev_tab_t = time(NULL);
+}
+
+/* the snapshot, refreshed when older than max_age seconds (0 = always) */
+static void rdev_snapshot(int max_age)
+{
+	time_t now = time(NULL);
+	if (max_age <= 0 || !rdev_tab_t || now < rdev_tab_t || now - rdev_tab_t >= max_age)
+		rdev_collect();
+}
+
+/* a box that is not routing: AP, repeater, media bridge, a node (the dashboard
+ * tiles and the topology overlay gate on the same two routing modes) */
+static int rdev_nonrouting(void)
+{
+	int m = sw_mode();
+	return !(m == SW_MODE_ROUTER || m == SW_MODE_HOTSPOT);
+}
+
+/* does the hook's maclist already carry this MAC? */
+static int rdev_maclist_has(struct json_object *macArray, const char *mac)
+{
+	int i, cnt = json_object_array_length(macArray);
+	for (i = 0; i < cnt; i++) {
+		const char *s = json_object_get_string(json_object_array_get_idx(macArray, i));
+		if (s && !strcasecmp(s, mac)) return 1;
+	}
+	return 0;
+}
+
+/* v3.3.3: a box that is not routing has no DHCP leases or conntrack for
+ * networkmap to set isOnline from, so every stock client view fed by the
+ * get_clientlist hook - the Network page's cards and Clients tab, Parental
+ * Controls, the QoS pickers, the topology node card - read empty there (the
+ * GT-BE19000 tester's AP-mode reports). The dashboard tiles (v3.1.6) and the
+ * node card (v3.3.1) each grew an overlay from Reaper's device store; this is
+ * the same data at the hook, once, for all of them. A row networkmap did
+ * produce is kept and only marked present (ip / band / network / node filled
+ * where it left them blank); a device it does not know is added in its own
+ * shape with from = "reaper_dev". Nodes, backhaul stations and affiliated MLO
+ * links are not devices and are left out, as the Devices page leaves them. */
+static void rdev_merge_clientlist(struct json_object *clients, struct json_object *macArray)
+{
+	int i, u, nbtab[4];
+	const char *self;
+
+	if (!clients || !macArray) return;
+	rdev_snapshot(RDEV_TTL);
+	self = get_lan_hwaddr();
+	for (u = 0; u < 4; u++) {
+		char k[16];
+		snprintf(k, sizeof(k), "wl%d_nband", u);
+		nbtab[u] = nvram_get_int(k);
+	}
+
+	for (i = 0; i < rdev_tab_n; i++) {
+		struct rdev *d = &rdev_tab[i];
+		struct json_object *row = NULL, *o = NULL;
+		char iswl[4], sdn[8], uname[40], ssid_key[32];
+		const char *s;
+		int mlo_link, wl = 0;
+
+		if (!d->online || d->node || d->bh_sta) continue;
+		mlo_link = (rdev_tab_mlo && d->wifi && !d->ip[0] && !d->resv && rdev_is_rand(d->mac) && !d->mlo) ? 1 : 0;
+		if (mlo_link) continue;
+
+		/* isWL as networkmap spells it (client_function.js isWL_map): 0 wired,
+		 * 1 = 2.4 GHz, 2/3 = first/second 5 GHz radio, 4/5 = first/second 6 GHz */
+		if (d->wifi) {
+			int nb = (d->unit >= 0 && d->unit < 4) ? nbtab[d->unit] : 0, same = 0;
+			if (!nb) nb = !strcmp(d->band, "2.4") ? 2 : !strcmp(d->band, "5") ? 1 : !strcmp(d->band, "6") ? 4 : 0;
+			if (d->unit >= 0)
+				for (u = 0; u < d->unit && u < 4; u++)
+					if (nbtab[u] == nb) same++;
+			wl = (nb == 2) ? 1 : (nb == 1) ? 2 + (same ? 1 : 0) : (nb == 4) ? 4 + (same ? 1 : 0) : 0;
+		}
+		snprintf(iswl, sizeof(iswl), "%d", wl);
+		snprintf(sdn, sizeof(sdn), "%d", d->sdn < 0 ? 0 : d->sdn);
+
+		if (json_object_object_get_ex(clients, d->mac, &row) && row) {
+			/* networkmap knows the device: mark it present, fill what it left blank */
+			json_object_object_add(row, "isOnline", json_object_new_string("1"));
+			if (d->ip[0] && (!json_object_object_get_ex(row, "ip", &o) || !o || !(s = json_object_get_string(o)) ||
+			    !*s || !strcmp(s, "0.0.0.0") || !strcmp(s, "offline")))
+				json_object_object_add(row, "ip", json_object_new_string(d->ip));
+			if (wl && (!json_object_object_get_ex(row, "isWL", &o) || !o || !(s = json_object_get_string(o)) || !strcmp(s, "0")))
+				json_object_object_add(row, "isWL", json_object_new_string(iswl));
+			if (d->sdn >= 0 && (!json_object_object_get_ex(row, "sdn_idx", &o) || !o || !(s = json_object_get_string(o)) || !strcmp(s, "0")))
+				json_object_object_add(row, "sdn_idx", json_object_new_string(sdn));
+			if (d->via[0] && (!json_object_object_get_ex(row, "amesh_papMac", &o) || !o || !(s = json_object_get_string(o)) || !*s))
+				json_object_object_add(row, "amesh_papMac", json_object_new_string(d->via));
+			if (!rdev_maclist_has(macArray, d->mac))
+				json_object_array_add(macArray, json_object_new_string(d->mac));
+			continue;
+		}
+
+		row = json_object_new_object();
+		gk_client_name(d->mac, uname, sizeof(uname));
+		snprintf(ssid_key, sizeof(ssid_key), "%s_ssid", d->vif);
+		json_object_object_add(row, "sdn_idx", json_object_new_string(sdn));
+		json_object_object_add(row, "sdn_type", json_object_new_string(""));
+		json_object_object_add(row, "vlan_id", json_object_new_string("0"));
+		json_object_object_add(row, "mlo", json_object_new_string(d->mlo ? "1" : "0"));
+		json_object_object_add(row, "type", json_object_new_string("0"));
+		json_object_object_add(row, "defaultType", json_object_new_string("0"));
+		json_object_object_add(row, "name", json_object_new_string(d->host[0] ? d->host : ""));
+		json_object_object_add(row, "nickName", json_object_new_string(uname[0] ? uname : ""));
+		json_object_object_add(row, "ip", json_object_new_string(d->ip[0] ? d->ip : ""));
+		json_object_object_add(row, "mac", json_object_new_string(d->mac));
+		json_object_object_add(row, "from", json_object_new_string("reaper_dev"));
+		json_object_object_add(row, "macRepeat", json_object_new_string("1"));
+		json_object_object_add(row, "isGateway", json_object_new_string("0"));
+		json_object_object_add(row, "isASUS", json_object_new_string("0"));
+		json_object_object_add(row, "isWebServer", json_object_new_string("0"));
+		json_object_object_add(row, "isPrinter", json_object_new_string("0"));
+		json_object_object_add(row, "isITunes", json_object_new_string("0"));
+		json_object_object_add(row, "dpiType", json_object_new_string(""));
+		json_object_object_add(row, "dpiDevice", json_object_new_string(""));
+		json_object_object_add(row, "vendor", json_object_new_string(d->host_vendor ? d->host : ""));
+		json_object_object_add(row, "isWL", json_object_new_string(iswl));
+		json_object_object_add(row, "isGN", json_object_new_string(""));
+		json_object_object_add(row, "isOnline", json_object_new_string("1"));
+		json_object_object_add(row, "ssid", json_object_new_string(d->vif[0] ? nvram_safe_get(ssid_key) : ""));
+		json_object_object_add(row, "isLogin", json_object_new_string("0"));
+		json_object_object_add(row, "opMode", json_object_new_string("0"));
