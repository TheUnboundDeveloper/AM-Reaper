+/* reaper 2026-10-03 (perf audit P2): the collector used to run INLINE here -
+ * popen() drained to EOF inside the single-threaded httpd, so every diagnostic
+ * run froze the whole GUI, and the login page, for every admin for the length
+ * of the collection (tens of seconds; the lock allowed 180 s). The run is now
+ * a detached grandchild (the shape rwifi's sampler and the walker use) that
+ * writes its verdict to a state file; the page asks action=start, polls
+ * action=status every 2 s and fetches action=get. The CSRF gate, the lock and
+ * the /tmp/reaper_diag_ path contract are unchanged. */
+#define RDIAG_LOCK	"/tmp/.reaper_diag_busy"
+#define RDIAG_STATE	"/tmp/.reaper_diag_state"
+#define RDIAG_RECLAIM	180	/* s: a lock older than this is a dead worker's - start may reclaim it */
+#define RDIAG_RUNMAX	300	/* s: status stops answering RUNNING for a lock older than this */
+
+static void rdiag_worker(void)
+{
+	FILE *p, *f;
+	char line[256], path[128];
+
+	path[0] = '\0';
+	if ((p = popen("/usr/sbin/reaper_diag 2>/dev/null", "r")) != NULL) {
+		while (fgets(line, sizeof(line), p)) {
+			char *m = strstr(line, "written to: ");
+			if (m != NULL) {
+				snprintf(path, sizeof(path), "%s", m + 12);
+				m = strchr(path, '\n');
+				if (m != NULL)
+					*m = '\0';
+			}
+		}
+		pclose(p);
+	}
+	if ((f = fopen(RDIAG_STATE ".tmp", "w")) != NULL) {
+		if (path[0] != '\0')
+			fprintf(f, "OK %s\n", path);
+		else
+			fputs("ERR\n", f);
+		fclose(f);
+		rename(RDIAG_STATE ".tmp", RDIAG_STATE);
+	}
+	unlink(RDIAG_LOCK);
+}
