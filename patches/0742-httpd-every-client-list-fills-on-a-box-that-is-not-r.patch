+/* v3.3.3: give every present device a network: cfg_mnt's own answer (recorded by
+ * the mesh scan), else the VIF map, else the bridge the cable was learned on
+ * (recorded by the FDB scan), else the main fronthaul row - which is what a
+ * station the lists have not caught up with is on in practice. */
+static void rdev_sdn_resolve(struct rdev *v, int n)
+{
+	json_object *map;
+	MTLAN_T *pmtl;
+	size_t sz = 0;
+	int i, deflt = -1;
+
+	pmtl = (MTLAN_T *)INIT_MTLAN(sizeof(MTLAN_T));
+	if (pmtl) {
+		if (get_mtlan(pmtl, &sz)) deflt = rdev_sdn_of_bridge("br0", pmtl, sz);
+		FREE_MTLAN((void *)pmtl);
+	}
+	if (deflt < 0) deflt = 0;
+	map = json_object_from_file(APG_IFNAMES_USED_FILE);
+	for (i = 0; i < n; i++) {
+		if (!v[i].online || v[i].node) continue;
+		if (v[i].sdn < 0 && v[i].vif[0]) v[i].sdn = rdev_sdn_of_vif(map, v[i].vif);
+		if (v[i].sdn < 0) v[i].sdn = deflt;
+	}
+	if (map) json_object_put(map);
+}
