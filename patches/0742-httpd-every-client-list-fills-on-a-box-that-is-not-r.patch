+/* v3.3.3: br0 and every enabled SDN's own bridge (a guest or IoT VLAN's wired
+ * clients are learned there, not on br0). Was br0 only. */
+static void rdev_scan_fdb(struct rdev *v, int *n)
+{
+	MTLAN_T *pmtl;
+	size_t sz = 0, i, j;
+	char done[32][IFNAMSIZ];
+	int nd = 0;
+
+	pmtl = (MTLAN_T *)INIT_MTLAN(sizeof(MTLAN_T));
+	if (pmtl && !get_mtlan(pmtl, &sz)) sz = 0;
+	rdev_scan_fdb_br(v, n, "br0", rdev_sdn_of_bridge("br0", pmtl, sz));
+	snprintf(done[nd++], IFNAMSIZ, "%s", "br0");
+	for (i = 0; pmtl && i < sz && nd < 32; i++) {
+		const char *br = pmtl[i].nw_t.br_ifname;
+		int seen = 0;
+		if (!br[0] || !pmtl[i].enable) continue;
+		for (j = 0; j < (size_t)nd; j++)
+			if (!strcmp(done[j], br)) { seen = 1; break; }
+		if (seen) continue;
+		snprintf(done[nd++], IFNAMSIZ, "%s", br);
+		rdev_scan_fdb_br(v, n, br, rdev_sdn_of_bridge(br, pmtl, sz));
+	}
+	if (pmtl) FREE_MTLAN((void *)pmtl);
+}
