+	cnt = json_object_array_length(list);
+	for (i = 0; i < cnt && ret < 0; i++) {
+		json_object *ent = json_object_array_get_idx(list, i), *sidx = NULL, *bands = NULL;
+		int bc, b;
+		if (!ent || !json_object_is_type(ent, json_type_object)) continue;
+		if (!json_object_object_get_ex(ent, "sdn_idx", &sidx) || !sidx) continue;
+		if (!json_object_object_get_ex(ent, "sdn_band", &bands) || !bands ||
+		    !json_object_is_type(bands, json_type_array)) continue;
+		bc = json_object_array_length(bands);
+		for (b = 0; b < bc; b++) {
+			json_object *bo = json_object_array_get_idx(bands, b), *ifn = NULL;
+			const char *s;
+			if (!bo || !json_object_is_type(bo, json_type_object)) continue;
+			if (!json_object_object_get_ex(bo, "wl_ifname", &ifn) || !ifn ||
+			    !json_object_is_type(ifn, json_type_string)) continue;
+			s = json_object_get_string(ifn);
+			if (!s || strcmp(s, vif)) continue;
+			if (json_object_is_type(sidx, json_type_int))
+				ret = json_object_get_int(sidx);
+			else if (json_object_is_type(sidx, json_type_string) && json_object_get_string(sidx))
+				ret = atoi(json_object_get_string(sidx));
+			break;
+		}
+	}
+	return ret;
+}
+
+static int rdev_sdn_of_vif(json_object *root, const char *vif)
+{
+	json_object *used = NULL, *mine = NULL;
+	char self[18];
+	const char *h;
+	int i, ret = -1;
+
+	if (!root || !vif || !vif[0] || !json_object_is_type(root, json_type_object)) return -1;
+	if (!json_object_object_get_ex(root, "vif_used", &used) || !used ||
+	    !json_object_is_type(used, json_type_object)) return -1;
+	h = get_lan_hwaddr();
+	snprintf(self, sizeof(self), "%s", h ? h : "");
+	for (i = 0; self[i]; i++) self[i] = toupper((unsigned char)self[i]);
+	if (self[0] && json_object_object_get_ex(used, self, &mine) && mine)
+		ret = rdev_sdn_of_vif_in(mine, vif);
+	if (ret < 0) {
+		json_object_object_foreach(used, nodekey, nodelist) {
+			(void)nodekey;
+			if ((ret = rdev_sdn_of_vif_in(nodelist, vif)) >= 0) break;
+		}
+	}
+	return ret;
+}
