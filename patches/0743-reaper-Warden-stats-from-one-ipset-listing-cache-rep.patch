+	  "    ipset save $s 2>/dev/null | sed -n 's/ timeout [0-9]*$//; /^add /p' > " RFW_SETCACHE "/$s.tmp\n"
+	  "    # fqdn cache: rewrite only when changed\n"
+	  "    if cmp -s " RFW_SETCACHE "/$s.tmp " RFW_SETCACHE "/$s 2>/dev/null; then rm -f " RFW_SETCACHE "/$s.tmp; else mv " RFW_SETCACHE "/$s.tmp " RFW_SETCACHE "/$s; fi\n"
