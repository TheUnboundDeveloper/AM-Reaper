-/* Bound a child command in the SHELL. rtrafd is a single-threaded ~10 Hz
- * collector with no watchdog: poll_classes() forks seven `tmctl` every 4 s and
- * poll_probe() one `ping` every 5 s, and plain popen()/pclose() puts no ceiling
- * on either - pclose() blocks until the child exits, however long that takes.
- * `ping -W` bounds the REPLY wait, not name resolution, so with dnsmasq
- * restarting a hostname probe parks in the resolver for tens of seconds and the
- * whole collector - WAN sampling, live.json, history rollover - stops with it.
- * busybox has no `timeout` applet (rmcpd records the same) and popen() hands
- * back no pid to kill, so the ceiling goes inside the command: run it in the
- * background, arm a killer, take whichever finishes first.
- *
- * The watcher MUST NOT inherit the pipe (v2.8.6 field regression): a popen
- * reader gets EOF only when every holder of the write fd has closed it, and
- * the watcher subshell - and the sleep it forks, which `kill $_w` does not
- * reach - held a copy for the full timeout. So a tmctl that answered in
- * milliseconds still cost the caller `secs` seconds of fgets(): 7 queues x 3 s
- * every 4 s class poll froze the whole collector, live.json included, which
- * the page renders as flatlined metrics that lurch forward every ~20 s.
- * Redirecting the watcher to /dev/null before it forks is the entire fix;
- * measured in the popen harness: 3.008 s -> 0.005 s fast path, hung child
- * still killed at `secs`.
- *
- * v3.2.3 (measured 2026-09-20): `kill $_w` reached the watcher subshell but not
- * the `sleep` it had forked, so every fast-path query orphaned one sleep to
- * pid 1, and its exit `secs` later was a SIGCHLD wake of init - four full /proc
- * scans each (check_services) - seven times per 4 s class poll: half of what an
- * idle box burned in pid 1. The watcher now traps TERM and kills AND reaps its
- * own sleep, and the main shell reaps the watcher, so nothing reaches pid 1.
- * The sleep is forked before the trap is armed: a TERM in the microsecond gap
- * between the two strands that one sleep (the old behaviour, once); the other
- * order would have the trap kill an inherited, already-reaped pid instead.
- * Harness (busybox ash): a 50 ms command
- * returns in 52 ms with no sleep left behind (the old form left one per call);
- * a hung single command is still killed at `secs`. The long-term shape is still
- * fork+exec with a poll() deadline: one process per query, no shell. */
-static void rt_bound(char *out, size_t n, const char *cmd, int secs)
-{
-	snprintf(out, n,
-	         "{ %s; } & _c=$!; "
-	         "{ sleep %d & trap 'kill $! 2>/dev/null; wait $! 2>/dev/null; exit' TERM; wait $!; kill -9 $_c 2>/dev/null; } >/dev/null 2>&1 & _w=$!; "
-	         "wait $_c 2>/dev/null; kill $_w 2>/dev/null; wait $_w 2>/dev/null",
-	         cmd, secs);
+/* Run ONE command with a deadline and no shell. rtrafd is a single-threaded
+ * ~10 Hz collector with no watchdog: poll_classes() runs seven `tmctl` every
+ * 4 s and poll_probe() one `ping` every 5 s, and plain popen()/pclose() puts
+ * no ceiling on either - `ping -W` bounds the reply wait, not name resolution.
+ * Until 2026-10-03 the ceiling lived in a shell wrapper (rt_bound: the
+ * command, a watcher subshell and its sleep, wait on whichever finished
+ * first). It was correct after two field fixes - v2.8.6: the watcher must not
+ * inherit the pipe or the reader waits the full timeout; v3.2.3: the watcher
+ * must reap its own sleep or pid 1 pays four /proc scans per orphan - but it
+ * was four processes per query, and seven queries per 4 s under HW QoS made
+ * that ~7 forks/s, the largest Reaper-owned share of an idle box's churn. This
+ * is the shape those notes named as the long-term one: fork + exec, the
+ * child's stdout on a pipe, the parent poll()ing it against a CLOCK_MONOTONIC
+ * deadline, and a child that has not finished by then killed and reaped here.
+ * Output beyond the caller's buffer is drained and dropped (both callers read
+ * short key: value lines). Returns the byte count - 0 when nothing arrived
+ * (timeout, missing binary) - or -1 when the pipe or the fork itself failed. */
+static long rt_now_ms(void)
+{
+	struct timespec ts;
+	clock_gettime(CLOCK_MONOTONIC, &ts);
+	return ts.tv_sec * 1000L + ts.tv_nsec / 1000000L;
+}
+
+static ssize_t rt_exec_bounded(char *const argv[], char *out, size_t outsz, int secs)
+{
+	int pfd[2], status, timedout = 0;
+	pid_t pid;
+	size_t got = 0;
+	long deadline;
+
+	if (outsz == 0) return -1;
+	out[0] = '\0';
+	if (pipe(pfd) != 0) return -1;
+	pid = fork();
+	if (pid < 0) {
+		close(pfd[0]); close(pfd[1]);
+		return -1;
+	}
+	if (pid == 0) {
+		int fd;
+		close(pfd[0]);
+		dup2(pfd[1], 1);
+		if (pfd[1] != 1) close(pfd[1]);
+		fd = open("/dev/null", O_RDWR);
+		if (fd >= 0) {
+			dup2(fd, 0);
+			dup2(fd, 2);
+			if (fd > 2) close(fd);
+		}
+		execvp(argv[0], argv);
+		_exit(127);
+	}
+	close(pfd[1]);
+	deadline = rt_now_ms() + (long)secs * 1000L;
+	for (;;) {
+		struct pollfd pd;
+		long left = deadline - rt_now_ms();
+		ssize_t n;
+		int r;
+		if (left <= 0) { timedout = 1; break; }
+		pd.fd = pfd[0]; pd.events = POLLIN; pd.revents = 0;
+		r = poll(&pd, 1, (int)left);
+		if (r < 0) {
+			if (errno == EINTR) continue;
+			break;
+		}
+		if (r == 0) { timedout = 1; break; }
+		if (got + 1 < outsz) {
+			n = read(pfd[0], out + got, outsz - 1 - got);
+			if (n > 0) { got += (size_t)n; out[got] = '\0'; }
+		} else {
+			char sink[256];
+			n = read(pfd[0], sink, sizeof(sink));
+		}
+		if (n <= 0) break;	/* EOF: the child closed its end (or an error) */
+	}
+	close(pfd[0]);
+	/* EOF normally means the child is exiting; give it the rest of the
+	 * deadline, never an open-ended wait (a child that closed stdout and
+	 * kept running would otherwise park the whole collector). */
+	while (!timedout) {
+		pid_t w = waitpid(pid, &status, WNOHANG);
+		if (w == pid) return (ssize_t)got;
+		if (w < 0 && errno != EINTR) return (ssize_t)got;
+		if (rt_now_ms() >= deadline) { timedout = 1; break; }
+		usleep(10000);
+	}
+	syslog(LOG_WARNING, "rtrafd: %s did not answer in %d s - killed", argv[0], secs);
+	kill(pid, SIGKILL);
+	while (waitpid(pid, &status, 0) < 0 && errno == EINTR)
+		;
+	return (ssize_t)got;
 }
 
