+/* v3.3.3: seconds on the monotonic clock. The two store windows compared time(NULL)
+ * with a start time taken before NTP: the step (hours, or years on a box without an RTC)
+ * expired STORE_RETRY_SECS at once and a step past LATE_LOAD_SECS parked a merely
+ * late USB store's history as .prev. */
+static time_t mono_secs(void)
+{
+	struct timespec ts;
+	clock_gettime(CLOCK_MONOTONIC, &ts);
+	return ts.tv_sec;
+}
