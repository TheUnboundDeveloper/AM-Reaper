-.rows.two{display:grid;grid-template-columns:1fr 1fr;gap:10px}
+/* repeat(2,minmax(0,1fr)), not "1fr 1fr" (2026-10-03, field "cut off in Safari"):
+   a 1fr track is minmax(auto,1fr) and floors at its row's min-content, so the
+   longest nowrap .sub2 (Wi-Fi Encryption, 439 px with three radios) pinned the
+   first column and .card{overflow:hidden} cut the second column's tags on any
+   window under ~1500 px - 1440 is a 13" MacBook. Same mechanism as the topbar
+   (main{min-width:0}) and the shell's rail floor. */
+.rows.two{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}
 .srow{display:flex;align-items:center;justify-content:space-between;padding:11px 12px;border:1px solid var(--line-soft);border-radius:10px;background:rgba(255,255,255,.015);gap:10px}
 .srow .l{display:flex;align-items:center;gap:11px;min-width:0}
+/* the label wrapper is a flex item with min-width:auto: without this .sub2 can
+   never be narrower than its text and its ellipsis is decorative */
+.srow .l>div{min-width:0}
 .ico{width:30px;height:30px;border-radius:8px;display:grid;place-items:center;background:#000;border:1px solid var(--line);flex:0 0 30px}
 .ico svg{width:16px;height:16px;stroke:var(--crimson);fill:none;stroke-width:1.7}
 .srow .name{color:var(--bone);font-weight:500;font-size:13px}
 .srow .sub2{color:var(--steel);font-size:11px;margin-top:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
 .tag{font-family:var(--hdr);font-size:11px;letter-spacing:.08em;text-transform:uppercase;padding:5px 10px;border-radius:6px;font-weight:600;white-space:nowrap}
+.srow .tag{flex:0 0 auto}  /* the pill keeps its width; the label beside it truncates */
 .tag.ok{color:var(--jade);border:1px solid rgba(79,178,134,.35);background:rgba(79,178,134,.08)}
 .tag.warn{color:var(--amber);border:1px solid rgba(224,169,59,.35);background:rgba(224,169,59,.08)}
 .tag.danger{color:#fff;border:1px solid var(--danger);background:rgba(255,59,48,.18)}
