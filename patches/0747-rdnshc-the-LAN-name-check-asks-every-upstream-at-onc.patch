From a3f56a0f95610ee32fea74c88f08c318c50df4ae Mon Sep 17 00:00:00 2001
From: reaper <theunbounddeveloper@outlook.com>
Date: Tue, 13 Oct 2026 19:07:58 -0400
Subject: [PATCH] rdnshc: the LAN name check asks every upstream at once

The silent-upstream pass waited for each configured server in turn inside
the health check's loop: up to ~6 s a minute while the LAN check was
failing, slipping the resolver check's cadence. dns_build / dns_sockaddr /
dns_ask_many send one query per upstream and collect the answers in a
single wait of the same timeout; the silent list is unchanged. Lean:
tests/test_landns_check.py.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 release/src/router/rc/rdnshc.c | 144 +++++++++++++++++++++++++--------
 1 file changed, 111 insertions(+), 33 deletions(-)

diff --git a/release/src/router/rc/rdnshc.c b/release/src/router/rc/rdnshc.c
index 6687694a479..8957425351d 100644
--- a/release/src/router/rc/rdnshc.c
+++ b/release/src/router/rc/rdnshc.c
@@ -177,26 +177,18 @@ static void cfg_read(struct hc_cfg *c)
 	c->strict = nvram_get_int("reaper_dnshc_strict");
 }
 
-/* One UDP query for <name> A IN, sent straight to addr:port. Returns the
- * reply's RCODE (0-15) when a reply with our id came back, -1 for silence, an
- * error or a name that cannot be encoded; *ancount (may be NULL) gets the
- * answer count. 2026-10-10: lifted out of probe_addr() so the LAN name
- * resolution check below can ask dnsmasq and its upstreams the same way. */
-static int dns_ask(const char *addr, int af, int port, const char *name, int timeout_ms, int *ancount)
+/* The wire form of one query, <name> A IN with a fresh id: returns its length,
+ * or -1 for a name that cannot be encoded. 2026-10-13: lifted out of dns_ask()
+ * so dns_ask_many() builds the same packet. */
+static int dns_build(unsigned char *pkt, size_t plen, const char *name, unsigned short *idp)
 {
-	unsigned char pkt[512];
 	unsigned char *q;
 	const char *lab, *dot;
-	struct sockaddr_storage ss;
-	socklen_t slen;
-	struct timeval tv;
-	fd_set rf;
 	unsigned short id;
-	int fd, len, r, n, rc = -1;
+	int n;
 
-	if (ancount) *ancount = 0;
 	id = (unsigned short)((getpid() << 4) ^ (unsigned)now_s() ^ (unsigned)rand());
-	memset(pkt, 0, sizeof(pkt));
+	memset(pkt, 0, plen);
 	pkt[0] = id >> 8; pkt[1] = id & 0xff;
 	pkt[2] = 0x01;				/* RD */
 	pkt[5] = 1;				/* QDCOUNT */
@@ -205,7 +197,7 @@ static int dns_ask(const char *addr, int af, int port, const char *name, int tim
 	while (*lab) {
 		dot = strchr(lab, '.');
 		n = dot ? (int)(dot - lab) : (int)strlen(lab);
-		if (n <= 0 || n > 63 || (q - pkt) + n + 1 > (int)sizeof(pkt) - 8) return -1;
+		if (n <= 0 || n > 63 || (q - pkt) + n + 1 > (int)plen - 8) return -1;
 		*q++ = (unsigned char)n;
 		memcpy(q, lab, n);
 		q += n;
@@ -214,22 +206,48 @@ static int dns_ask(const char *addr, int af, int port, const char *name, int tim
 	*q++ = 0;
 	*q++ = 0; *q++ = 1;			/* QTYPE A */
 	*q++ = 0; *q++ = 1;			/* QCLASS IN */
-	len = (int)(q - pkt);
+	*idp = id;
+	return (int)(q - pkt);
+}
 
-	memset(&ss, 0, sizeof(ss));
+/* addr:port as a sockaddr for af; 0 when addr does not parse. */
+static int dns_sockaddr(struct sockaddr_storage *ss, socklen_t *slen, const char *addr, int af, int port)
+{
+	memset(ss, 0, sizeof(*ss));
 	if (af == AF_INET6) {
-		struct sockaddr_in6 *s6 = (struct sockaddr_in6 *)&ss;
+		struct sockaddr_in6 *s6 = (struct sockaddr_in6 *)ss;
 		s6->sin6_family = AF_INET6;
 		s6->sin6_port = htons(port);
-		if (inet_pton(AF_INET6, addr, &s6->sin6_addr) != 1) return -1;
-		slen = sizeof(*s6);
+		if (inet_pton(AF_INET6, addr, &s6->sin6_addr) != 1) return 0;
+		*slen = sizeof(*s6);
 	} else {
-		struct sockaddr_in *s4 = (struct sockaddr_in *)&ss;
+		struct sockaddr_in *s4 = (struct sockaddr_in *)ss;
 		s4->sin_family = AF_INET;
 		s4->sin_port = htons(port);
-		if (inet_pton(AF_INET, addr, &s4->sin_addr) != 1) return -1;
-		slen = sizeof(*s4);
+		if (inet_pton(AF_INET, addr, &s4->sin_addr) != 1) return 0;
+		*slen = sizeof(*s4);
 	}
+	return 1;
+}
+
+/* One UDP query for <name> A IN, sent straight to addr:port. Returns the
+ * reply's RCODE (0-15) when a reply with our id came back, -1 for silence, an
+ * error or a name that cannot be encoded; *ancount (may be NULL) gets the
+ * answer count. 2026-10-10: lifted out of probe_addr() so the LAN name
+ * resolution check below can ask dnsmasq and its upstreams the same way. */
+static int dns_ask(const char *addr, int af, int port, const char *name, int timeout_ms, int *ancount)
+{
+	unsigned char pkt[512];
+	struct sockaddr_storage ss;
+	socklen_t slen;
+	struct timeval tv;
+	fd_set rf;
+	unsigned short id;
+	int fd, len, r, rc = -1;
+
+	if (ancount) *ancount = 0;
+	if ((len = dns_build(pkt, sizeof(pkt), name, &id)) < 0) return -1;
+	if (!dns_sockaddr(&ss, &slen, addr, af, port)) return -1;
 
 	if ((fd = socket(af == AF_INET6 ? AF_INET6 : AF_INET, SOCK_DGRAM, 0)) < 0) return -1;
 	if (connect(fd, (struct sockaddr *)&ss, slen) < 0 || send(fd, pkt, len, 0) != len) {
@@ -440,7 +458,7 @@ static void state_set(const char *what, long since, int alive)
  * router's DNS for "localhost" (answered from /etc/hosts, nothing leaves the
  * box) and for a random name under reaper_landns_domain (or dns_probe_host);
  * the random label is what gets past dnsmasq's and unbound's caches. When the
- * fresh name fails it asks up to four upstreams directly, to name the silent
+ * fresh name fails it asks up to four upstreams at once, to name the silent
  * ones. Two bad checks in a row turn the state bad, one good one clears it.
  *
  * Status only: nothing is moved, nothing is reloaded, link_internet (WAN LEDs,
@@ -569,9 +587,65 @@ static int landns_dhcp_targets(char t[2][INET_ADDRSTRLEN])
 	return n;
 }
 
-/* Ask up to LDNS_UP_MAX plain upstreams of dnsmasq directly; list the ones
- * that do not resolve qname. The file is read under the resolv lock (the
- * health check rewrites it under the same lock), the probes run after. */
+/* 2026-10-13: the same question to n servers at once - one send each, one
+ * wait for all of them within timeout_ms - so naming the silent upstreams
+ * costs one round trip however many there are. It used to be n sequential
+ * waits inside the health check's loop (up to 6 s per failing minute, slipping
+ * that check's own cadence). ok[i] = 1 when server i answered with a resolving
+ * rcode (landns_rcode_ok); silence, an error or a refusing rcode leave 0. */
+static void dns_ask_many(int n, char addr[][INET6_ADDRSTRLEN], const int *fam, const int *port,
+			 const char *name, int timeout_ms, int *ok)
+{
+	unsigned char pkt[512];
+	unsigned short id[LDNS_UP_MAX];
+	int fd[LDNS_UP_MAX], pending = 0, i, r, maxfd;
+	struct timeval t0, now, tv;
+	fd_set rf;
+
+	for (i = 0; i < n; i++) {
+		struct sockaddr_storage ss;
+		socklen_t slen;
+		int len;
+		ok[i] = 0; fd[i] = -1;
+		if ((len = dns_build(pkt, sizeof(pkt), name, &id[i])) < 0) continue;
+		if (!dns_sockaddr(&ss, &slen, addr[i], fam[i], port[i])) continue;
+		if ((fd[i] = socket(fam[i] == AF_INET6 ? AF_INET6 : AF_INET, SOCK_DGRAM, 0)) < 0) continue;
+		if (connect(fd[i], (struct sockaddr *)&ss, slen) < 0 || send(fd[i], pkt, len, 0) != len) {
+			close(fd[i]); fd[i] = -1;
+			continue;
+		}
+		pending++;
+	}
+	gettimeofday(&t0, NULL);
+	while (pending > 0 && !g_stop) {
+		long left;
+		gettimeofday(&now, NULL);
+		left = timeout_ms - ((now.tv_sec - t0.tv_sec) * 1000 + (now.tv_usec - t0.tv_usec) / 1000);
+		if (left <= 0) break;
+		FD_ZERO(&rf); maxfd = -1;
+		for (i = 0; i < n; i++)
+			if (fd[i] >= 0) { FD_SET(fd[i], &rf); if (fd[i] > maxfd) maxfd = fd[i]; }
+		tv.tv_sec = left / 1000; tv.tv_usec = (left % 1000) * 1000;
+		r = select(maxfd + 1, &rf, NULL, NULL, &tv);
+		if (r < 0) { if (errno == EINTR) continue; break; }
+		if (r == 0) break;
+		for (i = 0; i < n; i++) {
+			if (fd[i] < 0 || !FD_ISSET(fd[i], &rf)) continue;
+			r = recv(fd[i], pkt, sizeof(pkt), 0);
+			if (r >= 12 && pkt[0] == (id[i] >> 8) && pkt[1] == (id[i] & 0xff) && (pkt[2] & 0x80))
+				ok[i] = landns_rcode_ok(pkt[3] & 0x0f);
+			else if (r >= 0)
+				continue;	/* a datagram that is not our reply: keep waiting */
+			close(fd[i]); fd[i] = -1; pending--;
+		}
+	}
+	for (i = 0; i < n; i++)
+		if (fd[i] >= 0) close(fd[i]);
+}
+
+/* Ask up to LDNS_UP_MAX plain upstreams of dnsmasq directly, all at once; list
+ * the ones that do not resolve qname. The file is read under the resolv lock
+ * (the health check rewrites it under the same lock), the probes run after. */
 static void landns_silent_upstreams(const char *qname, char *out, size_t len)
 {
 	char addr[LDNS_UP_MAX][INET6_ADDRSTRLEN], line[HC_LINE];
@@ -603,12 +677,16 @@ static void landns_silent_upstreams(const char *qname, char *out, size_t len)
 		fclose(fp);
 	}
 	file_unlock(lock);
-	for (i = 0; i < n && !g_stop; i++) {
-		char nm[INET6_ADDRSTRLEN + 8];
-		if (landns_rcode_ok(dns_ask(addr[i], fam[i], port[i], qname, LDNS_UP_MS, NULL))) continue;
-		if (port[i] != 53) snprintf(nm, sizeof(nm), "%s#%d", addr[i], port[i]);
-		else strlcpy(nm, addr[i], sizeof(nm));
-		landns_append(out, len, nm);
+	if (n > 0 && !g_stop) {
+		int ok[LDNS_UP_MAX];
+		dns_ask_many(n, addr, fam, port, qname, LDNS_UP_MS, ok);
+		for (i = 0; i < n; i++) {
+			char nm[INET6_ADDRSTRLEN + 8];
+			if (ok[i]) continue;
+			if (port[i] != 53) snprintf(nm, sizeof(nm), "%s#%d", addr[i], port[i]);
+			else strlcpy(nm, addr[i], sizeof(nm));
+			landns_append(out, len, nm);
+		}
 	}
 }
 
