+	  "  if grep -qsx -- \"$1\" \"$SKIP\"; then if grep -qsx -- \"$1 new\" \"$SKIPREC.old\" 2>/dev/null; then echo \"$1 new\" >> \"$SKIPREC\"; else echo \"$1 pre\" >> \"$SKIPREC\"; fi; return 0; fi\n"
 	  /* WG_NETWORK_TBL_SZ is 8 PER FAMILY, not 8 in total. Counting every line
