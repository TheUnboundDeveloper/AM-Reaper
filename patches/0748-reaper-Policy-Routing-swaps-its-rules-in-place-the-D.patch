 	   * handful of v6 entries from a WireGuard server's AllowedIPs could refuse
@@ -461,6 +478,7 @@ static int ppbr_gen(const char *path, int teardown_only, const ppbr_cfg_t *cfg)
 	int used_fc[16];             /* fail-closed for that code */
