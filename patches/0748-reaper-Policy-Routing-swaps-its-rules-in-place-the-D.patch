diff --git a/release/src/router/rc/lan.c b/release/src/router/rc/lan.c
index fff12d2781..0224a09404 100644
--- a/release/src/router/rc/lan.c
+++ b/release/src/router/rc/lan.c
@@ -3026,11 +3026,17 @@ void stop_lan(void)
 #endif
 					/* reaper: name each radio-off in syslog - these
 					 * are synchronous calls into the closed wl driver
-					 * and are the prime suspects for the reboot stall. */
-					logmessage("stop_lan", "wl radio off %s: begin (uptime %lu)", ifname, (unsigned long)uptime());
+					 * and are the prime suspects for the reboot stall.
+					 * Wireless names only (2026-10-04): stock runs the two
+					 * commands on every lan_ifnames entry and they fail
+					 * silently on an Ethernet port, so eth1-eth4 logged a
+					 * radio-off they never had. */
+					if (strncmp(ifname, "wl", 2) == 0)
+						logmessage("stop_lan", "wl radio off %s: begin (uptime %lu)", ifname, (unsigned long)uptime());
 					eval("wlconf", ifname, "down");
 					eval("wl", "-i", ifname, "radio", "off");
-					logmessage("stop_lan", "wl radio off %s: done (uptime %lu)", ifname, (unsigned long)uptime());
+					if (strncmp(ifname, "wl", 2) == 0)
+						logmessage("stop_lan", "wl radio off %s: done (uptime %lu)", ifname, (unsigned long)uptime());
 				}
 				ifconfig(ifname, 0, NULL, NULL);
 #elif defined RTCONFIG_RALINK
diff --git a/release/src/router/rc/ntpd.c b/release/src/router/rc/ntpd.c
index 7881d9bbba..5c5888b14d 100644
--- a/release/src/router/rc/ntpd.c
+++ b/release/src/router/rc/ntpd.c
@@ -20,6 +20,7 @@
  */
 
 #include <string.h>
+#include <stdlib.h>
 #include <rc.h>
 #include <bcmnvram.h>
 #include <shutils.h>
@@ -92,9 +93,28 @@ int ntpd_synced_main(int argc, char *argv[])
 		logmessage("ntpd", "Unable to reach ntp server so far, keep trying");
 #endif
 
-	if (!nvram_match("ntp_ready", "1") && (argc == 2 && !strcmp(argv[1], "step"))) {
+	/* reaper 2026-10-04 (RT-BE86U field, two diags): busybox ntpd runs this hook
+	 * with "step" only after it STEPPED the clock (STEP_THRESHOLD is 1 s in this
+	 * tree). A clock that is already within a second when the first reply comes
+	 * - amtm RouterDate sets it from an HTTPS Date header early in boot - is
+	 * slewed instead, the hook saw only "stratum" and "periodic", and ntp_ready
+	 * stayed 0 for 36+ minutes with WireGuard, OpenVPN, diskmon, ddns and every
+	 * add-on NTP wait behind it, while the clock itself was right. The first good
+	 * reply raises "stratum" (16 -> the peer's + 1) and busybox exports the
+	 * stratum in the environment, so a stratum below 16 on "stratum" or
+	 * "periodic" is the same fact as a step: the clock is synchronised. */
+	const char *ev = (argc == 2 && argv[1]) ? argv[1] : "";
+	const char *st = getenv("stratum");
+	int stratum = st ? atoi(st) : 0;
+	int synced = !strcmp(ev, "step") ||
+		((!strcmp(ev, "stratum") || !strcmp(ev, "periodic")) && stratum > 0 && stratum < 16);
+
+	if (!nvram_match("ntp_ready", "1") && synced) {
 		nvram_set("ntp_ready", "1");
-		logmessage("ntpd", "Initial clock set");
+		if (!strcmp(ev, "step"))
+			logmessage("ntpd", "Initial clock set");
+		else
+			logmessage("ntpd", "Initial clock set (slewed: the clock was already within a second of the server; stratum %d on the %s event)", stratum, ev);
 /* Code from ntpclient */
 		now = time( (time_t*) 0 );
 		nvram_set_int("ntp_diff_ts", now-bf_time);
diff --git a/release/src/router/rc/rdnshc.c b/release/src/router/rc/rdnshc.c
index f0abb3433f..d0bfda769a 100644
--- a/release/src/router/rc/rdnshc.c
+++ b/release/src/router/rc/rdnshc.c
@@ -377,6 +377,7 @@ int rdnshc_main(int argc, char *argv[])
 	struct hc_cfg c;
 	char watched[INET6_ADDRSTRLEN] = "";
 	int down = 0, misses = 0, hits = 0, last_enabled = -1, i, alive = -1, v6_warned = 0;
+	int uplink_down = 0, held = 0;	/* v3.3.4: misses are not counted while the WAN is known down */
 	int last_fam = 0, v6skip_warned = 0;
 	long since = 0;
 	(void)argc; (void)argv;
@@ -467,8 +468,28 @@ int rdnshc_main(int argc, char *argv[])
 			} else if (!alive)
 				last_fam = 0;
 		}
-		if (alive) { hits++; misses = 0; } else { misses++; hits = 0; }
-		if (!alive && !down)
+		/* v3.3.4: a probe that cannot leave the router says nothing about the
+		 * resolver. Owner 2026-10-04 19:45: an ~80 s WAN link loss failed the
+		 * AdGuard host on br55 (it answers a real query only through the
+		 * uplink) - FAILOVER, re-applied after wan_up rewrote the list, RESTORED
+		 * three hits later: three dnsmasq reloads and ~10 s of unfiltered DNS for
+		 * an outage that was never the resolver's. A miss while the uplink is
+		 * KNOWN down (wanduck's link_wan reads 0, or wan0_state_t is set and not
+		 * CONNECTED = 2) moves neither counter; a hit always counts (a cached
+		 * answer is a live resolver). A box that does not maintain those keys is
+		 * never held, so a dead resolver can never hide behind this. */
+		uplink_down = !alive && (nvram_match("link_wan", "0") ||
+			(*nvram_safe_get("wan0_state_t") && nvram_get_int("wan0_state_t") != 2));
+		if (alive) { hits++; misses = 0; }
+		else if (!uplink_down) { misses++; hits = 0; }
+		if (uplink_down && !held) {
+			logmessage(HC_TAG, "DNS Health Check HOLD: the uplink is down (link_wan=%s wan0_state_t=%s) - a probe cannot reach %s from here, so misses are not counted until it is back", nvram_safe_get("link_wan"), nvram_safe_get("wan0_state_t"), c.target);
+			held = 1;
+		} else if (!uplink_down && held) {
+			logmessage(HC_TAG, "DNS Health Check: the uplink is back - %s is judged normally again", c.target);
+			held = 0;
+		}
+		if (!alive && !down && !uplink_down)
 			logmessage(HC_TAG, "DNS Health Check: %s did not answer within %d ms on any configured address (miss %d of %d)", c.target, c.timeout_ms, misses, c.fail);
 
 		if (!down && misses >= c.fail) {
diff --git a/release/src/router/rc/reaper_fw.c b/release/src/router/rc/reaper_fw.c
index fc8ef1d41a..6b6ca13826 100644
--- a/release/src/router/rc/reaper_fw.c
+++ b/release/src/router/rc/reaper_fw.c
@@ -2030,7 +2030,12 @@ static int rfw_gen_apply(const char *path, const rfw_cfg_t *c, int teardown_only
 	  "\n");
 
 	/* ---- teardown (S4: only our own chains, never the table) ---- */
+	/* 2026-10-04: drop the chain signatures FIRST. rwatch 3f compares the live
+	 * chains against " RFW_DIR "/chainsig, written at the end of a successful
+	 * build; while this script is tearing down and rebuilding, no signature
+	 * exists and the check stays silent instead of seeing a half-built chain. */
 	fprintf(f,
+	  "rm -f " RFW_DIR "/chainsig " RFW_DIR "/chainsig.tmp 2>/dev/null\n"
 	  "for T in iptables ip6tables; do\n"
 	  "  for P in INPUT:" RFW_CHAIN_IN " FORWARD:" RFW_CHAIN_FWD " OUTPUT:" RFW_CHAIN_OUT "; do\n"
 	  "    H=\"${P%%%%:*}\"; C=\"${P##*:}\"\n"
@@ -2199,6 +2204,24 @@ static int rfw_gen_apply(const char *path, const rfw_cfg_t *c, int teardown_only
 	  "  logger -t reaper_fw \"$RFW_HARD structural step(s) failed - firewall not active\"\n"
 	  "  exit 1\n"
 	  "fi\n"
+	  /* 2026-10-04 (backlog "chain-integrity watchdog covers the Warden drop
+	   * chains only"): the invariant for THESE chains is "they still read exactly
+	   * as this script built them". Gatekeeper's chains interleave DROP and
+	   * RETURN and gkd re-applies them itself; ours have no daemon, so sign them
+	   * here - one md5 of `-S` per chain, filter v4+v6 and the nat MASQ chain -
+	   * and let rwatch 3f recompute and compare. REAPER_FWN / REAPER_FWHC are
+	   * NOT signed: hcgate.sh toggles them at run time by design. Written after
+	   * the hard-failure exit (nothing to sign) and before the soft one (the
+	   * chains are live in whatever shape loaded, and that shape is the truth). */
+	  ": > " RFW_DIR "/chainsig.tmp\n"
+	  "for T in iptables ip6tables; do\n"
+	  "  for C in " RFW_CHAIN_IN " " RFW_CHAIN_FWD " " RFW_CHAIN_OUT "; do\n"
+	  "    $T -S \"$C\" >/dev/null 2>&1 || continue\n"
+	  "    echo \"$T filter $C $($T -S \"$C\" 2>/dev/null | md5sum | cut -d' ' -f1)\" >> " RFW_DIR "/chainsig.tmp\n"
+	  "  done\n"
+	  "done\n"
+	  "iptables -t nat -S " RFW_CHAIN_MASQ " >/dev/null 2>&1 && echo \"iptables nat " RFW_CHAIN_MASQ " $(iptables -t nat -S " RFW_CHAIN_MASQ " 2>/dev/null | md5sum | cut -d' ' -f1)\" >> " RFW_DIR "/chainsig.tmp\n"
+	  "mv -f " RFW_DIR "/chainsig.tmp " RFW_DIR "/chainsig 2>/dev/null\n"
 	  "if [ \"$RFW_FAIL\" -gt 0 ]; then\n"
 	  "  logger -t reaper_fw \"$RFW_FAIL rule(s) failed to load\"\n"
 	  "  exit 3\n"
