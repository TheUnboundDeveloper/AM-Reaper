 	memset(used_fc, 0, sizeof(used_fc));
@@ -472,7 +490,7 @@ static int ppbr_gen(const char *path, int teardown_only, const ppbr_cfg_t *cfg)
 
 	fprintf(f,
 	  "#!/bin/sh\n" REAPER_NV_HELPER
-	  "# generated by reaper_pbr - do not edit; idempotent (teardown then rebuild)\n"
