 	  "# rwatch compares the live chain against EXPECT and re-runs this script.\n"
@@ -349,7 +363,10 @@ static void ppbr_emit_skip_helpers(FILE *f)
 	   * re-runs this script when the interface appears, which turns it into
 	   * `new`. */
 	  "  if [ -n \"$2\" ] && [ ! -d /sys/class/net/\"$2\" ]; then echo \"$1 pending\" >> \"$SKIPREC\"; logger -t reaper_pbr \"WireGuard iface $2 down - $1 skip-bypass not installed yet (installed when the client starts)\"; return 0; fi\n"
-	  "  if grep -qsx -- \"$1\" \"$SKIP\"; then echo \"$1 pre\" >> \"$SKIPREC\"; return 0; fi\n"
