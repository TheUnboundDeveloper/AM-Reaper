From d173dcd8a4dffc4bcddb7327e7a082397fa2ab59 Mon Sep 17 00:00:00 2001
From: reaper <theunbounddeveloper@outlook.com>
Date: Tue, 13 Oct 2026 19:07:59 -0400
Subject: [PATCH] www: the DNS Failover status poll parses its reply once

The poll ran JSON.parse() twice on the same reply, the second inside the
first's empty catch; one parse now feeds both the resolver state and the
LAN name check state.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 release/src/router/www/Reaper_Failover.asp | 6 ++++--
 1 file changed, 4 insertions(+), 2 deletions(-)

diff --git a/release/src/router/www/Reaper_Failover.asp b/release/src/router/www/Reaper_Failover.asp
index 977a42c7e57..f09f5ef7692 100644
--- a/release/src/router/www/Reaper_Failover.asp
+++ b/release/src/router/www/Reaper_Failover.asp
@@ -461,8 +461,10 @@ function poll(){
   x.onreadystatechange = function(){
     if(x.readyState !== 4) return;
     if(x.status === 200){
-      try{ var j = JSON.parse(x.responseText); if(j && typeof j.reaper_dnshc_state === 'string') render(j.reaper_dnshc_state, ORIG.enable); }catch(e){}
-      try{ var k = JSON.parse(x.responseText); if(k && typeof k.reaper_landns_state === 'string') renderLd(k.reaper_landns_state); }catch(e){}
+      try{ var j = JSON.parse(x.responseText);
+        if(j && typeof j.reaper_dnshc_state === 'string') render(j.reaper_dnshc_state, ORIG.enable);
+        if(j && typeof j.reaper_landns_state === 'string') renderLd(j.reaper_landns_state);
+      }catch(e){}
     }
     fin();
   };
