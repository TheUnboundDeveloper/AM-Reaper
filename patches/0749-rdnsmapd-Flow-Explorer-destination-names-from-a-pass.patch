+# SPDX-License-Identifier: GPL-2.0-only
+# Copyright (C) 2026 the Reaper project maintainer
+# Part of the Reaper hardened Asuswrt-Merlin build. See LICENSE / LICENSE.reaper.
+# rdnsmapd: passive DNS name map for the Flow Explorer. libc only - rc decides
+# whether it runs, so it links neither libnvram nor libshared.
+include ../common.mak
+
+CFLAGS	+= -Os -Wall $(EXTRACFLAGS)
+CFLAGS	+= -I$(SRCBASE)/include -I$(TOP)/shared
+# same exploit-mitigation set as rtrafd (FORTIFY, strong canaries, format-security, PIE)
+CFLAGS	+= -D_FORTIFY_SOURCE=2 -fstack-protector-strong -Wformat -Wformat-security -fPIE
+LDFLAGS	= -pie -Wl,-z,relro,-z,now
+
+OBJS = rdnsmapd.o
+
+all: rdnsmapd
+
+rdnsmapd: $(OBJS)
+	@echo " [rdnsmapd] CC -o $@"
+	$(CC) $(LDFLAGS) -o $@ $(OBJS)
+
+	$(SIZECHECK)
+	$(CPTMP)
+
+clean:
+	rm -f rdnsmapd .*.depend
+	rm -f *.o
+
+install: all
+	@echo " [rdnsmapd] Installing..."
+	install -D rdnsmapd $(INSTALLDIR)/bin/rdnsmapd
+	$(STRIP) $(INSTALLDIR)/bin/rdnsmapd
+
+%.o: %.c .%.depend
+	@echo " [rdnsmapd] CC $@"
+	@$(CC) $(CFLAGS) -c $<
+
+.depend: $(OBJS:%.o=%.c)
+	@$(CC) $(CFLAGS) -M $^ > .depend
+
+.%.depend: %.c
+	@$(CC) $(CFLAGS) -M $< > $@
+
+-include $(OBJS:%.o=.%.depend)
diff --git a/release/src/router/rdnsmapd/rdnsmapd.c b/release/src/router/rdnsmapd/rdnsmapd.c
new file mode 100644
index 0000000000..9ae527ec54
--- /dev/null
+++ b/release/src/router/rdnsmapd/rdnsmapd.c
@@ -0,0 +1,501 @@
+/* SPDX-License-Identifier: GPL-2.0-only
+ * Copyright (C) 2026 the Reaper project maintainer
+ * Part of the Reaper hardened Asuswrt-Merlin build. See LICENSE / LICENSE.reaper.
+ *
+ * rdnsmapd - passive DNS name map for the Flow Explorer (Reaper_Conn.asp).
+ *
+ * The page showed every destination as a bare address because the router has
+ * no address-to-name source: a reverse lookup per row floods the resolver and
+ * returns CDN host names nobody recognises, dnsmasq's query log is lossy and
+ * churns the syslog, its pcap dump never rotates (conn-destination-hostname.md).
+ * This daemon takes the one source that is already on the wire: the DNS reply
+ * a client receives names exactly the address it is about to connect to.
+ *
+ * Mechanism, sized for zero idle cost:
+ *   - one AF_PACKET socket, unbound (every interface, both directions), with a
+ *     classic BPF filter attached BEFORE bind so the kernel rejects everything
+ *     that is not a UDP datagram from port 53 before a byte is copied;
+ *   - a blocking recv: no tick, no timer, no sweep - asleep while the LAN is quiet;
+ *   - per reply: parse the ANSWER section and map every A record to the QNAME the
+ *     client asked for (every A record there belongs to the question's CNAME
+ *     chain, so this IS the chain walked back, with no CNAME parsing);
+ *   - the table lives in /tmp/reaper/dnsmap, mmap'd MAP_SHARED by this daemon and
+ *     by httpd (shared/reaper_dnsmap.h): no publish step, nothing to parse.
+ * rc starts it in router mode while nvram rconn_names is not 0 and removes the
+ * file when the owner switches it off; the daemon itself reads no configuration.
+ *
+ * One-shot backfill (owner, 2026-10-05): switching the feature off wipes the
+ * table, so switching it back on would show bare addresses until every client
+ * resolved its destinations again. When httpd has left RDM_BACKFILL (written
+ * only on the off -> on toggle, never at boot), the daemon reads the active
+ * remote addresses from conntrack once, sends one PTR query each to dnsmasq
+ * (127.0.0.1 - its cache answers what the LAN resolved, misses go upstream),
+ * paced at ~50 a second, and stores the answers as REVERSE names (ndist 0):
+ * what the address owner registered, not what a device asked for. The page
+ * shows them muted; the first forward reply for the address takes over. The
+ * packet socket is drained throughout, so nothing is missed meanwhile.
+ *
+ * The same reply is seen once on the bridge and once on the egress port; the
+ * second copy is a same-name refresh that costs one hash probe. A reply that is
+ * 802.1Q-tagged on eth0 is delivered untagged on the VLAN interface too, so the
+ * filter needs no tag branch. DoH/DoT clients, and a wired client talking to a
+ * wired LAN resolver on the same switch, never cross the CPU and get no name. */
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <stdint.h>
+#include <unistd.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <signal.h>
+#include <time.h>
+#include <poll.h>
+#include <sys/mman.h>
+#include <sys/stat.h>
+#include <sys/socket.h>
+#include <netinet/in.h>
+#include <linux/filter.h>
+#include <linux/if_ether.h>
+#include <linux/if_packet.h>
+#include <arpa/inet.h>
+#include "reaper_dnsmap.h"
+
+#ifndef RDM_CT
+#define RDM_CT "/proc/net/nf_conntrack"	/* the host test points this at a fixture */
+#endif
+#define RDM_BF_MAX   512		/* addresses the backfill will ask about */
+#define RDM_BF_PACE  20			/* ms between PTR queries: ~50 a second */
+#define RDM_BF_WAIT  5000		/* ms to wait for the last answers */
+
+#ifndef RDM_TEST
+static volatile sig_atomic_t running = 1;
+static void on_term(int sig) { (void)sig; running = 0; }
+#endif
+
+/* tcpdump -dd 'udp src port 53' (EN10MB). IPv4 or IPv6 outer, UDP, source
+ * port 53, first fragment only. Interpreted by build-scripts/tests/test_dnsmap.py
+ * against sample frames, so a transcription slip fails the host test. */
+static struct sock_filter rdm_bpf[] = {
+	{ 0x28, 0, 0, 0x0000000c },	/* ldh [12]              ethertype */
+	{ 0x15, 0, 4, 0x000086dd },	/* jeq #0x86dd  -> 2 / 6  IPv6? */
+	{ 0x30, 0, 0, 0x00000014 },	/* ldb [20]              next header */
+	{ 0x15, 0, 11, 0x00000011 },	/* jeq #17      -> 4 / 15 UDP? */
+	{ 0x28, 0, 0, 0x00000036 },	/* ldh [54]              src port */
+	{ 0x15, 8, 9, 0x00000035 },	/* jeq #53      -> 14 / 15 */
+	{ 0x15, 0, 8, 0x00000800 },	/* jeq #0x0800  -> 7 / 15  IPv4? */
+	{ 0x30, 0, 0, 0x00000017 },	/* ldb [23]              protocol */
+	{ 0x15, 0, 6, 0x00000011 },	/* jeq #17      -> 9 / 15 */
+	{ 0x28, 0, 0, 0x00000014 },	/* ldh [20]              flags + fragment offset */
+	{ 0x45, 4, 0, 0x00001fff },	/* jset #0x1fff -> 15 / 11 (a later fragment: drop) */
+	{ 0xb1, 0, 0, 0x0000000e },	/* ldxb 4*([14]&0xf)     X = IP header length */
+	{ 0x48, 0, 0, 0x0000000e },	/* ldh [x+14]            src port */
+	{ 0x15, 0, 1, 0x00000035 },	/* jeq #53      -> 14 / 15 */
+	{ 0x06, 0, 0, 0x00040000 },	/* ret #262144  accept */
+	{ 0x06, 0, 0, 0x00000000 },	/* ret #0       drop */
+};
+
+/* skip an RR owner name: labels, or a compression pointer that ends it */
+static int rdm_skipname(const uint8_t *p, int n, int off)
+{
+	while (off < n) {
+		uint8_t l = p[off];
+
+		if (l == 0)
+			return off + 1;
+		if ((l & 0xc0) == 0xc0)
+			return off + 2 <= n ? off + 2 : -1;
+		if (l & 0xc0)
+			return -1;
+		off += 1 + l;
+	}
+	return -1;
+}
+
+/* read a name into out (>= 254 bytes), lower-cased, labels joined by '.',
+ * compression followed (bounded). Returns the offset just past the name as it
+ * sits at off, or -1: malformed, empty, or a byte the page must never see
+ * (outside 0x21..0x7e, or a double quote / backslash - the CGI prints the
+ * name raw inside JSON, so this charset IS the escaping). */
+static int rdm_readname(const uint8_t *p, int n, int off, char *out)
+{
+	int end = -1, hops = 0, o = 0, i;
+
+	while (off < n) {
+		uint8_t l = p[off];
+
+		if (l == 0) {
+			if (end < 0)
+				end = off + 1;
+			break;
+		}
+		if ((l & 0xc0) == 0xc0) {
+			if (off + 1 >= n || ++hops > 8)
+				return -1;
+			if (end < 0)
+				end = off + 2;
+			off = ((l & 0x3f) << 8) | p[off + 1];
+			continue;
+		}
+		if ((l & 0xc0) || off + 1 + l > n || o + 1 + l > 253)
+			return -1;
+		if (o)
+			out[o++] = '.';
+		for (i = 1; i <= l; i++) {
+			uint8_t c = p[off + i];
+
+			if (c >= 'A' && c <= 'Z')
+				c += 32;
+			if (c < 0x21 || c > 0x7e || c == '"' || c == '\\')
+				return -1;
+			out[o++] = (char)c;
+		}
+		off += 1 + l;
+	}
+	if (end < 0 || o == 0)
+		return -1;
+	out[o] = 0;
+	return end;
+}
+
+/* a name longer than the slot keeps its registrable tail: drop leading labels */
+static int rdm_fit(char *name)
+{
+	size_t len = strlen(name);
+
+	while (len > RDM_NAME) {
+		char *dot = memchr(name, '.', len);
+
+		if (!dot)
+			return 0;
+		len -= (size_t)(dot + 1 - name);
+		memmove(name, dot + 1, len + 1);
+	}
+	return (int)len;
+}
+
+/* one captured frame: Ethernet, IPv4/IPv6, UDP from port 53, a DNS response */
+static void rdm_parse(const uint8_t *p, int n, void *map, uint32_t now)
+{
+	struct rdm_hdr *h = map;
+	struct rdm_ent *t = rdm_table(map);
+	const uint8_t *q;
+	char qn[256];
+	int l4, dns, off, i, an, ql, ul;
+
+	if (n < 14 + 20 + 8 + 12)
+		return;
+	if (p[12] == 0x08 && p[13] == 0x00) {
+		int ihl = (p[14] & 0x0f) * 4;
+
+		if (ihl < 20 || p[23] != 17 || (((p[20] << 8) | p[21]) & 0x1fff) != 0)
+			return;
+		l4 = 14 + ihl;
+	} else if (p[12] == 0x86 && p[13] == 0xdd) {
+		if (p[20] != 17)
+			return;
+		l4 = 54;
+	} else
+		return;
+	dns = l4 + 8;
+	if (dns + 12 > n || ((p[l4] << 8) | p[l4 + 1]) != 53)
+		return;
+	ul = (p[l4 + 4] << 8) | p[l4 + 5];		/* trim Ethernet padding */
+	if (ul >= 8 && l4 + ul < n)
+		n = l4 + ul;
+	q = p + dns;
+	/* QR set, opcode 0, TC clear, RCODE 0, QDCOUNT 1, ANCOUNT >= 1 */
+	if (!(q[2] & 0x80) || (q[2] & 0x7a) || (q[3] & 0x0f) || q[4] != 0 || q[5] != 1)
+		return;
+	an = (q[6] << 8) | q[7];
+	if (!an)
+		return;
+	off = rdm_readname(p, n, dns + 12, qn);
+	if (off < 0 || off + 4 > n)
+		return;
+	off += 4;					/* QTYPE, QCLASS */
+	ql = rdm_fit(qn);
+	if (!ql)
+		return;
+	h->seen++;
+	if (an > 32)
+		an = 32;
+	for (i = 0; i < an; i++) {
+		int type, rdl;
+		uint32_t ttl;
+
+		off = rdm_skipname(p, n, off);
+		if (off < 0 || off + 10 > n)
+			return;
+		type = (p[off] << 8) | p[off + 1];
+		ttl = ((uint32_t)p[off + 4] << 24) | ((uint32_t)p[off + 5] << 16) |
+		      ((uint32_t)p[off + 6] << 8) | p[off + 7];
+		rdl = (p[off + 8] << 8) | p[off + 9];
+		off += 10;
+		if (off + rdl > n)
+			return;
+		if (type == 1 && rdl == 4) {
+			uint32_t ip;
+
+			memcpy(&ip, p + off, 4);		/* network order, as httpd's inet_aton gives it */
+			if (ttl < RDM_TTL_MIN)
+				ttl = RDM_TTL_MIN;
+			if (ttl > RDM_TTL_MAX)
+				ttl = RDM_TTL_MAX;
+			rdm_put(t, ip, qn, (uint8_t)ql, now + ttl);
+			h->upd++;
+		}
+		off += rdl;
+	}
+}
+
+/* ---- the one-shot backfill ---- */
+
+/* an address the Flow Explorer would show as a remote end: not private,
+ * loopback, link-local, carrier-NAT, multicast or unspecified (host order) */
+static int rdm_remote(uint32_t ip)
+{
+	uint8_t a = ip >> 24, b = (ip >> 16) & 255;
+
+	if (a == 10 || a == 127 || a == 0 || a >= 224)
+		return 0;
+	if ((a == 192 && b == 168) || (a == 172 && b >= 16 && b <= 31) ||
+	    (a == 169 && b == 254) || (a == 100 && b >= 64 && b <= 127))
+		return 0;
+	return 1;
+}
+
+/* the active remote addresses from conntrack's original tuples, deduplicated,
+ * minus those the table already names (network order out) */
+static int rdm_targets(uint32_t *out, int max, struct rdm_ent *t, uint32_t now)
+{
+	FILE *f = fopen(RDM_CT, "r");
+	char ln[1024], ip[24];
+	int n = 0, i, j;
+
+	if (!f)
+		return 0;
+	while (n < max && fgets(ln, sizeof(ln), f)) {
+		const char *k[2] = { "src=", "dst=" };
+
+		if (strncmp(ln, "ipv4", 4) != 0)
+			continue;
+		for (i = 0; i < 2 && n < max; i++) {
+			const char *p = strstr(ln, k[i]);
+			struct in_addr a;
+
+			if (!p || sscanf(p + 4, "%23[0-9.]", ip) != 1 || !inet_aton(ip, &a))
+				continue;
+			if (!rdm_remote(ntohl(a.s_addr)) || rdm_find(t, a.s_addr, now))
+				continue;
+			for (j = 0; j < n; j++)
+				if (out[j] == a.s_addr)
+					break;
+			if (j == n)
+				out[n++] = a.s_addr;
+		}
+	}
+	fclose(f);
+	return n;
+}
+
+/* a PTR query for ip (network order): id, RD, "d.c.b.a.in-addr.arpa PTR IN" */
+static int rdm_ptr_query(uint8_t *b, int blen, uint16_t id, uint32_t ip)
+{
+	uint8_t o[4];
+	int i, n = 12;
+
+	if (blen < 12 + 16 + 14 + 4)
+		return 0;
+	memcpy(o, &ip, 4);
+	memset(b, 0, 12);
+	b[0] = id >> 8;
+	b[1] = id & 255;
+	b[2] = 0x01;				/* RD */
+	b[5] = 1;				/* QDCOUNT */
+	for (i = 3; i >= 0; i--) {
+		int l = snprintf((char *)b + n + 1, 4, "%u", o[i]);
+
+		b[n] = (uint8_t)l;
+		n += 1 + l;
+	}
+	memcpy(b + n, "\x07in-addr\x04" "arpa", 14);	/* split: "\x04a" would read as one escape */
+	n += 14;
+	b[n++] = 0;
+	b[n++] = 12;				/* PTR */
+	b[n++] = 0;
+	b[n++] = 1;				/* IN */
+	return n;
+}
+
+/* a PTR answer (UDP payload): the id indexes the target list; the first PTR
+ * record becomes a REVERSE name (ndist 0) unless a forward reply named the
+ * address first - a learned name always wins */
+static void rdm_parse_ptr(const uint8_t *q, int n, void *map, uint32_t now, const uint32_t *tg, int ntg)
+{
+	struct rdm_hdr *h = map;
+	struct rdm_ent *t = rdm_table(map), *e;
+	char nm[256];
+	int off, i, an, id, ql;
+
+	if (n < 12)
+		return;
+	id = (q[0] << 8) | q[1];
+	if (id >= ntg || !(q[2] & 0x80) || (q[2] & 0x7a) || (q[3] & 0x0f) || q[4] != 0 || q[5] != 1)
+		return;
+	an = (q[6] << 8) | q[7];
+	if (!an)
+		return;
+	off = rdm_skipname(q, n, 12);
+	if (off < 0 || off + 4 > n)
+		return;
+	off += 4;
+	if (an > 8)
+		an = 8;
+	for (i = 0; i < an; i++) {
+		int type, rdl;
+
+		off = rdm_skipname(q, n, off);
+		if (off < 0 || off + 10 > n)
+			return;
+		type = (q[off] << 8) | q[off + 1];
+		rdl = (q[off + 8] << 8) | q[off + 9];
+		off += 10;
+		if (off + rdl > n)
+			return;
+		if (type == 12) {
+			if (rdm_readname(q, n, off, nm) < 0)
+				return;
+			ql = rdm_fit(nm);
+			if (!ql || rdm_find(t, tg[id], now))
+				return;
+			rdm_put(t, tg[id], nm, (uint8_t)ql, now + RDM_TTL_MIN);
+			if ((e = rdm_find(t, tg[id], now)) != NULL)
+				e->ndist = 0;
+			h->upd++;
+			return;
+		}
+		off += rdl;
+	}
+}
+
+#ifndef RDM_TEST
+/* drain both sockets for ms milliseconds: forward replies keep being learned
+ * while the backfill runs, PTR answers land as reverse names */
+static void rdm_bf_drain(struct pollfd *pf, void *map, const uint32_t *tg, int ntg, int ms)
+{
+	static uint8_t rb[4096];
+	struct timespec t0, t1;
+	int n, left;
+
+	clock_gettime(CLOCK_MONOTONIC, &t0);
+	for (;;) {
+		clock_gettime(CLOCK_MONOTONIC, &t1);
+		left = ms - (int)((t1.tv_sec - t0.tv_sec) * 1000 + (t1.tv_nsec - t0.tv_nsec) / 1000000);
+		if (left <= 0 || poll(pf, 2, left) <= 0)
+			return;
+		if ((pf[0].revents & POLLIN) && (n = (int)recv(pf[0].fd, rb, sizeof(rb), 0)) > 0)
+			rdm_parse(rb, n, map, (uint32_t)time(NULL));
+		if ((pf[1].revents & POLLIN) && (n = (int)recv(pf[1].fd, rb, sizeof(rb), 0)) > 0)
+			rdm_parse_ptr(rb, n, map, (uint32_t)time(NULL), tg, ntg);
+	}
+}
+
+static void rdm_backfill(void *map, int pk)
+{
+	static uint32_t tg[RDM_BF_MAX];
+	uint8_t qb[64];
+	struct sockaddr_in rs;
+	struct pollfd pf[2];
+	int ntg, us, i, n;
+
+	ntg = rdm_targets(tg, RDM_BF_MAX, rdm_table(map), (uint32_t)time(NULL));
+	if (ntg <= 0)
+		return;
+	if ((us = socket(AF_INET, SOCK_DGRAM, 0)) < 0)
+		return;
+	memset(&rs, 0, sizeof(rs));
+	rs.sin_family = AF_INET;
+	rs.sin_port = htons(53);
+	rs.sin_addr.s_addr = htonl(0x7f000001);	/* dnsmasq: its cache first, upstream on a miss */
+	pf[0].fd = pk;
+	pf[0].events = POLLIN;
+	pf[1].fd = us;
+	pf[1].events = POLLIN;
+	for (i = 0; i < ntg; i++) {
+		n = rdm_ptr_query(qb, sizeof(qb), (uint16_t)i, tg[i]);
+		if (n > 0)
+			sendto(us, qb, n, 0, (struct sockaddr *)&rs, sizeof(rs));
+		rdm_bf_drain(pf, map, tg, ntg, RDM_BF_PACE);
+	}
+	for (i = 0; i < RDM_BF_WAIT; i += 100)
+		rdm_bf_drain(pf, map, tg, ntg, 100);
+	close(us);
+}
+
+int main(void)
+{
+	struct sock_fprog prog = { sizeof(rdm_bpf) / sizeof(rdm_bpf[0]), rdm_bpf };
+	struct sockaddr_ll sll;
+	struct rdm_hdr *h;
+	struct stat st;
+	static uint8_t buf[4096];			/* EDNS replies fit; longer ones are truncated by the sender */
+	void *map;
+	int fd, sk, n, rcv = 262144;
+
+	signal(SIGTERM, on_term);
+	signal(SIGINT, on_term);
+	signal(SIGPIPE, SIG_IGN);
+
+	mkdir("/tmp/reaper", 0700);
+	if ((fd = open(RDM_PATH, O_RDWR | O_CREAT, 0600)) < 0)
+		return 1;
+	if (fstat(fd, &st) != 0 || (st.st_size < (off_t)RDM_SIZE && ftruncate(fd, RDM_SIZE) != 0)) {
+		close(fd);
+		return 1;
+	}
+	map = mmap(NULL, RDM_SIZE, PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0);
+	if (map == MAP_FAILED) {
+		close(fd);
+		return 1;
+	}
+	h = map;
+	if (h->magic != RDM_MAGIC || h->slots != RDM_SLOTS || h->esize != sizeof(struct rdm_ent)) {
+		memset(map, 0, RDM_SIZE);		/* fresh file or a layout change: start empty */
+		h->slots = RDM_SLOTS;
+		h->esize = sizeof(struct rdm_ent);
+		__sync_synchronize();
+		h->magic = RDM_MAGIC;
+	}
+	h->gen++;					/* entries survive a restart; the counter says it happened */
+
+	/* protocol 0 delivers nothing until bind(): the filter is in place first */
+	if ((sk = socket(AF_PACKET, SOCK_RAW, 0)) < 0)
+		return 1;
+	if (setsockopt(sk, SOL_SOCKET, SO_ATTACH_FILTER, &prog, sizeof(prog)) != 0)
+		return 1;
+	setsockopt(sk, SOL_SOCKET, SO_RCVBUF, &rcv, sizeof(rcv));
+	memset(&sll, 0, sizeof(sll));
+	sll.sll_family = AF_PACKET;
+	sll.sll_protocol = htons(ETH_P_ALL);
+	if (bind(sk, (struct sockaddr *)&sll, sizeof(sll)) != 0)
+		return 1;
+
+	/* the flag exists only when the owner just switched Names back on */
+	if (unlink(RDM_BACKFILL) == 0)
+		rdm_backfill(map, sk);
+
+	while (running) {
+		n = (int)recv(sk, buf, sizeof(buf), 0);
+		if (n < 0) {
+			if (errno == EINTR)
+				continue;
+			break;
+		}
+		rdm_parse(buf, n, map, (uint32_t)time(NULL));
+	}
+	close(sk);
+	munmap(map, RDM_SIZE);
+	close(fd);
+	return 0;
+}
+#endif
