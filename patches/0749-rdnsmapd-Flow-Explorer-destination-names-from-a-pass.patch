+/* reaper v3.3.4: the passive DNS name map behind the Flow Explorer's destination
+ * names (rdnsmapd, shared/reaper_dnsmap.h). One AF_PACKET socket with a kernel
+ * filter for UDP replies from port 53, a blocking recv, a 128 KB table in
+ * /tmp/reaper/dnsmap that httpd mmaps in place - no tick, no publish step.
+ * Default on (nvram rconn_names); the Connections page toggle is the opt-out,
+ * and off removes the table: it names what the household looked up. */
+void
+stop_rdnsmap(void)
+{
+	if (pids("rdnsmapd"))
+		killall_tk("rdnsmapd");
+}
+
+void
+start_rdnsmap(void)
+{
+	stop_rdnsmap();
+	if (!is_routing_enabled()) return;
+	if (nvram_match("rconn_names", "0")) {
+		unlink("/tmp/reaper/dnsmap");	/* RDM_PATH in shared/reaper_dnsmap.h */
+		return;
+	}
+	xstart("rdnsmapd");
+}
+
 /* reaper v1.6.1: passive channel-quality monitor. Opt-in (nvram rchq_enable),
  * read-only - it samples chanim_stats on each radio's current channel and
  * publishes /tmp/reaper_chq/live.json; it NEVER changes a channel or restarts
@@ -8786,6 +8812,45 @@ static void wlcsm_bindfix_remove(void)
 		unlink(LD_SO_PRELOAD);
 }
 
+/* reaper 2026-10-04 (owner): the DTIM interval is 1 on every radio. The
+ * compiled default for this family already reads 1 (defaults.c, the HND AX
+ * branch) but a box keeps whatever its nvram carries - ASUS stock sets 3 on
+ * these models and the stock explainer said so - so the first boot of an
+ * image with this function sets 1 on each radio ONCE, says so, and leaves a
+ * marker. From then on the value is the user's: the Wi-Fi Settings page may
+ * raise it again and this never runs twice (a factory reset clears both the
+ * marker and the value, so it runs once more and finds 1). Called before
+ * start_lan(), so the radios come up with it. */
+#define REAPER_DTIM_MARK	"/jffs/reaper/.dtim1"
+void reaper_dtim_default(void)
+{
+	char key[32], was[8] = "";
+	int unit, n = 0;
+
+	if (f_exists(REAPER_DTIM_MARK))
+		return;
+	for (unit = 0; unit < 4; unit++) {
+		snprintf(key, sizeof(key), "wl%d_ifname", unit);
+		if (!*nvram_safe_get(key))
+			continue;
+		snprintf(key, sizeof(key), "wl%d_dtim", unit);
+		if (nvram_match(key, "1"))
+			continue;
+		if (!was[0])
+			strlcpy(was, nvram_safe_get(key), sizeof(was));
+		nvram_set(key, "1");
+		n++;
+	}
+	if (!nvram_match("wl_dtim", "1"))
+		nvram_set("wl_dtim", "1");
+	if (n) {
+		nvram_commit();
+		logmessage("wireless", "DTIM interval set to 1 on %d radio(s) (was %s) - the Reaper default: sleeping clients wake at every beacon; raise it on the Wi-Fi Settings page if you prefer longer client sleeps", n, was[0] ? was : "unset");
+	}
+	mkdir("/jffs/reaper", 0755);
+	f_write_string(REAPER_DTIM_MARK, "1\n", 0, 0);
+}
+
 void start_wlcsm_bindfix(void)
 {
 	/* RETIRED 2026-09-16. libnvram.so and libwlcsm.so now carry Broadcom's own
@@ -8798,9 +8863,17 @@ void start_wlcsm_bindfix(void)
 	 * shim). The .so is no longer built (router Makefile). Function kept so the
 	 * caller and rc.h stay untouched. */
 	wlcsm_bindfix_remove();
-	if (nvram_match("wlcsm_bindfix", "1"))
+	if (nvram_match("wlcsm_bindfix", "1")) {
+		/* reaper 2026-10-04: v3.2.8 dropped the DEFAULT, but a value the user
+		 * set by hand while the shim was opt-in survives in nvram and re-logged
+		 * this line on every boot (owner, v3.3.4 r2 first boot). Say it once
+		 * more, then drop the retired key - committed - so the next boot is quiet. */
 		logmessage("wlcsm_bindfix", "retired - the WLCSM fix ships in libnvram.so/libwlcsm.so "
-			   "(stock 42015); the preload shim is not installed and wlcsm_bindfix=1 is ignored");
+			   "(stock 42015); the preload shim is not installed and wlcsm_bindfix=1 is ignored - "
+			   "the retired setting has been removed from nvram");
+		nvram_unset("wlcsm_bindfix");
+		nvram_commit();
+	}
 }
 
