diff --git a/release/src/router/shared/reaper_dnsmap.h b/release/src/router/shared/reaper_dnsmap.h
new file mode 100644
index 0000000000..9a52ab1299
--- /dev/null
+++ b/release/src/router/shared/reaper_dnsmap.h
@@ -0,0 +1,138 @@
+/* SPDX-License-Identifier: GPL-2.0-only
+ * Copyright (C) 2026 the Reaper project maintainer
+ * Part of the Reaper hardened Asuswrt-Merlin build. See LICENSE / LICENSE.reaper.
+ *
+ * Passive DNS name map, shared by rdnsmapd (the writer) and httpd (the reader
+ * behind reaper_conn.cgi). The table is a fixed open-addressing hash in a tmpfs
+ * file that both sides mmap MAP_SHARED: the daemon's in-memory table IS the file,
+ * so there is no publish step and nothing to parse - httpd probes it in place.
+ * IPv4 only: the Flow Explorer feed (/proc/fcache/nflist) is IPv4 only.
+ *
+ * Lifetime of an entry: written with now + clamp(record TTL, RDM_TTL_MIN,
+ * RDM_TTL_MAX); the reader extends it (rdm_touch) while a flow to that address
+ * is being viewed. A stale entry is one whose exp has passed - rdm_find treats
+ * it as absent and rdm_put as the first victim, so nothing ever sweeps.
+ *
+ * ndist: how many times the name for an address changed (a shared-CDN hint for
+ * the page). 0 is reserved: a REVERSE name from the one-shot backfill that runs
+ * when the owner switches the feature back on (what the address owner
+ * registered, not what a device asked for); the first forward reply for that
+ * address raises it to 1 and takes the name over.
+ *
+ * Concurrency (one writer, one reader, no lock): the writer clears ip, writes
+ * the body, then stores ip behind a barrier; the reader walks the whole probe
+ * window (a slot being refilled never ends the probe early) and trusts a name
+ * only when nlen and its NUL agree. The worst case is one missed label for one
+ * page poll. */
+#ifndef REAPER_DNSMAP_H
+#define REAPER_DNSMAP_H
+
+#include <stdint.h>
+#include <string.h>
+
+#define RDM_PATH     "/tmp/reaper/dnsmap"
+#define RDM_BACKFILL RDM_PATH ".backfill"	/* one-shot flag: httpd writes it on off -> on, the daemon consumes it */
+#define RDM_MAGIC    0x314d4452u	/* "RDM1" read as a little-endian u32 */
+#define RDM_SLOTS    2048u		/* power of two: 2048 x 64 B = 128 KB */
+#define RDM_PROBES   8			/* linear probe window, always walked in full */
+#define RDM_NAME     52			/* name bytes kept; name[RDM_NAME] is the NUL */
+#define RDM_TTL_MIN  3600u		/* a 20 s CDN TTL is useless to someone watching a flow */
+#define RDM_TTL_MAX  86400u
+#define RDM_SIZE     (64u + RDM_SLOTS * 64u)
+
+struct rdm_hdr {			/* 64 bytes */
+	uint32_t magic, slots, esize, gen;	/* gen: how many times a writer started */
+	uint32_t seen, upd;			/* replies parsed, records written (diag) */
+	uint32_t pad[10];
+};
+
+struct rdm_ent {			/* 64 bytes: 4 + 4 + 2 + 1 + 53 */
+	uint32_t ip;			/* network byte order; 0 = never used */
+	uint32_t exp;			/* epoch after which the entry is stale */
+	uint16_t ndist;			/* name changes seen; 0 = reverse (backfill) name */
+	uint8_t  nlen;
+	char     name[RDM_NAME + 1];
+};
+
+typedef char rdm_assert_hdr_[(sizeof(struct rdm_hdr) == 64) ? 1 : -1];
+typedef char rdm_assert_ent_[(sizeof(struct rdm_ent) == 64) ? 1 : -1];
+
+static inline uint32_t rdm_hash(uint32_t ip)
+{
+	return (ip * 0x9E3779B1u) >> 21;	/* top 11 bits -> 0..2047 */
+}
+
+static inline struct rdm_ent *rdm_table(void *map)
+{
+	return (struct rdm_ent *)((char *)map + sizeof(struct rdm_hdr));
+}
+
+/* reader: the live entry for ip, or NULL */
+static inline struct rdm_ent *rdm_find(struct rdm_ent *t, uint32_t ip, uint32_t now)
+{
+	uint32_t h = rdm_hash(ip);
+	int i;
+
+	for (i = 0; i < RDM_PROBES; i++) {
+		struct rdm_ent *e = &t[(h + i) & (RDM_SLOTS - 1)];
+
+		if (e->ip == ip)
+			return (e->exp > now && e->nlen && e->nlen <= RDM_NAME &&
+				e->name[e->nlen] == 0) ? e : NULL;
+	}
+	return NULL;
+}
+
+/* reader: a name stays while someone is looking at the flow */
+static inline void rdm_touch(struct rdm_ent *e, uint32_t now)
+{
+	if (e->exp < now + RDM_TTL_MIN)
+		e->exp = now + RDM_TTL_MIN;
+}
+
+/* writer (forward replies): refresh in place; else the first never-used slot in
+ * the window; else the earliest-expiring one (stale entries go first by
+ * construction). A reverse name (ndist 0) is confirmed or replaced either way. */
+static inline void rdm_put(struct rdm_ent *t, uint32_t ip, const char *name, uint8_t nlen, uint32_t exp)
+{
+	uint32_t h = rdm_hash(ip), vexp = ~0u;
+	struct rdm_ent *v = NULL;
+	int i;
+
+	for (i = 0; i < RDM_PROBES; i++) {
+		struct rdm_ent *e = &t[(h + i) & (RDM_SLOTS - 1)];
+
+		if (e->ip == ip) {
+			if (e->nlen != nlen || memcmp(e->name, name, nlen) != 0) {
+				memcpy(e->name, name, nlen);
+				e->name[nlen] = 0;
+				e->nlen = nlen;
+				if (e->ndist < 0xffff)
+					e->ndist++;
+			} else if (e->ndist == 0)
+				e->ndist = 1;
+			if (exp > e->exp)
+				e->exp = exp;
+			return;
+		}
+		if (e->ip == 0) {
+			v = e;
+			break;
+		}
+		if (e->exp < vexp) {
+			vexp = e->exp;
+			v = e;
+		}
+	}
+	v->ip = 0;
+	__sync_synchronize();
+	memcpy(v->name, name, nlen);
+	v->name[nlen] = 0;
+	v->nlen = nlen;
+	v->ndist = 1;
+	v->exp = exp;
+	__sync_synchronize();
+	v->ip = ip;
+}
+
+#endif /* REAPER_DNSMAP_H */
