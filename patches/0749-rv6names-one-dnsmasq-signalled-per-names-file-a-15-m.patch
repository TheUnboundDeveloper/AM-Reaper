+++ b/release/src/router/shared/reaper_v6names.h
@@ -9,14 +9,19 @@
  * handed out, so dnsmasq has no name for them and a DNS filter (AdGuard) lists them
  * as bare addresses. rc/rv6names.c maps each LAN neighbour's IPv6 address to the
  * name its DHCPv4 lease carries and writes "<ipv6> <name>" lines into a hosts file
- * per bridge, which that bridge's dnsmasq reads through hostsdir= (inotify, no
- * restart). These helpers are the pure part, proved on the host:
+ * per bridge, which that bridge's dnsmasq reads through addn-hosts= (re-read on
+ * SIGHUP; this dnsmasq is built -DNO_INOTIFY, so hostsdir= is not available). These
+ * helpers are the pure part, proved on the host:
  *   - which names may be written (a DHCP name dnsmasq would itself accept);
  *   - parsing one dnsmasq lease line (DHCPv4 -> MAC + name; DHCPv6 -> name only,
  *     because an IPv6 hosts entry under a DHCPv6 lease's name would make dnsmasq
