+++ b/release/src/router/shared/reaper_v6names.c
@@ -98,3 +98,53 @@ int rv6n_render(struct rv6n_pair *pairs, int n, int cap, char *out, size_t outle
 	}
 	return lines;
 }
+
+int rv6n_hold_merge(struct rv6n_held *tbl, int n, int cap, const struct rv6n_held *fresh, int nf,
+		    long now, long hold)
+{
+	int i, j, w;
+
+	if (!tbl || cap <= 0)
+		return 0;
+	if (n < 0) n = 0;
+	if (n > cap) n = cap;
+	for (i = 0; fresh && i < nf; i++) {
+		for (j = 0; j < n; j++)
+			if (!strcmp(tbl[j].br, fresh[i].br) && !strcmp(tbl[j].addr, fresh[i].addr))
+				break;
+		if (j == n) {
+			if (n < cap)
+				n++;
+			else {
+				int old = -1;
+				for (j = 0; j < n; j++)
+					if (tbl[j].seen < now && (old < 0 || tbl[j].seen < tbl[old].seen))
+						old = j;
+				if (old < 0)
+					continue;	/* full of pairs seen this tick: drop the newcomer */
+				j = old;
+			}
+			snprintf(tbl[j].br, sizeof(tbl[j].br), "%s", fresh[i].br);
+			snprintf(tbl[j].addr, sizeof(tbl[j].addr), "%s", fresh[i].addr);
+		}
+		snprintf(tbl[j].name, sizeof(tbl[j].name), "%s", fresh[i].name);
+		tbl[j].seen = now;
+	}
+	for (i = 0, w = 0; i < n; i++) {
+		if (now - tbl[i].seen >= hold)
+			continue;
+		if (w != i)
+			tbl[w] = tbl[i];
+		w++;
+	}
+	return w;
+}
+
+int rv6n_hup_due(int pending, long last, long now, long min_gap)
+{
+	if (!pending)
+		return 0;
+	if (last <= 0 || now < last)
+		return 1;
+	return now - last >= min_gap;
+}
