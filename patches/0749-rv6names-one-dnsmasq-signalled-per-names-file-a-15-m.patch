  *   - rendering the hosts file: IPv6 only (an IPv4 line could take a DHCPv4 lease's
- *     name), sorted, capped, so an unchanged set produces byte-identical output. */
+ *     name), sorted, capped, so an unchanged set produces byte-identical output;
+ *   - 2026-10-13: the hold table and the reload pacing. dnsmasq's SIGHUP empties its
+ *     whole DNS cache (cache_reload), so a departed address keeps its name for a
+ *     while (privacy addresses drop in and out of the neighbour cache) and each
+ *     instance is signalled at most once per pacing interval. */
 #ifndef REAPER_V6NAMES_H
 #define REAPER_V6NAMES_H
 
@@ -46,4 +51,26 @@ int rv6n_lease_line(const char *line, char *mac, size_t maclen, char *name, size
  * number of lines written, or -1 when out is too small (out is then empty). */
 int rv6n_render(struct rv6n_pair *pairs, int n, int cap, char *out, size_t outlen);
 
+/* 2026-10-13: one (bridge, address) -> name entry, kept after the neighbour leaves */
+struct rv6n_held {
+	char br[16];
+	char addr[RV6N_ADDR_MAX];
+	char name[RV6N_NAME_MAX];
+	long seen;			/* uptime (s) the pair was last in the neighbour cache */
+};
+
+/* Fold one tick's pairs (fresh, all stamped now) into the hold table tbl (n used,
+ * cap slots). The key is bridge + address: a fresh pair refreshes its entry, and
+ * an address that now carries another name takes the new name at once. Entries
+ * not seen for hold seconds or more are dropped. With the table full, a new pair
+ * replaces the entry seen longest ago, unless every entry was seen this tick.
+ * Returns the new entry count. */
+int rv6n_hold_merge(struct rv6n_held *tbl, int n, int cap, const struct rv6n_held *fresh, int nf,
+		    long now, long hold);
+
+/* 1 when a bridge with a rewritten file (pending) may signal its dnsmasq now:
+ * never signalled yet (last <= 0), or min_gap seconds or more since the last
+ * signal, or the clock went backwards. 0 otherwise. now and last are uptime. */
+int rv6n_hup_due(int pending, long last, long now, long min_gap);
+
 #endif /* REAPER_V6NAMES_H */
