+    fill.className="pfill"; fill.style.width="100%";
+    setTimeout(function(){bar.style.display="none";},1200);
+    prog.textContent=DATA.aborted?`<#RSVY_11#>`:(`<#RSVY_10#>`+(DATA.ts?" \u00b7 "+`<#RSVY_17#>`+": "+new Date(DATA.ts*1000).toLocaleTimeString():""));
+  }
+  clipTitle(prog);
+  /* each radio reports its own outcome - an empty radio is a result with a reason, not a blank */
+  var rs=DATA.radios||[], rt="", r, lab, s;
+  for(i=0;i<rs.length;i++){
+    r=rs[i]; lab=(NBANDNAME[r.nband]||r.ifname);
+    if(r.err===2) s=`<#RSVY_23#>`;
+    else if(r.err===4) s="<span class=\"warn\">"+`<#RSVY_27#>`+"</span>";
+    else if(r.err===1) s="<span class=\"bad\">"+`<#RWIF_83#>`+(r.msg?": "+esc(r.msg):"")+"</span>"+(r.moved?" \u00b7 "+`<#RSVY_34#>`+" "+esc(r.moved):"");
+    else s=(r.n||0)+" "+`<#RSVY_24#>`+(r.ms?" \u00b7 "+(r.ms/1000).toFixed(1)+" s":"")+(r.moved?" \u00b7 "+`<#RSVY_34#>`+" "+esc(r.moved):(r.home?" \u00b7 "+`<#RSVY_26#>`:(r.passive?" \u00b7 "+`<#RSVY_25#>`:"")));
+    /* r12 metal: the radio's raw radar-status line, so a surprising result can be read off the page */
+    rt+="<div"+(r.dfsl?" title=\""+esc(r.dfsl)+"\"":"")+"><b>"+lab+"</b> <span class=\"mono\">"+esc(r.ifname)+"</span>: "+s+"</div>";
+  }
+  document.getElementById("svyradios").innerHTML=rt;
+  list=DATA.aps||[];
+  for(i=0;i<list.length;i++){
+    a=list[i]; n++;
+    if(a.hidden) hidden++;
+    if(!best||a.rssi>best.rssi) best=a;
+    per[a.band]=(per[a.band]||0)+1;
+    if(a.ch){ if(!chans[a.band]){ chans[a.band]={}; names[a.band]={}; } chans[a.band][a.ch]=(chans[a.band][a.ch]||0)+1; (names[a.band][a.ch]=names[a.band][a.ch]||[]).push(a); }
+  }
+  var t="";
+  t+=`<div class="tile"><div class="k"><#RSVY_4#></div><div class="v">`+n+"</div></div>";
+  var bands=[2,5,6], b;
+  for(i=0;i<bands.length;i++){ b=bands[i]; if(per[b]) t+="<div class=\"tile\"><div class=\"k\">"+BANDNAME[b]+"</div><div class=\"v\">"+per[b]+"</div></div>"; }
+  if(hidden) t+=`<div class="tile"><div class="k"><#RSVY_8#></div><div class="v">`+hidden+"</div></div>";
+  if(best) t+=`<div class="tile"><div class="k"><#RSVY_16#></div><div class="v"><small>`+(best.hidden?`<#RSVY_8#>`:esc(best.ssid))+" \u00b7 "+best.rssi+" dBm</small></div></div>";
+  tiles.innerHTML=t;
+
+  list=filtered();
+  for(i=0;i<list.length;i++){
+    a=list[i];
+    rows+="<tr><td class=\"tname\">"+(a.hidden?`<span class="hid"><#RSVY_8#></span>`:esc(a.ssid))+"</td>"+
+      "<td class=\"mono\">"+esc(a.bssid)+"</td>"+
+      "<td>"+(BANDNAME[a.band]||"&ndash;")+"</td>"+
+      "<td class=\"num\">"+(a.ch?a.ch:"&ndash;")+"</td>"+
+      "<td class=\"num\">"+(a.w?a.w+" MHz":"&ndash;")+"</td>"+
+      "<td>"+sigCell(+a.rssi)+"</td>"+
+      "<td class=\"num\">"+(a.snr?a.snr+" dB":"&ndash;")+"</td>"+
+      "<td>"+(a.sec==="Open"?`<span class="badge warn"><#RSVY_18#></span>`:esc(a.sec))+"</td>"+
+      "<td>"+genLabel(a)+"</td>"+
+      "<td class=\"mono\">"+esc(ifnameOf(a.unit))+"</td></tr>";
+  }
+  tb.innerHTML=rows;
+  wrap.style.display=n?"":"none";
+  empty.style.display=n?"none":"";
+  document.getElementById("svycsv").disabled=!n;
+
+  /* one card per control channel in use, per band: the channel, how many networks share it, coloured
+   * 0-1 quiet / 2-3 shared / 4+ crowded; the channel this router runs on is marked and shown even when
+   * nobody else is there (only once its radio has scanned clean). Hover lists the networks heard. */
+  var ch="", keys, j, k, c, tier, me, mine={}, NB2B={2:2,1:5,4:6}, u, mt, lst2, tip;
+  for(i=0;ST&&ST.bands&&i<ST.bands.length;i++){
+    u=ST.bands[i]; mt=/^(?:6g)?([0-9]+)/.exec(String(u.run_chanspec||"")); b=NB2B[u.nband];
+    if(!mt||!b) continue;
+    for(j=0;j<rs.length;j++) if(rs[j].unit===u.unit&&(rs[j].err===0||rs[j].err===3)) break;
+    if(j>=rs.length) continue;
+    k=+mt[1]; if(!mine[b]) mine[b]={}; mine[b][k]=1;
+    if(!chans[b]) chans[b]={}; if(!chans[b][k]) chans[b][k]=0;
+  }
+  for(i=0;i<bands.length;i++){
+    b=bands[i]; if(!chans[b]) continue;
+    keys=Object.keys(chans[b]).map(Number).sort(function(p,r){return p-r;});
+    if(!ch) ch+="<div class=\"chleg\"><span><i class=\"t1\"></i><b>0-1</b> "+`<#RSVY_28#>`+"</span><span><i class=\"t2\"></i><b>2-3</b> "+`<#RSVY_29#>`+"</span><span><i class=\"t3\"></i><b>4+</b> "+`<#RSVY_30#>`+"</span></div>";
+    ch+="<div class=\"chband\"><div class=\"bn\">"+BANDNAME[b]+"<small>"+(per[b]||0)+" "+`<#RSVY_24#>`+"</small></div><div class=\"chcards\">";
+    for(j=0;j<keys.length;j++){
+      k=keys[j]; c=chans[b][k]; tier=c>=4?3:c>=2?2:1; me=!!(mine[b]&&mine[b][k]);
+      lst2=(names[b]&&names[b][k])?names[b][k].slice().sort(function(p,r){return (+r.rssi||0)-(+p.rssi||0);}):[];
+      tip=lst2.slice(0,8).map(function(x){return (x.hidden?`<#RSVY_8#>`:x.ssid)+" "+x.rssi+" dBm";}).join(", ")+(lst2.length>8?" ...":"");
+      ch+="<div class=\"chcard t"+tier+(me?" mine":"")+"\""+(tip?" title=\""+esc(tip)+"\"":"")+">"+
+        "<div class=\"ck\"><span>CH</span>"+(me?"<span class=\"badge me\">"+`<#RSYS_02#>`+"</span>":"")+"</div>"+
+        "<div class=\"cn\">"+k+"</div>"+
+        "<div class=\"cc\"><b>"+c+"</b>"+`<#RSVY_24#>`+"</div></div>";
+    }
+    ch+="</div></div>";
+  }
+  chan.innerHTML=ch||`<div class="empty"><#RSVY_6#></div>`;
+}
+
+function svyExport(){
+  if(!DATA||!DATA.aps||!DATA.aps.length) return;
+  var i,a,csv="ssid,bssid,band,channel,width_mhz,chanspec,rssi_dbm,noise_dbm,snr_db,security,generation,heard_by\n";
+  function q(s){ return "\""+String(s==null?"":s).replace(/"/g,"\"\"")+"\""; }
+  for(i=0;i<DATA.aps.length;i++){
+    a=DATA.aps[i];
+    csv+=[q(a.ssid),q(a.bssid),q(BANDNAME[a.band]||""),a.ch||"",a.w||"",q(a.cs),a.rssi||"",a.noise||"",a.snr||"",q(a.sec),q(genLabel(a).replace(/<[^>]*>/g,"")),q(ifnameOf(a.unit))].join(",")+"\n";
+  }
+  var blob=new Blob([csv],{type:"text/csv"}), u=URL.createObjectURL(blob), l=document.createElement("a");
+  l.href=u; l.download="reaper-site-survey-"+(DATA.ts?new Date(DATA.ts*1000).toISOString().slice(0,19).replace(/[:T]/g,"-"):"now")+".csv";
+  document.body.appendChild(l); l.click(); document.body.removeChild(l);
+  setTimeout(function(){URL.revokeObjectURL(u);},2000);
+}
+
+/* column sort: click toggles direction; signal and SNR default to strongest first */
+(function(){
+  var ths=document.querySelectorAll("#svytable th.sort"), i;
+  function on(th){
+    var k=th.getAttribute("data-k"), j;
+    if(SORTK===k) SORTD=-SORTD; else { SORTK=k; SORTD=(k==="rssi"||k==="snr")?-1:1; }
+    for(j=0;j<ths.length;j++) ths[j].className=ths[j].className.replace(" on","");
+    th.className+=" on";
+    svyRender();
+  }
+  for(i=0;i<ths.length;i++) (function(th){ th.addEventListener("click",function(){on(th);}); })(ths[i]);
+})();
+
+/* a closed tab should not leave a scan running unattended */
+function svyUnloadStop(){
+  if(POLL && navigator.sendBeacon){
+    try{ navigator.sendBeacon("/reaper_wifi.cgi?action=svystop"+reaperTok()); }catch(e){}
