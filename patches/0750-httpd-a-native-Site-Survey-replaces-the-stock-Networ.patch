+	for (; *src && *src != '\n' && *src != '\r' && i + 1 < len; src++)
+		if (*src >= 0x20 && *src <= 0x7e && *src != '"' && *src != '\\')
+			dst[i++] = *src;
+	dst[i] = 0;
