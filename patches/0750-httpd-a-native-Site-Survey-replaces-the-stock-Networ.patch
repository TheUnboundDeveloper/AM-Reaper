+/* reaper v3.3.4: the passive DNS name map (rdnsmapd, shared/reaper_dnsmap.h).
+ * The daemon's table is a tmpfs file; httpd maps it MAP_SHARED once and keeps
+ * the mapping across requests (one process), probing it in place per flow -
+ * no read, no parse. A stat every 5 s notices a removed or recreated file. */
+static void reaper_audit(const char *feat, const char *act, const char *detail);	/* defined below; the Names toggle audits */
+static void *rdm_map;
+static ino_t rdm_ino;
+static time_t rdm_chk;
+
+static struct rdm_ent *rconn_names_table(time_t now)
+{
+	struct stat st;
+
+	if (now - rdm_chk >= 5) {
+		rdm_chk = now;
+		if (stat(RDM_PATH, &st) != 0 || st.st_size < (off_t)RDM_SIZE) {
+			if (rdm_map) {
+				munmap(rdm_map, RDM_SIZE);
+				rdm_map = NULL;
+				rdm_ino = 0;
+			}
+		} else if (!rdm_map || st.st_ino != rdm_ino) {
+			int fd = open(RDM_PATH, O_RDWR);
+
+			if (rdm_map)
+				munmap(rdm_map, RDM_SIZE);
+			rdm_map = fd < 0 ? NULL : mmap(NULL, RDM_SIZE, PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0);
+			if (rdm_map == MAP_FAILED)
+				rdm_map = NULL;
+			if (fd >= 0)
+				close(fd);
+			rdm_ino = rdm_map ? st.st_ino : 0;
+		}
+	}
+	if (!rdm_map || ((struct rdm_hdr *)rdm_map)->magic != RDM_MAGIC)
+		return NULL;
+	return rdm_table(rdm_map);
+}
