+/* reaper 2026-10-04: every live LAN bridge and its IPv4 subnet, so a flow
+ * from a guest / SDN / VLAN bridge is attributed to its device. The nvram
+ * lan_ipaddr + lan_netmask pair names br0 only; the Flow Explorer labelled a
+ * flow from any other bridge with the router's WAN address (owner, br55).
+ * Enumerated from the live interfaces, as rtrafd's brsub_refresh() does, so a
+ * bridge counts the moment it exists - one SIOCGIFCONF per poll, no nvram. */
+#define RCONN_NBR 16
+struct rconn_brsub { uint32_t net, mask, addr; };	/* host order; addr = the bridge's own address */
+
+static int rconn_brsubs(struct rconn_brsub *out, int max)
+{
+	struct ifconf ifc;
+	struct ifreq buf[32], ifr;
+	int s, i, n, k = 0;
+
+	if ((s = socket(AF_INET, SOCK_DGRAM, 0)) < 0)
+		return 0;
+	memset(&ifc, 0, sizeof(ifc));
+	ifc.ifc_len = sizeof(buf);
+	ifc.ifc_req = buf;
+	if (ioctl(s, SIOCGIFCONF, &ifc) < 0) {
+		close(s);
+		return 0;
+	}
+	n = ifc.ifc_len / (int)sizeof(struct ifreq);
+	for (i = 0; i < n && k < max; i++) {
+		uint32_t a, m;
+
+		if (strncmp(buf[i].ifr_name, "br", 2) != 0) continue;	/* LAN bridges only */
+		if (buf[i].ifr_addr.sa_family != AF_INET) continue;
+		a = ntohl(((struct sockaddr_in *)&buf[i].ifr_addr)->sin_addr.s_addr);
+		memset(&ifr, 0, sizeof(ifr));
+		strlcpy(ifr.ifr_name, buf[i].ifr_name, sizeof(ifr.ifr_name));
+		if (ioctl(s, SIOCGIFNETMASK, &ifr) < 0) continue;
+		m = ntohl(((struct sockaddr_in *)&ifr.ifr_addr)->sin_addr.s_addr);
+		if (!m) continue;
+		out[k].mask = m;
+		out[k].net = a & m;
+		out[k].addr = a;
+		k++;
+	}
+	close(s);
+	return k;
+}
+
+static int rconn_is_lan(const struct rconn_brsub *bs, int n, uint32_t ip)
+{
+	int i;
+
+	for (i = 0; i < n; i++)
+		if ((ip & bs[i].mask) == bs[i].net) return 1;
+	return 0;
+}
