diff --git a/release/src/router/httpd/reaper_survey.c b/release/src/router/httpd/reaper_survey.c
new file mode 100755
index 0000000000..a9d6fe7eb9
--- /dev/null
+++ b/release/src/router/httpd/reaper_survey.c
@@ -0,0 +1,405 @@
+/* SPDX-License-Identifier: GPL-2.0-only
+ * Copyright (C) 2026 the Reaper project maintainer
+ * Part of the Reaper hardened Asuswrt-Merlin build. See LICENSE / LICENSE.reaper.
+ *
+ * Parser for the text of `wl escanresults` (Broadcom wl utility, dump_bss_info).
+ * One network prints as, for example:
+ *
+ *   SSID: "MyNet"
+ *   Mode: Managed   RSSI: -45 dBm   SNR: 50 dB   noise: -95 dBm   Flags: RSSI on-channel   Channel: 36/80
+ *   BSSID: 00:11:22:33:44:55   Capability: ESS RRM
+ *   Supported Rates: [ 6(b) 9 12(b) 18 24(b) 36 48 54 ]
+ *   HT Capable:
+ *           Chanspec: 5GHz channel 42 80MHz (0xe02a)
+ *           Primary channel: 36
+ *   VHT Capable:
+ *   HE Capable:
+ *   EHT Capable:
+ *   RSN:
+ *           multicast cipher: AES-CCMP
+ *           unicast ciphers(1): AES-CCMP
+ *           AKM Suites(2): WPA2-PSK WPA3-SAE
+ *
+ * The record starts at "SSID:" and ends at the next "SSID:" or EOF. Only the
+ * lines named above are read; anything else is skipped, so a field the driver
+ * does not print, or prints differently, degrades to "not reported" rather than
+ * to a lost record. rpunctd already parses the SSID / RSSI / Channel lines of
+ * this very output on metal (rpunctd/rpunctd.c execute_scan), which is what
+ * makes those three the anchors here. */
+#include <ctype.h>
+#include <stdlib.h>
+#include <string.h>
+#include "reaper_survey.h"
+
+int rsvy_parse_cs(const char *s, int *band, int *chan, int *width)
+{
+	const char *p = s;
+	char *e;
+	int six = 0, ch, w = 20;
+
+	if (!s || !*s)
+		return 0;
+	if (strncmp(p, "6g", 2) == 0) {
+		six = 1;
+		p += 2;
+	}
+	ch = (int)strtol(p, &e, 10);
+	if (e == p || ch <= 0 || ch > 255)
+		return 0;
+	if (*e == 'l' || *e == 'u') {
+		w = 40;
+		e++;
+	} else if (*e == '/') {
+		w = atoi(e + 1);
+		if (w != 40 && w != 80 && w != 160 && w != 320)
+			return 0;
+	}
+	/* anything else trailing (a space, "(0x...)", "-1" of a 320 block) is fine */
+	*band = six ? 6 : (ch <= 14 ? 2 : 5);
+	*chan = ch;
+	*width = w;
+	return 1;
+}
+
+void rsvy_json_str(FILE *out, const char *s)
+{
+	fputc('"', out);
+	for (; *s; s++) {
+		unsigned char c = (unsigned char)*s;
+		if (c == '"' || c == '\\') {
+			fputc('\\', out);
+			fputc(c, out);
+		} else if (c < 0x20) {
+			fprintf(out, "\\u%04x", c);
+		} else {
+			fputc(c, out);
+		}
+	}
+	fputc('"', out);
+}
+
+/* the number after "<key>" on a line, e.g. key "RSSI: " -> -45; 0 when absent */
+static int num_after(const char *line, const char *key)
+{
+	const char *q = strstr(line, key);
+	if (!q)
+		return 0;
+	return atoi(q + strlen(key));
+}
+
+/* append a space-separated word once */
+static void sec_add(struct rsvy_ap *ap, const char *w, size_t n)
+{
+	char tok[24];
+	size_t l = strlen(ap->sec);
+	const char *p;
+
+	if (n == 0 || n >= sizeof(tok))
+		return;
+	memcpy(tok, w, n);
+	tok[n] = 0;
+	/* already listed? (whole-word match) */
+	p = ap->sec;
+	while ((p = strstr(p, tok)) != NULL) {
+		int at_start = (p == ap->sec || p[-1] == ' ');
+		int at_end = (p[n] == 0 || p[n] == ' ');
+		if (at_start && at_end)
+			return;
+		p += n;
+	}
+	if (l + 1 + n >= sizeof(ap->sec))
+		return;
+	if (l) {
+		ap->sec[l] = ' ';
+		l++;
+	}
+	memcpy(ap->sec + l, tok, n + 1);
+}
+
+/* wl prints an SSID with a backslash doubled and every non-printable byte as
+ * a backslash-x hex pair (a hidden network's zero-length or all-zero name
+ * arrives as "" or as a run of zero pairs). Undo that so a UTF-8 name reaches
+ * the page as UTF-8; a decoded zero byte ends the name, which is what makes an
+ * all-zero SSID read as hidden. */
+static void ssid_decode(char *dst, size_t dn, const char *src, size_t sn)
+{
+	size_t i = 0, o = 0;
+
+	while (i < sn && o + 1 < dn) {
+		unsigned char c = (unsigned char)src[i];
+		if (c == '\\' && i + 1 < sn && src[i + 1] == '\\') {
+			dst[o++] = '\\';
+			i += 2;
+		} else if (c == '\\' && i + 3 < sn && src[i + 1] == 'x' &&
+			   isxdigit((unsigned char)src[i + 2]) && isxdigit((unsigned char)src[i + 3])) {
+			char h[3];
+			unsigned v;
+			h[0] = src[i + 2];
+			h[1] = src[i + 3];
+			h[2] = 0;
+			v = (unsigned)strtoul(h, NULL, 16);
+			if (v == 0)
+				break;			/* NUL: the name ends here */
+			dst[o++] = (char)v;
+			i += 4;
+		} else {
+			dst[o++] = (char)c;
+			i++;
+		}
+	}
+	dst[o] = 0;
+}
+
+static int flush(struct rsvy_ap *ap, int have, int radio_band, rsvy_cb cb, void *ctx, int *n)
+{
+	int b, c, w;
+
+	if (!have || !ap->bssid[0])
+		return 0;
+	if (rsvy_parse_cs(ap->cs, &b, &c, &w)) {
+		ap->band = b;
+		ap->chan = c;
+		ap->width = w;
+	} else {
+		ap->band = radio_band;
+		ap->chan = 0;
+		ap->width = 0;
+	}
+	if (!ap->sec[0])
+		strcpy(ap->sec, "Open");
+	ap->hidden = (ap->ssid[0] == 0);
+	(*n)++;
+	return cb(ap, ctx);
+}
+
+int rsvy_parse_escan_err(FILE *in, int radio_band, rsvy_cb cb, void *ctx, char *err, size_t errn)
+{
+	char line[1024];
+	struct rsvy_ap ap;
+	int have = 0, n = 0, in_sec = 0, wep = 0;
+
+	memset(&ap, 0, sizeof(ap));
+	while (fgets(line, sizeof(line), in)) {
+		char *p = line;
+		size_t l = strlen(line);
+
+		while (l && (line[l - 1] == '\n' || line[l - 1] == '\r'))
+			line[--l] = 0;
+		while (*p == ' ' || *p == '\t')
+			p++;
+
+		/* the utility's own words - "wl: Scan Rejected" on a radio that may not
+		 * leave its radar block, a timeout - are not records; keep the first */
+		if (err != NULL && err[0] == 0 && *p &&
+		    (strncmp(p, "wl:", 3) == 0 || strstr(p, "Scan Rejected") || strstr(p, "Timeout") || strstr(p, "timed out"))) {
+			size_t i2, o2 = 0;
+			for (i2 = 0; p[i2] && o2 + 1 < errn; i2++) {
+				unsigned char c = (unsigned char)p[i2];
+				err[o2++] = (c >= 0x20 && c < 0x7f) ? (char)c : ' ';
+			}
+			err[o2] = 0;
+			continue;
+		}
+		if (strncmp(p, "SSID:", 5) == 0) {
+			char *q, *e;
+
+			if (wep && !ap.sec[0])
+				strcpy(ap.sec, "WEP");
+			if (flush(&ap, have, radio_band, cb, ctx, &n))
+				return n;
+			memset(&ap, 0, sizeof(ap));
+			have = 1;
+			in_sec = 0;
+			wep = 0;
+			q = strchr(p, '"');
+			e = q ? strrchr(q + 1, '"') : NULL;
+			if (q && e && e > q)
+				ssid_decode(ap.ssid, sizeof(ap.ssid), q + 1, (size_t)(e - q - 1));
+			continue;
+		}
+		if (!have)
+			continue;
+
+		if (strstr(p, "RSSI: ") && strstr(p, "Channel: ")) {
+			const char *q = strstr(p, "Channel: ") + 9;
+			size_t cl = strcspn(q, " \t(");
+			ap.rssi = num_after(p, "RSSI: ");
+			ap.snr = num_after(p, "SNR: ");
+			ap.noise = num_after(p, "noise: ");
+			if (cl >= sizeof(ap.cs))
+				cl = sizeof(ap.cs) - 1;
+			memcpy(ap.cs, q, cl);
+			ap.cs[cl] = 0;
+			continue;
+		}
+		if (strncmp(p, "BSSID:", 6) == 0) {
+			const char *q = p + 6;
+			int i;
+			while (*q == ' ' || *q == '\t')
+				q++;
+			for (i = 0; i < 17 && q[i] && q[i] != ' ' && q[i] != '\t'; i++)
+				ap.bssid[i] = (char)tolower((unsigned char)q[i]);
+			ap.bssid[i] = 0;
+			if (i != 17)
+				ap.bssid[0] = 0;	/* not a MAC - the record is dropped at flush */
+			if (strstr(p, "Capability:") && (strstr(p, " WEP") || strstr(p, "Privacy")))
+				wep = 1;
+			continue;
+		}
+		if (strncmp(p, "EHT Capable", 11) == 0) { if (ap.phy < 7) ap.phy = 7; continue; }
+		if (strncmp(p, "HE Capable", 10) == 0)  { if (ap.phy < 6) ap.phy = 6; continue; }
+		if (strncmp(p, "VHT Capable", 11) == 0) { if (ap.phy < 5) ap.phy = 5; continue; }
+		if (strncmp(p, "HT Capable", 10) == 0)  { if (ap.phy < 4) ap.phy = 4; continue; }
+		if (strcmp(p, "RSN:") == 0 || strcmp(p, "WPA:") == 0) {
+			in_sec = 1;
+			continue;
+		}
+		if (in_sec && strncmp(p, "AKM Suites", 10) == 0) {
+			const char *q = strchr(p, ':');
+			if (q) {
+				q++;
+				while (*q) {
+					size_t wl;
+					while (*q == ' ' || *q == '\t')
+						q++;
+					wl = strcspn(q, " \t");
+					if (!wl)
+						break;
+					sec_add(&ap, q, wl);
+					q += wl;
+				}
+			}
+			continue;
+		}
+	}
+	/* a WEP network has no RSN/WPA block: the Capability flag is all there is */
+	if (wep && !ap.sec[0])
+		strcpy(ap.sec, "WEP");
+	flush(&ap, have, radio_band, cb, ctx, &n);
+	return n;
+}
+
+int rsvy_parse_escan(FILE *in, int radio_band, rsvy_cb cb, void *ctx)
+{
+	return rsvy_parse_escan_err(in, radio_band, cb, ctx, NULL, 0);
+}
+
+/* The channel block a radio sits in: rpunctd's proven block maths (its passive
+ * confirmation scans name exactly these channels and the driver accepts them
+ * on a radio that refuses a full-band scan), extended to 40 MHz pairs and to
+ * a single 20 MHz channel. */
+static const int rsvy_p5_80[] = { 36, 52, 100, 116, 132, 149, 165, 0 };
+static const int rsvy_p5_160[] = { 36, 100, 149, 0 };
+
+static int rsvy_block_start(int is6g, int ch, int width, int range2)
+{
+	int i;
+
+	if (!is6g) {
+		const int *l = width == 160 ? rsvy_p5_160 : width == 80 ? rsvy_p5_80 : NULL;
+
+		if (l == NULL)
+			return -1;
+		for (i = 0; l[i]; i++)
+			if (ch >= l[i] && ch <= l[i] + width / 5 - 4)
+				return l[i];
+		return -1;
+	}
+	if (width == 80)
+		return 1 + 16 * ((ch - 1) / 16);
+	if (width == 160)
+		return 1 + 32 * ((ch - 1) / 32);
+	if (width == 320)
+		return range2 ? (ch < 33 ? -1 : 33 + 64 * ((ch - 33) / 64)) : 1 + 64 * ((ch - 1) / 64);
+	return -1;
+}
+
+int rsvy_home_chans(const char *cs, char *out, size_t n)
+{
+	int band, ch, width, is6g, start, cnt, i, k = 0;
+	size_t len, o = 0;
+	char lu = 0;
+
+	out[0] = 0;
+	if (!rsvy_parse_cs(cs, &band, &ch, &width))
+		return 0;
+	is6g = (band == 6);
+	len = strlen(cs);
+	while (len && (cs[len - 1] == ' ' || cs[len - 1] == '\t'))
+		len--;
+	if (len && (cs[len - 1] == 'l' || cs[len - 1] == 'u'))
+		lu = cs[len - 1];
+	if (width <= 20) {
+		start = ch;
+		cnt = 1;
+	} else if (width == 40) {
+		cnt = 2;
+		if (lu == 'l')
+			start = ch;
+		else if (lu == 'u')
+			start = ch - 4;
+		else if (band == 2) {
+			start = ch;
+			cnt = 1;	/* no side given: the primary alone */
+		} else if (is6g)
+			start = 1 + 8 * ((ch - 1) / 8);
+		else if (ch >= 149)
+			start = 149 + 8 * ((ch - 149) / 8);
+		else
+			start = 36 + 8 * ((ch - 36) / 8);
+	} else {
+		start = rsvy_block_start(is6g, ch, width, strstr(cs, "320-2") != NULL);
+		cnt = width / 20;
+		if (start < 0) {
+			start = ch;
+			cnt = 1;
+		}
+	}
+	for (i = 0; i < cnt; i++) {
+		int w = snprintf(out + o, n - o, "%s%s%d", i ? "," : "", is6g ? "6g" : "", start + 4 * i);
+
+		if (w < 0 || (size_t)w >= n - o) {
+			out[o] = 0;
+			break;
+		}
+		o += (size_t)w;
+		k++;
+	}
+	return k;
+}
+
+int rsvy_chans_nonradar(char *list)
+{
+	char out[160], tok[16];
+	size_t o = 0, i = 0, n, tl;
+	int k = 0;
+
+	out[0] = 0;
+	while (list[i]) {
+		n = strcspn(list + i, ",");
+		tl = n < sizeof(tok) ? n : sizeof(tok) - 1;
+		memcpy(tok, list + i, tl);
+		tok[tl] = 0;
+		i += n;
+		if (list[i] == ',')
+			i++;
+		if (!tok[0])
+			continue;
+		if (strncmp(tok, "6g", 2) != 0) {
+			int ch = atoi(tok);
+
+			if (ch >= 52 && ch <= 144)
+				continue;
+		}
+		if (o + tl + 2 > sizeof(out))
+			break;
+		if (o)
+			out[o++] = ',';
+		memcpy(out + o, tok, tl);
+		o += tl;
+		out[o] = 0;
+		k++;
+	}
+	strcpy(list, out);	/* never longer than what came in */
+	return k;
+}
diff --git a/release/src/router/httpd/reaper_survey.h b/release/src/router/httpd/reaper_survey.h
new file mode 100755
index 0000000000..b469c8209f
--- /dev/null
+++ b/release/src/router/httpd/reaper_survey.h
@@ -0,0 +1,78 @@
+/* SPDX-License-Identifier: GPL-2.0-only
+ * Copyright (C) 2026 the Reaper project maintainer
+ * Part of the Reaper hardened Asuswrt-Merlin build. See LICENSE / LICENSE.reaper.
+ *
+ * reaper_survey: parse the text that `wl -i <ifname> escanresults` prints into one
+ * record per network heard. Pure libc - no httpd or nvram dependency - so the
+ * host test (build-scripts/tests/test_site_survey.py) compiles this file as-is.
+ *
+ * Why this exists (2026-10-04, RT-BE86U field report "Site Survey shows nothing
+ * beyond channel 44"): the stock Network Tools survey runs the prebuilt
+ * wlcscan_core_escan(), which collects the driver's escan events into a fixed
+ * buffer ("Memory not enough for scan results") and so lists only the first
+ * networks the scan meets, in channel order. The Reaper page reads the wl
+ * utility's own text instead - every network, every channel the regulatory
+ * domain allows - and never touches the running chanspec, the puncturing
+ * bitmap or the minimum-width exclusions, none of which bound a scan.
+ *
+ * Correction (2026-10-04, owner RT-BE96U on r4): a 5 GHz radio that sits on a
+ * 160 MHz block containing radar channels under in-service monitoring answers
+ * a full-band scan request with "Scan Rejected", active and passive alike -
+ * such a radio may not leave its block. That, more than the buffer, is why the
+ * stock page on the RT-BE86U (36/160) listed only the channels inside its
+ * block. rsvy_home_chans() derives that block so the page can at least listen
+ * there and say so. */
+#ifndef REAPER_SURVEY_H
+#define REAPER_SURVEY_H
+
+#include <stdio.h>
+
+#define RSVY_SSID_MAX	128	/* wl prints up to 32 bytes, non-printables as \xNN */
+#define RSVY_SEC_MAX	48
+
+struct rsvy_ap {
+	char ssid[RSVY_SSID_MAX];	/* as printed, quotes stripped; "" = hidden */
+	char bssid[18];			/* lower-case aa:bb:cc:dd:ee:ff */
+	char cs[20];			/* chanspec as printed: 36/80, 157l, 6g37/320-1, 6 */
+	int band;			/* 2, 5 or 6 */
+	int chan;			/* control channel */
+	int width;			/* 20, 40, 80, 160 or 320 MHz */
+	int rssi;			/* dBm; 0 = not reported */
+	int noise;			/* dBm; 0 = not reported */
+	int snr;			/* dB; 0 = not reported */
