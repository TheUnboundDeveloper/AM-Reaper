+			snprintf(cmd, sizeof(cmd), "/usr/sbin/wl -i %s chanspec 2>/dev/null", ifn);
+			if (!hx)
+				hx = rsvy_cmd_hex(cmd, NULL);	/* an old two-field file: the configured value is still the original */
+			logmessage("reaper_survey", "%s: a previous move-scan did not return - setting %s back now (%s)",
+				ifn, cs, (hx && rsvy_cs_apply(ifn, hx) == 0) ? "done" : "FAILED, set the channel on the Wireless page");
+		}
+	}
+	fclose(f);
+	unlink(RWIFI_SVYMV);
+}
