+/* r12 metal (owner, 2026-10-05): helpers for the live channel move.
+ * rsvy_cmd_hex: the first "0x..." number on the first output line of cmd that contains key
+ * (any line when key is NULL), 0 when there is none - reads `wl chanspec` "40/160 (0xe932)",
+ * `wl chanspecs` rows, and the OPERATING chanspec in `wl status` ("Chanspec: ... (0xe932)").
+ * The pipe is always drained so the utility never blocks on a full pipe. */
+static unsigned int rsvy_cmd_hex(const char *cmd, const char *key)
+{
+	FILE *p = popen(cmd, "r");
+	char ln[256], *h;
+	unsigned int v = 0;
+
+	if (p == NULL)
+		return 0;
+	while (fgets(ln, sizeof(ln), p) != NULL)
+		if (!v && (!key || strstr(ln, key)) && (h = strstr(ln, "0x")) != NULL)
+			v = (unsigned int)strtoul(h, NULL, 16);
+	pclose(p);
+	return v;
+}
+
+/* does any output line of cmd contain needle as a whole word ("bgdfs" in `wl cap`) */
+static int rsvy_cmd_has(const char *cmd, const char *needle)
+{
+	FILE *p = popen(cmd, "r");
+	char ln[512], *h;
+	size_t nl = strlen(needle);
+	int hit = 0;
+
+	if (p == NULL)
+		return 0;
+	while (fgets(ln, sizeof(ln), p) != NULL)
+		for (h = ln; !hit && (h = strstr(h, needle)) != NULL; h += nl)
+			if ((h == ln || h[-1] == ' ' || h[-1] == '\t') && (h[nl] == 0 || h[nl] == ' ' || h[nl] == '\t' || h[nl] == '\n' || h[nl] == '\r'))
+				hit = 1;
+	pclose(p);
+	return hit;
+}
