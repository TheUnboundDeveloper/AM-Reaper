+/* want = a radio unit, or -1 for every radio in turn */
+static void rwifi_survey_worker(int want, int move)
+{
+	static struct rsvy_ap aps[RSVY_MAX];
+	static int unit_of[RSVY_MAX];
+	struct rsvy_radio rad[RWIFI_MAXUNIT + 1];
+	struct rsvy_merge m;
+	char ifname[32], cmd[256], nvk[32], csbuf[64], home[96], nonr[96], prim[16], copt[112];
+	int unit, nrad = 0, total = 0, idx = 0, aborted = 0, t;
+	time_t ts = time(NULL);
+
+	memset(&m, 0, sizeof(m));
+	m.ap = aps;
+	m.unit_of = unit_of;
+	/* r12 metal (owner, 2026-10-05): this worker is forked from httpd without an exec, so it inherited
+	 * httpd's chld_reap (a SIGCHLD loop over waitpid(-1)). It reaped every popen child before pclose()
+	 * could, every exit status read -1, and a clean scan that heard nothing showed "Error: exit -1". */
+	signal(SIGCHLD, SIG_DFL);
+	rwifi_token_own(RWIFI_VRUN, "survey");
+	rwifi_survey_restore();
+	for (unit = 0; unit <= RWIFI_MAXUNIT; unit++) {	/* radios to visit, for the progress bar */
+		if (want >= 0 && unit != want)
+			continue;
+		if (rwifi_ifname(unit, ifname, sizeof(ifname)))
+			total++;
+	}
+	rwifi_survey_publish(0, 0, ts, "", 0, total, rad, 0, &m);
+	for (unit = 0; unit <= RWIFI_MAXUNIT; unit++) {
+		struct rsvy_radio *r;
+		struct timespec t0, t1;
+		FILE *p;
+		int band, rc;
+
+		if (want >= 0 && unit != want)
+			continue;
+		if (!rwifi_ifname(unit, ifname, sizeof(ifname)))
+			continue;
+		if (access(RWIFI_VRUN, F_OK) != 0) {	/* svystop unlinked the token */
+			aborted = 1;
+			break;
+		}
+		r = &rad[nrad];
+		memset(r, 0, sizeof(*r));
+		r->unit = unit;
+		strlcpy(r->ifname, ifname, sizeof(r->ifname));
+		snprintf(nvk, sizeof(nvk), "wl%d_nband", unit);
+		r->nband = nvram_get_int(nvk);
+		band = r->nband == 2 ? 2 : r->nband == 4 ? 6 : 5;
+		idx++;
+		rwifi_survey_publish(0, 0, ts, ifname, idx, total, rad, nrad, &m);
+		snprintf(nvk, sizeof(nvk), "wl%d_radio", unit);
+		if (!nvram_get_int(nvk)) {
+			r->err = 2;			/* radio off: nothing to listen with */
+			nrad++;
+			continue;
+		}
+		clock_gettime(CLOCK_MONOTONIC, &t0);
+		m.unit = unit;
+		rc = -1;
+		/* the one command, with the one charset-checked variable, plus a channel
+		 * list that is our own digits. Metal 2026-10-04 (owner RT-BE96U, r3 then
+		 * r4): the 5 GHz radio on 40/160 - radar channels under in-service
+		 * monitoring - answers a full-band escan with "Scan Rejected", active and
+		 * passive alike: such a radio may not leave its block. rpunctd's passive
+		 * scan of that same radio succeeds every day because it names only the
+		 * block's own channels. So: active, full band; passive, full band, a second
+		 * later (also covers a scan already in progress); then passive on the
+		 * radio's own block, reported as such. stderr rides with stdout and the
+		 * utility's first non-record line - its error - reaches the page. */
+		home[0] = 0;
+		nonr[0] = 0;
+		prim[0] = 0;
+		/* a 5 GHz radio under radar monitoring (in-service monitoring, or a
+		 * channel availability check) refuses every scan request on this
+		 * platform - active, passive, its own block, prohibited channels (owner
+		 * r5 metal, 2026-10-04). The stock survey core moves such a radio to a
+		 * non-radar chanspec for its scan and sets it back afterwards (read from
+		 * the prebuilt wlcscan_core_escan); that is an owner decision, so the page
+		 * says what is going on instead of a bare error. */
+		if (r->nband == 1) {
+			snprintf(cmd, sizeof(cmd), "/usr/sbin/wl -i %s dfs_status 2>/dev/null", ifname);
+			if ((p = popen(cmd, "r")) != NULL) {
+				char dl[160];
+
+				if (fgets(dl, sizeof(dl), p) != NULL) {
+					if (strstr(dl, "In-Service Monitoring") || strstr(dl, "Channel Availability Check"))
+						r->dfs = 1;
+					rsvy_safe_line(r->dfsl, sizeof(r->dfsl), dl);	/* shown as the line's tooltip */
+				}
+				pclose(p);
+			}
+		}
+		snprintf(cmd, sizeof(cmd), "/usr/sbin/wl -i %s chanspec 2>/dev/null", ifname);
+		if ((p = popen(cmd, "r")) != NULL) {
+			if (fgets(csbuf, sizeof(csbuf), p) != NULL) {
+				int cb, cc, cw;
+
+				csbuf[strcspn(csbuf, " \t\r\n")] = 0;
+				rsvy_home_chans(csbuf, home, sizeof(home));
+				strlcpy(nonr, home, sizeof(nonr));
+				rsvy_chans_nonradar(nonr);
+				if (rsvy_parse_cs(csbuf, &cb, &cc, &cw))
+					snprintf(prim, sizeof(prim), "%s%d", cb == 6 ? "6g" : "", cc);
+			}
+			pclose(p);
+		}
+		/* r5 metal (owner, 2026-10-04 21:50): 6 GHz answered the passive full-band
+		 * try; 5 GHz refused even its own block. So the narrowing goes on: the
+		 * block without its radar channels (52-144 are what in-service monitoring
+		 * forbids off channel - the stock page on the tester's 36/160 box listed
+		 * exactly 36-44), then the primary alone. A refusal returns at once, so
+		 * each extra try costs about a second. */
+		for (r->tries = 0, t = 0; t < 5; t++) {
+			const char *lst = t == 2 ? home : t == 3 ? nonr : t == 4 ? prim : NULL;
+
+			if (t >= 2 && (!lst[0] || (t == 3 && strcmp(nonr, home) == 0) ||
+				       (t == 4 && (strcmp(prim, nonr) == 0 || strcmp(prim, home) == 0))))
+				continue;
+			copt[0] = 0;
+			if (lst)
+				snprintf(copt, sizeof(copt), " -c %s", lst);
+			r->passive = (t >= 1);
+			r->home = t >= 2 ? t - 1 : 0;	/* 1 own block, 2 its non-radar part, 3 the primary alone */
+			r->tries++;
+			if (r->tries > 1)
+				sleep(1);
+			m.heard = 0;
+			r->msg[0] = 0;
+			snprintf(cmd, sizeof(cmd), "/usr/sbin/wl -i %s escanresults%s%s 2>&1",
+				 ifname, r->passive ? " -t passive" : "", copt);
+			if ((p = popen(cmd, "r")) != NULL) {
+				rsvy_parse_escan_err(p, band, rsvy_merge_cb, &m, r->msg, sizeof(r->msg));
+				rc = pclose(p);
+			} else
+				rc = -1;
+			if (m.heard > 0 || access(RWIFI_VRUN, F_OK) != 0)
+				break;
+			/* owner ruling 2026-10-04 (option 1): the radio is never moved off its
+			 * radar channel, and under monitoring every narrower request is refused
+			 * just the same - the first refusal is the answer, report it at once */
+			if (r->dfs && r->msg[0])
+				break;
+		}
+		/* owner 2026-10-05 ("Scan with channel move"): an explicit, per-click request to do what
+		 * the stock survey core does - move a 5 GHz radio that heard nothing in place to a non-radar
+		 * chanspec, scan the whole band there, and put it back. The click decides, not our radar probe:
+		 * any 5 GHz radio with no result is moved (r12 metal).
+		 * r12 metal (owner, 2026-10-05): `wl chanspec X` on a running radio changes only the CONFIGURED
+		 * chanspec - its get echoes the new value while the radio stays put - so the old settle check
+		 * passed and the scan was refused on 40/160 again. Stock wlcscan_core (prebuilt broadcom.o)
+		 * applies the move with the "acs_update" iovar after the chanspec, and returns through
+		 * "dfs_ap_move" when the driver has background radar checks (`wl cap` lists bgdfs): the check runs
+		 * on the spare core while the radio keeps serving on the scan channel, then it moves back. The
+		 * move is verified on the OPERATING chanspec (`wl status` Chanspec line); a radio that did not
+		 * move is reported as such, gets no scan, and has only its configuration put back. The original
+		 * goes to RWIFI_SVYMV first ("ifname 40/160 0xe932"; rwifi_survey_restore undoes a killed worker).
+		 * A background return takes about a minute; RWIFI_SVYBK refuses another move meanwhile. */
+		if (move && m.heard == 0 && r->nband == 1 && csbuf[0]) {
+			const char *cand[] = { "36/80", "149/80", NULL };
+			char mv[24] = "", rd[96];
+			unsigned int ocs, ncs = 0;
+			struct stat sb;
+			int i2, settled = 0, rc2 = -1, bg;
+
+			r->mvtry = 1;
+			snprintf(cmd, sizeof(cmd), "/usr/sbin/wl -i %s chanspec 2>/dev/null", ifname);
+			ocs = rsvy_cmd_hex(cmd, NULL);
+			for (i2 = 0; cand[i2] && !mv[0]; i2++) {	/* the first the driver offers that is not where we are */
+				if (strcmp(csbuf, cand[i2]) == 0)
+					continue;
+				snprintf(cmd, sizeof(cmd), "/usr/sbin/wl -i %s chanspecs -b 5 -w 80 2>/dev/null", ifname);
+				if ((p = popen(cmd, "r")) != NULL) {
+					while (fgets(rd, sizeof(rd), p))
+						if (!mv[0] && strncmp(rd, cand[i2], strlen(cand[i2])) == 0 && rd[strlen(cand[i2])] == ' ' && strstr(rd, "0x")) {
+							strlcpy(mv, cand[i2], sizeof(mv));
+							ncs = (unsigned int)strtoul(strstr(rd, "0x"), NULL, 16);
+						}
+					pclose(p);
+				}
+			}
+			if (stat(RWIFI_SVYBK, &sb) == 0 && time(NULL) - sb.st_mtime < 90) {
+				snprintf(r->msg, sizeof(r->msg), "the last move is still returning through a radar check - try again in a minute");
+			} else if (!ocs) {
+				snprintf(r->msg, sizeof(r->msg), "current chanspec unreadable - not moved");
+			} else if (!mv[0] || !ncs) {
+				snprintf(r->msg, sizeof(r->msg), "no non-radar 80 MHz chanspec offered");
+			} else {
+				FILE *rf = fopen(RWIFI_SVYMV, "w");
+
+				if (rf != NULL) {
+					fprintf(rf, "%s %s 0x%x\n", ifname, csbuf, ocs);
+					fclose(rf);
+				}
+				snprintf(cmd, sizeof(cmd), "/usr/sbin/wl -i %s cap 2>/dev/null", ifname);
+				bg = rsvy_cmd_has(cmd, "bgdfs");
+				logmessage("reaper_survey", "%s: moving from %s to %s for a full-band scan - its clients drop for the scan",
+					ifname, csbuf, mv);
+				if (rsvy_cs_apply(ifname, ncs) != 0) {
+					snprintf(r->msg, sizeof(r->msg), "the driver refused chanspec %s", mv);
+				} else {
+					snprintf(cmd, sizeof(cmd), "/usr/sbin/wl -i %s status 2>/dev/null", ifname);
+					for (i2 = 0; i2 < 20 && !settled; i2++) {	/* the OPERATING chanspec; a switch counts down beacons */
+						usleep(500000);
+						if (rsvy_cmd_hex(cmd, "Chanspec:") == ncs)
+							settled = 1;
+					}
+					if (!settled)
+						snprintf(r->msg, sizeof(r->msg), "the radio did not leave %.40s - not scanned", csbuf);
+				}
+				if (settled) {
+					sleep(1);				/* beaconing again before the scan */
+					for (t = 0; t < 2 && m.heard == 0; t++) {	/* active, then passive, full band */
+						if (t)
+							sleep(1);
+						r->passive = t;
+						r->tries++;
+						m.heard = 0;
+						r->msg[0] = 0;
+						snprintf(cmd, sizeof(cmd), "/usr/sbin/wl -i %s escanresults%s 2>&1", ifname, t ? " -t passive" : "");
+						if ((p = popen(cmd, "r")) != NULL) {
+							rsvy_parse_escan_err(p, band, rsvy_merge_cb, &m, r->msg, sizeof(r->msg));
+							rc2 = pclose(p);
+						} else
+							rc2 = -1;
+					}
+					rc = rc2;
+					r->home = 0;
+					strlcpy(r->moved, mv, sizeof(r->moved));
+					if (bg && wl_iovar_setint(ifname, "dfs_ap_move", (int)ocs) == 0) {
+						f_write_string(RWIFI_SVYBK, csbuf, 0, 0);
+						logmessage("reaper_survey", "%s: returning to %s after the scan (%d networks) through a background radar check - it keeps serving on %s for about a minute, then moves back",
+							ifname, csbuf, m.heard, mv);
+					} else if (rsvy_cs_apply(ifname, ocs) == 0) {
+						logmessage("reaper_survey", "%s: back on %s after the scan (%d networks); the radar check keeps the radio quiet for about a minute",
+							ifname, csbuf, m.heard);
+					} else
+						logmessage("reaper_survey", "%s: could NOT return to %s - set the channel on the Wireless page", ifname, csbuf);
+				} else {
+					/* nothing moved: put the configured value back, without acs_update - the radio never left */
+					wl_iovar_setint(ifname, "chanspec", (int)ocs);
+					logmessage("reaper_survey", "%s: did not leave %s - configuration put back, no scan", ifname, csbuf);
+				}
+				unlink(RWIFI_SVYMV);
+			}
+		}
+		clock_gettime(CLOCK_MONOTONIC, &t1);
+		r->n = m.heard;
+		r->ms = (int)((t1.tv_sec - t0.tv_sec) * 1000 + (t1.tv_nsec - t0.tv_nsec) / 1000000);
+		/* 0 heard networks; 1 the utility failed (exit status or an error line);
+		 * 2 radio off; 3 ran clean and heard nothing; 4 refused while under radar
+		 * monitoring (every attempt rejected - the platform rule, not a fault) */
+		r->err = m.heard > 0 ? 0 : (rc != 0 || r->msg[0]) ? ((r->dfs && !r->mvtry) ? 4 : 1) : 3;
+		if (r->err == 1 && !r->msg[0])	/* owner 2026-10-05: a bare "Error" said nothing (6 GHz, first run) */
+			snprintf(r->msg, sizeof(r->msg), "exit %d", WIFEXITED(rc) ? WEXITSTATUS(rc) : rc);
+		nrad++;
+		rwifi_survey_publish(0, 0, ts, ifname, idx, total, rad, nrad, &m);
+	}
+	rwifi_survey_publish(1, aborted, ts, "", idx, total, rad, nrad, &m);
+	unlink(RWIFI_VRUN);
+}
