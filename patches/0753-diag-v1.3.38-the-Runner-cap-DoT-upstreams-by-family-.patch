From 2bb521cc45e96a0d8b8e5f4f2513a835c8b5c655 Mon Sep 17 00:00:00 2001
From: reaper <theunbounddeveloper@outlook.com>
Date: Wed, 14 Oct 2026 09:43:13 -0400
Subject: [PATCH] diag: v1.3.38 - the Runner cap, DoT upstreams by family, a
 dead dongle, dongle traps

Section 15 reports the kernel's 4-frag cap (net.core.reaper_tx_sg_max, how
often it fired), TCP's max_skb_frags (4 = the no-build workaround is still
in place), the refused-packet lines in dmesg and syslog (the syslog count
anchored on the kernel's own line: an echoed command once read as "1
refused packet") and tx_dropped per Ethernet port and for the WAN device's
VLAN parent, with a FINDING when a line is present. Section 5 counts the
DNS-over-TLS upstreams by family, never the addresses. Section 7 prints
"dongle: NOT ANSWERING" and a FINDING for a radio that is on in nvram but
whose driver has no adapter. 19b counts dongle traps on the kernel's line,
lists the crash dumps by name, prints the restart lines before each trap
and raises a FINDING; its dmesg summary no longer masks "exceed" as "N"
(a hex run is masked only inside a token that carries a digit). Lean:
tests/test_diag_sanitizer.py runs the new programs under busybox awk, gawk
and mawk.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 release/src/router/others/reaper_diag  | 84 +++++++++++++++++++++++++-
 release/src/router/www/Reaper_Diag.asp |  2 +-
 2 files changed, 82 insertions(+), 4 deletions(-)

diff --git a/release/src/router/others/reaper_diag b/release/src/router/others/reaper_diag
index e7bd51b314d..fc3bbaf0984 100644
--- a/release/src/router/others/reaper_diag
+++ b/release/src/router/others/reaper_diag
@@ -1,6 +1,6 @@
 #!/bin/sh
 # ============================================================================
-#  REAPER-DIAG v1.3.37 (2026-10-13) - sanitized one-shot diagnostic bundle
+#  REAPER-DIAG v1.3.38 (2026-10-14) - sanitized one-shot diagnostic bundle
 #  Runs on ANY Reaper model (RT-BE96U / RT-BE86U / RT-BE88U / GT-BE98 /
 #  GT-BE98_PRO) - radios, ports and features are discovered at runtime.
 #
@@ -108,6 +108,16 @@
 #  word (genericname) is still masked at its template position - the promise stands -
 #  but is no longer masked across the rest of the report.
 #
+#  v1.3.38 (2026-10-14, GT-BE98 field): "skb->nr_frags N exceed max_sg_array 4" is a packet
+#  the Runner dropped (more than 4 page frags on a non-GSO skb), not noise. Section 15
+#  reports the kernel's 4-frag cap (net.core.reaper_tx_sg_max, the times it fired), the
+#  TCP max_skb_frags setting (4 = the no-build workaround is still in place), the line
+#  count in dmesg and syslog and tx_dropped per Ethernet port and for the WAN device's
+#  parent; a FINDING fires when any line is present. Section 5 counts the DNS-over-TLS
+#  upstreams by family (addresses never printed). The 19b dmesg summary masked every
+#  run of six hex-looking letters, which turned "exceed" into "N"; it now masks only
+#  tokens that carry a digit.
+#
 #  TWO RULES FOR ANYONE ADDING A SECTION BELOW:
 #    1. Never emit a container's CONTENTS when its SIZE answers the question.
 #       ipset member lists are dumped with `ipset list -t` (header only) for
@@ -122,7 +132,7 @@
 #  are one-shot cats. Do not add an unbounded command here.
 # ============================================================================
 PATH=/sbin:/bin:/usr/sbin:/usr/bin
-VER="REAPER-DIAG v1.3.37"
+VER="REAPER-DIAG v1.3.38"
 T0="$(date +%s 2>/dev/null)"
 MODEL="$(nvram get productid 2>/dev/null)"
 EXTNO="$(nvram get extendno 2>/dev/null)"
@@ -837,6 +847,15 @@ if [ "$(nvram get reaper_dns_v6names 2>/dev/null)" = 1 ] && S6="$(nvram get ipv6
   finding WARN "IPv6 device names is on but its daemon (rv6names) is not running - LAN devices' IPv6 addresses get no names (see 5)"
 fi
 echo "  dns-over-tls      : dnspriv_enable=$(nvram get dnspriv_enable 2>/dev/null)"
+# v1.3.38: upstreams by family, never the addresses (dnspriv_rulelist records are
+# <server>port>hostname>spkipin, '<'-separated). IPv6 DoT through a 6in4 tunnel was the
+# trigger of the Runner 4-frag drops (section 15).
+DOT4=0; DOT6=0; OIFS="$IFS"; IFS='<'
+for e in $(nvram get dnspriv_rulelist 2>/dev/null); do
+  case "${e%%>*}" in *:*) DOT6=$((DOT6+1)) ;; *.*) DOT4=$((DOT4+1)) ;; esac
+done
+IFS="$OIFS"
+echo "  dot upstreams     : ipv4=$DOT4 ipv6=$DOT6  profile=$(nvram get dnspriv_profile 2>/dev/null) reaper_dot_strict=$(nvram get reaper_dot_strict 2>/dev/null)"
 echo "  wanduck           : link_internet=$(nvram get link_internet 2>/dev/null) wandog=$(nvram get wandog_enable 2>/dev/null)"
 # v1.3.22: the log level decides whether rc and wanduck lines exist at all. syslogd -l N keeps
 # only messages MORE urgent than N, and rc's logmessage() writes at message_loglevel, so a box
@@ -932,6 +951,13 @@ u=0; while [ $u -le 3 ]; do
   echo "  -- unit $u  ifname=$IFN  band=$BAND --"
   echo "     radio_on=$(nvram get wl${u}_radio 2>/dev/null)  closed=$(nvram get wl${u}_closed 2>/dev/null)  country=$(nvram get wl${u}_country_code 2>/dev/null)"
   echo "     chanspec: $(wl -i $IFN chanspec 2>/dev/null)"
+  # v1.3.38: a radio that is on in nvram but whose driver has no adapter is a dongle
+  # whose firmware trapped (owner RT-BE96U 2026-10-14: wl1 + wl2 after a restart_net,
+  # clients silently on 2.4 GHz); nothing reloads it, only a power cycle. Say so.
+  if [ "$(nvram get wl${u}_radio 2>/dev/null)" = 1 ] && [ -z "$(wl -i $IFN isup 2>/dev/null)" ]; then
+    echo "     dongle: NOT ANSWERING - $(wl -i $IFN isup 2>&1 | head -1)"
+    finding WARN "wl${u} is enabled but its driver has no adapter - the radio's firmware is down (a dongle trap, see 19b) and stays down until a power cycle; its clients are on the other bands - see 7"
+  fi
   # v1.3.24: Roaming Assistant threshold (0 = off for this band), the Wireless
   # Scheduler (timesched=1 turns the radio off on its schedule; only the length
   # of the schedule string is printed) and, on 5 GHz, the DFS state.
@@ -1590,6 +1616,45 @@ for F in /proc/gdx/skb_idx /proc/gdx/stats /proc/fpm/status /proc/bpm/status; do
     echo "  $F : not present/readable"
   fi
 done
+# v1.3.38: the Runner's CPU-TX path drops a non-GSO skb with more than 4 page frags and
+# the kernel logs "skb->nr_frags N exceed max_sg_array 4" for each one (GT-BE98 field
+# 2026-10-14: 1:1 with eth1 tx_dropped). The kernel cap linearizes those skbs first
+# (net.core.reaper_tx_sg_max, 0 = stock); max_skb_frags=4 is the no-build workaround.
+echo "  -- Runner 4-frag transmit cap --"
+SGMAX="$(cat /proc/sys/net/core/reaper_tx_sg_max 2>/dev/null)"
+if [ -n "$SGMAX" ]; then
+  echo "  kernel cap        : reaper_tx_sg_max=$SGMAX$( [ "$SGMAX" = 0 ] && echo ' (OFF - stock behaviour)')  fired=$(cat /proc/sys/net/core/reaper_tx_sg_linearized 2>/dev/null)"
+else
+  echo "  kernel cap        : not in this kernel"
+fi
+SKBF="$(cat /proc/sys/net/core/max_skb_frags 2>/dev/null)"
+echo "  tcp max_skb_frags : ${SKBF:-?}$( [ "$SKBF" = 4 ] && echo ' (workaround in place - remove it once the kernel cap is present)')"
+SGD="$(dmesg 2>/dev/null | grep -c 'exceed max_sg_array')"
+SGS=0
+# syslog also carries echoed commands (the lab MCP logs every exec verbatim, a shell
+# history mirror may too); count only the kernel's own line (owner box 2026-10-14:
+# one echoed grep read as "1 refused packet" with dmesg at 0)
+for F in /tmp/syslog.log-1 /tmp/syslog.log; do
+  [ -r "$F" ] && SGS=$((SGS + $(grep -c '^[A-Z][a-z]* *[0-9]* [0-9:]* kernel: bdmf_sysb_data_to_sgdesc: ERROR: skb->nr_frags [0-9]* exceed max_sg_array' "$F" 2>/dev/null)))
+done
+echo "  refused packets   : dmesg=${SGD:-0} syslog=$SGS  (each line = one packet dropped)"
+WIF="$(nvram get wan0_ifname 2>/dev/null)"
+WPAR="$(awk -F'|' -v d="$WIF" 'NR>2 { gsub(/ /,"",$1); gsub(/ /,"",$3); if ($1==d) print $3 }' /proc/net/vlan/config 2>/dev/null)"
+TXD=""
+for d in /sys/class/net/eth*; do
+  [ -r "$d/statistics/tx_dropped" ] || continue
+  TXD="$TXD ${d##*/}=$(cat "$d/statistics/tx_dropped" 2>/dev/null)"
+done
+case "$WIF" in ""|eth*) ;; *) [ -r "/sys/class/net/$WIF/statistics/tx_dropped" ] && TXD="$TXD $WIF=$(cat /sys/class/net/$WIF/statistics/tx_dropped 2>/dev/null)" ;; esac
+echo "  tx_dropped        :${TXD:- none readable}${WPAR:+  (WAN $WIF rides $WPAR)}"
+SGN=$SGD; [ "$SGS" -gt "${SGN:-0}" ] 2>/dev/null && SGN=$SGS
+if [ "${SGN:-0}" -gt 0 ] 2>/dev/null; then
+  if [ -n "$SGMAX" ] && [ "$SGMAX" != 0 ]; then
+    finding WARN "the Runner dropped $SGN packet(s) with more than 4 fragments although the kernel cap is on - report it with this diag - see 15"
+  else
+    finding WARN "the Runner dropped $SGN packet(s) with more than 4 fragments (DNS-over-TLS bursts, often IPv6 DoT through a tunnel) - see 15"
+  fi
+fi
 
 sec "16. CONNECTIVITY PROBES (targets named, addresses never printed)"
 # Separates "the router cannot reach the internet" from "a LAN client cannot",
@@ -1781,6 +1846,17 @@ function pe(m,d,t){split(t,T,":");return mn[m]*2629800+d*86400+T[1]*3600+T[2]*60
   # and it was the least trustworthy: on metal 2026-09-10 it read 2 where the
   # truth was 0, both hits being echoed command text.
   echo "  panic/oops/oom    : $(grep -cE 'Kernel panic|Oops:|oom-killer|Out of memory' "$SNAP" 2>/dev/null)   wan link down: $(grep -c 'WAN(0) link down' "$SNAP" 2>/dev/null)   notify_rc reboot: $(grep -c 'notify_rc reboot' "$SNAP" 2>/dev/null)"
+  # v1.3.38: a dongle trap is a radio's firmware crashing (kernel: TRAP type ... @ epc);
+  # debug_monitor keeps a crash dump per trap under crash_log_backup_dir (names carry a
+  # date, a hex signature and the radio - nothing else). The restart that preceded each
+  # trap is the lead: owner RT-BE96U, restart_net twice (2026-10-13, 2026-10-14).
+  _dt=$(grep -cE '^[A-Z][a-z]* *[0-9]* [0-9:]* kernel: TRAP type 0x' "$SNAP" 2>/dev/null)
+  _cd=$(nvram get crash_log_backup_dir 2>/dev/null); [ -n "$_cd" ] || _cd=/data
+  echo "  dongle traps      : $_dt in the snapshot   crash dumps in $_cd: $(ls "$_cd"/debug-*_DHD.tgz 2>/dev/null | wc -l)$(ls -t "$_cd"/debug-*_DHD.tgz 2>/dev/null | head -3 | sed 's#.*/##; s/^/ /' | tr '\n' ' ')"
+  if [ "${_dt:-0}" -gt 0 ] 2>/dev/null; then
+    grep -E 'notify_rc restart_(net|allnet|net_and_phy|wireless|wps_enr|nas)\b|kernel: TRAP type 0x' "$SNAP" 2>/dev/null | grep -v rmcpd-lab | tail -6 | sed 's/^/     /'
+    finding WARN "$_dt dongle trap(s) in the log - a radio's firmware crashed; read the restart lines just before each in 19b (a restart with the radio readers still running was the owner-box cause)"
+  fi
   # v1.3.14: /proc/sys/kernel/tainted is a BITMASK, not a count. 4097 = 0x1001 =
   # proprietary module + out-of-tree module, which is the EXPECTED state on this
   # platform (the wl driver, and tfat/ntfs). Printing the integer made a normal
@@ -1807,7 +1883,9 @@ else
   echo "  no syslog readable"
 fi
 echo "  -- dmesg error summary (counts) --"
-dmesg 2>/dev/null | grep -iE 'error|fail|warn|oops|BUG|timeout|leak|denied' | sed 's/[0-9a-fx]\{6,\}/N/g' | sort | uniq -c | sort -rn | head -12 | awk '{c=$1; $1=""; printf "  %6d %s\n", c, substr($0,2,90)}'
+# v1.3.38: mask long hex/number runs only inside a token that carries a digit - the old
+# sed masked any six hex-looking letters, so "exceed" read as "N".
+dmesg 2>/dev/null | grep -iE 'error|fail|warn|oops|BUG|timeout|leak|denied' | awk '{ for (i = 1; i <= NF; i++) if ($i ~ /[0-9]/) gsub(/[0-9a-fx][0-9a-fx][0-9a-fx][0-9a-fx][0-9a-fx][0-9a-fx]+/, "N", $i); print }' | sort | uniq -c | sort -rn | head -12 | awk '{c=$1; $1=""; printf "  %6d %s\n", c, substr($0,2,90)}'
 
 echo ""; echo "  diag run time     : $(( $(date +%s) - ${T0:-0} )) s"
 echo ""; echo "#### END OF DIAG ####"
diff --git a/release/src/router/www/Reaper_Diag.asp b/release/src/router/www/Reaper_Diag.asp
index 9b8136c9d1c..5764c16818c 100644
--- a/release/src/router/www/Reaper_Diag.asp
+++ b/release/src/router/www/Reaper_Diag.asp
@@ -69,7 +69,7 @@ pre.sample .g{color:var(--jade)} pre.sample .r{color:#e0837d} pre.sample .w{colo
 
 <div class="pagehead">
   <h1><#RDIAG_00#> <a href="https://github.com/TheUnboundDeveloper/AM-Reaper/blob/main/docs/REAPER-GUIDE.md#413-diagnostics" target="_blank" rel="noopener noreferrer" title="<#RABT_43#>" style="display:inline-flex;align-items:center;justify-content:center;width:22px;height:22px;margin-left:8px;border-radius:50%;border:1px solid #4a4a4e;color:#8d897f;font:700 13px Arial,sans-serif;text-decoration:none;vertical-align:middle">?</a></h1>
-  <span class="ver"><#RDIAG_01#> &middot; REAPER-DIAG v1.3.37</span>
+  <span class="ver"><#RDIAG_01#> &middot; REAPER-DIAG v1.3.38</span>
 </div>
 <p class="lede"><#RDIAG_02#></p>
 
