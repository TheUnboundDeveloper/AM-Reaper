diff --git a/release/src/router/rdnsmapd/rdnsmapd.c b/release/src/router/rdnsmapd/rdnsmapd.c
index 9ae527ec54..39402d7713 100644
--- a/release/src/router/rdnsmapd/rdnsmapd.c
+++ b/release/src/router/rdnsmapd/rdnsmapd.c
@@ -14,7 +14,11 @@
  * Mechanism, sized for zero idle cost:
  *   - one AF_PACKET socket, unbound (every interface, both directions), with a
  *     classic BPF filter attached BEFORE bind so the kernel rejects everything
- *     that is not a UDP datagram from port 53 before a byte is copied;
+ *     that is not a UDP datagram from port 53 before a byte is copied; a frame
+ *     whose ingress device is not a LAN bridge (br*) is dropped before parsing
+ *     (audit 2026-10-06 V2: AF_PACKET sits ahead of netfilter, so the WAN INPUT
+ *     policy never applied and an Internet host sending UDP from port 53 at the
+ *     WAN address reached the parser as root);
  *   - a blocking recv: no tick, no timer, no sweep - asleep while the LAN is quiet;
  *   - per reply: parse the ANSWER section and map every A record to the QNAME the
  *     client asked for (every A record there belongs to the question's CNAME
@@ -57,6 +61,7 @@
 #include <linux/filter.h>
 #include <linux/if_ether.h>
 #include <linux/if_packet.h>
+#include <net/if.h>
 #include <arpa/inet.h>
 #include "reaper_dnsmap.h"
 
@@ -70,6 +75,47 @@
 #ifndef RDM_TEST
 static volatile sig_atomic_t running = 1;
 static void on_term(int sig) { (void)sig; running = 0; }
+
+/* audit 2026-10-06 (V2): is the frame's ingress device a LAN bridge? Every reply
+ * a LAN client receives crosses its bridge - the router's own dnsmasq replies
+ * leave through it, a reply forwarded from an external resolver is seen on it
+ * on the way out - so parsing bridge frames only loses nothing and drops the
+ * WAN port and the physical LAN ports (the latter were duplicate sightings).
+ * The verdict is cached per ifindex for 30 s: indexes are reused after a bridge
+ * is removed, so a cached name must not outlive a reconfiguration. */
+#define RDM_IFC 32
+struct rdm_ifc { int idx, lan; time_t at; };
+static struct rdm_ifc rdm_ifcache[RDM_IFC];
+
+static int rdm_lan_if(int idx, time_t now)
+{
+	char name[IF_NAMESIZE];
+	struct rdm_ifc *v = &rdm_ifcache[0];
+	int i;
+
+	if (idx <= 0)
+		return 0;
+	for (i = 0; i < RDM_IFC; i++) {
+		struct rdm_ifc *c = &rdm_ifcache[i];
+
+		if (c->idx == idx) {
+			if (now - c->at < 30)
+				return c->lan;
+			v = c;
+			break;
+		}
+		if (c->idx == 0) {
+			v = c;
+			break;
+		}
+		if (c->at < v->at)
+			v = c;
+	}
+	v->idx = idx;
+	v->at = now;
+	v->lan = if_indextoname((unsigned)idx, name) != NULL && name[0] == 'b' && name[1] == 'r';
+	return v->lan;
+}
 #endif
 
 /* tcpdump -dd 'udp src port 53' (EN10MB). IPv4 or IPv6 outer, UDP, source
@@ -393,8 +439,14 @@ static void rdm_bf_drain(struct pollfd *pf, void *map, const uint32_t *tg, int n
 		left = ms - (int)((t1.tv_sec - t0.tv_sec) * 1000 + (t1.tv_nsec - t0.tv_nsec) / 1000000);
 		if (left <= 0 || poll(pf, 2, left) <= 0)
 			return;
-		if ((pf[0].revents & POLLIN) && (n = (int)recv(pf[0].fd, rb, sizeof(rb), 0)) > 0)
-			rdm_parse(rb, n, map, (uint32_t)time(NULL));
+		if (pf[0].revents & POLLIN) {
+			struct sockaddr_ll from;
+			socklen_t fl = sizeof(from);
+
+			n = (int)recvfrom(pf[0].fd, rb, sizeof(rb), 0, (struct sockaddr *)&from, &fl);
+			if (n > 0 && rdm_lan_if(from.sll_ifindex, time(NULL)))
+				rdm_parse(rb, n, map, (uint32_t)time(NULL));
+		}
 		if ((pf[1].revents & POLLIN) && (n = (int)recv(pf[1].fd, rb, sizeof(rb), 0)) > 0)
 			rdm_parse_ptr(rb, n, map, (uint32_t)time(NULL), tg, ntg);
 	}
@@ -485,13 +537,20 @@ int main(void)
 		rdm_backfill(map, sk);
 
 	while (running) {
-		n = (int)recv(sk, buf, sizeof(buf), 0);
+		struct sockaddr_ll from;
+		socklen_t fl = sizeof(from);
+		time_t now;
+
+		n = (int)recvfrom(sk, buf, sizeof(buf), 0, (struct sockaddr *)&from, &fl);
 		if (n < 0) {
 			if (errno == EINTR)
 				continue;
 			break;
 		}
-		rdm_parse(buf, n, map, (uint32_t)time(NULL));
+		now = time(NULL);
+		if (!rdm_lan_if(from.sll_ifindex, now))
+			continue;			/* the WAN port or a physical LAN port: not ours (V2) */
+		rdm_parse(buf, n, map, (uint32_t)now);
 	}
 	close(sk);
 	munmap(map, RDM_SIZE);
