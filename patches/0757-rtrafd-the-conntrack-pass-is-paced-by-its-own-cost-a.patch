  * cycle is now a small bounded slice per tick: SCAN a few conntrack lines, SEND a
  * few echoes, spool history to RAM (flash flush folds into the hourly db_save). */
 #define HSEND_PER_TICK	16	/* ICMP echoes emitted per base tick (was: all NCLI at once) */
-#define HCONN_PER_TICK	256	/* nf_conntrack lines parsed per base tick */
 #define HBUSY_BPS	(300ULL * 1000000)	/* defer a new cycle while either WAN dir is busier than this (speed-test back-off) */
 #define HSPOOL		"/tmp/rtraf/healthhist.spool"	/* RAM staging for history rows; flushed to the store off the hot loop */
 enum { HP_IDLE = 0, HP_SCAN, HP_SEND, HP_WAIT };	/* v2.2.4 health-cycle phase */
@@ -198,7 +209,13 @@ static int flow_strain = 0;		/* a probe ran long this poll - compact after */
 #define FLOW_STALE_SECS	15
 static int flow_stale(uint32_t g)
 {
-	return (int)(flowgen - g) * FCACHE_SECS >= FLOW_STALE_SECS;
+	/* v3.3.5: a generation is ct_iv_ms long now (paced), so convert with the
+	 * measured interval. A live flow is seen on EVERY pass, so it is never stale
+	 * after fewer than two missed passes - a floor of one would let a slow pass
+	 * reclaim a live flow's slot before the flow is reached in the same pass. */
+	long need = (FLOW_STALE_SECS * 1000L + ct_iv_ms - 1) / ct_iv_ms;
+	if (need < 2) need = 2;
+	return (long)(flowgen - g) >= need;
 }
 
