 					 * FCACHE_SECS and every rate division derive from this). */
 #define PROBE_EVERY	(5 * TPS)	/* ping probe every 5 s */
 #define FCACHE_SECS	(HEAVY_EVERY * TICK_MS / 1000)	/* flow-cache sample interval (s) */
+/* v3.3.5: the conntrack + flow-cache pass is paced by its own measured cost
+ * (ct_pace). FCACHE_SECS is now the FLOOR of that interval, not the interval;
+ * every rate and every seconds-to-passes conversion uses ct_iv_ms, the interval
+ * the current deltas actually span. */
+#define CT_MIN_MS	(FCACHE_SECS * 1000)	/* the normal cadence (2 s) */
+#define CT_MAX_MS	30000	/* never sample slower than this */
+#define CT_BUDGET_PCT	3	/* target share of one core for the pass */
+#define CT_BPS(b)	((uint64_t)(b) * 8 * 1000 / (uint64_t)ct_iv_ms)	/* bytes this pass -> bits/s */
+static long ct_iv_ms = CT_MIN_MS;	/* measured interval the current pass's deltas span */
+static int ct_lines = 0;		/* entries the last pass read (for the pacing log line) */
+static int hp_ct_want = 0;		/* health probe: count TCP connections in the next pass */
+static int hp_ct_ready = 0;		/* health probe: that pass has published its counts */
 #define N5		288	/* 5-min slots  (24 h) */
 #define NH		336	/* hour slots   (14 d) */
 #define ND		366	/* day slots    (~1 y) */
