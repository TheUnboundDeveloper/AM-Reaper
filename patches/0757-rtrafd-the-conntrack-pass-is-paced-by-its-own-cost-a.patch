+/* v3.3.5 (field 2026-10-06, RT-BE88U): a DHT crawler on the LAN held ~10,700
+ * conntrack entries, 9,000 of them unanswered SYNs, and rtrafd used a whole core,
+ * mostly in the kernel. The pass re-reads the entire table and the kernel formats
+ * every line (with Broadcom's accelerated-byte lookup per entry), so its cost grows
+ * with the table, and a fixed 2 s cadence turns a big table into a busy loop. Pace
+ * it by its own measured cost instead: the next pass waits until this one amounts
+ * to CT_BUDGET_PCT of one core - never sooner than the normal 2 s, never later than
+ * CT_MAX_MS. Byte counters are cumulative per connection, so device totals and the
+ * history stay exact; only connections that open AND close between two passes go
+ * uncounted, and the live view refreshes less often while the table is large.
+ * The cost used is the CHEAPEST of the last three reads: a big table makes every
+ * read slow, while a read that merely lost the CPU to something else is a one-off
+ * and must not stretch the interval or log a table size that is not the cause.
+ * Returns the interval in ms; logs each change of state, at most once per 10 min. */
+static long ct_pace(long cost_ms)
+{
+	static long recent[3] = { -1, -1, -1 };	/* last three pass costs, ms; -1 = none yet */
+	static int ri = 0;
+	static int slow = 0;		/* the state last logged */
+	static time_t last_log = 0;
+	long iv, avg = -1;		/* avg: the cost the interval is derived from */
+	int now_slow, k;
+	time_t m;
+
+	if (cost_ms < 0) cost_ms = 0;
+	recent[ri] = cost_ms;
+	ri = (ri + 1) % 3;
+	for (k = 0; k < 3; k++)
+		if (recent[k] >= 0 && (avg < 0 || recent[k] < avg)) avg = recent[k];
+	iv = avg * 100 / CT_BUDGET_PCT;
+	if (iv < CT_MIN_MS) iv = CT_MIN_MS;
+	if (iv > CT_MAX_MS) iv = CT_MAX_MS;
+
+	now_slow = (iv >= 2L * CT_MIN_MS);	/* a margin, so the log cannot flap at the floor */
+	m = mono_secs();
+	if (now_slow != slow && (last_log == 0 || m - last_log >= 600)) {
+		if (now_slow)
+			syslog(LOG_NOTICE, "rtrafd: connection table holds %d entries and one read takes %ld ms - "
+			       "sampling every %ld s to stay near %d%% of one core", ct_lines, avg, iv / 1000, CT_BUDGET_PCT);
+		else
+			syslog(LOG_NOTICE, "rtrafd: connection table down to %d entries - sampling every %d s again",
+			       ct_lines, CT_MIN_MS / 1000);
+		slow = now_slow;
+		last_log = m;
+	}
+	return iv;
+}
