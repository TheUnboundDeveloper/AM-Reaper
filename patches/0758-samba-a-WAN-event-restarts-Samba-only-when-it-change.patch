From 235b6799faa9a577469d64ed450257491a8ac4f5 Mon Sep 17 00:00:00 2001
From: reaper <theunbounddeveloper@outlook.com>
Date: Thu, 15 Oct 2026 14:07:33 -0400
Subject: [PATCH] samba: a WAN event restarts Samba only when it changed what
 smbd binds to

wan_up() stopped and started Samba on every WAN up (first lease, changed
lease, each PPPoE reconnect, a dual-WAN switch), dropping open SMB
sessions, and every WireGuard server restart did it again
(_wg_server_update_service, wgs_lanaccess default 1). The WAN reaches
smb.conf only through "interfaces =": wan0_ifname behind smbd_wanac, and
br0's IPv6 addresses. wan_up() now restarts when SMB over the WAN is on,
when the config or its interfaces line is missing, or when br0 carries an
IPv6 address the line does not list. The WireGuard hook no longer touches
Samba: the only lines naming the tunnel subnets are #if 0 in
write_smb_conf.c, so it regenerated an identical file. Lean:
test_samba_wan_restart.py.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 release/src/router/rc/wan.c       | 38 ++++++++++++++++++++++++++++++-
 release/src/router/rc/wireguard.c | 15 ++++++------
 2 files changed, 45 insertions(+), 8 deletions(-)

diff --git a/release/src/router/rc/wan.c b/release/src/router/rc/wan.c
index e8684e17a31..f4e34af0a7b 100644
--- a/release/src/router/rc/wan.c
+++ b/release/src/router/rc/wan.c
@@ -3941,6 +3941,41 @@ static int dns_in_sdn_subnet(const char *ip)
 }
 #endif
 
+#if defined(RTCONFIG_SAMBASRV) || defined(RTCONFIG_TUXERA_SMBD)
+/* reaper 2026-10-15: stock stopped and started Samba on every wan_up() (first lease, a
+ * changed lease, each PPPoE reconnect, a dual-WAN switch), dropping every open SMB
+ * session. The WAN reaches smb.conf only through its "interfaces =" line
+ * (libdisk/write_smb_conf.c): wan0_ifname when SMB over the WAN (smbd_wanac) is on,
+ * and br0's IPv6 addresses, which no IPv6 path refreshes - the stock restart here did
+ * that as a side effect. So restart only when SMB over the WAN is on, or when br0
+ * carries an IPv6 address the running config does not list. No config file (Samba not
+ * started, or another server) = restart as stock and let start_samba() decide. */
+static int reaper_samba_wan_restart_needed(void)
+{
+	char line[512] = "", buf[512];
+	const char *lan = nvram_safe_get("lan_ifname"), *a;
+	FILE *fp;
+
+	if (nvram_get_int("smbd_wanac"))
+		return 1;
+	if ((fp = fopen("/etc/smb.conf", "r")) == NULL)
+		return 1;
+	while (fgets(buf, sizeof(buf), fp))
+		if (strncmp(buf, "interfaces = ", 13) == 0) {
+			strlcpy(line, buf, sizeof(line));
+			break;
+		}
+	fclose(fp);
+	if (!*line)
+		return 1;
+	if ((a = getifaddr(lan, AF_INET6, 0)) != NULL && *a && !strstr(line, a))
+		return 1;
+	if ((a = getifaddr(lan, AF_INET6, GIF_LINKLOCAL)) != NULL && *a && !strstr(line, a))
+		return 1;
+	return 0;
+}
+#endif
+
 void
 wan_up(const char *pwan_ifname)
 {
@@ -4764,7 +4799,8 @@ NOIP:
 #endif
 
 #if defined(RTCONFIG_SAMBASRV) || defined(RTCONFIG_TUXERA_SMBD)
-	if (nvram_match("enable_samba", "1"))
+	/* reaper 2026-10-15: only when the WAN event changed what smbd binds to */
+	if (nvram_match("enable_samba", "1") && reaper_samba_wan_restart_needed())
 	{
 		stop_samba(0);
 		start_samba();
diff --git a/release/src/router/rc/wireguard.c b/release/src/router/rc/wireguard.c
index b9f1ed158b8..b5c302342d4 100644
--- a/release/src/router/rc/wireguard.c
+++ b/release/src/router/rc/wireguard.c
@@ -1534,13 +1534,14 @@ static int _is_any_wgc_enabled()
 
 static void _wg_server_update_service(const char* prefix)
 {
-#if defined(RTCONFIG_SAMBASRV) || defined(RTCONFIG_TUXERA_SMBD)
-	if (nvram_pf_get_int(prefix, "lanaccess"))
-	{
-		stop_samba(0);
-		start_samba();
-	}
-#endif
+	/* reaper 2026-10-15: stock stopped and started Samba here whenever the server has
+	 * LAN access (wgs_lanaccess, default 1): at boot, on every wan_up() (which restarts
+	 * every server) and on each peer edit, so a WAN event restarted Samba twice. It
+	 * changed nothing: the only smb.conf lines that name the WireGuard client subnets
+	 * ("hosts allow" via get_wgsc_subnet()) sit inside an #if 0 block in
+	 * libdisk/write_smb_conf.c, so the regenerated config was identical and the restart
+	 * only dropped open SMB sessions. */
+	(void)prefix;
 }
 
 void start_wgsall()
-- 
