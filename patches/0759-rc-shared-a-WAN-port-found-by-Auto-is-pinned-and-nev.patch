diff --git a/release/src/router/rc/reaper_wanpin.c b/release/src/router/rc/reaper_wanpin.c
new file mode 100644
index 0000000000..869af46ad6
--- /dev/null
+++ b/release/src/router/rc/reaper_wanpin.c
@@ -0,0 +1,155 @@
+/*
+ * reaper_wanpin.c - once the WAN port is known, it never joins the LAN bridge again.
+ *
+ * reaper v3.3.6 (owner, 2026-10-06: "leaking LAN into WAN is a big no no"). Stock
+ * auto-WAN-port detection (RTCONFIG_AUTO_WANPORT, nvram autowan_enable, default on)
+ * lets the ISP cable go into either candidate port (autowan_ifnames). It can only
+ * find the WAN by BRIDGING: every candidate port is added to br0, a DHCP client runs
+ * on br0 itself (rc/udhcpc.c - the LAN interface briefly carries the ISP address),
+ * and the port the ISP's DHCP/PPPoE server is learned on (brctl showmacs) becomes
+ * the WAN. The closed restore_auto_wanport() (rc/prebuild private.o) undoes the
+ * detection - "addif ... for auto WANPORT", STP off, detection cleared - and stock
+ * calls it at EVERY boot (start_lan) and on EVERY WAN link loss (wanduck, three
+ * places). So the ISP-facing port was a forwarding member of the LAN bridge for
+ * ~35-45 s at each boot and each link loss: LAN broadcast, ARP, mDNS and unicast to
+ * the ISP segment, and frames from it to LAN hosts, bridged past the firewall. The
+ * only stock guard is an ebtables drop of DHCP and IPv6 RS/RA on those ports. Field
+ * (owner's RT-BE96U, 10G fibre): link drops minutes after boots and after the first
+ * recovery, a new ISP subnet each time - consistent with ISP port protection.
+ *
+ * The pin: the first time a port carries the WAN (stock detection, by DHCP or
+ * PPPoE) Reaper records it in nvram reaper_wanport. From then on, in router mode
+ * with auto-detection on:
+ *   - the boot and link-loss restore calls are skipped, so the port is never
+ *     re-bridged and detection is never re-run; stock's own "detected" state
+ *     (autowan_detected_ifname) is kept pointing at the pin, which the open code
+ *     already honours (wan.c uses it as the WAN interface, init.c builds the port
+ *     lists from it, lan.c leaves it out of br0);
+ *   - shared _eval() refuses `brctl addif <bridge> <pinned port>` from any caller,
+ *     the closed code included (belt and braces, logged).
+ * Moving the ISP cable is a deliberate act: choose the port on the WAN page (that
+ * turns auto-detection off, which clears the pin) or run Detect again
+ * (`service start_reaper_wanredetect`), which clears the pin and runs stock detection once.
+ * No user setting is changed: autowan_enable stays what the user set. A new or
+ * factory-reset router still detects once, bridged, at first setup.
+ */
+#include "rc.h"
+
+#if defined(RTCONFIG_AUTO_WANPORT) && !defined(RTCONFIG_BCM_MFG)
+
+#define WANPIN_KEY	"reaper_wanport"
+
+static int wanpin_candidate(const char *ifname)
+{
+	char word[32], *next;
+
+	if (!ifname || !*ifname)
+		return 0;
+	foreach(word, nvram_safe_get("autowan_ifnames"), next)
+		if (!strcmp(word, ifname))
+			return 1;
+	return 0;
+}
+
+/* The pinned port, or "" when nothing is pinned, the stored name is no longer a
+ * candidate port, or stock auto-WAN-port is not in effect. The last test is stock's
+ * own gate, is_auto_wanport_enabled() (closed, private.o): 0 outside router mode and
+ * whenever Dual WAN, WAN bonding, IPTV/VLAN tagging, a static WAN, MAC clone or SDN on
+ * the port is in use - so the pin never touches Dual WAN fail-over or switching, and
+ * nothing here runs in any of those modes. */
+const char *reaper_wanpin_get(void)
+{
+	static char pin[16];
+	const char *p;
+
+	if (!nvram_match("sw_mode", "1") || !nvram_match("autowan_enable", "1")
+	    || is_auto_wanport_enabled() <= 0)
+		return "";
+	p = nvram_safe_get(WANPIN_KEY);
+	if (strlen(p) >= sizeof(pin) || !wanpin_candidate(p))
+		return "";
+	strlcpy(pin, p, sizeof(pin));
+	return pin;
+}
+
+/* Keep stock's detected state on the pin. Called early at boot (before the port
+ * lists and the LAN bridge are built) and wherever a restore is being skipped. */
+void reaper_wanpin_seed(void)
+{
+	const char *pin;
+
+	/* a fixed WAN port was chosen (the Dual WAN page sets autowan_enable=0 for any
+	 * Primary WAN other than Auto): forget the pin, so turning Auto back on later
+	 * starts a fresh detection instead of trusting an old port */
+	if (!nvram_match("autowan_enable", "1")) {
+		if (*nvram_safe_get(WANPIN_KEY)) {
+			nvram_unset(WANPIN_KEY);
+			nvram_commit();
+			logmessage("reaper", "WAN port pin cleared: auto-detection is off (a fixed WAN port was chosen)");
+		}
+		return;
+	}
+	pin = reaper_wanpin_get();
+	if (*pin && !nvram_match("autowan_detected_ifname", pin))
+		nvram_set("autowan_detected_ifname", pin);
+}
+
+/* Record the port stock detection settled on; forget the pin when the user turns
+ * auto-detection off (a fixed WAN port was chosen), so turning it back on starts a
+ * fresh detection. Cheap; wanduck calls it on every scan. */
+void reaper_wanpin_learn(void)
+{
+	char det[16];
+
+	if (!nvram_match("autowan_enable", "1")) {
+		reaper_wanpin_seed();		/* clears the pin */
+		return;
+	}
+	if (!nvram_match("sw_mode", "1") || is_auto_wanport_enabled() != 2)
+		return;
+	strlcpy(det, nvram_safe_get("autowan_detected_ifname"), sizeof(det));
+	if (!wanpin_candidate(det) || nvram_match(WANPIN_KEY, det))
+		return;
+	nvram_set(WANPIN_KEY, det);
+	nvram_commit();
+	logmessage("reaper", "WAN port %s pinned: it stays out of the LAN bridge from now on "
+		   "(a link loss or reboot no longer re-runs auto-detection; to move the ISP cable, "
+		   "choose the port on the WAN page or run Detect again)", det);
+}
+
+/* 1 = the caller must NOT call restore_auto_wanport(): a WAN port is pinned. wanduck
+ * calls this on every 5 s scan while the link is down, so the log line is limited to
+ * a change of reason or once per 10 min. */
+int reaper_wanpin_hold(const char *why)
+{
+	static char last_why[24];
+	static long last_log = 0;
+	const char *pin = reaper_wanpin_get();
+	long now = uptime();
+
+	if (!*pin)
+		return 0;
+	reaper_wanpin_seed();
+	if (strcmp(last_why, why ? why : "") || now - last_log >= 600) {
+		strlcpy(last_why, why ? why : "", sizeof(last_why));
+		last_log = now;
+		logmessage("reaper", "%s on the pinned WAN port %s: auto-detection not re-run, port not bridged into the LAN",
+			   why ? why : "restore", pin);
+	}
+	return 1;
+}
+
+/* `service start_reaper_wanredetect`: the user moved the ISP cable. Forget the pin and run
+ * stock detection once (this IS the bridged search, on request). */
+void reaper_wanpin_redetect(void)
+{
+	if (*nvram_safe_get(WANPIN_KEY)) {
+		nvram_unset(WANPIN_KEY);
+		nvram_commit();
+	}
+	logmessage("reaper", "WAN port detection restarted on request: the candidate ports join the LAN bridge until the ISP answers on one, then that port is pinned");
+	if (nvram_match("sw_mode", "1") && is_auto_wanport_enabled() > 0)
+		restore_auto_wanport();
+}
+
+#endif	/* RTCONFIG_AUTO_WANPORT && !RTCONFIG_BCM_MFG */
