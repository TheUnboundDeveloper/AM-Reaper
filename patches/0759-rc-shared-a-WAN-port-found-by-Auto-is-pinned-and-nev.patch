+	{
+		if(action & RC_SERVICE_START) reaper_wanpin_redetect();
+	}
+#endif
 	else if (strcmp(script, "rchqd") == 0)	/* reaper v1.6.1 channel-quality monitor */
 	{
 		if(action & RC_SERVICE_STOP) stop_rchqd();
diff --git a/release/src/router/rc/udhcpc.c b/release/src/router/rc/udhcpc.c
index 8fc110bf16..7753a4cd3e 100644
--- a/release/src/router/rc/udhcpc.c
+++ b/release/src/router/rc/udhcpc.c
@@ -433,6 +433,7 @@ _dprintf("%s(%d): ifunit=%d, if=%s.\n", __func__, getpid(), ifunit, wan_ifname);
 
 			_dprintf("%s(%d): auto_wanport: Choose the WAN interface %s because of DHCP.\n", __func__, getpid(), wan_ifname);
 			set_auto_wanport(wan_ifname, 1);
+			reaper_wanpin_learn();	/* reaper v3.3.6: pin it - it is never bridged into the LAN again */
 
 			return 0;
 		}
diff --git a/release/src/router/rc/wanduck.c b/release/src/router/rc/wanduck.c
index 290161352c..3eb110e788 100644
--- a/release/src/router/rc/wanduck.c
+++ b/release/src/router/rc/wanduck.c
@@ -1681,7 +1681,13 @@ int chk_proto(int wan_unit){
 		 * reaches this branch (the dualwan_wans condition above). */
 		static long autowan_last = 0;
 		long now = uptime();
-		if(current_state[wan_unit] != WAN_STATE_CONNECTED || now - autowan_last >= 60){
+		/* reaper v3.3.6: record the port detection settled on, and once a port is
+		 * pinned leave the prober alone - it only exists to find a port, and its
+		 * search is the bridged one (rc/reaper_wanpin.c) */
+		reaper_wanpin_learn();
+		if(*reaper_wanpin_get())
+			;
+		else if(current_state[wan_unit] != WAN_STATE_CONNECTED || now - autowan_last >= 60){
 			autowan_last = now;
 			notify_rc_after_period_wait("restart_autowan", 1);
 		}
@@ -5092,7 +5098,8 @@ _dprintf("nat_rule: start_nat_rules 6.\n");
 					_dprintf("\n# Enable direct rule(C2D)......\n");
 
 #if defined(RTCONFIG_AUTO_WANPORT) && !defined(RTCONFIG_BCM_MFG)
-					if(link_wan[current_wan_unit] == 0 && is_auto_wanport_enabled() == 2){
+					if(link_wan[current_wan_unit] == 0 && is_auto_wanport_enabled() == 2
+							&& !reaper_wanpin_hold("WAN link lost")){	/* reaper v3.3.6: never re-bridge a known WAN port */
 						_dprintf("wanduck(C2D): Got the auto-detected WAN was unplugged...\n");
 						restore_auto_wanport();
 					}
@@ -5149,7 +5156,8 @@ _dprintf("nat_rule: start_nat_rules 6.\n");
 				}
 			}
 #if defined(RTCONFIG_AUTO_WANPORT) && !defined(RTCONFIG_BCM_MFG)
-			else if(link_wan[current_wan_unit] == 0 && is_auto_wanport_enabled() == 2){
+			else if(link_wan[current_wan_unit] == 0 && is_auto_wanport_enabled() == 2
+					&& !reaper_wanpin_hold("WAN link lost")){	/* reaper v3.3.6 */
 				_dprintf("wanduck 1: Got the auto-detected WAN was unplugged...\n");
 				restore_auto_wanport();
 			}
@@ -5190,7 +5198,8 @@ _dprintf("nat_rule: start_nat_rules 6.\n");
 		 */
 		else if(conn_changed_state[current_wan_unit] == DISCONN){
 #if defined(RTCONFIG_AUTO_WANPORT) && !defined(RTCONFIG_BCM_MFG)
-			if(link_wan[current_wan_unit] == 0 && is_auto_wanport_enabled() == 2){
+			if(link_wan[current_wan_unit] == 0 && is_auto_wanport_enabled() == 2
+					&& !reaper_wanpin_hold("WAN link lost")){	/* reaper v3.3.6 */
 				_dprintf("wanduck(DISCONN): Got the auto-detected WAN was unplugged...\n");
 				restore_auto_wanport();
 			}
diff --git a/release/src/router/shared/shutils.c b/release/src/router/shared/shutils.c
index 4485d0dd4d..20fae3482e 100644
--- a/release/src/router/shared/shutils.c
+++ b/release/src/router/shared/shutils.c
@@ -37,6 +37,7 @@
 #include <sys/types.h>
 #include <sys/stat.h>
 #include <sys/wait.h>
+#include <syslog.h>	/* reaper v3.3.6: the pinned-WAN-port guard in _eval() */
 #include <sys/ioctl.h>
 #include <assert.h>
 #include <sys/sysinfo.h>
@@ -269,6 +270,23 @@ int _eval(char *const argv[], const char *path, int timeout, int *ppid)
 	int fd, flags, sig, n;
 	char s[256], *p;
 	int debug_logeval = nvram_get_int("debug_logeval");
+
+#if defined(RTCONFIG_AUTO_WANPORT) && !defined(RTCONFIG_BCM_MFG)
+	/* reaper v3.3.6: a WAN port that has carried the WAN (nvram reaper_wanport,
+	 * rc/reaper_wanpin.c) is never bridged into a LAN bridge again while stock
+	 * auto-WAN-port is in effect - router mode, auto-detection on, Dual WAN off
+	 * (wan none / wan usb: the only layouts stock auto-detection runs in). rc skips
+	 * the stock restore calls; this catches any other caller, the closed code
+	 * included. Pretends success so the caller carries on as if bridged. */
+	if (argv[0] && argv[1] && argv[2] && argv[3]
+	    && !strcmp(argv[0], "brctl") && !strcmp(argv[1], "addif")
+	    && nvram_match("sw_mode", "1") && nvram_match("autowan_enable", "1")
+	    && (nvram_match("wans_dualwan", "wan none") || nvram_match("wans_dualwan", "wan usb"))
+	    && nvram_match("reaper_wanport", argv[3])) {
+		syslog(LOG_WARNING, "reaper: refused to bridge the pinned WAN port %s into %s", argv[3], argv[2]);
+		return 0;
+	}
+#endif
 #if 0
 	char *cpu = "0";
 	char *cpu_argv[32] = { "taskset", "-c", cpu, NULL};
