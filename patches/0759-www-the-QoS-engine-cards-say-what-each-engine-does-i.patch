From 12b6e01901a7af8f2fa8519b14f07d9c86c8794b Mon Sep 17 00:00:00 2001
From: reaper <theunbounddeveloper@outlook.com>
Date: Thu, 15 Oct 2026 14:07:34 -0400
Subject: [PATCH] www: the QoS engine cards say what each engine does, in one
 chip scheme

Plain chips were steel grey and read as switched off; they are now
bone-dim with a neutral border (green = strength, amber = cost, plain =
scope). Checked against rc: every card names the accelerator first
(hnd_nat_ac_init turns it off for every engine but off/10/11 - the
Bandwidth Limiter card now says so); Classful shows "Optional download
cap" (RQOS_126) instead of "Upload only"; Traditional gets Up + Down in
green and Classes + guarantees, like Cake and Classful; Off's "No control"
is amber like the Limiter's "Not bufferbloat". Lean:
test_qos_card_chips.py.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 release/src/router/www/Reaper_QoS.asp | 17 ++++++++++++-----
 1 file changed, 12 insertions(+), 5 deletions(-)

diff --git a/release/src/router/www/Reaper_QoS.asp b/release/src/router/www/Reaper_QoS.asp
index 37b281c9266..e92eaef5ef6 100644
--- a/release/src/router/www/Reaper_QoS.asp
+++ b/release/src/router/www/Reaper_QoS.asp
@@ -66,8 +66,10 @@ a{color:var(--bone-dim)} a:hover{color:var(--bone)}
 .mode h3{font-size:15px;font-weight:700;margin-bottom:6px;padding-right:20px}
 .mode p{font-size:12px;line-height:1.5;color:var(--bone-dim);margin:0 0 10px}
 .tags{display:flex;flex-wrap:wrap;gap:5px}
+/* chips: .good = a strength, .warn = a real cost, plain = a fact about scope. A plain chip is
+   a fact, not an off state, so it reads in bone-dim (2026-10-15: steel looked unlit). */
 .tag{font-family:var(--hdr);font-weight:600;font-size:9.5px;letter-spacing:.1em;text-transform:uppercase;
-  border:1px solid var(--line-soft);border-radius:5px;padding:2.5px 7px;color:var(--steel)}
+  border:1px solid rgba(236,231,219,.22);border-radius:5px;padding:2.5px 7px;color:var(--bone-dim)}
 .tag.good{color:var(--jade);border-color:rgba(79,178,134,.35)}
 .tag.warn{color:var(--amber);border-color:rgba(224,169,59,.35)}
 .mode .rec{position:absolute;top:-9px;left:12px;background:var(--crimson);color:#fff;font-family:var(--hdr);
@@ -403,19 +405,24 @@ var NV = {
 if (/^vlan[0-9]+$/.test(NV.wanif)) { var _tn = document.getElementById('rqos_trunknote'); if (_tn) _tn.style.display = ''; }
 
 /* ---------- mode model (qos_type 1/Adaptive is retired with the DPI stack) ---------- */
+/* Chips, checked against rc 2026-10-15: every card names the accelerator first (hnd_nat_ac_init
+   turns it off for every engine but off/10/11 - the Bandwidth Limiter included); the same fact
+   wears the same colour on every card. 11: upload is shaped, download only has the opt-in
+   ingress policer (start_hwqos_classful, qos_ipolicer). 0: HTB classes with min/ceil from
+   qos_orates both ways (imq0 for download), like 11's guarantees. */
 var MODES = [
   {key:'off', type:null, name:`<#Outdoor_mode_off#>`, desc:`<#RQOS_68#>`,
-   tags:[[`<#RQOS_69#>`,'good'],[`<#RQOS_70#>`,'']]},
+   tags:[[`<#RQOS_69#>`,'good'],[`<#RQOS_70#>`,'warn']]},
   {key:'11', type:'11', name:`<#RQOS_71#>`, rec:true, desc:`<#RQOS_72#>`,
-   tags:[[`<#RQOS_69#>`,'good'],[`<#RQOS_73#>`,''],[`<#RQOS_74#>`,'good']]},
+   tags:[[`<#RQOS_69#>`,'good'],[`<#RQOS_74#>`,'good'],[`<#RQOS_126#>`,'']]},
   {key:'10', type:'10', name:`<#RQOS_75#>`, desc:`<#RQOS_76#>`,
    tags:[[`<#RQOS_69#>`,'good'],[`<#RQOS_73#>`,''],[`<#RQOS_77#>`,'']]},
   {key:'9', type:'9', name:'Cake', desc:`<#RQOS_78#>`,
    tags:[[`<#RQOS_79#>`,'warn'],[`<#RQOS_80#>`,'good']]},
   {key:'0', type:'0', name:`<#EzQoS_type_traditional#>`, desc:`<#RQOS_81#>`,
-   tags:[[`<#RQOS_79#>`,'warn'],[`<#RQOS_80#>`,'']]},
+   tags:[[`<#RQOS_79#>`,'warn'],[`<#RQOS_80#>`,'good'],[`<#RQOS_74#>`,'good']]},
   {key:'2', type:'2', name:`<#Bandwidth_Limiter#>`, desc:`<#RQOS_82#>`,
-   tags:[[`<#RQOS_84#>`,''],[`<#RQOS_85#>`,'warn']]}
+   tags:[[`<#RQOS_79#>`,'warn'],[`<#RQOS_84#>`,''],[`<#RQOS_85#>`,'warn']]}
 ];
 var sel = (NV.enable === '1') ? String(NV.type) : 'off';
 if (sel !== 'off' && !MODES.some(function(m){return m.key===sel;})) sel = 'off'; /* unknown/retired type */
-- 
