+.explain .cands .k{font-family:var(--hdr);font-weight:600;font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--steel)}
+.tag{font-family:var(--hdr);font-weight:600;font-size:11.5px;letter-spacing:.06em;color:var(--bone);border:1px solid #3a3a3e;border-radius:6px;padding:3px 9px;background:#0b0b0d}
+.pinline{display:flex;align-items:center;gap:12px;flex-wrap:wrap;margin-top:12px;padding:11px 14px;border-radius:10px;border:1px solid var(--line-soft);background:#0b0b0d}
