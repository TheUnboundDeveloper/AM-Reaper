+  background:transparent;color:var(--bone-dim);transition:border-color .15s,color .15s,background .15s,box-shadow .15s}
+.btn:hover{color:var(--bone);border-color:var(--crimson-deep)}
+.btn:focus-visible{outline:2px solid var(--bone);outline-offset:2px}
+.btn.hot{background:var(--crimson-deep);border-color:var(--crimson-deep);color:var(--bone);margin-left:auto}
+.btn.hot:hover{background:var(--crimson);box-shadow:0 0 18px rgba(225,6,0,.25)}
