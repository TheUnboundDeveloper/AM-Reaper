+.sw input:checked ~ .tr{background:#4a4f55;border-color:#71767b}
+.sw input:checked ~ .tr::after{left:20px;background:var(--bone)}
+.sw input:focus-visible ~ .tr{outline:2px solid var(--bone);outline-offset:2px}
