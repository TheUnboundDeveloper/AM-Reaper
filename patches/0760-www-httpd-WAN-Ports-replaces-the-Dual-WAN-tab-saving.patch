+
+/* rules table */
+.rules{margin-top:14px;border:1px solid var(--line-soft);border-radius:10px;overflow:hidden}
+.rrow{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr) minmax(0,150px) 92px;gap:10px;align-items:center;padding:9px 12px}
