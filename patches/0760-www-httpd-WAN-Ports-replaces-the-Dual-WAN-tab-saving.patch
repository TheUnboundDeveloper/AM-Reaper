+.bar{display:flex;align-items:center;gap:14px;flex-wrap:wrap;margin-top:22px;padding:14px 16px;border:1px solid var(--line-soft);
+  border-radius:12px;background:var(--panel)}
+.bar .msg{font-size:12px;color:var(--steel);flex:1 1 300px;min-width:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:100%}
