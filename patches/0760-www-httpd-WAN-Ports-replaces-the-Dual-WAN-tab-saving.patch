+.sig .bl{stroke:var(--crimson)}
+.idtxt{min-width:0;flex:1 1 380px}
+.idtxt h1{font-family:var(--hdr);font-weight:700;font-size:26px;letter-spacing:.05em;color:var(--bone);text-transform:uppercase}
+.idtxt .sub{font-size:12.3px;color:var(--steel);margin-top:2px;max-width:78ch}
+.idchips{margin-left:auto;display:flex;gap:8px;flex-wrap:wrap;min-width:0}
+.chip{font-family:var(--hdr);font-weight:600;font-size:11px;letter-spacing:.1em;text-transform:uppercase;
+  color:var(--bone-dim);border:1px solid var(--line-soft);border-radius:6px;padding:5px 10px;background:var(--panel);
+  white-space:nowrap;display:inline-flex;align-items:center;gap:7px;max-width:100%;min-width:0}
+.chip b{color:var(--bone);font-weight:600;overflow:hidden;text-overflow:ellipsis;max-width:24ch}
+.chip .dot{width:8px;height:8px;border-radius:50%;background:var(--steel);flex:0 0 auto}
+.chip.ok .dot{background:var(--jade)} .chip.warn .dot{background:var(--amber)}
