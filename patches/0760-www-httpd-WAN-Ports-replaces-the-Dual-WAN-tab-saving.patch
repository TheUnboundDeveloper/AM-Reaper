+    /* stock appendModeOption(): Load Balance, or Fail Over keeping failback only if it was set */
+    var m = this.getAttribute('data-m');
+    if(m === 'lb') modeSelected('lb');
+    else { if(S.mode === 'lb') S.mode = 'fo'; modeSelected('fo'); }
+    render();
+  });
+  $id('failback').addEventListener('change', function(){ S.mode = this.checked ? 'fb' : 'fo'; render(); });
+  $id('ratio0').addEventListener('input', function(){ S.ratio0 = this.value; });
+  $id('ratio1').addEventListener('input', function(){ S.ratio1 = this.value; });
+  $id('standby').addEventListener('change', function(){
+    if(this.checked && gobi_support){
+      var me = (usb_index == 0) ? NV.wan0_enable : NV.wan1_enable;
+      if(me == '0' && confirm(T.standbyQ)){ if(usb_index == 0) hset('wan0_enable', '1'); else if(usb_index == 1) hset('wan1_enable', '1'); }
+    }
+    S.standby = this.checked ? '1' : '0';
+  });
+  $id('usbbk').addEventListener('change', function(){ S.usb_bk = this.checked ? '1' : '0'; });
+  $id('lanport1').addEventListener('change', function(){ S.lanport1 = this.value; });
+  $id('lanport2').addEventListener('change', function(){ S.lanport2 = this.value; });
+  $id('dnsprobe').addEventListener('change', function(){ S.dnsprobe = this.checked; renderMonitor(); });
+  $id('ping').addEventListener('change', function(){ S.ping = this.checked; renderMonitor(); });
+  $id('dnshost').addEventListener('input', function(){ S.dnshost = this.value; });
+  $id('pingtarget').addEventListener('input', function(){ S.pingtarget = this.value; });
+  $id('ptpick').addEventListener('click', function(){ $id('ptlist').classList.toggle('on'); });
+  $id('rtenable').addEventListener('change', function(){ S.routing = this.checked ? '1' : '0'; renderRules(); });
+  var is = $id('isp_seg').querySelectorAll('button');
+  for(j = 0; j < is.length; j++) is[j].addEventListener('click', function(){ ispUnit(this.getAttribute('data-u')); renderIsp(); });
+  $id('isp0c').addEventListener('change', function(){ S.isp0c = parseInt(this.value, 10) || 0; S.isp0l = 0; renderIsp(); });
+  $id('isp1c').addEventListener('change', function(){ S.isp1c = parseInt(this.value, 10) || 0; S.isp1l = 0; renderIsp(); });
+  $id('isp0l').addEventListener('change', function(){ S.isp0l = parseInt(this.value, 10) || 0; });
+  $id('isp1l').addEventListener('change', function(){ S.isp1l = parseInt(this.value, 10) || 0; });
+  $id('apply').addEventListener('click', apply);
+  $id('redetect').addEventListener('click', redetect);
+  window.addEventListener('resize', function(){ msg($id('msg').textContent, $id('msg').className.indexOf('err') >= 0); });
+
+  /* stock order: port list (async on the newer port map), then form_show(), then the saved mode */
+  lanPorts(function(){
+    /* stock initial(): both option lists are built once the port list is in (wanOptions() drops LAN
+       when it came back empty), and each selector starts on its first option */
+    S.primaryOpts = wanOptions('primary', wans_caps_primary);
+    S.secondOpts = wanOptions('second', wans_caps_secondary);
+    S.primary = S.primaryOpts.length ? S.primaryOpts[0].v : '';
+    S.second = S.secondOpts.length ? S.secondOpts[0].v : '';
+    if(!S.lanOpts.length) S.lanOpts = [{v: NV.wans_lanport, t: T.lanPort + NV.wans_lanport}];
+    if(!optHas(S.lanOpts, S.lanport1) && S.lanOpts.length) S.lanport1 = S.lanOpts[0].v;
+    if(!optHas(S.lanOpts, S.lanport2) && S.lanOpts.length) S.lanport2 = S.lanOpts[0].v;
+    S.mode = NV.wans_mode;
+    formShow(wans_flag);
+    if(!wans_flag) S.mode = NV.wans_mode;
+    render();
+    loadVlanPorts(function(){});
+    loadPingList();
+    window.__ready = 1;
+  });
+})();
+</script>
+</body>
+</html>
