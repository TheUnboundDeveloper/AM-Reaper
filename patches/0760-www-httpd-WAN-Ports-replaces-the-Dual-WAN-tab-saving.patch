+
+/* ping target presets */
+.ptwrap{position:relative;display:flex;gap:8px;align-items:center;flex-wrap:wrap}
+.ptlist{display:none;position:absolute;top:100%;left:0;z-index:20;margin-top:4px;min-width:260px;max-height:240px;overflow:auto;
+  background:#0f0f12;border:1px solid #3a3a3e;border-radius:8px;padding:4px 0}
+.ptlist.on{display:block}
+.ptlist button{display:block;width:100%;text-align:left;padding:7px 12px;background:transparent;border:0;color:var(--bone-dim);font:400 12.5px var(--body);cursor:pointer}
