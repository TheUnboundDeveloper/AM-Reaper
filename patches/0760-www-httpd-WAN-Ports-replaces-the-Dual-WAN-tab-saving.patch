+.pinline .v.pinned .st{color:var(--jade)}
+.pinline .v.search .st{color:var(--amber)}
+.pinline .btn{margin-left:auto}
+
+/* toggle switch: neutral grey, never crimson (rule 11) */
+.sw{position:relative;display:inline-flex;align-items:center;gap:10px;cursor:pointer;flex:0 0 auto;user-select:none}
