+  background:radial-gradient(90% 120% at 8% 0%,rgba(225,6,0,.10),transparent 55%),var(--panel)}
+.card.hero::before{content:"";position:absolute;left:0;top:14px;bottom:14px;width:3px;border-radius:3px;background:var(--crimson)}
