From a87d3146d5ee4f35cd1b89df667a089165d4729a Mon Sep 17 00:00:00 2001
From: reaper <theunbounddeveloper@outlook.com>
Date: Fri, 9 Oct 2026 13:26:04 -0400
Subject: [PATCH] inadyn: DDNS request logs no longer carry the provider
 credential

At debug log level the DDNS client wrote its requests whole into the system
log: the Basic/Bearer header, password= and token= query values, user:pass@
in a URL, the checkip command's user environment and the ASUS plugin's signed
request (the CVE-2026-16528 class, ASUS bulletin 2026-10-07). Every
request-logging site now passes through a redaction helper that masks those
parts and keeps the rest of the line readable. The generated client config,
which holds the password, is made owner-only after it is written (rc side in
the rc commit of this rung).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 release/src/router/inadyn/include/log.h       |   5 +
 release/src/router/inadyn/plugins/asuscomm.c  |   4 +-
 .../src/router/inadyn/plugins/asuscommv2.c    |   2 +-
 release/src/router/inadyn/src/ddns.c          |  14 +-
 release/src/router/inadyn/src/log.c           | 137 ++++++++++++++++++
 5 files changed, 152 insertions(+), 10 deletions(-)

diff --git a/release/src/router/inadyn/include/log.h b/release/src/router/inadyn/include/log.h
index 247e2b8869..6cbcb37b8c 100644
--- a/release/src/router/inadyn/include/log.h
+++ b/release/src/router/inadyn/include/log.h
@@ -37,6 +37,11 @@ int  log_level (char *level);
 void logitf     (int prio, const char *fmt, ...);
 void vlogit    (int prio, const char *fmt, va_list args);
 
+/* reaper 2026-10-08: a copy of a request/command string with its credentials masked
+ * (Basic/Bearer and other auth headers, password=/token= values, user:pass@ in a URL,
+ * INADYN_USER="..."). Use it wherever a request buffer is logged. Static buffer. */
+const char *log_redact(const char *s);
+
 #define logit(p, ...) do if ((p) <= MAX_LOG_LEVEL) logitf((p), __VA_ARGS__); while (0)
 
 #endif /* INADYN_LOG_H_ */
diff --git a/release/src/router/inadyn/plugins/asuscomm.c b/release/src/router/inadyn/plugins/asuscomm.c
index 69f1b0c8c7..268ecf06ea 100644
--- a/release/src/router/inadyn/plugins/asuscomm.c
+++ b/release/src/router/inadyn/plugins/asuscomm.c
@@ -343,7 +343,7 @@ static int request(ddns_t *ctx, ddns_info_t *info, ddns_alias_t *alias)
 			info->creds.encoded_password ? : "",
 			info->server_name.name,
 			info->user_agent);
-	logit(LOG_DEBUG, "request<%s>", ctx->request_buf);
+	logit(LOG_DEBUG, "request<%s>", log_redact(ctx->request_buf));
 	return strlen(ctx->request_buf);
 #endif
 }
@@ -359,7 +359,7 @@ static int request_unregister(ddns_t *ctx, ddns_info_t *info, ddns_alias_t *alia
 			info->creds.encoded_password ? : "",
 			info->server_name.name,
 			info->user_agent);
-	logit(LOG_DEBUG, "unregister_request<%s>", ctx->request_buf);
+	logit(LOG_DEBUG, "unregister_request<%s>", log_redact(ctx->request_buf));
 	return strlen(ctx->request_buf);
 }
 
diff --git a/release/src/router/inadyn/plugins/asuscommv2.c b/release/src/router/inadyn/plugins/asuscommv2.c
index 438a2fc47d..9a3ef04a98 100644
--- a/release/src/router/inadyn/plugins/asuscommv2.c
+++ b/release/src/router/inadyn/plugins/asuscommv2.c
@@ -317,7 +317,7 @@ static int request(ddns_t *ctx, ddns_info_t *info, ddns_alias_t *alias)
 			info->creds.encoded_password ? : "",
 			info->server_name.name,
 			info->user_agent);
-	logit(LOG_DEBUG, "request<%s>", ctx->request_buf);
+	logit(LOG_DEBUG, "request<%s>", log_redact(ctx->request_buf));
 	return strlen(ctx->request_buf);
 #endif
 }
diff --git a/release/src/router/inadyn/src/ddns.c b/release/src/router/inadyn/src/ddns.c
index f33c8613f5..337d0f8c94 100644
--- a/release/src/router/inadyn/src/ddns.c
+++ b/release/src/router/inadyn/src/ddns.c
@@ -92,26 +92,26 @@ static int shell_transaction(ddns_t *ctx, ddns_info_t *info, const char *cmd)
 		"INADYN_PROVIDER=\"%s\" INADYN_USER=\"%s\" %s",
 		info->system->name, info->creds.username, cmd);
 
-	logit(LOG_DEBUG, "Starting command to get my public IP#: %s", ctx->request_buf);
+	logit(LOG_DEBUG, "Starting command to get my public IP#: %s", log_redact(ctx->request_buf));
 
 	pipe = popen(ctx->request_buf, "r");
 	if (!pipe) {
-		logit(LOG_ERR, "Cannot run '%s': %s", ctx->request_buf, strerror(errno));
+		logit(LOG_ERR, "Cannot run '%s': %s", log_redact(ctx->request_buf), strerror(errno));
 		return errno;
 	}
 
 	/* TODO: timeout on fread */
 	rc = fread(ctx->work_buf, 1, ctx->work_buflen, pipe);
 	if (rc < 0) {
-		logit(LOG_ERR, "Error running '%s': %s", ctx->request_buf, strerror(errno));
+		logit(LOG_ERR, "Error running '%s': %s", log_redact(ctx->request_buf), strerror(errno));
 		ctx->work_buf[0] = 0;
 		rc = errno;
 	} else if (rc == 0) {
-		logit(LOG_ERR, "Error running '%s': 0 bytes read", ctx->request_buf);
+		logit(LOG_ERR, "Error running '%s': 0 bytes read", log_redact(ctx->request_buf));
 		ctx->work_buf[0] = 0;
 		rc = RC_INVALID_POINTER;
 	} else {
-		logit(LOG_DEBUG, "Command '%s' returns %d bytes", ctx->request_buf, rc);
+		logit(LOG_DEBUG, "Command '%s' returns %d bytes", log_redact(ctx->request_buf), rc);
 		ctx->work_buf[rc] = 0;
 		rc = 0;
 	}
@@ -156,7 +156,7 @@ static int server_transaction(ddns_t *ctx, ddns_info_t *provider)
 	trans->rsp         = ctx->work_buf;
 	trans->max_rsp_len = ctx->work_buflen - 1;	/* Save place for terminating \0 in string. */
 
-	logit(LOG_DEBUG, "Querying DDNS checkip server for my public IP#: %s", ctx->request_buf);
+	logit(LOG_DEBUG, "Querying DDNS checkip server for my public IP#: %s", log_redact(ctx->request_buf));
 
 	rc = http_transaction(client, &ctx->http_transaction);
 	if (trans->status != 200)
@@ -721,7 +721,7 @@ static int send_update(ddns_t *ctx, ddns_info_t *info, ddns_alias_t *alias, int
 	}
 
 	ctx->request_buf[trans.req_len] = 0;
-	logit(LOG_DEBUG, "Sending alias table update to DDNS server: %s", ctx->request_buf);
+	logit(LOG_DEBUG, "Sending alias table update to DDNS server: %s", log_redact(ctx->request_buf));
 
 #ifdef ENABLE_SIMULATION
 	logit(LOG_WARNING, "In simulation, skipping update to server ...");
diff --git a/release/src/router/inadyn/src/log.c b/release/src/router/inadyn/src/log.c
index 6746046bf2..d99c7f5b6f 100644
--- a/release/src/router/inadyn/src/log.c
+++ b/release/src/router/inadyn/src/log.c
@@ -86,6 +86,143 @@ void logitf(int prio, const char *fmt, ...)
 	va_end(args);
 }
 
+/* REAPER_REDACT_BEGIN */
+/* reaper 2026-10-08 - the CVE-2026-16528 class ("DDNS credentials written to the system
+ * log"). inadyn's debug-level dumps logged the provider request whole: the Basic or
+ * Bearer header (base64 of user:password, or the tunnelbroker update key), a password=
+ * or token= query value, user:pass@ inside a URL, the INADYN_USER environment handed to
+ * a checkip command, the ASUS plugin's signed request. With `ddns_debug` on, that is
+ * the credential in syslog for anyone who can read the log. Mask those parts before
+ * anything reaches syslog and keep the rest of the line readable. The daemon is
+ * single-threaded, so one static buffer is enough; over-matching a harmless header
+ * (User-Agent) costs nothing, missing a credential would. */
+#include <string.h>
+#include <ctype.h>
+
+#define LOG_REDACT_MAX 4096
+
+static int redact_ci_has(const char *s, size_t n, const char *needle)
+{
+	size_t m = strlen(needle), i, j;
+
+	if (m == 0 || n < m)
+		return 0;
+	for (i = 0; i + m <= n; i++) {
+		for (j = 0; j < m; j++)
+			if (tolower((unsigned char)s[i + j]) != (unsigned char)needle[j])
+				break;
+		if (j == m)
+			return 1;
+	}
+	return 0;
+}
+
+/* a header name, or a key=value key, that names a credential */
+static int redact_sensitive(const char *k, size_t n)
+{
+	static const char *const bad[] = { "pass", "pwd", "token", "key", "secret", "auth",
+					   "cookie", "user", "login", "email", "credential", "sign", NULL };
+	int i;
+
+	for (i = 0; bad[i]; i++)
+		if (redact_ci_has(k, n, bad[i]))
+			return 1;
+	return 0;
+}
+
+/* never past LOG_REDACT_MAX - 4: three bytes stay free for the "..." that marks a
+ * truncated copy, one for the terminator */
+static size_t redact_put(char *out, size_t o, const char *s, size_t n)
+{
+	if (o + n > LOG_REDACT_MAX - 4)
+		n = (o < LOG_REDACT_MAX - 4) ? LOG_REDACT_MAX - 4 - o : 0;
+	memcpy(out + o, s, n);
+	return o + n;
+}
+
+const char *log_redact(const char *s)
+{
+	static char out[LOG_REDACT_MAX];
+	static const char mask[] = "[redacted]";
+	size_t i = 0, o = 0, n;
+	int line_start = 1;
+
+	if (!s)
+		return "";
+	while (s[i] && o < LOG_REDACT_MAX - 4) {
+		/* user:pass@ in a URL authority */
+		if (s[i] == ':' && s[i + 1] == '/' && s[i + 2] == '/') {
+			const char *a = s + i + 3, *at = NULL, *p;
+
+			for (p = a; *p && *p != '/' && *p != ' ' && *p != '\r' && *p != '\n' && *p != '?'; p++) {
+				if (*p == '@') {
+					at = p;
+					break;
+				}
+			}
+			o = redact_put(out, o, s + i, 3);
+			i += 3;
+			if (at) {
+				o = redact_put(out, o, mask, sizeof(mask) - 1);
+				o = redact_put(out, o, "@", 1);
+				i = (size_t)(at - s) + 1;
+			}
+			line_start = 0;
+			continue;
+		}
+		/* a header line "Name: value" whose name says credential */
+		if (line_start) {
+			n = strcspn(s + i, ":\r\n= &?\"");
+			if (n > 0 && s[i + n] == ':' && redact_sensitive(s + i, n)) {
+				o = redact_put(out, o, s + i, n + 1);
+				i += n + 1;
+				while (s[i] == ' ') {
+					o = redact_put(out, o, " ", 1);
+					i++;
+				}
+				o = redact_put(out, o, mask, sizeof(mask) - 1);
+				i += strcspn(s + i, "\r\n");
+				line_start = 0;
+				continue;
+			}
+		}
+		/* key=value after ?, &, a space, or at a line start, whose key says credential */
+		if (line_start || s[i] == '?' || s[i] == '&' || s[i] == ' ') {
+			size_t k = line_start ? i : i + 1;
+
+			if (!line_start) {
+				o = redact_put(out, o, s + i, 1);
+				i++;
+			}
+			n = strcspn(s + k, "=&? \r\n\"");
+			if (n > 0 && s[k + n] == '=' && redact_sensitive(s + k, n)) {
+				o = redact_put(out, o, s + k, n + 1);
+				i = k + n + 1;
+				if (s[i] == '"' || s[i] == '\'') {
+					o = redact_put(out, o, s + i, 1);
+					o = redact_put(out, o, mask, sizeof(mask) - 1);
+					i += 1 + strcspn(s + i + 1, (s[i] == '"') ? "\"\r\n" : "'\r\n");
+				} else {
+					o = redact_put(out, o, mask, sizeof(mask) - 1);
+					i += strcspn(s + i, "& \r\n");
+				}
+				line_start = 0;
+				continue;
+			}
+		}
+		line_start = (s[i] == '\n');
+		o = redact_put(out, o, s + i, 1);
+		i++;
+	}
+	if (s[i]) {
+		memcpy(out + o, "...", 3);	/* room reserved by redact_put() */
+		o += 3;
+	}
+	out[o] = '\0';
+	return out;
+}
+/* REAPER_REDACT_END */
+
 
 /**
  * Local Variables:
-- 
2.25.1

