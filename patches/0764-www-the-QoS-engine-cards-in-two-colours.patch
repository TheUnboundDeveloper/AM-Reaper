From 6f94425299addb94d5674decea77a71330832125 Mon Sep 17 00:00:00 2001
From: reaper <theunbounddeveloper@outlook.com>
Date: Fri, 16 Oct 2026 14:42:57 -0400
Subject: [PATCH] www: the QoS engine cards in two colours

Owner review of the v3.4.4 cards: a plain chip still read as a third,
"switched off" state. Every chip now carries one of two colours - green
for something the engine does, amber for something it lacks or costs.
Hardware QoS: "Upload only" and "No classes" amber. HW QoS Classful:
"Optional download cap" green. Bandwidth Limiter: "Per-device caps"
green. The plain .tag style stays only as a fallback. Lean:
test_qos_card_chips.py, two token-free markers.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 release/src/router/www/Reaper_QoS.asp | 10 +++++-----
 1 file changed, 5 insertions(+), 5 deletions(-)

diff --git a/release/src/router/www/Reaper_QoS.asp b/release/src/router/www/Reaper_QoS.asp
index e92eaef5ef6..502e367f09e 100644
--- a/release/src/router/www/Reaper_QoS.asp
+++ b/release/src/router/www/Reaper_QoS.asp
@@ -66,8 +66,8 @@ a{color:var(--bone-dim)} a:hover{color:var(--bone)}
 .mode h3{font-size:15px;font-weight:700;margin-bottom:6px;padding-right:20px}
 .mode p{font-size:12px;line-height:1.5;color:var(--bone-dim);margin:0 0 10px}
 .tags{display:flex;flex-wrap:wrap;gap:5px}
-/* chips: .good = a strength, .warn = a real cost, plain = a fact about scope. A plain chip is
-   a fact, not an off state, so it reads in bone-dim (2026-10-15: steel looked unlit). */
+/* chips: two colours only (owner, 2026-10-15). .good = something the engine does, .warn =
+   something it lacks or costs. Every chip carries one; the plain .tag style is a fallback. */
 .tag{font-family:var(--hdr);font-weight:600;font-size:9.5px;letter-spacing:.1em;text-transform:uppercase;
   border:1px solid rgba(236,231,219,.22);border-radius:5px;padding:2.5px 7px;color:var(--bone-dim)}
 .tag.good{color:var(--jade);border-color:rgba(79,178,134,.35)}
@@ -414,15 +414,15 @@ var MODES = [
   {key:'off', type:null, name:`<#Outdoor_mode_off#>`, desc:`<#RQOS_68#>`,
    tags:[[`<#RQOS_69#>`,'good'],[`<#RQOS_70#>`,'warn']]},
   {key:'11', type:'11', name:`<#RQOS_71#>`, rec:true, desc:`<#RQOS_72#>`,
-   tags:[[`<#RQOS_69#>`,'good'],[`<#RQOS_74#>`,'good'],[`<#RQOS_126#>`,'']]},
+   tags:[[`<#RQOS_69#>`,'good'],[`<#RQOS_74#>`,'good'],[`<#RQOS_126#>`,'good']]},
   {key:'10', type:'10', name:`<#RQOS_75#>`, desc:`<#RQOS_76#>`,
-   tags:[[`<#RQOS_69#>`,'good'],[`<#RQOS_73#>`,''],[`<#RQOS_77#>`,'']]},
+   tags:[[`<#RQOS_69#>`,'good'],[`<#RQOS_73#>`,'warn'],[`<#RQOS_77#>`,'warn']]},
   {key:'9', type:'9', name:'Cake', desc:`<#RQOS_78#>`,
    tags:[[`<#RQOS_79#>`,'warn'],[`<#RQOS_80#>`,'good']]},
   {key:'0', type:'0', name:`<#EzQoS_type_traditional#>`, desc:`<#RQOS_81#>`,
    tags:[[`<#RQOS_79#>`,'warn'],[`<#RQOS_80#>`,'good'],[`<#RQOS_74#>`,'good']]},
   {key:'2', type:'2', name:`<#Bandwidth_Limiter#>`, desc:`<#RQOS_82#>`,
-   tags:[[`<#RQOS_79#>`,'warn'],[`<#RQOS_84#>`,''],[`<#RQOS_85#>`,'warn']]}
+   tags:[[`<#RQOS_79#>`,'warn'],[`<#RQOS_84#>`,'good'],[`<#RQOS_85#>`,'warn']]}
 ];
 var sel = (NV.enable === '1') ? String(NV.type) : 'off';
 if (sel !== 'off' && !MODES.some(function(m){return m.key===sel;})) sel = 'off'; /* unknown/retired type */
-- 
