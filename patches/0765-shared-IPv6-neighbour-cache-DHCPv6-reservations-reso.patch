diff --git a/release/src/router/shared/reaper_dhcp6.c b/release/src/router/shared/reaper_dhcp6.c
new file mode 100644
index 0000000000..5a24f28f2f
--- /dev/null
+++ b/release/src/router/shared/reaper_dhcp6.c
@@ -0,0 +1,85 @@
+/* SPDX-License-Identifier: GPL-2.0-only
+ * Copyright (C) 2026 the Reaper project maintainer
+ * Part of the Reaper hardened Asuswrt-Merlin build. See LICENSE / LICENSE.reaper.
+ *
+ * reaper_dhcp6.c - DHCPv6 reservation list parser. Contract in reaper_dhcp6.h.
+ */
+#include <stdio.h>
+#include <string.h>
+#include <ctype.h>
+#include "reaper_dhcp6.h"
+
+int reaper_dhcp6_sfx_valid(const char *s)
+{
+	int groups = 0, digits = 0;
+
+	if (!s || s[0] != ':' || s[1] != ':' || !s[2])
+		return 0;
+	for (s += 2; *s; s++) {
+		if (*s == ':') {
+			if (!digits || ++groups > 3)
+				return 0;
+			digits = 0;
+		} else if (isxdigit((unsigned char)*s)) {
+			if (++digits > 4)
+				return 0;
+		} else
+			return 0;
+	}
+	return digits > 0;
+}
+
+/* "AA:BB:CC:DD:EE:FF" in any case -> upper-case copy; 0 when it is not a MAC */
+static int mac_canon(const char *s, size_t len, char *out)
+{
+	size_t i;
+
+	if (len != 17)
+		return 0;
+	for (i = 0; i < 17; i++) {
+		if ((i % 3) == 2) {
+			if (s[i] != ':')
+				return 0;
+			out[i] = ':';
+		} else {
+			if (!isxdigit((unsigned char)s[i]))
+				return 0;
+			out[i] = (char)toupper((unsigned char)s[i]);
+		}
+	}
+	out[17] = 0;
+	return strcmp(out, "00:00:00:00:00:00") != 0 && strcmp(out, "FF:FF:FF:FF:FF:FF") != 0;
+}
+
+int reaper_dhcp6_walk(const char *list, void (*cb)(const char *mac, const char *sfx, void *arg), void *arg)
+{
+	const char *p = list;
+	int n = 0;
+
+	if (!list || !cb)
+		return 0;
+	while ((p = strchr(p, '<')) != NULL) {
+		const char *gt, *end;
+		char mac[18], sfx[REAPER_DHCP6_SFX_MAX + 1];
+		size_t l, i;
+
+		p++;
+		gt = strchr(p, '>');
+		end = strchr(p, '<');
+		if (!gt || (end && gt > end))
+			continue;			/* no '>' in this record */
+		if (!mac_canon(p, (size_t)(gt - p), mac))
+			continue;
+		l = end ? (size_t)(end - gt - 1) : strlen(gt + 1);
+		if (l == 0 || l > REAPER_DHCP6_SFX_MAX)
+			continue;
+		for (i = 0; i < l; i++)
+			sfx[i] = (char)tolower((unsigned char)gt[1 + i]);
+		sfx[l] = 0;
+		if (!reaper_dhcp6_sfx_valid(sfx))
+			continue;
+		cb(mac, sfx, arg);
+		n++;
+	}
+	return n;
+}
