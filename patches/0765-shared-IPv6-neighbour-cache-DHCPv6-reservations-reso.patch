@@ -0,0 +1,29 @@
+/* SPDX-License-Identifier: GPL-2.0-only
+ * Copyright (C) 2026 the Reaper project maintainer
+ * Part of the Reaper hardened Asuswrt-Merlin build. See LICENSE / LICENSE.reaper.
+ *
+ * reaper_dhcp6.h - DHCPv6 reservations (IPv6 remediation 2026-10-07, A3 step 2).
+ *
+ * The Devices page pins an IPv6 address to a device the way it pins an IPv4
+ * one, but only the HOST part is stored: "<MAC>::suffix" records in a /jffs
+ * list (the nvram cap rule forbids another nvram list). dnsmasq takes the
+ * network part from its own dhcp-range ("dhcp-host=<MAC>,[::suffix]"), so a
+ * delegated-prefix change needs no edit, and it matches the client by the MAC
+ * it finds in the neighbour table - which is every directly connected LAN
+ * client. Shared by httpd (the page's RMW, the backup import) and rc (the
+ * dnsmasq emitter) so both walk the list with one parser. */
+#ifndef REAPER_DHCP6_H
+#define REAPER_DHCP6_H
+
+#define REAPER_DHCP6_FILE "/jffs/reaper/dhcp6_static"
+#define REAPER_DHCP6_SFX_MAX 23		/* "::ffff:ffff:ffff:ffff" + NUL fits */
+
+/* a reservation suffix: "::" then one to four hex groups of one to four digits */
+int reaper_dhcp6_sfx_valid(const char *s);
+
+/* walk "<MAC>sfx<MAC>sfx...": cb(mac, sfx, arg) once per well-formed record,
+ * MAC upper-case colon form, suffix lower-case; malformed records are skipped.
+ * Returns the number of records delivered. */
+int reaper_dhcp6_walk(const char *list, void (*cb)(const char *mac, const char *sfx, void *arg), void *arg);
+
+#endif /* REAPER_DHCP6_H */
