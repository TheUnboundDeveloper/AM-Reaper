+<script>
+var NV = {
+  sw_mode: '<% nvram_get("sw_mode"); %>',
+  wlc_psta: '<% nvram_get("wlc_psta"); %>',
+  re_mode: '<% nvram_get("re_mode"); %>',
+  lan_ipaddr: '<% nvram_get("lan_ipaddr"); %>',
+  lan_hostname: '<% nvram_get("lan_hostname"); %>',
+  lan_ipaddr_rt: '<% nvram_default_get("lan_ipaddr_rt"); %>',
+  lan_netmask_rt: '<% nvram_default_get("lan_netmask_rt"); %>',
+  mld_enable: '<% nvram_get("mld_enable"); %>',
+  mld_default: '<% nvram_default_get("mld_enable"); %>',
+  wl11be: ['<% nvram_get("wl0_11be"); %>', '<% nvram_get("wl1_11be"); %>', '<% nvram_get("wl2_11be"); %>'],
+  reboot_s: parseInt('<% get_default_reboot_time(); %>', 10) || 150,
+  http_id: '<% nvram_get("http_id"); %>'
+};
+var T = {
+  rt:`<#RMOD_1#>`, ap:`<#RMOD_2#>`, mb:`<#RMOD_3#>`, rp:`<#RMOD_4#>`, node:`<#RMOD_80#>`,
+  stepParent:`<#RMOD_11#>`, stepPass:`<#RMOD_12#>`, stepAddr:`<#RMOD_13#>`, stepReview:`<#RMOD_14#>`
+};
+var FLOWS = {
+  ap: {title:`<#RMOD_5#>`, lead:`<#RMOD_8#>`, steps:['addr','review']},
+  mb: {title:`<#RMOD_6#>`, lead:`<#RMOD_9#>`, steps:['parent','pass','addr','review']},
+  rt: {title:`<#RMOD_7#>`, lead:`<#RMOD_10#>`, steps:['review']}
+};
+
+/* the mode the box is in now, read the way Advanced_OperationMode_Content.asp reads it */
+var CUR = (function(){
+  if (NV.re_mode === '1') return 'node';
+  if (NV.sw_mode === '1') return 'rt';
+  if (NV.sw_mode === '3') return NV.wlc_psta === '1' ? 'mb' : NV.wlc_psta === '2' ? 'rp' : 'ap';
+  if (NV.sw_mode === '2') return 'rp';
+  return 'rt';
+})();
+var q = location.search.match(/[?&]mode=(ap|mb|rt)(?:&|$)/);
+var MODE = q ? q[1] : '';
+var F = FLOWS[MODE], idx = 0;
+var HOST = (NV.lan_hostname || 'router').toLowerCase() + '.local';
+var st = {lan:'dhcp', ip:'', mask:'255.255.255.0', gw:'', dns1:'', dns2:'', pick:-1, man:false,
+          mssid:'', msec:'psk2', mband:'1', pw:''};
+var SVY = {state:'idle', aps:[], err:''}, POLL = null;
+
+function esc(s){return String(s).replace(/[&<>"']/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];});}
+function fmt(s){ var a=arguments, i=1; return String(s).replace(/%s/g,function(){ return i<a.length ? a[i++] : ''; }); }
+
