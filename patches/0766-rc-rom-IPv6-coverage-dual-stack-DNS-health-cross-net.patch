diff --git a/release/src/router/rc/init.c b/release/src/router/rc/init.c
index f0eccbf42b..43cec60dfd 100644
--- a/release/src/router/rc/init.c
+++ b/release/src/router/rc/init.c
@@ -25620,6 +25620,19 @@ static void sysinit(void)
 	 * and /tmp is tmpfs so the sticky bit costs nothing. Stock ASUS/Merlin
 	 * ships 0777 here; this is a deliberate divergence. */
 	chmod("/tmp", 01777);
+	/* reaper 2026-10-09 (audit V3): the kernel half of the same promise. In a
+	 * sticky world-writable directory, root no longer follows a link another
+	 * user planted, opens another user's file or FIFO with O_CREAT, or sees a
+	 * hard link to a file the linker could not write. This covers every stock
+	 * /tmp writer too (filter_rules, nat_rules, linux.trx...) without touching
+	 * them. All four exist in this 4.19 kernel and default to 0. */
+	f_write_string("/proc/sys/fs/protected_symlinks", "1", 0, 0);
+	f_write_string("/proc/sys/fs/protected_hardlinks", "1", 0, 0);
+	f_write_string("/proc/sys/fs/protected_regular", "1", 0, 0);
+	f_write_string("/proc/sys/fs/protected_fifos", "1", 0, 0);
+	/* ...and every Reaper directory exists, root-owned, before any service
+	 * starts, so nothing can be planted in its place (shared/reaper_tmpsafe.h) */
+	reaper_tmp_mkdirs();
 #ifdef RTCONFIG_USB
 	chmod(POOL_MOUNT_ROOT, 0777);
 #endif
