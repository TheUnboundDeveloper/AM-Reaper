+		write_v6names_sdn(fp, pmtl);	/* 2026-10-08: IPv6 device names + IPv6 reverse zones, before the .add */
 		snprintf(buf, sizeof(buf), "dnsmasq-%d.conf", pmtl->sdn_t.sdn_idx);
 		append_custom_config(buf, fp);
 		fclose(fp);
