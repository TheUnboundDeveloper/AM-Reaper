+/* ---------------------------------------------------------------------------
+ * 2026-10-08: reverse DNS across networks (owner request; plan bubbly-weaving-blanket).
+ *
+ * Each dnsmasq instance answers PTR lookups only for its own leases, and with
+ * bogus-priv on it answers NXDOMAIN for every other private range - so a resolver
+ * on a VLAN (the owner's AdGuard on VLAN 52) could not name a main-LAN device and
+ * the main LAN could not name a VLAN one. dnsmasq exempts a private zone from
+ * bogus-priv once a server is configured for it (rfc1035.c, lookup_domain
+ * F_DOMAINSRV), so a rev-server line per direction is the whole fix:
+ *   main instance   : rev-server=<vlan net>/<len>,<vlan gateway>  per eligible VLAN
+ *   VLAN instance   : rev-server=<lan net>/<len>,<lan_ipaddr>     when it is eligible
+ * Owner decisions: main LAN <-> each VLAN both ways, never VLAN <-> VLAN, Guest and
+ * Portal profiles (and any captive-portal network) excluded - a PTR sweep from a
+ * guest network would otherwise list the household's device names. Behind
+ * reaper_dns_revshare (default 1). Skipped with dns_fwd_local=1 (no bogus-priv:
+ * private reverse goes upstream by the operator's choice). No loop: no instance is
+ * ever given its own subnet, and the instance asked answers its own zone itself.
+ * Both call sites sit before the custom .add append, so an operator file still wins.
+ * ------------------------------------------------------------------------- */
+#define REVSHARE_SIG "/tmp/reaper/reaper_revzone.sig"
+#define V6NAMES_DIR  "/tmp/rv6names"	/* rc/rv6names.c writes <dir>/<bridge>/hosts */
+
+static int revshare_on(void)
+{
+	return nvram_get_int("reaper_dns_revshare") == 1 && nvram_get_int("dns_fwd_local") != 1;
+}
+
+static int revshare_eligible(const MTLAN_T *m)
+{
+	if (!m || !m->enable || m->nw_t.idx == 0)	/* off, or no dnsmasq of its own (IoT / main rows) */
+		return 0;
+	if (!m->nw_t.addr[0] || !strcmp(m->nw_t.addr, nvram_safe_get("lan_ipaddr")))
+		return 0;				/* the main LAN subnet itself */
+	if (!strcasecmp(m->name, "Guest") || !strcasecmp(m->name, "Portal"))
+		return 0;
+	if (m->sdn_t.cp_idx != 0)			/* any captive-portal network */
+		return 0;
+	return 1;
+}
+
+/* the main LAN instance: one line per eligible VLAN */
+void write_rev_servers_main(FILE *fp)
+{
+	MTLAN_T *pmtl;
+	size_t mtl_sz = 0, i;
+	char net[24];
+
+	if (!fp || !revshare_on())
+		return;
+	if ((pmtl = (MTLAN_T *)INIT_MTLAN(sizeof(MTLAN_T))) == NULL)
+		return;
+	get_mtlan(pmtl, &mtl_sz);
+	for (i = 0; i < mtl_sz; i++) {
+		if (!revshare_eligible(&pmtl[i]))
+			continue;
+		if (reaper_rev_net(pmtl[i].nw_t.addr, pmtl[i].nw_t.netmask, net, sizeof(net)) > 0)
+			fprintf(fp, "rev-server=%s,%s\n", net, pmtl[i].nw_t.addr);
+	}
+	FREE_MTLAN((void *)pmtl);
+}
+
+/* a VLAN instance: one line for the main LAN, when the VLAN is eligible */
+static void write_rev_servers_sdn(FILE *fp, const MTLAN_T *self)
+{
+	char net[24];
+	const char *lip = nvram_safe_get("lan_ipaddr");
+
+	if (!fp || !revshare_on() || !revshare_eligible(self))
+		return;
+	if (reaper_rev_net(lip, nvram_safe_get("lan_netmask"), net, sizeof(net)) > 0)
+		fprintf(fp, "rev-server=%s,%s\n", net, lip);
+}
+
+
+/* ---------------------------------------------------------------------------
+ * 2026-10-08: IPv6 device names (plan bubbly-weaving-blanket; rc/rv6names.c).
+ * Each instance reads ONLY its own bridge's names (addn-hosts=<dir>/hosts; the
+ * daemon sends one SIGHUP when a file changes - NOT hostsdir=: this dnsmasq is
+ * built -DNO_INOTIFY (top Makefile COPTS) and refuses to START with hostsdir,
+ * which took DNS, DHCP and RA down on r26; `dnsmasq --test` passes it) and answers its own /64's reverse zone
+ * locally (an address-less rev-server = local-only: these zones are global, so
+ * bogus-priv does not cover them, and an unknown address would otherwise be
+ * forwarded to the LAN filter, which treats the prefix as private and asks the
+ * gateway again - a loop). Across networks the r24 policy holds (main LAN <->
+ * each eligible VLAN, never VLAN <-> VLAN, guests never); those lines need the
+ * names feature too, so the far side always answers its own zone locally.
+ * Gate: reaper_dns_v6names == 1 and IPv6 enabled; IPv6 off = nothing written.
+ * ------------------------------------------------------------------------- */
+static int v6names_on(void)
+{
+	return nvram_get_int("reaper_dns_v6names") == 1 && ipv6_enabled();
+}
+
+/* the /64 of the first global address on ifname, "<net>/64"; 0 when none */
+static int br_v6_net(const char *ifname, char *out, size_t n)
+{
+	struct ifaddrs *ifa, *p;
+	char a6[INET6_ADDRSTRLEN];
+	int ok = 0;
+
+	if (!ifname || !*ifname || getifaddrs(&ifa) != 0)
+		return 0;
+	for (p = ifa; p && !ok; p = p->ifa_next) {
+		if (!p->ifa_addr || p->ifa_addr->sa_family != AF_INET6 || strcmp(p->ifa_name, ifname))
+			continue;
+		if (!inet_ntop(AF_INET6, &((struct sockaddr_in6 *)p->ifa_addr)->sin6_addr, a6, sizeof(a6)))
+			continue;
+		ok = reaper_rev_net6(a6, out, n) > 0;
+	}
+	freeifaddrs(ifa);
+	return ok;
+}
+
+static void v6names_own(FILE *fp, const char *ifname)
+{
+	char dir[96], net[64];
+
+	snprintf(dir, sizeof(dir), V6NAMES_DIR "/%s", ifname);
+	reaper_secure_dir(V6NAMES_DIR, 0755);
+	reaper_secure_dir(dir, 0755);	/* 2026-10-09 audit V3: the per-bridge dir too */
+	{	/* the file exists before dnsmasq reads it (a missing addn-hosts file only logs, but never leave one) */
+		char hf[112];
+		int fd;
+		snprintf(hf, sizeof(hf), "%s/hosts", dir);
+		if ((fd = open(hf, O_WRONLY | O_CREAT | O_NOFOLLOW, 0644)) >= 0)
+			close(fd);
+		fprintf(fp, "addn-hosts=%s\n", hf);
+	}
+	if (br_v6_net(ifname, net, sizeof(net)))
+		fprintf(fp, "rev-server=%s\n", net);	/* local-only: answered here, never forwarded */
+}
+
+/* the main LAN instance */
+void write_v6names_main(FILE *fp)
+{
+	MTLAN_T *pmtl;
+	size_t mtl_sz = 0, i;
+	char net[64];
+
+	if (!fp || !v6names_on())
+		return;
+	v6names_own(fp, nvram_safe_get("lan_ifname"));
+	if (!revshare_on() || (pmtl = (MTLAN_T *)INIT_MTLAN(sizeof(MTLAN_T))) == NULL)
+		return;
+	get_mtlan(pmtl, &mtl_sz);
+	for (i = 0; i < mtl_sz; i++)
+		if (revshare_eligible(&pmtl[i]) && br_v6_net(pmtl[i].nw_t.ifname, net, sizeof(net)))
+			fprintf(fp, "rev-server=%s,%s\n", net, pmtl[i].nw_t.addr);
+	FREE_MTLAN((void *)pmtl);
+}
+
+/* a VLAN instance: its own names and zone; the main LAN's zone when eligible */
+static void write_v6names_sdn(FILE *fp, const MTLAN_T *self)
+{
+	char net[64];
+
+	if (!fp || !self || !v6names_on())
+		return;
+	v6names_own(fp, self->nw_t.ifname);
+	if (revshare_on() && revshare_eligible(self) && br_v6_net(nvram_safe_get("lan_ifname"), net, sizeof(net)))
+		fprintf(fp, "rev-server=%s,%s\n", net, nvram_safe_get("lan_ipaddr"));
+}
+
+/* what the lines above depend on: the switch, the main LAN and every eligible
+ * VLAN's sdn index + net + gateway, in get_mtlan order (stable for one config) */
+static void revshare_sig(char *buf, size_t n)
+{
+	MTLAN_T *pmtl;
+	size_t mtl_sz = 0, i, w;
+	char net[24];
+
+	{
+		char l6[64] = "";
+		if (v6names_on()) br_v6_net(nvram_safe_get("lan_ifname"), l6, sizeof(l6));
+		w = (size_t)snprintf(buf, n, "on=%d v6=%d lan=%s/%s %s", revshare_on(), v6names_on(), nvram_safe_get("lan_ipaddr"), nvram_safe_get("lan_netmask"), l6);
+	}
+	if (w >= n || (pmtl = (MTLAN_T *)INIT_MTLAN(sizeof(MTLAN_T))) == NULL)
+		return;
+	get_mtlan(pmtl, &mtl_sz);
+	for (i = 0; i < mtl_sz && w < n; i++) {
+		if (!revshare_eligible(&pmtl[i]) || reaper_rev_net(pmtl[i].nw_t.addr, pmtl[i].nw_t.netmask, net, sizeof(net)) <= 0)
+			continue;
+		{
+			char v6n[64] = "";
+			if (v6names_on()) br_v6_net(pmtl[i].nw_t.ifname, v6n, sizeof(v6n));
+			w += (size_t)snprintf(buf + w, n - w, " %d:%s,%s,%s", pmtl[i].sdn_t.sdn_idx, net, pmtl[i].nw_t.addr, v6n);
+		}
+	}
+	FREE_MTLAN((void *)pmtl);
+}
+
+/* start_dnsmasq() records what the instances were written for ... */
+void revshare_sig_save(void)
+{
+	char s[1024];
+
+	revshare_sig(s, sizeof(s));
+	f_write_string(REVSHARE_SIG, s, 0, 0);
+}
+
+/* ... and restart_sdn / sdn_del ask whether that still holds. A network added,
+ * removed, readdressed, retyped or toggled changes the set every instance's
+ * rev-server lines were built from; restart_sdn <idx> regenerates only that one
+ * network, so the caller restarts dnsmasq once (all instances) when this is 1. */
+int revshare_sig_changed(void)
+{
+	char now[1024], was[1024] = "";
+
+	revshare_sig(now, sizeof(now));
+	if (f_read_string(REVSHARE_SIG, was, sizeof(was)) <= 0)
+		return 0;			/* nothing recorded yet: start_dnsmasq has not run */
+	return strcmp(now, was) != 0;
+}
+
