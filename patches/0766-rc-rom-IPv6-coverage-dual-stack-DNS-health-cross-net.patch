diff --git a/release/src/router/rc/rv6names.c b/release/src/router/rc/rv6names.c
new file mode 100644
index 0000000000..84e921b181
--- /dev/null
+++ b/release/src/router/rc/rv6names.c
@@ -0,0 +1,267 @@
+/*
+ * SPDX-License-Identifier: GPL-2.0-only
+ * Copyright (C) 2026 the Reaper project maintainer
+ *
+ * reaper 2026-10-08: IPv6 device names (BACKLOG "IPv6 clients have no names in
+ * a LAN DNS filter"; plan bubbly-weaving-blanket, owner-approved).
+ *
+ * LAN devices send DNS over IPv6 from SLAAC / privacy addresses the router never
+ * handed out, and dnsmasq knows names only from DHCP leases, so a DNS filter that
+ * sees those devices (AdGuard, through the intercept) lists them as bare
+ * addresses. Every 60 s this daemon:
+ *   - dumps the bridge neighbour cache (shared/reaper_nd.c, the table httpd, gkd
+ *     and rtrafd already share),
+ *   - reads the dnsmasq lease files: a DHCPv4 lease gives MAC -> name, a DHCPv6
+ *     lease gives a name that must NOT also appear in a hosts file (dnsmasq would
+ *     then refuse that lease its name - cache.c "not giving name ..."),
+ *   - writes "<ipv6> <name>" for each global neighbour whose MAC has a usable name
+ *     into /tmp/rv6names/<bridge>/hosts - only when the content changed, through
+ *     a temp file and rename(), so dnsmasq never reads half a file, and send
+ *     ONE SIGHUP when anything changed (addn-hosts= is re-read on SIGHUP).
+ *     NOT hostsdir=: this dnsmasq is built -DNO_INOTIFY and refuses to start
+ *     with it - that took DNS, DHCP and RA down on r26.
+ * IPv6 lines only: dnsmasq compares a DHCPv4 lease's name with hosts entries of
+ * the same family, so nothing here can take an IPv4 name away. Owner decision:
+ * the plain DHCP name, so a forward lookup of that name also returns the
+ * device's current IPv6 addresses.
+ *
+ * Gate: reaper_dns_v6names == 1 (default 1) and IPv6 enabled, router mode. Off
+ * (or IPv6 off) empties every file once, so dnsmasq drops the names, then idles
+ * on one nvram read every 30 s. Syslog only on enable / disable, never per tick.
+ */
+#include "rc.h"
+#include <signal.h>
+#include <dirent.h>
+#include <sys/stat.h>
+#include <arpa/inet.h>
+
+#define V6N_TAG		"rv6names"
+#define V6N_DIR		"/tmp/rv6names"
+#define V6N_TICK	60
+#define V6N_IDLE	30
+#define V6N_ND_MAX	512
+#define V6N_LEASE_MAX	512
+#define V6N_LINES	256
+#define V6N_BUF		(V6N_LINES * (RV6N_ADDR_MAX + RV6N_NAME_MAX + 2) + 1)
+#define V6N_BR_MAX	24
+
+static volatile sig_atomic_t g_stop;
+static void on_sig(int s) { (void)s; g_stop = 1; }
+
+struct v4name { char mac[18]; char name[RV6N_NAME_MAX]; };
+
+static struct reaper_nd nd[V6N_ND_MAX];
+static struct v4name v4[V6N_LEASE_MAX];
+static char v6names[V6N_LEASE_MAX][RV6N_NAME_MAX];
+static struct rv6n_pair pairs[V6N_ND_MAX];
+static char outbuf[V6N_BUF], curbuf[V6N_BUF];
+
+static int v6n_on(void)
+{
+#ifdef RTCONFIG_IPV6
+	return nvram_get_int("reaper_dns_v6names") == 1 && ipv6_enabled() && is_routing_enabled();
+#else
+	return 0;
+#endif
+}
+
+/* every dnsmasq lease file: the main one and one per SDN instance */
+static void read_leases(int *n4, int *n6)
+{
+	DIR *d;
+	struct dirent *e;
+	char path[300], line[512], mac[18], name[RV6N_NAME_MAX];
+	FILE *f;
+
+	*n4 = *n6 = 0;
+	if ((d = opendir("/var/lib/misc")) == NULL)
+		return;
+	while ((e = readdir(d)) != NULL) {
+		size_t l = strlen(e->d_name);
+		if (strncmp(e->d_name, "dnsmasq", 7) != 0 || l < 7 || strcmp(e->d_name + l - 7, ".leases") != 0)
+			continue;
+		snprintf(path, sizeof(path), "/var/lib/misc/%s", e->d_name);
+		if ((f = fopen(path, "r")) == NULL)
+			continue;
+		while (fgets(line, sizeof(line), f)) {
+			int k = rv6n_lease_line(line, mac, sizeof(mac), name, sizeof(name));
+			if (k == 4 && *n4 < V6N_LEASE_MAX) {
+				strlcpy(v4[*n4].mac, mac, sizeof(v4[*n4].mac));
+				strlcpy(v4[*n4].name, name, sizeof(v4[*n4].name));
+				(*n4)++;
+			} else if (k == 6 && *n6 < V6N_LEASE_MAX)
+				strlcpy(v6names[(*n6)++], name, RV6N_NAME_MAX);
+		}
+		fclose(f);
+	}
+	closedir(d);
+}
+
+static const char *name_of(const char *mac, int n4)
+{
+	int i;
+	for (i = 0; i < n4; i++)
+		if (!strcasecmp(v4[i].mac, mac))
+			return v4[i].name;
+	return NULL;
+}
+
+static int is_v6lease_name(const char *name, int n6)
+{
+	int i;
+	for (i = 0; i < n6; i++)
+		if (!strcasecmp(v6names[i], name))
+			return 1;
+	return 0;
+}
+
+/* write dir/hosts only when it differs; returns 1 when rewritten */
+static int put_file(const char *br, const char *content)
+{
+	char dir[96], path[128];
+	FILE *f;
+	long n;
+
+	if (!br[0] || strchr(br, '/') || br[0] == '.')
+		return 0;
+	snprintf(dir, sizeof(dir), V6N_DIR "/%s", br);
+	reaper_secure_dir(V6N_DIR, 0755);
+	if (reaper_secure_dir(dir, 0755) != 0)	/* 2026-10-09 (audit V3): root-owned, dnsmasq (nobody) only reads */
+		return 0;
+	snprintf(path, sizeof(path), "%s/hosts", dir);
+	curbuf[0] = '\0';
+	if ((f = fopen(path, "r")) != NULL) {
+		n = (long)fread(curbuf, 1, sizeof(curbuf) - 1, f);
+		curbuf[n > 0 ? n : 0] = '\0';
+		fclose(f);
+		if (!strcmp(curbuf, content))
+			return 0;
+	} else if (!content[0]) {
+		/* no file and nothing to say: create it empty so the dir is never bare */
+	}
+	/* 2026-10-09 (audit V3): rc runs with umask 0, so the old fopen("w") temp
+	 * file was 0666 until the chmod - long enough for dnsmasq (nobody, which
+	 * reads this directory) to open it for writing and keep that handle past
+	 * the rename. The temp file is now created 0600 (mkstemp) and opened up to
+	 * 0644 only once it is complete; dnsmasq still reads it, never writes it. */
+	if (reaper_write_atomic(path, content, strlen(content), 0644) != 0)
+		return 0;
+	return 1;
+}
+
+/* every dnsmasq instance re-reads its addn-hosts file on SIGHUP */
+static void v6n_reload(void)
+{
+#ifdef RTCONFIG_MULTILAN_CFG
+	reload_dnsmasq(ALL_SDN);
+#else
+	reload_dnsmasq();
+#endif
+}
+
+/* empty every existing bridge file (switch off / IPv6 off) */
+static void clear_all(void)
+{
+	DIR *d;
+	struct dirent *e;
+	int changed = 0;
+
+	if ((d = opendir(V6N_DIR)) == NULL)
+		return;
+	while ((e = readdir(d)) != NULL)
+		if (e->d_name[0] != '.')
+			changed |= put_file(e->d_name, "");
+	closedir(d);
+	if (changed)
+		v6n_reload();
+}
+
+static void tick(void)
+{
+	char brs[V6N_BR_MAX][16];
+	int nbr = 0, nn, n4, n6, i, b, changed = 0;
+	DIR *d;
+	struct dirent *e;
+
+	nn = reaper_nd_load(nd, V6N_ND_MAX);
+	read_leases(&n4, &n6);
+
+	/* every bridge we must speak for: the ones with neighbours and the ones
+	 * whose directory exists (a dnsmasq instance reads it - keep it current) */
+	for (i = 0; i < nn && nbr < V6N_BR_MAX; i++) {
+		for (b = 0; b < nbr && strcmp(brs[b], nd[i].br); b++) ;
+		if (b == nbr && nd[i].br[0]) strlcpy(brs[nbr++], nd[i].br, sizeof(brs[0]));
+	}
+	if ((d = opendir(V6N_DIR)) != NULL) {
+		while ((e = readdir(d)) != NULL && nbr < V6N_BR_MAX) {
+			if (e->d_name[0] == '.') continue;
+			for (b = 0; b < nbr && strcmp(brs[b], e->d_name); b++) ;
+			if (b == nbr) strlcpy(brs[nbr++], e->d_name, sizeof(brs[0]));
+		}
+		closedir(d);
+	}
+
+	for (b = 0; b < nbr; b++) {
+		int np = 0;
+		for (i = 0; i < nn; i++) {
+			const char *nm;
+			if (strcmp(nd[i].br, brs[b]) || !reaper_nd_global(nd[i].ip))
+				continue;
+			if ((nm = name_of(nd[i].mac, n4)) == NULL || is_v6lease_name(nm, n6))
+				continue;
+			if (!inet_ntop(AF_INET6, nd[i].ip, pairs[np].addr, sizeof(pairs[np].addr)))
+				continue;
+			strlcpy(pairs[np].name, nm, sizeof(pairs[np].name));
+			np++;
+		}
+		if (rv6n_render(pairs, np, V6N_LINES, outbuf, sizeof(outbuf)) < 0)
+			outbuf[0] = '\0';
+		changed |= put_file(brs[b], outbuf);
+	}
+	if (changed)
+		v6n_reload();	/* one SIGHUP per tick, only when a file really changed */
+}
+
+int rv6names_main(int argc, char *argv[])
+{
+	int was = -1, on, i;
+	(void)argc; (void)argv;
+
+	signal(SIGTERM, on_sig);
+	signal(SIGINT, on_sig);
+	signal(SIGHUP, SIG_IGN);
+	if (daemon(1, 0) < 0)
+		return 1;
+
+	while (!g_stop) {
+		on = v6n_on();
+		if (on != was) {
+			if (on)
+				logmessage(V6N_TAG, "IPv6 device names on - LAN devices' IPv6 addresses are named after their DHCP leases, refreshed every %d s", V6N_TICK);
+			else if (was == 1)
+				logmessage(V6N_TAG, "IPv6 device names off - the names were withdrawn");
+			if (!on)
+				clear_all();
+			was = on;
+		}
+		if (on)
+			tick();
+		for (i = 0; i < (on ? V6N_TICK : V6N_IDLE) && !g_stop; i++)
+			sleep(1);
+	}
+	return 0;
+}
+
+void stop_rv6names(void)
+{
+	if (pids("rv6names"))
+		killall_tk("rv6names");
+}
+
+void start_rv6names(void)
+{
+	stop_rv6names();
+	if (!is_routing_enabled())
+		return;
+	xstart("rv6names");
+}
