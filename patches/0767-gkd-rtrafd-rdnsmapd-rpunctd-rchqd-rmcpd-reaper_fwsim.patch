+/* a remote IPv6 end: globally routed (2000::/3 - which excludes loopback,
+ * link-local, ULA, multicast, mapped and unspecified) and not under one of the
+ * router's own LAN prefixes */
+static int rdm_remote6(const uint8_t *a)
+{
+	int i;
+
+	if ((a[0] & 0xe0) != 0x20)
+		return 0;
+	for (i = 0; i < rdm_lan6_n; i++)
+		if (memcmp(a, rdm_lan6[i], 8) == 0)
+			return 0;
+	return 1;
+}
