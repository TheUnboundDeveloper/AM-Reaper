+/* returns 1 when the address moved off `want` */
+static int host_free(const struct addr *net, int want, char *out, size_t len)
+{
+	unsigned v, base, mask, hostmax, h, cand = 0; struct addr a; int i, k, tries, found = 0;
+	if (net->fam != 4 || net->plen < 8 || net->plen > 30) { host_in_subnet(net, want, out, len); return 0; }
