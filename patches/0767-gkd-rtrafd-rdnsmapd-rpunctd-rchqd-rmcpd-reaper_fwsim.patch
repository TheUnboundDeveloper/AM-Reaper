+/* v1.10 (2026-10-09, owner report): the synthetic witness hosts were always
+ * .123 (source) and .124 (destination) in their subnet, and a DHCP pool that
+ * covers them hands those addresses to real devices - the Devices page listed
+ * a phone at the walker's stand-in 192.168.50.123 while Rule Status said the
+ * stand-ins are "not devices on your network". A rule or reservation aimed at
+ * that device would then be judged for the walker. A stand-in now skips every
+ * IPv4 address in use: the ARP table, the dnsmasq leases (every instance), the
+ * DHCP reservations (main + per SDN network), the router's own addresses, and
+ * a stand-in already handed out for another role in the same subnet. The scan
+ * starts at the old number, so an idle .123 stays .123. Host build: --used
+ * FILE (any text; every IPv4 address in it counts). IPv6 is unchanged: its
+ * stand-in ::23 sits in a /64 of SLAAC/privacy addresses. Common code. */
+#define USED_MAX 2048
+static unsigned used4[USED_MAX];
+static int nused4;
+
+static void used_scan(const char *s)
+{
+	const char *p = s;
+	while (*p) {
+		unsigned o[4]; int n = 0;
+		if (isdigit((unsigned char)*p) && (p == s || (!isdigit((unsigned char)p[-1]) && p[-1] != '.'))
