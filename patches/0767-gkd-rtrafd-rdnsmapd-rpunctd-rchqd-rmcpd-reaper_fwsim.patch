-static int rdm_targets(uint32_t *out, int max, struct rdm_ent *t, uint32_t now)
+/* IPv6 (2026-10-07): the /64 prefixes of the router's own global addresses on
+ * LAN bridges. IPv6 is not translated, so a LAN client's address is as global
+ * as the remote end's; the prefix the router announces is what tells them apart. */
+#define RDM_LAN6_MAX 16
+static uint8_t rdm_lan6[RDM_LAN6_MAX][8];
+static int rdm_lan6_n;
+
+static void rdm_lan6_load(void)
+{
+	FILE *f = fopen(RDM_IF6, "r");
+	char ln[256], hex[40], ifn[32];
+	unsigned scope;
+
+	rdm_lan6_n = 0;
+	if (!f)
+		return;
+	/* <32 hex> <ifindex> <prefixlen> <scope> <flags> <ifname>; scope 0 = global */
+	while (rdm_lan6_n < RDM_LAN6_MAX && fgets(ln, sizeof(ln), f)) {
+		int i;
+
+		if (sscanf(ln, "%39s %*x %*x %x %*x %31s", hex, &scope, ifn) != 3)
+			continue;
+		if (strlen(hex) != 32 || scope != 0 || ifn[0] != 'b' || ifn[1] != 'r')
+			continue;
+		for (i = 0; i < 8; i++) {
+			unsigned b;
+
+			if (sscanf(hex + i * 2, "%2x", &b) != 1)
+				break;
+			rdm_lan6[rdm_lan6_n][i] = (uint8_t)b;
+		}
+		if (i == 8)
+			rdm_lan6_n++;
+	}
+	fclose(f);
+}
