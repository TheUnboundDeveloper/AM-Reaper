+		    && !isdigit((unsigned char)p[n]) && p[n] != '.') {
+			if (nused4 < USED_MAX) used4[nused4++] = (o[0] << 24) | (o[1] << 16) | (o[2] << 8) | o[3];
+			p += n;
+			continue;
+		}
+		p++;
+	}
+}
