From a95c74273a2348ef900a292c70e552ec1117a6cd Mon Sep 17 00:00:00 2001
From: reaper <theunbounddeveloper@outlook.com>
Date: Fri, 16 Oct 2026 14:43:00 -0400
Subject: [PATCH] rc: a factory box joining an AiMesh system gets WPS on its
 onboarding band

Reaper ships the WPS setting off (wps_enable / wps_enable_x "0", since
v2.0.4); stock ships it on. generate_wl_para() sets each radio's wps_mode
with every arm inside wps_enable == "1" - including the arm stock uses
while an unconfigured router-mode box enrolls into an AiMesh system
(amesh_wps_enr, set by rc's wps_enr service, unset at every boot in
init.c). A factory Reaper box asked to join a mesh therefore came up with
WPS disabled on its onboarding band. Field: a ZenWiFi BQ16 on Reaper
would not join a GT-BE98 main router with MLO on ("Unable to add" with
the progress near 24%); the same unit on stock firmware joined.

reaper_amesh_wps_enrollee() ORs that one arm back in on its own: router
mode, x_Setting 0, not a node, amesh_wps_enr set, on the band the stock
arm names. It only reads nvram - the user's WPS setting stays off - and
the window closes with the reboot that ends the join. Logged as
"aimesh: wlN: WPS on for the AiMesh join of this factory box". Lean:
test_aimesh_wps_enrollee.py (the helper compiled against stub nvram, an
eight-row truth table; two negative controls fail), one marker.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 release/src/router/rc/sysdeps/init-broadcom.c | 54 ++++++++++++++++++-
 1 file changed, 52 insertions(+), 2 deletions(-)

diff --git a/release/src/router/rc/sysdeps/init-broadcom.c b/release/src/router/rc/sysdeps/init-broadcom.c
index 3690342c9b7..35ec6d18fde 100644
--- a/release/src/router/rc/sysdeps/init-broadcom.c
+++ b/release/src/router/rc/sysdeps/init-broadcom.c
@@ -10575,6 +10575,51 @@ void adjust_txbf_bfe_cap(int unit, char *orig_txbf_bfe_cap)
 	}
 }
 
+#if defined(RTCONFIG_AMAS) && defined(RTCONFIG_PROXYSTA)
+/* reaper 2026-10-16: the AiMesh join of a factory box, with the WPS setting off.
+ *
+ * Reaper ships WPS off (wps_enable / wps_enable_x "0", v2.0.4); stock ships it on.
+ * The wps_mode rule in generate_wl_para() nests every arm inside wps_enable == "1",
+ * including the one stock uses while an unconfigured router-mode box enrolls into
+ * an AiMesh system (amesh_wps_enr: set by the rc "wps_enr" service, unset at every
+ * boot in init.c). A factory Reaper box asked to join a mesh therefore had WPS
+ * disabled on its onboarding band. Field: a ZenWiFi BQ16 on Reaper would not join a
+ * GT-BE98 main router with MLO on; the same unit on stock firmware joined.
+ *
+ * This lets that one arm stand on its own, and only that arm: an unconfigured
+ * (x_Setting 0) router-mode box that is not a node, while amesh_wps_enr is set, on
+ * the band the stock arm names. wps_enable / wps_enable_x are never written, so the
+ * user's WPS setting stays as it is; the window ends with the reboot that finishes
+ * the join (or any reboot, which clears amesh_wps_enr). */
+static int reaper_amesh_wps_enrollee(int unit)
+{
+	if (nvram_match("wps_enable", "1"))
+		return 0;			/* the stock rule already covers this box */
+	if (!is_router_mode() || nvram_get_int("x_Setting") || nvram_get_int("re_mode") == 1)
+		return 0;
+	if (!nvram_get_int("amesh_wps_enr"))
+		return 0;
+#ifdef RTCONFIG_AMAS_5G_ONBOARDING
+	{
+		char tmp[100], prefix[] = "wlXXXXXXXXXX_";
+
+		snprintf(prefix, sizeof(prefix), "wl%d_", unit);
+		if (nvram_get_int(strcat_r(prefix, "nband", tmp)) == 4)
+			return 0;
+#if (defined(RTCONFIG_HAS_5G_2) && !defined(RTCONFIG_WIFI6E)) || (defined(RTCONFIG_QUADBAND) && !defined(RTCONFIG_HAS_6G_2))
+		if (unit == WL_5G_BAND)
+			return 0;
+#endif
+	}
+#else
+	if (unit != WL_2G_BAND && unit != nvram_get_int("wps_band_x"))
+		return 0;
+#endif
+	logmessage("aimesh", "wl%d: WPS on for the AiMesh join of this factory box (the WPS setting itself stays off)", unit);
+	return 1;
+}
+#endif
+
 void generate_wl_para(char *ifname, int unit, int subunit)
 {
 	dbG("unit %d subunit %d\n", unit, subunit);
@@ -10692,7 +10737,7 @@ void generate_wl_para(char *ifname, int unit, int subunit)
 #else
 		p = prefix;
 #endif
-		nvram_set(strcat_r(p, "wps_mode", tmp), (nvram_match("wps_enable", "1") && (is_ap(unit)
+		nvram_set(strcat_r(p, "wps_mode", tmp), ((nvram_match("wps_enable", "1") && (is_ap(unit)
 #ifdef RTCONFIG_PROXYSTA
 			|| (!nvram_get_int("x_Setting") &&
 #ifdef RTCONFIG_AMAS_5G_ONBOARDING
@@ -10712,7 +10757,12 @@ void generate_wl_para(char *ifname, int unit, int subunit)
 #endif
 			))
 #endif
-			)) ? "enabled" : "disabled");
+			))
+#if defined(RTCONFIG_AMAS) && defined(RTCONFIG_PROXYSTA)
+			/* reaper 2026-10-16: the AiMesh join of a factory box, see reaper_amesh_wps_enrollee() */
+			|| reaper_amesh_wps_enrollee(unit)
+#endif
+			) ? "enabled" : "disabled");
 
 #ifdef RTCONFIG_MULTILAN_MWL
 		if (nvram_get_int("w_Setting") && strcmp(prefix, prefix2) && !strcmp(p, prefix2))
-- 
