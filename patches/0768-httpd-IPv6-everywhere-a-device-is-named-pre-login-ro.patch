+/* 2026-10-07 (IPv6 A1): the fcache feed (/proc/fcache/nflist) is IPv4. IPv6 flows
+ * come from the conntrack table the CGI already reads for the TCP state, one row
+ * each, keyed by a hash of the tuple ("6" + 16 hex) that is stable across polls
+ * so the page's grouping and rate work unchanged. They carry no accelerator
+ * figures (hw 0, sw = bytes, "fam":6 so the page says so). IPv6 is not
+ * translated, so a subnet test cannot tell the LAN end: the neighbour cache
+ * (shared/reaper_nd.h, refreshed at most every 2 s) and the bridges' own
+ * addresses are the LAN side; a flow with neither end there is transit. */
+#define RCONN_V6_MAX 1024	/* rows kept per poll: bounded RAM on a busy dual-stack LAN */
+#define RCONN_ND     512
+struct rconn_v6 { char s[46], d[46]; int proto, sp, dp; unsigned long long pk, by; char st[16]; };
+static struct reaper_nd rconn_ndt[RCONN_ND];
+static int rconn_ndn;
+static time_t rconn_nd_at;
+
+static uint64_t rconn_fnv64(const char *s)
+{
+	uint64_t h = 0xcbf29ce484222325ULL;
+
+	for (; *s; s++) {
+		h ^= (unsigned char)*s;
+		h *= 0x100000001b3ULL;
+	}
+	return h;
+}
+
+/* 2026-10-08: a flow-cache tuple "<a.b.c.d:port>" has exactly one colon before its closing bracket. An IPv6
+ * tuple ("<2001:470:...:443>") matched "<%23[0-9.]:%d>" on its first group and became address "2001",
+ * port 470 (owner: Connections rows "2001" -> "2001:470"). IPv6 flows are read from conntrack instead. */
+static int fc_tuple_is_v4(const char *p)
+{
+	int colons = 0;
+	if (!p || *p != '<') return 0;
+	for (p++; *p && *p != '>'; p++)
+		if (*p == ':') colons++;
+	return *p == '>' && colons == 1;
+}
+
+/* one "ipv6 ..." conntrack line -> a row (original tuple; both directions' counters) */
+static void rconn_v6_row(const char *ctl, struct rconn_v6 **v, int *n, int *cap)
+{
+	struct rconn_v6 r;
+	const char *p, *sv, *b, *e;
+	char pname[16];
+	unsigned long long pk2 = 0, by2 = 0;
+	int stl;
+
+	if (*n >= RCONN_V6_MAX)
+		return;
+	memset(&r, 0, sizeof(r));
+	if (sscanf(ctl, "%*s %*d %15s %d", pname, &r.proto) != 2)
+		return;
+	if ((sv = strstr(ctl, "src=")) == NULL)
+		return;
+	if (strcmp(pname, "tcp") == 0) {		/* the state word sits right before the first src= */
+		e = sv; while (e > ctl && e[-1] == ' ') e--;
+		b = e;  while (b > ctl && b[-1] != ' ') b--;
+		stl = (int)(e - b);
+		if (stl > 0 && stl < (int)sizeof(r.st)) { memcpy(r.st, b, (size_t)stl); r.st[stl] = '\0'; }
+	}
+	if (sscanf(sv, "src=%45[0-9a-fA-F:] dst=%45[0-9a-fA-F:]", r.s, r.d) != 2)
+		return;
+	if ((p = strstr(sv, "sport=")) != NULL) sscanf(p, "sport=%d dport=%d", &r.sp, &r.dp);
+	if ((p = strstr(sv, "packets=")) != NULL) sscanf(p, "packets=%llu bytes=%llu", &r.pk, &r.by);
+	if (p && (p = strstr(p + 8, "packets=")) != NULL && sscanf(p, "packets=%llu bytes=%llu", &pk2, &by2) == 2) {
+		r.pk += pk2;
+		r.by += by2;
+	}
+	if (*n == *cap) {
+		int nc = *cap ? *cap * 2 : 64;
+		struct rconn_v6 *nv = realloc(*v, (size_t)nc * sizeof(**v));
+
+		if (nv == NULL) return;
+		*v = nv; *cap = nc;
+	}
+	(*v)[(*n)++] = r;
+}
+
+/* the LAN bridges' own IPv6 addresses (not link-local): the router's ends */
+static int rconn_rtr6_load(struct in6_addr *out, int max)
+{
+	struct ifaddrs *ifa, *p;
+	int n = 0;
+
+	if (getifaddrs(&ifa) != 0)
+		return 0;
+	for (p = ifa; p && n < max; p = p->ifa_next) {
+		const struct in6_addr *a;
+
+		if (!p->ifa_addr || p->ifa_addr->sa_family != AF_INET6 || strncmp(p->ifa_name, "br", 2) != 0)
+			continue;
+		a = &((struct sockaddr_in6 *)p->ifa_addr)->sin6_addr;
+		if (IN6_IS_ADDR_LINKLOCAL(a))
+			continue;
+		out[n++] = *a;
+	}
+	freeifaddrs(ifa);
+	return n;
+}
+
+static int rconn_is_rtr6(const struct in6_addr *rt, int n, const struct in6_addr *a)
+{
+	int i;
+
+	for (i = 0; i < n; i++)
+		if (memcmp(&rt[i], a, 16) == 0) return 1;
+	return 0;
+}
