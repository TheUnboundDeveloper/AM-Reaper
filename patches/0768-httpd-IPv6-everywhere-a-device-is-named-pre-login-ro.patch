+#ifdef RTCONFIG_IPV6
+/* reaper 2026-10-09 (BACKLOG "Internet Card on the Dashboard does not refresh for
+ * IPv6"): networkmap fills a client's global IPv6 address on its own schedule
+ * (ip6_prefix - the stock pages label it the IPv6 address; ip6 is the link-local),
+ * so the Dashboard and Network Map lists showed dual-stack devices with no IPv6
+ * until something prodded networkmap. Fill an EMPTY ip6_prefix of an online client
+ * from the kernel neighbour cache (shared/reaper_nd.h: bridges only, live states
+ * only); never override what networkmap reports. get_clientlist() is polled by the
+ * Dashboard every 10 s, so the dump is taken at most once per 5 s. */
+#define RCLI_ND 512
+static struct reaper_nd rcli_ndt[RCLI_ND];
+static int rcli_ndn;
+static time_t rcli_nd_at;
+
+static int rcli_nd_fill(const char *mac, char *out, size_t outlen)
+{
+	unsigned char a[16];
+	time_t now = time(NULL);
+
+	if (!rcli_nd_at || now < rcli_nd_at || now - rcli_nd_at >= 5) {
+		rcli_ndn = ipv6_enabled() ? reaper_nd_load(rcli_ndt, RCLI_ND) : 0;
+		rcli_nd_at = now;
+	}
+	if (!reaper_nd_addr_of(rcli_ndt, rcli_ndn, mac, a))
+		return 0;
+	return inet_ntop(AF_INET6, a, out, outlen) != NULL;
+}
+#endif
