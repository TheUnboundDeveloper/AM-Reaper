diff --git a/release/src/router/others/reaper_diag b/release/src/router/others/reaper_diag
index 7094733e55..cfb50dec64 100644
--- a/release/src/router/others/reaper_diag
+++ b/release/src/router/others/reaper_diag
@@ -1,6 +1,6 @@
 #!/bin/sh
 # ============================================================================
-#  REAPER-DIAG v1.3.29 (2026-10-05) - sanitized one-shot diagnostic bundle
+#  REAPER-DIAG v1.3.33 (2026-10-09) - sanitized one-shot diagnostic bundle
 #  Runs on ANY Reaper model (RT-BE96U / RT-BE86U / RT-BE88U / GT-BE98 /
 #  GT-BE98_PRO) - radios, ports and features are discovered at runtime.
 #
@@ -49,6 +49,29 @@
 #  rotated copy is named when the live mirror is between rotation and the next
 #  tick.
 #
+#  v1.3.30 (IPv6 pass, 2026-10-07): the Warden and Gatekeeper sections print the
+#  ip6tables chain and its counters beside the iptables ones; the connection
+#  section counts conntrack by family.
+#
+#  v1.3.31 (IPv6 tunnel day, 2026-10-08): section 4b gives every network its IPv6
+#  switch, bridge address presence, RA/DHCPv6 DNS option and dnsmasq .conf.add; section
+#  5 adds the resolver health check (targets by kind, state, per-face markers and the
+#  upstream order by role, never by address); section 6 adds the IPv6 DNS servers by
+#  kind, the 6in4/6to4/6rd tunnel (device, default route, first hop) and the
+#  tunnelbroker DDNS rule; section 14c reads the DNS intercept gate per family and
+#  flags a gate that disagrees with the health check.
+#
+#  v1.3.32 (same day): section 5 adds reverse DNS across networks (switch, rev-server
+#  lines per instance) and IPv6 device names (switch, daemon, names per bridge, names file
+#  per instance) - counts only, never a name or an address.
+#
+#  v1.3.33 (2026-10-09, audit V3): section 3 reports the /tmp hardening - the four
+#  fs.protected_* values and the owner/mode of each Reaper directory, with findings for a
+#  value that is not 1, a directory that is absent or not private, and anything rc moved
+#  aside. Scratch files moved into /tmp/reaper; the report is created fresh under noclobber.
+#  Section 7 prints the dynamic-puncturing gain and interval rpunctd actually applies (a stored
+#  0 means the preset's value, and used to print as a raw 0).
+#
 #  TWO RULES FOR ANYONE ADDING A SECTION BELOW:
 #    1. Never emit a container's CONTENTS when its SIZE answers the question.
 #       ipset member lists are dumped with `ipset list -t` (header only) for
@@ -63,20 +86,24 @@
 #  are one-shot cats. Do not add an unbounded command here.
 # ============================================================================
 PATH=/sbin:/bin:/usr/sbin:/usr/bin
-VER="REAPER-DIAG v1.3.29"
+VER="REAPER-DIAG v1.3.33"
 T0="$(date +%s 2>/dev/null)"
 MODEL="$(nvram get productid 2>/dev/null)"
 EXTNO="$(nvram get extendno 2>/dev/null)"
 STAMP="$(date +%Y%m%d_%H%M%S)"
-RAW="/tmp/.rdiag_raw.$$"
-SLIST="/tmp/.rdiag_secrets.$$"
-AWKP="/tmp/.rdiag_awk.$$"
-BODY="/tmp/.rdiag_body.$$"
-LEDG="/tmp/.rdiag_ledger.$$"
-FIND="/tmp/.rdiag_find.$$"
-RAW2="/tmp/.rdiag_raw2.$$"
-SNAP="/tmp/.rdiag_syslog.$$"
-CTS="/tmp/.rdiag_ct.$$"
+# 2026-10-09 (audit V3): scratch files live in Reaper's private directory (rc
+# creates /tmp/reaper root-owned 0700 at boot), never as guessable names in /tmp
+SCR=/tmp/reaper
+{ [ -d "$SCR" ] && [ ! -L "$SCR" ]; } || SCR=/tmp
+RAW="$SCR/.rdiag_raw.$$"
+SLIST="$SCR/.rdiag_secrets.$$"
+AWKP="$SCR/.rdiag_awk.$$"
+BODY="$SCR/.rdiag_body.$$"
+LEDG="$SCR/.rdiag_ledger.$$"
+FIND="$SCR/.rdiag_find.$$"
+RAW2="$SCR/.rdiag_raw2.$$"
+SNAP="$SCR/.rdiag_syslog.$$"
+CTS="$SCR/.rdiag_ct.$$"
 OUT="/tmp/reaper_diag_${MODEL}_${STAMP}.txt"
 umask 077
 trap 'rm -f $RAW $RAW2 $SLIST $SLIST.s $AWKP $BODY $LEDG $FIND $SNAP $CTS' EXIT
@@ -394,6 +421,28 @@ else
   if ! ( : > /jffs/.reaper_diag_w 2>/dev/null && rm -f /jffs/.reaper_diag_w ); then finding WARN "/jffs write test FAILED - Reaper lists cannot persist"; fi
 fi
 echo "  -- top (snapshot) --"; top -bn1 2>/dev/null | head -12 | sed 's/^/  /'
+# v1.3.33 (2026-10-09, audit V3): the /tmp hardening - the four kernel link protections
+# rc sets at boot, and Reaper's private directories (fixed names; owner and mode only).
+echo "  -- /tmp hardening --"
+TPS=""
+for k in symlinks hardlinks regular fifos; do
+  v="$(cat /proc/sys/fs/protected_$k 2>/dev/null)"; TPS="$TPS $k=${v:-?}"
+  [ "$v" = 1 ] || finding WARN "kernel protection fs.protected_$k is ${v:-unreadable}, not 1 - root can be steered through links or files another user planted in /tmp (see 3)"
+done
+echo "  protected_*       :$TPS"
+for d in /tmp/reaper:drwx------ /tmp/reaper_fw:drwx------ /tmp/reaper_pbr:drwx------ /tmp/rwarden:drwx------ \
+         /tmp/gk:drwx------ /tmp/reaper_wifi:drwx------ /tmp/rtraf:drwx------ /tmp/reaper_chq:drwx------ \
+         /tmp/reaper_mcp:drwx------ /tmp/reaper_bwfloor:drwx------ /tmp/err_rules:drwx------ /tmp/rv6names:drwxr-xr-x; do
+  p=${d%%:*}; want=${d#*:}
+  l="$(ls -lnd "$p" 2>/dev/null)"
+  if [ -z "$l" ]; then echo "  $p : absent"; finding WARN "$p is absent - rc creates it at boot; the module that uses it cannot keep its state private (see 3)"; continue; fi
+  m=${l%% *}; u="$(echo "$l" | awk '{print $3}')"
+  echo "  $p : $m uid $u"
+  { [ "$u" = 0 ] && [ "$m" = "$want" ]; } || finding WARN "$p is $m uid $u, expected $want uid 0 - a directory root keeps scripts or state in is not private (see 3)"
+done
+TAS="$(ls -d /tmp/*.bad.* 2>/dev/null | wc -l)"
+echo "  moved aside       : $TAS"
+[ "$TAS" -gt 0 ] && finding WARN "$TAS item(s) named *.bad.* in /tmp: something non-root held a Reaper directory name and rc moved it aside - check syslog for 'was not a private directory' (see 3)"
 
 sec "3b. NVRAM HYGIENE (names and sizes only - values never printed)"
 # The HND kernel nvram store rejects any name+value tuple over 1024 bytes and
@@ -445,6 +494,23 @@ for C in /etc/dnsmasq.conf /etc/dnsmasq-*.conf; do
   I="$(grep -E '^interface=' "$C" 2>/dev/null | head -1 | cut -d= -f2)"
   echo "  $(basename $C)  if=${I:-?}  dns=${D:-(router)}"
 done
+# v1.3.31: per-network IPv6. subnet_rl field 14 is the network's IPv6 switch (stock
+# tagged it a Wi-Fi setting, so it was unreachable on wired-only VLANs until r14); the
+# RA/DHCPv6 DNS option is printed by kind only, never by address.
+echo "  -- IPv6 per network (subnet_rl v6 switch, bridge address, advertised IPv6 DNS) --"
+nvram get subnet_rl 2>/dev/null | tr '<' '\n' | awk -F'>' 'NF>13 {print $2, $14}' | while read BR V6E; do
+  G6="$(ip -6 addr show dev "$BR" scope global 2>/dev/null | grep -c inet6)"
+  echo "  $BR  v6_enable=${V6E:-?}  global-v6=$( [ "${G6:-0}" -gt 0 ] && echo "PRESENT x$G6" || echo none)"
+  [ "$V6E" = 1 ] && [ "${G6:-0}" -eq 0 ] && [ "$(nvram get ipv6_service 2>/dev/null)" != disabled ] && finding WARN "network $BR has IPv6 switched on but its bridge has no global IPv6 address (see 4b)"
+done
+for C in /etc/dnsmasq.conf /etc/dnsmasq-*.conf; do
+  [ -f "$C" ] || continue
+  O6="$(sed -n 's/^dhcp-option=[^,]*,option6:23,//p' "$C" 2>/dev/null | head -1)"
+  PF6="$(nvram get ipv6_prefix 2>/dev/null | sed 's/::$//')"
+  K6=""; for a in $(echo "$O6" | tr ',' ' '); do case "$a" in "[::]") K6="$K6 router";; 2606:4700:*) K6="$K6 cloudflare";; 2001:4860:*) K6="$K6 google";; fd*|fc*) K6="$K6 ula";; *) if [ -n "$PF6" ] && [ "${a#$PF6}" != "$a" ]; then K6="$K6 own-prefix(lan)"; else K6="$K6 other"; fi;; esac; done
+  AD="/jffs/configs/$(basename "$C").add"
+  echo "  $(basename $C)  ipv6-dns:${K6:- (none advertised)}  .conf.add=$([ -f "$AD" ] && echo "present ($(grep -c . "$AD") lines)" || echo none)"
+done
 echo "  -- SDN firewall chains present --"
 for CH in SDN_FI SDN_FF SDN_IA; do printf "  %-7s %s\n" "$CH" "$(iptables -nL $CH 2>/dev/null | tail -n +3 | wc -l) rules"; done
 
@@ -508,6 +574,40 @@ else
   echo "  upstream resolvers: NONE in /tmp/resolv.dnsmasq (wan0_dns=$(nvram get wan0_dns 2>/dev/null)) - dnsmasq is forwarding nowhere; the syslog 'using nameserver' lines in 19 are the truth"
   [ "$(nvram get wan0_state_t 2>/dev/null)" = 2 ] && finding INFO "dnsmasq has no upstream resolver in its servers-file while the WAN is up (see 5)"
 fi
+# v1.3.31: the resolver health check (rc/rdnshc.c). Targets by kind, the state, the
+# per-face markers (r18) and the upstream order by ROLE - the watched server's two
+# faces against everything else - so a list that puts an off-site server ahead of the
+# on-site one is visible without printing a single address.
+HCT="$(nvram get reaper_dnshc_target 2>/dev/null)"; HCT6="$(nvram get reaper_dnshc_target6 2>/dev/null)"
+hck() { case "$1" in "") echo none;; 10.*|192.168.*|172.1[6-9].*|172.2[0-9].*|172.3[01].*) echo lan-v4;; *:*) echo v6;; *) echo external;; esac; }
+echo "  health check      : enable=$(nvram get reaper_dnshc_enable 2>/dev/null) target=$(hck "$HCT") target6=$(hck "$HCT6") state='$(nvram get reaper_dnshc_state 2>/dev/null)' strict-order=$(nvram get reaper_dns_strict 2>/dev/null)"
+echo "  health markers    : demoted=$([ -e /tmp/reaper/rdnshc.state ] && echo yes || echo no) ipv4-face-down=$([ -e /tmp/reaper/rdnshc.down4 ] && echo yes || echo no) ipv6-face-down=$([ -e /tmp/reaper/rdnshc.down6 ] && echo yes || echo no)"
+HCO=""
+for u in $(sed -n 's/^server=\([^/][^# ]*\).*/\1/p' /tmp/resolv.dnsmasq 2>/dev/null); do
+  if [ -n "$HCT" ] && [ "$u" = "$HCT" ]; then HCO="$HCO watched-v4"
+  elif [ -n "$HCT6" ] && [ "$u" = "$HCT6" ]; then HCO="$HCO watched-v6"
+  else case "$u" in 10.*|192.168.*|172.1[6-9].*|172.2[0-9].*|172.3[01].*|fd*|fc*) HCO="$HCO lan";; *:*) HCO="$HCO ext-v6";; *) HCO="$HCO ext-v4";; esac; fi
+done
+echo "  upstream order    :${HCO:- (empty)}"
+if [ "$(nvram get reaper_dnshc_enable 2>/dev/null)" = 1 ] && [ -n "$HCT" ]; then
+  case "$(nvram get reaper_dnshc_state 2>/dev/null)" in
+    down*) finding WARN "DNS health check: the watched resolver is DOWN - LAN lookups are going to the off-site servers (see 5)";;
+    up*) case "$HCO" in " watched-v4"*|" watched-v6"*) ;; *) [ -e /tmp/reaper/rdnshc.down4 ] || finding WARN "DNS health check says the watched resolver is up, but it is not first in the router's DNS list (order:$HCO) (see 5)";; esac;;
+  esac
+  [ -e /tmp/reaper/rdnshc.down4 ] && finding INFO "DNS health check: the watched resolver answers over IPv6 only - its IPv4 face is held behind the other servers (see 5)"
+  [ -e /tmp/reaper/rdnshc.down6 ] && finding INFO "DNS health check: the watched resolver answers over IPv4 only - its IPv6 face is held behind the other servers (see 5)"
+fi
+# v1.3.32: reverse DNS across networks (r24) and IPv6 device names (rc/rv6names.c). Counts only.
+echo "  device names      : across-networks=$(nvram get reaper_dns_revshare 2>/dev/null) ipv6-names=$(nvram get reaper_dns_v6names 2>/dev/null) rv6names-running=$(ps w 2>/dev/null | grep -c '[r]v6names')"
+for C in /etc/dnsmasq.conf /etc/dnsmasq-*.conf; do
+  [ -f "$C" ] || continue
+  HF="$(grep -o '^addn-hosts=/tmp/rv6names/.*' "$C" | head -1 | cut -d= -f2)"
+  NL=0; [ -n "$HF" ] && [ -f "$HF" ] && NL="$(grep -c . "$HF" 2>/dev/null)"
+  echo "  $(basename $C)  rev-server lines=$(grep -c '^rev-server=' "$C")  ipv6-names file=$([ -n "$HF" ] && echo yes || echo no)  ipv6 names=$NL"
+done
+if [ "$(nvram get reaper_dns_v6names 2>/dev/null)" = 1 ] && S6="$(nvram get ipv6_service 2>/dev/null)" && [ -n "$S6" ] && [ "$S6" != disabled ] && [ "$(ps w 2>/dev/null | grep -c '[r]v6names')" = 0 ]; then
+  finding WARN "IPv6 device names is on but its daemon (rv6names) is not running - LAN devices' IPv6 addresses get no names (see 5)"
+fi
 echo "  dns-over-tls      : dnspriv_enable=$(nvram get dnspriv_enable 2>/dev/null)"
 echo "  wanduck           : link_internet=$(nvram get link_internet 2>/dev/null) wandog=$(nvram get wandog_enable 2>/dev/null)"
 # v1.3.22: the log level decides whether rc and wanduck lines exist at all. syslogd -l N keeps
@@ -565,6 +665,27 @@ if [ -n "$V6S" ] && [ "$V6S" != disabled ]; then
   case "$V6M" in *"no SLAAC"*) finding INFO "LAN IPv6 is DHCPv6-only (no SLAAC) - devices without a DHCPv6 client (Android, most IoT) get no IPv6 address; IPv6 > Auto Configuration Setting > Stateless fixes it (see 6)";; esac
 fi
 
+# v1.3.31: the IPv6 DNS servers (by kind), the tunnel services, and the tunnelbroker
+# DDNS rule (stock stop_ddns() used to re-restore the whole IPv4 filter table to drop
+# it - fixed r15/r16; one accept must remain while the provider is chosen).
+K6=""; for i in 1 2 3; do a="$(nvram get ipv6_dns$i 2>/dev/null)"; case "$a" in "") ;; 2606:4700:*) K6="$K6 cloudflare";; 2001:4860:*) K6="$K6 google";; fd*|fc*) K6="$K6 ula";; *) case "$a" in "$(nvram get ipv6_prefix 2>/dev/null | sed 's/::$//')"*) K6="$K6 own-prefix(lan)";; *) K6="$K6 other";; esac;; esac; done
+echo "  ipv6 dns          : dnsenable=$(nvram get ipv6_dnsenable 2>/dev/null) servers:${K6:- (from ISP / none)}"
+case "$V6S" in 6in4|6to4|6rd)
+  TD="$(ls /sys/class/net 2>/dev/null | grep '^v6tun' | tr '\n' ' ')"
+  DR6="$(ip -6 route show default 2>/dev/null | head -1)"
+  GW6="$(echo "$DR6" | sed -n 's/.*via \([0-9a-fA-F:]*\).*/\1/p')"
+  FH="n/a"; [ -n "$GW6" ] && { ping6 -c 1 -W 2 "$GW6" >/dev/null 2>&1 && FH=answers || FH=SILENT; }
+  echo "  tunnel            : service=$V6S devices=${TD:-NONE} mtu=$(nvram get ipv6_tun_mtu 2>/dev/null) ttl=$(nvram get ipv6_tun_ttl 2>/dev/null) default-route-dev=$(echo "$DR6" | sed -n 's/.* dev \([^ ]*\).*/\1/p') first-hop=$FH"
+  [ -z "$TD" ] && finding WARN "IPv6 service is $V6S but no tunnel device exists (see 6)"
+  [ "$FH" = SILENT ] && finding WARN "IPv6 tunnel server is not answering - the tunnel is not passing traffic; a broker forwards only to the client IPv4 it was last told, so check the tunnel's client IPv4 / DDNS update first (see 6)"
+  ;;
+esac
+if [ "$(nvram get ddns_server_x 2>/dev/null)" = "WWW.TUNNELBROKER.NET" ] && [ "$(nvram get ddns_enable_x 2>/dev/null)" = 1 ]; then
+  HEA="$(iptables -S 2>/dev/null | grep -c -- '-s 66.220.2.74/32 .*-j ACCEPT')"
+  echo "  tunnelbroker ddns : checker accepts=$HEA (expect 1 unless WAN ping is open)  inadyn.conf mode=$(ls -l /etc/inadyn.conf 2>/dev/null | cut -c1-10)"
+  [ "$(nvram get misc_ping_x 2>/dev/null)" != 1 ] && [ "${HEA:-0}" = 0 ] && finding WARN "tunnelbroker DDNS is on but the broker's ICMP checker is not admitted - its update check can fail (see 6)"
+fi
+
 sec "7. WIRELESS (radios discovered at runtime)"
 # v1.3.24: the settings that explain overnight client drops (RT-BE88U field diag
 # 2026-09-27 could neither confirm nor rule them out). roamast's [EXAP] deauth is
@@ -598,7 +719,7 @@ u=0; while [ $u -le 3 ]; do
   # events and an in-driver channel change are live (6 GHz) - an unexplained channel move can be it.
   MMD="$(wl -i $IFN interference 2>/dev/null | sed -n 's/^Mode = \([0-9-]*\).*/\1/p' | head -1)"
   MNV="$(nvram get wl${u}_rmit 2>/dev/null)"
-  MST="$(grep "^wl$u " /tmp/reaper_wlmit.state 2>/dev/null | sed 's/.* result=//')"
+  MST="$(grep "^wl$u " /tmp/reaper/reaper_wlmit.state 2>/dev/null | sed 's/.* result=//')"
   echo "     interference: mode=${MMD:-?}  setting=${MNV:-driver-default}  applier=${MST:--}  edcrs=$(wl -i $IFN edcrs_hi_event_mode 2>/dev/null)/$(wl -i $IFN edcrs_hi_event_status 2>/dev/null)  sr=$(wl -i $IFN sr_config options 2>/dev/null | awk '{print $2}')"
   [ -n "$MNV" ] && case "$MST" in refused|waiting|skipped*|error*) finding INFO "interference mitigation is set on $IFN but not active (applier: $MST) - see 7";; esac
   # v1.3.20: static preamble puncturing (rc/reaper_punct.c) - the saved setting, what the
@@ -606,14 +727,25 @@ u=0; while [ $u -le 3 ]; do
   if [ "$NB" = 1 ] || [ "$NB" = 4 ]; then
     PNV="$(nvram get wl${u}_punct 2>/dev/null)"
     PLV="$(wl -i $IFN eht dissubchan 2>/dev/null | head -1 | awk '{print $3}')"
-    PST="$(grep "^wl$u " /tmp/reaper_punct.state 2>/dev/null | sed 's/.* result=//')"
+    PST="$(grep "^wl$u " /tmp/reaper/reaper_punct.state 2>/dev/null | sed 's/.* result=//')"
     echo "     puncturing: setting=${PNV:-off}  live=${PLV:-?}  applier=${PST:--}"
     case "$PST" in refused|stale|waiting|skipped*|error*)
       [ -n "$PNV" ] && finding INFO "puncturing is set on $IFN but not active (applier: $PST) - see 7";; esac
     # v1.3.21: dynamic puncturing (rpunctd) - the controller's flat state line for this radio
     # and whether the daemon is alive; it exits by itself only when no radio is Dynamic.
     case "$PNV" in dyn*)
-      DL="$(grep "^wl$u " /tmp/reaper_punct.dyn.state 2>/dev/null | cut -c1-400)"
+      # v1.3.33: the setting stores 0 for "the preset's value", and a raw 0 read as "puncture
+      # on any gain". Print what rpunctd actually applies (rpunctd/punct_core.c presets[]:
+      # min gain C/B/A = 20/15/10 %, min interval 300/180/60 s; a non-zero field overrides).
+      PNP=$(echo "$PNV" | cut -d'|' -f2); PNS=$(echo "$PNV" | cut -d'|' -f3)
+      PNG=$(echo "$PNV" | cut -d'|' -f4); PNH=$(echo "$PNV" | cut -d'|' -f5)
+      case "$PNP" in b) PPN=Balanced; PDG=15; PDH=180;; a) PPN=Aggressive; PDG=10; PDH=60;; *) PPN=Conservative; PDG=20; PDH=300;; esac
+      case "$PNS" in i) PSN=idle-scan;; a) PSN=active-scan;; *) PSN=passive;; esac
+      case "$PNG" in ''|*[!0-9]*) PNG=0;; esac; case "$PNH" in ''|*[!0-9]*) PNH=0;; esac
+      { [ "$PNG" -gt 0 ] && [ "$PNG" -le 100 ]; } && PEG="$PNG % (set)" || PEG="$PDG % (preset)"
+      { [ "$PNH" -gt 0 ] && [ "$PNH" -le 86400 ]; } && PEH="$PNH s (set)" || PEH="$PDH s (preset)"
+      echo "     dynamic settings: preset=$PPN  source=$PSN  min gain=$PEG  min interval=$PEH"
+      DL="$(grep "^wl$u " /tmp/reaper/reaper_punct.dyn.state 2>/dev/null | cut -c1-400)"
       if pidof rpunctd >/dev/null 2>&1; then DR=running; else DR=NOT-running; fi
       echo "     dynamic puncturing: daemon=$DR  ${DL:-no state yet}"
       [ "$DR" = running ] || finding WARN "dynamic puncturing is set on $IFN but rpunctd is not running (rwatch restarts it within its tick) - see 7";;
