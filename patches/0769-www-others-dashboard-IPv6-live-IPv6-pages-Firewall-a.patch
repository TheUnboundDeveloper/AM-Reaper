+  var sync = function(){
+    var w = Math.round(c.getBoundingClientRect().width);
+    if(w > 0) document.documentElement.style.setProperty('--pagew', w + 'px');
+  };
+  if(window.ResizeObserver) new ResizeObserver(sync).observe(c);
+  else window.addEventListener('resize', sync);
+  sync();
+}
