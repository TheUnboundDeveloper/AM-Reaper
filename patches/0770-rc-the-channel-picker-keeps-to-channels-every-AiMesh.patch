+/*
+ * SPDX-License-Identifier: GPL-2.0-only
+ * Copyright (C) 2026 the Reaper project maintainer
+ *
+ * reaper v3.4.6: the channels every AiMesh node can follow ("Fit channels to
+ * AiMesh nodes", amas_chanfit; on by default, inert until a node is registered).
+ *
+ * WHY. AiMesh keeps, for every unit, the channels each of its radios can use
+ * (/tmp/chanspec_all.json, written by the closed AiMesh controller from what the
+ * nodes report) and turns the intersection into wlN_acs_excl_chans_cfg, which
+ * the channel picker (acsd2) honours. Two things were missing on the owner's
+ * RT-BE96U with an RT-AX92U node (2026-10-16): the picker's own fall-back after
+ * a failed DFS check landed the 5 GHz radio on 48/80 - a channel the node's
+ * backhaul radio cannot use and that was already in the exclusion list - and
+ * nothing noticed for two hours; and nothing said that, with the 80 MHz minimum
+ * width and the stock exclusions, every channel left for the node was a DFS
+ * channel. A node on 2.4 GHz only is a mesh with a quarter of its backhaul.
+ *
+ * HOW (no closed code touched, no stock exclusion removed).
+ *  1. Interrogation: the per-unit lists in chanspec_all.json, read under the
+ *     controller's own file lock. Each band carries a width bitmask (1=20 2=40
+ *     4=80 8=160 16=320) and channel codes "0000FCCC": a flag digit (0 plain -
+ *     every 2.4 and 6 GHz entry -, 1 usable, 2 usable with DFS, 8 not usable)
+ *     and three channel digits; an unlisted channel is not usable. A node
+ *     reporting two 5 GHz radios uses the upper one for its backhaul (dual-5 GHz
+ *     ASUS nodes), so
+ *     only that one counts - the controller's own intersection excludes the
+ *     lower one too, and the owner's node never joined on 48/80.
+ *  2. The fit rule, per chanspec this radio offers (`wl chanspecs`, every
+ *     width): the node-facing sub-block - the part of the channel, up to 80 MHz
+ *     wide and no wider than the node can do, that contains the control
+ *     channel - must be usable by every registered node. A node without a radio
+ *     on the band constrains nothing. DFS channels stay in (owner, 2026-10-16).
+ *     On the owner's data this agrees with the controller's 49 exclusions in
+ *     all but 165/20 (which the stock base list excludes anyway).
+ *  3. The result is held in /jffs/reaper_meshchan/wlN.compat (the list and
+ *     what it was built from), so a reboot applies it before the nodes report
+ *     again, and the chanspecs outside it are appended to wlN_acs_excl_chans
+ *     through the minimum-width module's record (rc/reaper_bwfloor.c: strip
+ *     first, add last, never an empty picker). Rebuilt when the registry, the
+ *     reported lists or MLO change.
+ *  4. The watcher (the reaper_bwfloor daemon's tick) compares the live
+ *     chanspec with the list; a radio parked outside it for a minute has its
+ *     picker re-run, with a cooldown, and the state names it.
+ *  5. When no non-DFS channel at or above the floor is left for the nodes,
+ *     one log line and the page say so: a fixed bandwidth or a manual channel
+ *     lifts the stock Auto-width exclusions. Nothing is overridden here.
+ *
+ * MLO: the compatible set is the node radios' physics and does not change with
+ * MLO; the state records mld_enable, and the watcher re-picks one radio only,
+ * never every picker, so the other links of the MLD are left alone.
+ * ASCII only (rule 1). Nothing in nvram but the switch (rule: no Reaper list in
+ * nvram; the list is a /jffs file).
+ */
+#ifndef MESHCHAN_HOST
+#include "rc.h"
+#include "reaper_meshchan.h"
+#include <reaper_tmpsafe.h>
+#include <sys/stat.h>
+#endif
+
+/* ---- MESHCHAN_PURE_BEGIN (libc only; the lean host test compiles this block) ---- */
+#define MC_MAXNODES	8
+#define MC_NCH		256
+#define MC_NB		3
+#define MC_MAXCOV	16
+enum { MC_B24 = 0, MC_B5 = 1, MC_B6 = 2 };
+
+struct mc_band { unsigned char present, bwmask, flag[MC_NCH]; };
+struct mc_node { char mac[18]; unsigned char is_re, dual5g; struct mc_band b[MC_NB]; };
+struct mc_nodes { int n, res, cap, snap; struct mc_node v[MC_MAXNODES]; };	/* cap = the router's own entry, or -1; snap = read from the kept copy */
+
+struct jp { const char *p; };
+
+static void js_ws(struct jp *j)
+{
+	while (*j->p == ' ' || *j->p == '\t' || *j->p == '\r' || *j->p == '\n')
+		j->p++;
+}
+
+static int js_ch(struct jp *j, char c)
+{
+	js_ws(j);
+	if (*j->p != c)
+		return -1;
+	j->p++;
+	return 0;
+}
+
+/* a JSON string; out may be NULL (skip). Longer strings are cut, never overrun. */
+static int js_str(struct jp *j, char *out, size_t len)
+{
+	size_t n = 0;
+
+	js_ws(j);
+	if (*j->p != '"')
+		return -1;
+	j->p++;
+	while (*j->p && *j->p != '"') {
+		char ch = *j->p++;
+		if (ch == '\\' && *j->p)
+			ch = *j->p++;
+		if (out && n + 1 < len)
+			out[n++] = ch;
+	}
+	if (*j->p != '"')
+		return -1;
+	j->p++;
+	if (out && len)
+		out[n] = 0;
+	return 0;
+}
+
+static long js_num(struct jp *j, int *ok)
+{
+	char *end;
+	long v;
+
+	js_ws(j);
+	v = strtol(j->p, &end, 10);
+	*ok = end != j->p;
+	j->p = end;
+	return v;
+}
+
+/* skip any value */
+static int js_skip(struct jp *j, int depth)
+{
+	js_ws(j);
+	if (depth > 16)
+		return -1;
+	if (*j->p == '"')
+		return js_str(j, NULL, 0);
+	if (*j->p == '{' || *j->p == '[') {
+		char close = *j->p == '{' ? '}' : ']';
+		j->p++;
+		for (;;) {
+			js_ws(j);
+			if (*j->p == close) { j->p++; return 0; }
+			if (!*j->p)
+				return -1;
+			if (close == '}' && (js_str(j, NULL, 0) < 0 || js_ch(j, ':') < 0))
+				return -1;
+			if (js_skip(j, depth + 1) < 0)
+				return -1;
+			js_ws(j);
+			if (*j->p == ',')
+				j->p++;
+		}
+	}
+	while (*j->p && !strchr(",}] \t\r\n", *j->p))
+		j->p++;
+	return 0;
+}
+
+/* {"bandwidth":15,"channel":"1 00001036 00002052 ..."} */
+static int js_band(struct jp *j, struct mc_band *b)
+{
+	char key[24];
+	static char val[2048];
+
+	if (js_ch(j, '{') < 0)
+		return -1;
+	for (;;) {
+		js_ws(j);
+		if (*j->p == '}') { j->p++; break; }
+		if (js_str(j, key, sizeof(key)) < 0 || js_ch(j, ':') < 0)
+			return -1;
+		if (!strcmp(key, "bandwidth")) {
+			int ok;
+			long v = js_num(j, &ok);
+			if (!ok)
+				return -1;
+			b->bwmask = (unsigned char)(v & 0xff);
+		} else if (!strcmp(key, "channel")) {
+			const char *p;
+			if (js_str(j, val, sizeof(val)) < 0)
+				return -1;
+			for (p = val; *p; ) {
+				const char *s = p;
+				while (*p && *p != ' ')
+					p++;
+				if (p - s == 8 && strspn(s, "0123456789") >= 8) {
+					/* 0000FCCC: four reserved digits, the flag F (0 plain, 1 usable, 2 usable
+					 * with DFS, 8 not usable), three channel digits. Stored as F + 1 so an
+					 * unlisted channel (0) stays apart from a plain one; a reserved digit set
+					 * is treated as not usable (unknown meaning). */
+					int hi = (s[0] - '0') * 1000 + (s[1] - '0') * 100 + (s[2] - '0') * 10 + (s[3] - '0');
+					int f = s[4] - '0';
+					int ch = (s[5] - '0') * 100 + (s[6] - '0') * 10 + (s[7] - '0');
+					if (ch > 0 && ch < MC_NCH) {
+						b->flag[ch] = hi ? 255 : (unsigned char)(f + 1);
+						b->present = 1;
+					}
+				}
+				while (*p == ' ')
+					p++;
+			}
+		} else if (js_skip(j, 0) < 0)
+			return -1;
+		js_ws(j);
+		if (*j->p == ',')
+			j->p++;
+	}
+	return 0;
+}
+
+/* stored codes: 1 plain, 2 usable, 3 usable with DFS; 0 unlisted, 9 not usable, 255 unknown */
+static int mc_usable(int f) { return f >= 1 && f <= 3; }
+#define MC_DFS_CODE	3
+
+static int band_min(const struct mc_band *b)
+{
+	int c;
+	for (c = 1; c < MC_NCH; c++)
+		if (mc_usable(b->flag[c]))
+			return c;
+	return 0;
+}
+
+/* a channel usable by either radio of a band is usable */
+static void band_union(struct mc_band *d, const struct mc_band *s)
+{
+	int c;
+	d->present |= s->present;
+	d->bwmask |= s->bwmask;
+	for (c = 0; c < MC_NCH; c++)
+		if (!mc_usable(d->flag[c]) && s->flag[c])
+			d->flag[c] = s->flag[c];
+}
+
+static int js_node(struct jp *j, struct mc_node *nd)
+{
+	char key[24];
+	static struct mc_band b5[2], t;
+	int n5 = 0;
+
+	memset(nd->b, 0, sizeof(nd->b));
+	memset(b5, 0, sizeof(b5));
+	if (js_ch(j, '{') < 0)
+		return -1;
+	for (;;) {
+		js_ws(j);
+		if (*j->p == '}') { j->p++; break; }
+		if (js_str(j, key, sizeof(key)) < 0 || js_ch(j, ':') < 0)
+			return -1;
+		if ((key[0] == '2' || key[0] == '5' || key[0] == '6') && key[1] == 'G') {
+			memset(&t, 0, sizeof(t));
+			if (js_band(j, &t) < 0)
+				return -1;
+			if (key[0] == '2')
+				band_union(&nd->b[MC_B24], &t);
+			else if (key[0] == '6')
+				band_union(&nd->b[MC_B6], &t);
+			else if (n5 < 2)
+				b5[n5++] = t;
+		} else if (!strcmp(key, "is_re")) {
+			int ok;
+			nd->is_re = js_num(j, &ok) != 0;
+			if (!ok)
+				return -1;
+		} else if (js_skip(j, 0) < 0)
+			return -1;
+		js_ws(j);
+		if (*j->p == ',')
+			j->p++;
+	}
+	if (n5 == 1)
+		nd->b[MC_B5] = b5[0];
+	else if (n5 == 2) {
+		/* two 5 GHz radios: the upper one carries the backhaul */
+		nd->dual5g = 1;
+		nd->b[MC_B5] = band_min(&b5[1]) > band_min(&b5[0]) ? b5[1] : b5[0];
+	}
+	return 0;
+}
+
+/* /tmp/chanspec_all.json -> nodes; 0 ok, -1 malformed */
+int mc_parse_json(const char *json, struct mc_nodes *out)
+{
+	struct jp j = { json };
+
+	memset(out, 0, sizeof(*out));
+	out->cap = -1;
+	if (js_ch(&j, '{') < 0)
+		return -1;
+	for (;;) {
+		char mac[18];
+		js_ws(&j);
+		if (*j.p == '}')
+			break;
+		if (js_str(&j, mac, sizeof(mac)) < 0 || js_ch(&j, ':') < 0)
+			return -1;
+		if (out->n < MC_MAXNODES) {
+			struct mc_node *nd = &out->v[out->n];
+			memcpy(nd->mac, mac, sizeof(nd->mac));
+			nd->is_re = nd->dual5g = 0;
+			if (js_node(&j, nd) < 0)
+				return -1;
+			if (nd->is_re)
+				out->res++;
+			else if (out->cap < 0)
+				out->cap = out->n;
+			out->n++;
+		} else if (js_skip(&j, 0) < 0)
+			return -1;
+		js_ws(&j);
+		if (*j.p == ',')
+			j.p++;
+	}
+	return 0;
+}
+
+/*
+ * A Broadcom chanspec (as `wl chanspecs` prints it in parentheses) -> band,
+ * width, control channel and the 20 MHz channels it covers (ascending).
+ * Returns the covered count, -1 if the value is not one this platform prints.
+ * Checked by the lean host test against every chanspec the owner's three
+ * radios offer (439 values, all five widths, 320 MHz included).
+ */
+int mc_decode(unsigned cs, int *band, int *width, int *ctl, int cov[MC_MAXCOV])
+{
+	int c = cs & 0xff, sb = (cs >> 8) & 7, n = 0, k;
+
+	switch (cs & 0xc000) {
+	case 0x0000: *band = MC_B24; break;
+	case 0xc000: *band = MC_B5; break;
+	case 0x4000: *band = MC_B6; break;
+	default: return -1;
+	}
+	switch (cs & 0x3800) {
+	case 0x1000:
+		*width = 20; *ctl = c; cov[n++] = c;
+		break;
+	case 0x1800:
+		if (sb > 1) return -1;
+		*width = 40; *ctl = sb ? c + 2 : c - 2;
+		cov[n++] = c - 2; cov[n++] = c + 2;
+		break;
+	case 0x2000:
+		if (sb > 3) return -1;
+		*width = 80; *ctl = c - 6 + 4 * sb;
+		for (k = 0; k < 4; k++) cov[n++] = c - 6 + 4 * k;
+		break;
+	case 0x2800:
+		*width = 160; *ctl = c - 14 + 4 * sb;
+		for (k = 0; k < 8; k++) cov[n++] = c - 14 + 4 * k;
+		break;
+	case 0x3000: {
+		/* 320 MHz (6 GHz only): bits 0-2 = the 320 MHz block, bits 6-9 = the control slot */
+		int idx = cs & 7, pos = (cs >> 6) & 0xf, start = 1 + 32 * idx;
+		if (*band != MC_B6 || idx > 5) return -1;
+		*width = 320; *ctl = start + 4 * pos;
+		for (k = 0; k < 16; k++) cov[n++] = start + 4 * k;
+		break;
+	}
+	default:
+		return -1;
+	}
+	for (k = 0; k < n; k++)
+		if (cov[k] <= 0 || cov[k] >= MC_NCH)
+			return -1;
+	return n;
+}
+
+static int mc_nmax(unsigned m) { return m & 16 ? 320 : m & 8 ? 160 : m & 4 ? 80 : m & 2 ? 40 : 20; }
+
+/* the node-facing sub-block (<= 80 MHz, no wider than the node, around the control channel) must be usable */
+int mc_node_fits(const struct mc_node *nd, int band, int width, int ctl, const int *cov, int ncov)
+{
+	const struct mc_band *b = &nd->b[band];
+	int subw, per, i, s, k;
+
+	if (!nd->is_re || !b->present)
+		return 1;
+	subw = width;
+	if (mc_nmax(b->bwmask) < subw) subw = mc_nmax(b->bwmask);
+	if (subw > 80) subw = 80;
+	per = subw / 20;
+	for (i = 0; i < ncov && cov[i] != ctl; i++)
+		;
+	if (i == ncov)
+		return 0;
+	s = i - i % per;
+	for (k = s; k < s + per && k < ncov; k++)
+		if (!mc_usable(b->flag[cov[k]]))
+			return 0;
+	return 1;
+}
+
+/* 1 = every registered node can use it, 0 = not, -1 = undecodable. *dfs from the router's own entry: 1/0, -1 unknown */
+int mc_compat(const struct mc_nodes *nds, unsigned cs, int *dfs)
+{
+	int band, width, ctl, cov[MC_MAXCOV], n, i;
+
+	if ((n = mc_decode(cs, &band, &width, &ctl, cov)) < 0)
+		return -1;
+	if (dfs) {
+		*dfs = -1;
+		if (nds->cap >= 0 && nds->v[nds->cap].b[band].present) {
+			*dfs = 0;
+			for (i = 0; i < n; i++)
+				if (nds->v[nds->cap].b[band].flag[cov[i]] == MC_DFS_CODE)
+					*dfs = 1;
+		}
+	}
+	for (i = 0; i < nds->n; i++)
+		if (!mc_node_fits(&nds->v[i], band, width, ctl, cov, n))
+			return 0;
+	return 1;
+}
+
+/* every "(0x....)" of a `wl chanspecs` listing; returns how many were stored */
+int mc_scan_hex(const char *s, unsigned short *out, int max)
+{
+	int n = 0;
+	const char *p = s;
+
+	while (max > 0 && (p = strstr(p, "(0x")) != NULL) {
+		char *end;
+		unsigned long v = strtoul(p + 1, &end, 16);
+		if (end != p + 1 && *end == ')' && v <= 0xffff) {
+			out[n++] = (unsigned short)v;
+			max--;
+		}
+		p = end;
+	}
+	return n;
+}
+
+unsigned long mc_djb2(const char *s, unsigned long h)
+{
+	if (!h)
+		h = 5381;
+	while (*s)
+		h = h * 33 + (unsigned char)*s++;
+	return h;
+}
+
+static int mc_list_has(const char *list, unsigned cs)
+{
+	const char *p = list;
+	char *end;
+
+	while (*p) {
+		unsigned long v = strtoul(p, &end, 16);
+		if (end != p && v == cs)
+			return 1;
+		p = strchr(p, ',');
+		if (!p)
+			break;
+		p++;
+	}
+	return 0;
+}
+
+static void mc_list_add(char *list, size_t len, unsigned cs)
+{
+	char t[12];
+	snprintf(t, sizeof(t), "%s0x%04x", list[0] ? "," : "", cs);
+	strlcat(list, t, len);
+}
+
+/* remove one chanspec from a "0x....,0x...." list in place; returns how many were removed */
+static int mc_list_del(char *list, unsigned cs)
+{
+	char *r = list, *w = list;
+	int removed = 0;
+
+	while (*r) {
+		char *end, *next = strchr(r, ',');
+		size_t tok = next ? (size_t)(next - r) : strlen(r);
+		unsigned long v = strtoul(r, &end, 16);
+
+		if (end != r && v == cs) {
+			removed++;
+		} else {
+			if (w != list)
+				*w++ = ',';
+			memmove(w, r, tok);
+			w += tok;
+		}
+		if (!next)
+			break;
+		r = next + 1;
+	}
+	*w = 0;
+	return removed;
+}
+
+static int mc_width_of(unsigned cs)
+{
+	switch (cs & 0x3800) {
+	case 0x1000: return 20;
+	case 0x1800: return 40;
+	case 0x2000: return 80;
+	case 0x2800: return 160;
+	case 0x3000: return 320;
+	}
+	return 0;
+}
+
+/*
+ * Owner ruling 2026-10-16: when the exclusions in force leave the nodes no non-DFS
+ * chanspec at or above the floor, un-exclude exactly the non-DFS chanspecs every
+ * node can use at that width (on the owner's mesh: the four 149-161/80 entries of
+ * the stock Auto-width rule, which keeps them clear of the 6 GHz band's AFC power).
+ * Without one, every pick is DFS and the driver's fall-back after the DFS check
+ * lands where it likes. Nothing is lifted while such a landing exists.
+ * Returns how many were lifted; they are appended to `lifted`.
+ */
+static int mc_lift(const unsigned short *offer, const unsigned char *fit, const unsigned char *dfs,
+		   int n, int floor, char *cur, char *lifted, size_t liftedlen)
+{
+	int i, allowed = 0, k = 0;
+
+	for (i = 0; i < n; i++)
+		if (fit[i] && !dfs[i] && mc_width_of(offer[i]) >= floor && !mc_list_has(cur, offer[i]))
+			allowed++;
+	if (allowed)
+		return 0;
+	for (i = 0; i < n; i++)
+		if (fit[i] && !dfs[i] && mc_width_of(offer[i]) >= floor && mc_list_has(cur, offer[i])) {
+			mc_list_del(cur, offer[i]);
+			mc_list_add(lifted, liftedlen, offer[i]);
+			k++;
+		}
+	return k;
+}
+/* The held plan (no reported lists, no usable kept copy) keeps its lift: the chanspecs recorded on
+ * line 4 were put back into the list before the recomputation, so take them out again and carry
+ * them forward (audit 2026-10-16 B1: a held plan re-excluded them until the first report).
+ * Returns how many came out; they are appended to `lifted`. */
+static int mc_relift(const char *old, char *cur, char *lifted, size_t liftedlen)
+{
+	const char *p = old;
+	char *end;
+	int k = 0;
+
+	for (; *p; ) {
+		unsigned long v = strtoul(p, &end, 16);
+		if (end != p && v <= 0xffff && mc_list_del(cur, (unsigned)v)) {
+			mc_list_add(lifted, liftedlen, (unsigned)v);
+			k++;
+		}
+		p = strchr(p, ',');
+		if (!p)
+			break;
+		p++;
+	}
+	return k;
+}
+/* ---- MESHCHAN_PURE_END ---- */
+
+#ifndef MESHCHAN_HOST
+
+#define MC_DIR		"/tmp/reaper/meshchan"
+#define MC_REC		"/jffs/reaper_meshchan"
+#define MC_JSON		"/tmp/chanspec_all.json"
+#define MC_NODES_SNAP	MC_REC "/nodes.json"	/* the last good copy of MC_JSON (RAM-only; nodes re-send it only when they connect) */
+#define MC_MAXOFFER	512
+#define MC_LISTMAX	4096
+
+struct mc_state { unsigned long sig; int nodes, mld, floor, compat, nondfs, excl, lifted; long built; char how[16]; };
+
+static int mc_ifname_ok(const char *s)
+{
+	size_t n = strlen(s);
+	return n > 0 && n < IFNAMSIZ &&
+	       strspn(s, "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789._-") == n;
+}
+
+int reaper_meshchan_enabled(void)
+{
+	if (!nvram_get_int("amas_chanfit"))
+		return 0;
+	if (nvram_get_int("re_mode") == 1)
+		return 0;
+	return nvram_get_int("sw_mode") == 1 || nvram_get_int("sw_mode") == 3;
+}
+
+/* the pairing registry: one record per '<' */
+int reaper_meshchan_registered(void)
+{
+	char *a = get_cfg_relist(0);
+	const char *p;
+	int n = 0;
+
+	if (!a)
+		return 0;
+	for (p = a; (p = strchr(p, '<')) != NULL; p++)
+		n++;
+	free(a);
+	return n;
+}
+
+/* what the result depends on: the registry, MLO, and the reported lists (size + mtime; cheap every tick) */
+unsigned long reaper_meshchan_sig(void)
+{
+	struct stat st;
+	char tmp[64];
+	unsigned long h = 5381;
+	char *a = get_cfg_relist(0);
+
+	if (a) {
+		h = mc_djb2(a, h);
+		free(a);
+	}
+	snprintf(tmp, sizeof(tmp), "|mld=%d|fit=%d|", nvram_get_int("mld_enable"), nvram_get_int("amas_chanfit"));
+	h = mc_djb2(tmp, h);
+	if (stat(MC_JSON, &st) == 0) {
+		snprintf(tmp, sizeof(tmp), "|%ld|%ld|", (long)st.st_size, (long)st.st_mtime);
+		h = mc_djb2(tmp, h);
+	}
+	return h;
+}
+
+/* a node that left the registry still sits in an old copy of the lists: it constrains nothing */
+static void mc_only_registered(struct mc_nodes *nds)
+{
+	char *rl = get_cfg_relist(0);
+	int i;
+
+	if (!rl)
+		return;
+	for (i = 0; i < nds->n; i++)
+		if (nds->v[i].is_re && !strstr(rl, nds->v[i].mac)) {
+			nds->v[i].is_re = 0;
+			nds->res--;
+		}
+	free(rl);
+}
+
+/* the kept copy already holds exactly these bytes (audit 2026-10-16 C2: no flash write for an identical copy) */
+static int mc_snap_same(const char *buf, size_t n)
+{
+	static char have[24576];
+	FILE *f = fopen(MC_NODES_SNAP, "r");
+	size_t m;
+
+	if (!f)
+		return 0;
+	m = fread(have, 1, sizeof(have) - 1, f);
+	fclose(f);
+	return m == n && memcmp(have, buf, n) == 0;
+}
+
+/*
+ * The nodes' lists: /tmp/chanspec_all.json under the controller's own lock. The file is
+ * RAM-only and a node re-sends its lists only when it connects, so a reboot with a node
+ * offline would leave the main router with nothing to fit - the very moment it matters.
+ * A good read is therefore kept in /jffs and used when /tmp has nothing yet (boot, nodes
+ * down); nodes no longer in the registry are dropped from either copy.
+ */
+static int mc_load(struct mc_nodes *nds)
+{
+	static char buf[24576];
+	FILE *f;
+	size_t n;
+	int lock;
+
+	memset(nds, 0, sizeof(*nds));
+	nds->cap = -1;
+	lock = file_lock("chanspec");
+	f = fopen(MC_JSON, "r");
+	n = f ? fread(buf, 1, sizeof(buf) - 1, f) : 0;
+	if (f)
+		fclose(f);
+	file_unlock(lock);
+	if (n) {
+		buf[n] = 0;
+		if (mc_parse_json(buf, nds) == 0 && nds->res > 0) {
+			if (!mc_snap_same(buf, n)) {
+				mkdir(MC_REC, 0755);
+				reaper_write_atomic(MC_NODES_SNAP, buf, n, 0600);
+			}
+			mc_only_registered(nds);
+			return 0;
+		}
+		memset(nds, 0, sizeof(*nds));
+		nds->cap = -1;
+	}
+	f = fopen(MC_NODES_SNAP, "r");
+	n = f ? fread(buf, 1, sizeof(buf) - 1, f) : 0;
+	if (f)
+		fclose(f);
+	if (!n)
+		return -1;
+	buf[n] = 0;
+	if (mc_parse_json(buf, nds) < 0)
+		return -1;
+	nds->snap = 1;
+	mc_only_registered(nds);
+	return 0;
+}
+
+static const int mc_widths[5] = { 20, 40, 80, 160, 320 };
+
+/* every chanspec the radio offers, all widths of its band */
+static int mc_offer(const char *ifn, int band, unsigned short *out, int max)
+{
+	char cmd[96], line[128];
+	int w, n = 0;
+
+	if (!mc_ifname_ok(ifn))
+		return -1;
+	for (w = 0; w < 5 && n < max; w++) {
+		FILE *pp;
+		if (band == 2 && mc_widths[w] > 40)
+			break;
+		snprintf(cmd, sizeof(cmd), "wl -i %s chanspecs -b %d -w %d 2>/dev/null", ifn, band, mc_widths[w]);
+		if ((pp = popen(cmd, "r")) == NULL)
+			return -1;
+		while (fgets(line, sizeof(line), pp) && n < max)
+			n += mc_scan_hex(line, out + n, max - n);
+		pclose(pp);
+	}
+	return n;
+}
+
+static void mc_paths(int u, char *jp, size_t jl, char *tp, size_t tl)
+{
+	snprintf(jp, jl, MC_REC "/wl%d.compat", u);
+	snprintf(tp, tl, MC_DIR "/wl%d.compat", u);
+}
+
+/* the knowledge, in /jffs (a reboot applies it before the nodes report again) and mirrored to /tmp for the readers */
+static void mc_write(int u, const struct mc_state *st, const char *list, const char *ndlist, const char *lifted)
+{
+	char jp[64], tp[64], tmp[72];
+	FILE *f;
+	int i;
+
+	mc_paths(u, jp, sizeof(jp), tp, sizeof(tp));
+	for (i = 0; i < 2; i++) {
+		const char *path = i ? tp : jp;
+		if (i == 0)
+			mkdir(MC_REC, 0755);
+		else
+			reaper_secure_dir(MC_DIR, 0700);
+		snprintf(tmp, sizeof(tmp), "%s.tmp", path);
+		if ((f = fopen(tmp, "w")) == NULL)
+			continue;
+		fprintf(f, "sig=%lx nodes=%d mld=%d floor=%d compat=%d nondfs=%d excl=%d lifted=%d built=%ld how=%s\n%s\n%s\n%s\n",
+			st->sig, st->nodes, st->mld, st->floor, st->compat, st->nondfs, st->excl, st->lifted, st->built, st->how,
+			list, ndlist, lifted);
+		fclose(f);
+		if (rename(tmp, path) != 0)
+			unlink(tmp);
+	}
+}
+
+static int mc_read(int u, struct mc_state *st, char *list, size_t len)
+{
+	char jp[64], tp[64], line[200];
+	FILE *f;
+
+	mc_paths(u, jp, sizeof(jp), tp, sizeof(tp));
+	memset(st, 0, sizeof(*st));
+	if (list && len)
+		list[0] = 0;
+	if ((f = fopen(tp, "r")) == NULL && (f = fopen(jp, "r")) == NULL)
+		return -1;
+	if (!fgets(line, sizeof(line), f)) {
+		fclose(f);
+		return -1;
+	}
+	sscanf(line, "sig=%lx nodes=%d mld=%d floor=%d compat=%d nondfs=%d excl=%d lifted=%d built=%ld how=%15s",
+	       &st->sig, &st->nodes, &st->mld, &st->floor, &st->compat, &st->nondfs, &st->excl, &st->lifted, &st->built, st->how);
+	if (list && len && fgets(list, len, f))
+		list[strcspn(list, "\r\n")] = 0;
+	fclose(f);
+	return 0;
+}
+
+/* line n (1-based) of the plan file: 3 = the non-DFS compat list, 4 = the lifted list; 0 ok (out may be empty), -1 none */
+static int mc_read_line(int u, int n, char *out, size_t len)
+{
+	char jp[64], tp[64];
+	FILE *f;
+	int i;
+
+	mc_paths(u, jp, sizeof(jp), tp, sizeof(tp));
+	out[0] = 0;
+	if ((f = fopen(tp, "r")) == NULL && (f = fopen(jp, "r")) == NULL)
+		return -1;
+	for (i = 1; i <= n; i++)
+		if (!fgets(out, len, f)) {
+			fclose(f);
+			out[0] = 0;
+			return i == 1 ? -1 : 0;
+		}
+	fclose(f);
+	out[strcspn(out, "\r\n")] = 0;
+	return 0;
+}
+
+static void mc_drop(int u)
+{
+	char jp[64], tp[64];
+	mc_paths(u, jp, sizeof(jp), tp, sizeof(tp));
+	unlink(jp);
+	unlink(tp);
+}
+
+static void mc_status(int u, const char *s)
+{
+	char path[64];
+	FILE *f;
+
+	reaper_secure_dir(MC_DIR, 0700);
+	snprintf(path, sizeof(path), MC_DIR "/wl%d.st", u);
+	if ((f = fopen(path, "w")) != NULL) {
+		fprintf(f, "%s\n", s);
+		fclose(f);
+	}
+}
+
+/* the minimum-width module reports a radio the fit does not apply to (fixed channel, radio off, ...) */
+void reaper_meshchan_note(int u, const char *st)
+{
+	mc_status(u, st);
+}
+
+/* one line per distinct build, not per rebuild */
+static int mc_said(int u, const char *what, unsigned long sig)
+{
+	char path[96];
+	FILE *f;
+
+	reaper_secure_dir(MC_DIR, 0700);
+	snprintf(path, sizeof(path), MC_DIR "/wl%d.said.%s", u, what);
+	if ((f = fopen(path, "r")) != NULL) {
+		unsigned long old = 0;
+		if (fscanf(f, "%lx", &old) != 1)
+			old = 0;
+		fclose(f);
+		if (old == sig)
+			return 1;
+	}
+	if ((f = fopen(path, "w")) != NULL) {
+		fprintf(f, "%lx\n", sig);
+		fclose(f);
+	}
+	return 0;
+}
+
+/*
+ * Bring the radio's exclusion list in line with the nodes. Called by the
+ * minimum-width module after its own additions, with the live list in cur and
+ * the running record of this run's additions in added; appends to both.
+ *   floor = 80 while the minimum width applies to this radio (set, or implied
+ *           by preamble puncturing), else 0.
+ * Returns the number of chanspecs appended (>= 0), or
+ *   -3 off (switch, node mode, not router/AP)   -2 no node registered
+ *   -1 refused: not one channel the nodes could use at the floor would be left
+ */
+int reaper_meshchan_excl(int u, const char *ifn, int band, int floor,
+			 char *cur, size_t curlen, char *added, size_t addedlen)
+{
+	static struct mc_nodes nds;
+	static unsigned short offer[MC_MAXOFFER];
+	static char list[MC_LISTMAX];
+	static unsigned char fit[MC_MAXOFFER], dfs[MC_MAXOFFER];
+	static char ndlist[MC_LISTMAX], lifted[1024], old[1024];
+	struct mc_state st;
+	int n, i, nreg, allowed = 0, nondfs = 0, compat = 0, excl = 0, loaded, nlifted = 0;
+	char s[64];
+
+	memset(&st, 0, sizeof(st));
+	if (!reaper_meshchan_enabled()) {
+		mc_status(u, "off");
+		return -3;
+	}
+	nreg = reaper_meshchan_registered();
+	if (!nreg) {
+		mc_drop(u);
+		mc_status(u, "none");
+		return -2;
+	}
+	st.sig = reaper_meshchan_sig();
+	st.mld = nvram_get_int("mld_enable");
+	st.floor = floor;
+	st.built = (long)time(NULL);
+	/* an earlier run may have un-excluded chanspecs for the nodes: put stock's view back first and decide again
+	 * (stock rewrites the 5 GHz list at every wireless restart anyway; this keeps a daemon-side rebuild honest) */
+	if (mc_read_line(u, 4, old, sizeof(old)) == 0 && old[0]) {
+		const char *p = old;
+		char *end;
+		for (; *p; ) {
+			unsigned long v = strtoul(p, &end, 16);
+			if (end != p && !mc_list_has(cur, (unsigned)v))
+				mc_list_add(cur, curlen, (unsigned)v);
+			p = strchr(p, ',');
+			if (!p)
+				break;
+			p++;
+		}
+	}
+	lifted[0] = 0;
+	ndlist[0] = 0;
+	if ((n = mc_offer(ifn, band, offer, MC_MAXOFFER)) <= 0) {
+		mc_status(u, "error");
+		return 0;
+	}
+
+	loaded = mc_load(&nds) == 0 && nds.res > 0;
+	if (loaded) {
+		st.nodes = nds.res;
+		strlcpy(st.how, nds.snap ? "snapshot" : "reported", sizeof(st.how));
+		list[0] = 0;
+		for (i = 0; i < n; i++) {
+			int d = -1, f = mc_compat(&nds, offer[i], &d);
+			fit[i] = f == 1;
+			dfs[i] = d == 1;
+			if (fit[i]) {
+				mc_list_add(list, sizeof(list), offer[i]);
+				if (!dfs[i])
+					mc_list_add(ndlist, sizeof(ndlist), offer[i]);
+				compat++;
+			}
+		}
+	} else {
+		/* the nodes have not reported yet (boot): the last result stands */
+		struct mc_state prev;
+		if (mc_read(u, &prev, list, sizeof(list)) < 0 || !list[0]) {
+			mc_status(u, "waiting");
+			return 0;
+		}
+		st.nodes = prev.nodes;
+		strlcpy(st.how, "held", sizeof(st.how));
+		mc_read_line(u, 3, ndlist, sizeof(ndlist));
+		/* the last result stands, its lift included: the entries put back above come out again */
+		nlifted = mc_relift(old, cur, lifted, sizeof(lifted));
+		for (i = 0; i < n; i++) {
+			fit[i] = mc_list_has(list, offer[i]);
+			dfs[i] = 0;		/* unknown without the router's own flags */
+			if (fit[i])
+				compat++;
+		}
+	}
+	st.compat = compat;
+
+	/* the owner's ruling: the nodes get a non-DFS landing even if a stock exclusion has to give way */
+	if (loaded)
+		nlifted = mc_lift(offer, fit, dfs, n, floor, cur, lifted, sizeof(lifted));
+	st.lifted = nlifted;
+
+	/* never an empty picker: something at or above the floor must stay */
+	for (i = 0; i < n; i++)
+		if (fit[i] && mc_width_of(offer[i]) >= floor && !mc_list_has(cur, offer[i]))
+			allowed++;
+	if (!allowed) {
+		st.excl = -1;
+		mc_write(u, &st, list, ndlist, lifted);
+		mc_status(u, "unavailable");
+		if (!mc_said(u, "unavail", st.sig))
+			logmessage("reaper_bwfloor", "wl%d: no channel both this radio and the %d AiMesh node(s) can use is left%s after the existing exclusions - the node fit is not applied", u, st.nodes, floor ? " at 80 MHz or wider" : "");
+		return -1;
+	}
+
+	for (i = 0; i < n; i++) {
+		if (fit[i] || mc_list_has(cur, offer[i]))
+			continue;
+		if (strlen(cur) + 8 >= curlen || strlen(added) + 8 >= addedlen)
+			break;
+		mc_list_add(cur, curlen, offer[i]);
+		mc_list_add(added, addedlen, offer[i]);
+		excl++;
+	}
+	st.excl = excl;
+	for (i = 0; i < n; i++)
+		if (fit[i] && !dfs[i] && mc_width_of(offer[i]) >= floor && !mc_list_has(cur, offer[i]))
+			nondfs++;
+	st.nondfs = loaded ? nondfs : -1;
+	mc_write(u, &st, list, ndlist, lifted);
+	if (nlifted && loaded && !mc_said(u, "lifted", st.sig))
+		logmessage("reaper_bwfloor", "wl%d: the exclusions in force left the %d AiMesh node(s) no non-DFS channel%s - %d excluded chanspec(s) every node can use are allowed again (%s) so a DFS check's fall-back has a landing they can follow", u, st.nodes, floor ? " at 80 MHz or wider" : "", nlifted, lifted);
+	snprintf(s, sizeof(s), "ok");
+	mc_status(u, s);
+	if (!mc_said(u, "built", st.sig))
+		logmessage("reaper_bwfloor", "wl%d: channels fitted to %d AiMesh node(s) (%s): %d of %d usable by every node, %d excluded here%s",
+			u, st.nodes, st.how, compat, n, excl, st.mld ? ", MLO on" : "");
+	if (loaded && !nondfs && !mc_said(u, "nondfs", st.sig))
+		logmessage("reaper_bwfloor", "wl%d: every channel the %d AiMesh node(s) can use%s is a DFS channel after the existing exclusions%s - the radio has no non-DFS channel to fall back to for them; a fixed bandwidth or a manual channel lifts the stock Auto-width exclusions",
+			u, st.nodes, floor ? " at 80 MHz or wider" : "", st.mld ? " (MLO on)" : "");
+	return excl;
+}
+
+/* 1 = the live chanspec is one every node can use, 0 = outside the set, -1 = no set for this radio */
+int reaper_meshchan_live_ok(int u, unsigned cs)
+{
+	static char list[MC_LISTMAX];
+	struct mc_state st;
+
+	if (mc_read(u, &st, list, sizeof(list)) < 0 || !list[0] || st.nodes <= 0)
+		return -1;
+	return mc_list_has(list, cs & 0xffff) ? 1 : 0;
+}
+
+/* -1 unknown, else how many non-DFS chanspecs every node can use at the floor the picker may still choose */
+int reaper_meshchan_nondfs(int u)
+{
+	struct mc_state st;
+
+	if (mc_read(u, &st, NULL, 0) < 0 || st.nodes <= 0)
+		return -1;
+	return st.nondfs;
+}
+
+/*
+ * Where to move a radio parked outside the set: the widest non-DFS chanspec every
+ * node can use at or above the floor that the picker may still choose (not
+ * excluded); ties go to the lowest value. 1 found, 0 none.
+ */
+int reaper_meshchan_target(int u, int floor, unsigned *cs)
+{
+	static char nd[MC_LISTMAX], ex[MC_LISTMAX + 1024];
+	char key[40];
+	const char *p;
+	char *end;
+	unsigned best = 0;
+	int bw = 0;
+
+	if (mc_read_line(u, 3, nd, sizeof(nd)) < 0 || !nd[0])
+		return 0;
+	snprintf(key, sizeof(key), "wl%d_acs_excl_chans", u);
+	strlcpy(ex, nvram_safe_get(key), sizeof(ex));
+	for (p = nd; *p; ) {
+		unsigned long v = strtoul(p, &end, 16);
+		if (end != p) {
+			int w = mc_width_of((unsigned)v);
+			if (w >= floor && !mc_list_has(ex, (unsigned)v) && (w > bw || (w == bw && v < best))) {
+				best = (unsigned)v;
+				bw = w;
+			}
+		}
+		p = strchr(p, ',');
+		if (!p)
+			break;
+		p++;
+	}
+	if (!bw)
+		return 0;
+	*cs = best;
+	return 1;
+}
+
+/* the fields the state line and the page carry */
+void reaper_meshchan_status(int u, unsigned live_cs, char *out, size_t len)
+{
+	struct mc_state st;
+	char path[64], s[24] = "";
+	FILE *f;
+	int ok;
+
+	snprintf(path, sizeof(path), MC_DIR "/wl%d.st", u);
+	if ((f = fopen(path, "r")) != NULL) {
+		if (fgets(s, sizeof(s), f))
+			s[strcspn(s, "\r\n")] = 0;
+		fclose(f);
+	}
+	if (!s[0]) {
+		out[0] = 0;
+		return;
+	}
+	if (mc_read(u, &st, NULL, 0) < 0)
+		memset(&st, 0, sizeof(st));
+	ok = live_cs ? reaper_meshchan_live_ok(u, live_cs) : -1;
+	snprintf(out, len, " fit=%s nodes=%d compat=%d nondfs=%d mld=%d live=%s",
+		 !strcmp(s, "ok") ? (ok == 0 ? "outside" : "ok") : s,
+		 st.nodes, st.compat, st.nondfs, nvram_get_int("mld_enable"), ok < 0 ? "-" : ok ? "in" : "out");
+}
+
+#endif /* !MESHCHAN_HOST */
