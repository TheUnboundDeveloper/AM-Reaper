+/* the OPERATING chanspec from `wl status` ("Chanspec: 48/80 (0xe32a)"): the chanspec iovar echoes
+ * the CONFIGURED value, which differs from where the radio is right after a `wl chanspec` set */
+static int oper_chanspec(const char *ifn, unsigned int *cs)
+{
+	char cmd[96], line[200];
+	FILE *p;
+	int ok = 0;
+
+	if (!ifname_ok(ifn))
+		return 0;
+	snprintf(cmd, sizeof(cmd), "wl -i %s status 2>/dev/null", ifn);
+	if ((p = popen(cmd, "r")) == NULL)
+		return 0;
+	while (fgets(line, sizeof(line), p)) {
+		char *t = strstr(line, "Chanspec:"), *h = t ? strstr(t, "0x") : NULL;
+		if (h) {
+			*cs = (unsigned int)strtoul(h, NULL, 16) & 0xffff;
+			ok = *cs != 0;
+		}
+	}
+	pclose(p);
+	return ok;
+}
+
+/* reaper v3.4.6: move a running radio to a chanspec the way the stock survey core and the Site
+ * Survey page do (httpd/web.c rsvy_cs_apply, r12 metal): the "chanspec" iovar sets only the
+ * configured value, "acs_update" -1 makes the driver act on it, and the result is verified on the
+ * OPERATING chanspec. A radio that did not move gets its configuration put back. 1 moved, 0 not. */
+static int move_to(const char *ifn, unsigned int from, unsigned int to)
+{
+	unsigned int oper = 0;
+	int i;
+
+	if (wl_iovar_setint((char *)ifn, "chanspec", (int)to) != 0)
+		return 0;
+	if (wl_iovar_setint((char *)ifn, "acs_update", -1) != 0) {
+		wl_iovar_setint((char *)ifn, "chanspec", (int)from);
+		return 0;
+	}
+	for (i = 0; i < 20; i++) {	/* a switch counts down beacons; the survey waits the same 10 s */
+		usleep(500000);
+		if (oper_chanspec(ifn, &oper) && oper == to)
+			return 1;
+	}
+	wl_iovar_setint((char *)ifn, "chanspec", (int)from);
+	return 0;
+}
