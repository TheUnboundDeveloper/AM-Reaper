+/* The same answer from the driver's own "bss" iovar - what `wl bss` reads - without the fork
+ * (audit 2026-10-16 C1: this ran `wl` for every 2.4/5 GHz carrier on every 5 s tick). Self-checking:
+ * the first read of an interface runs the utility once and compares; if the iovar fails or disagrees,
+ * one syslog line and the fork stays for that interface - a model where the iovar misbehaves keeps
+ * today's behaviour, it never gets an inert parker. */
+static int bss_state(const char *ifn)
+{
+	static struct { char ifn[IFNAMSIZ]; int trust; } seen[AP_MAXU];
+	int i, v = 0;
+
+	for (i = 0; i < AP_MAXU && seen[i].ifn[0] && strcmp(seen[i].ifn, ifn); i++)
+		;
+	if (i == AP_MAXU)
+		return bss_state_wl(ifn);
+	if (!seen[i].ifn[0]) {
+		int viaw = bss_state_wl(ifn);
+		int r = wl_bssiovar_get((char *)ifn, "bss", 0, &v, sizeof(v));
+		strlcpy(seen[i].ifn, ifn, sizeof(seen[i].ifn));
+		seen[i].trust = (r == 0 && viaw >= 0 && (v ? 1 : 0) == viaw);
+		if (!seen[i].trust)
+			logmessage(AP_TAG, "%s: the bss iovar %s - reading the carrier state through wl", ifn,
+				   r == 0 ? "disagrees with wl" : "is not available");
+		return viaw;
+	}
+	if (!seen[i].trust || wl_bssiovar_get((char *)ifn, "bss", 0, &v, sizeof(v)) != 0)
+		return bss_state_wl(ifn);
+	return v ? 1 : 0;
+}
