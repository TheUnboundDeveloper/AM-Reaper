+/* reaper v3.4.6: re-run the picker for ONE radio, the way the AiMesh controller does it
+ * (rom/apps_scripts/acs_restart.sh: acs_cli2 -i <radio> acs_restart, behind the same nvram gate
+ * rc.c uses). The other radios - the MLD's other links with MLO on - are left where they are. */
+static void repick_one(const char *ifn)
+{
+	if (nvram_match("acscli2_acs_restart", "1") && ifname_ok(ifn))
+		eval("acs_cli2", "-i", (char *)ifn, "acs_restart");
+	else
+		restart_picker();
