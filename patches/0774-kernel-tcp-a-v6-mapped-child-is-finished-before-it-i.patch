From 2ad7daa869f6d8bb88fd47687567a97197ecae98 Mon Sep 17 00:00:00 2001
From: reaper <theunbounddeveloper@outlook.com>
Date: Fri, 9 Oct 2026 20:26:59 -0400
Subject: [PATCH] kernel: tcp - a v6-mapped child is finished before it is
 hashed (CVE-2026-43198)

Port of upstream 858d2a4f67ff ("tcp: fix potential race in
tcp_v6_syn_recv_sock()") as taken into 5.10.y (aef4a9ae). An IPv4 client
connecting to a dual-stack listener gets a v6-mapped child socket; it was
published in the established hash by tcp_v4_syn_recv_sock() while its pinet6
still pointed at the listener's ipv6_pinfo, and only then fixed up. Another
CPU could use the child in that window.

__tcp_v4_syn_recv_sock() takes an optional child-init hook that runs before
the child is synced and hashed; tcp_v6_syn_recv_sock() passes
tcp_v6_mapped_child_init(). The exported six-argument tcp_v4_syn_recv_sock()
and the af_ops signature are unchanged (it calls the new function with NULL),
so no blob or out-of-tree caller sees a different ABI. The Broadcom MPTCP
variant is left as shipped: it is enabled on no Reaper model. test_kernel_tcp6_mapped_race.py
---
 .../kernel/linux-4.19/include/net/tcp.h       | 12 ++++
 .../kernel/linux-4.19/net/ipv4/tcp_ipv4.c     | 32 +++++++++--
 .../kernel/linux-4.19/net/ipv6/tcp_ipv6.c     | 56 ++++++++++++++++++-
 3 files changed, 94 insertions(+), 6 deletions(-)

diff --git a/release/src-rt-5.04behnd.4916/kernel/linux-4.19/include/net/tcp.h b/release/src-rt-5.04behnd.4916/kernel/linux-4.19/include/net/tcp.h
index f59aaa310f..38729916b5 100644
--- a/release/src-rt-5.04behnd.4916/kernel/linux-4.19/include/net/tcp.h
+++ b/release/src-rt-5.04behnd.4916/kernel/linux-4.19/include/net/tcp.h
@@ -565,6 +565,18 @@ struct sock *tcp_v4_syn_recv_sock(const struct sock *sk, struct sk_buff *skb,
 				  struct dst_entry *dst,
 				  struct request_sock *req_unhash,
 				  bool *own_req);
+/* CVE-2026-43198 (upstream 858d2a4f67ff): tcp_v4_syn_recv_sock() with a hook
+ * that finishes a v6-mapped child before it is hashed. Kept separate so the
+ * exported six-argument tcp_v4_syn_recv_sock() and the af_ops signature stay
+ * as they were for any out-of-tree caller.
+ */
+struct sock *__tcp_v4_syn_recv_sock(const struct sock *sk, struct sk_buff *skb,
+				    struct request_sock *req,
+				    struct dst_entry *dst,
+				    struct request_sock *req_unhash,
+				    bool *own_req,
+				    void (*opt_child_init)(struct sock *newsk,
+							   const struct sock *sk));
 int tcp_v4_do_rcv(struct sock *sk, struct sk_buff *skb);
 int tcp_v4_connect(struct sock *sk, struct sockaddr *uaddr, int addr_len);
 int tcp_connect(struct sock *sk);
diff --git a/release/src-rt-5.04behnd.4916/kernel/linux-4.19/net/ipv4/tcp_ipv4.c b/release/src-rt-5.04behnd.4916/kernel/linux-4.19/net/ipv4/tcp_ipv4.c
index 47a9eb9de0..30334ef7dc 100644
--- a/release/src-rt-5.04behnd.4916/kernel/linux-4.19/net/ipv4/tcp_ipv4.c
+++ b/release/src-rt-5.04behnd.4916/kernel/linux-4.19/net/ipv4/tcp_ipv4.c
@@ -1554,12 +1554,19 @@ EXPORT_SYMBOL(tcp_v4_conn_request);
 /*
  * The three way handshake has completed - we got a valid synack -
  * now create the new socket.
+ *
+ * opt_child_init (CVE-2026-43198): tcp_v6_syn_recv_sock() passes a hook for a
+ * v6-mapped child. It runs before the child is synced and hashed - once
+ * inet_ehash_nolisten() publishes it, other CPUs can use it, and its pinet6
+ * must no longer point at the listener's ipv6_pinfo.
  */
-struct sock *tcp_v4_syn_recv_sock(const struct sock *sk, struct sk_buff *skb,
-				  struct request_sock *req,
-				  struct dst_entry *dst,
-				  struct request_sock *req_unhash,
-				  bool *own_req)
+struct sock *__tcp_v4_syn_recv_sock(const struct sock *sk, struct sk_buff *skb,
+				    struct request_sock *req,
+				    struct dst_entry *dst,
+				    struct request_sock *req_unhash,
+				    bool *own_req,
+				    void (*opt_child_init)(struct sock *newsk,
+							   const struct sock *sk))
 {
 	struct inet_request_sock *ireq;
 	bool found_dup_sk = false;
@@ -1607,6 +1614,10 @@ struct sock *tcp_v4_syn_recv_sock(const struct sock *sk, struct sk_buff *skb,
 	}
 	sk_setup_caps(newsk, dst);
 
+#if IS_ENABLED(CONFIG_IPV6)
+	if (opt_child_init)
+		opt_child_init(newsk, sk);
+#endif
 	tcp_ca_openreq_child(newsk, dst);
 
 	tcp_sync_mss(newsk, dst_mtu(dst));
@@ -1665,6 +1676,17 @@ put_and_exit:
 	tcp_done(newsk);
 	goto exit;
 }
+EXPORT_SYMBOL(__tcp_v4_syn_recv_sock);
+
+struct sock *tcp_v4_syn_recv_sock(const struct sock *sk, struct sk_buff *skb,
+				  struct request_sock *req,
+				  struct dst_entry *dst,
+				  struct request_sock *req_unhash,
+				  bool *own_req)
+{
+	return __tcp_v4_syn_recv_sock(sk, skb, req, dst, req_unhash, own_req,
+				      NULL);
+}
 EXPORT_SYMBOL(tcp_v4_syn_recv_sock);
 
 #if !defined(CONFIG_BCM_KF_MPTCP) || !defined(CONFIG_BCM_MPTCP)
diff --git a/release/src-rt-5.04behnd.4916/kernel/linux-4.19/net/ipv6/tcp_ipv6.c b/release/src-rt-5.04behnd.4916/kernel/linux-4.19/net/ipv6/tcp_ipv6.c
index 39064c8631..315cc6d7ae 100644
--- a/release/src-rt-5.04behnd.4916/kernel/linux-4.19/net/ipv6/tcp_ipv6.c
+++ b/release/src-rt-5.04behnd.4916/kernel/linux-4.19/net/ipv6/tcp_ipv6.c
@@ -1270,6 +1270,46 @@ static void tcp_v6_restore_cb(struct sk_buff *skb)
 }
 
 #if !defined(CONFIG_BCM_KF_MPTCP) || !defined(CONFIG_BCM_MPTCP)
+/* CVE-2026-43198 (upstream 858d2a4f67ff "tcp: fix potential race in
+ * tcp_v6_syn_recv_sock()"). Called from __tcp_v4_syn_recv_sock() for a
+ * v6-mapped child BEFORE it is hashed. This used to run after
+ * tcp_v4_syn_recv_sock() returned, when the child was already visible in the
+ * established hash with pinet6 still pointing at the listener's ipv6_pinfo.
+ */
+static void tcp_v6_mapped_child_init(struct sock *newsk, const struct sock *sk)
+{
+	struct tcp6_sock *newtcp6sk = (struct tcp6_sock *)newsk;
+	const struct ipv6_pinfo *np = inet6_sk(sk);
+	struct inet_sock *newinet = inet_sk(newsk);
+	struct ipv6_pinfo *newnp;
+
+	newinet->pinet6 = newnp = &newtcp6sk->inet6;
+
+	memcpy(newnp, np, sizeof(struct ipv6_pinfo));
+
+	newnp->saddr = newsk->sk_v6_rcv_saddr;
+
+	inet_csk(newsk)->icsk_af_ops = &ipv6_mapped;
+	newsk->sk_backlog_rcv = tcp_v4_do_rcv;
+#ifdef CONFIG_TCP_MD5SIG
+	tcp_sk(newsk)->af_specific = &tcp_sock_ipv6_mapped_specific;
+#endif
+
+	newnp->ipv6_mc_list = NULL;
+	newnp->ipv6_ac_list = NULL;
+	newnp->ipv6_fl_list = NULL;
+	newnp->pktoptions  = NULL;
+	newnp->opt	   = NULL;
+
+	/* __tcp_v4_syn_recv_sock() has set newinet->mc_{index,ttl} from the skb */
+	newnp->mcast_oif   = newinet->mc_index;
+	newnp->mcast_hops  = newinet->mc_ttl;
+
+	newnp->rcv_flowinfo = 0;
+	if (np->repflow)
+		newnp->flow_label = 0;
+}
+
 static struct sock *tcp_v6_syn_recv_sock(const struct sock *sk, struct sk_buff *skb,
 					 struct request_sock *req,
 					 struct dst_entry *dst,
@@ -1298,8 +1338,21 @@ struct sock *tcp_v6_syn_recv_sock(const struct sock *sk, struct sk_buff *skb,
 	struct flowi6 fl6;
 
 	if (skb->protocol == htons(ETH_P_IP)) {
+#if !defined(CONFIG_BCM_KF_MPTCP) || !defined(CONFIG_BCM_MPTCP)
+		/*
+		 *	v6 mapped: the child is finished by tcp_v6_mapped_child_init()
+		 *	before it is hashed (CVE-2026-43198). Its tcp_sync_mss() in
+		 *	__tcp_v4_syn_recv_sock() then already runs with the ipv6_mapped
+		 *	ops, so the second sync that used to follow here is gone.
+		 */
+		return __tcp_v4_syn_recv_sock(sk, skb, req, dst,
+					      req_unhash, own_req,
+					      tcp_v6_mapped_child_init);
+#else
 		/*
-		 *	v6 mapped
+		 *	v6 mapped (Broadcom MPTCP build, not enabled on any Reaper
+		 *	model: the mapped ops depend on the request's saw_mpc, which
+		 *	the child-init hook does not see - left as shipped)
 		 */
 
 		newsk = tcp_v4_syn_recv_sock(sk, skb, req, dst,
@@ -1361,6 +1414,7 @@ struct sock *tcp_v6_syn_recv_sock(const struct sock *sk, struct sk_buff *skb,
 		tcp_sync_mss(newsk, inet_csk(newsk)->icsk_pmtu_cookie);
 
 		return newsk;
+#endif
 	}
 
 	ireq = inet_rsk(req);
-- 
2.25.1

