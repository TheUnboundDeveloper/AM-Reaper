+  if(miss)
+    c += '<span class="fchip vol miss' + (selVol === PINKEY ? ' on' : '') + '" data-v="' + PINKEY + '">' +
+         esc(miss.name) + ' &mdash; ' + esc(`<#RDST_82#>`) + '</span>';
+  V.forEach(function(v){
+    var tag = '';
+    if(v.name === pinName) tag = '<span class="vtag in">' + esc(`<#RDST_80#>`) + '</span>';
+    else if(v.hist) tag = '<span class="vtag">' + esc(`<#RDST_81#>`) + '</span>';
+    c += '<span class="fchip vol' + (v.name === selVol ? ' on' : '') + '" data-v="' + esc(v.name) + '">' +
+         esc(v.name) + tag + '</span>';
