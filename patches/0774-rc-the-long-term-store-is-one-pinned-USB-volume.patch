 release/src/router/rc/watchdog.c          |   1 +
 release/src/router/www/Reaper_Storage.asp | 191 ++++++++++++++++++++--
 3 files changed, 283 insertions(+), 10 deletions(-)

diff --git a/release/src/router/rc/reaper_usbmon.c b/release/src/router/rc/reaper_usbmon.c
index 5a59fa05547..4f9090c5b47 100644
--- a/release/src/router/rc/reaper_usbmon.c
+++ b/release/src/router/rc/reaper_usbmon.c
@@ -451,3 +451,104 @@ void reaper_usbmon_check(void)
 		usbmon_recover_bus();
 	}
 }
