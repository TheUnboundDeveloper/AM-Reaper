+/* ---- 2026-10-18: the pinned long-term store (shared/reaper_store.h) ----
+ * Two jobs on the watchdog tick, every USBMON_EVERY_SECS:
+ *  1. ADOPT, once (the upgrade path): a box already set to USB before the pin
+ *     existed has reaper_store=usb and no reaper_store_vid. Pin the volume that
+ *     holds Reaper history - the most recently written one when several do (the
+ *     field box had history on both partitions) - by writing its store.id and
+ *     the nvram pin. Waits until the box has been up RSTORE_ADOPT_UP_SECS and no
+ *     mount has been active for RSTORE_ADOPT_QUIET_SECS, so a partition that is
+ *     still mounting is never passed over. No history anywhere: the only mounted
+ *     volume, else nothing (Reaper_Storage.asp asks). A box with a pin is never
+ *     touched, and reaper_store itself is never changed.
+ *  2. LAST SEEN: while the pin is mounted, keep "<epoch> <vid>" in /jffs at most
+ *     hourly (first write once the clock is sane), so the page can say when a
+ *     missing volume was last there. A tiny file, rewritten 24 times a day. */
+#include <reaper_store.h>
+#define RSTORE_ADOPT_UP_SECS	300
+#define RSTORE_ADOPT_QUIET_SECS	120
+#define RSTORE_SEEN_EVERY_SECS	3600
+
+static void rstore_adopt(unsigned long up)
+{
+	static int done = 0;
+	char buf[32], best[64] = "", only[64] = "", vdir[96], nid[24];
+	long best_t = 0;
+	int nvol = 0;
+	DIR *d;
+	struct dirent *e;
+
+	if (done || up < RSTORE_ADOPT_UP_SECS)
+		return;
+	if (f_read_string(REAPER_USB_MOUNT_STAMP, buf, sizeof(buf)) > 0
+	    && up < strtoul(buf, NULL, 10) + RSTORE_ADOPT_QUIET_SECS)
+		return;	/* a mount was active recently (or the stamp is ahead): let it finish */
+	if (reaper_usbmon_lock_busy("/var/lock/usb.lock"))
+		return;
+	if ((d = opendir(RSTORE_MNT)) == NULL)
+		return;
+	while ((e = readdir(d)) != NULL) {
+		long newest = 0;
+		if (!rstore_is_mount(RSTORE_MNT, e->d_name, 1))
+			continue;
+		snprintf(vdir, sizeof(vdir), RSTORE_MNT "/%s", e->d_name);
+		if (access(vdir, W_OK) != 0)
+			continue;
+		nvol++;
+		strlcpy(only, e->d_name, sizeof(only));
+		if (rstore_hist(vdir, &newest) && newest > best_t) {
+			best_t = newest;
+			strlcpy(best, e->d_name, sizeof(best));
+		}
+	}
+	closedir(d);
+	if (!best[0]) {
+		if (nvol != 1)
+			return;	/* nothing mounted yet, or several and none holds history */
+		strlcpy(best, only, sizeof(best));
+	}
+	snprintf(vdir, sizeof(vdir), RSTORE_MNT "/%s", best);
+	if (rstore_new_id(nid, sizeof(nid)) != 0 || rstore_write_id(vdir, nid) != 0) {
+		logmessage("reaper", "long-term storage: could not mark USB volume %s as the store - will retry", best);
+		return;
+	}
+	nvram_set("reaper_store_vid", nid);
+	nvram_set("reaper_store_vname", best);
+	nvram_commit();
+	rstore_seen_write(nid, (long)time(NULL));
+	done = 1;
+	logmessage("reaper", "long-term storage: USB volume %s is now the pinned store (%s); other volumes are no longer used",
+		best, best_t ? "it holds the most recent Reaper history" : "the only mounted volume");
+}
+
+void reaper_store_check(void)
+{
+	static unsigned long last = 0, seen_up = 0;
+	static int seen_once = 0;
+	unsigned long up = (unsigned long)uptime();
+	char vid[24], name[64];
+	time_t now;
+
+	if (up - last < USBMON_EVERY_SECS)
+		return;
+	last = up;
+	if (!nvram_match("reaper_store", "usb"))
+		return;
+	strlcpy(vid, nvram_safe_get("reaper_store_vid"), sizeof(vid));
+	if (!rstore_vid_ok(vid)) {
+		rstore_adopt(up);
+		return;
+	}
+	if (!rstore_find(RSTORE_MNT, 1, vid, name, sizeof(name), NULL, 0))
+		return;
+	if (strcmp(nvram_safe_get("reaper_store_vname"), name))
+		nvram_set("reaper_store_vname", name);	/* relabelled: keep the display name current */
+	now = time(NULL);
+	if (now > 1600000000 && (!seen_once || up - seen_up >= RSTORE_SEEN_EVERY_SECS)
+	    && rstore_seen_write(vid, (long)now) == 0) {
+		seen_once = 1;
+		seen_up = up;
+	}
+}
