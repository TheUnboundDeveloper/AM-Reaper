-  document.getElementById('clitbody').innerHTML = tb || `<tr><td colspan="3" style="color:var(--steel)"><#RTRF_69#></td></tr>`;
+  var maxTot=rows.length?Math.max(1,rows[0].tot):1, tb=[];
