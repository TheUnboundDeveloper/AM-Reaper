 </div>
 
@@ -409,6 +439,40 @@ function devCell(ip, mac){
   return '<span class="tname">'+esc(head)+'</span>'+(bits.length?'<div class="tsub">'+bits.join(' &middot; ')+'</div>':'');
 }
 
+/* ---- Top devices / Top talkers: fixed row count ----
+   The tables used to hold however many rows the last sample had, so each refresh
+   grew or shrank the panel and moved everything under it. Now each table always
+   renders exactly TOPN[which] rows (the 10/20/30/50 buttons in its header, kept
+   per table in localStorage): real rows first, then blank rows to fill the box.
+   Renderers hand over up to TOPN_MAX rows; the latest set is kept so a button
+   press redraws at once instead of waiting for the next sample. */
+var TOPN_MAX=50, TOPN_OPTS=[10,20,30,50], TOPN={cli:10,top:10}, TOPROWS={cli:null,top:null};
+var TOPTB={cli:'clitbody',top:'toptbody'};
+function fillTop(which, rows, empty){
+  TOPROWS[which]={rows:rows, empty:empty};
+  var n=TOPN[which], h='', i;
+  for(i=0;i<n;i++){
+    if(i<rows.length) h+=rows[i];
+    else if(i===0) h+='<tr><td colspan="3" style="color:var(--steel)">'+empty+'</td></tr>';
+    else h+='<tr class="pad"><td colspan="3"></td></tr>';
+  }
+  document.getElementById(TOPTB[which]).innerHTML=h;
+}
+(function(){
+  try{ ['cli','top'].forEach(function(w){ var v=parseInt(localStorage.getItem('rtraf_rows_'+w),10); if(TOPN_OPTS.indexOf(v)>=0) TOPN[w]=v; }); }catch(e){}
+  var sels=document.querySelectorAll('.rowsel');
+  for(var s=0;s<sels.length;s++)(function(sel){
+    var w=sel.getAttribute('data-tbl'), bs=sel.querySelectorAll('button'), j;
+    var mark=function(){ for(var k=0;k<bs.length;k++) bs[k].className=(parseInt(bs[k].textContent,10)===TOPN[w])?'on':''; };
+    for(j=0;j<bs.length;j++) bs[j].onclick=function(){
+      TOPN[w]=parseInt(this.textContent,10);
+      try{ localStorage.setItem('rtraf_rows_'+w, String(TOPN[w])); }catch(e){}
+      mark(); var c=TOPROWS[w]; fillTop(w, c?c.rows:[], c?c.empty:'');
+    };
+    mark(); fillTop(w, [], '');   /* full-size box from the first paint */
+  })(sels[s]);
+})();
+
 /* ---- SVG chart helpers (W=1000 viewBox) ---- */
 var W=1000;
 function axis(svg, H, maxv, unit){
@@ -632,9 +696,9 @@ function renderLive(d){
   var th=''; for(var i=0;i<tiles.length;i++) th+='<div class="tile"><div class="k">'+tiles[i][0]+'</div><div class="v '+tiles[i][2]+'">'+tiles[i][1]+'</div></div>';
   document.getElementById('tiles').innerHTML=th;
   if(drawTbl){
-    var tb=''; (d.top||[]).sort(function(a,b){return b.rate-a.rate;}).slice(0,12).forEach(function(t){
-      tb+='<tr><td>'+devCell(t.src,t.smac)+'</td><td>'+esc(t.dst)+' <span class="badge">'+esc(portName(t.dport,t.proto))+'</span></td><td class="num">'+fmtBps(t.rate*8)+'</td></tr>'; });
-    document.getElementById('toptbody').innerHTML = tb || `<tr><td colspan="3" style="color:var(--steel)"><#RTRF_63#></td></tr>`;
+    var tr=[]; (d.top||[]).sort(function(a,b){return b.rate-a.rate;}).slice(0,TOPN_MAX).forEach(function(t){
+      tr.push('<tr><td>'+devCell(t.src,t.smac)+'</td><td><div class="dcell"><span class="dip" title="'+esc(t.dst)+'">'+esc(t.dst)+'</span><span class="badge">'+esc(portName(t.dport,t.proto))+'</span></div></td><td class="num">'+fmtBps(t.rate*8)+'</td></tr>'); });
+    fillTop('top', tr, `<#RTRF_63#>`);
   }
 
   if(curWin!=='live') return;   /* rolling live charts only render in the Live window */
