From 673ade55e2099c5ab39b0532555c859aae6d6480 Mon Sep 17 00:00:00 2001
From: reaper <theunbounddeveloper@outlook.com>
Date: Fri, 9 Oct 2026 20:27:00 -0400
Subject: [PATCH] rtrafd, www: Traffic Analyzer - Top Devices and Top Talkers
 show 10, 20, 30 or 50 rows

Each table gets its own 10/20/30/50 selector (remembered in the browser), a
fixed layout and padded rows, so the page does not jump as rows come and go.
rtrafd keeps 64 live top-talker slots (was 20) so the 50-row view is full and
the spare slots absorb eviction churn.
---
 release/src/router/rtrafd/rtrafd.c        |  4 +-
 release/src/router/www/Reaper_Traffic.asp | 92 +++++++++++++++++++----
 2 files changed, 80 insertions(+), 16 deletions(-)

diff --git a/release/src/router/rtrafd/rtrafd.c b/release/src/router/rtrafd/rtrafd.c
index 1c6cbed45d..5e0a54e9b9 100644
--- a/release/src/router/rtrafd/rtrafd.c
+++ b/release/src/router/rtrafd/rtrafd.c
@@ -116,7 +116,7 @@ static int hp_ct_ready = 0;		/* health probe: that pass has published its counts
 #define RT_DEVKEY	"router"
 #define RT_DEVLBL	"Router"
 #define NFLOW		16384	/* conntrack delta table (power of 2) */
-#define NTOP		20
+#define NTOP		64	/* live top-talker slots; the page shows up to 50 (v3.3.8: 20 -> 64, the spare slots absorb eviction churn) */
 #define FC_MAX		1536	/* flows parsed per fcache poll (bounded work) */
 #define FC_SLOTS	16384	/* fcache flow-id -> last-bytes delta table */
 #define SAVE_EVERY	3600	/* persist once an hour (jffs - NAND wear) */
@@ -1108,7 +1108,7 @@ static void top_note(const char *src, const char *dst, int dport, int proto,
 	 * draws that line in the same spot. */
 	if (top_is_self(dst)) return;
 
-	/* ...and NTOP is 20 SLOTS, which is not the same thing as 20 talkers. One
+	/* ...and NTOP is a count of SLOTS, which is not the same thing as talkers. One
 	 * conversation opened over eleven parallel connections used to occupy eleven
 	 * of them: a wrong reading (the panel promises a per-destination-port
 	 * bucket, and showed eleven identical rows instead), and a real loss, since
diff --git a/release/src/router/www/Reaper_Traffic.asp b/release/src/router/www/Reaper_Traffic.asp
index 64248cf889..3f88ad77b1 100644
--- a/release/src/router/www/Reaper_Traffic.asp
+++ b/release/src/router/www/Reaper_Traffic.asp
@@ -94,6 +94,36 @@ table.ta .num{text-align:right;font-variant-numeric:tabular-nums;color:var(--bon
 .bar>span{position:absolute;left:0;top:0;bottom:0;border-radius:4px;background:var(--s1)}
 .tname{color:var(--bone);font-weight:500}
 .tsub{color:var(--steel);font-size:11px;margin-top:1px}
+/* Top devices / Top talkers: a fixed box. The table always holds exactly the
+   chosen number of rows (blank rows pad it), every row has one height, and the
+   columns are fixed, so a refresh never moves the panels below it. */
+.phead{display:flex;align-items:center;gap:10px}
+.phead h2{flex:1}
+.rowsel{display:inline-flex;border:1px solid var(--line-soft);border-radius:8px;overflow:hidden}
+.rowsel button{font-family:var(--hdr);font-weight:600;font-size:11.5px;letter-spacing:.05em;background:transparent;
+  color:var(--bone-dim);border:0;border-left:1px solid var(--line-soft);padding:4px 9px;cursor:pointer;min-width:32px}
+.rowsel button:first-child{border-left:0}
+.rowsel button:hover{color:var(--bone)}
+.rowsel button.on{color:#fff;background:linear-gradient(180deg,var(--crimson),var(--crimson-deep))}
+table.ta.tfix{table-layout:fixed}
+table.ta.tfix tbody tr{height:54px}
+table.ta.tfix td{white-space:nowrap;overflow:hidden;text-overflow:ellipsis;vertical-align:middle;padding-top:0;padding-bottom:0}
+table.ta.tfix .tname,table.ta.tfix .tsub{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
+table.ta.tfix tr.pad td{border-bottom-color:transparent}
+table.ta.tfix .dcell{display:flex;align-items:center;gap:7px;min-width:0}
+table.ta.tfix .dip{overflow:hidden;text-overflow:ellipsis;min-width:0}
+table.ta.tfix .dcell .badge{flex:none}
+.grid>.panel{min-width:0}
+@media(max-width:600px){
+  .phead{flex-wrap:wrap}
+  table.ta.tfix .c-num{width:78px}
+  table.ta.tfix .c-src{width:42%}
+  table.ta.tfix td,table.ta.tfix th{padding-left:5px;padding-right:5px}
+  table.ta.tfix .dcell{flex-wrap:wrap;row-gap:3px}
+  table.ta.tfix .dip{flex:1 1 100%}
+}
+table.ta.tfix .c-num{width:104px}
+table.ta.tfix .c-src{width:40%}
 .badge{font-family:var(--hdr);font-size:9.5px;letter-spacing:.08em;border:1px solid var(--line-soft);border-radius:5px;padding:2px 6px;color:var(--steel)}
 .badge.updonly{margin-left:9px;vertical-align:2px;text-transform:none;letter-spacing:.06em;cursor:help}
 
