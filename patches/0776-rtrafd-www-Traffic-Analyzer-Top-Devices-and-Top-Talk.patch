-  document.getElementById('clitbody').innerHTML = dh || `<tr><td colspan="3" style="color:var(--steel)"><#RTRF_66#></td></tr>`;
+  var dh=[];
+  devs.slice(0,TOPN_MAX).forEach(function(r){ var tot=r.dn+r.up;
