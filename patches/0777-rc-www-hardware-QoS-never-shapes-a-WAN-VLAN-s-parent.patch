diff --git a/release/src/router/rc/qos.c b/release/src/router/rc/qos.c
index 84a98d238e..e9aed92929 100644
--- a/release/src/router/rc/qos.c
+++ b/release/src/router/rc/qos.c
@@ -3153,6 +3153,38 @@ int start_cake(void)
 #ifndef HWQOS_VLAN_CFG
 #define HWQOS_VLAN_CFG "/proc/net/vlan/config"
 #endif
+/* reaper 2026-10-10 (field, GT-BE98 family on v3.3.8): on the boards with the
+ * external 2.5G switch (GT-BE98, GT-BE98 Pro, GT-BE96, GT-BE19000) the "2.5G
+ * WAN/LAN-1" jack is vlan4094 on eth1, and eth1 is also LAN-2..4 and a wired
+ * AiMesh backhaul. The parent lookup below therefore handed the LAN trunk to
+ * tmctl, and the whole classful program (queues deleted and recreated, PI2,
+ * the queue shapers, the port shaper at the upload rate, the policer) landed
+ * on it: every wired LAN port and the backhaul were throttled to the upload
+ * rate and the box looked dead. Before v3.3.7 tmctl was pointed at vlan4094
+ * itself, which it refuses (rc=108, as ppp0), so hardware QoS on that jack
+ * was inert and nobody noticed. A port that also carries the LAN is never
+ * shaped: the lookup returns no port, both engines refuse to arm, and the
+ * reason is logged once per start. The QoS page says the same (RQOS_125). */
+#ifndef HWQOS_SYSNET
+#define HWQOS_SYSNET "/sys/class/net"
+#endif
+static int hwqos_lan_port(const char *ifname)
+{
+	char path[128], word[IFNAMSIZ + 1], *next, *list;
+
+	if (!ifname || !*ifname)
+		return 0;
+	/* the kernel's view: a bridge member right now */
+	snprintf(path, sizeof(path), HWQOS_SYSNET "/%s/brport", ifname);
+	if (d_exists(path))
+		return 1;
+	/* the model's LAN port set */
+	list = nvram_safe_get("lan_ifnames");
+	foreach(word, list, next)
+		if (!strcmp(word, ifname))
+			return 1;
+	return 0;
+}
 static const char *hwqos_tm_ifname(int unit)
 {
 	static char buf[IFNAMSIZ + 1];
@@ -3178,8 +3210,15 @@ static const char *hwqos_tm_ifname(int unit)
 			}
 		fclose(f);
 	}
-	if (name && strcmp(buf, name))
-		logmessage("qos", "hardware QoS shapes %s, the port under %s", buf, get_wan_ifname(unit));
+	if (name && strcmp(buf, name)) {
+		if (hwqos_lan_port(buf)) {
+			logmessage("qos", "hardware QoS not applied: WAN %s rides %s, which also carries the LAN ports - "
+					  "shaping it would throttle the wired LAN and a wired backhaul. "
+					  "Use the 10G WAN port for hardware QoS, or a software engine on this jack.", name, buf);
+			buf[0] = '\0';
+		} else
+			logmessage("qos", "hardware QoS shapes %s, the port under %s", buf, get_wan_ifname(unit));
+	}
 	return buf;
 }
 
@@ -3214,6 +3253,13 @@ int start_hwqos(void)
 		}
 	}
 
+	/* reaper 2026-10-10: no port to shape (the WAN rides a LAN trunk, or the
+	 * name was not a plain interface name) - do not arm; the reason was logged. */
+	if (!*wan_ifname) {
+		logmessage("qos", "hardware QoS not started: no port to shape");
+		return -1;
+	}
+
 	if ((f = fopen(qosfn, "w")) == NULL) return -2;
 
 	fprintf(f,
@@ -3332,6 +3378,13 @@ int start_hwqos_classful(void)
 		}
 	}
 
+	/* reaper 2026-10-10: no port to shape (the WAN rides a LAN trunk, or the
+	 * name was not a plain interface name) - do not arm; the reason was logged. */
+	if (!*wan_ifname) {
+		logmessage("qos", "hardware QoS not started: no port to shape");
+		return -1;
+	}
+
 	if ((f = fopen(qosfn, "w")) == NULL) return -2;
 
 	fprintf(f,
