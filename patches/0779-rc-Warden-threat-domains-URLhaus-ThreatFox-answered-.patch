+/* Put the country-list host into the whitelist ONCE (see RW_GEO_HOST_IP).
+ * Owner-directed exception to "an update never rewrites a user setting": it
+ * only ADDS one entry, never removes or reorders anything, and the marker is
+ * written whether or not the entry was added - so a user who deletes it later
+ * keeps it deleted. Runs only after the nvram -> /jffs list migration has
+ * committed: before that, the allow file is about to be overwritten by the
+ * migration and a seed written now would be lost with the marker already set.
+ * Runs whether or not Warden is enabled, so the entry is on the page before the
+ * user first arms it. */
+static void rw_seed_allow(void)
+{
+	char *cur, *dup, *nv, *tok, *save = NULL;
+	int have = 0;
+	size_t n;
+
+	if (!f_exists(REAPER_RW_DIR "/.committed") || f_exists(RW_SEED_MARK))
+		return;
+	if ((cur = rw_list_get("allow")) == NULL)
+		return;
+	if ((dup = strdup(cur)) != NULL) {
+		for (tok = strtok_r(dup, " ,<>", &save); tok; tok = strtok_r(NULL, " ,<>", &save))
+			if (!strcmp(tok, RW_GEO_HOST_IP) || !strcmp(tok, RW_GEO_HOST_IP "/32")) { have = 1; break; }
+		free(dup);
+	} else {
+		free(cur);
+		return;
+	}
+	if (!have) {
+		n = strlen(cur) + sizeof(" " RW_GEO_HOST_IP);
+		if ((nv = malloc(n)) == NULL) { free(cur); return; }
+		snprintf(nv, n, "%s%s%s", cur, (*cur && cur[strlen(cur) - 1] != ' ') ? " " : "", RW_GEO_HOST_IP);
+		if (rw_list_set("allow", nv) != 0) { free(nv); free(cur); return; }	/* retry next start */
+		free(nv);
+		logmessage("rwarden", "whitelist: added the country-list host www.ipdeny.com (%s) once - remove it on the Warden page if not wanted", RW_GEO_HOST_IP);
+	}
+	free(cur);
+	rjf_set(RW_SEED_MARK, "1", "rwarden");
+}
