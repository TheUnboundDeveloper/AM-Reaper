From 7cd163646d2df8ca96cc2acb926e89c5b0a2e083 Mon Sep 17 00:00:00 2001
From: reaper <theunbounddeveloper@outlook.com>
Date: Mon, 19 Oct 2026 16:58:53 -0400
Subject: [PATCH] rc: Warden threat domains (URLhaus / ThreatFox answered
 NXDOMAIN) and the list host whitelisted once

Threat domains, new and off by default: abuse.ch's public hostfiles become
address=/host/ lines in /tmp/rwarden/dns.conf, included by every dnsmasq
instance (services.c for the main one, sdn.c for each guest/VLAN network -
emitted only when the file exists, a missing include is fatal to dnsmasq).
Per-feed keep-last-good on a failed fetch, a 100,000-name cap, a never-block
set (the feed hosts, NTP, DDNS, DNS-over-TLS names, the LAN domain) plus the
user's exemptions (/jffs/rwarden/dnsallow), one restart_dnsmasq only when the
list changed, /jffs/rwarden/dns.cache replayed at boot, rw_dns_sync() when the
switch flips. reaper_warden_dns_conf() exported through rc.h. Keys
rwarden_dns / rwarden_dns_feeds (defaults in the security-review commit).
The country-list fetch is redirect-pinned to https like the threat feeds.

The list host: www.ipdeny.com (51.15.12.186) is in France; with FR selected
and the router-self filter on, Warden dropped its own downloads, the update
budget ran out and countries added after that never loaded. The address is
seeded into the whitelist once, visibly and removably; a country with no data
is logged as NOT blocked and named in one closing line.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 release/src/router/rc/rc.h               |   2 +
 release/src/router/rc/rwarden.c          | 252 ++++++++++++++++++++++-
 release/src/router/rc/sdn.c              |   9 +
 release/src/router/rc/services.c         |   9 +
 release/src/router/www/Reaper_Warden.asp |  75 ++++++-
 5 files changed, 336 insertions(+), 11 deletions(-)

diff --git a/release/src/router/rc/rc.h b/release/src/router/rc/rc.h
index 777e064cbf9..a76b8031ed2 100644
--- a/release/src/router/rc/rc.h
+++ b/release/src/router/rc/rc.h
@@ -3038,6 +3038,7 @@ extern int pidof_upnp(void);	/* reaper: pid of miniupnpd OR miniupnpd-igdv2 (exa
 extern void start_wlcsm_bindfix(void);	/* reaper: arm/clear the WLCSM netlink bind() shim via /etc/ld.so.preload */
 extern void stop_rwarden(void);	/* reaper v1.8.0 Warden ipset threat-feed/geo/manual-IP firewall (rc/rwarden.c) */
 extern void start_rwarden(void);
+extern const char *reaper_warden_dns_conf(void);	/* 2026-10-19: the threat-domain include for every dnsmasq instance, or NULL (rc/services.c, rc/sdn.c) */
 /* reaper v2.3.8 native firewall: object-model custom rules engine (rc/reaper_fw.c).
  * start/stop apply the COMMITTED ruleset; apply/confirm/rollback drive the
  * commit-confirm state machine; dryrun compiles a preview and executes nothing. */
@@ -3069,6 +3070,7 @@ extern void reaper_usb_mount_stamp(void);	/* rc/usb.c */
 #define REAPER_USB_RETRY_MARK	"/tmp/reaper/.reaper_usb_retry_"	/* + partition: mount events re-sent so far */
 #define REAPER_USB_RETRY_MAX	3
 extern void reaper_usbmon_check(void);
+extern void reaper_store_check(void);	/* 2026-10-18: pinned long-term store - adopt + last seen (rc/reaper_usbmon.c) */
 extern void reaper_usb_mounted_mark(const char *part);
 extern int reaper_slp_should_arm(unsigned long up, unsigned long stamp, int have_stamp, unsigned long floor, unsigned long grace);	/* rc/watchdog.c, libc only */
 /* v2.6.2 shared REAPER_HOOK front chains (rc/reaper_hook.c) */
diff --git a/release/src/router/rc/rwarden.c b/release/src/router/rc/rwarden.c
index 792f096ba8e..7ae0951252f 100644
--- a/release/src/router/rc/rwarden.c
+++ b/release/src/router/rc/rwarden.c
@@ -55,7 +55,9 @@
  *   clock would present as a whole-network outage rather than a router-only
  *   one. Cannot lock a user out: management is LAN->router (INPUT) and the
  *   replies carry a LAN destination, which RW_SELF exempts, so the GUI stays
- *   reachable and the toggle stays revocable.
+ *   reachable and the toggle stays revocable. The country-list host is NOT a
+ *   built-in carve-out: it is seeded once into the user's whitelist
+ *   (rw_seed_allow, 2026-10-19) and stays removable.
  *
  * STATS (v1.8.7): start_rwarden generates /tmp/rwarden/stats.sh, which reads
  *   the live iptables/ip6tables packet counters and emits a JSON snapshot
@@ -90,6 +92,12 @@
 #define RW_CCTMP  "/tmp/rwarden/cc.live"	/* scratch: live per-country deltas being folded */
 #define RW_CHTMP  "/tmp/rwarden/ch.live"	/* scratch: one chain listing, read by every bucket */
 #define RW_SAVE   "/jffs/rwarden/sets.ipset"
+/* 2026-10-19 threat domains: the dnsmasq include (address=/host/ lines) every
+ * instance reads through conf-file=, its /jffs copy for a boot before the first
+ * update, and the stamp of the last successful list build */
+#define RW_DNS_CONF  "/tmp/rwarden/dns.conf"
+#define RW_DNS_CACHE "/jffs/rwarden/dns.cache"
+#define RW_DNS_UPD   "/tmp/rwarden/dns.upd"
 /* The threat sets' ceiling. Was a bare literal repeated at six ipset-create
  * sites AND implicitly assumed by the UI, so "surface the count against the
  * limit" had no single number to quote. One definition, string form for the
@@ -113,6 +121,19 @@
 #define RW_GEO_BUDGET_S "900"
 #define RW_GEO_MAXELEM   262144		/* per-country sets; the default 65536 truncates the biggest zones */
 #define RW_GEO_MAXELEM_S "262144"	/* same value, for string-pasted script text */
+/* The country-list host, seeded ONCE into the user's whitelist (owner,
+ * 2026-10-19). www.ipdeny.com is hosted in France (Scaleway, 51.15.0.0/16), so
+ * with FR selected and the router-traffic filter on, RW_SELF dropped the
+ * updater's own downloads: every fetch timed out, the 900 s geo budget ran out,
+ * and countries added after FR was armed never loaded at all (27 of 79 sat at
+ * zero entries on the owner's box while the page showed them as blocked). A
+ * plain whitelist entry rather than a hidden carve-out, so it is visible on the
+ * page and removable - a user who deletes it owns the consequence, and the
+ * one-shot marker below guarantees it is never put back. IPv4 only: the host
+ * has no AAAA record (checked 2026-10-19). If ipdeny ever moves, the
+ * REAPER-WARDEN-SELF log line names the new DST. */
+#define RW_GEO_HOST_IP  "51.15.12.186"
+#define RW_SEED_MARK    REAPER_RW_DIR "/.seed_geohost"
 
 /* Curated open IP/CIDR feeds. id must be [a-z0-9]; url is emitted only into a
  * single-quoted curl arg in the generated updater, and is a fixed literal here
@@ -1051,6 +1072,22 @@ static void rw_gen_update(void)
 	  "CURLG='curl -fsSL --max-filesize 33554432 --retry 1 --max-time 20'\n"
 	  "GEO_DEADLINE=$(( $(date +%%s) + " RW_GEO_BUDGET_S " ))\n"
 	  "geo_budget_left() { [ \"$(date +%%s)\" -lt \"$GEO_DEADLINE\" ]; }\n"
+	  /* 2026-10-19: one wrapper per country fetch so a failure can say WHICH
+	   * kind it was. Every miss used to log "FAILED ... keeping last-good" -
+	   * including fetches never attempted because the budget had run out, and
+	   * sets that had never held a single entry, so a country the page listed
+	   * as blocked could be silently unblocked forever. GT records whether the
+	   * fetch was actually tried; geo_fail sorts the miss into skipped / no data
+	   * (NOT blocked) / stale. */
+	  "GEO_SKIP=0; GEO_FAIL=0\n"
+	  "geo_get() { GT=0; geo_budget_left || return 1; GT=1; $CURLG \"$1\" -o $TMP 2>/dev/null && [ -s $TMP ]; }\n"
+	  "geo_fail() {\n"
+	  "  [ \"$GT\" = 1 ] || { GEO_SKIP=$((GEO_SKIP+1)); return 0; }\n"
+	  "  GEO_FAIL=$((GEO_FAIL+1))\n"
+	  "  NE=$(ipset -t list $3 2>/dev/null | sed -n 's/.*Number of entries: //p')\n"
+	  "  if [ \"${NE:-0}\" -gt 0 ]; then logger -t rwarden \"geo $1 fetch FAILED for $2 - keeping last-good\"\n"
+	  "  else logger -t rwarden \"geo $1 fetch FAILED for $2 - NO data loaded yet, this country is NOT blocked\"; fi\n"
+	  "}\n"
 	  /* https-only INCLUDING across redirects. -L follows redirects and curl
 	   * permits https->http by default, so an https feed that 302s to http was
 	   * still followed - and whatever came back is loaded straight into a DROP
@@ -1063,6 +1100,8 @@ static void rw_gen_update(void)
 	  "if curl --proto-redir =https --version >/dev/null 2>&1; then\n"
 	  "  CURL=\"$CURL --proto =https --proto-redir =https\"\n"
 	  "  CURLC=\"$CURLC --proto =https --proto-redir =https\"\n"
+	  /* 2026-10-19: the geo fetch was the one curl left unpinned */
+	  "  CURLG=\"$CURLG --proto =https --proto-redir =https\"\n"
 	  "else\n"
 	  "  logger -t rwarden \"curl has no --proto-redir; feed fetches are not redirect-pinned\"\n"
 	  "fi\n"
@@ -1191,14 +1230,26 @@ static void rw_gen_update(void)
 	save = NULL;
 	list = strdup(nvram_safe_get("rwarden_geo"));
 	if (list) {
+		/* every set this run is responsible for, for the closing "NOT blocked"
+		 * summary (89 countries x "rw_g6_xx " fits with room to spare) */
+		char geosets[2048];
+		geosets[0] = 0;
 		for (tok = strtok_r(list, " ,<>", &save); tok; tok = strtok_r(NULL, " ,<>", &save)) {
 			char cc[3];
 			if (!rw_valid_cc(tok)) continue;
 			cc[0] = tolower((int)tok[0]); cc[1] = tolower((int)tok[1]); cc[2] = 0;
+			if (strlen(geosets) + 20 < sizeof(geosets)) {
+				strlcat(geosets, " rw_g_", sizeof(geosets));
+				strlcat(geosets, cc, sizeof(geosets));
+				if (!rw_geo_no_v6(cc)) {
+					strlcat(geosets, " rw_g6_", sizeof(geosets));
+					strlcat(geosets, cc, sizeof(geosets));
+				}
+			}
 			/* IPv4 (batch ipset restore, per-entry fallback - see threat sets) */
 			fprintf(f,
 			  "ipset create rw_g_%s hash:net maxelem " RW_GEO_MAXELEM_S " -exist\n"
-			  "if geo_budget_left && $CURLG \"https://www.ipdeny.com/ipblocks/data/aggregated/%s-aggregated.zone\" -o $TMP 2>/dev/null && [ -s $TMP ]; then\n"
+			  "if geo_get \"https://www.ipdeny.com/ipblocks/data/aggregated/%s-aggregated.zone\"; then\n"
 			  "  ipset create rw_g_%s_t hash:net maxelem " RW_GEO_MAXELEM_S " -exist; ipset flush rw_g_%s_t\n"
 			  "  grep -oE '([0-9]{1,3}\\.){3}[0-9]{1,3}(/[0-9]{1,2})?' $TMP | rw_f4 | sed 's/^/add rw_g_%s_t /' > $TMP.rst\n"
 			  "  if ! ipset restore -! < $TMP.rst 2>/dev/null; then\n"
@@ -1208,8 +1259,8 @@ static void rw_gen_update(void)
 			  "  fi\n"
 			  "  ipset swap rw_g_%s_t rw_g_%s; ipset destroy rw_g_%s_t\n"
 			  "  OK=1\n"
-				  "else logger -t rwarden \"geo v4 fetch FAILED for %s - keeping last-good\"; fi\n",
-			  cc, cc, cc, cc, cc, cc, cc, cc, cc, cc, cc, cc);
+				  "else geo_fail v4 %s rw_g_%s; fi\n",
+			  cc, cc, cc, cc, cc, cc, cc, cc, cc, cc, cc, cc, cc);
 			/* IPv6 (same batch + fallback shape). reaper v2.6.1: a few
 			 * countries have NO v6 zone upstream (ipdeny 404s for kp), which
 			 * logged "geo v6 fetch FAILED ... keeping last-good" on every
@@ -1223,7 +1274,7 @@ static void rw_gen_update(void)
 			}
 			fprintf(f,
 			  "ipset create rw_g6_%s hash:net family inet6 maxelem " RW_GEO_MAXELEM_S " -exist\n"
-			  "if geo_budget_left && $CURLG \"https://www.ipdeny.com/ipv6/ipaddresses/aggregated/%s-aggregated.zone\" -o $TMP 2>/dev/null && [ -s $TMP ]; then\n"
+			  "if geo_get \"https://www.ipdeny.com/ipv6/ipaddresses/aggregated/%s-aggregated.zone\"; then\n"
 			  "  ipset create rw_g6_%s_t hash:net family inet6 maxelem " RW_GEO_MAXELEM_S " -exist; ipset flush rw_g6_%s_t\n"
 			  "  grep -oiE '([0-9a-f]{0,4}:){2,7}[0-9a-f]{0,4}(/[0-9]{1,3})?' $TMP | rw_f6 | sed 's/^/add rw_g6_%s_t /' > $TMP.rst\n"
 			  "  if ! ipset restore -! < $TMP.rst 2>/dev/null; then\n"
@@ -1233,11 +1284,93 @@ static void rw_gen_update(void)
 			  "  fi\n"
 			  "  ipset swap rw_g6_%s_t rw_g6_%s; ipset destroy rw_g6_%s_t\n"
 			  "  OK=1\n"
-				  "else logger -t rwarden \"geo v6 fetch FAILED for %s - keeping last-good\"; fi\n",
-			  cc, cc, cc, cc, cc, cc, cc, cc, cc, cc, cc, cc);
+				  "else geo_fail v6 %s rw_g6_%s; fi\n",
+			  cc, cc, cc, cc, cc, cc, cc, cc, cc, cc, cc, cc, cc);
 		}
 		free(list);
+		/* One closing line per run that a user can act on. The per-fetch lines
+		 * scroll past in a burst of ~150; this one names every selected country
+		 * that is enforcing nothing, whatever the cause. */
+		fprintf(f,
+		  "[ \"$GEO_SKIP\" -gt 0 ] && logger -t rwarden \"geo: update time budget (" RW_GEO_BUDGET_S " s) ran out - $GEO_SKIP list fetch(es) not attempted\"\n"
+		  "GEO_EMPTY=''\n"
+		  "for s in%s; do\n"
+		  "  NE=$(ipset -t list $s 2>/dev/null | sed -n 's/.*Number of entries: //p')\n"
+		  "  [ \"${NE:-0}\" -gt 0 ] && continue\n"
+		  "  case $s in rw_g6_*) GEO_EMPTY=\"$GEO_EMPTY ${s#rw_g6_}(v6)\";; *) GEO_EMPTY=\"$GEO_EMPTY ${s#rw_g_}\";; esac\n"
+		  "done\n"
+		  "[ -n \"$GEO_EMPTY\" ] && logger -t rwarden \"geo: selected but NO data loaded, NOT blocked:$GEO_EMPTY\"\n",
+		  geosets);
+		/* The failure this was written for: with the router-traffic filter on,
+		 * a blocked country that hosts the list server stops every download. */
+		if (nvram_match("rwarden_self", "1"))
+			fprintf(f,
+			  "[ $((GEO_FAIL+GEO_SKIP)) -gt 0 ] && logger -t rwarden \"geo: router-traffic filter is ON - the list host www.ipdeny.com (" RW_GEO_HOST_IP ") must stay whitelisted, or the router blocks its own list downloads (see REAPER-WARDEN-SELF drops)\"\n");
 	}
+	/* 2026-10-19 threat domains. URLhaus and ThreatFox publish hostfiles
+	 * (`127.0.0.1<TAB>host` lines, `#` comments, on abuse.ch's keyless legacy
+	 * path); the usable names become `address=/host/` lines - dnsmasq answers
+	 * NXDOMAIN for the host and its subdomains, the man page's own blocklist
+	 * idiom - in ONE file every dnsmasq instance includes (conf-file=, see
+	 * reaper_warden_dns_conf). address= lines are read at start only, so a
+	 * CHANGED list restarts dnsmasq once at the end of this run; an unchanged
+	 * one does nothing. Keep-last-good on a failed fetch, the /jffs copy
+	 * rewritten only when the list changed. Never blocked: the feed and list
+	 * hosts (or the next update could not run), this router's own names, the
+	 * local zones, and the operator's /jffs/rwarden/dnsallow - each with its
+	 * subdomains. One fputs so the lean test can lift the block whole. */
+	fputs(
+	  "# ---- threat domains (2026-10-19): URLhaus / ThreatFox hostfiles -> dnsmasq\n"
+	  "# address=/host/ lines (NXDOMAIN for the host and its subdomains), read by every\n"
+	  "# dnsmasq instance through conf-file= and restarted only when the list changed.\n"
+	  "RW_DNS_CAP=100000\n"
+	  "RW_DNSC=" RW_DNS_CONF "\n"
+	  "RW_DNSK=" RW_DNS_CACHE "\n"
+	  "RW_DNSU=" RW_DNS_UPD "\n"
+	  "RW_DNSA=" RW_CACHE "/dnsallow\n"
+	  "DNS_CHANGED=0\n"
+	  "rw_dom() { tr -d '\\r' | awk '($1==\"127.0.0.1\"||$1==\"0.0.0.0\") && NF>=2 {print tolower($2)}' | grep -E '^[a-z0-9]([a-z0-9-]{0,62}\\.)+[a-z][a-z0-9-]{0,62}$'; }\n"
+	  "# never-block: the feed and list hosts, this router's own names, the local zones\n"
+	  "# and the operator's exemptions (the dnsallow list) - each covers its subdomains\n"
+	  "rw_dexempt() {\n"
+	  "  { printf '%s\\n' abuse.ch ipdeny.com pool.ntp.org asuscomm.com asus.com github.com githubusercontent.com spamhaus.org local arpa lan\n"
+	  "    for k in lan_domain ddns_hostname_x ntp_server0 ntp_server1; do _nv $k; done\n"
+	  "    _nv dnspriv_rulelist | tr '<' '\\n' | cut -d'>' -f3\n"
+	  "    tr ' ,<>' '\\n' < $RW_DNSA 2>/dev/null\n"
+	  "  } | tr 'A-Z' 'a-z' | grep -E '^[a-z0-9]([a-z0-9-]{0,62}\\.)*[a-z][a-z0-9-]{0,62}$' | sort -u > $TMP.ex\n"
+	  "  awk 'FILENAME==ARGV[1] { x[$1]=1; next } { d=$1; if (d in x) next; n=split(d, p, \".\"); s=\"\"; for (i=n; i>1; i--) { s=(s==\"\" ? p[i] : p[i] \".\" s); if (s in x) next } print d }' $TMP.ex -\n"
+	  "}\n"
+	  "# one feed: fetch and parse into its own .last file, which a failed fetch keeps (so one\n"
+	  "# feed's outage never shrinks the list to the other feed); prints the names it contributed\n"
+	  "rw_dfeed() {\n"
+	  "  case \"$DF\" in *\" $1 \"*) ;; *) rm -f $RW_DNSC.$1.last; echo 0; return 0;; esac\n"
+	  "  if $CURL --max-filesize 4194304 \"$2\" -o $TMP 2>/dev/null; then rw_dom < $TMP > $RW_DNSC.$1.last\n"
+	  "  else logger -t rwarden \"threat domains: $1 fetch FAILED - keeping the previous download\"; fi\n"
+	  "  [ -s $RW_DNSC.$1.last ] && cat $RW_DNSC.$1.last >> $DN\n"
+	  "  if [ -f $RW_DNSC.$1.last ]; then wc -l < $RW_DNSC.$1.last | tr -d ' '; else echo 0; fi\n"
+	  "}\n"
+	  "if [ \"$(_nv rwarden_dns)\" = 1 ]; then\n"
+	  "  DF=\" $(_nv rwarden_dns_feeds) \"; DN=$TMP.dn; : > $DN\n"
+	  "  DU=$(rw_dfeed urlhaus 'https://urlhaus.abuse.ch/downloads/hostfile/')\n"
+	  "  DT=$(rw_dfeed threatfox 'https://threatfox.abuse.ch/downloads/hostfile/')\n"
+	  "  if [ $((DU+DT)) -gt 0 ]; then\n"
+	  "    sort -u $DN > $DN.u; DA=$(wc -l < $DN.u | tr -d ' ')\n"
+	  "    rw_dexempt < $DN.u | head -n $RW_DNS_CAP > $DN.f; DL=$(wc -l < $DN.f | tr -d ' ')\n"
+	  "    if [ \"$DL\" -gt 0 ]; then\n"
+	  "      { echo \"# generated by Warden threat domains - do not edit; NXDOMAIN for each host and its subdomains\"; sed 's|^|address=/|; s|$|/|' $DN.f; } > $RW_DNSC.new\n"
+	  "      if cmp -s $RW_DNSC.new $RW_DNSC 2>/dev/null; then rm -f $RW_DNSC.new\n"
+	  "      elif mv -f $RW_DNSC.new $RW_DNSC; then\n"
+	  "        mkdir -p \"${RW_DNSK%/*}\"; cp -f $RW_DNSC $RW_DNSK.tmp && mv -f $RW_DNSK.tmp $RW_DNSK\n"
+	  "        DNS_CHANGED=1\n"
+	  "      fi\n"
+	  "      date +%s > $RW_DNSU\n"
+	  "      logger -t rwarden \"threat domains: $DL loaded (URLhaus $DU, ThreatFox $DT), $((DA-DL)) exempted or over the cap$([ \"$DNS_CHANGED\" = 1 ] && echo ', list changed - dnsmasq restarts')\"\n"
+	  "    else logger -t rwarden \"threat domains: the feeds produced no usable entries - keeping last-good\"; fi\n"
+	  "  else logger -t rwarden \"threat domains: nothing fetched and no previous download - keeping last-good\"; fi\n"
+	  "  rm -f $DN $DN.u $DN.f $TMP.ex\n"
+	  "elif [ -f $RW_DNSC ]; then\n"
+	  "  rm -f $RW_DNSC $RW_DNSC.*.last; DNS_CHANGED=1\n"
+	  "fi\n", f);
 	/* persist every warden set to jffs. NOTE (2026-07-29 audit): `ipset save`
 	 * accepts AT MOST ONE setname; handed several it prints "Unknown argument"
 	 * to stderr, writes NOTHING, and still EXITS 0 - so the old one-liner
@@ -1273,6 +1406,11 @@ static void rw_gen_update(void)
 	 * flush the flow cache so existing flows to a now-blocked peer re-traverse
 	 * the REAPER_WARDEN chain and get dropped (A3-NET-001). No-op if accel off. */
 	fprintf(f, "fc flush 2>/dev/null\n");
+	/* 2026-10-19: the threat-domain list is read by dnsmasq at start only
+	 * (address= lines never reload on SIGHUP), so a CHANGED list restarts it -
+	 * once, here, at the end of the run, never from a UI tick. The explicit
+	 * exit 0 keeps the && from leaking a status (build-sop's wrapper trap). */
+	fprintf(f, "[ \"$DNS_CHANGED\" = 1 ] && service restart_dnsmasq >/dev/null 2>&1\nexit 0\n");
 	fclose(f);
 	/* Atomic publish, same as rw_gen_apply. These are rewritten on every
 	 * Save & Apply while cron and httpd may be EXECUTING them: fold.sh runs
@@ -1504,6 +1642,12 @@ static void rw_gen_stats(void)
 	  "GE=$(echo \"$SETS\" | awk '$1 ~ /^rw_g6?_[a-z][a-z]$/ {s+=$2} END{print s+0}')\n"
 	  "GZ=$(echo \"$SETS\" | awk '$1 ~ /^rw_g_[a-z][a-z]$/ && $2==0 {z++} END{print z+0}')\n"
 	  "SV=1; [ \"$(_nv rwarden_stats_save)\" = 0 ] && SV=0\n"
+	  /* 2026-10-19 threat domains: switch, names in the list, the last build
+	   * stamp, and whether the running dnsmasq was started with the include */
+	  "DNE=$(_nv rwarden_dns); [ \"$DNE\" = 1 ] || DNE=0\n"
