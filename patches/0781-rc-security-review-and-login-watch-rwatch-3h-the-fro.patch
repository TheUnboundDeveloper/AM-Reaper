+/* 2026-10-19: security review (rc/rwatch.c section 3h). Every watchdog tick
+ * inventories /jffs/scripts, /jffs/configs, the SSH authorized keys, add-on
+ * files, cron entries and the WAN-exposure settings and diffs them against
+ * the baseline the operator accepted; this CGI serves that report to the
+ * Firewall page and the dashboard bar, records an acceptance, and flips the
+ * switch. Advisory end to end: nothing here undoes a change. The baseline
+ * goes through rjf_set() (every parent 0700, file 0600, tmp+fsync+rename)
+ * because /jffs/reaper may well have been created world-writable by the
+ * watchdog's own `mkdir -p` from cron. */
+#define RVIEW_SH      "/tmp/reaper/rwatch.sh"
+#define RVIEW_JSON    "/tmp/reaper/review.json"
+#define RVIEW_INV     "/tmp/reaper/review.inv"
+#define RVIEW_LAST    "/tmp/reaper/review.last"
+#define RVIEW_AUTH    "/tmp/reaper/review.auth"
+#define RVIEW_BASE    "/jffs/reaper/review/baseline"
+#define RVIEW_INV_MAX (200 * 1024)
+
+/* a detached `sh rwatch.sh review` so the card refreshes at once after a
+ * toggle or an acceptance: the witness worker's double-fork shape, never on
+ * the request path (an in-httpd walk once stalled every admin page). The
+ * script runs only when it is root's own unwritable-by-others regular file. */
+static void rview_kick(void)
+{
+	pid_t pid;
+
+	if (!reaper_script_ok(RVIEW_SH))
+		return;
+	pid = fork();
+	if (pid == 0) {
+		if (fork() == 0) {
+			char *argv[] = { "sh", RVIEW_SH, "review", NULL };
+			int fd;
+			setsid();
+			for (fd = 0; fd < 64; fd++)
+				close(fd);
+			fd = open("/dev/null", O_RDWR);
+			if (fd == 0) {
+				dup2(0, 1);
+				dup2(0, 2);
+			}
+			_eval(argv, NULL, 30, NULL);
+			_exit(0);
+		}
+		_exit(0);
+	}
+	if (pid > 0)
+		waitpid(pid, NULL, 0);
+}
+
+static void
+do_reaper_watch_cgi(char *url, FILE *stream)
+{
+	char *action = get_cgi("action");
+	int why = reaper_gate();
+
+	if (why != RGATE_OK) {
+		reaper_gate_deny(stream, why, "RWCH");
+		return;
+	}
+	if (!action) action = "status";
+
+	if (!strcmp(action, "status")) {
+		FILE *rf = NULL;
+		char rb[4096];
+		size_t rn;
+		int en = nvram_match("rwatch_review", "1");
+		int rw = nvram_match("rwatch_enable", "1");
+		if (en)
+			rf = fopen(RVIEW_JSON, "r");
+		if (!rf) {
+			/* No report (a boot, or the seconds after the switch went on): say
+			 * whether a baseline is on disk, so the pages show "accepted, first
+			 * check pending" rather than "no baseline". The first tick after a
+			 * boot waits out the 5-minute grace and then the next five-minute
+			 * slot - up to 10 minutes. Same test as rwatch's `-s` and `! -L`. */
+			struct stat bs;
+			int armed = en && lstat(RVIEW_BASE, &bs) == 0 && S_ISREG(bs.st_mode) && bs.st_size > 0;
+			websWrite(stream, "{\"ok\":0,\"enabled\":%d,\"rwatch\":%d,\"armed\":%d,\"error\":\"no report yet\"}", en, rw, armed);
+			return;
+		}
+		while ((rn = fread(rb, 1, sizeof(rb), rf)) > 0)
+			fwrite(rb, 1, rn, stream);
+		fclose(rf);
+		return;
+	}
+
+	if (!strcmp(action, "set")) {
+		char *en = get_cgi("enable");
+		int on = (en && *en == '1');
+		nvram_set("rwatch_review", on ? "1" : "0");
+		nvram_commit();
+		reaper_audit("review", on ? "on" : "off", "");
+		if (on) {
+			rview_kick();
+		} else {
+			unlink(RVIEW_JSON);
+			unlink(RVIEW_LAST);
+			unlink(RVIEW_AUTH);
+		}
+		websWrite(stream, "{\"ok\":1,\"enabled\":%d}", on);
+		return;
+	}
+
+	if (!strcmp(action, "ack")) {
+		struct stat st;
+		char *body;
+		int fd;
+		size_t got = 0;
+		ssize_t r;
+		if (!nvram_match("rwatch_review", "1")) {
+			websWrite(stream, "{\"ok\":0,\"ek\":\"RFW_355\"}");
+			return;
+		}
+		if (!nvram_match("rwatch_enable", "1") || !reaper_script_ok(RVIEW_SH)) {
+			websWrite(stream, "{\"ok\":0,\"ek\":\"RFW_338\"}");
+			return;
+		}
+		fd = open(RVIEW_INV, O_RDONLY | O_NOFOLLOW);
+		if (fd < 0 || fstat(fd, &st) != 0 || !S_ISREG(st.st_mode) ||
+		    st.st_size <= 0 || st.st_size > RVIEW_INV_MAX) {
+			if (fd >= 0) close(fd);
+			websWrite(stream, "{\"ok\":0,\"ek\":\"RFW_356\"}");
+			return;
+		}
+		if ((body = malloc(st.st_size + 1)) == NULL) {
+			close(fd);
+			websWrite(stream, "{\"ok\":0,\"ek\":\"RFW_357\"}");
+			return;
+		}
+		while (got < (size_t)st.st_size && (r = read(fd, body + got, st.st_size - got)) > 0)
+			got += r;
+		close(fd);
+		if (got != (size_t)st.st_size) {
+			free(body);
+			websWrite(stream, "{\"ok\":0,\"ek\":\"RFW_356\"}");
+			return;
+		}
+		body[got] = '\0';
+		if (rjf_set(RVIEW_BASE, body, "review") != 0) {
+			free(body);
+			websWrite(stream, "{\"ok\":0,\"ek\":\"RFW_357\"}");
+			return;
+		}
+		free(body);
+		unlink(RVIEW_LAST);
+		unlink(RVIEW_AUTH);
+		reaper_audit("review", "baseline", "accepted");
+		rview_kick();
+		websWrite(stream, "{\"ok\":1,\"running\":1}");
+		return;
+	}
+
+	websWrite(stream, "{\"ok\":0,\"error\":\"unknown action\"}");
+}
