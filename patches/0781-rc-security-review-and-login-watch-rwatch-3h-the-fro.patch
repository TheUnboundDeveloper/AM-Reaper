 /* v3.3.1: record the node a device hangs off. Only a well-formed MAC is kept,
@@ -28021,10 +28194,75 @@ static int rdev_sdn_of_bridge(const char *br, MTLAN_T *pmtl, size_t sz)
  * carries; on a wlN[.M] port it is wireless on that radio's band and that VIF.
  * Being in the table means it is actively bridging => online. Only reclassifies
  * devices already in the table. */
+/* 2026-10-19 (field: an iPhone on the RT-AX92U node read "Wired", and stayed
+ * "connected" in Airplane mode). An FDB entry lives for the bridge ageing time
+ * (300 s) after the device's last frame, so on any port where something better
+ * exists - the radio's assoclist on a wl port, the node's client lists on a
+ * backhaul port - an entry older than this is a device that has LEFT, not one
+ * that is idle. Ethernet ports keep the full ageing time: nothing better
+ * exists there, and a quiet printer is still plugged in. */
+#define RDEV_FDB_FRESH 90	/* s */
+
+/* Every MAC an AiMesh node answers to on our bridge - its LAN MAC and its
+ * backhaul stations - with the LAN MAC that names the node. A bridge port that
+ * carries one of them is that node's backhaul. Refilled once per collect. */
+static struct { char mac[18]; char lan[18]; } rdev_nm[96];
+static int rdev_nm_n = 0;
+#ifdef RTCONFIG_CFGSYNC
+static void rdev_nm_add(const unsigned char *m, const char *lan)
+{
+	if (rdev_nm_n >= (int)(sizeof(rdev_nm) / sizeof(rdev_nm[0]))) return;
+	if (!(m[0] | m[1] | m[2] | m[3] | m[4] | m[5])) return;
+	snprintf(rdev_nm[rdev_nm_n].mac, sizeof(rdev_nm[0].mac), "%02X:%02X:%02X:%02X:%02X:%02X",
+	         m[0], m[1], m[2], m[3], m[4], m[5]);
+	snprintf(rdev_nm[rdev_nm_n].lan, sizeof(rdev_nm[0].lan), "%s", lan);
+	rdev_nm_n++;
+}
+
+static void rdev_nm_load(void)
+{
+	int shm_id, i;
+	P_CM_CLIENT_TABLE tbl;
+	void *shm;
+
+	rdev_nm_n = 0;
+	shm_id = shmget((key_t)KEY_SHM_CFG, sizeof(CM_CLIENT_TABLE), 0666|IPC_CREAT);
+	if (shm_id == -1) return;
+	shm = shmat(shm_id, (void *)0, 0);
+	if (shm == (void *)-1) return;
+	tbl = (P_CM_CLIENT_TABLE)shm;
+	for (i = 1; i < tbl->count && i < CFG_CLIENT_NUM; i++) {	/* index 0 = this router */
+		const unsigned char *r = tbl->realMacAddr[i];
+		char lan[18];
+		if (!(r[0] | r[1] | r[2] | r[3] | r[4] | r[5])) continue;
+		snprintf(lan, sizeof(lan), "%02X:%02X:%02X:%02X:%02X:%02X", r[0], r[1], r[2], r[3], r[4], r[5]);
+		rdev_nm_add(r, lan);
+		rdev_nm_add(tbl->sta2g[i], lan);
+		rdev_nm_add(tbl->sta5g[i], lan);
+		rdev_nm_add(tbl->sta6g[i], lan);
+	}
+	shmdt(shm);
+}
+#else
+static void rdev_nm_load(void) { rdev_nm_n = 0; }
+#endif
+
+/* the node LAN MAC a bridge-table MAC belongs to, or NULL */
+static const char *rdev_nm_owner(const char *mac)
+{
+	int i;
+	for (i = 0; i < rdev_nm_n; i++)
+		if (!strcasecmp(rdev_nm[i].mac, mac)) return rdev_nm[i].lan;
+	return NULL;
+}
