+}
+
+/* The health check's probe: <name> A IN straight to target:53 (never through
+ * dnsmasq). 1 = a reply with our id came back (strict: NOERROR + >=1 record),
+ * 0 = silence, an error, or a reply that does not qualify. */
+static int probe_addr(const struct hc_cfg *c, const char *addr, int af)
+{
+	int an = 0, rc = dns_ask(addr, af, 53, c->name, c->timeout_ms, &an);
+	if (rc < 0) return 0;
+	if (!c->strict) return 1;
+	return (rc == 0 && an > 0);
 }
 
 /* Does this line name the target as a plain upstream? For the servers-file
@@ -414,6 +427,260 @@ static void state_set(const char *what, long since, int alive)
 	nvram_set("reaper_dnshc_state", st);
 }
 
+/* ======================================================================
+ * 2026-10-10: LAN name resolution check (BACKLOG "The dashboard says
+ * Connected while LAN clients have no name resolution").
+ *
+ * The dashboard's Internet status only says the WAN holds an address. LAN
+ * devices resolve through dnsmasq on lan_ipaddr:53 (or through the servers
+ * DHCP hands out, when dhcp_dns1_x/dhcp_dns2_x are set), and that path can be
+ * dead while the WAN is fine: dnsmasq not running, or every upstream silent
+ * for names it has not cached (RT-BE86U 2026-10-04: unbound up, its
+ * WireGuard upstream down). Once a minute, while the WAN is up, this asks the
+ * router's DNS for "localhost" (answered from /etc/hosts, nothing leaves the
+ * box) and for a random name under reaper_landns_domain (or dns_probe_host);
+ * the random label is what gets past dnsmasq's and unbound's caches. When the
+ * fresh name fails it asks up to four upstreams directly, to name the silent
+ * ones. Two bad checks in a row turn the state bad, one good one clears it.
+ *
+ * Status only: nothing is moved, nothing is reloaded, link_internet (WAN LEDs,
+ * Dual WAN fail-over) is never touched. Published as nvram
+ * reaper_landns_state "<state> <seconds in state> <silent servers|->";
+ * Main_ReaperDash.asp paints the Internet status amber and explains it in a
+ * tooltip. Independent of the health check's switch; reaper_landns_enable=0
+ * (DNS Failover page) turns it off. Syslog: one line when it turns bad, one
+ * when it recovers - nothing per check.
+ * ====================================================================== */
+#define LDNS_EVERY	60	/* s between checks */
+#define LDNS_FIRST	15	/* s after start (or a switch-on) before the first */
+#define LDNS_LOCAL_MS	1500	/* the router's own name: any reply = dnsmasq is listening */
+#define LDNS_FRESH_MS	2000	/* a fresh name through the path LAN devices use */
+#define LDNS_UP_MS	1500	/* each upstream, asked directly */
+#define LDNS_UP_MAX	4
+
+/* LANDNS-PURE-BEGIN (host-tested by test_landns_check.py; no firmware calls in here) */
+#define LDNS_UNK	0	/* not judged yet */
+#define LDNS_OK		1
+#define LDNS_FAIL	2	/* the router's DNS answers, but no upstream resolves a new name */
+#define LDNS_SVC	3	/* the router's DNS does not answer at all */
+#define LDNS_DFAIL	4	/* the DNS servers DHCP hands out do not resolve a new name */
+#define LDNS_HELD	5	/* the WAN is down: not judged (the status is red already) */
+#define LDNS_OFF	6	/* switched off */
+#define LDNS_BAD_AFTER	2	/* consecutive bad checks before the state turns bad */
+
+/* A reply that proves the path resolves: NOERROR, or NXDOMAIN (a random name
+ * normally does not exist). SERVFAIL, REFUSED, anything else, or silence (-1)
+ * does not. */
+static int landns_rcode_ok(int rcode)
+{
+	return rcode == 0 || rcode == 3;
+}
+
+static int landns_is_bad(int st)
+{
+	return st == LDNS_FAIL || st == LDNS_SVC || st == LDNS_DFAIL;
+}
+
+/* One check's result r (LDNS_OK / _FAIL / _SVC / _DFAIL, or LDNS_HELD) ->
+ * the published state. *bad counts consecutive bad checks. A good check clears
+ * at once; a bad one needs LDNS_BAD_AFTER in a row; until then a judged state
+ * stands and an unjudged one stays unknown. */
+static int landns_step(int cur, int r, int *bad)
+{
+	if (r == LDNS_HELD) { *bad = 0; return LDNS_HELD; }
+	if (r == LDNS_OK) { *bad = 0; return LDNS_OK; }
+	if (*bad < 100) (*bad)++;
+	if (*bad >= LDNS_BAD_AFTER) return r;
+	return (cur == LDNS_HELD || cur == LDNS_OFF) ? LDNS_UNK : cur;
+}
+
+/* A domain the random label can go under: letters, digits and hyphens in
+ * dot-separated labels of 1-63, at least two labels, 3-100 characters. */
+static int landns_domain_ok(const char *d)
+{
+	int len = 0, lab = 0, dots = 0;
+	if (!d) return 0;
+	for (; d[len]; len++) {
+		char ch = d[len];
+		if (ch == '.') {
+			if (lab == 0) return 0;
+			lab = 0; dots++;
+		} else if ((ch >= 'a' && ch <= 'z') || (ch >= 'A' && ch <= 'Z') || (ch >= '0' && ch <= '9') || ch == '-') {
+			if (++lab > 63) return 0;
+		} else
+			return 0;
+	}
+	return len >= 3 && len <= 100 && lab > 0 && dots > 0;
+}
+/* LANDNS-PURE-END */
+
+static const char *landns_name(int st)
+{
+	static const char *n[] = { "unk", "ok", "fail", "svc", "dfail", "wan", "off" };
+	return (st >= 0 && st <= LDNS_OFF) ? n[st] : "unk";
+}
+
+struct landns {
+	int st, bad;
+	long since, next;
+	char silent[96];		/* "a,b#53535" - the servers that did not answer, for the tooltip */
+};
+
+static void landns_publish(const struct landns *ld, long t)
+{
+	char v[128];
+	snprintf(v, sizeof(v), "%s %ld %s", landns_name(ld->st), t - ld->since, *ld->silent ? ld->silent : "-");
+	nvram_set("reaper_landns_state", v);
+}
+
+/* The same test the health check's HOLD uses, on the PRIMARY unit (Dual WAN). */
+static int landns_uplink_down(void)
+{
+	char k[24];
+	const char *s;
+	if (nvram_match("link_wan", "0")) return 1;
+	snprintf(k, sizeof(k), "wan%d_state_t", wan_primary_ifunit());
+	s = nvram_safe_get(k);
+	return *s && atoi(s) != 2;
+}
+
+static void landns_append(char *out, size_t len, const char *what)
+{
+	size_t used = strlen(out);
+	if (used + strlen(what) + 2 > len) return;	/* full: the first ones are the useful ones */
+	if (used) strlcat(out, ",", len);
+	strlcat(out, what, len);
+}
+
+/* The servers LAN devices are handed by DHCP, when the admin set any;
+ * 0 = devices are given the router. */
+static int landns_dhcp_targets(char t[2][INET_ADDRSTRLEN])
+{
+	static const char *keys[2] = { "dhcp_dns1_x", "dhcp_dns2_x" };
+	struct in_addr a;
+	const char *p;
+	int i, n = 0;
+	if (!nvram_match("dhcp_enable_x", "1")) return 0;
+	for (i = 0; i < 2; i++) {
+		p = nvram_safe_get(keys[i]);
+		if (*p && inet_pton(AF_INET, p, &a) == 1 && a.s_addr)
+			strlcpy(t[n++], p, INET_ADDRSTRLEN);
+	}
+	return n;
+}
+
+/* Ask up to LDNS_UP_MAX plain upstreams of dnsmasq directly; list the ones
+ * that do not resolve qname. The file is read under the resolv lock (the
+ * health check rewrites it under the same lock), the probes run after. */
+static void landns_silent_upstreams(const char *qname, char *out, size_t len)
+{
+	char addr[LDNS_UP_MAX][INET6_ADDRSTRLEN], line[HC_LINE];
+	int port[LDNS_UP_MAX], fam[LDNS_UP_MAX], n = 0, i, lock;
+	unsigned char bin[16];
+	FILE *fp;
+
+	*out = 0;
+	lock = file_lock("resolv");
+	if ((fp = fopen(HC_DNSMASQ, "r")) != NULL) {
+		while (n < LDNS_UP_MAX && fgets(line, sizeof(line), fp)) {
+			const char *p = line + 7;	/* strlen("server=") */
+			size_t al;
+			if (!line_is_upstream(line, "server=")) continue;
+			al = strcspn(p, "#@% \t\r\n");
+			if (al == 0 || al >= INET6_ADDRSTRLEN) continue;
+			memcpy(addr[n], p, al);
+			addr[n][al] = 0;
+			port[n] = 53;
+			if (p[al] == '#') {
+				int pt = atoi(p + al + 1);
+				if (pt > 0 && pt < 65536) port[n] = pt;
+			}
+			if (inet_pton(AF_INET, addr[n], bin) == 1) fam[n] = AF_INET;
+			else if (inet_pton(AF_INET6, addr[n], bin) == 1 && hc_v6_usable()) fam[n] = AF_INET6;
+			else continue;
+			n++;
+		}
+		fclose(fp);
+	}
+	file_unlock(lock);
+	for (i = 0; i < n && !g_stop; i++) {
+		char nm[INET6_ADDRSTRLEN + 8];
+		if (landns_rcode_ok(dns_ask(addr[i], fam[i], port[i], qname, LDNS_UP_MS, NULL))) continue;
+		if (port[i] != 53) snprintf(nm, sizeof(nm), "%s#%d", addr[i], port[i]);
+		else strlcpy(nm, addr[i], sizeof(nm));
+		landns_append(out, len, nm);
+	}
+}
+
+/* Called once per loop pass; does nothing until a check is due. */
+static void landns_tick(struct landns *ld)
+{
+	char tg[2][INET_ADDRSTRLEN], q[128], lan[INET_ADDRSTRLEN] = "", silent[sizeof(ld->silent)] = "";
+	const char *d;
+	long t = now_s(), prev_since = ld->since;
+	int r, nt, i, prev = ld->st;
+	struct in_addr a;
+
+	if (nvram_match("reaper_landns_enable", "0")) {
+		if (ld->st != LDNS_OFF) {
+			ld->st = LDNS_OFF; ld->bad = 0; ld->since = t; *ld->silent = 0;
+			landns_publish(ld, t);
+		}
+		return;
+	}
+	if (ld->st == LDNS_OFF) {
+		ld->st = LDNS_UNK; ld->bad = 0; ld->since = t; ld->next = t + LDNS_FIRST; *ld->silent = 0;
+		landns_publish(ld, t);
+	}
+	if (t < ld->next) return;
+	ld->next = t + LDNS_EVERY;
+
+	if (landns_uplink_down())
+		r = LDNS_HELD;
+	else {
+		d = nvram_safe_get("reaper_landns_domain");
+		if (!landns_domain_ok(d)) d = nvram_safe_get("dns_probe_host");
+		if (!landns_domain_ok(d)) d = "dns.msftncsi.com";
+		snprintf(q, sizeof(q), "rq%08x.%s", (unsigned)rand(), d);
+		if ((nt = landns_dhcp_targets(tg)) > 0) {
+			r = LDNS_DFAIL;
+			for (i = 0; i < nt && r != LDNS_OK; i++)
+				if (landns_rcode_ok(dns_ask(tg[i], AF_INET, 53, q, LDNS_FRESH_MS, NULL))) r = LDNS_OK;
+			if (r != LDNS_OK)
+				for (i = 0; i < nt; i++) landns_append(silent, sizeof(silent), tg[i]);
+		} else {
+			strlcpy(lan, nvram_safe_get("lan_ipaddr"), sizeof(lan));
+			if (inet_pton(AF_INET, lan, &a) != 1) strlcpy(lan, "127.0.0.1", sizeof(lan));
+			if (dns_ask(lan, AF_INET, 53, "localhost", LDNS_LOCAL_MS, NULL) < 0)
+				r = LDNS_SVC;
+			else if (landns_rcode_ok(dns_ask(lan, AF_INET, 53, q, LDNS_FRESH_MS, NULL)))
+				r = LDNS_OK;
+			else {
+				r = LDNS_FAIL;
+				landns_silent_upstreams(q, silent, sizeof(silent));
+			}
+		}
+	}
+
+	ld->st = landns_step(ld->st, r, &ld->bad);
+	if (ld->st != prev) ld->since = t;
+	if (ld->st == r && landns_is_bad(r)) strlcpy(ld->silent, silent, sizeof(ld->silent));
+	else if (!landns_is_bad(ld->st)) *ld->silent = 0;
+
+	if (landns_is_bad(ld->st) && ld->st != prev) {
+		if (ld->st == LDNS_SVC)
+			logmessage(HC_TAG, "LAN name resolution FAILING: the router's DNS service is not answering on %s:53 (%d checks) - LAN devices cannot look up any name", lan, ld->bad);
+		else if (ld->st == LDNS_DFAIL)
+			logmessage(HC_TAG, "LAN name resolution FAILING: the DNS servers LAN devices are handed by DHCP (%s) do not resolve new names (%d checks)", ld->silent, ld->bad);
+		else if (*ld->silent)
+			logmessage(HC_TAG, "LAN name resolution FAILING: the router's DNS answers, but no upstream resolves new names (%d checks) - not answering: %s", ld->bad, ld->silent);
+		else
+			logmessage(HC_TAG, "LAN name resolution FAILING: the router's DNS answers, but does not resolve new names (%d checks) - every upstream answered when asked directly", ld->bad);
+	} else if (landns_is_bad(prev) && ld->st == LDNS_OK)
+		logmessage(HC_TAG, "LAN name resolution restored after %ld s", t - prev_since);
+	landns_publish(ld, t);
+}
+
 int rdnshc_main(int argc, char *argv[])
 {
 	struct hc_cfg c;
@@ -426,6 +693,7 @@ int rdnshc_main(int argc, char *argv[])
 	 * server's place. Index 0 = IPv4, 1 = IPv6; fseen = probed at least once. */
 	int fmiss[2] = { 0, 0 }, fhit[2] = { 0, 0 }, fdown[2] = { 0, 0 }, fseen[2] = { 0, 0 };
 	long since = 0;
+	struct landns ld = { LDNS_OFF, 0, 0, 0, "" };	/* 2026-10-10: the LAN name resolution check */
 	(void)argc; (void)argv;
 
 	signal(SIGTERM, on_sig);
@@ -486,6 +754,10 @@ int rdnshc_main(int argc, char *argv[])
 			hc_gate();
 		}
 
+		/* 2026-10-10: runs whether or not the health check is switched on; it
+		 * paces itself (LDNS_EVERY) and only reads, never moves anything */
+		landns_tick(&ld);
+
