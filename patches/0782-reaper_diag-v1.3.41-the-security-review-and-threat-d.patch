From f47c94ec970a6f63eefeab9254663a3a38159898 Mon Sep 17 00:00:00 2001
From: reaper <theunbounddeveloper@outlook.com>
Date: Mon, 19 Oct 2026 16:58:56 -0400
Subject: [PATCH] reaper_diag v1.3.41: the security review and threat-domain
 state

Section 12 reports the review switch, the baseline and the last report's
counts (never the items or the login sources), section 14 the threat-domain
list (names loaded, cache, last build, which dnsmasq instances include it),
section 17 the review files; a finding when something is switched on but not
in force.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 release/src/router/others/reaper_diag  | 34 ++++++++++++++++++++++++--
 release/src/router/www/Reaper_Diag.asp |  2 +-
 2 files changed, 33 insertions(+), 3 deletions(-)
 mode change 100755 => 100644 release/src/router/others/reaper_diag

diff --git a/release/src/router/others/reaper_diag b/release/src/router/others/reaper_diag
old mode 100755
new mode 100644
index ecebb7c515e..ac38484e53e
--- a/release/src/router/others/reaper_diag
+++ b/release/src/router/others/reaper_diag
@@ -1,6 +1,10 @@
 #!/bin/sh
 # ============================================================================
-#  REAPER-DIAG v1.3.40 (2026-10-16) - sanitized one-shot diagnostic bundle
+#  REAPER-DIAG v1.3.41 (2026-10-19) - sanitized one-shot diagnostic bundle
+#  v1.3.41 reports the security review (switch, baseline, unreviewed changes and
+#  login-notice COUNTS - never the sources) in 12 and 17, and the threat-domain
+#  list state (names loaded, cache, last build, which dnsmasq instances include
+#  it) in 14, each with a FINDING when something is on but not in force.
 #  Runs on ANY Reaper model (RT-BE96U / RT-BE86U / RT-BE88U / GT-BE98 /
 #  GT-BE98_PRO) - radios, ports and features are discovered at runtime.
 #
@@ -150,7 +154,7 @@
 #  are one-shot cats. Do not add an unbounded command here.
 # ============================================================================
 PATH=/sbin:/bin:/usr/sbin:/usr/bin
-VER="REAPER-DIAG v1.3.40"
+VER="REAPER-DIAG v1.3.41"
 T0="$(date +%s 2>/dev/null)"
 MODEL="$(nvram get productid 2>/dev/null)"
 EXTNO="$(nvram get extendno 2>/dev/null)"
@@ -1477,6 +1481,21 @@ _mr="$(pidof rmcpd 2>/dev/null | wc -w)"
 printf "  %-8s %-22s running=%s  session=%s (arm-gated: idle=0 is normal)\n" rmcpd "rmcp_port=$(nvram get rmcp_port 2>/dev/null)" "$_mr" "$_ms"
 [ "$_ms" = ARMED ] && [ "$_mr" = 0 ] && finding WARN "an Advisor session is armed (/tmp/reaper_mcp/session) but rmcpd is not running - the daemon exited uncleanly; re-arm from the Advisor page (see 12c)"
 echo "  rwatch            : rwatch_enable=$(nvram get rwatch_enable 2>/dev/null)  cron=$(cru l 2>/dev/null | grep -c '#rwatch#')"
+# v1.3.41: the security review (rwatch 3h) - the switch, the accepted baseline, and the
+# last report's COUNTS. Never the items or the login sources: the report on the box has
+# them, a bundle shared with a tester need not.
+_rv="$(nvram get rwatch_review 2>/dev/null)"; _rvb=none; _rvu=0; _rvn=0
+[ -s /jffs/reaper/review/baseline ] && _rvb="$(wc -l < /jffs/reaper/review/baseline | tr -d ' ') items, accepted $(ls -le /jffs/reaper/review/baseline 2>/dev/null | awk '{print $6,$7,$8,$9,$10}')"
+if [ -r /tmp/reaper/review.json ]; then
+  _rva=$(sed -n 's/.*"armed":\([0-9]*\),"ts":.*/\1/p' /tmp/reaper/review.json); _rvs=$(sed -n 's/.*"armed":[0-9]*,"ts":\([0-9]*\),.*/\1/p' /tmp/reaper/review.json)
+  _rvu=$(sed -n 's/.*"unreviewed":\([0-9]*\),.*/\1/p' /tmp/reaper/review.json); _rvt=$(sed -n 's/.*"total":\([0-9]*\),.*/\1/p' /tmp/reaper/review.json); _rvn=$(sed -n 's/.*"notices_n":\([0-9]*\)}.*/\1/p' /tmp/reaper/review.json)
+  _rvr="armed=${_rva:-?} items=${_rvt:-?} unreviewed=${_rvu:-0} login_notices=${_rvn:-0} checked=$(date -d @${_rvs:-0} '+%F %R' 2>/dev/null || echo ${_rvs:-?})"
+else _rvr="no report yet"; fi
+echo "  security review   : rwatch_review=${_rv:-unset}  baseline=$_rvb  report: $_rvr"
+case "$_rvu$_rvn" in *[!0-9]*) _rvu=0; _rvn=0;; esac
+[ "$_rv" = 1 ] && [ "$_rvb" = none ] && finding INFO "the security review is switched on but no baseline has been accepted - nothing is reported until Accept on the Firewall page, Status tab (see 12)"
+[ "$_rv" = 1 ] && [ "${_rvu:-0}" -gt 0 ] && finding WARN "security review: ${_rvu} unreviewed change(s) to /jffs scripts, configs, SSH keys, add-ons, cron or the exposure settings since the accepted baseline - the Firewall page, Status tab, lists them (see 12)"
+[ "$_rv" = 1 ] && [ "${_rvn:-0}" -gt 0 ] && finding WARN "security review: ${_rvn} failed-login burst(s) - 10 or more failed SSH or web logins from one source inside a 5 min check; the sources are on the Firewall page, Status tab (counts only here)"
 echo "  warden            : rwarden_enable=$(nvram get rwarden_enable 2>/dev/null)  cron=$(cru l 2>/dev/null | grep -cE '#rwarden')  chain=$(iptables -nL REAPER_WARDEN >/dev/null 2>&1 && echo present || echo absent)  chain6=$(ip6tables -nL REAPER_WARDEN >/dev/null 2>&1 && echo present || echo absent)"
 echo "  rules engine      : reaper_fw_enable=$(nvram get reaper_fw_enable 2>/dev/null) active=$(nvram get reaper_fw_active 2>/dev/null) armed=$(nvram get reaper_fw_armed 2>/dev/null)"
 echo "  policy routing    : reaper_pbr_enable=$(nvram get reaper_pbr_enable 2>/dev/null) active=$(nvram get reaper_pbr_active 2>/dev/null)"
@@ -1502,6 +1521,15 @@ echo "  amtm-ish mounts: $(mount 2>/dev/null | grep -c /tmp/mnt)"
 
 sec "14. FIREWALL / WARDEN (counters and set SIZES - contents never dumped)"
 nvram show 2>/dev/null | grep '^rwarden_' | sort | sed 's/^/  /'
+# v1.3.41: threat domains (rwarden_dns) - the list dnsmasq answers NXDOMAIN for: how many
+# names, the /jffs copy, when it was last built, and how many of the dnsmasq instances
+# (main + one per guest/VLAN network) were started with the include. Names never dumped.
+_td="$(nvram get rwarden_dns 2>/dev/null)"; _tdn=$(grep -c '^address=' /tmp/rwarden/dns.conf 2>/dev/null); _tdu=$(cat /tmp/rwarden/dns.upd 2>/dev/null)
+case "$_tdn" in ''|*[!0-9]*) _tdn=0;; esac
+_tdc=$(ls /etc/dnsmasq.conf /etc/dnsmasq-*.conf 2>/dev/null | wc -l | tr -d ' '); _tdi=$(grep -l '^conf-file=/tmp/rwarden/dns.conf' /etc/dnsmasq.conf /etc/dnsmasq-*.conf 2>/dev/null | wc -l | tr -d ' ')
+echo "  threat domains    : rwarden_dns=${_td:-unset}  names=$_tdn  cache=$( [ -s /jffs/rwarden/dns.cache ] && echo present || echo none )  built=$( [ -n "$_tdu" ] && date -d @$_tdu '+%F %R' 2>/dev/null || echo never )  included_in=${_tdi:-0}/${_tdc:-0} dnsmasq conf(s)"
+[ "$_td" = 1 ] && [ "$(nvram get rwarden_enable 2>/dev/null)" = 1 ] && [ "$_tdn" = 0 ] && finding WARN "threat domains are switched on but no list is loaded - the feeds have not been fetched yet, or every fetch failed (see 14 and the rwarden lines in the log)"
+[ "$_td" = 1 ] && [ "$_tdn" -gt 0 ] && [ "${_tdi:-0}" -lt "${_tdc:-0}" ] && finding WARN "threat domains: the list is built but $((_tdc-_tdi)) dnsmasq instance(s) run without it - a dnsmasq restart loads it (Warden page: Save, or the nightly update)"
 echo "  -- chain packet/byte counters --"
 # The counters are the whole point: a climbing RW_ODROP during a reported
 # outage says Warden dropped it, and a flat one says look upstream. Before
@@ -1881,6 +1909,8 @@ if [ "$RS_BASE" = /tmp/reaper ] && grep -q ' /tmp/mnt/' /proc/mounts 2>/dev/null
   finding WARN "Reaper's durable store is RAM although a USB disk is mounted - log history is lost at every reboot; set the store to USB - see 17"
 fi
 echo "  datastore opt-ins : $(nvram get reaper_store_ds 2>/dev/null)"
+# v1.3.41: the security review's files (sizes only; the report's counts are in 12)
+echo "  security review   : $(ls -l /jffs/reaper/review/baseline /tmp/reaper/review.json /tmp/reaper/review.auth /tmp/reaper/auth.cur 2>/dev/null | awk '{n=$NF; sub(/.*\//,"",n); printf "%s=%sB ", n, $5} END{if(!NR) print "no files"}')"
 # v1.3.7: the one-shot PPPoE stale-session bounce (rwatch_gen, v1.9.2) is armed
 # by DEFAULT - its test is `!= 0`, so an UNSET key counts as enabled - and it
 # fires at most once per boot behind a tmpfs latch. The nvram grep above only
diff --git a/release/src/router/www/Reaper_Diag.asp b/release/src/router/www/Reaper_Diag.asp
index e9949d440c1..695be727b2f 100644
--- a/release/src/router/www/Reaper_Diag.asp
+++ b/release/src/router/www/Reaper_Diag.asp
@@ -69,7 +69,7 @@ pre.sample .g{color:var(--jade)} pre.sample .r{color:#e0837d} pre.sample .w{colo
 
 <div class="pagehead">
   <h1><#RDIAG_00#> <a href="https://github.com/TheUnboundDeveloper/AM-Reaper/blob/main/docs/REAPER-GUIDE.md#413-diagnostics" target="_blank" rel="noopener noreferrer" title="<#RABT_43#>" style="display:inline-flex;align-items:center;justify-content:center;width:22px;height:22px;margin-left:8px;border-radius:50%;border:1px solid #4a4a4e;color:#8d897f;font:700 13px Arial,sans-serif;text-decoration:none;vertical-align:middle">?</a></h1>
-  <span class="ver"><#RDIAG_01#> &middot; REAPER-DIAG v1.3.40</span>
+  <span class="ver"><#RDIAG_01#> &middot; REAPER-DIAG v1.3.41</span>
 </div>
 <p class="lede"><#RDIAG_02#></p>
 
-- 
2.25.1

