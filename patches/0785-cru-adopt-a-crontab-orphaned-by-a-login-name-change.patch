From 560e4c461383d374fdc38b2b2c10369458211d60 Mon Sep 17 00:00:00 2001
From: reaper <theunbounddeveloper@outlook.com>
Date: Sun, 11 Oct 2026 12:03:39 -0400
Subject: [PATCH] cru: adopt a crontab orphaned by a login-name change

cru keeps the jobs in /var/spool/cron/crontabs/<login name>; busybox crond
skips a crontab whose name is not a user in /etc/passwd; a login rename
without a reboot (Administration > System) rebuilds /etc/passwd under the
new name, so every job registered at boot sat in a file crond ignores while
"cru l" read the new name's empty file (field: GT-BE98 on v3.0.0, every
cru job dead). adopt() runs under the existing lock on add, delete and
list: only when /etc/passwd is readable and lists the current login, never
a file named for a user that still exists, an #id# already in the current
crontab wins, lines without an id are kept, the orphan is removed and
cron.update appended; one logger line with the count and no name.
Ordinary add / replace / delete / list are unchanged. Lean:
tests/test_cru_adopt.py.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 release/src/router/others/cru | 43 +++++++++++++++++++++++++++++++++++
 1 file changed, 43 insertions(+)

diff --git a/release/src/router/others/cru b/release/src/router/others/cru
index 910c75078c..7dba002a01 100755
--- a/release/src/router/others/cru
+++ b/release/src/router/others/cru
@@ -4,10 +4,49 @@ U="$D/cron.update"
 F="$D/`nvram get http_username`"
 N="$F.new"
 L="/var/lock/cron.lock"
+P="/etc/passwd"
+
+# reaper 2026-10-10: the crontab is named after the login name, crond skips a
+# crontab whose name is not a user in /etc/passwd, and a login-name change
+# (Administration > System, or the pre-v3.3.1 setup box) rebuilds /etc/passwd
+# under the new name without a reboot. Every job registered at boot then sat in
+# a file crond ignores while "cru l" read the new name's empty one (field:
+# GT-BE98 on v3.0.0, every cru job dead). Under the cru lock, adopt such an
+# orphan: its lines go into the current crontab (an #id# already there wins),
+# the orphan is removed and crond is told. A file named for a user that still
+# exists is never touched, and nothing is moved unless /etc/passwd is readable
+# and lists the current login - an unreadable or half-written passwd must not
+# look like "every crontab is orphaned".
+adopt() {
+	ME="${F##*/}"
+	[ -n "$ME" ] && [ -r "$P" ] || return 0
+	awk -F: -v n="$ME" '$1==n{f=1} END{exit !f}' "$P" || return 0
+	for O in "$D"/*; do
+		[ -f "$O" ] || continue
+		B="${O##*/}"
+		case "$B" in cron.update|*.new) continue;; esac
+		[ "$O" = "$F" ] && continue
+		awk -F: -v n="$B" '$1==n{f=1} END{exit !f}' "$P" && continue
+		C=0
+		while IFS= read -r LINE || [ -n "$LINE" ]; do
+			[ -n "$LINE" ] || continue
+			ID=`echo "$LINE" | sed -n 's/.*\(#[^#][^#]*#\)$/\1/p'`
+			if [ -n "$ID" ] && [ -f "$F" ] && awk -v id="$ID" 'substr($0, length($0) - length(id) + 1) == id {f=1} END{exit !f}' "$F"; then
+				continue
+			fi
+			echo "$LINE" >>"$F"
+			C=$((C + 1))
+		done <"$O"
+		rm -f "$O"
+		echo "$ME" >>"$U"
+		logger -t cru "moved $C cron job(s) left under a login name that no longer exists to the current login (the login name changed without a reboot)"
+	done
+}
 
 if [ $# -gt 1 -a "$1" = "a" -o "$1" = "d" ]; then
 	{
 		flock -x 278
+		adopt
 		ID=$2
 		grep -v "#$ID#\$" $F >$N 2>/dev/null
 		if [ "$1" = "a" ]; then
@@ -23,6 +62,10 @@ if [ $# -gt 1 -a "$1" = "a" -o "$1" = "d" ]; then
 fi
 
 if [ "$1" = "l" ]; then
+	{
+		flock -x 278
+		adopt
+	} 278>$L
 	cat $F 2>/dev/null
 	exit 0
 fi
-- 
2.25.1

