From 8eade270ea39cbabd9ebafd4c4c1681446f60740 Mon Sep 17 00:00:00 2001
From: reaper <theunbounddeveloper@outlook.com>
Date: Sun, 11 Oct 2026 12:03:42 -0400
Subject: [PATCH] version: Reaper_v3.4.0

Nine fixes since v3.3.9: the Samba 4 enrollment order, the header Internet
tooltip on every page, the LAN name resolution check, five kernel one-hunk
CVE fixes, POSTed list saves, cru adopting a renamed login's crontab, the
nav rail icons, diag v1.3.34.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 release/src-rt/version.conf | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/release/src-rt/version.conf b/release/src-rt/version.conf
index 334552227f..70ec979bc5 100644
--- a/release/src-rt/version.conf
+++ b/release/src-rt/version.conf
@@ -4,6 +4,6 @@ KERNEL_VER_AM=$(subst .,,$(KERNEL_VER))
 FS_VER_AM=$(subst .,,$(FS_VER))
 
 SERIALNO=102.8
-EXTENDNO=Reaper_v3.3.9
+EXTENDNO=Reaper_v3.4.0
 
 RCNO=0
