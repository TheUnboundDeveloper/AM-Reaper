+/* 2026-10-20 Dreadwatch (Reaper_Dreadwatch.asp): the threat-domain list's own report,
+ * produced by the collector rc generates (rc/rwarden.c rw_gen_dns), and a self-test. */
+#define RDW_SH   "/tmp/rwarden/dns.sh"
+#define RDW_CONF "/tmp/rwarden/dns.conf"
+
+/* the first name on the list (reaper-nx=/name/, or an older firmware's address=/name/),
+ * charset-checked; 0 = found */
+static int rdw_first_name(char *out, size_t osz)
+{
+	FILE *f = fopen(RDW_CONF, "r");
+	char ln[300], *p, *e;
+	int found = -1;
+
+	if (!f)
+		return -1;
+	while (found && fgets(ln, sizeof(ln), f)) {
+		if (!strncmp(ln, "reaper-nx=/", 11)) p = ln + 11;
+		else if (!strncmp(ln, "address=/", 9)) p = ln + 9;
+		else continue;
+		if ((e = strchr(p, '/')) == NULL || e == p || (size_t)(e - p) >= osz) continue;
+		*e = 0;
+		if (strspn(p, "abcdefghijklmnopqrstuvwxyz0123456789.-") != strlen(p)) continue;
+		strlcpy(out, p, osz);
+		found = 0;
+	}
+	fclose(f);
+	return found;
+}
+
+/* one A query for name to the router's own resolver (127.0.0.1:53), 1.5 s at most;
+ * 0 = answered, *rcode = the answer's RCODE (3 = NXDOMAIN) */
+static int rdw_query(const char *name, int *rcode)
+{
+	unsigned char q[300], r[512];
+	struct sockaddr_in a;
+	struct timeval tv = { 1, 500000 };
+	const char *p = name, *dot;
+	int n = 12, s, len;
+
+	memset(q, 0, 12);
+	q[0] = 0x52; q[1] = 0x57;	/* id */
+	q[2] = 0x01;			/* RD */
+	q[5] = 1;			/* one question */
+	while (*p) {
+		dot = strchr(p, '.');
+		len = dot ? (int)(dot - p) : (int)strlen(p);
+		if (len < 1 || len > 63 || n + len + 6 > (int)sizeof(q))
+			return -1;
+		q[n++] = (unsigned char)len;
+		memcpy(q + n, p, len);
+		n += len;
+		p += len + (dot ? 1 : 0);
+	}
+	q[n++] = 0;
+	q[n++] = 0; q[n++] = 1;		/* A */
+	q[n++] = 0; q[n++] = 1;		/* IN */
+	if ((s = socket(AF_INET, SOCK_DGRAM, 0)) < 0)
+		return -1;
+	setsockopt(s, SOL_SOCKET, SO_RCVTIMEO, &tv, sizeof(tv));
+	memset(&a, 0, sizeof(a));
+	a.sin_family = AF_INET;
+	a.sin_port = htons(53);
+	a.sin_addr.s_addr = htonl(INADDR_LOOPBACK);
+	if (connect(s, (struct sockaddr *)&a, sizeof(a)) != 0 || send(s, q, n, 0) != n ||
+	    (len = recv(s, r, sizeof(r), 0)) < 12 || r[0] != 0x52 || r[1] != 0x57) {
+		close(s);
+		return -1;
+	}
+	close(s);
+	*rcode = r[3] & 0x0f;
+	return 0;
+}
