From 9697f241d6c87bc6c2a3e53327243f66ac1dd834 Mon Sep 17 00:00:00 2001
From: reaper <theunbounddeveloper@outlook.com>
Date: Tue, 20 Oct 2026 18:02:51 -0400
Subject: [PATCH] httpd: Dreadwatch status, test and reset; Security Review
 per-item accept, rules and log; SameSite on the session cookie

reaper_warden.cgi gains dns_status (dns.sh stats), dns_reset and dns_test
(one A query to 127.0.0.1:53 from C, 1.5 s timeout), behind the existing
gate. reaper_watch.cgi gains ack_one (folds one item into the baseline with
a linear write), rules / rules_set (100 rules, 8 KB, charset and prefix
validated) and log; Accept all audits what it folded in; every action
appends to /jffs/reaper/review/accept.log (200 kept). The settings export
carries the rules (rwatch_rules), re-validated on import. Security review
2026-10-20, F-4: SameSite=Lax on the session cookie at both open emitters
(login_cgi, send_token_headers). Reaper_Dreadwatch.asp is a native page.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 release/src/router/httpd/httpd.c         |  10 +-
 release/src/router/httpd/reaper_inject.c |   1 +
 release/src/router/httpd/web.c           | 451 ++++++++++++++++++++++-
 3 files changed, 455 insertions(+), 7 deletions(-)

diff --git a/release/src/router/httpd/httpd.c b/release/src/router/httpd/httpd.c
index ea48f5cfdaa..ac7d0c0eed9 100644
--- a/release/src/router/httpd/httpd.c
+++ b/release/src/router/httpd/httpd.c
@@ -798,7 +798,15 @@ send_token_headers( int status, char* title, char* extra_header, char* mime_type
     if ( mime_type != (char*) 0 )
 	(void) fprintf( conn_fp, "Content-Type: %s\r\n", mime_type );
 
-    (void) fprintf( conn_fp, "Set-Cookie: %s\r\n", token_cookie);
+    /* reaper 2026-10-20 (security review F-4): SameSite=Lax on the session cookie.
+     * The cookie text comes from the closed gen_asus_token_cookie() and always ends
+     * in ';' ("HttpOnly;" or "Secure;"), so the attribute is appended here, in open
+     * code, by the only two emitters (this one and login_cgi in web.c). Lax, not
+     * Strict: a bookmark or a link to the router must still open logged in; a
+     * cross-site POST or XHR then carries no session at all, a second layer beside
+     * the per-boot http_id every Reaper control already demands. An empty cookie
+     * (a blob failure) gets no bare attribute. */
+    (void) fprintf( conn_fp, "Set-Cookie: %s%s\r\n", token_cookie, token_cookie[0] ? " SameSite=Lax" : "");
 
     (void) fprintf( conn_fp, "Connection: close\r\n" );
     (void) fprintf( conn_fp, "\r\n" );
