diff --git a/release/src/router/httpd/web.c b/release/src/router/httpd/web.c
index d1ccd38b2e2..64620e5e012 100644
--- a/release/src/router/httpd/web.c
+++ b/release/src/router/httpd/web.c
@@ -23703,6 +23703,185 @@ static void reaper_audit(const char *feat, const char *act, const char *detail)
 #define RVIEW_AUTH    "/tmp/reaper/review.auth"
 #define RVIEW_BASE    "/jffs/reaper/review/baseline"
 #define RVIEW_INV_MAX (200 * 1024)
+/* 2026-10-20 (reviewer: expected /jffs churn made every run noise; accepts must be
+ * logged): the operator's rules (rc/rwatch.c RV_RULES - `<mode> <glob>` lines the
+ * inventory AND the diff apply, first match wins) and a log of every acceptance and
+ * rules change. Both persistent on /jffs (they survive a firmware update), both
+ * written through rjf_set. */
+#define RVIEW_DIFF    "/tmp/reaper/review.diff"
+#define RVIEW_RULES   "/jffs/reaper/review/rules"
+#define RVIEW_ALOG    "/jffs/reaper/review/accept.log"
+#define RVIEW_RULES_MAX   100
+#define RVIEW_RULES_BYTES 8192
+#define RVIEW_ALOG_LINES  200
+
+/* a whole small regular file, never through a link; NULL when absent or bad */
+static char *rview_slurp(const char *path, size_t max)
+{
+	struct stat st;
+	char *b;
+	size_t got = 0;
+	ssize_t r;
+	int fd = open(path, O_RDONLY | O_NOFOLLOW);
+
+	if (fd < 0)
+		return NULL;
+	if (fstat(fd, &st) != 0 || !S_ISREG(st.st_mode) || (size_t)st.st_size > max || (b = malloc(st.st_size + 1)) == NULL) {
+		close(fd);
+		return NULL;
+	}
+	while (got < (size_t)st.st_size && (r = read(fd, b + got, st.st_size - got)) > 0)
+		got += r;
+	close(fd);
+	if (got != (size_t)st.st_size) {
+		free(b);
+		return NULL;
+	}
+	b[got] = '\0';
+	return b;
+}
+
+/* one line into the accept log (time, client, action, detail), keeping the last
+ * RVIEW_ALOG_LINES; tabs, newlines and control bytes in the detail become spaces */
+static void rview_alog(const char *action, const char *detail)
+{
+	char line[768], *old, *p, *keep;
+	size_t n, i, nl = 0;
+
+	snprintf(line, sizeof(line), "%ld\t%s\t%s\t%s\n", (long)time(NULL),
+		 reaper_client_ip[0] ? reaper_client_ip : "-", action, detail ? detail : "");
+	for (i = 0; line[i]; i++)	/* the first three tabs are the separators */
+		if (((unsigned char)line[i] < 0x20 && line[i] != '\t' && !(line[i] == '\n' && line[i + 1] == '\0')) || line[i] == 0x7f)
+			line[i] = ' ';
+	for (i = 0, nl = 0; line[i]; i++)
+		if (line[i] == '\t' && ++nl > 3)
+			line[i] = ' ';
+	old = rview_slurp(RVIEW_ALOG, 256 * 1024);
+	keep = old ? old : "";
+	for (p = keep, nl = 0; *p; p++)
+		if (*p == '\n') nl++;
+	for (p = keep; nl >= RVIEW_ALOG_LINES && *p; p++)	/* drop the oldest lines */
+		if (*p == '\n') nl--;
+	n = strlen(p) + strlen(line) + 1;
+	if ((keep = malloc(n)) != NULL) {
+		snprintf(keep, n, "%s%s", p, line);
+		rjf_set(RVIEW_ALOG, keep, "review");
+		free(keep);
+	}
+	free(old);
+}
+
+/* what an Accept-all folds in: counts by status from the last diff, and the first
+ * 20 item keys (the diff is control-byte free - rwatch strips it) */
+static void rview_fold_summary(char *out, size_t osz)
+{
+	FILE *f = fopen(RVIEW_DIFF, "r");
+	char ln[1024], keys[512] = "";
+	int add = 0, chg = 0, rem = 0, rul = 0, nk = 0;
+
+	if (f) {
+		while (fgets(ln, sizeof(ln), f)) {
+			char *st = ln, *t, *k, *e;
+			if ((t = strchr(st, '\t')) == NULL) continue;
+			*t++ = 0;
+			if ((k = strchr(t, '\t')) == NULL) continue;
+			*k++ = 0;
+			if ((e = strchr(k, '\t')) != NULL) *e = 0;
+			if (!strcmp(st, "added")) add++;
+			else if (!strcmp(st, "changed")) chg++;
+			else if (!strcmp(st, "removed")) rem++;
+			else if (!strcmp(st, "rule")) rul++;
+			else continue;
+			if (nk++ < 20 && strlen(keys) + strlen(k) + 3 < sizeof(keys))
+				snprintf(keys + strlen(keys), sizeof(keys) - strlen(keys), "%s%s", keys[0] ? ", " : "", k);
+		}
+		fclose(f);
+	}
+	snprintf(out, osz, "%d added, %d changed, %d removed, %d by rule%s%s", add, chg, rem, rul, keys[0] ? ": " : "", keys);
+}
+
+/* one inventory/baseline line's item identity: a file is one item whatever its
+ * mode letter (S/A/K/E - rwatch _rv_diff's kk()), anything else is type+key */
+static int rview_same_item(const char *line, char t, const char *k)
+{
+	const char *tab = strchr(line, '\t'), *end;
+	size_t kl = strlen(k);
+	int f1, f2;
+
+	if (!tab || tab == line) return 0;
+	f1 = strchr("SAKE", line[0]) != NULL;
+	f2 = strchr("SAKE", t) != NULL;
+	if (f1 != f2 || (!f1 && line[0] != t)) return 0;
+	end = strchr(tab + 1, '\t');
+	if (!end) end = tab + 1 + strlen(tab + 1);
+	return (size_t)(end - (tab + 1)) == kl && strncmp(tab + 1, k, kl) == 0;
+}
+
+/* the baseline with one item folded in: every baseline line of the item dropped,
+ * every inventory line of it appended (none when it is gone). *hit = the item was
+ * in either. Linear: a write cursor, never strcat over a 200 KB buffer. NULL = no
+ * memory. Both inputs are modified in place temporarily and restored. */
+static char *rview_fold_one(char *base, char *inv, char t, const char *k, int *hit)
+{
+	size_t osz = strlen(base) + strlen(inv) + 4, ol = 0, l;
+	char *out = malloc(osz), *p, *e, c;
+	int pass, same;
+
+	*hit = 0;
+	if (!out) return NULL;
+	for (pass = 0; pass < 2; pass++) {
+		for (p = pass ? inv : base; *p; p = e) {
+			e = strchr(p, '\n'); e = e ? e + 1 : p + strlen(p);
+			l = (size_t)(e - p);
+			c = *e; *e = 0;
+			same = rview_same_item(p, t, k);
+			if (same) *hit = 1;
+			if (pass ? same : !same) {	/* the baseline's other lines, then the item's live line */
+				memcpy(out + ol, p, l); ol += l;
+				if (out[ol - 1] != '\n') out[ol++] = '\n';
+			}
+			*e = c;
+		}
+	}
+	out[ol] = 0;
+	return out;
+}
+
+/* a saved rules text is one rule per line: `hash|meta|exist|ignore <pattern>`, the
+ * pattern /jffs/..., cron:... or nvram:..., printable ASCII without a quote,
+ * backslash or backtick; blank lines and # comments kept. 0 = valid. */
+static int rview_rules_ok(const char *s)
+{
+	int n = 0;
+	size_t len = strlen(s);
+
+	if (len > RVIEW_RULES_BYTES) return -1;
+	while (*s) {
+		const char *e = strchr(s, '\n'), *p, *sp;
+		size_t l = e ? (size_t)(e - s) : strlen(s);
+		char ln[260];
+
+		if (l >= sizeof(ln)) return -1;
+		memcpy(ln, s, l); ln[l] = 0;
+		if (l && ln[l - 1] == '\r') ln[--l] = 0;
+		for (p = ln; *p; p++)
+			if ((unsigned char)*p < 0x20 || (unsigned char)*p > 0x7e || *p == '"' || *p == '\\' || *p == '`')
+				return -1;
+		if (ln[0] && ln[0] != '#') {
+			if ((sp = strchr(ln, ' ')) == NULL) return -1;
+			if (!((sp - ln == 4 && (!strncmp(ln, "hash", 4) || !strncmp(ln, "meta", 4))) ||
+			      (sp - ln == 5 && !strncmp(ln, "exist", 5)) || (sp - ln == 6 && !strncmp(ln, "ignore", 6))))
+				return -1;
+			while (*sp == ' ') sp++;
+			if (strncmp(sp, "/jffs/", 6) && strncmp(sp, "cron:", 5) && strncmp(sp, "nvram:", 6))
+				return -1;
+			if (++n > RVIEW_RULES_MAX) return -1;
+		}
+		s += l + (e ? 1 : 0);
+		if (!e) break;
+	}
+	return 0;
+}
 
