+/* reaper_qis: the Reaper palette for the one wizard flow Reaper keeps - AiMesh
+   add-node (aimesh_topology.html -> QIS_wizard.htm?flag=amas_addNode) and AiMesh
+   node mode (?flag=amasnode_page). www/Makefile appends this sheet to
+   mobile/css/qis.css at install, after the stock rules, so it wins by order; the
+   stock sheet and the theme injector (which refuses QIS_* pages on purpose) are
+   untouched. Colours, buttons and links only; toggles stay neutral (reaper-ui
+   rule 11). Every selector here exists in the stock qis.css; the host test
+   test_qis_theme_append.py fails when a GPL merge renames one. ASCII only. */
+
+/* surfaces */
+body{ background-color:#08080a !important; color:#ECE7DB; }
+.qisBackground, .qisBackgroundIndex{ background:#08080a !important; background-image:none !important; }
+.popup_container.defpass > div, #eula_popup_view{ background:#141416 !important; color:#ECE7DB; }
+.scorebarBorder, .textInputDisabled{ background:#1b1b1e !important; border-color:#2a2a2e !important; }
+
+/* text */
+option, .labelContainer, .inputTitle, .descInput, .optionInput, .selectorTopContainer,
+.apListDiv, .aimesh_info, .ap_ssid, .loadingBar, .mobile_abortBtn, .model_welcome,
+.navigation, .navigation li dt, .navigation li dd a, .navigation li dd a:visited,
+#eulaConfirmContainer label, #asusEulaContainer{ color:#ECE7DB !important; }
+.aimesh_mac, .ap_title_container{ color:#C9C2B4 !important; }
+.ap_title_container{ border-bottom:1px solid #2a2a2e !important; }
+
+/* links and accents */
+a{ color:#E10600 !important; }
+.advSetting, .descSteps, .desktop_left_field, .desktop_abortBtn, .icon_excl_mark,
+.defpass_guideline_title_container > div:not(:first-child), .defpass.popup_container .title_container .title,
+#readAgainBtn, #knowRiskBtn, .ap_ssid_hover, .navigation li dt:hover{ color:#E10600 !important; }
+.icon_excl_mark{ border-color:#E10600 !important; }
+.selectorContainerDiv:hover, .selectBar > label:hover, .labelInput:hover{ color:#E10600 !important; }
+.navigation li dd:hover{ background-color:#E10600 !important; }
+.footer_mobile{ border-top-color:#E10600 !important; }
+
+/* buttons */
+.desktop_applyBtn, .mobileApply, .welcome_button, #aimesh_welcome_button, .macCloneBtn{
+  background:#E10600 !important; border-color:#E10600 !important; color:#ECE7DB !important; }
+.desktop_abortBtn{ border:2px solid #2a2a2e !important; background:transparent !important; color:#ECE7DB !important; }
+.mobileAbort{ background:#141416 !important; }
+.desktop_applyBtn.disabled, .desktop_abortBtn.disabled, .mobileApply.disabled, .mobileAbort.disabled{
+  background:#2a2a2e !important; border-color:#2a2a2e !important; color:#8a8a8e !important; }
+.mobileAbort.disabled .mobile_abortBtn{ color:#8a8a8e !important; }
+
+/* inputs */
+.textInput, .textInput_DE{ background:#141416 !important; border:1px solid #2a2a2e !important; color:#ECE7DB !important; }
+.ui-input-text input, .ui-input-search input{ background:#141416 !important; border-color:#2a2a2e !important; color:#ECE7DB !important; }
+
+/* progress */
+.loadingBarContainer{ border:2px solid #E10600 !important; }
+.loadingBar{ background-color:#E10600 !important; }
+.cssload-circle .cssload-inner{ border:5px solid rgba(225,6,0,0.7) !important; box-shadow:inset 0px 0px 10px rgba(225,6,0,0.15) !important; }
+
+/* header strip: no ASUS logo, no grey gradient (de-ASUS, reaper-ui rule 25) */
+.headerBar .icon_logo, .headerBarIndex .icon_logo{ display:none !important; }
+.headerBar, .headerBarIndex{ background:#08080a !important; background-image:none !important; border-bottom:1px solid #2a2a2e !important; }
+.model_welcome{ background:transparent !important; background-image:none !important; color:#ECE7DB !important; }
+
+/* titles: main in bone, the step subtitle carries the accent; the column is centred (owner, 2026-10-12) */
+.desktop_left_field{ text-align:center !important; }
+.titleMain{ color:#ECE7DB !important; }
+/* long languages: the subtitle keeps at most two lines and ends in an ellipsis; the full text is in its
+   title tooltip (reaper-ui overflow rule 26/41). Buttons keep one line, clipped the same way. */
+.titleSub{ color:#E10600 !important; overflow:hidden; text-overflow:ellipsis; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow-wrap:anywhere; }
+.desktop_applyBtn, .desktop_abortBtn{ overflow:hidden; text-overflow:ellipsis; white-space:nowrap; padding:0 14px; box-sizing:border-box; }
+.mobileApply .mobile_applyBtn, .mobileAbort .mobile_abortBtn{ display:block; max-width:100%; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; padding:0 10px; }
+
+/* the prerequisites box on the AiMesh search page (amassearch_page.html, rqs_* = reaper-owned classes) */
+.rqs_box{ margin:18px auto 22px; max-width:680px; padding:14px 18px; background:#141416; border:1px solid #2a2a2e; border-radius:6px; color:#ECE7DB; text-align:left; font-size:15px; line-height:1.5; }
+.rqs_title{ color:#E10600; font-weight:bold; margin-bottom:8px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
+.rqs_list{ margin:0; padding-left:20px; }
+.rqs_list li{ margin-bottom:6px; }
+
+/* the AiMesh dictionary strings carry inline color spans (ASUS blue #569AC7); importance beats inline */
+.qisBackground .pageDesc span{ color:#ECE7DB !important; font-weight:bold; }
