@@ -1426,6 +1426,11 @@ init_key_contexts(struct key_state *ks, struct tls_multi *multi, const struct ke
     {
         if (!cipher_kt_mode_aead(key_type->cipher))
         {
+            /* reaper 2026-10-13 (2.7.8 backport 69a7cb1b4f87): upstream fails the
+             * session here through the enum key_gen_status that 87d3dd5cd3c7 adds;
