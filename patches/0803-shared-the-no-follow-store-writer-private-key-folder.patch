+	int fd, same = 0;
+
+	if (path && lstat(path, &st) == 0 && S_ISREG(st.st_mode) && (size_t)st.st_size == len &&
+	    (st.st_mode & 07777) == (mode & 07777) &&
+	    (fd = open(path, O_RDONLY | O_NOFOLLOW | O_NONBLOCK | O_CLOEXEC)) >= 0) {
+		same = 1;
+		while (same && off < len) {
+			ssize_t n = read(fd, buf, len - off < sizeof(buf) ? len - off : sizeof(buf));
+			if (n <= 0 || memcmp(buf, p + off, (size_t)n) != 0)
+				same = 0;
+			else
+				off += (size_t)n;
+		}
+		close(fd);
+	}
+	return same ? 0 : reaper_write_atomic(path, data, len, mode);
+}
