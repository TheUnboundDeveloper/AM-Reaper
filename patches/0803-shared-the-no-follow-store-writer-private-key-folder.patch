diff --git a/release/src/router/shared/reaper_jfile.c b/release/src/router/shared/reaper_jfile.c
index 705990bbc7b..597655d9c51 100644
--- a/release/src/router/shared/reaper_jfile.c
+++ b/release/src/router/shared/reaper_jfile.c
@@ -72,6 +72,41 @@ static void rjf_ww_walk(char *path, size_t cap, dev_t dev, int depth, int *fixed
 	closedir(d);
 }
 
+/* 2026-10-21 (field report, v3.4.8): a folder only root may enter. /jffs/ca_files holds
+ * the IPsec CA, server and client private keys and the scripts rc runs from it as root;
+ * stock left the keys readable by everyone in a 0755 folder and made the scripts 0777, so
+ * the write-for-everyone sweep alone left both reachable for any non-root service. The
+ * folder becomes 0700 and every regular file in it loses its group and other bits (and
+ * any set-id bit). A symlink is never followed or changed: anything that is not a real
+ * directory is refused (-1). The folder is flat, so this does not recurse. Everything
+ * that uses it runs as root (rc, httpd's export / import, charon as the uid-0 admin).
+ * Returns how many entries changed. */
+int reaper_private_dir(const char *dir)
+{
+	char p[PATH_MAX];
+	struct stat st;
+	struct dirent *e;
+	DIR *d;
+	int n = 0;
+
+	if (lstat(dir, &st) != 0 || !S_ISDIR(st.st_mode))
+		return -1;
+	if ((st.st_mode & 07777) != 0700 && chmod(dir, 0700) == 0)
+		n++;
+	if ((d = opendir(dir)) == NULL)
+		return n;
+	while ((e = readdir(d)) != NULL) {
+		if (!strcmp(e->d_name, ".") || !strcmp(e->d_name, ".."))
+			continue;
+		if (snprintf(p, sizeof(p), "%s/%s", dir, e->d_name) >= (int)sizeof(p))
+			continue;
+		if (lstat(p, &st) == 0 && S_ISREG(st.st_mode) && (st.st_mode & 07077) && chmod(p, st.st_mode & 0700) == 0)
+			n++;
+	}
+	closedir(d);
+	return n;
+}
+
 /* The sweep runs right after /jffs is mounted, and syslogd cannot have started
  * yet - it writes /jffs/syslog.log (r1 metal, 2026-10-20: the line never reached
  * the log). So the result is kept here, in pid 1 like the boot loop that starts
@@ -81,13 +116,17 @@ static void rjf_ww_walk(char *path, size_t cap, dev_t dev, int depth, int *fixed
 #ifndef RJF_WW_REC
 #define RJF_WW_REC "/tmp/reaper/jffs.sweep"
 #endif
-static int rjf_ww_ran, rjf_ww_fixed, rjf_ww_failed, rjf_ww_logged;
+static int rjf_ww_ran, rjf_ww_fixed, rjf_ww_failed, rjf_ww_logged, rjf_pv_fixed;
 static char rjf_ww_root[64];
 
 static void rjf_ww_log(void)
 {
-	logmessage("reaper", "jffs: write access for all users removed from %d file(s) and folder(s) under %s%s (left by firmware before v3.3.8, or restored from an older backup)",
-	           rjf_ww_fixed, rjf_ww_root, rjf_ww_failed ? ", some could not be changed" : "");
+	if (rjf_ww_fixed || rjf_ww_failed)
+		logmessage("reaper", "jffs: write access for all users removed from %d file(s) and folder(s) under %s%s (left by firmware before v3.3.8, or restored from an older backup)",
+		           rjf_ww_fixed, rjf_ww_root, rjf_ww_failed ? ", some could not be changed" : "");
+	if (rjf_pv_fixed)
+		logmessage("reaper", "jffs: the IPsec keys and scripts in %s/ca_files made root-only (%d file(s) and folder(s); left readable or writable by earlier firmware)",
+		           rjf_ww_root, rjf_pv_fixed);
 	rjf_ww_logged = 1;
 }
 
@@ -102,12 +141,17 @@ int reaper_jffs_perm_sweep(const char *root)
 		return -1;
 	snprintf(path, sizeof(path), "%s", root);
 	rjf_ww_walk(path, sizeof(path), st.st_dev, 0, &fixed, &failed);
+	/* IPsec's key folder is root's alone (reaper_private_dir), with or without IPsec on */
+	snprintf(path, sizeof(path), "%s/ca_files", root);
+	rjf_pv_fixed = reaper_private_dir(path);
+	if (rjf_pv_fixed < 0)
+		rjf_pv_fixed = 0;
 	rjf_ww_ran = 1;
 	rjf_ww_fixed = fixed;
 	rjf_ww_failed = failed;
 	rjf_ww_logged = 0;
 	snprintf(rjf_ww_root, sizeof(rjf_ww_root), "%s", root);
-	if ((fixed || failed) && pids("syslogd"))
+	if ((fixed || failed || rjf_pv_fixed) && pids("syslogd"))
 		rjf_ww_log();
 	return fixed;
 }
@@ -123,7 +167,7 @@ void reaper_jffs_perm_report(void)
 
 	if (!rjf_ww_ran)
 		return;
-	if ((rjf_ww_fixed || rjf_ww_failed) && !rjf_ww_logged) {
+	if ((rjf_ww_fixed || rjf_ww_failed || rjf_pv_fixed) && !rjf_ww_logged) {
 		for (i = 0; i < 30 && !pids("syslogd"); i++)
 			usleep(100000);
 		usleep(200000);		/* its socket is bound a moment after the process exists */
diff --git a/release/src/router/shared/reaper_store.h b/release/src/router/shared/reaper_store.h
index b431dd9b7a4..99960d8c282 100644
--- a/release/src/router/shared/reaper_store.h
+++ b/release/src/router/shared/reaper_store.h
@@ -259,4 +259,54 @@ static inline int rstore_seen_write(const char *vid, long t)
 	return rstore_write_file(RSTORE_SEEN, txt, 0600);
 }
 
+/* 2026-10-21: the published location. wallguard.sh and the Dreadwatch collector read no nvram, so
+ * the watchdog (rc/reaper_usbmon.c) writes the effective base and the opted-in datasets to
+ * RSTORE_PUB: "<base>\n,<datasets>,\n", rewritten only on a change, removed while the store is
+ * volatile (RAM, no pin, or the pinned volume not mounted). Datasets keep only [a-z0-9,]. jffs is
+ * the JFFS base (a parameter for the host test). 1 = durable, text in out. */
+#define RSTORE_PUB		"/tmp/reaper/store.base"
+#define RSTORE_JFFS_BASE	"/jffs/reaper"
+
+static inline int rstore_pub_text(const char *mode, const char *vid, const char *ds, const char *root,
+				  int need_mount, const char *jffs, char *out, size_t len)
+{
+	char base[176], d[80];
+	size_t i, n = 0;
+	if (!mode || !ds || !out || !len) return 0;
+	if (!strcmp(mode, "jffs")) {
+		if (!rstore_dir_ok(jffs)) return 0;
+		snprintf(base, sizeof(base), "%s", jffs);
+	} else if (!strcmp(mode, "usb")) {
+		if (!rstore_find(root, need_mount, vid, NULL, 0, base, sizeof(base))) return 0;
+	} else
+		return 0;
+	for (i = 0; ds[i] && n < sizeof(d) - 1; i++)
+		if ((ds[i] >= 'a' && ds[i] <= 'z') || (ds[i] >= '0' && ds[i] <= '9') || ds[i] == ',')
+			d[n++] = ds[i];
+	d[n] = 0;
+	return snprintf(out, len, "%s\n,%s,\n", base, d) < (int)len;
+}
+
+/* The shell reader: rstore_dir <dataset> prints the base when the dataset is opted in and the base
+ * is still usable (a USB base: still mounted, its store.id present; never through a symlink), else
+ * prints nothing and returns 1. wallguard.sh carries the same text between its "rstore_dir: begin" and
+ * "rstore_dir: end" lines - test_usb_store_pin.py keeps the two identical. The RSTORE_* variables
+ * exist for the host test only. */
+#define RSTORE_SH_DIR \
+	"# rstore_dir: begin (shared/reaper_store.h RSTORE_SH_DIR - keep identical)\n" \
+	"rstore_dir() {\n" \
+	"  _sf=${RSTORE_PUB_F:-/tmp/reaper/store.base}; _sm=${RSTORE_MNT_D:-/tmp/mnt}\n" \
+	"  [ -f \"$_sf\" ] && [ ! -L \"$_sf\" ] || return 1\n" \
+	"  { read -r _sb; read -r _sd; } < \"$_sf\"\n" \
+	"  case \"$_sd\" in *\",$1,\"*) ;; *) return 1 ;; esac\n" \
+	"  case \"$_sb\" in\n" \
+	"    \"${RSTORE_JFFS_D:-/jffs/reaper}\") ;;\n" \
+	"    \"$_sm\"/?*/.reaper) grep -qF \" ${_sb%/.reaper} \" \"${RSTORE_MOUNTS:-/proc/mounts}\" && [ -f \"$_sb/store.id\" ] && [ ! -L \"$_sb/store.id\" ] || return 1 ;;\n" \
+	"    *) return 1 ;;\n" \
+	"  esac\n" \
+	"  [ -d \"$_sb\" ] && [ ! -L \"$_sb\" ] && [ -w \"$_sb\" ] || return 1\n" \
+	"  echo \"$_sb\"\n" \
+	"}\n" \
+	"# rstore_dir: end\n"
+
 #endif /* _REAPER_STORE_H_ */
diff --git a/release/src/router/shared/reaper_store_io.h b/release/src/router/shared/reaper_store_io.h
new file mode 100644
index 00000000000..4af49414f5d
--- /dev/null
+++ b/release/src/router/shared/reaper_store_io.h
@@ -0,0 +1,330 @@
+/* SPDX-License-Identifier: GPL-2.0-only
+ * Copyright (C) 2026 the Reaper project maintainer
+ * Part of the Reaper hardened Asuswrt-Merlin build. See LICENSE / LICENSE.reaper.
+ * reaper_store_io.h - the long-term store's no-follow file operations (2026-10-21), used by
+ * /usr/sbin/rstore (wallguard/rstore.c) and its host test. Kept out of reaper_store.h, which rc,
+ * httpd and rtrafd include: these need the POSIX-2008 *at() calls. Include reaper_store.h first. */
+#ifndef _REAPER_STORE_IO_H_
+#define _REAPER_STORE_IO_H_
+
+#ifndef _GNU_SOURCE
+#define _GNU_SOURCE
+#endif
+#include <fcntl.h>
+#include <dirent.h>
+#include <errno.h>
+#include <string.h>
+#include <unistd.h>
+#include <sys/stat.h>
+
+/* 2026-10-21 (review): writing INTO the store without following a link. A USB store is a volume
+ * other people can write: in guest share mode the firmware's smb.conf maps every guest to
+ * "guest account = admin" (uid 0), so anyone on the LAN can plant a symlink inside .reaper and a
+ * root write by path (`>>`, `cp`, `rm` in a shell) lands wherever it points - /jffs/scripts
+ * included. rtrafd already opens its files O_NOFOLLOW for this reason; these helpers give the
+ * shell writers (wallguard.sh, the Dreadwatch collector, rwatch) the same discipline through
+ * /usr/sbin/rstore. The base is opened from its trusted parent (the /tmp/mnt mountpoint, or
+ * /jffs) and every level below it with openat(O_NOFOLLOW|O_DIRECTORY); files are opened
+ * O_NOFOLLOW and must be regular; a replace is a fresh O_EXCL file renamed into place. */
+#ifndef RSTORE_TRUST_MNT
+#define RSTORE_TRUST_MNT	RSTORE_MNT	/* the host test points these at a temp tree */
+#define RSTORE_TRUST_JFFS	RSTORE_JFFS_BASE
+#define RSTORE_NEED_MOUNT	1
+#endif
+
+/* a file or folder name we create or touch: [A-Za-z0-9_.-], not starting with '.', no '/' */
+static inline int rstore_leaf_ok(const char *n)
+{
+	const char *p;
+	if (!n || !*n || *n == '.' || strlen(n) > 64) return 0;
+	for (p = n; *p; p++)
+		if (!((*p >= 'a' && *p <= 'z') || (*p >= 'A' && *p <= 'Z') || (*p >= '0' && *p <= '9') ||
+		      *p == '_' || *p == '-' || *p == '.')) return 0;
+	return 1;
+}
+
+/* the store base as a directory fd, or -1: RSTORE_TRUST_JFFS itself, or <mnt>/<volume>/.reaper
+ * with <volume> a real mount; .reaper is never created here (store_set pins and creates it) */
+static inline int rstore_open_base(const char *base)
+{
+	char vol[96];
+	const char *p;
+	size_t l = strlen(RSTORE_TRUST_MNT);
+	int mfd, fd;
+
+	if (!base) return -1;
+	if (!strcmp(base, RSTORE_TRUST_JFFS))
+		return open(base, O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC);
+	if (strncmp(base, RSTORE_TRUST_MNT, l) || base[l] != '/') return -1;
+	p = base + l + 1;
+	l = strcspn(p, "/");
+	if (l == 0 || l >= sizeof(vol) || strcmp(p + l, "/" RSTORE_DIR)) return -1;
+	memcpy(vol, p, l); vol[l] = '\0';
+	if (!rstore_is_mount(RSTORE_TRUST_MNT, vol, RSTORE_NEED_MOUNT)) return -1;
+	{
+		char mp[160];
+		if (snprintf(mp, sizeof(mp), "%s/%s", RSTORE_TRUST_MNT, vol) >= (int)sizeof(mp)) return -1;
+		if ((mfd = open(mp, O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC)) < 0) return -1;
+	}
+	fd = openat(mfd, RSTORE_DIR, O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC);
+	close(mfd);
+	return fd;
+}
+
+/* <base>/<sub> as a directory fd; sub is "-" (the base itself) or one or two names joined by '/',
+ * each created 0700 when missing and never followed through a link */
+static inline int rstore_open_sub(const char *base, const char *sub)
+{
+	char s[132], *a, *b;
+	int fd, nfd, i;
+
+	if ((fd = rstore_open_base(base)) < 0) return -1;
+	if (!sub || !strcmp(sub, "-")) return fd;
+	if (strlen(sub) >= sizeof(s)) { close(fd); return -1; }
+	strcpy(s, sub);
+	a = s;
+	for (i = 0; a && i < 2; i++) {
+		if ((b = strchr(a, '/')) != NULL) *b++ = '\0';
+		if (!rstore_leaf_ok(a)) { close(fd); return -1; }
+		if (mkdirat(fd, a, 0700) != 0 && errno != EEXIST) { close(fd); return -1; }
+		nfd = openat(fd, a, O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC);
+		close(fd);
+		if ((fd = nfd) < 0) return -1;
+		a = b;
+	}
+	if (a) { close(fd); return -1; }	/* deeper than two levels */
+	return fd;
+}
+
+static inline int rstore_copy_fd(int in, int out, long long max)
+{
+	char buf[16384];
+	long long n = 0;
+	ssize_t r;
+	while ((r = read(in, buf, sizeof(buf))) > 0) {
+		char *p = buf;
+		if (max >= 0 && (n += r) > max) return -1;
+		while (r > 0) {
+			ssize_t w = write(out, p, (size_t)r);
+			if (w <= 0) { if (w < 0 && errno == EINTR) continue; return -1; }
+			p += w; r -= w;
+		}
+	}
+	return r < 0 ? -1 : 0;
+}
+
+/* name in dfd as a regular file opened with flags, or -1: a link, a FIFO or a device is refused */
+static inline int rstore_open_reg(int dfd, const char *name, int flags, mode_t mode)
+{
+	struct stat st;
+	int fd = openat(dfd, name, flags | O_NOFOLLOW | O_NONBLOCK | O_CLOEXEC, mode);
+	if (fd < 0) return -1;
+	if (fstat(fd, &st) != 0 || !S_ISREG(st.st_mode)) { close(fd); return -1; }
+	fcntl(fd, F_SETFL, fcntl(fd, F_GETFL) & ~O_NONBLOCK);
+	return fd;
+}
+
+/* open <sub>/<name> for appending; past cap bytes the file becomes <name>.1 first (renameat replaces,
+ * never follows); anything that is not a regular file at the name is removed, not written through.
+ * Returns the fd, or -1. (review 2026-10-24, Q-A-10: the one copy both append forms use) */
+static inline int rstore_open_append(const char *base, const char *sub, const char *name, long long cap)
+{
+	char old[80];
+	struct stat st;
+	int dfd, fd;
+
+	if (!rstore_leaf_ok(name) || snprintf(old, sizeof(old), "%s.1", name) >= (int)sizeof(old)) return -1;
+	if ((dfd = rstore_open_sub(base, sub)) < 0) return -1;
+	if (fstatat(dfd, name, &st, AT_SYMLINK_NOFOLLOW) == 0) {
+		if (!S_ISREG(st.st_mode)) unlinkat(dfd, name, 0);
+		else if (cap > 0 && st.st_size > cap) renameat(dfd, name, dfd, old);
+	}
+	fd = rstore_open_reg(dfd, name, O_WRONLY | O_APPEND | O_CREAT, 0600);
+	close(dfd);
+	return fd;
+}
+
+/* append in to <sub>/<name> (rstore_open_append's rules) */
+static inline int rstore_append(const char *base, const char *sub, const char *name, long long cap, int in)
+{
+	int fd = rstore_open_append(base, sub, name, cap), r;
+
+	if (fd < 0) return -1;
+	r = rstore_copy_fd(in, fd, -1);
+	if (close(fd) != 0) r = -1;
+	return r;
+}
+
+/* replace <sub>/<name> with the regular file src: a fresh O_EXCL temp in the same folder, synced,
+ * renamed over the name (a link planted at the name is replaced, never followed) */
+static inline int rstore_put(const char *base, const char *sub, const char *name, const char *src)
+{
+	char tmp[96];
+	int dfd, in, out, r;
+
+	if (!rstore_leaf_ok(name) || snprintf(tmp, sizeof(tmp), "%s.%d.tmp", name, (int)getpid()) >= (int)sizeof(tmp)) return -1;
+	if ((in = rstore_open_reg(AT_FDCWD, src, O_RDONLY, 0)) < 0) return -1;
+	if ((dfd = rstore_open_sub(base, sub)) < 0) { close(in); return -1; }
+	unlinkat(dfd, tmp, 0);
+	out = openat(dfd, tmp, O_WRONLY | O_CREAT | O_EXCL | O_NOFOLLOW | O_CLOEXEC, 0600);
+	if (out < 0) { close(in); close(dfd); return -1; }
+	r = rstore_copy_fd(in, out, -1);
+	close(in);
+	if (fsync(out) != 0) r = -1;
+	if (close(out) != 0) r = -1;
+	if (r == 0 && renameat(dfd, tmp, dfd, name) != 0) r = -1;
+	if (r != 0) unlinkat(dfd, tmp, 0);
+	close(dfd);
+	return r;
+}
+
+/* copy the regular file <sub>/<name> (at most max bytes) to dst, a fresh file root owns; a link,
+ * a FIFO or an oversized file is refused */
+static inline int rstore_get(const char *base, const char *sub, const char *name, const char *dst, long long max)
+{
+	int dfd, in, out, r;
+
+	unlink(dst);	/* a refused copy never leaves an older one behind */
+	if (!rstore_leaf_ok(name)) return -1;
+	if ((dfd = rstore_open_sub(base, sub)) < 0) return -1;
+	in = rstore_open_reg(dfd, name, O_RDONLY, 0);
+	close(dfd);
+	if (in < 0) return -1;
+	if ((out = open(dst, O_WRONLY | O_CREAT | O_EXCL | O_NOFOLLOW | O_CLOEXEC, 0600)) < 0) { close(in); return -1; }
+	r = rstore_copy_fd(in, out, max);
+	close(in);
+	if (close(out) != 0) r = -1;
+	if (r != 0) unlink(dst);
+	return r;
+}
+
+/* remove from <sub> every entry named [a-z0-9_]+ that is not in keep (NULL-terminated): unlinkat
+ * on the folder fd, so a link is removed itself and nothing outside the folder can be reached */
+static inline int rstore_prune(const char *base, const char *sub, char **keep)
+{
+	DIR *d;
+	struct dirent *e;
+	int dfd, dd, i;
+
+	if ((dfd = rstore_open_sub(base, sub)) < 0) return -1;
+	if ((dd = dup(dfd)) < 0 || (d = fdopendir(dd)) == NULL) { if (dd >= 0) close(dd); close(dfd); return -1; }
+	while ((e = readdir(d)) != NULL) {
+		const char *p;
+		int ok = 1, kept = 0;
+		for (p = e->d_name; *p; p++)
+			if (!((*p >= 'a' && *p <= 'z') || (*p >= '0' && *p <= '9') || *p == '_')) { ok = 0; break; }
+		if (!ok || !e->d_name[0]) continue;
+		for (i = 0; keep && keep[i]; i++)
+			if (!strcmp(keep[i], e->d_name)) { kept = 1; break; }
+		if (!kept) unlinkat(dfd, e->d_name, 0);
+	}
+	closedir(d);
+	close(dfd);
+	return 0;
+}
+
+
+/* append len bytes from buf (httpd's audit line; rstore_open_append's rules) */
+static inline int rstore_append_buf(const char *base, const char *sub, const char *name, long long cap,
+				    const char *buf, size_t len)
+{
+	int fd = rstore_open_append(base, sub, name, cap), r = 0;
+
+	if (fd < 0) return -1;
+	if (write(fd, buf, len) != (ssize_t)len) r = -1;
+	if (close(fd) != 0) r = -1;
+	return r;
+}
+
+/* append in, then keep only the last maxlines lines (the ring datasets: device and channel-quality
+ * history); the trimmed copy is a fresh O_EXCL file renamed over the old one.
+ * review 2026-10-24 (Q-A-5): a full ring used to be rewritten on EVERY append - the 7 MB channel-quality ring
+ * once per five-minute tick, some 2 GB a day of flash or USB writes for one new line. The ring may now run a
+ * tenth over maxlines before it is trimmed back to maxlines (one rewrite per maxlines/10 appends), and the line
+ * count comes from a streaming read; the file is read into memory for the trim only. Readers take the last
+ * lines they need (web.c reads the tail), so the slack never shows. */
+#define RSTORE_RING_MAX	(64LL << 20)	/* a ring larger than this is not read back into memory */
+static inline int rstore_ring(const char *base, const char *sub, const char *name, long maxlines, int in)
+{
+	char tmp[96], chunk[16384], *buf = NULL;
+	struct stat st;
+	long lines = 0, skip;
+	ssize_t n;
+	size_t got = 0, cut = 0;
+	int dfd, fd, out, r = 0;
+
+	if (maxlines < 1 || rstore_append(base, sub, name, 0, in) != 0) return -1;
+	if (snprintf(tmp, sizeof(tmp), "%s.%d.tmp", name, (int)getpid()) >= (int)sizeof(tmp)) return -1;
+	if ((dfd = rstore_open_sub(base, sub)) < 0) return -1;
+	if ((fd = rstore_open_reg(dfd, name, O_RDONLY, 0)) < 0) { close(dfd); return -1; }
+	if (fstat(fd, &st) != 0 || st.st_size > RSTORE_RING_MAX) { close(fd); close(dfd); return -1; }
+	while ((n = read(fd, chunk, sizeof(chunk))) > 0)
+		for (ssize_t i = 0; i < n; i++)
+			if (chunk[i] == '\n') lines++;
+	if (n < 0 || lines <= maxlines + maxlines / 10) { close(fd); close(dfd); return n < 0 ? -1 : 0; }
+	if (lseek(fd, 0, SEEK_SET) != 0 || (buf = malloc((size_t)st.st_size + 1)) == NULL) { close(fd); close(dfd); return -1; }
+	while (got < (size_t)st.st_size && (n = read(fd, buf + got, (size_t)st.st_size - got)) > 0)
+		got += (size_t)n;
+	close(fd);
+	lines = 0;
+	for (size_t i = 0; i < got; i++)
+		if (buf[i] == '\n') lines++;
+	skip = lines - maxlines;
+	for (cut = 0; cut < got && skip > 0; cut++)
+		if (buf[cut] == '\n') skip--;
+	unlinkat(dfd, tmp, 0);
+	out = openat(dfd, tmp, O_WRONLY | O_CREAT | O_EXCL | O_NOFOLLOW | O_CLOEXEC, 0600);
+	if (out < 0) r = -1;
+	else {
+		if (write(out, buf + cut, got - cut) != (ssize_t)(got - cut)) r = -1;
+		if (close(out) != 0) r = -1;
+		if (r == 0 && renameat(dfd, tmp, dfd, name) != 0) r = -1;
+		if (r != 0) unlinkat(dfd, tmp, 0);
+	}
+	free(buf);
+	close(dfd);
+	return r;
+}
+
+/* remove the folder <sub>/<name> and the files in it (an incident dump): every unlink is relative to
+ * the folder's own fd, so a link inside is removed itself, never followed; a folder nested inside is
+ * left (and with it the folder - nothing outside is ever reached) */
+static inline int rstore_rmtree(const char *base, const char *sub, const char *name)
+{
+	DIR *d;
+	struct dirent *e;
+	int dfd, cfd;
+
+	if (!rstore_leaf_ok(name) || (dfd = rstore_open_sub(base, sub)) < 0) return -1;
+	cfd = openat(dfd, name, O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC);
+	if (cfd < 0) {			/* not a folder: a file or a link at the name goes, nothing else */
+		unlinkat(dfd, name, 0);
+		close(dfd);
+		return 0;
+	}
+	if ((d = fdopendir(cfd)) == NULL) { close(cfd); close(dfd); return -1; }
+	while ((e = readdir(d)) != NULL)
+		if (strcmp(e->d_name, ".") && strcmp(e->d_name, ".."))
+			unlinkat(cfd, e->d_name, 0);
+	closedir(d);
+	unlinkat(dfd, name, AT_REMOVEDIR);
+	close(dfd);
+	return 0;
+}
+
+/* create <name> in the base with text, only when absent (the "collecting since" stamps) */
+static inline int rstore_stamp(const char *base, const char *name, const char *text)
+{
+	int dfd, fd, r = 0;
+	size_t l = strlen(text);
+
+	if (!rstore_leaf_ok(name) || (dfd = rstore_open_base(base)) < 0) return -1;
+	fd = openat(dfd, name, O_WRONLY | O_CREAT | O_EXCL | O_NOFOLLOW | O_CLOEXEC, 0600);
+	close(dfd);
+	if (fd < 0) return errno == EEXIST ? 0 : -1;
+	if (write(fd, text, l) != (ssize_t)l) r = -1;
+	if (close(fd) != 0) r = -1;
+	return r;
+}
+
+#endif /* _REAPER_STORE_IO_H_ */
