+int reaper_secure_dir_for(const char *path, mode_t mode, uid_t uid, gid_t gid)
+{
+	struct stat st;
+
+	if (!path || !*path)
+		return -1;
+	if (mkdir(path, mode) != 0 && errno != EEXIST)
+		return -1;
+	if (lstat(path, &st) != 0)
+		return -1;
+	if (!S_ISDIR(st.st_mode) || (st.st_uid != uid && st.st_uid != geteuid())) {
+		char aside[256];
+		snprintf(aside, sizeof(aside), "%s.bad.%d", path, (int)getpid());
+		syslog(LOG_WARNING, "reaper: %s was not the expected directory (%s, uid %d) - moved aside to %s",
+		       path, S_ISLNK(st.st_mode) ? "symlink" : S_ISDIR(st.st_mode) ? "directory" : "file",
+		       (int)st.st_uid, aside);
+		if (rename(path, aside) != 0 || mkdir(path, mode) != 0)
+			return -1;
+	}
+	/* lstat said a real directory in a parent only root can change: no redirection */
+	if (chown(path, uid, gid) != 0 || chmod(path, mode) != 0)
+		return -1;
+	return 0;
+}
