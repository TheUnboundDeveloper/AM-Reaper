From 540ffe05d581d34c9021441277cdeaec86816608 Mon Sep 17 00:00:00 2001
From: reaper <theunbounddeveloper@outlook.com>
Date: Wed, 14 Oct 2026 09:43:12 -0400
Subject: [PATCH] kernel: linearize a non-GSO skb with more than four page
 frags before the Runner

The Runner's CPU-TX path takes at most RUNNER_MAX_SG_FRAGS (4) page frags
per non-GSO skb (closed bdmf.o); the prebuilt enet caller treats a refusal
as "already freed" and counts tx_dropped - "skb->nr_frags N exceed
max_sg_array 4" is a dropped packet, and its retransmit, a clone with the
same frags, is dropped again. enet advertises NETIF_F_SG and has no
ndo_features_check, so nothing linearized for it. TCP adds one frag per
write it cannot merge; stubby (one thread, small TLS records, several
upstreams, Nagle on) builds 5-10 frag skbs once the upstream RTT is long:
GT-BE98 field, IPv6 DNS-over-TLS through a 6in4 tunnel (route64 and HE
alike), lines 1:1 with eth1 tx_dropped. netif_skb_features() clears
NETIF_F_SG for a non-GSO skb with more frags than net.core.reaper_tx_sg_max
(4; 0 = stock) so validate_xmit_skb() linearizes exactly those skbs (at
most one MSS); net.core.reaper_tx_sg_linearized counts how often it fired.
CONFIG_BCM_XRDP-guarded; no struct change. Owner RT-BE96U metal: the cap
fires and every transfer completes; stock BE96U LAN ports accept such skbs
so the drop-stops proof belongs to the GT-BE98. No-build workaround for an
older image: net.core.max_skb_frags=4. Lean: tests/test_kernel_runner_sg_cap.py,
reaper_verify section 28 (the sysctl names in vmlinux).

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 .../linux-4.19/include/linux/netdevice.h      |  5 +++
 .../kernel/linux-4.19/net/core/dev.c          | 31 ++++++++++++++++
 .../linux-4.19/net/core/sysctl_net_core.c     | 36 +++++++++++++++++++
 3 files changed, 72 insertions(+)

diff --git a/release/src-rt-5.04behnd.4916/kernel/linux-4.19/include/linux/netdevice.h b/release/src-rt-5.04behnd.4916/kernel/linux-4.19/include/linux/netdevice.h
index fc3f2edd19..84553f5bbc 100755
--- a/release/src-rt-5.04behnd.4916/kernel/linux-4.19/include/linux/netdevice.h
+++ b/release/src-rt-5.04behnd.4916/kernel/linux-4.19/include/linux/netdevice.h
@@ -3699,6 +3699,11 @@ void dev_queue_xmit_nit(struct sk_buff *skb, struct net_device *dev);
 
 extern int		netdev_budget;
 extern unsigned int	netdev_budget_usecs;
+#if defined(CONFIG_BCM_XRDP)
+/* Reaper: Runner 4-frag transmit cap, see netif_skb_features() */
+extern int sysctl_reaper_tx_sg_max;
+extern atomic_long_t reaper_tx_sg_linearized;
+#endif
 
 /* Called by rtnetlink.c:rtnl_unlock() */
 void netdev_run_todo(void);
diff --git a/release/src-rt-5.04behnd.4916/kernel/linux-4.19/net/core/dev.c b/release/src-rt-5.04behnd.4916/kernel/linux-4.19/net/core/dev.c
index aca36bb73b..5a112742fe 100644
--- a/release/src-rt-5.04behnd.4916/kernel/linux-4.19/net/core/dev.c
+++ b/release/src-rt-5.04behnd.4916/kernel/linux-4.19/net/core/dev.c
@@ -3207,6 +3207,24 @@ static netdev_features_t dflt_features_check(struct sk_buff *skb,
 	return vlan_features_check(skb, features);
 }
 
+/* Reaper: the Runner's CPU-TX path takes at most RUNNER_MAX_SG_FRAGS (4) page
+ * frags per non-GSO skb (closed bdmf.o; rdp/projects/BCM6813/target/bdmf/
+ * system/linux/ce/bdmf_system.h). The prebuilt enet caller treats a refusal
+ * as "already freed" and counts tx_dropped ("skb->nr_frags N exceed
+ * max_sg_array 4"), and enet has no ndo_features_check, so nothing
+ * linearizes for it. TCP adds one frag per write
+ * it cannot merge: stubby (one thread, small TLS records, several upstreams,
+ * Nagle on) builds 5-10 frag skbs once the upstream RTT is long, e.g. IPv6 DoT
+ * through a 6in4 tunnel, and every such packet and its retransmit was dropped.
+ * netif_skb_features() clears NETIF_F_SG for those skbs so validate_xmit_skb()
+ * linearizes them (at most one MSS). net.core.reaper_tx_sg_max: 0 = stock;
+ * net.core.reaper_tx_sg_linearized counts how often the cap fired.
+ */
+#if defined(CONFIG_BCM_XRDP)
+int sysctl_reaper_tx_sg_max __read_mostly = 4;
+atomic_long_t reaper_tx_sg_linearized;
+#endif
+
 static netdev_features_t gso_features_check(const struct sk_buff *skb,
 					    struct net_device *dev,
 					    netdev_features_t features)
@@ -3266,6 +3284,19 @@ netdev_features_t netif_skb_features(struct sk_buff *skb)
 	else
 		features &= dflt_features_check(skb, dev, features);
 
+#if defined(CONFIG_BCM_XRDP)
+	{
+		int cap = READ_ONCE(sysctl_reaper_tx_sg_max);
+
+		if (unlikely(cap && !skb_is_gso(skb) &&
+			     skb_shinfo(skb)->nr_frags > cap &&
+			     (features & NETIF_F_SG))) {
+			features &= ~NETIF_F_SG;
+			atomic_long_inc(&reaper_tx_sg_linearized);
+		}
+	}
+#endif
+
 	return harmonize_features(skb, features);
 }
 EXPORT_SYMBOL(netif_skb_features);
diff --git a/release/src-rt-5.04behnd.4916/kernel/linux-4.19/net/core/sysctl_net_core.c b/release/src-rt-5.04behnd.4916/kernel/linux-4.19/net/core/sysctl_net_core.c
index d7e39167ce..28f13f2966 100644
--- a/release/src-rt-5.04behnd.4916/kernel/linux-4.19/net/core/sysctl_net_core.c
+++ b/release/src-rt-5.04behnd.4916/kernel/linux-4.19/net/core/sysctl_net_core.c
@@ -309,6 +309,25 @@ proc_dolongvec_minmax_bpf_restricted(struct ctl_table *table, int write,
 }
 #endif
 
+#if defined(CONFIG_BCM_XRDP)
+/* Reaper: read-only view of the Runner 4-frag cap counter (see dev.c) */
+static int proc_reaper_tx_sg_linearized(struct ctl_table *table, int write,
+					void __user *buffer, size_t *lenp,
+					loff_t *ppos)
+{
+	unsigned long val = atomic_long_read(&reaper_tx_sg_linearized);
+	struct ctl_table tmp = {
+		.data	= &val,
+		.maxlen	= sizeof(val),
+		.mode	= table->mode,
+	};
+
+	if (write)
+		return -EPERM;
+	return proc_doulongvec_minmax(&tmp, write, buffer, lenp, ppos);
+}
+#endif
+
 static struct ctl_table net_core_table[] = {
 #ifdef CONFIG_NET
 	{
@@ -532,6 +551,23 @@ static struct ctl_table net_core_table[] = {
 		.extra1		= &one,
 		.extra2		= &max_skb_frags,
 	},
+#if defined(CONFIG_BCM_XRDP)
+	{
+		.procname	= "reaper_tx_sg_max",
+		.data		= &sysctl_reaper_tx_sg_max,
+		.maxlen		= sizeof(int),
+		.mode		= 0644,
+		.proc_handler	= proc_dointvec_minmax,
+		.extra1		= &zero,
+		.extra2		= &max_skb_frags,
+	},
+	{
+		.procname	= "reaper_tx_sg_linearized",
+		.maxlen		= sizeof(unsigned long),
+		.mode		= 0444,
+		.proc_handler	= proc_reaper_tx_sg_linearized,
+	},
+#endif
 	{
 		.procname	= "netdev_budget_usecs",
 		.data		= &netdev_budget_usecs,
-- 
2.25.1

