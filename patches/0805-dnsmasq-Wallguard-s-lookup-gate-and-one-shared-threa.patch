+
+/* reaper 2026-10-24: the record itself - "<epoch> <client> <listed domain> <feed ids>" - written for
+   the server-array entries above (feeds "-") and for the mapped table (reaper_nx.c). The listed
+   name is lower-cased: the collector takes [a-z0-9.-] only. */
+void reaper_hit_rec(const char *listed, const char *feeds, union mysockaddr *client)
 {
   static time_t win;
   static int used;
   static unsigned int dropped;
-  struct server *s;
   struct stat st;
-  char ip[INET6_ADDRSTRLEN], line[64 + INET6_ADDRSTRLEN + MAXDNAMESTR];
+  char ip[INET6_ADDRSTRLEN], line[64 + INET6_ADDRSTRLEN + MAXDNAMESTR + 800], lst[MAXDNAMESTR + 1];
   time_t now;
   int fd, n = 0;
+  size_t i;
 
-  if (!daemon->reaper_hitlog || first < 0 || first >= daemon->serverarraysz)
-    return;
-  s = daemon->serverarray[first];
-  if (!(s->flags & SERV_REAPER_NX) || !s->domain)
+  if (!daemon->reaper_hitlog || !listed || !*listed)
     return;
+  for (i = 0; i < sizeof(lst) - 1 && listed[i]; i++)
+    lst[i] = (listed[i] >= 'A' && listed[i] <= 'Z') ? listed[i] + 32 : listed[i];
+  lst[i] = 0;
 
   now = time(NULL);
   if (now != win)
@@ -834,7 +849,7 @@ void reaper_hit(int first, union mysockaddr *client)
     {
