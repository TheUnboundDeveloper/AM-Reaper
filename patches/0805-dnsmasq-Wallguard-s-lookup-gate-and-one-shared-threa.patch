diff --git a/release/src/router/dnsmasq/src/reaper_nx.c b/release/src/router/dnsmasq/src/reaper_nx.c
new file mode 100644
index 00000000000..f790c109364
--- /dev/null
+++ b/release/src/router/dnsmasq/src/reaper_nx.c
@@ -0,0 +1,125 @@
+/* SPDX-License-Identifier: GPL-2.0-only
+   Copyright (C) 2026 the Reaper project maintainer
+   Part of the Reaper hardened Asuswrt-Merlin build. See LICENSE / LICENSE.reaper.
+
+   reaper_nx.c - Dreadwatch's threat-domain table (2026-10-24).
+
+   The threat list used to reach dnsmasq as --reaper-nx=/host/ lines: one struct server per
+   name in EVERY instance (~54 bytes a name) plus the 21 MB text file in tmpfs, so with four
+   instances the same 683k names lived in RAM five times (~125 MB on the RT-BE96U; the 1 GB
+   RT-BE88U is the budget). Now rc compiles the list with wallguardc into one table in Wallguard's
+   format (wallguard_db.h: sorted 64-bit FNV-1a hashes with list bits, every entry covering its
+   subdomains) and every instance maps it read-only, MAP_SHARED: one physical copy for all of
+   them, ~12 bytes a name, no text copy. The list bits name the feeds (the table's list ids).
+
+   Semantics are the ones --reaper-nx had: NXDOMAIN for the listed name and its subdomains
+   (NOERR for a name dnsmasq knows locally, as address=/x/ does); one hit record per answer
+   (--reaper-hitlog, now with the feed ids); a name dnsmasq answers itself from a config entry
+   of equal or longer domain (local=, address=, an explicit server=/zone/) keeps that answer.
+   The judge runs where the server-array entries used to answer - forward.c, after
+   lookup_domain and before any forward - so the cache stays in front of it exactly as before
+   and rc still restarts dnsmasq when the list changes. A missing or damaged table blocks
+   nothing and is logged once: the resolver never fails over the block list. */
+#include "dnsmasq.h"
+#include "wallguard_db.h"
+#include <sys/mman.h>
+
+#define NX_RECHECK 2		/* seconds between stat()s of the table (Wallguard's cadence) */
+
+static struct {
+  struct wallguard_table t;		/* wallguard_db.h: the mapper Wallguard uses too (review 2026-10-24, Q-A-9) */
+  time_t checked;
+} nx;
+
+/* map the table, or pick up a new one rc renamed into place (mtime / inode change) */
+static void nx_map(time_t now)
+{
+  if (!daemon->reaper_nx_db || (nx.checked && now - nx.checked < NX_RECHECK))
+    return;
+  nx.checked = now;
+  switch (wallguard_table_refresh(&nx.t, daemon->reaper_nx_db))
+    {
+    case -1:
+      /* review 2026-10-24 (Q-A-3): rc rebuilds the table in the background at boot, so an instance can start before
+         it exists - that is not a fault and is not logged; a table that was mapped and then went away is */
+      my_syslog(LOG_WARNING, _("reaper-nx-db: %s is not there - the threat list blocks nothing until rc rebuilds it"), daemon->reaper_nx_db);
+      break;
+    case 1:
+      if (!nx.t.ok)
+	my_syslog(LOG_WARNING, _("reaper-nx-db: the threat table is damaged - blocking nothing until rc rebuilds it"));
+      else
+	my_syslog(LOG_INFO, _("reaper-nx-db: %u threat names mapped"), nx.t.v.nblock);
+      break;
+    }
+}
+
+/* The longest listed suffix of name, matched as --reaper-nx did: the name itself, or a listed
+   parent whose entry covers subdomains (every entry rc compiles does; the flag is honoured
+   anyway). An allow entry, should a table ever carry one, wins. Returns the suffix length
+   (0 = not listed); *bits = its list bits, *at = where the suffix starts inside name. */
+static size_t nx_longest(const char *name, uint32_t *bits, const char **at)
+{
+  size_t n = 0;
+
+  if (!nx.t.ok || wallguard_walk(&nx.t.v, name, bits, at, &n, 1) != WALLGUARD_LISTED)
+    return 0;
+  return n;
+}
+
+/* the feed ids behind a set of list bits, comma-joined ("-" when the table names none) */
+static void nx_feeds(uint32_t bits, char *out, size_t n)
+{
+  size_t len = 0;
+  int i;
+
+  out[0] = 0;
+  for (i = 0; i < WALLGUARD_LISTS && len + WALLGUARD_LISTNAME + 2 < n; i++)
+    if ((bits & (1u << i)) && nx.t.v.h->lists[i][0])
+      len += (size_t)snprintf(out + len, n - len, "%s%.*s", len ? "," : "", WALLGUARD_LISTNAME, nx.t.v.h->lists[i]);
+  if (!out[0])
+    strcpy(out, "-");
+}
+
+/* forward.c, right after the server-array search: matched = lookup_domain found an entry (first
+   is then its index; *flags = what is_local_answer made of it). A listed suffix longer than that
+   entry's domain turns the query into the --reaper-nx answer - the longest entry wins, as it did
+   when the names were entries themselves, whatever the shorter one was (address=, local=, a
+   zone's server=): NXDOMAIN - NOERR for a name dnsmasq knows locally, as address=/x/ does - and
+   one hit record naming the listed entry and its feeds. Returns 1 when it answered. */
+int reaper_nx_judge(time_t now, int matched, int first, char *name, unsigned int *flags, union mysockaddr *client)
+{
+  uint32_t bits = 0;
+  const char *at = NULL;
+  size_t ml;
+  char feeds[WALLGUARD_LISTS * (WALLGUARD_LISTNAME + 1) + 2];
+
+  if (!daemon->reaper_nx_db)
+    return 0;
+  nx_map(now);
+  if (!nx.t.ok)
+    return 0;
+  if (!(ml = nx_longest(name, &bits, &at)))
+    return 0;
+  if (matched && first >= 0 && first < daemon->serverarraysz &&
+      (size_t)daemon->serverarray[first]->domain_len >= ml)
+    return 0;			/* a config entry of equal or longer domain owns this name */
+  *flags = check_for_local_domain(name, now) ? F_NOERR : F_NXDOMAIN;
+  if (*flags & F_NXDOMAIN)
+    {
+      nx_feeds(bits, feeds, sizeof(feeds));
+      reaper_hit_rec(at, feeds, client);
+    }
+  return 1;
+}
+
+/* wallguard.c: a listed name is dnsmasq's own answer, so Dreadwatch keeps winning over Wallguard */
+int reaper_nx_listed(const char *name)
+{
+  uint32_t bits = 0;
+  const char *at = NULL;
+
+  if (!daemon->reaper_nx_db)
+    return 0;
+  nx_map(dnsmasq_time());
+  return nx_longest(name, &bits, &at) > 0;
+}
