 	n = snprintf(line, sizeof(line), "# dropped %u\n", dropped);
-      n += snprintf(line + n, sizeof(line) - n, "%ld %s %s\n", (long)now, ip, s->domain);
+      n += snprintf(line + n, sizeof(line) - n, "%ld %s %s %s\n", (long)now, ip, lst, feeds ? feeds : "-");
       if (n > 0 && (size_t)n < sizeof(line) && write(fd, line, n) == n)
 	dropped = 0;
     }
diff --git a/release/src/router/dnsmasq/src/edns0.c b/release/src/router/dnsmasq/src/edns0.c
index 94881c2bc7a..f1ddb6efbc5 100644
--- a/release/src/router/dnsmasq/src/edns0.c
+++ b/release/src/router/dnsmasq/src/edns0.c
@@ -554,14 +554,103 @@ static size_t add_umbrella_opt(struct dns_header *header, size_t plen, size_t ou
   return add_pseudoheader(header, plen, outlen, EDNS0_OPTION_UMBRELLA, (unsigned char *)&opt, u - (u8 *)&opt, 0, 1);
 }
 
-/* Set *check_subnet if we add a client subnet option, which needs to checked 
+/* reaper 2026-10-21: Encrypted DNS. rednsd (the router's own DNS-over-TLS server)
+   forwards each device's query over loopback, so dnsmasq sees 127.0.0.1. It names the
+   device in EDNS0_OPTION_REAPER_CLIENT (1 byte family, 1 = IPv4 / 2 = IPv6, then the
+   address) so reaper_hit() can record the device. The option is believed only from a
+   loopback source - a LAN host cannot send from 127.0.0.0/8 - and it is cut out of every
+   query whatever the source, so it never reaches an upstream server. Only that option
+   is touched: no OPT RR is added, nothing else in it changes. */
+static union mysockaddr reaper_real;
+static union mysockaddr *reaper_real_for;
+
+static int reaper_from_loopback(union mysockaddr *source)
+{
+  if (source->sa.sa_family == AF_INET)
+    return (ntohl(source->in.sin_addr.s_addr) >> 24) == 127;
+  if (source->sa.sa_family == AF_INET6)
+    return IN6_IS_ADDR_LOOPBACK(&source->in6.sin6_addr);
+  return 0;
+}
+
+static size_t reaper_take_client(struct dns_header *header, size_t plen, union mysockaddr *source)
+{
+  unsigned char *udp, *lenp, *data, *q, *end;
+  unsigned short rdlen, code, len;
+  int is_sign, i;
+
+  reaper_real_for = NULL;
+
+  if (!find_pseudoheader(header, plen, NULL, &udp, &is_sign, NULL) || is_sign)
+    return plen;
+
+  /* udp points at the CLASS field: CLASS(2) TTL(4) RDLEN(2) RDATA */
+  lenp = udp + 6;
+  data = lenp + 2;
+  rdlen = (lenp[0] << 8) | lenp[1];
+  end = ((unsigned char *)header) + plen;
+  if (data + rdlen > end)
+    return plen;
+
+  for (i = 0; i + 4 <= rdlen; )
+    {
+      q = data + i;
+      code = (q[0] << 8) | q[1];
+      len = (q[2] << 8) | q[3];
+      if (i + 4 + len > rdlen)
+	break;	/* malformed: leave it to the rest of dnsmasq */
+      if (code != EDNS0_OPTION_REAPER_CLIENT)
+	{
+	  i += 4 + len;
+	  continue;
+	}
+      if (reaper_from_loopback(source))
+	{
+	  if (len == 5 && q[4] == 1)
+	    {
+	      memset(&reaper_real, 0, sizeof(reaper_real));
+	      reaper_real.in.sin_family = AF_INET;
+	      memcpy(&reaper_real.in.sin_addr, q + 5, 4);
+	      reaper_real_for = source;
+	    }
+	  else if (len == 17 && q[4] == 2)
+	    {
+	      memset(&reaper_real, 0, sizeof(reaper_real));
+	      reaper_real.in6.sin6_family = AF_INET6;
+	      memcpy(&reaper_real.in6.sin6_addr, q + 5, 16);
+	      reaper_real_for = source;
+	    }
+	}
+      /* cut the option out; anything after it in the packet moves up */
+      memmove(q, q + 4 + len, end - (q + 4 + len));
+      rdlen -= 4 + len;
+      plen -= 4 + len;
+      end -= 4 + len;
+      lenp[0] = rdlen >> 8;
+      lenp[1] = rdlen & 0xff;
+    }
+
+  return plen;
+}
+
+/* The device a reaper_hit() should record: the one rednsd named for this query, else
+   the address the query came from. Tied to the very address object the caller passed to
+   add_edns0_config(), so a retry or another query never inherits it. */
+union mysockaddr *reaper_client(union mysockaddr *addr)
+{
+  return (addr && addr == reaper_real_for) ? &reaper_real : addr;
+}
+
+/* Set *check_subnet if we add a client subnet option, which needs to checked
    in the reply. Set *cacheable to zero if we add an option which the answer
    may depend on. */
-size_t add_edns0_config(struct dns_header *header, size_t plen, size_t outlen, 
-			union mysockaddr *source, time_t now, int *cacheable)    
+size_t add_edns0_config(struct dns_header *header, size_t plen, size_t outlen,
+			union mysockaddr *source, time_t now, int *cacheable)
 {
   *cacheable = 1;
-  
+
+  plen = reaper_take_client(header, plen, source);
+
   plen  = add_mac(header, plen, outlen, source, now, cacheable);
   plen = add_dns_client(header, plen, outlen, source, now, cacheable);
   
