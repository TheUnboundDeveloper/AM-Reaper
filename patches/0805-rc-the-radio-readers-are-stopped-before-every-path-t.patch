diff --git a/release/src/router/rc/services.c b/release/src/router/rc/services.c
index 8face7686c..470a5b8ee6 100644
--- a/release/src/router/rc/services.c
+++ b/release/src/router/rc/services.c
@@ -8194,6 +8194,46 @@ start_rpunctd(void)
 	xstart("rpunctd");
 }
 
+/* reaper 2026-10-14: the radio readers as one unit. rpunctd arms a 4 s
+ * chanim_stats window on every Dynamic radio each tick, reaper_bwfloor reads
+ * isup / chanspec / dfs_status every 15 s (and may restart acsd), rchqd reads
+ * chanim_stats every 10 s. None of them may touch a dongle that rc is in the
+ * middle of stopping: restart_wireless() has stopped the first two since
+ * v3.2.8, but the net / allnet / net_and_phy / wps_enr branches tear the
+ * radios down without that, and they never drop wlready, so rpunctd's own
+ * guard was blind. Owner RT-BE96U, 2026-10-13 and 2026-10-14: a GUI IPv6
+ * change ran restart_net, and 7 s into the teardown both Dynamic radios'
+ * firmware trapped (dhdpcie_checkdied, TRAP type 0x4 @ 0x80f084 on wl1 and
+ * wl2 alike); they answered "wl driver adapter not found" until a power
+ * cycle. wl0, which none of the readers touched, survived both times.
+ * Called right before stop_acsd() and right after start_acsd(): acsd is the
+ * stock daemon of the same class, and stock already sequences it against
+ * every teardown, so pairing with it keeps a future branch honest. */
+void
+reaper_wl_readers_stop(void)
+{
+	int armed = pids("rpunctd");
+
+	stop_rpunctd();
+	stop_reaper_bwfloor();
+	stop_rchqd();
+	if (armed) {
+		/* a window rpunctd armed just before the kill runs on in the firmware
+		 * for up to REAPER_WL_WINDOW_MS: let it close before the teardown */
+		logmessage("reaper", "radio readers stopped for a wireless teardown (waiting out an armed measurement window)");
+		usleep((REAPER_WL_WINDOW_MS + 600) * 1000);
+	} else
+		logmessage("reaper", "radio readers stopped for a wireless teardown");
+}
+
+void
+reaper_wl_readers_start(void)
+{
+	start_rpunctd();		/* no-op unless a radio is Dynamic */
+	start_reaper_bwfloor();	/* no-op while every wlN_bwfloor is off */
+	start_rchqd();		/* no-op unless rchq_enable, router mode */
+}
+
