 #ifdef RTCONFIG_NOTIFICATION_CENTER
@@ -21435,6 +21482,7 @@ check_ddr_done:
 				nvram_set(strcat_r(prefix, "mfp", tmp), "1");
 				nvram_unset("skip_init_run_wpas");
