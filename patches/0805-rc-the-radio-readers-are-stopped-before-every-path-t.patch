 	nvram_set_int("amas_ready", 0);
 #endif
@@ -7122,8 +7122,7 @@ void restart_wireless(void)
 	nvram_set_int("wlready", 1);
 	timecheck();
 #endif
-	start_rpunctd();	/* reaper v3.2.8: stopped at the top; a no-op unless a radio is Dynamic */
