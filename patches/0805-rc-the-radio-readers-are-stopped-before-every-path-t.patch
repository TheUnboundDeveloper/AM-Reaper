diff --git a/release/src/router/shared/reaper_wlquiet.c b/release/src/router/shared/reaper_wlquiet.c
new file mode 100644
index 0000000000..d9f9c369aa
--- /dev/null
+++ b/release/src/router/shared/reaper_wlquiet.c
@@ -0,0 +1,58 @@
+/* reaper 2026-10-14: is rc tearing the radios down right now?
+ *
+ * The radio readers - rpunctd (arms a 4 s chanim_stats window on every Dynamic
+ * radio each tick), reaper_bwfloor (isup / chanspec / dfs_status every 15 s)
+ * and rchqd (chanim_stats every 10 s) - must not send a wl ioctl into a dongle
+ * that rc is in the middle of stopping. Owner RT-BE96U, 2026-10-13 and
+ * 2026-10-14: a GUI IPv6 change ran restart_net; seven seconds into the
+ * teardown both Dynamic radios' firmware trapped (dhdpcie_checkdied, TRAP type
+ * 0x4 @ 0x80f084, identical on wl1 and wl2) and they answered "wl driver
+ * adapter not found" until a power cycle; wl0, which none of the readers
+ * touched, survived both times. The GT-BE98 report of 2026-09-28 (a trap one
+ * second into a restart_wireless) is the same shape.
+ *
+ * rc stops the readers first (reaper_wl_readers_stop in services.c). This is
+ * the readers' own eye on the same thing, for a start that lands inside such a
+ * window: it keys on rc_service, which the net / allnet / net_and_phy /
+ * wps_enr branches hold for their whole run while never touching wlready, the
+ * flag restart_wireless drops and the readers already honour.
+ */
+#include <string.h>
+#include <bcmnvram.h>
+#include "reaper_wlquiet.h"
+
+/* every rc service that stops or restarts the radios; whole tokens of
+ * rc_service ("action_script", several joined by ';' or ' ') */
+static const char *const reaper_wl_teardown_svc[] = {
+	"restart_net", "restart_allnet", "restart_net_and_phy",
+	"restart_wireless", "restart_dsl_wireless", "restart_wps_enr",
+	"restart_nas", "restart_wlcconnect", "restart_modemscan",
+	NULL
+};
+
+int reaper_wl_tearing_down(void)
+{
+	const char *rs = nvram_safe_get("rc_service");
+	int i;
+
+	if (!*rs)
+		return 0;
+	for (i = 0; reaper_wl_teardown_svc[i]; i++) {
+		const char *svc = reaper_wl_teardown_svc[i];
+		size_t n = strlen(svc);
+		const char *p = rs;
+
+		while ((p = strstr(p, svc)) != NULL) {
+			if ((p == rs || p[-1] == ';' || p[-1] == ' ') &&
+			    (p[n] == 0 || p[n] == ';' || p[n] == ' '))
+				return 1;	/* restart_nas, never restart_nasapps */
+			p += n;
+		}
+	}
+	return 0;
+}
+
+int reaper_wl_quiet(void)
+{
+	return !nvram_match("wlready", "1") || reaper_wl_tearing_down();
+}
diff --git a/release/src/router/shared/reaper_wlquiet.h b/release/src/router/shared/reaper_wlquiet.h
new file mode 100644
index 0000000000..0334576609
--- /dev/null
+++ b/release/src/router/shared/reaper_wlquiet.h
@@ -0,0 +1,15 @@
+/* reaper 2026-10-14: "is rc tearing the radios down right now?" - the one
+ * answer the radio readers (rpunctd, reaper_bwfloor, rchqd) and rc share.
+ * See reaper_wlquiet.c. */
+#ifndef REAPER_WLQUIET_H
+#define REAPER_WLQUIET_H
+
+/* 1 while rc_service names a service that stops or restarts the radios
+ * (restart_net, restart_allnet, restart_net_and_phy, restart_wireless, ...) */
+int reaper_wl_tearing_down(void);
+
+/* 1 when no radio ioctl should be sent: wlready is not 1, or rc is tearing
+ * the radios down (the branches that do so without ever dropping wlready) */
+int reaper_wl_quiet(void);
+
+#endif
