  * 2 = wireless down (geometry is re-read after), 1 = applier waiting, 0 = go. */
 static int radio_quiet(void)
 {
-	if (!nvram_match("wlready", "1")) return 2;
+	if (reaper_wl_quiet()) return 2;
 	if (pids(RP_APPLIER_NAME)) return 1;
