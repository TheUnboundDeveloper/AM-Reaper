From af1d214e1282de0bb3a9347c040462bd2c6dbfd3 Mon Sep 17 00:00:00 2001
From: reaper <theunbounddeveloper@outlook.com>
Date: Sun, 25 Oct 2026 22:49:04 -0400
Subject: [PATCH] dreadwatch: the frozen ThreatFox snapshot behind Reaper's
 Basics

abuse.ch closed its keyless hostfiles (HTTP 410). Dreadwatch moved to free
lists, and the last keyless ThreatFox host list (21 Oct 2026) ships as a fixed
snapshot inside the built-in "Reaper's Basics" row. Installed to
/usr/share/dreadwatch; third-party threat data, never edited.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 release/src/router/dreadwatch/Makefile        |    16 +
 .../router/dreadwatch/threatfox-snapshot.txt  | 30806 ++++++++++++++++
 2 files changed, 30822 insertions(+)
 create mode 100644 release/src/router/dreadwatch/Makefile
 create mode 100755 release/src/router/dreadwatch/threatfox-snapshot.txt

diff --git a/release/src/router/dreadwatch/Makefile b/release/src/router/dreadwatch/Makefile
new file mode 100644
index 00000000000..0a424ed826f
--- /dev/null
+++ b/release/src/router/dreadwatch/Makefile
@@ -0,0 +1,16 @@
+# SPDX-License-Identifier: GPL-2.0-only
+# Copyright (C) 2026 the Reaper project maintainer
+# Part of the Reaper hardened Asuswrt-Merlin build. See LICENSE / LICENSE.reaper.
+# dreadwatch: data shipped with Warden > Dreadwatch (nothing to compile). threatfox-snapshot.txt is
+# ThreatFox's last free hostfile (abuse.ch, 2026-10-21): abuse.ch closed its free downloads that day, and
+# the owner chose to keep that last list as part of Reaper's Basics. One host name per line, read by rc's
+# updater (rw_dom in rc/rwarden.c), never fetched, never updated.
+include ../common.mak
+
+all:
+
+clean:
+
+install: all
+	@echo " [dreadwatch] Installing..."
+	install -D -m 0644 threatfox-snapshot.txt $(INSTALLDIR)/usr/share/dreadwatch/threatfox-snapshot.txt
diff --git a/release/src/router/dreadwatch/threatfox-snapshot.txt b/release/src/router/dreadwatch/threatfox-snapshot.txt
new file mode 100755
index 00000000000..7e1ad0dcf90
--- /dev/null
+++ b/release/src/router/dreadwatch/threatfox-snapshot.txt
