+/* ---- setup */
+
+static int bind_listener(struct listener *l)
+{
+	sockaddr_u a;
+	int fd, one = 1;
+
+	if (sa_from_str(l->addr, l->port, &a))
+		return -1;
+	if ((fd = socket(a.sa.sa_family, SOCK_STREAM | SOCK_CLOEXEC, 0)) < 0)
+		return -1;
+	setsockopt(fd, SOL_SOCKET, SO_REUSEADDR, &one, sizeof(one));
+	if (a.sa.sa_family == AF_INET6)
+		setsockopt(fd, IPPROTO_IPV6, IPV6_V6ONLY, &one, sizeof(one));
+	/* a WAN or SDN address may come and go: bind it even if it is not up yet */
+	setsockopt(fd, IPPROTO_IP, IP_FREEBIND, &one, sizeof(one));
+	if (bind(fd, &a.sa, sa_len(&a)) || listen(fd, 64) || set_nonblock(fd)) {
+		l->err = errno;
+		close(fd);
+		return -1;
+	}
+	l->fd = fd;
+	return 0;
+}
+
+static int udp_socket(int family)
+{
+	sockaddr_u a;
+	int fd = socket(family, SOCK_DGRAM | SOCK_CLOEXEC | SOCK_NONBLOCK, 0);
+
+	if (fd < 0)
+		return -1;
+	memset(&a, 0, sizeof(a));
+	a.sa.sa_family = family;
+	/* from loopback: the only source dnsmasq believes the client option from */
+	if (family == AF_INET)
+		a.in.sin_addr.s_addr = htonl(INADDR_LOOPBACK);
+	else
+		a.in6.sin6_addr = in6addr_loopback;
+	if (bind(fd, &a.sa, sa_len(&a))) {
+		close(fd);
+		return -1;
+	}
+	return fd;
+}
+
+static void drop_privileges(void)
+{
+	struct passwd *pw = getpwnam("nobody");
+	struct rlimit rl = { 512, 512 };
+
+	setrlimit(RLIMIT_NOFILE, &rl);
+	if (getuid() != 0)
+		return;
+	if (!pw) {	/* review 2026-10-24 (S-A-9): never keep root for want of the account */
+		logmsg(LOG_ERR, "rednsd: no 'nobody' account - stopping rather than serving as root");
+		exit(1);
+	}
+	if (setgroups(0, NULL) || setgid(pw->pw_gid) || setuid(pw->pw_uid)) {
+		logmsg(LOG_ERR, "rednsd: cannot drop to nobody, stopping");
+		exit(1);
+	}
+	prctl(PR_SET_NO_NEW_PRIVS, 1, 0, 0, 0);
+}
+
+static void on_term(int s) { (void)s; got_term = 1; }
+static void on_hup(int s) { (void)s; got_hup = 1; }
+static void on_usr1(int s) { (void)s; got_usr1 = 1; }
+
+#ifndef RED_TEST
+int main(int argc, char **argv)
+{
+	int i, opt, foreground = 0, bound = 0;
+	long long next_status;
+	char pidfile[] = "/var/run/rednsd.pid";
+
+	while ((opt = getopt(argc, argv, "fc:")) != -1) {
+		if (opt == 'f') foreground = 1;
+		else if (opt == 'c') conf_path = optarg;
+	}
+	openlog("rednsd", LOG_PID, LOG_DAEMON);
+	if (load_conf(conf_path, &cfg, 0) || !*cfg.cert || !*cfg.key) {
+		logmsg(LOG_ERR, "rednsd: no usable configuration in %s", conf_path);
+		return 1;
+	}
+	signal(SIGPIPE, SIG_IGN);
+	signal(SIGTERM, on_term);
+	signal(SIGINT, on_term);
+	signal(SIGHUP, on_hup);
+	signal(SIGUSR1, on_usr1);	/* the page asks for fresh numbers */
+
+	if (!(ctx = tls_setup())) {
+		logmsg(LOG_ERR, "rednsd: cannot load the certificate %s / key %s", cfg.cert, cfg.key);
+		write_status("cert_error");
+		return 1;
+	}
+	cert_describe();
+	for (i = 0; i < cfg.nlisten; i++) {
+		if (bind_listener(&cfg.listen[i]) == 0)
+			bound++;
+		else
+			logmsg(LOG_WARNING, "rednsd: cannot listen on %s port %d: %s",
+			       cfg.listen[i].addr, cfg.listen[i].port, strerror(cfg.listen[i].err));
+	}
+	udp4 = udp_socket(AF_INET);
+	udp6 = udp_socket(AF_INET6);
+	if (!bound) {
+		write_status("bind_error");
+		return 1;
+	}
+	if (!foreground && daemon(0, 0))
+		return 1;
+	{
+		FILE *pf = fopen(pidfile, "w");
+		if (pf) { fprintf(pf, "%d\n", (int)getpid()); fclose(pf); }
+	}
+	drop_privileges();
+	for (i = 0; i < MAX_CONN; i++) {
+		conns[i].fd = -1;
+		conns[i].state = C_FREE;
+	}
+	for (i = 0; i < MAX_TCPRE; i++)
+		tre[i].fd = -1;
+	started = now_ms();
+	write_status("running");
+	next_status = now_ms() + STATUS_MS;
+	logmsg(LOG_NOTICE, "rednsd: encrypted DNS for devices on %d address(es)", bound);
+
+	while (!got_term) {
+		struct pollfd pfd[MAX_LISTEN + 2 + MAX_CONN + MAX_TCPRE];
+		int map[MAX_LISTEN + 2 + MAX_CONN + MAX_TCPRE], np = 0, timeout;
+		long long t = now_ms(), next = next_status;
+
+		if (got_hup) {
+			got_hup = 0;
+			if (load_conf(conf_path, &cfg, 1) == 0)
+				logmsg(LOG_NOTICE, "rednsd: peers and policy reloaded");
+			/* re-point open connections at their (possibly new) network */
+			for (i = 0; i < MAX_CONN; i++)
+				if (conns[i].state != C_FREE && !(conns[i].net = peer_of(&cfg, &conns[i].peer)))
+					conns[i].closing = 1;
+		}
+
+		/* timers: handshakes, idle connections, unanswered queries, slow TCP retries */
+		for (i = 0; i < MAX_PENDING; i++)
+			if (pend[i].used && pend[i].deadline <= t)
+				fail_query(&pend[i]);
+			else if (pend[i].used && pend[i].deadline < next)
+				next = pend[i].deadline;
+		for (i = 0; i < MAX_TCPRE; i++)
+			if (tre[i].fd >= 0 && tre[i].deadline <= t)
+				tcpre_fail(&tre[i]);
+			else if (tre[i].fd >= 0 && tre[i].deadline < next)
+				next = tre[i].deadline;
+		for (i = 0; i < MAX_CONN; i++) {
+			struct conn *c = &conns[i];
+			if (c->state == C_FREE)
+				continue;
+			if (c->state == C_HANDSHAKE && c->hs_deadline <= t) {
+				n_hs_fail++;
+				c->closing = 1;
+			}
+			if (c->state == C_OPEN && !c->inflight && c->wlen == c->woff && t - c->last >= IDLE_MS)
+				c->closing = 1;
+			if (c->closing) {
+				conn_close(c);
+				continue;
+			}
+			if (c->state == C_HANDSHAKE && c->hs_deadline < next)
+				next = c->hs_deadline;
+			if (c->state == C_OPEN && c->last + IDLE_MS < next)
+				next = c->last + IDLE_MS;
+		}
+		if (t >= next_status || got_usr1) {
+			got_usr1 = 0;
+			write_status("running");
+			next_status = t + STATUS_MS;
+		}
+
+		for (i = 0; i < cfg.nlisten; i++)
+			if (cfg.listen[i].fd >= 0) {
+				pfd[np].fd = cfg.listen[i].fd; pfd[np].events = POLLIN; map[np++] = -1 - i;
+			}
+		if (udp4 >= 0) { pfd[np].fd = udp4; pfd[np].events = POLLIN; map[np++] = -1000; }
+		if (udp6 >= 0) { pfd[np].fd = udp6; pfd[np].events = POLLIN; map[np++] = -1001; }
+		for (i = 0; i < MAX_TCPRE; i++)
+			if (tre[i].fd >= 0) {
+				pfd[np].fd = tre[i].fd; pfd[np].events = tre[i].sent ? POLLIN : POLLOUT; map[np++] = -2000 - i;
+			}
+		for (i = 0; i < MAX_CONN; i++) {
+			struct conn *c = &conns[i];
+			short ev = 0;
+			if (c->state == C_FREE)
+				continue;
+			if (c->want_write)
+				ev |= POLLOUT;
+			if (c->state == C_HANDSHAKE ? !c->want_write : c->inflight < MAX_INFLIGHT)
+				ev |= POLLIN;
+			/* ev may be 0 while the connection waits for answers: poll still
+			   reports a hang-up or an error, and nothing spins */
+			pfd[np].fd = c->fd; pfd[np].events = ev; map[np++] = i;
+		}
+		timeout = (int)(next - t);
+		if (timeout < 0) timeout = 0;
+		if (timeout > 1000) timeout = 1000;
+		if (poll(pfd, np, timeout) < 0 && errno != EINTR)
+			break;
+
+		for (i = 0; i < np; i++) {
+			if (!pfd[i].revents)
+				continue;
+			if (map[i] == -1000 || map[i] == -1001)
+				upstream_in(pfd[i].fd);
+			else if (map[i] <= -2000)
+				tcpre_io(&tre[-2000 - map[i]], pfd[i].revents);
+			else if (map[i] < 0)
+				accept_on(&cfg.listen[-1 - map[i]]);
+			else {
+				struct conn *c = &conns[map[i]];
+				if (c->state == C_HANDSHAKE)
+					conn_handshake(c);
+				else if (c->state == C_OPEN) {
+					if (c->want_write)
+						conn_flush(c);
+					if (!c->closing)
+						conn_read(c);
+				}
+				if (pfd[i].revents & (POLLERR | POLLNVAL | POLLHUP))
+					c->closing = 1;
+			}
+		}
+		/* answers that arrived may have made room for queued messages */
+		for (i = 0; i < MAX_CONN; i++)
+			if (conns[i].state == C_OPEN && !conns[i].closing && conns[i].rlen >= 2
+			    && conns[i].inflight < MAX_INFLIGHT)
+				conn_read(&conns[i]);
+	}
+
+	for (i = 0; i < MAX_CONN; i++)
+		conn_close(&conns[i]);
+	for (i = 0; i < MAX_TCPRE; i++)
+		tcpre_close(&tre[i]);
+	write_status("stopped");
+	logmsg(LOG_NOTICE, "rednsd: stopped");
+	return 0;
+}
+#endif
-- 
