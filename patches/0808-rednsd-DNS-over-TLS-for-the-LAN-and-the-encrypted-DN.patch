+# SPDX-License-Identifier: GPL-2.0-only
+# Copyright (C) 2026 the Reaper project maintainer
+# Part of the Reaper hardened Asuswrt-Merlin build. See LICENSE / LICENSE.reaper.
+# rednsd: Encrypted DNS for devices (DNS-over-TLS to the router). libc + OpenSSL 3.5
+# only - rc decides whether it runs and writes its config, so it links neither libnvram
+# nor libshared.
+include ../common.mak
+
+CFLAGS	+= -Os -Wall $(EXTRACFLAGS)
+CFLAGS	+= -I$(SRCBASE)/include -I$(TOP)/openssl/include
+# same exploit-mitigation set as rmcpd/rdnsmapd: a network-facing TLS listener
+CFLAGS	+= -D_FORTIFY_SOURCE=2 -fstack-protector-strong -Wformat -Wformat-security -fPIE
+LDFLAGS	= -L$(TOP)/openssl -lssl -lcrypto -ldl -pie -Wl,-z,relro,-z,now
+
+OBJS = rednsd.o
+
+all: rednsd
+
+rednsd: $(OBJS)
+	@echo " [rednsd] CC -o $@"
+	$(CC) -o $@ $(OBJS) $(LDFLAGS)
+
+	$(SIZECHECK)
+	$(CPTMP)
+
+clean:
+	rm -f rednsd .*.depend
+	rm -f *.o
+
+install: all
+	@echo " [rednsd] Installing..."
+	install -D rednsd $(INSTALLDIR)/usr/sbin/rednsd
+	$(STRIP) $(INSTALLDIR)/usr/sbin/rednsd
+	install -D -m 0755 encdns.sh $(INSTALLDIR)/usr/sbin/encdns.sh
+	install -D -m 0644 doh-names.txt $(INSTALLDIR)/usr/share/encdns/doh-names
+	install -D -m 0644 doh-seed.txt $(INSTALLDIR)/usr/share/encdns/doh-seed
+
+%.o: %.c .%.depend
+	@echo " [rednsd] CC $@"
+	@$(CC) $(CFLAGS) -c $<
+
+.depend: $(OBJS:%.o=%.c)
+	@$(CC) $(CFLAGS) -M $^ > .depend
+
+.%.depend: %.c
+	@$(CC) $(CFLAGS) -M $< > $@
+
+-include $(OBJS:%.o=.%.depend)
