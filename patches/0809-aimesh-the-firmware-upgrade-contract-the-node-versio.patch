 function prettyVer(s){
-  /* "3006.102.8_Reaper_v2.3.0[_noMCP]" or "Reaper_v2.3.0a" -> "Reaper v2.3.0a" */
+  /* "3006_102_8_Reaper_v2.3.0" (older "3006.102.8_Reaper_v2.3.0[_noMCP]") or "Reaper_v2.3.0a" -> "Reaper v2.3.0a" */
   var m = String(s||'').match(/Reaper_v([0-9][0-9a-z.\-]*)/);
