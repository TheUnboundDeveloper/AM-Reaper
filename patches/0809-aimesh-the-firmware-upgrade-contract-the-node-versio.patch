diff --git a/release/src/router/httpd/web.c b/release/src/router/httpd/web.c
index 041526422a..178f73b80c 100644
--- a/release/src/router/httpd/web.c
+++ b/release/src/router/httpd/web.c
@@ -46731,6 +46731,39 @@ ej_get_wiredclientlist(int eid, webs_t wp, int argc, char **argv){
 	return 0;
 }
 
+/* reaper 2026-10-15: the aimesh: onboarding diagnostics below run inside the
+ * get_onboardinglist render, which the Add node window polls every 10 s
+ * (QIS handler.js) and device-map/amesh.asp every second, for the whole search.
+ * Unthrottled, one candidate parent heard on 2.4 GHz alone wrote the same
+ * "partial ... (still usable)" line on every poll - and a tester sent exactly
+ * that line in as the proof of a failure. One line per (parent, node, kind)
+ * per AIMESH_LOG_GAP seconds says the same thing once. httpd is a single
+ * process, so a static table is enough. */
+#define AIMESH_LOG_GAP	600
+static int aimesh_log_due(const char *a, const char *b, int kind)
+{
+	static struct { char a[18], b[18]; int kind; long at; } seen[16];
+	static int next;
+	long now = uptime();
+	int i;
+
+	for (i = 0; i < 16; i++) {
+		if (seen[i].kind == kind && !strncmp(seen[i].a, a ? a : "", sizeof(seen[i].a) - 1)
+		    && !strncmp(seen[i].b, b ? b : "", sizeof(seen[i].b) - 1)) {
+			if (now - seen[i].at < AIMESH_LOG_GAP)
+				return 0;
+			seen[i].at = now;
+			return 1;
+		}
+	}
+	strlcpy(seen[next].a, a ? a : "", sizeof(seen[next].a));
+	strlcpy(seen[next].b, b ? b : "", sizeof(seen[next].b));
+	seen[next].kind = kind;
+	seen[next].at = now;
+	next = (next + 1) % 16;
+	return 1;
+}
+
 static char *select_best_onboarding_re(char *newReMac, int *rssi, int *source, long ts_eth, int *type)
 {
 	json_object *obListObj = NULL;
@@ -46788,11 +46821,13 @@ static char *select_best_onboarding_re(char *newReMac, int *rssi, int *source, l
 				 * changes. These gates affect the SEARCH LISTING only - the join path
 				 * (ob_selection / onboarding+macs) never reads onboarding.json - so a
 				 * parent chosen on 2.4 GHz still onboards through the stock path. */
-				if (!sourceObj)
-					logmessage("aimesh", "onboarding: parent %s skipped for node %s - missing source",
-						key, newReMac);
-				else if (!(rssiObj && rssi5gObj && rssi5g2Obj && tsEthObj))
-					logmessage("aimesh", "onboarding: parent %s partial for node %s - missing%s%s%s%s (still usable)",
+				if (!sourceObj) {
+					if (aimesh_log_due(key, newReMac, 1))
+						logmessage("aimesh", "onboarding: parent %s skipped for node %s - missing source",
+							key, newReMac);
+				}
+				else if (!(rssiObj && rssi5gObj && rssi5g2Obj && tsEthObj) && aimesh_log_due(key, newReMac, 2))
+					logmessage("aimesh", "onboarding: parent %s heard node %s on fewer bands - missing%s%s%s%s (normal; the parent is still scored)",
 						key, newReMac,
 						rssiObj ? "" : " rssi",
 						rssi5gObj ? "" : " rssi_5g",
@@ -47014,7 +47049,7 @@ ej_get_onboardinglist(int eid, webs_t wp, int argc, char **argv){
 				json_object_object_get_ex(newReObj, "misc_info", &miscInfoObj);
 				/* reaper: gate-1 diagnostics. A candidate lacking either key is
 				 * discarded here with no trace. Logging only. */
-				if (!(modelNameObj && tsEthObj))
+				if (!(modelNameObj && tsEthObj) && aimesh_log_due(newReMac, "", 3))
 					logmessage("aimesh", "onboarding: candidate %s dropped - missing%s%s",
 						newReMac,
 						modelNameObj ? "" : " model_name",
@@ -47048,7 +47083,7 @@ ej_get_onboardinglist(int eid, webs_t wp, int argc, char **argv){
 
 					/* reaper: passed gate 1 but no parent qualified, so this node never
 					 * reaches the wizard. Logging only. */
-					if (!strlen(reMac))
+					if (!strlen(reMac) && aimesh_log_due(newReMac, "", 4))
 						logmessage("aimesh", "onboarding: node %s (%s) seen but no parent selected - not offered",
 							newReMac, modelName);
 
diff --git a/release/src/router/rom/webs_scripts/reaper_webs_note.sh b/release/src/router/rom/webs_scripts/reaper_webs_note.sh
old mode 100755
new mode 100644
index 417f1c6ec4..bc83d05d15
--- a/release/src/router/rom/webs_scripts/reaper_webs_note.sh
+++ b/release/src/router/rom/webs_scripts/reaper_webs_note.sh
@@ -23,8 +23,8 @@ if [ -z "$info" ]; then
 	exit 0
 fi
 
-# "$info" arrives as the webs_state_info string "3006.102.8_Reaper_v2.1.5"
-# (or a bare "2.1.5"); take the X.Y.Z
+# "$info" arrives as the webs_state_info string "3006_102_8_Reaper_v2.1.5"
+# (before 2026-10-15 "3006.102.8_Reaper_v2.1.5"; or a bare "2.1.5"); take the X.Y.Z
 ver=$(echo "$info" | sed 's/.*Reaper_v//; s/[^0-9.].*//')
 [ -z "$ver" ] && { nvram set cfg_note=2; exit 0; }
 
diff --git a/release/src/router/rom/webs_scripts/reaper_webs_update.sh b/release/src/router/rom/webs_scripts/reaper_webs_update.sh
index f62848a84b..51cb70543e 100644
--- a/release/src/router/rom/webs_scripts/reaper_webs_update.sh
+++ b/release/src/router/rom/webs_scripts/reaper_webs_update.sh
@@ -4,8 +4,13 @@
 # GitHub (never ASUS/Merlin), compares the running Reaper vX.Y.Z against the
 # published one for THIS model AND THIS variant (MCP vs noMCP), and sets the
 # stock webs_state_* nvram the firmware page already renders. It NEVER downloads
-# or flashes an image (Phase 1). Opt-in: rc only runs this when the user has
-# enabled the check (firmware_check_enable=1; default 0).
+# or flashes an image (Phase 1). Opt-in: Reaper's own scheduled check
+# (watchdog auto_firmware_check_reaper) only runs this when the user has
+# enabled it (firmware_check_enable=1; default 0). A check the admin starts by
+# hand runs it too, and so does AiMesh: the mesh firmware check runs rc's
+# start_fw_check on every unit (webs_update_trigger=CFG_MNT), which execs this
+# script directly. That path is logged below rather than refused - refusing
+# it would leave every Reaper unit in a mesh unable to report or take updates.
 #
 # v3.1.0: a BETA channel. The manifest may carry a second line per model and
 # variant, MODEL#VARIANT-beta#..., written by the Dev-branch publish. It is
@@ -40,7 +45,9 @@ if [ "${rt_ls%% *}" != "drwx------" ] || [ "$(echo "$rt_ls" | awk '{print $3}')"
 	exit 0
 fi
 
-echo "---- reaper update check $(date) ----" > "$LOG"
+echo "---- reaper update check $(date) trigger=$(nvram get webs_update_trigger) ----" > "$LOG"
+[ "$(nvram get webs_update_trigger)" = "CFG_MNT" ] && \
+	logger -t reaper-fw "update check requested by AiMesh (CFG_MNT) - fetching the Reaper manifest"
 
 model=$(nvram get productid)
 
@@ -223,8 +230,13 @@ case "$offer" in
 stable|beta)
 	echo "---- update available: Reaper v$rem_ver ($offer) ----" >> "$LOG"
 	nvram set webs_state_flag=1
-	# firmware-string shape the page renders; keeps the Reaper version visible
-	nvram set webs_state_info="3006.102.8_Reaper_v${rem_ver}"
+	# Merlin's webs_state_info shape: firmbase_firmver_buildno_extendno - the
+	# layout the stock firmware pages and the watchdog new-version notice
+	# (%4[^_]_%3[^_]_%2[^_]_%15s) read, and the one AiMesh nodes display. The
+	# old "3006.102.8_Reaper_v..." put the word Reaper in the build-number
+	# slot (nodes showed "3.0.0.6.Reaper_v..."). Reaper's own pages and
+	# webs_note.sh match Reaper_v<ver>, which is unchanged.
+	nvram set webs_state_info="3006_102_8_Reaper_v${rem_ver}"
 	# consumed by reaper_webs_upgrade.sh (Phase 2 download+flash)
 	nvram set webs_state_url="$rem_url"
 	nvram set webs_state_sha256="$rem_sha"
diff --git a/release/src/router/rom/webs_scripts/reaper_webs_upgrade.sh b/release/src/router/rom/webs_scripts/reaper_webs_upgrade.sh
index 663ec1d23d..bf5a587210 100644
--- a/release/src/router/rom/webs_scripts/reaper_webs_upgrade.sh
+++ b/release/src/router/rom/webs_scripts/reaper_webs_upgrade.sh
@@ -15,6 +15,16 @@
 #                       1 = finished WITHOUT flashing - read webs_state_error
 #   webs_state_error    1 = guard/download failure   2 = not enough RAM
 #                       3 = verification failure (size/sha256/firmware_check)
+#
+# AiMesh (2026-10-15): a mesh-wide upgrade runs "start_webs_upgrade 1" on every
+# unit (the rc_service line in the syslog) - rc passes the 1 through as $1.
+# Stock ssl_webs_upgrade.sh (same directory, the contract this follows) reads
+# it as cfg_trigger: DOWNLOAD AND VERIFY ONLY, set cfg_fwstatus=6 before the
+# download, and never reboot or restart_upgrade - AiMesh sequences the flash
+# on all units itself once every one has its image. This script used to ignore
+# $1 and flash at once, rebooting a unit in the middle of the mesh's own
+# sequence. With $1=1 it now stops after verification: same guards, same
+# checks, no flash. Without an argument (Reaper_Firmware.asp) nothing changed.
 
 LOG=/tmp/webs_upgrade.log
 FW=/tmp/linux.trx
@@ -29,9 +39,15 @@ fail() {
 	exit 0
 }
 
+cfg_trigger="$1"	# 1 = started by AiMesh (cfg_mnt): download + verify only
+
 nvram set webs_state_upgrade=0
 nvram set webs_state_error=0
-echo "---- reaper webs upgrade $(date) ----" > "$LOG"
+echo "---- reaper webs upgrade $(date) cfg_trigger=${cfg_trigger:-0} ----" > "$LOG"
+if [ "$cfg_trigger" = "1" ]; then
+	logger -t REAPER_UPGRADE "AiMesh upgrade: download and verify only - the mesh sequences the flash"
+	nvram set auto_upgrade=1	# as stock: cfg_mnt's own flash step reads it
+fi
 # 2026-10-09 (audit V3): rc runs with umask 0, so without this wget would create
 # the image 0666 - writable by any process between the hash check and the flash.
 # 022 keeps it root-writable only (the private-file check below relies on it).
@@ -82,6 +98,8 @@ if [ -z "$free_kb" ] || [ "$free_kb" -le "$need_kb" ]; then
 	fail "not enough free RAM for the download (need ${need_kb}kB have ${free_kb:-0}kB)" 2
 fi
 
+[ "$cfg_trigger" = "1" ] && nvram set cfg_fwstatus=6	# cfg_mnt's "downloading" state, as stock
+
 echo "---- downloading $base ----" >> "$LOG"
 logger -t REAPER_UPGRADE "downloading $base"
 # GNU wget; --output-file feeds ej_get_fwdl_percent (the page's progress bar)
@@ -119,6 +137,23 @@ if [ "$(nvram get firmware_check)" != "1" ]; then
 	fail "firmware_check rejected the image" 3
 fi
 
+if [ "$cfg_trigger" = "1" ]; then
+	# AiMesh: the image is verified at the stock path; hand it to cfg_mnt and
+	# stop. Same end state stock leaves for its flash step: fwpath=2, logger
+	# and jffs2 stopped, webs_state_upgrade=1 with webs_state_error=0. The USB
+	# release and eject happen in rc's own "upgrade" service (services.c),
+	# which is what cfg_mnt runs for the flash.
+	nvram set fwpath=2
+	echo "---- image verified - waiting for the AiMesh flash step ----" >> "$LOG"
+	logger -t REAPER_UPGRADE "image verified - waiting for the AiMesh flash step"
+	rc rc_service stop_logger
+	rc rc_service "stop_jffs2 0"
+	sleep 1
+	nvram set webs_state_upgrade=1
+	nvram commit
+	exit 0
+fi
+
 nvram set webs_state_upgrade=2
 echo "---- image verified - flashing, router will reboot ----" >> "$LOG"
 logger -t REAPER_UPGRADE "image verified - flashing, router will reboot"
diff --git a/release/src/router/www/Advanced_FirmwareUpgrade_Content.asp b/release/src/router/www/Advanced_FirmwareUpgrade_Content.asp
index e24d3fd948..3cf9a2ffd8 100644
--- a/release/src/router/www/Advanced_FirmwareUpgrade_Content.asp
+++ b/release/src/router/www/Advanced_FirmwareUpgrade_Content.asp
@@ -162,6 +162,13 @@ if(cfg_sync_support){
 	var cfg_check = '<% nvram_get("cfg_check"); %>';
 	var cfg_upgrade = '<% nvram_get("cfg_upgrade"); %>';
 }
+/* reaper 2026-10-15: the check and the upgrade go through AiMesh (cfg_mnt) only
+   when at least one node is paired - then cfg_mnt runs start_fw_check on every
+   unit, which execs each unit's own webs_update.sh (Reaper's manifest check on a
+   Reaper unit, the vendor's on a stock node), and sequences the upgrade with
+   "start_webs_upgrade 1" (download-only on a Reaper unit since 2026-10-15).
+   A router with no node keeps the direct Reaper check it has always used. */
+var reaper_mesh_nodes = ('<% nvram_get("cfg_relist"); %>' != '' || '<% nvram_get("cfg_relist_x"); %>' != '');
 /* reaper: firmware comes from the Reaper GitHub project, not ASUS/Merlin */
 download_url_redir = "https://github.com/TheUnboundDeveloper/AM-Reaper/releases";
 download_url = "https://github.com/TheUnboundDeveloper/AM-Reaper/releases";
@@ -741,9 +748,9 @@ function detect_firmware(flag){
 		},
 
 		success: function(){
-			/* reaper Phase 2: result polling must match the direct (non-cfg_mnt)
-			   check above - read webs_state_*, not cfg_check. */
-			if(0 && cfg_sync_support){
+			/* reaper: result polling must match the path detect_update() took -
+			   cfg_check for the AiMesh path, webs_state_* for the direct one. */
+			if(cfg_sync_support && reaper_mesh_nodes){
 				if(cfg_check == "" || cfg_check == "0" || cfg_check == "1" || cfg_check == "5"){
 					setTimeout("detect_firmware();", 1000);
 				}
@@ -875,10 +882,13 @@ function detect_update(){
 	document.getElementById('update_states').innerHTML="Checking for available updates...";
 	document.getElementById('update_scan').style.display="";
 	document.getElementById('update').disabled = true;
-	/* reaper Phase 2: NEVER route the check through cfg_mnt (action_mode=
-	   firmware_check asks ASUS's servers and bypasses reaper_webs_update.sh).
-	   Always drive the Reaper manifest check directly. */
-	if(0 && cfg_sync_support){
+	/* reaper 2026-10-15: through cfg_mnt only with a node paired (see
+	   reaper_mesh_nodes). The earlier note here - "cfg_mnt asks ASUS's servers
+	   and bypasses reaper_webs_update.sh" - was wrong for this router: cfg_mnt's
+	   check runs rc start_fw_check, which execs /usr/sbin/webs_update.sh, i.e.
+	   the Reaper script. Turning the path off cost every Reaper main router the
+	   ability to check or upgrade its nodes. */
+	if(cfg_sync_support && reaper_mesh_nodes){
 		cfgsync_firmware_check();
 	}
 	else{
diff --git a/release/src/router/www/AiMesh.asp b/release/src/router/www/AiMesh.asp
index b393a6795b..93c9337eaf 100644
--- a/release/src/router/www/AiMesh.asp
+++ b/release/src/router/www/AiMesh.asp
@@ -54,8 +54,24 @@ if(theme == "WHITE"){
 if(isSupport("TS_UI"))
 	$('link').last().after('<link rel="stylesheet" type="text/css" href="css/difference.css">');
 
+/* reaper 2026-10-15: cfg_server - the AiMesh controller - is started by rc
+   start_cfgsync() only when cfg_master=1 or x_Setting=1 (RTCONFIG_MASTER_DET).
+   Stock forced its setup wizard, which sets x_Setting, so a stock main router
+   never sat at 0. Reaper keeps x_Setting=0 until setup (that is what keeps a
+   factory box findable as a node) and the box is usable meanwhile - so until
+   the setup box runs there is no cfg_server: Add node finds nothing and the
+   page looks empty. Same root as the Network page's main-network notice; same
+   cure, the setup box, which sets x_Setting and reboots into a working CAP. */
+function reaperAiMeshNotice(){
+	var sw = '<% nvram_get("sw_mode"); %>', psta = '<% nvram_get("wlc_psta"); %>', re = '<% nvram_get("re_mode"); %>';
+	var xs = '<% nvram_get("x_Setting"); %>', master = '<% nvram_get("cfg_master"); %>';
+	var routerOrAp = (sw == "1") || (sw == "3" && psta != "1");
+	if(routerOrAp && re != "1" && xs != "1" && master != "1")
+		document.getElementById("rams_setup_notice").style.display = "";
+}
 function initial(){
 	show_menu();
+	reaperAiMeshNotice();
 	$("#AiMesh_Topology").load("/aimesh/aimesh_topology.html", function(){
 		setTimeout(function(){
 			$('link').filter("[href*='/aimesh/aimesh_topology.css']").after('<link rel="stylesheet" type="text/css" href="/aimesh/aimesh_system_settings.css">');
@@ -116,6 +132,10 @@ function change_tab(_index){
 			<table width="98%" border="0" align="left" cellpadding="0" cellspacing="0">
 				<tr>
 					<td align="left" valign="top">
+						<div id="rams_setup_notice" style="display:none;width:760px;box-sizing:border-box;margin:0 0 10px;padding:12px 16px;border-radius:6px;background:rgba(224,169,59,.10);border:1px solid rgba(224,169,59,.38);box-shadow:inset 3px 0 0 #E0A93B;">
+							<span style="font-size:13px;line-height:1.5;color:#ECE7DB;"><#RAMS_10#></span>
+							<a href="Reaper_WiFiSetup.asp" style="display:inline-block;margin-left:12px;font-weight:600;font-size:11.5px;letter-spacing:.07em;text-transform:uppercase;background:#E0A93B;color:#1a1206;text-decoration:none;border-radius:6px;padding:7px 11px;white-space:nowrap;"><#RWFS_1#></a>
+						</div>
 						<table width="760px" border="0" cellpadding="5" cellspacing="0" class="FormTitle" id="FormTitle" style="border-radius:3px;">
 							<tbody>
 								<tr>
diff --git a/release/src/router/www/Reaper_Firmware.asp b/release/src/router/www/Reaper_Firmware.asp
index 1c1dfb204b..39cd44b496 100644
--- a/release/src/router/www/Reaper_Firmware.asp
+++ b/release/src/router/www/Reaper_Firmware.asp
