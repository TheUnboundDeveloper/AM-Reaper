diff --git a/release/src/router/rc/encdns.c b/release/src/router/rc/encdns.c
new file mode 100644
index 00000000000..771afa99dab
--- /dev/null
+++ b/release/src/router/rc/encdns.c
@@ -0,0 +1,508 @@
+/*
+ * reaper 2026-10-21: Encrypted DNS for devices - the rc side of rednsd
+ * (release/src/router/rednsd/rednsd.c), the router's own DNS-over-TLS server.
+ *
+ * rc decides whether it runs (nvram reaper_dot_srv, off at factory; the switch is on
+ * Warden > Encrypted DNS) and writes everything it needs into /tmp/rednsd/rednsd.conf:
+ *   - the certificate httpd serves (/etc/cert.pem + /etc/key.pem: Let's Encrypt from
+ *     any provider, an uploaded one, or the router's own self-signed one);
+ *   - where to listen: the main LAN address (IPv4 + IPv6), each guest/VLAN network's
+ *     address, and the WAN address when it is public - devices that look the
+ *     certificate's name up get the WAN address and reach the router through br0;
+ *   - who may connect, and which dnsmasq instance answers them ("peer" lines);
+ *   - who DNS Director sends elsewhere ("deny-mac" / "deny-net", "allow-mac").
+ * Port 853 is dropped on every non-LAN interface while it runs (rednsd_wan_drop()), a
+ * backstop to rednsd's own peer filter.
+ *
+ * A change to the listen/certificate part restarts it (the listeners need root, which
+ * rednsd gives up after binding); a change to peers or policy only is a SIGHUP.
+ */
+#include <rc.h>
+#include <net/ethernet.h>
+#include <shared.h>
+#include <pwd.h>
+#include <stdarg.h>
+#include <sys/stat.h>
+#include <arpa/inet.h>
+#include <ctype.h>
+#ifdef RTCONFIG_DNSFILTER
+#include "dnsfilter.h"
+#endif
+#ifdef RTCONFIG_MULTILAN_CFG
+#include "mtlan_utils.h"
+#endif
+
+#define RED_DIR		"/tmp/rednsd"		/* root 0755 (REAPER_TMP_DIRS): the config, rc's note */
+#define RED_RUN		RED_DIR "/run"		/* nobody 0700: rednsd's status file */
+#define RED_CONF	RED_DIR "/rednsd.conf"
+#define RED_STATUS	RED_RUN "/status.json"
+#define RED_NOTE	RED_DIR "/note.json"	/* why rc did not start it; the page prefers this */
+#define RED_PORT	853
+#define RED_CERT	"/etc/cert.pem"
+#define RED_KEY		"/etc/key.pem"
+#define RED_CABUNDLE	"/etc/ssl/certs/ca-certificates.crt"
+
+struct rb {
+	char b[12288];
+	size_t o;
+};
+
+static void rb_add(struct rb *r, const char *fmt, ...)
+{
+	va_list ap;
+	int n;
+
+	if (r->o >= sizeof(r->b) - 1)
+		return;
+	va_start(ap, fmt);
+	n = vsnprintf(r->b + r->o, sizeof(r->b) - r->o, fmt, ap);
+	va_end(ap);
+	if (n > 0)
+		r->o = (r->o + n < sizeof(r->b)) ? r->o + n : sizeof(r->b) - 1;
+}
+
+static int mask_bits(const char *mask)
+{
+	struct in_addr a;
+	uint32_t m;
+	int n = 0;
+
+	if (!mask || inet_pton(AF_INET, mask, &a) != 1)
+		return -1;
+	for (m = ntohl(a.s_addr); m & 0x80000000u; m <<= 1)
+		n++;
+	return n;
+}
+
+/* an address the internet can reach: not private, CGNAT, link-local or loopback */
+static int public_v4(const char *s)
+{
+	struct in_addr a;
+	uint32_t x;
+
+	if (!s || inet_pton(AF_INET, s, &a) != 1)
+		return 0;
+	x = ntohl(a.s_addr);
+	if ((x >> 24) == 0 || (x >> 24) == 10 || (x >> 24) == 127 || x >= 0xe0000000u)
+		return 0;
+	if ((x & 0xfff00000u) == 0xac100000u || (x & 0xffff0000u) == 0xc0a80000u
+	    || (x & 0xffc00000u) == 0x64400000u || (x & 0xffff0000u) == 0xa9fe0000u)
+		return 0;
+	return 1;
+}
+
+/* the main LAN's IPv4 subnet as a.b.c.d/n */
+static int lan_subnet(char *out, size_t n)
+{
+	struct in_addr ip, mask;
+	int bits = mask_bits(nvram_safe_get("lan_netmask"));
+
+	if (bits < 0 || inet_pton(AF_INET, nvram_safe_get("lan_ipaddr"), &ip) != 1
+	    || inet_pton(AF_INET, nvram_safe_get("lan_netmask"), &mask) != 1)
+		return 0;
+	ip.s_addr &= mask.s_addr;
+	snprintf(out, n, "%s/%d", inet_ntoa(ip), bits);
+	return 1;
+}
+
+/* certificate + listeners: a change here needs a restart */
+static void red_static(struct rb *r)
+{
+	char lan6[INET6_ADDRSTRLEN] = "";
+	int unit;
+
+	rb_add(r, "cert %s\nkey %s\n", RED_CERT, RED_KEY);
+	if (f_exists(RED_CABUNDLE))
+		rb_add(r, "cabundle %s\n", RED_CABUNDLE);
+	rb_add(r, "status %s\n", RED_STATUS);
+	rb_add(r, "listen %s %d\n", nvram_safe_get("lan_ipaddr"), RED_PORT);
+#ifdef RTCONFIG_IPV6
+	if (ipv6_enabled()) {
+		const char *p = getifaddr(nvram_safe_get("lan_ifname"), AF_INET6, 0);
+		if (p && *p) {
+			snprintf(lan6, sizeof(lan6), "%s", p);
+			rb_add(r, "listen %s %d\n", lan6, RED_PORT);
+		}
+	}
+#endif
+#ifdef RTCONFIG_MULTILAN_CFG
+	{
+		MTLAN_T *pmtl;
+		size_t mtl_sz = 0, i;
+		if ((pmtl = (MTLAN_T *)INIT_MTLAN(sizeof(MTLAN_T)))) {
+			get_mtlan(pmtl, &mtl_sz);
+			for (i = 0; i < mtl_sz; i++)
+				if (pmtl[i].enable && pmtl[i].nw_t.idx && pmtl[i].nw_t.addr[0]
+				    && strcmp(pmtl[i].nw_t.addr, nvram_safe_get("lan_ipaddr")))
+					rb_add(r, "listen %s %d\n", pmtl[i].nw_t.addr, RED_PORT);
+			FREE_MTLAN((void *)pmtl);
+		}
+	}
+#endif
+	/* the certificate's name resolves to the WAN address: listen there too, for LAN
+	   peers only (rednsd's peer filter + rednsd_wan_drop()). Behind double NAT the
+	   WAN address is private and nobody's name points at it - nothing to add. */
+	for (unit = WAN_UNIT_FIRST; unit < WAN_UNIT_MAX; unit++) {
+		char name[32];
+		snprintf(name, sizeof(name), "wan%d_ipaddr", unit);
+		if (public_v4(nvram_safe_get(name)))
+			rb_add(r, "listen %s %d wan\n", nvram_safe_get(name), RED_PORT);
+	}
+}
+
+#ifdef RTCONFIG_DNSFILTER
+/* the router answers this DNS Director mode itself (or nobody filters) */
+static int dnsf_router_ok(int mode)
+{
+	return mode == DNSF_SRV_UNFILTERED || mode == DNSF_SRV_ROUTER;
+}
+#endif
+
+/* peers + DNS Director policy: a change here is a SIGHUP */
+static void red_policy(struct rb *r)
+{
+	char net[64];
+#ifdef RTCONFIG_IPV6
+	char lan6p[INET6_ADDRSTRLEN + 8] = "";
+#endif
+
+	if (lan_subnet(net, sizeof(net)))
+		rb_add(r, "peer %s 127.0.0.1\n", net);	/* the main instance also listens on loopback */
+#ifdef RTCONFIG_IPV6
+	if (ipv6_enabled()) {
+		const char *p = getifaddr(nvram_safe_get("lan_ifname"), AF_INET6, GIF_PREFIXLEN);
+		if (p && *p) {
+			snprintf(lan6p, sizeof(lan6p), "%s", p);
+			rb_add(r, "peer %s ::1\n", lan6p);
+		}
+	}
+#endif
+#ifdef RTCONFIG_MULTILAN_CFG
+	{
+		MTLAN_T *pmtl;
+		size_t mtl_sz = 0, i;
+		if ((pmtl = (MTLAN_T *)INIT_MTLAN(sizeof(MTLAN_T)))) {
+			get_mtlan(pmtl, &mtl_sz);
+			for (i = 0; i < mtl_sz; i++) {
+				const MTLAN_T *m = &pmtl[i];
+				if (!m->enable || !m->nw_t.idx || !m->nw_t.addr[0] || !m->nw_t.subnet[0]
+				    || !strcmp(m->nw_t.addr, nvram_safe_get("lan_ipaddr")))
+					continue;
+				/* a guest/VLAN device is answered by its own network's instance */
+				rb_add(r, "peer %s/%u %s\n", m->nw_t.subnet, m->nw_t.prefixlen, m->nw_t.addr);
+#ifdef RTCONFIG_DNSFILTER
+				if (nvram_get_int("dnsfilter_enable_x") && !dnsf_router_ok(m->sdn_t.dnsf_idx))
+					rb_add(r, "deny-net %s/%u\n", m->nw_t.subnet, m->nw_t.prefixlen);
+#endif
+			}
+			FREE_MTLAN((void *)pmtl);
+		}
+	}
+#endif
+#ifdef RTCONFIG_DNSFILTER
+	/* DNS Director: a device it sends to another server must not get the router's
+	   unfiltered answers over DoT. rednsd closes it before TLS, so Android's automatic
+	   mode falls back to port 53, where DNS Director applies. */
+	if (nvram_get_int("dnsfilter_enable_x")) {
+		char *nv, *nvp, *rule, *name, *mac, *mode, macbuf[18];
+		unsigned char ea[ETHER_ADDR_LEN];
+
+#ifdef HND_ROUTER
+		nv = nvp = malloc(255 * 6 + 1);
+		if (nv) nvram_split_get("dnsfilter_rulelist", nv, 255 * 6 + 1, 5);
+#else
+		nv = nvp = strdup(nvram_safe_get("dnsfilter_rulelist"));
+#endif
+		while (nv && (rule = strsep(&nvp, "<")) != NULL) {
+			if (vstrsep(rule, ">", &name, &mac, &mode) != 3 || !*mac || !*mode || !ether_atoe(mac, ea))
+				continue;
+			/* the normalised address: DNS Director's text may hold anything after the sixth group */
+			rb_add(r, "%s %s\n", dnsf_router_ok(safe_atoi(mode)) ? "allow-mac" : "deny-mac", ether_etoa(ea, macbuf));
+		}
+		free(nv);
+		if (!dnsf_router_ok(nvram_get_int("dnsfilter_mode"))) {
+			if (lan_subnet(net, sizeof(net)))
+				rb_add(r, "deny-net %s\n", net);
+#ifdef RTCONFIG_IPV6
+			if (*lan6p)
+				rb_add(r, "deny-net %s\n", lan6p);
+#endif
+		}
+	}
+#endif
+}
+
+static int red_enabled(void)
+{
+	return is_routing_enabled() && nvram_get_int("reaper_dot_srv") == 1;
+}
+
+/* the page reads this when rednsd is not running to say why */
+static void red_status_note(const char *state)
+{
+	char buf[96];
+
+	if (reaper_secure_dir(RED_DIR, 0755) != 0)
+		return;
+	snprintf(buf, sizeof(buf), "{\"state\":\"%s\"}\n", state);
+	reaper_write_atomic(RED_NOTE, buf, strlen(buf), 0644);
+}
+
+void stop_rednsd(void)
+{
+	if (pids("rednsd"))
+		killall_tk("rednsd");
+}
+
+void start_rednsd(void)
+{
+	struct rb s, p;
+	struct passwd *pw;
+	FILE *f;
+
+	stop_rednsd();
+	if (!red_enabled()) {
+		unlink(RED_CONF);
+		unlink(RED_STATUS);
+		unlink(RED_NOTE);
+		return;
+	}
+	if (!f_exists(RED_CERT) || !f_exists(RED_KEY)) {
+		logmessage("rednsd", "Encrypted DNS for devices waits for the router's certificate");
+		unlink(RED_CONF);	/* rwatch respawns rednsd only while rc has a config out */
+		red_status_note("no_cert");
+		return;
+	}
+	memset(&s, 0, sizeof(s));
+	memset(&p, 0, sizeof(p));
+	red_static(&s);
+	red_policy(&p);
+	/* root's directory (the config); rednsd, after dropping to nobody, writes its status in run/ */
+	if (reaper_secure_dir(RED_DIR, 0755) != 0 || !(pw = getpwnam("nobody")) ||
+	    reaper_secure_dir_for(RED_RUN, 0700, pw->pw_uid, pw->pw_gid) != 0) {
+		logmessage("rednsd", "Encrypted DNS for devices cannot set up " RED_DIR " - not started");
+		return;
+	}
+	unlink(RED_NOTE);
+	if (!(f = fopen(RED_CONF, "w")))
+		return;
+	fputs("# generated by rc (encdns.c) - Encrypted DNS for devices\n", f);
+	fputs(s.b, f);
+	fputs(p.b, f);
+	fclose(f);
+	chmod(RED_CONF, 0644);
+	xstart("rednsd");
+}
+
+/* After a LAN, guest network, WAN or DNS Director change: rewrite the config and tell
+   rednsd only when something it uses changed. */
+void rednsd_refresh(void)
+{
+	struct rb s, p;
+	char *old, head[] = "# generated by rc (encdns.c) - Encrypted DNS for devices\n";
+	size_t hl = sizeof(head) - 1;
+	FILE *f;
+
+	if (!red_enabled()) {
+		if (pids("rednsd"))
+			start_rednsd();		/* stops it and clears its files */
+		return;
+	}
+	if (!pids("rednsd")) {
+		start_rednsd();
+		return;
+	}
+	memset(&s, 0, sizeof(s));
+	memset(&p, 0, sizeof(p));
+	red_static(&s);
+	red_policy(&p);
+	old = read_whole_file(RED_CONF);
+	if (old && strlen(old) == hl + s.o + p.o && !strncmp(old + hl, s.b, s.o) && !strcmp(old + hl + s.o, p.b)) {
+		free(old);
+		return;					/* nothing changed */
+	}
+	if (!old || strncmp(old, head, hl) || strncmp(old + hl, s.b, s.o) || strncmp(old + hl + s.o, "peer ", 5)) {
+		free(old);
+		start_rednsd();				/* the listeners or certificate changed */
+		return;
+	}
+	free(old);
+	if ((f = fopen(RED_CONF, "w"))) {
+		fputs(head, f);
+		fputs(s.b, f);
+		fputs(p.b, f);
+		fclose(f);
+		killall("rednsd", SIGHUP);		/* peers or policy only */
+	}
+}
+
+/* The certificate httpd serves changed (renewal, upload): rednsd read it as root at
+   start and cannot read it again, so it starts over. */
+void rednsd_cert_changed(void)
+{
+	if (red_enabled())
+		start_rednsd();
+}
+
+/* Port 853 answers on LAN-side bridges only: drop it on every other interface (WAN,
+   VPN) while rednsd runs. Called from filter_setting() right after the INVALID drop,
+   ahead of every accept, for IPv4 and IPv6. */
+void rednsd_wan_drop(FILE *fp)
+{
+	if (!fp || !red_enabled())
+		return;
+	fprintf(fp, "-A INPUT -i lo -p tcp --dport %d -j ACCEPT\n", RED_PORT);
+	fprintf(fp, "-A INPUT ! -i br+ -p tcp --dport %d -j DROP\n", RED_PORT);
+	fprintf(fp, "-A INPUT ! -i br+ -p udp --dport %d -j DROP\n", RED_PORT);
+}
+
+/* ---- 2026-10-21: block encrypted DNS that goes around the router (Encrypted DNS tab).
+   A device that encrypts its DNS to an outside provider is invisible to Wallguard, Dreadwatch,
+   DNS Director and Gatekeeper; with this on, LAN and guest devices cannot: DoT / DoQ (853) to
+   anything is refused, HTTPS (TCP/UDP 443) to the known DoH resolvers' addresses is refused,
+   the DoH provider names answer NXDOMAIN and the browser canaries tell automatic DoH to stand
+   down. "Automatic" encrypted DNS then falls back to the router silently; devices that want
+   encryption use the router's own (rednsd above). DNS Director's "No filtering" devices are
+   exempt. Off by default (reaper_doh_block). */
+#define EDNS_SET4	"redns_doh"
+#define EDNS_SET6	"redns_doh6"
+#define EDNS_SCRIPT	"/usr/sbin/encdns.sh"
+#define EDNS_NAMES	"/usr/share/encdns/doh-names"
+#define EDNS_CONF	RED_DIR "/doh.conf"
+
+int edns_block_enabled(void)
+{
+	return is_routing_enabled() && nvram_get_int("reaper_doh_block") == 1;
+}
+
+/* The sets exist before any rule names them - reaper_restore_rules drops a match-set line
+   whose set is missing, silently - and hold the shipped seed + the cached list from boot. */
+static void edns_sets_ensure(void)
+{
+	eval("ipset", "create", EDNS_SET4, "hash:net", "maxelem", "65536", "-exist");
+	eval("ipset", "create", EDNS_SET6, "hash:net", "family", "inet6", "maxelem", "16384", "-exist");
+	if (reaper_secure_dir(RED_DIR, 0755) == 0 && f_exists(EDNS_SCRIPT))
+		eval("sh", EDNS_SCRIPT, "replay");
+}
+
+/* The REAPER_EDNS chain (declared in filter_setting / filter_setting2) and its FORWARD jump
+   for LAN and guest bridges, next to DNS Director's DoT rules: after ESTABLISHED (a toggle
+   leaves running connections alone), before the guest-network chain and the LAN accept. */
+void edns_block_rules(FILE *fp, int v6)
+{
+	if (!fp || !edns_block_enabled())
+		return;
+	if (!v6)
+		edns_sets_ensure();		/* once per firewall build; IPv4 is written first */
+#ifdef RTCONFIG_DNSFILTER
+	/* a device DNS Director lets use any DNS server ("No filtering") may encrypt as it likes */
+	if (nvram_get_int("dnsfilter_enable_x")) {
+		char *nv, *nvp, *rule, *name, *mac, *mode, macbuf[18];
+		unsigned char ea[ETHER_ADDR_LEN];
+#ifdef HND_ROUTER
+		nv = nvp = malloc(255 * 6 + 1);
+		if (nv) nvram_split_get("dnsfilter_rulelist", nv, 255 * 6 + 1, 5);
+#else
+		nv = nvp = strdup(nvram_safe_get("dnsfilter_rulelist"));
+#endif
+		while (nv && (rule = strsep(&nvp, "<")) != NULL) {
+			if (vstrsep(rule, ">", &name, &mac, &mode) != 3 || !*mac || !*mode || !ether_atoe(mac, ea))
+				continue;
+			if (safe_atoi(mode) == DNSF_SRV_UNFILTERED)
+				/* the normalised address: text after the sixth group would land in the rule */
+				fprintf(fp, "-A REAPER_EDNS -m mac --mac-source %s -j RETURN\n", ether_etoa(ea, macbuf));
+		}
+		free(nv);
+	}
+#endif
+	fprintf(fp, "-A REAPER_EDNS -p tcp --dport 853 -j REJECT --reject-with tcp-reset\n");
+	fprintf(fp, "-A REAPER_EDNS -p udp --dport 853 -j REJECT\n");
+	fprintf(fp, "-A REAPER_EDNS -p tcp --dport 443 -m set --match-set %s dst -j REJECT --reject-with tcp-reset\n",
+		v6 ? EDNS_SET6 : EDNS_SET4);
+	fprintf(fp, "-A REAPER_EDNS -p udp --dport 443 -m set --match-set %s dst -j REJECT\n", v6 ? EDNS_SET6 : EDNS_SET4);
+	fprintf(fp, "-A FORWARD -i br+ -j REAPER_EDNS\n");
+}
+
+/* is name (or a name it sits under) one the router itself encrypts to (DNS Privacy) */
+static int edns_router_upstream(const char *name)
+{
+	char *nv = strdup(nvram_safe_get("dnspriv_rulelist")), *p = nv, *rule;
+	size_t n = strlen(name);
+	int hit = 0;
+
+	while (!hit && p && (rule = strsep(&p, "<")) != NULL) {
+		char *addr = NULL, *port = NULL, *host = NULL, *spki = NULL;
+		size_t h;
+		if (vstrsep(rule, ">", &addr, &port, &host, &spki) < 3 || !host || !*host)
+			continue;
+		h = strlen(host);
+		hit = !strcasecmp(host, name) || (h > n && host[h - n - 1] == '.' && !strcasecmp(host + h - n, name));
+	}
+	free(nv);
+	return hit;
+}
+
+/* The DoH provider names, answered NXDOMAIN (with their subdomains) while the block is on:
+   the conf-file every dnsmasq instance includes (services.c, sdn.c). Written here, when a
+   dnsmasq config is written; NULL = no include. */
+const char *reaper_edns_dns_conf(void)
+{
+	FILE *f;
+	char line[256], *b = NULL, *nb;
+	size_t len = 0;
+
+	if (!edns_block_enabled() || reaper_secure_dir(RED_DIR, 0755) != 0 || !(f = fopen(EDNS_NAMES, "r")))
+		return NULL;
+	while (fgets(line, sizeof(line), f)) {
+		char *s = line, *e;
+		size_t i;
+		int ok = 1;
+		while (*s == ' ' || *s == '\t')
+			s++;
+		for (e = s; *e && *e != '\n' && *e != '\r' && *e != ' ' && *e != '#'; e++)
+			;
+		*e = 0;
+		if (!*s || !strchr(s, '.') || edns_router_upstream(s))
+			continue;
+		for (i = 0; s[i]; i++)
+			if (!(isalnum((unsigned char)s[i]) || s[i] == '.' || s[i] == '-'))
+				ok = 0;
+		if (!ok || !(nb = realloc(b, len + strlen(s) + 12)))
+			continue;
+		b = nb;
+		len += sprintf(b + len, "address=/%s/\n", s);
+	}
+	fclose(f);
+	if (!b)
+		return NULL;
+	/* review 2026-10-24 (Q-A-8): written once per network on every dnsmasq start - identical bytes are left alone */
+	if (reaper_write_changed(EDNS_CONF, b, len, 0644) != 0) {
+		free(b);
+		return NULL;
+	}
+	free(b);
+	return EDNS_CONF;
+}
+
+/* end of start_firewall: the daily list update follows the switch; the first one runs as
+   soon as the router is online after the block is switched on */
+void edns_block_sync(void)
+{
+	if (!edns_block_enabled()) {
+		eval("cru", "d", "edns_doh");
+		return;
+	}
+	eval("cru", "a", "edns_doh", "25 5 * * * sh " EDNS_SCRIPT " update");
+	if (!f_exists("/jffs/encdns/doh.ips") && nvram_get_int("wan0_state_t") == 2)
+		edns_doh_update();
+}
+
+/* the page's "Update list now", and the first fetch: in the background, never waited on */
+void edns_doh_update(void)
+{
+	char *argv[] = { "sh", EDNS_SCRIPT, "update", NULL };
+	pid_t pid;
+
+	if (edns_block_enabled() && f_exists(EDNS_SCRIPT))
+		_eval(argv, ">/dev/null", 0, &pid);
+}
