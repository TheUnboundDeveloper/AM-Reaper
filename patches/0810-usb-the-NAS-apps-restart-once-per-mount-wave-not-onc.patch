From e70cac006c5c087962591f377453c9a18384a85e Mon Sep 17 00:00:00 2001
From: reaper <theunbounddeveloper@outlook.com>
Date: Thu, 15 Oct 2026 14:07:32 -0400
Subject: [PATCH] usb: the NAS apps restart once per mount wave, not once per
 partition

hotplug_usb() ran a full restart_nasapps (Samba, FTP, media server, NFS,
Time Machine - and UPnP with them) after every partition that mounted or
unmounted, blocking on it under the usb lock, so a disk with two
mountable partitions or two disks at boot ran the whole stop + start back
to back. Each event now stamps /tmp/reaper/nasapps.settle and leaves a
detached waiter that restarts the apps after 3 s only if its stamp is
still the newest; called after file_unlock() so the waiter never holds the
usb lock; any failure falls back to the stock immediate restart. The GUI
eject path (ignore_nas_service_ counter, ejusb_main) is unchanged. Lean:
test_nasapps_settle.py (the function compiled and run per event).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 release/src/router/rc/usb.c | 48 ++++++++++++++++++++++++++++++++++---
 1 file changed, 45 insertions(+), 3 deletions(-)

diff --git a/release/src/router/rc/usb.c b/release/src/router/rc/usb.c
index 347bb7e0ee..25af49b615 100644
--- a/release/src/router/rc/usb.c
+++ b/release/src/router/rc/usb.c
@@ -27,6 +27,7 @@
 #include <sys/swap.h>
 #include <sys/vfs.h>
 #include <sys/stat.h>
+#include <sys/wait.h>		/* reaper: waitpid() in reaper_nasapps_settle() */
 #include <rc_event.h>
 #include <shared.h>
 
@@ -2668,6 +2669,45 @@ void remove_storage_main(int shutdn)
 	exec_for_host(-1, 0x02, shutdn ? EFH_SHUTDN : 0, umount_partition);
 }
 
+/* reaper 2026-10-15: one NAS-app restart per mount wave, not one per partition.
+ * Stock restarted every NAS application (Samba, FTP, media server, NFS, Time Machine,
+ * and UPnP with them) after EACH partition hotplug mounted or unmounted, so a disk with
+ * two mountable partitions, or two disks at boot, ran the whole stop + start twice in a
+ * row. Each event now stamps REAPER_NAS_STAMP and leaves a detached waiter; after
+ * REAPER_NAS_SETTLE_S the waiter restarts the apps only if its stamp is still the
+ * newest, so the last event of a wave does it once, after every mount is in place.
+ * Called after file_unlock("usb"): the waiter must not inherit the lock descriptor.
+ * Any failure falls back to the stock immediate restart. */
+#define REAPER_NAS_STAMP	REAPER_TMPDIR "/nasapps.settle"
+#define REAPER_NAS_SETTLE_S	3
+
+static void reaper_nasapps_settle(void)
+{
+	char mine[32], seen[32];
+	pid_t pid;
+
+	snprintf(mine, sizeof(mine), "%d.%ld", (int)getpid(), uptime());
+	if (reaper_secure_dir(REAPER_TMPDIR, 0700) != 0 ||
+	    f_write_string(REAPER_NAS_STAMP, mine, 0, 0600) <= 0 ||
+	    (pid = fork()) < 0) {
+		notify_rc_after_wait("restart_nasapps");
+		return;
+	}
+	if (pid > 0) {
+		waitpid(pid, NULL, 0);
+		return;
+	}
+	/* first child: hand the wait to a grandchild so the hotplug process can exit;
+	 * if that fork fails, wait here instead */
+	if (fork() > 0)
+		_exit(0);
+	sleep(REAPER_NAS_SETTLE_S);
+	seen[0] = '\0';
+	if (f_read_string(REAPER_NAS_STAMP, seen, sizeof(seen)) > 0 && strcmp(seen, mine) == 0)
+		notify_rc_after_wait("restart_nasapps");
+	_exit(0);
+}
+
 #if defined(RTCONFIG_REALTEK) || (defined(RTCONFIG_RALINK) && !defined(RTCONFIG_MT798X))
 static const char *path_to_name(const char *path) {
 	const char *s = path, *tmp;
@@ -2873,7 +2913,7 @@ void hotplug_usb(void)
 	{
 		/* scsi partition */
 		char devname[64];
-		int lock, c;
+		int lock, c, nas_settle = 0;
 		char *d, dev[32], nv_name[32];
 
 		/* strip trail digits */
@@ -2913,7 +2953,7 @@ void hotplug_usb(void)
 				if (mount_partition(devname, host, NULL, device, EFH_HP_ADD)) {
 _dprintf("restart_nas_services(%d): test 5.\n", getpid());
 					//restart_nas_services(1, 1, 0); // restart all NAS applications
-					notify_rc_and_wait("restart_nasapps");
+					nas_settle = 1;	/* reaper: once per wave, after file_unlock() below */
 				}
 				TRACE_PT(" end of mount\n");
 #if defined(EBG15) || defined(EBG19)
@@ -2936,13 +2976,15 @@ _dprintf("restart_nas_services(%d): test 5.\n", getpid());
 			} else {
 _dprintf("restart_nas_services(%d): test 6.\n", getpid());
 				//restart_nas_services(1, 1, 0);
-				notify_rc_after_wait("restart_nasapps");
+				nas_settle = 1;	/* reaper: once per wave, after file_unlock() below */
 			}
 #if defined(EBG15) || defined(EBG19)
 			led_control(LED_USB, LED_OFF);
 #endif
 		}
 		file_unlock(lock);
+		if (nas_settle)
+			reaper_nasapps_settle();
 #ifdef RTCONFIG_FRS_FEEDBACK
 #ifdef RTCONFIG_DBLOG
 		start_dblog(0);
-- 
