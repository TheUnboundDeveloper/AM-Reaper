+/* 2026-10-22: the ASUS DDNS / Let's Encrypt seeds (RW_ASUSDDNS_IP, RW_LE_IPS). Called
+ * from rw_seed_allow (boot, every Warden start) and from start_ddns() (rc/services.c),
+ * so a user who switches DDNS or the certificate on gets the entries before the first
+ * update, without waiting for a Warden restart. Each seed fires once, only while its
+ * feature is in use; a seeded entry the user later removed stays removed, and while
+ * the router-traffic filter is on the log says once per boot what that costs. */
+void rwarden_ddns_seed(void)
+{
+	int asus = nvram_match("ddns_enable_x", "1") && nvram_match("ddns_server_x", "WWW.ASUS.COM");
+	int le = nvram_match("le_enable", "1");
+	int warden = nvram_match("rwarden_enable", "1");
+
+	if (!f_exists(REAPER_RW_DIR "/.committed"))
+		return;
+	if (asus && rw_seed_one("allow", RW_ASUSDDNS_IP, RW_SEED_MARK_ASUSDDNS, "the ASUS DDNS server ns1.asuscomm.com", "Warden") && warden)
+		rw_seed_live(RW_ASUSDDNS_IP);
+	if (le && rw_seed_one("allow", RW_LE_IPS, RW_SEED_MARK_LE, "the Let's Encrypt certificate server", "Warden") && warden)
+		rw_seed_live(RW_LE_IPS);
+	if (warden && nvram_match("rwarden_self", "1") && !f_exists(RW_DDNS_WARNED)
+	 && ((asus && !rw_seed_present(RW_ASUSDDNS_IP)) || (le && !rw_seed_present(RW_LE_IPS)))) {
+		logmessage("rwarden", "whitelist: the ASUS DDNS / Let's Encrypt server entries were removed and the router-traffic filter is ON - if a blocked country or list covers them (both are in the United States list), DDNS updates fail and the certificate is not issued or renewed; add %s back on the Warden page",
+		           asus && !rw_seed_present(RW_ASUSDDNS_IP) ? RW_ASUSDDNS_IP : RW_LE_IPS);
+		(void)reaper_write_atomic(RW_DDNS_WARNED, "1\n", 2, 0600);
+	}
 }
 
