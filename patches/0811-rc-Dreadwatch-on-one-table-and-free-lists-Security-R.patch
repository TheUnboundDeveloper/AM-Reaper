+/* the addresses of a seed straight into the running whitelist sets (the next apply
+   loads them from the list anyway); -exist makes a repeat harmless */
+static void rw_seed_live(const char *ips)
+{
+	char ip[48];
+	const char *s, *e;
+	size_t l;
+
+	for (s = ips; *s; s = e) {
+		while (*s == ' ') s++;
+		for (e = s; *e && *e != ' '; e++) ;
+		if ((l = e - s) == 0 || l >= sizeof(ip))
+			continue;
+		memcpy(ip, s, l);
+		ip[l] = '\0';
+		eval("ipset", "add", strchr(ip, ':') ? "rw_allow6" : "rw_allow", ip, "-exist");
+	}
+}
+
+/* is every address of ips still in the whitelist */
+static int rw_seed_present(const char *ips)
+{
+	char *cur = rw_list_get("allow"), ip[48];
+	const char *s, *e;
+	size_t l;
+	int all = 1;
+
+	if (!cur)
+		return 1;	/* unreadable: say nothing rather than warn wrongly */
+	for (s = ips; all && *s; s = e) {
+		while (*s == ' ') s++;
+		for (e = s; *e && *e != ' '; e++) ;
+		if ((l = e - s) == 0 || l >= sizeof(ip))
+			continue;
+		memcpy(ip, s, l);
+		ip[l] = '\0';
+		if (rw_seed_has(cur, ip) == 0)
+			all = 0;
+	}
+	free(cur);
+	return all;
+}
