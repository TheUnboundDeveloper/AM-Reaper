diff --git a/release/src/router/rc/reaper_nv.h b/release/src/router/rc/reaper_nv.h
index 80230c33df5..9e6e1e0fb20 100644
--- a/release/src/router/rc/reaper_nv.h
+++ b/release/src/router/rc/reaper_nv.h
@@ -42,4 +42,30 @@
 	"  done\n" \
 	"  wait \"$_p\" 2>/dev/null; cat \"$_f\" 2>/dev/null; rm -f \"$_f\"\n" \
 	"}\n"
+
+/* _nvs (review 2026-10-24, Q-A-6): ONE guarded `nvram show` for a batch of single-line settings. The Security
+ * Review's inventory read 37 of them through 37 `_nv` calls - some 300 forks and most of a second every tick.
+ * Prints "name<TAB>value" for every name given, in order; an unset name prints an empty value; only the FIRST
+ * line of a value is taken and tabs are dropped from it, so a multi-line setting (sshd_authkeys) still goes
+ * through _nv. The dump holds every setting, passwords included, for the ~20 ms it exists: created 0600 under
+ * noclobber (the same planted-link rule as _nv), removed on every path. Returns 1 when the reader hung, so the
+ * caller can skip its tick rather than report every setting "removed". Same fputs-safe rule: no % characters. */
+#define REAPER_NVS_HELPER \
+	"# _nvs: one guarded `nvram show` for a batch of names -> \"name<TAB>value\" per name (first line of a value)\n" \
+	"_nvs() {\n" \
+	"  _f=/tmp/.nvs.$$\n" \
+	"  rm -f \"$_f\" 2>/dev/null\n" \
+	"  (umask 077; set -C; : > \"$_f\") 2>/dev/null || { logger -t reaper-nv \"refusing unsafe nv temp $_f\"; return 1; }\n" \
+	"  nvram show >\"$_f\" 2>/dev/null & _p=$!; _i=0\n" \
+	"  while kill -0 \"$_p\" 2>/dev/null; do\n" \
+	"    _i=$((_i+1))\n" \
+	"    if [ \"$_i\" -gt 250 ]; then kill -9 \"$_p\" 2>/dev/null; wait \"$_p\" 2>/dev/null; rm -f \"$_f\"; logger -t reaper-nv \"nvram show hung >5 s - killed (netlink wait)\"; return 1; fi\n" \
+	"    usleep 20000\n" \
+	"  done\n" \
+	"  wait \"$_p\" 2>/dev/null\n" \
+	"  awk -v K=\"$*\" 'BEGIN { n = split(K, a, \" \"); for (i = 1; i <= n; i++) w[a[i]] = 1 }\n" \
+	"    { e = index($0, \"=\"); if (!e) next; k = substr($0, 1, e - 1); if ((k in w) && !(k in v)) v[k] = substr($0, e + 1) }\n" \
+	"    END { for (i = 1; i <= n; i++) { x = (a[i] in v) ? v[a[i]] : \"\"; gsub(/[\\t\\r]/, \"\", x); print a[i] \"\\t\" x } }' \"$_f\"\n" \
+	"  rm -f \"$_f\"\n" \
+	"}\n"
 #endif
diff --git a/release/src/router/rc/reaper_usbmon.c b/release/src/router/rc/reaper_usbmon.c
index 4f9090c5b47..ae25b34ca95 100644
--- a/release/src/router/rc/reaper_usbmon.c
+++ b/release/src/router/rc/reaper_usbmon.c
@@ -523,6 +523,36 @@ static void rstore_adopt(unsigned long up)
 		best, best_t ? "it holds the most recent Reaper history" : "the only mounted volume");
 }
 
+/* 3. PUBLISH (2026-10-21, Long-Term Storage rows for Wallguard / Dreadwatch / Encrypted DNS): the
+ *    effective base + the opted-in datasets as RSTORE_PUB, for the scripts that read no nvram;
+ *    rewritten only on a change (or when the file went missing). Every location, not only usb.
+ *    A USB base that appears wakes Wallguard, whose lists may be on it. */
+static void rstore_publish(void)
+{
+	static char last[256] = "";
+	static int had_usb = 0;
+	char txt[256];
+	int usb;
+
+	if (nvram_match("reaper_store", "jffs"))
+		mkdir(RSTORE_JFFS_BASE, 0700);
+	if (!rstore_pub_text(nvram_safe_get("reaper_store"), nvram_safe_get("reaper_store_vid"),
+	    nvram_safe_get("reaper_store_ds"), RSTORE_MNT, 1, RSTORE_JFFS_BASE, txt, sizeof(txt)))
+		txt[0] = '\0';
+	if (strcmp(txt, last) || (txt[0] && access(RSTORE_PUB, F_OK) != 0)) {
+		if (!txt[0])
+			unlink(RSTORE_PUB);
+		else if (reaper_secure_dir(REAPER_TMPDIR, 0700) != 0 ||
+			 reaper_write_atomic(RSTORE_PUB, txt, strlen(txt), 0600) != 0)
+			return;
+		strlcpy(last, txt, sizeof(last));
+	}
+	usb = !strncmp(txt, RSTORE_MNT "/", sizeof(RSTORE_MNT));
+	if (usb && !had_usb)
+		wallguard_store_attached();
+	had_usb = usb;
+}
+
 void reaper_store_check(void)
 {
 	static unsigned long last = 0, seen_up = 0;
@@ -534,6 +564,7 @@ void reaper_store_check(void)
 	if (up - last < USBMON_EVERY_SECS)
 		return;
 	last = up;
+	rstore_publish();
 	if (!nvram_match("reaper_store", "usb"))
 		return;
 	strlcpy(vid, nvram_safe_get("reaper_store_vid"), sizeof(vid));
