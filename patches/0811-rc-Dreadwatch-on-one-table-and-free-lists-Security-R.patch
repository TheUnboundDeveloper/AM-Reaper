+/* 2026-10-24: before the first update on this firmware the table is rebuilt from the /jffs copy of the
+ * "<feeds> <name>" list - or, right after an upgrade, from the older reaper-nx= copy with every name under
+ * one "legacy" feed. Constant paths, root-run; exit 2 = no copy at all (the update will say so), 1 = a copy
+ * that would not build (logged). wallguardc validates every name, so nothing dnsmasq could refuse is installed. */
+static const char rw_nx_rebuild_sh[] =
+	"D=" RW_NX_DIR "; K=" RW_DNS_KGZ "; O=" RW_DNS_CACHE_GZ "; T=/tmp/rwarden/nx.rebuild.$$\n"
+	"mkdir -p $D; chmod 755 $D; rm -f $T.*\n"
+	"if [ -s $K ]; then gzip -dc $K > $T.k 2>/dev/null\n"
+	"elif [ -s $O ] || [ -s " RW_DNS_CACHE " ] || [ -s " RW_DNS_LEGACY " ]; then\n"
+	"  { [ -s $O ] && gzip -dc $O 2>/dev/null; cat " RW_DNS_CACHE " " RW_DNS_LEGACY " 2>/dev/null; } | sed -n -e 's|^reaper-nx=/\\(.*\\)/$|legacy \\1|p' -e 's|^address=/\\(.*\\)/$|legacy \\1|p' > $T.k\n"
+	"else exit 2; fi\n"
+	"[ -s $T.k ] || { rm -f $T.*; logger -t rwarden \"threat domains: the /jffs copy would not build into a table - blocking nothing until the next update\"; exit 1; }\n"
+	"/usr/sbin/wallguardc build --subtree --out $D/threat.db.new --kfile $T.k --kids \"" RW_DIDS_STR " other legacy\" >/dev/null 2>&1 && /usr/sbin/wallguardc check --db $D/threat.db.new >/dev/null 2>&1 && mv -f $D/threat.db.new $D/threat.db\n"
+	"R=$?; [ $R -eq 0 ] || { R=1; logger -t rwarden \"threat domains: the /jffs copy would not build into a table - blocking nothing until the next update\"; }\n"
+	"wc -l < $T.k | tr -d ' ' > " RW_DNS_COUNT "; head -n 1 $T.k | cut -d' ' -f2 > " RW_DNS_FIRST "; rm -f $T.* $D/threat.db.new; exit $R\n";
+
+/* review 2026-10-24 (Q-A-3, owner's call): the rebuild runs DETACHED. dnsmasq starts at once and maps the table
+ * within 2 s of its arrival (dnsmasq reaper_nx.c), instead of every boot waiting the 15-20 s the build takes;
+ * until it lands the threat list blocks nothing - that window is the trade for the faster boot. One rebuild at a
+ * time: a second start_dnsmasq while it runs (the extra networks' instances) finds the pid alive and leaves it be.
+ * The script logs its own failure now (it used to be read from the exit code). */
+#define RW_NX_REBUILD_PID	RW_DIR "/nx.rebuild.pid"
+static void rw_nx_rebuild_bg(void)
+{
+	char *argv[] = { "sh", "-c", (char *)rw_nx_rebuild_sh, NULL };
+	char buf[16] = "";
+	FILE *f;
+	int pid = 0;
+
+	if ((f = fopen(RW_NX_REBUILD_PID, "r")) != NULL) {
+		if (fgets(buf, sizeof(buf), f))
+			pid = atoi(buf);
+		fclose(f);
+		if (pid > 0 && kill(pid, 0) == 0)
+			return;
+	}
+	pid = 0;
+	if (_eval(argv, ">/dev/null", 0, &pid) != 0 || pid <= 0)
+		return;
+	if ((f = fopen(RW_NX_REBUILD_PID, "w")) != NULL) {
+		fprintf(f, "%d\n", pid);
+		fclose(f);
+	}
+	logmessage("rwarden", "threat domains: rebuilding the table from the /jffs copy in the background - in force once it lands");
+}
