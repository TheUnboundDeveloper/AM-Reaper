+++ b/release/src/router/www/reaper/rp.js
@@ -0,0 +1,392 @@
+/* SPDX-License-Identifier: GPL-2.0-only
+ * Copyright (C) 2026 the Reaper project maintainer
+ * Part of the Reaper hardened Asuswrt-Merlin build. See LICENSE / LICENSE.reaper.
+ *
+ * rp.js - the Reaper component kit's script half (Reaper-native UI, wave 0, 2026-10-22).
+ * Loaded after reaper_util.js (window.esc, ReaperNames, reaperConfirm live there). Everything is
