+        T('Reaper_Routes.asp', `<#menu5_7_6#>`, routing), T('Reaper_PortFwd.asp', `<#menu5_7_5#>`, routing),
+        T('Reaper_Conn.asp', `<#Connections#>`, !sup('sfp4m') && routing),
+        T('Reaper_Storage.asp', `<#RDST_00#>`)]},
