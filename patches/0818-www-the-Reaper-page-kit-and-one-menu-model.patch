+
+  /* menuTree's shape: {list:[{menuName,index,tab:[{url,tabName}]}], exclude} - what buildRail()
+     and the shell tab strip already consume. Sections become menu_Split entries, hidden-by-condition
+     menus and tabs are simply absent. */
+  function tree(F){
+    var model = build(F || pageFacts()), list = [], i, m, tabs, j, t;
+    for (i = 0; i < model.length; i++){
+      m = model[i];
+      if (m.section){ list.push({menuName: m.section, index: 'menu_Split', tab: [{url: 'NULL', tabName: '__HIDE__'}]}); continue; }
+      if (m.when === false) continue;
+      tabs = [];
+      for (j = 0; j < m.tabs.length; j++){ t = m.tabs[j]; if (t.when) tabs.push({url: t.url, tabName: t.label}); }
+      if (!tabs.length) continue;
+      tabs.push({url: 'NULL', tabName: '__INHERIT__'});
+      list.push({menuName: m.label, index: m.index, tab: tabs, badge: m.badge || ''});
+    }
+    return {list: list, exclude: {menus: function(){ return []; }, tabs: function(){ return []; }}};
+  }
+
+  /* the flat rail: one item per visible menu - its first non-inherit page, its pages, its icon */
+  function rail(F){
+    var t = tree(F).list, out = [], i, m, j, pages, first;
+    for (i = 0; i < t.length; i++){
+      m = t[i];
+      if (m.index === 'menu_Split'){ out.push({section: m.menuName}); continue; }
+      pages = []; first = '';
+      for (j = 0; j < m.tab.length; j++){
+        if (m.tab[j].url === 'NULL') continue;
+        pages.push(m.tab[j].url);
+        if (!first && m.tab[j].tabName !== '__INHERIT__') first = m.tab[j].url;
+      }
+      if (!first) first = pages[0];
+      out.push({index: m.index, label: m.menuName, page: first, pages: pages, icon: ICONS[m.index] || ICONS._default, badge: m.badge});
+    }
+    return out;
+  }
