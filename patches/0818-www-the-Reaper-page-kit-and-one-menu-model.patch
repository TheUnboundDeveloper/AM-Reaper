diff --git a/release/src/router/www/reaper/rp.css b/release/src/router/www/reaper/rp.css
new file mode 100755
index 00000000000..0edd39be446
--- /dev/null
+++ b/release/src/router/www/reaper/rp.css
@@ -0,0 +1,244 @@
+/* SPDX-License-Identifier: GPL-2.0-only
+   Copyright (C) 2026 the Reaper project maintainer
+   Part of the Reaper hardened Asuswrt-Merlin build. See LICENSE / LICENSE.reaper.
+
+   rp.css - the Reaper component kit (Reaper-native UI, wave 0, 2026-10-22).
+   One stylesheet every Reaper page loads instead of carrying these rules inline (the 29 pages
+   carried 245 KB of page CSS, 79 KB of it the same rules repeated). Class names are the ones the
+   pages already use, so a page migrates by dropping its copy of a rule, not by renaming markup.
+   Sections: tokens + fonts, base, page head, buttons + pills, panel, fields, toggles (grey by
+   design - a red ON toggle reads as an alert), tables, custom select, add-row, hint, applying
+   overlay, fly-out, scrollbar. Data visualisations keep their own colours (standing rule 2).
+   Cache: httpd serves this one file with max-age=60 (its own mime entry in httpd/web.c, ahead of the 1-hour
+   "**.css" rule), so a new image's look shows within a minute. Never link it with a ?query: do_file looks the
+   path up with the query and answers 404 (_r25, 2026-10-23). */
+
+@font-face{font-family:'Rajdhani';font-weight:600;font-display:swap;src:url('/fonts/rajdhani-600.woff2') format('woff2')}
+@font-face{font-family:'Rajdhani';font-weight:700;font-display:swap;src:url('/fonts/rajdhani-700.woff2') format('woff2')}
+@font-face{font-family:'Inter';font-weight:400;font-display:swap;src:url('/fonts/inter-400.woff2') format('woff2')}
+@font-face{font-family:'Inter';font-weight:500;font-display:swap;src:url('/fonts/inter-500.woff2') format('woff2')}
+@font-face{font-family:'Inter';font-weight:600;font-display:swap;src:url('/fonts/inter-600.woff2') format('woff2')}
+:root{
+  --bg:#08080a; --panel:#0f0f12; --panel-2:#141418; --raised:#101014;
+  --line:rgba(225,6,0,.16); --line-soft:rgba(255,255,255,.06); --line2:rgba(255,255,255,.10);
+  --crimson:#E10600; --crimson-deep:#B3000C; --red:#E10600; --red-dim:rgba(225,6,0,.18);
+  --bone:#ECE7DB; --bone-dim:#B7B1A4; --steel:#71767b;
+  --jade:#4FB286; --amber:#E0A93B;
+  --hdr:'Rajdhani','Oswald',system-ui,sans-serif;
+  --body:'Inter',system-ui,-apple-system,'Segoe UI',sans-serif;
+  --mono:ui-monospace,Consolas,'SF Mono',monospace;
+}
+*{box-sizing:border-box}
+html,body{margin:0;min-height:100%}
+body{font-family:var(--body);color:var(--bone-dim);background:var(--bg);
+  background-image:radial-gradient(1200px 500px at 18% -10%,rgba(225,6,0,.10),transparent 60%),
+    radial-gradient(100% 100% at 50% 40%,transparent 55%,rgba(0,0,0,.55) 100%);
+  -webkit-font-smoothing:antialiased;padding:22px 26px 60px}
+h1,h2,h3,.hdr{font-family:var(--hdr);letter-spacing:.04em;color:var(--bone);margin:0}
+.mono{font-family:var(--mono);font-variant-numeric:tabular-nums}
+a{color:var(--bone-dim)} a:hover{color:var(--bone)}
+.eyebrow{font-family:var(--hdr);text-transform:uppercase;letter-spacing:.22em;font-size:11px;color:var(--steel)}
+html{scrollbar-width:thin;scrollbar-color:var(--crimson) #000}
+::-webkit-scrollbar{width:12px;height:12px}
+::-webkit-scrollbar-track{background:#000}
+::-webkit-scrollbar-thumb{background:var(--crimson);border-radius:8px;border:2px solid #000}
+
+/* page head: eyebrow + title left, status pill, actions right */
+.pagehead{display:flex;align-items:center;gap:14px;margin-bottom:18px;flex-wrap:wrap}
+.pagehead h1{font-size:24px;font-weight:700}
+.spacer{flex:1}
+.pill{display:inline-flex;align-items:center;gap:7px;border:1px solid var(--line-soft);border-radius:999px;
+  padding:5px 12px;font-family:var(--hdr);font-weight:600;font-size:12px;letter-spacing:.06em;color:var(--bone-dim);background:var(--panel)}
+.pill .dot{width:8px;height:8px;border-radius:50%;background:var(--steel)}
+.pill.on .dot{background:var(--jade)} .pill.on{color:var(--bone)}
+.pill.warn .dot{background:var(--amber)} .pill.bad .dot{background:var(--crimson)}
+.btn{display:inline-block;border:1px solid var(--line-soft);background:var(--panel);color:var(--bone);
+  font-family:var(--hdr);font-weight:600;font-size:13px;letter-spacing:.05em;border-radius:9px;
+  padding:9px 18px;cursor:pointer;transition:.15s;text-transform:uppercase}
+.btn:hover{border-color:var(--line)}
+.btn.primary{background:linear-gradient(180deg,var(--crimson),var(--crimson-deep));border-color:transparent;color:#fff}
+.btn.primary:hover{filter:brightness(1.1)}
+.btn.ghost{background:transparent}
+.btn.small{padding:6px 12px;font-size:12px}
+.btn[disabled]{opacity:.45;cursor:default;filter:none}
+
+/* panel (card) */
+.panel{background:var(--panel);border:1px solid var(--line-soft);border-radius:14px;padding:18px 20px;margin-bottom:18px}
+/* a page's settings sections sit in one static crimson frame (owner, 2026-10-23: the look the stock skin gave the
+   System page in _r20 while the cursor was over it - its .tab:hover fill - kept on permanently; the translucent
+   crimson shows as thick bands between and around the sections); used by Reaper_System, Reaper_SNMP, Reaper_Tweaks */
+.rframe{background:rgba(225,6,0,.22);border:1px solid rgba(225,6,0,.30)}
+.panel h2{font-size:15px;font-weight:700;text-transform:uppercase;letter-spacing:.12em;margin-bottom:4px}
+.panel .sub{font-size:12.5px;color:var(--steel);margin:2px 0 14px;line-height:1.5}
+.duo{display:grid;grid-template-columns:1fr 1fr;gap:18px}
+@media (max-width:980px){.duo{grid-template-columns:1fr}}
+
+/* fields: label above control, unit after it */
+.bwrow{display:flex;gap:26px;flex-wrap:wrap}
+.bwfield label{display:block;font-family:var(--hdr);font-weight:600;font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:var(--bone-dim);margin-bottom:6px}
+.bwfield input,.bwfield select,.bwfield textarea{background:#000;border:1px solid var(--line-soft);border-radius:8px;color:var(--bone);
+  font-family:var(--body);font-size:14px;padding:9px 11px;width:150px;outline:none}
+.bwfield select{min-width:150px}
+.bwfield input.short{width:90px}
+.bwfield input:focus,.bwfield select:focus,.bwfield textarea:focus{border-color:var(--line)}
+.bwfield .unit{margin-left:7px;color:var(--steel);font-size:12px}
+.bwfield .qnote{margin-top:5px}
+/* a settings row: label | control | help (the stock FormTable shape, Reaper-styled) */
+.frow{display:grid;grid-template-columns:minmax(200px,320px) minmax(160px,1fr);gap:8px 22px;align-items:center;padding:10px 0;border-top:1px solid var(--line-soft)}
+.frow:first-of-type{border-top:none}
+.frow .fl{font-family:var(--hdr);font-weight:600;font-size:13.5px;letter-spacing:.05em;color:var(--bone)}
+.frow .fh{grid-column:1/-1;font-size:12px;color:var(--steel);line-height:1.5;margin-top:-4px}
+.frow input[type=text],.frow input[type=password],.frow input[type=number],.frow select,.frow textarea{background:#000;border:1px solid var(--line-soft);border-radius:8px;color:var(--bone);
+  font-family:var(--body);font-size:13.5px;padding:8px 10px;outline:none;max-width:100%}
+.frow input:focus,.frow select:focus,.frow textarea:focus{border-color:var(--line)}
+.frow.locked{opacity:.5}
+.qbadge{font-family:var(--hdr);font-weight:700;font-size:12px;color:var(--bone)}
+.qnote{font-size:10px;color:var(--steel);letter-spacing:.05em}
+.hint{font-size:12px;color:var(--steel);line-height:1.55;margin-top:10px}
+.hint b{color:var(--bone-dim);font-weight:600}
+.hint.warn{color:var(--amber)}
+
+/* toggles - NEUTRAL GREY by design (an ON toggle in brand red reads as an alert) */
+.togglerow{display:flex;align-items:flex-start;gap:12px;padding:10px 0;border-top:1px solid var(--line-soft)}
+.togglerow:first-of-type{border-top:none}
+.tswitch{position:relative;flex:0 0 42px;height:22px;margin-top:2px}
+.tswitch input{position:absolute;opacity:0;width:100%;height:100%;margin:0;cursor:pointer;z-index:2}
+.tswitch .track{position:absolute;inset:0;background:#26262b;border:1px solid var(--line-soft);border-radius:999px;transition:.15s}
+.tswitch .track::after{content:"";position:absolute;top:2px;left:2px;width:16px;height:16px;border-radius:50%;background:#6a6f75;transition:.15s}
+.tswitch input:checked ~ .track{background:#3a3f45}
+.tswitch input:checked ~ .track::after{left:22px;background:#c9cdd2}
+.tswitch input[disabled] ~ .track{opacity:.4}
+.tmeta .tname{font-family:var(--hdr);font-weight:600;font-size:13.5px;letter-spacing:.05em;color:var(--bone)}
+.tmeta .tdesc{font-size:12px;color:var(--steel);line-height:1.5;margin-top:2px}
+
+/* tables (the class-editor shape every list editor uses) */
+table.classes{width:100%;border-collapse:collapse;margin-top:6px}
+table.classes th{font-family:var(--hdr);font-weight:600;font-size:10.5px;letter-spacing:.14em;text-transform:uppercase;
+  color:var(--steel);text-align:left;padding:8px 10px;border-bottom:1px solid var(--line-soft)}
+table.classes td{padding:9px 10px;border-bottom:1px solid var(--line-soft);font-size:13px;color:var(--bone-dim)}
+table.classes tr:last-child td{border-bottom:none}
+table.classes input[type=text]{background:#000;border:1px solid var(--line-soft);border-radius:7px;color:var(--bone);
+  font-family:var(--body);font-size:13px;padding:7px 9px;outline:none}
+table.classes input[type=text]:focus{border-color:var(--line)}
+table.classes select{background:#000;border:1px solid var(--line-soft);border-radius:8px;color:var(--bone);font-family:var(--body);font-size:12.5px;padding:6px 8px;outline:none;max-width:170px}
+table.classes select:focus{border-color:var(--line)}
+table.classes td .unit{margin-left:5px;color:var(--steel);font-size:11px}
+table.classes th.num,table.classes td.num{text-align:right;font-variant-numeric:tabular-nums}
+.rcell{font-size:12.5px;color:var(--bone-dim);word-break:break-all}
+.rcell .rn{font-family:var(--hdr);font-weight:600;font-size:13px;color:var(--bone)}
+.arrows span{cursor:pointer;color:var(--steel);font-size:15px;padding:0 4px;user-select:none}
+.arrows span:hover{color:var(--bone)}
+.bwldel{cursor:pointer;color:var(--steel);font-size:19px;line-height:1;padding:2px 8px;user-select:none}
+.bwldel:hover{color:var(--crimson)}
+.empty{color:var(--steel);text-align:center;padding:16px}
+
+/* add-row under a table */
+.bwl-add{display:flex;gap:12px;flex-wrap:wrap;align-items:flex-end;margin-top:14px;padding-top:14px;border-top:1px solid var(--line-soft)}
+.bwl-add .f{display:flex;flex-direction:column;gap:5px}
+.bwl-add label{font-family:var(--hdr);font-weight:600;font-size:10.5px;letter-spacing:.1em;text-transform:uppercase;color:var(--steel)}
+.bwl-add input,.bwl-add select{background:#000;border:1px solid var(--line-soft);border-radius:8px;color:var(--bone);font-family:var(--body);font-size:13px;padding:8px 10px;outline:none}
+.bwl-add input:focus,.bwl-add select:focus{border-color:var(--line)}
+.bwl-add input.dev{width:220px}
+.bwl-add input.num{width:96px}
+.bwl-add .pair{display:flex;align-items:center;gap:6px;color:var(--steel)}
+.rbudget{font-size:11px;color:var(--steel);margin-top:8px;letter-spacing:.04em}
+.rbudget.hot{color:var(--amber)}
+
+/* custom select: a hidden native <select class="sel"> inside .selwrap, drawn by rp.js as a
+   centred button + fixed-position listbox (native option text cannot be centred) */
+.selwrap{position:relative;width:100%}
+.sel.enhanced{display:none}
+.csel{width:100%;position:relative;font-family:var(--body);font-size:12.5px;color:var(--bone);
+  background:var(--raised);border:1px solid var(--line2);border-radius:8px;padding:8px 26px;cursor:pointer;
+  text-align:center;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;user-select:none}
+.csel:hover{border-color:var(--steel)}
+.csel:focus-visible{outline:2px solid var(--red);outline-offset:1px}
+.csel[aria-disabled=true]{opacity:.5;cursor:default}
+.csel::after{content:"";position:absolute;right:11px;top:50%;width:7px;height:7px;
+  border-right:2px solid var(--steel);border-bottom:2px solid var(--steel);
+  transform:translateY(-70%) rotate(45deg);pointer-events:none}
+.cmenu{position:fixed;z-index:55;background:#101014;border:1px solid var(--line2);border-radius:8px;
+  padding:4px;box-shadow:0 18px 44px -12px #000;display:none;max-height:280px;overflow:auto}
+.cmenu.open{display:block}
+.copt{text-align:center;font-size:12.5px;color:var(--bone-dim);padding:7px 10px;border-radius:6px;cursor:pointer;white-space:nowrap}
+.copt:hover{background:var(--red-dim);color:var(--bone)}
+.copt.active{background:rgba(236,231,219,.07);color:var(--bone)}
+
+/* status chips */
+.statuspill{display:inline-flex;align-items:center;gap:6px;border-radius:999px;padding:3px 10px;font-family:var(--hdr);font-weight:600;font-size:11px;letter-spacing:.08em;text-transform:uppercase;border:1px solid var(--line-soft);color:var(--bone-dim)}
+.statuspill.ok{color:var(--jade);border-color:rgba(79,178,134,.35)}
+.statuspill.warn{color:var(--amber);border-color:rgba(224,169,59,.35)}
+.statuspill.bad{color:var(--crimson);border-color:var(--line)}
+.tag{font-family:var(--hdr);font-weight:600;font-size:9.5px;letter-spacing:.1em;text-transform:uppercase;
+  border:1px solid rgba(236,231,219,.22);border-radius:5px;padding:2.5px 7px;color:var(--bone-dim)}
+.tag.good{color:var(--jade);border-color:rgba(79,178,134,.35)}
+.tag.warn{color:var(--amber);border-color:rgba(224,169,59,.35)}
+
+/* applying overlay (rp.applying()) */
+.applying{position:fixed;inset:0;background:rgba(0,0,0,.78);display:none;z-index:60;place-items:center}
+.applying.show{display:grid}
+.applying .abox{text-align:center}
+.applying .abox h2{font-size:18px;margin-bottom:8px}
+.applying .abox p{color:var(--steel);font-size:13px}
+
+/* FAQ / help fly-out */
+.scrim{position:fixed;inset:0;background:rgba(0,0,0,.55);opacity:0;pointer-events:none;transition:.2s;z-index:40}
+.scrim.open{opacity:1;pointer-events:auto}
+.flyout{position:fixed;top:0;right:-460px;width:440px;max-width:92vw;height:100vh;background:var(--panel);
+  border-left:1px solid var(--line);z-index:41;transition:right .22s ease;display:flex;flex-direction:column}
+.flyout.open{right:0}
+.flyout .fhead{display:flex;align-items:center;gap:10px;padding:16px 18px;border-bottom:1px solid var(--line-soft)}
+.flyout .fhead h2{font-size:16px;font-weight:700;flex:1}
+.flyout .fclose{cursor:pointer;color:var(--steel);font-size:20px;line-height:1;padding:2px 6px}
+.flyout .fclose:hover{color:var(--bone)}
+.flyout .fbody{overflow-y:auto;padding:6px 18px 40px}
+.flyout details{border-bottom:1px solid var(--line-soft);padding:2px 0}
+.flyout summary{cursor:pointer;font-family:var(--hdr);font-weight:600;font-size:13.5px;letter-spacing:.04em;color:var(--bone);
+  padding:12px 2px;list-style:none;position:relative;padding-right:22px}
+.flyout summary::-webkit-details-marker{display:none}
+.flyout summary::after{content:"+";position:absolute;right:4px;top:10px;color:var(--steel);font-size:16px}
+.flyout details[open] summary::after{content:"\2013"}
+.flyout .fc{font-size:12.5px;line-height:1.65;color:var(--bone-dim);padding:0 2px 14px}
+.flyout .fc b{color:var(--bone);font-weight:600}
+.flyout .fc ul{margin:6px 0;padding-left:18px}
+.flyout .fc li{margin:4px 0}
+.flyout .fc .fx{color:var(--jade)}
+
+/* i18n overflow: clip, and rp.js sets a title on anything actually clipped */
+.rtip{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
+
+/* ---- page frame (review 2026-10-24, Q-C1-8 / Q-C2-11): rules the native pages each carried byte for byte;
+   one copy here, cached. A page's own variant of a rule still follows this file and wins. ---- */
+.win{position:relative;font-family:var(--hdr);font-weight:600;font-size:12.5px;letter-spacing:.06em;text-transform:uppercase;border:1px solid var(--line-soft);background:var(--panel);color:var(--bone-dim);border-radius:8px;padding:8px 16px;cursor:pointer}
+.secerr{display:none;font-size:12.5px;color:var(--amber);border:1px solid rgba(224,169,59,.35);border-radius:10px;padding:8px 12px;margin:0 0 12px}
+.frow .fc{display:flex;align-items:center;gap:10px;flex-wrap:wrap;min-width:0}
+.chk{display:inline-flex;align-items:center;gap:6px;font-size:12.5px;color:var(--bone-dim);cursor:pointer;user-select:none}
+.win.on{color:#fff;background:linear-gradient(180deg,var(--crimson),var(--crimson-deep));border-color:transparent}
+.win .cdot{display:none;position:absolute;top:5px;right:5px;width:7px;height:7px;border-radius:50%;background:var(--amber)}
+.syswrap{max-width:1180px}
+.chk input{accent-color:#9a9fa6;width:14px;height:14px;margin:0}
+.panel.broken .secerr{display:block}
+.chgpill.show{display:inline-flex}
+.rtab th{font-family:var(--hdr);font-weight:600;font-size:10.5px;letter-spacing:.14em;text-transform:uppercase;color:var(--steel);text-align:left;padding:7px 10px;border-bottom:1px solid var(--line-soft)}
+.msg.show{display:block}
+.rtab{width:100%;border-collapse:collapse;margin:4px 0 6px;font-size:12.5px}
+.chgpill{display:none}
+.win:hover{border-color:var(--line)}
+.radios label{display:inline-flex;align-items:center;gap:6px;font-size:13px;color:var(--bone-dim);cursor:pointer}
+.rtab tr:last-child td{border-bottom:none}
+.edmsg{font-size:12.5px;color:var(--amber);margin-top:8px;display:none}
+.note.show{display:block}
+.win.dirty .cdot{display:block}
+table.classes td.acts{white-space:nowrap;text-align:right}
+.frow input.mid{width:240px}
+.win.gone{display:none}
+.tab.on{display:block}
+.tab{display:none}
+.rtab td.name{color:var(--bone);word-break:break-word}
+.radios{display:flex;gap:16px;flex-wrap:wrap}
+.radios input{accent-color:#9a9fa6;margin:0}
+table.classes tr.dim td{color:var(--steel)}
+.frow input.short{width:96px}
+.edmsg.show{display:block}
+.bwl-add input.ip{width:150px}
+.kv .k{color:var(--steel)}
diff --git a/release/src/router/www/reaper/rp.js b/release/src/router/www/reaper/rp.js
