+/* SPDX-License-Identifier: GPL-2.0-only
+ * Copyright (C) 2026 the Reaper project maintainer
+ * Part of the Reaper hardened Asuswrt-Merlin build. See LICENSE / LICENSE.reaper.
+ *
+ * menu.js - the Reaper menu model (Reaper-native UI, wave 0, 2026-10-22).
+ *
+ * ONE declarative list of sections, menus and pages, each with the condition that shows it. The
+ * shell rail, the shell tab strip and the dashboard rail all render from it, so the three can no
+ * longer disagree (the dashboard rail used to be a hand-kept copy that ignored every condition).
+ * The conditions are the ones www/require/menuTrees/menuTree.js evaluated (inventory 2026-10-22),
+ * carried over one by one; the facts they read come straight from httpd here, so no page needs
+ * state.js (and its 500 KB of stock script) to draw a menu.
+ *
+ * menuTree.js stays only as the file Merlin add-ons bind-mount their pages into: reaper_util.js's
+ * ReaperAddons lifts those out, and the rails append them as the Add-ons section.
+ *
+ * Shape: ReaperMenu.tree(facts?) -> {list, exclude} in menuTree's own format, so the shell's
+ * buildRail()/tab strip take it unchanged; ReaperMenu.rail(facts?) -> the flat rail list the
+ * dashboard draws. tabName '__HIDE__' = reachable but no tab chip, '__INHERIT__' = no own chip
+ * (reached from links on the previous tab) - both exactly as before, until each page's wave.
+ *
+ * Every visible string is a dict token (standing rule 24); build() takes plain strings so the
+ * host test can run the model under node with crafted facts.
+ */
+(function(){
+  'use strict';
+
+  /* ---- facts, filled by httpd (the same ej calls state.js uses) ---- */
+  function pageFacts(){
+    var ui = {}, mode = 'rt';
+    try { ui = [<% get_ui_support(); %>][0] || {}; } catch (e) {}
+    try { mode = String([<% get_operation_mode(); %>][0] || 'rt').toLowerCase(); } catch (e) {}
+    return {
+      ui: ui, mode: mode,
+      wans_dualwan: '<% nvram_get("wans_dualwan"); %>',
+      wlc_band: '<% nvram_get("wlc_band"); %>',
+      mlo_rp: '<% nvram_get("mlo_rp"); %>', mlo_mb: '<% nvram_get("mlo_mb"); %>'
+    };
+  }
+
+  /* ---- the model ---- */
+  function build(F){
+    var sup = function(x){ return !!(F.ui && F.ui[x]); };
+    var mode = String(F.mode || 'rt').toLowerCase();
+    var is = function(){ for (var i = 0; i < arguments.length; i++) if (mode === arguments[i]) return true; return false; };
+    var routing = !is('rp', 'ap', 'mb');                      /* the modes that route: router / WISP */
+    var usbIndex = (' ' + (F.wans_dualwan || '') + ' ').split(' ').indexOf('usb') - 1;
+    var dualWAN = (F.wlc_band || '') === '' && sup('dualwan');
+    var dw = (F.wans_dualwan || '').split(' '), dualwanEnabled = dw.length > 1 && dw[1] !== '' && dw[1] !== 'none';
+    var concurrep = sup('concurrep') && F.mlo_rp !== '1' && F.mlo_mb !== '1';
+    var rpRSSI = is('rp') && sup('user_low_rssi');            /* repeater with the stock RSSI tabs hidden */
+    /* menuTree.js:536-545 - amasRouter decides by mode and is checked FIRST; amasNode hides it only on a
+       node-only model (a router that can also be a node, e.g. the RT-BE96U, reports both) */
+    var aimeshRouterUI = sup('amas') && (sup('amasRouter') ? is('rt', 'wisp', 'ap') : !sup('amasNode'));
+    var T = function(url, label, when, flag){ return {url: url, label: label, when: (when === undefined ? true : when), flag: flag || ''}; };
+    var HIDE = '__HIDE__', INH = '__INHERIT__';
+
+    return [
+      {section: `<#menu5_1_1#>`},
+      {index: 'menu_Index', label: `<#Reaper_c_dashboard#>`, tabs: [T('Main_ReaperDash.asp', HIDE)]},
+      {index: 'menu_AiMesh', label: 'AiMesh', when: aimeshRouterUI, tabs: [T('AiMesh.asp', 'AiMesh')]},
+      {index: 'menu_GuestNetwork', label: sup('sdn_mwl') ? `<#Network#>` : `<#Guest_Network#>`, when: sup('mssid') && !is('rp', 'mb'), tabs: [
