+        T('Reaper_SmartConnect.asp', `<#smart_connect_rule#>`, (sup('smart_connect') || sup('bandstr') || sup('smart_connect_v2')) && !sup('qcawifi') && !sup('rawifi') && !is('rp', 'mb')),
+        T('Reaper_Survey.asp', `<#WiFi_sitesurvey#>`)]}
+    ];
