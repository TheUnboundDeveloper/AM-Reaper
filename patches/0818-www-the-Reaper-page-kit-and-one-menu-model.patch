+        T('Advanced_ACL_Content.asp', `<#menu5_1_4#>`, !sup('sdn_mainfh') && !rpRSSI),
+        T('Advanced_WSecurity_Content.asp', `<#menu5_1_5#>`, !sup('sdn_mainfh') && !rpRSSI),
