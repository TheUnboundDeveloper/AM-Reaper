diff --git a/release/src/router/rc/rwatch.c b/release/src/router/rc/rwatch.c
index aa0fdcac839..4e30229899e 100644
--- a/release/src/router/rc/rwatch.c
+++ b/release/src/router/rc/rwatch.c
@@ -983,6 +983,18 @@ static void rwatch_gen(void)
 	   * lock. Held off until HEALGRACE, and skipped while a rules candidate is
 	   * armed: the exposure keys are mid-change by design during commit-confirm,
 	   * and a report taken then would name the operator's own edit as drift. */
+	  /* 2026-10-26 (_r39 metal: the review card and the dashboard flagged /jffs/nvram/asus_device_list 0666 an hour
+	   * after boot). The boot sweep (shared/reaper_jfile.c reaper_jffs_perm_sweep) clears write-for-everyone once,
+	   * but ASUS's prebuilt device discovery rewrites that JFFS-backed setting with the bit set again, and there is
+	   * no source to fix. So each tick takes the bit off /jffs/nvram files that have it - only those, so an
+	   * unchanged file's inode is never touched (flash wear) - before the review looks. One log line per boot.
+	   * Anything else under /jffs that gains the bit is still the review's finding. */
+	  "# 3g2) /jffs/nvram: write-for-everyone off again (a stock binary re-adds it)\n"
+	  "_nvw=$(ls -lan /jffs/nvram 2>/dev/null | awk '$1 ~ /^-.......w/ { n=$0; for (i=1;i<=8;i++) sub(/^[^ ]+ +/, \"\", n); if (n !~ /\\// && n != \".\" && n != \"..\") print n }')\n"
+	  "if [ -n \"$_nvw\" ]; then\n"
+	  "  for _f in $_nvw; do [ -f \"/jffs/nvram/$_f\" ] && [ ! -L \"/jffs/nvram/$_f\" ] && chmod o-w \"/jffs/nvram/$_f\"; done\n"
+	  "  [ -f $RV_TMP/nvw.said ] || { logger -t rwatch \"removed write-for-everyone from /jffs/nvram: $(echo $_nvw) (a stock binary sets it when it rewrites the file; checked every tick)\"; : > $RV_TMP/nvw.said; }\n"
+	  "fi\n"
 	  "# 3h) security review (advisory - never a FAILURE): what changed since the\n"
 	  "#     operator accepted a baseline - see _rv_run above\n"
 	  "if [ \"$UP\" -ge \"$HEALGRACE\" ] && [ ! -f /tmp/reaper_fw/armed ]; then _rv_run; fi\n"
