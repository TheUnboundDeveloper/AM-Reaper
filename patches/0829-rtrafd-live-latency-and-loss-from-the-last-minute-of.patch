From 9325fd6aac64edb74f122bb704cc74d567315971 Mon Sep 17 00:00:00 2001
From: reaper <theunbounddeveloper@outlook.com>
Date: Mon, 19 Oct 2026 16:58:49 -0400
Subject: [PATCH] rtrafd: live latency and loss from the last minute of probes;
 the Traffic page says when the collector is off

Owner (RT-BE96U): the Latency and Loss tiles vanished until the probe target
was re-applied. The live figure was the running average of the open 5-minute
bucket, falling back to a slot hist_tick had just zeroed, so it read 0 right
after every boundary and for as long as the target was unreachable - and the
page dropped both tiles on a 0. The live value now comes from a 12-probe
window (the last 60 s) kept apart from the history bucket, with the probe
state (configured, consecutive start failures) reported alongside.

Traffic page: with the collector off nothing on the page has data, so it says
that once, with the switch, instead of drawing empty charts under a green
Live pill (field, BQ16). Status chips in the two standing colours; a button
chip opens the setting it names. rtrafd resolves its store through the
pinned volume (reaper_store.h).

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 release/src/router/rtrafd/rtrafd.c        | 165 ++++++++++++++------
 release/src/router/www/Reaper_Traffic.asp | 180 ++++++++++++++++------
 2 files changed, 250 insertions(+), 95 deletions(-)

diff --git a/release/src/router/rtrafd/rtrafd.c b/release/src/router/rtrafd/rtrafd.c
index 5e0a54e9b9..2edc10ba13 100644
--- a/release/src/router/rtrafd/rtrafd.c
+++ b/release/src/router/rtrafd/rtrafd.c
@@ -66,6 +66,7 @@
 #include <shutils.h>
 #include <shared.h>
 #include <mtlan_utils.h>	/* SDN/VLAN identity behind each LAN bridge */
+#include <reaper_store.h>	/* 2026-10-18: the pinned USB store volume */
 
 /* Dual cadence: a fast 100 ms base tick drives the live view (WAN rate +
  * live.json write) so the page's "Live" refresh mode gets true 100 ms samples
@@ -383,6 +384,18 @@ static const char *ip_bridge(uint32_t ip)
 static uint64_t prb_rtt_sum = 0;
 static uint32_t prb_n = 0, prb_lost = 0;
 
+/* Live latency/loss: the last PRB_WIN probe results, kept apart from the 5-min
+ * history bucket. 2026-10-17 (owner): the live figure used to be the running
+ * average of the open bucket, falling back to a slot hist_tick had just zeroed,
+ * so it read 0 whenever the bucket held no reply - right after every boundary,
+ * and for as long as the target stayed unreachable - and the page dropped both
+ * tiles on a 0. */
+#define PRB_WIN	12			/* 12 x PROBE_EVERY = the last 60 s */
+static int32_t prbw[PRB_WIN];		/* RTT in us, or -1 for no reply */
+static int prbw_len = 0, prbw_pos = 0;
+static int prb_set = 0;			/* a valid probe target is configured */
+static uint32_t prb_err = 0;		/* consecutive pings that could not be started */
+
 /* quota syslog once-flags */
 static int warned80 = 0, warned100 = 0, warn_month = -1;
 
@@ -1620,32 +1633,76 @@ static void poll_conntrack(void)
 	if (hcount) { hp_count_publish(); hp_ct_want = 0; hp_ct_ready = 1; }
 }
 
+static void prbw_push(int32_t rtt_us)
+{
+	prbw[prbw_pos] = rtt_us;
+	prbw_pos = (prbw_pos + 1) % PRB_WIN;
+	if (prbw_len < PRB_WIN) prbw_len++;
+}
+
+/* the live window: attempts, replies, mean RTT of the replies, loss % of the
+ * attempts. Order does not matter, and until the ring fills the results sit in
+ * prbw[0..len-1]. */
+static void prbw_stats(int *n, int *ok, uint64_t *rtt_us, uint64_t *loss)
+{
+	int i, k = 0;
+	uint64_t sum = 0;
+	for (i = 0; i < prbw_len; i++)
+		if (prbw[i] >= 0) { sum += (uint64_t)prbw[i]; k++; }
+	*n = prbw_len;
+	*ok = k;
+	*rtt_us = k ? sum / (uint64_t)k : 0;
+	*loss = prbw_len ? (uint64_t)(prbw_len - k) * 100 / (uint64_t)prbw_len : 0;
+}
+
 static void poll_probe(void)
 {
+	static time_t err_logged = 0;
 	char tgt[64], out[2048], *l, *nl;
 	int got = 0;
+	uint64_t us = 0;
 	ssize_t r;
 	strlcpy(tgt, nvram_safe_get("rtraf_probe"), sizeof(tgt));
-	if (!host_ok(tgt)) return;
+	prb_set = host_ok(tgt);
+	if (!prb_set) { prbw_len = prbw_pos = 0; prb_err = 0; return; }
 	{
 		/* 2026-10-03: no shell - host_ok() already bounds the characters */
 		char *av[] = { "ping", "-c", "1", "-W", "2", tgt, NULL };
 		r = rt_exec_bounded(av, out, sizeof(out), 6);
 	}
-	if (r < 0) return;
+	if (r < 0) {
+		/* the ping never ran (pipe or fork failed): not a loss at the target,
+		 * so it stays out of the loss figure, but it must not pass silently -
+		 * it used to return here uncounted and unlogged, and the page read
+		 * the resulting zeros as "no probe". Empty the window so the page
+		 * shows no figure rather than a frozen one. */
+		int e = errno;
+		prb_err++;
+		prbw_len = prbw_pos = 0;
+		if (prb_err == 1 && (err_logged == 0 || mono_secs() - err_logged >= 600)) {
+			syslog(LOG_WARNING, "rtrafd: latency probe could not start ping (%s)", strerror(e));
+			err_logged = mono_secs();
+		}
+		return;
+	}
+	prb_err = 0;
 	for (l = out; l != NULL && *l != '\0'; l = nl) {
 		char *t;
 		nl = strchr(l, '\n');
 		if (nl != NULL) *nl++ = '\0';
 		t = strstr(l, "time=");
-		if (t) {
+		if (t && !got) {	/* first reply only - a DUP! line must not double the sum */
 			double ms = atof(t + 5);
-			prb_rtt_sum += (uint64_t)(ms * 1000.0);
+			if (ms < 0) ms = 0;
+			if (ms > 60000.0) ms = 60000.0;
+			us = (uint64_t)(ms * 1000.0);
 			got = 1;
 		}
 	}
 	prb_n++;
-	if (!got) prb_lost++;
+	if (got) prb_rtt_sum += us;
+	else     prb_lost++;
+	prbw_push(got ? (int32_t)us : -1);
 }
 
 static void probe_close_bucket(void)
@@ -1815,16 +1872,17 @@ static void write_live(const char *store)
 	fprintf(o, ",\"quota\":{\"used\":%llu,\"cap_gb\":%llu}",
 		(unsigned long long)(r_wan->bm[imcur].rx + r_wan->bm[imcur].tx),
 		(unsigned long long)cap_gb);
-	/* live probe = running average since the current 5-min bucket opened;
-	 * the ring slot is only stamped at bucket close, so reading it directly
-	 * showed 0 for most of each window. Fall back to the last closed slot
-	 * until the first sample of a new bucket lands. */
+	/* live probe = the last PRB_WIN results (see prbw). set: a target is
+	 * configured; n: attempts in the window; ok: replies; err: consecutive
+	 * pings that could not be started. The page keys the tiles on `set` and
+	 * the figures on n/ok - an RTT of 0 no longer means "no probe". */
 	{
-		uint64_t live_rtt = (prb_n > prb_lost) ? prb_rtt_sum / (prb_n - prb_lost)
-						       : r_prb->b5[i5cur].rx;
-		uint64_t live_loss = prb_n ? (prb_lost * 100) / prb_n : r_prb->b5[i5cur].tx;
-		fprintf(o, ",\"probe\":{\"rtt_us\":%llu,\"loss\":%llu}",
-			(unsigned long long)live_rtt, (unsigned long long)live_loss);
+		int pn, pok;
+		uint64_t prtt, ploss;
+		prbw_stats(&pn, &pok, &prtt, &ploss);
+		fprintf(o, ",\"probe\":{\"set\":%d,\"n\":%d,\"ok\":%d,\"rtt_us\":%llu,\"loss\":%llu,\"err\":%u}",
+			prb_set, pn, pok, (unsigned long long)prtt, (unsigned long long)ploss,
+			(unsigned)prb_err);
 	}
 	fprintf(o, ",\"top\":[");
 	for (i = 0; i < ntop; i++) {
@@ -2355,41 +2413,23 @@ static const char *resolve_store(char *buf, size_t len)
 			return "jffs";
 		}
 	} else if (strcmp(mode, "usb") == 0) {
-		/* v2.1.7 (field: "USB history reset by a firmware flash"): the upgrade
-		 * flow runs `ejusb -1` BEFORE services stop, which can leave the bare
-		 * /tmp/mnt/<label> mountpoint DIRECTORY behind on tmpfs. The old scan
-		 * then recreated reaper/ inside it and the final save wrote the whole
-		 * history into RAM - "saved" successfully, gone at reboot. A real USB
-		 * mount has a different st_dev from tmpfs /tmp/mnt, so skip any entry
-		 * that is not actually a mounted filesystem. Also scan in two passes,
-		 * preferring the partition that already holds reaper/rtraf.db, so a
-		 * box with several USB partitions keeps saving to the one that has
-		 * the history instead of whichever readdir happens to list first. */
-		struct stat mroot, ms;
-		DIR *d;
-		struct dirent *e;
-		int pass;
-		if (stat("/tmp/mnt", &mroot) != 0) { buf[0] = '\0'; return "ram"; }
-		for (pass = 0; pass < 2; pass++) {
-			if ((d = opendir("/tmp/mnt")) == NULL) break;
-			while ((e = readdir(d)) != NULL) {
-				char p[144], db[160];
-				if (e->d_name[0] == '.') continue;
-				snprintf(p, sizeof(p), "/tmp/mnt/%s", e->d_name);
-				if (stat(p, &ms) != 0 || ms.st_dev == mroot.st_dev)
-					continue;	/* bare dir on tmpfs, not a mount */
-				snprintf(p, sizeof(p), "/tmp/mnt/%s/reaper", e->d_name);
-				snprintf(db, sizeof(db), "%s/rtraf.db", p);
-				if (pass == 0 && access(db, F_OK) != 0)
-					continue;	/* pass 0 wants an existing db */
-				mkdir(p, 0700);
-				if (dir_ok(p) && access(p, W_OK) == 0) {
-					strlcpy(buf, db, len);
-					closedir(d);
-					return "usb";
-				}
-			}
-			closedir(d);
+		/* 2026-10-18 (field: one SSD, two partitions, the history split between
+		 * them): USB is the PINNED volume only - the one whose .reaper/store.id
+		 * matches nvram reaper_store_vid (shared/reaper_store.h). Never "the
+		 * first mounted entry" (readdir order = mount order = a race), never a
+		 * folder created here. Pin absent = RAM, and the late-attach window in
+		 * main() waits for it. The v2.1.7 guards are kept by construction: the id
+		 * file lives on the real mount (a bare tmpfs mountpoint has none), and
+		 * with one candidate there is no "prefer the volume with a db" pass. The
+		 * db moves from the pre-pin reaper/ folder into .reaper/ on first use. */
+		char vid[24], vol[64], base[128], vdir[96];
+		strlcpy(vid, nvram_safe_get("reaper_store_vid"), sizeof(vid));
+		if (rstore_find(RSTORE_MNT, 1, vid, vol, sizeof(vol), base, sizeof(base))) {
+			snprintf(vdir, sizeof(vdir), RSTORE_MNT "/%s", vol);
+			if (rstore_migrate_rtraf(vdir))
+				syslog(LOG_NOTICE, "rtrafd: moved the traffic history on %s into " RSTORE_DIR "/", vol);
+			snprintf(buf, len, "%s/rtraf.db", base);
+			return "usb";
 		}
 	}
 	buf[0] = '\0';
@@ -2650,6 +2690,11 @@ int main(int argc, char **argv)
 	time_t last_save, boot_m;	/* v3.3.3: monotonic, see mono_secs() */
 	int db_attached = 0;	/* requested store reachable + old db (if any) loaded */
 	int db_gave_up = 0;	/* retry window expired without the medium appearing */
+	/* 2026-10-18: where this run attached, and whether it was asked for a store
+	 * at all - the final save goes back there, never into a store that a
+	 * store_set change named while we were running (see the exit path) */
+	char att_path[160] = "";
+	int want_store = nvram_safe_get("rtraf_path")[0] ? 1 : 0;
 	int i;
 
 	if (daemon(0, 0) < 0) return 1;
@@ -2714,6 +2759,7 @@ int main(int argc, char **argv)
 		else if (lr > 0)
 			db_align();
 		db_attached = 1;
+		strlcpy(att_path, dbpath, sizeof(att_path));
 	} else if (nvram_safe_get("rtraf_path")[0]) {
 		syslog(LOG_NOTICE,
 		       "rtrafd: store '%s' not mounted yet - holding history in RAM and retrying for %d s",
@@ -2901,6 +2947,7 @@ int main(int argc, char **argv)
 						else if (lr > 0)
 							db_align();
 						db_attached = 1;
+						strlcpy(att_path, dbpath, sizeof(att_path));
 						syslog(LOG_NOTICE, "rtrafd: store came up late - attached %s", dbpath);
 					}
 				} else {
@@ -2931,6 +2978,7 @@ int main(int argc, char **argv)
 				} else
 					db_park_prev(dbpath);
 				db_attached = 1;
+				strlcpy(att_path, dbpath, sizeof(att_path));
 			}
 			db_save(dbpath);
 			health_flush_spool();	/* v2.2.4: flush spooled health history here, off the hot loop */
@@ -2956,6 +3004,25 @@ int main(int argc, char **argv)
 	}
 
 	store = resolve_store(dbpath, sizeof(dbpath));
+	/* 2026-10-18: store_set restarts us with nvram ALREADY naming the new
+	 * store. Re-resolving here wrote this run's history over the new store's
+	 * own (a volume move) or parked it as .prev (RAM -> a store that has
+	 * history). Reaper_Storage.asp promises the old store keeps its history
+	 * and the new one continues from its own, so: a run that attached saves
+	 * back where it attached while that directory is still there (ejected =
+	 * the last periodic save stands), and a run that was never asked for a
+	 * store writes none on the way out. */
+	if (!want_store)
+		dbpath[0] = '\0';
+	else if (db_attached && att_path[0] && strcmp(att_path, dbpath)) {
+		char ad[160], *sl;
+		strlcpy(ad, att_path, sizeof(ad));
+		if ((sl = strrchr(ad, '/')) != NULL) *sl = '\0';
+		if (dir_ok(ad) && access(ad, W_OK) == 0)
+			strlcpy(dbpath, att_path, sizeof(dbpath));
+		else
+			dbpath[0] = '\0';
+	}
 	set_store_dir(dbpath);
 	if (dbpath[0] && !db_attached)
 		db_park_prev(dbpath);
