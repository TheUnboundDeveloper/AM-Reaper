+static void mc_nop_read(char *rec, size_t len)
+{
+	FILE *f = fopen(MC_NOP, "r");
+	size_t n = f ? fread(rec, 1, len - 1, f) : 0;
+
+	if (f)
+		fclose(f);
+	rec[n] = 0;
+}
+
+/* written only when it changed; an empty record is no file */
+static void mc_nop_write(const char *rec, const char *was)
+{
+	if (!strcmp(rec, was))
+		return;
+	if (!rec[0]) {
+		unlink(MC_NOP);
+		return;
+	}
+	mkdir(MC_REC, 0755);
+	reaper_write_atomic(MC_NOP, rec, strlen(rec), 0600);
+}
 
