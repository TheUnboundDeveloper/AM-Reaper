+/*
+ * mc_compat()'s DFS answer as the plan stores it (2026-10-19). Unknown (-1: this
+ * router's own entry is missing from the AiMesh lists, so there is no radar flag to
+ * read) counts as DFS. A non-DFS entry may become a lifted exclusion and the
+ * watcher's direct-move target, and both assume no radar check is needed there -
+ * under ETSI EN 301 893 as under the FCC rules. Failing towards DFS only costs the
+ * lift and the move; the picker still chooses, with its own radar handling.
+ */
+static unsigned char mc_dfs_flag(int d)
+{
+	return d != 0;
+}
+
 /*
  * Owner ruling 2026-10-16: when the exclusions in force leave the nodes no non-DFS
  * chanspec at or above the floor, un-exclude exactly the non-DFS chanspecs every
@@ -550,6 +583,176 @@ static int mc_relift(const char *old, char *cur, char *lifted, size_t liftedlen)
 	}
 	return k;
 }
+
+/*
+ * Field 2026-10-18 (owner RT-BE96U, RT-AX92U node): the node's lists lost channels 116-128
+ * for 30 minutes at a time and got them back - a radar detection's non-occupancy period on
+ * the node (the main router, on 100/160 with its own check cleared, saw none) - and every
+ * return made 100/160 fit again, so the plan followed the cycle and the node's 5 GHz backhaul
+ * was off for hours. A channel a node listed as usable and then stopped listing is therefore
+ * held unusable for MC_NOP_HOLD after the last time it went, in a record of
+ *   MAC band channel expires-at
+ * lines; an entry is refreshed while the drops repeat and lapses by itself. Nothing is
+ * recorded while the clock has not been set (an expiry would be meaningless), and an entry
+ * with such an expiry is ignored.
+ */
+#define MC_NOP_HOLD	(6 * 3600L)	/* s a dropped channel stays out after the last drop */
+#define MC_NOP_MAX	4096
+#define MC_NOP_MAXDROP	128
+#define MC_CLOCK_SANE	1704067200L	/* 2024-01-01: a clock before this has not been set */
+
+static const char *mc_band_name(int b) { return b == MC_B24 ? "2.4 GHz" : b == MC_B5 ? "5 GHz" : "6 GHz"; }
+
+/* one record line; 1 read, 0 end, -1 malformed (every reader skips it, the next rewrite drops it) */
+static int mc_nop_next(const char **pp, char *mac, int *band, int *ch, long *exp)
+{
+	const char *p = *pp, *nl;
+	int n;
+
+	while (*p == '\n' || *p == '\r')
+		p++;
+	if (!*p)
+		return 0;
+	nl = strchr(p, '\n');
+	*pp = nl ? nl + 1 : p + strlen(p);
+	n = sscanf(p, "%17s %d %d %ld", mac, band, ch, exp);
+	return (n == 4 && *band >= 0 && *band < MC_NB && *ch > 0 && *ch < MC_NCH) ? 1 : -1;
+}
+
+static const struct mc_node *mc_node_by_mac(const struct mc_nodes *nds, const char *mac)
+{
+	int i;
+	for (i = 0; i < nds->n; i++)
+		if (!strcmp(nds->v[i].mac, mac))
+			return &nds->v[i];
+	return NULL;
+}
+
+struct mc_drop { const char *mac; int band, ch; unsigned char seen; };	/* seen: 1 refreshed, 2 new */
+
+/*
+ * Bring the record up to date: lapsed entries go; every channel a node in cur stopped listing
+ * since prev (the lists as kept) is recorded, or refreshed, with expiry now + hold. prev may be
+ * NULL (prune only). Returns how many entries are NEW; fresh names them for the log line.
+ */
+int mc_nop_update(char *rec, size_t len, const struct mc_nodes *prev, const struct mc_nodes *cur,
+		  long now, long hold, char *fresh, size_t freshlen)
+{
+	static struct mc_drop drops[MC_NOP_MAXDROP];
+	static char out[MC_NOP_MAX];
+	char mac[18], line[64];
+	const char *p = rec, *lmac = NULL;
+	size_t olen = len < sizeof(out) ? len : sizeof(out);
+	int nd = 0, nnew = 0, band, ch, i, r, lband = -1;
+	long exp;
+
+	if (fresh && freshlen)
+		fresh[0] = 0;
+	if (now < MC_CLOCK_SANE)
+		return 0;
+	/* 1. what went: usable in the kept lists, not usable now */
+	if (prev) {
+		for (i = 0; i < cur->n && nd < MC_NOP_MAXDROP; i++) {
+			const struct mc_node *c = &cur->v[i], *o;
+			if (!c->is_re || (o = mc_node_by_mac(prev, c->mac)) == NULL)
+				continue;
+			for (band = 0; band < MC_NB; band++) {
+				if (!c->b[band].present || !o->b[band].present)
+					continue;
+				for (ch = 1; ch < MC_NCH && nd < MC_NOP_MAXDROP; ch++)
+					if (mc_usable(o->b[band].flag[ch]) && !mc_usable(c->b[band].flag[ch])) {
+						drops[nd].mac = c->mac;
+						drops[nd].band = band;
+						drops[nd].ch = ch;
+						drops[nd].seen = 0;
+						nd++;
+					}
+			}
+		}
+	}
+	/* 2. the record again: lapsed entries out, a repeated drop refreshed */
+	out[0] = 0;
+	while ((r = mc_nop_next(&p, mac, &band, &ch, &exp)) != 0) {
+		if (r < 0 || exp < MC_CLOCK_SANE || exp <= now)
+			continue;
+		for (i = 0; i < nd; i++)
+			if (!drops[i].seen && drops[i].band == band && drops[i].ch == ch && !strcmp(drops[i].mac, mac)) {
+				drops[i].seen = 1;
+				exp = now + hold;
+				break;
+			}
+		snprintf(line, sizeof(line), "%s %d %d %ld\n", mac, band, ch, exp);
+		if (strlen(out) + strlen(line) < olen)
+			strlcat(out, line, olen);
+	}
+	/* 3. the new drops */
+	for (i = 0; i < nd; i++) {
+		if (drops[i].seen)
+			continue;
+		snprintf(line, sizeof(line), "%s %d %d %ld\n", drops[i].mac, drops[i].band, drops[i].ch, now + hold);
+		if (strlen(out) + strlen(line) >= olen)
+			break;
+		strlcat(out, line, olen);
+		drops[i].seen = 2;
+		nnew++;
+	}
+	memcpy(rec, out, strlen(out) + 1);
+	/* "MAC 5 GHz 116,120,124,128; MAC 2.4 GHz 11" */
+	for (i = 0; fresh && freshlen && i < nd; i++) {
+		if (drops[i].seen != 2)
+			continue;
+		if (!lmac || lband != drops[i].band || strcmp(lmac, drops[i].mac)) {
+			snprintf(line, sizeof(line), "%s%s %s %d", lmac ? "; " : "", drops[i].mac, mc_band_name(drops[i].band), drops[i].ch);
+			lmac = drops[i].mac;
+			lband = drops[i].band;
+		} else
+			snprintf(line, sizeof(line), ",%d", drops[i].ch);
+		strlcat(fresh, line, freshlen);
+	}
+	return nnew;
+}
+
+/* the entries in force: the channel goes unusable in the node's band; per[] counts them per band */
+int mc_nop_apply(struct mc_nodes *nds, const char *rec, long now, int per[MC_NB])
+{
+	const char *p = rec;
+	char mac[18];
+	int band, ch, i, r, total = 0;
+	long exp;
+
+	for (i = 0; i < MC_NB; i++)
+		per[i] = 0;
+	while ((r = mc_nop_next(&p, mac, &band, &ch, &exp)) != 0) {
+		if (r < 0 || exp < MC_CLOCK_SANE || (now >= MC_CLOCK_SANE && exp <= now))
+			continue;
+		for (i = 0; i < nds->n; i++) {
+			struct mc_node *nd = &nds->v[i];
+			if (!nd->is_re || strcmp(nd->mac, mac) || !nd->b[band].present)
+				continue;
+			if (mc_usable(nd->b[band].flag[ch]))
+				nd->b[band].flag[ch] = 9;
+			per[band]++;
+			total++;
+		}
+	}
+	return total;
+}
+
+/* 1 = an entry has lapsed and the record still carries it (the plan should be rebuilt) */
+int mc_nop_expired(const char *rec, long now)
+{
+	const char *p = rec;
+	char mac[18];
+	int band, ch, r;
+	long exp;
+
+	if (now < MC_CLOCK_SANE)
+		return 0;
+	while ((r = mc_nop_next(&p, mac, &band, &ch, &exp)) != 0)
+		if (r == 1 && exp >= MC_CLOCK_SANE && exp <= now)
+			return 1;
+	return 0;
+}
