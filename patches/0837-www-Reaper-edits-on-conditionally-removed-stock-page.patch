+function setupSmartConnectToggle(){
+	var btn = document.getElementById('smartConnectToggle');
+	if(!btn) return;
+
+	if(RP_SDN_MIGRATED){
+		/* not a dead switch, not a hand-forged sdn_rl: point at the owner */
+		btn.value = 'Manage on Network page';
+		btn.title = 'In this firmware state the main network\'s band membership is managed on the Network page - open the main network there and choose its Wi-Fi bands.';
+		var hintEl = document.getElementById('scWhereHint');
+		if(hintEl) hintEl.innerHTML = 'Choose which radios take part on the <b>Network</b> page &mdash; open the main network and pick its Wi-Fi bands.';
+		return;
+	}
+
+	if(isSmartConnectEnabled()){
+		btn.value = 'Disable Smart Connect';
+		btn.title = 'Turn off Smart Connect (band steering) for all radios';
+		// inline !important: reaper_content.css force-shows .formfontdesc,
+		// which kept this box visible while Smart Connect was on
+		var disc = document.getElementById('scDisableDisclaimer');
+		if(disc) disc.style.setProperty('display', 'none', 'important');
+	}
+	else{
+		btn.value = 'Enable Smart Connect';
+		btn.title = 'Turn Smart Connect (band steering) back on for all radios';
+		// Surface the band-steering caveat while Smart Connect is off.
+		var disc = document.getElementById('scDisableDisclaimer');
+		if(disc) disc.style.display = '';
+		// Grey out the rule set: nothing on this page applies while Smart Connect is off.
+		var div = document.getElementById('bsd_steering_div');
+		if(div){
