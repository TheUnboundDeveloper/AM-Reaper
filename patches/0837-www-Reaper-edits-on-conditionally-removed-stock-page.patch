+.mono{font-family:ui-monospace,Menlo,Consolas,monospace;font-variant-numeric:tabular-nums}
+.eyebrow{font-family:var(--hdr);text-transform:uppercase;letter-spacing:.22em;font-size:11px;color:var(--steel)}
+a{color:var(--bone-dim)} a:hover{color:var(--bone)}
+.pagehead{display:flex;align-items:center;gap:14px;margin-bottom:8px;flex-wrap:wrap}
+.pagehead h1{font-size:24px;font-weight:700}
+.spacer{flex:1}
+.pill{display:inline-flex;align-items:center;gap:7px;border:1px solid var(--line-soft);border-radius:999px;
+  padding:5px 12px;font-family:var(--hdr);font-weight:600;font-size:12px;letter-spacing:.06em;color:var(--bone-dim);background:var(--panel)}
+.pill .dot{width:8px;height:8px;border-radius:50%;background:var(--steel)}
+.pill.armed .dot{background:var(--jade);box-shadow:0 0 8px var(--jade)}
+.btn{display:inline-block;border:1px solid var(--line-soft);background:var(--panel);color:var(--bone);
+  font-family:var(--hdr);font-weight:600;font-size:13px;letter-spacing:.05em;border-radius:9px;padding:9px 16px;cursor:pointer;text-transform:uppercase}
+.btn:hover{border-color:var(--line)}
+.btn.primary{background:linear-gradient(180deg,var(--crimson),var(--crimson-deep));border-color:transparent;color:#fff}
+.btn.ghost{background:transparent}
+.btn:disabled{opacity:.4;cursor:not-allowed}
+.panel{background:var(--panel);border:1px solid var(--line-soft);border-radius:14px;padding:18px 20px;margin-bottom:16px;max-width:820px}
+.panel h2{font-size:17px;font-weight:700;margin-bottom:4px}
+.panel .sub{font-size:12.5px;color:var(--steel);margin-bottom:14px}
+.row{display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin:10px 0}
+label.fld{display:block;font-size:12px;color:var(--bone-dim);margin-bottom:5px}
+.fhint{font-size:11.5px;color:var(--steel);margin-top:5px;line-height:1.4}
+input[type=text],input[type=password],input[type=number]{background:#0a0a0c;border:1px solid var(--line-soft);border-radius:8px;
+  color:var(--bone);font-family:var(--body);font-size:14px;padding:9px 12px;min-width:240px}
+input:focus{outline:none;border-color:var(--line)}
+.note{font-size:12.5px;line-height:1.55}
+.banner{border:1px solid var(--line);border-radius:12px;background:linear-gradient(180deg,rgba(225,6,0,.06),transparent);
+  padding:14px 16px;margin-bottom:18px;max-width:820px}
+.banner ul{margin:8px 0 0;padding-left:18px}
+.banner li{margin:3px 0;font-size:12.5px}
+.creds{background:#0a0a0c;border:1px solid var(--line-soft);border-radius:10px;padding:12px 14px;margin-top:12px}
+.creds .k{font-size:11px;color:var(--steel);text-transform:uppercase;letter-spacing:.1em}
+.creds .v{font-family:ui-monospace,Menlo,Consolas,monospace;font-size:13px;color:var(--bone);word-break:break-all;margin:2px 0 10px}
+pre.snip{background:#0a0a0c;border:1px solid var(--line-soft);border-radius:10px;padding:12px 14px;overflow-x:auto;
+  font-size:12px;color:var(--bone-dim);white-space:pre;max-width:100%}
+.count{font-family:var(--hdr);font-size:15px;color:var(--amber)}
+.msg{font-size:12.5px;margin-top:8px;min-height:16px}
+.msg.err{color:var(--crimson)}
+.msg.ok{color:var(--jade)}
+.hide{display:none!important}
+.hr{height:1px;background:var(--line-soft);margin:16px 0;border:0}
+.grid2{display:grid;grid-template-columns:1fr 1fr;gap:12px}
+@media(max-width:680px){.grid2{grid-template-columns:1fr}}
+</style>
+</head>
+<body>
+<div class="pagehead">
+  <div class="eyebrow">Reaper</div>
+  <h1><#Reaper_c_ai_advisor#> <a href="https://github.com/TheUnboundDeveloper/AM-Reaper/blob/main/docs/REAPER-GUIDE.md#416-ai-advisor-mcp-build-only" target="_blank" rel="noopener noreferrer" title="<#RABT_43#>" style="display:inline-flex;align-items:center;justify-content:center;width:22px;height:22px;margin-left:8px;border-radius:50%;border:1px solid #4a4a4e;color:#8d897f;font:700 13px Arial,sans-serif;text-decoration:none;vertical-align:middle">?</a></h1>
+  <span id="statePill" class="pill"><span class="dot"></span><span id="stateTxt"><#RADV_77#></span></span>
+  <button class="btn ghost" onclick="loadStatus()"><#CTL_refresh#></button>
+  <div class="spacer"></div>
+</div>
+
+<div class="banner note">
+  <#RADV_01#>
+  <ul>
+    <li><#RADV_02#></li>
+    <li><#RADV_03#></li>
+    <li><#RADV_04#></li>
+    <li><#RADV_05#></li>
+    <li><#RADV_06#></li>
+    <li><#RADV_07#></li>
+  </ul>
+</div>
+
+<!-- PROVISION -->
+<div class="panel">
+  <h2>1 &middot; <#RADV_08#></h2>
+  <div class="sub"><#RADV_09#></div>
+  <div id="provState" class="note"></div>
+  <div class="row" id="oldRow" style="display:none">
+    <div>
+      <label class="fld" for="oldcode"><#RADV_10#></label>
+      <input type="password" id="oldcode" autocomplete="off" placeholder="<#RADV_11#>">
+    </div>
+  </div>
+  <div class="row">
+    <div>
+      <label class="fld" for="code"><#RADV_12#></label>
+      <input type="text" id="code" autocomplete="off" spellcheck="false" placeholder="<#RADV_13#>">
+    </div>
+    <button class="btn" onclick="genCode()"><#CTL_Generate#></button>
+    <button class="btn primary" onclick="provision()"><#RADV_14#></button>
+    <button class="btn ghost" onclick="deprovision()"><#CTL_clear#></button>
+  </div>
+  <div id="provMsg" class="msg"></div>
+</div>
+
+<!-- USB KEY (optional 2nd factor) -->
+<div class="panel">
+  <h2>2 &middot; <#RADV_15#> <span style="color:var(--steel);font-weight:400;font-size:13px"><#RADV_16#></span></h2>
+  <div class="sub"><#RADV_17#></div>
+  <div id="usbState" class="note"></div>
+  <div class="row">
+    <button class="btn primary" onclick="usbEnroll()"><#RADV_18#></button>
+    <button class="btn ghost" onclick="usbUnenroll()"><#RADV_19#></button>
+  </div>
+  <div class="note" style="color:var(--steel)"><#RADV_20#> <span class="mono">reaper.key</span> <#RADV_21#></div>
+  <div id="usbMsg" class="msg"></div>
+</div>
+
+<!-- SETTINGS -->
+<div class="panel">
+  <h2>3 &middot; <#Settings#></h2>
+  <div class="sub"><#RADV_22#></div>
+  <div class="grid2">
+    <div><label class="fld" for="port"><#RADV_23#> (1024&ndash;65535)</label><input type="number" id="port" min="1024" max="65535"></div>
+    <div><label class="fld" for="timeout"><#RADV_24#> (15&ndash;240 min)</label><input type="number" id="timeout" min="15" max="240"></div>
+    <div><label class="fld" for="client"><#RADV_25#></label><input type="text" id="client" autocomplete="off" spellcheck="false">
+      <!-- v3.1.0 (backlog): the example + "blank = any host" sentence clipped as a
+           placeholder in this cell; it reads in full as a hint line instead -->
+      <div class="fhint"><#RADV_26#></div></div>
+  </div>
+  <div class="row"><button class="btn" onclick="saveSettings()"><#RADV_27#></button></div>
+  <div id="setMsg" class="msg"></div>
+</div>
+
+<!-- ARM -->
+<div class="panel">
+  <h2>4 &middot; <#RADV_28#></h2>
+  <div class="sub"><#RADV_29#></div>
+  <div class="row">
+    <div><label class="fld" for="armcode"><#RADV_08#></label><input type="password" id="armcode" autocomplete="off" placeholder="<#RADV_30#>"></div>
+    <button class="btn primary" id="armBtn" onclick="arm()"><#RADV_31#></button>
+    <button class="btn ghost" id="disarmBtn" onclick="disarm()"><#RADV_32#></button>
+  </div>
+  <div class="row" style="margin-top:8px">
+    <label class="fld" style="display:flex;align-items:center;gap:8px;cursor:pointer;font-weight:400">
+      <input type="checkbox" id="netdiag"> <#RADV_73#>
+    </label>
+  </div>
+  <div class="sub" style="margin-top:2px"><#RADV_74#></div>
+  <div id="armMsg" class="msg"></div>
+
+  <div id="armedBox" class="creds hide">
+    <div class="k"><#RADV_33#></div><div class="v"><span id="countdown" class="count">&mdash;</span></div>
+    <div class="k"><#RADV_34#></div><div class="v" id="epUrl">&mdash;</div>
+    <div class="k"><#RADV_76#></div><div class="v" id="epUrl6">&mdash;</div>
+    <div class="k"><#RADV_35#></div><div class="v" id="epTok">&mdash;</div>
+    <hr class="hr">
+    <div class="k"><#RADV_36#></div>
+    <pre class="snip" id="snip">&mdash;</pre>
+    <button class="btn" onclick="copySnip()"><#RADV_75#></button>
+    <div class="note" style="margin-top:10px;color:var(--steel)">
+      <#RADV_37#> (<span class="mono">https</span>) <#RADV_38#> <span class="mono">http</span> <#RADV_39#> <span class="mono">mcp-remote</span> <#RADV_40#>
+    </div>
+  </div>
+</div>
+
+<script src="/reaper_util.js"></script>
+<script>
+var CGI = '/reaper_mcp.cgi';
+var REAPER_HTTPID = <% nvram_get_js("http_id"); %>;  /* F4 CSRF token */
+var endExpiry = 0, ticker = null, provisionedNow = false;
+
+function post(action, params){
+  var body = 'action=' + encodeURIComponent(action) + '&http_id=' + encodeURIComponent(REAPER_HTTPID);
+  if(params) for(var k in params) body += '&' + k + '=' + encodeURIComponent(params[k]);
+  return fetch(CGI, {method:'POST', headers:{'Content-Type':'application/x-www-form-urlencoded'}, body:body})
+    .then(function(r){return r.text();}).then(function(t){ try{return JSON.parse(t);}catch(e){return {ok:0,error:`<#RADV_41#>`};} });
+}
+
+function setMsg(id, text, cls){ var e=document.getElementById(id); e.textContent=text||''; e.className='msg'+(cls?(' '+cls):''); }
+
+function fmtLeft(sec){ if(sec<0)sec=0; var m=Math.floor(sec/60), s=sec%60; return m+'m '+(s<10?'0':'')+s+'s'; }
+
+function loadStatus(){
+  post('status').then(function(d){
+    var pill=document.getElementById('statePill'), txt=document.getElementById('stateTxt');
+    if(d.armed){ pill.className='pill armed'; txt.textContent=`<#RADV_42#>`; endExpiry=d.expiry; startTicker(); document.getElementById('armedBox').classList.remove('hide'); }
+    else { pill.className='pill'; txt.textContent=`<#RADV_77#>`; document.getElementById('armedBox').classList.add('hide'); stopTicker(); }
+    document.getElementById('provState').innerHTML = d.provisioned
+      ? `<span style="color:var(--jade)"><#RADV_43#></span> <#RADV_44#>`
+      : `<span style="color:var(--amber)"><#RADV_45#></span> <#RADV_46#>`;
+    document.getElementById('oldRow').style.display = d.provisioned ? '' : 'none';
+    provisionedNow = !!d.provisioned;
+    document.getElementById('usbState').innerHTML = d.usb_enrolled
+      ? `<span style="color:var(--jade)"><#RADV_47#></span> <#RADV_48#>`
+      : `<span style="color:var(--steel)"><#RADV_49#></span> <#RADV_50#>`;
+    if(d.port) document.getElementById('port').value=d.port;
+    if(d.timeout) document.getElementById('timeout').value=d.timeout;
+    /* prefill the IP pin so it is retained across visits/applies (empty = any LAN host) */
+    document.getElementById('client').value = (typeof d.client!=='undefined' ? d.client : '');
+    document.getElementById('armBtn').disabled = !d.provisioned || (d.locked?true:false);
+    if(d.locked) setMsg('armMsg',`<#RADV_51#>`,'err');
+  });
+}
+
+function genCode(){
+  var a=new Uint8Array(16); (crypto||window.crypto).getRandomValues(a);
+  var abc='0123456789ABCDEFGHJKMNPQRSTVWXYZ', out='';
+  for(var i=0;i<a.length;i++){ out+=abc[a[i]&31]; if(i%4===3 && i<a.length-1) out+='-'; }
+  document.getElementById('code').value=out;
+}
+
+/* CGI error keys (ek) -> localized text; the raw English d.error stays the
+   fallback so an unmapped/new key still surfaces (pre-v2.1.1 these messages
+   bypassed the dict entirely) */
+var AERR = {
+  RADVE_1:`<#RADVE_1#>`, RADVE_2:`<#RADVE_2#>`, RADVE_3:`<#RADVE_3#>`, RADVE_4:`<#RADVE_4#>`,
+  RADVE_5:`<#RADVE_5#>`, RADVE_6:`<#RADVE_6#>`, RADVE_7:`<#RADVE_7#>`, RADVE_8:`<#RADVE_8#>`,
+  RADVE_9:`<#RADVE_9#>`, RADVE_10:`<#RADVE_10#>`, RADVE_11:`<#RADVE_11#>`, RADVE_12:`<#RADVE_12#>`,
+  RADVE_13:`<#RADVE_13#>`, RADVE_14:`<#RADVE_14#>`, RADVE_15:`<#RADVE_15#>`, RADVE_16:`<#RADVE_16#>`,
+  RADVE_17:`<#RADVE_17#>`, RADVE_18:`<#RADVE_18#>`, RADVE_19:`<#RADVE_19#>`
+};
+function aerr(d, fb){ return (d && d.ek && AERR[d.ek]) || (d && d.error) || fb; }
+
+function provision(){
+  var code=document.getElementById('code').value.trim();
+  if(code.length<12){ setMsg('provMsg',`<#RADV_52#>`,'err'); return; }
+  var p={code:code};
+  if(provisionedNow){
+    var oc=document.getElementById('oldcode').value;
+    if(!oc){ setMsg('provMsg',`<#RADV_53#>`,'err'); return; }
+    p.oldcode=oc;
+  }
+  post('provision',p).then(function(d){
+    if(d.ok){ setMsg('provMsg',`<#RADV_54#>`,'ok'); document.getElementById('code').value=''; document.getElementById('oldcode').value=''; loadStatus(); }
+    else setMsg('provMsg', aerr(d,`<#RADV_55#>`), 'err');
+  });
+}
+
+function deprovision(){
+  if(!confirm(`<#RADV_56#>`)) return;
+  var p={};
+  if(provisionedNow){
+    var c=prompt(`<#RADV_57#>`); if(!c) return; p.code=c;
+  }
+  post('deprovision',p).then(function(d){ setMsg('provMsg', d.ok?`<#RADV_58#>`:aerr(d,`<#RADV_55#>`), d.ok?'ok':'err'); loadStatus(); });
+}
+
+function usbEnroll(){
+  setMsg('usbMsg',`<#RADV_59#>`,'');
+  post('usb_enroll').then(function(d){
+    if(d.ok){ setMsg('usbMsg',`<#RADV_60#>`+esc(d.volume)+`<#RADV_61#>`,'ok'); loadStatus(); }
+    else setMsg('usbMsg', aerr(d,`<#RADV_55#>`), 'err');
+  });
+}
+function usbUnenroll(){
+  if(!confirm(`<#RADV_62#>`)) return;
+  var p={};
+  if(provisionedNow){
+    var c=prompt(`<#RADV_57#>`); if(!c) return; p.code=c;
+  }
+  post('usb_unenroll',p).then(function(d){ setMsg('usbMsg', d.ok?`<#RADV_63#>`:aerr(d,`<#RADV_55#>`), d.ok?'ok':'err'); loadStatus(); });
+}
+
+/* themed waiting modal lives in the framing shell (reaper_shell.asp) */
+function rwait(m){ var w=(window.parent&&window.parent.reaperWait)?window.parent:window; if(w.reaperWait) w.reaperWait(m); }
+function rdone(){ var w=(window.parent&&window.parent.reaperWaitDone)?window.parent:window; if(w.reaperWaitDone) w.reaperWaitDone(); }
+function saveSettings(){
+  var port=parseInt(document.getElementById('port').value,10);
+  var to=parseInt(document.getElementById('timeout').value,10);
+  var cl=document.getElementById('client').value.trim();
+  if(!(port>=1024&&port<=65535)){ setMsg('setMsg',`<#RADV_64#>`,'err'); return; }
+  if(!(to>=15&&to<=240)){ setMsg('setMsg',`<#RADV_65#>`,'err'); return; }
+  var f=new FormData();
+  f.append('action_mode','apply'); f.append('rmcp_port',''+port); f.append('rmcp_timeout',''+to); f.append('rmcp_client',cl);
+  f.append('http_id',REAPER_HTTPID);  /* F4 CSRF token - applyapp.cgi needs it to persist */
+  rwait(`<#Reaper_c_applying#>`);
+  fetch('/applyapp.cgi',{method:'POST',body:new URLSearchParams(f)}).then(function(r){
+    rdone();
+    if(r.ok){ setMsg('setMsg',`<#RADV_66#>`,'ok'); } else { setMsg('setMsg',`<#RADV_55#>`,'err'); }
+  }).catch(function(){ rdone(); setMsg('setMsg',`<#RADV_55#>`,'err'); });
+}
+
+function arm(){
+  var code=document.getElementById('armcode').value;
+  if(!code){ setMsg('armMsg',`<#RADV_67#>`,'err'); return; }
+  setMsg('armMsg',`<#RADV_68#>`,'');
+  var nd = document.getElementById('netdiag').checked ? 1 : 0;
+  rwait(`<#Reaper_c_applying#>`);
+  post('arm',{code:code, netdiag:nd}).then(function(d){
+    rdone();
+    document.getElementById('armcode').value='';
+    if(!d.ok){ setMsg('armMsg', aerr(d,`<#RADV_69#>`), 'err'); loadStatus(); return; }
+    setMsg('armMsg',`<#RADV_70#>`,'ok');
+    endExpiry=d.expiry;
+    document.getElementById('epUrl').textContent=d.url;
+    document.getElementById('epUrl6').textContent=d.url6||'-';   /* IPv6 A8: present when the LAN holds an IPv6 address */
+    document.getElementById('epTok').textContent=d.token;
+    document.getElementById('snip').textContent=buildSnip(d.url,d.token);
+    document.getElementById('armedBox').classList.remove('hide');
+    startTicker(); loadStatus();
+  });
+}
+
+function disarm(){ post('disarm').then(function(){ setMsg('armMsg',`<#RADV_71#>`,'ok'); loadStatus(); }); }
+
+function buildSnip(url,tok){
+  return '{\n  "mcpServers": {\n    "reaper-router": {\n      "url": "'+url+'",\n      "headers": { "Authorization": "Bearer '+tok+'" }\n    }\n  }\n}';
+}
+function copySnip(){ var t=document.getElementById('snip').textContent; if(navigator.clipboard) navigator.clipboard.writeText(t); }
+
+var tickN=0;
+function startTicker(){ stopTicker(); tickN=0; ticker=setInterval(tick,1000); tick(); }
+function stopTicker(){ if(ticker){clearInterval(ticker);ticker=null;} }
+function tick(){
+  var left=endExpiry-Math.floor(Date.now()/1000);
+  document.getElementById('countdown').textContent=fmtLeft(left);
+  if(left<=0){ stopTicker(); loadStatus(); return; }
+  /* reaper v1.4.9: re-poll the server every ~5s so a server-side session end
+     (USB key pulled, session timeout, or disarm) flips the UI to locked promptly
+     instead of counting down a session the router has already torn down. */
+  if((++tickN % 5)===0){
+    post('status').then(function(d){
+      if(!d.armed){ stopTicker(); setMsg('armMsg',`<#RADV_72#>`,'err'); loadStatus(); }
+      else if(d.expiry){ endExpiry=d.expiry; }
+    });
+  }
+}
+
+loadStatus();
+</script>
+</body>
+</html>
