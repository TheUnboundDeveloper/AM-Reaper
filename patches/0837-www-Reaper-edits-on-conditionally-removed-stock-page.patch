+function toggleSmartConnect(){
+	if(RP_SDN_MIGRATED){
+		/* v2.9.4: the classic pair is inert here - go where the control lives */
+		top.location = RP_NETPAGE;
+		return;
+	}
+
+	var setObj = {};
+
+	if(isSmartConnectEnabled()){
+		if(!confirm('Disable Smart Connect?\n\nBand steering will be turned off and every Smart Connect control on this page is deactivated. Each radio (2.4 / 5 / 6 GHz) keeps broadcasting its current SSID independently.\n\nNote: if your radios share the same SSID, a device may stay on a less-than-optimal band (e.g. 2.4 GHz instead of 5 / 6 GHz). Set a preferred band on the device, or disconnect/reconnect to re-select; give each band its own SSID to make the choice explicit.\n\nWireless will restart.')){
+			return;
+		}
+		setObj['smart_connect_x'] = '0';
+	}
+	else{
+		if(!confirm('Enable Smart Connect?\n\nAll radios will be steered as one Smart Connect group.\n\nWireless will restart.')){
+			return;
+		}
+		setObj['smart_connect_x'] = '1';	// SMRTCONN_FULL_BANDS
+		if(typeof smart_connect_v2_support !== 'undefined' && smart_connect_v2_support){
+			// v2 selects participating bands via a bitmask; (re)select every available band.
+			// The mask is indexed by BAND SLOT, not by how many bands exist: bit i means
+			// bandName[i] of ["2G","5G1","5G2","6G1","6G2"] - the same mapping
