+	setObj['action_mode'] = 'apply';
+	setObj['rc_service'] = 'restart_wireless';
+	httpApi.nvramSet(setObj, function(){
+		showLoading(10);
+		setTimeout(function(){
+			location.reload();
+		}, 10000);
+	});
+}
