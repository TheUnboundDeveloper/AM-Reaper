From 988d9085b22e9594d4bc789bfe8769bc22922fc2 Mon Sep 17 00:00:00 2001
From: reaper <theunbounddeveloper@outlook.com>
Date: Tue, 27 Oct 2026 09:53:13 -0400
Subject: [PATCH] shared: get_hex_data() keeps upstream's bounds check only
 (double fix)

ASUS 40585 clamps len to the source's hex pairs the way our M15 fix did; the
replay kept both and the second declaration of `avail` did not compile.
Upstream's text.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 release/src/router/shared/common_utils.c | 4 ----
 1 file changed, 4 deletions(-)

diff --git a/release/src/router/shared/common_utils.c b/release/src/router/shared/common_utils.c
index 0660866c51b..edcec9e1365 100644
--- a/release/src/router/shared/common_utils.c
+++ b/release/src/router/shared/common_utils.c
@@ -158,10 +158,6 @@ get_hex_data(uchar *data_str, uchar *hex_data, int len)
 	uchar val;
 	int idx, avail;
 	char hexstr[3] = {0};
-	int avail = (int)(strlen((char*)data_str) / 2);	/* M15: don't read past the source */
-
-	if (len > avail)
-		len = avail;
 
 	src = data_str;
 	dest = hex_data;
-- 
2.25.1

