From 4b6cad76704ea836cf0a5d64a3e4a43747280cbc Mon Sep 17 00:00:00 2001
From: reaper <theunbounddeveloper@outlook.com>
Date: Tue, 27 Oct 2026 09:53:16 -0400
Subject: [PATCH] httpd: declare get_string_md5(), drop the two orphan extendno
 statics (review pass 2)

Upstream's ETag rework removed httpd.c's extern for get_string_md5() together
with the extendno variant that used it; the merged cache-bust stamp calls it, so
the declaration comes back (the definition is web.c's). cached_extendno and
cached_extendno_md5 had no user left.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 release/src/router/httpd/httpd.c | 3 +--
 1 file changed, 1 insertion(+), 2 deletions(-)

diff --git a/release/src/router/httpd/httpd.c b/release/src/router/httpd/httpd.c
index cb12e4a6869..2ed56d605b2 100644
--- a/release/src/router/httpd/httpd.c
+++ b/release/src/router/httpd/httpd.c
@@ -272,6 +272,7 @@ extern int save_iptv_port(char *isp);
 #endif
 
 extern int get_file_md5(char *file, char *out, int len);
+extern int get_string_md5(const char *input_string, char *out, int len);	/* web.c; the build stamp in every ETag */
 
 #define UI_REV_HASH_LEN 24
 
@@ -299,8 +300,6 @@ int login_error_status = 0;
 char cloud_file[256];
 char indexpage[128];
 
-static char cached_extendno[256] = {0};
-static char cached_extendno_md5[33] = {0};
 static char cached_buildinfo[128] = {0};	/* reaper 2026-10-26: the build stamp in every ETag */
 static char cached_buildinfo_md5[33] = {0};
 
-- 
2.25.1

