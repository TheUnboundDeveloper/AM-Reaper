From 7fb78ff7cabd07058a32fcab9b10dfdb970773f6 Mon Sep 17 00:00:00 2001
From: reaper <theunbounddeveloper@outlook.com>
Date: Tue, 27 Oct 2026 10:28:04 -0400
Subject: [PATCH] rc: rc_ipsec_ca_txt_parse() declares the `left` its CN scan
 uses

Upstream's 40585 version of the function bounds every copy with a local
`left`; ours copies the three fields through ipsec_copy_field() and kept only
upstream's bounded CN scan at the end, which still uses it. Found by the
compile sweep.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 release/src/router/rc/rc_ipsec.c | 1 +
 1 file changed, 1 insertion(+)

diff --git a/release/src/router/rc/rc_ipsec.c b/release/src/router/rc/rc_ipsec.c
index eee6e9bc9d7..94ba8a0f4cd 100644
--- a/release/src/router/rc/rc_ipsec.c
+++ b/release/src/router/rc/rc_ipsec.c
@@ -1068,6 +1068,7 @@ int rc_ipsec_ca_txt_parse()
     char buf[SZ_BUF];
     char *p_tmp = NULL, *p_buf = NULL;
     int file_idx = 0;
+    size_t left;
     /*ca index star from 0*/
     snprintf(buf, sizeof(buf), "%s", nvram_safe_get("ca_manage_profile"));
     p_buf = &buf[0];
-- 
2.25.1

