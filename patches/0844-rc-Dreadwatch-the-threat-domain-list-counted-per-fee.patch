+/* 2026-10-20 Dreadwatch: the directory dnsmasq writes its hit records into. dnsmasq
+ * has dropped to its run user (nobody) when it answers, and /tmp/rwarden is root
+ * 0700, so the records get their own directory, created here (as root, before the
+ * instance starts) and owned by that user. Anything else already holding the name
+ * is left alone: dnsmasq opens the file O_NOFOLLOW and simply records nothing. */
+static void rw_hits_dir(void)
+{
+	struct passwd *pw = getpwnam("nobody");
+	uid_t u = pw ? pw->pw_uid : 65534;
+	gid_t g = pw ? pw->pw_gid : 65534;
+	struct stat st;
+
+	if (mkdir(RW_HITS_DIR, 0700) != 0 && errno != EEXIST)
+		return;
+	if (lstat(RW_HITS_DIR, &st) != 0 || !S_ISDIR(st.st_mode))
+		return;
+	if ((st.st_uid != u || st.st_gid != g) && chown(RW_HITS_DIR, u, g) != 0)
+		return;
+	if ((st.st_mode & 07777) != 0700)
+		chmod(RW_HITS_DIR, 0700);
+}
