From 1a180f310208b9c175de76cf0d7fa6f3fc6ec445 Mon Sep 17 00:00:00 2001
From: reaper <theunbounddeveloper@outlook.com>
Date: Tue, 20 Oct 2026 18:02:50 -0400
Subject: [PATCH] rc: Security Review watch rules - hash, meta, exist or ignore
 per path; a mode change is not a change

Rules in /jffs/reaper/review/rules: a mode (hash, meta, exist, ignore) and a
glob on the full path, or cron: / nvram: patterns; first match wins, the
built-in defaults after them. One awk engine (RV_AWK) applies them to the
live inventory and to the baseline keys in the diff, so an ignored path is
never reported removed, and an item whose mode a rule changed is status
"rule" (listed, not counted as unreviewed). A private SSH key is never
hashed whatever a rule says.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 release/src/router/rc/rwatch.c | 123 +++++++++++++++++++++++++--------
 1 file changed, 96 insertions(+), 27 deletions(-)

diff --git a/release/src/router/rc/rwatch.c b/release/src/router/rc/rwatch.c
index 8b872f44fa..3abbb35453 100644
--- a/release/src/router/rc/rwatch.c
+++ b/release/src/router/rc/rwatch.c
@@ -132,37 +132,104 @@ static void rwatch_gen(void)
 	  "RV_IDS=' rwatch rwarden rwarden_ck rexport reaper_fw_dns reaper_fw_cc reaper_pbr_cc '\n"
 	  "RV_NV_S='wan0_nat_x vts_enable_x autofw_enable_x dmz_ip upnp_enable wan0_upnp_enable upnp_pinhole_enable upnp_protect_svc misc_http_x http_enable misc_httpport_x misc_httpsport_x sshd_enable sshd_port telnetd_enable jffs2_scripts script_usbmount wan0_dnsenable_x wan0_dns wan_dns_x log_ipaddr fw_enable_x ipv6_fw_enable enable_cloudsync'\n"
 	  "RV_NV_H='vts_rulelist autofw_rulelist sshd_authkeys'\n"
-	  "# TYPE<TAB>key<TAB>value, sorted: S hashed file, K key file by size/date/mode,\n"
-	  "# A add-on file by size/date, C a cron line that is not Reaper's own, N a setting\n"
+	  "RV_RULES=/jffs/reaper/review/rules\n"
+	  "RV_TAB=$(printf '\\t')\n"
+	  "# 2026-10-20 (reviewer: expected churn under /jffs flagged on every run): WHAT is\n"
+	  "# watched and HOW is decided by rules - the operator's file above (`<mode> <glob>`\n"
+	  "# per line, modes hash / meta / exist / ignore, first match wins; globs are written\n"
+	  "# as /jffs/..., or cron:<glob> / nvram:<glob> for those kinds) ahead of these\n"
+	  "# defaults, which reproduce the pre-rules inventory exactly. A private SSH key is\n"
+	  "# never hashed whatever a rule says.\n"
+	  "RV_DEF='hash /jffs/scripts/*;hash /jffs/configs/*;hash /jffs/.ssh/authorized_keys;meta /jffs/.ssh/*;meta /jffs/addons/*'\n"
+	  "# the rule engine, one copy, used by the inventory AND the diff (so a path a rule\n"
+	  "# now ignores is never reported \"removed\" against an older baseline)\n"
+	  "RV_AWK='\n"
+	  "function g2r(g,  r, i, c) { r = \"^\"\n"
+	  "  for (i = 1; i <= length(g); i++) { c = substr(g, i, 1)\n"
+	  "    if (c == \"*\") r = r \".*\"; else if (c == \"?\") r = r \".\"; else if (index(\"\\\\^$.[]|()+{}\", c)) r = r \"\\\\\" c; else r = r c }\n"
+	  "  return r \"$\" }\n"
+	  "function radd(l,  m, p) {\n"
+	  "  sub(/\\r$/, \"\", l); if (l ~ /^[ \\t]*(#|$)/) return\n"
+	  "  m = l; sub(/[ \\t].*$/, \"\", m); p = l; sub(/^[^ \\t]+[ \\t]+/, \"\", p); sub(/[ \\t]+$/, \"\", p)\n"
+	  "  if (m !~ /^(hash|meta|exist|ignore)$/ || p == \"\" || p == l || nr >= 200) return\n"
+	  "  rm[++nr] = m; rr[nr] = g2r(p) }\n"
+	  "function rload(rf, def,  l, n, i, a) {\n"
+	  "  nr = 0\n"
+	  "  while ((getline l < rf) > 0) radd(l)\n"
+	  "  close(rf)\n"
+	  "  n = split(def, a, \";\"); for (i = 1; i <= n; i++) radd(a[i]) }\n"
+	  "function rmode(k,  i) { for (i = 1; i <= nr; i++) if (k ~ rr[i]) return rm[i]; return \"\" }\n"
+	  "function dpath(p) { return \"/jffs\" substr(p, length(J) + 1) }\n"
+	  "'\n"
+	  "# every candidate, unclassified: F<TAB>path<TAB>size date<TAB>mode, C cron, N setting\n"
+	  "_rv_walk() {\n"
+	  "  for f in $RV_JFFS/scripts/* $RV_JFFS/configs/*; do\n"
+	  "    [ -f \"$f\" ] && [ ! -L \"$f\" ] || continue\n"
+	  "    ls -l \"$f\" 2>/dev/null | awk -v p=\"$f\" '{printf \"F\\t%s\\t%s %s %s %s\\t%s\\n\", p, $5, $6, $7, $8, $1}'\n"
+	  "  done\n"
+	  "  for f in $RV_JFFS/.ssh/*; do\n"
+	  "    [ -f \"$f\" ] || continue\n"
+	  "    [ \"$f\" = \"$RV_JFFS/.ssh/authorized_keys\" ] && [ -L \"$f\" ] && continue\n"
+	  "    ls -l \"$f\" 2>/dev/null | awk -v p=\"$f\" '{printf \"F\\t%s\\t%s %s %s %s\\t%s\\n\", p, $5, $6, $7, $8, $1}'\n"
+	  "  done\n"
+	  "  [ -d $RV_JFFS/addons ] && ls -lR $RV_JFFS/addons 2>/dev/null | awk -v d=\"$RV_JFFS/addons\" '\n"
+	  "    /^\\/.*:$/ { d=substr($0,1,length($0)-1); next }\n"
+	  "    $1 ~ /^-/ { if (n>=20000) { t=1; next } nm=$0; for (i=0;i<8;i++) sub(/^[^ ]+ +/,\"\",nm); sub(/ -> .*$/,\"\",nm); printf \"F\\t%s/%s\\t%s %s %s %s\\t%s\\n\", d, nm, $5, $6, $7, $8, $1; n++ }\n"
+	  "    END { if (t) print \"T\\taddons\\ttruncated\" }'\n"
+	  "  cru l 2>/dev/null | tr '\\t' ' ' | while IFS= read -r l; do\n"
+	  "    id=$(printf '%s' \"$l\" | sed -n 's/.*#\\([^#][^#]*\\)#$/\\1/p')\n"
+	  "    if [ -n \"$id\" ]; then case \"$RV_IDS\" in *\" $id \"*) continue;; esac; fi\n"
+	  "    printf 'C\\t%s\\t-\\n' \"$l\"\n"
+	  "  done\n"
+	  "  for k in $RV_NV_S; do printf 'N\\t%s\\t%s\\n' \"$k\" \"$(_nv $k | tr -d '\\n\\t')\"; done\n"
+	  "  for k in $RV_NV_H; do v=\"$(_nv $k)\"; [ -n \"$v\" ] && v=$(printf '%s' \"$v\" | md5sum | cut -d' ' -f1); printf 'N\\t%s\\t%s\\n' \"$k\" \"$v\"; done\n"
+	  "}\n"
+	  "# classify by rule: H (to hash), A file by size/date, K SSH key file (+ mode), E existence only; drop ignored\n"
+	  "_rv_apply() {\n"
+	  "  awk -F'\\t' -v J=\"$RV_JFFS\" -v RF=\"$RV_RULES\" -v DEF=\"$RV_DEF\" \"$RV_AWK\"'\n"
+	  "    BEGIN { rload(RF, DEF) }\n"
+	  "    $1 == \"T\" { if (!tr++) print; next }\n"
+	  "    $1 == \"F\" { dp = dpath($2); m = rmode(dp); if (m == \"\") m = \"meta\"\n"
+	  "      key = (index(dp, \"/jffs/.ssh/\") == 1 && dp != \"/jffs/.ssh/authorized_keys\")\n"
+	  "      if (m == \"hash\" && key) m = \"meta\"\n"
+	  "      if (m == \"ignore\") next\n"
+	  "      if (index(dp, \"/jffs/addons/\") == 1 && ++na > 2000) { if (!tr++) print \"T\\taddons\\ttruncated\"; next }\n"
+	  "      if (m == \"hash\") print \"H\\t\" $2 \"\\t\" $4\n"
+	  "      else if (m == \"exist\") print \"E\\t\" $2 \"\\t-\"\n"
+	  "      else if (key) print \"K\\t\" $2 \"\\t\" $3 \" \" $4\n"
+	  "      else print \"A\\t\" $2 \"\\t\" $3\n"
+	  "      next }\n"
+	  "    $1 == \"C\" { if (rmode(\"cron:\" $2) != \"ignore\") print; next }\n"
+	  "    $1 == \"N\" { if (rmode(\"nvram:\" $2) != \"ignore\") print; next }'\n"
+	  "}\n"
+	  "# TYPE<TAB>key<TAB>value, sorted: S hashed file, A file by size/date, K key file by\n"
+	  "# size/date/mode, E file by existence, C a cron line that is not Reaper's own, N a setting\n"
 	  "_rv_inv() {\n"
+	  "  _rv_walk | _rv_apply > $RV_TMP/review.walk || return 1\n"
 	  "  {\n"
-	  "    for f in $RV_JFFS/scripts/* $RV_JFFS/configs/* $RV_JFFS/.ssh/authorized_keys; do\n"
-	  "      [ -f \"$f\" ] && [ ! -L \"$f\" ] || continue\n"
-	  "      printf 'S\\t%s\\t%s %s\\n' \"$f\" \"$(md5sum \"$f\" 2>/dev/null | cut -d' ' -f1)\" \"$(ls -l \"$f\" 2>/dev/null | cut -c1-10)\"\n"
-	  "    done\n"
-	  "    for f in $RV_JFFS/.ssh/*; do\n"
-	  "      [ -f \"$f\" ] || continue\n"
-	  "      [ \"$f\" = \"$RV_JFFS/.ssh/authorized_keys\" ] && continue\n"
-	  "      ls -l \"$f\" 2>/dev/null | awk -v p=\"$f\" '{printf \"K\\t%s\\t%s %s %s %s %s\\n\", p, $5, $6, $7, $8, $1}'\n"
-	  "    done\n"
-	  "    [ -d $RV_JFFS/addons ] && ls -lR $RV_JFFS/addons 2>/dev/null | awk -v d=\"$RV_JFFS/addons\" '\n"
-	  "      /^\\/.*:$/ { d=substr($0,1,length($0)-1); next }\n"
-	  "      $1 ~ /^-/ { if (n>=2000) { t=1; next } nm=$0; for (i=0;i<8;i++) sub(/^[^ ]+ +/,\"\",nm); sub(/ -> .*$/,\"\",nm); printf \"A\\t%s/%s\\t%s %s %s %s\\n\", d, nm, $5, $6, $7, $8; n++ }\n"
-	  "      END { if (t) print \"T\\taddons\\ttruncated\" }'\n"
-	  "    cru l 2>/dev/null | tr '\\t' ' ' | while IFS= read -r l; do\n"
-	  "      id=$(printf '%s' \"$l\" | sed -n 's/.*#\\([^#][^#]*\\)#$/\\1/p')\n"
-	  "      if [ -n \"$id\" ]; then case \"$RV_IDS\" in *\" $id \"*) continue;; esac; fi\n"
-	  "      printf 'C\\t%s\\t-\\n' \"$l\"\n"
+	  "    grep -v \"^H$RV_TAB\" $RV_TMP/review.walk\n"
+	  "    grep \"^H$RV_TAB\" $RV_TMP/review.walk | while IFS=\"$RV_TAB\" read -r _t _k _m; do\n"
+	  "      printf 'S\\t%s\\t%s %s\\n' \"$_k\" \"$(md5sum \"$_k\" 2>/dev/null | cut -d' ' -f1)\" \"$_m\"\n"
 	  "    done\n"
-	  "    for k in $RV_NV_S; do printf 'N\\t%s\\t%s\\n' \"$k\" \"$(_nv $k | tr -d '\\n\\t')\"; done\n"
-	  "    for k in $RV_NV_H; do v=\"$(_nv $k)\"; [ -n \"$v\" ] && v=$(printf '%s' \"$v\" | md5sum | cut -d' ' -f1); printf 'N\\t%s\\t%s\\n' \"$k\" \"$v\"; done\n"
 	  "  } | sort\n"
+	  "  rm -f $RV_TMP/review.walk\n"
 	  "}\n"
-	  "# baseline vs live -> status<TAB>line. FILENAME, not NR==FNR: an empty first file must not swallow the second\n"
+	  "# baseline vs live -> status<TAB>line. FILENAME, not NR==FNR: an empty first file must not swallow the second.\n"
+	  "# A file is one item whatever its mode (S/A/K/E): a mode a rule changed is status \"rule\", not a change.\n"
 	  "_rv_diff() {\n"
-	  "  awk -F'\t' 'FILENAME==ARGV[1] { b[$1 \"\\t\" $2]=$3; next }\n"
-	  "    { k=$1 \"\\t\" $2; s[k]=1; st=(k in b) ? ((b[k]==$3) ? \"baseline\" : \"changed\") : \"added\"; printf \"%s\\t%s\\n\", st, $0 }\n"
-	  "    END { for (k in b) if (!(k in s)) printf \"removed\\t%s\\t%s\\n\", k, b[k] }' \"$1\" \"$2\"\n"
+	  "  awk -F'\\t' -v J=\"$RV_JFFS\" -v RF=\"$RV_RULES\" -v DEF=\"$RV_DEF\" \"$RV_AWK\"'\n"
+	  "    function kk(t, k) { return (t ~ /^[SAKE]$/) ? \"F\\t\" k : t \"\\t\" k }\n"
+	  "    function gone(t, k) {\n"
+	  "      if (t ~ /^[SAKE]$/) return rmode(dpath(k)) == \"ignore\"\n"
+	  "      if (t == \"C\") return rmode(\"cron:\" k) == \"ignore\"\n"
+	  "      if (t == \"N\") return rmode(\"nvram:\" k) == \"ignore\"\n"
+	  "      return 0 }\n"
+	  "    BEGIN { rload(RF, DEF) }\n"
+	  "    FILENAME==ARGV[1] { if (gone($1, $2)) next; k = kk($1, $2); b[k] = $3; bt[k] = $1; bl[k] = $0; next }\n"
+	  "    { k = kk($1, $2); s[k] = 1\n"
+	  "      st = (k in b) ? ((bt[k] != $1) ? \"rule\" : ((b[k] == $3) ? \"baseline\" : \"changed\")) : \"added\"\n"
+	  "      printf \"%s\\t%s\\n\", st, $0 }\n"
+	  "    END { for (k in b) if (!(k in s)) printf \"removed\\t%s\\n\", bl[k] }' \"$1\" \"$2\"\n"
 	  "}\n"
 	  "# the report the page and the dashboard read. Keys and values are untrusted text (a cron\n"
 	  "# line is whatever was typed): backslash and quote escaped, control bytes stripped by the\n"
@@ -174,7 +241,9 @@ static void rwatch_gen(void)
 	  "    $2==\"T\" { tr=1; next }\n"
 	  /* unreviewed counts only against an ACCEPTED baseline: before one exists every row is "new"
 	   * and there is nothing to review yet - the dashboard bar and the log key off that count */
-	  "    { tot++; if ($1!=\"baseline\") { if (armed+0) u++; if (nb<200) a[nb++]=item() } else if (bl<200) c[bl++]=item() }\n"
+	  /* 2026-10-20: a "rule" row (a mode an operator rule changed) is listed with the
+	   * changes but is not one: not counted, not logged; Accept records it */
+	  "    { tot++; if ($1!=\"baseline\") { if (armed+0 && $1!=\"rule\") u++; if (nb<200) a[nb++]=item() } else if (bl<200) c[bl++]=item() }\n"
 	  "    END {\n"
 	  "      printf \"{\\\"ok\\\":1,\\\"enabled\\\":1,\\\"armed\\\":%d,\\\"ts\\\":%d,\\\"unreviewed\\\":%d,\\\"total\\\":%d,\\\"truncated\\\":%d,\\\"items\\\":[\", armed+0, ts+0, u+0, tot+0, tr+0\n"
 	  "      n=0\n"
@@ -236,7 +305,7 @@ static void rwatch_gen(void)
 	  "  _rv_json \"$_ra\" < $RV_TMP/review.diff > $RV_TMP/review.json.tmp && mv -f $RV_TMP/review.json.tmp $RV_TMP/review.json\n"
 	  "  if [ \"$_ra\" != 1 ]; then rm -f $RV_TMP/review.last; return 0; fi\n"
 	  /* one syslog line per CHANGE of the change set, never per tick (3g's idiom) */
-	  "  _rc=$(grep -v -e '^baseline\t' -e '^[a-z]*\tT\t' $RV_TMP/review.diff)\n"
+	  "  _rc=$(grep -v -e '^baseline\t' -e '^rule\t' -e '^[a-z]*\tT\t' $RV_TMP/review.diff)\n"
 	  "  if [ -n \"$_rc\" ]; then\n"
 	  "    _rs=$(printf '%s' \"$_rc\" | md5sum | cut -d' ' -f1)\n"
 	  "    if [ \"$_rs\" != \"$(cat $RV_TMP/review.last 2>/dev/null)\" ]; then\n"
-- 
