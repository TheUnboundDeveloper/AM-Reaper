+  DNS_FEED_IDS.forEach(function(id){ $('fd_'+id).checked = !!dfs[id]; });
+  $('dnsallow').value = dwSplit(NV.dnsallow).join('\n');
+  $('wardenoff').style.display = (NV.warden === '1') ? 'none' : 'flex';
+}
+var lastName = '';
