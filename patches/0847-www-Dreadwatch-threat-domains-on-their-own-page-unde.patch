+function dwWhen(t){ return t > 0 ? new Date(t*1000).toLocaleString() : '\u2014'; }
+function dwNum(n){ return Number(n||0).toLocaleString(); }
+/* an exemption is a host name (or a bare zone such as lan); a bad line refuses the whole save */
+function dwCleanNames(raw){
+  var out = [], bad = [];
+  String(raw||'').split(/[\s,<>]+/).forEach(function(t){
+    t = t.trim().toLowerCase(); if(!t) return;
+    if(t.length <= 253 && DNS_NAME_RE.test(t)) out.push(t); else bad.push(t);
+  });
+  return { ok: out.join(' '), bad: bad };
+}
+function dwCell(tr, text, cls){ var td = document.createElement('td'); td.textContent = text; if(cls) td.className = cls; tr.appendChild(td); return td; }
