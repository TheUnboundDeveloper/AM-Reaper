+  pill.textContent = (on && j.live && j.names > 0) ? `<#RWDN_03#>` : `<#RWDN_04#>`;
+  if(!j || !j.ok){ return; }
+  $('s_total').textContent = dwNum(j.total);
+  $('s_names').textContent = dwNum(j.names);
+  $('s_clients').textContent = dwNum((j.clients||[]).length);
+  $('s_upd').textContent = dwWhen(j.upd);
+  $('s_droptile').style.display = j.dropped > 0 ? '' : 'none';
+  $('s_dropped').textContent = dwNum(j.dropped);
+  $('nohitlog').style.display = (on && j.names > 0 && !j.hitlog) ? 'flex' : 'none';
+  var st = $('dnsstat');
+  if(!on) st.textContent = '';
+  else if(j.names > 0 && j.live) st.textContent = `<#RWDN_119#>`.replace('%1', dwNum(j.names)).replace('%2', dwWhen(j.upd));
