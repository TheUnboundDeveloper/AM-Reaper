+  var tb = $(tbodyId); tb.textContent = '';
+  if(!rows.length){ var tr = document.createElement('tr'), td = dwCell(tr, `<#RDWT_23#>`, 'empty'); td.colSpan = cols; tb.appendChild(tr); return; }
+  rows.forEach(function(r){ var tr = document.createElement('tr'); fill(tr, r); tb.appendChild(tr); });
+}
+function dwDev(ip){
+  if(ip === '127.0.0.1' || ip === '::1') return `<#RDWT_37#>`;
+  var n = ReaperNames.byIp(ip, '');
+  return n ? n + ' (' + ip + ')' : ip;
+}
