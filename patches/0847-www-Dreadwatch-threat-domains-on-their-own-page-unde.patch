+  dnsallow: decodeURIComponent('<% rwarden_list("dnsallow"); %>')
+};
+var DNS_FEED_IDS = ['urlhaus','threatfox'];
+var DNS_NAME_RE = /^[a-z0-9]([a-z0-9-]{0,62}\.)*[a-z][a-z0-9-]{0,62}$/;
