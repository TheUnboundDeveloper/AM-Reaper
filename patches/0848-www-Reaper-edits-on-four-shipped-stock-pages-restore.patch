@@ -3065,29 +3065,30 @@ if (isBRCMplatform && (prefix === "6g1" || prefix === "6g2")) {
                 let commonStringError = {};
                 let validateErrorCount = 0;
                 if (smartConnectEnable && version === "v2") {
+                    /* reaper 2026-10-04: the mask is built per radio SLOT from radioSeqArray. The
+                       stock fallback `return 7` (= slots 0-2) sat behind a second, identical
+                       smartConnectEnable guard, so it could never run - but it would have dropped
+                       6 GHz on a tri-band box the moment either guard was edited. Removed: the
+                       outer guard is the only one, and there is no fallback to be wrong. */
                     postObject.smart_connect_selif_x = (() => {
-                        if (smartConnectEnable) {
-                            let smartConnectSelifArray = [];
-                            for (let element of radioSeqArray) {
-                                if (element === "") {
-                                    continue;
-                                }
-
-                                let smartConnectRadioElement = document.getElementById(`smart_connect_check_${element}`);
-                                if (smartConnectRadioElement) {
-                                    let value = smartConnectRadioElement.checked ? "1" : "0";
-                                    smartConnectSelifArray.push(value);
-                                } else {
-                                    smartConnectSelifArray.push("0");
-                                }
+                        let smartConnectSelifArray = [];
+                        for (let element of radioSeqArray) {
+                            if (element === "") {
+                                continue;
                             }
 
-                            // put string array to binary string and transforms it to decimal
-                            let smartConnectSelifStr = smartConnectSelifArray.join("");
-                            return parseInt(smartConnectSelifStr, 2);
+                            let smartConnectRadioElement = document.getElementById(`smart_connect_check_${element}`);
+                            if (smartConnectRadioElement) {
+                                let value = smartConnectRadioElement.checked ? "1" : "0";
+                                smartConnectSelifArray.push(value);
+                            } else {
+                                smartConnectSelifArray.push("0");
+                            }
                         }
 
-                        return 7;
+                        // put string array to binary string and transforms it to decimal
+                        let smartConnectSelifStr = smartConnectSelifArray.join("");
+                        return parseInt(smartConnectSelifStr, 2);
                     })();
                 }
 
@@ -3616,13 +3617,46 @@ if (isBRCMplatform && (prefix === "6g1" || prefix === "6g2")) {
                     });
                 }
 
-                httpApi.nvramSet(postObject, function () {
-                    showLoading(restartTime);
-                    window.scrollTo && window.scrollTo({top: 0, left: 0, behavior: 'smooth'});
-                    setTimeout(function () {
-                        location.reload();
-                    }, restartTime * 1000);
+                /* reaper v2.9.3: the overlay used to be raised INSIDE the nvramSet success
+                   callback. Applying a wireless security change deauths the client, so the
+                   response to that very request never arrives, the callback never runs, and
+                   the page sits inert while the router applies the change perfectly. Field
+                   report 2026-08-30: "it appeared nothing happened when in reality it
+                   rebooted the wifi with the password" - the owner only noticed it had
+                   worked when he tried to leave the page and found himself disconnected.
+                   This is the FIRST-BOOT path now that factory Wi-Fi is open again, so it is
+                   the common case, not an edge one. Raise the overlay and arm the reload
+                   BEFORE the request: feedback must never depend on the connection the
+                   change is about to drop. */
+                var wlSecChanged = Object.keys(postObject).some(function (k) {
+                    return /_(ssid|auth_mode_x|wpa_psk|crypto|mfp)$/.test(k);
                 });
+
+                showLoading(restartTime);
+                window.scrollTo && window.scrollTo({top: 0, left: 0, behavior: 'smooth'});
+
+                if (wlSecChanged) {
+                    /* Say plainly that the browser itself may be the client that drops.
+                       DrSurf_sweet_advise1 is stock and already translated in all 25 packs,
+                       so this costs no new token. Backticks because the English carries an
+                       apostrophe and other locales may too. */
+                    try {
+                        var lb = document.getElementById("loadingBlock");
+                        if (lb && !document.getElementById("rwl_dc_hint")) {
+                            var hint = document.createElement("div");
+                            hint.id = "rwl_dc_hint";
+                            hint.style.cssText = "margin:14px 18px 0;line-height:1.5";
+                            hint.textContent = `<#DrSurf_sweet_advise1#>`;
+                            lb.appendChild(hint);
+                        }
+                    } catch (e) {}
+                }
+
+                setTimeout(function () {
+                    location.reload();
+                }, restartTime * 1000);
+
+                httpApi.nvramSet(postObject, function () {});
             }
 
             function mloHint() {
