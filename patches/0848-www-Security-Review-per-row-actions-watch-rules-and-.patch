+    <table class="rt hidden" id="rv_tbl"><thead><tr><th><#RFW_332#></th><th><#RFW_333#></th><th><#RFW_334#></th><th><#RFW_335#></th><th><#RFW_368#></th></tr></thead><tbody></tbody></table>
     <p class="note hidden" id="rv_trunc"><#RFW_354#></p>
     <div id="rv_nwrap" class="hidden"><p class="note"><b><#RFW_360#></b></p><ul class="rvn" id="rv_nlist"></ul></div>
     <p class="note"><#RFW_336#></p>
