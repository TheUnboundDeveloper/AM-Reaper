 function rvcgi(q,cb){xhr('/reaper_watch.cgi?'+q+'&http_id='+encodeURIComponent(REAPER_HTTPID),cb||function(){});}
 function rvpost(q,cb){
   var x=new XMLHttpRequest(),done=false;
@@ -1565,6 +1582,7 @@ function rvRender(j){
   items.forEach(function(it){
     var r=document.createElement('tr');if(it.st!=='baseline')r.className='rv-'+it.st;
     [RV_T[it.t]||it.t,it.k,RV_S[it.st]||it.st,it.v||''].forEach(function(v,i){var td=document.createElement('td');td.textContent=v;if(i===3)td.className='rvmono';r.appendChild(td);});
+    r.appendChild(rvActions(it,!!j.armed));
     body.appendChild(r);
   });
   if(items.length)tbl.classList.remove('hidden');
