-var RV_S={added:`<#RFW_348#>`,changed:`<#RFW_349#>`,removed:`<#RFW_350#>`,baseline:`<#RFW_351#>`,'new':`<#RFW_352#>`};
-var RV_EK={RFW_338:`<#RFW_338#>`,RFW_355:`<#RFW_355#>`,RFW_356:`<#RFW_356#>`,RFW_357:`<#RFW_357#>`};
+var RV_T={S:`<#RFW_343#>`,K:`<#RFW_344#>`,A:`<#RFW_345#>`,E:`<#RFW_366#>`,C:`<#RFW_346#>`,N:`<#RFW_347#>`};
+var RV_S={added:`<#RFW_348#>`,changed:`<#RFW_349#>`,removed:`<#RFW_350#>`,baseline:`<#RFW_351#>`,'new':`<#RFW_352#>`,rule:`<#RFW_367#>`};
+var RV_EK={RFW_338:`<#RFW_338#>`,RFW_355:`<#RFW_355#>`,RFW_356:`<#RFW_356#>`,RFW_357:`<#RFW_357#>`,RFW_369:`<#RFW_369#>`};
+var RV_ACT={'accept-all':`<#RFW_380#>`,'accept-one':`<#RFW_381#>`,rules:`<#RFW_382#>`};
