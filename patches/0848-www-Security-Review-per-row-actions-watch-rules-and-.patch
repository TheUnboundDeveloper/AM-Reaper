 }
+/* 2026-10-20: per-row actions. Accept folds THIS item into the baseline (only
+   against an accepted baseline, and only for a row that differs from it);
+   Existence only / Ignore / Ignore folder put a rule for the item AHEAD of the
+   saved rules (first match wins) and save. A file's rule pattern is its /jffs path
+   as listed; cron lines and settings get cron:/nvram: rules, Ignore only. */
+function rvBtn(label,fn){var b=document.createElement('button');b.className='btn ghost sm';b.type='button';b.textContent=label;b.onclick=fn;return b;}
+/* a listed name as a rule pattern: the glob's own * and ?, and what the rules file
+   refuses (a quote, backslash, backtick, anything outside printable ASCII), become
+   ? - which still matches exactly that character */
+function rvGlobEsc(s){return s.replace(/[*?"\\`]|[^\x20-\x7e]/g,'?');}
+function rvActions(it,armed){
+  var td=document.createElement('td');td.className='rvact';
+  var file=/^[SAKE]$/.test(it.t);
+  if(armed&&it.st!=='baseline'&&it.st!=='new')td.appendChild(rvBtn(`<#RFW_370#>`,function(){rvAckOne(it);}));
+  if(file){
+    if(it.t!=='E')td.appendChild(rvBtn(`<#RFW_371#>`,function(){rvAddRule('exist '+rvGlobEsc(it.k));}));
+    td.appendChild(rvBtn(`<#RFW_372#>`,function(){rvAddRule('ignore '+rvGlobEsc(it.k));}));
+    var dir=it.k.replace(/\/[^\/]*$/,'');
+    if(dir.indexOf('/jffs/')===0&&dir.split('/').length>3)td.appendChild(rvBtn(`<#RFW_373#>`,function(){rvAddRule('ignore '+rvGlobEsc(dir)+'/*');}));
+  }else if(it.t==='C'||it.t==='N'){
+    td.appendChild(rvBtn(`<#RFW_372#>`,function(){rvAddRule('ignore '+(it.t==='C'?'cron:':'nvram:')+rvGlobEsc(it.k));}));
+  }
+  return td;
+}
+function rvAckOne(it){
+  rvpost('action=ack_one&t='+encodeURIComponent(it.t)+'&k='+encodeURIComponent(it.k),function(j){
+    if(!j||!j.ok){$('rv_state').textContent=(j&&j.ek&&RV_EK[j.ek])?RV_EK[j.ek]:`<#RFW_359#>`;return;}
+    $('rv_state').textContent=`<#RFW_358#>`;
+    setTimeout(rvLoad,3000);setTimeout(rvLoadLog,3000);
+  });
+}
+function rvAddRule(line){
+  var cur=$('rv_rules').value.replace(/\s+$/,'');
+  if((cur+'\n').indexOf(line+'\n')===0||cur.split('\n').indexOf(line)>=0){rvSaveRules(cur);return;}
+  rvSaveRules(line+(cur?'\n'+cur:''));
+}
+function rvSaveRules(text){
+  rvpost('action=rules_set&rules='+encodeURIComponent(text),function(j){
+    if(!j||!j.ok){$('rv_rstate').textContent=(j&&j.ek&&RV_EK[j.ek])?RV_EK[j.ek]:`<#RFW_359#>`;return;}
+    $('rv_rules').value=text;rvRulesText=text;
+    $('rv_rstate').textContent=`<#RFW_377#>`;
+    setTimeout(rvLoad,3000);setTimeout(rvLoad,8000);rvLoadLog();
+  });
+}
+function rvLoadRules(){
+  rvcgi('action=rules',function(j){if(j&&j.ok&&$('rv_rules').value===rvRulesText){rvRulesText=j.rules||'';$('rv_rules').value=rvRulesText;}});
+}
+function rvLoadLog(){
+  rvcgi('action=log',function(j){
+    var ul=$('rv_log');ul.textContent='';
+    var l=(j&&j.ok&&j.log)||[];
+    if(!l.length){var e=document.createElement('li');e.textContent=`<#RFW_383#>`;ul.appendChild(e);return;}
+    l.slice(0,10).forEach(function(x){
+      var li=document.createElement('li');
+      li.textContent=`<#RFW_379#>`.replace('%1',x.ts?new Date(x.ts*1000).toLocaleString():'').replace('%2',RV_ACT[x.act]||x.act).replace('%3',x.ip||'-').replace('%4',x.d||'');
+      ul.appendChild(li);
+    });
+  });
+}
 function rvToggle(){
   var on=!$('rv_tg').classList.contains('on');
   rvpost('action=set&enable='+(on?'1':'0'),function(j){
@@ -1591,7 +1668,7 @@ function rvAck(){
     rvpost('action=ack',function(j){
       if(!j||!j.ok){$('rv_state').textContent=(j&&j.ek&&RV_EK[j.ek])?RV_EK[j.ek]:`<#RFW_359#>`;return;}
       $('rv_state').textContent=`<#RFW_358#>`;
-      setTimeout(rvLoad,3000);setTimeout(rvLoad,8000);
+      setTimeout(rvLoad,3000);setTimeout(rvLoad,8000);rvLoadLog();
     });
   });
 }
@@ -2097,6 +2174,7 @@ function boot(){
   $('st_auto').onclick=function(){this.classList.toggle('on');stopAuto();startAuto();};
   $('rv_tg').onclick=rvToggle;
   $('rv_ack').onclick=rvAck;
+  $('rv_rsave').onclick=function(){rvSaveRules($('rv_rules').value.replace(/\r/g,'').replace(/\s+$/,''));};
   $('wt_refresh').onclick=function(){try{var _h=$('wt_hint');if(_h)_h.textContent=' ...';}catch(e){}loadWit(true);};
   $('wt_auto').onclick=function(){this.classList.toggle('on');stopWitAuto();startWitAuto();};
   document.addEventListener('visibilitychange',function(){if(document.hidden){stopAuto();stopWitAuto();}else{if($('tab_status').classList.contains('on'))startAuto();if($('tab_witness').classList.contains('on'))startWitAuto();}});
