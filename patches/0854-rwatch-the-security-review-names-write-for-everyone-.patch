From 9194968073c556bbc5f913221acf5da1c422d224 Mon Sep 17 00:00:00 2001
From: reaper <theunbounddeveloper@outlook.com>
Date: Tue, 20 Oct 2026 21:56:35 -0400
Subject: [PATCH] rwatch: the security review names write-for-everyone under
 /jffs

_rv_ww counts files and non-sticky folders under /jffs that any user can
write (first 1000), writes review.ww, and review.json gains "ww" and
"ww_p" (the first path) - its own fields, since notices_n counts failed
logins. One syslog line per change of the count, not per run.

The walk is ls -lanR + awk: the router's busybox find has no -type,
-perm or -xdev and silently matches nothing (proven on metal: a 0777
folder, a 0666 file whose name has a space, a sticky folder skipped).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 release/src/router/rc/rwatch.c | 34 +++++++++++++++++++++++++++++++---
 1 file changed, 31 insertions(+), 3 deletions(-)

diff --git a/release/src/router/rc/rwatch.c b/release/src/router/rc/rwatch.c
index 3abbb35453..23db079e1c 100644
--- a/release/src/router/rc/rwatch.c
+++ b/release/src/router/rc/rwatch.c
@@ -235,7 +235,7 @@ static void rwatch_gen(void)
 	  "# line is whatever was typed): backslash and quote escaped, control bytes stripped by the\n"
 	  "# caller; the page renders with textContent only. Changes first, baseline rows after, 200 max.\n"
 	  "_rv_json() {\n"
-	  "  awk -F'\t' -v armed=\"$1\" -v ts=\"$(date +%s)\" -v AUTHF=\"$RV_TMP/review.auth\" '\n"
+	  "  awk -F'\t' -v armed=\"$1\" -v ts=\"$(date +%s)\" -v AUTHF=\"$RV_TMP/review.auth\" -v WWF=\"$RV_TMP/review.ww\" '\n"
 	  "    function esc(s) { gsub(/\\\\/, \"\\\\\\\\&\", s); gsub(/\"/, \"\\\\\\\\&\", s); return s }\n"
 	  "    function item() { return \"{\\\"t\\\":\\\"\" $2 \"\\\",\\\"k\\\":\\\"\" esc($3) \"\\\",\\\"st\\\":\\\"\" $1 \"\\\",\\\"v\\\":\\\"\" esc($4) \"\\\"}\" }\n"
 	  "    $2==\"T\" { tr=1; next }\n"
@@ -254,9 +254,36 @@ static void rwatch_gen(void)
 	  "      printf \"],\\\"notices\\\":[\"\n"
 	  "      m=0\n"
 	  "      while ((getline line < AUTHF) > 0) { split(line, f, \" \"); if (f[1]==\"auth\") { if (m++) printf \",\"; printf \"{\\\"svc\\\":\\\"%s\\\",\\\"ip\\\":\\\"%s\\\",\\\"n\\\":%d,\\\"ts\\\":%d}\", esc(f[2]), esc(f[3]), f[4]+0, f[5]+0 } }\n"
-	  "      printf \"],\\\"notices_n\\\":%d}\\n\", m\n"
+	  /* 2026-10-20 (field): write-for-everyone under /jffs, `ww <count> <first path>` kept by
+	   * _rv_ww - its own fields, because the pages word notices_n as failed logins */
+	  "      ww=0; wp=\"\"\n"
+	  "      if ((getline line < WWF) > 0) { split(line, f, \" \"); if (f[1]==\"ww\") { ww=f[2]+0; wp=substr(line, length(f[1]) + length(f[2]) + 3) } }\n"
+	  "      printf \"],\\\"notices_n\\\":%d,\\\"ww\\\":%d,\\\"ww_p\\\":\\\"%s\\\"}\\n\", m, ww, esc(wp)\n"
 	  "    }'\n"
 	  "}\n"
+	  /* 2026-10-20 (field, RT-BE88U): rc removes write-for-everyone from every file and
+	   * folder under /jffs at each boot (shared/reaper_jfile.c reaper_jffs_perm_sweep). One
+	   * that has it again was given it since: the count and the first path go to the card
+	   * and the dashboard, one syslog line per change of the count. Reported, never changed
+	   * here - the review is advisory end to end. Regular files and non-sticky folders,
+	   * the sweep's own set; at most 1000 listed. Read from `ls -lanR`, because this
+	   * firmware's busybox find has no -type, -perm or -xdev (r1 metal: a find-based
+	   * first version read 0 with a 0666 file planted); -a includes the hidden files,
+	   * the 9th mode character is the other-write bit, a trailing t/T is sticky. */
+	  "_rv_ww() {\n"
+	  "  ls -lanR /jffs 2>/dev/null | awk '/^\\/.*:$/ { d=substr($0, 1, length($0)-1); next } ($1 ~ /^-.......w/ || ($1 ~ /^d.......w/ && $1 !~ /[tT]$/)) { n=$0; for (i=1;i<=8;i++) sub(/^[^ ]+ +/, \"\", n); if (n==\".\" || n==\"..\") next; print d \"/\" n }' | head -n 1000 > $RV_TMP/ww.lst\n"
+	  "  _wn=$(wc -l < $RV_TMP/ww.lst | tr -d ' ')\n"
+	  "  if [ \"${_wn:-0}\" -gt 0 ]; then\n"
+	  "    _wp=$(head -n 1 $RV_TMP/ww.lst | tr -d '\\000-\\037\\177')\n"
+	  "    printf 'ww %s %s\\n' \"$_wn\" \"$_wp\" > $RV_TMP/review.ww\n"
+	  "    [ \"$_wn\" = \"$(cat $RV_TMP/ww.said 2>/dev/null)\" ] || logger -t rwatch \"security review: $_wn file(s) or folder(s) under /jffs are writable by any user (first: $_wp) - the next reboot removes that permission; until then a compromised non-root service could change them\"\n"
+	  "    echo \"$_wn\" > $RV_TMP/ww.said\n"
+	  "  else\n"
+	  "    rm -f $RV_TMP/review.ww $RV_TMP/ww.said\n"
+	  "  fi\n"
+	  "  rm -f $RV_TMP/ww.lst\n"
+	  "  return 0\n"
+	  "}\n"
 	  /* 2026-10-19 (Rung 3): failed logins per source since the last tick, from a
 	   * byte cursor on the syslog. dropbear logs `Bad password attempt for 'u' from
 	   * ip:port` / `[v6]:port` and `Login attempt for nonexistent user from ...`
@@ -297,9 +324,10 @@ static void rwatch_gen(void)
 	  "  return 0\n"
 	  "}\n"
 	  "_rv_run() {\n"
-	  "  if [ \"$(_nv rwatch_review)\" != 1 ]; then rm -f $RV_TMP/review.json $RV_TMP/review.last $RV_TMP/review.inv $RV_TMP/review.diff $RV_TMP/review.auth $RV_TMP/auth.cur $RV_TMP/auth.seen 2>/dev/null; return 0; fi\n"
+	  "  if [ \"$(_nv rwatch_review)\" != 1 ]; then rm -f $RV_TMP/review.json $RV_TMP/review.last $RV_TMP/review.inv $RV_TMP/review.diff $RV_TMP/review.auth $RV_TMP/auth.cur $RV_TMP/auth.seen $RV_TMP/review.ww $RV_TMP/ww.said 2>/dev/null; return 0; fi\n"
 	  "  _rv_inv > $RV_TMP/review.inv.tmp 2>/dev/null && mv -f $RV_TMP/review.inv.tmp $RV_TMP/review.inv || return 0\n"
 	  "  _rv_auth\n"
+	  "  _rv_ww\n"
 	  "  _ra=0; [ -s \"$RV_BASE\" ] && [ ! -L \"$RV_BASE\" ] && _ra=1\n"
 	  "  if [ \"$_ra\" = 1 ]; then _rv_diff \"$RV_BASE\" $RV_TMP/review.inv; else awk '{print \"new\\t\" $0}' $RV_TMP/review.inv; fi | tr -d '\\000-\\010\\013-\\037\\177' > $RV_TMP/review.diff\n"
 	  "  _rv_json \"$_ra\" < $RV_TMP/review.diff > $RV_TMP/review.json.tmp && mv -f $RV_TMP/review.json.tmp $RV_TMP/review.json\n"
-- 
2.25.1

