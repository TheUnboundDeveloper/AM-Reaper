From 9d65ea1c8287c09c2cb18f102fcadd582a865008 Mon Sep 17 00:00:00 2001
From: reaper <theunbounddeveloper@outlook.com>
Date: Tue, 20 Oct 2026 21:56:37 -0400
Subject: [PATCH] reaper_diag v1.3.45: /jffs world-write count and the boot
 sweep record

Section 3 counts files and folders under /jffs any user can write (ls
-lanR + awk, counts only), prints the boot record from
/tmp/reaper/jffs.sweep, and raises a WARN finding when the count is not
zero. Reaper_Diag.asp follows the version.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 release/src/router/others/reaper_diag  | 16 +++++++++++++---
 release/src/router/www/Reaper_Diag.asp |  2 +-
 2 files changed, 14 insertions(+), 4 deletions(-)

diff --git a/release/src/router/others/reaper_diag b/release/src/router/others/reaper_diag
index f569dd74a5..4eb3f4294f 100644
--- a/release/src/router/others/reaper_diag
+++ b/release/src/router/others/reaper_diag
@@ -1,7 +1,8 @@
 #!/bin/sh
 # ============================================================================
-#  REAPER-DIAG v1.3.44 (2026-10-20) - sanitized one-shot diagnostic bundle
-#  v1.3.44 guards the Dreadwatch pending count in 14: no hits file reads 0, not a
+#  REAPER-DIAG v1.3.45 (2026-10-20) - sanitized one-shot diagnostic bundle
+#  v1.3.45 counts files and folders under /jffs that any user can write (section 3; rc
+#  removes that at every boot, so a count is a regression). v1.3.44 guards the Dreadwatch pending count in 14: no hits file reads 0, not a
 #  shell error (the first r3 report carried one). v1.3.43 adds the Dreadwatch line in 14 (threat-domain block counts per feed,
 #  never a name or a device). v1.3.42 adds the Gatekeeper DNS sinkhole line in 14b (held devices' resolver:
 #  pid, port, redirect rule counts). v1.3.41 reports the security review (switch,
@@ -158,7 +159,7 @@
 #  are one-shot cats. Do not add an unbounded command here.
 # ============================================================================
 PATH=/sbin:/bin:/usr/sbin:/usr/bin
-VER="REAPER-DIAG v1.3.44"
+VER="REAPER-DIAG v1.3.45"
 T0="$(date +%s 2>/dev/null)"
 MODEL="$(nvram get productid 2>/dev/null)"
 EXTNO="$(nvram get extendno 2>/dev/null)"
@@ -732,6 +733,15 @@ done
 TAS="$(ls -d /tmp/*.bad.* 2>/dev/null | wc -l)"
 echo "  moved aside       : $TAS"
 [ "$TAS" -gt 0 ] && finding WARN "$TAS item(s) named *.bad.* in /tmp: something non-root held a Reaper directory name and rc moved it aside - check syslog for 'was not a private directory' (see 3)"
+# v1.3.45 (2026-10-20, field): files and folders under /jffs any user can write. rc removes that
+# at every boot (reaper_jffs_perm_sweep), so a count here was set since the boot. Counts only.
+# From `ls -lanR`: this busybox find has no -type/-perm/-xdev. 9th mode char = other-write; t/T = sticky.
+JWW="$(ls -lanR /jffs 2>/dev/null | awk '/^\/.*:$/ {next} ($1 ~ /^-.......w/ || ($1 ~ /^d.......w/ && $1 !~ /[tT]$/)) { n=$0; for (i=1;i<=8;i++) sub(/^[^ ]+ +/, "", n); if (n=="." || n=="..") next; if ($1 ~ /^d/) d++; else f++ } END {print f+0, d+0}')"
+JWF=${JWW%% *}; JWD=${JWW##* }
+echo "  /jffs world-write : files=${JWF:-0} folders=${JWD:-0}  (0 expected: rc removes it at every boot)"
+JSW="$(cat /tmp/reaper/jffs.sweep 2>/dev/null)"
+echo "  /jffs boot sweep  : $( [ -n "$JSW" ] && echo "changed=${JSW%% *} failed=$(echo "$JSW" | awk '{print $2}') this boot" || echo "no record this boot")"
+[ $(( ${JWF:-0} + ${JWD:-0} )) -gt 0 ] && finding WARN "$(( ${JWF:-0} + ${JWD:-0} )) file(s) or folder(s) under /jffs are writable by any user, set since the last boot - a non-root service could change them (keys, sshd_authkeys); the next reboot removes it (the Security Review card names the first one) (see 3)"
 
 sec "3b. NVRAM HYGIENE (names and sizes only - values never printed)"
 # The HND kernel nvram store rejects any name+value tuple over 1024 bytes and
diff --git a/release/src/router/www/Reaper_Diag.asp b/release/src/router/www/Reaper_Diag.asp
index 28b6d9ac11..2475c1f92c 100644
--- a/release/src/router/www/Reaper_Diag.asp
+++ b/release/src/router/www/Reaper_Diag.asp
@@ -69,7 +69,7 @@ pre.sample .g{color:var(--jade)} pre.sample .r{color:#e0837d} pre.sample .w{colo
 
