diff --git a/release/src/router/wallguard/wallguard.sh b/release/src/router/wallguard/wallguard.sh
new file mode 100644
index 0000000000..d4b74046b8
--- /dev/null
+++ b/release/src/router/wallguard/wallguard.sh
@@ -0,0 +1,500 @@
+#!/bin/sh
+# SPDX-License-Identifier: GPL-2.0-only
+# Copyright (C) 2026 the Reaper project maintainer
+# Part of the Reaper hardened Asuswrt-Merlin build. See LICENSE / LICENSE.reaper.
+#
+# wallguard.sh - Wallguard's list updater and statistics collector (2026-10-21).
+#
+# rc (rc/wallguard.c) writes what this needs into $D and calls it; httpd calls stats / why-less
+# actions. Nothing here reads nvram. $D is root's; dnsmasq (nobody) writes only in $D/run, so
+# what comes from there is moved into $D, never followed through a symlink, and validated.
+#   $D/feeds    one subscribed list per line: <bit> <id> <url> <p|c|s>  (p = preset, c = custom,
+#               s = a profile's blocked services: a local file rc writes, url "-", never fetched)
+#   $D/safesearch  the search engines' enforcement names + addresses (safe search, phase 2)
+#   $D/safe     names that are never blocked (router names, NTP, DDNS, DoT, list hosts)
+#   $J/block    My rules: names to block (with subdomains)
+#   $J/allow    names never blocked;  $J/allow24 = "<expiry> <name>" temporary allows
+#
+#   update   fetch every list (keeping the previous copy of one that fails), then build
+#   build    compile the table from what is on disk (after a rule change - no downloads)
+#   fold     move dnsmasq's blocked-lookup records into the counters
+#   stats    fold, then print the status JSON for the page
+#   unbreak <ip-or-mac> <minutes>   recent blocked names for one device, as JSON
+#   live     the newest lookups of the live view, as JSON
+#   reset    clear the counters
+#   safe     refresh the safe-search file now (rc, when a profile first asks for it)
+#   restore  no table yet: build from the lists kept on the USB volume, no download
+#
+# Long-Term Storage (2026-10-21, System Log > Long-Term Storage): with "Wallguard block lists" ticked
+# and the store on the pinned USB volume, a downloaded list moves to <volume>/.reaper/wallguard/lists
+# and leaves RAM; the table is always built into RAM (the stick is read only while building, never
+# during lookups). $J/lists.sum holds each list's sha256 as downloaded, so a copy changed on the
+# shared volume is never used. "Wallguard blocked lookups" appends every folded record to
+# <store>/wallguard/blocked.log. Where the store is comes from the watchdog (rstore_dir below).
+D=${WALLGUARD_DIR:-/tmp/wallguard}
+J=${WALLGUARD_JFFS:-/jffs/wallguard}
+L=$D/lists
+RUN=$D/run
+SC=${WALLGUARDC:-/usr/sbin/wallguardc}
+CTR=$D/counters
+REC=$D/recent
+
+# 2026-10-25 (release review X-2): each list is capped at 32 MB, but nine presets and eight custom lists
+# together could fill the RAM disk. The lists kept in RAM (a USB store takes them out of it) stay under
+# LCAP together, and nothing is downloaded while less than 160 MB of memory is available.
+LCAP=${WALLGUARD_RAM_CAP:-100663296}
+MEMMIN=${WALLGUARD_MEM_MIN_KB:-163840}
+CURL='curl -fsSL --max-filesize 33554432 --retry 2 --max-time 90'
+CURLC='curl -fsSL --max-filesize 33554432 --retry 1 --max-time 25'
+if curl --proto-redir =https --version >/dev/null 2>&1; then
+  CURL="$CURL --proto =https --proto-redir =https"
+  CURLC="$CURLC --proto =https --proto-redir =https"
+fi
+
+log() { logger -t wallguard "$*" 2>/dev/null; }
+
+# rstore_dir: begin (shared/reaper_store.h RSTORE_SH_DIR - keep identical)
+rstore_dir() {
+  _sf=${RSTORE_PUB_F:-/tmp/reaper/store.base}; _sm=${RSTORE_MNT_D:-/tmp/mnt}
+  [ -f "$_sf" ] && [ ! -L "$_sf" ] || return 1
+  { read -r _sb; read -r _sd; } < "$_sf"
+  case "$_sd" in *",$1,"*) ;; *) return 1 ;; esac
+  case "$_sb" in
+    "${RSTORE_JFFS_D:-/jffs/reaper}") ;;
+    "$_sm"/?*/.reaper) grep -qF " ${_sb%/.reaper} " "${RSTORE_MOUNTS:-/proc/mounts}" && [ -f "$_sb/store.id" ] && [ ! -L "$_sb/store.id" ] || return 1 ;;
+    *) return 1 ;;
+  esac
+  [ -d "$_sb" ] && [ ! -L "$_sb" ] && [ -w "$_sb" ] || return 1
+  echo "$_sb"
+}
+# rstore_dir: end
+SUM=$J/lists.sum
+# every read and write on the store goes through rstore: a USB store is a volume other people can
+# write (guest shares map to uid 0), and a root `cp`/`>>`/`rm` by path there follows their links
+RS=${RSTORE:-/usr/sbin/rstore}
+ST=$D/stage		# root's RAM copies of stored lists, checked before a build uses them
+
+# the store base for the lists, when "Wallguard block lists" is ticked and the store is a USB volume
+st_lists() {
+  b=$(rstore_dir shl) || return 1
+  case "$b" in "${RSTORE_MNT_D:-/tmp/mnt}"/*) echo "$b" ;; *) return 1 ;; esac
+}
+sum_of() { sha256sum "$1" 2>/dev/null | awk '{print $1}'; }
+sum_rec() { awk -v i="$1" '$1 == i {print $2; exit}' "$SUM" 2>/dev/null; }
+sum_set() {
+  mkdir -p "$J"
+  { awk -v i="$1" '$1 != i' "$SUM" 2>/dev/null; echo "$1 $2 $3"; } > "$SUM.tmp" && mv "$SUM.tmp" "$SUM"
+}
+# the stored copy of list <id> as root's RAM copy in $ST, only when its sha256 is the one recorded
+# at download (copied first, checked after: what the build reads is what was checked)
+st_get() {
+  [ -n "$S" ] || return 1
+  r=$(sum_rec "$1"); [ -n "$r" ] || return 1
+  [ -d "$ST" ] || mkdir -m 0700 "$ST" 2>/dev/null || return 1
+  if [ ! -s "$ST/$1" ] || [ "$(sum_of "$ST/$1")" != "$r" ]; then
+    "$RS" get "$S" wallguard/lists "$1" "$ST/$1" 33554432 2>/dev/null || { rm -f "$ST/$1"; return 1; }
+    if [ "$(sum_of "$ST/$1")" != "$r" ]; then
+      rm -f "$ST/$1"; log "list $1 on the USB volume does not match its last download - not used"; return 1
+    fi
+  fi
+  echo "$ST/$1"
+}
+# the usable copy of list <id>: the checked RAM copy of the stored one, else the downloaded one
+list_path() {
+  st_get "$1" && return 0
+  [ -s "$L/$1" ] && [ ! -L "$L/$1" ] && { echo "$L/$1"; return 0; }
+  return 1
+}
+# a list just downloaded to RAM: record its sha256; with a USB store, write it there (rstore put),
+# read it back and check it, then drop the downloaded copy. Any failure keeps the list in RAM.
+offload() {
+  h=$(sum_of "$L/$1"); z=$(wc -c < "$L/$1")
+  [ -n "$h" ] || return 0
+  sum_set "$1" "$h" "$z"
+  [ -n "$S" ] || return 0
+  rm -f "$ST/$1"
+  if "$RS" put "$S" wallguard/lists "$1" "$L/$1" 2>/dev/null && st_get "$1" >/dev/null; then
+    rm -f "$L/$1"; return 0
+  fi
+  [ -n "$warned" ] || log "a list could not be written to the USB volume - kept in RAM"
+  warned=1
+}
+# "Wallguard blocked lookups": append the folded records; past the cap (USB 16 MB, JFFS 2 MB) the
+# log becomes blocked.log.1 first
+hist() {
+  b=$(rstore_dir shh) || return 0
+  case "$b" in "${RSTORE_MNT_D:-/tmp/mnt}"/*) cap=16777216 ;; *) cap=2097152 ;; esac
+  "$RS" append "$b" wallguard blocked.log "$cap" < "$1" 2>/dev/null
+}
+
+# the bytes of the lists held in RAM (not a download in progress)
+ram_lists() {
+  for f in "$L"/*; do
+    case "$f" in *.new) continue ;; esac
+    [ -f "$f" ] && [ ! -L "$f" ] && wc -c < "$f"
+  done | awk '{ s += $1 } END { print s + 0 }'
+}
+mem_avail_kb() { awk '/^MemAvailable:/ { print $2; f = 1 } END { if (!f) print 999999999 }' /proc/meminfo 2>/dev/null; }
+
+# Where the store is, for the page and the history queue (2026-10-25, release review X-1): the
+# watchdog's record, the mount table and one lstat of the base - never a read, a write or a test
+# inside the volume. httpd waits for `stats`, so I/O on a USB disk that hangs would hang the web
+# interface with it. The writes themselves still go through rstore_dir + rstore (hist_bg).
+store_peek() {
+  _sf=${RSTORE_PUB_F:-/tmp/reaper/store.base}; _sm=${RSTORE_MNT_D:-/tmp/mnt}
+  [ -f "$_sf" ] && [ ! -L "$_sf" ] || return 1
+  { read -r _sb; read -r _sd; } < "$_sf"
+  case "$_sd" in *",$1,"*) ;; *) return 1 ;; esac
+  case "$_sb" in
+    "${RSTORE_JFFS_D:-/jffs/reaper}") ;;
+    "$_sm"/?*/.reaper) grep -qF " ${_sb%/.reaper} " "${RSTORE_MOUNTS:-/proc/mounts}" || return 1 ;;
+    *) return 1 ;;
+  esac
+  [ ! -L "$_sb" ] || return 1
+  echo "$_sb"
+}
+
+# "Wallguard blocked lookups" in the background (2026-10-25, release review X-1): fold queues the
+# records and one detached writer appends them, so neither the page's stats nor the cron fold waits
+# on the USB disk. While a writer is still out (a slow or hung disk) the queue grows, capped at 20,000
+# records; a writer gone for an hour is given up and the next one starts.
+hist_bg() {
+  [ -s "$D/hist.q" ] || return 0
+  if [ -e "$D/hist.work" ]; then
+    [ $(( $(date +%s) - $(date -r "$D/hist.work" +%s 2>/dev/null || echo 0) )) -ge 3600 ] || {
+      tail -n 20000 "$D/hist.q" > "$D/hist.q.t" && mv "$D/hist.q.t" "$D/hist.q"; return 0; }
+    rm -f "$D/hist.work"
+  fi
+  mv "$D/hist.q" "$D/hist.work" 2>/dev/null || return 0
+  # the writer drops every lock this script holds (fold's among them): a hung disk must not hold up the next fold
+  ( exec 6>&- 7>&- 8>&- 9>&-; hist "$D/hist.work"; rm -f "$D/hist.work" ) </dev/null >/dev/null 2>&1 &
+}
+
+# a feed line: "<bit> <id> <https-url> <p|c>" or "<bit> svc_<profile> - s", each field
+# checked before it becomes a path
+feed_ok() {
+  case "$1" in ''|*[!0-9]*) return 1 ;; esac
+  [ "$1" -ge 1 ] && [ "$1" -le 30 ] || return 1
+  case "$2" in ''|*[!a-z0-9_]*) return 1 ;; esac
+  if [ "$4" = s ]; then
+    case "$2" in svc_?*) ;; *) return 1 ;; esac
+    [ "$3" = - ] || return 1
+    return 0
+  fi
+  case "$3" in https://?*) ;; *) return 1 ;; esac
+  return 0
+}
+
+# cat what dnsmasq left in $RUN, but only a regular file - never through a symlink
+run_cat() { for f in "$@"; do [ -f "$f" ] && [ ! -L "$f" ] && cat "$f"; done; }
+
+build() {
+  # one build at a time (rc's background rebuilds, Unbreak's Allow, the update): two at once wrote the
+  # same table file (review 2026-10-21); waits, so the later rule change still lands
+  exec 8>"$D/build.lock"
+  flock -w 300 8 || { log "another block table build is still running - this one was skipped"; return 1; }
+  args=; miss=
+  [ -f "$D/feeds" ] || : > "$D/feeds"
+  [ -n "${S+x}" ] || S=$(st_lists)
+  while read -r bit id url kind; do
+    feed_ok "$bit" "$id" "$url" "$kind" || continue
+    if p=$(list_path "$id"); then
+      args="$args --list $bit:$id:$p"
+    elif [ "$kind" != s ] && awk -v i="$id" '$1 == i && $3 > 0 {f=1} END {exit !f}' "$D/state" 2>/dev/null; then
+      miss="$miss $id"
+    fi
+  done < "$D/feeds"
+  # a list that was downloaded before and has no usable copy now (its USB volume is not mounted):
+  # the table in use stays rather than lose those names
+  if [ -n "$miss" ] && [ -s "$D/db" ]; then
+    log "list(s)$miss have no usable copy (USB volume not mounted, or the copy changed) - the block table in use stays until they are back or downloaded again"
+    rm -rf "$ST"
+    return 1
+  fi
+  now=$(date +%s)
+  # temporary allows still running; the expired ones drop out of the file too
+  if [ -f "$J/allow24" ]; then
+    awk -v n="$now" '$1 > n' "$J/allow24" > "$D/allow24.keep"
+    awk '{print $2}' "$D/allow24.keep" > "$D/allow24"
+    cmp -s "$D/allow24.keep" "$J/allow24" || { cp "$D/allow24.keep" "$J/allow24.tmp" && mv "$J/allow24.tmp" "$J/allow24"; }
+  else
+    : > "$D/allow24"
+  fi
+  # shellcheck disable=SC2086
+  if "$SC" build --out "$D/db" --stats "$D/build.json" --rules "$J/block" --allow "$J/allow" \
+       --allow "$D/allow24" --allow "$D/safe" $args; then
+    log "block table built: $(sed -n 's/.*"names":\([0-9]*\).*/\1/p' "$D/build.json") names"
+    rm -rf "$ST"
+  else
+    log "the block table could not be built - the previous one stays in use"
+    rm -rf "$ST"
+    return 1
+  fi
+}
+
+update() {
+  exec 9>"$D/update.lock"
+  flock -n 9 || { log "an update is already running"; return 0; }
+  mkdir -p "$L"
+  S=$(st_lists)
+  restore_build		# no table yet: block from the stored lists while the downloads run
+  : > "$D/state.new"
+  while read -r bit id url kind; do
+    feed_ok "$bit" "$id" "$url" "$kind" || { [ -n "$id" ] && log "feed line for $id is not valid - skipped"; continue; }
+    [ "$kind" = s ] && continue		# rc wrote it; nothing to fetch
+    c=$CURL; [ "$kind" = c ] && c=$CURLC
+    prev=$(awk -v i="$id" '$1 == i {print $3}' "$D/state" 2>/dev/null)
+    now=$(date +%s)
+    why=
+    [ "$(mem_avail_kb)" -lt "$MEMMIN" ] && why="not fetched, less than $((MEMMIN / 1024)) MB of memory available"
+    # shellcheck disable=SC2086
+    if [ -z "$why" ] && $c -o "$L/$id.new" "$url" 2>/dev/null && [ -s "$L/$id.new" ]; then
+      old=0; [ -f "$L/$id" ] && [ ! -L "$L/$id" ] && old=$(wc -c < "$L/$id")
+      [ $(( $(ram_lists) - old + $(wc -c < "$L/$id.new") )) -gt "$LCAP" ] &&
+        why="not taken, the lists kept in RAM would pass $((LCAP / 1048576)) MB (Long-Term Storage can keep them on USB)"
+    else
+      [ -n "$why" ] || why="download failed"
+    fi
+    if [ -z "$why" ]; then
+      mv "$L/$id.new" "$L/$id"
+      offload "$id"
+      echo "$id ok $now $now" >> "$D/state.new"
+    else
+      rm -f "$L/$id.new"
+      if list_path "$id" >/dev/null; then st=failed; else st=missing; fi
+      echo "$id $st ${prev:-0} $now" >> "$D/state.new"
+      log "list $id: $why$( [ "$st" = failed ] && echo ', previous copy kept')"
+    fi
+  done < "$D/feeds"
+  mv "$D/state.new" "$D/state"
+  # 2026-10-25 (release review W-1): no subscribed list has a usable copy - every download failed, as at
+  # a boot that runs before the WAN or the clock is up. The table below still carries My rules, so the
+  # "no table yet" retries would never fire again and nothing on the lists would be blocked until 05:15.
+  # $D/pending says the lists are still owed: rc fetches again when the WAN comes up, rwatch every 10 min.
+  nf=0; nu=0
+  while read -r bit id url kind; do
+    feed_ok "$bit" "$id" "$url" "$kind" || continue
+    [ "$kind" = s ] && continue
+    nf=$((nf + 1)); list_path "$id" >/dev/null && nu=$((nu + 1))
+  done < "$D/feeds"
+  if [ "$nf" -gt 0 ] && [ "$nu" = 0 ]; then
+    : > "$D/pending"
+    log "no block list could be downloaded - only My rules are blocked until the lists come down (retried when the internet is up)"
+  else
+    rm -f "$D/pending"
+  fi
+  safesearch
+  # lists no longer subscribed leave the RAM disk and the USB volume (rstore prune: removed inside
+  # the folder by name, never through a link)
+  for f in "$L"/*; do
+    [ -f "$f" ] || [ -L "$f" ] || continue
+    n=${f##*/}
+    awk -v i="$n" '$2 == i {f=1} END {exit !f}' "$D/feeds" || rm -f "$f"
+  done
+  # shellcheck disable=SC2046
+  [ -n "$S" ] && "$RS" prune "$S" wallguard/lists $(awk '$2 ~ /^[a-z0-9_]+$/ {print $2}' "$D/feeds") 2>/dev/null
+  build
+}
+
+# no table yet (boot, or the USB volume just arrived): build from the stored lists - only when at
+# least one stored list is usable, so the "no table, fetch" paths are never fooled by a table
+# holding My rules alone
+restore_build() {
+  [ -s "$D/db" ] && return 0
+  [ -n "$S" ] && [ -f "$D/feeds" ] || return 1
+  n=0
+  while read -r bit id url kind; do
+    feed_ok "$bit" "$id" "$url" "$kind" || continue
+    p=$(list_path "$id") || continue
+    case "$p" in "$ST"/*) n=1 ;; esac
+  done < "$D/feeds"
+  [ "$n" = 1 ] || return 1
+  log "no block table yet - building from the lists on the USB volume"
+  build
+}
+restore() {
+  exec 9>"$D/update.lock"
+  flock -n 9 || return 0
+  S=$(st_lists)
+  restore_build
+}
+
+# Safe search (phase 2, 2026-10-21): which names the engine answers and with what. Google's
+# country domains come from Google's own list; the enforcement addresses are resolved through
+# the router's resolver (never hard-coded). A list or an address that cannot be fetched keeps
+# the previous one, so a bad moment upstream never switches safe search off. Groups:
+# g Google, b Bing, d DuckDuckGo, y / Y YouTube Restricted Mode moderate / strict.
+safesearch() {
+  out=$D/safesearch.new
+  if $CURLC -o "$D/gdomains.new" https://www.google.com/supported_domains 2>/dev/null \
+     && grep -q '^\.google\.' "$D/gdomains.new"; then
+    mv "$D/gdomains.new" "$D/gdomains"
+  else
+    rm -f "$D/gdomains.new"
+  fi
+  {
+    { [ -f "$D/gdomains" ] && cat "$D/gdomains"; echo .google.com; } | tr 'A-Z' 'a-z' \
+      | awk '/^\.google\.[a-z][a-z.]*[a-z]$/ && !s[$0]++ { d = substr($0, 2); print "name g " d; print "name g www." d }'
+    for n in www.bing.com bing.com; do echo "name b $n"; done
+    for n in duckduckgo.com www.duckduckgo.com start.duckduckgo.com; do echo "name d $n"; done
+    for n in www.youtube.com m.youtube.com youtubei.googleapis.com youtube.googleapis.com www.youtube-nocookie.com; do
+      echo "name y $n"
+    done
+    for gh in g:forcesafesearch.google.com b:strict.bing.com d:safe.duckduckgo.com y:restrictmoderate.youtube.com Y:restrict.youtube.com; do
+      g=${gh%%:*}; h=${gh#*:}
+      a=$("$SC" resolve "$h" 2>/dev/null | awk -v g="$g" '($2 == "v4" && $3 ~ /^[0-9.]+$/) || ($2 == "v6" && $3 ~ /^[0-9a-f:]+$/) { print "addr " g " " $3 }')
+      if [ -n "$a" ]; then echo "$a"; else [ -f "$D/safesearch" ] && grep "^addr $g " "$D/safesearch"; fi
+    done
+  } > "$out"
+  mv "$out" "$D/safesearch"
+}
+
+# names are host names or nothing: a record that is not one is dropped, never shown
+NAMERE='^[a-z0-9_]([a-z0-9_.-]*[a-z0-9_])?$'
+# a client address (IPv4 / IPv6) and a MAC, as dnsmasq writes them
+IPRE='^[0-9a-f.:]+$'
+MACRE='^[0-9a-f][0-9a-f]:[0-9a-f][0-9a-f]:[0-9a-f][0-9a-f]:[0-9a-f][0-9a-f]:[0-9a-f][0-9a-f]:[0-9a-f][0-9a-f]$'
+
+fold() {
+  # one fold at a time (2026-10-25, release review): the cron fold and the page's stats both read and
+  # rewrite the counters, and two at once lost one's records
+  exec 6>"$D/fold.lock"
+  flock -w 10 6 || return 0
+  hist_bg		# records queued while the last writer was still out go now, new records or not
+  [ -f "$CTR" ] || { [ -f "$J/counters" ] && cp "$J/counters" "$CTR"; } || echo "SINCE $(date +%s)" > "$CTR"
+  [ -s "$CTR" ] || echo "SINCE $(date +%s)" > "$CTR"
+  # a plain, non-empty file only: a link or a directory planted at the name (review 2026-10-24 S-A-4: a directory
+  # wedged every later fold) is removed unread; rename never follows a link either
+  [ -f "$RUN/hits" ] && [ ! -L "$RUN/hits" ] || { rm -rf "$RUN/hits" 2>/dev/null; return 0; }
+  [ -s "$RUN/hits" ] || return 0
+  mv "$RUN/hits" "$D/hits.work" 2>/dev/null || return 0
+  if [ -L "$D/hits.work" ] || [ ! -f "$D/hits.work" ]; then rm -rf "$D/hits.work"; return 0; fi
+  rm -f "$CTR.names" "$CTR.devs"
+  awk -v re="$NAMERE" -v ipre="$IPRE" -v macre="$MACRE" '
+    function hexv(s,   i, c, v) { v = 0; s = tolower(s)
+      for (i = 1; i <= length(s); i++) { c = index("0123456789abcdef", substr(s, i, 1)) - 1; if (c < 0) return 0; v = v * 16 + c }
+      return v }
+    FILENAME == ARGV[1] { if ($1 == "SINCE") since = $2; else if ($1 == "TOTAL") tot = $2;
+                          else if ($1 == "CNAME") cn = $2; else if ($1 == "DROPPED") dr = $2;
+                          else if ($1 == "NAME" && $2 ~ re) { nc[$2] = $3; nb[$2] = $4; nt[$2] = $5 }
+                          else if ($1 == "DEV" && ($2 ~ ipre || $2 ~ macre) && $5 ~ ipre) { dc[$2] = $3; dt[$2] = $4; di[$2] = $5 }
+                          else if ($1 == "LIST") lc[$2] = $3; next }
+    /^# dropped [0-9]+$/ { dr += $3; next }
+    NF != 6 || $1 !~ /^[0-9]+$/ || $2 !~ ipre || $3 !~ /^[0-9a-f]+$/ || ($4 != "q" && $4 != "c") || ($5 != "-" && $5 !~ macre) || $6 !~ re { next }
+    { tot++; if ($4 == "c") cn++
+      nc[$6]++; nb[$6] = $3; nt[$6] = $1
+      dev = ($5 != "-") ? $5 : $2; dc[dev]++; dt[dev] = $1; di[dev] = $2
+      bits = hexv($3); for (b = 0; b < 31; b++) { if (bits % 2 == 1) lc[b]++; bits = int(bits / 2) }
+      print > REC }
+    END { print "SINCE " (since ? since : systime()) > OUT; print "TOTAL " tot+0 > OUT
+          print "CNAME " cn+0 > OUT; print "DROPPED " dr+0 > OUT
+          for (b in lc) print "LIST " b " " lc[b] > OUT
+          for (n in nc) print "NAME " n " " nc[n] " " nb[n] " " nt[n] > NAMES
+          for (d in dc) print "DEV " d " " dc[d] " " dt[d] " " di[d] > DEVS }
+  ' REC="$REC.add" OUT="$CTR.new" NAMES="$CTR.names" DEVS="$CTR.devs" "$CTR" "$D/hits.work"
+  # review 2026-10-24 (S-A-1): the counters keep the 200 busiest names and the 200 busiest devices, never
+  # every distinct one - a device inventing names or addresses could otherwise grow this file, its hourly
+  # /jffs copy and the RAM every fold holds without bound (Dreadwatch's collector keeps its top 100 the same way)
+  [ -f "$CTR.names" ] && sort -k3,3nr "$CTR.names" | head -n 200 >> "$CTR.new"
+  [ -f "$CTR.devs" ] && sort -k3,3nr "$CTR.devs" | head -n 200 >> "$CTR.new"
+  rm -f "$CTR.names" "$CTR.devs"
+  mv "$CTR.new" "$CTR"
+  rm -rf "$D/hits.work"
+  if [ -s "$REC.add" ]; then
+    cat "$REC.add" >> "$REC"
+    store_peek shh >/dev/null && cat "$REC.add" >> "$D/hist.q"
+    rm -f "$REC.add"
+    tail -n 500 "$REC" > "$REC.t" && mv "$REC.t" "$REC"
+  fi
+  hist_bg
+  # bank on /jffs at most hourly (NAND wear)
+  if [ ! -f "$J/counters" ] || [ $(( $(date +%s) - $(date -r "$J/counters" +%s 2>/dev/null || echo 0) )) -ge 3600 ]; then
+    mkdir -p "$J" && cp "$CTR" "$J/counters.tmp" && mv "$J/counters.tmp" "$J/counters"
+  fi
+}
+
+# the queries / blocked / cname / per-list counters of every live dnsmasq instance, summed
+instances() {
+  for f in "$RUN"/stats.*; do
+    [ -f "$f" ] && [ ! -L "$f" ] || continue
+    p=${f##*.}
+    case "$p" in *[!0-9]*|'') continue ;; esac
+    if [ -d "/proc/$p" ]; then cat "$f"; else rm -f "$f"; fi
+  done | awk '$2 ~ /^[0-9]+$/ && $3 ~ /^[0-9]+$/ && $4 ~ /^[0-9]+$/ { q += $2; b += $3; c += $4 } END { printf "%d %d %d", q, b, c }'
+}
+
+stats() {
+  fold
+  touch "$D/state" "$D/feeds"
+  # where the blocked-lookup history goes (Long-Term Storage): usb + volume name, jffs, or nothing
+  HS=; HV=; HB=$(store_peek shh) && case "$HB" in "${RSTORE_MNT_D:-/tmp/mnt}"/*) HS=usb; HV=${HB%/.reaper}; HV=${HV##*/} ;; *) HS=jffs ;; esac
+  set -- $(instances)
+  q=${1:-0}; b=${2:-0}; c=${3:-0}
+  awk -v q="$q" -v b="$b" -v c="$c" -v now="$(date +%s)" -v re="$NAMERE" -v ipre="$IPRE" -v macre="$MACRE" \
+      -v built="$( [ -f "$D/build.json" ] && cat "$D/build.json" || echo null)" \
+      -v hist="$HS" -v histvol="$HV" \
+      -v store="$(b=$(store_peek shl) && case "$b" in "${RSTORE_MNT_D:-/tmp/mnt}"/*) b=${b%/.reaper}; echo "${b##*/}" ;; esac)" \
+      -v live="$( [ -f "$D/live.on" ] && echo $(( 3600 - ($(date +%s) - $(date -r "$D/live.on" +%s)) )) || echo 0)" '
+    FILENAME == ARGV[1] { st[$1] = $2; ok[$1] = $3; at[$1] = $4; next }
+    FILENAME == ARGV[2] { fb[$2] = $1; fu[$2] = $3; fk[$2] = $4; order[++nf] = $2; next }
+    $1 == "SINCE" { since = $2 } $1 == "TOTAL" { tot = $2 } $1 == "CNAME" { cn = $2 } $1 == "DROPPED" { dr = $2 }
+    $1 == "LIST" { lc[$2] = $3 }
+    $1 == "NAME" && $2 ~ re { nn++; nm[nn] = $2; ncnt[nn] = $3; nbit[nn] = $4; ntime[nn] = $5 }
+    $1 == "DEV" && ($2 ~ ipre || $2 ~ macre) && $5 ~ ipre { dd++; dv[dd] = $2; dcnt[dd] = $3; dtime[dd] = $4; dip[dd] = $5 }
+    function topn(cnt, n, k,   i, j, t, idx) { for (i = 1; i <= n; i++) idx[i] = i
+      for (i = 1; i <= n && i <= k; i++) for (j = i + 1; j <= n; j++) if (cnt[idx[j]] > cnt[idx[i]]) { t = idx[i]; idx[i] = idx[j]; idx[j] = t }
+      # busybox awk reads "name (" as a function call, so concatenate through sep
+      out = ""; for (i = 1; i <= n && i <= k; i++) { sep = (i > 1) ? "," : ""; out = out sep idx[i] }; return out }
+    END {
+      gsub(/[^A-Za-z0-9 ._-]/, "", store); gsub(/[^A-Za-z0-9 ._-]/, "", histvol)
+      printf "{\"ok\":1,\"now\":%d,\"queries\":%d,\"blocked_live\":%d,\"cname_live\":%d,\"since\":%d,\"total\":%d,\"cname\":%d,\"dropped\":%d,\"live\":%d,\"build\":%s,\"store\":\"%s\",\"hist\":\"%s\",\"histvol\":\"%s\",", now, q, b, c, since, tot, cn, dr, (live > 0 ? live : 0), built, store, hist, histvol
+      printf "\"feeds\":["
+      for (i = 1; i <= nf; i++) { id = order[i]
+        printf "%s{\"id\":\"%s\",\"bit\":%d,\"kind\":\"%s\",\"st\":\"%s\",\"ok\":%d,\"at\":%d,\"blocked\":%d}", (i > 1 ? "," : ""), id, fb[id], fk[id], (id in st ? st[id] : "new"), ok[id], at[id], lc[fb[id]] }
+      printf "],\"rules_blocked\":%d,\"top\":[", lc[0]
+      split(topn(ncnt, nn, 50), t, ",")
+      for (i = 1; t[i] != ""; i++) { k = t[i]; printf "%s{\"d\":\"%s\",\"n\":%d,\"bits\":\"%s\",\"t\":%d}", (i > 1 ? "," : ""), nm[k], ncnt[k], nbit[k], ntime[k] }
+      printf "],\"devices\":["
+      split(topn(dcnt, dd, 50), t2, ",")
+      for (i = 1; t2[i] != ""; i++) { k = t2[i]; printf "%s{\"dev\":\"%s\",\"ip\":\"%s\",\"n\":%d,\"t\":%d}", (i > 1 ? "," : ""), dv[k], dip[k], dcnt[k], dtime[k] }
+      printf "]}\n" }
+  ' "$D/state" "$D/feeds" "$CTR" 2>/dev/null || echo '{"ok":0}'
+}
+
+unbreak() {
+  dev=$1; mins=${2:-15}
+  fold
+  awk -v dev="$dev" -v since="$(( $(date +%s) - mins * 60 ))" -v re="$NAMERE" '
+    NF == 6 && $1 >= since && ($2 == dev || $5 == dev) && $6 ~ re { c[$6]++; t[$6] = $1; b[$6] = $3 }
+    END { printf "{\"ok\":1,\"names\":["; i = 0
+          for (n in c) printf "%s{\"d\":\"%s\",\"n\":%d,\"t\":%d,\"bits\":\"%s\"}", (i++ ? "," : ""), n, c[n], t[n], b[n]
+          printf "]}\n" }' "$REC" 2>/dev/null || echo '{"ok":1,"names":[]}'
+}
+
+live() {
+  run_cat "$RUN/live.1" "$RUN/live" | tail -n 300 | awk -v re="$NAMERE" -v ipre="$IPRE" '
+    BEGIN { printf "{\"ok\":1,\"rows\":["; i = 0 }
+    NF == 5 && $1 ~ /^[0-9]+$/ && $2 ~ ipre && $3 ~ /^[0-9]+$/ && $5 ~ re && $4 ~ /^[-abps]$/ {
+      printf "%s{\"t\":%d,\"ip\":\"%s\",\"q\":%d,\"v\":\"%s\",\"d\":\"%s\"}", (i++ ? "," : ""), $1, $2, $3, $4, $5 }
+    END { printf "]}\n" }'
+}
+
+reset() {
+  rm -f "$RUN/hits" "$REC" "$J/counters"
+  echo "SINCE $(date +%s)" > "$CTR"
+  log "Wallguard counters reset by the operator"
+}
+
+mkdir -p "$D"
+case "$1" in
+  update) update ;;
+  build) build ;;
+  fold) fold ;;
+  stats) stats ;;
+  unbreak) unbreak "$2" "$3" ;;
+  live) live ;;
+  reset) reset ;;
+  safe) safesearch ;;
+  restore) restore ;;
+  *) echo "usage: $0 update|build|fold|stats|unbreak <dev> <min>|live|reset|safe|restore" >&2; exit 2 ;;
+esac
diff --git a/release/src/router/wallguard/wallguard_db.h b/release/src/router/wallguard/wallguard_db.h
new file mode 100644
index 0000000000..d4ee23a550
--- /dev/null
+++ b/release/src/router/wallguard/wallguard_db.h
@@ -0,0 +1,256 @@
+// SPDX-License-Identifier: GPL-2.0-only
+// Copyright (C) 2026 the Reaper project maintainer
+// Part of the Reaper hardened Asuswrt-Merlin build. See LICENSE / LICENSE.reaper.
+/*
+ * wallguard_db.h - the Wallguard block table (2026-10-21).
+ *
+ * ONE file format, shared by the compiler (release/src/router/wallguard/wallguardc.c) and the
+ * engine inside dnsmasq (release/src/router/dnsmasq/src/wallguard.c). The two copies of this
+ * header must stay byte-identical; build-scripts/tests/test_wallguard.py checks that.
+ *
+ * Layout (host byte order - built and read on the same router; 8-byte aligned):
+ *   struct wallguard_hdr
+ *   uint64_t block_hash[nblock]   sorted ascending
+ *   uint32_t block_mask[nblock]   list bits; WALLGUARD_SUBTREE = the entry covers subdomains
+ *   (pad to 8)
+ *   uint64_t allow_hash[nallow]   sorted ascending
+ *   uint32_t allow_flag[nallow]   WALLGUARD_SUBTREE or 0
+ *
+ * A name is hashed lowercased, without a trailing dot (64-bit FNV-1a). A lookup walks the
+ * name's label suffixes, full name first: an allow entry that matches (the full name, or a
+ * parent whose entry covers subdomains) allows the name outright; block entries that match
+ * the same way OR their list bits together. The caller blocks when those bits meet the
+ * asking device's profile mask. Bit 0 is "My rules"; bits 1..30 are subscribed lists.
+ */
+#ifndef WALLGUARD_DB_H
+#define WALLGUARD_DB_H
+
+#include <stdint.h>
+#include <string.h>
+#include <time.h>
+#include <fcntl.h>
+#include <unistd.h>
+#include <sys/types.h>
+#include <sys/stat.h>
+#include <sys/mman.h>
+
+#define WALLGUARD_MAGIC		"SHRD"
+#define WALLGUARD_VERSION		1
+#define WALLGUARD_LISTS		31		/* bits 0..30 */
+#define WALLGUARD_LISTNAME		24
+#define WALLGUARD_SUBTREE		0x80000000u
+#define WALLGUARD_BITS		0x7fffffffu
+#define WALLGUARD_MAX_NAMES	1000000u
+#define WALLGUARD_NAME_MAX		253
+
+struct wallguard_hdr {
+	char magic[4];				/* "SHRD" */
+	uint32_t version;			/* WALLGUARD_VERSION */
+	uint32_t nblock;
+	uint32_t nallow;
+	uint32_t nlists;			/* list names present (<= WALLGUARD_LISTS) */
+	uint32_t flags;				/* reserved, 0 */
+	uint64_t built;				/* epoch */
+	char lists[WALLGUARD_LISTS][WALLGUARD_LISTNAME];	/* index = bit; "" = unused */
+	uint32_t pad[2];
+};						/* 784 bytes */
+
+struct wallguard_view {
+	const struct wallguard_hdr *h;
+	const uint64_t *bhash;
+	const uint32_t *bmask;
+	const uint64_t *ahash;
+	const uint32_t *aflag;
+	uint32_t nblock, nallow;
+};
+
+#define WALLGUARD_ALIGN8(x)	(((x) + 7u) & ~(size_t)7u)
+
+static inline size_t wallguard_size(uint32_t nblock, uint32_t nallow)
+{
+	size_t s = sizeof(struct wallguard_hdr);
+	s += (size_t)nblock * 8u + (size_t)nblock * 4u;
+	s = WALLGUARD_ALIGN8(s);
+	s += (size_t)nallow * 8u + (size_t)nallow * 4u;
+	return s;
+}
+
+/* 0 = a well-formed table of exactly len bytes; the view then points into it */
+static inline int wallguard_view_of(const void *base, size_t len, struct wallguard_view *v)
+{
+	const struct wallguard_hdr *h = (const struct wallguard_hdr *)base;
+	const unsigned char *p = (const unsigned char *)base;
+	size_t off;
+
+	if (!base || len < sizeof(*h) || memcmp(h->magic, WALLGUARD_MAGIC, 4) || h->version != WALLGUARD_VERSION)
+		return -1;
+	if (h->nblock > WALLGUARD_MAX_NAMES || h->nallow > WALLGUARD_MAX_NAMES || h->nlists > WALLGUARD_LISTS)
+		return -1;
+	if (wallguard_size(h->nblock, h->nallow) != len)
+		return -1;
+	off = sizeof(*h);
+	v->h = h;
+	v->nblock = h->nblock;
+	v->nallow = h->nallow;
+	v->bhash = (const uint64_t *)(p + off);
+	off += (size_t)h->nblock * 8u;
+	v->bmask = (const uint32_t *)(p + off);
+	off = WALLGUARD_ALIGN8(off + (size_t)h->nblock * 4u);
+	v->ahash = (const uint64_t *)(p + off);
+	off += (size_t)h->nallow * 8u;
+	v->aflag = (const uint32_t *)(p + off);
+	return 0;
+}
+
+/* FNV-1a 64 over the lowercased bytes [s, s+n) */
+static inline uint64_t wallguard_hash(const char *s, size_t n)
+{
+	uint64_t h = 0xcbf29ce484222325ull;
+	size_t i;
+
+	for (i = 0; i < n; i++) {
+		unsigned char c = (unsigned char)s[i];
+		if (c >= 'A' && c <= 'Z')
+			c += 32;
+		h ^= c;
+		h *= 0x100000001b3ull;
+	}
+	return h;
+}
+
+/* index of key in a sorted array, or -1 */
+static inline long wallguard_find(const uint64_t *a, uint32_t n, uint64_t key)
+{
+	uint32_t lo = 0, hi = n;
+
+	while (lo < hi) {
+		uint32_t mid = lo + (hi - lo) / 2;
+		if (a[mid] < key)
+			lo = mid + 1;
+		else
+			hi = mid;
+	}
+	return (lo < n && a[lo] == key) ? (long)lo : -1;
+}
+
+#define WALLGUARD_PASS	0
+#define WALLGUARD_ALLOWED	1	/* an allow entry decided it */
+#define WALLGUARD_LISTED	2	/* *bits holds the list bits that match */
+
+/* The one label walk (review 2026-10-24, Q-A-9: Wallguard's lookup, Dreadwatch's and `wallguardc explain`
+   each had their own copy). Walks the name's label suffixes, full name first (trailing dots ignored):
+   an allow entry that matches allows the name outright; block entries that match either OR their
+   bits together (longest = 0: Wallguard - a name on two lists is on both) or stop at the first, longest
+   one (longest = 1: Dreadwatch - that entry names the hit). *at, when asked for, receives the listed
+   suffix that decided - the shortest one for longest = 0 - pointing into name, or name itself when
+   nothing did; *len its length. Records carry that entry rather than the query (S-A-1: the query name
+   is the asker's to invent, so a device could grow the counters without bound). */
+static inline int wallguard_walk(const struct wallguard_view *v, const char *name, uint32_t *bits,
+			      const char **at, size_t *len, int longest)
+{
+	size_t n = strlen(name);
+	const char *s = name;
+	int first = 1;
+	uint32_t acc = 0;
+
+	*bits = 0;
+	if (at)
+		*at = name;
+	if (len)
+		*len = 0;
+	if (!v || !v->h)
+		return WALLGUARD_PASS;
+	while (n && name[n - 1] == '.')
+		n--;
+	while (n > 0) {
+		uint64_t h = wallguard_hash(s, n);
+		long i;
+
+		if ((i = wallguard_find(v->ahash, v->nallow, h)) >= 0 && (first || (v->aflag[i] & WALLGUARD_SUBTREE)))
+			return WALLGUARD_ALLOWED;
+		if ((i = wallguard_find(v->bhash, v->nblock, h)) >= 0 && (first || (v->bmask[i] & WALLGUARD_SUBTREE))) {
+			acc |= v->bmask[i] & WALLGUARD_BITS;
+			if (at)
+				*at = s;
+			if (len)
+				*len = n;
+			if (longest)
+				break;
+		}
+		/* next label suffix */
+		{
+			const char *dot = memchr(s, '.', n);
+			if (!dot)
+				break;
+			n -= (size_t)(dot + 1 - s);
+			s = dot + 1;
+		}
+		first = 0;
+	}
+	*bits = acc;
+	return acc ? WALLGUARD_LISTED : WALLGUARD_PASS;
+}
+
+static inline int wallguard_lookup_at(const struct wallguard_view *v, const char *name, uint32_t *bits, const char **at)
+{
+	return wallguard_walk(v, name, bits, at, NULL, 0);
+}
+
+static inline int wallguard_lookup(const struct wallguard_view *v, const char *name, uint32_t *bits)
+{
+	return wallguard_walk(v, name, bits, NULL, NULL, 0);
+}
+
+/* A mapped table that a reader keeps and refreshes (Q-A-9: dnsmasq's Wallguard engine, its Dreadwatch
+   judge and wallguardc each had their own mapper). Tables are only ever replaced by rename, so a new
+   inode or mtime means a new table; the old mapping is dropped only once the new one is in place. */
+struct wallguard_table {
+	void *base;
+	size_t len;
+	struct wallguard_view v;
+	int ok;				/* the mapped table is well-formed */
+	time_t mtime;
+	ino_t ino;
+};
+
+static inline void wallguard_table_drop(struct wallguard_table *t)
+{
+	if (t->base && t->base != MAP_FAILED)
+		munmap(t->base, t->len);
+	t->base = NULL;
+	t->ok = 0;
+}
+
+/* 0 = unchanged (or still absent), 1 = (re)mapped - t->ok says whether it is well-formed,
+   -1 = a table that was mapped is gone (now dropped) */
+static inline int wallguard_table_refresh(struct wallguard_table *t, const char *path)
+{
+	struct stat st;
+	void *b;
+	int fd = open(path, O_RDONLY | O_CLOEXEC);
+
+	if (fd == -1) {
+		int had = t->base != NULL;
+		wallguard_table_drop(t);
+		t->mtime = 0;
+		return had ? -1 : 0;
+	}
+	if (fstat(fd, &st) == -1 || st.st_size <= 0 ||
+	    (st.st_mtime == t->mtime && st.st_ino == t->ino && t->base)) {
+		close(fd);
+		return 0;
+	}
+	b = mmap(NULL, (size_t)st.st_size, PROT_READ, MAP_SHARED, fd, 0);
+	close(fd);
+	if (b == MAP_FAILED)
+		return 0;
+	wallguard_table_drop(t);
+	t->base = b;
+	t->len = (size_t)st.st_size;
+	t->mtime = st.st_mtime;
+	t->ino = st.st_ino;
+	t->ok = wallguard_view_of(b, t->len, &t->v) == 0;
+	return 1;
+}
+
+#endif
diff --git a/release/src/router/wallguard/wallguardc.c b/release/src/router/wallguard/wallguardc.c
new file mode 100644
index 0000000000..eaf317c925
--- /dev/null
+++ b/release/src/router/wallguard/wallguardc.c
@@ -0,0 +1,730 @@
+// SPDX-License-Identifier: GPL-2.0-only
+// Copyright (C) 2026 the Reaper project maintainer
+// Part of the Reaper hardened Asuswrt-Merlin build. See LICENSE / LICENSE.reaper.
+/*
+ * wallguardc - the Wallguard list compiler (2026-10-21).
+ *
+ * Turns downloaded block lists, the operator's own rules and the safety allow-set into the
+ * one table every dnsmasq instance maps (wallguard_db.h). Run by the updater rc generates
+ * (/tmp/wallguard/wallguard.sh) and by httpd for "Why?".
+ *
+ *   wallguardc build --out DB [--stats JSON] [--rules FILE]... [--allow FILE]...
+ *                 [--list BIT:ID:FILE]... [--kfile FILE --kids "ID ID ..."]
+ *     --kfile: Dreadwatch's "<feeds> <name>" list (feeds = comma-joined ids, "-" = other);
+ *              bit = the id's position in --kids (1-based)
+ *   wallguardc explain --db DB [--mask HEX] NAME
+ *   wallguardc check --db DB
+ *   wallguardc resolve NAME...      (phase 2: safe search) "NAME v4|v6 ADDRESS" per address
+ *
+ * Accepted line formats (anything else is counted as unsupported, never guessed at):
+ *   hosts           0.0.0.0 name [name...]   (any IPv4/IPv6 literal first)   exact names
+ *   plain           name                                                     exact
+ *   wildcard        *.name                                                   name + subdomains
+ *   AdGuard/ABP     ||name^   ||name^$important                              name + subdomains
+ *                   @@||name^                                                allow, + subdomains
+ *   dnsmasq         address=/a/b/[0.0.0.0|::|#]  server=/a/  local=/a/       name + subdomains
+ * Comments (# ! [) and blank lines are skipped. --rules lines are names (+ subdomains) in any
+ * of the forms above; --allow lines likewise become allow entries.
+ *
+ * The table holds at most WALLGUARD_MAX_NAMES distinct names. When the lists together hold
+ * more, the operator's rules and the earlier lists win: names only later lists carry are
+ * dropped, and each list reports how many of its names did not fit.
+ */
+#define _GNU_SOURCE
+#include <ctype.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/mman.h>
+#include <sys/stat.h>
+#include <time.h>
+#include <unistd.h>
+#include <arpa/inet.h>
+#include <netdb.h>
+#include <sys/socket.h>
+
+#include "wallguard_db.h"
+
+#define RAW_MAX		4000000u	/* entries read before reading stops (memory bound) */
+#define LINE_MAX_	4096
+
+struct ent {
+	uint64_t h;
+	uint32_t m;
+	uint8_t pri;		/* source order: 0 = rules, 1.. = lists in order */
+	uint8_t pad[3];
+};
+
+struct src {
+	int bit, pri;
+	char id[WALLGUARD_LISTNAME];
+	const char *file;
+	unsigned long lines, names, unsupported, invalid, allows, unique, capped;
+	int missing;
+};
+
+static struct ent *blk, *alw;
+static size_t nblk, cblk, nalw, calw;
+static int raw_full;
+
+static void *xrealloc(void *p, size_t n)
+{
+	void *q = realloc(p, n);
+	if (!q) {
+		fprintf(stderr, "wallguardc: out of memory\n");
+		exit(2);
+	}
+	return q;
+}
+
+static void push(struct ent **a, size_t *n, size_t *cap, uint64_t h, uint32_t m, int pri)
+{
+	if (*n + nalw + nblk >= RAW_MAX * 2u) {	/* never reached unless RAW_MAX is */
+		raw_full = 1;
+		return;
+	}
+	if (*n == *cap) {
+		*cap = *cap ? *cap * 2 : 65536;
+		*a = xrealloc(*a, *cap * sizeof(**a));
+	}
+	(*a)[*n].h = h;
+	(*a)[*n].m = m;
+	(*a)[*n].pri = (uint8_t)pri;
+	(*n)++;
+}
+
+/* Normalise a host name in place: lowercase, no trailing dot, labels 1-63 of
+   [a-z0-9_-], 4..253 characters, at least one dot. 0 = valid. */
+static int norm(char *s)
+{
+	size_t n = strlen(s), lab = 0, i;
+	int dots = 0;
+
+	if (n && s[n - 1] == '.')
+		s[--n] = 0;
+	if (n < 3 || n > WALLGUARD_NAME_MAX)
+		return -1;
+	for (i = 0; i < n; i++) {
+		unsigned char c = (unsigned char)s[i];
+		if (c >= 'A' && c <= 'Z')
+			s[i] = (char)(c += 32);
+		if (c == '.') {
+			if (lab == 0)
+				return -1;
+			lab = 0;
+			dots++;
+			continue;
+		}
+		if (!((c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == '-' || c == '_'))
+			return -1;
+		if (++lab > 63)
+			return -1;
+	}
+	if (lab == 0 || dots == 0)
+		return -1;
+	if (!strcmp(s, "localhost.localdomain") || !strcmp(s, "local.domain"))
+		return -1;
+	return 0;
+}
+
+static int is_ip(const char *t)
+{
+	unsigned char b[16];
+	return inet_pton(AF_INET, t, b) == 1 || inet_pton(AF_INET6, t, b) == 1 || !strcmp(t, "0");
+}
+
+enum { L_SKIP, L_NAMES, L_UNSUP };
+
+/* Parse one line into up to 64 names. *subtree / *allow describe all of them. */
+static int parse_line(char *line, char **names, int *nn, int *subtree, int *allow)
+{
+	char *p = line, *e, *tok, *save;
+	int k = 0;
+
+	*nn = 0;
+	*subtree = 0;
+	*allow = 0;
+	while (*p == ' ' || *p == '\t')
+		p++;
+	e = p + strlen(p);
+	while (e > p && (e[-1] == '\n' || e[-1] == '\r' || e[-1] == ' ' || e[-1] == '\t'))
+		*--e = 0;
+	if (!*p || *p == '#' || *p == '!' || *p == '[')
+		return L_SKIP;
+
+	if (!strncmp(p, "@@||", 4) || !strncmp(p, "||", 2)) {
+		char *caret;
+		*allow = p[0] == '@';
+		p += *allow ? 4 : 2;
+		if (!(caret = strchr(p, '^')))
+			return L_UNSUP;
+		*caret = 0;
+		if (caret[1] && strcmp(caret + 1, "$important") && strcmp(caret + 1, "|"))
+			return L_UNSUP;		/* $client, $dnstype, paths ... not ours to guess */
+		if (strpbrk(p, "*/|$"))
+			return L_UNSUP;
+		*subtree = 1;
+		names[(*nn)++] = p;
+		return L_NAMES;
+	}
+	if (!strncmp(p, "address=/", 9) || !strncmp(p, "server=/", 8) || !strncmp(p, "local=/", 7)) {
+		char *last;
+		p = strchr(p, '/') + 1;
+		if (!(last = strrchr(p, '/')))
+			return L_UNSUP;
+		if (last[1] && strcmp(last + 1, "0.0.0.0") && strcmp(last + 1, "::") && strcmp(last + 1, "#"))
+			return L_UNSUP;		/* an address= that answers with a real address */
+		*last = 0;
+		*subtree = 1;
+		for (tok = strtok_r(p, "/", &save); tok && k < 64; tok = strtok_r(NULL, "/", &save))
+			names[k++] = tok;
+		*nn = k;
+		return k ? L_NAMES : L_UNSUP;
+	}
+	/* hosts / plain: a comment starts at a # after whitespace; a # inside a token is an
+	   element-hiding rule (example.com##.banner, #@#, #?#), not a name */
+	for (e = p; (e = strchr(e, '#')); e++)
+		if (e > p && (e[-1] == ' ' || e[-1] == '\t')) {
+			*e = 0;
+			break;
+		} else if (e > p)
+			return L_UNSUP;
+	tok = strtok_r(p, " \t", &save);
+	if (!tok)
+		return L_SKIP;
+	if (is_ip(tok)) {
+		for (tok = strtok_r(NULL, " \t", &save); tok && k < 64; tok = strtok_r(NULL, " \t", &save))
+			names[k++] = tok;
+		*nn = k;
+		return k ? L_NAMES : L_SKIP;
+	}
+	if (strtok_r(NULL, " \t", &save))
+		return L_UNSUP;
+	if (!strncmp(tok, "*.", 2)) {
+		tok += 2;
+		*subtree = 1;
+	}
+	if (strpbrk(tok, "*/|$^"))
+		return L_UNSUP;
+	names[(*nn)++] = tok;
+	return L_NAMES;
+}
+
+/* rules = 1: every name is a block (or allow, for --allow) covering subdomains */
+static void read_src(struct src *s, int rules, int force_allow)
+{
+	FILE *f = fopen(s->file, "r");
+	char line[LINE_MAX_];
+
+	if (!f) {
+		s->missing = 1;
+		return;
+	}
+	while (fgets(line, sizeof(line), f)) {
+		char *names[64];
+		int nn, subtree, allow, r, i;
+
+		if (!strchr(line, '\n') && !feof(f)) {	/* an over-long line: drop the rest of it */
+			int c;
+			while ((c = fgetc(f)) != EOF && c != '\n')
+				;
+			s->lines++;
+			s->unsupported++;
+			continue;
+		}
+		s->lines++;
+		r = parse_line(line, names, &nn, &subtree, &allow);
+		if (r == L_SKIP)
+			continue;
+		if (r == L_UNSUP) {
+			s->unsupported++;
+			continue;
+		}
+		if (rules || force_allow)
+			subtree = 1;
+		if (force_allow)
+			allow = 1;
+		for (i = 0; i < nn; i++) {
+			uint64_t h;
+			if (norm(names[i])) {
+				s->invalid++;
+				continue;
+			}
+			h = wallguard_hash(names[i], strlen(names[i]));
+			if (allow) {
+				push(&alw, &nalw, &calw, h, subtree ? WALLGUARD_SUBTREE : 0, s->pri);
+				s->allows++;
+			} else {
+				if (nblk >= RAW_MAX) {
+					raw_full = 1;
+					s->capped++;
+					continue;
+				}
+				push(&blk, &nblk, &cblk, h, (1u << s->bit) | (subtree ? WALLGUARD_SUBTREE : 0), s->pri);
+				s->names++;
+			}
+		}
+	}
+	fclose(f);
+}
+
+/* review 2026-10-24 (Q-A-3b): Dreadwatch's "<feeds> <name>" list read directly - feeds a comma list of
+   ids ("-" = none: the "other" id), one entry per named feed exactly as the per-feed --list files the
+   shell used to split out would give (an id not in --kids is skipped, as those files were never passed).
+   kid[0..nk) are the sources for the ids, in --kids order (bit = position + 1). */
+static void read_kfile(const char *file, struct src *kid, int nk, int all_sub)
+{
+	FILE *f = fopen(file, "r");
+	char line[LINE_MAX_];
+
+	if (!f) {
+		if (nk)
+			kid[0].missing = 1;
+		return;
+	}
+	while (fgets(line, sizeof(line), f)) {
+		char *sp, *name, *feeds, *id, *save;
+		uint64_t h;
+		size_t n = strlen(line);
+		int k;
+
+		if (!nk)
+			break;
+		kid[0].lines++;
+		if (n && line[n - 1] != '\n' && !feof(f)) {	/* an over-long line: drop the rest of it */
+			int c;
+			while ((c = fgetc(f)) != EOF && c != '\n')
+				;
+			kid[0].unsupported++;
+			continue;
+		}
+		while (n && (line[n - 1] == '\n' || line[n - 1] == '\r'))
+			line[--n] = 0;
+		if (!n)
+			continue;
+		if (!(sp = strchr(line, ' ')) || strchr(sp + 1, ' ')) {
+			kid[0].unsupported++;
+			continue;
+		}
+		*sp = 0;
+		feeds = line;
+		name = sp + 1;
+		if (norm(name)) {
+			kid[0].invalid++;
+			continue;
+		}
+		h = wallguard_hash(name, strlen(name));
+		if (!strcmp(feeds, "-"))
+			feeds = "other";
+		for (id = strtok_r(feeds, ",", &save); id; id = strtok_r(NULL, ",", &save)) {
+			for (k = 0; k < nk && strcmp(kid[k].id, id); k++)
+				;
+			if (k == nk)
+				continue;
+			if (nblk >= RAW_MAX) {
+				raw_full = 1;
+				kid[k].capped++;
+				continue;
+			}
+			push(&blk, &nblk, &cblk, h, (1u << kid[k].bit) | (all_sub ? WALLGUARD_SUBTREE : 0), kid[k].pri);
+			kid[k].names++;
+		}
+	}
+	fclose(f);
+}
+
+static int cmp_h(const void *a, const void *b)
+{
+	const struct ent *x = a, *y = b;
+	return x->h < y->h ? -1 : x->h > y->h;
+}
+
+static int cmp_pri(const void *a, const void *b)
+{
+	const struct ent *x = a, *y = b;
+	if (x->pri != y->pri)
+		return x->pri < y->pri ? -1 : 1;
+	return x->h < y->h ? -1 : x->h > y->h;
+}
+
+/* sort by hash and merge duplicates: masks OR together, pri = the earliest source */
+static size_t merge(struct ent *a, size_t n)
+{
+	size_t i, o = 0;
+
+	if (!n)
+		return 0;
+	qsort(a, n, sizeof(*a), cmp_h);
+	for (i = 1; i < n; i++) {
+		if (a[i].h == a[o].h) {
+			a[o].m |= a[i].m;
+			if (a[i].pri < a[o].pri)
+				a[o].pri = a[i].pri;
+		} else
+			a[++o] = a[i];
+	}
+	return o + 1;
+}
+
+static void json_str(FILE *f, const char *s)
+{
+	fputc('"', f);
+	for (; *s; s++) {
+		unsigned char c = (unsigned char)*s;
+		if (c == '"' || c == '\\')
+			fprintf(f, "\\%c", c);
+		else if (c < 0x20 || c > 0x7e)
+			fprintf(f, "\\u%04x", c);
+		else
+			fputc(c, f);
+	}
+	fputc('"', f);
+}
+
+static int write_db(const char *out, struct src *srcs, int nsrc)
+{
+	char tmp[4096];
+	struct wallguard_hdr h;
+	FILE *f;
+	size_t i;
+	int k;
+	static const char zero[8];
+	size_t off;
+
+	/* per process: two builds at once must not share (and truncate) one temp inode (review 2026-10-21) */
+	if (snprintf(tmp, sizeof(tmp), "%s.%d.tmp", out, (int)getpid()) >= (int)sizeof(tmp))
+		return -1;
+	memset(&h, 0, sizeof(h));
+	memcpy(h.magic, WALLGUARD_MAGIC, 4);
+	h.version = WALLGUARD_VERSION;
+	h.nblock = (uint32_t)nblk;
+	h.nallow = (uint32_t)nalw;
+	h.built = (uint64_t)time(NULL);
+	for (k = 0; k < nsrc; k++)
+		if (srcs[k].bit >= 0 && srcs[k].bit < WALLGUARD_LISTS) {
+			memcpy(h.lists[srcs[k].bit], srcs[k].id, WALLGUARD_LISTNAME - 1);
+			h.nlists++;
+		}
+	if (!(f = fopen(tmp, "wb")))
+		return -1;
+	fwrite(&h, sizeof(h), 1, f);
+	for (i = 0; i < nblk; i++)
+		fwrite(&blk[i].h, 8, 1, f);
+	for (i = 0; i < nblk; i++)
+		fwrite(&blk[i].m, 4, 1, f);
+	off = sizeof(h) + nblk * 12u;
+	fwrite(zero, 1, WALLGUARD_ALIGN8(off) - off, f);
+	for (i = 0; i < nalw; i++)
+		fwrite(&alw[i].h, 8, 1, f);
+	for (i = 0; i < nalw; i++)
+		fwrite(&alw[i].m, 4, 1, f);
+	if (fflush(f) || ferror(f) || fsync(fileno(f))) {
+		fclose(f);
+		unlink(tmp);
+		return -1;
+	}
+	fclose(f);
+	chmod(tmp, 0644);
+	return rename(tmp, out);
+}
+
+static int cmd_build(int argc, char **argv)
+{
+	struct src srcs[WALLGUARD_LISTS + 16];
+	const char *out = NULL, *stats = NULL, *kfile = NULL;
+	char kids[WALLGUARD_LISTS * WALLGUARD_LISTNAME];
+	int nsrc = 0, i, k, all_sub = 0, used[WALLGUARD_LISTS] = { 0 }, kfirst = -1, nk = 0;
+	size_t cap = WALLGUARD_MAX_NAMES;
+
+	if (getenv("WALLGUARD_MAX_NAMES"))		/* tests only: exercise the cap cheaply */
+		cap = strtoul(getenv("WALLGUARD_MAX_NAMES"), NULL, 10);
+	memset(srcs, 0, sizeof(srcs));
+	for (i = 2; i < argc; i++) {
+		struct src *s = &srcs[nsrc];
+		if (!strcmp(argv[i], "--subtree")) {	/* 2026-10-24 (Dreadwatch): a plain name covers its subdomains */
+			all_sub = 1;
+			continue;
+		}
+		if (i + 1 >= argc)
+			goto usage;
+		if (!strcmp(argv[i], "--out"))
+			out = argv[++i];
+		else if (!strcmp(argv[i], "--stats"))
+			stats = argv[++i];
+		else if (!strcmp(argv[i], "--rules") || !strcmp(argv[i], "--allow")) {
+			if (nsrc >= (int)(sizeof(srcs) / sizeof(srcs[0])))
+				goto usage;
+			s->bit = !strcmp(argv[i], "--rules") ? 0 : -1;	/* -1 = allow-only source */
+			s->pri = 0;
+			snprintf(s->id, sizeof(s->id), "%s", s->bit == 0 ? "rules" : "allow");
+			s->file = argv[++i];
+			nsrc++;
+		} else if (!strcmp(argv[i], "--list")) {
+			char *spec = argv[++i], *c1, *c2;
+			int bit;
+			if (nsrc >= (int)(sizeof(srcs) / sizeof(srcs[0])))
+				goto usage;
+			if (!(c1 = strchr(spec, ':')) || !(c2 = strchr(c1 + 1, ':')))
+				goto usage;
+			bit = atoi(spec);
+			if (bit < 1 || bit >= WALLGUARD_LISTS || used[bit] || c2 - c1 - 1 <= 0 || c2 - c1 - 1 >= WALLGUARD_LISTNAME)
+				goto usage;
+			used[bit] = 1;
+			s->bit = bit;
+			memcpy(s->id, c1 + 1, (size_t)(c2 - c1 - 1));
+			s->file = c2 + 1;
+			nsrc++;
+		} else if (!strcmp(argv[i], "--kfile"))
+			kfile = argv[++i];
+		else if (!strcmp(argv[i], "--kids")) {	/* the ids of a --kfile, in bit order (bit = position) */
+			char *id, *save;
+			if (kfirst >= 0 || snprintf(kids, sizeof(kids), "%s", argv[++i]) >= (int)sizeof(kids))
+				goto usage;
+			kfirst = nsrc;
+			for (id = strtok_r(kids, " ", &save); id; id = strtok_r(NULL, " ", &save)) {
+				int bit = nk + 1;
+				if (nsrc >= (int)(sizeof(srcs) / sizeof(srcs[0])) || bit >= WALLGUARD_LISTS || used[bit] ||
+				    strlen(id) >= WALLGUARD_LISTNAME)
+					goto usage;
+				used[bit] = 1;
+				srcs[nsrc].bit = bit;
+				memcpy(srcs[nsrc].id, id, strlen(id));
+				srcs[nsrc].file = NULL;
+				nsrc++;
+				nk++;
+			}
+		} else
+			goto usage;
+	}
+	if (!out || (!kfile) != (kfirst < 0))
+		goto usage;
+	/* sources in order: rules/allow first, then lists as given */
+	{
+		int pri = 1;
+		for (k = 0; k < nsrc; k++)
+			srcs[k].pri = srcs[k].bit >= 1 ? pri++ : 0;
+	}
+	for (k = 0; k < nsrc; k++)
+		if (srcs[k].file)
+			read_src(&srcs[k], srcs[k].bit == 0 || all_sub, srcs[k].bit == -1);
+	if (kfile) {
+		read_kfile(kfile, &srcs[kfirst], nk, all_sub);
+		/* an id with no names is left out of the header, as its empty --list file was never passed */
+		for (k = kfirst; k < kfirst + nk; k++)
+			if (!srcs[k].names && !srcs[k].capped)
+				srcs[k].bit = -2;
+	}
+
+	nalw = merge(alw, nalw);
+	nblk = merge(blk, nblk);
+	for (k = 0; k < nsrc; k++) {	/* unique contribution = names whose earliest source it is */
+		size_t j;
+		for (j = 0; j < nblk; j++)
+			if (blk[j].pri == srcs[k].pri && srcs[k].bit >= 0 && (blk[j].m & (1u << srcs[k].bit)))
+				srcs[k].unique++;
+	}
+	if (nblk > cap) {		/* keep the earliest sources' names */
+		size_t j;
+		qsort(blk, nblk, sizeof(*blk), cmp_pri);
+		for (j = cap; j < nblk; j++)
+			for (k = 0; k < nsrc; k++)
+				if (srcs[k].pri == blk[j].pri && srcs[k].bit >= 0) {
+					srcs[k].capped++;
+					srcs[k].unique--;
+					break;
+				}
+		nblk = cap;
+		qsort(blk, nblk, sizeof(*blk), cmp_h);
+	}
+	if (write_db(out, srcs, nsrc)) {
+		fprintf(stderr, "wallguardc: cannot write %s: %s\n", out, strerror(errno));
+		return 1;
+	}
+	if (stats) {
+		char tmp[4096];
+		FILE *f;
+		snprintf(tmp, sizeof(tmp), "%s.%d.tmp", stats, (int)getpid());
+		if ((f = fopen(tmp, "w"))) {
+			fprintf(f, "{\"built\":%ld,\"names\":%lu,\"allow\":%lu,\"full\":%d,\"sources\":[",
+				(long)time(NULL), (unsigned long)nblk, (unsigned long)nalw, raw_full || nblk >= cap);
+			for (k = 0; k < nsrc; k++) {
+				fprintf(f, "%s{\"bit\":%d,\"id\":", k ? "," : "", srcs[k].bit);
+				json_str(f, srcs[k].id);
+				fprintf(f, ",\"missing\":%d,\"lines\":%lu,\"names\":%lu,\"unique\":%lu,\"allows\":%lu,"
+					"\"unsupported\":%lu,\"invalid\":%lu,\"capped\":%lu}",
+					srcs[k].missing, srcs[k].lines, srcs[k].names, srcs[k].unique, srcs[k].allows,
+					srcs[k].unsupported, srcs[k].invalid, srcs[k].capped);
+			}
+			fprintf(f, "]}\n");
+			fclose(f);
+			rename(tmp, stats);
+		}
+	}
+	return 0;
+usage:
+	fprintf(stderr, "usage: wallguardc build [--subtree] --out DB [--stats JSON] [--rules F]... [--allow F]... [--list BIT:ID:F]...\n"
+			"                     [--kfile F --kids \"ID ID ...\"]\n");
+	return 2;
+}
+
+/* review 2026-10-24 (Q-A-9): the mapper is wallguard_db.h's, the one dnsmasq uses */
+static int map_db(const char *path, struct wallguard_view *v, void **base, size_t *len)
+{
+	struct wallguard_table t;
+
+	memset(&t, 0, sizeof(t));
+	if (wallguard_table_refresh(&t, path) != 1 || !t.ok) {
+		wallguard_table_drop(&t);
+		return -1;
+	}
+	*v = t.v;
+	*base = t.base;
+	*len = t.len;
+	return 0;
+}
+
+static int cmd_explain(int argc, char **argv)
+{
+	const char *db = NULL, *name = NULL;
+	uint32_t mask = WALLGUARD_BITS, bits = 0;
+	struct wallguard_view v;
+	void *base;
+	size_t len, n;
+	char nm[WALLGUARD_NAME_MAX + 2];
+	const char *s;
+	int i, r, first = 1, any = 0;
+
+	for (i = 2; i < argc; i++) {
+		if (!strcmp(argv[i], "--db") && i + 1 < argc)
+			db = argv[++i];
+		else if (!strcmp(argv[i], "--mask") && i + 1 < argc)
+			mask = (uint32_t)strtoul(argv[++i], NULL, 16) & WALLGUARD_BITS;
+		else
+			name = argv[i];
+	}
+	if (!db || !name || strlen(name) > WALLGUARD_NAME_MAX) {
+		fprintf(stderr, "usage: wallguardc explain --db DB [--mask HEX] NAME\n");
+		return 2;
+	}
+	snprintf(nm, sizeof(nm), "%s", name);
+	if (norm(nm)) {
+		printf("{\"ok\":0,\"error\":\"not a host name\"}\n");
+		return 1;
+	}
+	if (map_db(db, &v, &base, &len)) {
+		printf("{\"ok\":0,\"error\":\"no block table\"}\n");
+		return 1;
+	}
+	r = wallguard_lookup(&v, nm, &bits);
+	printf("{\"ok\":1,\"name\":");
+	json_str(stdout, nm);
+	printf(",\"verdict\":\"%s\",\"bits\":%u,\"mask\":%u,\"lists\":[",
+	       r == WALLGUARD_ALLOWED ? "allowed" : (r == WALLGUARD_LISTED && (bits & mask)) ? "blocked" : "pass",
+	       bits, mask);
+	for (i = 0; i < WALLGUARD_LISTS; i++)
+		if (bits & (1u << i)) {
+			printf("%s", any++ ? "," : "");
+			json_str(stdout, v.h->lists[i][0] ? v.h->lists[i] : (i == 0 ? "rules" : "?"));
+		}
+	printf("],\"steps\":[");
+	for (s = nm, n = strlen(nm); n > 0; first = 0) {
+		uint64_t h = wallguard_hash(s, n);
+		long a = wallguard_find(v.ahash, v.nallow, h), b = wallguard_find(v.bhash, v.nblock, h);
+		char part[WALLGUARD_NAME_MAX + 1];
+		const char *dot;
+		memcpy(part, s, n);
+		part[n] = 0;
+		printf("%s{\"suffix\":", first ? "" : ",");
+		json_str(stdout, part);
+		printf(",\"allow\":%d,\"allow_sub\":%d,\"block\":%u,\"block_sub\":%d}",
+		       a >= 0, a >= 0 && (v.aflag[a] & WALLGUARD_SUBTREE) ? 1 : 0,
+		       b >= 0 ? (v.bmask[b] & WALLGUARD_BITS) : 0u, b >= 0 && (v.bmask[b] & WALLGUARD_SUBTREE) ? 1 : 0);
+		if (!(dot = memchr(s, '.', n)))
+			break;
+		n -= (size_t)(dot + 1 - s);
+		s = dot + 1;
+	}
+	printf("],\"built\":%llu}\n", (unsigned long long)v.h->built);
+	munmap(base, len);
+	return 0;
+}
+
+static int cmd_check(int argc, char **argv)
+{
+	struct wallguard_view v;
+	void *base;
+	size_t len;
+	uint32_t i;
+
+	if (argc != 4 || strcmp(argv[2], "--db"))
+		return 2;
+	if (map_db(argv[3], &v, &base, &len)) {
+		printf("{\"ok\":0}\n");
+		return 1;
+	}
+	for (i = 1; i < v.nblock; i++)
+		if (v.bhash[i - 1] >= v.bhash[i])
+			goto bad;
+	for (i = 1; i < v.nallow; i++)
+		if (v.ahash[i - 1] >= v.ahash[i])
+			goto bad;
+	printf("{\"ok\":1,\"names\":%u,\"allow\":%u,\"built\":%llu}\n", v.nblock, v.nallow, (unsigned long long)v.h->built);
+	munmap(base, len);
+	return 0;
+bad:
+	printf("{\"ok\":0,\"error\":\"not sorted\"}\n");
+	munmap(base, len);
+	return 1;
+}
+
+/* phase 2 (2026-10-21): the search engines' enforcement addresses for safe search, through
+   the router's own resolver. Only host names are looked up; nothing is printed for a name
+   that does not resolve, and the exit status says whether anything did. */
+static int cmd_resolve(int argc, char **argv)
+{
+	int i, any = 0;
+
+	for (i = 2; i < argc; i++) {
+		struct addrinfo hints, *res = NULL, *a;
+		char name[WALLGUARD_NAME_MAX + 2], ip[INET6_ADDRSTRLEN];
+
+		if (strlen(argv[i]) > WALLGUARD_NAME_MAX)
+			continue;
+		snprintf(name, sizeof(name), "%s", argv[i]);
+		if (norm(name) != 0)
+			continue;
+		memset(&hints, 0, sizeof(hints));
+		hints.ai_family = AF_UNSPEC;
+		hints.ai_socktype = SOCK_STREAM;	/* one entry per address */
+		if (getaddrinfo(name, NULL, &hints, &res) != 0)
+			continue;
+		for (a = res; a; a = a->ai_next) {
+			if (a->ai_family == AF_INET)
+				inet_ntop(AF_INET, &((struct sockaddr_in *)a->ai_addr)->sin_addr, ip, sizeof(ip));
+			else if (a->ai_family == AF_INET6)
+				inet_ntop(AF_INET6, &((struct sockaddr_in6 *)a->ai_addr)->sin6_addr, ip, sizeof(ip));
+			else
+				continue;
+			printf("%s %s %s\n", name, a->ai_family == AF_INET ? "v4" : "v6", ip);
+			any = 1;
+		}
+		freeaddrinfo(res);
+	}
+	return any ? 0 : 1;
+}
+
+int main(int argc, char **argv)
+{
+	if (argc >= 2 && !strcmp(argv[1], "build"))
+		return cmd_build(argc, argv);
+	if (argc >= 2 && !strcmp(argv[1], "explain"))
+		return cmd_explain(argc, argv);
+	if (argc >= 2 && !strcmp(argv[1], "check"))
+		return cmd_check(argc, argv);
+	if (argc >= 2 && !strcmp(argv[1], "resolve"))
+		return cmd_resolve(argc, argv);
+	fprintf(stderr, "usage: wallguardc build|explain|check|resolve ...\n");
+	return 2;
+}
