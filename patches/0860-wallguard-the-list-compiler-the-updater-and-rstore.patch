+# SPDX-License-Identifier: GPL-2.0-only
+# Copyright (C) 2026 the Reaper project maintainer
+# Part of the Reaper hardened Asuswrt-Merlin build. See LICENSE / LICENSE.reaper.
+# wallguardc: the Wallguard list compiler (Warden > Wallguard). libc only - rc runs it from the
+# updater it generates, httpd for "Why?"; it links neither libnvram nor libshared.
+include ../common.mak
+
+CFLAGS	+= -Os -Wall $(EXTRACFLAGS)
+CFLAGS	+= -I$(SRCBASE)/include -I$(TOP)/shared
+# same exploit-mitigation set as rdnsmapd: it parses files fetched from the internet
+CFLAGS	+= -D_FORTIFY_SOURCE=2 -fstack-protector-strong -Wformat -Wformat-security -fPIE
+LDFLAGS	= -pie -Wl,-z,relro,-z,now
+
+OBJS = wallguardc.o
+
+all: wallguardc rstore
+
+wallguardc: $(OBJS)
+	@echo " [wallguard] CC -o $@"
+	$(CC) $(LDFLAGS) -o $@ $(OBJS)
+
+	$(SIZECHECK)
+	$(CPTMP)
+
+# 2026-10-21: the long-term store's no-follow writer (shared/reaper_store_io.h); used by wallguard.sh,
+# the Dreadwatch collector and rwatch - installed whether or not Wallguard is switched on
+rstore: rstore.o
+	@echo " [wallguard] CC -o $@"
+	$(CC) $(LDFLAGS) -o $@ rstore.o
+
+clean:
+	rm -f wallguardc rstore .*.depend
+	rm -f *.o
+
+install: all
+	@echo " [wallguard] Installing..."
+	install -D wallguardc $(INSTALLDIR)/usr/sbin/wallguardc
+	$(STRIP) $(INSTALLDIR)/usr/sbin/wallguardc
+	install -D rstore $(INSTALLDIR)/usr/sbin/rstore
+	$(STRIP) $(INSTALLDIR)/usr/sbin/rstore
+	install -D -m 0755 wallguard.sh $(INSTALLDIR)/usr/sbin/wallguard.sh
+	install -D -m 0644 services.txt $(INSTALLDIR)/usr/share/wallguard/services
+
+%.o: %.c .%.depend
+	@echo " [wallguard] CC $@"
+	@$(CC) $(CFLAGS) -c $<
+
+.depend: $(OBJS:%.o=%.c)
+	@$(CC) $(CFLAGS) -M $^ > .depend
+
+.%.depend: %.c
+	@$(CC) $(CFLAGS) -M $< > $@
+
+-include $(OBJS:%.o=.%.depend) .rstore.depend
