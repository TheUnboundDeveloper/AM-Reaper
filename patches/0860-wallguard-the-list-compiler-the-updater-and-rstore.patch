--- /dev/null
+++ b/release/src/router/wallguard/rstore.c
@@ -0,0 +1,50 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Copyright (C) 2026 the Reaper project maintainer
+ * Part of the Reaper hardened Asuswrt-Merlin build. See LICENSE / LICENSE.reaper.
+ *
+ * rstore - write into the long-term store without following a link (2026-10-21).
+ * The shell writers (wallguard.sh, the Dreadwatch collector, rwatch) go through this instead of
+ * `>>`, `cp` or `rm` on a path inside a USB volume other people can write; the rules live in
+ * shared/reaper_store_io.h.
+ *
+ *   rstore append <base> <sub|-> <name> <cap-bytes>      data on stdin
+ *   rstore put    <base> <sub|-> <name> <src-file>
+ *   rstore get    <base> <sub|-> <name> <dst-file> <max-bytes>
+ *   rstore prune  <base> <sub|-> [keep ...]
+ *   rstore stamp  <base> <name> <text>
+ *   rstore ring   <base> <sub|-> <name> <max-lines>      data on stdin; keeps the last max-lines
+ *   rstore rmtree <base> <sub|-> <name>                  an incident-dump folder and its files
+ * <base> is what rstore_dir printed: /jffs/reaper or /tmp/mnt/<volume>/.reaper. Exit 0 = done.
+ */
+#define _GNU_SOURCE	/* the *at() calls and O_NOFOLLOW, before the first system header */
+#include <reaper_store.h>
+#include <reaper_store_io.h>
+
+static long long num(const char *s)
+{
+	char *e;
+	long long v = strtoll(s, &e, 10);
+	return (*s && !*e && v >= 0) ? v : -1;
+}
+
+int main(int argc, char **argv)
+{
+	const char *op = argc > 1 ? argv[1] : "";
+
+	if (!strcmp(op, "append") && argc == 6 && num(argv[5]) >= 0)
+		return rstore_append(argv[2], argv[3], argv[4], num(argv[5]), 0) ? 1 : 0;
+	if (!strcmp(op, "put") && argc == 6)
+		return rstore_put(argv[2], argv[3], argv[4], argv[5]) ? 1 : 0;
+	if (!strcmp(op, "get") && argc == 7 && num(argv[6]) > 0)
+		return rstore_get(argv[2], argv[3], argv[4], argv[5], num(argv[6])) ? 1 : 0;
+	if (!strcmp(op, "prune") && argc >= 4)
+		return rstore_prune(argv[2], argv[3], argv + 4) ? 1 : 0;
+	if (!strcmp(op, "stamp") && argc == 5)
+		return rstore_stamp(argv[2], argv[3], argv[4]) ? 1 : 0;
+	if (!strcmp(op, "ring") && argc == 6 && num(argv[5]) > 0)
+		return rstore_ring(argv[2], argv[3], argv[4], (long)num(argv[5]), 0) ? 1 : 0;
+	if (!strcmp(op, "rmtree") && argc == 5)
+		return rstore_rmtree(argv[2], argv[3], argv[4]) ? 1 : 0;
+	fputs("usage: rstore append|put|get|prune|stamp|ring|rmtree <base> ... (see the source)\n", stderr);
+	return 2;
+}
