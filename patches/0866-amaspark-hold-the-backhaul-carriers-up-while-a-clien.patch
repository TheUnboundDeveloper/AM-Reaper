From 20104dfe00f2005d61ea904255bb06a0b70c1ba7 Mon Sep 17 00:00:00 2001
From: reaper <theunbounddeveloper@outlook.com>
Date: Sun, 25 Oct 2026 22:49:12 -0400
Subject: [PATCH] amaspark: hold the backhaul carriers up while a client
 network is down

Field (RT-BE88U): the Wireless Scheduler turned the networks back on at the end
of their off window, but no SSID went out until a reboot. With parking on, the
primary BSS stays down while no node is paired, and the scheduler's turn-on was
never proven under a parked carrier. vif_down() looks for a wlN.M that is
switched on in the settings but down on the air; while one is, every carrier is
held up and the reason logged; parking resumes 60 s after every client network
is back. Parking off: no change.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 release/src/router/rc/amaspark.c | 57 +++++++++++++++++++++++++++++---
 1 file changed, 53 insertions(+), 4 deletions(-)

diff --git a/release/src/router/rc/amaspark.c b/release/src/router/rc/amaspark.c
index caf75514c4..8df0d93827 100644
--- a/release/src/router/rc/amaspark.c
+++ b/release/src/router/rc/amaspark.c
@@ -69,6 +69,8 @@
 #define AP_SETTLE	120		/* s, quiet period after a window closes before parking again */
 #define AP_STATE	"/tmp/reaper/amaspark.state"
 #define AP_MAXU		4		/* radios: the GT-BE98 family has four (2.4, 5-1, 5-2, 6); the band comes from wlN_nband, never the unit number */
+#define AP_MAXIF	24		/* interfaces whose bss state is read: the primaries and their client networks */
+#define AP_VIF_SETTLE	60		/* s, after every client network is up again before parking resumes */
 
 static volatile sig_atomic_t g_stop;
 static void on_sig(int s) { (void)s; g_stop = 1; }
@@ -100,12 +102,12 @@ static int bss_state_wl(const char *ifn)
  * today's behaviour, it never gets an inert parker. */
 static int bss_state(const char *ifn)
 {
-	static struct { char ifn[IFNAMSIZ]; int trust; } seen[AP_MAXU];
+	static struct { char ifn[IFNAMSIZ]; int trust; } seen[AP_MAXIF];
 	int i, v = 0;
 
-	for (i = 0; i < AP_MAXU && seen[i].ifn[0] && strcmp(seen[i].ifn, ifn); i++)
+	for (i = 0; i < AP_MAXIF && seen[i].ifn[0] && strcmp(seen[i].ifn, ifn); i++)
 		;
-	if (i == AP_MAXU)
+	if (i == AP_MAXIF)
 		return bss_state_wl(ifn);
 	if (!seen[i].ifn[0]) {
 		int viaw = bss_state_wl(ifn);
@@ -144,6 +146,31 @@ static int bss_assoc_count(const char *ifn)
 	return n;
 }
 
+/* 2026-10-25 (field, RT-BE88U tester: the Wireless Scheduler turned the networks back on at the end of their
+ * off window but no SSID was broadcast until a reboot). The parking proof above covers client networks that are
+ * ALREADY up when the primary goes down; it never covered bringing one UP while its radio's primary is parked -
+ * which is exactly the scheduler's turn-on (`wl bss -C <n> up` on wlN.M). So a client network that is enabled in
+ * the settings (wlN.M_bss_enabled=1, listed in wlN_vifs) but down on the air - a schedule's off window, or any
+ * other reason - keeps every carrier up until it is back: its bring-up then happens exactly as on stock firmware.
+ * Re-parking with every client network up is the proven case. Returns 1 and the name of the first such network. */
+static int vif_down(int u, char *out, size_t n)
+{
+	char key[32], list[160], *p, *s;
+
+	snprintf(key, sizeof(key), "wl%d_vifs", u);
+	strlcpy(list, nvram_safe_get(key), sizeof(list));
+	for (p = strtok_r(list, " ", &s); p; p = strtok_r(NULL, " ", &s)) {
+		if (strlen(p) >= IFNAMSIZ) continue;
+		snprintf(key, sizeof(key), "%s_bss_enabled", p);
+		if (!nvram_match(key, "1")) continue;
+		if (bss_state(p) == 0) {
+			strlcpy(out, p, n);
+			return 1;
+		}
+	}
+	return 0;
+}
+
 static void bss_set(const char *ifn, int up)
 {
 	eval("wl", "-i", (char *)ifn, "bss", up ? "up" : "down");
@@ -195,8 +222,9 @@ int amaspark_main(int argc, char *argv[])
 	char parked[AP_MAXU] = { 0 }, held[AP_MAXU] = { 0 };
 	char ifn[AP_MAXU][IFNAMSIZ];
 	int nband[AP_MAXU], before[AP_MAXU], radio[AP_MAXU];
-	int last_enabled = -1, last_window = 0, ob_capped = 0, settling = 0;
+	int last_enabled = -1, last_window = 0, ob_capped = 0, settling = 0, vheld = 0;
 	long ob_start = 0, settle_until = 0;
+	static char vbuf[200];
 	(void)argc; (void)argv;
 
 	signal(SIGTERM, on_sig);
@@ -308,6 +336,27 @@ int amaspark_main(int argc, char *argv[])
 			}
 		}
 
+		/* a client network that is enabled but down holds every carrier up (vif_down() above) */
+		if (want || vheld) {
+			char dn[IFNAMSIZ] = "";
+			for (u = 0; u < AP_MAXU && !dn[0]; u++)
+				if (ifn[u][0] && radio[u])
+					vif_down(u, dn, sizeof(dn));
+			if (dn[0]) {
+				snprintf(vbuf, sizeof(vbuf), "client network %s is down (a Wi-Fi schedule may have turned it off) - its radio's carrier stays up so it can come back as on stock firmware", dn);
+				if (!vheld)
+					logmessage(AP_TAG, "holding the backhaul carriers up: %s", vbuf);
+				vheld = 1;
+				want = 0;
+				why_rel = vbuf;
+			} else if (vheld) {
+				vheld = 0;
+				settle_until = now + AP_VIF_SETTLE;
+				want = 0;
+				logmessage(AP_TAG, "every client network is up again - parking resumes in %d s", AP_VIF_SETTLE);
+			}
+		}
+
 		if (want) {
 			int acted = 0;
 			/* reaper v3.1.0 (owner 2026-09-06): a wireless restart - a Network or
