From 4f84fb233c5a805074fd7bbb8447243714782bdc Mon Sep 17 00:00:00 2001
From: reaper <theunbounddeveloper@outlook.com>
Date: Sun, 25 Oct 2026 22:49:17 -0400
Subject: [PATCH] rtrafd: the database and health log written through the
 no-follow store writer

The traffic database, its health log and the history rings on the long-term
store go through reaper_store_io (openat, O_NOFOLLOW, temp + rename), same
rings and rotation as before.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 release/src/router/rtrafd/rtrafd.c | 101 ++++++++++++++++-------------
 1 file changed, 56 insertions(+), 45 deletions(-)

diff --git a/release/src/router/rtrafd/rtrafd.c b/release/src/router/rtrafd/rtrafd.c
index c178a4537f..cba3fbfde7 100644
--- a/release/src/router/rtrafd/rtrafd.c
+++ b/release/src/router/rtrafd/rtrafd.c
@@ -67,6 +67,7 @@
 #include <shared.h>
 #include <mtlan_utils.h>	/* SDN/VLAN identity behind each LAN bridge */
 #include <reaper_store.h>	/* 2026-10-18: the pinned USB store volume */
+#include <reaper_store_io.h>	/* 2026-10-21: every store write relative to a no-follow folder fd */
 
 /* Dual cadence: a fast 100 ms base tick drives the live view (WAN rate +
  * live.json write) so the page's "Live" refresh mode gets true 100 ms samples
@@ -2355,34 +2356,19 @@ static void cli_dedup_ipkeys(void)
  * and far kinder to NAND than the old every-cycle append). */
 static void health_flush_spool(void)
 {
-	char lp[176];
 	struct stat st;
-	FILE *in, *out;
-	char buf[2048];
-	size_t n;
+	int in, r;
 	if (!g_store_dir[0]) return;
 	if (stat(HSPOOL, &st) != 0 || st.st_size == 0) return;		/* nothing pending */
-	snprintf(lp, sizeof(lp), "%s/healthhist.log", g_store_dir);
-	if (stat(lp, &st) == 0 && st.st_size > HLOG_MAX) {
-		char pv[192];
-		snprintf(pv, sizeof(pv), "%s.1", lp);
-		rename(lp, pv);
-	}
-	if ((in = fopen(HSPOOL, "r")) == NULL) return;
-	/* O_NOFOLLOW: g_store_dir can be an attacker-writable USB mount, so a
-	   symlink planted at healthhist.log would redirect these root appends.
-	   Same discipline as db_save() below. */
-	{
-		int _fd = open(lp, O_WRONLY | O_CREAT | O_APPEND | O_NOFOLLOW, 0600);
-		if (_fd < 0 || (out = fdopen(_fd, "a")) == NULL) {
-			if (_fd >= 0) close(_fd);
-			fclose(in);
-			return;
-		}
-	}
-	while ((n = fread(buf, 1, sizeof(buf), in)) > 0) fwrite(buf, 1, n, out);
-	fclose(out);
-	fclose(in);
+	if ((in = open(HSPOOL, O_RDONLY | O_NOFOLLOW | O_CLOEXEC)) < 0) return;
+	/* g_store_dir can be an attacker-writable USB mount: rstore_append() opens the store folder from
+	   its trusted parent with no link followed at any level (O_NOFOLLOW on the file alone still let a
+	   .reaper swapped for a link redirect this append), rotates to .1 past HLOG_MAX first, and
+	   appends only to a regular file (2026-10-21 review) */
+	r = rstore_append(g_store_dir, "-", "healthhist.log", HLOG_MAX, in);
+	close(in);
+	if (r != 0)
+		return;		/* the spool is kept and flushed next time */
 	if (truncate(HSPOOL, 0) != 0)		/* best-effort; a failure just re-flushes the same rows next time */
 		syslog(LOG_DEBUG, "rtrafd: healthhist spool reset: %s", strerror(errno));
 }
@@ -2448,28 +2434,43 @@ static const char *resolve_store(char *buf, size_t len)
 
 static time_t db_saved = 0;	/* h.saved of the restored db (0 = none loaded) */
 
+/* the store folder of a db path ("/jffs/reaper/rtraf.db" or "<mnt>/<vol>/.reaper/rtraf.db") as a
+   folder fd opened with no link followed at any level (shared/reaper_store_io.h), or -1 */
+#define DB_LEAF "rtraf.db"
+static int db_dir(const char *path)
+{
+	char dir[160];
+	size_t l = strlen(path);
+	if (l <= sizeof(DB_LEAF) || strcmp(path + l - (sizeof(DB_LEAF) - 1), DB_LEAF) || path[l - sizeof(DB_LEAF)] != '/')
+		return -1;
+	if (l - sizeof(DB_LEAF) >= sizeof(dir))
+		return -1;
+	memcpy(dir, path, l - sizeof(DB_LEAF));
+	dir[l - sizeof(DB_LEAF)] = '\0';
+	return rstore_open_base(dir);
+}
+
 static void db_save(const char *path)
 {
 	dbhdr_t h;
 	FILE *o;
-	char tmp[160];
 	int i;
-	int fd;
+	int fd, dfd;
 	time_t st = time(NULL);
 	if (!path[0]) return;
 	/* never REGRESS the file's timestamp: a save on a box whose clock hasn't
 	 * synced would stamp 1970 over a sane restored stamp, and the next boot's
 	 * db_align() would then have nothing to align to */
 	if (!clock_sane(st) && db_saved > st) st = db_saved;
-	snprintf(tmp, sizeof(tmp), "%s.new", path);
-	/* On an attacker-controlled USB mount, tmp could be a pre-planted symlink;
-	 * clear it, then create exclusively without following (O_EXCL|O_NOFOLLOW)
-	 * with 0600 so history is never world-readable and never redirected. The
-	 * final rtraf.db is this 0600 file, published atomically via rename(). */
-	unlink(tmp);
-	fd = open(tmp, O_CREAT | O_EXCL | O_WRONLY | O_NOFOLLOW, 0600);
-	if (fd < 0) return;
-	if ((o = fdopen(fd, "w")) == NULL) { close(fd); unlink(tmp); return; }
+	/* On an attacker-controlled USB mount, the temp name could be a pre-planted symlink, and (2026-10-21
+	 * review) so could .reaper itself: everything is relative to the store folder opened with no link
+	 * followed (db_dir), the temp created exclusively without following (O_EXCL|O_NOFOLLOW) with 0600,
+	 * published atomically with renameat(). */
+	if ((dfd = db_dir(path)) < 0) return;
+	unlinkat(dfd, DB_LEAF ".new", 0);
+	fd = openat(dfd, DB_LEAF ".new", O_CREAT | O_EXCL | O_WRONLY | O_NOFOLLOW | O_CLOEXEC, 0600);
+	if (fd < 0) { close(dfd); return; }
+	if ((o = fdopen(fd, "w")) == NULL) { close(fd); unlinkat(dfd, DB_LEAF ".new", 0); close(dfd); return; }
 	memset(&h, 0, sizeof(h));
 	h.magic = DB_MAGIC; h.ver = DB_VER; h.saved = st; h.nnet = nnet;
 	memcpy(h.netname, netname, sizeof(netname));
@@ -2481,7 +2482,8 @@ static void db_save(const char *path)
 	for (i = 0; i < NCLI; i++) fwrite(r_cli[i], sizeof(ring_t), 1, o);
 	fwrite(r_prb, sizeof(ring_t), 1, o);
 	fclose(o);
-	rename(tmp, path);
+	renameat(dfd, DB_LEAF ".new", dfd, DB_LEAF);
+	close(dfd);
 }
 
 /* Park an existing db out of the way as <path>.prev so it is never silently
@@ -2489,11 +2491,12 @@ static void db_save(const char *path)
  * or a store that appeared too late to restore). No-op if the file is absent. */
 static void db_park_prev(const char *path)
 {
-	char prev[176];
-	if (!path[0] || access(path, F_OK) != 0) return;
-	snprintf(prev, sizeof(prev), "%s.prev", path);
-	if (rename(path, prev) == 0)
-		syslog(LOG_WARNING, "rtrafd: prior %s not restored - preserved as %s", path, prev);
+	struct stat st;
+	int dfd;
+	if (!path[0] || (dfd = db_dir(path)) < 0) return;
+	if (fstatat(dfd, DB_LEAF, &st, AT_SYMLINK_NOFOLLOW) == 0 && renameat(dfd, DB_LEAF, dfd, DB_LEAF ".prev") == 0)
+		syslog(LOG_WARNING, "rtrafd: prior %s not restored - preserved as %s.prev", path, path);
+	close(dfd);
 }
 
 /* returns 1 = history loaded (possibly truncated), 0 = no db file,
@@ -2505,10 +2508,18 @@ static int db_load(const char *path)
 	FILE *o;
 	int i;
 	int fd;
+	int dfd, e;
+	struct stat sb;
 	if (!path[0]) return 0;
-	/* don't follow a symlink planted where rtraf.db should be */
-	fd = open(path, O_RDONLY | O_NOFOLLOW);
-	if (fd < 0) return (errno == ENOENT) ? 0 : -1;
+	/* don't follow a symlink planted where rtraf.db (or, 2026-10-21, .reaper) should be; a FIFO
+	   or other non-file is refused without blocking */
+	if ((dfd = db_dir(path)) < 0) return 0;
+	fd = openat(dfd, DB_LEAF, O_RDONLY | O_NOFOLLOW | O_NONBLOCK | O_CLOEXEC);
+	e = errno;
+	close(dfd);
+	if (fd < 0) return (e == ENOENT) ? 0 : -1;
+	if (fstat(fd, &sb) != 0 || !S_ISREG(sb.st_mode)) { close(fd); return -1; }
+	fcntl(fd, F_SETFL, fcntl(fd, F_GETFL) & ~O_NONBLOCK);
 	if ((o = fdopen(fd, "r")) == NULL) { close(fd); return -1; }
 	if (fread(&h, sizeof(h), 1, o) != 1 || h.magic != DB_MAGIC || h.ver != DB_VER) {
 		fclose(o);
-- 
2.25.1

