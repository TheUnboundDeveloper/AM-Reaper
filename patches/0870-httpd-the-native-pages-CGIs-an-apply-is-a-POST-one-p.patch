+static void sh_popen(FILE *stream, const char *cmd, const char *fallback)
+{
+	FILE *p;
+	char big[2048];
+	int got = 0;
+
+	if ((p = popen(cmd, "r")) != NULL) {
+		while (fgets(big, sizeof(big), p) != NULL) {
+			websWrite(stream, "%s", big);
+			got = 1;
+		}
+		pclose(p);
+	}
+	if (!got)
+		websWrite(stream, "%s", fallback);
+}
