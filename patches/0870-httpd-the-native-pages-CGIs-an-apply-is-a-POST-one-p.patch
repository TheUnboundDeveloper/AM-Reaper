+/* 2026-10-21 Encrypted DNS for devices (Reaper_EncryptedDNS.asp): rednsd's status file
+ * plus what the page needs to explain it. httpd is single-threaded, so this never waits
+ * for rednsd: it asks for a fresh file (SIGUSR1) and returns the current one - the page
+ * polls every 10 s. The file sits in a directory rednsd writes as nobody, so it is passed
+ * on only as a small regular file of printable ASCII shaped like a JSON object. */
+#define RENC_STATUS	"/tmp/rednsd/run/status.json"	/* rednsd's own (nobody) */
+#define RENC_NOTE	"/tmp/rednsd/note.json"		/* rc: why it did not start */
+#define RENC_DNSF_ROUTER 11	/* DNSF_SRV_ROUTER in rc/dnsfilter.h */
+
+static int renc_private_v4(const char *s)
+{
+	struct in_addr a;
+	uint32_t x;
+
+	if (!s || !*s || inet_pton(AF_INET, s, &a) != 1)
+		return 0;
+	x = ntohl(a.s_addr);
+	return x && ((x >> 24) == 10 || (x & 0xfff00000u) == 0xac100000u || (x & 0xffff0000u) == 0xc0a80000u
+		     || (x & 0xffc00000u) == 0x64400000u);
+}
+
+/* 2026-10-21: the encrypted-DNS block - an ipset's size, the REAPER_EDNS chain's refusals by
+   port, and how many provider names the router answers NXDOMAIN. popen() runs `sh -c`, so every command
+   below is a fixed literal - nothing from the request reaches a shell. */
+/* both block sets' sizes from ONE shell (review 2026-10-24, Q-B-7); -1 = a set that is not there */
+static void renc_set_sizes(long *v4, long *v6)
+{
+	char line[160];
+	FILE *p = popen("ipset list -t redns_doh 2>/dev/null; echo --; ipset list -t redns_doh6 2>/dev/null", "r");
+	long *cur = v4;
+
+	*v4 = *v6 = -1;
+	if (!p)
+		return;
+	while (fgets(line, sizeof(line), p)) {
+		if (!strncmp(line, "--", 2))
+			cur = v6;
+		else
+			sscanf(line, "Number of entries: %ld", cur);
+	}
+	pclose(p);
+}
+
+static void renc_rejects(const char *cmd, unsigned long long *p853, unsigned long long *p443)
+{
+	char line[300];
