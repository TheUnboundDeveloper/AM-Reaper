+/* JSON string of a file's text: fw_json_frag's escaping contract (review 2026-10-24, Q-B-9: this was a fourth one;
+   `<>&` arrive as < etc. - S-B-4 - and the parsed value is the same) */
+static void fw_json_frag(FILE *stream, const char *s);
+static void sh_json_file(FILE *stream, const char *path)
+{
+	int ex;
+	const char *v = rjf_get(path, &ex);
+
+	websWrite(stream, "\"");
+	fw_json_frag(stream, ex > 0 ? v : "");
+	websWrite(stream, "\"");
+}
