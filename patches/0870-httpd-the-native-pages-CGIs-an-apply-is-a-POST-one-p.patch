+		websWrite(stream, "{\"ok\":1,\"until\":%lld}", until);
+		return;
+	}
+	if (!strcmp(action, "why")) {
+		char *name = get_cgi("name"), live[48], n[256];
+		if (!name || strlen(name) >= sizeof(n)) {
+			websWrite(stream, "{\"ok\":0,\"ek\":\"RSHD_E2\"}");
+			return;
+		}
+		snprintf(n, sizeof(n), "%s", name);
