+/* the router's own answer for a name (A), as text: an address, "nxdomain" or "none" */
+static void sh_live_answer(const char *name, char *out, size_t n)
+{
+	char ip[16];
+	int rc;
+
+	if (reaper_dns_a(name, &rc, ip, sizeof(ip)) != 0)
+		snprintf(out, n, "none");
+	else if (rc == 3)
+		snprintf(out, n, "nxdomain");
+	else
+		snprintf(out, n, "%s", ip[0] ? ip : "none");
+}
