+		}
+		snprintf(n, sizeof(n), "%s", name);
+		for (i = 0; n[i]; i++)
+			n[i] = (char)tolower((unsigned char)n[i]);
+		if (!sh_name(n) || (strcmp(dur, "24h") && strcmp(dur, "always"))) {
+			websWrite(stream, "{\"ok\":0,\"ek\":\"RSHD_E2\"}");
