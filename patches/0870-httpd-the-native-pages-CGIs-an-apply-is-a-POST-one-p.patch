+/* ---------------------------------------------------------------------------
+ * reaper 2026-10-23 (CVE-2026-75779 class): cross-site refusal for every
+ * authenticated CGI.
+ *
+ * Stock checks the Referer only for the 38 CGIs in the closed mime_referers[]
+ * list (apply.cgi, applyapp.cgi, upgrade.cgi, ...). The other authenticated
+ * CGIs - over a hundred of them: netool, set_iperf3_cli, wl_apply, set_fw_path,
+ * the create_sdn family - ran on a valid session cookie alone. SameSite=Lax on
+ * asus_token (security review 2026-10-20 F-4) keeps the cookie off cross-site
+ * POSTs, but a top-level cross-site GET navigation still carries it, and
+ * do_html_post_and_get parses a GET query string. So a hostile page opened by
+ * a logged-in admin could drive any of those CGIs; one with a shell sink is
+ * the advisory's CSRF-to-root chain.
+ *
+ * A request is cross-site when the browser says so (Sec-Fetch-Site, which a
+ * page cannot suppress or forge) or when its Referer names another host. It is
+ * still allowed when the Referer is this router under another of its own names
+ * (LAN address, the DUT domains, lan_hostname): those are pages the router
+ * served itself. A request with neither header passes on the HTTPS listener -
+ * curl, scripts, browsers too old to send Sec-Fetch-Site - as before. On the
+ * plain-HTTP listener it does NOT pass when a browser sent it (review
+ * 2026-10-24, S-B-1): browsers attach Fetch Metadata only to trustworthy
+ * destinations, never to http://192.168.x.x, and send no Referer on a
+ * cross-site navigation there, so over HTTP "no header" is exactly the
+ * cross-site case; a same-origin request from the router's own pages always
+ * carries its Referer (nothing served here sets a no-referrer policy). The
+ * ASUS app (fromapp) is not a browser and is not checked here.
+ *
+ * One stock cross-DEVICE flow is kept: an AiMesh node's wizard (QIS_V3
+ * handler.js goTo.Conncap) navigates to http://<DUT domain>/cfg_onboarding.cgi
+ * ?flag=AMesh&id=<mac>, which lands on the CAP with the node's address as the
+ * Referer. That handler only signals "node available" to cfg_server and
+ * redirects to index.asp, so a plain GET to it stays allowed; with re_mac in
+ * the query (the onboarding lock event) it is refused like any other CGI. The
+ * query is read as init_cgi() will decode it, never as raw request text
+ * (review 2026-10-24, S-B-2: a percent-encoded key name is still that key).
+ *
+ * Pages (.asp, .htm) are not covered: the stock list holds the ones ASUS
+ * marked as acting. The refusal is a bare 403, not the login page, so a
+ * hostile page cannot bounce the admin to a login form either.
+ * ------------------------------------------------------------------------- */
+static void reaper_hostpart(const char *s, char *out, size_t outsz)
+{
+	const char *h, *e;
+	size_t n;
+
+	h = strstr(s, "://");
+	h = h ? h + 3 : s;
+	if (*h == '[') {
+		e = strchr(h, ']');
+		e = e ? e + 1 : h + strlen(h);
+	} else
+		e = h + strcspn(h, ":/?#\r\n \t");
+	n = (size_t)(e - h);
+	if (n >= outsz)
+		n = 0;
+	memcpy(out, h, n);
+	out[n] = '\0';
+}
+
+static int reaper_host_is_self(const char *h)
+{
+	char fq[160];
+	const char *hn = nvram_safe_get("lan_hostname");
+
+	if (!h[0])
+		return 0;
+	if (!strcasecmp(h, nvram_safe_get("lan_ipaddr")) ||
+	    !strcasecmp(h, DUT_DOMAIN_NAME) || !strcasecmp(h, OLD_DUT_DOMAIN_NAME))
+		return 1;
+	if (hn[0]) {
+		if (!strcasecmp(h, hn))
+			return 1;
+		snprintf(fq, sizeof(fq), "%s.%s", hn, nvram_safe_get("lan_domain"));
+		if (!strcasecmp(h, fq))
+			return 1;
+	}
+	return 0;
+}
+
+/* Does the request's query carry this key, once decoded the way init_cgi() decodes it
+ * (%xx and +)? Decided on a copy; a query too long for the copy counts as carrying it
+ * (review 2026-10-24, S-B-2: the exemption below was read off the raw text, so
+ * "%72e_mac=" was not "re_mac" to it but was to init_cgi). */
+static int reaper_query_has(const char *file, const char *key)
+{
+	char q[512];
+	const char *s = strchr(file, '?');
+
+	if (!s)
+		return 0;
+	if (snprintf(q, sizeof(q), "%s", s + 1) >= (int)sizeof(q))
+		return 1;
+	unescape(q, sizeof(q));
+	return strstr(q, key) != NULL;
+}
+
+/* ua = the User-Agent (NULL when absent); tls = this listener is the HTTPS one */
+static int reaper_xsite_cgi_refused(const char *url, const char *file, const char *method, const char *sfs, const char *ua, int tls)
+{
+	static long last_log = 0;
+	char rh[128], hh[128], name[48];
+	int i, n, xsite;
+
+	if (!strstr(url, ".cgi"))
+		return 0;
+
+	reaper_hostpart(referer_url, rh, sizeof(rh));
+	reaper_hostpart(host_name[0] ? host_name : nvram_safe_get("lan_ipaddr"), hh, sizeof(hh));
+
+	if (rh[0])
+		xsite = strcasecmp(rh, hh) != 0 && !reaper_host_is_self(rh);
+	else if (sfs[0])
+		xsite = strcasecmp(sfs, "cross-site") == 0;
+	else
+		/* neither header: cross-site when a browser sent it over plain HTTP (S-B-1,
+		 * see above); curl and scripts carry no Mozilla/ User-Agent and still pass */
+		xsite = !tls && ua && !strncmp(ua, "Mozilla/", 8);
+	if (!xsite)
+		return 0;
+
+	if (!strcmp(url, "cfg_onboarding.cgi") && !strcasecmp(method, "get") && !reaper_query_has(file, "re_mac"))
+		return 0;
+
+	if (uptime() - last_log >= 10) {
+		for (i = n = 0; url[i] && n < (int)sizeof(name) - 1; i++)
+			if (isalnum((unsigned char)url[i]) || strchr("._-/", url[i]))
+				name[n++] = url[i];
+		name[n] = '\0';
+		logmessage("httpd", "reaper: cross-site request refused (%s, referer host %s)",
+			name, rh[0] ? "foreign" : sfs[0] ? "absent, Sec-Fetch-Site cross-site" : "absent, plain HTTP browser");
+		last_log = uptime();
+	}
+	return 1;
+}
+
 static void
 handle_request(void)
 {
@@ -1430,6 +1567,7 @@ handle_request(void)
 #endif
 	char inviteCode[512];
 	char uip_tmp[128] = {0}, *temp_ip_str = NULL;
+	char sec_fetch_site[16] = {0};	/* reaper: cross-site CGI guard */
 
 	/* Initialize the request variables. */
 	auth_result = 1;
@@ -1560,6 +1698,14 @@ handle_request(void)
 			cur = cp + strlen(cp) + 1;
 			//_dprintf("httpd referer = %s\n", referer);
 		}
+		else if ( strncasecmp( cur, "Sec-Fetch-Site:", 15 ) == 0 )
+		{
+			/* reaper: copied out, cur not advanced - the next header reuses the space */
+			cp = &cur[15];
+			cp += strspn( cp, " \t" );
+			strlcpy(sec_fetch_site, cp, sizeof(sec_fetch_site));
+			sec_fetch_site[strcspn(sec_fetch_site, "\r\n \t")] = '\0';
+		}
 		else if ( strncasecmp( cur, "Host:", 5 ) == 0 )
 		{
 			cp = &cur[5];
@@ -1743,6 +1889,7 @@ handle_request(void)
 		strlcpy(user_agent, "", sizeof(user_agent));
 
 	fromapp = check_user_agent(useragent);
+	reaper_req_post = strcasecmp(method, "post") == 0;	/* reaper 2026-10-25 (review S-C2-1): web.c refuses an apply on anything else */
 
 	if(!strcmp(url, APPGETCGI))
 		json_support = 1;
@@ -1882,6 +2029,13 @@ handle_request(void)
 				else if((mime_exception&MIME_EXCEPTION_NOAUTH_ALL)) {
 				}
 				else {
+					/* reaper 2026-10-23: cross-site refusal for every authenticated CGI */
+					if (!fromapp && reaper_xsite_cgi_refused(url, file, method, sec_fetch_site, useragent, do_ssl)) {
+						if(strcasecmp(method, "post") == 0 && handler->input)	//response post request
+							{ int _dn = cl; if (_dn > 65536) _dn = 65536; while (_dn-- > 0 && fgetc(conn_fp) != EOF) ; }
+						send_error( 403, "Forbidden", (char*) 0, "Cross-site request refused." );
+						return;
+					}
 					if(do_referer&CHECK_REFERER){
 						referer_result = referer_check(referer, fromapp);
 						if(referer_result != 0){
@@ -1970,6 +2124,15 @@ handle_request(void)
 				}
 #endif
 			}
+			/* reaper 2026-10-25 (review 2026-10-24, Q-B-2): a stock page that no longer ships bounces to its
+			 * Reaper replacement - the stub in reaper_output() never ran because the "file not found"
+			 * answer below came first. Headers first, then the stub; nothing else of the page exists. */
+			if (handler->output && !strstr(file, ".cgi") && reaper_gone_page(file) && !check_if_file_exist(file)) {
+				send_headers(200, "OK", handler->extra_header, handler->mime_type, fromapp);
+				if (strcasecmp(method, "head") != 0)
+					reaper_output(handler, file, conn_fp);
+				break;
+			}
 			if(!strstr(file, ".cgi") && !strstr(file, "syslog.txt") && !(strstr(file,"uploadIconFile.tar")) && (fnmatch("backup_jffs*.tar",file,0) == FNM_NOMATCH) && !(strstr(file,"networkmap.tar")) && !(strstr(file,".CFG")) && !(strstr(file,".rbk")) /* reaper v2.7.2: full-backup download is handler-generated, not on disk */ && !(strstr(file,".log")) && !check_if_file_exist(file)
 #ifdef RTCONFIG_USB_MODEM
 					&& !strstr(file, "modemlog.txt")
