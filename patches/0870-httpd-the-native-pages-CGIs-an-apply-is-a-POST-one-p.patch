+/* ---- reaper 2026-10-25 (review 2026-10-24, S-C1-1 / S-C2-2): a secret inside an nvram list never rides the
+ * page source. reaper_masked_list(key) serves the list with the secret field of every row replaced by
+ * RSEC_MASK when it is set (the field per key is the table below); a page posts an untouched row back as it
+ * got it, and reaper_rsec_unmask() puts the stored field back - matched by the row's leading key fields,
+ * else by its position - before the value is checked and stored. vpnc_pppoe_passwd posted as the mask takes
+ * the password of the saved PPTP/L2TP profile whose server and user name were posted with it (the page's
+ * "Use" button). The mask itself is never stored as a secret. ---- */
+#define RSEC_MASK	"********"
+#define RSEC_ROWS	64
+#define RSEC_FIELDS	48
+struct rsec_list { const char *name; char rowsep, fieldsep; int field, nkey; };
+static const struct rsec_list rsec_lists[] = {
+	{ "vpn_serverx_clientlist",	'<', '>', 1, 1 },	/* <user>pass */
+	{ "pptpd_clientlist",		'<', '>', 1, 1 },
+	{ "ipsec_client_list_1",	'<', '>', 1, 1 },
+	{ "ipsec_client_list_2",	'<', '>', 1, 1 },
+	{ "vpnc_clientlist",		'<', '>', 4, 4 },	/* <desc>proto>server>user>pass>... */
+	{ "ipsec_profile_1",		0,   '>', 7, 0 },	/* one row; the pre-shared key */
+	{ NULL, 0, 0, 0, 0 }
+};
+
+static const struct rsec_list *rsec_of(const char *name)
+{
+	int i;
+
+	for (i = 0; rsec_lists[i].name; i++)
+		if (!strcmp(name, rsec_lists[i].name))
+			return &rsec_lists[i];
+	return NULL;
+}
+
+/* the stored list as a page would see it - decrypted where this build encrypts it */
+static const char *rsec_stored(const char *name, char *dec, size_t declen)
+{
+	const char *s = nvram_safe_get(name);
+#if defined(RTCONFIG_NVRAM_ENCRYPT)
+	if (!strcmp(name, "pptpd_clientlist") || !strcmp(name, "vpn_serverx_clientlist")) {
+		memset(dec, 0, declen);
+		remove_encrypt_list_value((char *)s, dec, (int)declen);
+		return dec;
+	}
+#else
+	(void)dec;
+	(void)declen;
+#endif
+	return s;
+}
+
+static void rsec_mask(const struct rsec_list *l, const char *in, char *out, size_t cap)
+{
+	size_t o = 0;
+	int fi = 0;
+	const char *p = in;
+
+	while (*p && o + 1 < cap) {
+		if (l->rowsep && *p == l->rowsep) {
+			fi = 0;
+			out[o++] = *p++;
+			continue;
+		}
+		if (*p == l->fieldsep) {
+			fi++;
+			out[o++] = *p++;
+			continue;
+		}
+		if (fi == l->field) {		/* the secret: swallowed, the mask written once in its place */
+			const char *e = p;
+			while (*e && *e != l->fieldsep && !(l->rowsep && *e == l->rowsep))
+				e++;
+			if (e > p && o + sizeof(RSEC_MASK) < cap) {
+				memcpy(out + o, RSEC_MASK, sizeof(RSEC_MASK) - 1);
+				o += sizeof(RSEC_MASK) - 1;
+			}
+			p = e;
+			continue;
+		}
+		out[o++] = *p++;
+	}
+	out[o] = 0;
+}
+
+/* review 2026-10-24 (1.2): the hex MD5 of the factory-default login password, so the System page can refuse the
+ * default as a new password without carrying the default itself in its source (on a model with a per-unit label
+ * password, nvram_default_get("http_passwd") is that unit's password). Empty when there is no default. */
+static int ej_reaper_default_pw_md5(int eid, webs_t wp, int argc, char_t **argv)
+{
+#ifdef RTCONFIG_HTTPS
+	const char *d = nvram_default_get("http_passwd");
+	unsigned char key[MD5_DIGEST_LENGTH];
+	char hex[2 * MD5_DIGEST_LENGTH + 1];
+	MD5_CTX c;
+	int i;
+
+	if (!d || !*d)
+		return 0;
+	MD5_Init(&c);
+	MD5_Update(&c, d, strlen(d));
+	MD5_Final(key, &c);
+	for (i = 0; i < MD5_DIGEST_LENGTH; i++)
+		snprintf(hex + i * 2, 3, "%02x", (unsigned int)key[i]);
+	return websWrite(wp, "%s", hex);
+#else
+	return 0;
+#endif
+}
+
+static int ej_reaper_masked_list(int eid, webs_t wp, int argc, char_t **argv)
+{
+	char *name, masked[8200], dec[8200], *enc;
+	const struct rsec_list *l;
+	size_t n;
+	int ret;
+
+	if (ejArgs(argc, argv, "%s", &name) < 1 || !(l = rsec_of(name))) {
+		websError(wp, 400, "Insufficient args\n");
+		return -1;
+	}
+	rsec_mask(l, rsec_stored(name, dec, sizeof(dec)), masked, sizeof(masked));
+	n = strlen(masked) * 3 + 1;	/* each char expands to %XX at most, as nvram_char_to_ascii */
+	if (!(enc = malloc(n)))
+		return 0;
+	char_to_ascii_safe(enc, masked, n);
+	ret = websWrite(wp, "%s", enc);
+	free(enc);
+	return ret;
+}
+
+static int rsec_split(char *s, char sep, char **f, int max)
+{
+	char seps[2] = { sep, 0 };
+	char *tok;
+	int n = 0;
+
+	while (n < max && (tok = strsep(&s, seps)) != NULL)
+		f[n++] = tok;
+	return n;
+}
+
+/* the posted list with every RSEC_MASK field taken from the stored one; out, or posted when nothing to do */
+static char *rsec_unmask(const struct rsec_list *l, const char *posted, const char *stored, char *out, size_t cap)
+{
+	char *pc, *sc, *prow[RSEC_ROWS], *srow[RSEC_ROWS], *pf[RSEC_FIELDS], *sf[RSEC_FIELDS];
+	int np, ns, i, j, k, nf, nsf, found;
+	size_t o = 0;
+
+	if (!(pc = strdup(posted)))
+		return (char *)posted;
+	if (!(sc = strdup(stored))) {
+		free(pc);
+		return (char *)posted;
+	}
+	if (l->rowsep) {
+		np = rsec_split(pc, l->rowsep, prow, RSEC_ROWS);
+		ns = rsec_split(sc, l->rowsep, srow, RSEC_ROWS);
+	} else {
+		prow[0] = pc; np = 1;
+		srow[0] = sc; ns = 1;
+	}
+	out[0] = 0;
+	for (i = 0; i < np && o + 1 < cap; i++) {
+		char *rowc = strdup(prow[i]), rep[1024];
+
+		if (!rowc)
+			break;
+		nf = rsec_split(rowc, l->fieldsep, pf, RSEC_FIELDS);
+		rep[0] = 0;
+		if (nf > l->field && !strcmp(pf[l->field], RSEC_MASK)) {
+			/* the stored row with the same key fields, else the one at the same position */
+			found = -1;
+			for (j = 0; j < ns && found < 0 && l->nkey > 0; j++) {
+				char *scopy = strdup(srow[j]);
+				if (!scopy)
+					break;
+				nsf = rsec_split(scopy, l->fieldsep, sf, RSEC_FIELDS);
+				for (k = 0; k < l->nkey && k < nf && k < nsf && !strcmp(pf[k], sf[k]); k++)
+					;
+				if (k == l->nkey && nsf > l->field)
+					found = j;
+				free(scopy);
+			}
+			if (found < 0 && i < ns)
+				found = i;
+			if (found >= 0) {
+				char *scopy = strdup(srow[found]);
+				if (scopy) {
+					nsf = rsec_split(scopy, l->fieldsep, sf, RSEC_FIELDS);
+					if (nsf > l->field && strcmp(sf[l->field], RSEC_MASK))
+						snprintf(rep, sizeof(rep), "%s", sf[l->field]);
+					free(scopy);
+				}
+			}
+			pf[l->field] = rep;		/* "" when nothing was stored: the mask is never kept as a secret */
+		}
+		if (i > 0)
+			out[o++] = l->rowsep;
+		for (k = 0; k < nf && o + 1 < cap; k++) {
+			int w;
+			if (k > 0)
+				out[o++] = l->fieldsep;
+			w = snprintf(out + o, cap - o, "%s", pf[k]);
+			o += (w < 0 || (size_t)w >= cap - o) ? cap - o - 1 : (size_t)w;
+		}
+		free(rowc);
+	}
+	out[o < cap ? o : cap - 1] = 0;
+	free(pc);
+	free(sc);
+	return out;
+}
+
+/* called for every posted name in validate_apply(): the value to check and store */
+static char *reaper_rsec_unmask(webs_t wp, const char *name, char *value, char *buf, size_t cap)
+{
+	const struct rsec_list *l;
+	char dec[8200];
+
+	if (!strstr(value, RSEC_MASK))
+		return value;
+	if ((l = rsec_of(name)))
+		return rsec_unmask(l, value, rsec_stored(name, dec, sizeof(dec)), buf, cap);
+	if (!strcmp(name, "vpnc_pppoe_passwd") && !strcmp(value, RSEC_MASK)) {
+		const char *srv = websGetVar(wp, "vpnc_heartbeat_x", nvram_safe_get("vpnc_heartbeat_x"));
+		const char *usr = websGetVar(wp, "vpnc_pppoe_username", nvram_safe_get("vpnc_pppoe_username"));
+		char *lc = strdup(nvram_safe_get("vpnc_clientlist")), *row, *save = NULL, *f[RSEC_FIELDS];
+		int nf;
+
+		snprintf(buf, cap, "%s", nvram_safe_get("vpnc_pppoe_passwd"));	/* no such profile: the stored password stays */
+		for (row = lc ? strtok_r(lc, "<", &save) : NULL; row; row = strtok_r(NULL, "<", &save)) {
+			nf = rsec_split(row, '>', f, RSEC_FIELDS);
+			if (nf > 4 && !strcmp(f[2], srv) && !strcmp(f[3], usr) && strcmp(f[4], RSEC_MASK)) {
+				snprintf(buf, cap, "%s", f[4]);
+				break;
+			}
+		}
+		free(lc);
+		return buf;
+	}
+	return value;
+}
