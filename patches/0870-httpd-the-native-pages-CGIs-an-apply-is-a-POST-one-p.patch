+/* rewrite SH_DIR/pause with target's line replaced (until == 0 removes it) */
+static void sh_pause_set(const char *target, long long until)
+{
+	FILE *f = fopen(SH_DIR "/pause", "r"), *o;
+	char line[128], key[64];
+
+	snprintf(key, sizeof(key), "%s ", strcmp(target, "all") ? "mac" : "all");
+	if (!(o = fopen(SH_DIR "/pause.tmp", "w"))) {
+		if (f) fclose(f);
+		return;
+	}
+	while (f && fgets(line, sizeof(line), f)) {
+		if (!strcmp(target, "all") && !strncmp(line, "all ", 4))
+			continue;
+		if (strcmp(target, "all") && !strncmp(line, "mac ", 4) && !strncasecmp(line + 4, target, 17))
+			continue;
+		fputs(line, o);
+	}
+	if (f)
+		fclose(f);
+	if (until > 0) {
+		if (!strcmp(target, "all"))
+			fprintf(o, "all %lld\n", until);
+		else
+			fprintf(o, "mac %s %lld\n", target, until);
+	}
+	fclose(o);
+	rename(SH_DIR "/pause.tmp", SH_DIR "/pause");
+}
