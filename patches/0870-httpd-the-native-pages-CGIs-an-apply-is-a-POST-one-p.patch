+		if (reaper_secure_dir(SH_DIR, 0755) != 0) {
+			websWrite(stream, "{\"ok\":0,\"ek\":\"RSHD_E1\"}");
+			return;
+		}
+		sh_pause_set(target, until);
+		notify_rc("start_wallguard_policy");
