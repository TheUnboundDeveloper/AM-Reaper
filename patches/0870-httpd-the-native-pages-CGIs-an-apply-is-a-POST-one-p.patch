+			char gc;
+			if ((f = fopen(SH_DIR "/safesearch", "r"))) {
+				while (fgets(line, sizeof(line), f))
+					if (sscanf(line, "addr %c", &gc) == 1 && strchr(gs, gc))
+						g[strchr(gs, gc) - gs]++;
+				fclose(f);
+			}
+			websWrite(stream, "\"g\":%d,\"b\":%d,\"d\":%d,\"y\":%d,\"Y\":%d,\"at\":%ld}",
+				  g[0], g[1], g[2], g[3], g[4], stat(SH_DIR "/safesearch", &sb) == 0 ? (long)sb.st_mtime : 0L);
+		}
+		websWrite(stream, ",\"pause\":[");
+		if ((f = fopen(SH_DIR "/pause", "r"))) {
+			int k = 0;
+			long long t;
+			char a[40];
+			while (fgets(line, sizeof(line), f)) {
+				if (sscanf(line, "all %lld", &t) == 1 && t > time(NULL))
+					websWrite(stream, "%s{\"t\":\"all\",\"until\":%lld}", k++ ? "," : "", t);
+				else if (sscanf(line, "mac %39s %lld", a, &t) == 2 && t > time(NULL) && sh_mac(a))
+					websWrite(stream, "%s{\"t\":\"%s\",\"until\":%lld}", k++ ? "," : "", a, t);
+			}
+			fclose(f);
+		}
+		websWrite(stream, "]}");
+		return;
+	}
+	if (!strcmp(action, "save")) {
+		/* only the fields sent are saved; a bad line refuses that field and nothing else */
+		static const struct { const char *field, *file; int (*check)(char *); } F[] = {
+			{ "lists", SH_JFFS "/lists", sh_chk_list },
+			{ "block", SH_JFFS "/block", sh_chk_name },
+			{ "allow", SH_JFFS "/allow", sh_chk_name },
+			{ "profiles", SH_JFFS "/profiles", sh_chk_profile },
+			{ "assign", SH_JFFS "/assign", sh_chk_assign },
+			{ "services", SH_JFFS "/services", sh_chk_services },
