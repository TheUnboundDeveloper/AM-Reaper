+	if (!strcmp(action, "config")) {
+		FILE *f;
+		char line[128];
+		websWrite(stream, "{\"ok\":1,\"enable\":%d,\"mode\":\"%s\",\"db\":%d,\"presets\":[",
+			  nvram_get_int("wallguard_enable") == 1, nvram_match("wallguard_mode", "nx") ? "nx" : "null", f_exists(SH_DIR "/db"));
+		for (i = 0; sh_presets[i]; i++)
+			websWrite(stream, "%s{\"id\":\"%s\",\"bit\":%d}", i ? "," : "", sh_presets[i], i + 1);	/* bit = position + 1 */
+		websWrite(stream, "],\"lists\":");
+		sh_json_file(stream, SH_JFFS "/lists");
+		websWrite(stream, ",\"block\":");
+		sh_json_file(stream, SH_JFFS "/block");
+		websWrite(stream, ",\"allow\":");
+		sh_json_file(stream, SH_JFFS "/allow");
+		websWrite(stream, ",\"allow24\":");
+		sh_json_file(stream, SH_JFFS "/allow24");
+		websWrite(stream, ",\"profiles\":");
+		sh_json_file(stream, SH_JFFS "/profiles");
+		websWrite(stream, ",\"assign\":");
+		sh_json_file(stream, SH_JFFS "/assign");
+		/* phase 2: blocked services, schedules, safe search */
+		websWrite(stream, ",\"services\":");
+		sh_json_file(stream, SH_JFFS "/services");
+		websWrite(stream, ",\"sched\":");
+		sh_json_file(stream, SH_JFFS "/sched");
+		websWrite(stream, ",\"safe\":");
+		sh_json_file(stream, SH_JFFS "/safe");
+		websWrite(stream, ",\"catalog\":[");
+		if ((f = fopen(SH_CATALOG, "r"))) {
+			char cl[2048];
+			int k = 0;
+			while (fgets(cl, sizeof(cl), f)) {
+				char *lab, *cat, *e;
+				if (cl[0] == '#' || !(lab = strchr(cl, '|')))
+					continue;
+				*lab++ = 0;
+				if (!(cat = strchr(lab, '|')) || !(e = strchr(cat + 1, '|')))
+					continue;
+				*cat++ = 0;
+				*e = 0;
+				/* the shipped file is plain ASCII; anything that could break the JSON is skipped */
+				if (strpbrk(cl, "\"\\<>") || strpbrk(lab, "\"\\<>") || strpbrk(cat, "\"\\<>"))
+					continue;
+				websWrite(stream, "%s{\"id\":\"%s\",\"l\":\"%s\",\"c\":\"%s\"}", k++ ? "," : "", cl, lab, cat);
+			}
