+/* 2026-10-21 (Long-Term Storage rows for Wallguard / Dreadwatch / Encrypted DNS): bytes of the
+ * regular files directly in <base>/<sub> - lstat, so a link planted on a shared volume counts
+ * nothing - and of a log plus its .1 generation */
+static long long rdev_dir_bytes(const char *base, const char *sub)
+{
+	char dir[200], p[320];
+	struct stat st;
+	struct dirent *e;
+	long long n = 0;
+	DIR *d;
+
+	if (snprintf(dir, sizeof(dir), "%s/%s", base, sub) >= (int)sizeof(dir) ||
+	    lstat(dir, &st) != 0 || !S_ISDIR(st.st_mode) || (d = opendir(dir)) == NULL)
+		return 0;
+	while ((e = readdir(d)) != NULL)
+		if (e->d_name[0] != '.' && snprintf(p, sizeof(p), "%s/%s", dir, e->d_name) < (int)sizeof(p) &&
+		    lstat(p, &st) == 0 && S_ISREG(st.st_mode))
+			n += st.st_size;
+	closedir(d);
+	return n;
+}
+
+static long long rdev_pair_bytes(const char *base, const char *rel)
+{
+	char p[320];
+	struct stat st;
+	long long n = 0;
+
+	if (snprintf(p, sizeof(p), "%s/%s", base, rel) < (int)sizeof(p) && lstat(p, &st) == 0 && S_ISREG(st.st_mode))
+		n += st.st_size;
+	if (snprintf(p, sizeof(p), "%s/%s.1", base, rel) < (int)sizeof(p) && lstat(p, &st) == 0 && S_ISREG(st.st_mode))
+		n += st.st_size;
+	return n;
+}
