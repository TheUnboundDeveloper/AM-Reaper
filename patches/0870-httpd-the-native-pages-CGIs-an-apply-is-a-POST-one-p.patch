+/* ===================================================================
+ * reaper 2026-10-23: reaper_net.cgi - the Network Tools runner (Reaper_Analysis.asp, Reaper_Netstat.asp,
+ * Reaper_WOL.asp). The stock pages run a CALLER-BUILT command line as root (apply.cgi SystemCmd, and
+ * netool.cgi into the rc netool daemon via /bin/sh) behind a charset filter only, so any flag could be
+ * added. Here the page names a TOOL and a TARGET; the server validates the target (host name / IPv4 /
+ * IPv6 / MAC), builds the argv from fixed flags and bounded numbers and runs it with execvp - no shell.
+ * One job at a time (lock), a hard runtime cap (the worker kills the tool), output capped at
+ * RNET_OUTMAX, and the state always ends in DONE (the stock pages polled forever when a command failed
+ * because their end marker was written only on success). Gated on http_id like every Reaper CGI.
+ *   action=start&tool=ping|traceroute|nslookup|netstat|wake&...   -> {"ok":1} | {"ok":0,"error":"E_..."}
+ *   action=status                 -> {"ok":1,"state":"idle|running|done|failed","tool":..,"target":..,"rc":..}
+ *   action=get&from=N             -> status fields + "next" (byte offset) + "text" (output from N, <= 64 KB)
+ *   action=cancel                 -> stop the running tool
+ * =================================================================== */
+#define RNET_DIR	"/tmp/reaper/net"
+#define RNET_LOCK	RNET_DIR "/busy"
+#define RNET_STATE	RNET_DIR "/state"
+#define RNET_OUT	RNET_DIR "/out"
+#define RNET_OUTMAX	(256 * 1024)
+#define RNET_CHUNK	65536
+#define RNET_RECLAIM	330	/* s: older than every tool's cap (traceroute 310 s) = a dead worker's lock */
+
+struct rnet_job {
+	char tool[16];
+	char target[256];
+	int limit;			/* s: hard runtime cap */
+	int argc;
+	char *argv[16];
+	char store[16][256];	/* review 2026-10-24 (S-B-5): a 253-byte host name must fit whole */
+};
+static struct rnet_job rnet_job;
+
+static void rnet_arg(struct rnet_job *j, const char *a)
+{
+	if (j->argc >= 15)
+		return;
+	strlcpy(j->store[j->argc], a, sizeof(j->store[0]));
+	j->argv[j->argc] = j->store[j->argc];
+	j->argc++;
+	j->argv[j->argc] = NULL;
+}
+
+static void rnet_argn(struct rnet_job *j, int n)
+{
+	char num[16];
+	snprintf(num, sizeof(num), "%d", n);
+	rnet_arg(j, num);
+}
+
+/* host name (RFC 1123 labels, <= 253), IPv4 or IPv6 (fam 4 / 6 / 0 = any); a leading '-' would be an option */
+static int rnet_host_ok(const char *s, int fam)
+{
+	struct in_addr a4;
+	struct in6_addr a6;
+	size_t len = strlen(s), lab = 0;
+	const char *p;
+
+	if (len == 0 || len > 253 || s[0] == '-')
+		return 0;
+	if (inet_pton(AF_INET, s, &a4) == 1)
+		return fam != 6;
+	if (inet_pton(AF_INET6, s, &a6) == 1)
+		return fam != 4;
+	for (p = s; *p; p++) {
+		if (*p == '.') {
+			if (lab == 0 || p[-1] == '-')
+				return 0;
+			lab = 0;
+			continue;
+		}
+		if (!isalnum((unsigned char)*p) && *p != '-')
+			return 0;
+		if (lab == 0 && *p == '-')
+			return 0;
+		if (++lab > 63)
+			return 0;
+	}
+	return lab > 0 && p[-1] != '-';
+}
+
+static int rnet_mac_ok(const char *s)
+{
+	return gk_valid_mac(s);		/* review 2026-10-24 (Q-B-9): the one copy of this rule */
+}
+
+/* bounded decimal; dflt when absent, -1 when present but out of range */
+static int rnet_num(const char *s, int lo, int hi, int dflt)
+{
+	char *e;
+	long v;
+
+	if (!s || !*s)
+		return dflt;
+	v = strtol(s, &e, 10);
+	if (*e || v < lo || v > hi)
+		return -1;
+	return (int)v;
+}
+
+/* the argv for one request, from fixed flags only; NULL = ok, else an error code for the page */
+static const char *rnet_build(struct rnet_job *j)
+{
+	char *tool = get_cgi("tool"), *target = get_cgi("target"), *ver = get_cgi("ver");
+	int fam = (ver && !strcmp(ver, "6")) ? 6 : 4, n;
+
+	memset(j, 0, sizeof(*j));
+	if (!tool)
+		return "E_TOOL";
+	if (!target)
+		target = "";
+	strlcpy(j->tool, tool, sizeof(j->tool));
+	if (!strcmp(tool, "ping")) {
+		/* count up to 240: the page's continuous mode is one long run it reads as it grows */
+		if (!rnet_host_ok(target, fam))
+			return "E_TARGET";
+		if ((n = rnet_num(get_cgi("count"), 1, 240, 5)) < 0)
+			return "E_COUNT";
+		rnet_arg(j, fam == 6 ? "ping6" : "ping");
+		rnet_arg(j, "-c"); rnet_argn(j, n);
+		rnet_arg(j, "-w"); rnet_argn(j, n + 5);
+		rnet_arg(j, target);
+		j->limit = n + 10;
+	} else if (!strcmp(tool, "traceroute")) {
+		char *num = get_cgi("numeric");
+		if (!rnet_host_ok(target, fam))
+			return "E_TARGET";
+		if ((n = rnet_num(get_cgi("hops"), 1, 30, 30)) < 0)
+			return "E_COUNT";
+		rnet_arg(j, "/usr/sbin/traceroute");
+		rnet_arg(j, fam == 6 ? "-6" : "-4");
+		if (num && !strcmp(num, "1"))
+			rnet_arg(j, "-n");
+		rnet_arg(j, "-m"); rnet_argn(j, n);
+		rnet_arg(j, "-w"); rnet_arg(j, "3");
+		rnet_arg(j, target);
+		j->limit = n * 10 + 10;
+	} else if (!strcmp(tool, "nslookup")) {
+		/* a name only, never a server: busybox 1.25 silently ignores an IPv6 server address */
+		if (!rnet_host_ok(target, 0))
+			return "E_TARGET";
+		rnet_arg(j, "nslookup");
+		rnet_arg(j, target);
+		j->limit = 30;
+	} else if (!strcmp(tool, "netstat")) {
+		/* bits: 1 listening, 2 all, 4 numeric, 8 tcp, 16 udp, 32 raw, 64 unix, 128 routes, 256 program */
+		static const char letter[] = "lantuwxrp";
+		char opt[16] = "-W";
+		int i, k = 2;
+		if ((n = rnet_num(get_cgi("opts"), 0, 511, 2 + 4 + 8 + 16)) < 0)
+			return "E_OPTS";
+		for (i = 0; i < 9; i++)
+			if (n & (1 << i))
+				opt[k++] = letter[i];
+		opt[k] = '\0';
+		rnet_arg(j, "netstat");
+		rnet_arg(j, opt);
+		target = "";
+		j->limit = 20;
+	} else if (!strcmp(tool, "wake")) {
+		char *ifc = get_cgi("iface"), path[48];
+		struct stat st;
+		if (!rnet_mac_ok(target))
+			return "E_MAC";
+		if (!ifc || !*ifc)
+			ifc = "br0";
+		/* a LAN bridge that exists: brN (main LAN br0, SDN bridges br52...) */
+		if (strncmp(ifc, "br", 2) || !ifc[2] || strlen(ifc) > 6 || strspn(ifc + 2, "0123456789") != strlen(ifc + 2))
+			return "E_IFACE";
+		snprintf(path, sizeof(path), "/sys/class/net/%s", ifc);
+		if (stat(path, &st) != 0)
+			return "E_IFACE";
+		rnet_arg(j, "ether-wake");
+		rnet_arg(j, "-i"); rnet_arg(j, ifc);
+		rnet_arg(j, "-b");
+		rnet_arg(j, target);
+		j->limit = 10;
+	} else
+		return "E_TOOL";
+	strlcpy(j->target, target[0] ? target : "-", sizeof(j->target));
+	return NULL;
+}
+
+static void rnet_state(const char *word, long a, int b, const struct rnet_job *j)
+{
+	FILE *f = fopen(RNET_STATE ".tmp", "w");
+
+	if (!f)
+		return;
+	fprintf(f, "%s %ld %d %s %s\n", word, a, b, j->tool, j->target);
+	fclose(f);
+	rename(RNET_STATE ".tmp", RNET_STATE);
+}
+
+/* the detached worker: run the tool with its output on a pipe, copy it (capped) to RNET_OUT, kill it at
+ * the cap, and always finish with DONE <exit code> <killed> */
+static void rnet_worker(void *arg)
+{
+	struct rnet_job *j = (struct rnet_job *)arg;
+	int pfd[2] = { -1, -1 }, status = 0, killed = 0, fd, code = -1;
+	pid_t c = -1;
+	char buf[2048];
+	ssize_t n;
+	size_t total = 0;
+	time_t t0 = time(NULL);
+
+	signal(SIGCHLD, SIG_DFL);	/* httpd's disposition must not auto-reap the tool before waitpid */
+	signal(SIGPIPE, SIG_IGN);
+	fd = open(RNET_OUT, O_WRONLY | O_CREAT | O_TRUNC, 0600);
+	if (fd < 0 || pipe(pfd) != 0)
+		goto done;
+	c = fork();
+	if (c == 0) {
+		dup2(pfd[1], 1);
+		dup2(pfd[1], 2);
+		close(pfd[0]);
+		close(pfd[1]);
+		close(fd);
+		setenv("PATH", "/bin:/sbin:/usr/bin:/usr/sbin", 1);
+		execvp(j->argv[0], j->argv);
+		_exit(127);
+	}
+	close(pfd[1]);
+	if (c < 0)
+		goto done;
+	rnet_state("RUNNING", (long)c, 0, j);
+	fcntl(pfd[0], F_SETFL, O_NONBLOCK);
+	for (;;) {
+		n = read(pfd[0], buf, sizeof(buf));
+		if (n > 0) {
+			if (total < RNET_OUTMAX) {
+				size_t w = (size_t)n;
+				if (total + w > RNET_OUTMAX)
+					w = RNET_OUTMAX - total;
+				if (write(fd, buf, w) < 0)
+					break;
+				total += w;
+			}
+			continue;
+		}
+		if (n == 0)
+			break;		/* the tool closed its output */
+		if (errno != EAGAIN && errno != EINTR)
+			break;
+		if (time(NULL) - t0 > j->limit) {
+			kill(c, killed ? SIGKILL : SIGTERM);
+			if (++killed > 3)
+				break;
+			sleep(1);
+			continue;
+		}
+		{
+			/* review 2026-10-24 (Q-B-11): wait for output (or 1 s, for the deadline) instead of waking
+			   five times a second for up to five minutes */
+			struct pollfd pf = { pfd[0], POLLIN, 0 };
+			poll(&pf, 1, 1000);
+		}
+	}
+	if (killed)
+		kill(c, SIGKILL);
+	if (waitpid(c, &status, 0) == c && WIFEXITED(status))
+		code = WEXITSTATUS(status);
+done:
+	if (pfd[0] >= 0)
+		close(pfd[0]);
+	if (fd >= 0)
+		close(fd);
+	rnet_state("DONE", code, killed ? 1 : 0, j);
+	unlink(RNET_LOCK);
+}
+
+static void
+do_reaper_net_cgi(char *url, FILE *stream)
+{
+	char *act = get_cgi("action"), line[400], word[16], tool[16], target[256];
+	const char *sstate;
+	long a = 0, lock_age = -1;
+	int b = 0, running, why;
+	struct stat st;
+	FILE *f;
+
+	why = reaper_gate();
+	if (why != RGATE_OK) {
+		reaper_gate_deny(stream, why, "RNET");
+		return;
+	}
+	if (!act || !*act)
+		act = "status";
+	if (stat(RNET_LOCK, &st) == 0)
+		lock_age = (long)(time(NULL) - st.st_mtime);
+
+	if (!strcmp(act, "start")) {
+		const char *err;
+		/* validate first: a bad request gets its own error even while a job runs. rnet_build
+		 * fills the static job, which only the next detach copies - a running worker has its own. */
+		if ((err = rnet_build(&rnet_job)) != NULL) {
+			websWrite(stream, "{\"ok\":0,\"error\":\"%s\"}", err);
+			return;
+		}
+		if (lock_age >= 0 && lock_age < RNET_RECLAIM) {
+			websWrite(stream, "{\"ok\":0,\"error\":\"E_BUSY\"}");
+			return;
+		}
+		reaper_secure_dir(REAPER_TMPDIR, 0700);	/* reaper 2026-10-23: never a plain mkdir in /tmp (link-safe, owner/mode checked) */
+		reaper_secure_dir(RNET_DIR, 0700);
+		unlink(RNET_OUT);
+		if ((f = fopen(RNET_LOCK, "w")) != NULL)
+			fclose(f);
+		rnet_state("RUNNING", 0, 0, &rnet_job);
+		logmessage("reaper_net", "%s %s", rnet_job.tool, rnet_job.target);
+		reaper_detach(rnet_worker, &rnet_job);
+		websWrite(stream, "{\"ok\":1}");
+		return;
+	}
+
+	word[0] = tool[0] = target[0] = '\0';
+	if ((f = fopen(RNET_STATE, "r")) != NULL) {
+		if (fgets(line, sizeof(line), f) != NULL &&
+		    sscanf(line, "%15s %ld %d %15s %255s", word, &a, &b, tool, target) < 3)
+			word[0] = '\0';
+		fclose(f);
+	}
+	running = !strcmp(word, "RUNNING") && lock_age >= 0 && lock_age < RNET_RECLAIM;
+	sstate = running ? "running" : !strcmp(word, "DONE") ? "done" : word[0] ? "failed" : "idle";
+
+	if (!strcmp(act, "cancel")) {
+		/* only a tool this runner starts: check the pid's name before signalling it */
+		if (running && a > 1) {
+			char path[48], comm[32] = "";
+			FILE *cf;
+			snprintf(path, sizeof(path), "/proc/%ld/comm", a);
+			if ((cf = fopen(path, "r")) != NULL) {
+				if (fgets(comm, sizeof(comm), cf) == NULL)
+					comm[0] = '\0';
+				fclose(cf);
+			}
+			comm[strcspn(comm, "\n")] = '\0';
+			if (!strcmp(comm, "ping") || !strcmp(comm, "ping6") || !strcmp(comm, "traceroute") ||
+			    !strcmp(comm, "nslookup") || !strcmp(comm, "netstat") || !strcmp(comm, "ether-wake"))
+				kill((pid_t)a, SIGTERM);
+		}
+		websWrite(stream, "{\"ok\":1}");
+		return;
+	}
+	if (strcmp(act, "status") && strcmp(act, "get")) {
+		websWrite(stream, "{\"ok\":0,\"error\":\"E_ACTION\"}");
+		return;
