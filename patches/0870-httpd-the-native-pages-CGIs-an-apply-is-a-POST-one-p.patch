+/* reaper 2026-10-23: the exact SystemCmd shapes the stock Network Tools pages build (Main_Netstat,
+ * Main_ConnStatus, Main_Analysis, Main_WOL). The charset filter in apply_cgi blocks shell syntax but not
+ * extra OPTIONS, so a caller could add any flag (-w 99999, -I <iface>, ether-wake -p <password> ...). The
+ * stock path stays for the stock pages and the ASUS app (owner: keep, harden); only these shapes pass, with
+ * the host / MAC checked by the Reaper Network Tools runner's validators. mac (optional) receives the
+ * validated WOL target. (rnet_host_ok / rnet_mac_ok are declared above send_netool_req.) */
+static int reaper_syscmd_shape_ok(const char *page, const char *cmd, char *mac, size_t maclen)
+{
+	char buf[160], *tok[8], *p, *save = NULL;
+	struct in_addr a4;
+	int n = 0, i;
+
+	if (!page || !cmd || strlen(cmd) >= sizeof(buf))
+		return 0;
+	strlcpy(buf, cmd, sizeof(buf));
+	for (p = strtok_r(buf, " \t\v\f", &save); p; p = strtok_r(NULL, " \t\v\f", &save)) {
+		if (n == 8)
+			return 0;
+		tok[n++] = p;
+	}
+	if (n == 0)
+		return 0;
+	if (!strcmp(page, "Main_Netstat_Content.asp") && !strcasecmp(tok[0], "netstat")) {
+		static const char *opt[] = { "-pa", "-pt", "-pu", "-pw", "-px", "-pl", "-r", NULL };
+		if (n < 2 || n > 3)
+			return 0;
+		for (i = 0; opt[i] && strcmp(tok[1], opt[i]); i++)
+			;
+		return opt[i] && (n == 2 || !strcmp(tok[2], "-n"));
+	}
+	if ((!strcmp(page, "Main_Netstat_Content.asp") || !strcmp(page, "Main_ConnStatus_Content.asp")) &&
+	    !strcasecmp(tok[0], "netstat-nat")) {
+		if (n < 2)
+			return 0;
+		i = 2;
+		if (!strcmp(tok[1], "-s")) {
+			if (n > 2 && strcmp(tok[2], "-n")) {
+				if (inet_pton(AF_INET, tok[2], &a4) != 1)
+					return 0;
+				i = 3;
+			}
+		} else if (strcmp(tok[1], "-L") && strcmp(tok[1], "-S"))
+			return 0;
+		return n == i || (n == i + 1 && !strcmp(tok[i], "-n"));
+	}
+	if (!strcmp(page, "Main_Analysis_Content.asp")) {
+		if (!strcasecmp(tok[0], "ping"))
+			return n == 4 && !strcmp(tok[1], "-c") && isValid_digit_string(tok[2]) && rnet_host_ok(tok[3], 0);
+		if (!strcasecmp(tok[0], "traceroute") || !strcasecmp(tok[0], "nslookup"))
+			return n == 2 && rnet_host_ok(tok[1], 0);
+		return 0;
+	}
+	if (!strcmp(page, "Main_WOL_Content.asp") && !strcasecmp(tok[0], "ether-wake")) {
+		const char *m;
+		if (n == 5 && !strcmp(tok[1], "-i") && !strcmp(tok[2], "br0") && !strcmp(tok[3], "-b"))
+			m = tok[4];
+		else if (n == 4 && !strcmp(tok[1], "-i") && !strcmp(tok[2], "br0"))
+			m = tok[3];
+		else
+			return 0;
+		if (!rnet_mac_ok(m))
+			return 0;
+		if (mac)
+			strlcpy(mac, m, maclen);
+		return 1;
+	}
+	return 0;
+}
