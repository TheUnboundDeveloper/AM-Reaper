From 9923c7d608a435d3a766cc645a4cd5a3d789c1f7 Mon Sep 17 00:00:00 2001
From: reaper <theunbounddeveloper@outlook.com>
Date: Sun, 25 Oct 2026 22:49:20 -0400
Subject: [PATCH] reaper_diag v1.3.46 - v1.3.49

v1.3.46 reads Dreadwatch's compiled table (names, gzip copies, size, how many
instances map it); v1.3.47 reads file times with `date -r` (no stat applet);
v1.3.48 dumps nvram once and counts the syslog in one awk pass; v1.3.49 says in
section 5 when /jffs/configs/dnsmasq.conf replaces the generated config and when
a local upstream in the live config has nothing listening, each with a finding.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 release/src/router/others/reaper_diag  | 163 ++++++++++++++++++-------
 release/src/router/www/Reaper_Diag.asp |   2 +-
 2 files changed, 120 insertions(+), 45 deletions(-)

diff --git a/release/src/router/others/reaper_diag b/release/src/router/others/reaper_diag
index 4eb3f4294f..74ecb0dede 100644
--- a/release/src/router/others/reaper_diag
+++ b/release/src/router/others/reaper_diag
@@ -1,7 +1,13 @@
 #!/bin/sh
 # ============================================================================
-#  REAPER-DIAG v1.3.45 (2026-10-20) - sanitized one-shot diagnostic bundle
-#  v1.3.45 counts files and folders under /jffs that any user can write (section 3; rc
+#  REAPER-DIAG v1.3.49 (2026-10-25) - sanitized one-shot diagnostic bundle
+#  v1.3.49 says in 5 when /jffs/configs/dnsmasq.conf replaces the generated config (add-on residue) and when a
+#  local-port upstream in the live config has nothing listening (GT-BE98 ControlD report).
+#  v1.3.48 does the same work with fewer processes: one nvram dump, one /proc walk, one pass for 19b's counts.
+#  v1.3.47 reads the /jffs copy's time with date -r (this busybox has no stat applet; v1.3.46 showed built=never).
+#  v1.3.46 reads Dreadwatch's compiled table in 14: the name count from rc's count file, the gzip copies, the table
+#  and how many dnsmasq instances map it (the _r35 report carried a false "no list loaded" against the two-line
+#  include). v1.3.45 counts files and folders under /jffs that any user can write (section 3; rc
 #  removes that at every boot, so a count is a regression). v1.3.44 guards the Dreadwatch pending count in 14: no hits file reads 0, not a
 #  shell error (the first r3 report carried one). v1.3.43 adds the Dreadwatch line in 14 (threat-domain block counts per feed,
 #  never a name or a device). v1.3.42 adds the Gatekeeper DNS sinkhole line in 14b (held devices' resolver:
@@ -153,13 +159,15 @@
 #       rewrite it to [EXT-IP-n] and the line loses its meaning; print the
 #       NAME of the target instead ("Google-DNS"), as section 16 does.
 #
-#  COST NOTE: httpd is single-threaded and do_reaper_diag_cgi() popen()s this
-#  script, so the whole GUI is blocked while it runs. Everything added in
-#  v1.2.0 is bounded: the probes use short deadlines and the accelerator reads
-#  are one-shot cats. Do not add an unbounded command here.
+#  COST NOTE: httpd runs this script in a detached worker (reaper_detach), so
+#  the GUI is not blocked while it runs - but the router is, a little: keep
+#  every command bounded (the probes use short deadlines, the accelerator reads
+#  are one-shot cats). v1.3.48: nvram is dumped ONCE ($NVS), /proc is walked
+#  once without forking cat, and 19b counts its patterns in one awk pass. Do
+#  not add an unbounded command here.
 # ============================================================================
 PATH=/sbin:/bin:/usr/sbin:/usr/bin
-VER="REAPER-DIAG v1.3.45"
+VER="REAPER-DIAG v1.3.49"
 T0="$(date +%s 2>/dev/null)"
 MODEL="$(nvram get productid 2>/dev/null)"
 EXTNO="$(nvram get extendno 2>/dev/null)"
@@ -178,10 +186,16 @@ RAW2="$SCR/.rdiag_raw2.$$"
 SNAP="$SCR/.rdiag_syslog.$$"
 CTS="$SCR/.rdiag_ct.$$"
 DFS="$SCR/.rdiag_dnsf.$$"
+NVS="$SCR/.rdiag_nv.$$"
+CPUF="$SCR/.rdiag_cpu.$$"
 OUT="/tmp/reaper_diag_${MODEL}_${STAMP}.txt"
 umask 077
-trap 'rm -f $RAW $RAW2 $SLIST $SLIST.s $AWKP $AWKP.* $BODY $BODY.* $LEDG $FIND $SNAP $CTS $DFS' EXIT
+trap 'rm -f $RAW $RAW2 $SLIST $SLIST.s $AWKP $AWKP.* $BODY $BODY.* $LEDG $FIND $SNAP $CTS $DFS $NVS $CPUF' EXIT
 : > "$FIND"
+# v1.3.48 (review 2026-10-24, Q-B-8): ONE dump of the whole nvram store for every section that reads it
+# (it was seven `nvram show` runs, ~60-100 KB each). It holds secrets, so it lives with $SLIST: in Reaper's
+# root-only 0700 directory, mode 0600 (umask above), removed by the trap.
+nvram show > "$NVS" 2>/dev/null
 
 sec() { echo ""; echo "#### $1 ####"; }
 have() { type "$1" >/dev/null 2>&1; }  # v1.0.1: on-router busybox ash lacks "command -v"
@@ -204,9 +218,9 @@ wprobe() {
   [ -n "$_hit" ] && echo "  $_l : IN SET ->$_hit" || echo "  $_l : not in any Warden set"
 }
 
-# Bounded reachability probe. httpd is single-threaded and blocked for the whole
-# run, so the packet count and per-packet timeout are deliberately small; worst
-# case is ~3 s per target and typical is well under 1 s.
+# Bounded reachability probe. The packet count and per-packet timeout are
+# deliberately small (the run should stay short even though httpd is no longer
+# blocked by it); worst case is ~3 s per target and typical is well under 1 s.
 probe() {
   _l="$1"; _a="$2"
   have ping || { echo "  $_l : ping absent"; return; }
@@ -297,7 +311,7 @@ slog_files() {
 # ---------------------------------------------------------------------------
 # 1. Collect sensitive literals -> $SLIST as "CLASS<TAB>value" (never printed)
 # ---------------------------------------------------------------------------
-nvram show 2>/dev/null | awk -F= '
+awk -F= '
   /^[A-Za-z0-9_.]+=/ {
     k=$1; sub(/^[^=]*=/,""); v=$0
     if (length(v) < 5) next
@@ -308,7 +322,7 @@ nvram show 2>/dev/null | awk -F= '
     else if (k ~ /_ssid$/) cls="SSID"
     else if (k ~ /ddns_hostname|_hostname$|computer_name|lan_domain|ddns_username/) cls="HOST"
     if (cls != "") print cls "\t" v
-  }' > "$SLIST" 2>/dev/null
+  }' "$NVS" > "$SLIST" 2>/dev/null
 # DHCP client hostnames (dnsmasq leases field 4)
 for LF in /var/lib/misc/dnsmasq.leases /tmp/var/lib/misc/dnsmasq.leases /jffs/nmp/dnsmasq.leases; do
   [ -f "$LF" ] && awk '{ if ($4 != "*" && length($4) >= 5) print "HOST\t" $4 }' "$LF" >> "$SLIST" 2>/dev/null && break
@@ -749,9 +763,9 @@ sec "3b. NVRAM HYGIENE (names and sizes only - values never printed)"
 # value is within reach of that cap are the next silent failure; the ones
 # Asuswrt-Merlin already routes to /jffs (custom_clientlist, dhcp_staticlist,
 # vpn lists...) are safe and listed only for completeness.
-NVTOT="$(nvram show 2>/dev/null | wc -c)"; NVSZ="$(nvram show 2>/dev/null | sed -n 's/^size: \([0-9]*\) bytes.*/\1/p' | head -1)"
+NVTOT="$(wc -c < "$NVS" 2>/dev/null | tr -d ' ')"; NVSZ="$(sed -n 's/^size: \([0-9]*\) bytes.*/\1/p' "$NVS" 2>/dev/null | head -1)"
 echo "  nvram total       : ${NVTOT:-?} bytes of text$( [ -n "$NVSZ" ] && echo " (reported size: $NVSZ)")"
-NVBIG="$(nvram show 2>/dev/null | awk -F= '/^[A-Za-z0-9_.]+=/ { if (length($0) > 900) print "  " $1 " (" length($0) " bytes)" }')"
+NVBIG="$(awk -F= '/^[A-Za-z0-9_.]+=/ { if (length($0) > 900) print "  " $1 " (" length($0) " bytes)" }' "$NVS" 2>/dev/null)"
 if [ -n "$NVBIG" ]; then
   echo "  values >900 bytes (1 KB tuple cap):"; echo "$NVBIG"
   # v1.3.1: a Reaper-owned name near the cap is a real defect (only Merlin's
@@ -996,6 +1010,38 @@ if [ "$(nvram get reaper_landns_enable 2>/dev/null)" != 0 ]; then
     "")    [ "$LDRUN" = no ] && [ "$(nvram get sw_mode 2>/dev/null)" = 1 ] && finding INFO "LAN name resolution check is on but rdnshc is not running - the dashboard shows no verdict (see 5)";;
   esac
 fi
+# v1.3.49 (2026-10-25; GT-BE98 ControlD report 2026-10-21): a /jffs/configs/dnsmasq.conf REPLACES the generated
+# /etc/dnsmasq.conf whole (shared/scripts.c use_custom_config, unless custom scripts are off) and /jffs survives
+# every flash and downgrade, so an add-on removed without its cleanup leaves DNS (and DHCP) on the add-on's config.
+# The servers-file above is then not what dnsmasq reads: the live config's own upstreams, by role, and whether a
+# local-port upstream has anything listening (ControlD's ctrld sits on 127.0.0.1#5354).
+CDC=/jffs/configs/dnsmasq.conf
+if [ -f "$CDC" ]; then
+  if [ "$(nvram get jffs2_scripts 2>/dev/null)" = 0 ]; then
+    echo "  custom dnsmasq.conf: present, NOT in use (custom scripts are off)"
+  else
+    echo "  custom dnsmasq.conf: IN USE - replaces the generated /etc/dnsmasq.conf ($(grep -c . "$CDC" 2>/dev/null) lines)"
+    finding WARN "/jffs/configs/dnsmasq.conf REPLACES the router's generated DNS/DHCP config - add-on residue survives every flash and downgrade; if no add-on needs it, move it aside and restart dnsmasq (see 5)"
+  fi
+fi
+LSF=no; grep -q '^servers-file=' /etc/dnsmasq.conf 2>/dev/null && LSF=yes
+LSV=""; LEXT=0; LDEAD=""
+for u in $(sed -n 's/^server=\([^/][^ ]*\)$/\1/p' /etc/dnsmasq.conf 2>/dev/null); do
+  r="$(ldrole "$u")"; LSV="$LSV $r"
+  case "$r" in
+    local*) p=53; case "$u" in *#*) p="${u#*#}";; esac
+            netstat -tuln 2>/dev/null | awk '{print $4}' | grep -q ":$p\$" || LDEAD="$LDEAD $r";;
+    *) LEXT=$((LEXT+1));;
+  esac
+done
+echo "  live dnsmasq.conf : servers-file=$LSF own upstreams=${LSV:- none} local-with-no-listener=${LDEAD:- none}"
+if [ -n "$LDEAD" ]; then
+  if [ "$LSF" = no ] && [ "$LEXT" = 0 ]; then
+    finding WARN "dnsmasq's only upstream is a local port with nothing listening ($LDEAD) - every new name fails; an add-on's resolver (ControlD, a DoH proxy) is gone but its config stayed (see 5)"
+  else
+    finding INFO "dnsmasq names a local upstream with nothing listening ($LDEAD) - lookups sent there time out before another server is tried (see 5)"
+  fi
+fi
 # v1.3.32: reverse DNS across networks (r24) and IPv6 device names (rc/rv6names.c). Counts only.
 echo "  device names      : across-networks=$(nvram get reaper_dns_revshare 2>/dev/null) ipv6-names=$(nvram get reaper_dns_v6names 2>/dev/null) rv6names-running=$(ps w 2>/dev/null | grep -c '[r]v6names')"
 for C in /etc/dnsmasq.conf /etc/dnsmasq-*.conf; do
@@ -1102,7 +1148,7 @@ sec "7. WIRELESS (radios discovered at runtime)"
 if pidof roamast >/dev/null 2>&1; then RAST=running; else RAST=not-running; fi
 echo "  roaming assistant : roamast=$RAST  roamast_disable=$(nvram get roamast_disable 2>/dev/null)  disable_exap=$(nvram get disable_exap 2>/dev/null)"
 APGS=""
-for k in $(nvram show 2>/dev/null | grep -E '^apg[0-9]+_timesched=1$' | cut -d_ -f1); do APGS="$APGS $k"; done
+for k in $(grep -E '^apg[0-9]+_timesched=1$' "$NVS" 2>/dev/null | cut -d_ -f1); do APGS="$APGS $k"; done
 echo "  SDN access-time schedules on:${APGS:- none}"
 u=0; while [ $u -le 3 ]; do
   IFN="$(nvram get wl${u}_ifname 2>/dev/null)"
@@ -1434,11 +1480,20 @@ sec "12b. PROCESS HEALTH (stuck readers, D-state, top CPU - command names only)"
 # The libnvram netlink wait-forever hang (v2.6.1 guard) shows up as an `nvram`
 # process that is minutes old and asleep in __skb_wait_for_more_packets.
 UPNOW="$(cut -d. -f1 /proc/uptime)"; STUCK=0; DST=0; ZOMB=0
+# v1.3.48 (Q-B-8): ONE walk of /proc, the stat line read by the shell itself (it forked cat ~300 times, twice);
+# the CPU totals for the top-5 list below are collected on the same pass
+: > "$CPUF"
 for PD in /proc/[0-9]*; do
   PID="${PD#/proc/}"; [ -r "$PD/stat" ] || continue
-  LINE="$(cat $PD/stat 2>/dev/null)" || continue
+  { read -r LINE < "$PD/stat"; } 2>/dev/null || continue
   CMD="${LINE#*(}"; CMD="${CMD%%)*}"; REST="${LINE##*) }"
   set -- $REST; STATE="$1"; STT="${20}"
+  # ${12}/${13} = utime/stime: REST begins at /proc/<pid>/stat field 3, so
+  # fields 14/15 land on positionals 12/13. BusyBox ash reads a bare $12 as
+  # positional 12 and this has always been correct on the router -- verified
+  # on metal 2026-09-10, identical output either way. The braces are for
+  # POSIX: any other sh reads $12 as ${1}2, which would silently print 0s.
+  echo "$(( (${12} + ${13}) / 100 )) $CMD $PID" >> "$CPUF"
   AGE=$((UPNOW - STT / 100))
   case "$STATE" in
     D) DST=$((DST+1)); echo "  D-state   pid=$PID $CMD age=${AGE}s wchan=$(cat $PD/wchan 2>/dev/null)";;
@@ -1453,16 +1508,7 @@ echo "  stuck readers >60s: $STUCK   D-state: $DST   zombies: $ZOMB"
 [ "$STUCK" -gt 0 ] && finding WARN "$STUCK stuck nvram/netfilter reader process(es) older than 60 s - see 12b (libnvram netlink hang signature)"
 [ "$DST" -gt 0 ] && finding WARN "$DST process(es) in uninterruptible D-state - see 12b"
 echo "  -- top 5 by accumulated CPU (utime+stime, seconds) --"
-for PD in /proc/[0-9]*; do
-  LINE="$(cat $PD/stat 2>/dev/null)" || continue
-  CMD="${LINE#*(}"; CMD="${CMD%%)*}"; REST="${LINE##*) }"
-  # ${12}/${13} = utime/stime: REST begins at /proc/<pid>/stat field 3, so
-  # fields 14/15 land on positionals 12/13. BusyBox ash reads a bare $12 as
-  # positional 12 and this has always been correct on the router -- verified
-  # on metal 2026-09-10, identical output either way. The braces are for
-  # POSIX: any other sh reads $12 as ${1}2, which would silently print 0s.
-  set -- $REST; echo "$(( (${12} + ${13}) / 100 )) $CMD ${PD#/proc/}"
-done | sort -rn | head -5 | awk '{printf "  %6ss  %-20s pid=%s\n", $1, $2, $3}'
+sort -rn "$CPUF" 2>/dev/null | head -5 | awk '{printf "  %6ss  %-20s pid=%s\n", $1, $2, $3}'
 echo "  -- memory --"; grep -E '^(MemFree|MemAvailable|Slab|Committed_AS|SwapTotal|SwapFree)' /proc/meminfo 2>/dev/null | sed 's/^/  /'
 
 sec "12c. REAPER SERVICES vs. THEIR SWITCHES"
@@ -1534,21 +1580,33 @@ echo "  entware: $( [ -d /opt/bin ] && echo present || echo absent )"
 echo "  amtm-ish mounts: $(mount 2>/dev/null | grep -c /tmp/mnt)"
 
 sec "14. FIREWALL / WARDEN (counters and set SIZES - contents never dumped)"
-nvram show 2>/dev/null | grep '^rwarden_' | sort | sed 's/^/  /'
+grep '^rwarden_' "$NVS" 2>/dev/null | sort | sed 's/^/  /'
 # v1.3.41: threat domains (rwarden_dns) - the list dnsmasq answers NXDOMAIN for: how many
 # names, the /jffs copy, when it was last built, and how many of the dnsmasq instances
 # (main + one per guest/VLAN network) were started with the include. Names never dumped.
 # v1.3.43 (Dreadwatch): the list is reaper-nx= lines (address= on a box that has not rebuilt it
 # since the update) with a counted /jffs copy (dns.nx; the old dns.cache only before the first
 # rebuild); the hit counters - totals and per-feed counts only, never a name or a device address.
-_td="$(nvram get rwarden_dns 2>/dev/null)"; _tdn=$(grep -c -e '^reaper-nx=' -e '^address=' /tmp/rwarden/dns.conf 2>/dev/null); _tdu=$(cat /tmp/rwarden/dns.upd 2>/dev/null)
+# v1.3.46 (2026-10-24): the list is ONE compiled table (/tmp/reaper_nx/threat.db, wallguardc) that every dnsmasq instance
+# maps read-only; the include is two constant lines, so the count is rc's dns.count (reaper-nx=/address= lines only on
+# a firmware before the table), the /jffs copy is dns.k.gz (dns.nx.gz = the older form, still written for a downgrade)
+# and "built" falls back to that copy's time after a reboot. An instance maps the table at its first query, so a low
+# mapped_by right after boot is normal; a MISSING table with names counted means they resolve unfiltered until rc
+# rebuilds it. Counts and sizes only.
+_td="$(nvram get rwarden_dns 2>/dev/null)"; _tdn=$(cat /tmp/rwarden/dns.count 2>/dev/null); _tdu=$(cat /tmp/rwarden/dns.upd 2>/dev/null)
+case "$_tdn" in ''|*[!0-9]*) _tdn=$(grep -c -e '^reaper-nx=' -e '^address=' /tmp/rwarden/dns.conf 2>/dev/null);; esac
 case "$_tdn" in ''|*[!0-9]*) _tdn=0;; esac
+[ -n "$_tdu" ] || _tdu=$(date -r /jffs/rwarden/dns.k.gz +%s 2>/dev/null)	# no stat applet in this busybox (v1.3.47)
+_tdt=0; [ -s /tmp/reaper_nx/threat.db ] && _tdt=$(wc -c < /tmp/reaper_nx/threat.db 2>/dev/null | tr -d ' '); case "$_tdt" in ''|*[!0-9]*) _tdt=0;; esac
+_tdm=0; for _p in $(pidof dnsmasq 2>/dev/null); do grep -q '/tmp/reaper_nx/threat.db' /proc/$_p/maps 2>/dev/null && _tdm=$((_tdm+1)); done
 _tdc=$(ls /etc/dnsmasq.conf /etc/dnsmasq-*.conf 2>/dev/null | wc -l | tr -d ' '); _tdi=$(grep -l '^conf-file=/tmp/rwarden/dns.conf' /etc/dnsmasq.conf /etc/dnsmasq-*.conf 2>/dev/null | wc -l | tr -d ' ')
 _tdh=0; grep -q '^reaper-hitlog=' /tmp/rwarden/dns.conf 2>/dev/null && _tdh=1
-echo "  threat domains    : rwarden_dns=${_td:-unset}  names=$_tdn  counted=$_tdh  cache=$( [ -s /jffs/rwarden/dns.nx ] && echo dns.nx || { [ -s /jffs/rwarden/dns.cache ] && echo dns.cache-legacy || echo none; } )  built=$( [ -n "$_tdu" ] && date -d @$_tdu '+%F %R' 2>/dev/null || echo never )  included_in=${_tdi:-0}/${_tdc:-0} dnsmasq conf(s)"
+echo "  threat domains    : rwarden_dns=${_td:-unset}  names=$_tdn  counted=$_tdh  cache=$( [ -s /jffs/rwarden/dns.k.gz ] && echo dns.k.gz || { [ -s /jffs/rwarden/dns.nx.gz ] && echo dns.nx.gz-legacy || { [ -s /jffs/rwarden/dns.nx ] && echo dns.nx-legacy || { [ -s /jffs/rwarden/dns.cache ] && echo dns.cache-legacy || echo none; }; }; } )  built=$( [ -n "$_tdu" ] && date -d @$_tdu '+%F %R' 2>/dev/null || echo never )  included_in=${_tdi:-0}/${_tdc:-0} dnsmasq conf(s)"
+echo "  threat table      : /tmp/reaper_nx/threat.db $( [ "$_tdt" -gt 0 ] && echo "$_tdt bytes" || echo MISSING )  mapped_by=$_tdm/${_tdc:-0} dnsmasq instance(s)  (one copy in RAM for all; an instance maps it at its first query)"
 _tdk=/jffs/rwarden/dns.counters; [ "$(nvram get rwarden_stats_save 2>/dev/null)" = 0 ] && _tdk=/tmp/rwarden/dns.counters
 echo "  dreadwatch        : $(awk '$1=="TOTAL"{t=$2} $1=="DROPPED"{d=$2} $1=="SINCE"{s=$2} $1=="FEED"{f=f " " $2 "=" $3} $1=="CLIENT"{c++} END{printf "blocked=%d not_recorded=%d devices=%d since=%s per_feed:%s", t, d, c, (s ? s : "-"), (f ? f : " none")}' $_tdk 2>/dev/null || echo "no counters")  pending=$( [ -f /tmp/dreadwatch/dns.hits ] && wc -l < /tmp/dreadwatch/dns.hits || echo 0 )  feeds: $(awk '{printf "%s%s=%s/%s", (NR>1?" ":""), $1, $7, $4}' /jffs/rwarden/dns.feeds 2>/dev/null)"
 [ "$_td" = 1 ] && [ "$(nvram get rwarden_enable 2>/dev/null)" = 1 ] && [ "$_tdn" = 0 ] && finding WARN "threat domains are switched on but no list is loaded - the feeds have not been fetched yet, or every fetch failed (see 14 and the rwarden lines in the log)"
+[ "$_td" = 1 ] && [ "$_tdn" -gt 0 ] && [ "$_tdt" = 0 ] && finding WARN "threat domains: $_tdn names are counted but the compiled table /tmp/reaper_nx/threat.db is missing - they resolve unfiltered until rc rebuilds it (the nightly update, or a dnsmasq restart)"
 [ "$_td" = 1 ] && [ "$_tdn" -gt 0 ] && [ "${_tdi:-0}" -lt "${_tdc:-0}" ] && finding WARN "threat domains: the list is built but $((_tdc-_tdi)) dnsmasq instance(s) run without it - a dnsmasq restart loads it (Dreadwatch page: Save, or the nightly update)"
 [ "$_td" = 1 ] && [ "$_tdn" -gt 0 ] && [ "$_tdh" = 0 ] && finding INFO "threat domains: the list predates Dreadwatch counting (address= lines) - blocks are not counted until the next list update"
 echo "  -- chain packet/byte counters --"
@@ -1915,7 +1973,7 @@ probe "Google-DNS-v4     " 8.8.8.8
 [ -z "$PROBE_OK" ] && finding WARN "every connectivity probe from the router lost 100 % (gateway, Cloudflare, Google) - the router itself has no path out, or Warden's self chain drops the probes (section 14 IN SET); read 5 and 16 before anything about DNS or clients"
 
 sec "17. RWATCH (self-monitor state + durable store)"
-nvram show 2>/dev/null | grep -E '^(rwatch_|reaper_store)' | sort | sed 's/^/  /'
+grep -E '^(rwatch_|reaper_store)' "$NVS" 2>/dev/null | sort | sed 's/^/  /'
 # reaper v2.6.1: resolve the durable store the way rwatch.sh / rdev_store_base()
 # do, and report the syslog mirror. The old section only looked at /jffs/rwatch,
 # which is the INCIDENT-DUMP dir (created on first incident) - "none" there was
@@ -1998,6 +2056,20 @@ if [ -n "$SLF" ]; then
   #     still shows that the lab was running.
   cat $SLF 2>/dev/null | awk '!seen[$0]++' | grep -v 'rmcpd-lab: exec:' > "$SNAP" 2>/dev/null
   SLF="$SNAP"
+  # v1.3.48 (review 2026-10-24, Q-B-8): every line-count this section prints, in ONE pass over the snapshot
+  # (it was ~22 `grep -c` passes; with the USB mirror the snapshot is up to ~16 MB). Each pattern is the one
+  # the grep used (BRE `(` is literal, so `WAN\(0\)` here; the two -i patterns test a lower-cased copy).
+  CNTS="$(awk '
+    { l = tolower($0) }
+    /DEAUTHORIZE error/ { c[1]++ }  /ocv_cap unsupported/ { c[2]++ }
+    /roamast: .*\[EXAP\]Deauth/ { c[3]++ }  /roamast: .*weak signal/ { c[4]++ }
+    l ~ /radar[^a-z]*(detect|found)/ { c[5]++ }  l ~ /channel switch|[^a-z]csa[^a-z]/ { c[6]++ }
