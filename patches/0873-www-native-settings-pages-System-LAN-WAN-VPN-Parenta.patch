+    });
+    if (!any) h += '<div class="hint">' + hx(`<#RVST_29#>`) + '</div>';
+  }
+  q('ipsec').innerHTML = h + '</div>';
+}
+function drawPptp(){
+  var pid = parseInt(LIVE.st.pptpdpid, 10) || 0, en = NV.pptpd_enable === '1';
+  var s = pid > 0 ? ['on', `<#RVST_16#>`] : (en ? ['warn', `<#RVST_17#>`] : ['off', `<#RVST_21#>`]);
+  var h = '<div class="inst"><div class="ihead"><span class="iname">PPTP</span>' + pill(s[0], s[1]) + '<span class="spacer"></span>' + link('Reaper_VPNServer.asp', 'pptp') + '</div>';
+  if (pid > 0){
+    var rows = LIVE.pptp || [];
+    h += rows.length ? '<div class="sub2">' + hx(`<#Full_Clients#>`) + ' (' + rows.length + ')</div>' + table([`<#Username#>`, `<#wan_interface#>`, `<#RVST_39#>`, `<#RVST_41#>`], rows.map(function(r){ return [r.user, r.iface, r.remote, r.client]; }))
+      : '<div class="hint">' + hx(`<#RVST_29#>`) + '</div>';
+  }
+  q('pptp').innerHTML = h + '</div>';
+}
+
+/* ---------- clients ---------- */
+var RGW = {0: `<#RVST_42#>`, 1: `<#RVST_43#>`, 2: `<#Reaper_c_vpn_director#>`, 3: `<#Reaper_c_vpn_director#>`};
+function drawOvpnClients(){
+  var h = '', u;
+  for (u = 1; u <= OVPNC; u++){
+    var p = 'vpn_client' + u + '_', st = parseOvpn(LIVE.st['vpn_client' + u + '_status']), s = ovpnState(NV[p + 'state'], NV[p + 'errno']);
+    var enabled = eas(u), desc = NV[p + 'desc'] || ('Client ' + u);
+    if (!enabled && NV[p + 'state'] !== '1' && NV[p + 'state'] !== '2') s = ['off', `<#RVST_21#>`];
+    h += '<div class="inst"><div class="ihead"><span class="iname">OpenVPN ' + u + '</span><span class="idesc">' + hx(desc) + '</span>' + pill(s[0], s[1]) + (enabled ? tag('good', `<#CTL_Enabled#>`) : '') + '<span class="spacer"></span>' + link('Reaper_VPNClient.asp', 'ovpn') + '</div>';
+    var rows = [];
+    if (NV[p + 'addr']) rows.push([`<#RVST_44#>`, NV[p + 'addr'] + (NV[p + 'port'] ? ':' + NV[p + 'port'] : '') + (NV[p + 'proto'] ? '/' + NV[p + 'proto'] : '')]);
