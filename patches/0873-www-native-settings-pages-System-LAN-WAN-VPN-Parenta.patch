index 0000000000..1eb994dceb
--- /dev/null
+++ b/release/src/router/www/Reaper_IPv6Setup.asp
@@ -0,0 +1,486 @@
+<!-- SPDX-License-Identifier: GPL-2.0-only
+     Copyright (C) 2026 the Reaper project maintainer
+     Part of the Reaper hardened Asuswrt-Merlin build. See LICENSE / LICENSE.reaper. -->
+<!DOCTYPE html>
+<html lang="en">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width, initial-scale=1">
+<meta name="reaper-native" content="1">
+<title>REAPER &mdash; IPv6</title>
+<!-- Reaper_IPv6Setup.asp - WAN > IPv6 (Reaper-native UI, 2026-10-23).
+     Replaces Advanced_IPv6_Content.asp and Advanced_IPv61_Content.asp (parity files
+     build-scripts/tests/ui_parity/Advanced_IPv6_Content.json and Advanced_IPv61_Content.json).
+     The same eight connection types and the same row-by-row visibility as the stock page; every stock check kept;
+     only the changed settings are posted, with restart_net (plus restart_ftpd when FTP is on) like stock.
+     Not carried, with the reason in the parity files: the second-WAN page (ipv61_*): rc reads it only on
+     RTCONFIG_MULTIWAN_CFG / MULTIWAN_IF builds and no Reaper model builds either; "IPv6 Only" (no model reports
+     v6only); the Yandex DNS hint (stock hard-codes it off).
+     Deliberate differences: switching the type no longer blanks the saved values (stock emptied the prefix, LAN
+     address and static WAN fields), and the three ipv6_*_s copies are written only for Static and 6in4, where
+     rc reads them (stock wrote them empty on every other save). -->
+<link rel="stylesheet" href="/reaper/rp.css">
+<style>
+/* page-specific rules only; the Reaper look comes from /reaper/rp.css */
+.frow input.wide{width:340px} .frow input.num{width:90px} .frow input.hex{width:80px} .frow select{min-width:220px}
+.frow.off,.panel.off{display:none}
+.frow.bad input,.frow.bad select{border-color:var(--crimson)!important;box-shadow:0 0 0 2px rgba(225,6,0,.25)}
+.fv.dim{color:var(--steel)}
