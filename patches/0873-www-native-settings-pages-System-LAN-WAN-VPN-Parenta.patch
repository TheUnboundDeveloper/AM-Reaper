+  on('d_add', 'click', addDev);
+  on('d_mac', 'keydown', function(e){ if (e.key === 'Enter'){ e.preventDefault(); addDev(); } });
+  on('dtbody', 'click', tableClick);
+  on('dtbody', 'change', tableChange);
+  on('ed_mode', 'change', function(){ if (ED){ ED.mode = q('ed_mode').value; paintWeek(); } });
+  on('ed_addwin', 'click', addWin);
+  on('ed_done', 'click', edDone);
+  on('ed_cancel', 'click', function(){ closeEd(); render(); });
+  if (!ROUTING){ show('modehint', true); q('applybtn').disabled = true; }
+  show('ntphint', NTP_READY !== '1');
+  clock();
+  var want = wantedMac(), wi = -1;
+  if (want && !BROKEN.p_dev){
+    ROWS.forEach(function(r, i){ if (r.mac.toUpperCase() === want) wi = i; });
+    if (wi >= 0 && macOk(want)) openEd(wi); else if (macOk(want)) q('d_mac').value = want;
+  }
+  /* device names and the add picker: networkmap list + custom_clientlist, as stock's dropdown */
+  try {
+    ReaperNames.refresh(CUSTOM_CL, function(cl){
+      var ml = (cl && cl.maclist) || [], h = '';
+      ml.forEach(function(mac){ var c = cl[mac], M = String(mac).toUpperCase(); if (!c || !macOk(M)) return;
+        h += '<option value="' + hx(M) + '">' + hx(ReaperNames.byMac(M, M) + (c.ip ? ' (' + c.ip + ')' : '')) + '</option>'; });
+      q('clients').innerHTML = h;
+      if (!BROKEN.p_dev) render();
+      if (ED) q('ed_title').textContent = sub(`<#RPAR_30#>`, devName(ROWS[ED.i]));
+    });
+  } catch (e) {}
+  dirty();
+  rp.tips();
+}
+boot();
+})();
+</script>
+</body>
+</html>
diff --git a/release/src/router/www/Reaper_PortFwd.asp b/release/src/router/www/Reaper_PortFwd.asp
new file mode 100644
index 0000000000..42f3441ef8
--- /dev/null
+++ b/release/src/router/www/Reaper_PortFwd.asp
@@ -0,0 +1,100 @@
+<!-- SPDX-License-Identifier: GPL-2.0-only
+     Copyright (C) 2026 the Reaper project maintainer
+     Part of the Reaper hardened Asuswrt-Merlin build. See LICENSE / LICENSE.reaper. -->
+<!DOCTYPE html>
+<html lang="en">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width, initial-scale=1">
+<meta name="reaper-native" content="1">
+<title>REAPER &mdash; <#menu5_7_5#></title>
+<!-- Reaper_PortFwd.asp - System Log > Port Forwarding (Reaper-native UI, System Log wave, 2026-10-23).
+     Replaces Main_IPTStatus_Content.asp; the same two live tables from the same httpd emitters
+     (httpd/data_arrays.c): get_vserver_array (`iptables -t nat -nxL`, DNAT rules, DNS/UPnP chains excluded) and
+     get_upnp_array (/tmp/upnp.leases after SIGUSR2 to miniupnpd; costs ~1 s per load, so no polling).
+     Every field is escaped here (the UPnP description is written by a LAN client); the emitter escapes it for
+     the inline array too (lease_js_escape, 2026-10-23). DNAT chains Reaper owns are named instead of passing for
+     user port forwards (REAPER_GKN = Gatekeeper's hold page). -->
+<link rel="stylesheet" href="/reaper/rp.css">
+<style>
+.rtab td{padding:7px 10px;border-bottom:1px solid var(--line-soft);color:var(--bone-dim);font-family:var(--mono);vertical-align:top;word-break:break-word}
+.rtab td.txt{font-family:var(--body)}
+.empty{color:var(--steel);font-size:12.5px;padding:8px 0}
+</style>
+</head>
+<body>
+<script src="/reaper_util.js"></script>
+<script src="/reaper/rp.js"></script>
+
+<div class="syswrap">
+<div class="pagehead">
+  <div>
+    <div class="eyebrow"><#System_Log#></div>
+    <h1><#menu5_7_5#></h1>
+  </div>
+  <div class="spacer"></div>
+  <button type="button" class="btn" id="b_refresh"><#CTL_refresh#></button>
+</div>
+<div class="hint" style="margin:-4px 0 14px"><#RLOG_31#></div>
+
+<div class="rframe">
+<div class="panel" id="p_vs">
+  <h2><#RLOG_32#></h2>
+  <div class="sub"><#RLOG_33#></div>
+  <div id="vs"></div>
+</div>
+<div class="panel" id="p_upnp">
+  <h2><#RLOG_34#></h2>
+  <div class="sub" id="upnpsub"><#RLOG_35#></div>
+  <div id="upnp"></div>
+</div>
+</div>
+</div>
+
+<script>
+(function(){
+'use strict';
+var q = rp.q, hx = rp.esc;
+<% get_vserver_array(); %>
+<% get_upnp_array(); %>
+var UPNP_ON = '<% nvram_get("upnp_enable"); %>' === '1';
+function rows(a){ return (a || []).filter(function(r){ return r && r.length; }); }
+/* DNAT chains Reaper writes itself: name them instead of letting them pass for a user's port forward */
+var CHAIN = {VSERVER: `<#RLOG_36#>`, REAPER_GKN: `<#RLOG_37#>`};
+function chainLabel(c){ return CHAIN[c] || c; }
+function left(s){
+  var n = parseInt(s, 10); if (!(n > 0)) return '-';
+  var h = Math.floor(n / 3600), m = Math.floor(n / 60) % 60;
+  return (h ? h + 'h ' : '') + m + 'm ' + (n % 60) + 's';
+}
+
+function drawVs(){
+  var a = rows(vserverarray), h;
+  if (!a.length){ q('vs').innerHTML = '<div class="empty">' + hx(`<#RLOG_38#>`) + '</div>'; return; }
+  h = `<table class="rtab"><thead><tr><th><#RLOG_39#></th><th><#RLOG_40#></th><th><#RLOG_41#></th><th><#RLOG_42#></th><th><#RLOG_43#></th><th><#RLOG_44#></th></tr></thead><tbody>`;
+  a.forEach(function(r){
+    /* [src, dst, proto, port range, to host, to port, chain] */
+    h += '<tr><td>' + hx(r[0]) + '</td><td>' + hx(r[2]) + '</td><td>' + hx(r[3] || '-') + '</td><td>' + hx(r[4] || '-') + '</td><td>' + hx(r[5] || '-') +
+      '</td><td class="txt">' + hx(chainLabel(r[6])) + '</td></tr>';
+  });
+  q('vs').innerHTML = h + '</tbody></table>';
+}
+function drawUpnp(){
+  var a = rows(upnparray), h;
+  if (!UPNP_ON) q('upnpsub').textContent = `<#RLOG_45#>`;
+  if (!a.length){ q('upnp').innerHTML = '<div class="empty">' + hx(`<#RLOG_46#>`) + '</div>'; return; }
+  h = `<table class="rtab"><thead><tr><th><#RLOG_40#></th><th><#RLOG_41#></th><th><#RLOG_42#></th><th><#RLOG_43#></th><th><#RLOG_47#></th><th><#RLOG_48#></th></tr></thead><tbody>`;
+  a.forEach(function(r){
+    /* [proto, external port, internal ip, internal port, seconds left, description] */
+    h += '<tr><td>' + hx(r[0]) + '</td><td>' + hx(r[1]) + '</td><td>' + hx(r[2]) + '</td><td>' + hx(r[3]) + '</td><td>' + hx(left(r[4])) +
+      '</td><td class="txt">' + hx(r[5] || '') + '</td></tr>';
+  });
+  q('upnp').innerHTML = h + '</tbody></table>';
+}
+try { drawVs(); } catch (e) { q('vs').innerHTML = '<div class="empty">' + hx(`<#RADM_78#>`) + '</div>'; }
+try { drawUpnp(); } catch (e) { q('upnp').innerHTML = '<div class="empty">' + hx(`<#RADM_78#>`) + '</div>'; }
+q('b_refresh').addEventListener('click', function(){ location.reload(); });
+})();
+</script>
+</body>
+</html>
diff --git a/release/src/router/www/Reaper_Routes.asp b/release/src/router/www/Reaper_Routes.asp
new file mode 100644
index 0000000000..e658778cd0
--- /dev/null
+++ b/release/src/router/www/Reaper_Routes.asp
@@ -0,0 +1,310 @@
+<!-- SPDX-License-Identifier: GPL-2.0-only
+     Copyright (C) 2026 the Reaper project maintainer
+     Part of the Reaper hardened Asuswrt-Merlin build. See LICENSE / LICENSE.reaper. -->
+<!DOCTYPE html>
+<html lang="en">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width, initial-scale=1">
+<meta name="reaper-native" content="1">
+<title>REAPER &mdash; <#menu5_7_6#></title>
+<!-- Reaper_Routes.asp - System Log > Routing table (Reaper-native UI, System Log wave, 2026-10-23) + LAN > Route editor
+     (LAN/WAN wave, 2026-10-23).
+     Tab "Routing table": replaces Main_RouteStatus_Content.asp, which read /proc/net/route - the MAIN table only. Owner:
+     show every table. Data: reaper_pbr.cgi?action=routes (`ip -4|-6 rule show`, `ip -4|-6 route show table all`,
+     /etc/iproute2/rt_tables; fixed commands, capped). Tables are listed in the order the rules consult them;
+     the kernel's "local" table (local + broadcast addresses) is folded away by default. Read-only, no polling.
+     Tab "Static routes": replaces Advanced_GWStaticRoute_Content.asp (parity file
+     build-scripts/tests/ui_parity/Advanced_GWStaticRoute_Content.json): sr_enable_x + sr_rulelist
+     (<IP>NETMASK>GATEWAY>METRIC>IF, rc/firewall.c convert_routes), posted only when changed, restart_net like stock
+     (convert_routes runs in start_lan and the routes are added by add_lan_routes / add_wan_routes - no narrower service).
+     Deliberate differences from stock: the list's size is shown against the nvram limit and a save that would not fit
+     is refused (httpd refuses sr_rulelist over 1024 bytes and the kernel store a name=value over ~1006, both silently;
+     stock let 64 rows be entered and dropped the save past about 20, B-SR-1); a destination with host bits set under
+     its netmask is refused (the kernel rejects it, B-SR-2); rows can be edited; the list is serialised from the
+     page's own model, never from table HTML (B-SR-3). -->
+<link rel="stylesheet" href="/reaper/rp.css">
+<style>
+/* page-specific rules only; the Reaper look comes from /reaper/rp.css */
+.bar{display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin:0 0 12px}
+.bar .spacer{flex:1}
+.rtab{width:100%;border-collapse:collapse;margin:4px 0 14px;font-size:12.5px}
+.rtab td{padding:7px 10px;border-bottom:1px solid var(--line-soft);color:var(--bone-dim);font-family:var(--mono);vertical-align:top;word-break:break-all}
+.rtab td.dst{color:var(--bone)}
+.thead{display:flex;align-items:baseline;gap:10px;margin:16px 0 2px}
+.thead h3{font-family:var(--hdr);font-size:13.5px;letter-spacing:.08em;text-transform:uppercase;color:var(--bone);margin:0}
+.thead .tag{font-family:var(--mono)}
+.empty{color:var(--steel);font-size:12.5px;padding:6px 0 10px}
+.msg{font-size:12.5px;color:var(--amber);display:none} 
+.wins{display:flex;gap:6px;flex-wrap:wrap;margin:0 0 16px}
+.edonly{display:none} .edonly.show{display:inline-flex}
+ .bwl-add input.num{width:70px}
+.bwl-add.bad input,.bwl-add.bad select{border-color:var(--crimson)}
+table.classes td.mono{font-family:var(--mono)}
+.link{color:var(--bone-dim);text-decoration:underline;cursor:pointer}
+</style>
+</head>
+<body>
+<script src="/reaper_util.js"></script>
+<script src="/reaper/rp.js"></script>
+
+<div class="syswrap">
+<div class="pagehead">
+  <div>
+    <div class="eyebrow"><#System_Log#></div>
+    <h1><#menu5_7_6#></h1>
+  </div>
+  <div class="spacer"></div>
+  <span class="pill warn chgpill" id="chgpill"><span class="dot"></span><span><#RADM_77#>: <b id="chgcount">0</b></span></span>
+  <button type="button" class="btn ghost edonly" id="discardbtn" disabled><#Discard#></button>
+  <button type="button" class="btn primary edonly" id="applybtn"><#CTL_apply#></button>
+  <button type="button" class="btn" id="b_refresh"><#CTL_refresh#></button>
+</div>
+<div class="msg" id="topmsg" style="margin:0 0 12px"></div>
+
+<div class="wins" id="wins">
+  <button type="button" class="win" data-t="view"><span class="cdot"></span><#menu5_7_6#></button>
+  <button type="button" class="win" data-t="edit"><span class="cdot"></span><#RRTE_01#></button>
+</div>
+
+<!-- ================= ROUTING TABLE (read-only) ================= -->
+<div class="tab" id="tab_view">
+<div class="hint" style="margin:-4px 0 14px"><#RLOG_13#></div>
+<div class="rframe">
+<div class="panel" id="p_v4">
+  <div class="bar"><h2 style="margin:0">IPv4</h2><div class="spacer"></div><label class="chk"><input type="checkbox" id="c_local"><#RLOG_14#></label></div>
+  <div id="v4"></div>
+</div>
+<div class="panel" id="p_v6">
+  <h2>IPv6</h2>
+  <div id="v6"></div>
+</div>
+</div>
+</div>
+
+<!-- ================= STATIC ROUTES (editor) ================= -->
+<div class="tab rframe" id="tab_edit">
+  <div class="panel" id="p_sr">
+    <h2><#RouterConfig_GWStatic_groupitemdesc#></h2>
+    <div class="sub"><#RRTE_02#></div>
+    <div class="secerr"><#RADM_78#></div>
+    <div class="frow" id="r_sren"><div class="fl"><#RouterConfig_GWStaticEnable_itemname#></div><div class="fc"><label class="tswitch"><input type="checkbox" id="t_sren"><span class="track"></span></label></div></div>
+    <table class="classes"><thead><tr><th><#RouterConfig_GWStaticIP_itemname#></th><th><#RouterConfig_GWStaticMask_itemname#></th><th><#RouterConfig_GWStaticGW_itemname#></th><th><#RouterConfig_GWStaticMT_itemname#></th><th><#wan_interface#></th><th></th></tr></thead><tbody id="srtbody"></tbody></table>
+    <div class="bwl-add" id="sradd">
+      <div class="f"><label><#RouterConfig_GWStaticIP_itemname#></label><input type="text" class="ip mono" id="a_ip" maxlength="15" autocomplete="off"></div>
+      <div class="f"><label><#RouterConfig_GWStaticMask_itemname#></label><input type="text" class="ip mono" id="a_mask" maxlength="15" autocomplete="off"></div>
+      <div class="f"><label><#RouterConfig_GWStaticGW_itemname#></label><input type="text" class="ip mono" id="a_gw" maxlength="15" autocomplete="off"></div>
+      <div class="f"><label><#RouterConfig_GWStaticMT_itemname#></label><input type="text" class="num mono" id="a_metric" maxlength="3" autocomplete="off"></div>
+      <div class="f"><label><#wan_interface#></label><select id="a_if"><option value="LAN">LAN</option><option value="MAN">MAN</option><option value="WAN">WAN</option><option value="VPN">VPN</option></select></div>
+      <button type="button" class="btn small" id="sraddbtn"><#CTL_add#></button>
+    </div>
+    <div class="rbudget" id="srbudget"></div>
+    <div class="msg" id="srmsg" style="margin-top:8px"></div>
+    <div class="hint"><#RRTE_03#></div>
+  </div>
+</div>
+</div>
+
+<div class="applying" id="applying"><div class="abox"><h2 id="ap_t"><#Reaper_c_applying#></h2><p id="ap_p"><#RRTE_04#></p></div></div>
+<iframe name="hidden_frame" id="hidden_frame" style="display:none" width="0" height="0"></iframe>
+<form method="post" name="form" action="/start_apply.htm" target="hidden_frame">
+  <input type="hidden" name="current_page" value="Reaper_Routes.asp">
+  <input type="hidden" name="next_page" value="Reaper_Routes.asp">
+  <input type="hidden" name="action_mode" value="apply">
+  <input type="hidden" name="action_script" value="">
+  <input type="hidden" name="action_wait" value="10">
+  <input type="hidden" name="sr_enable_x" value="" disabled>
+  <input type="hidden" name="sr_rulelist" value="" disabled>
+</form>
+
+<script>
+(function(){
+'use strict';
+var q = rp.q, hx = rp.esc;
+var U = rp.dec, ip2n = rp.ip.n, wins = rp.wins;   /* the kit's copies (rp.js) */
+var DATA = null, NAMES = {};
+var HTTPID = '<% nvram_get("http_id"); %>';   /* reaper_pbr.cgi is CSRF-gated (httpd-generated hex token; kept as test_reaper_syslog_pages.py pins it) */
+var MODE = 'rt'; try { MODE = String([<% get_operation_mode(); %>][0] || 'rt').toLowerCase(); } catch (e) {}
+var ROUTING = !(MODE === 'rp' || MODE === 'ap' || MODE === 'mb');   /* menu.js: stock Static Routes showed only when routing */
+
+/* rt_tables: "<id> <name>"; ip prints the name when it knows one */
+function names(txt){ var m = {}; String(txt || '').split('\n').forEach(function(l){ var a = l.trim().split(/\s+/); if (a.length >= 2 && /^\d+$/.test(a[0])) m[a[0]] = a[1]; }); return m; }
+function label(t){
+  var n = NAMES[t] || t, d = {main: `<#RLOG_15#>`, local: `<#RLOG_16#>`, 'default': `<#RLOG_17#>`};
+  if (d[n]) return d[n];
+  if (/^wgc\d$/.test(n)) return 'WireGuard ' + n.slice(3);
+  if (/^ovpnc\d$/.test(n)) return 'OpenVPN ' + n.slice(5);
+  if (/^wan\d$/.test(n)) return 'WAN ' + n.slice(3);
+  return '';
+}
+/* one route line -> {table, dst, fields}; `ip route show table all` tags non-main routes with "table X" */
+function parseRoute(l){
+  var w = l.trim().split(/\s+/), r = {table: 'main', type: '', dst: '', via: '', dev: '', src: '', metric: '', proto: '', scope: ''}, i;
+  if (!w[0]) return null;
+  if (/^(local|broadcast|unreachable|prohibit|blackhole|throw|anycast|multicast|unicast)$/.test(w[0])){ r.type = w.shift(); }
+  r.dst = w.shift();
+  for (i = 0; i < w.length; i++){
+    var k = w[i], v = w[i + 1];
+    if (k === 'table'){ r.table = v; i++; } else if (k === 'via'){ r.via = v; i++; } else if (k === 'dev'){ r.dev = v; i++; }
+    else if (k === 'src'){ r.src = v; i++; } else if (k === 'metric'){ r.metric = v; i++; } else if (k === 'proto'){ r.proto = v; i++; }
+    else if (k === 'scope'){ r.scope = v; i++; }
+  }
+  return r;
+}
+/* rules in priority order: "20:\tfrom all lookup 8437" -> {prio, text, table} */
+function parseRules(txt){
+  return String(txt || '').split('\n').filter(function(l){ return /^\d+:/.test(l); }).map(function(l){
+    var m = /^(\d+):\s*(.*)$/.exec(l), t = /\blookup (\S+)/.exec(m[2]);
+    return {prio: m[1], text: m[2].trim(), table: t ? t[1] : ''};
+  });
+}
+function draw(fam){
+  var box = q(fam === 4 ? 'v4' : 'v6'), routes = String(DATA['route' + fam] || '').split('\n').map(parseRoute).filter(Boolean);
+  var rules = parseRules(DATA['rule' + fam]), showLocal = q('c_local').checked, order = [], seen = {}, by = {}, h = '';
+  if (!routes.length && !rules.length){ box.innerHTML = '<div class="empty">' + hx(fam === 4 ? `<#RLOG_18#>` : `<#RLOG_19#>`) + '</div>'; return; }
+  routes.forEach(function(r){ (by[r.table] = by[r.table] || []).push(r); });
+  /* tables in the order the rules consult them, then any table no rule names */
+  rules.forEach(function(x){ if (x.table && !seen[x.table]){ seen[x.table] = 1; order.push(x.table); } });
+  Object.keys(by).forEach(function(t){ if (!seen[t]){ seen[t] = 1; order.push(t); } });
+  h += `<table class="rtab"><thead><tr><th style="width:90px"><#RLOG_20#></th><th><#RLOG_21#></th></tr></thead><tbody>`;
+  rules.forEach(function(x){ h += '<tr><td>' + hx(x.prio) + '</td><td class="dst">' + hx(x.text) + '</td></tr>'; });
+  if (!rules.length) h += '<tr><td colspan="2" class="empty">-</td></tr>';
+  h += '</tbody></table>';
+  order.forEach(function(t){
+    var list = by[t] || [], lab = label(t);
+    if (t === 'local' && !showLocal) return;
+    h += '<div class="thead"><h3>' + hx(lab || (`<#RLOG_22#>` + ' ' + (NAMES[t] || t))) + '</h3>' + (lab ? '<span class="tag">' + hx(NAMES[t] || t) + '</span>' : '') + '<span class="tag">' + list.length + '</span></div>';
+    if (!list.length){ h += '<div class="empty">' + hx(`<#RLOG_23#>`) + '</div>'; return; }
+    h += `<table class="rtab"><thead><tr><th><#RLOG_24#></th><th><#RLOG_25#></th><th><#RLOG_26#></th><th><#RLOG_27#></th><th><#RLOG_28#></th><th><#RLOG_29#></th></tr></thead><tbody>`;
+    list.forEach(function(r){
+      h += '<tr><td class="dst">' + hx((r.type ? r.type + ' ' : '') + r.dst) + '</td><td>' + hx(r.via || '-') + '</td><td>' + hx(r.dev || '-') + '</td><td>' + hx(r.src || '-') +
+        '</td><td>' + hx(r.metric || '-') + '</td><td>' + hx([r.proto, r.scope].filter(Boolean).join(' / ') || '-') + '</td></tr>';
+    });
+    h += '</tbody></table>';
+  });
+  box.innerHTML = h;
+}
+function load(){
+  var x = new XMLHttpRequest();
+  q('topmsg').classList.remove('show');
+  x.open('GET', '/reaper_pbr.cgi?action=routes&http_id=' + encodeURIComponent(HTTPID) + '&_=' + Date.now(), true); x.timeout = 15000;
+  x.onload = function(){
+    var d = null; try { d = JSON.parse(x.responseText); } catch (e) {}
+    if (!d || !d.ok){ q('topmsg').textContent = `<#RLOG_30#>`; q('topmsg').classList.add('show'); return; }
+    DATA = d; NAMES = names(d.tables); draw(4); draw(6);
+  };
+  x.onerror = x.ontimeout = function(){ q('topmsg').textContent = `<#RLOG_30#>`; q('topmsg').classList.add('show'); };
+  x.send();
+}
+
+/* ================= static route editor (the stock Advanced_GWStaticRoute_Content.asp) ================= */
+var NV = {sr_enable_x: U('<% nvram_char_to_ascii("","sr_enable_x"); %>'), sr_rulelist: U('<% nvram_char_to_ascii("","sr_rulelist"); %>')};
+var MAXROWS = 64;   /* stock addRow_Group(64) */
+/* sr_rulelist: httpd refuses a value over its CKN_STR1024 size (web.c nvram_check), and the kernel nvram store drops
+   a name=value tuple over ~1006 bytes (measured on the BE96U) with no error; sr_rulelist is not known to be on the
+   JFFS whitelist. The smaller of the two is the limit: 1006 - "sr_rulelist=". */
+var MAXBYTES = Math.min(1024, 1006 - 'sr_rulelist='.length);
+var SR = [], SR_EDITED = false, BROKEN = false, INIT_EN = '';
+function srParse(s){
+  var out = [];
+  String(s || '').split('<').forEach(function(r){ if (!r) return; var f = r.split('>'); if (f.length !== 5) return; out.push({ip: f[0], mask: f[1], gw: f[2], metric: f[3], dev: f[4]}); });
+  return out;
+}
+function srSer(l){ return l.map(function(r){ return '<' + [r.ip, r.mask, r.gw, r.metric, r.dev].join('>'); }).join(''); }
+/* contiguous netmask; stock lets 0.0.0.0 pass (a default route) */
+function maskOk(m){ var n = ip2n(m), i, seenZero = false; if (n < 0) return false; for (i = 31; i >= 0; i--){ var b = Math.floor(n / Math.pow(2, i)) % 2; if (b && seenZero) return false; if (!b) seenZero = true; } return true; }
+function srMsg(t){ var m = q('srmsg'); m.textContent = t || ''; m.classList.toggle('show', !!t); }
+function srDraw(){
+  var h = '';
+  SR.forEach(function(r, i){
+    h += '<tr><td class="mono">' + hx(r.ip) + '</td><td class="mono">' + hx(r.mask) + '</td><td class="mono">' + hx(r.gw) + '</td><td class="mono">' + hx(r.metric || '-') + '</td><td>' + hx(r.dev) +
+      '</td><td style="text-align:right;white-space:nowrap"><span class="link sredit" data-i="' + i + '">' + hx(`<#RRTE_05#>`) + '</span> <span class="bwldel" data-i="' + i + '" title="' + hx(`<#CTL_del#>`) + '">&times;</span></td></tr>';
+  });
+  q('srtbody').innerHTML = h || '<tr><td colspan="6" class="empty">' + hx(`<#IPConnection_VSList_Norule#>`) + '</td></tr>';
+  var n = srSer(SR).length, b = q('srbudget');
+  b.textContent = SR.length + ' / ' + MAXROWS + '  -  ' + n + ' / ' + MAXBYTES + ' ' + `<#RRTE_06#>`;
+  b.classList.toggle('hot', n > MAXBYTES * 0.85 || SR.length >= MAXROWS);
+}
+/* stock addRow_Group checks, plus: host bits under the mask refused, metric 0-999, and the byte limit */
+function srAdd(){
+  srMsg('');
+  var r = {ip: q('a_ip').value.trim(), mask: q('a_mask').value.trim(), gw: q('a_gw').value.trim(), metric: q('a_metric').value.trim(), dev: q('a_if').value}, e = '';
+  if (SR.length >= MAXROWS) e = `<#JS_itemlimit1#>` + ' ' + MAXROWS + ' ' + `<#JS_itemlimit2#>`;
+  else if (!r.ip || !r.mask || !r.gw) e = `<#JS_fieldblank#>`;
+  else if (!rp.v.ipv4(r.ip)) e = r.ip + ' ' + `<#JS_validip#>`;
+  else if (!rp.v.ipv4(r.mask) || !maskOk(r.mask)) e = r.mask + ' ' + `<#JS_validip#>`;
+  else if (((ip2n(r.ip) & ~ip2n(r.mask)) >>> 0) !== 0) e = `<#RRTE_07#>`;
+  else if (!rp.v.ipv4(r.gw)) e = r.gw + ' ' + `<#JS_validip#>`;
+  else if (r.metric && !rp.v.int(r.metric, 0, 999)) e = `<#RRTE_08#>`;
+  else if (SR.some(function(x){ return x.ip === r.ip && x.gw === r.gw; })) e = `<#JS_duplicate#>`;   /* stock: same IP and gateway */
+  else if (srSer(SR.concat([r])).length > MAXBYTES) e = `<#RRTE_09#>`;
+  if (e){ srMsg(e); q('sradd').classList.add('bad'); setTimeout(function(){ q('sradd').classList.remove('bad'); }, 4000); return; }
+  SR.push(r); SR_EDITED = true;
+  /* stock: adding a route turns static routes on */
+  q('t_sren').checked = true;
+  ['a_ip', 'a_mask', 'a_gw', 'a_metric'].forEach(function(id){ q(id).value = ''; }); q('a_if').value = 'LAN';
+  srDraw(); dirty();
+}
+function collect(){
+  var c = {}; if (BROKEN) return c;
+  c.sr_enable_x = (q('t_sren').checked ? '1' : '0') === INIT_EN ? NV.sr_enable_x : (q('t_sren').checked ? '1' : '0');
+  c.sr_rulelist = SR_EDITED ? srSer(SR) : NV.sr_rulelist;
+  return c;
+}
+function diff(c){ var ch = {}, k; for (k in c) if (Object.prototype.hasOwnProperty.call(c, k) && String(c[k]) !== String(NV[k])) ch[k] = c[k]; return ch; }
+function dirty(){
+  var ch = diff(collect()), n = Object.keys(ch).length;
+  rp.pill(n);
+  var w = document.querySelector('#wins .win[data-t="edit"]'); if (w) w.classList.toggle('dirty', n > 0);
+}
+function applyAll(){
+  q('topmsg').classList.remove('show');
+  var ch = diff(collect()), n = Object.keys(ch).length;
+  if (!n){ q('topmsg').textContent = `<#RADM_63#>`; q('topmsg').classList.add('show'); return; }
+  if (ch.sr_rulelist !== undefined && ch.sr_rulelist.length > MAXBYTES){ q('topmsg').textContent = `<#RRTE_09#>`; q('topmsg').classList.add('show'); return; }
+  /* rc: convert_routes (firewall.c) runs in start_lan and the routes are added by add_lan_routes / add_wan_routes,
+     so the stock restart_net (LAN + WAN) is the narrowest service that applies them */
+  if (!confirm(`<#RRTE_10#>`)) return;
+  rp.applying(`<#Reaper_c_applying#>`, `<#RRTE_04#>`);
+  rp.post(document.form, ch, 'restart_net', 10);
+}
+
+/* ---------- tabs ---------- */
+function showTab(t){
+  ['view', 'edit'].forEach(function(x){ q('tab_' + x).classList.toggle('on', x === t); });
+  wins().forEach(function(w){ w.classList.toggle('on', w.getAttribute('data-t') === t); });
+  q('b_refresh').style.display = t === 'view' ? '' : 'none';
+  q('applybtn').classList.toggle('show', t === 'edit'); q('discardbtn').classList.toggle('show', t === 'edit');
+  try { sessionStorage.setItem('rrte_tab', t); } catch (e) {}
+}
+
+function boot(){
+  try {
+    q('t_sren').checked = NV.sr_enable_x === '1'; INIT_EN = q('t_sren').checked ? '1' : '0';
+    SR = srParse(NV.sr_rulelist); srDraw();
+  } catch (e){ BROKEN = true; q('p_sr').classList.add('broken'); if (window.console) console.error('Reaper_Routes: editor failed to load:', e); }
+  if (!ROUTING) wins().forEach(function(w){ if (w.getAttribute('data-t') === 'edit') w.classList.add('gone'); });
+  wins().forEach(function(w){ w.addEventListener('click', function(){ showTab(w.getAttribute('data-t')); }); });
+  var want = 'view'; try { want = sessionStorage.getItem('rrte_tab') || 'view'; } catch (e) {}
+  if (/(^|[?&])tab=edit/.test(location.search)) want = 'edit';
+  showTab(want === 'edit' && ROUTING ? 'edit' : 'view');
+  q('b_refresh').addEventListener('click', load);
+  q('c_local').addEventListener('change', function(){ if (DATA){ draw(4); draw(6); } });
+  q('sraddbtn').addEventListener('click', srAdd);
+  q('srtbody').addEventListener('click', function(e){
+    var t = e.target; if (!t || !t.classList) return;
+    var i = +t.getAttribute('data-i');
+    if (t.classList.contains('bwldel')){ SR.splice(i, 1); SR_EDITED = true; srDraw(); dirty(); }
+    else if (t.classList.contains('sredit')){ var r = SR[i]; q('a_ip').value = r.ip; q('a_mask').value = r.mask; q('a_gw').value = r.gw; q('a_metric').value = r.metric; q('a_if').value = r.dev; SR.splice(i, 1); SR_EDITED = true; srDraw(); dirty(); }
+  });
+  q('t_sren').addEventListener('change', dirty);
+  q('applybtn').addEventListener('click', applyAll);
+  q('discardbtn').addEventListener('click', function(){ location.reload(); });
+  dirty();
+  load();
+}
+boot();
+})();
+</script>
+</body>
+</html>
diff --git a/release/src/router/www/Reaper_SNMP.asp b/release/src/router/www/Reaper_SNMP.asp
