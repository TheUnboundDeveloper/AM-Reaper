+  on('discardbtn', 'click', function(){ location.reload(); });
+  on('pf_proto', 'change', pfProto); on('pf_preset', 'change', pfPreset);
+  on('pf_save', 'click', pfSave); on('pf_cancel', 'click', pfClear); on('pftbody', 'click', pfClick);
+  on('pt_app', 'change', ptApp); on('pt_save', 'click', ptSave); on('pt_cancel', 'click', ptClear); on('pttbody', 'click', ptClick);
+  on('t_dmz', 'change', dmzSync); on('i_dmz', 'input', dmzSync);
+  on('t_relay', 'change', algSync);
+  on('t_vts', 'change', pfNotes);
+  on('dmzftp', 'click', function(){ showTab('pf'); q('pf_preset').value = 's0'; pfPreset(); });
+  document.addEventListener('input', dirty); document.addEventListener('change', dirty);
+  /* client addresses for the internal-IP and DMZ fields (networkmap list, as stock's picker) */
+  try {
+    ReaperNames.refresh(CUSTOM_CL, function(cl){
+      var dl = q('clients'), ml = (cl && cl.maclist) || [], seen = {}, h = '';
+      ml.forEach(function(mac){ var c = cl[mac]; if (!c || !c.ip || seen[c.ip]) return; seen[c.ip] = 1;
+        h += '<option value="' + hx(c.ip) + '">' + hx(ReaperNames.byMac(mac, mac)) + '</option>'; });
+      dl.innerHTML = h;
+    });
+  } catch (e) {}
+  showTab(firstTab());
+  /* the DMZ page's deep link (stock Advanced_VirtualServer_Content.asp?af=KnownApps&item=ftp): open the FTP preset,
+     never save on load */
+  if (param('af') === 'KnownApps' && param('item') === 'ftp' && !BROKEN.p_pf){ showTab('pf'); q('pf_preset').value = 's0'; pfPreset(); }
+  dirty();
+  rp.tips();
+}
+boot();
+})();
+</script>
