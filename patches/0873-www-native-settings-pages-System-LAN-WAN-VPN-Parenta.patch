+/* ---------- live prefix: the stock page polled update_IPv6state.asp while the saved type was selected ---------- */
+/* (review 2026-10-24, Q-C1-4: every 10 s, and not while the tab is hidden - a prefix changes on the scale of hours) */
+function poll(){
+  if (document.hidden || svc() !== ORIG || ORIG === 'disabled'){ setTimeout(poll, 10000); return; }
