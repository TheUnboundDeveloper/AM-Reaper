+}
+function drawWgServer(){
+  var on = NV.wgs1_enable === '1', h = '<div class="inst"><div class="ihead"><span class="iname">WireGuard</span>' + pill(on ? 'on' : 'off', on ? `<#RVST_16#>` : `<#RVST_21#>`) + '<span class="spacer"></span>' + link('Reaper_VPNServer.asp', 'wg') + '</div>';
