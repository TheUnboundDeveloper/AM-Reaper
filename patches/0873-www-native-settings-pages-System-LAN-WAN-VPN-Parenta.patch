+++ b/release/src/router/www/Reaper_DDNS.asp
@@ -0,0 +1,494 @@
+<!-- SPDX-License-Identifier: GPL-2.0-only
+     Copyright (C) 2026 the Reaper project maintainer
+     Part of the Reaper hardened Asuswrt-Merlin build. See LICENSE / LICENSE.reaper. -->
+<!DOCTYPE html>
+<html lang="en">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width, initial-scale=1">
+<meta name="reaper-native" content="1">
+<title>REAPER &mdash; <#menu5_3_6#></title>
+<!-- Reaper_DDNS.asp - WAN > DDNS (Reaper-native UI, LAN/WAN wave, 2026-10-23).
+     Replaces Advanced_ASUSDDNS_Content.asp (parity file build-scripts/tests/ui_parity/Advanced_ASUSDDNS_Content.json):
+     the DDNS provider settings and the HTTPS certificate method (Let's Encrypt / imported / self-signed), with the
+     stock row-per-provider rules and checks, posting only the changed settings.
+     Deliberate differences from stock:
+     - ASUS DDNS (WWW.ASUS.COM / WWW.ASUS.COM.CN, asuscomm) is not offered: the owner removed it from the firmware.
+       A saved asuscomm setup shows as not configured with a note; its server name is never posted back, and the
+       deregister / transfer / privacy-policy flows that only served it are gone.
+     - Nothing is written on load. Stock read ddns_return_code through ej nvram_get_ddns, which CLEARS it
+       (httpd/web.c ej_nvram_get_ddns); this page reads ddns_return_code and ddns_return_code_chk with
+       nvram_char_to_ascii and polls /ajax_ddnscode.asp (plain nvram_get) - the same values, nothing cleared.
+     - No stray wl_gmode_protection_x field (stock posted it on every save) and action_wait is never empty.
+     - The DDNS password is not written into the page: an empty field keeps the saved one (nvram_match tells the
+       page whether one is saved).
+     - restart_webdav is not run: with RTCONFIG_WEBDAV unset (.config) rc/services.c "webdav" only rescans an
+       Entware AiCloud install. A certificate-only change runs prepare_cert without restarting DDNS.
+     - DOMAINS.GOOGLE.COM (Google Domains closed) is listed only while it is the saved provider.
+     - The Let's Encrypt terms box is asked for every switch to Let's Encrypt (stock asked only on the asuscomm path).
+     - The self-signed certificate renewal lives on the System page (Reaper_System.asp certificate panel). -->
+<link rel="stylesheet" href="/reaper/rp.css">
+<style>
+/* page-specific rules only; the Reaper look comes from /reaper/rp.css */
+ .frow input.mid{width:260px} .frow select{min-width:240px}
+.frow.off,.panel.off,.off{display:none}
+.frow.bad input,.frow.bad select{border-color:var(--crimson)!important;box-shadow:0 0 0 2px rgba(225,6,0,.25)}
+.fv{color:var(--bone);font-size:13.5px}
+.fv.warn{color:var(--amber)}
+.kv{display:grid;grid-template-columns:auto 1fr;gap:3px 14px;font-size:12.5px;max-width:640px;margin-top:6px}
+ .kv .v{color:var(--bone);min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
+.btns{display:flex;gap:8px;flex-wrap:wrap;margin-top:12px}
+.link{color:var(--bone-dim);text-decoration:underline;font-size:12.5px;cursor:pointer}
+.msg{font-size:12.5px;color:var(--amber);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:100%;min-width:0;display:none}
+.note{display:none;font-size:12.5px;color:var(--amber);margin:6px 0 0}
+.upl input[type=file]{font-size:12px;color:var(--bone-dim)}
+</style>
+</head>
+<body>
+<script src="/reaper_util.js"></script>
+<script src="/reaper/rp.js"></script>
+
+<div class="syswrap">
+<div class="pagehead">
+  <div>
+    <div class="eyebrow"><#menu5_3#></div>
+    <h1><#menu5_3_6#></h1>
+  </div>
+  <span class="pill" id="statepill"><span class="dot"></span><span id="statetext"></span></span>
+  <div class="spacer"></div>
+  <span class="pill warn chgpill" id="chgpill"><span class="dot"></span><span><#RADM_77#>: <b id="chgcount">0</b></span></span>
+  <button type="button" class="btn ghost" id="discardbtn" disabled><#Discard#></button>
+  <button type="button" class="btn primary" id="applybtn"><#CTL_apply#></button>
+</div>
+<div class="msg" id="topmsg" style="margin:-6px 0 12px"></div>
+<div class="hint" style="margin:-4px 0 14px"><#RDDN_01#></div>
+
+<div class="rframe">
+<div class="panel" id="p_ddns">
+  <h2><#LANHostConfig_x_DDNSEnable_sectionname#></h2>
+  <div class="secerr"><#RADM_78#></div>
+  <div class="frow"><div class="fl"><#LANHostConfig_x_DDNSEnable_itemname#></div><div class="fc"><label class="tswitch"><input type="checkbox" id="t_ddns"><span class="track"></span></label></div><div class="fh"><#RDDN_02#></div><div class="note" id="asusnote"></div></div>
