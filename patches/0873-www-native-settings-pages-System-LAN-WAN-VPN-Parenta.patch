+
+/* ---------- state words ---------- */
+var ERRNO = {1: `<#vpn_openvpn_conflict#>`, 2: `<#vpn_openvpn_conflict#>`, 3: `<#vpn_openvpn_conflict#>`, 4: `<#qis_fail_desc1#>`, 5: `<#qis_fail_desc1#>`, 6: `<#qis_fail_desc1#>`, 7: `<#RVST_14#>`, 8: `<#RVST_15#>`};
