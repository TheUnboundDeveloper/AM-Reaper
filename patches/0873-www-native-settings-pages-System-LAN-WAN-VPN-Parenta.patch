+.rtab th .dir{display:inline-block;width:10px;margin-left:3px}
+.rtab td{padding:7px 8px;border-bottom:1px solid var(--line-soft);color:var(--bone-dim);vertical-align:top}
+.rtab td.mono{font-family:var(--mono);white-space:nowrap}
+.rtab td .sub2{display:block;color:var(--steel);font-size:11.5px;font-family:var(--mono)}
+.empty{color:var(--steel);font-size:12.5px;padding:8px 0}
+.legend{font-size:12px;color:var(--steel);margin-top:4px}
+.drv{background:#000;border:1px solid var(--line-soft);border-radius:10px;color:var(--bone-dim);font-family:var(--mono);font-size:11.5px;line-height:1.45;padding:10px 12px;max-height:50vh;overflow:auto;white-space:pre-wrap;word-break:break-all;margin:10px 0 0}
+</style>
+</head>
+<body>
+<script src="/reaper_util.js"></script>
+<script src="/reaper/rp.js"></script>
+
+<div class="syswrap">
+<div class="pagehead">
+  <div>
+    <div class="eyebrow"><#System_Log#></div>
+    <h1><#menu5_7_4#></h1>
+  </div>
+  <span class="pill"><span class="dot"></span><span id="count"></span></span>
+  <div class="spacer"></div>
+  <div class="bar"><span class="hint" style="margin:0"><#RLOG_67#></span>
+    <select id="s_rate"><option value="0"><#RLOG_68#></option><option value="3">3 s</option><option value="5">5 s</option><option value="10">10 s</option></select></div>
+  <button type="button" class="btn" id="b_refresh"><#CTL_refresh#></button>
+</div>
+<div class="hint" style="margin:-4px 0 14px"><#RLOG_69#></div>
+
+<div class="rframe">
+<div id="radios"></div>
+<div class="panel" id="p_drv">
+  <h2><#RLOG_70#></h2>
+  <div class="sub"><#RLOG_71#></div>
+  <button type="button" class="btn" id="b_drv"><#RLOG_72#></button>
+  <pre class="drv" id="drv" style="display:none"></pre>
+</div>
+</div>
+</div>
+
+<script>
+(function(){
+'use strict';
+var q = rp.q, hx = rp.esc;
+var NB = ['<% nvram_get("wl0_nband"); %>', '<% nvram_get("wl1_nband"); %>', '<% nvram_get("wl2_nband"); %>', '<% nvram_get("wl3_nband"); %>'];
+var IFN = '<% nvram_get("wl_ifnames"); %>'.trim().split(/\s+/).filter(Boolean);
+var SORT = {k: 'rssi', dir: -1}, timer = null, DATA = null;
+try { var s = JSON.parse(localStorage.getItem('rwlog_sort') || 'null'); if (s && s.k) SORT = s; } catch (e) {}
+
+/* band name by wlN_nband; a second radio on the same band gets -1 / -2 (GT-BE98 family) */
+function bandNames(){
+  var base = NB.map(function(b){ return b === '2' ? '2.4 GHz' : b === '1' ? '5 GHz' : b === '4' ? '6 GHz' : ''; }), n = {}, out = [];
+  base.forEach(function(b){ if (b) n[b] = (n[b] || 0) + 1; });
+  var seen = {};
+  base.forEach(function(b, i){ if (!b){ out[i] = 'Radio ' + i; return; } seen[b] = (seen[b] || 0) + 1; out[i] = n[b] > 1 ? b + '-' + seen[b] : b; });
+  return out;
+}
+/* the endpoint is JS assignments; run them inside a function so nothing lands on window */
+function parse(txt){
+  var src = 'var dataarray0, dataarray1, dataarray2, dataarray3, wificlients0, wificlients1, wificlients2, wificlients3,' +
+    ' dfs_statusarray0, dfs_statusarray1, dfs_statusarray2, dfs_statusarray3;\n' + txt +
+    '\n;return {d: [dataarray0, dataarray1, dataarray2, dataarray3], c: [wificlients0, wificlients1, wificlients2, wificlients3],' +
+    ' f: [dfs_statusarray0, dfs_statusarray1, dfs_statusarray2, dfs_statusarray3]};';
+  return (new Function(src))();
+}
+var COLS = [
+  {k: 'name', h: `<#RLOG_49#>`, t: 'text'}, {k: 'ip', h: `<#RLOG_51#>`, t: 'ip'}, {k: 'mac', h: `<#RLOG_52#>`, t: 'text'},
+  {k: 'rssi', h: 'RSSI', t: 'num'}, {k: 'rate', h: `<#RLOG_73#>`, t: 'num'}, {k: 'time', h: `<#RLOG_74#>`, t: 'num'},
+  {k: 'phy', h: `<#RLOG_75#>`, t: 'text'}, {k: 'net', h: `<#RLOG_76#>`, t: 'text'}, {k: 'flags', h: `<#RLOG_77#>`, t: 'text'}];
+function secs(t){ var m = /(\d+):(\d+):(\d+)/.exec(t || ''); return m ? (+m[1]) * 3600 + (+m[2]) * 60 + (+m[3]) : -1; }
+function clients(list){
+  return (list || []).filter(function(r){ return r && typeof r === 'object' && r.length >= 12; }).map(function(r){
+    var net = r[12] === 'Main BSS' ? `<#RLOG_78#>` : (r[12] ? r[12] + (r[13] && r[13] !== '0' ? ' (VLAN ' + r[13] + ')' : '') : `<#RLOG_79#>`);
+    return {mac: r[0], ip: r[1], name: r[2], ip6: r[3], rssi: parseInt(r[4], 10), rx: r[5], tx: r[6], rate: parseInt(r[6], 10) || 0,
+      conn: String(r[7] || '').trim(), time: secs(r[7]), phy: [r[8] ? r[8] + 'x' : '', r[9], r[10]].filter(Boolean).join(' '), flags: r[11], net: net};
+  });
+}
+function radioHtml(i, label, d, f, list){
+  var h = '<div class="panel"><h2>' + hx(label) + '</h2>';
+  if (!d || !d.length){ return h + '<div class="empty">' + hx(`<#RLOG_80#>`) + '</div></div>'; }
+  var kv = [[`SSID`, d[0]], ['BSSID', d[5]], [`<#RLOG_81#>`, d[4]], ['RSSI / SNR / Noise', [d[1], d[2], d[3]].join(' / ')], [`<#RLOG_82#>`, d[6] !== undefined && d[6] !== '' ? d[6] + '%' : '-'], [`<#RLOG_83#>`, d[7]]];
+  if (f && f.length) kv.push(['DFS', f[0] + ' (' + f[1] + ', ' + f[2] + ')']);
+  h += '<div class="kv">' + kv.map(function(x){ return '<div><div class="k">' + hx(x[0]) + '</div><div class="v">' + hx(x[1] === undefined || x[1] === '' ? '-' : x[1]) + '</div></div>'; }).join('') + '</div>';
+  if (!list.length) return h + '<div class="empty">' + hx(`<#RLOG_84#>`) + '</div></div>';
+  var col = COLS.filter(function(c){ return c.k === SORT.k; })[0] || COLS[3], cmp = rp.cmp(col.t);
+  list.sort(function(a, b){ return SORT.dir * cmp(a[col.k], b[col.k]) || rp.cmp('ip')(a.ip, b.ip); });
+  h += '<table class="rtab"><thead><tr>' + COLS.map(function(c){ return '<th data-k="' + c.k + '"' + (c.k === col.k ? ' class="on"' : '') + '>' + hx(c.h) +
+    '<span class="dir">' + (c.k === col.k ? (SORT.dir > 0 ? '&#9650;' : '&#9660;') : '') + '</span></th>'; }).join('') + '</tr></thead><tbody>';
+  list.forEach(function(r){
+    h += '<tr><td class="name">' + hx(r.name || '-') + '</td><td class="mono">' + hx(r.ip || '-') + (r.ip6 ? '<span class="sub2">' + hx(r.ip6) + '</span>' : '') +
+      '</td><td class="mono">' + hx(r.mac) + '</td><td class="mono">' + hx(isNaN(r.rssi) ? '?' : r.rssi + ' dBm') + '</td><td class="mono">' + hx((r.rx || '-') + ' / ' + (r.tx || '-')) +
+      '</td><td class="mono">' + hx(r.conn || '-') + '</td><td class="mono">' + hx(r.phy || '-') + '</td><td>' + hx(r.net) + '</td><td class="mono">' + hx(r.flags || '') + '</td></tr>';
+  });
+  return h + '</tbody></table></div>';
+}
+function draw(){
+  if (!DATA) return;
+  var names = bandNames(), h = '', total = 0, i;
+  for (i = 0; i < IFN.length && i < 4; i++){
+    var list = clients(DATA.c[i]); total += list.length;
+    h += radioHtml(i, names[i], DATA.d[i], DATA.f[i], list);
+  }
+  h += '<div class="legend">' + hx(`<#RLOG_85#>`) + '</div>';
+  q('radios').innerHTML = h;
+  q('count').textContent = total + ' ' + `<#RLOG_86#>`;
+}
+function load(){
+  var x = new XMLHttpRequest();
+  x.open('GET', '/ajax_reaper_wlstatus.asp?_=' + Date.now(), true); x.timeout = 15000;
+  x.onload = function(){ if (x.status !== 200) return; try { DATA = parse(x.responseText); draw(); } catch (e) { if (window.console) console.error('Reaper_WLog: parse', e); } };
+  x.send();
+}
+function schedule(){
+  if (timer){ clearInterval(timer); timer = null; }
+  var r = parseInt(q('s_rate').value, 10) || 0;
+  try { localStorage.setItem('rwlog_rate', String(r)); } catch (e) {}
+  if (r) timer = setInterval(function(){ if (!document.hidden) load(); }, r * 1000);
+}
+/* the closed driver dump: URI-encoded text with \xNN runs and \n escapes; on demand only */
+function driver(){
+  var box = q('drv'), x = new XMLHttpRequest();
+  box.style.display = ''; box.textContent = `<#RLOG_87#>`;
+  x.open('GET', '/wl_log.asp?_=' + Date.now(), true); x.timeout = 15000;
+  x.onload = function(){
+    var t = x.responseText || '';
+    try { t = decodeURIComponent(t); } catch (e) {}
+    t = t.replace(/(?:\\x[\da-fA-F]{2})+/g, function(m){ try { return decodeURIComponent(m.replace(/\\x/g, '%')); } catch (e) { return m; } }).replace(/\\n/g, '\n');
+    box.textContent = t.trim().length > 10 ? t : `<#RLOG_88#>`;
+  };
+  x.onerror = x.ontimeout = function(){ box.textContent = `<#RLOG_88#>`; };
+  x.send();
+}
+q('radios').addEventListener('click', function(e){
+  var th = e.target.closest ? e.target.closest('th[data-k]') : null; if (!th) return;
+  var k = th.getAttribute('data-k'); SORT = {k: k, dir: SORT.k === k ? -SORT.dir : (k === 'rssi' || k === 'rate' ? -1 : 1)};
+  try { localStorage.setItem('rwlog_sort', JSON.stringify(SORT)); } catch (e2) {}
+  draw();
+});
+try { var r0 = localStorage.getItem('rwlog_rate'); if (r0 !== null) q('s_rate').value = r0; else q('s_rate').value = '5'; } catch (e) { q('s_rate').value = '5'; }
+q('s_rate').addEventListener('change', schedule);
+q('b_refresh').addEventListener('click', load);
+q('b_drv').addEventListener('click', driver);
+document.addEventListener('visibilitychange', function(){ if (!document.hidden && timer) load(); });
+load(); schedule();
+})();
+</script>
+</body>
+</html>
diff --git a/release/src/router/www/Reaper_WOL.asp b/release/src/router/www/Reaper_WOL.asp
new file mode 100644
index 0000000000..f75f0020d1
--- /dev/null
+++ b/release/src/router/www/Reaper_WOL.asp
@@ -0,0 +1,183 @@
+<!-- SPDX-License-Identifier: GPL-2.0-only
+     Copyright (C) 2026 the Reaper project maintainer
+     Part of the Reaper hardened Asuswrt-Merlin build. See LICENSE / LICENSE.reaper. -->
+<!DOCTYPE html>
+<html lang="en">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width, initial-scale=1">
+<meta name="reaper-native" content="1">
+<title>REAPER &mdash; <#NetworkTools_WOL#></title>
+<!-- Reaper_WOL.asp - Network Tools > Wake on LAN (Reaper-native UI, Network Tools wave, 2026-10-23).
+     Replaces Main_WOL_Content.asp. Wake = reaper_net.cgi tool=wake: the server validates the MAC (6 octets) and
+     runs `ether-wake -i br0 -b <MAC>` itself (the stock page sent a whole ether-wake command line). The saved list
+     is the stock nvram key wollist ("<name>MAC<name>MAC...", CKN_STR1024): names lose '<', '>' and control
+     characters (they are the field separators), the serialized list must stay under 1 KB (nvram cap), and every
+     name is escaped on render (stock pasted names into the page raw). Device picker = the Devices page's own
+     list (reaper_dev.cgi?action=status). -->
+<link rel="stylesheet" href="/reaper/rp.css">
+<style>
+.frow input.mid{width:200px} .frow select{min-width:260px;max-width:100%}
+.btns{display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin-top:14px}
+.msg{font-size:12.5px;color:var(--amber);display:none} 
+.msg.ok{color:var(--jade)}
+.rtab td{padding:7px 10px;border-bottom:1px solid var(--line-soft);color:var(--bone-dim);vertical-align:middle}
+.rtab td.mono{font-family:var(--mono)}
+.rtab .btn.small{padding:5px 12px}
+.empty{color:var(--steel);font-size:12.5px;padding:8px 0}
+.bytes{font-size:12px;color:var(--steel)}
+</style>
+</head>
+<body>
+<script src="/reaper_util.js"></script>
+<script src="/reaper/rp.js"></script>
+
+<div class="syswrap">
+<div class="pagehead">
+  <div>
+    <div class="eyebrow"><#Network_Tools#></div>
+    <h1><#NetworkTools_WOL#></h1>
+  </div>
+  <div class="spacer"></div>
+  <span class="pill warn chgpill" id="chgpill"><span class="dot"></span><span><#RADM_77#></span></span>
+</div>
+<div class="hint" style="margin:-4px 0 14px"><#RNT_36#></div>
+
+<div class="rframe">
+<div class="panel" id="p_wake">
+  <h2><#RNT_37#></h2>
+  <div class="frow"><div class="fl"><#RNT_38#></div><div class="fc"><select id="s_dev"><option value=""><#RNT_39#></option></select></div></div>
+  <div class="frow"><div class="fl"><#RLOG_52#></div><div class="fc"><input type="text" class="mid mono" id="i_mac" maxlength="17" placeholder="AA:BB:CC:DD:EE:FF" autocomplete="off">
+    <button type="button" class="btn primary" id="b_wake"><#RNT_40#></button></div></div>
+  <div class="btns"><span class="msg" id="wakemsg"></span></div>
+</div>
+
+<div class="panel" id="p_list">
+  <h2><#RNT_41#></h2>
+  <div class="sub"><#RNT_42#></div>
+  <div id="list"></div>
+  <div class="frow"><div class="fl"><#RNT_43#></div><div class="fc">
+    <input type="text" class="mid" id="a_name" maxlength="32" placeholder="<#RLOG_49#>" autocomplete="off">
+    <input type="text" class="mid mono" id="a_mac" maxlength="17" placeholder="AA:BB:CC:DD:EE:FF" autocomplete="off">
+    <button type="button" class="btn" id="b_add"><#RNT_44#></button></div></div>
+  <div class="btns">
+    <button type="button" class="btn primary" id="b_save"><#CTL_apply#></button>
+    <button type="button" class="btn ghost" id="b_discard" disabled><#Discard#></button>
+    <span class="bytes" id="bytes"></span>
+    <span class="msg" id="listmsg"></span>
+  </div>
+</div>
+</div>
+</div>
+
+<div class="applying" id="applying"><div class="abox"><h2 id="ap_t"><#Reaper_c_applying#></h2><p id="ap_p"><#RADM_61#></p></div></div>
+<iframe name="hidden_frame" id="hidden_frame" style="display:none" width="0" height="0"></iframe>
+<form method="post" name="form" action="/start_apply.htm" target="hidden_frame">
+  <input type="hidden" name="current_page" value="Reaper_WOL.asp">
+  <input type="hidden" name="next_page" value="Reaper_WOL.asp">
+  <input type="hidden" name="action_mode" value="apply">
+  <input type="hidden" name="action_script" value="saveNvram">
+  <input type="hidden" name="action_wait" value="1">
+  <input type="hidden" name="wollist" value="" disabled>
+</form>
+
+<script>
+(function(){
+'use strict';
+var q = rp.q, hx = rp.esc;
+var U = rp.dec;   /* the kit's copies (rp.js) */
+var HTTPID = '<% nvram_get("http_id"); %>';
+var NV_LIST = U('<% nvram_char_to_ascii("","wollist"); %>');
+var LIST = [], DEVS = [], timer = null;
+var MAXB = 1000;   /* wollist is CKN_STR1024; stay under the 1 KB nvram value cap */
+
+function msg(id, t, ok){ var m = q(id); m.textContent = t || ''; m.classList.toggle('show', !!t); m.classList.toggle('ok', !!ok); }
+function macOk(s){ return /^([0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}$/.test(s); }
+/* names: no '<' '>' (the list separators) and no control characters */
+function cleanName(s){ return String(s || '').replace(/[<>\x00-\x1f\x7f]/g, '').trim().slice(0, 32); }
+function parse(s){ var out = [], re = /<([^<>]*)>([0-9A-Fa-f:]{17})/g, m; while ((m = re.exec(s))) out.push({name: m[1], mac: m[2].toUpperCase()}); return out; }
+function serialize(){ return LIST.map(function(r){ return '<' + r.name + '>' + r.mac; }).join(''); }
+var BASE = parse(NV_LIST).map(function(r){ return '<' + r.name + '>' + r.mac; }).join('');   /* the saved list, normalised */
+function dirty(){ var ch = serialize() !== BASE;
+  q('chgpill').classList.toggle('show', ch); q('b_discard').disabled = !ch;
+  var n = serialize().length; q('bytes').textContent = n + ' / ' + MAXB + ' B'; return ch; }
+function draw(){
+  if (!LIST.length){ q('list').innerHTML = '<div class="empty">' + hx(`<#RNT_45#>`) + '</div>'; dirty(); return; }
+  var h = `<table class="rtab"><thead><tr><th><#RLOG_49#></th><th><#RLOG_52#></th><th></th></tr></thead><tbody>`;
+  LIST.forEach(function(r, i){
+    h += '<tr><td class="name">' + hx(r.name || '-') + '</td><td class="mono">' + hx(r.mac) + '</td><td style="text-align:right;white-space:nowrap">' +
+      '<button type="button" class="btn small" data-wake="' + i + '">' + hx(`<#RNT_40#>`) + '</button> ' +
+      '<button type="button" class="btn small ghost" data-del="' + i + '">&times;</button></td></tr>';
+  });
+  q('list').innerHTML = h + '</tbody></table>'; dirty();
+}
+
+/* ---------- wake through reaper_net.cgi ---------- */
+function call(params, cb){ rp.net(HTTPID, params, cb); }
+function wake(mac){
+  msg('wakemsg', '');
+  mac = String(mac || '').trim().toUpperCase();
+  if (!macOk(mac)){ msg('wakemsg', `<#RNT_46#>`); return; }
+  call('action=start&tool=wake&iface=br0&target=' + encodeURIComponent(mac), function(d){
+    if (!d){ msg('wakemsg', `<#RNT_27#>`); return; }
+    if (!d.ok){ msg('wakemsg', d.error === 'E_BUSY' ? `<#RNT_18#>` : d.error === 'E_MAC' ? `<#RNT_46#>` : (d.error || `<#RNT_27#>`)); return; }
+    var tries = 0;
+    if (timer) clearInterval(timer);
+    timer = setInterval(function(){
+      call('action=status', function(s){
+        if (!s || !s.ok || s.state === 'running'){ if (++tries > 15){ clearInterval(timer); msg('wakemsg', `<#RNT_27#>`); } return; }
+        clearInterval(timer);
+        if (s.state === 'done' && s.rc === 0) msg('wakemsg', `<#RNT_47#>` + ' ' + mac, true);
+        else msg('wakemsg', `<#RNT_27#>`);
+      });
+    }, 700);
+  });
+}
+
+/* ---------- device picker (the Devices page's list) ---------- */
+function loadDevices(){
+  var x = new XMLHttpRequest();
+  x.open('GET', '/reaper_dev.cgi?action=status&http_id=' + encodeURIComponent(HTTPID), true); x.timeout = 15000;
+  x.onload = function(){
+    var j = null; try { j = JSON.parse(x.responseText); } catch (e) {}
+    DEVS = (j && j.devices) ? j.devices.filter(function(d){ return d && macOk(String(d.mac || '')); }) : [];
+    /* offline first: those are the ones worth waking */
+    DEVS.sort(function(a, b){ return (a.online ? 1 : 0) - (b.online ? 1 : 0) || rp.cmp('text')(a.name || a.host, b.name || b.host); });
+    q('s_dev').innerHTML = '<option value="">' + hx(`<#RNT_39#>`) + '</option>' + DEVS.map(function(d, i){
+      return '<option value="' + i + '">' + hx((d.name || d.host || d.mac) + '  ' + d.mac + (d.online ? '  (' + `<#RNT_48#>` + ')' : '')) + '</option>';
+    }).join('');
+  };
+  x.send();
+}
+
+q('s_dev').addEventListener('change', function(){ var d = DEVS[+q('s_dev').value]; if (d){ q('i_mac').value = String(d.mac).toUpperCase(); q('a_mac').value = String(d.mac).toUpperCase(); q('a_name').value = cleanName(d.name || d.host); } });
+q('b_wake').addEventListener('click', function(){ wake(q('i_mac').value); });
+q('i_mac').addEventListener('keydown', function(e){ if (e.key === 'Enter') wake(q('i_mac').value); });
+q('list').addEventListener('click', function(e){
+  var t = e.target;
+  if (t.hasAttribute('data-wake')){ var r = LIST[+t.getAttribute('data-wake')]; if (r){ q('i_mac').value = r.mac; wake(r.mac); } }
+  else if (t.hasAttribute('data-del')){ LIST.splice(+t.getAttribute('data-del'), 1); draw(); }
+});
+q('b_add').addEventListener('click', function(){
+  msg('listmsg', '');
+  var name = cleanName(q('a_name').value), mac = q('a_mac').value.trim().toUpperCase();
+  if (!macOk(mac)){ msg('listmsg', `<#RNT_46#>`); q('a_mac').focus(); return; }
+  if (LIST.some(function(r){ return r.mac === mac; })){ msg('listmsg', `<#RNT_49#>`); return; }
+  LIST.push({name: name, mac: mac});
+  if (serialize().length > MAXB){ LIST.pop(); msg('listmsg', `<#RNT_50#>`); return; }
+  q('a_name').value = ''; q('a_mac').value = ''; draw();
+});
+q('b_save').addEventListener('click', function(){
+  msg('listmsg', '');
+  if (!dirty()){ msg('listmsg', `<#RADM_63#>`); return; }
+  if (serialize().length > MAXB){ msg('listmsg', `<#RNT_50#>`); return; }
+  rp.applying(`<#Reaper_c_applying#>`, `<#RADM_61#>`);
+  rp.post(document.form, {wollist: serialize()}, 'saveNvram', 1, false);
+  setTimeout(function(){ location.reload(); }, 5000);
+});
+q('b_discard').addEventListener('click', function(){ LIST = parse(NV_LIST); draw(); });
+LIST = parse(NV_LIST); draw(); loadDevices();
+})();
+</script>
