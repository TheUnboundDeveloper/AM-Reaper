+<!-- SPDX-License-Identifier: GPL-2.0-only
+     Copyright (C) 2026 the Reaper project maintainer
+     Part of the Reaper hardened Asuswrt-Merlin build. See LICENSE / LICENSE.reaper. -->
+<!DOCTYPE html>
+<html lang="en">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width, initial-scale=1">
+<meta name="reaper-native" content="1">
+<title>REAPER &mdash; <#smart_connect_rule#></title>
+<!-- Reaper_SmartConnect.asp - Network Tools > Smart Connect Rule (Reaper-native UI, Network Tools wave, 2026-10-23).
+     Replaces Advanced_Smart_Connect.asp; same nvram, same meaning. Per band unit N (wl<N><sub>_ for the two
+     subunit keys when the sdn_mainfh support flag is set, as stock):
+       wlN_bsd_steering_policy     "bwutil x x rssi phyLess phyGreater 0xFLAGS"  bit1 RSSI greater, bit6 load balance,
+                                   capability bit11 ax only / bit10 a/b/g/n/ac / bit3 ac/ax only / bit2 a/b/g/n
+       wlN<sub>_bsd_sta_select_policy  11 fields: [1] rssi [2] phyLess [3] phyGreater [10] 0xFLAGS  (bit1 RSSI,
+                                   capability bit15 / bit14 / bit3 / bit2)
+       wlN_bsd_if_qualify_policy   "bwutil 0xFLAGS ..."  capability bit11 / bit10 / bit2 / bit1
+       wlN<sub>_bsd_if_select_policy   target interfaces in order, space separated
+       bsd_bounce_detect           "window counts dwell"
+     Bit n = string position length-(n+1) of the 32-bit binary, as the stock page reads it. Stock bugs not carried:
+     load balance could not be turned off (bit6 never cleared); a capability choice added its bit without clearing
+     the others (bits piled up; if_qualify "All" cleared bit9 instead of bit11); Restore defaults also reset
+     wlN_txchain (a TX chain mask, not a Smart Connect setting). Only bands in the Smart Connect group
+     (smart_connect_selif_x, bit = slot in ["2G","5G1","5G2","6G1","6G2"]) are editable, as stock. Only changed
+     keys are posted (stock reposted smart_connect_x / selif / txchain every time), through /applyapp.cgi with
+     restart_wireless like the stock page. Once cfg_server has migrated the main network to SDN (sdn_rl carries
+     MAINFH) the on/off switch lives on the Network page and this page links there instead. -->
+<link rel="stylesheet" href="/reaper/rp.css">
+<style>
+.sctab{width:100%;border-collapse:collapse;font-size:12.5px}
+.sctab th{font-family:var(--hdr);font-weight:600;font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:var(--steel);text-align:left;padding:8px 10px;border-bottom:1px solid var(--line-soft)}
+.sctab td{padding:8px 10px;border-bottom:1px solid var(--line-soft);color:var(--bone-dim);vertical-align:middle}
+.sctab tr:last-child td{border-bottom:none}
+.sctab td.l{font-family:var(--hdr);font-weight:600;color:var(--bone);width:24%}
+.sctab td.na{color:var(--steel);text-align:center;cursor:help}
+.sctab input[type=text]{background:#000;border:1px solid var(--line-soft);border-radius:7px;color:var(--bone);font-family:var(--mono);font-size:12.5px;padding:6px 8px;outline:none;width:76px}
+.sctab select{background:#000;border:1px solid var(--line-soft);border-radius:7px;color:var(--bone);font-family:var(--body);font-size:12.5px;padding:6px 8px;outline:none;max-width:170px}
+.sctab .unit{color:var(--steel);font-size:11.5px;margin-left:4px}
+.sctab .bad{border-color:var(--crimson)!important;box-shadow:0 0 0 2px rgba(225,6,0,.25)}
+.sctab td .row{display:flex;gap:6px;align-items:center;flex-wrap:wrap}
+.btns{display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin-top:14px}
+.msg{font-size:12.5px;color:var(--amber);display:none} 
+.off{opacity:.45;pointer-events:none}
+.tswitch{display:inline-block;vertical-align:middle}
+</style>
+</head>
+<body>
+<script src="/reaper_util.js"></script>
+<script src="/reaper/rp.js"></script>
+
+<div class="syswrap">
+<div class="pagehead">
+  <div>
+    <div class="eyebrow"><#Network_Tools#></div>
+    <h1><#smart_connect_rule#></h1>
+  </div>
+  <span class="pill" id="scpill"><span class="dot"></span><span id="sctext"></span></span>
+  <div class="spacer"></div>
+  <span class="pill warn chgpill" id="chgpill"><span class="dot"></span><span><#RADM_77#>: <b id="chgcount">0</b></span></span>
+  <button type="button" class="btn ghost" id="discardbtn" disabled><#Discard#></button>
+  <button type="button" class="btn primary" id="applybtn"><#CTL_apply#></button>
+</div>
+<div class="msg" id="topmsg" style="margin:-6px 0 12px"></div>
+<div class="hint" style="margin:-4px 0 14px"><#RNT_51#> <a class="link" href="/reaper_shell.asp#Reaper_WLog.asp" target="_top"><#menu5_7_4#></a></div>
+
+<div class="rframe">
+<div class="panel" id="p_master">
+  <h2><#RNT_52#></h2>
+  <div class="sub" id="mastersub"></div>
+  <div class="btns" style="margin-top:4px"><button type="button" class="btn" id="b_toggle"></button></div>
+</div>
+<div id="rules">
+<div class="panel"><h2><#RNT_53#></h2><div class="sub"><#RNT_54#></div><table class="sctab" id="t_steer"></table></div>
+<div class="panel"><h2><#RNT_55#></h2><div class="sub"><#RNT_56#></div><table class="sctab" id="t_sta"></table></div>
+<div class="panel"><h2><#RNT_57#></h2><div class="sub"><#RNT_58#></div><table class="sctab" id="t_if"></table></div>
+<div class="panel"><h2><#RNT_59#></h2><div class="sub"><#RNT_60#></div><table class="sctab" id="t_bounce"></table>
+  <div class="btns"><button type="button" class="btn ghost" id="b_restore"><#RNT_61#></button></div></div>
+</div>
+</div>
+</div>
+
+<div class="applying" id="applying"><div class="abox"><h2 id="ap_t"><#Reaper_c_applying#></h2><p id="ap_p"><#RNT_62#></p></div></div>
+
+<script>
+(function(){
+'use strict';
+var q = rp.q, hx = rp.esc;
+var U = rp.dec;   /* the kit's copies (rp.js) */
+var UI = {}; try { UI = [<% get_ui_support(); %>][0] || {}; } catch (e) {}
+var NB = ['<% nvram_get("wl0_nband"); %>', '<% nvram_get("wl1_nband"); %>', '<% nvram_get("wl2_nband"); %>', '<% nvram_get("wl3_nband"); %>'];
+var IFN = '<% nvram_get("wl_ifnames"); %>'.trim().split(/\s+/).filter(Boolean);
+var SDN_RL = U('<% nvram_char_to_ascii("","sdn_rl"); %>'), AP_RL = U('<% nvram_char_to_ascii("","ap_wifi_rl"); %>');
+var SC_X = '<% nvram_get("smart_connect_x"); %>', SELIF = '<% nvram_get("smart_connect_selif_x"); %>';
+var SDN_MIGRATED = SDN_RL.indexOf('>MAINFH') >= 0 || SDN_RL.indexOf('MAINFH') >= 0;
+var SLOTS = ['2G', '5G1', '5G2', '6G1', '6G2'];
+var CAPS = [['0', `<#All#>`], ['1', '802.11ac/ax only'], ['2', '802.11a/b/g/n'], ['3', '802.11ax only'], ['4', '802.11a/b/g/n/ac']];
+
+/* bands present: unit, title, slot (5 GHz / 6 GHz numbered in unit order, as stock bandName) */
+var BANDS = (function(){
+  var out = [], n5 = 0, n6 = 0, c5 = NB.filter(function(b){ return b === '1'; }).length, c6 = NB.filter(function(b){ return b === '4'; }).length;
+  for (var u = 0; u < IFN.length && u < 4; u++){
+    var b = NB[u], slot = '', title = '';
+    if (b === '2'){ slot = '2G'; title = '2.4 GHz'; }
+    else if (b === '1'){ n5++; slot = '5G' + n5; title = c5 > 1 ? '5 GHz-' + n5 : '5 GHz'; }
+    else if (b === '4'){ n6++; slot = '6G' + n6; title = c6 > 1 ? '6 GHz-' + n6 : '6 GHz'; }
+    if (slot) out.push({unit: u, slot: slot, bit: SLOTS.indexOf(slot), title: title});
+  }
+  return out;
+})();
+/* sdn_mainfh: the two per-subunit keys follow the main network's subunit (stock getMainFhSubunit) */
+var SUB = (function(){
+  if (!UI.sdn_mainfh) return '';
+  var main = SDN_RL.split('>MAINFH')[0].split('<').pop(), s = AP_RL.split('>' + main)[0].split('.').pop();
+  return /^\d+$/.test(s) ? '.' + s : '.1';
+})();
+function inGroup(b){ return (parseInt(SELIF, 10) || 0) & (1 << b.bit); }
+function K(b){ return {steer: 'wl' + b.unit + '_bsd_steering_policy', sta: 'wl' + b.unit + SUB + '_bsd_sta_select_policy',
+  sel: 'wl' + b.unit + SUB + '_bsd_if_select_policy', qual: 'wl' + b.unit + '_bsd_if_qualify_policy'}; }
+
+/* ---------- flag bits ---------- */
+function bitsOf(hex){ var v = parseInt(hex, 16); return isNaN(v) ? 0 : v >>> 0; }
+function hexOf(v){ return '0x' + (v >>> 0).toString(16); }
+function has(v, n){ return !!(v & (1 << n)); }
+/* capability <-> bits: [ax only, a/b/g/n/ac, ac/ax only, a/b/g/n] per policy */
+var CAPBITS = {steer: [11, 10, 3, 2], sta: [15, 14, 3, 2], qual: [11, 10, 2, 1]};
+function capRead(v, kind){ var c = CAPBITS[kind]; return has(v, c[0]) ? '3' : has(v, c[1]) ? '4' : has(v, c[2]) ? '1' : has(v, c[3]) ? '2' : '0'; }
+function capWrite(v, kind, cap){
+  var c = CAPBITS[kind], i;
+  for (i = 0; i < 4; i++) v &= ~(1 << c[i]);            /* one capability at a time (stock let them pile up) */
+  if (cap === '3') v |= 1 << c[0]; else if (cap === '4') v |= 1 << c[1]; else if (cap === '1') v |= 1 << c[2]; else if (cap === '2') v |= 1 << c[3];
+  return v >>> 0;
+}
+
+var NV = {};
+function fields(s, n){ var a = String(s || '').trim().split(/\s+/); while (a.length < n) a.push('0'); return a; }
+
+/* ---------- render ---------- */
+function head(){ return '<tr><th></th>' + BANDS.map(function(b){ return '<th>' + hx(b.title) + '</th>'; }).join('') + '</tr>'; }
+function na(){ return '<td class="na" title="' + hx(`<#RNT_63#>`) + '">- -</td>'; }
+function capSel(id, val){ return '<select id="' + id + '">' + CAPS.map(function(c){ return '<option value="' + c[0] + '"' + (c[0] === val ? ' selected' : '') + '>' + hx(c[1]) + '</option>'; }).join('') + '</select>'; }
+function num(id, val, unit){ return '<div class="row"><input type="text" id="' + id + '" value="' + hx(val) + '" maxlength="6">' + (unit ? '<span class="unit">' + hx(unit) + '</span>' : '') + '</div>'; }
+function rssi(id, dir, val){ return '<div class="row"><select id="' + id + '_d"><option value="0"' + (dir ? '' : ' selected') + '>' + hx(`<#option_less#>`) + '</option><option value="1"' + (dir ? ' selected' : '') + '>' +
+  hx(`<#option_greater#>`) + '</option></select><input type="text" id="' + id + '" value="' + hx(val) + '" maxlength="4"><span class="unit">dBm</span></div>'; }
+function row(label, cell){ return '<tr><td class="l">' + hx(label) + '</td>' + BANDS.map(function(b, i){ return inGroup(b) ? '<td>' + cell(b, i) + '</td>' : na(); }).join('') + '</tr>'; }
+
+function render(){
+  var h = head();
+  h += row(`<#RNT_64#>`, function(b, i){ var f = fields(NV[K(b).steer], 7), v = bitsOf(f[6]);
+    return '<label class="tswitch"><input type="checkbox" id="lb' + i + '"' + (has(v, 6) ? ' checked' : '') + '><span class="track"></span></label>'; });
+  h += row(`<#RNT_65#>`, function(b, i){ return num('st_bw' + i, fields(NV[K(b).steer], 7)[0], '%'); });
+  h += row('RSSI', function(b, i){ var f = fields(NV[K(b).steer], 7); return rssi('st_rssi' + i, has(bitsOf(f[6]), 1), f[3]); });
+  h += row(`<#RNT_66#>`, function(b, i){ return num('st_pl' + i, fields(NV[K(b).steer], 7)[4], 'Mbps'); });
+  h += row(`<#RNT_67#>`, function(b, i){ return num('st_pg' + i, fields(NV[K(b).steer], 7)[5], 'Mbps'); });
+  h += row(`<#RNT_68#>`, function(b, i){ return capSel('st_cap' + i, capRead(bitsOf(fields(NV[K(b).steer], 7)[6]), 'steer')); });
+  q('t_steer').innerHTML = h;
+
+  h = head();
+  h += row('RSSI', function(b, i){ var f = fields(NV[K(b).sta], 11); return rssi('sa_rssi' + i, has(bitsOf(f[10]), 1), f[1]); });
+  h += row(`<#RNT_66#>`, function(b, i){ return num('sa_pl' + i, fields(NV[K(b).sta], 11)[2], 'Mbps'); });
+  h += row(`<#RNT_67#>`, function(b, i){ return num('sa_pg' + i, fields(NV[K(b).sta], 11)[3], 'Mbps'); });
+  h += row(`<#RNT_68#>`, function(b, i){ return capSel('sa_cap' + i, capRead(bitsOf(fields(NV[K(b).sta], 11)[10]), 'sta')); });
+  q('t_sta').innerHTML = h;
+
+  h = head();
+  /* target bands in order: every other band of this router, then "none" from the second choice on */
+  var others = BANDS.length - 1, j;
+  for (j = 1; j <= others; j++){
+    h += row(`<#RNT_69#>` + ' ' + j, function(b, i){
+      var cur = String(NV[K(b).sel] || '').trim().split(/\s+/).filter(Boolean)[j - 1] || (j > 1 ? 'none' : '');
+      var opts = BANDS.filter(function(o){ return o.unit !== b.unit; }).map(function(o){ var ifn = 'wl' + o.unit + SUB;
+        return '<option value="' + ifn + '"' + (ifn === cur ? ' selected' : '') + '>' + hx(o.title) + '</option>'; }).join('');
+      return '<select id="if_sel' + i + '_' + j + '">' + opts + (j > 1 ? '<option value="none"' + (cur === 'none' ? ' selected' : '') + '>-</option>' : '') + '</select>';
+    });
+  }
+  h += row(`<#RNT_65#>`, function(b, i){ return num('if_bw' + i, fields(NV[K(b).qual], 2)[0], '%'); });
+  h += row(`<#RNT_68#>`, function(b, i){ return capSel('if_cap' + i, capRead(bitsOf(fields(NV[K(b).qual], 2)[1]), 'qual')); });
+  q('t_if').innerHTML = h;
+
+  var bd = fields(NV.bsd_bounce_detect, 3);
+  q('t_bounce').innerHTML = '<tr><td class="l">' + hx(`<#RNT_70#>`) + '</td><td>' + num('bd_win', bd[0], 's') + '</td></tr>' +
+    '<tr><td class="l">' + hx(`<#RNT_71#>`) + '</td><td>' + num('bd_cnt', bd[1], '') + '</td></tr>' +
+    '<tr><td class="l">' + hx(`<#RNT_72#>`) + '</td><td>' + num('bd_dwell', bd[2], 's') + '</td></tr>';
+  BANDS.forEach(function(b, i){ if (inGroup(b)) lbSync(i); });
+  dirty();
+}
+/* load balance on: the trigger thresholds do not apply (stock greyed them only after a click) */
+function lbSync(i){
+  var on = q('lb' + i) && q('lb' + i).checked;
+  ['st_bw', 'st_rssi', 'st_rssi', 'st_pl', 'st_pg', 'st_cap'].forEach(function(p){ var e = q(p + i); if (e) e.disabled = on; var d = q(p + i + '_d'); if (d) d.disabled = on; });
+}
+
+/* ---------- collect: new value per key, from the page ---------- */
+function v(id){ return q(id).value.trim(); }
+function collect(){
+  var c = {};
+  BANDS.forEach(function(b, i){
+    if (!inGroup(b)) return;
+    var k = K(b), st = fields(NV[k.steer], 7), sv = bitsOf(st[6]), lb = q('lb' + i).checked;
+    if (lb) sv |= 1 << 6;
+    else {
+      sv &= ~(1 << 6);                                 /* stock never cleared it: load balance could not be turned off */
+      st[0] = v('st_bw' + i); st[3] = v('st_rssi' + i); st[4] = v('st_pl' + i); st[5] = v('st_pg' + i);
+      sv = q('st_rssi' + i + '_d').value === '1' ? (sv | 2) : (sv & ~2);
+      sv = capWrite(sv, 'steer', q('st_cap' + i).value);
+    }
+    st[6] = hexOf(sv); c[k.steer] = st.join(' ');
+    var sa = fields(NV[k.sta], 11), av = bitsOf(sa[10]);
+    sa[1] = v('sa_rssi' + i); sa[2] = v('sa_pl' + i); sa[3] = v('sa_pg' + i);
+    av = q('sa_rssi' + i + '_d').value === '1' ? (av | 2) : (av & ~2);
+    sa[10] = hexOf(capWrite(av, 'sta', q('sa_cap' + i).value)); c[k.sta] = sa.join(' ');
+    var qu = fields(NV[k.qual], 2); qu[0] = v('if_bw' + i); qu[1] = hexOf(capWrite(bitsOf(qu[1]), 'qual', q('if_cap' + i).value)); c[k.qual] = qu.join(' ');
+    var sel = [], j;
+    for (j = 1; j < BANDS.length; j++){ var e = q('if_sel' + i + '_' + j); if (e && e.value && e.value !== 'none' && sel.indexOf(e.value) < 0) sel.push(e.value); }
+    c[k.sel] = sel.join(' ');
+  });
+  c.bsd_bounce_detect = [v('bd_win'), v('bd_cnt'), v('bd_dwell')].join(' ');
+  return c;
+}
+/* an untouched value keeps nvram's exact spelling (hex case, spacing) */
+function norm(s){ return String(s || '').trim().split(/\s+/).map(function(x){ return /^0x[0-9a-f]+$/i.test(x) ? '0x' + parseInt(x, 16).toString(16) : x; }).join(' '); }
+function diff(c){ var ch = {}, k; for (k in c) if (norm(c[k]) !== norm(NV[k])) ch[k] = c[k]; return ch; }
+function dirty(){ var n = 0, k, ch; try { ch = diff(collect()); } catch (e) { return; } for (k in ch) n++;
+  rp.pill(n); }
+function validate(){
+  var bad = null;
+  function chk(id, lo, hi){ var e = q(id); if (!e || e.disabled || bad) return; if (!rp.v.int(e.value.trim(), lo, hi)){ bad = e; } }
+  BANDS.forEach(function(b, i){ if (!inGroup(b)) return;
+    chk('st_bw' + i, 0, 100); chk('st_rssi' + i, -100, 0); chk('st_pl' + i, 0, 11530); chk('st_pg' + i, 0, 11530);
+    chk('sa_rssi' + i, -100, 0); chk('sa_pl' + i, 0, 11530); chk('sa_pg' + i, 0, 11530); chk('if_bw' + i, 0, 100); });
+  chk('bd_win', 0, 9999); chk('bd_cnt', 0, 9999); chk('bd_dwell', 0, 9999);
+  if (bad){ bad.classList.add('bad'); bad.focus(); setTimeout(function(){ bad.classList.remove('bad'); }, 6000); return `<#RNT_73#>`; }
+  return '';
+}
+
+/* ---------- apply through the stock path (applyapp.cgi: validate_apply + restart_wireless) ---------- */
+function post(obj, cb){
+  var x = new XMLHttpRequest(), b = [], k;
+  for (k in obj) b.push(encodeURIComponent(k) + '=' + encodeURIComponent(obj[k]));
+  x.open('POST', '/applyapp.cgi', true); x.setRequestHeader('Content-Type', 'application/x-www-form-urlencoded'); x.timeout = 150000;
+  x.onloadend = function(){ cb && cb(); };
+  x.send(b.join('&'));
+}
+function msg(t){ var m = q('topmsg'); m.textContent = t || ''; m.classList.toggle('show', !!t); }
+function applyAll(){
+  msg('');
+  var err = validate(); if (err){ msg(err); return; }
+  var ch = diff(collect()), n = 0, k; for (k in ch) n++;
+  if (!n){ msg(`<#RADM_63#>`); return; }
+  ch.action_mode = 'apply'; ch.rc_service = 'restart_wireless';
+  rp.applying(`<#Reaper_c_applying#>`, `<#RNT_62#>`);
+  post(ch); setTimeout(function(){ location.reload(); }, 15000);
+}
+function restore(){
+  if (!confirm(`<#RNT_74#>`)) return;
+  var keys = ['bsd_bounce_detect'];
+  BANDS.forEach(function(b){ var k = K(b); keys.push(k.steer, k.sta, k.sel, k.qual); });   /* never wlN_txchain (stock reset it too) */
+  appGet(keys, 'nvram_default_get', function(d){
+    if (!d){ msg(`<#RNT_27#>`); return; }
+    var obj = {}, any = false; keys.forEach(function(k){ if (d[k] !== undefined && norm(d[k]) !== norm(NV[k])){ obj[k] = d[k]; any = true; } });
+    if (!any){ msg(`<#RADM_63#>`); return; }
+    obj.action_mode = 'apply'; obj.rc_service = 'restart_wireless';
+    rp.applying(`<#Reaper_c_applying#>`, `<#RNT_62#>`);
+    post(obj); setTimeout(function(){ location.reload(); }, 15000);
+  });
+}
+function toggle(){
+  if (SDN_MIGRATED){ top.location.href = '/reaper_shell.asp#SDN.asp'; return; }
+  var on = (parseInt(SC_X, 10) || 0) > 0, obj = {};
+  if (!confirm(on ? `<#RNT_75#>` : `<#RNT_76#>`)) return;
+  obj.smart_connect_x = on ? '0' : '1';
+  if (!on && UI.smart_connect_v2){ var m = 0; BANDS.forEach(function(b){ m |= 1 << b.bit; }); obj.smart_connect_selif_x = String(m); }  /* slot mask: 11 on a 2.4/5/6 box */
+  obj.action_mode = 'apply'; obj.rc_service = 'restart_wireless';
+  rp.applying(`<#Reaper_c_applying#>`, `<#RNT_62#>`);
+  post(obj); setTimeout(function(){ location.reload(); }, 15000);
+}
+function appGet(keys, fn, cb){
+  var x = new XMLHttpRequest();
+  x.open('GET', '/appGet.cgi?hook=' + keys.map(function(k){ return fn + '(' + k + ')'; }).join('%3B') + '&_=' + Date.now(), true); x.timeout = 15000;
+  x.onload = function(){ var d = null; try { d = JSON.parse(x.responseText); } catch (e) {} cb(d); };
+  x.onerror = x.ontimeout = function(){ cb(null); };
+  x.send();
+}
+
+function master(){
+  var on = (parseInt(SC_X, 10) || 0) > 0;
+  q('sctext').textContent = on ? `<#RNT_77#>` : `<#RNT_78#>`; q('scpill').className = 'pill' + (on ? ' on' : '');
+  if (SDN_MIGRATED){ q('mastersub').textContent = `<#RNT_79#>`; q('b_toggle').textContent = `<#RNT_80#>`; }
+  else { q('mastersub').textContent = on ? `<#RNT_81#>` : `<#RNT_82#>`; q('b_toggle').textContent = on ? `<#RNT_83#>` : `<#RNT_84#>`; }
+  q('rules').classList.toggle('off', !on && !SDN_MIGRATED);
+}
+
+q('applybtn').addEventListener('click', applyAll);
+q('discardbtn').addEventListener('click', function(){ location.reload(); });
+q('b_restore').addEventListener('click', restore);
