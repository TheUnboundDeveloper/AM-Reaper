+}
+function drawIpsec(){
+  var on = NV.ipsec_server_enable === '1', h = '<div class="inst"><div class="ihead"><span class="iname">IPsec</span>' + pill(on ? 'on' : 'off', on ? `<#RVST_16#>` : `<#RVST_21#>`) + '<span class="spacer"></span>' + link('Reaper_VPNServer.asp', 'ipsec') + '</div>';
