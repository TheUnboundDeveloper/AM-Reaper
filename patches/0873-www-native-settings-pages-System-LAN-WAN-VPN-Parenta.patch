+  ['vpn_client_bridge', 'vpn_client_nat', 'vpn_client_gw', 'vpn_client_enforce', 'vpn_client_username', 'vpn_client_password', 'vpn_client_useronly', 'vpn_client_cn', 'vpn_crt_client_static', 'vpn_crt_client_ca', 'vpn_crt_client_crt', 'vpn_crt_client_key', 'vpn_crt_client_crl', 'vpn_crt_client_extra'].forEach(function(k){ FIELD_TAB[k] = 'ovpn'; });
