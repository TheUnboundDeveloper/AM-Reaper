+    p = i ? 'b' : 'a'; u = 'wan' + SVC[p] + '_';
+    if (!has(c, u + 'proto')) continue;
+    S = svcRules(p);
+    if (S.ip){
+      if (!ip4u(c[u + 'ipaddr_x'])) return bad(p + '_ip', T.eIp);
+      if (c[u + 'gateway_x'] !== '' && c[u + 'gateway_x'] !== '0.0.0.0' && !ip4u(c[u + 'gateway_x'])) return bad(p + '_gw', T.eIp);
+      if (c[u + 'gateway_x'] === c[u + 'ipaddr_x']) return bad(p + '_gw', T.eGwIp);
+      if (!maskOk(c[u + 'netmask_x'])) return bad(p + '_mask', T.eMask);
+    }
+    if (S.dnsman){
+      if (c[u + 'dns1_x'] === '' && c[u + 'dns2_x'] === '' && c[u + 'proto'] !== 'dhcp') return bad(p + '_dns1', T.eDns);
+      if (c[u + 'dns1_x'] !== '' && !ip4u(c[u + 'dns1_x'])) return bad(p + '_dns1', T.eIp);
+      if (c[u + 'dns2_x'] !== '' && !ip4u(c[u + 'dns2_x'])) return bad(p + '_dns2', T.eIp);
+    }
+    if (has(c, u + 'pppoe_username')){
+      if (!strOk(c[u + 'pppoe_username'])) return bad(p + '_user', T.eStr);
+      if (has(c, u + 'pppoe_passwd') && !strOk(c[u + 'pppoe_passwd'])) return bad(p + '_pass', T.eStr);
+      if (S.idle || S.opt){ if (!has(c, u + 'pppoe_passwd') && !PWSET[SVC[p]]) return bad(p + '_pass', T.ePass); }
+    }
+    if (has(c, u + 'pppoe_idletime') && !num(c[u + 'pppoe_idletime'], 0, 4294967295)) return bad(p + '_idle', fmt(T.eRange, 0, 4294967295));
+    if (has(c, u + 'pppoe_mtu')){
+      if (!num(c[u + 'pppoe_mtu'], 576, 1492)) return bad(p + '_mtu', fmt(T.eRange, 576, 1492));
+      if (!num(c[u + 'pppoe_mru'], 576, 1492)) return bad(p + '_mru', fmt(T.eRange, 576, 1492));
+      if (!strOk(c[u + 'pppoe_service'])) return bad(p + '_svc', T.eStr);
+      if (!strOk(c[u + 'pppoe_ac'])) return bad(p + '_ac', T.eStr);
+    }
+    if (has(c, u + 'pppoe_options_x') && !strOk(c[u + 'pppoe_options_x'])) return bad(p + '_opt', T.eStr);
+  }
+  return '';
+}
+
+/* ---------- port conflicts (stock check_port_conflicts): refused, the user picks another port ---------- */
+function stbText(){ var o = q('s_stb').options[q('s_stb').selectedIndex]; return o ? o.textContent : ''; }
+function bondPorts(){
+  if (!sup('lacp')) return [];
+  var p = NV.productid;
+  if (/^(GT-BE98|GT-BE98_PRO|GT-BE96|GT-BE19000|GT-BE19000AI|GT-BE96_AI)$/.test(p)) return NV.lacp_ifnames_x === 'eth0 eth3' ? ['10G WAN/LAN1', '10G LAN6'] : ['1G LAN5', '10G LAN6'];
+  if (p === 'BQ16' || p === 'BQ16_PRO') return ['LAN4', 'LAN5'];
+  return ['LAN1', 'LAN2'];   /* state.js get_bonding_ports default (RT-BE96U, BE88U, BE86U) */
+}
+function portConflict(R){
+  var stb = R.stb, dw = (NV.wans_dualwan || '').split(' '), what = '', txt = stbText(), i, j;
+  if (sup('dualwan') && (dw[0] === 'lan' || dw[1] === 'lan')){
+    if (stb === NV.wans_lanport) what = 'WAN';
+    for (i = 0; i < STBMAP.length && !what; i++){
+      if (String(STBMAP[i].value) === stb && STBMAP[i].comboport_value_list){
+        var vl = String(STBMAP[i].comboport_value_list).split(' ');
+        for (j = 0; j < vl.length; j++) if (vl[j] === NV.wans_lanport) what = 'WAN';
+      }
+    }
+  }
+  if (!what && sup('lacp') && NV.lacp_enabled === '1' && R.none){
+    bondPorts().forEach(function(b){ if (txt.indexOf(b) !== -1 || b.indexOf(txt) !== -1) what = T.lacp; });
+  }
+  if (!what && sup('mtlancfg') && R.none){
+    VLANPORTS.forEach(function(n){ if (txt.indexOf('LAN' + n) !== -1) what = 'VLAN'; });
+  }
+  return what ? fmt(T.samePort, what, 'IPTV') + ' ' + T.others : '';
+}
+/* SDN ports on this router (stock get_vlan_portlist: apg<N>_dut_list for this label MAC, vlan_trunk_rl) */
+var VLANPORTS = (function(){
+  var out = [];
+  try {
+    Object.keys(APG).forEach(function(i){
+      if (APG[i].enable !== '1') return;
+      String(APG[i].dut_list || '').split('<').forEach(function(d){
+        var f = d.split('>'); if (f[0] && f[0] === NV.label_mac && f[2]) f[2].split(',').forEach(function(pt){ if (pt) out.push(pt.substr(1, 1)); });
+      });
+    });
+    String(NV.vlan_trunk_rl || '').split('<').forEach(function(r){ var f = r.split('>'); if (f[0]) out.push(f[0]); });
+  } catch (e) {}
+  return out;
+})();
+
+/* ---------- apply ---------- */
+function applyAll(){
+  msg('');
+  var c = collect(), changed = diff(c), err, k, x, f = document.form;
+  if (!count(changed)){ msg(T.nothing); return; }
+  err = validate(c); if (err){ msg(err); return; }
+  var R = rules(), assign = ASSIGN.some(function(a){ return has(changed, a); });
+  var active = R.stb !== '0' || R.tag !== 'none', reasons = [], extra = {}, mswan = [], lines = [];
+  if (assign && active){
+    var pc = portConflict(R); if (pc){ msg(pc); return; }
+    /* WAN aggregation uses LAN 4 (state.js wanAggr_p2_conflicts_w_stb_port: STB 4 or 6) */
+    if (sup('wanbonding') && NV.bond_wan === '1' && (R.stb === '4' || R.stb === '6')){
+      if (!confirm(T.aggrConflict)) return;
+      extra.bond_wan = '0'; reasons.push(T.rAggr);
+    }
+    /* bonding ports carrying an IPTV / VoIP / bridge port (stock turn_off_lacp) */
+    if (sup('lacp') && NV.lacp_enabled === '1' && !R.none){
+      var list = [];
+      if (R.manual){ if (R.stb === '3') list = [PORTS.VOIP_PORT]; else if (R.stb === '4') list = [PORTS.IPTV_PORT]; else if (R.stb === '6') list = [PORTS.VOIP_PORT, PORTS.IPTV_PORT]; }
+      else ['voip_port', 'iptv_port', 'bridge_port'].forEach(function(kk){ if (R.prof[kk]) list.push(R.prof[kk]); });
+      var joined = list.filter(function(s){ return !!s; }).join('/');
+      if (bondPorts().some(function(b){ return joined.indexOf(b) !== -1; })){
+        if (!confirm(fmt(T.disableFunc, joined, 'IPTV', T.lacp))) return;
+        extra.lacp_enabled = '0'; reasons.push(T.rLacp);
+      }
+    }
+    /* Multi-Service WAN profiles and 802.1Q on the WAN cannot share it with IPTV: turned off after the final confirm */
+    for (k in MSW) if (has(MSW, k) && MSW[k] === '1') mswan.push(k);
+    var dot1q = NV.wan0_dot1q === '1', names = [];
+    if (sup('mswan') && mswan.length) names.push('Multi-Service WAN');
+    if (dot1q) names.push('802.1Q');
+    if (names.length){
+      if (!confirm(fmt(T.conflict, 'IPTV', names.join(', ')))) return;
+      if (dot1q){ extra.wan_unit = '0'; extra.wan_dot1q = '0'; reasons.push(T.rDot1q); }
+      if (mswan.length) reasons.push(T.rMswan);
+    } else mswan = [];
+    /* IPTV runs only on the default WAN port: auto detection off, dual WAN off (stock confirm_autowan_change) */
+    if ((sup('autowan') && NV.autowan_enable === '1') || !singleDefaultWan()){
+      var dn = (ETH.wan && ETH.wan.wan_name) ? String(ETH.wan.wan_name) : 'WAN';
+      if (!confirm(fmt(T.wanport, 'IPTV', dn))) return;
+      if (ETH.wan && ETH.wan.extra_settings) for (x in ETH.wan.extra_settings) if (has(ETH.wan.extra_settings, x)) extra[x] = String(ETH.wan.extra_settings[x]);
+      if ((NV.wans_dualwan || '').indexOf('none') === -1){ extra.wans_dualwan = 'wan none'; reasons.push(T.rDual); }
+      if (/^(GT-BE98|GT-BE98_PRO|GT-BE96|GT-BE19000|GT-BE19000AI|GT-BE96_AI)$/.test(NV.productid) && NV.lacp_ifnames_x === 'eth0 eth3'){ extra.lacp_enabled = '0'; extra.lacp_ifnames_x = ''; }
+      reasons.push(T.rAuto);
+    }
+  }
+  for (k in extra) if (has(extra, k)) changed[k] = extra[k];
+  var reboot = assign;
+  if (reboot){ lines.push(fmt(T.cReboot, REBOOT_WAIT)); reasons.forEach(function(r){ lines.push(r); }); }
+  else lines.push(T.cNet);
+  lines.push(T.cGo);
+  if (!confirm(lines.join('\n\n'))) return;
+  for (k in changed) if (has(changed, k) && !f.querySelector('input[name="' + k + '"]')){
+    x = document.createElement('input'); x.type = 'hidden'; x.name = k; x.disabled = true; f.appendChild(x);
+  }
+  rp.applying(T.applying, reboot ? T.apReboot : T.apNet);
+  function go(){
+    if (reboot){
+      rp.post(f, changed, 'reboot', REBOOT_WAIT, false);
+      setTimeout(function(){ top.location.href = '/'; }, (REBOOT_WAIT + 10) * 1000);
+    } else rp.post(f, changed, 'restart_net', 10);   /* stock: apply_new, restart_net, 10 s (rc/services.c:18390) */
+  }
+  if (mswan.length){
+    /* web.c:15057 disable_multiservice_wan sets wan<N>_enable=0 for each listed unit */
+    var xr = new XMLHttpRequest();
+    xr.open('POST', '/applyapp.cgi', true);
+    xr.setRequestHeader('Content-Type', 'application/x-www-form-urlencoded; charset=UTF-8');
+    xr.onload = go; xr.onerror = go;
+    try { xr.send(encodeURIComponent(JSON.stringify({action_mode: 'disable_multiservice_wan', mswan_index_list: mswan.join(',')}))); } catch (e) { go(); }
+  } else go();
+}
+/* stock use_single_default_wan_sfp: single WAN on the default port (its extra_settings all in place) */
+function singleDefaultWan(){
+  if ((NV.wans_dualwan || '').indexOf('none') === -1) return false;
+  var ok = false;
+  ['wan', 'sfp'].forEach(function(key){
+    var o = ETH[key], good = !!o, x;
+    if (o && o.extra_settings) for (x in o.extra_settings) if (has(o.extra_settings, x) && String(EXTRA[x] === undefined ? '' : EXTRA[x]) !== String(o.extra_settings[x])) good = false;
+    if (good) ok = true;
+  });
+  return ok;
+}
+
+/* ---------- wiring ---------- */
+function boot(){
+  SECTIONS.forEach(function(s){
+    try { s.init(); }
+    catch (e){ BROKEN[s.panel] = 1; var p = q(s.panel); if (p) p.classList.add('broken'); if (window.console) console.error('Reaper_IPTV: section ' + s.panel + ' failed to load:', e); }
+  });
+  on('applybtn', 'click', applyAll);
+  on('discardbtn', 'click', function(){ location.reload(); });
+  on('s_wantag', 'change', function(){
+    /* stock set_connection: Movistar starts the IPTV connection as static and VoIP as DHCP */
+    if (q('s_wantag').value === 'movistar' && NV.switch_wantag !== 'movistar'){ pick(q('a_proto'), 'static'); svcType('a'); pick(q('b_proto'), 'dhcp'); svcType('b'); }
+    /* leaving a profile for None starts with no STB port (stock kept the profile's port bridged, so None did not turn IPTV off) */
+    if (q('s_wantag').value === 'none' && NV.switch_wantag !== 'none' && NV.switch_wantag !== '') pick(q('s_stb'), '0');
+    sync();
+  });
+  ['s_stb', 'a_dhcpip', 'a_dnsauto', 'a_auth', 'b_dhcpip', 'b_dnsauto', 'b_auth'].forEach(function(id){ on(id, 'change', sync); });
+  ['i_vid1', 'i_vid2'].forEach(function(id){ on(id, 'input', sync); });
+  on('a_proto', 'change', function(){ svcType('a'); }); on('b_proto', 'change', function(){ svcType('b'); });
+  on('a_showpass', 'change', function(){ q('a_pass').type = q('a_showpass').checked ? 'text' : 'password'; });
+  on('b_showpass', 'change', function(){ q('b_pass').type = q('b_showpass').checked ? 'text' : 'password'; });
+  document.addEventListener('input', dirty); document.addEventListener('change', dirty);
+  sync();
+  SNAP = collect();
+  dirty();
+  rp.tips();
+}
+boot();
+})();
+</script>
+</body>
+</html>
diff --git a/release/src/router/www/Reaper_IPv6.asp b/release/src/router/www/Reaper_IPv6.asp
new file mode 100644
index 0000000000..b9d3d5f9f5
--- /dev/null
+++ b/release/src/router/www/Reaper_IPv6.asp
@@ -0,0 +1,121 @@
+<!-- SPDX-License-Identifier: GPL-2.0-only
+     Copyright (C) 2026 the Reaper project maintainer
+     Part of the Reaper hardened Asuswrt-Merlin build. See LICENSE / LICENSE.reaper. -->
+<!DOCTYPE html>
+<html lang="en">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width, initial-scale=1">
+<meta name="reaper-native" content="1">
+<title>REAPER &mdash; IPv6</title>
+<!-- Reaper_IPv6.asp - System Log > IPv6 (Reaper-native UI, System Log wave, 2026-10-23).
+     Replaces Main_IPV6Status_Content.asp. Data: httpd ej_lan_ipv6_network_array (data_arrays.c: the WAN/LAN IPv6
+     configuration, then the LAN's IPv6 neighbours with their lease/networkmap names; SIGUSR2 to dnsmasq + an
+     `ip neigh` fork per load) and, on IGD2 builds, ej_ipv6_pinhole_array (/tmp/upnp.leases6 after SIGUSR2 to
+     miniupnpd, ~1 s). Rows: [hostname, MAC, "addr, addr"]; pinholes [proto, remote ip, remote port, local ip,
+     local port, timestamp, description]. Stock bug not carried over: it popped the [] sentinel and then tested
+     length > 1, so exactly one client showed as "No IPv6 clients". The emitter now escapes hostnames and
+     descriptions and always closes its arrays (2026-10-23). No polling. -->
+<link rel="stylesheet" href="/reaper/rp.css">
+<style>
+.kv{display:grid;grid-template-columns:minmax(200px,320px) 1fr;gap:6px 22px;font-size:13px}
+.kv .k{color:var(--steel);font-family:var(--hdr);font-weight:600;letter-spacing:.04em}
+.kv .v{color:var(--bone);font-family:var(--mono);word-break:break-all}
+.rtab th{font-family:var(--hdr);font-weight:600;font-size:10.5px;letter-spacing:.14em;text-transform:uppercase;color:var(--steel);text-align:left;padding:7px 10px;border-bottom:1px solid var(--line-soft);cursor:pointer;user-select:none;white-space:nowrap}
+.rtab th:hover,.rtab th.on{color:var(--bone)}
+.rtab th .dir{display:inline-block;width:10px;margin-left:4px}
+.rtab.static th{cursor:default}
+.rtab td{padding:7px 10px;border-bottom:1px solid var(--line-soft);color:var(--bone-dim);vertical-align:top;word-break:break-all}
+.rtab td.mono{font-family:var(--mono)}
+.rtab tr.desc td{color:var(--steel);font-size:12px;border-bottom:none;padding-bottom:0}
+.empty{color:var(--steel);font-size:12.5px;padding:8px 0}
+</style>
+</head>
+<body>
+<script src="/reaper_util.js"></script>
+<script src="/reaper/rp.js"></script>
+
+<div class="syswrap">
+<div class="pagehead">
+  <div>
+    <div class="eyebrow"><#System_Log#></div>
+    <h1>IPv6</h1>
+  </div>
+  <div class="spacer"></div>
+  <button type="button" class="btn" id="b_refresh"><#CTL_refresh#></button>
+</div>
+<div class="hint" style="margin:-4px 0 14px"><#ipv6_info_desc#></div>
+
+<div class="rframe">
+<div class="panel" id="p_cfg">
+  <h2><#RLOG_56#></h2>
+  <div id="cfg"></div>
+</div>
+<div class="panel" id="p_cli">
+  <h2><#RLOG_57#></h2>
+  <div id="cli"></div>
+</div>
+<div class="panel off" id="p_pin" style="display:none">
+  <h2><#RLOG_58#></h2>
+  <div class="sub" id="pinsub"></div>
+  <div id="pin"></div>
+</div>
+</div>
+</div>
+
+<script>
+(function(){
+'use strict';
+var q = rp.q, hx = rp.esc;
+var ipv6cfgarray = [[]], ipv6clientarray = [[]], pinholesarray = [[]];
+<% get_ipv6net_array(); %>
+<% ipv6_pinholes(); %>
+var UI = {}; try { UI = [<% get_ui_support(); %>][0] || {}; } catch (e) {}
+var PIN_ON = '<% nvram_get("upnp_pinhole_enable"); %>' === '1';
+function rows(a){ return (a || []).filter(function(r){ return r && r.length; }); }
+
+function drawCfg(){
+  var a = rows(ipv6cfgarray);
+  if (!a.length){ q('cfg').innerHTML = '<div class="empty">' + hx(`<#RLOG_59#>`) + '</div>'; q('p_cli').style.display = 'none'; return; }
+  q('cfg').innerHTML = '<div class="kv">' + a.map(function(r){ return '<div class="k">' + hx(r[0]) + '</div><div class="v">' + hx(r[1] || '-') + '</div>'; }).join('') + '</div>';
+}
+var SORT = {k: 'host', dir: 1};
+function drawCli(){
+  var list = rows(ipv6clientarray).map(function(r){ return {host: r[0] === '*' ? '' : r[0], mac: r[1], addr: r[2]}; });
+  if (!list.length){ q('cli').innerHTML = '<div class="empty">' + hx(`<#RLOG_60#>`) + '</div>'; return; }
+  var cmp = rp.cmp('text'); list.sort(function(a, b){ return SORT.dir * cmp(a[SORT.k], b[SORT.k]); });
+  var heads = [['host', `<#RLOG_50#>`], ['mac', `<#RLOG_52#>`], ['addr', `<#RLOG_61#>`]];
+  var h = '<table class="rtab"><thead><tr>' + heads.map(function(c){ return '<th data-k="' + c[0] + '"' + (c[0] === SORT.k ? ' class="on"' : '') + '>' + hx(c[1]) +
+    '<span class="dir">' + (c[0] === SORT.k ? (SORT.dir > 0 ? '&#9650;' : '&#9660;') : '') + '</span></th>'; }).join('') + '</tr></thead><tbody>';
+  list.forEach(function(r){
+    h += '<tr><td class="name">' + hx(r.host || '-') + '</td><td class="mono">' + hx(r.mac) + '</td><td class="mono">' +
+      String(r.addr || '').split(/,\s*/).filter(Boolean).map(hx).join('<br>') + '</td></tr>';
+  });
+  q('cli').innerHTML = h + '</tbody></table>';
+}
+function drawPin(){
+  if (!UI.igd2) return;
+  q('p_pin').style.display = '';
+  q('pinsub').textContent = PIN_ON ? '' : `<#RLOG_62#>`;
+  var a = rows(pinholesarray);
+  if (!a.length){ q('pin').innerHTML = '<div class="empty">' + hx(`<#RLOG_63#>`) + '</div>'; return; }
+  var h = `<table class="rtab static"><thead><tr><th><#RLOG_40#></th><th><#RLOG_64#></th><th><#RLOG_65#></th><th><#RLOG_66#></th><th><#RLOG_43#></th></tr></thead><tbody>`;
+  a.forEach(function(r){
+    /* [proto, remote ip, remote port, local ip, local port, timestamp, description] */
+    if (r[6]) h += '<tr class="desc"><td colspan="5">' + hx(r[6]) + '</td></tr>';
+    h += '<tr><td class="mono">' + hx(r[0]) + '</td><td class="mono">' + hx(r[1]) + '</td><td class="mono">' + hx(r[2]) + '</td><td class="mono">' + hx(r[3]) + '</td><td class="mono">' + hx(r[4]) + '</td></tr>';
+  });
+  q('pin').innerHTML = h + '</tbody></table>';
+}
+q('cli').addEventListener('click', function(e){
+  var th = e.target.closest ? e.target.closest('th[data-k]') : null; if (!th) return;
+  var k = th.getAttribute('data-k'); SORT = {k: k, dir: SORT.k === k ? -SORT.dir : 1}; drawCli();
+});
+q('b_refresh').addEventListener('click', function(){ location.reload(); });
+try { drawCfg(); } catch (e) { q('cfg').innerHTML = '<div class="empty">' + hx(`<#RADM_78#>`) + '</div>'; }
+try { drawCli(); } catch (e) { q('cli').innerHTML = '<div class="empty">' + hx(`<#RADM_78#>`) + '</div>'; }
+try { drawPin(); } catch (e) {}
+})();
+</script>
+</body>
+</html>
diff --git a/release/src/router/www/Reaper_IPv6Setup.asp b/release/src/router/www/Reaper_IPv6Setup.asp
