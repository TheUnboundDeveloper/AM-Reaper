@@ -0,0 +1,518 @@
+<!-- SPDX-License-Identifier: GPL-2.0-only
+     Copyright (C) 2026 the Reaper project maintainer
+     Part of the Reaper hardened Asuswrt-Merlin build. See LICENSE / LICENSE.reaper. -->
+<!DOCTYPE html>
+<html lang="en">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width, initial-scale=1">
+<meta name="reaper-native" content="1">
+<title>REAPER &mdash; <#Time_Scheduling#></title>
+<!-- Reaper_Parental.asp - Parental Controls > Time Scheduling (Reaper-native UI, 2026-10-24).
+     Replaces ParentalControl.asp (parity file build-scripts/tests/ui_parity/ParentalControl.json). The menu's other
+     Parental Controls tabs (Web & Apps Filters, Web History) need the TrendMicro engine (RTCONFIG_BWDPI), which this
+     build does not have, so their flags are off and they never show.
+     Settings, all read by rc/pc.c + rc/firewall.c on restart_firewall (the stock page's script):
+     - MULTIFILTER_ALL        1 = enforce the device list (firewall.c: no PControls rules while 0)
+     - MULTIFILTER_BLOCK_ALL  1 = every LAN / SDN interface: -A FORWARD -i <if> -j DROP (pc.c config_block_all_string),
+                              independent of MULTIFILTER_ALL
+     - four parallel '>' lists, one entry per device, read by index (pc.c get_all_pc_list, foreach_62_keep_empty_string):
+       MULTIFILTER_ENABLE 0 off / 1 on schedule / 2 blocked; MULTIFILTER_MAC; MULTIFILTER_DEVICENAME (rc keeps 31 chars);
+       MULTIFILTER_MACFILTER_DAYTIME_V2 = the device's schedule, '<' separated 12-char rules (shared/sched_v2.c):
+       <W|M><enable 0/1><weekday mask, 2 hex, bit 0 = Sunday><start HHMM><end HHMM>. W = the times are blocked,
+       M = the Internet is allowed only in those times (pc.c adds a DROP after the windows). A start later than the end
+       runs past midnight; end 0000 or 2400 = midnight; 0000-2400 = the whole day. rc parses 64 rules per device.
+     Apply posts only the keys that changed; the four lists are rewritten together once any device is added, removed,
+     switched or rescheduled, and rows nobody touched keep their stored text. Untouched schedules are never re-encoded.
+     Limits: devices = get_ui_support MaxRule_parentctrl (stock fallback 16), time windows in all = MaxRule_PC_DAYTIME
+     (stock fallback 128), 64 per device; MULTIFILTER_MAC and MULTIFILTER_ENABLE are not JFFS-whitelisted (1 KB nvram
+     wall, ENABLE is CKN_STR128), DEVICENAME and DAYTIME_V2 are (CKN_STR4096).
+     Deliberate differences from stock:
+     - one editor (day chips + from / to) instead of the drag grid, with a week preview drawn the way rc reads the rules;
+       the W / M choice is a per-device select (stock showed it only at PC_SCHED_V3 >= 3; rc/pc.c handles both here).
+       A new device gets stock's two default windows switched off, as stock did: nothing is blocked until a window is on.
+     - Block all devices saves at Apply with a confirm (stock wrote it at once from its switch) and is always shown.
+     - an empty schedule is stored as '<', as httpd's block_device_internet CGI does: that CGI reads the lists with
+       foreach_62, which skips empty fields, so an empty schedule there shifted every later device's schedule.
+     - Allow-only with no switched-on window is refused (rc would leave that device unrestricted), a broadcast /
+       multicast / zero MAC is refused, and names lose the < > separators and a leading @ (a PMS group marker).
+     - rows rc cannot use (bad MAC) are shown dimmed and can be deleted; schedule entries the editor does not model
+       (other rule types, a second mode) are kept as they are. -->
+<link rel="stylesheet" href="/reaper/rp.css">
+<style>
+/* page-specific rules only; the Reaper look comes from /reaper/rp.css */
+.panel.off,.off{display:none}
+.f.bad input,.f.bad select{border-color:var(--crimson)!important;box-shadow:0 0 0 2px rgba(225,6,0,.25)}
+table.classes td.st{width:160px}
+table.classes tr.cur td{background:rgba(225,6,0,.06)}
+.bwl-add select{min-width:160px}
+.msg{font-size:12.5px;color:var(--amber);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:100%;min-width:0;display:none}
+.hint a,.sub a{color:var(--bone-dim)}
+/* schedule editor: one row per time window */
+.edrow{display:flex;gap:10px;flex-wrap:wrap;align-items:center;margin:10px 0}
+.edrow .lbl{font-family:var(--hdr);font-weight:600;font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:var(--bone-dim)}
+.edrow select{background:#000;border:1px solid var(--line-soft);border-radius:8px;color:var(--bone);font-family:var(--body);font-size:13px;padding:8px 10px;outline:none}
+.win{display:flex;gap:8px;flex-wrap:wrap;align-items:center;padding:9px 0;border-top:1px solid var(--line-soft)}
+.win .tswitch{margin:0 6px 0 0}
+.win .dim{color:var(--steel);font-size:12px}
+.win.idle .day,.win.idle input[type="time"]{opacity:.45}
+.day{font-family:var(--hdr);font-weight:600;font-size:11px;min-width:40px;padding:4px 6px;border-radius:6px;border:1px solid var(--line-soft);background:transparent;color:var(--steel);cursor:pointer}
+.day.on{color:var(--bone);border-color:var(--crimson-deep);background:rgba(225,6,0,.16)}
+input[type="time"]{background:#000;border:1px solid var(--line-soft);border-radius:8px;color:var(--bone);font-family:var(--body);font-size:12.5px;padding:6px 10px;outline:none;color-scheme:dark}
+/* week preview: red = Internet blocked, dark = Internet allowed (two colours only) */
+.week{display:grid;grid-template-columns:48px 1fr;gap:5px 10px;margin:16px 0 6px;max-width:760px}
+.week .wd{font-family:var(--hdr);font-weight:600;font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:var(--steel);align-self:center}
+.week .bar{position:relative;height:14px;background:#1a1a1f;border-radius:4px;overflow:hidden}
+.week .bar.deny{background:rgba(225,6,0,.55)}
+.week .seg{position:absolute;top:0;bottom:0}
+.week .seg.deny{background:rgba(225,6,0,.55)}
+.week .seg.open{background:#1a1a1f}
+.week .axis{display:flex;justify-content:space-between;font-family:var(--mono);font-size:10px;color:var(--steel)}
+.legend{display:flex;gap:18px;align-items:center;font-size:11.5px;color:var(--steel);margin-bottom:4px}
+.legend i{display:inline-block;width:12px;height:10px;border-radius:2px;margin-right:6px;vertical-align:-1px}
+.legend i.deny{background:rgba(225,6,0,.55)}
+.legend i.open{background:#1a1a1f;border:1px solid var(--line2)}
+</style>
+</head>
+<body>
+<script src="/reaper_util.js"></script>
+<script src="/reaper/rp.js"></script>
+
+<div class="syswrap">
+<div class="pagehead">
+  <div>
+    <div class="eyebrow"><#Parental_Control#></div>
+    <h1><#Time_Scheduling#></h1>
+  </div>
+  <span class="pill" id="statepill"><span class="dot"></span><span class="mono" id="statetext"></span></span>
+  <span class="pill" title="<#RPAR_52#>"><span class="dot"></span><span class="mono" id="systime"></span></span>
+  <div class="spacer"></div>
+  <span class="pill warn chgpill" id="chgpill"><span class="dot"></span><span><#RADM_77#>: <b id="chgcount">0</b></span></span>
+  <button type="button" class="btn ghost" id="discardbtn" disabled><#Discard#></button>
+  <button type="button" class="btn primary" id="applybtn"><#CTL_apply#></button>
+</div>
+<div class="msg" id="topmsg" style="margin:-6px 0 12px"></div>
+<div class="hint" style="margin:-4px 0 14px"><#RPAR_01#></div>
+<div class="hint warn off" id="modehint" style="margin:-4px 0 14px"><#RPAR_02#></div>
+<div class="hint warn off" id="ntphint" style="margin:-4px 0 14px"><#RPAR_03#> <a href="/reaper_shell.asp#Reaper_System.asp" target="_top"><#menu5_6_2#></a></div>
+
+<div class="rframe" id="tab_main">
+  <div class="panel" id="p_set">
+    <h2><#RPAR_04#></h2>
+    <div class="secerr"><#RADM_78#></div>
+    <div class="togglerow">
+      <label class="tswitch"><input type="checkbox" id="s_all"><span class="track"></span></label>
+      <div class="tmeta"><div class="tname"><#ParentalCtrl_Enable_TS#></div><div class="tdesc"><#RPAR_05#></div></div>
+    </div>
+    <div class="togglerow">
+      <label class="tswitch"><input type="checkbox" id="s_blockall"><span class="track"></span></label>
+      <div class="tmeta"><div class="tname"><#RPAR_06#></div><div class="tdesc"><#RPAR_07#></div></div>
+    </div>
+  </div>
+  <div class="panel" id="p_dev">
+    <h2><#RPAR_08#></h2>
+    <div class="sub"><#RPAR_09#></div>
+    <div class="secerr"><#RADM_78#></div>
+    <div class="hint warn off" id="offnote" style="margin:0 0 10px"><#RPAR_10#></div>
+    <div class="hint warn off" id="skewnote" style="margin:0 0 10px"></div>
+    <table class="classes"><thead><tr><th><#RPAR_12#></th><th><#RPAR_13#></th><th><#RPAR_14#></th><th></th></tr></thead><tbody id="dtbody"></tbody></table>
+    <div class="rbudget" id="dbudget"></div>
+    <div class="bwl-add" id="dadd">
+      <div class="f"><label><#RPAR_15#></label><input type="text" class="dev mono" id="d_mac" maxlength="17" autocomplete="off" list="clients" placeholder="AA:BB:CC:DD:EE:FF"></div>
+      <div class="f"><label><#RPAR_12#></label><select id="d_state"><option value="1"><#RPAR_16#></option><option value="2"><#RPAR_17#></option><option value="0"><#RPAR_18#></option></select></div>
+      <button type="button" class="btn small" id="d_add"><#CTL_add#></button>
+    </div>
+    <div class="edmsg" id="dmsg"></div>
+  </div>
+  <div class="panel off" id="p_ed">
+    <h2 id="ed_title"></h2>
+    <div class="sub mono" id="ed_mac"></div>
+    <div class="edrow"><span class="lbl"><#RPAR_31#></span><select id="ed_mode"><option value="W"><#RPAR_32#></option><option value="M"><#RPAR_33#></option></select></div>
+    <div id="ed_wins"></div>
+    <div class="edrow"><button type="button" class="btn ghost small" id="ed_addwin"><#RPAR_39#></button><span class="rbudget" id="ed_budget" style="margin:0"></span></div>
+    <div class="hint off" id="ed_other"></div>
+    <div class="week" id="ed_week"></div>
+    <div class="legend"><span><i class="deny"></i><#RPAR_42#></span><span><i class="open"></i><#RPAR_43#></span></div>
+    <div class="hint"><#RPAR_44#></div>
+    <div class="edmsg" id="emsg"></div>
+    <div class="edrow" style="margin-top:14px"><button type="button" class="btn small" id="ed_done"><#RPAR_45#></button><button type="button" class="btn ghost small" id="ed_cancel"><#CTL_Cancel#></button></div>
+  </div>
+</div>
+<datalist id="clients"></datalist>
+</div>
+
+<div class="applying" id="applying"><div class="abox"><h2 id="ap_t"><#Reaper_c_applying#></h2><p id="ap_p"><#RPAR_51#></p></div></div>
+<iframe name="hidden_frame" id="hidden_frame" style="display:none" width="0" height="0"></iframe>
+<form method="post" name="form" action="/start_apply.htm" target="hidden_frame">
