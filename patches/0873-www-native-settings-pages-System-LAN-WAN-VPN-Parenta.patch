+  function v4(id){ var s = val(id); return rp.v.ipv4(s) && !/^(0|127)\./.test(s) && parseInt(s, 10) < 224; }
+  var maxlen = q('s_ac').value === '1' ? 112 : 126;   /* stock: stateful takes 16 of the 128 bits */
+  if (v === 'other'){
+    if (!v6('i_ipaddr')) return e6('i_ipaddr');
+    if (!rng('i_plenwan', 3, 128)) return eN('i_plenwan', 3, 128);
+    if (!v6('i_gw', true)) return e6('i_gw');
+  }
+  if (v === 'other' || (v === 'dhcp6' && !q('t_pd').checked)){
+    if (!rng('i_plen', 3, maxlen)) return eN('i_plen', 3, maxlen);
+    if (!v6('i_rtr')) return e6('i_rtr');
+  }
+  if ((v === 'other' || v === 'dhcp6') && q('s_ac').value === '1'){
+    if (!/^[0-9A-Fa-f]{1,4}$/.test(val('i_start'))) return bad('i_start', `<#RIP6_27#>`);
+    if (!/^[0-9A-Fa-f]{1,4}$/.test(val('i_end'))) return bad('i_end', `<#RIP6_27#>`);
+    if (parseInt(val('i_start'), 16) > parseInt(val('i_end'), 16)) return bad('i_end', `<#RIP6_26#>`);
+    if (!rng('i_life', 120, 604800)) return eN('i_life', 120, 604800);
+  }
+  if (v === '6to4' || v === '6in4' || v === '6rd'){
+    if (!(val('i_mtu') === '0' || rng('i_mtu', 1280, 1480))) return eN('i_mtu', 1280, 1480);
+    if (!rng('i_ttl', 0, 255)) return eN('i_ttl', 0, 255);
+  }
+  if (c.ipv6_dns1 !== undefined){
+    if (!v6('i_dns1', true)) return e6('i_dns1');
+    if (!v6('i_dns2', true)) return e6('i_dns2');
+    if (!v6('i_dns3', true)) return e6('i_dns3');
+  }
+  if (v === '6to4' && !v4('i_relay')) return bad('i_relay', `<#RIP6_24#>`);
+  if (v === '6in4'){
+    if (!v4('i_v4end')) return bad('i_v4end', `<#RIP6_24#>`);
+    if (!v6('i_tunaddr')) return e6('i_tunaddr');
+    if (!rng('i_tunaddrlen', 3, 128)) return eN('i_tunaddrlen', 3, 128);
+    if (!v6('i_tunpeer', true)) return e6('i_tunpeer');
+    if (!rng('i_plen', 3, 126)) return eN('i_plen', 3, 126);
+    if (!v6('i_prefix')) return e6('i_prefix');
+  }
+  if (v === '6rd' && !q('t_6rddhcp').checked){
+    if (!v4('i_6rdrouter')) return bad('i_6rdrouter', `<#RIP6_24#>`);
+    if (!rng('i_6rdip4size', 0, 32)) return eN('i_6rdip4size', 0, 32);
+    if (!v6('i_6rdprefix')) return e6('i_6rdprefix');
