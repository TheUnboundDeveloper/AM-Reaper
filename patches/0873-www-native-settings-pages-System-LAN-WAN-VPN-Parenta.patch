+</head>
+<body>
+<script src="/reaper_util.js"></script>
+<script src="/reaper/rp.js"></script>
+
+<div class="syswrap">
+<div class="pagehead">
+  <div>
+    <div class="eyebrow"><#System_Log#></div>
+    <h1><#menu5_7_3#></h1>
+  </div>
+  <span class="pill"><span class="dot"></span><span id="count"></span></span>
+  <div class="spacer"></div>
+  <button type="button" class="btn" id="b_refresh"><#CTL_refresh#></button>
+</div>
+<div class="hint" style="margin:-4px 0 14px"><#DHCPlease_title#></div>
+
+<div class="rframe">
+<div class="panel" id="p_leases">
+  <div id="list"></div>
+</div>
+</div>
+</div>
+
+<script>
+(function(){
+'use strict';
+var q = rp.q, hx = rp.esc;
+var leasearray = [];
+<% get_leases_array(); %>
+/* columns: key, header, comparator type, cell class */
+var COLS = [
+  {k: 'dev', h: `<#RLOG_49#>`, t: 'text', c: 'name'}, {k: 'host', h: `<#RLOG_50#>`, t: 'text', c: ''},
+  {k: 'ip', h: `<#RLOG_51#>`, t: 'ip', c: 'mono'}, {k: 'mac', h: `<#RLOG_52#>`, t: 'text', c: 'mono'},
+  {k: 'left', h: `<#RLOG_53#>`, t: 'num', c: 'mono'}, {k: 'vlan', h: 'VLAN', t: 'num', c: 'mono'}];
+var SORT = {k: 'ip', dir: 1};
+try { var s = JSON.parse(localStorage.getItem('rlease_sort') || 'null'); if (s && s.k) SORT = s; } catch (e) {}
+
+function rows(){
+  return (leasearray || []).filter(function(r){ return r && r.length >= 5; }).map(function(r){
+    var multi = r.length >= 6;
+    return {left: r[0], mac: r[1], ip: r[2], host: r[3] === '*' ? '' : r[3], vlan: multi ? r[4] : '', dev: r[r.length - 1]};
+  });
+}
+function leftText(s){
+  var n = parseInt(s, 10); if (!(n > 0)) return '-';
+  var d = Math.floor(n / 86400), h = Math.floor(n / 3600) % 24, m = Math.floor(n / 60) % 60;
+  return (d ? d + 'd ' : '') + (d || h ? h + 'h ' : '') + m + 'm';
+}
+function draw(){
+  var list = rows(), multi = list.some(function(r){ return r.vlan !== '' && r.vlan !== '0'; }), cols = COLS.filter(function(c){ return c.k !== 'vlan' || multi; });
+  q('count').textContent = list.length + ' ' + `<#RLOG_54#>`;
+  if (!list.length){ q('list').innerHTML = '<div class="empty">' + hx(`<#RLOG_55#>`) + '</div>'; return; }
+  var col = cols.filter(function(c){ return c.k === SORT.k; })[0] || cols[2], cmp = rp.cmp(col.t);
+  list.sort(function(a, b){ return SORT.dir * cmp(a[col.k], b[col.k]) || rp.cmp('ip')(a.ip, b.ip); });
+  var h = '<table class="rtab"><thead><tr>' + cols.map(function(c){
+    return '<th data-k="' + c.k + '"' + (c.k === col.k ? ' class="on"' : '') + '>' + hx(c.h) + '<span class="dir">' + (c.k === col.k ? (SORT.dir > 0 ? '&#9650;' : '&#9660;') : '') + '</span></th>';
+  }).join('') + '</tr></thead><tbody>';
+  list.forEach(function(r){
+    h += '<tr>' + cols.map(function(c){ var v = c.k === 'left' ? leftText(r.left) : r[c.k]; return '<td class="' + c.c + '">' + hx(v || '-') + '</td>'; }).join('') + '</tr>';
+  });
+  q('list').innerHTML = h + '</tbody></table>';
+}
+q('list').addEventListener('click', function(e){
+  var th = e.target.closest ? e.target.closest('th[data-k]') : null; if (!th) return;
+  var k = th.getAttribute('data-k'); SORT = {k: k, dir: SORT.k === k ? -SORT.dir : 1};
+  try { localStorage.setItem('rlease_sort', JSON.stringify(SORT)); } catch (e2) {}
+  draw();
+});
+q('b_refresh').addEventListener('click', function(){ location.reload(); });
+try { draw(); } catch (e) { q('list').innerHTML = '<div class="empty">' + hx(`<#RADM_78#>`) + '</div>'; }
+})();
+</script>
+</body>
+</html>
diff --git a/release/src/router/www/Reaper_Log.asp b/release/src/router/www/Reaper_Log.asp
