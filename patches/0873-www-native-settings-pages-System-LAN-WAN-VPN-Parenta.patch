+    h += kv(rows) + '</div>';
+  }
+  q('ovpnc').innerHTML = h;
+}
+function drawWgClients(){
+  var h = '', u;
+  for (u = 1; u <= WGC; u++){
+    var p = 'wgc' + u + '_', en = NV[p + 'enable'] === '1', up = LIVE.st['wgc' + u + '_status'], desc = NV[p + 'desc'] || ('Client ' + u);
+    var s = !en ? ['off', `<#RVST_21#>`] : (up === '1' ? ['on', `<#Connected#>`] : (up === '0' ? ['warn', `<#RVST_49#>`] : ['warn', `<#RVST_01#>`]));
