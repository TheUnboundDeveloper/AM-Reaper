+    c.Tor_socksport = txt('i_socks', NV.Tor_socksport); c.Tor_transport = txt('i_trans', NV.Tor_transport); c.Tor_dnsport = txt('i_dns', NV.Tor_dnsport);
+  }
+});
+section('p_dev', function(){
+  LIST = parseList(NV.Tor_redir_list);
+  devDraw();
+}, function(c){
+  /* scope "whole LAN" = an empty list (rc/firewall.c strlen == 0 branch); the list is re-serialised only once edited */
+  if (!q('t_tor').checked) return;
+  if (q('s_scope').value === 'lan') c.Tor_redir_list = '';
+  else c.Tor_redir_list = LIST_EDITED ? ser(LIST) : NV.Tor_redir_list;
+});
+
+function devDraw(){
+  var h = '';
+  LIST.forEach(function(x, i){
+    var isMac = rp.v.mac(x), name = isMac ? ReaperNames.byMac(x, '') : '';
+    h += '<tr><td>' + hx(name || (isMac ? `<#RTOR_20#>` : `<#RTOR_21#>`)) + '</td><td class="mono">' + hx(x) + '</td>' +
+      '<td class="acts"><span class="bwldel" data-i="' + i + '" title="' + hx(`<#CTL_del#>`) + '">&times;</span></td></tr>';
+  });
+  q('devbody').innerHTML = h || '<tr><td colspan="3" class="empty">' + hx(`<#IPConnection_VSList_Norule#>`) + '</td></tr>';
+  var b = q('devbudget'), bytes = ser(LIST).length;
+  b.textContent = sub(`<#RTOR_22#>`, LIST.length, bytes, MAXBYTES);
+  b.classList.toggle('hot', bytes > MAXBYTES * 0.9);
+}
+function devAdd(){
+  var mac = val('a_mac').toUpperCase(), list;
+  edmsg('');
+  if (!mac) return edmsg(`<#JS_fieldblank#>`, 'a_mac');
+  if (!macOk(mac)) return edmsg(`<#IPConnection_x_illegal_mac#>`, 'a_mac');
+  if (LIST.some(function(x){ return x.toUpperCase() === mac; })) return edmsg(`<#JS_duplicate#>`, 'a_mac');
+  list = LIST.concat([mac]);
+  if (ser(list).length > MAXBYTES) return edmsg(`<#RTOR_23#>`);
+  LIST = list; LIST_EDITED = true; q('a_mac').value = '';
+  q('s_scope').value = 'list';
+  devDraw(); syncAll();
+}
+function devDel(i){
+  if (!LIST[i]) return;
+  LIST.splice(i, 1); LIST_EDITED = true; devDraw(); syncAll();
+}
+
+/* ---------- collect, unsaved changes ---------- */
+function collect(){ var c = {}; SECTIONS.forEach(function(s){ if (!BROKEN[s.panel]) s.collect(c); }); return c; }
+function diff(c){ var ch = {}, k; for (k in c) if (Object.prototype.hasOwnProperty.call(c, k) && String(c[k]) !== String(NV[k] === undefined ? '' : NV[k])) ch[k] = c[k]; return ch; }
+function dirty(){
+  var n; try { n = count(diff(collect())); } catch (e) { return; }
+  rp.pill(n);
+}
+function torSync(){
+  var on = q('t_tor').checked, list = q('s_scope').value === 'list';
+  ['r_socks', 'r_trans', 'r_dns', 'r_scope'].forEach(function(id){ show(id, on); });
+  show('p_dev', on && list);
+  note('scopenote', on && !list ? `<#RTOR_24#>` : '');
+}
+function syncAll(){ torSync(); dirty(); }
+
+/* ---------- validate: '' or the message; the offending row is marked ---------- */
+function validate(c, ch){
+  function bad(id, m){
+    var el = q(id), row = el && el.closest ? el.closest('.frow') : null;
+    if (row){ row.classList.add('bad'); setTimeout(function(){ row.classList.remove('bad'); }, 6000); }
+    if (el && el.focus) el.focus();
+    return m;
+  }
+  if (c.Tor_enable !== '1') return '';
+  /* stock: numeric 0-65535 each; here 1-65535, non-empty and distinct (torrc needs three listeners) */
+  var ports = [['Tor_socksport', 'i_socks'], ['Tor_transport', 'i_trans'], ['Tor_dnsport', 'i_dns']], seen = {}, i;
+  for (i = 0; i < ports.length; i++){
+    var v = c[ports[i][0]];
+    if (!rp.v.port(v)) return bad(ports[i][1], `<#RTOR_25#>`);
+    if (seen[v]) return bad(ports[i][1], `<#RTOR_26#>`);
+    seen[v] = 1;
+  }
+  /* B-TOR-2: "selected devices" with nothing selected would save an empty list = every device */
+  if (q('s_scope').value === 'list' && !LIST.length) return bad('s_scope', `<#RTOR_27#>`);
+  if (c.Tor_redir_list !== undefined && c.Tor_redir_list.length > MAXBYTES) return bad('s_scope', `<#RTOR_23#>`);
+  return '';
+}
+
+/* ---------- apply ---------- */
+function applyAll(){
+  msg('');
+  var c = collect(), changed = diff(c);
+  if (!count(changed)){ msg(`<#RADM_63#>`); return; }
+  var err = validate(c, changed); if (err){ msg(err); return; }
+  /* rule 14: the selected devices lose everything that is not TCP or DNS (rc/firewall.c FORWARD DROP) and wait for Tor */
+  if (c.Tor_enable === '1'){
+    var turningOn = NV.Tor_enable !== '1', widening = changed.Tor_redir_list === '' && NV.Tor_redir_list !== '';
+    if (turningOn || widening){
+      var who = c.Tor_redir_list === '' ? `<#RTOR_28#>` : sub(`<#RTOR_29#>`, LIST.length);
+      if (!confirm(who + ' ' + `<#RTOR_30#>`)) return;
+    }
+  }
+  rp.applying(`<#Reaper_c_applying#>`, `<#RTOR_19#>`);
+  /* rc/services.c handle_notifications "tor": stop_Tor_proxy + start_Tor_proxy, then start_firewall rebuilds the
+     REDIRECT / DROP rules (the stock page used the same script with action_wait 3) */
+  rp.post(document.form, changed, 'restart_tor', 5);
+}
+
+/* ---------- state pill: is the Tor daemon running (httpd/sysinfo.c pid.<name>, parsed from appGet's raw wrapper) ---------- */
+function torState(){
+  var x = new XMLHttpRequest();
+  try {
+    x.open('GET', '/appGet.cgi?hook=sysinfo("pid.Tor")&_=' + Date.now(), true);
+    x.timeout = 6000;
+    x.onload = function(){
+      var s = String(x.responseText || ''), i = s.indexOf('":'), pid = i >= 0 ? parseInt(s.slice(i + 2), 10) : NaN;
+      var on = x.status === 200 && pid > 0;
+      q('statepill').className = 'pill ' + (on ? 'on' : (NV.Tor_enable === '1' ? 'bad' : ''));
+      q('statetext').textContent = on ? `<#RTOR_31#>` : (NV.Tor_enable === '1' ? `<#RTOR_32#>` : `<#RTOR_33#>`);
+    };
+    x.send();
+  } catch (e) {}
+}
+
+/* ---------- wiring ---------- */
+function boot(){
+  SECTIONS.forEach(function(s){
+    try { s.init(); }
+    catch (e){
+      BROKEN[s.panel] = 1; var p = q(s.panel); if (p) p.classList.add('broken');
+      if (window.console) console.error('Reaper_Tor: section ' + s.panel + ' failed to load:', e);
+    }
+  });
+  /* the state every control started in (keep() posts nvram's own value for an untouched control) */
+  Array.prototype.forEach.call(document.querySelectorAll('.syswrap input[id], .syswrap select[id]'), function(e){ INIT[e.id] = snap(e.id); });
+  on('applybtn', 'click', applyAll);
+  on('discardbtn', 'click', function(){ location.reload(); });
+  on('devaddbtn', 'click', devAdd);
+  on('devbody', 'click', function(e){ var t = e.target; if (t && t.classList && t.classList.contains('bwldel')) devDel(parseInt(t.getAttribute('data-i'), 10)); });
+  document.addEventListener('input', syncAll); document.addEventListener('change', syncAll);
+  q('statetext').textContent = NV.Tor_enable === '1' ? `<#RTOR_31#>` : `<#RTOR_33#>`;
+  q('statepill').className = 'pill' + (NV.Tor_enable === '1' ? ' on' : '');
+  if (!ROUTING){ show('modehint', true); q('applybtn').disabled = true; }
+  /* device names and the MAC picker (networkmap list, as stock's client dropdown) */
+  try {
+    ReaperNames.refresh(CUSTOM_CL, function(cl){
+      var dl = q('macs'), ml = (cl && cl.maclist) || [], h = '';
+      ml.forEach(function(mac){ var c = cl[mac]; if (!c || !rp.v.mac(mac)) return;
+        h += '<option value="' + hx(String(mac).toUpperCase()) + '">' + hx(ReaperNames.byMac(mac, mac) + (c.ip ? ' (' + c.ip + ')' : '')) + '</option>'; });
+      dl.innerHTML = h;
+      if (!BROKEN.p_dev) devDraw();
+    });
+  } catch (e) {}
+  torState();
+  syncAll();
+  rp.tips();
+}
+boot();
+})();
+</script>
+</body>
+</html>
