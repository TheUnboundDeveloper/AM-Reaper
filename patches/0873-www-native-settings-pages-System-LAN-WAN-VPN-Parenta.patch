+<script>
+(function(){
+'use strict';
+/* everything stays inside this closure: a page-level name can shadow reaper_util.js's window.esc and friends */
+var q = rp.q;
+var chk = rp.chk, U = rp.dec, msg = rp.msg, note = rp.note, on = rp.on, pick = rp.pick, show = rp.show, val = rp.val;   /* the kit's copies (rp.js) */
+/* every value arrives through nvram_char_to_ascii: httpd's nvram_get passes ' and \ through, so a stored value
+   could otherwise end the JS string it is written into */
+
+/* what the box holds now: the page posts only what differs from this */
+var NV = {
+  ipv6_service: U('<% nvram_char_to_ascii("","ipv6_service"); %>'), ipv6_ifdev: U('<% nvram_char_to_ascii("","ipv6_ifdev"); %>'),
+  ipv6_accept_defrtr: U('<% nvram_char_to_ascii("","ipv6_accept_defrtr"); %>'), ipv6_dhcp_pd: U('<% nvram_char_to_ascii("","ipv6_dhcp_pd"); %>'),
+  ipv6_dhcp6c_release: U('<% nvram_char_to_ascii("","ipv6_dhcp6c_release"); %>'),
+  ipv6_relay: U('<% nvram_char_to_ascii("","ipv6_relay"); %>'), ipv6_tun_v4end: U('<% nvram_char_to_ascii("","ipv6_tun_v4end"); %>'),
+  ipv6_tun_addr: U('<% nvram_char_to_ascii("","ipv6_tun_addr"); %>'), ipv6_tun_addrlen: U('<% nvram_char_to_ascii("","ipv6_tun_addrlen"); %>'),
+  ipv6_tun_peer: U('<% nvram_char_to_ascii("","ipv6_tun_peer"); %>'), ipv6_6rd_dhcp: U('<% nvram_char_to_ascii("","ipv6_6rd_dhcp"); %>'),
+  ipv6_6rd_prefix: U('<% nvram_char_to_ascii("","ipv6_6rd_prefix"); %>'), ipv6_6rd_prefixlen: U('<% nvram_char_to_ascii("","ipv6_6rd_prefixlen"); %>'),
+  ipv6_6rd_router: U('<% nvram_char_to_ascii("","ipv6_6rd_router"); %>'), ipv6_6rd_ip4size: U('<% nvram_char_to_ascii("","ipv6_6rd_ip4size"); %>'),
+  ipv6_tun_mtu: U('<% nvram_char_to_ascii("","ipv6_tun_mtu"); %>'), ipv6_tun_ttl: U('<% nvram_char_to_ascii("","ipv6_tun_ttl"); %>'),
+  ipv6_ipaddr: U('<% nvram_char_to_ascii("","ipv6_ipaddr"); %>'), ipv6_prefix_len_wan: U('<% nvram_char_to_ascii("","ipv6_prefix_len_wan"); %>'),
+  ipv6_gateway: U('<% nvram_char_to_ascii("","ipv6_gateway"); %>'), ipv6_rtr_addr: U('<% nvram_char_to_ascii("","ipv6_rtr_addr"); %>'),
+  ipv6_prefix: U('<% nvram_char_to_ascii("","ipv6_prefix"); %>'), ipv6_prefix_length: U('<% nvram_char_to_ascii("","ipv6_prefix_length"); %>'),
+  ipv6_prefix_s: U('<% nvram_char_to_ascii("","ipv6_prefix_s"); %>'), ipv6_prefix_length_s: U('<% nvram_char_to_ascii("","ipv6_prefix_length_s"); %>'),
+  ipv6_rtr_addr_s: U('<% nvram_char_to_ascii("","ipv6_rtr_addr_s"); %>'), ipv6_autoconf_type: U('<% nvram_char_to_ascii("","ipv6_autoconf_type"); %>'),
+  ipv6_dhcp_start: U('<% nvram_char_to_ascii("","ipv6_dhcp_start"); %>'), ipv6_dhcp_end: U('<% nvram_char_to_ascii("","ipv6_dhcp_end"); %>'),
+  ipv6_dhcp_lifetime: U('<% nvram_char_to_ascii("","ipv6_dhcp_lifetime"); %>'), ipv6_dnsenable: U('<% nvram_char_to_ascii("","ipv6_dnsenable"); %>'),
+  ipv6_dns1: U('<% nvram_char_to_ascii("","ipv6_dns1"); %>'), ipv6_dns2: U('<% nvram_char_to_ascii("","ipv6_dns2"); %>'), ipv6_dns3: U('<% nvram_char_to_ascii("","ipv6_dns3"); %>'),
+  ipv6_radvd: U('<% nvram_char_to_ascii("","ipv6_radvd"); %>')
+};
+/* facts the stock page read: the WAN type (dual WAN reads WAN 0's), its IPv4 address (6to4), FTP (restart_ftpd) */
+var DUALWAN = U('<% nvram_char_to_ascii("","wans_dualwan"); %>');
+var RCSUP = ' ' + U('<% nvram_char_to_ascii("","rc_support"); %>') + ' ';
+function sup(x){ return RCSUP.indexOf(' ' + x + ' ') !== -1; }
+var WANS = DUALWAN.indexOf('none') === -1 && sup('dualwan');
+var WANPROTO = WANS ? U('<% nvram_char_to_ascii("","wan0_proto"); %>') : U('<% nvram_char_to_ascii("","wan_proto"); %>');
+var WAN0IP = U('<% nvram_char_to_ascii("","wan0_ipaddr"); %>');
+var FTP_ON = U('<% nvram_char_to_ascii("","enable_ftp"); %>') === '1';
+var PPPW = (WANPROTO === 'pppoe' || WANPROTO === 'pptp' || WANPROTO === 'l2tp');
+/* the WAN types that own the IPv6 setup (rc/softwire46): stock locks the type selector for them */
+var S46 = {v6plus: `<#IPv6_plus#>`, ocnvc: `<#IPv6_ocnvc#>`, dslite: 'DS-Lite', v6opt: `<#IPv6_opt#>`};
+/* "static6" is the legacy name of Static IPv6; shared/misc.c reads both */
+var ORIG = NV.ipv6_service === 'static6' ? 'other' : NV.ipv6_service;
+var TYPEHELP = {disabled: `<#RIP6_34#>`, dhcp6: `<#RIP6_32#>`, other: `<#RIP6_33#>`, ipv6pt: `<#RIP6_30#>`, flets: `<#RIP6_31#>`,
+  '6to4': `<#RIP6_35#>`, '6in4': `<#RIP6_20#>`, '6rd': `<#RIP6_36#>`};
+var LIVE = {prefix: NV.ipv6_prefix, plen: NV.ipv6_prefix_length, rtr: NV.ipv6_rtr_addr};
+
+function svc(){ return q('s_service').value; }
+
+/* stock GetIPv6_split: the first four groups of an address (or what precedes "::"), the /64 the pool lives in */
+function split6(a){
+  var s1 = a.split('::'), pos = a.search('::'), s2 = a.split(':'), r = '', i;
+  if (s1.length > 1){
+    if (s1[0].substring(0, pos).split(':').length > 4){ for (i = 0; i < 4; i++){ r += s2[i]; if (i < 3) r += ':'; } }
+    else r = s1[0];
+  } else if (s2.length > 1){ for (i = 0; i < 4; i++){ r += (s2[i] === undefined ? '' : s2[i]); if (i < 3) r += ':'; } }
+  return r;
+}
+/* stock calcIP6: 6to4 prefix 2002:WWXX:YYZZ::/48 from the WAN IPv4 address */
+function calc6to4(ip){
+  var o = String(ip).split('.'), h = function(n){ var x = (parseInt(n, 10) || 0).toString(16); return x.length < 2 ? '0' + x : x; };
+  return '2002:' + h(o[0]) + h(o[1]) + ':' + h(o[2]) + h(o[3]) + '::';
+}
+
+/* ---------- sections: each initialises in its own guard ---------- */
+var SECTIONS = [], BROKEN = {};
+function section(panel, init){ SECTIONS.push({panel: panel, init: init}); }
+
+section('p_conn', function(){
+  if (!sup('ipv6pt')){ ['ipv6pt', 'flets'].forEach(function(v){ var o = q('s_service').querySelector('option[value="' + v + '"]'); if (o) o.parentNode.removeChild(o); }); }
+  if (!pick(q('s_service'), ORIG)) pick(q('s_service'), 'disabled');
+  pick(q('s_ifdev'), NV.ipv6_ifdev === 'eth' ? 'eth' : 'ppp');
+  q('t_defrtr').checked = NV.ipv6_accept_defrtr === '1';
+  q('t_pd').checked = NV.ipv6_dhcp_pd !== '0';
+  q('t_release').checked = NV.ipv6_dhcp6c_release === '1';
+  if (S46[WANPROTO]){
+    q('s_service').disabled = true;
+    note('s46note', `<#ipv6_v6plus_service_hint#>`.replace('%3$@', function(){ return S46[WANPROTO]; }));
+  }
+});
+section('p_tun', function(){
+  q('i_relay').value = NV.ipv6_relay; q('i_v4end').value = NV.ipv6_tun_v4end;
+  q('i_tunaddr').value = NV.ipv6_tun_addr; q('i_tunaddrlen').value = NV.ipv6_tun_addrlen; q('i_tunpeer').value = NV.ipv6_tun_peer;
+  q('t_6rddhcp').checked = NV.ipv6_6rd_dhcp !== '0';
+  q('i_6rdprefix').value = NV.ipv6_6rd_prefix; q('i_6rdprefixlen').value = NV.ipv6_6rd_prefixlen;
+  q('i_6rdrouter').value = NV.ipv6_6rd_router; q('i_6rdip4size').value = NV.ipv6_6rd_ip4size;
+  q('i_mtu').value = NV.ipv6_tun_mtu; q('i_ttl').value = NV.ipv6_tun_ttl;
+});
+section('p_wan', function(){
+  q('i_ipaddr').value = NV.ipv6_ipaddr; q('i_plenwan').value = NV.ipv6_prefix_len_wan; q('i_gw').value = NV.ipv6_gateway;
+});
+section('p_lan', function(){
+  q('i_rtr').value = NV.ipv6_rtr_addr; q('i_prefix').value = NV.ipv6_prefix; q('i_plen').value = NV.ipv6_prefix_length;
+  pick(q('s_ac'), NV.ipv6_autoconf_type === '1' ? '1' : '0');
+  /* the pool is stored as prefix::hex; rc reads only the last group (rc/services.c, s6_addr16[7]) */
+  var a = NV.ipv6_dhcp_start.split('::')[1], b = NV.ipv6_dhcp_end.split('::')[1];
+  q('i_start').value = (NV.ipv6_dhcp_start && NV.ipv6_dhcp_end && a !== undefined) ? a : '1000';
+  q('i_end').value = (NV.ipv6_dhcp_start && NV.ipv6_dhcp_end && b !== undefined) ? b : '2000';
+  q('i_life').value = NV.ipv6_dhcp_lifetime;
+});
+section('p_dns', function(){
+  q('t_dnsauto').checked = NV.ipv6_dnsenable !== '0';
+  q('i_dns1').value = NV.ipv6_dns1; q('i_dns2').value = NV.ipv6_dns2; q('i_dns3').value = NV.ipv6_dns3;
+});
+section('p_ra', function(){ q('t_radvd').checked = NV.ipv6_radvd === '1'; });
+
+/* ---------- the stock visibility rules (Advanced_IPv6_Content.asp showInputfield / showInputfield2) ---------- */
+function rules(){
+  var v = svc(), pd = q('t_pd').checked, d6 = v === 'dhcp6', oth = v === 'other', pt = v === 'ipv6pt' || v === 'flets';
+  var tun = v === '6to4' || v === '6in4' || v === '6rd', orig = v === ORIG;
+  var R = {
+    ifdev: PPPW && (d6 || oth || v === 'ipv6pt'),
+    pd: d6, release: d6 || pt,
+    relay: v === '6to4', v4end: v === '6in4', tunaddr: v === '6in4', tunpeer: v === '6in4',
+    rd: v === '6rd', rdman: v === '6rd' && !q('t_6rddhcp').checked, mtu: tun, ttl: tun,
+    wan: oth || (d6 && pd), ipaddr: oth, gw: oth, plenwan: oth || (d6 && pd),
+    lan: d6 || oth || tun,
+    rtr: oth || (d6 && !pd), rtrv: tun || (d6 && pd),
+    plen: oth || (d6 && !pd) || v === '6in4', plenv: (d6 && pd) || v === '6to4' || v === '6rd',
+    prefix: v === '6in4', prefixv: d6 || oth || v === '6to4' || v === '6rd',
+    ac: d6 || oth, dns: v !== 'disabled', dnsauto: d6 || pt, ra: d6 || oth || tun
+  };
+  R.defrtr = d6 && R.ifdev && q('s_ifdev').value === 'ppp';
+  R.pool = R.ac && q('s_ac').value === '1';
+  R.dnsman = R.dns && (!R.dnsauto || !q('t_dnsauto').checked);
+  R.orig = orig;
+  return R;
+}
+function liveText(s){ return s ? s : `<#RIP6_21#>`; }
+function setLive(id, s){ var e = q(id); e.textContent = liveText(s); e.classList.toggle('dim', !s); }
+/* the prefix the stateful pool is built on, as stock built it */
+function poolPrefix(R){
+  var v = svc();
+  if (v === 'other' || (v === 'dhcp6' && !q('t_pd').checked)) return val('i_rtr') ? split6(val('i_rtr')) : '';
+  return (R.orig && LIVE.rtr) ? split6(LIVE.rtr) : '';
+}
+function sync(){
+  var R = rules(), v = svc();
+  show('r_ifdev', R.ifdev); show('r_defrtr', R.defrtr); show('r_pd', R.pd); show('r_release', R.release);
+  show('p_tun', R.relay || R.v4end || R.rd || R.mtu);
+  show('r_relay', R.relay); show('r_v4end', R.v4end); show('r_tunaddr', R.tunaddr); show('r_tunpeer', R.tunpeer);
+  show('r_6rddhcp', R.rd); ['r_6rdprefix', 'r_6rdrouter', 'r_6rdip4size'].forEach(function(id){ show(id, R.rdman); });
+  show('r_mtu', R.mtu); show('r_ttl', R.ttl);
+  show('p_wan', R.wan); show('r_ipaddr', R.ipaddr); show('r_plenwan', R.plenwan); show('r_gw', R.gw);
+  show('p_lan', R.lan); show('r_rtr', R.rtr); show('r_rtrv', R.rtrv); show('r_plen', R.plen); show('r_plenv', R.plenv);
+  show('r_prefix', R.prefix); show('r_prefixv', R.prefixv); show('r_ac', R.ac);
+  ['r_start', 'r_end', 'r_life'].forEach(function(id){ show(id, R.pool); });
+  show('p_dns', R.dns); show('r_dnsauto', R.dnsauto); ['r_dns1', 'r_dns2', 'r_dns3'].forEach(function(id){ show(id, R.dnsman); });
+  show('p_ra', R.ra);
+  q('typehelp').textContent = TYPEHELP[v] || '';
+  /* read-only values: live from the box while the saved type is selected, derived where stock derived them */
+  if (v === '6to4'){ setLive('v_prefix', WAN0IP ? calc6to4(WAN0IP) : ''); setLive('v_plen', '48'); setLive('v_rtr', R.orig ? LIVE.rtr : ''); }
+  else if (v === 'other' || (v === 'dhcp6' && !q('t_pd').checked)){ var p = val('i_rtr') ? split6(val('i_rtr')) : ''; setLive('v_prefix', p ? p + '::' : ''); }
+  else { setLive('v_prefix', R.orig ? LIVE.prefix : ''); setLive('v_plen', R.orig ? LIVE.plen : ''); setLive('v_rtr', R.orig ? LIVE.rtr : ''); }
+  var pp = poolPrefix(R); q('pfx_start').textContent = pp + '::'; q('pfx_end').textContent = pp + '::';
+  /* stock: on a v6plus / OCN / IPv6 Option WAN, Passthrough with manual DNS gets a "turn auto DNS on" note */
+  var dn = (WANPROTO === 'v6plus' || WANPROTO === 'ocnvc' || WANPROTO === 'v6opt') && v === 'ipv6pt' && !q('t_dnsauto').checked;
+  note('dnsnote', dn ? `<#IPv6_plus_dns_auto_hint#>`.replace('%2$@', function(){ return S46[WANPROTO]; }) : '');
+  statePill();
+}
+function statePill(){
+  var on = ORIG !== 'disabled' && ORIG !== '', o = q('s_service').querySelector('option[value="' + ORIG + '"]');
+  q('statetext').textContent = on ? ((o ? o.textContent : ORIG) + (LIVE.prefix ? '  ' + LIVE.prefix + (LIVE.plen ? '/' + LIVE.plen : '') : '')) : `<#RIP6_22#>`;
+  q('statepill').className = 'pill' + (on ? ' on' : '');
+}
+
+/* ---------- collect: exactly the fields stock posted for the selected type ---------- */
+function collect(){
+  var c = {}, R = rules(), v = svc();
+  if (!BROKEN.p_conn){
+    c.ipv6_service = v;
+    c.ipv6_ifdev = v === 'flets' ? 'eth' : (R.ifdev ? q('s_ifdev').value : 'ppp');
+    if (v === 'dhcp6'){ c.ipv6_accept_defrtr = chk('t_defrtr'); c.ipv6_dhcp_pd = chk('t_pd'); }
+    if (R.release) c.ipv6_dhcp6c_release = chk('t_release');
+  }
+  if (!BROKEN.p_tun){
+    if (R.relay) c.ipv6_relay = val('i_relay');
+    if (R.v4end){ c.ipv6_tun_v4end = val('i_v4end'); c.ipv6_tun_addr = val('i_tunaddr'); c.ipv6_tun_addrlen = val('i_tunaddrlen'); c.ipv6_tun_peer = val('i_tunpeer'); }
+    if (R.rd) c.ipv6_6rd_dhcp = chk('t_6rddhcp');
+    if (R.rdman){ c.ipv6_6rd_prefix = val('i_6rdprefix'); c.ipv6_6rd_prefixlen = val('i_6rdprefixlen'); c.ipv6_6rd_router = val('i_6rdrouter'); c.ipv6_6rd_ip4size = val('i_6rdip4size'); }
+    if (R.mtu){ c.ipv6_tun_mtu = val('i_mtu'); c.ipv6_tun_ttl = val('i_ttl'); }
+  }
+  if (!BROKEN.p_wan){
+    if (R.ipaddr){ c.ipv6_ipaddr = val('i_ipaddr'); c.ipv6_gateway = val('i_gw'); }
+    if (R.plenwan) c.ipv6_prefix_len_wan = val('i_plenwan');
+  }
+  if (!BROKEN.p_lan){
+    if (R.rtr) c.ipv6_rtr_addr = val('i_rtr');
+    if (R.plen) c.ipv6_prefix_length = val('i_plen');
+    if (R.prefix) c.ipv6_prefix = val('i_prefix');
+    /* rc reads these copies for Static (prefix length + LAN address) and 6in4 (prefix + length) */
+    if (v === 'other'){ c.ipv6_prefix_length_s = val('i_plen'); c.ipv6_rtr_addr_s = val('i_rtr'); }
+    if (v === '6in4'){ c.ipv6_prefix_length_s = val('i_plen'); c.ipv6_prefix_s = val('i_prefix'); }
+    if (R.ac) c.ipv6_autoconf_type = q('s_ac').value;
+    if (R.pool){ var pp = poolPrefix(R); c.ipv6_dhcp_start = pp + '::' + val('i_start'); c.ipv6_dhcp_end = pp + '::' + val('i_end'); c.ipv6_dhcp_lifetime = val('i_life'); }
+  }
+  if (!BROKEN.p_dns){
+    if (R.dnsauto) c.ipv6_dnsenable = chk('t_dnsauto');
+    if (R.dnsman){ c.ipv6_dns1 = val('i_dns1'); c.ipv6_dns2 = val('i_dns2'); c.ipv6_dns3 = val('i_dns3'); }
+  }
+  if (!BROKEN.p_ra) c.ipv6_radvd = chk('t_radvd');
+  return c;
+}
+function diff(c){ return rp.diff(c, NV); }
+function dirty(){ var changed; try { changed = diff(collect()); } catch (e) { return; } rp.dirtyMark(changed); }
+
+/* ---------- validate (stock validForm): returns '' or the message; the row is marked ---------- */
+function validate(c){
+  var v = svc();
+  function bad(id, m){
+    var el = q(id), row = el && el.closest ? el.closest('.frow') : null;
+    if (row){ row.classList.add('bad'); setTimeout(function(){ row.classList.remove('bad'); }, 6000); }
+    if (el && el.focus) el.focus();
+    return m;
+  }
+  function v6(id, opt){ var s = val(id); return (opt && s === '') || rp.v.ipv6(s); }
+  function rng(id, lo, hi){ return rp.v.int(val(id), lo, hi); }
+  function e6(id){ return bad(id, `<#RIP6_23#>`); }
+  function eN(id, lo, hi){ return bad(id, `<#RIP6_25#>` + ' ' + lo + ' - ' + hi); }
