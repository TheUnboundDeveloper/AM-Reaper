index 0000000000..6eb24c2bb0
--- /dev/null
+++ b/release/src/router/www/Reaper_SNMP.asp
@@ -0,0 +1,220 @@
+<!-- SPDX-License-Identifier: GPL-2.0-only
+     Copyright (C) 2026 the Reaper project maintainer
+     Part of the Reaper hardened Asuswrt-Merlin build. See LICENSE / LICENSE.reaper. -->
+<!DOCTYPE html>
+<html lang="en">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width, initial-scale=1">
+<meta name="reaper-native" content="1">
+<title>REAPER &mdash; SNMP</title>
+<!-- Reaper_SNMP.asp - Administration > SNMP (Reaper-native UI wave 1, 2026-10-23).
+     Replaces Advanced_SNMP_Content.asp: the same nine settings (parity file
+     build-scripts/tests/ui_parity/Advanced_SNMP_Content.json) on the kit, only the changed ones posted.
+     What rc/snmpd.c does with them, and the page says so: SNMPv3 only (v1/v2c communities are never
+     written), the v3 user is the router login name, both passphrases are cut to one token (spaces and
+     control characters dropped) and net-snmp refuses one shorter than 8 - so the page asks for 8 to 64
+     printable characters without spaces, and only while SNMP is on (the stock page's privacy-password
+     check blocked Apply even with SNMP off). restart_snmpd also rebuilds the firewall (the WAN rule). -->
+<link rel="stylesheet" href="/reaper/rp.css">
+<style>
+/* page-specific rules only; the Reaper look comes from /reaper/rp.css */
+.frow input.mid{width:320px} .frow select{min-width:160px}
+.frow.off,.panel.off{display:none}
+.frow.bad input,.frow.bad select{border-color:var(--crimson)!important;box-shadow:0 0 0 2px rgba(225,6,0,.25)}
+.msg{font-size:12.5px;color:var(--amber);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:100%;min-width:0;display:none}
+</style>
+</head>
+<body>
+<script src="/reaper_util.js"></script>
+<script src="/reaper/rp.js"></script>
+
+<div class="syswrap">
+<div class="pagehead">
+  <div>
+    <div class="eyebrow"><#menu5_6#></div>
+    <h1>SNMP</h1>
+  </div>
+  <span class="pill" id="statepill"><span class="dot"></span><span id="statetext"></span></span>
+  <div class="spacer"></div>
+  <span class="pill warn chgpill" id="chgpill"><span class="dot"></span><span><#RADM_77#>: <b id="chgcount">0</b></span></span>
+  <button type="button" class="btn ghost" id="discardbtn" disabled><#Discard#></button>
+  <button type="button" class="btn primary" id="applybtn"><#CTL_apply#></button>
+</div>
+<div class="msg" id="topmsg" style="margin:-6px 0 12px"></div>
+<div class="hint" style="margin:-4px 0 14px"><#RSNM_01#></div>
+
+<div class="rframe">
+<div class="panel" id="p_agent">
+  <h2><#RSNM_02#></h2>
+  <div class="secerr"><#RADM_78#></div>
+  <div class="frow"><div class="fl"><#RSNM_03#></div><div class="fc"><label class="tswitch"><input type="checkbox" id="t_snmpd_enable"><span class="track"></span></label></div></div>
+  <div class="frow on1" id="r_wan"><div class="fl"><#RSNM_04#></div><div class="fc"><label class="tswitch"><input type="checkbox" id="t_snmpd_wan"><span class="track"></span></label></div><div class="fh"><#RSNM_05#></div></div>
+  <div class="frow on1"><div class="fl"><#RSNM_06#></div><div class="fc"><input type="text" class="mid" id="i_sysName" maxlength="255" autocomplete="off"></div></div>
+  <div class="frow on1"><div class="fl"><#RSNM_07#></div><div class="fc"><input type="text" class="mid" id="i_sysLocation" maxlength="255" autocomplete="off"></div></div>
+  <div class="frow on1"><div class="fl"><#RSNM_08#></div><div class="fc"><input type="text" class="mid" id="i_sysContact" maxlength="255" autocomplete="off"></div><div class="fh"><#RSNM_09#></div></div>
+</div>
+
+<div class="panel" id="p_user">
+  <h2><#RSNM_10#></h2>
+  <div class="sub"><#RSNM_11#></div>
+  <div class="secerr"><#RADM_78#></div>
+  <div class="frow on1"><div class="fl"><#RSNM_12#></div><div class="fc"><span class="fv mono" id="v3user"></span></div></div>
+  <div class="frow on1"><div class="fl"><#RSNM_13#></div><div class="fc"><select id="s_v3_auth_type"><option value="SHA">SHA</option><option value="MD5">MD5</option></select></div></div>
+  <div class="frow on1"><div class="fl"><#RSNM_14#></div><div class="fc"><input type="password" class="mid mono" id="i_v3_auth_passwd" maxlength="64" autocomplete="new-password"></div><div class="fh"><#RSNM_18#></div></div>
+  <div class="frow on1"><div class="fl"><#RSNM_15#></div><div class="fc"><select id="s_v3_priv_type"><option value="AES">AES</option><option value="DES">DES</option><option value="NONE"><#wl_securitylevel_0#></option></select></div></div>
+  <div class="frow on1" id="r_privpw"><div class="fl"><#RSNM_16#></div><div class="fc"><input type="password" class="mid mono" id="i_v3_priv_passwd" maxlength="64" autocomplete="new-password"></div></div>
+  <div class="frow on1"><div class="fl"></div><div class="fc"><label class="chk"><input type="checkbox" id="c_showpw"><#RSNM_17#></label></div></div>
+</div>
+</div>
+</div>
+
+<div class="applying" id="applying"><div class="abox"><h2 id="ap_t"><#Reaper_c_applying#></h2><p id="ap_p"><#RADM_61#></p></div></div>
+<iframe name="hidden_frame" id="hidden_frame" style="display:none" width="0" height="0"></iframe>
+<form method="post" name="form" action="/start_apply.htm" target="hidden_frame">
+  <input type="hidden" name="current_page" value="Reaper_SNMP.asp">
+  <input type="hidden" name="next_page" value="Reaper_SNMP.asp">
+  <input type="hidden" name="action_mode" value="apply">
+  <input type="hidden" name="action_script" value="">
+  <input type="hidden" name="action_wait" value="5">
+  <input type="hidden" name="snmpd_enable" value="" disabled>
+  <input type="hidden" name="snmpd_wan" value="" disabled>
+  <input type="hidden" name="sysName" value="" disabled>
+  <input type="hidden" name="sysLocation" value="" disabled>
+  <input type="hidden" name="sysContact" value="" disabled>
+  <input type="hidden" name="v3_auth_type" value="" disabled>
+  <input type="hidden" name="v3_auth_passwd" value="" disabled>
+  <input type="hidden" name="v3_priv_type" value="" disabled>
+  <input type="hidden" name="v3_priv_passwd" value="" disabled>
+</form>
+
+<script>
+(function(){
+'use strict';
+/* everything stays inside this closure: a page-level name can shadow reaper_util.js's window.esc and friends */
+var q = rp.q;
+var chk = rp.chk, U = rp.dec, msg = rp.msg, on = rp.on, setChk = rp.setChk, show = rp.show;   /* the kit's copies (rp.js) */
+var SW = '<% nvram_get("sw_mode"); %>';
+var ROUTER = (SW === '1');
+
+/* what the box holds now: the page posts only what differs from this */
+var NV = {
+  snmpd_enable: '<% nvram_get("snmpd_enable"); %>', snmpd_wan: '<% nvram_get("snmpd_wan"); %>',
+  sysName: U('<% nvram_char_to_ascii("","sysName"); %>'), sysLocation: U('<% nvram_char_to_ascii("","sysLocation"); %>'),
+  sysContact: U('<% nvram_char_to_ascii("","sysContact"); %>'),
+  /* review 2026-10-24 (S-C2-2): the passphrases never ride the page source - a presence flag each, an empty field
+     that posts only when typed (the Internet page's pattern) */
+  v3_auth_type: '<% nvram_get("v3_auth_type"); %>', v3_auth_passwd: '', v3_auth_set: '<% nvram_match("v3_auth_passwd", "", "0"); %>' !== '0',
+  v3_priv_type: '<% nvram_get("v3_priv_type"); %>', v3_priv_passwd: '', v3_priv_set: '<% nvram_match("v3_priv_passwd", "", "0"); %>' !== '0',
+  http_username: U('<% nvram_char_to_ascii("","http_username"); %>')
+};
+/* an empty nvram value means the default (shared/defaults.c): compare against what the control shows for it */
+(function(){ var D = {snmpd_enable: '0', snmpd_wan: '0', v3_auth_type: 'SHA', v3_priv_type: 'AES'}, k;
+  for (k in D) if (NV[k] === '') NV[k] = D[k]; })();
+
+function isOn(v){ return v === '1'; }
+function shown(id){ var e = q(id); return !!e && !e.classList.contains('off'); }
+function pick(sel, v){ var i; for (i = 0; i < sel.options.length; i++) if (sel.options[i].value === v){ sel.value = v; return; } }
+
+/* ---------- sections: each initialises in its own guard and contributes its own fields ---------- */
+var SECTIONS = [], BROKEN = {};
+function section(panel, init, collect){ SECTIONS.push({panel: panel, init: init, collect: collect}); }
+
+section('p_agent', function(){
+  setChk('t_snmpd_enable', isOn(NV.snmpd_enable)); setChk('t_snmpd_wan', isOn(NV.snmpd_wan));
+  q('i_sysName').value = NV.sysName; q('i_sysLocation').value = NV.sysLocation; q('i_sysContact').value = NV.sysContact;
+}, function(c){
+  c.snmpd_enable = chk('t_snmpd_enable');
+  /* the WAN rule is a router-mode firewall rule; outside router mode the switch is hidden and the value kept */
+  c.snmpd_wan = ROUTER ? chk('t_snmpd_wan') : NV.snmpd_wan;
+  c.sysName = q('i_sysName').value.trim(); c.sysLocation = q('i_sysLocation').value.trim(); c.sysContact = q('i_sysContact').value.trim();
+});
+
+section('p_user', function(){
+  q('v3user').textContent = NV.http_username;
+  pick(q('s_v3_auth_type'), NV.v3_auth_type); pick(q('s_v3_priv_type'), NV.v3_priv_type);
+  q('i_v3_auth_passwd').value = ''; q('i_v3_auth_passwd').placeholder = NV.v3_auth_set ? '********' : '';
+  q('i_v3_priv_passwd').value = ''; q('i_v3_priv_passwd').placeholder = NV.v3_priv_set ? '********' : '';
+}, function(c){
+  c.v3_auth_type = q('s_v3_auth_type').value; c.v3_auth_passwd = q('i_v3_auth_passwd').value;
+  c.v3_priv_type = q('s_v3_priv_type').value;
+  /* a hidden privacy password (privacy None) keeps what nvram holds */
+  c.v3_priv_passwd = shown('r_privpw') ? q('i_v3_priv_passwd').value : NV.v3_priv_passwd;
+});
+
+function sync(){
+  var on = q('t_snmpd_enable').checked, rows = document.querySelectorAll('.frow.on1'), i;
+  for (i = 0; i < rows.length; i++) rows[i].classList.toggle('off', !on);
+  show('p_user', on);
+  if (on){ show('r_wan', ROUTER); show('r_privpw', q('s_v3_priv_type').value !== 'NONE'); }
+}
+function statePill(){
+  var on = isOn(NV.snmpd_enable);
+  q('statetext').textContent = on ? `<#RSNM_20#>` : `<#RSNM_21#>`;
+  q('statepill').className = 'pill' + (on ? ' on' : '');
+}
+
+/* ---------- collect, unsaved changes ---------- */
+function collect(){
+  var c = {};
+  SECTIONS.forEach(function(s){ if (!BROKEN[s.panel]) s.collect(c); });
+  return c;
+}
+function diff(c){ return rp.diff(c, NV); }
+function dirty(){ var changed; try { changed = diff(collect()); } catch (e) { return; } rp.dirtyMark(changed); }
+
+/* ---------- validate: returns '' or the message; the row is marked ---------- */
+/* rc/snmpd.c drops spaces and control characters from both passphrases and net-snmp refuses one under 8 */
+function pwOk(p){ return /^[\x21-\x7e]{8,64}$/.test(p); }
+function validate(c){
+  function bad(id, m){
+    var el = q(id), row = el && el.closest ? el.closest('.frow') : null;
+    if (row){ row.classList.add('bad'); setTimeout(function(){ row.classList.remove('bad'); }, 6000); }
+    if (el && el.focus) el.focus();
+    return m;
+  }
+  if (c.snmpd_enable !== '1') return '';
+  /* an empty field keeps the stored passphrase (when one is stored); a typed one must pass the rule */
+  if (c.v3_auth_passwd !== '' ? !pwOk(c.v3_auth_passwd) : !NV.v3_auth_set) return bad('i_v3_auth_passwd', `<#RSNM_19#>`);
+  if (c.v3_priv_type !== 'NONE' && (c.v3_priv_passwd !== '' ? !pwOk(c.v3_priv_passwd) : !NV.v3_priv_set)) return bad('i_v3_priv_passwd', `<#RSNM_19#>`);
+  return '';
+}
+
+/* ---------- apply ---------- */
+function applyAll(){
+  msg('');
+  var c = collect(), err = validate(c), changed, n = 0, k;
+  if (err){ msg(err); return; }
+  changed = diff(c); for (k in changed) n++;
+  if (!n){ msg(`<#RADM_63#>`); return; }
+  /* restart_snmpd = stop, start (only when enabled) and a firewall rebuild; with SNMP off before and after,
+     nothing runs that reads these values, so the save alone is enough */
+  var live = c.snmpd_enable === '1' || NV.snmpd_enable === '1';
+  var script = live ? 'restart_snmpd' : 'saveNvram', wait = live ? 5 : 1;
+  rp.applying(`<#Reaper_c_applying#>`, `<#RADM_61#>`);
+  rp.post(document.form, changed, script, wait, false);
+  setTimeout(function(){ location.reload(); }, (wait + 4) * 1000);
+}
+
+/* ---------- wiring ---------- */
+function boot(){
+  SECTIONS.forEach(function(s){
+    try { s.init(); }
+    catch (e){
+      BROKEN[s.panel] = 1; var p = q(s.panel); if (p) p.classList.add('broken');
+      if (window.console) console.error('Reaper_SNMP: section ' + s.panel + ' failed to load:', e);
+    }
+  });
+  on('applybtn', 'click', applyAll);
+  on('discardbtn', 'click', function(){ location.reload(); });
+  on('t_snmpd_enable', 'change', sync);
+  on('s_v3_priv_type', 'change', sync);
+  on('c_showpw', 'change', function(){ var t = q('c_showpw').checked ? 'text' : 'password'; q('i_v3_auth_passwd').type = t; q('i_v3_priv_passwd').type = t; });
+  document.addEventListener('input', dirty); document.addEventListener('change', dirty);
+  sync(); statePill(); dirty();
+}
+boot();
+})();
+</script>
+</body>
+</html>
