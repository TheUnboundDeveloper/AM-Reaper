+<!-- SPDX-License-Identifier: GPL-2.0-only
+     Copyright (C) 2026 the Reaper project maintainer
+     Part of the Reaper hardened Asuswrt-Merlin build. See LICENSE / LICENSE.reaper. -->
+<!DOCTYPE html>
+<html lang="en">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width, initial-scale=1">
+<meta name="reaper-native" content="1">
+<title>REAPER &mdash; <#Network_Analysis#></title>
+<!-- Reaper_Analysis.asp - Network Tools > Network Analysis (Reaper-native UI, Network Tools wave, 2026-10-23).
+     Replaces Main_Analysis_Content.asp (the RT-BE96U shipped the ROG_UI copy on netool.cgi). Ping, continuous ping
+     (one long run read as it grows, drawn as a latency graph with loss / jitter), traceroute and nslookup through
+     reaper_net.cgi: the page sends a tool and a target, the server validates the target and builds the command
+     itself (no shell, bounded counts, one job at a time, hard runtime cap, always ends). Presets come from the
+     kit's rp.pingPresets (/ajax/DNS_List.json). -->
+<link rel="stylesheet" href="/reaper/rp.css">
+<style>
+.frow input.mid{width:280px} .frow input.short{width:80px} .frow select{min-width:200px}
+.frow.off{display:none}
+.btns{display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin-top:14px}
+.msg{font-size:12.5px;color:var(--amber);display:none} 
+.out{background:#000;border:1px solid var(--line-soft);border-radius:10px;color:var(--bone-dim);font-family:var(--mono);font-size:12px;line-height:1.5;
+  padding:10px 12px;margin:0;height:46vh;min-height:220px;overflow:auto;white-space:pre-wrap;word-break:break-all}
+.stats{display:grid;grid-template-columns:repeat(auto-fill,minmax(130px,1fr));gap:8px 18px;margin:4px 0 12px}
+.stats .k{color:var(--steel);font-family:var(--hdr);font-weight:600;font-size:11px;letter-spacing:.1em;text-transform:uppercase}
+.stats .v{color:var(--bone);font-family:var(--mono);font-size:14px}
+.graph{width:100%;height:180px;background:#000;border:1px solid var(--line-soft);border-radius:10px;display:block}
+.graph .ln{fill:none;stroke:#E10600;stroke-width:1.6}
+.graph .gr{stroke:rgba(255,255,255,.07);stroke-width:1}
+.graph .lb{fill:var(--steel);font-family:var(--mono);font-size:10px}
+.graph .ls{fill:#E0A93B}
+</style>
+</head>
+<body>
+<script src="/reaper_util.js"></script>
+<script src="/reaper/rp.js"></script>
+
+<div class="syswrap">
+<div class="pagehead">
+  <div>
+    <div class="eyebrow"><#Network_Tools#></div>
+    <h1><#Network_Analysis#></h1>
+  </div>
+  <span class="pill" id="statepill"><span class="dot"></span><span id="statetext"></span></span>
+  <div class="spacer"></div>
+</div>
+<div class="hint" style="margin:-4px 0 14px"><#RNT_01#></div>
+
+<div class="rframe">
+<div class="panel" id="p_run">
+  <div class="frow"><div class="fl"><#RNT_02#></div><div class="fc"><select id="s_tool">
+    <option value="ping"><#RNT_03#></option><option value="cping"><#RNT_04#></option>
+    <option value="traceroute"><#RNT_05#></option><option value="nslookup"><#RNT_06#></option></select></div></div>
+  <div class="frow"><div class="fl"><#NetworkTools_target#></div><div class="fc">
+    <input type="text" class="mid mono" id="i_target" maxlength="253" list="presets" autocomplete="off" placeholder="example.com">
+    <datalist id="presets"></datalist></div><div class="fh"><#RNT_07#></div></div>
+  <div class="frow" id="r_ver"><div class="fl"><#RNT_08#></div><div class="fc">
+    <label class="chk"><input type="radio" name="ver" value="4" checked>IPv4</label><label class="chk"><input type="radio" name="ver" value="6">IPv6</label></div></div>
+  <div class="frow" id="r_count"><div class="fl"><#RNT_09#></div><div class="fc"><input type="text" class="short mono" id="i_count" maxlength="3" value="5"><span class="unit" id="countunit"></span></div></div>
+  <div class="frow off" id="r_hops"><div class="fl"><#RNT_10#></div><div class="fc"><input type="text" class="short mono" id="i_hops" maxlength="2" value="30">
+    <label class="chk"><input type="checkbox" id="c_numeric"><#RNT_11#></label></div></div>
+  <div class="btns">
+    <button type="button" class="btn primary" id="b_run"><#RNT_12#></button>
+    <button type="button" class="btn ghost" id="b_stop" disabled><#RNT_13#></button>
+    <span class="msg" id="msg"></span>
+  </div>
+</div>
+
+<div class="panel" id="p_graph" style="display:none">
+  <h2><#RNT_14#></h2>
+  <div class="stats" id="stats"></div>
+  <svg class="graph" id="graph" viewBox="0 0 730 180" preserveAspectRatio="none"></svg>
+</div>
+
+<div class="panel" id="p_out">
+  <h2><#RNT_15#></h2>
+  <pre class="out" id="out"></pre>
+</div>
+</div>
+</div>
+
+<script>
+(function(){
+'use strict';
+var q = rp.q, hx = rp.esc;
+var HTTPID = '<% nvram_get("http_id"); %>';   /* reaper_net.cgi is CSRF-gated */
+var timer = null, next = 0, text = '';
+var ERR = {E_TARGET: `<#RNT_16#>`, E_COUNT: `<#RNT_17#>`, E_BUSY: `<#RNT_18#>`};
+
+function msg(t){ var m = q('msg'); m.textContent = t || ''; m.classList.toggle('show', !!t); }
+function tool(){ return q('s_tool').value; }
+function ver(){ var r = document.querySelector('input[name=ver]:checked'); return r ? r.value : '4'; }
+function pill(state){
+  var on = state === 'running';
+  q('statetext').textContent = on ? `<#RNT_19#>` : state === 'done' ? `<#RNT_20#>` : state === 'failed' ? `<#RNT_21#>` : `<#RNT_22#>`;
+  q('statepill').className = 'pill' + (on ? ' on' : '');
+  q('b_run').disabled = on; q('b_stop').disabled = !on;
+}
+function layout(){
+  var t = tool();
+  q('r_ver').classList.toggle('off', t === 'nslookup');
+  q('r_count').classList.toggle('off', t !== 'ping' && t !== 'cping');
+  q('r_hops').classList.toggle('off', t !== 'traceroute');
+  if (t === 'cping' && (+q('i_count').value || 0) < 30) q('i_count').value = '120';
+  if (t === 'ping' && (+q('i_count').value || 0) > 100) q('i_count').value = '5';
+  q('countunit').textContent = t === 'cping' ? `<#RNT_23#>` : '';
+}
+
+/* ---------- ping parsing (busybox: "64 bytes from x: seq=3 ttl=57 time=11.2 ms"; iputils: icmp_seq=) ---------- */
+var PTS = [];   /* {seq, ms} in order received */
+function pingParse(){
+  PTS = [];
+  text.split('\n').forEach(function(l){
+    var m = /(?:icmp_)?seq=(\d+).*?time=([\d.]+)\s*ms/.exec(l);
+    if (m) PTS.push({seq: +m[1], ms: +m[2]});
+  });
+}
+function pingStats(){
+  var n = PTS.length, maxSeq = -1, sum = 0, mn = Infinity, mx = 0, jit = 0, i;
+  for (i = 0; i < n; i++){ var v = PTS[i].ms; sum += v; if (v < mn) mn = v; if (v > mx) mx = v; if (i) jit += Math.abs(v - PTS[i - 1].ms); if (PTS[i].seq > maxSeq) maxSeq = PTS[i].seq; }
+  var sent = maxSeq + 1, sm = /(\d+) packets transmitted/.exec(text); if (sm) sent = +sm[1];
+  return {sent: sent, recv: n, loss: sent > 0 ? Math.round(100 * (sent - n) / sent) : 0, min: n ? mn : 0, avg: n ? sum / n : 0, max: mx, jitter: n > 1 ? jit / (n - 1) : 0};
+}
+function f1(v){ return (Math.round(v * 10) / 10).toFixed(1); }
+function drawGraph(){
+  var s = pingStats(), svg = q('graph'), W = 730, H = 180, P = 22, h = '';
+  q('stats').innerHTML = [[`<#RNT_24#>`, s.recv + ' / ' + s.sent], [`<#RNT_25#>`, s.loss + '%'], ['min', f1(s.min) + ' ms'], ['avg', f1(s.avg) + ' ms'],
+    ['max', f1(s.max) + ' ms'], ['jitter', f1(s.jitter) + ' ms']].map(function(x){ return '<div><div class="k">' + hx(x[0]) + '</div><div class="v">' + hx(x[1]) + '</div></div>'; }).join('');
+  if (!PTS.length){ svg.innerHTML = ''; return; }
+  var top = Math.max(1, Math.ceil(s.max * 1.15)), last = PTS[PTS.length - 1].seq, span = Math.max(10, last + 1), i;
+  for (i = 0; i <= 4; i++){ var y = P + (H - 2 * P) * i / 4; h += '<line class="gr" x1="0" x2="' + W + '" y1="' + y + '" y2="' + y + '"></line><text class="lb" x="4" y="' + (y - 3) + '">' + f1(top * (4 - i) / 4) + ' ms</text>'; }
+  var pts = PTS.map(function(p){ return (W * p.seq / (span - 1)).toFixed(1) + ',' + (H - P - (H - 2 * P) * p.ms / top).toFixed(1); });
+  h += '<polyline class="ln" points="' + pts.join(' ') + '"></polyline>';
+  /* lost replies: a tick on the axis for every missing sequence number */
+  var got = {}; PTS.forEach(function(p){ got[p.seq] = 1; });
+  for (i = 0; i <= last; i++) if (!got[i]) h += '<rect class="ls" x="' + (W * i / (span - 1) - 1).toFixed(1) + '" y="' + (H - P) + '" width="2" height="6"></rect>';
+  svg.innerHTML = h;
+}
+
+/* ---------- runner ---------- */
+function call(params, cb){ rp.net(HTTPID, params, cb); }
+function render(){
+  var box = q('out'), atEnd = box.scrollHeight - box.scrollTop - box.clientHeight < 24;
+  box.textContent = text; if (atEnd) box.scrollTop = box.scrollHeight;
+  var pingish = /^(PING|ping)/.test(text) || PTS.length;
+  q('p_graph').style.display = (tool() === 'cping' || (pingish && tool() === 'ping')) ? '' : 'none';
+  if (q('p_graph').style.display === '') { pingParse(); drawGraph(); }
+}
+function poll(){
+  call('action=get&from=' + next, function(d){
+    if (!d || !d.ok){ return; }
+    if (d.text){ text += d.text; next = d.next; render(); }
+    pill(d.state);
+    if (d.state !== 'running'){ stopTimer();
+      if (d.state === 'done' && d.killed) msg(`<#RNT_26#>`); }
+  });
+}
+function stopTimer(){ if (timer){ clearInterval(timer); timer = null; } }
+function run(){
+  msg('');
+  var t = tool(), target = q('i_target').value.trim(), p = 'action=start&target=' + encodeURIComponent(target);
+  if (!target){ msg(ERR.E_TARGET); q('i_target').focus(); return; }
+  if (t === 'ping' || t === 'cping'){
+    var c = q('i_count').value.trim(), lim = t === 'cping' ? 240 : 100;
+    if (!rp.v.int(c, 1, lim)){ msg(ERR.E_COUNT); q('i_count').focus(); return; }
+    p += '&tool=ping&count=' + c + '&ver=' + ver();
+  } else if (t === 'traceroute'){
+    var hp = q('i_hops').value.trim();
+    if (!rp.v.int(hp, 1, 30)){ msg(ERR.E_COUNT); q('i_hops').focus(); return; }
+    p += '&tool=traceroute&hops=' + hp + '&ver=' + ver() + (q('c_numeric').checked ? '&numeric=1' : '');
+  } else p += '&tool=nslookup';
+  call(p, function(d){
+    if (!d){ msg(`<#RNT_27#>`); return; }
+    if (!d.ok){ msg(ERR[d.error] || d.error || `<#RNT_27#>`); return; }
+    text = ''; next = 0; PTS = []; render(); pill('running');
+    stopTimer(); timer = setInterval(poll, 1000);
+  });
+}
+q('s_tool').addEventListener('change', layout);
+q('b_run').addEventListener('click', run);
+q('b_stop').addEventListener('click', function(){ call('action=cancel', function(){ poll(); }); });
+q('i_target').addEventListener('keydown', function(e){ if (e.key === 'Enter') run(); });
+rp.pingPresets(q('presets'));
+layout();
+/* a run started earlier (another tab, a reload) is shown, not lost */
+call('action=status', function(d){
+  if (!d || !d.ok) { pill('idle'); return; }
+  pill(d.state);
+  if (d.state === 'running' || d.state === 'done'){
+    if (d.target) q('i_target').value = d.target;
+    if (d.tool === 'traceroute' || d.tool === 'nslookup') q('s_tool').value = d.tool;
+    layout();
+    text = ''; next = 0; poll();
+    if (d.state === 'running') timer = setInterval(poll, 1000);
+  }
+});
+})();
+</script>
+</body>
+</html>
diff --git a/release/src/router/www/Reaper_DDNS.asp b/release/src/router/www/Reaper_DDNS.asp
