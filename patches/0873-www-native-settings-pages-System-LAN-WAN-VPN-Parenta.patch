+  if (WIREGUARD) for (n = 1; n <= 5; n++){
+    h += '<div class="c"><span class="n">WireGuard ' + n + '</span><span class="d" title="' + hx(WG[n].desc) + '">' + hx(WG[n].desc || ('Client ' + n)) + '</span>' +
+      (WG[n].en === '1' ? '<span class="tag good">' + hx(`<#CTL_Enabled#>`) + '</span>' : '<span class="tag">' + hx(`<#RVDR_18#>`) + '</span>') +
+      (WG[n].ks === '1' ? '<span class="tag warn">' + hx(`<#RVDR_20#>`) + '</span>' : '') + '</div>';
+  }
+  q('cllist').innerHTML = h;
+}, function(c){});
+
+section('p_rules', function(){
+  RULES = parseList(NV.vpndirector_rulelist);
+  var opts = [['WAN', 'WAN']], n;
+  if (sup('openvpnd')) for (n = 1; n <= 5; n++) opts.push(['OVPN' + n, ifaceName('OVPN' + n)]);
+  if (WIREGUARD) for (n = 1; n <= 5; n++) opts.push(['WGC' + n, ifaceName('WGC' + n)]);
+  q('r_iface').innerHTML = opts.map(function(o){ return '<option value="' + hx(o[0]) + '">' + hx(o[1]) + '</option>'; }).join('');
+  render();
+}, function(c){
+  if (EDITED) c.vpndirector_rulelist = ser(RULES);
+});
+
+function render(){
+  var h = '', order = RULES.map(function(r, i){ return i; }), last = null;
+  /* display grouped by interface; the stored order (and so the posted list) is untouched */
+  order.sort(function(a, b){ var d = groupKey(RULES[a].f[4] || '') - groupKey(RULES[b].f[4] || ''); return d || (a - b); });
+  order.forEach(function(i){
+    var r = RULES[i], f = r.f, ok = f.length === 5, g = ok ? f[4] : '';
+    if (ok && g !== last){ last = g; h += '<tr class="grp"><td colspan="6">' + hx(ifaceName(g)) + (ifaceOff(g) ? ' <span class="tag warn">' + hx(ifaceOff(g)) + '</span>' : '') + '</td></tr>'; }
+    h += '<tr' + (ok ? '' : ' class="dim"') + '>';
+    if (ok) h += '<td class="en"><span class="ensw' + (f[0] === '1' ? ' on' : '') + '" data-i="' + i + '" data-a="tog" title="' + hx(f[0] === '1' ? `<#RVDR_21#>` : `<#RVDR_22#>`) + '"><span class="dot"></span>' + hx(f[0] === '1' ? `<#Reaper_c_on#>` : `<#RVDR_18#>`) + '</span></td>';
+    else h += '<td class="en"><span class="tag warn">' + hx(`<#RVDR_23#>`) + '</span></td>';
+    h += '<td>' + hx(f[1] || '') + '</td><td class="mono">' + hx(f[2] || '') + (ok && !f[2] ? '<span class="tag">' + hx(`<#RVDR_24#>`) + '</span>' : '') + '</td><td class="mono">' + hx(f[3] || '') + (ok && !f[3] ? '<span class="tag">' + hx(`<#RVDR_24#>`) + '</span>' : '') + '</td><td>' + hx(ok ? f[4] : r.raw) + '</td>';
+    h += '<td class="acts">' + (ok ? '<button type="button" class="btn ghost small" data-i="' + i + '" data-a="edit">' + hx(`<#pvccfg_edit#>`) + '</button>' : '') +
+      '<span class="bwldel" data-i="' + i + '" data-a="del" title="' + hx(`<#CTL_del#>`) + '">&times;</span></td></tr>';
+  });
+  q('rtbody').innerHTML = h || '<tr><td colspan="6" class="empty">' + hx(`<#RVDR_25#>`) + '</td></tr>';
+  var b = q('rbudget'), bytes = ser(RULES).length;
+  b.textContent = sub(`<#RVDR_26#>`, RULES.length, MAX_RULES, bytes, MAX_BYTES);
+  b.classList.toggle('hot', RULES.length >= MAX_RULES || bytes > MAX_BYTES * 0.9);
+  q('statetext').textContent = RULES.filter(function(r){ return r.f.length === 5 && r.f[0] === '1'; }).length + ' / ' + RULES.length;
+  q('statepill').className = 'pill' + (RULES.some(function(r){ return r.f.length === 5 && r.f[0] === '1'; }) ? ' on' : '');
+}
+function clearEd(){
+  ['r_desc', 'r_local', 'r_remote'].forEach(function(id){ q(id).value = ''; });
+  q('r_en').checked = true; q('r_iface').value = 'WAN'; editIdx = -1;
+  q('r_save').textContent = `<#CTL_add#>`; show('r_cancel', false); edmsg('');
+}
+function editRow(i){
+  var f = RULES[i].f;
+  editIdx = i;
+  q('r_iface').value = f[4]; if (q('r_iface').value !== f[4]) q('r_iface').selectedIndex = 0;
+  q('r_en').checked = f[0] === '1'; q('r_desc').value = f[1]; q('r_local').value = f[2]; q('r_remote').value = f[3];
+  q('r_save').textContent = `<#CTL_onlysave#>`; show('r_cancel', true); edmsg('');
+  q('r_desc').focus();
+}
+function dup(f, skip){ return RULES.some(function(o, i){ return i !== skip && o.f.length === 5 && o.f[4] === f[4] && o.f[2] === f[2] && o.f[3] === f[3]; }); }
+function saveRule(){
+  var f = [q('r_en').checked ? '1' : '0', val('r_desc'), val('r_local'), val('r_remote'), q('r_iface').value], list;
+  edmsg('');
+  if (!descOk(f[1])) return edmsg(`<#RVDR_27#>`, 'r_desc');
+  if (!addrOk(f[2])) return edmsg(sub(`<#RVDR_28#>`, f[2]), 'r_local');
+  if (!addrOk(f[3])) return edmsg(sub(`<#RVDR_28#>`, f[3]), 'r_remote');
+  if (!/^(WAN|OVPN[1-5]|WGC[1-5])$/.test(f[4])) return edmsg(`<#RVDR_29#>`, 'r_iface');
+  if (dup(f, editIdx)) return edmsg(`<#JS_duplicate#>`, 'r_local');
+  if (editIdx < 0 && RULES.length >= MAX_RULES) return edmsg(`<#JS_itemlimit1#>` + ' ' + MAX_RULES + ' ' + `<#JS_itemlimit2#>`);
+  /* stock B-VPND-4: no selector at all = every address, the router's own traffic included */
+  if ((f[2] === '' || f[2] === '0.0.0.0') && (f[3] === '' || f[3] === '0.0.0.0') && f[0] === '1' && !confirm(sub(`<#RVDR_30#>`, ifaceName(f[4])))){ q('r_local').focus(); return; }
+  list = RULES.slice();
+  if (editIdx >= 0) list[editIdx] = row(f); else list.push(row(f));
+  if (ser(list).length > MAX_BYTES) return edmsg(sub(`<#RVDR_31#>`, ser(list).length, MAX_BYTES));
+  RULES = list; EDITED = true; clearEd(); render(); dirty();
+}
+function tableClick(e){
+  var t = e.target && e.target.closest ? e.target.closest('[data-a]') : null, i, a;
+  if (!t) return;
+  i = parseInt(t.getAttribute('data-i'), 10); a = t.getAttribute('data-a'); if (isNaN(i) || !RULES[i]) return;
+  if (a === 'edit'){ editRow(i); return; }
+  if (a === 'tog'){ var f = RULES[i].f.slice(); f[0] = f[0] === '1' ? '0' : '1'; RULES[i] = row(f); EDITED = true; render(); dirty(); return; }
+  RULES.splice(i, 1); EDITED = true;
+  if (editIdx === i) clearEd(); else if (editIdx > i) editIdx--;
+  render(); dirty();
+}
+
+/* ---------- collect, unsaved changes ---------- */
+function collect(){ var c = {}; SECTIONS.forEach(function(s){ if (!BROKEN[s.panel]) s.collect(c); }); return c; }
+function diff(c){ var ch = {}, k; for (k in c) if (Object.prototype.hasOwnProperty.call(c, k) && String(c[k]) !== String(NV[k] === undefined ? '' : NV[k])) ch[k] = c[k]; return ch; }
+function dirty(){
+  var n; try { n = count(diff(collect())); } catch (e) { return; }
+  rp.pill(n);
+}
+
+/* ---------- apply ---------- */
+function applyAll(){
+  msg('');
+  var changed = diff(collect());
+  if (!count(changed)){ msg(`<#RADM_63#>`); return; }
+  /* rule 14: a rule to a client that is off blocks or bypasses its devices depending on that client's Killswitch */
+  var offs = [];
+  RULES.forEach(function(r){ var f = r.f; if (f.length === 5 && f[0] === '1' && ifaceOff(f[4]) && offs.indexOf(ifaceName(f[4])) < 0) offs.push(ifaceName(f[4]) + ' (' + ifaceOff(f[4]) + ')'); });
+  if (offs.length && !confirm(`<#RVDR_32#>` + '\n- ' + offs.join('\n- '))) return;
+  rp.applying(`<#Reaper_c_applying#>`, `<#RVDR_14#>`);
+  /* rc/services.c vpnrouting dispatch, unit 0: WAN rules, every WireGuard and OpenVPN client's rules, killswitches,
+     exclusive DNS, then reaper_pbr_regen (stock Advanced_VPNDirector.asp used the same script) */
+  rp.post(document.form, changed, 'restart_vpnrouting0', 5);
+}
+
+/* ---------- wiring ---------- */
+function boot(){
+  SECTIONS.forEach(function(s){
+    try { s.init(); }
+    catch (e){
+      BROKEN[s.panel] = 1; var p = q(s.panel); if (p) p.classList.add('broken');
+      if (window.console) console.error('Reaper_VPNDirector: section ' + s.panel + ' failed to load:', e);
+    }
+  });
+  on('applybtn', 'click', applyAll);
+  on('discardbtn', 'click', function(){ location.reload(); });
+  on('r_save', 'click', saveRule);
+  on('r_cancel', 'click', clearEd);
+  on('rtbody', 'click', tableClick);
+  if (!ROUTING){ show('modehint', true); q('applybtn').disabled = true; }
+  /* client addresses for the local field (networkmap list, as stock's picker) */
+  try {
+    ReaperNames.refresh(CUSTOM_CL, function(cl){
+      var dl = q('clients'), ml = (cl && cl.maclist) || [], seen = {}, h = '';
+      ml.forEach(function(mac){ var c = cl[mac]; if (!c || !c.ip || seen[c.ip]) return; seen[c.ip] = 1;
+        h += '<option value="' + hx(c.ip) + '">' + hx(ReaperNames.byMac(mac, mac)) + '</option>'; });
+      dl.innerHTML = h;
+    });
+  } catch (e) {}
+  dirty();
+  rp.tips();
+}
+boot();
+})();
+</script>
+</body>
+</html>
