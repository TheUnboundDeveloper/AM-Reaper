diff --git a/release/src/router/www/Reaper_Netstat.asp b/release/src/router/www/Reaper_Netstat.asp
new file mode 100644
index 0000000000..f2e72fa5ef
--- /dev/null
+++ b/release/src/router/www/Reaper_Netstat.asp
@@ -0,0 +1,148 @@
+<!-- SPDX-License-Identifier: GPL-2.0-only
+     Copyright (C) 2026 the Reaper project maintainer
+     Part of the Reaper hardened Asuswrt-Merlin build. See LICENSE / LICENSE.reaper. -->
+<!DOCTYPE html>
+<html lang="en">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width, initial-scale=1">
+<meta name="reaper-native" content="1">
+<title>REAPER &mdash; Netstat</title>
+<!-- Reaper_Netstat.asp - Network Tools > Netstat (Reaper-native UI, Network Tools wave, 2026-10-23).
+     Replaces Main_Netstat_Content.asp (ROG_UI copy on netool.cgi). The router's own sockets through
+     reaper_net.cgi tool=netstat: the page sends an option bitmask (1 listening, 2 all, 4 numeric, 8 TCP, 16 UDP,
+     32 RAW, 64 UNIX, 128 routes, 256 program) and the server maps it to fixed busybox netstat letters. The
+     netstat-nat view is not repeated here: NAT / tracked connections live on the Connections page (Reaper_Conn),
+     the routing table on Routing Table (Reaper_Routes). Internet sockets are shown as a sortable table. -->
+<link rel="stylesheet" href="/reaper/rp.css">
+<style>
+.opts{display:flex;gap:14px;flex-wrap:wrap}
+.btns{display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin-top:14px}
+.btns input[type=text]{background:#000;border:1px solid var(--line-soft);border-radius:8px;color:var(--bone);font-family:var(--body);font-size:13px;padding:8px 10px;outline:none;width:220px}
+.msg{font-size:12.5px;color:var(--amber);display:none} 
+.rtab th{font-family:var(--hdr);font-weight:600;font-size:10.5px;letter-spacing:.14em;text-transform:uppercase;color:var(--steel);text-align:left;padding:7px 8px;border-bottom:1px solid var(--line-soft);cursor:pointer;user-select:none;white-space:nowrap}
+.rtab th:hover,.rtab th.on{color:var(--bone)}
+.rtab th .dir{display:inline-block;width:10px;margin-left:3px}
+.rtab td{padding:6px 8px;border-bottom:1px solid var(--line-soft);color:var(--bone-dim);font-family:var(--mono);word-break:break-all}
+.out{background:#000;border:1px solid var(--line-soft);border-radius:10px;color:var(--bone-dim);font-family:var(--mono);font-size:12px;line-height:1.5;padding:10px 12px;margin:0;max-height:46vh;overflow:auto;white-space:pre-wrap;word-break:break-all}
+.empty{color:var(--steel);font-size:12.5px;padding:8px 0}
+</style>
+</head>
+<body>
+<script src="/reaper_util.js"></script>
+<script src="/reaper/rp.js"></script>
+
+<div class="syswrap">
+<div class="pagehead">
+  <div>
+    <div class="eyebrow"><#Network_Tools#></div>
+    <h1>Netstat</h1>
+  </div>
+  <span class="pill" id="statepill"><span class="dot"></span><span id="statetext"></span></span>
+  <div class="spacer"></div>
+</div>
+<div class="hint" style="margin:-4px 0 14px"><#RNT_28#> <a class="link" href="/reaper_shell.asp#Reaper_Conn.asp" target="_top"><#Connections#></a></div>
+
+<div class="rframe">
+<div class="panel" id="p_opts">
+  <h2><#RNT_29#></h2>
+  <div class="opts">
+    <label class="chk"><input type="radio" name="scope" value="1" checked><#sockets_listening#></label>
+    <label class="chk"><input type="radio" name="scope" value="2"><#sockets_all#></label>
+  </div>
+  <div class="opts" style="margin-top:10px">
+    <label class="chk"><input type="checkbox" class="o" value="8" checked>TCP</label>
+    <label class="chk"><input type="checkbox" class="o" value="16" checked>UDP</label>
+    <label class="chk"><input type="checkbox" class="o" value="32">RAW</label>
+    <label class="chk"><input type="checkbox" class="o" value="64">UNIX</label>
+    <label class="chk"><input type="checkbox" class="o" value="256" checked><#RNT_30#></label>
+    <label class="chk"><input type="checkbox" class="o" value="4" checked><#RNT_31#></label>
+  </div>
+  <div class="btns">
+    <button type="button" class="btn primary" id="b_run"><#RNT_12#></button>
+    <input type="text" id="find" placeholder="<#CTL_search#>" autocomplete="off">
+    <span class="msg" id="msg"></span>
+  </div>
+</div>
+<div class="panel" id="p_res">
+  <h2><#RNT_15#></h2>
+  <div id="table"></div>
+  <pre class="out" id="out" style="display:none"></pre>
+</div>
+</div>
+</div>
+
+<script>
+(function(){
+'use strict';
+var q = rp.q, hx = rp.esc;
+var HTTPID = '<% nvram_get("http_id"); %>';   /* reaper_net.cgi is CSRF-gated */
+var timer = null, next = 0, text = '', SORT = {k: 'local', dir: 1};
+
+function msg(t){ var m = q('msg'); m.textContent = t || ''; m.classList.toggle('show', !!t); }
+function pill(state){
+  var on = state === 'running';
+  q('statetext').textContent = on ? `<#RNT_19#>` : state === 'done' ? `<#RNT_20#>` : state === 'failed' ? `<#RNT_21#>` : `<#RNT_22#>`;
+  q('statepill').className = 'pill' + (on ? ' on' : ''); q('b_run').disabled = on;
+}
+function call(params, cb){ rp.net(HTTPID, params, cb); }
+/* internet socket lines: Proto Recv-Q Send-Q Local Foreign [State] [PID/Program] */
+var COLS = [['proto', 'Proto'], ['local', `<#RNT_32#>`], ['foreign', `<#RNT_33#>`], ['state', `<#RNT_34#>`], ['prog', `<#RNT_30#>`]];
+function rows(){
+  var out = [];
+  text.split('\n').forEach(function(l){
+    var w = l.trim().split(/\s+/);
+    if (!/^(tcp|udp|raw)6?$/.test(w[0]) || w.length < 5) return;
+    var isTcp = /^tcp/.test(w[0]), state = isTcp ? (w[5] || '') : '', prog = w.slice(isTcp ? 6 : 5).join(' ');
+    out.push({proto: w[0], local: w[3], foreign: w[4], state: state, prog: prog});
+  });
+  return out;
+}
+function draw(){
+  var list = rows(), f = q('find').value.trim().toLowerCase();
+  var other = text.split('\n').filter(function(l){ return l && !/^(tcp|udp|raw)6?\s/.test(l.trim()) && !/^(Active Internet|Proto )/.test(l.trim()); });
+  if (f) list = list.filter(function(r){ return (r.proto + ' ' + r.local + ' ' + r.foreign + ' ' + r.state + ' ' + r.prog).toLowerCase().indexOf(f) >= 0; });
+  if (list.length){
+    var cmp = rp.cmp('text');
+    list.sort(function(a, b){ return SORT.dir * cmp(a[SORT.k], b[SORT.k]); });
+    var h = '<table class="rtab"><thead><tr>' + COLS.map(function(c){ return '<th data-k="' + c[0] + '"' + (c[0] === SORT.k ? ' class="on"' : '') + '>' + hx(c[1]) +
+      '<span class="dir">' + (c[0] === SORT.k ? (SORT.dir > 0 ? '&#9650;' : '&#9660;') : '') + '</span></th>'; }).join('') + '</tr></thead><tbody>';
+    list.forEach(function(r){ h += '<tr>' + COLS.map(function(c){ return '<td>' + hx(r[c[0]] || '-') + '</td>'; }).join('') + '</tr>'; });
+    q('table').innerHTML = h + '</tbody></table>';
+  } else q('table').innerHTML = text ? '<div class="empty">' + hx(`<#RNT_35#>`) + '</div>' : '';
+  /* UNIX sockets and anything else netstat prints stay as text */
+  var o = q('out'); o.style.display = other.length > 1 ? '' : 'none';
+  o.textContent = other.filter(function(l){ return !f || l.toLowerCase().indexOf(f) >= 0; }).join('\n');
+}
+function poll(){
+  call('action=get&from=' + next, function(d){
+    if (!d || !d.ok) return;
+    if (d.text){ text += d.text; next = d.next; }
+    pill(d.state); draw();
+    if (d.state !== 'running' && timer){ clearInterval(timer); timer = null; }
+  });
+}
+function run(){
+  msg('');
+  var opts = +document.querySelector('input[name=scope]:checked').value;
+  Array.prototype.forEach.call(document.querySelectorAll('input.o'), function(c){ if (c.checked) opts |= +c.value; });
+  call('action=start&tool=netstat&opts=' + opts, function(d){
+    if (!d){ msg(`<#RNT_27#>`); return; }
+    if (!d.ok){ msg(d.error === 'E_BUSY' ? `<#RNT_18#>` : (d.error || `<#RNT_27#>`)); return; }
+    text = ''; next = 0; draw(); pill('running');
+    if (timer) clearInterval(timer);
+    timer = setInterval(poll, 1000);
+  });
+}
+q('table').addEventListener('click', function(e){
+  var th = e.target.closest ? e.target.closest('th[data-k]') : null; if (!th) return;
+  var k = th.getAttribute('data-k'); SORT = {k: k, dir: SORT.k === k ? -SORT.dir : 1}; draw();
+});
+q('b_run').addEventListener('click', run);
+q('find').addEventListener('input', draw);
+pill('idle');
+run();
+})();
+</script>
+</body>
+</html>
