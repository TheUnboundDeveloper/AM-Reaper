+
+/* ---------- the poll ---------- */
+var POLL_KEYS = ['vpn_server1_state', 'vpn_server1_errno', 'vpn_server2_state', 'vpn_server2_errno', 'vpn_clientx_eas', 'wgs1_enable', 'ipsec_server_enable', 'pptpd_enable'];
