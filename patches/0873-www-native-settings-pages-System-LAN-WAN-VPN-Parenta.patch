+  x.onerror = function(){ setTimeout(pollDdns, 6000); };
+  try { x.send(); } catch (e) {}
+}
+
+/* ---------- certificate details (stock show_cert_details) ---------- */
+function certInfo(ci){
+  ci = ci || {};
+  var have = ci.issueTo && ci.issueBy && ci.expire, st;
+  if (have){
+    if (NV.le_enable === '1' && LE.state === '0') st = String(ci.issueBy).indexOf("Let's Encrypt") === -1 ? `<#vpn_openvpn_KC_Authorizing#>` : `<#upgrade_processing#>`;
+    else st = `<#Status_Active#>`;
+  } else st = (LE.aux === '5' && LE.sb === '7') ? `<#RDDN_32#>` : `<#RDDN_33#>`;
+  q('c_status').textContent = st;
+  q('c_to').textContent = ci.issueTo || '-'; q('c_by').textContent = ci.issueBy || '-'; q('c_exp').textContent = ci.expire || '-';
+  q('ca_to').textContent = ci.CAissueTo || '-'; q('ca_by').textContent = ci.CAissueBy || '-'; q('ca_exp').textContent = ci.CAexpire || '-';
+  return !have || (NV.le_enable === '1' && LE.state === '0');
+}
+/* stock polled /ajax_certinfo.asp every second while Let's Encrypt was authorising; parsed here, never evaluated */
+var cpolls = 0;
+function pollCert(){
+  if (cpolls++ > 60) return;
+  var x = new XMLHttpRequest();
+  x.open('GET', '/ajax_certinfo.asp?_=' + Date.now(), true);
+  x.onload = function(){
+    var t = String(x.responseText || ''), m = /httpd_cert_info\s*=\s*\[(\{[\s\S]*?\})\]/.exec(t), s = /le_state\s*=\s*'([^'\n]*)'/.exec(t), ci = null;
+    try { ci = m ? JSON.parse(m[1]) : null; } catch (e) { ci = null; }
+    if (s) LE.state = s[1];
+    if (certInfo(ci || CERT)) setTimeout(pollCert, 2000);
+  };
+  x.onerror = function(){ setTimeout(pollCert, 4000); };
+  try { x.send(); } catch (e) {}
+}
+
+/* ---------- certificate upload: upload_cert_key.cgi stores the files; Apply runs prepare_cert to use them ---------- */
+var UPLOADED = false;
+function upload(){
+  var k = q('f_key').value, c = q('f_cert').value, ke = k.slice(k.lastIndexOf('.') + 1).toLowerCase(), ce = c.slice(c.lastIndexOf('.') + 1).toLowerCase();
+  note('uplnote', '');
+  /* stock check_filename */
+  if (ke !== 'pem' && ke !== 'key'){ note('uplnote', `<#DDNS_https_key_alert#>`); return; }
+  if (ce !== 'pem' && ce !== 'crt' && ce !== 'cer'){ note('uplnote', `<#DDNS_https_cert_alert#>`); return; }
+  q('upload_form').submit();
+  UPLOADED = true; q('s_cert').value = '2';
+  note('uplnote', `<#RDDN_34#>`);
+  sync(); dirty();
+}
+
+/* ---------- collect, unsaved changes ---------- */
+function collect(){ var c = {}; SECTIONS.forEach(function(s){ if (!BROKEN[s.panel]) s.collect(c); }); return c; }
+function diff(c){
+  var changed = {}, k, was;
+  for (k in c){
+    if (!Object.prototype.hasOwnProperty.call(c, k)) continue;
+    was = String(NV[k] === undefined ? '' : NV[k]);
+    if (was === '' && c[k] === '0' && SWITCHES[k]) continue;
+    if (String(c[k]) !== was) changed[k] = c[k];
+  }
+  return changed;
+}
+function dirty(){
+  var changed, n;
+  try { changed = diff(collect()); } catch (e) { return; }
+  n = count(changed) + (UPLOADED && changed.le_enable === undefined ? 1 : 0);
+  rp.pill(n);
+}
+function statePill(){
+  var on = NV.ddns_enable_x === '1';
+  q('statetext').textContent = !on ? `<#RDDN_35#>` : (ASUS_SAVED || !NV.ddns_server_x) ? `<#RDDN_36#>` : (NV.ddns_hostname_x || NV.ddns_server_x);
+  q('statepill').className = 'pill' + (savedOn() ? ' on' : '');
+}
+
+/* ---------- validate (stock validForm) ---------- */
+function validate(c, changed){
+  var R = rules(), v = server(), k, ddns = false;
+  function bad(id, m){
+    var el = q(id), row = el && el.closest ? el.closest('.frow') : null;
+    if (row){ row.classList.add('bad'); setTimeout(function(){ row.classList.remove('bad'); }, 6000); }
+    if (el && el.focus) el.focus();
+    return m;
+  }
+  for (k in changed) if (/^ddns_/.test(k)) ddns = true;
+  if (q('t_ddns').checked && ddns){
+    if (v === '') return bad('s_server', `<#LANHostConfig_x_DDNS_alarm_server#>`);
+    if (!rp.v.int(val('i_refresh'), 0, 365)) return bad('i_refresh', `<#RDDN_37#>`);
+    if (R.period && !rp.v.int(val('i_period'), 30, 99999)) return bad('i_period', `<#period_time_validation#>` + ' 30');
+    if (v !== 'CUSTOM'){
+      if (R.host){
+        if (val('i_host') === '') return bad('i_host', `<#LANHostConfig_x_DDNS_alarm_14#>`);
+        if (!strOk(val('i_host'))) return bad('i_host', `<#RDDN_38#>`);
+      }
+      if (R.user){
+        if (v !== 'DNS.HE.NET' && val('i_user') === '') return bad('i_user', `<#QKSet_account_nameblank#>`);
+        if (!strOk(val('i_user'))) return bad('i_user', `<#RDDN_38#>`);
+      }
+      if (R.pass){
+        if (q('i_pass').value === '' && !PASS_SET) return bad('i_pass', `<#File_Pop_content_alert_desc6#>`);
+        if (q('i_pass').value !== '' && !strOk(q('i_pass').value)) return bad('i_pass', `<#RDDN_38#>`);
+      }
+    }
+  }
+  return '';
+}
+
+/* ---------- apply: the stock submitForm scripts (rc/services.c handle_notifications) ---------- */
+function plan(changed){
+  var ddns = false, k, S = [], wait = 5;
+  for (k in changed) if (/^ddns_/.test(k)) ddns = true;
+  var cert = changed.le_enable !== undefined || UPLOADED, le = (changed.le_enable !== undefined ? changed.le_enable : NV.le_enable) === '1';
+  var on = q('t_ddns').checked;
+  if (on && le && (ddns || cert)){
+    /* "ddns_le": stop_ddns + start_ddns with the inadyn cache removed (Let's Encrypt runs inside the DDNS client);
+       "prepare_cert": prepare_cert_in_etc(), httpd reloads it after the current session (httpds_reload_cert=2) */
+    S = ['restart_ddns_le', 'prepare_cert']; wait = 10;
+  } else {
+    /* "ddns": stop_ddns + start_ddns + update_srv_cert_if_ddns_changed() */
+    if (ddns) S.push('restart_ddns');
+    if (cert && HTTP_ENABLE !== '0'){
+      S.push('prepare_cert'); wait = 10;
+      if (NV.le_enable === '1') S.push('restart_ddns_le');   /* leaving Let's Encrypt: stock restarted its client too */
+    }
+  }
+  /* FTP over TLS serves the same certificate: stock appended prepare_cert;restart_ftpd to every save */
+  if (FTP_TLS && S.length){ if (S.indexOf('prepare_cert') < 0) S.push('prepare_cert'); S.push('restart_ftpd'); wait = 10; }
+  return {script: S.length ? S.join(';') : 'saveNvram', wait: S.length ? wait : 1, cert: cert, ddns: ddns};
+}
+function applyAll(){
+  msg('');
+  var c = collect(), changed = diff(c), err = validate(c, changed), p;
+  if (err){ msg(err); return; }
+  if (!count(changed) && !UPLOADED){ msg(`<#RADM_63#>`); return; }
+  /* stock: switching to Let's Encrypt without its terms box falls back to the self-signed certificate */
+  if (changed.le_enable === '1' && !q('c_leterms').checked){
+    if (!confirm(`<#LANHostConfig_x_DDNSLetsEncrypt_Disagree#>`)) return;
+    q('s_cert').value = '0'; certSync(); c = collect(); changed = diff(c);
+    if (!count(changed) && !UPLOADED){ msg(`<#RADM_63#>`); return; }
+  }
+  p = plan(changed);
+  if (p.cert && p.script.indexOf('prepare_cert') !== -1 && !confirm(`<#RDDN_39#>`)) return;
+  /* stock check_update: same server, host and address as the last update - ask before forcing another */
+  if (p.ddns && q('t_ddns').checked && DDNS_UPDATED === '1' && WAN_IP && WAN_IP === DDNS_IP.replace(/&#10/g, '')
+      && changed.ddns_server_x === undefined && changed.ddns_hostname_x === undefined && !confirm(`<#LANHostConfig_x_DDNS_update_confirm#>`)) return;
+  rp.applying(`<#Reaper_c_applying#>`, p.cert ? `<#RDDN_40#>` : `<#RDDN_14#>`);
+  rp.post(document.form, changed, p.script, p.wait);
+}
+/* stock's manual update (onSubmitApply ddnsclient) as an apply that posts no setting */
+function updateNow(){
+  msg('');
+  if (q('chgcount').textContent !== '0'){ msg(`<#RDDN_41#>`); return; }
+  var p = NV.le_enable === '1' ? 'restart_ddns_le;prepare_cert' : 'restart_ddns';
+  rp.applying(`<#Reaper_c_applying#>`, `<#RDDN_14#>`);
+  rp.post(document.form, {}, p, 5);
+}
+
+/* ---------- wiring ---------- */
+function boot(){
+  SECTIONS.forEach(function(s){
+    try { s.init(); }
+    catch (e){
+      BROKEN[s.panel] = 1; var p = q(s.panel); if (p) p.classList.add('broken');
+      if (window.console) console.error('Reaper_DDNS: section ' + s.panel + ' failed to load:', e);
+    }
+  });
+  on('applybtn', 'click', applyAll);
+  on('discardbtn', 'click', function(){ location.reload(); });
+  ['t_ddns', 's_server', 't_check', 's_cert'].forEach(function(id){ on(id, 'change', sync); });
+  on('b_update', 'click', updateNow);
+  on('b_upload', 'click', upload);
+  on('b_exp_srv', 'click', function(){ location.href = 'cert_key.tar'; });
+  on('b_exp_ca', 'click', function(){ location.href = 'cacert_key.tar'; });
+  document.addEventListener('input', dirty); document.addEventListener('change', dirty);
+  sync(); dirty();
+  setTimeout(pollDdns, 1500);
+  if (!BROKEN.p_cert && sup('HTTPS') && certInfo(CERT)) setTimeout(pollCert, 2000);
+  rp.tips();
+}
+boot();
+})();
+</script>
+</body>
+</html>
