+<script src="/reaper/rp.js"></script>
+<script>
+(function(){
+/* 2026-10-21 Encrypted DNS for devices: the switch (nvram reaper_dot_srv, this form ->
+   restart_rednsd) and rednsd's status (reaper_encdns.cgi, behind the http_id gate). The
+   per-device instructions are filled with the live values - the certificate's name and
+   the router's address - so nothing has to be looked up. Everything the router reports
+   is rendered with textContent.
+   Review 2026-10-24 (Q-C2-12): one closure, no page globals; the controls are wired below with
+   addEventListener, never with inline on*= attributes. */
+var HID = '<% nvram_get("http_id"); %>';
+var NV = {
+  on:   '<% nvram_get("reaper_dot_srv"); %>',
+  blk:  '<% nvram_get("reaper_doh_block"); %>',
+  lan:  '<% nvram_get("lan_ipaddr"); %>',
+  ddns: decodeURIComponent('<% nvram_char_to_ascii("", "ddns_hostname_x"); %>'),
+  ssid: [decodeURIComponent('<% nvram_char_to_ascii("", "wl0_ssid"); %>'), decodeURIComponent('<% nvram_char_to_ascii("", "wl1_ssid"); %>'),
+         decodeURIComponent('<% nvram_char_to_ascii("", "wl2_ssid"); %>'), decodeURIComponent('<% nvram_char_to_ascii("", "wl3_ssid"); %>')]
+};
+var LINK_DIRECTOR = ['/reaper_shell.asp#Reaper_DNS.asp?tab=dd', `<#Reaper_c_dns_director#>`];
+var LINK_CERT = ['/reaper_shell.asp#Reaper_DDNS.asp', `<#menu5_3#> > <#menu5_3_6#>`];
+var curName = '', curTrusted = false;
+var $ = rp.q;
+function encTg(el){ el.className = (el.className.indexOf('on') >= 0) ? 'tg' : 'tg on'; }
+function encNum(n){ return Number(n||0).toLocaleString(); }
+/* fill el with text whose %1 becomes a link (href, label) or a code chip (label only) */
+function encFill(el, text, href, label){
+  var parts = String(text).split('%1'), mid;
+  el.textContent = '';
+  el.appendChild(document.createTextNode(parts[0]));
+  if(parts.length > 1){
+    if(href){ mid = document.createElement('a'); mid.href = href; mid.target = '_top'; }
+    else mid = document.createElement('code');
+    mid.textContent = label;
+    el.appendChild(mid);
+    el.appendChild(document.createTextNode(parts.slice(1).join('%1')));
+  }
+}
+/* the name devices should use: the DDNS name when the certificate covers it, else its first plain name */
+function encPickName(c){
+  var names = (c && c.names) || [], i, n, dd = String(NV.ddns||'').toLowerCase();
+  for(i = 0; i < names.length; i++){
+    n = String(names[i]).toLowerCase();
+    if(n === dd || (n.indexOf('*.') === 0 && dd.slice(dd.indexOf('.')) === n.slice(1) && dd.indexOf('.') > 0)) return dd;
+  }
+  for(i = 0; i < names.length; i++) if(String(names[i]).indexOf('*') < 0) return String(names[i]);
+  return (c && c.cn) ? String(c.cn) : '';
+}
+function encRender(j){
+  var st = j && j.st, running = !!(j && j.running && st && st.state === 'running');
+  var pill = $('pill');
+  pill.className = 'statuspill' + (running ? '' : ' off');
+  pill.textContent = running ? `<#RENC_04#>` : `<#RENC_05#>`;
+  var why = $('why'), wt = '';
+  if(NV.on === '1' && !running){
+    var W = {no_cert:`<#RENC_39#>`, cert_error:`<#RENC_40#>`, bind_error:`<#RENC_41#>`};
+    wt = (st && W[st.state]) ? W[st.state] : `<#RENC_46#>`;
+  }
+  $('whytext').textContent = wt; why.style.display = wt ? 'flex' : 'none';
+  $('s_conns').textContent = running ? encNum(st.conns) : '\u2014';
+  $('s_queries').textContent = running ? encNum(st.queries) : '\u2014';
+  $('s_refused').textContent = running ? encNum((st.refused_peer||0) + (st.refused_policy||0) + (st.refused_busy||0)) : '\u2014';
+
+  /* certificate */
+  var c = (st && st.cert) || null, now = Date.now() / 1000, cs = $('c_state');
+  curName = c ? encPickName(c) : '';
+  curTrusted = !!(c && c.trusted && !(c.not_after && c.not_after < now));
+  $('c_name').textContent = curName || '\u2014';
+  $('c_issuer').textContent = (c && c.issuer) ? c.issuer : '\u2014';
+  $('c_until').textContent = (c && c.not_after) ? new Date(c.not_after * 1000).toLocaleDateString() : '\u2014';
+  if(!c || c.error){ cs.textContent = ''; }
+  else if(c.not_after && c.not_after < now){ cs.className = 'certstate bad'; encFill(cs, `<#RENC_34#>`, LINK_CERT[0], LINK_CERT[1]); }
+  else if(c.trusted){ cs.className = 'certstate good'; cs.textContent = `<#RENC_31#>`; }
+  else if(c.self_signed){ cs.className = 'certstate bad'; encFill(cs, `<#RENC_32#>`, LINK_CERT[0], LINK_CERT[1]); }
+  else { cs.className = 'certstate bad'; encFill(cs, `<#RENC_33#>`, LINK_CERT[0], LINK_CERT[1]); }
+
+  /* where it answers */
+  var ul = $('listen'); ul.textContent = '';
+  ((st && st.listen) || []).forEach(function(l){
+    var li = document.createElement('li'), code = document.createElement('code');
+    li.className = l.ok ? 'good' : 'gap';
+    code.textContent = l.a + (l.p !== 853 ? ':' + l.p : '');
+    li.appendChild(code);
+    if(l.wan){ var s = document.createElement('span'); s.className = 'dim'; s.textContent = ' \u2014 ' + `<#RENC_36#>`; li.appendChild(s); }
+    if(!l.ok){ var e = document.createElement('span'); e.className = 'dim'; e.textContent = ' \u2014 ' + `<#RENC_37#>`; li.appendChild(e); }
+    ul.appendChild(li);
+  });
+  if(!ul.firstChild){ var d = document.createElement('li'); d.className = 'dim'; d.textContent = '\u2014'; ul.appendChild(d); }
+  $('wanpriv').style.display = (j && j.wan_private && curTrusted) ? '' : 'none';
+
+  /* per device, with the live values */
+  encFill($('d_android'), `<#RENC_17#>`, null, curTrusted && curName ? curName : `<#RENC_26#>`);
+  $('appledl').disabled = !(curTrusted && curName);
+  $('d_apple_need').style.display = (curTrusted && curName) ? 'none' : '';
+  $('d_linux').textContent = (curTrusted && curName) ? 'DNS=' + NV.lan + '#' + curName + '\nDNSOverTLS=yes' : '\u2014';
+  $('d_linux_need').style.display = (curTrusted && curName) ? 'none' : '';
+
+  /* 2026-10-21: block encrypted DNS that goes around the router */
+  var b = (j && j.blk) || null, on = !!(b && b.on), D = String.fromCharCode(8212), fd = $('b_feed');
