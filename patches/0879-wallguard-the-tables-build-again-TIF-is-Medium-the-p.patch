+	   * way, as before. */
+	  "exec 9>/tmp/rwarden/ctr.lock; _w=25; while ! flock -n 9 2>/dev/null && [ $_w -gt 0 ]; do _w=$((_w-1)); usleep 200000; done\n"
 	  "NOW=$(date +%s)\n"
 	  "mkdir -p \"$DIR\" 2>/dev/null\n"
 	  "# one-time migration from the v2.2.1 single-value baseline (no per-country\n"
@@ -1870,7 +1873,8 @@ static void rw_gen_stats(void)
 	   * synchronously in its single process, so every second waited here is a
 	   * second the whole GUI is frozen; a checkpoint holding the exclusive lock
 	   * that long is the rare case, and a one-tick dip beats a dead page. */
-	  "exec 9>/tmp/rwarden/ctr.lock; flock -w 2 -s 9 2>/dev/null\n"
+	  /* 2026-10-26: shared, at most 2 s, polled (busybox flock has no -w) */
+	  "exec 9>/tmp/rwarden/ctr.lock; _w=10; while ! flock -s -n 9 2>/dev/null && [ $_w -gt 0 ]; do _w=$((_w-1)); usleep 200000; done\n"
 	  "BASE=0; SINCE=0\n"
 	  "if [ \"$SV\" = 1 ] && [ -f \"$CTR\" ]; then\n"
 	  "  BASE=$(awk '$1==\"TOTAL\"{print $2+0; exit}' \"$CTR\" 2>/dev/null); [ -n \"$BASE\" ] || BASE=0\n"
@@ -2009,7 +2013,7 @@ static void rw_gen_dns(void)
 	  "# dnsmasq could not write: its 50-a-second / 256 KB bounds); the raw records go to a 500-line tmpfs log.\n"
 	  "# Writes /jffs only when there is something new, or the Warden retention interval has passed.\n"
 	  "dfold() {\n"
-	  "  exec 8>$LOCK; flock -w 5 8 2>/dev/null\n"
+	  "  exec 8>$LOCK; _w=25; while ! flock -n 8 2>/dev/null && [ $_w -gt 0 ]; do _w=$((_w-1)); usleep 200000; done\n"
 	  "  NOW=$(date +%s)\n"
 	  "  mkdir -p \"${DCTR%/*}\" 2>/dev/null\n"
 	  "  case \"$(_nv rwarden_reset)\" in 24h) IV=86400;; 7d) IV=604800;; 30d) IV=2592000;; 90d) IV=7776000;; *) IV=0;; esac\n"
@@ -2088,7 +2092,7 @@ static void rw_gen_dns(void)
 	  "      }' \"$_O\" \"$_R\"\n"
 	  "}\n"
 	  "dreset() {\n"
-	  "  exec 8>$LOCK; flock -w 5 8 2>/dev/null\n"
+	  "  exec 8>$LOCK; _w=25; while ! flock -n 8 2>/dev/null && [ $_w -gt 0 ]; do _w=$((_w-1)); usleep 200000; done\n"
 	  "  mkdir -p \"${DCTR%/*}\" 2>/dev/null\n"
 	  "  echo \"SINCE $(date +%s)\" > \"$DCTR.tmp\" && mv -f \"$DCTR.tmp\" \"$DCTR\"\n"
 	  "  rm -f \"$REC\" \"$HF\"\n"
