+/* ---------- saved exclusions (/jffs/reaper/logfilter through reaper_logf.cgi) ---------- */
+function lfReq(method, params, cb){
+  var x = new XMLHttpRequest(), f = new URLSearchParams(), done = false, k;
+  f.append('http_id', HID);
+  for (k in params) f.append(k, params[k]);
+  function fin(j){ if (!done){ done = true; cb(j); } }
+  x.open(method, '/reaper_logf.cgi' + (method === 'GET' ? '?' + f.toString() + '&_=' + Date.now() : ''), true);
+  if (method === 'POST') x.setRequestHeader('Content-Type', 'application/x-www-form-urlencoded');
+  x.timeout = 12000;
+  x.onload = function(){ var j = null; if (x.status === 200){ try { j = JSON.parse(x.responseText); } catch (e) {} } fin(j); };
+  x.onerror = x.ontimeout = function(){ fin(null); };
+  try { x.send(method === 'POST' ? f.toString() : null); } catch (e) { fin(null); }
+}
+/* one entry per line, trimmed; blanks and repeats (any case) dropped */
+function lfList(text){
+  var seen = {}, out = [];
+  String(text).split(/\r?\n/).forEach(function(s){ s = s.trim(); var k = s.toLowerCase(); if (s && !seen[k]){ seen[k] = 1; out.push(s); } });
+  return out;
+}
+function lfLoad(){
+  lfReq('GET', {action: 'get'}, function(j){
+    if (!j || !j.ok){ msg('lfmsg', `<#RLOG_101#>`); return; }
+    if (j.max > 0) LFMAX = j.max;
+    if (j.len > 0) LFLEN = j.len;
+    SAVED = lfList(j.list || ''); q('t_lf').value = SAVED.join('\n'); render();
+  });
+}
+function lfSave(list, done){
+  msg('lfmsg', '');
+  if (list.length > LFMAX || list.some(function(s){ return s.length > LFLEN || /[^\x20-\x7e]/.test(s); })){ msg('lfmsg', `<#RLOG_98#>`); return; }
+  q('b_lfsave').disabled = q('b_lfadd').disabled = true;
+  lfReq('POST', {action: 'set', list: list.join('\n')}, function(j){
+    q('b_lfsave').disabled = q('b_lfadd').disabled = false;
+    if (!j || !j.ok){ msg('lfmsg', (j && j.ek === 'RLOG_98') ? `<#RLOG_98#>` : (j && /^RDEVE_1/.test(j.ek || '')) ? `<#RDEVE_1#>` : `<#RLOG_99#>`); return; }
+    SAVED = list; q('t_lf').value = list.join('\n');
+    if (done) done();
+    msg('lfmsg', `<#RLOG_97#>`.replace('%1', list.length)); render();
+  });
+}
+/* the Exclude box's words join the saved list in one step */
