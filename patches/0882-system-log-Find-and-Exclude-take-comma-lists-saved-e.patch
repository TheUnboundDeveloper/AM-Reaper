 	{ "reaper_wallguard.cgi*", "application/json", no_cache_IE7, do_html_post_and_get, do_reaper_wallguard_cgi, do_auth },	/* 2026-10-21 Wallguard */
+	{ "reaper_logf.cgi*", "application/json", no_cache_IE7, do_html_post_and_get, do_reaper_logf_cgi, do_auth },	/* 2026-10-26 System Log exclusions */
 	{ "reaper_fw.cgi*", "application/json", no_cache_IE7, do_html_post_and_get, do_reaper_fw_cgi, do_auth },
 	{ "reaper_watch.cgi*", "application/json", no_cache_IE7, do_html_post_and_get, do_reaper_watch_cgi, do_auth },
