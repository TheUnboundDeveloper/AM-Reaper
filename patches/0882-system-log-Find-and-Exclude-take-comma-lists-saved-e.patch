+/* reaper 2026-10-26: the System Log page's saved exclusions (Reaper_Log.asp) - Reaper's
+ * own logFilter.json. Stock's /www/ajax/logFilter.json is part of the read-only image, so a
+ * user could never add to it. One pattern per line in /jffs/reaper/logfilter (plain text,
+ * editable over SSH as well); the page hides a System log line that contains any of them,
+ * upper and lower case alike. Only the view: the log file, Save (syslog.txt) and a remote
+ * syslog server still get every line. */
+#define RLOGF_FILE	"/jffs/reaper/logfilter"
+#define RLOGF_MAX	64	/* patterns */
+#define RLOGF_LINE	128	/* bytes in one pattern */
+#define RLOGF_BYTES	(RLOGF_MAX * (RLOGF_LINE + 1))
+
+/* 0 when v is a list the page may save: printable ASCII, one pattern per line, bounded */
+static int rlogf_ok(const char *v)
+{
+	const char *p;
+	int n = 0, len = 0;
+
+	if (!v || strlen(v) >= RLOGF_BYTES)
+		return -1;
+	for (p = v; ; p++) {
+		if (!*p || *p == '\n') {
+			if (len > RLOGF_LINE || (len && ++n > RLOGF_MAX))
+				return -1;
+			len = 0;
+			if (!*p)
+				break;
+			continue;
+		}
+		if ((unsigned char)*p < 0x20 || (unsigned char)*p > 0x7e)
+			return -1;
+		len++;
+	}
+	return 0;
+}
+
+static void
+do_reaper_logf_cgi(char *url, FILE *stream)
+{
+	char *action = get_cgi("action");
+	int why = reaper_gate();
+
+	if (why != RGATE_OK) {
+		reaper_gate_deny(stream, why, "RDEVE");
+		return;
+	}
+	if (!action || !strcmp(action, "get")) {
+		char *l = rview_slurp(RLOGF_FILE, RLOGF_BYTES);
+		websWrite(stream, "{\"ok\":1,\"max\":%d,\"len\":%d,\"list\":", RLOGF_MAX, RLOGF_LINE);
+		gk_json_esc(stream, l ? l : "");
+		websWrite(stream, "}");
+		free(l);
+		return;
+	}
+	/* save the whole list (an empty one removes the file) */
+	if (!strcmp(action, "set")) {
+		char *v = get_cgi("list"), d[32];
+		const char *p;
+		int n = 0;
+
+		if (!v)
+			v = "";
+		if (rlogf_ok(v) != 0) {
+			websWrite(stream, "{\"ok\":0,\"ek\":\"RLOG_98\"}");
+			return;
+		}
+		if (*v ? rjf_set(RLOGF_FILE, v, "log") != 0 : (unlink(RLOGF_FILE) != 0 && errno != ENOENT)) {
+			websWrite(stream, "{\"ok\":0,\"ek\":\"RLOG_99\"}");
+			return;
+		}
+		for (p = v; *p; p++)
+			if (*p == '\n') n++;
+		n += *v && v[strlen(v) - 1] != '\n';
+		snprintf(d, sizeof(d), "%d pattern(s)", n);
+		reaper_audit("log", "exclusions", d);
+		websWrite(stream, "{\"ok\":1,\"n\":%d}", n);
+		return;
+	}
+	websWrite(stream, "{\"ok\":0,\"ek\":\"RDEVE_13\"}");
+}
