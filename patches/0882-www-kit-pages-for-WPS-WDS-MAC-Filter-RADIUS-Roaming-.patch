@@ -565,6 +582,29 @@ static const char *reaper_css_only[] = {
 	NULL
 };
 
+/* 2026-11-01 (owner: no stock UI, no injected theme): the AiMesh and Network pages keep the stock ASUS markup
+ * but carry their OWN Reaper stylesheet, linked as the last stylesheet in each page's <head>
+ * (reaper/reaper_content_aimesh.css, reaper/reaper_content_network.css - built from reaper_content.css, computed
+ * styles identical). httpd injects no stylesheet into them: they get the reaper-native treatment (link floor +
+ * shell bounce, mode 2). The Network page is SDN.asp plus the two documents of the network app it frames or
+ * opens; the aimesh/ parts AiMesh.asp loads are fragments with no </head>. Matched on the query-stripped path,
+ * whole components, case-insensitive - so another sdn.html (www/dashboard/pages/) never picks it up. */
+static const char *reaper_own_theme[] = { "AiMesh.asp", "SDN.asp", "SDN/sdn.html", "SDN/mlo.html", NULL };
+
+static int reaper_own_theme_page(const char *file)
+{
+	size_t n = strcspn(file, "?"), k;
+	int i;
+
+	for (i = 0; reaper_own_theme[i]; i++) {
+		k = strlen(reaper_own_theme[i]);
+		if (n >= k && strncasecmp(file + n - k, reaper_own_theme[i], k) == 0
+		    && (n == k || file[n - k - 1] == '/'))
+			return 1;
+	}
+	return 0;
+}
+
 /* True when the (query-stripped) basename ends in .asp/.htm/.html. CGI
  * endpoints also answer as text/html but emit tiny redirect stubs
  * (login.cgi/login_v2.cgi meta-refresh, QIS_default.cgi, page_default.cgi);
@@ -686,6 +726,8 @@ static int reaper_should_inject(struct mime_handler *h, const char *file)
 	for (i = 0; reaper_native[i]; i++)
 		if (strcasecmp(name, reaper_native[i]) == 0)
 			return 2;
+	if (reaper_own_theme_page(file))	/* AiMesh / Network: they link their own stylesheet */
+		return 2;
 
 
 	return 1;
