+<title>REAPER &mdash; MLO</title>
+<!-- Reaper_MLO.asp - Wireless > MLO (Reaper-native UI, native wave, 2026-11-01).
+     Replaces MLO.asp (the SDN single-page app in an iframe: sdn.js, mlo.js, rwd_component.js); same nvram, same
+     requests, posted as stock httpApi.nvramSet does (url-encoded JSON to /applyapp.cgi, so httpd's own
+     wl_nband_to_wlx turns the 2g1_/5g1_/6g1_ band keys into wl<unit>_ keys):
+       MLO switch ON   mld_enable=1 + for every band present: <band>_11be=1, _crypto=aes+gcmp256, _radio=1,
+                       _timesched=0; rc_service "reboot;" (bcmwifi). The confirm lists the radios it turns on and the
+                       schedules it turns off, as stock does.
+       MLO switch OFF  mld_enable=0; every enabled MLO fronthaul network (apg mlo=2) goes off with it: a main network
+                       (MAINFH / MAINBH) by apm<N>_mlo=0 + its band list without MLO (stock get_mainfh_dut_list), any
+                       other by apg<N>_enable=0 + its sdn_rl row disabled; rc_service "reboot;".
+       Backhaul        the MLO backhaul network (sdn_rl type MLO, apg mlo=1): SSID (1-32 bytes) and Hide SSID ->
+                       apg<N>_ssid / apg<N>_hide_ssid, rc_service "restart_wireless;restart_sdn <idx>;". Stock re-sent
+                       all 15 apg<N>_ keys with 13 unchanged; only the two that change are sent here.
+     The list shows the networks stock lists: sdn_rl rows of type MLO with apg mlo 1 (backhaul, first) or 2 (fronthaul).
+     Add a Network hands off to the Network page's own MLO wizard (sdn.js Get_Wizard_MLO, the same wizard stock opens
+     here): a one-shot sessionStorage flag that SDN.asp reads once. A fronthaul network is edited on that page too.
+     Dead on this build and left out: the backhaul-band selector (RTCONFIG_MLO_BH_BAND off), the get-start popup and the
+     QIS mlo path (stock hard-wires both checks true). The backhaul password shows masked, with a Show button (stock
+     printed it in clear). Per-network client counts are not shown (stock: the whole client list per page load). -->
+<link rel="stylesheet" href="/reaper/rp.css">
+<style>
+.msg{font-size:12.5px;color:var(--amber);display:none}
+.fv{font-family:var(--hdr);font-weight:600;color:var(--bone)}
+.fv.mono{font-family:var(--mono);font-weight:400}
+.frow input.ssid{width:280px}
+.tag{display:inline-block;font-family:var(--hdr);font-weight:600;font-size:11px;letter-spacing:.06em;text-transform:uppercase;
+  border:1px solid var(--line-soft);border-radius:6px;padding:2px 7px;color:var(--bone-dim)}
+.tag.on{color:var(--jade);border-color:rgba(79,178,134,.45)}
+.tleft{font-size:12px;color:var(--steel);margin-left:8px}
+td.acts{text-align:right;white-space:nowrap}
+.addrow{display:flex;align-items:center;gap:12px;flex-wrap:wrap;margin-top:12px}
+</style>
+</head>
+<body>
+<script src="/reaper_util.js"></script>
+<script src="/reaper/rp.js"></script>
+
+<div class="syswrap">
+<div class="pagehead">
+  <div>
+    <div class="eyebrow"><#menu5_1#></div>
+    <h1><#WiFi_mlo_title#></h1>
+  </div>
+  <div class="spacer"></div>
+</div>
+<div class="msg" id="topmsg" style="margin:-6px 0 12px"></div>
+<div class="hint" style="margin:-4px 0 14px"><#WiFi_mlo_Desc#></div>
+
+<div class="rframe">
+<div class="panel" id="p_main">
+  <div class="togglerow"><label class="tswitch"><input type="checkbox" id="t_mlo"><span class="track"></span></label><div>MLO</div></div>
+  <div class="hint" style="margin-top:6px"><#WiFi_mlo_switch_Hint#></div>
+  <div class="frow"><div class="fl"><#QKSet_wireless_webtitle#></div><div class="fc"><button type="button" class="btn small ghost" id="b_wifi"><#btn_go#></button></div></div>
+</div>
+
+<div class="panel" id="p_list">
+  <h2><#GuestNetwork_ProfileList#></h2>
+  <div class="sub" id="listsub"></div>
+  <table class="classes"><thead><tr><th><#QIS_finish_wireless_item1#></th><th>MLO</th><th><#Status_Str#></th><th></th></tr></thead>
+    <tbody id="mbody"><tr><td colspan="4" class="empty">&hellip;</td></tr></tbody></table>
+  <div class="addrow"><button type="button" class="btn primary small" id="b_add"><#GuestNetwork_ProfileAdd#></button><span class="msg" id="addmsg"></span></div>
+</div>
+
+<div class="panel" id="p_bh" style="display:none">
+  <h2><#AiMesh_WiFi_Backhaul#></h2>
+  <div class="frow"><div class="fl"><#QIS_finish_wireless_item1#></div><div class="fc"><input type="text" class="ssid" id="i_ssid" maxlength="32" autocomplete="off"></div></div>
+  <div class="frow"><div class="fl"><#WLANConfig11b_AuthenticationMethod_itemname#></div><div class="fc"><span class="fv">WPA3-Personal</span></div></div>
+  <div class="frow"><div class="fl"><#QIS_finish_wireless_item2#></div><div class="fc"><span class="fv mono" id="v_pwd">&bull;&bull;&bull;&bull;&bull;&bull;&bull;&bull;</span>
+    <button type="button" class="btn small ghost" id="b_pwd"><#Clientlist_Show#></button></div></div>
+  <div class="frow"><div class="fl"><#WLANConfig11b_x_BlockBCSSID_itemname#></div><div class="fc"><label class="tswitch"><input type="checkbox" id="t_hide"><span class="track"></span></label></div></div>
+  <div class="addrow"><button type="button" class="btn primary small" id="b_bh"><#CTL_apply#></button><span class="msg" id="bhmsg"></span></div>
+</div>
+</div>
+</div>
+
+<div class="applying" id="applying"><div class="abox"><h2 id="ap_t"><#Reaper_c_applying#></h2><p id="ap_p"><#RNT_62#></p></div></div>
+
+<script>
+(function(){
+'use strict';
+var q = rp.q, hx = rp.esc, U = rp.dec;
+var UI = {}; try { UI = [<% get_ui_support(); %>][0] || {}; } catch (e) {}
+var MLD = <% nvram_get_js("mld_enable"); %> === '1';
+var SDN_RL = U('<% nvram_char_to_ascii("","sdn_rl"); %>');
+var WLNB = String(<% nvram_get_js("wlnband_list"); %>).toUpperCase().split('<').filter(Boolean);
+var WL = [
+  {radio: <% nvram_get_js("wl0_radio"); %>, ts: <% nvram_get_js("wl0_timesched"); %>},
+  {radio: <% nvram_get_js("wl1_radio"); %>, ts: <% nvram_get_js("wl1_timesched"); %>},
+  {radio: <% nvram_get_js("wl2_radio"); %>, ts: <% nvram_get_js("wl2_timesched"); %>},
+  {radio: <% nvram_get_js("wl3_radio"); %>, ts: <% nvram_get_js("wl3_timesched"); %>}
+];
+var NOW = parseInt('<% utctimestamp(); %>', 10) || 0;
+var REBOOT_WAIT = parseInt('<% get_default_reboot_time(); %>', 10) || 90;
+var SDN_PAGE = UI.sdn_mwl ? `<#Network#>` : `<#Guest_Network#>`;
+var MAINS = {MAINFH: 1, MAINBH: 1};
+
+/* the bands this box has, in stock's slot order (get_wl_unit_by_band: the slot's position in wlnband_list) */
+var SLOTS = ['2g1', '5g1', '5g2', '6g1', '6g2'].map(function(s){ return {key: s, unit: WLNB.indexOf(s.toUpperCase())}; })
+  .filter(function(s){ return s.unit >= 0; });
+function has(slot){ return SLOTS.some(function(s){ return s.key === slot; }); }
+function slotName(s){
+  if (s === '2g1') return '2.4 GHz';
+  var f = s.charAt(0) + ' GHz';
+  if (s.charAt(2) === '2') return f + '-2';
+  return has(s.substring(0, 2) + '2') ? f + '-1' : f;
+}
+/* stock wifi_band_options_cb: the band bits a band list may carry on this box */
+var BAND_BITS = (function(){
+  var b = 0;
+  if (has('2g1')) b |= 1;
+  if (has('5g2')) b |= 4 | 8; else if (has('5g1')) b |= 2;
+  if (has('6g2')) b |= 32 | 64; else if (has('6g1')) b |= 16;
+  return b;
+})();
+/* stock get_mainfh_dut_list(bits, false): the main network's band list once MLO is off */
+function mainDutNoMlo(bits){
+  var band = 0;
+  [1, 2, 4, 8, 16, 32, 64].forEach(function(v){ if (bits & v) band += v; });
+  if ((bits & 4) && !(bits & 2)) band += 2;
+  if ((bits & 64) && !(bits & 16)) band += 16;
+  if ((bits & 2) && !(band & 4)) band += 4;
+  if ((bits & 16) && !(band & 64)) band += 64;
+  if ((bits & 8) && bits > 8 && !(band & 2)) band += 2;
+  if ((bits & 32) && bits > 32 && !(band & 16)) band += 16;
+  return '<*>' + band + '>';
+}
+/* the band field of the first entry of a dut_list (<MAC>bands>ports ...) - stock mainfh_smart_connect.band_bitwise */
+function firstBands(dut){
+  var e = String(dut || '').split('<').filter(Boolean)[0];
+  return e ? (parseInt(e.split('>')[1], 10) || 0) : 0;
+}
+
+/* sdn_rl rows: idx>sdn_name>sdn_enable>vlan_idx>subnet_idx>apg_idx>... (sdn.js sdn_rl_attr order) */
+var ROWS = rp.list.parse(SDN_RL).map(function(r){ return {r: r, idx: r.f[0], name: r.f[1], on: r.f[2] === '1', apg: r.f[5]}; })
+  .filter(function(x){ return x.idx !== '0' && x.idx !== '' && +x.apg > 0; });
+var AP = {};          /* prefix+idx -> {enable, ssid, hide_ssid, mlo, dut_list, timesched, expiretime, disabled, security} */
+function pfx(x){ return MAINS[x.name] ? 'apm' : 'apg'; }
+var FIELDS = ['enable', 'ssid', 'hide_ssid', 'mlo', 'dut_list', 'timesched', 'expiretime', 'disabled', 'security'];
+
+function msg(id, t){ var m = q(id); m.textContent = t || ''; m.style.display = t ? (id === 'topmsg' ? 'block' : 'inline') : 'none'; }
+function appGet(keys, cb){
+  var x = new XMLHttpRequest();
+  x.open('GET', '/appGet.cgi?hook=' + keys.map(function(k){ return 'nvram_char_to_ascii(' + k + ',' + k + ')'; }).join('%3B') + '&_=' + Date.now(), true);
+  x.timeout = 15000;
+  x.onload = function(){ var d = null; try { d = JSON.parse(x.responseText); } catch (e) {} cb(d); };
+  x.onerror = x.ontimeout = function(){ cb(null); };
+  x.send();
+}
+/* stock httpApi.nvramSet: url-encoded JSON (httpd decodes it and maps the band keys) */
+function nvSet(obj, cb){
+  var x = new XMLHttpRequest();
+  x.open('POST', '/applyapp.cgi', true);
+  x.setRequestHeader('Content-Type', 'application/x-www-form-urlencoded; charset=UTF-8');
+  x.timeout = 45000;
+  x.onloadend = function(){ if (cb) cb(); };
+  x.send(encodeURIComponent(JSON.stringify(obj)));
+}
+function back(){ top.location.href = '/reaper_shell.asp#Reaper_MLO.asp'; }
+/* a reboot: the router's own reboot time, then wait for httpd to answer again */
+function rebooting(){
+  rp.applying(`<#Reaper_c_rebooting#>`, `<#AiMesh_System_Reboot_Hint#>`);
+  setTimeout(function(){
+    var tries = 0, t = setInterval(function(){
+      var c = new XMLHttpRequest(), done = false; c.open('GET', '/httpd_check.xml?_=' + Date.now(), true); c.timeout = 2500;
+      c.onload = function(){ if (done) return; done = true; if (c.status === 200){ clearInterval(t); back(); } };
+      try { c.send(); } catch (e) {}
+      if (++tries > 90){ clearInterval(t); top.location.href = '/'; }
+    }, 2000);
+  }, REBOOT_WAIT * 1000);
+}
+
+function mloRows(){
+  var bh = [], fh = [];
+  ROWS.forEach(function(x){
+    if (x.name !== 'MLO') return;
+    var a = AP[pfx(x) + x.apg]; if (!a) return;
+    if (a.mlo === '1') bh.push(x); else if (a.mlo === '2') fh.push(x);
+  });
+  return bh.concat(fh);      /* stock: the backhaul first */
+}
+function timeLeft(a){
+  if (a.timesched !== '2' || !NOW) return '';
+  var end = String(a.expiretime || '').split(',')[1];
+  if (!end || end.length !== 13) return '';
+  var s = Math.max(0, parseInt(end.substr(2, 10), 10) - NOW), h = Math.floor(s / 3600), m = Math.floor(s / 60) % 60;
+  return `<#mssid_time_remaining#>` + ' ' + h + ':' + (m < 10 ? '0' : '') + m;
+}
+var selBh = null;
+function paintList(){
+  var rows = mloRows(), b = q('mbody');
+  if (!rows.length){ b.innerHTML = '<tr><td colspan="4" class="empty">' + hx(`<#IPConnection_VSList_Norule#>`) + '</td></tr>'; return; }
+  b.innerHTML = rows.map(function(x){
+    var a = AP[pfx(x) + x.apg], isBh = a.mlo === '1', on = x.on && a.disabled !== '1';
+    var left = on ? timeLeft(a) : '';
+    return '<tr><td class="name">' + hx(a.ssid) + '</td><td>' + (isBh ? hx(`<#AiMesh_WiFi_Backhaul#>`) : 'MLO') + '</td>' +
+      '<td><span class="tag' + (on ? ' on' : '') + '">' + hx(on ? `<#Status_Active#>` : `<#Status_Inactive#>`) + '</span>' +
+      (left ? '<span class="tleft">' + hx(left) + '</span>' : '') + '</td>' +
+      '<td class="acts"><button type="button" class="btn small ghost" data-idx="' + hx(x.idx) + '">' + hx(`<#CTL_modify#>`) + '</button></td></tr>';
+  }).join('');
+}
+function openBh(x){
+  var a = AP[pfx(x) + x.apg]; selBh = x;
+  q('i_ssid').value = a.ssid; q('t_hide').checked = a.hide_ssid === '1';
+  /* stock: the password is field 3 of the first security row (<band>auth>crypto>PWD>radius_idx) */
+  var sec = String(a.security || '').split('<')[1], pwd = sec ? (sec.split('>')[3] || '') : '';
+  q('v_pwd').dataset.pwd = pwd; q('v_pwd').innerHTML = '&bull;&bull;&bull;&bull;&bull;&bull;&bull;&bull;';
+  q('b_pwd').style.display = pwd ? '' : 'none';
+  msg('bhmsg', ''); q('p_bh').style.display = '';
+}
+
+/* --- the switch --- */
+function switchOn(){
+  var off = [], sched = [];
+  SLOTS.forEach(function(s){
+    var w = WL[s.unit] || {};
+    if (w.radio !== '1') off.push(slotName(s.key));
+    if (w.ts === '1') sched.push(slotName(s.key));
+  });
+  var lines = [];
+  if (off.length || sched.length){
+    lines.push(`<#RNW_7#>`);
+    if (off.length) lines.push('- ' + `<#WLANConfig11b_WirelessCtrl_button1name#>` + ' ' + off.join(', ') + ' ' + `<#Wireless_Radio#>`);
+    if (sched.length) lines.push('- ' + `<#WLANConfig11b_WirelessCtrl_buttonname#>` + ' ' + sched.join(', ') + ' ' + `<#menu5_1#>` + ' ' + `<#Time_Scheduling#>`);
+  }
+  lines.push(`<#AiMesh_System_Reboot_Hint#>`, `<#AiMesh_Are_U_Sure_Proceed#>`);
+  if (!confirm(lines.join('\n'))) return false;
+  var o = {action_mode: 'apply', rc_service: 'reboot;', mld_enable: '1'};
+  SLOTS.forEach(function(s){ o[s.key + '_11be'] = '1'; o[s.key + '_crypto'] = 'aes+gcmp256'; o[s.key + '_radio'] = '1'; o[s.key + '_timesched'] = '0'; });
+  nvSet(o); rebooting(); return true;
+}
+function switchOff(){
+  var fh = ROWS.filter(function(x){ var a = AP[pfx(x) + x.apg]; return x.on && a && a.mlo === '2'; });
+  if (!confirm((fh.length ? `<#WiFi_mlo_disable_Hint#>` + '\n' : '') + `<#AiMesh_System_Reboot_Hint#>`)) return false;
+  var o = {action_mode: 'apply', rc_service: 'reboot;', mld_enable: '0'}, rl = false;
+  fh.forEach(function(x){
+    var a = AP[pfx(x) + x.apg];
+    if (MAINS[x.name]){
+      o['apm' + x.apg + '_mlo'] = '0';
+      o['apm' + x.apg + '_dut_list'] = mainDutNoMlo(firstBands(a.dut_list) & BAND_BITS);
+    } else {
+      o['apg' + x.apg + '_enable'] = '0';
+      var f = x.r.f.slice(); f[2] = '0'; x.r = rp.list.row(f); rl = true;
+    }
+  });
+  if (rl) o.sdn_rl = rp.list.ser(rp.list.parse(SDN_RL).map(function(r){
+    var m = ROWS.filter(function(x){ return x.idx === r.f[0]; })[0]; return m ? m.r : r; }));
+  nvSet(o); rebooting(); return true;
+}
+
+function load(){
+  var keys = [];
+  ROWS.forEach(function(x){ FIELDS.forEach(function(f){ keys.push(pfx(x) + x.apg + '_' + f); }); });
+  if (!keys.length){ paintList(); return; }
+  appGet(keys, function(d){
+    if (!d){ msg('topmsg', `<#ALERT_OF_ERROR_System4#>`); q('mbody').innerHTML = ''; return; }
+    ROWS.forEach(function(x){
+      var a = {}; FIELDS.forEach(function(f){ a[f] = U(d[pfx(x) + x.apg + '_' + f] || ''); }); AP[pfx(x) + x.apg] = a;
+    });
+    paintList();
+  });
+}
+
+q('t_mlo').checked = MLD;
+q('listsub').textContent = rp.sub(`<#RNW_8#>`, SDN_PAGE);
+q('t_mlo').addEventListener('change', function(){
+  msg('topmsg', '');
+  var ok = this.checked ? switchOn() : switchOff();
+  if (!ok) this.checked = !this.checked;
+});
+q('b_wifi').addEventListener('click', function(){ top.location.href = '/reaper_shell.asp#Reaper_WiFiSettings.asp'; });
+q('b_add').addEventListener('click', function(){
+  /* SDN.asp opens its MLO wizard once for this flag (it checks the profile limit itself) */
+  try { sessionStorage.setItem('reaper_sdn_wizard', 'MLO'); } catch (e) {}
+  top.location.href = '/reaper_shell.asp#SDN.asp';
+});
+q('mbody').addEventListener('click', function(e){
+  var btn = e.target.closest && e.target.closest('button[data-idx]'); if (!btn) return;
+  var x = ROWS.filter(function(r){ return r.idx === btn.getAttribute('data-idx'); })[0]; if (!x) return;
+  if (AP[pfx(x) + x.apg].mlo === '1') openBh(x);
+  else top.location.href = '/reaper_shell.asp#SDN.asp';
+});
+q('b_pwd').addEventListener('click', function(){
+  var v = q('v_pwd'), shown = v.getAttribute('data-shown') === '1';
+  if (shown){ v.innerHTML = '&bull;&bull;&bull;&bull;&bull;&bull;&bull;&bull;'; v.setAttribute('data-shown', '0'); }
+  else { v.textContent = v.dataset.pwd || ''; v.setAttribute('data-shown', '1'); }
+});
+q('b_bh').addEventListener('click', function(){
+  msg('bhmsg', '');
+  if (!selBh){ msg('bhmsg', `<#ALERT_OF_ERROR_System4#>`); return; }
+  var s = q('i_ssid').value, bytes = unescape(encodeURIComponent(s)).length;
+  if (!s.trim() || bytes > 32 || /[\x00-\x1f\x7f]/.test(s)){ msg('bhmsg', `<#RWFS_10#>`); q('i_ssid').focus(); return; }
+  var o = {action_mode: 'apply', rc_service: 'restart_wireless;restart_sdn ' + selBh.idx + ';'};
+  o['apg' + selBh.apg + '_ssid'] = s; o['apg' + selBh.apg + '_hide_ssid'] = q('t_hide').checked ? '1' : '0';
+  rp.applying(`<#Reaper_c_applying#>`, `<#RNT_62#>`);
+  nvSet(o); setTimeout(function(){ location.reload(); }, 20000);
+});
+load();
+})();
+</script>
+</body>
+</html>
diff --git a/release/src/router/www/Reaper_RADIUS.asp b/release/src/router/www/Reaper_RADIUS.asp
new file mode 100644
index 00000000000..7cc72a6a96f
--- /dev/null
+++ b/release/src/router/www/Reaper_RADIUS.asp
@@ -0,0 +1,163 @@
+<!-- SPDX-License-Identifier: GPL-2.0-only
+     Copyright (C) 2026 the Reaper project maintainer
+     Part of the Reaper hardened Asuswrt-Merlin build. See LICENSE / LICENSE.reaper. -->
+<!DOCTYPE html>
+<html lang="en">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width, initial-scale=1">
+<meta name="reaper-native" content="1">
+<title>REAPER &mdash; <#menu5_1_5#></title>
+<!-- Reaper_RADIUS.asp - Wireless > RADIUS Setting (Reaper-native UI, native wave, 2026-10-31).
+     Replaces Advanced_WSecurity_Content.asp; same nvram, same apply. Per radio unit N (primary network):
+       wlN_radius_ipaddr   server address: IPv4, or IPv6 in router mode (stock); "" = none
+       wlN_radius_port     1-65535 (default 1812)
+       wlN_radius_key      shared secret, up to 64 printable ASCII, no leading / trailing double quote (stock)
+     Consumer: the prebuilt hostapd writer (rc/prebuild hostapd_config_be.o) reads them ONLY for a band whose
+     wlN_auth_mode_x is an Enterprise / 802.1X mode (wpa wpa2 wpawpa2 wpa3 wpa2wpa3 suite-b radius). No Reaper page
+     sets those modes today (Wireless Settings has no authentication control; setup forces WPA2/WPA3-Personal), so
+     each band shows whether its server is in use and why not - the owner asked for the page anyway (2026-10-31)
+     rather than deleting it. With Smart Connect grouping bands, rc copies the lead band's server to the others at
+     restart (init-broadcom.c). Guest Network Pro Enterprise networks keep their own servers (Network page).
+     Apply = /applyapp.cgi with rc_service restart_wireless (stock), only changed keys. Differences from stock: every
+     radio on one page (stock cycled the global wl_unit); a blank address is accepted (clears the server); port 0
+     refused (stock allowed it); the secret field starts masked with a show switch. -->
+<link rel="stylesheet" href="/reaper/rp.css">
+<style>
+.msg{font-size:12.5px;color:var(--amber);display:none}
+.frow input.addr{width:300px} .frow input.port{width:96px} .frow input.key{width:300px}
+.bad{border-color:var(--crimson)!important;box-shadow:0 0 0 2px rgba(225,6,0,.25)}
+.use{font-size:12.5px;line-height:1.55;margin:0 0 10px;color:var(--steel)}
+.use.on{color:var(--jade)}
+.show{font-size:12px;color:var(--steel);display:inline-flex;align-items:center;gap:6px;cursor:pointer}
+</style>
+</head>
+<body>
+<script src="/reaper_util.js"></script>
+<script src="/reaper/rp.js"></script>
+
+<div class="syswrap">
+<div class="pagehead">
+  <div>
+    <div class="eyebrow"><#menu5_1#></div>
+    <h1><#menu5_1_5#></h1>
+  </div>
+  <div class="spacer"></div>
+  <span class="pill warn chgpill" id="chgpill"><span class="dot"></span><span><#RADM_77#>: <b id="chgcount">0</b></span></span>
+  <button type="button" class="btn ghost" id="discardbtn" disabled><#Discard#></button>
+  <button type="button" class="btn primary" id="applybtn"><#CTL_apply#></button>
+</div>
+<div class="msg" id="topmsg" style="margin:-6px 0 12px"></div>
+<div class="hint" style="margin:-4px 0 14px"><#WLANAuthentication11a_display1_sectiondesc#></div>
+<div class="rframe" id="bands"></div>
+</div>
+
+<div class="applying" id="applying"><div class="abox"><h2 id="ap_t"><#Reaper_c_applying#></h2><p id="ap_p"><#RNT_62#></p></div></div>
+
+<script>
+(function(){
+'use strict';
+var q = rp.q, hx = rp.esc;
+var NB = [<% nvram_get_js("wl0_nband"); %>, <% nvram_get_js("wl1_nband"); %>, <% nvram_get_js("wl2_nband"); %>, <% nvram_get_js("wl3_nband"); %>];
+var IFN = <% nvram_get_js("wl_ifnames"); %>.trim().split(/\s+/).filter(Boolean);
+var SW_MODE = <% nvram_get_js("sw_mode"); %>, WLC_BAND = <% nvram_get_js("wlc_band"); %>;
+var V6 = SW_MODE === '1';                           /* stock: IPv6 address only in router mode (every Reaper model has IPv6) */
+var NV = {
+  wl0_auth_mode_x: <% nvram_get_js("wl0_auth_mode_x"); %>, wl0_radius_ipaddr: <% nvram_get_js("wl0_radius_ipaddr"); %>, wl0_radius_port: <% nvram_get_js("wl0_radius_port"); %>, wl0_radius_key: <% nvram_get_js("wl0_radius_key"); %>,
+  wl1_auth_mode_x: <% nvram_get_js("wl1_auth_mode_x"); %>, wl1_radius_ipaddr: <% nvram_get_js("wl1_radius_ipaddr"); %>, wl1_radius_port: <% nvram_get_js("wl1_radius_port"); %>, wl1_radius_key: <% nvram_get_js("wl1_radius_key"); %>,
+  wl2_auth_mode_x: <% nvram_get_js("wl2_auth_mode_x"); %>, wl2_radius_ipaddr: <% nvram_get_js("wl2_radius_ipaddr"); %>, wl2_radius_port: <% nvram_get_js("wl2_radius_port"); %>, wl2_radius_key: <% nvram_get_js("wl2_radius_key"); %>,
+  wl3_auth_mode_x: <% nvram_get_js("wl3_auth_mode_x"); %>, wl3_radius_ipaddr: <% nvram_get_js("wl3_radius_ipaddr"); %>, wl3_radius_port: <% nvram_get_js("wl3_radius_port"); %>, wl3_radius_key: <% nvram_get_js("wl3_radius_key"); %>
+};
+var ENT = {wpa: 1, wpa2: 1, wpawpa2: 1, wpa3: 1, wpa2wpa3: 1, 'suite-b': 1, radius: 1};
+var AUTH = {open: `<#CTL_open#>`, shared: 'Shared Key', psk: 'WPA-Personal', psk2: 'WPA2-Personal', pskpsk2: 'WPA/WPA2-Personal',
+  sae: 'WPA3-Personal', psk2sae: 'WPA2/WPA3-Personal', owe: 'Enhanced Open', openowe: 'Enhanced Open Transition',
+  wpa: 'WPA-Enterprise', wpa2: 'WPA2-Enterprise', wpawpa2: 'WPA/WPA2-Enterprise', wpa3: 'WPA3-Enterprise',
+  wpa2wpa3: 'WPA2/WPA3-Enterprise', 'suite-b': 'WPA3-Enterprise 192-bit', radius: 'Radius with 802.1x'};
+
+var BANDS = (function(){
+  var out = [], n5 = 0, n6 = 0, c5 = NB.filter(function(b){ return b === '1'; }).length, c6 = NB.filter(function(b){ return b === '4'; }).length;
+  for (var u = 0; u < (IFN.length || 4) && u < 4; u++){   /* no wl_ifnames: every unit that reports a band */
+    var b = NB[u], t = '';
+    if (b === '2') t = '2.4 GHz';
+    else if (b === '1'){ n5++; t = c5 > 1 ? '5 GHz-' + n5 : '5 GHz'; }
+    else if (b === '4'){ n6++; t = c6 > 1 ? '6 GHz-' + n6 : '6 GHz'; }
+    if (t) out.push({u: u, title: t, locked: (SW_MODE === '2' || SW_MODE === '4') && String(u) === WLC_BAND});
+  }
+  return out;
+})();
+function K(b, f){ return 'wl' + b.u + '_radius_' + f; }
+function msg(t){ var m = q('topmsg'); m.textContent = t || ''; m.style.display = t ? 'block' : 'none'; }
+
+function render(){
+  var h = '';
+  BANDS.forEach(function(b, i){
+    h += '<div class="panel" id="p' + i + '"><h2>' + hx(b.title) + '</h2>';
+    if (b.locked){ h += '<div class="sub">' + hx(`<#page_not_support_mode_hint#>`) + '</div></div>'; return; }
+    var am = NV['wl' + b.u + '_auth_mode_x'], lab = AUTH[am] || am || '-', on = !!ENT[am];
+    h += '<div class="use' + (on ? ' on' : '') + '" id="use' + i + '"></div>' +
+      '<div class="frow"><div class="fl">' + hx(`<#WLANAuthentication11a_ExAuthDBIPAddr_itemname#>`) + '</div><div class="fc"><input type="text" class="addr mono" id="ip' + i + '" maxlength="39" autocomplete="off"></div></div>' +
+      '<div class="frow"><div class="fl">' + hx(`<#WLANAuthentication11a_ExAuthDBPortNumber_itemname#>`) + '</div><div class="fc"><input type="text" class="port mono" id="pt' + i + '" maxlength="5" autocomplete="off" placeholder="1812"></div></div>' +
+      '<div class="frow"><div class="fl">' + hx(`<#WLANAuthentication11a_ExAuthDBPassword_itemname#>`) + '</div><div class="fc"><input type="password" class="key mono" id="ky' + i + '" maxlength="64" autocomplete="new-password">' +
+        '<label class="show"><input type="checkbox" id="sk' + i + '">' + hx(`<#QIS_show_pass#>`) + '</label></div></div>' +
+      '</div>';
+    b.useText = rp.sub(on ? `<#RNW_4#>` : `<#RNW_3#>`, `<#WLANConfig11b_AuthenticationMethod_itemname#>`, lab);
+  });
+  q('bands').innerHTML = h;
+  BANDS.forEach(function(b, i){
+    if (b.locked) return;
+    q('use' + i).textContent = b.useText;
+    fill(b, i);
+    ['ip', 'pt', 'ky'].forEach(function(p){ q(p + i).addEventListener('input', function(){ this.classList.remove('bad'); dirty(); }); });
+    q('sk' + i).addEventListener('change', function(){ q('ky' + i).type = this.checked ? 'text' : 'password'; });
+  });
+  dirty();
+}
+function fill(b, i){ q('ip' + i).value = NV[K(b, 'ipaddr')]; q('pt' + i).value = NV[K(b, 'port')]; q('ky' + i).value = NV[K(b, 'key')]; }
+function changes(){
+  var ch = {};
+  BANDS.forEach(function(b, i){
+    if (b.locked) return;
+    var v = {ipaddr: q('ip' + i).value.trim(), port: q('pt' + i).value.trim(), key: q('ky' + i).value};
+    Object.keys(v).forEach(function(f){ if (v[f] !== NV[K(b, f)]) ch[K(b, f)] = v[f]; });
+  });
+  return ch;
+}
+function dirty(){ rp.pill(rp.count(changes())); }
+/* stock validators: address IPv4 (IPv6 in router mode), port range, secret printable ASCII without edge quotes */
+function validate(){
+  var err = '', el = null;
+  BANDS.forEach(function(b, i){
+    if (b.locked || err) return;
+    var ip = q('ip' + i).value.trim(), pt = q('pt' + i).value.trim(), ky = q('ky' + i).value;
+    if (ip && !rp.v.ipv4(ip) && !(V6 && rp.v.ipv6(ip))){ err = ip + ' ' + `<#JS_validip#>`; el = q('ip' + i); }
+    else if (!rp.v.int(pt, 1, 65535)){ err = `<#JS_validrange#>` + ' 1 ' + `<#JS_validrange_to#>` + ' 65535'; el = q('pt' + i); }
+    else if (/[^\x20-\x7e]/.test(ky)){ err = `<#JS_validstr2#>` + ' ' + ky.replace(/[\x20-\x7e]/g, '').slice(0, 8); el = q('ky' + i); }
+    else if (ky.charAt(0) === '"'){ err = `<#JS_validstr1#>` + ' ["]'; el = q('ky' + i); }
+    else if (ky.length && ky.charAt(ky.length - 1) === '"'){ err = `<#JS_validstr3#>` + ' ["]'; el = q('ky' + i); }
+    if (err) err = b.title + ': ' + err;
+  });
+  if (el){ el.classList.add('bad'); el.focus(); }
+  return err;
+}
+function post(obj){
+  var x = new XMLHttpRequest(), a = [], k;
+  for (k in obj) a.push(encodeURIComponent(k) + '=' + encodeURIComponent(obj[k]));
+  x.open('POST', '/applyapp.cgi', true); x.setRequestHeader('Content-Type', 'application/x-www-form-urlencoded'); x.timeout = 150000;
+  x.send(a.join('&'));
+}
+function apply(){
+  msg('');
+  var err = validate(); if (err){ msg(err); return; }
+  var ch = changes();
+  if (!rp.count(ch)){ msg(`<#RADM_63#>`); return; }
+  ch.action_mode = 'apply'; ch.rc_service = 'restart_wireless';
+  rp.applying(`<#Reaper_c_applying#>`, `<#RNT_62#>`);
+  post(ch); setTimeout(function(){ location.reload(); }, 15000);
+}
+q('applybtn').addEventListener('click', apply);
+q('discardbtn').addEventListener('click', function(){ msg(''); render(); });
+render();
+})();
+</script>
+</body>
+</html>
diff --git a/release/src/router/www/Reaper_RoamBlock.asp b/release/src/router/www/Reaper_RoamBlock.asp
new file mode 100644
index 00000000000..b3defa358fd
--- /dev/null
+++ b/release/src/router/www/Reaper_RoamBlock.asp
@@ -0,0 +1,190 @@
+<!-- SPDX-License-Identifier: GPL-2.0-only
+     Copyright (C) 2026 the Reaper project maintainer
+     Part of the Reaper hardened Asuswrt-Merlin build. See LICENSE / LICENSE.reaper. -->
+<!DOCTYPE html>
+<html lang="en">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width, initial-scale=1">
+<meta name="reaper-native" content="1">
+<title>REAPER &mdash; <#WiFi_Roaming_Block_List#></title>
+<!-- Reaper_RoamBlock.asp - Wireless > Roaming Block List (Reaper-native UI, native wave, 2026-10-31).
+     Replaces Advanced_Roaming_Block_Content.asp; same nvram, same apply:
+       rast_static_cli_enable          "1" = the deny list is on (global)
+       wl0/1/2_rast_static_client      "<MAC<MAC..." upper case, at most 64 (the same list on every radio, as stock)
+     Consumer: the Roaming Assistant leaves the listed clients alone - no steering between AiMesh nodes; AiMesh
+     carries the keys to the nodes. Apply = /applyapp.cgi with rc_service restart_wireless (stock).
+     Differences from stock, on purpose: the list is read from all three radios (stock read wl0 only and wrote all
+     three, so a list that had diverged lost entries on the next save); only changed keys are posted; device names
+     come from ReaperNames (the user's own names, then networkmap) and go in as text, never markup; the picker
+     offers the wireless clients that are online now (stock: client_function.js dropdown). -->
+<link rel="stylesheet" href="/reaper/rp.css">
+<style>
+.bwl-add input.mac{width:170px}
+.bwl-add select{min-width:240px;max-width:100%}
+.bwl-add.bad input{border-color:var(--crimson)}
+.msg{font-size:12.5px;color:var(--amber);display:none}
+.off{opacity:.45;pointer-events:none}
+#p_list{margin-top:10px}
+.rtab td{padding:7px 10px;border-bottom:1px solid var(--line-soft);color:var(--bone-dim);vertical-align:middle}
+.rtab td.mono{font-family:var(--mono)}
+.rtab td.name{max-width:280px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
+</style>
+</head>
+<body>
+<script src="/reaper_util.js"></script>
+<script src="/reaper/rp.js"></script>
+
+<div class="syswrap">
+<div class="pagehead">
+  <div>
+    <div class="eyebrow"><#menu5_1#></div>
+    <h1><#WiFi_Roaming_Block_List#></h1>
+  </div>
+  <div class="spacer"></div>
+  <span class="pill warn chgpill" id="chgpill"><span class="dot"></span><span><#RADM_77#>: <b id="chgcount">0</b></span></span>
+  <button type="button" class="btn ghost" id="discardbtn" disabled><#Discard#></button>
+  <button type="button" class="btn primary" id="applybtn"><#CTL_apply#></button>
+</div>
+<div class="msg" id="topmsg" style="margin:-6px 0 12px"></div>
+
+<div class="rframe">
+<div class="panel" id="p_on">
+  <h2><#WiFi_Roaming_Block_List#></h2>
+  <div class="sub"><#Roaming_block_list_desc#></div>
+  <div class="togglerow"><label class="tswitch"><input type="checkbox" id="t_on"><span class="track"></span></label><div><#Roaming_block_list_enable#></div></div>
+  <div id="p_list">
+  <table class="rtab"><thead><tr><th><#Clientlist_device#></th><th><#MAC_Address#></th><th></th></tr></thead><tbody id="tbody"></tbody></table>
+  <div class="bwl-add" id="addbar">
+    <div class="f"><label><#Clientlist_device#></label><select id="s_pick" title="<#select_wireless_MAC#>"><option value=""><#Select_menu_default#></option></select></div>
+    <div class="f"><label><#MAC_Address#></label><input type="text" class="mac mono" id="a_mac" maxlength="17" placeholder="AA:BB:CC:DD:EE:FF" autocomplete="off"></div>
+    <button type="button" class="btn small" id="b_add"><#CTL_add#></button>
+  </div>
+  <div class="rbudget" id="budget"></div>
+  <div class="msg" id="addmsg" style="margin-top:8px"></div>
+  </div>
+</div>
+</div>
+</div>
+
+<div class="applying" id="applying"><div class="abox"><h2 id="ap_t"><#Reaper_c_applying#></h2><p id="ap_p"><#RNT_62#></p></div></div>
+
+<script>
+(function(){
+'use strict';
+var q = rp.q, hx = rp.esc, U = rp.dec;
+var MAX = 64;                                        /* stock addRow(obj, 64); 64 x 18 B fits the key */
+var UNITS = [0, 1, 2];                               /* stock writes wl0/1/2 */
+var NV = {
+  rast_static_cli_enable: <% nvram_get_js("rast_static_cli_enable"); %>,
+  wl0_rast_static_client: U('<% nvram_char_to_ascii("","wl0_rast_static_client"); %>'),
+  wl1_rast_static_client: U('<% nvram_char_to_ascii("","wl1_rast_static_client"); %>'),
+  wl2_rast_static_client: U('<% nvram_char_to_ascii("","wl2_rast_static_client"); %>')
+};
+var LIST = [], DEVS = [];
+
+function macs(s){ var out = []; String(s || '').split('<').forEach(function(m){ m = m.trim().toUpperCase(); if (rp.v.mac(m)) out.push(m); }); return out; }
+/* the union of the three radios, in stock order (wl0 first), without duplicates */
+function load(){
+  var seen = {}, out = [];
+  UNITS.forEach(function(u){ macs(NV['wl' + u + '_rast_static_client']).forEach(function(m){ if (!seen[m]){ seen[m] = 1; out.push(m); } }); });
+  return out.slice(0, MAX);
+}
+function ser(){ return LIST.map(function(m){ return '<' + m; }).join(''); }
+var BASE = [];                                       /* the list as loaded (the union above) */
+function enOn(){ return NV.rast_static_cli_enable === '1'; }
+function listChanged(){ return LIST.join('<') !== BASE.join('<'); }
+/* the keys to post: the switch if it moved; the list, to every radio, only if the user changed it (a list that
+   had diverged across radios is shown merged, but is left alone until it is edited) */
+function changes(){
+  var ch = {};
+  if (q('t_on').checked !== enOn()) ch.rast_static_cli_enable = q('t_on').checked ? '1' : '0';
+  if (listChanged()){ var s = ser(); UNITS.forEach(function(u){ ch['wl' + u + '_rast_static_client'] = s; }); }
+  return ch;
+}
+function dirty(){ rp.pill((q('t_on').checked !== enOn() ? 1 : 0) + (listChanged() ? 1 : 0)); }
+function msg(id, t){ var m = q(id); m.textContent = t || ''; m.classList.toggle('show', !!t); m.style.display = t ? 'block' : 'none'; }
+
+function draw(){
+  var h = '';
+  LIST.forEach(function(m, i){
+    h += '<tr><td class="name" data-i="' + i + '"></td><td class="mono">' + hx(m) + '</td>' +
+         '<td style="text-align:right"><span class="bwldel" data-i="' + i + '" title="' + hx(`<#CTL_del#>`) + '">&times;</span></td></tr>';
+  });
+  q('tbody').innerHTML = h || '<tr><td colspan="3" class="empty">' + hx(`<#IPConnection_VSList_Norule#>`) + '</td></tr>';
+  names();
+  var b = q('budget'); b.textContent = `<#List_limit#>` + ' ' + LIST.length + ' / ' + MAX; b.classList.toggle('hot', LIST.length >= MAX);
+  q('p_list').classList.toggle('off', !q('t_on').checked);
+  pickDraw(); dirty();
+}
+/* device names are client-chosen: text only */
+function names(){
+  Array.prototype.forEach.call(document.querySelectorAll('#tbody td.name'), function(td){
+    var m = LIST[+td.getAttribute('data-i')]; if (!m) return;
+    var n = ReaperNames.byMac(m, ''); td.textContent = n; td.title = n;
+  });
+}
+function pickDraw(){
+  var s = q('s_pick'), have = {};
+  LIST.forEach(function(m){ have[m] = 1; });
+  while (s.options.length > 1) s.remove(1);
+  DEVS.forEach(function(d){ if (have[d.mac]) return; var o = document.createElement('option'); o.value = d.mac; o.textContent = d.label; s.appendChild(o); });
+  if (!rp.pick(s, rp.val('a_mac').toUpperCase())) s.value = '';
+}
+/* wireless clients online now (networkmap isWL != 0), named the way every kit page names them */
+function devLoad(){
+  try {
+    ReaperNames.refresh('<% nvram_char_to_ascii("", "custom_clientlist"); %>', function(cl){
+      var ml = (cl && cl.maclist) || [], out = [];
+      ml.forEach(function(mac){ var c = cl[mac], m = String(mac).toUpperCase(), nm;
+        if (!c || !rp.v.mac(m) || String(c.isOnline) === '0' || !c.isWL || String(c.isWL) === '0') return;
+        nm = ReaperNames.byMac(mac, m);
+        out.push({mac: m, label: (nm !== m ? nm + ' - ' : '') + m}); });
+      out.sort(function(a, b){ return a.label.toLowerCase() < b.label.toLowerCase() ? -1 : 1; });
+      DEVS = out; names(); pickDraw();
+    });
+  } catch (e) {}
+}
+function add(){
+  msg('addmsg', '');
+  var m = rp.val('a_mac').toUpperCase(), e = '';
+  if (LIST.length >= MAX) e = `<#JS_itemlimit1#>` + ' ' + MAX + ' ' + `<#JS_itemlimit2#>`;
+  else if (!m) e = `<#JS_fieldblank#>`;
+  else if (!rp.v.mac(m)) e = `<#IPConnection_x_illegal_mac#>`;
+  else if (LIST.indexOf(m) >= 0) e = `<#JS_duplicate#>`;
+  if (e){ msg('addmsg', e); q('addbar').classList.add('bad'); setTimeout(function(){ q('addbar').classList.remove('bad'); }, 4000); return; }
+  LIST.push(m); q('a_mac').value = ''; draw();
+}
+
+/* the stock apply path: /applyapp.cgi -> validate_apply + notify_rc(restart_wireless) */
+function post(obj){
+  var x = new XMLHttpRequest(), b = [], k;
+  for (k in obj) b.push(encodeURIComponent(k) + '=' + encodeURIComponent(obj[k]));
+  x.open('POST', '/applyapp.cgi', true); x.setRequestHeader('Content-Type', 'application/x-www-form-urlencoded'); x.timeout = 150000;
+  x.send(b.join('&'));
+}
+function apply(){
+  msg('topmsg', '');
+  var ch = changes();
+  if (!rp.count(ch)){ msg('topmsg', `<#RADM_63#>`); return; }
+  ch.action_mode = 'apply'; ch.rc_service = 'restart_wireless';
+  rp.applying(`<#Reaper_c_applying#>`, `<#RNT_62#>`);
+  post(ch); setTimeout(function(){ location.reload(); }, 15000);
+}
+
+q('t_on').checked = enOn();
+BASE = load(); LIST = BASE.slice();
+q('t_on').addEventListener('change', draw);
+q('b_add').addEventListener('click', add);
+q('a_mac').addEventListener('keydown', function(e){ if (e.key === 'Enter') add(); });
+q('a_mac').addEventListener('input', function(){ if (!rp.pick(q('s_pick'), rp.val('a_mac').toUpperCase())) q('s_pick').value = ''; });
+q('s_pick').addEventListener('change', function(){ if (this.value){ q('a_mac').value = this.value; msg('addmsg', ''); } });
+q('tbody').addEventListener('click', function(e){ var t = e.target;
+  if (t && t.classList && t.classList.contains('bwldel')){ LIST.splice(+t.getAttribute('data-i'), 1); draw(); } });
+q('applybtn').addEventListener('click', apply);
+q('discardbtn').addEventListener('click', function(){ q('t_on').checked = enOn(); LIST = BASE.slice(); msg('topmsg', ''); msg('addmsg', ''); draw(); });
+draw(); devLoad();
+})();
+</script>
+</body>
+</html>
diff --git a/release/src/router/www/Reaper_VLAN.asp b/release/src/router/www/Reaper_VLAN.asp
new file mode 100644
index 00000000000..efd5eaf9b8e
--- /dev/null
+++ b/release/src/router/www/Reaper_VLAN.asp
@@ -0,0 +1,480 @@
+<!-- SPDX-License-Identifier: GPL-2.0-only
+     Copyright (C) 2026 the Reaper project maintainer
+     Part of the Reaper hardened Asuswrt-Merlin build. See LICENSE / LICENSE.reaper. -->
+<!DOCTYPE html>
+<html lang="en">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width, initial-scale=1">
+<meta name="reaper-native" content="1">
+<title>REAPER &mdash; VLAN</title>
+<!-- Reaper_VLAN.asp - LAN > VLAN (Reaper-native UI, native wave, 2026-11-01).
+     Replaces Advanced_VLAN_Switch_Content.asp + Advanced_VLAN_Profile_Content.asp; same nvram, same requests, posted
+     as stock httpApi.nvramSet does (url-encoded JSON to /applyapp.cgi).
+     Switch tab: every AiMesh node that reports its Ethernet ports (get_cfg_clientlist capability 27, live
+       state from /get_port_status.cgi), each port All / Access (one VLAN network) / Trunk (all tags or one VID).
+       Apply = stock applyRule: every VLAN network's apg<N>_dut_list rewritten (lanport fields cleared, the Access ports
+       appended to their network's row for the node, nodes missing from the list added back as <MAC>>), vlan_trunklist
+       (<MAC>Lx#vid|all ...), rc_service restart_net_and_phy. A port stock locks stays All: the dual-WAN LAN port, the
+       WAN-aggregation port, LACP bonding ports, IPTV ports, an external-switch port, a live WAN port.
+     Profile tab: the vlan_rl rows with the networks bound to them.
+       Add = stock addRow_Group: a VLAN-only network (sdn_rl type Customized, a subnet with DHCP off, an open apg named
+       VLAN_<vid> with no Wi-Fi on any node), restart_wireless;restart_net_and_phy;.
+       Edit = vlan_rl (+ the VID swapped in vlan_trunklist), restart_net_and_phy;.
+       Delete = the network's sdn_rl / vlan_rl / subnet_rl / radius_list rows out, the same rows in the *_x lists,
+       apg<N>_enable=0, the VID out of vlan_trunklist, restart_net_and_phy; (+ restart_qos;restart_firewall; with QoS on).
+     Differences: rows this page does not change are written back byte for byte (stock re-serialised every list); a
+     trunk port that carries several VIDs keeps them (stock's one-VID select turned it into "all" on the next Apply);
+     deleting a VLAN row with no network removes it (stock threw); sdn_access_rl rows naming a deleted network go too. -->
+<link rel="stylesheet" href="/reaper/rp.css">
+<style>
+.msg{font-size:12.5px;color:var(--amber);display:none}
+.nodehead{font-family:var(--hdr);font-weight:600;color:var(--bone);margin:14px 0 6px;display:flex;gap:10px;flex-wrap:wrap;align-items:baseline}
+.nodehead:first-child{margin-top:0}
+.nodehead .k{font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:var(--steel)}
+.nodehead .mono{font-family:var(--mono);font-weight:400;font-size:12px;color:var(--bone-dim)}
+table.classes select{min-width:120px}
+.pst{font-size:12px}
+.pst.on{color:var(--jade)} .pst.warn{color:var(--amber)} .pst.off{color:var(--steel)}
+.lock{font-size:11.5px;color:var(--steel);display:block;margin-top:3px}
+.addrow{display:flex;align-items:flex-end;gap:12px;flex-wrap:wrap;margin-top:14px;padding-top:14px;border-top:1px solid var(--line-soft)}
+.addrow .f{display:flex;flex-direction:column;gap:5px}
+.addrow label.k{font-family:var(--hdr);font-weight:600;font-size:10.5px;letter-spacing:.1em;text-transform:uppercase;color:var(--steel)}
+.addrow input[type=text]{background:#000;border:1px solid var(--line-soft);border-radius:8px;color:var(--bone);font-family:var(--body);font-size:13px;padding:8px 10px;outline:none;width:96px}
+td.acts{text-align:right;white-space:nowrap}
+.btnrow{display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin-top:14px}
+</style>
+</head>
+<body>
+<script src="/reaper_util.js"></script>
+<script src="/reaper/rp.js"></script>
+
+<div class="syswrap">
+<div class="pagehead">
+  <div>
+    <div class="eyebrow"><#menu5_2#></div>
+    <h1>VLAN</h1>
+  </div>
+  <div class="spacer"></div>
+</div>
+<div class="msg" id="topmsg" style="margin:-6px 0 12px"></div>
+
+<div class="wins" id="wins">
+  <button type="button" class="win" data-t="sw" id="win_sw"><span class="cdot"></span>VLAN</button>
+  <button type="button" class="win" data-t="pf" id="win_pf"><span class="cdot"></span><#VALN_Profile#></button>
+</div>
+
+<div class="tab rframe" id="tab_sw">
+<div class="panel" id="p_sw">
+  <h2><#VALN_Switch_desc#></h2>
+  <div class="sub" id="swdesc"></div>
+  <div id="nodes"><div class="hint">&hellip;</div></div>
+  <div class="btnrow"><button type="button" class="btn primary" id="b_swapply"><#CTL_apply#></button><span class="msg" id="swmsg"></span></div>
+</div>
+</div>
+
+<div class="tab rframe" id="tab_pf">
+<div class="panel" id="p_pf">
+  <h2><#GuestNetwork_ProfileList#></h2>
+  <div class="sub" id="pfdesc"></div>
+  <table class="classes"><thead><tr><th><#QIS_finish_wireless_item1#></th><th><#WANVLANIDText#></th><th><#VLAN_port_iso#></th><th></th></tr></thead>
+    <tbody id="pbody"></tbody></table>
+  <div class="addrow">
+    <div class="f"><label class="k" for="i_vid"><#WANVLANIDText#></label><input type="text" id="i_vid" maxlength="4" inputmode="numeric" autocomplete="off" placeholder="3-4093"></div>
+    <label class="chk"><input type="checkbox" id="c_iso"><#VLAN_port_iso#></label>
+    <button type="button" class="btn primary small" id="b_add"><#CTL_add#></button><span class="msg" id="addmsg"></span>
+  </div>
+</div>
+<div class="panel" id="p_ed" style="display:none">
+  <h2><#CTL_modify#></h2>
+  <div class="frow"><div class="fl"><#QIS_finish_wireless_item1#></div><div class="fc"><span id="e_name"></span></div></div>
+  <div class="frow"><div class="fl"><#WANVLANIDText#></div><div class="fc"><input type="text" class="short" id="e_vid" maxlength="4" inputmode="numeric" autocomplete="off"></div></div>
+  <div class="frow"><div class="fl"><#VLAN_port_iso#></div><div class="fc"><label class="tswitch"><input type="checkbox" id="e_iso"><span class="track"></span></label></div></div>
+  <div class="btnrow"><button type="button" class="btn primary small" id="b_edok"><#CTL_apply#></button><button type="button" class="btn small ghost" id="b_edcancel"><#CTL_Cancel#></button><span class="msg" id="edmsg"></span></div>
+</div>
+</div>
+</div>
+
+<div class="applying" id="applying"><div class="abox"><h2 id="ap_t"><#Reaper_c_applying#></h2><p id="ap_p"><#RNT_62#></p></div></div>
+
+<script>
+(function(){
+'use strict';
+var q = rp.q, hx = rp.esc, U = rp.dec, L = rp.list;
+var UI = {}; try { UI = [<% get_ui_support(); %>][0] || {}; } catch (e) {}
+var NV = {
+  sdn_rl: U('<% nvram_char_to_ascii("","sdn_rl"); %>'), vlan_rl: U('<% nvram_char_to_ascii("","vlan_rl"); %>'),
+  subnet_rl: U('<% nvram_char_to_ascii("","subnet_rl"); %>'), radius_list: U('<% nvram_char_to_ascii("","radius_list"); %>'),
+  sdn_access_rl: U('<% nvram_char_to_ascii("","sdn_access_rl"); %>'), vlan_trunklist: U('<% nvram_char_to_ascii("","vlan_trunklist"); %>'),
+  wans_dualwan: <% nvram_get_js("wans_dualwan"); %>, wans_lanport: <% nvram_get_js("wans_lanport"); %>, bond_wan: <% nvram_get_js("bond_wan"); %>,
+  lacp_enabled: <% nvram_get_js("lacp_enabled"); %>, lacp_ifnames_x: <% nvram_get_js("lacp_ifnames_x"); %>, switch_stb_x: <% nvram_get_js("switch_stb_x"); %>,
+  iptv_stb_port: <% nvram_get_js("iptv_stb_port"); %>, iptv_voip_port: <% nvram_get_js("iptv_voip_port"); %>, iptv_bridge_port: <% nvram_get_js("iptv_bridge_port"); %>,
+  lan_ipaddr: <% nvram_get_js("lan_ipaddr"); %>, qos_enable: <% nvram_get_js("qos_enable"); %>, productid: <% nvram_get_js("productid"); %>
+};
+/* factory defaults the new VLAN-only subnet is built from (stock nvramDefaultGet) */
