+.own{font-size:12.5px;color:var(--steel);margin:-2px 0 10px}
+.own b{font-family:var(--mono);color:var(--bone);font-weight:400}
+.warnline{font-size:12.5px;color:var(--amber);line-height:1.55;margin:0 0 8px}
