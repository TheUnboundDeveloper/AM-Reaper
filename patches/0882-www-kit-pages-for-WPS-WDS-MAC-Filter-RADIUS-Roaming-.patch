@@ -9010,3 +9010,12 @@ RSHD_163=Če naj bo ključ kar v naslovu, vnesite $APIkey na mesto, kamor sodi (
 RBST_00=Bastion
 RDWT_66=Uveljavljanje nastavitev Dreadwatch…
 RDWT_67=Kako deluje Dreadwatch
