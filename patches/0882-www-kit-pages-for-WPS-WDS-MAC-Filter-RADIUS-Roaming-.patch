+</style>
+</head>
+<body>
+<script src="/reaper_util.js"></script>
+<script src="/reaper/rp.js"></script>
+
+<div class="syswrap">
+<div class="pagehead">
+  <div>
+    <div class="eyebrow"><#menu5_1#></div>
+    <h1>WDS</h1>
+  </div>
+  <div class="spacer"></div>
+  <span class="pill warn chgpill" id="chgpill"><span class="dot"></span><span><#RADM_77#>: <b id="chgcount">0</b></span></span>
+  <button type="button" class="btn ghost" id="discardbtn" disabled><#Discard#></button>
+  <button type="button" class="btn primary" id="applybtn"><#CTL_apply#></button>
+</div>
+<div class="msg" id="topmsg" style="margin:-6px 0 12px"></div>
+<div class="hint" style="margin:-4px 0 14px"><#RNW_6#></div>
+<div class="rframe" id="bands"></div>
+</div>
+
+<div class="applying" id="applying"><div class="abox"><h2 id="ap_t"><#Reaper_c_applying#></h2><p id="ap_p"><#RNT_62#></p></div></div>
+
+<script>
+(function(){
+'use strict';
+var q = rp.q, hx = rp.esc, U = rp.dec;
+var MAX = 4;                                         /* stock addRow(obj, 4) */
+var HTTPID = <% nvram_get_js("http_id"); %>;
+var NB = [<% nvram_get_js("wl0_nband"); %>, <% nvram_get_js("wl1_nband"); %>, <% nvram_get_js("wl2_nband"); %>, <% nvram_get_js("wl3_nband"); %>];
+var IFN = <% nvram_get_js("wl_ifnames"); %>.trim().split(/\s+/).filter(Boolean);
+var SW_MODE = <% nvram_get_js("sw_mode"); %>, WLC_BAND = <% nvram_get_js("wlc_band"); %>;
+var NV = {
+  wl0_mode_x: <% nvram_get_js("wl0_mode_x"); %>, wl0_wdsapply_x: <% nvram_get_js("wl0_wdsapply_x"); %>, wl0_wdslist: U('<% nvram_char_to_ascii("","wl0_wdslist"); %>'),
+  wl0_hwaddr: <% nvram_get_js("wl0_hwaddr"); %>, wl0_chanspec: <% nvram_get_js("wl0_chanspec"); %>, wl0_channel: <% nvram_get_js("wl0_channel"); %>,
+  wl1_mode_x: <% nvram_get_js("wl1_mode_x"); %>, wl1_wdsapply_x: <% nvram_get_js("wl1_wdsapply_x"); %>, wl1_wdslist: U('<% nvram_char_to_ascii("","wl1_wdslist"); %>'),
+  wl1_hwaddr: <% nvram_get_js("wl1_hwaddr"); %>, wl1_chanspec: <% nvram_get_js("wl1_chanspec"); %>, wl1_channel: <% nvram_get_js("wl1_channel"); %>,
+  wl2_mode_x: <% nvram_get_js("wl2_mode_x"); %>, wl2_wdsapply_x: <% nvram_get_js("wl2_wdsapply_x"); %>, wl2_wdslist: U('<% nvram_char_to_ascii("","wl2_wdslist"); %>'),
+  wl2_hwaddr: <% nvram_get_js("wl2_hwaddr"); %>, wl2_chanspec: <% nvram_get_js("wl2_chanspec"); %>, wl2_channel: <% nvram_get_js("wl2_channel"); %>,
+  wl3_mode_x: <% nvram_get_js("wl3_mode_x"); %>, wl3_wdsapply_x: <% nvram_get_js("wl3_wdsapply_x"); %>, wl3_wdslist: U('<% nvram_char_to_ascii("","wl3_wdslist"); %>'),
+  wl3_hwaddr: <% nvram_get_js("wl3_hwaddr"); %>, wl3_chanspec: <% nvram_get_js("wl3_chanspec"); %>, wl3_channel: <% nvram_get_js("wl3_channel"); %>
+};
+var SSID = {};                                       /* bssid -> ssid from the last scan, for the list's name column */
+
+var BANDS = (function(){
+  var out = [], n5 = 0, n6 = 0, c5 = NB.filter(function(b){ return b === '1'; }).length, c6 = NB.filter(function(b){ return b === '4'; }).length;
+  for (var u = 0; u < (IFN.length || 4) && u < 4; u++){   /* no wl_ifnames: every unit that reports a band */
+    var b = NB[u], t = '';
+    if (b === '2') t = '2.4 GHz';
+    else if (b === '1'){ n5++; t = c5 > 1 ? '5 GHz-' + n5 : '5 GHz'; }
+    else if (b === '4'){ n6++; t = c6 > 1 ? '6 GHz-' + n6 : '6 GHz'; }
+    if (t) out.push({u: u, title: t, locked: (SW_MODE === '2' || SW_MODE === '4') && String(u) === WLC_BAND, aps: []});
+  }
+  return out;
+})();
+function macs(s){ var out = [], seen = {}; String(s || '').split('<').forEach(function(m){ m = m.trim().toUpperCase(); if (rp.v.mac(m) && !seen[m]){ seen[m] = 1; out.push(m); } }); return out; }
+BANDS.forEach(function(b){
+  var p = 'wl' + b.u + '_';
+  b.mode0 = /^[012]$/.test(NV[p + 'mode_x']) ? NV[p + 'mode_x'] : '0';
+  b.apply0 = NV[p + 'wdsapply_x'] === '1' ? '1' : '0';
+  b.list0 = macs(NV[p + 'wdslist']).slice(0, MAX); b.list = b.list0.slice();
+  b.auto = (NV[p + 'chanspec'] || NV[p + 'channel'] || '0') === '0';
+});
+function msg(id, t){ var m = q(id); if (!m) return; m.textContent = t || ''; m.style.display = t ? 'block' : 'none'; }
+function changes(){
+  var ch = {};
+  BANDS.forEach(function(b, i){
+    if (b.locked) return;
+    var p = 'wl' + b.u + '_', m = q('s_mode' + i).value, a = q('t_ap' + i).checked ? '1' : '0';
+    if (m !== b.mode0) ch[p + 'mode_x'] = m;
+    if (a !== b.apply0) ch[p + 'wdsapply_x'] = a;
+    if (b.list.join('<') !== b.list0.join('<')) ch[p + 'wdslist'] = b.list.map(function(x){ return '<' + x; }).join('');
+  });
+  return ch;
+}
+function dirty(){ rp.pill(rp.count(changes())); }
+
+function render(){
+  var h = '';
+  BANDS.forEach(function(b, i){
+    var p = 'wl' + b.u + '_';
+    h += '<div class="panel" id="p' + i + '"><h2>' + hx(b.title) + '</h2>' +
+      '<div class="own">' + hx(`<#MAC_Address#>`) + ': <b>' + hx(rp.v.mac(NV[p + 'hwaddr']) ? NV[p + 'hwaddr'].toUpperCase() : `<#Status_Inactive#>`) + '</b></div>';
+    if (b.locked){ h += '<div class="sub">' + hx(`<#page_not_support_mode_hint#>`) + '</div></div>'; return; }
+    if (b.auto) h += '<div class="warnline" id="aw' + i + '"></div>';
+    h += '<div class="frow"><div class="fl">' + hx(`<#WLANConfig11b_x_APMode_itemname#>`) + '</div><div class="fc"><select id="s_mode' + i + '">' +
+        '<option value="0">' + hx(`<#WLANConfig11b_x_APMode_option0#>`) + '</option><option value="1">' + hx(`<#WLANConfig11b_x_APMode_option1#>`) + '</option>' +
+        '<option value="2">' + hx(`<#WLANConfig11b_x_APMode_option2#>`) + '</option></select></div></div>' +
+      '<div class="listbox" id="lb' + i + '">' +
+      '<div class="togglerow"><label class="tswitch"><input type="checkbox" id="t_ap' + i + '"><span class="track"></span></label><div>' + hx(`<#WLANConfig11b_x_BRApply_itemname#>`) + '</div></div>' +
+      '<table class="rtab"><thead><tr><th>' + hx(`<#WLANConfig11b_RBRList_groupitemdesc#>`) + '</th><th>SSID</th><th></th></tr></thead><tbody id="tb' + i + '"></tbody></table>' +
+      '<div class="bwl-add" id="ab' + i + '">' +
+        '<div class="f"><label>' + hx(`<#AP_survey#>`) + '</label><select id="pk' + i + '" title="' + hx(`<#select_AP#>`) + '"><option value="">' + hx(`<#Select_menu_default#>`) + '</option></select></div>' +
+        '<button type="button" class="btn small" id="sv' + i + '">' + hx(`<#RSVY_1#>`) + '</button>' +
+        '<div class="f"><label>' + hx(`<#MAC_Address#>`) + '</label><input type="text" class="mac mono" id="am' + i + '" maxlength="17" placeholder="AA:BB:CC:DD:EE:FF" autocomplete="off"></div>' +
+        '<button type="button" class="btn small" id="ba' + i + '">' + hx(`<#CTL_add#>`) + '</button></div>' +
+      '<div class="rbudget" id="bg' + i + '"></div><div class="svy" id="ss' + i + '"></div><div class="msg" id="am_msg' + i + '" style="margin-top:8px"></div>' +
+      '</div></div>';
+  });
+  q('bands').innerHTML = h;
+  BANDS.forEach(function(b, i){
+    if (b.locked) return;
+    if (b.auto){
+      var w = q('aw' + i), a = document.createElement('a');
+      w.textContent = `<#RNW_5#>` + ' ';
+      a.href = '/reaper_shell.asp#Reaper_WiFiSettings.asp'; a.target = '_top'; a.textContent = `<#menu5_1#>` + ' - ' + `<#Settings#>`;
+      w.appendChild(a);
+    }
+    q('s_mode' + i).value = b.mode0;
+    q('t_ap' + i).checked = b.apply0 === '1';
+    q('s_mode' + i).addEventListener('change', function(){ draw(i); });
+    q('t_ap' + i).addEventListener('change', function(){ draw(i); });
+    q('ba' + i).addEventListener('click', function(){ add(i); });
+    q('sv' + i).addEventListener('click', function(){ scan(i); });
+    q('am' + i).addEventListener('keydown', function(e){ if (e.key === 'Enter') add(i); });
+    q('pk' + i).addEventListener('change', function(){ if (this.value){ q('am' + i).value = this.value; msg('am_msg' + i, ''); } });
+    q('tb' + i).addEventListener('click', function(e){ var t = e.target;
+      if (t && t.classList && t.classList.contains('bwldel')){ b.list.splice(+t.getAttribute('data-i'), 1); draw(i); } });
+    draw(i);
+  });
+}
+function draw(i){
+  var b = BANDS[i], h = '';
+  b.list.forEach(function(m, j){
+    h += '<tr><td class="mono">' + hx(m) + '</td><td class="name" data-m="' + hx(m) + '"></td>' +
+         '<td style="text-align:right"><span class="bwldel" data-i="' + j + '" title="' + hx(`<#CTL_del#>`) + '">&times;</span></td></tr>';
+  });
+  q('tb' + i).innerHTML = h || '<tr><td colspan="3" class="empty">' + hx(`<#IPConnection_VSList_Norule#>`) + '</td></tr>';
+  Array.prototype.forEach.call(q('tb' + i).querySelectorAll('td.name'), function(td){ var s = SSID[td.getAttribute('data-m')] || ''; td.textContent = s; td.title = s; });
+  var g = q('bg' + i); g.textContent = `<#List_limit#>` + ' ' + b.list.length + ' / ' + MAX; g.classList.toggle('hot', b.list.length >= MAX);
+  var m0 = q('s_mode' + i).value === '0';
+  q('lb' + i).classList.toggle('off', m0);           /* AP only: no WDS peers (stock disabled the same controls) */
+  pickDraw(i); dirty();
+}
+function pickDraw(i){
+  var b = BANDS[i], s = q('pk' + i), have = {};
+  b.list.forEach(function(m){ have[m] = 1; });
+  while (s.options.length > 1) s.remove(1);
+  b.aps.forEach(function(a){ if (have[a.mac]) return; var o = document.createElement('option'); o.value = a.mac; o.textContent = a.label; s.appendChild(o); });
+}
+/* Reaper's site survey for this radio: svystart, then svydata until done (the radio leaves its channel briefly) */
+function scan(i){
+  var b = BANDS[i], btn = q('sv' + i), x = new XMLHttpRequest();
+  btn.disabled = true; q('ss' + i).textContent = `<#RSVY_9#>` + '...';
+  x.open('GET', '/reaper_wifi.cgi?action=svystart&unit=' + b.u + '&http_id=' + encodeURIComponent(HTTPID) + '&_=' + Date.now(), true); x.timeout = 15000;
+  x.onload = function(){
+    var r = null; try { r = JSON.parse(x.responseText); } catch (e) {}
+    if (!r || !r.ok){ btn.disabled = false; q('ss' + i).textContent = (r && (r.err === 'busy' || r.err === 'busycap')) ? `<#RSVY_12#>` : `<#RSVY_11#>`; return; }
+    var tries = 0, t = setInterval(function(){
+      var y = new XMLHttpRequest();
+      y.open('GET', '/reaper_wifi.cgi?action=svydata&http_id=' + encodeURIComponent(HTTPID) + '&_=' + Date.now(), true); y.timeout = 8000;
+      y.onload = function(){
+        var d = null; try { d = JSON.parse(y.responseText); } catch (e) {}
+        if (d && d.done){
+          clearInterval(t); btn.disabled = false;
+          b.aps = (d.aps || []).filter(function(a){ return a && +a.unit === b.u && rp.v.mac(String(a.bssid || '')); }).map(function(a){
+            var mac = String(a.bssid).toUpperCase(), ss = a.hidden ? '(' + `<#RSVY_8#>` + ')' : String(a.ssid || '');
+            if (!a.hidden) SSID[mac] = ss;
+            return {mac: mac, label: ss + ' - ' + mac + (a.rssi !== undefined ? '  ' + a.rssi + ' dBm' : ''), rssi: +a.rssi || -999};
+          }).sort(function(p, r){ return r.rssi - p.rssi; });
+          q('ss' + i).textContent = `<#RSVY_10#>` + ': ' + b.aps.length;
+          draw(i);
+        } else if (++tries > 60){ clearInterval(t); btn.disabled = false; q('ss' + i).textContent = `<#RSVY_11#>`; }
+      };
+      y.send();
+    }, 1000);
+  };
+  x.onerror = x.ontimeout = function(){ btn.disabled = false; q('ss' + i).textContent = `<#RSVY_11#>`; };
+  x.send();
+}
+function add(i){
+  var b = BANDS[i], id = 'am_msg' + i;
+  msg(id, '');
+  var m = rp.val('am' + i).toUpperCase(), e = '';
+  if (b.list.length >= MAX) e = `<#JS_itemlimit1#>` + ' ' + MAX + ' ' + `<#JS_itemlimit2#>`;
+  else if (!m) e = `<#JS_fieldblank#>`;
+  else if (!rp.v.mac(m)) e = `<#IPConnection_x_illegal_mac#>`;
+  else if (b.list.indexOf(m) >= 0) e = `<#JS_duplicate#>`;
+  if (e){ msg(id, e); q('ab' + i).classList.add('bad'); setTimeout(function(){ q('ab' + i).classList.remove('bad'); }, 4000); return; }
+  b.list.push(m); q('am' + i).value = ''; draw(i);
+}
+function post(obj){
+  var x = new XMLHttpRequest(), a = [], k;
+  for (k in obj) a.push(encodeURIComponent(k) + '=' + encodeURIComponent(obj[k]));
+  x.open('POST', '/applyapp.cgi', true); x.setRequestHeader('Content-Type', 'application/x-www-form-urlencoded'); x.timeout = 150000;
+  x.send(a.join('&'));
+}
+function apply(){
+  msg('topmsg', '');
+  var ch = changes();
+  if (!rp.count(ch)){ msg('topmsg', `<#RADM_63#>`); return; }
+  ch.action_mode = 'apply'; ch.rc_service = 'restart_wireless';
+  rp.applying(`<#Reaper_c_applying#>`, `<#RNT_62#>`);
+  post(ch); setTimeout(function(){ location.reload(); }, 15000);
+}
+q('applybtn').addEventListener('click', apply);
+q('discardbtn').addEventListener('click', function(){ BANDS.forEach(function(b){ b.list = b.list0.slice(); }); msg('topmsg', ''); render(); });
+render();
+})();
+</script>
+</body>
+</html>
diff --git a/release/src/router/www/Reaper_WPS.asp b/release/src/router/www/Reaper_WPS.asp
new file mode 100644
index 00000000000..4af5760474e
--- /dev/null
+++ b/release/src/router/www/Reaper_WPS.asp
@@ -0,0 +1,200 @@
+<!-- SPDX-License-Identifier: GPL-2.0-only
+     Copyright (C) 2026 the Reaper project maintainer
+     Part of the Reaper hardened Asuswrt-Merlin build. See LICENSE / LICENSE.reaper. -->
+<!DOCTYPE html>
+<html lang="en">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width, initial-scale=1">
+<meta name="reaper-native" content="1">
+<title>REAPER &mdash; <#menu5_1_2#></title>
+<!-- Reaper_WPS.asp - Wireless > WPS (Reaper-native UI, native wave, 2026-10-31).
+     Replaces Advanced_WWPS_Content.asp; same nvram, same requests:
+       wps_enable      "1"/"0"  -> /applyapp.cgi + restart_wireless (stock apply_new + restart_wireless)
+       wps_band_x      the WPS radio, 2.4 or 5 GHz (6 GHz cannot run WPS) -> /apply.cgi change_wps_unit, only while
+                       WPS is off (stock rule)
+       Start           /apply.cgi wps_apply: wps_band, wps_enable=1, wps_sta_pin (8 digits; "00000000" = push button)
+       Reset (OOB)     /apply.cgi wps_reset: rc reset_wps -> w_Setting=0 + restart_wireless; the WPS stack makes a new
+                       network name and key - so it asks first (stock did not)
+     Status: GET /WPS_info.xml (prebuilt ej_wps_info*): 13 <wps_info> fields, [0] state text, [1] configured Yes/No,
+     [7] AP PIN, [11] auth mode, [12] band. Stock pre-checks kept: enabling refuses a hidden network, WPA/WEP-only
+     authentication and a radio that is off; WPA3-Personal cannot run WPS. Differences: the client PIN must be the
+     8 digits the router accepts (stock also let 4 digits through, which httpd then dropped without a word); the
+     WPA3 hint works for a lone 5 GHz radio (stock's band-name switch missed it); one band request, not two. -->
+<link rel="stylesheet" href="/reaper/rp.css">
+<style>
+.msg{font-size:12.5px;color:var(--amber);display:none}
+.frow select{min-width:200px}
+.frow input.pin{width:130px}
+.fv{font-family:var(--hdr);font-weight:600;color:var(--bone)}
+.fv.mono{font-family:var(--mono);font-weight:400}
+.warnline{font-size:12.5px;color:var(--amber);line-height:1.55;margin:8px 0 0}
+/* dim the contents, never the panel: a translucent panel lets the page's crimson frame show through it */
+.off{pointer-events:none}
+.off>*{opacity:.45}
+.radios{display:flex;gap:18px;flex-wrap:wrap;align-items:center}
+.radios label{display:inline-flex;gap:6px;align-items:center;cursor:pointer}
+.spin{display:inline-block;width:10px;height:10px;border-radius:50%;border:2px solid var(--line);border-top-color:var(--crimson);animation:sp 1s linear infinite;margin-left:8px;vertical-align:middle}
+@keyframes sp{to{transform:rotate(360deg)}}
+</style>
+</head>
+<body>
+<script src="/reaper_util.js"></script>
+<script src="/reaper/rp.js"></script>
+
+<div class="syswrap">
+<div class="pagehead">
+  <div>
+    <div class="eyebrow"><#menu5_1#></div>
+    <h1><#menu5_1_2#></h1>
+  </div>
+  <div class="spacer"></div>
+</div>
+<div class="msg" id="topmsg" style="margin:-6px 0 12px"></div>
+<div class="hint" style="margin:-4px 0 14px"><#WLANConfig11b_display6_sectiondesc#></div>
+
+<div class="rframe">
+<div class="panel" id="p_main">
+  <div class="togglerow"><label class="tswitch"><input type="checkbox" id="t_on"><span class="track"></span></label><div><#WLANConfig11b_x_WPS_itemname#></div></div>
+  <div class="frow"><div class="fl"><#Current_band#></div><div class="fc"><select id="s_band"></select></div><div class="fh" id="bandhint"></div></div>
+  <div class="frow"><div class="fl"><#PPPConnection_x_WANLink_itemname#></div><div class="fc"><span class="fv" id="v_state">&mdash;</span><span class="spin" id="v_spin" style="display:none"></span></div></div>
+  <div class="frow"><div class="fl"><#wireless_configured#></div><div class="fc"><span class="fv" id="v_conf">&mdash;</span>
+    <button type="button" class="btn small ghost" id="b_reset" style="display:none"><#CTL_Reset_OOB#></button></div>
+    <div class="fh" id="resetdesc" style="display:none"><#WLANConfig11b_x_ResetWPS_desc#></div></div>
+  <div class="frow"><div class="fl"><#WLANConfig11b_x_DevicePIN_itemname#></div><div class="fc"><span class="fv mono" id="v_pin">&mdash;</span></div></div>
+  <div class="warnline" id="w_band" style="display:none"></div>
+</div>
+
+<div class="panel" id="p_add">
+  <div class="frow"><div class="fl"><#WLANConfig11b_x_WPSMode_itemname#></div><div class="fc radios">
+    <label><input type="radio" name="wps_method" value="0" checked><#WLANConfig11b_x_WPS_pushbtn#></label>
+    <label><input type="radio" name="wps_method" value="1"><#WLANConfig11b_x_WPSPIN_itemname#></label>
+    <input type="text" class="pin mono" id="i_pin" maxlength="9" inputmode="numeric" autocomplete="off" placeholder="12345670" style="display:none">
+    <button type="button" class="btn primary small" id="b_start"><#wps_start_btn#></button> <span class="msg" id="addmsg"></span>
+  </div></div>
+</div>
+</div>
+</div>
+
+<div class="applying" id="applying"><div class="abox"><h2 id="ap_t"><#Reaper_c_applying#></h2><p id="ap_p"><#RNT_62#></p></div></div>
+
+<script>
+(function(){
+'use strict';
+var q = rp.q, hx = rp.esc;
+var NB = [<% nvram_get_js("wl0_nband"); %>, <% nvram_get_js("wl1_nband"); %>, <% nvram_get_js("wl2_nband"); %>, <% nvram_get_js("wl3_nband"); %>];
+var IFN = <% nvram_get_js("wl_ifnames"); %>.trim().split(/\s+/).filter(Boolean);
+var NV = {
+  wps_enable: <% nvram_get_js("wps_enable"); %>, wps_band_x: <% nvram_get_js("wps_band_x"); %>, wps_sta_pin: <% nvram_get_js("wps_sta_pin"); %>,
+  wl0_closed: <% nvram_get_js("wl0_closed"); %>, wl0_radio: <% nvram_get_js("wl0_radio"); %>, wl0_auth_mode_x: <% nvram_get_js("wl0_auth_mode_x"); %>, wl0_wep_x: <% nvram_get_js("wl0_wep_x"); %>,
+  wl1_closed: <% nvram_get_js("wl1_closed"); %>, wl1_radio: <% nvram_get_js("wl1_radio"); %>, wl1_auth_mode_x: <% nvram_get_js("wl1_auth_mode_x"); %>, wl1_wep_x: <% nvram_get_js("wl1_wep_x"); %>,
+  wl2_closed: <% nvram_get_js("wl2_closed"); %>, wl2_radio: <% nvram_get_js("wl2_radio"); %>, wl2_auth_mode_x: <% nvram_get_js("wl2_auth_mode_x"); %>, wl2_wep_x: <% nvram_get_js("wl2_wep_x"); %>
+};
+var ON = NV.wps_enable === '1';
+var poll = null;
+
+/* WPS radios: 2.4 and 5 GHz units (stock leaves 6 GHz out - rc never runs WPS there) */
+var BANDS = (function(){
+  var out = [], n5 = 0, c5 = NB.filter(function(b){ return b === '1'; }).length;
+  for (var u = 0; u < (IFN.length || 4) && u < 3; u++){
+    if (NB[u] === '2') out.push({u: u, title: '2.4 GHz'});
+    else if (NB[u] === '1'){ n5++; out.push({u: u, title: c5 > 1 ? '5 GHz-' + n5 : '5 GHz'}); }
+  }
+  return out;
+})();
+function band(){ var u = +q('s_band').value; return BANDS.filter(function(b){ return b.u === u; })[0] || BANDS[0]; }
+function msg(id, t){ var m = q(id); m.textContent = t || ''; m.style.display = t ? (id === 'addmsg' ? 'inline' : 'block') : 'none'; }
+/* why the chosen radio cannot run WPS ('' = it can); stock enableWPS() checks, in its order */
+function blocker(b){
+  var p = 'wl' + b.u + '_', am = NV[p + 'auth_mode_x'], wep = NV[p + 'wep_x'];
+  if (NV[p + 'closed'] === '1') return b.title + ': ' + `<#note_hide_SSID_WPS#>`;
+  if (/^(shared|psk|wpa|wpa2|wpawpa2)$/.test(am) || (am === 'open' && (wep === '1' || wep === '2'))) return b.title + ': ' + `<#note_auth_wpa_WPS#>`;
+  if (NV[p + 'radio'] === '0') return `<#note_turn_wifi_on_WPS#>`;
+  if (/^(sae|wpa3|suite-b)$/.test(am)) return b.title + ': ' + `<#wireless_JS_WPS_fail_WPA3P#>`;
+  return '';
+}
+function form(o){ var a = [], k; for (k in o) a.push(encodeURIComponent(k) + '=' + encodeURIComponent(o[k])); return a.join('&'); }
+function xpost(url, body, cb){
+  var x = new XMLHttpRequest();
+  x.open('POST', url, true); x.setRequestHeader('Content-Type', 'application/x-www-form-urlencoded'); x.timeout = 30000;
+  x.onloadend = function(){ if (cb) cb(); };
+  x.send(body);
+}
+function busy(t, after){ rp.applying(`<#Reaper_c_applying#>`, t || `<#RNT_62#>`); setTimeout(function(){ location.reload(); }, after || 12000); }
+
+function paint(){
+  var b = band(), why = blocker(b);
+  q('s_band').disabled = ON;
+  q('bandhint').textContent = ON ? `<#WLANConfig11b_x_WPSband_hint#>` : '';
+  var w = q('w_band'); w.textContent = why; w.style.display = why ? 'block' : 'none';
+  q('p_add').classList.toggle('off', !ON || !!why);
+}
+/* status: the prebuilt /WPS_info.xml, polled while the page is open */
+function status(){
+  var x = new XMLHttpRequest();
+  x.open('GET', '/WPS_info.xml?_=' + Date.now(), true); x.timeout = 8000;
+  x.onload = function(){
+    var d = x.responseXML, f = d ? d.getElementsByTagName('wps_info') : [], v = [], i;
+    for (i = 0; i < f.length; i++) v.push(f[i].textContent || '');
+    if (v.length < 13) return;
+    var st = ON ? v[0] : `<#wps_state_not_used#>`;
+    q('v_state').textContent = st;
+    q('v_spin').style.display = ON && v[0] === 'Start WPS Process' ? '' : 'none';
+    q('v_conf').textContent = v[1] === 'Yes' ? `<#checkbox_Yes#>` : v[1] === 'No' ? `<#checkbox_No#>` : v[1];
+    var canReset = ON && v[1] === 'Yes';
+    q('b_reset').style.display = canReset ? '' : 'none'; q('resetdesc').style.display = canReset ? '' : 'none';
+    q('v_pin').textContent = /^\d{4,8}$/.test(v[7]) ? v[7] : '-';
+  };
+  x.send();
+}
+/* client PIN: one space or hyphen in the middle allowed; 8 digits with a valid checksum (httpd takes nothing else) */
+function pinOk(s){
+  s = String(s || '').trim().replace(/^(\d{4})[ -](\d{4})$/, '$1$2');
+  if (!/^\d{8}$/.test(s)) return '';
+  var sum = 0, i; for (i = 0; i < 8; i++) sum += (+s.charAt(i)) * (i % 2 ? 1 : 3);
+  return sum % 10 === 0 ? s : '';
+}
+
+BANDS.forEach(function(b){ var o = document.createElement('option'); o.value = b.u; o.textContent = b.title; q('s_band').appendChild(o); });
+if (!rp.pick(q('s_band'), NV.wps_band_x) && BANDS.length) q('s_band').value = String(BANDS[0].u);
+q('t_on').checked = ON;
+
+q('t_on').addEventListener('change', function(){
+  msg('topmsg', '');
+  var want = this.checked, why = want ? blocker(band()) : '';
+  if (why){ this.checked = !want; msg('topmsg', why); return; }
+  xpost('/applyapp.cgi', form({wps_enable: want ? '1' : '0', action_mode: 'apply', rc_service: 'restart_wireless'}));
+  busy();
+});
+q('s_band').addEventListener('change', function(){
+  msg('topmsg', '');
+  if (ON){ rp.pick(this, NV.wps_band_x); msg('topmsg', `<#WLANConfig11b_x_WPSband_hint#>`); return; }
+  var u = this.value;
+  xpost('/apply.cgi', form({action_mode: 'change_wps_unit', action_script: '', action_wait: '1', current_page: 'Reaper_WPS.asp', next_page: '', wps_band: u}),
+    function(){ NV.wps_band_x = u; paint(); });
+  paint();
+});
+Array.prototype.forEach.call(document.querySelectorAll('input[name=wps_method]'), function(r){
+  r.addEventListener('change', function(){ q('i_pin').style.display = this.value === '1' && this.checked ? '' : 'none'; msg('addmsg', ''); });
+});
+q('b_start').addEventListener('click', function(){
+  msg('addmsg', '');
+  var b = band(), why = blocker(b); if (why){ msg('addmsg', why); return; }
+  var pbc = document.querySelector('input[name=wps_method]:checked').value === '0', pin = pbc ? '00000000' : pinOk(q('i_pin').value);
+  if (!pin){ msg('addmsg', `<#JS_InvalidPIN#>`); q('i_pin').focus(); return; }
+  xpost('/apply.cgi', form({action_mode: 'wps_apply', action_script: '', action_wait: '1', current_page: 'Reaper_WPS.asp', next_page: '',
+    wps_band: String(b.u), wps_enable: '1', wps_sta_pin: pin}), function(){ status(); });
+  q('v_state').textContent = 'Start WPS Process'; q('v_spin').style.display = '';
+});
+q('b_reset').addEventListener('click', function(){
+  if (!confirm(`<#WLANConfig11b_x_ResetWPS_desc#>`)) return;
+  xpost('/apply.cgi', form({action_mode: 'wps_reset', action_script: '', action_wait: '5', current_page: 'Reaper_WPS.asp', next_page: '', wps_band: String(band().u)}));
+  busy(`<#RNT_62#>`, 15000);
+});
+/* stock method default: a stored PIN that is not the PBC value means the PIN method was last used */
+if (pinOk(NV.wps_sta_pin) && NV.wps_sta_pin !== '00000000'){ document.querySelector('input[name=wps_method][value="1"]').checked = true; q('i_pin').style.display = ''; }
+paint(); status(); poll = setInterval(status, 3000);
+})();
+</script>
+</body>
+</html>
