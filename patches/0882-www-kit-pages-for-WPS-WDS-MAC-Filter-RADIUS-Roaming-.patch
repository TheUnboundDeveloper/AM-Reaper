+<meta name="viewport" content="width=device-width, initial-scale=1">
+<meta name="reaper-native" content="1">
+<title>REAPER &mdash; <#menu5_1_4#></title>
+<!-- Reaper_MACFilter.asp - Wireless > Wireless MAC Filter (Reaper-native UI, native wave, 2026-10-31).
+     Replaces Advanced_ACL_Content.asp; same nvram, same apply. Per radio unit N (primary network only, as stock):
+       wlN_macmode      "disabled" | "allow" (Accept: only the list may join) | "deny" (Reject: the list may not)
+       wlN_maclist_x    "<MAC<MAC..." upper case, at most 64 (stock page cap)
+     Consumer: init-broadcom.c generate_wl_para turns the list into wlN_maclist for the driver ACL (wlconf, closed).
+     PROVEN on the owner's RT-BE96U (2026-10-31, lab): wl0_macmode=deny + a list, restart_wireless -> the driver
+     enforced it (wl macmode 1, the MAC loaded); the MAINFH apm row stayed "disabled" and did not overwrite the
+     wlN_ keys - so this page owns wlN_ as stock does. Guest Network Pro networks keep their own filter on the
+     Network (SDN) page. Apply = /applyapp.cgi with rc_service restart_wireless (stock), only changed keys.
+     Differences from stock, on purpose: every radio on one page (stock switched the global wl_unit through a
+     form post); changing Accept/Reject keeps the list (stock emptied it); Accept with an empty list is refused
+     (it would lock every wireless device out; stock refused it with a message about the login client); the page
+     reloads after the apply so the result shows (stock kept showing its local copy); names via ReaperNames, as
+     text. A band the router uses as its repeater uplink (Repeater / Media Bridge mode) is not editable (stock). -->
+<link rel="stylesheet" href="/reaper/rp.css">
+<style>
+.bwl-add input.mac{width:170px}
+.bwl-add select{min-width:240px;max-width:100%}
+.bwl-add.bad input{border-color:var(--crimson)}
+.msg{font-size:12.5px;color:var(--amber);display:none}
+.off{opacity:.45;pointer-events:none}
+.listbox{margin-top:10px}
+.rtab td{padding:7px 10px;border-bottom:1px solid var(--line-soft);color:var(--bone-dim);vertical-align:middle}
+.rtab td.mono{font-family:var(--mono)}
+.rtab td.name{max-width:280px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
+.frow select{min-width:200px}
+.panel.bad{border-color:var(--crimson)}
+</style>
+</head>
+<body>
+<script src="/reaper_util.js"></script>
+<script src="/reaper/rp.js"></script>
+
+<div class="syswrap">
+<div class="pagehead">
+  <div>
+    <div class="eyebrow"><#menu5_1#></div>
+    <h1><#menu5_1_4#></h1>
+  </div>
+  <div class="spacer"></div>
+  <span class="pill warn chgpill" id="chgpill"><span class="dot"></span><span><#RADM_77#>: <b id="chgcount">0</b></span></span>
+  <button type="button" class="btn ghost" id="discardbtn" disabled><#Discard#></button>
+  <button type="button" class="btn primary" id="applybtn"><#CTL_apply#></button>
+</div>
+<div class="msg" id="topmsg" style="margin:-6px 0 12px"></div>
+<div class="hint" style="margin:-4px 0 14px"><#DeviceSecurity11a_display1_sectiondesc#></div>
+<div class="rframe" id="bands"></div>
+</div>
+
+<div class="applying" id="applying"><div class="abox"><h2 id="ap_t"><#Reaper_c_applying#></h2><p id="ap_p"><#RNT_62#></p></div></div>
+
+<script>
+(function(){
+'use strict';
+var q = rp.q, hx = rp.esc, U = rp.dec;
+var MAX = 64;                                        /* stock addRow(obj, 64) */
+var NB = [<% nvram_get_js("wl0_nband"); %>, <% nvram_get_js("wl1_nband"); %>, <% nvram_get_js("wl2_nband"); %>, <% nvram_get_js("wl3_nband"); %>];
+var IFN = <% nvram_get_js("wl_ifnames"); %>.trim().split(/\s+/).filter(Boolean);
+var SW_MODE = <% nvram_get_js("sw_mode"); %>, WLC_BAND = <% nvram_get_js("wlc_band"); %>;
+var NV = {
+  wl0_macmode: <% nvram_get_js("wl0_macmode"); %>, wl0_maclist_x: U('<% nvram_char_to_ascii("","wl0_maclist_x"); %>'),
+  wl1_macmode: <% nvram_get_js("wl1_macmode"); %>, wl1_maclist_x: U('<% nvram_char_to_ascii("","wl1_maclist_x"); %>'),
+  wl2_macmode: <% nvram_get_js("wl2_macmode"); %>, wl2_maclist_x: U('<% nvram_char_to_ascii("","wl2_maclist_x"); %>'),
+  wl3_macmode: <% nvram_get_js("wl3_macmode"); %>, wl3_maclist_x: U('<% nvram_char_to_ascii("","wl3_maclist_x"); %>')
+};
+var DEVS = [];
+
+/* the radios present, titled as the Wireless pages title them (5 / 6 GHz numbered when there are two) */
+var BANDS = (function(){
+  var out = [], n5 = 0, n6 = 0, c5 = NB.filter(function(b){ return b === '1'; }).length, c6 = NB.filter(function(b){ return b === '4'; }).length;
+  for (var u = 0; u < (IFN.length || 4) && u < 4; u++){   /* no wl_ifnames: every unit that reports a band */
+    var b = NB[u], t = '';
+    if (b === '2') t = '2.4 GHz';
+    else if (b === '1'){ n5++; t = c5 > 1 ? '5 GHz-' + n5 : '5 GHz'; }
+    else if (b === '4'){ n6++; t = c6 > 1 ? '6 GHz-' + n6 : '6 GHz'; }
+    if (t) out.push({u: u, title: t});
+  }
+  return out;
+})();
+function macs(s){ var out = [], seen = {}; String(s || '').split('<').forEach(function(m){ m = m.trim().toUpperCase(); if (rp.v.mac(m) && !seen[m]){ seen[m] = 1; out.push(m); } }); return out; }
+BANDS.forEach(function(b){
+  var mode = NV['wl' + b.u + '_macmode'];
+  b.mode0 = mode === 'allow' || mode === 'deny' ? mode : 'disabled';
+  b.list0 = macs(NV['wl' + b.u + '_maclist_x']).slice(0, MAX);
+  b.list = b.list0.slice();
+  /* Repeater / Media Bridge: the uplink band carries no clients of its own (stock hides the page for it) */
+  b.locked = (SW_MODE === '2' || SW_MODE === '4') && String(b.u) === WLC_BAND;
+});
+
+function msg(id, t){ var m = q(id); if (!m) return; m.textContent = t || ''; m.style.display = t ? 'block' : 'none'; }
+function curMode(i){ return q('t_on' + i).checked ? q('s_mode' + i).value : 'disabled'; }
+function listChanged(b){ return b.list.join('<') !== b.list0.join('<'); }
+function changes(){
+  var ch = {};
+  BANDS.forEach(function(b, i){
+    if (b.locked) return;
+    var m = curMode(i);
+    if (m !== b.mode0) ch['wl' + b.u + '_macmode'] = m;
+    if (listChanged(b)) ch['wl' + b.u + '_maclist_x'] = b.list.map(function(x){ return '<' + x; }).join('');
+  });
+  return ch;
+}
+function dirty(){ rp.pill(rp.count(changes())); }
+
+function render(){
+  var h = '';
+  BANDS.forEach(function(b, i){
+    h += '<div class="panel" id="p' + i + '"><h2>' + hx(b.title) + '</h2>';
+    if (b.locked){ h += '<div class="sub">' + hx(`<#page_not_support_mode_hint#>`) + '</div></div>'; return; }
+    h += '<div class="togglerow"><label class="tswitch"><input type="checkbox" id="t_on' + i + '"><span class="track"></span></label><div>' + hx(`<#enable_macmode#>`) + '</div></div>' +
+      '<div class="listbox" id="lb' + i + '">' +
+      '<div class="frow"><div class="fl">' + hx(`<#FirewallConfig_MFMethod_itemname#>`) + '</div><div class="fc"><select id="s_mode' + i + '">' +
+        '<option value="allow">' + hx(`<#FirewallConfig_MFMethod_item1#>`) + '</option><option value="deny">' + hx(`<#FirewallConfig_MFMethod_item2#>`) + '</option></select></div>' +
+        '<div class="fh">' + hx(`<#RNW_2#>`) + '</div></div>' +
+      '<table class="rtab"><thead><tr><th>' + hx(`<#Clientlist_device#>`) + '</th><th>' + hx(`<#MAC_Address#>`) + '</th><th></th></tr></thead><tbody id="tb' + i + '"></tbody></table>' +
+      '<div class="bwl-add" id="ab' + i + '">' +
+        '<div class="f"><label>' + hx(`<#Clientlist_device#>`) + '</label><select id="pk' + i + '" title="' + hx(`<#select_wireless_MAC#>`) + '"><option value="">' + hx(`<#Select_menu_default#>`) + '</option></select></div>' +
+        '<div class="f"><label>' + hx(`<#MAC_Address#>`) + '</label><input type="text" class="mac mono" id="am' + i + '" maxlength="17" placeholder="AA:BB:CC:DD:EE:FF" autocomplete="off"></div>' +
+        '<button type="button" class="btn small" id="ba' + i + '">' + hx(`<#CTL_add#>`) + '</button></div>' +
+      '<div class="rbudget" id="bg' + i + '"></div><div class="msg" id="am_msg' + i + '" style="margin-top:8px"></div>' +
+      '</div></div>';
+  });
+  q('bands').innerHTML = h;
+  BANDS.forEach(function(b, i){
+    if (b.locked) return;
+    q('t_on' + i).checked = b.mode0 !== 'disabled';
+    q('s_mode' + i).value = b.mode0 === 'deny' ? 'deny' : 'allow';   /* stock shows Accept for a disabled filter */
+    q('t_on' + i).addEventListener('change', function(){ draw(i); });
+    q('s_mode' + i).addEventListener('change', function(){ dirty(); });   /* the list stays (stock emptied it) */
+    q('ba' + i).addEventListener('click', function(){ add(i); });
+    q('am' + i).addEventListener('keydown', function(e){ if (e.key === 'Enter') add(i); });
+    q('am' + i).addEventListener('input', function(){ if (!rp.pick(q('pk' + i), rp.val('am' + i).toUpperCase())) q('pk' + i).value = ''; });
+    q('pk' + i).addEventListener('change', function(){ if (this.value){ q('am' + i).value = this.value; msg('am_msg' + i, ''); } });
+    q('tb' + i).addEventListener('click', function(e){ var t = e.target;
+      if (t && t.classList && t.classList.contains('bwldel')){ b.list.splice(+t.getAttribute('data-i'), 1); draw(i); } });
+    draw(i);
+  });
+}
+function draw(i){
+  var b = BANDS[i], h = '';
+  b.list.forEach(function(m, j){
+    h += '<tr><td class="name" data-m="' + hx(m) + '"></td><td class="mono">' + hx(m) + '</td>' +
+         '<td style="text-align:right"><span class="bwldel" data-i="' + j + '" title="' + hx(`<#CTL_del#>`) + '">&times;</span></td></tr>';
+  });
+  q('tb' + i).innerHTML = h || '<tr><td colspan="3" class="empty">' + hx(`<#IPConnection_VSList_Norule#>`) + '</td></tr>';
+  var g = q('bg' + i); g.textContent = `<#List_limit#>` + ' ' + b.list.length + ' / ' + MAX; g.classList.toggle('hot', b.list.length >= MAX);
+  q('lb' + i).classList.toggle('off', !q('t_on' + i).checked);
+  q('p' + i).classList.remove('bad');
+  names(); pickDraw(i); dirty();
+}
+/* device names are client-chosen: text only */
+function names(){
+  Array.prototype.forEach.call(document.querySelectorAll('#bands td.name'), function(td){
+    var n = ReaperNames.byMac(td.getAttribute('data-m'), ''); td.textContent = n; td.title = n;
+  });
+}
+function pickDraw(i){
+  var b = BANDS[i], s = q('pk' + i), have = {};
+  if (!s) return;
+  b.list.forEach(function(m){ have[m] = 1; });
+  while (s.options.length > 1) s.remove(1);
+  DEVS.forEach(function(d){ if (have[d.mac]) return; var o = document.createElement('option'); o.value = d.mac; o.textContent = d.label; s.appendChild(o); });
+  if (!rp.pick(s, rp.val('am' + i).toUpperCase())) s.value = '';
+}
+/* wireless clients online now (networkmap isWL != 0), as the stock picker's 'wl' list */
+function devLoad(){
+  try {
+    ReaperNames.refresh('<% nvram_char_to_ascii("", "custom_clientlist"); %>', function(cl){
+      var ml = (cl && cl.maclist) || [], out = [];
+      ml.forEach(function(mac){ var c = cl[mac], m = String(mac).toUpperCase(), nm;
+        if (!c || !rp.v.mac(m) || String(c.isOnline) === '0' || !c.isWL || String(c.isWL) === '0') return;
+        nm = ReaperNames.byMac(mac, m);
+        out.push({mac: m, label: (nm !== m ? nm + ' - ' : '') + m}); });
+      out.sort(function(a, b){ return a.label.toLowerCase() < b.label.toLowerCase() ? -1 : 1; });
+      DEVS = out; names(); BANDS.forEach(function(b, i){ if (!b.locked) pickDraw(i); });
+    });
+  } catch (e) {}
+}
+function add(i){
+  var b = BANDS[i], id = 'am_msg' + i;
+  msg(id, '');
+  var m = rp.val('am' + i).toUpperCase(), e = '';
+  if (b.list.length >= MAX) e = `<#JS_itemlimit1#>` + ' ' + MAX + ' ' + `<#JS_itemlimit2#>`;
+  else if (!m) e = `<#JS_fieldblank#>`;
+  else if (!rp.v.mac(m)) e = `<#IPConnection_x_illegal_mac#>`;
+  else if (b.list.indexOf(m) >= 0) e = `<#JS_duplicate#>`;
+  if (e){ msg(id, e); q('ab' + i).classList.add('bad'); setTimeout(function(){ q('ab' + i).classList.remove('bad'); }, 4000); return; }
+  b.list.push(m); q('am' + i).value = ''; draw(i);
+}
+
+function post(obj){
+  var x = new XMLHttpRequest(), a = [], k;
+  for (k in obj) a.push(encodeURIComponent(k) + '=' + encodeURIComponent(obj[k]));
+  x.open('POST', '/applyapp.cgi', true); x.setRequestHeader('Content-Type', 'application/x-www-form-urlencoded'); x.timeout = 150000;
+  x.send(a.join('&'));
+}
+function apply(){
+  msg('topmsg', '');
+  /* Accept with an empty list admits nobody: every wireless device on that band would be cut off */
+  var lock = -1;
+  BANDS.forEach(function(b, i){ if (lock < 0 && !b.locked && curMode(i) === 'allow' && !b.list.length) lock = i; });
+  if (lock >= 0){ q('p' + lock).classList.add('bad'); msg('topmsg', BANDS[lock].title + ': ' + `<#RNW_1#>`); q('am' + lock).focus(); return; }
+  var ch = changes();
+  if (!rp.count(ch)){ msg('topmsg', `<#RADM_63#>`); return; }
+  ch.action_mode = 'apply'; ch.rc_service = 'restart_wireless';
+  rp.applying(`<#Reaper_c_applying#>`, `<#RNT_62#>`);
+  post(ch); setTimeout(function(){ location.reload(); }, 15000);
+}
+
+q('applybtn').addEventListener('click', apply);
+q('discardbtn').addEventListener('click', function(){ BANDS.forEach(function(b){ b.list = b.list0.slice(); }); msg('topmsg', ''); render(); });
+render(); devLoad();
+})();
+</script>
+</body>
+</html>
