@@ -115,6 +115,24 @@ function adjust_TM_eula_height(_objID) {
 	}
 }
 function adjust_panel_block_top(_objID, _offsetHeight) {
+	/* reaper 2026-11-01 (owner, AiMesh client card "opens near the top of the page"): inside reaper_shell.asp this
+	   page never scrolls - the shell grows its frame to the content and the browser window scrolls instead - so
+	   the scrollTop below is always 0 and every panel landed at the top of the page wherever the user was. The
+	   shell publishes the slice of this page the user can see as --rv-top / --rv-h on <html> (reaper_shell.asp,
+	   anchorNow). Centre the panel in that slice; a panel taller than the slice starts at its top plus the
+	   caller's offset. Measured against the panel's containing block (the AiMesh card is appended next to the
+	   client panel, not to <body>). Outside the shell the variables are absent and the stock code runs. */
+	try { if (window.parent !== window && typeof parent.reaperAnchorNow === "function") parent.reaperAnchorNow(); } catch (e) {}
+	const rvEl = document.getElementById(_objID);
+	const rvS = document.documentElement.style;
+	const rvTop = parseFloat(rvS.getPropertyValue("--rv-top")), rvH = parseFloat(rvS.getPropertyValue("--rv-h"));
+	if (rvEl && !isNaN(rvTop) && !isNaN(rvH)) {
+		const cb = rvEl.offsetParent;
+		const cbTop = (cb && getComputedStyle(cb).position !== "static") ? cb.getBoundingClientRect().top + (window.pageYOffset || 0) : 0;
+		const want = rvTop + Math.max(_offsetHeight, (rvH - rvEl.offsetHeight) / 2);
+		rvEl.style.setProperty("top", Math.round(want - cbTop) + "px", "important");
+		return;
+	}
 	const getScrollTop = () => {
 		if(isSupport("UI4")){
 			return top.document.querySelector("article.main-content").scrollTop;
diff --git a/release/src/router/www/reaper/fit.js b/release/src/router/www/reaper/fit.js
index 7c47e490486..6d549ac9049 100644
--- a/release/src/router/www/reaper/fit.js
+++ b/release/src/router/www/reaper/fit.js
@@ -204,10 +204,18 @@
 		for (i = 0; i < cand.length; i++) {
 			el = cand[i];
 			if (!el.isConnected || !el.getClientRects().length) continue;
+			/* 2026-10-31 (owner, iPhone 17 portrait): a group marked data-rfit-keep (the header's ? / Reboot / Logout)
+			   is never squeezed for some other element's overflow. On the dashboard the nearest clipping ancestor of
+			   the header is the page body, so any live tile that spilled past a phone screen for a moment shrank the
+			   two buttons, and they sprang back on the next pass - the bounce. Its own CSS sizes and cuts it. */
+			if (el.closest && el.closest('[data-rfit-keep]')) continue;
 			/* an item its page says must not shrink (flex-shrink 0 in a flex row: a data value) is left whole */
 			if (el.parentElement && /flex/.test(win.getComputedStyle(el.parentElement).display) &&
 			    win.getComputedStyle(el).flexShrink === '0') continue;
 			a = clipAncestor(win, el); if (!a || a.scrollWidth - a.clientWidth <= 1) continue;
+			/* 2026-10-31 (owner, phones): a table that rp.css shows as a sideways-scrolling block under 680 px pans
+			   by design - its headers are never cut to squeeze it into the phone */
+			if (a.tagName === 'TABLE' && win.getComputedStyle(a).display === 'block') continue;
 			if (!groups.has(a)) groups.set(a, []);
 			groups.get(a).push(el);
 		}
diff --git a/release/src/router/www/reaper/rp.css b/release/src/router/www/reaper/rp.css
