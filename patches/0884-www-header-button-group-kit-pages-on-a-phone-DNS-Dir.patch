+
+/* phones (owner, 2026-10-31): the shell gives a framed page the full screen width under 680 px, and the
+   two-column settings row could not shrink below 200 + 22 + 160 px plus the padding round it - so the shell
+   widened the frame and every native page panned sideways. Under 680 px a row stacks its label over its
+   control, and the body and panel padding tighten. Last in the file, so it wins over the base rules above. */
+@media (max-width:680px){
+  body{padding:14px 12px 48px}
+  .panel{padding:14px 14px}
+  .frow{grid-template-columns:minmax(0,1fr);gap:6px}
+  .frow .fh{margin-top:0}
+  /* a data table with more columns than a phone holds scrolls sideways in its own box (only table.classes: a
+     table shown as a block shrinks to its content, so a short list would stop filling its panel). It lays out
+     at its narrowest, so its headers keep to one line; fit.js leaves them whole (the table pans, nothing is cut) */
+  table.classes{display:block;max-width:100%;overflow-x:auto;-webkit-overflow-scrolling:touch}
+  table.classes th{white-space:nowrap}
+  table.classes td.empty{text-align:left}   /* centred across the scroll width, it ran past the screen */
+  /* an add-row field never runs wider than the panel (a picker is as wide as its longest option) */
+  .bwl-add .f,.bwl-add input,.bwl-add select{max-width:100%}
+}
