+/* reaper_lists.h - the addresses of Dreadwatch's and Wallguard's built-in lists, in ONE place.
+ * rc downloads from them (rwarden.c RW_DFEEDS in the generated update script, wallguard.c presets[]);
+ * httpd hands the same strings to the pages (<% reaper_list_urls(); %>), which show each list's
+ * address on its row so a list can be read before it is ticked (forum request, 2026-11-02).
+ * Plain string defines on purpose: the host tests lift rwarden.c's script with a #define reader.
+ * ThreatFox has no address: it is a snapshot bundled with the firmware (abuse.ch closed its free
+ * downloads on 2026-10-21). */
+#ifndef REAPER_LISTS_H
+#define REAPER_LISTS_H
+
+/* Dreadwatch: free, keyless lists on global CDNs, in RW_DIDS order (rc/rwarden.c) */
+#define RDW_URL_URLHAUS		"https://malware-filter.gitlab.io/malware-filter/urlhaus-filter-hosts.txt"
+#define RDW_URL_PHISH		"https://malware-filter.gitlab.io/malware-filter/phishing-filter-hosts.txt"
+#define RDW_URL_C2		"https://raw.githubusercontent.com/drb-ra/C2IntelFeeds/master/feeds/domainC2s.csv"
+#define RDW_URL_CRYPTO		"https://v.firebog.net/hosts/Prigent-Crypto.txt"
+#define RDW_URL_RANSOM		"https://blocklistproject.github.io/Lists/ransomware.txt"
+#define RDW_URL_CERTPL		"https://hole.cert.pl/domains/v2/domains_hosts.txt"
+#define RDW_URL_THREATVIEW	"https://threatview.io/Downloads/DOMAIN-High-Confidence-Feed.txt"
+
+#define RDW_LIST(X) \
+	X("urlhaus", RDW_URL_URLHAUS) \
+	X("phish", RDW_URL_PHISH) \
+	X("c2", RDW_URL_C2) \
+	X("crypto", RDW_URL_CRYPTO) \
+	X("ransom", RDW_URL_RANSOM) \
+	X("certpl", RDW_URL_CERTPL) \
+	X("threatview", RDW_URL_THREATVIEW)
+
+/* Wallguard presets (rc/wallguard.c presets[]; a preset's bit never changes - profiles store masks) */
+#define RWG_URL_HAGEZI_LIGHT	"https://raw.githubusercontent.com/hagezi/dns-blocklists/main/adblock/light.txt"
+#define RWG_URL_HAGEZI_NORMAL	"https://raw.githubusercontent.com/hagezi/dns-blocklists/main/adblock/multi.txt"
+#define RWG_URL_HAGEZI_PRO	"https://raw.githubusercontent.com/hagezi/dns-blocklists/main/adblock/pro.txt"
+#define RWG_URL_HAGEZI_PROPLUS	"https://raw.githubusercontent.com/hagezi/dns-blocklists/main/adblock/pro.plus.txt"
+#define RWG_URL_OISD_SMALL	"https://small.oisd.nl/"
+#define RWG_URL_OISD_BIG	"https://big.oisd.nl/"
+#define RWG_URL_STEVENBLACK	"https://raw.githubusercontent.com/StevenBlack/hosts/master/hosts"
+#define RWG_URL_ADGUARD_DNS	"https://adguardteam.github.io/AdGuardSDNSFilter/Filters/filter.txt"
+#define RWG_URL_HAGEZI_TIF	"https://raw.githubusercontent.com/hagezi/dns-blocklists/main/adblock/tif.medium.txt"
+
+#define RWG_LIST(X) \
+	X("hagezi_light", RWG_URL_HAGEZI_LIGHT) \
+	X("hagezi_normal", RWG_URL_HAGEZI_NORMAL) \
+	X("hagezi_pro", RWG_URL_HAGEZI_PRO) \
+	X("hagezi_proplus", RWG_URL_HAGEZI_PROPLUS) \
+	X("oisd_small", RWG_URL_OISD_SMALL) \
+	X("oisd_big", RWG_URL_OISD_BIG) \
+	X("stevenblack", RWG_URL_STEVENBLACK) \
+	X("adguard_dns", RWG_URL_ADGUARD_DNS) \
+	X("hagezi_tif", RWG_URL_HAGEZI_TIF)
