index ef740e192d9..d96479243d6 100644
--- a/release/src/router/wallguard/wallguard.sh
+++ b/release/src/router/wallguard/wallguard.sh
@@ -340,6 +340,27 @@ fetch() {
   return 0
 }
 
+# 2026-11-02 (guide rewrite): Save rebuilds the table from the lists already downloaded - but a list ticked
+# for the first time (or again, after its copy was pruned) has nothing to build from, so it waited for the
+# 05:15 run while the page said Save downloads it. Any subscribed download without a usable copy -> update
+# (fetch, then build); otherwise the rebuild alone, as before.
