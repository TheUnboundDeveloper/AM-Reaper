+/* reaper 2026-11-02 (forum): every built-in Dreadwatch / Wallguard list address, for the page rows, from the
+ * table the router downloads from (shared/reaper_lists.h). var LURL = <% reaper_list_urls(); %>;
+ * -> {"dw":{"urlhaus":"https://...",...},"wg":{"hagezi_light":"https://...",...}} (constant strings, no escaping needed) */
+static int
+ej_reaper_list_urls(int eid, webs_t wp, int argc, char_t **argv)
+{
+	int n = 0, ret = 0;
+#define RL_PAIR(id, url) ret += websWrite(wp, "%s\"%s\":\"%s\"", n++ ? "," : "", id, url);
+	ret += websWrite(wp, "{\"dw\":{");
+	RDW_LIST(RL_PAIR)
+	n = 0;
+	ret += websWrite(wp, "},\"wg\":{");
+	RWG_LIST(RL_PAIR)
+	ret += websWrite(wp, "}}");
+#undef RL_PAIR
+	return ret;
+}
