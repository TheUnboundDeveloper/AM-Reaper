     /* protect the fc linked lists by disabling all interrupts */
     BLOG_LOCK_BH();
 
diff --git a/release/src-rt-5.04behnd.4916/kernel/linux-4.19/drivers/scsi/sg.c b/release/src-rt-5.04behnd.4916/kernel/linux-4.19/drivers/scsi/sg.c
