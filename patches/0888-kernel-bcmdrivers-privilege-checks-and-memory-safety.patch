@@ -87,8 +87,8 @@ static ssize_t proc_cmd_write(struct file *file, const char __user *buffer,
 	table = (struct proc_cmd_table *) file->private_data;
 	if ((count <= 1) || (buffer == NULL))
 		goto help;
-	if (count > PROC_CMD_STRING_SIZE)
-		count = PROC_CMD_STRING_SIZE;
+	if (count > PROC_CMD_STRING_SIZE - 1)	/* reaper (review 2026-11-03): room for the terminator */
+		count = PROC_CMD_STRING_SIZE - 1;
 	memset(cmd_line, 0, PROC_CMD_STRING_SIZE);
 	if (copy_from_user(cmd_line, buffer, count))
 		return count;
@@ -161,8 +161,10 @@ struct proc_dir_entry *proc_create_cmd(const char *name,
 		return NULL;
 	if (table->size > PROC_CMD_TABLE_SIZE_MAX)
 		return NULL;
+	/* reaper (review 2026-11-03, E-3): owner-only write. These are command consoles (PHY/MDIO
