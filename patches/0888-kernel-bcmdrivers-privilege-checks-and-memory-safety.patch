diff --git a/release/src-rt-5.04behnd.4916/bcmdrivers/opensource/char/bcm_knvram/impl1/src/wlcsm_netlink.c b/release/src-rt-5.04behnd.4916/bcmdrivers/opensource/char/bcm_knvram/impl1/src/wlcsm_netlink.c
index 435594e0f3b..0953418c703 100644
--- a/release/src-rt-5.04behnd.4916/bcmdrivers/opensource/char/bcm_knvram/impl1/src/wlcsm_netlink.c
+++ b/release/src-rt-5.04behnd.4916/bcmdrivers/opensource/char/bcm_knvram/impl1/src/wlcsm_netlink.c
@@ -352,12 +352,34 @@ wlcsm_nl_rcv_skb(struct sk_buff *skb)
     t_WLCSM_MSG_HDR *msg_hdr;
     char buffer[WLCSM_NAMEVALUEPAIR_MAX];
     char *p = NULL;
+    unsigned int avail;
 
     if (skb->len >= NLMSG_SPACE(0)) {
         if (nlh->nlmsg_len < sizeof(*nlh) || skb->len < nlh->nlmsg_len)
             return;
 
+        /* reaper (review 2026-11-03, E-1): this family is the whole router nvram - get, set,
+         * unset, commit, getall - and any local process can open a NETLINK_WLCSM socket.
+         * Stock trusted every sender, so a non-root daemon (dnsmasq, avahi, lldpd and the
+         * Gatekeeper sink run as nobody) could read every secret or set http_passwd. Every
+         * real client (rc, httpd, the Wi-Fi daemons, the nvram command) is root with the
+         * full capability set. CAP_SYS_ADMIN, not CAP_NET_ADMIN: dnsmasq keeps CAP_NET_ADMIN
+         * after it drops to nobody. A refused sender gets an empty answer, so a client
+         * library waiting for one does not hang. */
+        if (nlh->nlmsg_len < NLMSG_LENGTH(sizeof(t_WLCSM_MSG_HDR)))
+            return;
         msg_hdr = (t_WLCSM_MSG_HDR *)NLMSG_DATA(nlh);
+        if (!netlink_capable(skb, CAP_SYS_ADMIN)) {
+            if (net_ratelimit())
+                printk(KERN_WARNING "wlcsm: refused nvram message %u from unprivileged pid %u\n",
+                       (unsigned int)msg_hdr->type, nlh->nlmsg_pid);
+            wlcsm_sendup_response(msg_hdr->type,(char *)(msg_hdr+1),0,nlh->nlmsg_pid,0);
+            return;
+        }
+        /* the payload length is the sender's word: never echo or parse more than arrived */
+        avail = skb->len - NLMSG_LENGTH(sizeof(t_WLCSM_MSG_HDR));
+        if (msg_hdr->len > avail)
+            return;
 
         switch(msg_hdr->type) {
 
@@ -393,10 +415,23 @@ wlcsm_nl_rcv_skb(struct sk_buff *skb)
 
         case WLCSM_MSG_REGISTER: {
             t_WLCSM_MSG_REGISTER *reg=(t_WLCSM_MSG_REGISTER *)(msg_hdr+1);
-            PROCESS_REG_LIST *process=kmalloc(sizeof(PROCESS_REG_LIST),GFP_KERNEL);
+            PROCESS_REG_LIST *process;
+            unsigned int nlen;
+
+            /* reaper (review 2026-11-03, E-1): reg->len is the sender's and name[] is 256 bytes -
+             * bound the copy by what arrived and by the buffer, and terminate it */
+            if (avail < offsetof(t_WLCSM_MSG_REGISTER, process))
+                break;
+            nlen = reg->len;
+            if (nlen > avail - offsetof(t_WLCSM_MSG_REGISTER, process))
+                nlen = avail - offsetof(t_WLCSM_MSG_REGISTER, process);
+            if (nlen > sizeof(process->name) - 1)
+                nlen = sizeof(process->name) - 1;
+            process=kmalloc(sizeof(PROCESS_REG_LIST),GFP_KERNEL);
             if(process) {
                 process->pid= reg->pid;
-                memcpy(process->name,reg->process,reg->len);
+                memcpy(process->name,reg->process,nlen);
+                process->name[nlen] = '\0';
                 if(!strcmp(reg->process,"wlmngr"))  g_mngr_pid=reg->pid;
 #ifdef WLCSM_DEBUG
                 else if(!strcmp(reg->process,"wldebug")) {
@@ -467,8 +502,15 @@ wlcsm_nl_rcv_skb(struct sk_buff *skb)
         }
         break;
 	case WLCSM_MSG_NVRAM_XFR:
+		/* reaper (review 2026-11-03, E-1): nvram_xfr() strcpy()s its argument into a 1024-byte
+		 * buffer - the string must end inside what arrived and fit */
+		if (!memchr((char *)(msg_hdr+1), 0, avail) ||
+		    strnlen((char *)(msg_hdr+1), avail) >= sizeof(buffer)) {
+			wlcsm_sendup_response(msg_hdr->type,(char *)(msg_hdr+1),0,nlh->nlmsg_pid,0);
+			break;
+		}
 		if ((p = nvram_xfr((char *)(msg_hdr+1)))) {
-			strcpy(buffer, p);
+			strlcpy(buffer, p, sizeof(buffer));
 			wlcsm_sendup_response(msg_hdr->type,buffer,strlen(buffer),nlh->nlmsg_pid,0);
 		} else {
 			wlcsm_sendup_response(msg_hdr->type,(char *)(msg_hdr+1),0,nlh->nlmsg_pid,0);
@@ -485,8 +527,18 @@ wlcsm_nl_rcv_skb(struct sk_buff *skb)
             int len=0,retlen=0,maxAllowedSize=0,index=0;
             char *bigbuffer=NULL;
             maxAllowedSize=NL_PACKET_SIZE-sizeof(struct nlmsghdr)- sizeof(t_WLCSM_MSG_HDR);
+            /* reaper (review 2026-11-03, E-1): two ints must have arrived, and the page index
+             * is the sender's - it becomes a byte offset into the nvram image */
+            if (avail < 2 * sizeof(int)) {
+                wlcsm_sendup_response(WLCSM_MSG_NVRAM_GETALL_DONE,(char *)(msg_hdr+1),0,nlh->nlmsg_pid,0);
+                break;
+            }
             len=((int *)(msg_hdr+1))[0];
             index=((int *)(msg_hdr+1))[1];
+            if (index < 0 || index > INT_MAX / maxAllowedSize) {
+                wlcsm_sendup_response(WLCSM_MSG_NVRAM_GETALL_DONE,(char *)(msg_hdr+1),0,nlh->nlmsg_pid,0);
+                break;
+            }
             bigbuffer=kmalloc(2*maxAllowedSize,GFP_KERNEL);
             if(bigbuffer) {
                 retlen=wlcsm_nvram_getall_pos(bigbuffer,maxAllowedSize,index*maxAllowedSize);
diff --git a/release/src-rt-5.04behnd.4916/bcmdrivers/opensource/char/mcast/impl1/bcm_mcast_netlink.c b/release/src-rt-5.04behnd.4916/bcmdrivers/opensource/char/mcast/impl1/bcm_mcast_netlink.c
