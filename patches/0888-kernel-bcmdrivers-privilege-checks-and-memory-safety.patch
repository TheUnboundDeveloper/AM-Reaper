 		f = fcheck(fd);
 		spin_unlock(&current->files->file_lock);
 		if (f != filp) {
-			file_lock->fl_type = F_UNLCK;
-			error = do_lock_file_wait(filp, cmd, file_lock);
-			WARN_ON_ONCE(error);
+			/* reaper (review 2026-11-03, E-5): CVE-2024-41012, upstream "filelock: Remove
+			 * locks reliably when fcntl/close race is detected" */
+			locks_remove_posix(filp, current->files);
