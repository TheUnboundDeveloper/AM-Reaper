diff --git a/release/src-rt-5.04behnd.4916/bcmdrivers/opensource/include/bcm963xx/proc_cmd.h b/release/src-rt-5.04behnd.4916/bcmdrivers/opensource/include/bcm963xx/proc_cmd.h
