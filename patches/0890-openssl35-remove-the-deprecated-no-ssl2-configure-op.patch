From 31bde046670246fa66eb9e46a9045392abc24b02 Mon Sep 17 00:00:00 2001
From: reaper <theunbounddeveloper@outlook.com>
Date: Mon, 26 Oct 2026 13:54:34 -0400
Subject: [PATCH] openssl35: remove the deprecated no-ssl2 configure option

Carried from Asuswrt-Merlin (Eric Sauvageau), commit 9e53d766f86, unchanged.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 release/src/router/Makefile | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/release/src/router/Makefile b/release/src/router/Makefile
index b01083cc2ef..c0a3db674db 100644
--- a/release/src/router/Makefile
+++ b/release/src/router/Makefile
@@ -3770,7 +3770,7 @@ endif
 #      no-ec no-ecdh no-ecdsa no-err no-hw no-jpake no-threads \
 #      no-zlib no-engine no-engines no-sse2 no-perlasm \
 #      no-dtls1 no-store no-psk no-md2 no-mdc2 no-ts
-OPENSSL_CIPHERS := no-ssl2 no-gost no-heartbeats no-err no-unit-test
+OPENSSL_CIPHERS := no-gost no-heartbeats no-err no-unit-test
 ifeq ($(RTCONFIG_OPENVPN),y)
 OPENSSL_CIPHERS += enable-rc5
 endif
-- 
2.25.1

