+static void cs_lastline(const char *buf, size_t n, char *out, size_t cap)
+{
+	size_t e = n, b, i, o = 0;
+
+	while (e && (buf[e - 1] == '\n' || buf[e - 1] == '\r' || buf[e - 1] == ' '))
+		e--;
+	for (b = e; b && buf[b - 1] != '\n'; b--)
