+			if (r < 0 && errno == EINTR)
+				continue;
+			if (r <= 0)
+				break;
+			if (kept < sizeof(head)) {
+				size_t take = (size_t)r < sizeof(head) - kept ? (size_t)r : sizeof(head) - kept;
+				memcpy(head + kept, s, take);
+				if (fd >= 0 && write(fd, s, take) < 0) {
+					close(fd);
+					fd = -1;
+				}
+				kept += take;
+			}
+		}
+		if (!done && waitpid(pid, &status, WNOHANG) == pid)
+			done = 1;
+		if (done && stfd >= 0) {	/* the caller waits for the script, not for EOF */
+			code = status;
+			if (write(stfd, &code, sizeof(code)) < 0) { }
+			close(stfd);
+			stfd = -1;
+		}
+	}
+	close(p[0]);
+	if (fd >= 0)
+		close(fd);
+	if (!done)
+		while (waitpid(pid, &status, 0) < 0 && errno == EINTR)
+			;
+	if (stfd >= 0) {
+		code = status;
+		if (write(stfd, &code, sizeof(code)) < 0) { }
+		close(stfd);
+	}
+	cs_lastline(head, kept, last, sizeof(last));
+	if (WIFEXITED(status) && WEXITSTATUS(status) != 0)
+		logmessage("custom_script", "%s exited with status %d%s%s - its output: %s", cmd[0], WEXITSTATUS(status),
+			   last[0] ? ": " : "", last, path);
+	else if (WIFSIGNALED(status) && WTERMSIG(status) == SIGALRM)
+		logmessage("custom_script", "%s did not finish in %d s and was stopped - its output: %s", cmd[0], timeout, path);
+	else if (WIFSIGNALED(status))
+		logmessage("custom_script", "%s was ended by signal %d%s%s - its output: %s", cmd[0], WTERMSIG(status),
+			   last[0] ? ": " : "", last, path);
+	_exit(0);
+}
+
+/* Windows line endings break the #! line ("/bin/sh\r" does not exist) with no other trace */
+static int cs_crlf(const char *script)
+{
+	char b[160];
+	ssize_t n;
+	int fd = open(script, O_RDONLY | O_NOFOLLOW), crlf = 0;
+	char *nl;
+
+	if (fd < 0)
+		return 0;
+	n = read(fd, b, sizeof(b) - 1);
+	close(fd);
+	if (n <= 0)
+		return 0;
+	b[n] = 0;
+	nl = strchr(b, '\n');
+	if (nl && nl > b && nl[-1] == '\r')
+		crlf = 1;
+	return crlf;
+}
+
+static void cs_run(char *const cmd[], const char *name, int timeout)
+{
+	int sp[2] = { -1, -1 }, code;
+	pid_t c;
+
+	if (timeout && pipe(sp) != 0)
+		sp[0] = sp[1] = -1;
+	c = fork();
+	if (c < 0) {
+		_eval(cmd, NULL, timeout, NULL);	/* no watcher: run it the stock way */
+		goto out;
+	}
+	if (c == 0) {
+		if (sp[0] >= 0)
+			close(sp[0]);
+		if (fork() == 0)	/* the watcher, reparented to init: the caller never waits for it */
+			cs_watch(cmd, name, timeout, sp[1]);
+		_exit(0);
+	}
+	if (sp[1] >= 0)
+		close(sp[1]);
+	while (waitpid(c, NULL, 0) < 0 && errno == EINTR)
+		;
+	if (sp[0] >= 0) {
+		while (read(sp[0], &code, sizeof(code)) < 0 && errno == EINTR)
+			;
+	}
+out:
+	if (sp[0] >= 0)
+		close(sp[0]);
+}
