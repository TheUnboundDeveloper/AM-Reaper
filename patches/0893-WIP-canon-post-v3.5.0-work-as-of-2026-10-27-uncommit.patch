+/* reaper 2026-10-26 cache bust (owner: a change must reach the browser without anyone clearing a cache):
+ * - every ETag carries the image's build stamp (nvram buildinfo = RT_BUILD_INFO, rewritten at every build), so a
+ *   new firmware changes every ETag even where the file did not change - a dictionary edit changes a script's
+ *   served text, not its file;
+ * - stylesheets and our scripts say "Cache-Control: no-cache": kept, but asked about on every load (a 304 is a
+ *   header). Stock gave stylesheets an hour with no question asked, and Safari (no ETag) an hour or 60 s;
+ * - a rendered response whose text is not the file (HTML - the theme is injected - or a file holding <% %> tags:
+ *   menu.js's operation mode, rp.js's http_id, state.js) gets no ETag: the file's hash said "unchanged" while its
+ *   values had changed, so the browser kept the old copy. It gets the handler's own Cache-Control instead.
+ * Images and the vendor libraries keep their hour; the stamp renews them at the first question after a flash. */
+int append_etag_header(char *file, char *extra_header, char *if_none_match, char *title, int title_len, char *final_header, int final_header_len, int rendered, const char *mime)
