+/* 2026-10-27: one settings-file value as the export writes it (caller frees). *have = 0 for a value kept in a
+ * /jffs file that does not exist: it is left out of the file, so an import leaves that file alone */
+static char *rcfg_get(int i, int *have)
+{
+	const char *nv = rcfg_flags[i].nv, *ln = rcfg_rw_list(nv), *f = NULL, *jv;
+	const struct sh_file *wf = rcfg_wg_file(nv);
+	char *v;
+	int ex = 1;
+
+	*have = 1;
+	if (ln) {
+		v = rw_list_get(ln);
+		return v ? v : strdup("");
+	}
+	if (!strcmp(nv, "rwatch_rules") || !strcmp(nv, "rlog_filter")) {	/* 2026-10-20 / 2026-10-26: /jffs files */
+		v = !strcmp(nv, "rwatch_rules") ? rview_slurp(RVIEW_RULES, RVIEW_RULES_BYTES) : rview_slurp(RLOGF_FILE, RLOGF_BYTES);
+		return v ? v : strdup("");
+	}
+	if (!strcmp(nv, "rdev_dhcp6")) {	/* IPv6 A3: a /jffs list */
+		jv = rjf_get(REAPER_DHCP6_FILE, &ex);
+		return strdup(ex > 0 && jv ? jv : "");
+	}
+	if (!strcmp(nv, "rwarden_dnskeys")) f = RDW_KEYS;
+	else if (!strcmp(nv, "wallguard_keys")) f = SH_JFFS "/keys";
+	else if (wf) f = wf->file;
+	if (f) {
+		jv = rjf_get(f, &ex);
+		if (ex <= 0) { *have = 0; return NULL; }
+		return strdup(jv ? jv : "");
+	}
+	return strdup(nvram_safe_get(nv));
