+	if ((c = ej_nvram_value(name, name_tmp, sizeof(name_tmp), config_buf, sizeof(config_buf), dec_passwd, sizeof(dec_passwd))) == NULL)
+		c = "";
+	if ((lit = reaper_js_literal(c)) == NULL)
+		return websWrite(wp, "\"\"");
+	ret = websWrite(wp, "%s", lit);
+	free(lit);
+	return ret;
