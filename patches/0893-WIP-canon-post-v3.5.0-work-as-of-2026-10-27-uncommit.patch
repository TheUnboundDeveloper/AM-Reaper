+/* reaper 2026-10-26 (BACKLOG "settings written into page scripts without escaping"): s as ONE double-quoted JavaScript
+ * string literal, safe in any script context - inside '...', "...", `...`, bare, and before a </script>. Letters,
+ * digits, space and . , : ; / @ + = _ - pass; every other ASCII byte is \xNN (so ' " ` \ $ { < > never appear raw);
+ * UTF-8 is decoded to \uXXXX (a surrogate pair above U+FFFF), an invalid byte becomes �. nvram_get escaped only
+ * " & < > as &#NN and let ' and \ through: a stored value holding them ended the string it was written into and ran
+ * as code in the admin's browser (and a UTF-8 name came out as &#-48 sequences). Returns malloc'd text or NULL. */
+char *reaper_js_literal(const char *s)
+{
+	size_t n = strlen(s), o = 0;
+	char *out = malloc(6 * n + 3);		/* worst case \uXXXX per input byte */
+	const unsigned char *p = (const unsigned char *)s;
+
+	if (!out)
+		return NULL;
+	out[o++] = '"';
+	while (*p) {
+		unsigned int cp, need, i;
+		unsigned char ch = *p;
+
+		if (ch < 0x80) {
+			if (isalnum(ch) || strchr(" .,:;/@+=_-", ch))
+				out[o++] = ch;
+			else
+				o += sprintf(out + o, "\\x%02x", ch);
+			p++;
+			continue;
+		}
+		if (ch >= 0xC2 && ch <= 0xDF) { need = 1; cp = ch & 0x1F; }
+		else if (ch >= 0xE0 && ch <= 0xEF) { need = 2; cp = ch & 0x0F; }
+		else if (ch >= 0xF0 && ch <= 0xF4) { need = 3; cp = ch & 0x07; }
+		else { o += sprintf(out + o, "\\ufffd"); p++; continue; }
+		for (i = 1; i <= need; i++)
+			if ((p[i] & 0xC0) != 0x80)
+				break;
+		if (i <= need) { o += sprintf(out + o, "\\ufffd"); p++; continue; }
+		for (i = 1; i <= need; i++)
+			cp = (cp << 6) | (p[i] & 0x3F);
+		/* overlong, surrogate or out-of-range forms are not characters */
+		if ((need == 2 && cp < 0x800) || (need == 3 && (cp < 0x10000 || cp > 0x10FFFF)) || (cp >= 0xD800 && cp <= 0xDFFF)) {
+			o += sprintf(out + o, "\\ufffd"); p++; continue;
+		}
+		if (cp > 0xFFFF) {
+			cp -= 0x10000;
+			o += sprintf(out + o, "\\u%04x\\u%04x", 0xD800 | (cp >> 10), 0xDC00 | (cp & 0x3FF));
+		} else
+			o += sprintf(out + o, "\\u%04x", cp);
+		p += need + 1;
+	}
+	out[o++] = '"';
+	out[o] = 0;
+	return out;
+}
