+	RCFG_SVC(t & RCFG_T_WG, "restart_wallguard;start_wallguard_update");
+	RCFG_SVC(t & RCFG_T_DNS, "restart_dnsmasq;restart_rdnshc");
+	RCFG_SVC(t & RCFG_T_ENC, "restart_rednsd");
+	RCFG_SVC(t & RCFG_T_WATCH, "restart_rwatch");
+	RCFG_SVC(t & RCFG_T_TRAF, "restart_rtraf");
+	RCFG_SVC(t & RCFG_T_EXPORT, "restart_rexport");
