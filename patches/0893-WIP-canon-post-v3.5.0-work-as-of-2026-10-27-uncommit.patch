+/* 2026-10-27: a settings-file key that is one of Wallguard's files ("wallguard_<field>"), or NULL */
+static const struct sh_file *rcfg_wg_file(const char *nv)
+{
+	int i;
+
+	if (strncmp(nv, "wallguard_", 10) != 0) return NULL;
+	for (i = 0; i < SH_NFILES; i++)
+		if (!strcmp(nv + 10, sh_files[i].field)) return &sh_files[i];
+	return NULL;
+}
