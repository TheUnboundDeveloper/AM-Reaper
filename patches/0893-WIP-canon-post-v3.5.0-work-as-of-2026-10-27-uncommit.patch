+		if (!src_keys_ok(v))
+			return -1;
+		unlink(dw ? RDW_KEYS : SH_JFFS "/keys");
+		return (dw ? src_keys_save(RDW_KEYS, RDW_SRC, "rwarden", v) : sh_keys_save(v)) == 0 ? 0 : -1;
+	}
+	if (wf || !strcmp(nv, "rwarden_dnssrc")) {	/* line by line through the page's own check */
+		if ((clean = malloc(SH_LIST_MAX > RDW_SRC_MAX ? SH_LIST_MAX : RDW_SRC_MAX)) == NULL)
+			return -1;
+		r = wf ? sh_lines(v, clean, SH_LIST_MAX, wf->check) : sh_lines(v, clean, RDW_SRC_MAX, rdw_chk_src);
