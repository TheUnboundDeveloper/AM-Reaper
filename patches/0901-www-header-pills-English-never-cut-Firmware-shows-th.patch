+	/* 2026-10-28 (owner): a label that carries its English text in data-en (the header pills) is never cut below
+	   the width that English takes - English is the standard size, and only a longer translation gives way, down
+	   to that size. Measured in the label's own font, case and letter spacing; 0 = no floor. */
+	function enFloor(el) {
+		var en = el.getAttribute && el.getAttribute('data-en'), cs, c, t;
+		if (!en) return 0;
+		cs = el.ownerDocument.defaultView.getComputedStyle(el);
+		t = cs.textTransform === 'uppercase' ? en.toUpperCase() : en;
+		CANVAS = CANVAS || document.createElement('canvas');
+		c = CANVAS.getContext('2d'); c.font = cs.fontStyle + ' ' + cs.fontWeight + ' ' + cs.fontSize + ' ' + cs.fontFamily;
+		return Math.ceil(c.measureText(t).width + (parseFloat(cs.letterSpacing) || 0) * t.length) + 2;
+	}
+	/* the floor is the English width, but never more than the text itself needs: a value whose reference is the
+	   longest English word ("Disconnected") must not pad a shorter one ("Connected") */
+	function floors(doc) {
+		var els = doc.querySelectorAll('[data-en]'), i, el, f;
+		for (i = 0; i < els.length; i++) { el = els[i]; el.style.minWidth = ''; }
+		for (i = 0; i < els.length; i++) {
+			el = els[i]; f = Math.min(enFloor(el), el.scrollWidth);
+			el.__rfitFl = f > 0 ? f : 0;
+			if (el.__rfitFl) el.style.minWidth = el.__rfitFl + 'px';
+		}
+	}
+	/* a strip of chips in priority order (data-rfit-strip: the header pills) shows as many as fit at their ENGLISH
+	   sizes, dropping from the end - so English is never cut, and a longer translation keeps the same chips and
+	   gives way inside them (fitContainers). A wrapping strip (phones) shows everything. */
+	function need(win, el) {
+		var cs = win.getComputedStyle(el), n = 0, k = 0, c;
+		for (c = el.firstElementChild; c; c = c.nextElementSibling) {
+			if (win.getComputedStyle(c).display === 'none') continue;
+			n += c.__rfitFl || Math.max(c.scrollWidth, c.getBoundingClientRect().width); k++;
+		}
+		return n + (parseFloat(cs.columnGap) || 0) * Math.max(0, k - 1) + (parseFloat(cs.paddingLeft) || 0) +
+			(parseFloat(cs.paddingRight) || 0) + (parseFloat(cs.borderLeftWidth) || 0) + (parseFloat(cs.borderRightWidth) || 0);
+	}
+	function strips(doc) {
+		var win = doc.defaultView, ss = doc.querySelectorAll('[data-rfit-strip]'), i, s, p, pcs, room, c, vis, tot, gap;
+		for (i = 0; i < ss.length; i++) {
+			s = ss[i]; p = s.parentElement;
+			if (!p || !s.getClientRects().length || win.getComputedStyle(s).flexWrap === 'wrap') continue;
+			pcs = win.getComputedStyle(p); gap = parseFloat(pcs.columnGap) || 0;
+			room = p.clientWidth - (parseFloat(pcs.paddingLeft) || 0) - (parseFloat(pcs.paddingRight) || 0);
+			vis = 0;
+			for (c = p.firstElementChild; c; c = c.nextElementSibling) {
+				if (!c.getClientRects().length) continue;
+				vis++;
+				if (c !== s && win.getComputedStyle(c).flexGrow === '0') room -= c.getBoundingClientRect().width;
+			}
+			room -= gap * Math.max(0, vis - 1);
+			vis = []; for (c = s.firstElementChild; c; c = c.nextElementSibling) if (c.getClientRects().length) vis.push(c);
+			gap = parseFloat(win.getComputedStyle(s).columnGap) || 0;
+			tot = 0; for (c = 0; c < vis.length; c++) tot += need(win, vis[c]) + (c ? gap : 0);
+			while (vis.length > 1 && tot > room + 0.5) {
+				c = vis.pop(); tot -= need(win, c) + gap;
+				c.style.display = 'none'; c.setAttribute('data-rfit-hid', '1');
+			}
+		}
+	}
 
