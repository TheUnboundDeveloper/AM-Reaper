diff --git a/release/src/router/httpd/web.c b/release/src/router/httpd/web.c
index 9f3edd17685..8a8529f7a4f 100644
--- a/release/src/router/httpd/web.c
+++ b/release/src/router/httpd/web.c
@@ -26219,15 +26219,23 @@ static int sh_ip(const char *s)
 	return inet_pton(AF_INET, s, b) == 1 || inet_pton(AF_INET6, s, b) == 1;
 }
 
+/* 2026-10-28 (owner): "$APIkey" marks where a source's saved API key goes in its address - the only "$" a URL may
+ * carry, and never in the host (wallguard.sh fetch puts the key there, %-encoded, in its root-only curl config) */
 static int sh_url(const char *u)
 {
-	size_t i;
+	size_t i, h;
 
 	if (strncmp(u, "https://", 8) || strlen(u) > 400)
 		return 0;
-	for (i = 0; u[i]; i++)
+	h = 8 + strcspn(u + 8, "/?#");
+	for (i = 0; u[i]; i++) {
+		if (u[i] == '$' && i > h && !strncmp(u + i, "$APIkey", 7)) {
+			i += 6;
+			continue;
+		}
 		if ((unsigned char)u[i] <= ' ' || (unsigned char)u[i] > 0x7e || strchr("\"'`\\$<>", u[i]))
 			return 0;
+	}
 	return 1;
 }
 
@@ -26286,7 +26294,8 @@ static int sh_whole(const char *l, int n)
 /* 2026-10-26 (owner): a custom source's options, after its URL, space-separated, each at most once:
  *   name=<%-enc, 1..40>  fmt=list|json:<field>  method=get|post  body=<%-enc, 1..1024>  hdr=<header name>
  * %-encoded values decode to printable ASCII; a name may not carry markup or quote characters (the page shows
- * it as text anyway). The API key that goes with hdr= is never in this line (sh_keys_save, /jffs/wallguard/keys). */
+ * it as text anyway). The API key that goes with hdr= or with $APIkey in the URL (2026-10-28) is never in this line
+ * (sh_keys_save, /jffs/wallguard/keys). */
 static int sh_hex(int c)
 {
 	return isdigit(c) ? c - '0' : tolower(c) - 'a' + 10;
diff --git a/release/src/router/rc/rwarden.c b/release/src/router/rc/rwarden.c
index 86df4671839..2aba1c90693 100644
--- a/release/src/router/rc/rwarden.c
+++ b/release/src/router/rc/rwarden.c
@@ -1547,7 +1547,10 @@ domains:
 	  "        'custom '[1-8])\n"
 	  "          case \"$DSEEN\" in *\" $_s \"*) continue ;; esac\n"
 	  "          case \"$_u\" in https://?*) ;; *) logger -t rwarden \"threat domains: your source $_s has no https:// address - skipped\"; continue ;; esac\n"
-	  "          case \"$_u$_o\" in *[\\\"\\'\\`\\$\\<\\>\\\\]*) logger -t rwarden \"threat domains: your source $_s has characters that are not allowed - skipped\"; continue ;; esac\n"
+	  "          # 2026-10-28: the one \"$\" allowed is $APIkey after the host - where wallguard.sh puts the saved key\n"
+	  "          _uc=$(printf '%s' \"$_u\" | sed 's/[$]APIkey//g'); _uh=${_u#https://}; _uh=${_uh%%[/?#]*}\n"
+	  "          case \"$_uh\" in *[$]*) _uc='$' ;; esac\n"
+	  "          case \"$_uc$_o\" in *[\\\"\\'\\`\\$\\<\\>\\\\]*) logger -t rwarden \"threat domains: your source $_s has characters that are not allowed - skipped\"; continue ;; esac\n"
 	  "          case \"$_o\" in *[!A-Za-z0-9=%:._\\ -]*) logger -t rwarden \"threat domains: your source $_s has options that are not valid - skipped\"; continue ;; esac\n"
 	  "          DSEEN=\"$DSEEN$_s \"; echo \"custom$_s $_u $_o\" >> $TMP.cs ;;\n"
 	  "      esac\n"
diff --git a/release/src/router/rc/wallguard.c b/release/src/router/rc/wallguard.c
index d7443ecaf12..1a03363659a 100644
--- a/release/src/router/rc/wallguard.c
+++ b/release/src/router/rc/wallguard.c
@@ -88,15 +88,22 @@ static int sh_name_ok(const char *s)
 	return 1;
 }
 
+/* the one "$" allowed is "$APIkey" after the host (2026-10-28, httpd's sh_url): where wallguard.sh puts the key */
 static int sh_url_ok(const char *u)
 {
-	size_t i;
+	size_t i, h;
 
 	if (strncmp(u, "https://", 8) || strlen(u) > 400)
 		return 0;
-	for (i = 0; u[i]; i++)
+	h = 8 + strcspn(u + 8, "/?#");
+	for (i = 0; u[i]; i++) {
+		if (u[i] == '$' && i > h && !strncmp(u + i, "$APIkey", 7)) {
+			i += 6;
+			continue;
+		}
 		if ((unsigned char)u[i] <= ' ' || u[i] == '"' || u[i] == '\'' || u[i] == '`' || u[i] == '\\' || u[i] == '$')
 			return 0;
+	}
 	return 1;
 }
 
diff --git a/release/src/router/wallguard/wallguard.sh b/release/src/router/wallguard/wallguard.sh
index f208825b805..38e8f456ca5 100644
--- a/release/src/router/wallguard/wallguard.sh
+++ b/release/src/router/wallguard/wallguard.sh
@@ -11,7 +11,8 @@
 #   $D/feeds    one subscribed list per line: <bit> <id> <url> <p|c|s> [options]  (p = preset, c = custom,
 #               s = a profile's blocked services: a local file rc writes, url "-", never fetched;
 #               options, custom only: name= fmt=list|json:<field> method=get|post body= hdr=<header>)
-#   $J/keys     "<slot> <API key>" per custom source that sends one (root 0600; never in a command line)
+#   $J/keys     "<slot> <API key>" per custom source that sends one (root 0600; never in a command line) - the
+#               API key: in a header (hdr=) or inside the URL, where the URL says $APIkey (2026-10-28)
 #   $D/safesearch  the search engines' enforcement names + addresses (safe search, phase 2)
 #   $D/safe     names that are never blocked (router names, NTP, DDNS, DoT, list hosts)
 #   $J/block    My rules: names to block (with subdomains)
@@ -281,6 +282,9 @@ warden_why() {
 # the names (a URL value is cut to its host; addresses are not names). Plain sources fetch as before.
 # fetch <out> <url> <curl command> <options> <id>: 0 ok, 99 needs a key none is saved for, 98 no names in the
 # answer's field, else curl's status.
+# 2026-10-28 (owner): the second form - the key inside the address. Each $APIkey in the URL (never in its host;
+# httpd and rc check that) becomes the saved key, %-encoded; the finished URL goes into the same root-only config
+# as url = "...", so the key is never in a command line (awk reads it from its environment, which only root sees).
 pdec() {
   printf '%s' "$1" | awk 'function hv(h,  i, v) { v = 0; h = tolower(h); for (i = 1; i <= 2; i++) v = v * 16 + index("0123456789abcdef", substr(h, i, 1)) - 1; return v }
     { s = $0; o = ""; while ((i = index(s, "%")) > 0) { o = o substr(s, 1, i - 1) sprintf("%c", hv(substr(s, i + 1, 2))); s = substr(s, i + 3) } printf "%s", o s }'
@@ -295,7 +299,8 @@ json_names() {
   [ -s "$1" ] || return 98
 }
 fetch() {
-  if [ -z "$4" ]; then
+  _uk=; case "$2" in *'$APIkey'*) _uk=1 ;; esac
+  if [ -z "$4" ] && [ -z "$_uk" ]; then
     # shellcheck disable=SC2086
     $3 -o "$1" "$2" 2>/dev/null; return
   fi
@@ -303,7 +308,7 @@ fetch() {
   for _t in $4; do
     case "$_t" in method=post) _m=post ;; body=*) _b=$(pdec "${_t#body=}") ;; hdr=*) _h=${_t#hdr=} ;; fmt=*) _f=${_t#fmt=} ;; esac
   done
-  if [ -n "$_h" ]; then
+  if [ -n "$_h" ] || [ -n "$_uk" ]; then
     _kf=${FKEYS:-$J/keys}	# Dreadwatch's sources pass their own key file (the fetch action below)
     [ -f "$_kf" ] && [ ! -L "$_kf" ] && _k=$(awk -v s="${5#custom}" '$1 == s { print $2; exit }' "$_kf")
     case "$_k" in ''|*[!!-~]*|*[\"\'\`\\\$]*) return 99 ;; esac
@@ -314,6 +319,10 @@ fetch() {
     umask 077
     : > "$_cf"
     [ -n "$_h" ] && printf 'header = "%s: %s"\n' "$_h" "$_k" >> "$_cf"
+    [ -n "$_uk" ] && WGK=$_k awk -v u="$2" 'BEGIN { k = ENVIRON["WGK"]; for (i = 33; i < 127; i++) c[sprintf("%c", i)] = i
+      e = ""; for (i = 1; i <= length(k); i++) { x = substr(k, i, 1); if (x !~ /^[A-Za-z0-9._~-]$/) x = sprintf("%%%02X", c[x]); e = e x }
+      o = ""; while ((i = index(u, "$APIkey")) > 0) { o = o substr(u, 1, i - 1) e; u = substr(u, i + 7) }
+      printf "url = \"%s\"\n", o u }' >> "$_cf"
     if [ "$_m" = post ]; then
       printf '%s' "$_b" > "$_bf"
       printf 'data-binary = "@%s"\n' "$_bf" >> "$_cf"
@@ -321,7 +330,7 @@ fetch() {
     fi
   )
   # shellcheck disable=SC2086
-  $3 -K "$_cf" -o "$1" "$2" 2>/dev/null; _r=$?
+  if [ -n "$_uk" ]; then $3 -K "$_cf" -o "$1" 2>/dev/null; else $3 -K "$_cf" -o "$1" "$2" 2>/dev/null; fi; _r=$?
   rm -f "$_cf" "$_bf"
   [ "$_r" = 0 ] || return "$_r"
   case "$_f" in json:?*) json_names "$1" "${_f#json:}" || return 98 ;; esac
