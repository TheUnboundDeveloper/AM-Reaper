diff --git a/release/src/router/shared/reaper_rewrite.h b/release/src/router/shared/reaper_rewrite.h
new file mode 100644
index 00000000000..873e628e7cc
--- /dev/null
+++ b/release/src/router/shared/reaper_rewrite.h
@@ -0,0 +1,233 @@
+/*
+ * reaper 2026-11-05: Wallguard DNS rewrites (Bastion > Wallguard), shared by httpd and rc.
+ *
+ * The operator's rewrites live in /jffs/wallguard/rewrite, one per line:
+ *     <name> <answer>          the name itself only
+ *     <name> <answer> sub      the name and every name under it
+ * The answer is an IPv4 address, an IPv6 address, or another name (an alias, the name itself only).
+ * httpd checks each line with rrw_parse() before it is written (the page's save and a settings-file
+ * import); rc reads the file again at every dnsmasq start and turns it into dnsmasq lines with
+ * rrw_conf(), checking each line once more - the file can be edited by hand.
+ *
+ * What each row becomes (every dnsmasq instance includes the result, guest networks too):
+ *     name + address + sub   address=/name/address      the name and its subdomains
+ *     name + address         host-record=name,address   the name only (and its reverse lookup)
+ *     name + other name      cname=name,other           the name only; the other name must be one the
+ *                                                        router answers itself (a device or a rewrite)
+ * plus, once per name with an address, local=/name/ (the record types not given - AAAA of an IPv4-only
+ * rewrite, HTTPS - are answered empty, never forwarded) and, for a name without subdomains,
+ * server=/ *.name/# (its subdomains are looked up as usual). A name under a name-and-subdomains row gets
+ * neither: what it does not give itself is that row's.
+ * dnsmasq refuses to START on a duplicate alias or an alias loop, which would take DNS down for every
+ * network - so rrw_conf() drops, never emits: an alias that is also an address row, an alias given
+ * twice, an alias pointing at itself or at another alias (no chains, so no loops). Everything is
+ * written from checked characters only (no comma, slash, space or newline can reach a line).
+ */
+#ifndef REAPER_REWRITE_H
+#define REAPER_REWRITE_H
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <arpa/inet.h>
+
+#define RRW_MAX		512	/* rows read from the file */
+#define RRW_NAME	254	/* 253 + NUL */
+#define RRW_A		1
+#define RRW_AAAA	2
+#define RRW_CNAME	3
+
+struct rrw { char name[RRW_NAME], ans[RRW_NAME]; int type, sub; };
+
+/* a DNS name as the page stores it: lower case, labels of 1-63 [a-z0-9_-] that neither start nor end
+   with "-", 1-253 characters, no leading or trailing dot; a single label ("nas") is allowed. Not
+   digits and dots only (an address, or a mistyped one such as 1.2.3 or 01.2.3.4) and not "localhost". */
+static inline int rrw_name_ok(const char *s)
+{
+	size_t n = strlen(s), i, lab = 0;
+
+	if (n < 1 || n > 253 || s[0] == '.' || s[n - 1] == '.' || s[n - 1] == '-' || strspn(s, "0123456789.") == n)
+		return 0;
+	for (i = 0; i < n; i++) {
+		char c = s[i];
+		if (c == '.') {
+			if (!lab || s[i - 1] == '-')
+				return 0;
+			lab = 0;
+			continue;
+		}
+		if (!((c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == '-' || c == '_'))
+			return 0;
+		if (c == '-' && !lab)
+			return 0;
+		if (++lab > 63)
+			return 0;
+	}
+	return strcmp(s, "localhost") != 0;
+}
+
+/* one line "<name> <answer> [sub]" (spaces or tabs between, nothing after) -> *r. 1 = a valid
+   rewrite. Upper case is refused here: httpd lowers the line first. */
+static inline int rrw_parse(const char *line, struct rrw *r)
+{
+	char buf[RRW_NAME * 2 + 16], *tok[4], *save = NULL, *t;
+	unsigned char b[16];
+	int n = 0;
+
+	memset(r, 0, sizeof(*r));
+	if (!line || strlen(line) >= sizeof(buf))
+		return 0;
+	strcpy(buf, line);
+	for (t = strtok_r(buf, " \t\r\n", &save); t; t = strtok_r(NULL, " \t\r\n", &save)) {
+		if (n == 4)
+			return 0;
+		tok[n++] = t;
+	}
+	if (n < 2 || n > 3 || strlen(tok[0]) >= RRW_NAME || strlen(tok[1]) >= RRW_NAME)
+		return 0;
+	if (n == 3) {
+		if (strcmp(tok[2], "sub"))
+			return 0;
+		r->sub = 1;
+	}
+	strcpy(r->name, tok[0]);
+	strcpy(r->ans, tok[1]);
+	if (!rrw_name_ok(r->name))
+		return 0;
+	if (inet_pton(AF_INET, r->ans, b) == 1)
+		r->type = RRW_A;
+	else if (strchr(r->ans, ':') && strspn(r->ans, "0123456789abcdef:.") == strlen(r->ans) && inet_pton(AF_INET6, r->ans, b) == 1)
+		r->type = RRW_AAAA;
+	else if (rrw_name_ok(r->ans) && strcmp(r->ans, r->name) && !r->sub)
+		r->type = RRW_CNAME;		/* an alias covers the name only */
+	else
+		return 0;
+	return 1;
+}
+
+/* the dnsmasq lines for the rewrites in text, into out (NUL-terminated). Returns the bytes written,
+   0 = nothing to include. *skipped = valid-looking rows left out: unreadable lines, aliases that
+   would stop dnsmasq starting (see the top), duplicates are dropped silently. */
+static inline size_t rrw_conf(const char *text, char *out, size_t max, int *skipped)
+{
+	struct rrw *r;
+	char *copy, *line, *save = NULL;
+	size_t o = 0;
+	int n = 0, i, j, bad = 0;
+
+	if (skipped)
+		*skipped = 0;
+	if (!out || max < 2)
+		return 0;
+	*out = 0;
+	if (!text || !*text || !(r = calloc(RRW_MAX, sizeof(*r))))
+		return 0;
+	if (!(copy = strdup(text))) {
+		free(r);
+		return 0;
+	}
+	for (line = strtok_r(copy, "\n", &save); line; line = strtok_r(NULL, "\n", &save)) {
+		while (*line == ' ' || *line == '\t' || *line == '\r')
+			line++;
+		if (!*line || *line == '#')
+			continue;
+		if (n == RRW_MAX || !rrw_parse(line, &r[n])) {
+			bad++;
+			continue;
+		}
+		for (j = 0; j < n; j++)		/* the same row twice */
+			if (!strcmp(r[j].name, r[n].name) && !strcmp(r[j].ans, r[n].ans) && r[j].sub == r[n].sub)
+				break;
+		if (j == n)
+			n++;
+	}
+	free(copy);
+
+	/* aliases, in two passes: first the ones that may stand at all (no address row of the same name, the
+	   first of a repeated alias), then - among those only, so a row dropped in the first pass cannot take
+	   a good one with it - any alias whose target is another alias (a chain; a loop drops every member) */
+	for (i = 0; i < n; i++) {
+		if (r[i].type != RRW_CNAME)
+			continue;
+		for (j = 0; j < n; j++)
+			if (j != i && !strcmp(r[j].name, r[i].name) && (r[j].type != RRW_CNAME || j < i))
+				break;
+		if (j < n)
+			r[i].type = -RRW_CNAME;		/* dropped, first pass */
+	}
+	for (i = 0; i < n; i++) {
+		if (r[i].type != RRW_CNAME)
+			continue;
+		for (j = 0; j < n; j++)
+			if (j != i && (r[j].type == RRW_CNAME || r[j].type == -RRW_CNAME * 2) && !strcmp(r[j].name, r[i].ans))
+				break;
+		if (j < n)
+			r[i].type = -RRW_CNAME * 2;	/* dropped, second pass (still an alias for its peers' test) */
+	}
+
+	for (i = 0; i < n; i++) {
+		char l[RRW_NAME * 2 + 32];
+		int len;
+
+		if (r[i].type < 0) {
+			bad++;
+			continue;
+		}
+		if (r[i].type == RRW_CNAME) {
+			len = snprintf(l, sizeof(l), "cname=%s,%s\n", r[i].name, r[i].ans);
+		} else if (r[i].sub)
+			len = snprintf(l, sizeof(l), "address=/%s/%s\n", r[i].name, r[i].ans);
+		else
+			len = snprintf(l, sizeof(l), "host-record=%s,%s\n", r[i].name, r[i].ans);
+		if (len <= 0 || (size_t)len >= sizeof(l) || o + (size_t)len + 1 > max) {
+			n = i;			/* out of room: the rows not written get no lines below either */
+			break;
+		}
+		memcpy(out + o, l, (size_t)len + 1);
+		o += (size_t)len;
+	}
+
+	/* once per name with an address: local=/name/ makes the router answer the record types it was not given
+	   (an IPv4-only rewrite answers AAAA, and HTTPS / SVCB, empty - no outside answer can lead around it;
+	   dnsmasq 2.86+ would forward them). For a name without subdomains, server=/ *.name/# hands its
+	   subdomains back to the usual servers - unless a name-and-subdomains row above it covers them. */
+	for (i = 0; i < n; i++) {
+		char l[RRW_NAME * 2 + 32];
+		int len, k, covered = 0;
+
+		if (r[i].type != RRW_A && r[i].type != RRW_AAAA)
+			continue;
+		for (j = 0; j < i; j++)
+			if ((r[j].type == RRW_A || r[j].type == RRW_AAAA) && !strcmp(r[j].name, r[i].name))
+				break;
+		if (j < i)
+			continue;		/* this name's lines are written */
+		/* covered = 1: the name has a name-and-subdomains row of its own; 2: one above it covers it (its own
+		   rows answer what they give, the rest - subdomains, the other family - is the row above's) */
+		for (k = 0; k < n && covered != 1; k++) {
+			size_t a = strlen(r[i].name), b = strlen(r[k].name);
+			if ((r[k].type != RRW_A && r[k].type != RRW_AAAA) || !r[k].sub)
+				continue;
+			if (!strcmp(r[i].name, r[k].name))
+				covered = 1;
+			else if (a > b + 1 && r[i].name[a - b - 1] == '.' && !strcmp(r[i].name + a - b, r[k].name))
+				covered = 2;
+		}
+		if (covered == 2)
+			continue;
+		if (covered)
+			len = snprintf(l, sizeof(l), "local=/%s/\n", r[i].name);
+		else
+			len = snprintf(l, sizeof(l), "local=/%s/\nserver=/*.%s/#\n", r[i].name, r[i].name);
+		if (len <= 0 || (size_t)len >= sizeof(l) || o + (size_t)len + 1 > max)
+			break;
+		memcpy(out + o, l, (size_t)len + 1);
+		o += (size_t)len;
+	}
+	free(r);
+	if (skipped)
+		*skipped = bad;
+	return o;
+}
+
+#endif /* REAPER_REWRITE_H */
