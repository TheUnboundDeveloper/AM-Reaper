+/* v2.1.3 (Quick Look): one conntrack TCP row (original tuple, network order) - the state each fcache flow is
+ * matched to. Batch B (2026-11-05, code review 2026-08-18): the match used to be a linear scan of the whole table
+ * PER FLOW - O(flows x conntrack), up to 300000 rows (ct_max) times every Runner flow, once a second while the page
+ * is open, inside the single-flight lock. The table is now sorted once by (s, sp, d, dp, ix) and each flow does
+ * two binary searches. `ix` is the row's line order in /proc/net/nf_conntrack: the scan took the FIRST row that
+ * matched either direction, and the lowest ix of the two lookups is that same row, so every "st" is unchanged. */
+struct rc_ctst { uint32_t s, d; unsigned sp, dp; int ix; char st[16]; };
+
+static int rconn_ct_cmp(const void *pa, const void *pb)
+{
+	const struct rc_ctst *a = pa, *b = pb;
+
+	if (a->s != b->s) return a->s < b->s ? -1 : 1;
+	if (a->sp != b->sp) return a->sp < b->sp ? -1 : 1;
+	if (a->d != b->d) return a->d < b->d ? -1 : 1;
+	if (a->dp != b->dp) return a->dp < b->dp ? -1 : 1;
+	return a->ix < b->ix ? -1 : a->ix > b->ix;
+}
+
+/* the lowest-ix row whose original tuple is s:sp -> d:dp, or NULL (v sorted by rconn_ct_cmp) */
+static const struct rc_ctst *rconn_ct_find(const struct rc_ctst *v, int n, uint32_t s, unsigned sp, uint32_t d, unsigned dp)
+{
+	struct rc_ctst k;
+	int lo = 0, hi = n;
+
+	k.s = s; k.sp = sp; k.d = d; k.dp = dp; k.ix = -1;	/* below every real ix: the lower bound is the first */
+	while (lo < hi) {
+		int mid = lo + (hi - lo) / 2;
+
+		if (rconn_ct_cmp(&v[mid], &k) < 0) lo = mid + 1;
+		else hi = mid;
+	}
+	if (lo < n && v[lo].s == s && v[lo].sp == sp && v[lo].d == d && v[lo].dp == dp)
+		return &v[lo];
+	return NULL;
+}
