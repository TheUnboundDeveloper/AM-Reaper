+#ifdef RTCONFIG_BCMWL6
+/* reaper 2026-11-05 (review 2026-11-03 B-5): get_wl_status as ONE JSON object for Reaper_WLog.asp, which JSON.parses
+ * it instead of running it as code (new Function). The stock producer (sysdeps/web-broadcom-am.c) is unchanged -
+ * Main_WStatus_Content.asp and ajax_wificlients.asp still evaluate its JS - so its text is captured and rewritten:
+ * `[var ]NAME = VALUE;` becomes "NAME":VALUE, a string keeps its bytes (the producer's \' \" \\ escapes undone, then " \ < > & DEL and
+ * control bytes written as JSON escapes), a comma before ] is dropped. Text of any other shape (a token the producer
+ * never writes) is refused: the reply is {} - no data, never a guess. o needs 6 * strlen(s) + 3 bytes. */
+static int
+reaper_wl_json(const char *s, char *o)
+{
+	const unsigned char *p = (const unsigned char *)s;
+	int first = 1;
+
+	*o++ = '{';
+	for (;;) {
+		int depth = 0, comma = 0;
+		char prev = '[';	/* '[' after an opening bracket, ',' after a comma, 'v' after a value */
+
+		while (isspace(*p)) p++;
+		if (!*p)
+			break;
+		if (!strncmp((const char *)p, "var ", 4))
+			for (p += 4; *p == ' '; p++);
+		if (!isalpha(*p) && *p != '_')
+			return -1;
+		if (!first)
+			*o++ = ',';
+		first = 0;
+		*o++ = '"';
+		while (isalnum(*p) || *p == '_')
+			*o++ = *p++;
+		*o++ = '"';
+		*o++ = ':';
+		while (*p == ' ') p++;
+		if (*p++ != '=')
+			return -1;
+		do {
+			while (isspace(*p)) p++;
+			if (*p == ',') {
+				if (prev != 'v')
+					return -1;
+				comma = 1; prev = ','; p++;
+			} else if (*p == ']') {
+				if (!depth)
+					return -1;
+				comma = 0; depth--; prev = 'v'; *o++ = *p++;	/* a pending comma before ] is dropped */
+			} else if (*p == '[' || *p == '"') {
+				if (prev == 'v')
+					return -1;
+				if (comma)
+					*o++ = ',';
+				comma = 0;
+				if (*p == '[') {
+					depth++; prev = '['; *o++ = *p++;
+					continue;
+				}
+				*o++ = '"';
+				for (p++; *p != '"'; p++) {
+					unsigned char c = *p;
+
+					if (!c)
+						return -1;
+					if (c == '\\') {
+						if (!p[1] || !strchr("'\"\\", p[1]))
+							return -1;
+						c = *++p;
+					}
+					if (c == '"' || c == '\\') {
+						*o++ = '\\'; *o++ = c;
+					} else if (c < 0x20 || c == 0x7f || c == '<' || c == '>' || c == '&')
+						o += sprintf(o, "\\u%04x", c);
+					else
+						*o++ = c;
+				}
+				*o++ = '"'; p++; prev = 'v';
+			} else
+				return -1;
+		} while (depth);
+		while (*p == ' ') p++;
+		if (*p++ != ';')
+			return -1;
+	}
+	*o++ = '}';
+	*o = 0;
+	return 0;
+}
