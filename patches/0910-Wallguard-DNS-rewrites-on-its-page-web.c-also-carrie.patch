+/* 2026-11-05 (owner): a DNS rewrite, "<name> <answer> [sub]" (shared/reaper_rewrite.h, rc reads it with the
+   same rules). Stored lower case in its plain form, single spaces - never longer than the line sent. */
+static int sh_chk_rewrite(char *l)
+{
+	struct rrw r;
+	char *c;
+	size_t n = strlen(l);
+
+	for (c = l; *c; c++)
+		*c = (char)tolower((unsigned char)*c);
+	if (!rrw_parse(l, &r))
+		return 0;
+	snprintf(l, n + 1, "%s %s%s", r.name, r.ans, r.sub ? " sub" : "");
+	return 1;
+}
