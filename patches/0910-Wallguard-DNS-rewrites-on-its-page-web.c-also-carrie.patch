+		return websWrite(wp, "{}");
+	ej_wl_status_array(eid, m, argc, argv);
+	fclose(m);
+	if (txt && (out = malloc(6 * len + 16)) != NULL && reaper_wl_json(txt, out) == 0)
+		ret = websWrite(wp, "%s", out);
+	else
+		ret = websWrite(wp, "{}");
+	free(out);
+	free(txt);
+	return ret;
+}
