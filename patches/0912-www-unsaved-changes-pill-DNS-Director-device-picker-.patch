+/* Reaper: an "Unsaved changes: N" pill and a Discard button for a page that keeps its edits on the
+   page until its own Apply / Save writes them (2026-10-30, owner: on Reaper QoS a row's x edited only
+   the page and nothing said Apply was still owed, so the first delete was never written).
+   Same look and wording as the kit pages' chgpill (rp.css / rp.pill), styled here so a page that does
+   not load the kit gets it too. Nothing is written by this file.
+     ReaperPending.watch({at: el, snap: fn, label: str, discard: str})
+       el    - the page's Apply / Save button; the pill and Discard go just before it
+       snap  - returns {key: value} of everything the Apply / Save would write; a key whose value
+               differs from the baseline counts as one change
+     ReaperPending.arm()   - takes the baseline (call once the page has drawn its data; again after a
+                             save that does not reload the page)
+     ReaperPending.hold()  - hides the pill while the page applies
+   The page is re-checked one tick after any input, change, click or focus change, so the page's own
+   handler has updated its data first. Discard reloads the page. */
+(function(){
+  'use strict';
+  var cfg = null, base = null, pill = null, cnt = null, btn = null, held = false, timer = 0;
+  function css(){
+    if (document.getElementById('rpend_css')) return;
+    var s = document.createElement('style'); s.id = 'rpend_css';
+    s.textContent = '.rpend{display:none;align-items:center;gap:7px;border:1px solid rgba(224,169,59,.45);' +
+      'border-radius:999px;padding:5px 12px;font-size:12px;color:#ECE7DB;white-space:nowrap;line-height:1.2}' +
+      '.rpend.show{display:inline-flex}.rpend .dot{width:8px;height:8px;border-radius:50%;background:#E0A93B}' +
+      '.rpend b{color:#E0A93B;font-weight:700}';
+    (document.head || document.documentElement).appendChild(s);
+  }
+  function take(){ try { var s = cfg.snap(); return (s && typeof s === 'object') ? s : null; } catch (e) { return null; } }
+  function differ(a, b){
+    var n = 0, seen = {}, k;
+    for (k in a) if (Object.prototype.hasOwnProperty.call(a, k)){ seen[k] = 1; if (String(a[k]) !== String(b[k])) n++; }
+    for (k in b) if (Object.prototype.hasOwnProperty.call(b, k) && !seen[k]) n++;
+    return n;
+  }
+  function check(){
+    timer = 0;
+    if (!cfg || held || !base) return;
+    var s = take(); if (!s) return;
+    var n = differ(base, s);
+    cnt.textContent = String(n);
+    pill.classList.toggle('show', n > 0);
+    btn.disabled = !n;
+  }
+  function later(){ if (!timer) timer = setTimeout(check, 0); }
+  window.ReaperPending = {
+    watch: function(o){
+      if (cfg || !o || !o.at || !o.at.parentNode || typeof o.snap !== 'function') return;
+      cfg = o; css();
+      pill = document.createElement('span'); pill.className = 'rpend'; pill.id = 'rpend'; pill.setAttribute('role', 'status');
+      var dot = document.createElement('span'); dot.className = 'dot';
+      var t = document.createElement('span'); t.textContent = (o.label || 'Unsaved changes') + ': ';
+      cnt = document.createElement('b'); cnt.textContent = '0'; t.appendChild(cnt);
+      pill.appendChild(dot); pill.appendChild(t);
+      btn = document.createElement('button'); btn.type = 'button'; btn.id = 'rpend_discard';
+      btn.className = o.btnClass || 'btn ghost'; btn.textContent = o.discard || 'Discard'; btn.disabled = true;
+      btn.addEventListener('click', function(){ location.reload(); });
+      o.at.parentNode.insertBefore(pill, o.at); o.at.parentNode.insertBefore(btn, o.at);
+      ['input', 'change', 'click', 'keyup', 'focusout'].forEach(function(ev){ document.addEventListener(ev, later, true); });
+    },
+    arm: function(){ if (!cfg) return; base = take(); held = false; check(); },
+    hold: function(){ held = true; if (pill){ pill.classList.remove('show'); btn.disabled = true; } },
+    check: function(){ check(); }
+  };
+})();
