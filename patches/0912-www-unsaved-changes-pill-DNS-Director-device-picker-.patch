@@ -477,6 +479,30 @@ function ddDraw(){
   q('ddtbody').innerHTML = h || '<tr><td colspan="3" class="empty">' + hx(`<#IPConnection_VSList_Norule#>`) + '</td></tr>';
   Array.prototype.forEach.call(document.querySelectorAll('#ddtbody select.ddrow'), function(s){ modeOpts(s, DDL[+s.getAttribute('data-i')].mode); });
   var b = q('ddbudget'); b.textContent = DDL.length + ' / ' + DD_MAX; b.classList.toggle('hot', DDL.length >= DD_MAX);
+  ddPickDraw();
+}
+/* 2026-10-30 (owner): pick the device from the connected ones - picking fills the MAC box, typing one still
+   works, and ddAdd() checks either the same way. A device that already has a rule is left out. Names come
+   from the clients themselves, so they go in as text, never markup. */
+function ddPickDraw(){
+  var s = q('s_ddpick'), have = {}; if (!s) return;
+  DDL.forEach(function(r){ have[r.mac] = 1; });
+  while (s.options.length > 1) s.remove(1);
+  DD_DEVS.forEach(function(d){ if (have[d.mac]) return; var o = document.createElement('option'); o.value = d.mac; o.textContent = d.label; s.appendChild(o); });
+  if (!pick(s, val('a_ddmac').toUpperCase())) s.value = '';
+}
+function ddPickLoad(){
+  try {
+    ReaperNames.refresh('<% nvram_char_to_ascii("", "custom_clientlist"); %>', function(cl){
+      var ml = (cl && cl.maclist) || [], out = [];
+      ml.forEach(function(mac){ var c = cl[mac], m = String(mac).toUpperCase(), nm;
+        if (!c || !rp.v.mac(m) || String(c.isOnline) === '0') return;
+        nm = ReaperNames.byMac(mac, m);
+        out.push({mac: m, label: (nm !== m ? nm + ' - ' : '') + m + (c.ip ? ' (' + c.ip + ')' : '')}); });
+      out.sort(function(a, b){ return a.label.toLowerCase() < b.label.toLowerCase() ? -1 : 1; });
+      DD_DEVS = out; ddPickDraw();
+    });
+  } catch (e) {}
 }
