+/* per radio: [wlN.1, wlN.2, wlN.3] - the main network, then the two other networks the radio can carry (BCM4916:
+   four BSSs per radio, wlN being the hidden backhaul carrier; wl0.4 is the AiMesh onboarding interface and never a
+   user network). Names may hold ' or \ */
 var U = rp.dec;
 var VSSID = [
   [U('<% nvram_char_to_ascii("","wl0.1_ssid"); %>'), U('<% nvram_char_to_ascii("","wl0.2_ssid"); %>'), U('<% nvram_char_to_ascii("","wl0.3_ssid"); %>')],
@@ -95,6 +103,36 @@ var VON = [
   ['<% nvram_char_to_ascii("","wl1.1_bss_enabled"); %>', '<% nvram_char_to_ascii("","wl1.2_bss_enabled"); %>', '<% nvram_char_to_ascii("","wl1.3_bss_enabled"); %>'],
   ['<% nvram_char_to_ascii("","wl2.1_bss_enabled"); %>', '<% nvram_char_to_ascii("","wl2.2_bss_enabled"); %>', '<% nvram_char_to_ascii("","wl2.3_bss_enabled"); %>'],
   ['<% nvram_char_to_ascii("","wl3.1_bss_enabled"); %>', '<% nvram_char_to_ascii("","wl3.2_bss_enabled"); %>', '<% nvram_char_to_ascii("","wl3.3_bss_enabled"); %>']];
+/* 2026-10-30: each network's type from its Guest Network Pro profile - sdn_rl records are idx>type>enable>vlan>
+   subnet>apg_idx, the SSID is apg<idx>_ssid - so a box says IoT Network, Kid's Network, VPN Network ... instead of
+   calling every non-main network a guest network. The stock labels (sdn.js wizard_type_text) */
+var SDN_RL = U('<% nvram_char_to_ascii("","sdn_rl"); %>');
+/* the main network is a MAINFH profile on wlN.1 once sdn_rl carries MAINFH rows; before that it is the primary wlN */
+var MIGRATED = SDN_RL.split('<').some(function(r){ return r.split('>')[1] === 'MAINFH'; });
+var PSSID = [U('<% nvram_char_to_ascii("","wl0_ssid"); %>'), U('<% nvram_char_to_ascii("","wl1_ssid"); %>'), U('<% nvram_char_to_ascii("","wl2_ssid"); %>'), U('<% nvram_char_to_ascii("","wl3_ssid"); %>')];
+var APG_SSID = ['', U('<% nvram_char_to_ascii("","apg1_ssid"); %>'), U('<% nvram_char_to_ascii("","apg2_ssid"); %>'), U('<% nvram_char_to_ascii("","apg3_ssid"); %>'), U('<% nvram_char_to_ascii("","apg4_ssid"); %>'), U('<% nvram_char_to_ascii("","apg5_ssid"); %>'), U('<% nvram_char_to_ascii("","apg6_ssid"); %>'), U('<% nvram_char_to_ascii("","apg7_ssid"); %>'), U('<% nvram_char_to_ascii("","apg8_ssid"); %>'), U('<% nvram_char_to_ascii("","apg9_ssid"); %>'), U('<% nvram_char_to_ascii("","apg10_ssid"); %>'), U('<% nvram_char_to_ascii("","apg11_ssid"); %>'), U('<% nvram_char_to_ascii("","apg12_ssid"); %>'), U('<% nvram_char_to_ascii("","apg13_ssid"); %>'), U('<% nvram_char_to_ascii("","apg14_ssid"); %>'), U('<% nvram_char_to_ascii("","apg15_ssid"); %>'), U('<% nvram_char_to_ascii("","apg16_ssid"); %>')];
+var TYPE_TXT = {Guest: `<#Guest_Network#>`, Employee: `<#GuestNetwork_Employee#>`, Portal: `<#GuestNetwork_Portal#>`, Kids: `<#GuestNetwork_Kid#>`,
+  IoT: `<#GuestNetwork_IoT#>`, VPN: `<#GuestNetwork_VPN#>`, Customized: `<#GuestNetwork_Customized#>`, MLO: `<#WiFi_mlo_title#>`, Gaming: `<#GuestNetwork_Gaming#>`};
+var NETTYPE = {}, HAS_PROF = false;
+SDN_RL.split('<').forEach(function(r){
+  var f = r.split('>'), t, s; if (f.length < 6 || f[2] === '0') return;
+  t = TYPE_TXT[f[1]]; s = APG_SSID[parseInt(f[5], 10)] || '';
+  if (t && s && !NETTYPE.hasOwnProperty(s)){ NETTYPE[s] = t; HAS_PROF = true; }
+});
+/* 2026-10-30 (field, GT-BE98 v3.6.2): device names. httpd sends only the DHCP lease hostname - what the device itself
+   reported, "*" when it reported none - and the stock page put the client list's name over an empty or "*" one; this
+   page had dropped that. Your name for the device first (custom_clientlist, then the live list), the lease hostname
+   after, as every other Reaper page does (reaper_util.js ReaperNames). */
+var CUSTOM_CL = '<% nvram_char_to_ascii("", "custom_clientlist"); %>', NAMES_AT = 0;
+function nameOf(mac, ip, lease){
+  var n = ReaperNames.byMac(mac, '') || (ip ? ReaperNames.byIp(ip, '') : '');
+  return n || (lease && lease !== '*' ? lease : '');
+}
+function names(){
+  if (Date.now() - NAMES_AT < 60000) return;
+  NAMES_AT = Date.now();
+  try { ReaperNames.refresh(CUSTOM_CL, function(){ draw(); }); } catch (e) {}
+}
 var SORT = {k: 'rssi', dir: -1}, timer = null, DATA = null;
 try { var s = JSON.parse(localStorage.getItem('rwlog_sort') || 'null'); if (s && s.k) SORT = s; } catch (e) {}
 
@@ -121,29 +159,49 @@ var COLS = [
 function secs(t){ var m = /(\d+):(\d+):(\d+)/.exec(t || ''); return m ? (+m[1]) * 3600 + (+m[2]) * 60 + (+m[3]) : -1; }
 function clients(list){
   return (list || []).filter(function(r){ return r && typeof r === 'object' && r.length >= 12; }).map(function(r){
-    return {mac: r[0], ip: r[1], name: r[2], ip6: r[3], rssi: parseInt(r[4], 10), rx: r[5], tx: r[6], rate: parseInt(r[6], 10) || 0,
+    return {mac: r[0], ip: r[1], name: nameOf(r[0], r[1], r[2]), ip6: r[3], rssi: parseInt(r[4], 10), rx: r[5], tx: r[6], rate: parseInt(r[6], 10) || 0,
       conn: String(r[7] || '').trim(), time: secs(r[7]), phy: [r[8] ? r[8] + 'x' : '', r[9], r[10]].filter(Boolean).join(' '), flags: r[11],
       tag: r[12] || '', vlan: r[13] && r[13] !== '0' ? r[13] : ''};
   });
 }
-/* the networks of radio i, keyed by the client tag: the main network first (shown even with no clients), the enabled
-   guests (wlN.2, wlN.3, then any other name a client carries), the primary BSS (mesh backhaul) last, only when used */
-var RANK = {main: 0, guest: 1, bh: 2};
+/* the networks of radio i, keyed by the client tag: the main network first (shown even with no clients), the other
+   enabled networks in slot order (wlN.2, wlN.3, then any other name a client carries), the primary BSS (mesh
+   backhaul) last, only when used. A network's label is its profile type; without a profile list (no Guest Network
+   Pro) the stock guest slots wlN.2 / wlN.3 are guest networks */
+var RANK = {main: 0, net: 1, bh: 2};
+function netType(i, ssid){
+  if (NETTYPE.hasOwnProperty(ssid)) return NETTYPE[ssid];
+  var s = VSSID[i].indexOf(ssid);   /* no profile list: the stock guest slots are guest networks */
+  return (!HAS_PROF && s >= (MIGRATED ? 1 : 0)) ? `<#Guest_Network#>` : '';
+}
 function nets(i, d, list){
-  var mainOn = VON[i][0] === '1', out = [], by = {}, main = {};
-  function add(key, kind, name){ if (!by[key]){ by[key] = {kind: kind, name: name, bssid: '', vlan: '', list: []}; out.push(by[key]); } return by[key]; }
+  var mainOn = VON[i][0] === '1', out = [], by = {}, s;
+  function add(key, kind, name){ if (!by[key]){ by[key] = {kind: kind, name: name, type: kind === 'net' ? netType(i, name) : '', bssid: '', vlan: '', list: []}; out.push(by[key]); } return by[key]; }
   /* Media Bridge / WDS / Stations serve no clients: no empty boxes there */
