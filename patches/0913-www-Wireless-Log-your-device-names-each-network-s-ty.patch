+      else if (c.tag) n = add(c.tag, 'net', c.tag);
+      else n = MIGRATED ? add('', 'main', '') : add('', 'net', VSSID[i][0]);
+    }
     if (c.vlan) n.vlan = c.vlan;
     n.list.push(c);
   });
-  /* in AP mode the radio's SSID / BSSID were read from wlN: give the BSSID to the box that SSID names */
-  var hit = d[0] && d[0] === main.name ? main : by['Main BSS'];
