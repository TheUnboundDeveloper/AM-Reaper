+  var hit = (d[0] && out.filter(function(n){ return n.name === d[0]; })[0]) || (MIGRATED ? by['Main BSS'] : null);
   if (hit && (d[7] === 'AP' || d[7] === 'Hybrid')) hit.bssid = d[5];
   out.forEach(function(n, k){ n.k = k; });
   return out.sort(function(a, b){ return RANK[a.kind] - RANK[b.kind] || a.k - b.k; });
@@ -158,7 +216,7 @@ function netHtml(n, col, cmp){
   var title = n.name || (n.kind === 'bh' ? `<#RLOG_78#>` : n.kind === 'main' ? `<#RLOG_79#>` : '-');
   var h = '<div class="net"><h3>' + hx(title) +
