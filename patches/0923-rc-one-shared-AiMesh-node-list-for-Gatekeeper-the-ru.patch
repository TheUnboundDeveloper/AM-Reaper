diff --git a/release/src/router/rc/reaper_aimesh.c b/release/src/router/rc/reaper_aimesh.c
new file mode 100644
index 00000000000..337e2228d35
--- /dev/null
+++ b/release/src/router/rc/reaper_aimesh.c
@@ -0,0 +1,107 @@
+/*
+ * rc/reaper_aimesh.c - the one AiMesh node list every Reaper enforcement surface reads (2026-11-01).
+ *
+ * AiMesh nodes are infrastructure, not clients. cfg_server's pairing registry, cfg_relist /
+ * cfg_relist_x (`<reMac>maclist2g>maclist5g>ts` / `<reMac>maclist6g>..`, records joined by '<'),
+ * holds each node's LAN MAC and every per-band STA MAC it connects with. Gatekeeper has exempted
+ * them since v2.7.3; until now it was the only surface that knew AiMesh existed - the rules engine
+ * (Service Intercept rewrites a service for EVERY LAN source, and a node is a LAN source) and
+ * Policy Routing carried no exemption, so one broad operator rule could cut a node off.
+ *
+ *  - reaper_aimesh_macs(): the parser, moved unchanged from gatekeeper.c gk_emit_relist(): every
+ *    MAC-shaped token in both lists, strict check (the MAC reaches a root-run script unquoted),
+ *    case-insensitive de-dup, at most `max` kept and the overflow counted for the caller to log.
+ *  - reaper_aimesh_sync (applet, /sbin symlink - `rc <applet>` does not dispatch): refreshes the
+ *    shared hash:mac set REAPER_AIMESH_SET from the registry as it is NOW. A staging set is filled
+ *    and swapped in under a lock, so a chain matching `-m set --match-set reaper_aimesh src -j
+ *    RETURN` never sees it half-filled and two callers never interleave. The consumers' scripts run
+ *    it when they start - an apply script re-run by restart_firewall must not put back the node list
+ *    from when it was generated - and rwatch runs it every tick, so a node that joins while
+ *    Gatekeeper is off (gkd, the registry watcher, runs only with Gatekeeper on) is exempt within
+ *    one tick. Gatekeeper keeps its per-MAC rules (ebtables has no set match) from the same parser.
+ */
+#include "rc.h"
+#include <ctype.h>
+
+#define AIMESH_STAGE  REAPER_AIMESH_SET "_n"
+#define AIMESH_COUNT  "/tmp/reaper/aimesh.n"
+
+/* strict MAC check - the same rule as gatekeeper.c gk_valid_mac / httpd / gkd */
+static int aimesh_valid_mac(const char *m)
+{
+	int i;
+	if (!m || strlen(m) != 17) return 0;
+	for (i = 0; i < 17; i++) {
+		if ((i % 3) == 2) { if (m[i] != ':') return 0; }
+		else if (!isxdigit((unsigned char)m[i])) return 0;
+	}
+	return 1;
+}
+
+int reaper_aimesh_macs(char macs[][18], int max, int *dropped)
+{
+	char *lists[2];
+	int n = 0, over = 0, i, li;
+
+	lists[0] = get_cfg_relist(0);
+	lists[1] = get_cfg_relist(1);
+	for (li = 0; li < 2; li++) {
+		char *p = lists[li];
+		if (!p) continue;
+		for (; *p; p++) {
+			char mac[18];
+			int dup = 0;
+			if (!isxdigit((unsigned char)p[0])) continue;
+			if (strlen(p) < 17) break;
+			memcpy(mac, p, 17);
+			mac[17] = '\0';
+			if (!aimesh_valid_mac(mac)) continue;
+			for (i = 0; i < n; i++)
+				if (strcasecmp(macs[i], mac) == 0) { dup = 1; break; }
+			if (!dup) {
+				if (n < max) strlcpy(macs[n++], mac, 18);
+				else over++;
+			}
+			p += 16;	/* the loop's ++ completes the 17-char skip */
+		}
+	}
+	free(lists[0]);
+	free(lists[1]);
+	if (dropped) *dropped = over;
+	return n;
+}
+
+int reaper_aimesh_sync_main(int argc, char *argv[])
+{
+	char macs[REAPER_AIMESH_MAX][18], prev[16] = "";
+	int n, i, dropped = 0, lock;
+	FILE *p;
+
+	n = reaper_aimesh_macs(macs, REAPER_AIMESH_MAX, &dropped);
+	lock = file_lock("reaper_aimesh");
+	eval("ipset", "create", REAPER_AIMESH_SET, "hash:mac", "-exist");
+	if ((p = popen("ipset restore -exist", "w")) != NULL) {
+		fprintf(p, "create " AIMESH_STAGE " hash:mac -exist\nflush " AIMESH_STAGE "\n");
+		for (i = 0; i < n; i++)
+			fprintf(p, "add " AIMESH_STAGE " %s\n", macs[i]);
+		pclose(p);
+		eval("ipset", "swap", AIMESH_STAGE, REAPER_AIMESH_SET);
+		eval("ipset", "destroy", AIMESH_STAGE);
+	}
+	file_unlock(lock);
+
+	/* log on change only: rwatch runs this every tick */
+	reaper_secure_dir("/tmp/reaper", 0700);
+	f_read_string(AIMESH_COUNT, prev, sizeof(prev));
+	{
+		char cur[16];
+		snprintf(cur, sizeof(cur), "%d/%d", n, dropped);
+		if (strcmp(prev, cur) != 0) {
+			f_write_string(AIMESH_COUNT, cur, 0, 0);
+			logmessage("reaper_aimesh", "AiMesh registry: %d infrastructure MAC(s) exempt from the rules engine and Policy Routing", n);
+			if (dropped)
+				logmessage("reaper_aimesh", "AiMesh registry has more than %d MACs - %d NOT exempted (a large tri-band mesh can exceed this)", REAPER_AIMESH_MAX, dropped);
+		}
+	}
+	return 0;
+}
