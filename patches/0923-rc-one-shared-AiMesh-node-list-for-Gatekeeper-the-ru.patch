 	for (d = RFW_D_IN; d <= RFW_D_OUT; d++) {
 		int v6;
@@ -2280,6 +2290,8 @@ static int rfw_gen_apply(const char *path, const rfw_cfg_t *c, int teardown_only
 			const char *ch  = rfw_chain_of(d);
 			fprintf(f, "%s -N %s 2>/dev/null; RFWH %s -F %s\n", ipt, ch, ipt, ch);
 			rfw_emit_head(f, v6, d);
+			if (d != RFW_D_OUT)	/* 2026-11-01: AiMesh nodes skip the engine (OUTPUT has no source MAC) */
+				fprintf(f, "RFWR %s -A %s -m set --match-set " REAPER_AIMESH_SET " src -j RETURN\n", ipt, ch);
 			rfw_emit_rules(f, c, v6, d);
 			if (d == RFW_D_FWD) {
 				/* precedence: explicit rules, then the per-device egress
diff --git a/release/src/router/rc/reaper_pbr.c b/release/src/router/rc/reaper_pbr.c
