From bacb4dda4a3d7715fb5973e134546d1f3f1ce33d Mon Sep 17 00:00:00 2001
From: reaper <theunbounddeveloper@outlook.com>
Date: Mon, 2 Nov 2026 09:50:04 -0500
Subject: [PATCH] www: AiMesh and Network carry their own Reaper stylesheet
 (102.8 line)

Owner (2026-11-01): no stock theme and no injected one. AiMesh.asp and the Network page (SDN.asp
and the two documents of the network app, SDN/sdn.html and SDN/mlo.html) keep the stock markup
and link their own stylesheet as the last one in the head - reaper/reaper_content_aimesh.css and
reaper/reaper_content_network.css, built from reaper_content.css (the rules those pages use).
Computed styles compared element by element in the mock against the injected skin: AiMesh 2178
and Network 1623 element states identical. `theme` is forced empty in AiMesh.asp, sdn.html and
mlo.html, so the stock alternate themes never load (the previous commit stops shipping them and
gives the four pages httpd mode 2).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 release/src/router/www/AiMesh.asp             |   4 +-
 .../www/reaper/reaper_content_aimesh.css      | 550 +++++++++++++++++
 .../www/reaper/reaper_content_network.css     | 559 ++++++++++++++++++
 .../www/sysdep/FUNCTION/SDN/SDN/mlo.html      |   4 +-
 .../www/sysdep/FUNCTION/SDN/SDN/sdn.html      |   4 +-
 5 files changed, 1118 insertions(+), 3 deletions(-)
 create mode 100644 release/src/router/www/reaper/reaper_content_aimesh.css
 create mode 100644 release/src/router/www/reaper/reaper_content_network.css

diff --git a/release/src/router/www/AiMesh.asp b/release/src/router/www/AiMesh.asp
index 93c9337eaff..fef2be19bc7 100644
--- a/release/src/router/www/AiMesh.asp
+++ b/release/src/router/www/AiMesh.asp
@@ -46,7 +46,7 @@ function getSafeTheme(paramName, allowedValues = ['WHITE', 'ROG', 'TUF', '']) {
 	return allowedValues.includes(safePrefix) ? safePrefix : "";
 }
 
-var theme = getSafeTheme("current_theme").toUpperCase();
+var theme = "";	/* reaper 2026-11-01: one theme - the Reaper stylesheet linked in the head; the stock WHITE/ROG/TUF variants are not shipped */
 if(theme == "WHITE"){
 	$('link').filter("[href*='/aimesh/aimesh_topology.css']").after('<link rel="stylesheet" type="text/css" href="/aimesh/aimesh_topology_' + theme + '.css">');
 }
@@ -99,6 +99,8 @@ function change_tab(_index){
 	}
 }
 </script>
+<!-- reaper 2026-11-01: this page's Reaper theme - last stylesheet in the head, where httpd used to inject it -->
+<link rel="stylesheet" type="text/css" href="/reaper/reaper_content_aimesh.css">
 </head>
 
 <body onload="initial();" onunLoad="return unload_body();" class="bg">
diff --git a/release/src/router/www/reaper/reaper_content_aimesh.css b/release/src/router/www/reaper/reaper_content_aimesh.css
new file mode 100644
index 00000000000..09fdb0898b7
--- /dev/null
+++ b/release/src/router/www/reaper/reaper_content_aimesh.css
@@ -0,0 +1,550 @@
+/* SPDX-License-Identifier: GPL-2.0-only
+ * Copyright (C) 2026 the Reaper project maintainer
+ * Part of the Reaper hardened Asuswrt-Merlin build. See LICENSE / LICENSE.reaper. */
+/* REAPER theme for the AiMesh page (AiMesh.asp and the aimesh/ parts it loads into itself).
+   These stay the stock ASUS pages; this file is their whole and only Reaper look. Each page links it
+   as the last stylesheet in its <head> (AiMesh.asp); httpd injects no stylesheet into them
+   (httpd/reaper_inject.c reaper_own_theme[]) and the stock alternate themes do not ship.
+   Built 2026-11-01 from reaper_content.css: every rule that can match anything this page renders,
+   in the same order, with its comments; rules for other pages left out. Computed styles were
+   compared old vs new on the rendered page: identical. Style this page HERE from now on.
+   The file name keeps the "reaper_content" prefix on purpose: reaper_shell.asp re-injects
+   reaper_content.css into a framed stock page that has no link[href*="reaper_content"].
+   RULE: pure ASCII only - the www packaging minifier strips non-ASCII bytes. */
+@font-face{font-family:'Rajdhani';font-weight:600;font-display:swap;src:url('/fonts/rajdhani-600.woff2') format('woff2')}
+@font-face{font-family:'Rajdhani';font-weight:700;font-display:swap;src:url('/fonts/rajdhani-700.woff2') format('woff2')}
+@font-face{font-family:'Inter';font-weight:400;font-display:swap;src:url('/fonts/inter-400.woff2') format('woff2')}
+@font-face{font-family:'Inter';font-weight:500;font-display:swap;src:url('/fonts/inter-500.woff2') format('woff2')}
+/* ---------- 1. strip stock chrome / geometry ---------- */
+#TopBanner,#mainMenu,#subMenu,#footer,.banner1{display:none!important}
+html{scrollbar-width:thin;scrollbar-color:#E10600 #000}
+::-webkit-scrollbar{width:12px;height:12px}
+::-webkit-scrollbar-track{background:#000}
+::-webkit-scrollbar-thumb{background:#E10600;border-radius:8px;border:2px solid #000}
+body,body.bg{background:#08080a!important;background-image:
+  radial-gradient(1100px 420px at 20% -12%,rgba(225,6,0,.08),transparent 60%)!important;
+  margin:0!important;padding:16px 20px!important;min-width:0!important;
+  font-family:'Inter','Segoe UI',system-ui,sans-serif}
+table.content{margin:0!important;width:100%!important}
+table.content>tbody>tr>td[width="17"]{display:none!important}
+table.content>tbody>tr>td:has(#mainMenu){display:none!important}
+/* ---------- 2. in-page tab strip: HIDDEN - the reaper shell renders the tabs
+   itself (from menuTree) above the frame, reliably for every page ---------- */
+#tabMenu,.submenuBlock{display:none!important}
+/* page title / description block: force visible as a defense against any
+   stock hide logic - these must always show at the top of the content */
+.formfonttitle,.formfontdesc{display:block!important;visibility:visible!important;opacity:1!important}
+div.container{display:block!important}
+/* ---------- 3. content panels ---------- */
+.FormTitle{background:linear-gradient(180deg,#141418,#0f0f12)!important;
+  border:1px solid rgba(255,255,255,.06)!important;border-radius:14px!important;
+  width:100%!important;max-width:1100px!important;box-shadow:none!important}
+.FormTitle>tbody>tr>td[bgcolor]{background:transparent!important}
+td[bgcolor="#4D595D"]{background:transparent!important}
+.formfonttitle{color:#ECE7DB!important;font-family:'Rajdhani','Oswald',system-ui,sans-serif!important;
+  font-weight:600!important;letter-spacing:.08em!important;text-transform:uppercase!important;font-size:16px!important}
+.splitLine{background:none!important;border-bottom:1px solid rgba(225,6,0,.35)!important;height:1px!important}
+/* settings tables */
+.FormTable,.FormTable_table{background:#0c0c0f!important;border:1px solid rgba(255,255,255,.08)!important;
+  border-radius:8px!important;border-collapse:separate!important;border-spacing:0!important}
+.FormTable th,.FormTable_table th{background:#101014!important;color:#B7B1A4!important;
+  border-color:rgba(255,255,255,.06)!important;font-weight:500!important;text-shadow:none!important}
+.FormTable td,.FormTable_table td{background:#0c0c0f!important;color:#ECE7DB!important;
+  border-color:rgba(255,255,255,.06)!important}
+/* gradient lives on the ROW: multi-td header rows would restart the gradient
+   per cell (seen on QoS user rules) */
+.FormTable thead tr,.FormTable_table thead tr{
+  background:linear-gradient(90deg,rgba(225,6,0,.25),#141418)!important}
+.FormTable thead td,.FormTable_table thead td{
+  background:transparent!important;color:#ECE7DB!important;
+  font-family:'Rajdhani','Oswald',system-ui,sans-serif!important;font-weight:600!important;
+  letter-spacing:.08em!important;text-shadow:none!important;border-color:rgba(255,255,255,.08)!important}
+.hintstyle,.hintstyle:link,.hintstyle:visited{color:#ECE7DB!important}
+.hintstyle:hover{color:#E10600!important}
+/* ---------- 4. controls ---------- */
+input[type="text"],input[type="password"],input[type="number"],textarea,
+.input_3_table,.input_6_table,.input_12_table,.input_15_table,.input_18_table,
+.input_20_table,.input_22_table,.input_25_table,.input_30_table,.input_32_table,.input_option{
+  background:#000!important;color:#ECE7DB!important;border:1px solid rgba(255,255,255,.12)!important;
+  border-radius:6px!important;text-shadow:none!important}
+input[type="text"]:focus,input[type="password"]:focus,textarea:focus{border-color:rgba(225,6,0,.5)!important;outline:none!important}
+input:disabled,.client_input_text_disabled{background:#0c0c0f!important;color:#71767b!important}
+select{background:#000!important;color:#ECE7DB!important;border:1px solid rgba(255,255,255,.12)!important;border-radius:6px!important}
+input[type="radio"],input[type="checkbox"]{accent-color:#E10600!important}
+.button_gen,.button_gen_long,input.button_gen{background:linear-gradient(180deg,#1a1a1f,#101014)!important;
+  color:#ECE7DB!important;border:1px solid rgba(255,255,255,.14)!important;border-radius:8px!important;
+  font-family:'Rajdhani','Oswald',system-ui,sans-serif!important;font-weight:600!important;
+  letter-spacing:.08em!important;text-shadow:none!important;box-shadow:none!important}
+.button_gen:hover,.button_gen_long:hover{border-color:#E10600!important;color:#fff!important;
+  background:linear-gradient(180deg,#2a0507,#160204)!important}
+/* log viewer + misc text */
+textarea,.textarea_log,.textarea_log_table{background:#000!important;color:#B7B1A4!important;
+  font-family:Consolas,Monaco,monospace!important;border:1px solid rgba(255,255,255,.1)!important}
+a:link,a:visited{color:#E0A93B}
+a:hover{color:#E10600}
+/* ---------- 5. stock banner-offset shims ---------- */
+table#FormTitle{margin-top:0!important}
+table[bgcolor="#4d595d"],table[bgcolor="#4D595D"],td[bgcolor="#4d595d"]{background:transparent!important}
+/* state.js browser_compatibility() re-wraps the whole content cell in a div
+   with an inline margin-top:-140px AFTER load (tucks content under the stock
+   banner); important beats inline, attribute selector tracks the JS write */
+div[style*="margin-top:-140px"],div[style*="margin-top: -140px"]{margin-top:0!important}
+/* ---------- 6. per-page fixes ---------- */
+/* popup.js showLoading()/showLoadingBar() set inline overflow:hidden on the
+   html element; if the restore path stalls the framed page can never scroll
+   again (VPN Status symptom) - keep vertical scrolling available */
+html{overflow-y:auto!important}
+/* ...but the RWD SPA pages (SDN/MLO/AdGuard/Multi-WAN etc., body.body_rwd) are
+   auto-sized to their content by resize_iframe_height (rwd_component.js:
+   .container height + 30px bottom margin), so the injected body padding pushed
+   them a few px past that and forced a redundant inner scrollbar on top of the
+   shell's page scrollbar. Hide the inner one - the iframe already fits the
+   content and the 30px margin is the buffer. */
+html:has(.body_rwd){overflow-y:hidden!important}
+/* GameBoost Gear Accelerator ON/OFF toggle: labels overflow the 50px halves
+   with the wider Inter body font - condensed Rajdhani at a tighter size */
+.switch .container{font-family:'Rajdhani',system-ui,sans-serif!important}
+.switch .container div div{font-size:15px!important;letter-spacing:.02em}
+/* remaining stock chrome surfaces */
+tr[bgcolor="#4D595D"],tr[bgcolor="#4d595d"]{background:transparent!important}
+/* ---------- 7. recolor: stock blue accents -> reaper palette ----------
+   CONTROLS AND CHROME ONLY. Data visualizations keep their stock colors:
+   bandwidth-monitor gauges/needles/bars, speedtest dial + rainbow scale,
+   traffic charts, signal meters, CPU/RAM core colors, status greens. */
+/* scrollbars: the stock html::-webkit-* rules in form_style.css carry
+   !important and higher specificity than the section-1 pseudo rules, so
+   every page still showed the stock blue thumb - beat them here */
+html::-webkit-scrollbar{display:block!important;width:12px!important;height:12px!important;padding:0!important}
+html::-webkit-scrollbar-thumb{background-color:#E10600!important;border:2px solid #000!important;border-radius:8px!important}
+html::-webkit-scrollbar-track{background-color:#000!important}
+/* toggle switches - all three stock mechanisms. User choice: NEUTRAL GREY,
+   not crimson (an ON toggle in brand-red read as an alert/warning) */
+.switch input:checked~.container{background:linear-gradient(180deg,#6b6b72,#45454b)!important}
+img.iphone_switch{filter:grayscale(1) brightness(.85)!important}
+/* selected pills / tab chips (AiProtection, Parental Controls, AiDisk) */
+.clicked{background-color:#E10600!important;box-shadow:0 0 6px rgba(225,6,0,.45)!important}
+.click:hover{background-color:rgba(225,6,0,.45)!important;box-shadow:none!important}
+.folderClicked{color:#E10600!important}
+/* dropdown suggestion lists + clickable rows: stock #3366FF hover */
+div[id$="_Block_PC"] div:hover,#ClientList_Block a:hover,#WDSAPList div:hover,
+.clientlist_dropdown div:hover,.clientlist_dropdown a:hover,
+.dns_server_list_dropdown div:hover,.dns_server_list_dropdown a:hover,
+#QoSList_Block div:hover,.table_clientlist_item:hover,
+.WL_MAC_Block div:hover,.WL_MAC_Block a:hover,
+.StatusClickHint_mouseover{background-color:#B3000C!important;color:#fff!important}
+/* buttons still on the stock blue gradient */
+.button_gen_touch,.titlebtn:hover,.button_gen_dis:hover,
+.confirm_button_gen_long_left:hover,.confirm_button_gen_long_right:hover{
+  background:linear-gradient(180deg,#2a0507,#160204)!important;
+  border-color:#E10600!important;color:#fff!important}
+.actionButtonOK{background-color:#E10600!important;color:#fff!important}
+.confirm_button:hover,.confirm_button:active{background:#B3000C!important}
+.statustext{color:#B7B1A4!important}
+.sub_title{color:#ECE7DB!important}
+.band_block{border-color:#E10600!important;color:#FFF!important}
+/* jquery-ui slider (network map and friends) */
+.ui-slider .ui-slider-range{background:#E10600!important}
+.ui-slider .ui-slider-handle{background:#ECE7DB!important;border-color:#E10600!important}
+/* popup containers on the stock blue-tinted gradient */
+.popup_container .popup_content_container{background:#0f0f12!important;border:1px solid rgba(225,6,0,.35)!important}
+/* InternetSpeed wraps the speedtest in a bare div#FormTitle with an inline
+   grey background */
+div#FormTitle{background-color:#0f0f12!important}
+/* ---------- 8. teal sweep: remaining stock teal/grey-green surfaces ----------
+   yellow hint/value text stays YELLOW by design - only the teal surfaces
+   behind text and entry fields go dark */
+/* entry fields section 4 missed */
+.input_macaddr_table,.devicepin,.top-input,.query_list,.textarea_ssh_table,
+.IPaddr,.IPaddr input,.input_option_left,.input_option optgroup,select optgroup{
+  background:#000!important;color:#ECE7DB!important;
+  border:1px solid rgba(255,255,255,.12)!important;text-shadow:none!important}
+/* dropdown list bodies (items were teal #576D73 / white #EFEFEF) */
+#QoSList_Block,#QoSList_Block div,.dns_server_list_dropdown,.dns_server_list_dropdown div,
+.clientlist_dropdown,.clientlist_dropdown div,
+div[id$="_Block_PC"],div[id$="_Block_PC"] div,div[id$="_Block_PC"] a{
+  background-color:#0c0c0f!important;color:#ECE7DB!important}
+/* teal panels / containers */
+.MainContent,.content_bg,.list_bg,.block_bg,.tab_info_bg,.analysis_bg,.pop_div_bg,
+.qrcodepanel,.qrcodepanelpad,.eula_panel_container,.tm_title_bg,.aidisk1_table,
+.list_table,.textarea_bg,.FormTitle thead,.popup_bg,.popup_bar_bg,
+.s46_ports,.s46_ports_pf,.primary_wan_connected,.secondary_wan_connected,
+.single_wan_connected{background:#0f0f12!important}
+/* teal tab strips still drawn in-page */
+.tab,.tab_item,.tab_NW,.block_filter{background:#141418!important}
+.tab:hover,.tabClicked,.tab_item:hover,.tab_item_click,.block_filter_pressed,
+.vpnClientTitle_td_click{background:rgba(225,6,0,.22)!important}
+#sortable div table tr:hover{background:#2a0507!important}
+/* ---------- 9. network map: index.asp cards + device-map/* iframes ---------- */
+.NM_table{background-color:#0f0f12!important;border:1px solid rgba(255,255,255,.06)!important}
+[bgcolor="#444f53"],[bgcolor="#444F53"]{background:#141418!important}
+#iconInternet,#iconInternet_primary,#iconInternet_secondary,#iconRouter,#iconClient,
+#iconWebcam,#iconRemote,.iconPrinter,.iconmodem,
+.iconAMesh,.iconAMesh_dis{
+  filter:grayscale(1) sepia(1) hue-rotate(-50deg) saturate(3) brightness(.95)}
+.statusbody,.NM_radius_bottom_container{background:#0f0f12!important}
+.table-header{background:#101014!important}
+.card_table td,.clientlist_content,.usericons_content,.client_upload_div,
+.clientlist_viewlist{background-color:#0f0f12!important}
+.nav li{background-color:#141418!important}
+.nav li:hover{background-color:#B3000C!important}
+.Tablehead,.Tabletitle td,.top-message,.top-message1,.top-messgae,.top-messgaea,
+.top-messgae1,.top-messgae2,.top-messgae3{background-color:#101014!important;color:#ECE7DB!important}
+.clients span,.style1{color:#ECE7DB!important}
+.input{background:#000!important;color:#ECE7DB!important;border:1px solid rgba(255,255,255,.12)!important}
+.button{background:linear-gradient(180deg,#1a1a1f,#101014)!important;color:#ECE7DB!important;
+  border:1px solid rgba(255,255,255,.14)!important}
+.client_tag{background-color:#1a1a1f!important}
+.clientIcon,.clientIcon_clicked,.clientIcon_no_hover,.vendorIcon_no_hover,
+.client_canvasUserIcon,.imgUserIcon_card,.imgUserIcon_viewlist,
+.custom_icon_category .category_content div{background-color:#141418!important}
+.clientIcon:hover,.clientIcon.clicked,.imgUserIcon_card:hover,
+.custom_icon_list_bg .custom_icon_category .category_content div:hover{
+  background-color:rgba(225,6,0,.35)!important}
+.port_status_bg:before,.port_status_bg .label_W_bg:before{background:#141418!important}
+.usb_text,.status{color:#B7B1A4!important}
+/* v1.2.4a: the mounted-disk label (.usb_text.plugin) used white text on a heavy #000
+   text-shadow that read as a black box; bone text + a light shadow instead. */
+.usb_text.plugin{color:#ECE7DB!important;text-shadow:0 1px 2px rgba(0,0,0,.55)!important}
+/* ---------- 10. visual-audit fixes (113-page stock-vs-reaper review) ---------- */
+/* AiProtection event/activity cards + tables paint their grey fills via
+   INLINE style attributes, which the [bgcolor] rules never matched */
+[style*="background-color:#444f53"],[style*="background-color: #444f53"],
+[style*="background-color:#444F53"],[style*="background:#444f53"],
+[style*="background: #444f53"]{background-color:#141418!important}
+.edit_text_content,.edit_text_tool_combine_select,
+.edit_text_tool_combine_input{background:#000!important;color:#ECE7DB!important}
+/* ---------- 11. AiMesh (AiMesh.asp + device-map/amesh.asp) - own CSS bundle
+   (aimesh/aimesh_topology.css etc.), untouched by earlier sections.
+   Chrome/controls only: panels, tabs, buttons, dropdowns, radios; product
+   photos and the intro illustration stay stock ---------- */
+/* steel gradient buttons -> dark */
+.node_btn_control > div,.manage_btn{
+  background-image:linear-gradient(-180deg,#1d1d22 0%,#101014 100%)!important;
+  border:1px solid rgba(255,255,255,.14)!important}
+.node_btn_control > div:hover,.manage_btn:hover{
+  border-color:rgba(225,6,0,.7)!important;color:#fff!important}
+/* Clients / Network / Management category tabs */
+.category_bg{background-image:linear-gradient(#17171b 1%,#101014 100%)!important}
+.category_bg.clicked{background-image:linear-gradient(#3a0a0c 1%,#17171b 100%)!important}
+/* client-list All/Wired/Wireless tab strip */
+.client_tab_bg div.clicked{background-image:linear-gradient(#3a0a0c 1%,#17171b 100%)!important}
+/* grey hover slabs */
+.info_right,.jstree-default .jstree-hovered,
+.client_list_bg .client_action_bg > span:hover{background:#1b1b20!important}
+/* node dropdown */
+.custom_select_selected,.custom_pure_text{background-color:#141419!important;
+  border-color:rgba(255,255,255,.12)!important}
+.custom_select_items{background-color:#0d0d10!important}
+.custom_select_items div:hover{background-color:rgba(225,6,0,.15)!important}
+/* content slabs */
+.item_bg,.item_space,.backhaul_info .backhaul_bg{background-color:#141419!important}
+/* blue radio dot + optimize badge -> crimson */
+.custom_radio_label.checked:before{background-color:#E10600!important}
+.product_icon_container.optimize{background:linear-gradient(315deg,rgba(225,6,0,0) -2.81%,#E10600 42.25%,#7a0300 67.78%,rgba(122,3,0,0) 101.56%)!important}
+/* cyan svg sprite icons -> crimson (tab glyphs, connect-type badges).
+   NOT the node product images (.amesh_router_image_web = real photos) */
+.category_bg > div:before,
+[class*="client_connect_icon"],
+.amesh_each_router_icon_bg.amesh_router_icon{
+  filter:grayscale(1) sepia(1) hue-rotate(-50deg) saturate(3) brightness(.95)}
+/* the big steel content panels + node-list blue accents */
+#manage_block,#client_block{background-color:#101014!important}
+.card_block_bg{background:#141419!important;border:1px solid rgba(255,255,255,.08)!important}
+/* blue location_topology.svg node glyph in the tree -> crimson (filter the
+   whole <i>, the sprite may sit on the element or its :before; keep real
+   product photos untouched) */
+.jstree-themeicon.topology_icon:not(.cloud_product_icon){
+  filter:grayscale(1) sepia(1) hue-rotate(-50deg) saturate(3) brightness(.95)}
+#jstree::-webkit-scrollbar-thumb{background-color:#E10600!important}
+.common_content_bg{background:#141419!important}
+.jstree-clicked .product_icon_container{
+  border:1px solid #E10600!important;
+  box-shadow:0 0 2px 0 rgba(0,0,0,.6),0 0 2px 2px rgba(225,6,0,.35),0 0 4px 0 rgba(0,0,0,.2)!important}
+/* AiMesh top tabs (Topology / System Settings): the generic .clicked rule
+   painted a bright-red FILL; make them read as tabs with a maroon underline */
+.aimesh_tab > span{color:#B7B1A4!important;background:transparent!important;box-shadow:none!important}
+.aimesh_tab > span.clicked{color:#ECE7DB!important;background:transparent!important;box-shadow:none!important}
+.aimesh_tab > span.clicked:before{border-bottom:2px solid #B3000C!important}
+/* v1.4.7/1.4.9a: the location photo behind the router/node name -> the ASUS logo.
+   v1.4.9a extends the logo band DOWN behind the room selector so the dropdown sits
+   ON the image, its bottom landing a few px above the divider under the room row.
+   Painted as a ::before layer behind the (now transparent) icon/space/location rows
+   so NO content moves; the model name/MAC and the room dropdown render on top. */
+.primary_info_bg{position:relative}
+.primary_info_bg::before{content:"";position:absolute;left:0;right:0;top:0;
+  height:234px;   /* KNOB: raise toward / lower away from the divider under the room selector (target 2-5px above it) */
+  background:url("/images/RLogo.png") no-repeat center;background-size:100% 100%;
+  border-radius:4px 4px 0 0;z-index:0;pointer-events:none}
+.primary_info_bg > .icon_bg{height:176px!important;background:transparent!important;position:relative;z-index:1}
+.primary_info_bg > .icon_bg .translucent_bg{background:none!important;height:100%!important}
+.primary_info_bg > .item_space{background:transparent!important;position:relative;z-index:1}
+.primary_info_bg > .item_bg.location{background:transparent!important;position:relative;z-index:1}
+/* 2026-08-11: centre the model name over the MAC line. Stock right-aligns both
+   (.model_info_bg text-align:right, .model_name justify-content:flex-end) inside
+   a shrink-to-fit absolute box, so the two lines only line up on their right
+   edge - "RT-BE96U" (24px) is narrower than "MAC | 10:7C:..." (12px) and hangs
