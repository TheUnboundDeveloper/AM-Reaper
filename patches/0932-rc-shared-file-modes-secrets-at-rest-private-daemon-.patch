+/* reaper (review 2026-11-03, E-4): hotplug2's first rule (/rom/etc/hotplug2.rules) makes every
+ * new device node 0644, so any uid could read a whole USB disk (/dev/sdX) or send it SCSI
+ * commands (/dev/sgN). The asus_sd / asus_sg applets run right after it for each one; only
+ * root uses these nodes (the mount, Samba and FTP work on the mounted volume). */
+static void reaper_devnode_private(const char *name, const char *action)
+{
+	char path[64];
+	const char *c;
+
+	if (!name || !action || strcmp(action, "add") || !*name || strlen(name) > 16)
+		return;
+	for (c = name; *c; c++)
+		if (!((*c >= 'a' && *c <= 'z') || (*c >= '0' && *c <= '9')))
+			return;
+	snprintf(path, sizeof(path), "/dev/%s", name);
+	chmod(path, 0600);
+}
