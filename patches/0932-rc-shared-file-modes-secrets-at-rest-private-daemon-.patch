+/* reaper (review 2026-11-03, E-3/E-4): what only root may open or write, set every boot.
+ * - The BSP's make_static_devnodes.sh mknods the Broadcom driver nodes under umask 022, so
+ *   they come out 0644 and any uid can open them and issue ioctls (blog, fcache, Runner,
+ *   BDMF shell, VLAN, BPM...). busybox mdev is built without mdev.conf support, so the
+ *   "666 !" rules the BSP generates into mdev.conf never apply: this is where their mode
+ *   is set. Raw disk and SCSI-generic nodes present now get the same; later ones are handled
+ *   by the asus_sd / asus_sg hotplug applets (rc/rc.c).
+ * - Broadcom's proc_create_cmd() made every /proc/driver/<drv>/cmd 0666 (PHY/MDIO register
+ *   writes, MAC registers, frame injection). bcm_enet is linked from a prebuilt object, so
+ *   the header fix cannot reach its entries: group/other write comes off every file under
+ *   /proc/driver here.
+ * - The /jffs copy of the kernel-nvram commit file (E-2), when the closed nvram library has
+ *   written one.
+ * Every user of these is root. Called after the static nodes exist and again before the
+ * services start, when every driver module has loaded. */
+static void reaper_proc_nowrite(const char *dir, int depth)
+{
+	char path[512];
+	struct stat st;
+	struct dirent *e;
+	DIR *d;
+
+	if (depth > 4 || (d = opendir(dir)) == NULL)
+		return;
+	while ((e = readdir(d)) != NULL) {
+		if (e->d_name[0] == '.')
+			continue;
+		snprintf(path, sizeof(path), "%s/%s", dir, e->d_name);
+		if (lstat(path, &st) != 0)
+			continue;
+		if (S_ISDIR(st.st_mode))
+			reaper_proc_nowrite(path, depth + 1);
+		else if (S_ISREG(st.st_mode) && (st.st_mode & 022))
+			chmod(path, st.st_mode & 07755);
+	}
+	closedir(d);
+}
+
+static void reaper_root_only_perms(void)
+{
+	static const char *const nodes[] = {
+		"fcache", "bpm", "bcm_user_tod", "tms", "pktrunner", "ext_bonding", "bcmepon",
+		"bcm_user_ploam", "laser_dev", "bcm_omci", "bcm_ploam", "bdmf_shell", "rgs_logger",
+		"bcmvlan", "buzzz", "sysperf", "spdsvc", "bcmxtmcfg0", "bcm", "bcmatm0", "bcmadsl0",
+		"bcmadsl1", "bcmphydiag", "blog", "archer", "mpm", "slicslac", "dect", "dectdbg",
+		"ac97", "bp3", "vfbio", "kmsg", "kmem", NULL
+	};
+	char path[300];
+	struct stat st;
+	struct dirent *e;
+	DIR *d;
+	int i;
+
+	for (i = 0; nodes[i]; i++) {
+		snprintf(path, sizeof(path), "/dev/%s", nodes[i]);
+		if (lstat(path, &st) == 0 && (S_ISCHR(st.st_mode) || S_ISBLK(st.st_mode)) && (st.st_mode & 077))
+			chmod(path, 0600);
+	}
+	if ((d = opendir("/dev")) != NULL) {
+		while ((e = readdir(d)) != NULL) {
+			if (strncmp(e->d_name, "sd", 2) && strncmp(e->d_name, "sg", 2))
+				continue;
+			snprintf(path, sizeof(path), "/dev/%s", e->d_name);
+			if (lstat(path, &st) == 0 && (S_ISCHR(st.st_mode) || S_ISBLK(st.st_mode)) && (st.st_mode & 077))
+				chmod(path, 0600);
+		}
+		closedir(d);
+	}
+	reaper_proc_nowrite("/proc/driver", 0);
+	if (lstat("/jffs/.kernel_nvram.setting", &st) == 0 && S_ISREG(st.st_mode) && (st.st_mode & 077))
+		chmod("/jffs/.kernel_nvram.setting", 0600);
+	if (lstat("/jffs/cert.tgz", &st) == 0 && S_ISREG(st.st_mode) && (st.st_mode & 077))
+		chmod("/jffs/cert.tgz", 0600);	/* C-3: the HTTPS and CA private keys are inside */
+	/* review 2026-11-03 (metal): /etc/email (the notification mailer's config) came up 0777, non-sticky, from closed
+	 * code - made root's 0755 before it exists, and again if it does */
+	if (lstat("/etc/email", &st) != 0)
+		mkdir("/etc/email", 0755);
+	else if (S_ISDIR(st.st_mode) && (st.st_mode & 022))
+		chmod("/etc/email", 0755);
+}
+
 static void sysinit(void)
 {
 #if defined(RTCONFIG_DEBUG)
@@ -25614,11 +25695,19 @@ static void sysinit(void)
 	}
 	// LPRng support
 	mkdir("/var/state", 0777);
-	mkdir("/var/state/parport", 0777);
-	mkdir("/var/state/parport/svr_statue", 0777);
-
-	mkdir("/var/lock", 0777);
-	mkdir("/var/tmp/dhcp", 0777);
+	/* review 2026-11-03 (metal): sticky - the print server still creates its files here, nobody else's can be
+	 * removed or replaced (0777 non-sticky before) */
+	mkdir("/var/state/parport", 01777);
+	mkdir("/var/state/parport/svr_statue", 01777);
+
+	/* reaper (review 2026-11-03, C-1): 0755, not ASUS's 0777. PID 1 takes every rc lock here
+	 * (/var/lock/firewall.lock first) with a blocking F_SETLKW, and a world-writable, non-sticky
+	 * lock directory let any uid swap a lock file for its own and hold it, wedging rc until a
+	 * power cycle. Only root locks or writes in either; the chmod covers an existing directory. */
+	mkdir("/var/lock", 0755);
+	chmod("/var/lock", 0755);
+	mkdir("/var/tmp/dhcp", 0755);
+	chmod("/var/tmp/dhcp", 0755);
 	mkdir("/home/root", 0700);
 	/* 01777, not 0777: without S_ISVTX any uid can unlink or rename another's
 	 * entry in /tmp, so a non-root foothold can delete a root-owned file and
@@ -25637,11 +25726,18 @@ static void sysinit(void)
 	f_write_string("/proc/sys/fs/protected_hardlinks", "1", 0, 0);
 	f_write_string("/proc/sys/fs/protected_regular", "1", 0, 0);
 	f_write_string("/proc/sys/fs/protected_fifos", "1", 0, 0);
+	/* review 2026-11-03 (E-7): kernel addresses (/proc/kallsyms, %pK) and the kernel log only for root -
+	 * KASLR means nothing while any process can read the text base; every reader here is root */
+	f_write_string("/proc/sys/kernel/kptr_restrict", "2", 0, 0);
+	f_write_string("/proc/sys/kernel/dmesg_restrict", "1", 0, 0);
 	/* ...and every Reaper directory exists, root-owned, before any service
 	 * starts, so nothing can be planted in its place (shared/reaper_tmpsafe.h) */
 	reaper_tmp_mkdirs();
 #ifdef RTCONFIG_USB
-	chmod(POOL_MOUNT_ROOT, 0777);
+	/* reaper (review 2026-11-03, C-1): 0755, not 0777. rc makes every mount point here as root;
+	 * a world-writable /tmp/mnt let any uid plant a symlink where an unlabeled volume's mount
+	 * point would go, and mount(2) follows it (rc/usb.c mount_r() refuses a link as well) */
+	chmod(POOL_MOUNT_ROOT, 0755);
 #endif
 	f_write("/etc/hosts", NULL, 0, 0, 0644);			// blank
 	f_write("/etc/fstab", NULL, 0, 0, 0644);			// !!TB - blank
@@ -25652,8 +25748,9 @@ static void sysinit(void)
 	 * without an explicit mode (fopen "w", a shell ">") was 0666 - writable by
 	 * the non-root services (dnsmasq and tftpd as nobody, Entware daemons)
 	 * before root read it back. Placed here, after the directory block above,
-	 * so each directory ASUS made 0777 on purpose (/var/lock, /var/state,
-	 * /var/tmp/dhcp; /tmp is 01777) keeps exactly its stock mode. The services
+	 * so each directory made with an explicit mode above keeps exactly that mode
+	 * (/var/state 0777 as ASUS made it; /var/lock and /var/tmp/dhcp 0755 since
+	 * review 2026-11-03; /tmp is 01777). The services
 	 * that must create files as another user set their own: vsftpd
 	 * local_umask=000, Samba force create/directory mode 0777, tftpd's -U
 	 * default, mkdir_if_none's "mkdir -m 0777". chmod() ignores the umask, so
@@ -25752,6 +25849,7 @@ static void sysinit(void)
         eval("/etc/make_static_devnodes.sh");
 #endif
 #endif
+	reaper_root_only_perms();	/* review 2026-11-03, E-3/E-4 */
 
 #if defined(RTCONFIG_SOC_IPQ40XX)
 	unlink("/dev/random");
@@ -25962,7 +26060,7 @@ def_boot_reinit:
 
 	// autoreboot after kernel panic
 	f_write_string("/proc/sys/kernel/panic", "3", 0, 0);
-	f_write_string("/proc/sys/kernel/panic_on_oops", "3", 0, 0);
+	f_write_string("/proc/sys/kernel/panic_on_oops", "1", 0, 0);	/* a switch, not a delay (review 2026-11-03; it read as a copy of panic=3) */
 	/* reaper v3.3.3: this kernel is built with BOOTPARAM_SOFTLOCKUP_PANIC=y, so a CPU
 	 * that does not schedule for 2 x watchdog_thresh (20 s) PANICS, and PANIC_TIMEOUT=5
 	 * reboots it with nothing kept (no pstore, no console on a shipped box). That turns
@@ -26695,6 +26793,11 @@ int init_main(int argc, char *argv[])
 #else
 	reaper_mount_data("mount -t ubifs ubi:data /data");
 #endif
+	/* reaper (review 2026-11-03, E-2): /data holds the kernel-nvram commit file - every setting,
+	 * the secret ones included (in their NVRAM_ENCRYPT form, which this box can decode). The BSP
+	 * leaves /data 0755 and the file 0644, so any uid could read it. Only root uses /data. */
+	chmod("/data", 0700);
+	chmod("/data/.kernel_nvram.setting", 0600);
 	if (system("insmod bcm_knvram") == 0)
 		reaper_wait_knvram();
 	else
@@ -27196,6 +27299,7 @@ logmessage("ATE", "boot/continue fail= %d/%d\n", nvram_get_int("Ate_boot_fail"),
 					system("sb_flash_update; nvram set sb_flash_update=1; nvram commit");
 			}
 #endif
+			reaper_root_only_perms();	/* review 2026-11-03: every driver module has loaded by now */
 			start_services();
 #if defined(RTCONFIG_AI_SERVICE)
 			renew_ai_key(ROUTER_PRIVATE_KEY, ROUTER_PUBLIC_KEY, ROUTER_PUBLIC_KEY);
