  * soft-lockup panic here and now - the watchdog's 1 s tick would be late for a
  * stall that begins in pre-mount's fsck - and leave the uptime for the watchdog,
  * which re-arms the panic REAPER_SLP_GRACE_SECS after the last stamp. */
+/* review 2026-11-03 (metal): the share-permission files at the top of a volume (.__admin_var.txt, .__folder_list.txt,
+ * .___var.txt and their numbered copies) decide who may read and write each share. Written 0666 under a leaked
+ * umask(0) (libdisk add_folder), they kept that mode on disk. Group and other write come off at every mount -
+ * top level only, regular files only, never through a link. */
+static void reaper_share_files_private(const char *mnt)
+{
+	DIR *d = opendir(mnt);
+	struct dirent *e;
+	struct stat st;
+	char p[512];
+
+	if (!d)
+		return;
+	while ((e = readdir(d)) != NULL) {
+		if (strncmp(e->d_name, ".__", 3) != 0)
+			continue;
+		snprintf(p, sizeof(p), "%s/%s", mnt, e->d_name);
+		if (lstat(p, &st) == 0 && S_ISREG(st.st_mode) && (st.st_mode & 022))
+			chmod(p, st.st_mode & 07755);
+	}
+	closedir(d);
+}
