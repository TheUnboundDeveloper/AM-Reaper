+/* reaper (review 2026-11-03): one byte-range parser for send_headers and do_file. "bytes=S-E", "bytes=S-" (to the end)
+ * and "bytes=-N" (the last N) against a file of known size; 1 = a satisfiable range in *s..*e. The stock parse read
+ * "bytes=0-" as 0-0 (one byte), answered 200, and announced ranges of files whose size it did not know (/0). */
+static int reaper_byte_range(const char *hdr, long long total, off_t *s, off_t *e)
+{
+	char *end = NULL;
+	long long a, b;
+
+	if (!hdr || strncasecmp(hdr, "bytes=", 6) != 0 || total <= 0)
+		return 0;
+	hdr += 6;
+	if (*hdr == '-') {			/* the last N bytes */
+		b = strtoll(hdr + 1, &end, 10);
+		if (end == hdr + 1 || b <= 0)
+			return 0;
+		a = total > b ? total - b : 0;
+		b = total - 1;
+	} else {
+		a = strtoll(hdr, &end, 10);
+		if (end == hdr || *end != '-' || a < 0)
+			return 0;
+		hdr = end + 1;
+		if (*hdr >= '0' && *hdr <= '9') {
+			b = strtoll(hdr, &end, 10);
+			if (b > total - 1)
+				b = total - 1;
+		} else
+			b = total - 1;
+	}
+	if (a > b || a >= total)
+		return 0;
+	*s = (off_t)a;
+	*e = (off_t)b;
+	return 1;
+}
