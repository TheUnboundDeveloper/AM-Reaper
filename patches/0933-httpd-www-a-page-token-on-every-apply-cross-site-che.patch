 #!/bin/sh
 cd /etc
+# reaper (review 2026-11-03, C-3): every key, certificate and the backup archive this writes is
+# private from the start; the public certificates are opened to 644 again below
+umask 077
 SECS=1262278080
 # cert.pem, key.pem are reserved to Let's encrypt and uploaded certificate.
 HTTPD_ROOTCA_GEN_CERT=cacert_gen.pem
@@ -359,6 +362,11 @@ else
 	logger "Server certificate updated."
 fi
 
+# reaper (review 2026-11-03, C-3): certificates readable, private keys root-only, set before the
+# backup below records the modes (a 0666 _gen certificate was copied over the live CA here)
+chmod 644 ${HTTPD_ROOTCA_CERT} ${HTTPD_ROOTCA_GEN_CERT} ${HTTPD_CERT} ${HTTPD_GEN_CERT} 2>/dev/null
+chmod 600 ${HTTPD_ROOTCA_KEY} ${HTTPD_ROOTCA_GEN_KEY} ${HTTPD_KEY} ${HTTPD_GEN_KEY} 2>/dev/null
+
 # 2020/01/03 import the self-certificate
 ln -sf ${HTTPD_ROOTCA_CERT} cert.crt
 
@@ -371,6 +379,8 @@ cat ${HTTPD_KEY} ${HTTPD_CERT} > server.pem
 		etc/${HTTPD_CERT} etc/${HTTPD_KEY} \
 		etc/${HTTPD_GEN_CERT} etc/${HTTPD_GEN_KEY}
 
+chmod 600 server.pem /jffs/cert.tgz 2>/dev/null	# reaper (review 2026-11-03, C-3): both hold private keys
+
 for f in /tmp/cert.csr ; do
 	[ -e ${f} ] && rm -f ${f}
