-			(void) fprintf( conn_fp, "Content-Length: %jd\r\n", (intmax_t) content_length);
-			(void) fprintf( conn_fp, "Content-Range: bytes %jd-%jd/%lld\r\n", (intmax_t) content_start, (intmax_t) content_end, request_file_size);
