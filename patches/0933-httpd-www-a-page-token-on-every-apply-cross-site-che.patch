+/* review 2026-11-03 (B-1): a browser's apply carries the per-boot http_id, as every Reaper CGI request does - the hook
+ * reaper_inject.c writes into each authenticated page adds it to every form and request aimed at start_apply*.htm,
+ * apply.cgi and applyapp.cgi. Not asked of: the ASUS app and scripts (no browser User-Agent), a pristine-stock UI
+ * (reaper_inject=0: no hook), an AiMesh node (its UI is never injected). */
+static int reaper_apply_token_ok(const char *hid, const char *where)
+{
+	static long last;
+	const char *want;
+
+	if (check_user_agent(user_agent) != FROM_BROWSER)
+		return 1;
+	if (nvram_match("reaper_inject", "0") || nvram_match("re_mode", "1") || nvram_match("disable_ui", "1"))
+		return 1;
+	want = nvram_safe_get("http_id");
+	if (want[0] && hid && strcmp(hid, want) == 0)
+		return 1;
+	if (uptime() - last >= 10) {
+		last = uptime();
+		logmessage("httpd", "reaper: apply without the page token refused (%s)", where);
+	}
+	return 0;
+}
