@@ -0,0 +1,230 @@
+/* SPDX-License-Identifier: GPL-2.0-only
+ * Copyright (C) 2026 the Reaper project maintainer
+ * Part of the Reaper hardened Asuswrt-Merlin build. See LICENSE / LICENSE.reaper.
+ *
+ * rc/reaper_fwlog.c - the firewall log path, rc's side (2026-11-08, backlog fwlog-nflog-plan.md sections 7-8).
+ *
+ * rflogd (the collector) takes every firewall log line over NFLOG; this file decides whether it runs and which
+ * target the log rules use, through one state file, /tmp/reaper/fwlog/path (shared/reaper_fwlog.h):
+ *   "nflog" - written only while the kernel lists the NFLOG target AND rflogd is running with every group bound;
+ *   "log"   - anything else: the rules use the limited LOG (10/s, burst 50, level 5) and syslog keeps the lines.
+ * NFLOG with no listener records nothing, so the file is never left at "nflog" for a collector that is gone:
+ *   - rflog_sync() (boot, the rflog verb, a remote-log change) starts rflogd, waits for its first stats, and sets
+ *     the path; a change re-runs the firewall (restart_firewall), whose every log rule follows the file - the stock
+ *     chains and the blob's are rendered from it, Warden's and the rules engine's scripts read it as they run;
+ *   - reaper_fwlog_watch() runs in the watchdog every 2 s: a dead collector on the NFLOG path is restarted at once
+ *     (restart_rflog); if the restart fails, rflog_sync() falls back to "log". Back on "log" with a healthy collector,
+ *     it is moved up again once a minute at most (the flap guard below).
+ * In router mode only: an AP / repeater / node writes none of these rules.
+ */
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <signal.h>
+#include <time.h>
+#include <ctype.h>
+#include <sys/stat.h>
+
+#include "rc.h"
+#include <shared.h>
+#include <reaper_fwlog.h>
+
+#define RFL_CONF	RFL_DIR "/fwlog.conf"
+#define RFL_STATS	RFL_DIR "/stats.json"
+#define RFL_SWAP	RFL_DIR "/swap.at"	/* epoch of the last path change: the flap guard */
+#define RFL_UPGUARD	60			/* seconds before "log" may go back to "nflog" */
+
+static int rfl_slurp(const char *path, char *buf, size_t cap)
+{
+	int fd = open(path, O_RDONLY | O_NOFOLLOW | O_CLOEXEC);
+	ssize_t n;
+
+	buf[0] = '\0';
+	if (fd < 0)
+		return -1;
+	n = read(fd, buf, cap - 1);
+	close(fd);
+	if (n < 0)
+		return -1;
+	buf[n] = '\0';
+	return 0;
+}
+
+static int rfl_write(const char *path, const char *text)
+{
+	char tmp[96];
+	int fd;
+	size_t l = strlen(text);
+
+	snprintf(tmp, sizeof(tmp), "%s.%d", path, (int)getpid());
+	unlink(tmp);
+	if ((fd = open(tmp, O_WRONLY | O_CREAT | O_EXCL | O_NOFOLLOW | O_CLOEXEC, 0600)) < 0)
+		return -1;
+	if (write(fd, text, l) != (ssize_t)l || close(fd) != 0 || rename(tmp, path) != 0) {
+		unlink(tmp);
+		return -1;
+	}
+	return 0;
+}
+
+/* the kernel lists NFLOG for IPv4 (and IPv6 while it is on) - built in here, but another model's kernel may not */
+static int rfl_kernel_ok(void)
+{
+	char t[2048];
+
+	if (rfl_slurp("/proc/net/ip_tables_targets", t, sizeof(t)) != 0 || !strstr(t, "NFLOG\n"))
+		return 0;
+#ifdef RTCONFIG_IPV6
+	if (ipv6_enabled() && (rfl_slurp("/proc/net/ip6_tables_targets", t, sizeof(t)) != 0 || !strstr(t, "NFLOG\n")))
+		return 0;
+#endif
+	return 1;
+}
+
+/* 1 = rflogd runs with every group bound, 0 = not running, -1 = it could not bind (another owner): don't loop */
+static int rfl_alive(void)
+{
+	char t[4096], p[32], comm[32];
+	const char *s;
+	int pid;
+
+	if (rfl_slurp(RFL_STATS, t, sizeof(t)) != 0)
+		return 0;
+	if (strstr(t, "\"bind_error\":"))
+		return -1;
+	if ((s = strstr(t, "\"pid\":")) == NULL || (pid = atoi(s + 6)) <= 1 || kill(pid, 0) != 0)
+		return 0;
+	snprintf(p, sizeof(p), "/proc/%d/comm", pid);
+	if (rfl_slurp(p, comm, sizeof(comm)) != 0 || strcmp(comm, "rflogd\n") != 0)
+		return 0;
+	return 1;
+}
+
+static long rfl_num(const char *key, long def, long lo, long hi)
+{
+	const char *v = nvram_safe_get(key);
+	char *e;
+	long x;
+
+	if (!*v)
+		return def;
+	x = strtol(v, &e, 10);
+	return (*e || x < lo || x > hi) ? def : x;
+}
+
+/* fwlog.conf - the daemon reads no nvram. Retention / RAM / CPU keys are optional (the page adds them); the remote
+ * target is the System Log page's log_ipaddr / log_port, the same server syslogd sends to. */
+static void rfl_write_conf(void)
+{
+	char c[512], fwd[96] = "", host[64];
+	const char *ip = nvram_safe_get("log_ipaddr"), *pid = nvram_safe_get("productid");
+	long port = rfl_num("log_port", 514, 1, 65535);
+	size_t i, k = 0;
+
+	if (*ip && strlen(ip) < 64 && strspn(ip, "0123456789abcdefABCDEF.:") == strlen(ip))
+		snprintf(fwd, sizeof(fwd), strchr(ip, ':') ? "[%s]:%ld" : "%s:%ld", ip, port);
+	for (i = 0; pid[i] && k + 1 < sizeof(host); i++)
+		if (isalnum((unsigned char)pid[i]) || pid[i] == '-' || pid[i] == '_' || pid[i] == '.')
+			host[k++] = pid[i];
+	host[k] = '\0';
+	snprintf(c, sizeof(c), "groups=%d,%d,%d,%d\nram_kb=%ld\nkeep_days=%ld\nkeep_mb=%ld\ncpu=%ld\ncopy=128\nfwd=%s\nhost=%s\n",
+		 RFL_G_STOCK, RFL_G_WARDEN, RFL_G_BLOB, RFL_G_REAPER,
+		 rfl_num("reaper_fwlog_ram_kb", 2048, 256, 65536), rfl_num("reaper_fwlog_keep_days", 30, 1, 3650),
+		 rfl_num("reaper_fwlog_keep_mb", 256, 16, 65536), rfl_num("reaper_fwlog_cpu", 8, 0, 255), fwd, host[0] ? host : "router");
+	rfl_write(RFL_CONF, c);
+}
+
+/* set the path; on a change re-run the firewall so every log rule follows it (once the firewall exists - at boot
+ * the first build reads the file by itself). Going up to NFLOG waits out the flap guard; going down never waits. */
+static void rfl_set_path(int nflog, const char *why)
+{
+	char t[32];
+	long last = 0;
+	time_t now = time(NULL);
+
+	if (nflog == rfl_nflog())
+		return;
+	if (rfl_slurp(RFL_SWAP, t, sizeof(t)) == 0)
+		last = atol(t);
+	if (nflog && last && now - last < RFL_UPGUARD && now >= last)
+		return;
+	if (rfl_write(RFL_PATH, nflog ? "nflog\n" : "log\n") != 0) {
+		logmessage("fwlog", "could not write %s: %s", RFL_PATH, strerror(errno));
+		return;
+	}
+	snprintf(t, sizeof(t), "%ld\n", (long)now);
+	rfl_write(RFL_SWAP, t);
+	if (nflog)
+		logmessage("fwlog", "firewall log lines go to the collector (rflogd, NFLOG)");
+	else
+		logmessage("fwlog", "%s: firewall log lines go to the System Log, limited to 10 a second", why);
+	if (f_exists(REAPER_FW_BUILT_MARK))
+		notify_rc("restart_firewall");
+}
+
+void stop_rflogd(void)
+{
+	if (pids("rflogd"))
+		killall_tk("rflogd");
+}
+
+void rflog_sync(void)
+{
+	int i, alive;
+
+	if (!is_routing_enabled()) {
+		stop_rflogd();
+		return;
+	}
+	if (reaper_secure_dir(REAPER_TMPDIR, 0700) != 0 || reaper_secure_dir(RFL_DIR, 0700) != 0) {
+		rfl_set_path(0, "the collector's folder is not private");
+		return;
+	}
+	rfl_write_conf();
+	if (!rfl_kernel_ok()) {
+		stop_rflogd();
+		rfl_set_path(0, "this kernel has no NFLOG target");
+		return;
+	}
+	if (pids("rflogd") && rfl_alive() == 1)
+		killall("rflogd", SIGHUP);	/* re-read fwlog.conf */
+	else {
+		stop_rflogd();
+		unlink(RFL_STATS);
+		xstart("rflogd");
+		for (i = 0; i < 20 && rfl_alive() == 0; i++)
+			usleep(100000);		/* its first stats.json says every group is bound */
+	}
+	alive = rfl_alive();
+	rfl_set_path(alive == 1, alive < 0 ? "the collector could not take its netlink groups (another program owns them)"
+					    : "the firewall log collector is not running");
+}
+
+/* the watchdog, every tick (1 s): checks every 2 s */
+void reaper_fwlog_watch(void)
+{
+	static unsigned tick;
+	static time_t kicked;
+	time_t now;
+	int alive;
+
+	if (++tick % 2 || !is_routing_enabled())
+		return;
+	now = time(NULL);
+	alive = rfl_alive();
+	if (rfl_nflog()) {
+		if (alive != 1 && now - kicked >= 4) {
+			/* lines are being lost right now: restart it (rflog_sync falls back if that fails) */
+			logmessage("fwlog", "the firewall log collector stopped - restarting it");
+			notify_rc("restart_rflog");
+			kicked = now;
+		}
+	} else if (alive >= 0 && tick % 60 == 0 && now - kicked >= 60) {
+		/* on the fallback: once a minute, try the collector again (a bind error is not retried) */
+		notify_rc("restart_rflog");
+		kicked = now;
+	}
+}
