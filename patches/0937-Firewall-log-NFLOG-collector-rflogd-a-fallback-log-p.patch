+/* reaper 2026-11-08 (field RT-BE88U): DDNS on Custom runs exactly /jffs/scripts/ddns-start (shared/scripts.c
+ * run_custom_script); a script saved as ddns-start.sh never ran and the page said nothing. Reaper_DDNS.asp reads
+ * {"s":N,"near":"name"}: s 0 = not there (near = a ddns-start* file that is, backups skipped), 1 = there but not
+ * executable, 2 = ready. near holds only [A-Za-z0-9._-]. */
+static int
+ej_reaper_ddns_script(int eid, webs_t wp, int argc, char **argv)
+{
+	struct stat st;
+	DIR *d;
+	struct dirent *e;
+	char near[64] = "";
+	int s = 0;
+	size_t n;
+
+	if (stat("/jffs/scripts/ddns-start", &st) == 0 && S_ISREG(st.st_mode))
+		s = (st.st_mode & (S_IXUSR | S_IXGRP | S_IXOTH)) ? 2 : 1;
+	else if ((d = opendir("/jffs/scripts")) != NULL) {
+		while ((e = readdir(d)) != NULL) {
+			if (strncasecmp(e->d_name, "ddns-start", 10) && strncasecmp(e->d_name, "ddns_start", 10))
+				continue;
+			n = strlen(e->d_name);
+			if (n >= sizeof(near) || e->d_name[strspn(e->d_name,
+			    "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789._-")] != '\0')
+				continue;
+			if ((n > 4 && (!strcmp(e->d_name + n - 4, ".bak") || !strcmp(e->d_name + n - 4, ".old")))
+			    || (n > 5 && !strcmp(e->d_name + n - 5, ".orig")) || e->d_name[n - 1] == '~')
+				continue;
+			strlcpy(near, e->d_name, sizeof(near));
+			break;
+		}
+		closedir(d);
+	}
+	return websWrite(wp, "{\"s\":%d,\"near\":\"%s\"}", s, near);
+}
