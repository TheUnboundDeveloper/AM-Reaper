+/* reaper 2026-11-08 (field): a WireGuard .conf without its keys was imported anyway - read_wgc_config_file resets
+ * every wgcN_ setting first, so the instance was left with an empty or broken key. The file is checked before that
+ * reset: bit 1 = no valid [Interface] PrivateKey, bit 2 = no valid [Peer] PublicKey (0 = both there). A key is 32
+ * bytes of base64: 43 characters of A-Z a-z 0-9 + / then '='. Key lines are read at column 0, as the importer reads
+ * them; Reaper_VPNClient.asp runs the same check before it sends the file. */
+static int
+reaper_wgc_key_ok(const char *v)
+{
+	int i;
+
+	for (i = 0; i < 43; i++)
+		if (!(isalnum((unsigned char)v[i]) || v[i] == '+' || v[i] == '/'))
+			return 0;
+	return v[43] == '=' && (v[44] == '\0' || v[44] == ' ' || v[44] == '\t');
+}
+
+static int
+reaper_wgc_conf_keys(const char *path)
+{
+	FILE *fp;
+	char buf[256], *v;
+	int sec = 0, have = 0;	/* sec 1 = [Interface], 2 = [Peer] */
+
+	if (!(fp = fopen(path, "r")))
+		return 3;
+	while (fgets(buf, sizeof(buf), fp)) {
+		buf[strcspn(buf, "\r\n")] = '\0';
+		if (buf[0] == '[') {
+			sec = !strncasecmp(buf, "[Interface]", 11) ? 1 : !strncasecmp(buf, "[Peer]", 6) ? 2 : 0;
+			continue;
+		}
+		if (sec == 1 && !strncmp(buf, "PrivateKey", 10))
+			v = buf + 10;
+		else if (sec == 2 && !strncmp(buf, "PublicKey", 9))
+			v = buf + 9;
+		else
+			continue;
+		v += strspn(v, " \t");
+		if (*v != '=')
+			continue;
+		v++;
+		v += strspn(v, " \t");
+		if (reaper_wgc_key_ok(v))
+			have |= sec;
+	}
+	fclose(fp);
+	return 3 & ~have;
+}
