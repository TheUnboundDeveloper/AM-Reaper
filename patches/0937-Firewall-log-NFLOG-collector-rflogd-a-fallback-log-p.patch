+/* 2026-11-08 (NFLOG plan section 7, item 4): the closed blob writes its anti-botnet chains as text - logdrop_dns /
+ * logdrop_ip, an UNLIMITED -j LOG then -j DROP, on the router's own OUTPUT - into the rules file rc loads. Every
+ * `-A <chain> -j LOG --log-prefix "<p>"<opts>` line it wrote is replaced by the firewall log target (NFLOG group 42
+ * while rflogd runs, else the limited LOG keeping its --log-* options); every other line is copied byte for byte, so
+ * what it blocks is unchanged. A line this does not recognise stays as written. */
+static void reaper_extra_log_reroute(const char *path)
+{
+	char tmp[96], line[1024], chain[32], prefix[32], opts[96];
+	FILE *in, *out;
+	int nfl = rfl_nflog(), bad = 0;
+
+	snprintf(tmp, sizeof(tmp), "%s.rr", path);
+	if ((in = fopen(path, "r")) == NULL)
+		return;
+	if ((out = fopen(tmp, "w")) == NULL) {
+		fclose(in);
+		return;
+	}
+	while (fgets(line, sizeof(line), in)) {
+		int off = 0;
+		size_t i, o = 0;
+
+		if (sscanf(line, "-A %31s -j LOG --log-prefix \"%31[^\"]\"%n", chain, prefix, &off) != 2 || off <= 0) {
+			if (fputs(line, out) == EOF)
+				bad = 1;
+			continue;
+		}
+		/* the blob's own --log-* options, for the LOG form: words of [a-z-] only, else none */
+		for (i = off; line[i] && line[i] != '\n' && o + 2 < sizeof(opts); i++) {
+			char c = line[i];
+			if (!((c >= 'a' && c <= 'z') || c == '-' || c == ' ')) {
+				o = 0;
+				break;
+			}
+			if (c == ' ' && (o == 0 || opts[o - 1] == ' '))
+				continue;
+			opts[o++] = c;
+		}
+		if (o && opts[o - 1] != ' ')
+			opts[o++] = ' ';
+		opts[o] = '\0';
+		if (fprintf(out, "-A %s %s\n", chain, rfl_tgt(nfl, RFL_G_BLOB, prefix, NULL, opts)) < 0)
+			bad = 1;
+	}
+	fclose(in);
+	if (fclose(out) != 0 || bad) {
+		unlink(tmp);
+		return;
+	}
+	if (rename(tmp, path) != 0)
+		unlink(tmp);
+}
