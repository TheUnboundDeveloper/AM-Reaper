diff --git a/release/src/router/shared/reaper_fwlog.h b/release/src/router/shared/reaper_fwlog.h
new file mode 100644
index 00000000000..71ce9a2bdda
--- /dev/null
+++ b/release/src/router/shared/reaper_fwlog.h
@@ -0,0 +1,111 @@
+/* SPDX-License-Identifier: GPL-2.0-only
+ * Copyright (C) 2026 the Reaper project maintainer
+ * Part of the Reaper hardened Asuswrt-Merlin build. See LICENSE / LICENSE.reaper.
+ *
+ * shared/reaper_fwlog.h - the firewall log path (2026-11-08, backlog fwlog-nflog-plan.md section 7).
+ *
+ * Every firewall log rule rc writes takes its target text from here: the stock logaccept / logdrop bodies
+ * (rc/firewall.c), Warden's RW_DROP / RW_ODROP / RW_SDROP (rc/rwarden.c), the rules engine's per-rule log and its
+ * nat intercept / forward lines (rc/reaper_fw.c) and the closed blob's DROP_DNS / DROP_IP chains (rerouted in
+ * rc/firewall.c reaper_extra_log_reroute). Two forms:
+ *   - NFLOG to the collector (rflogd), one netlink group per source - no syslog, no printk, no console;
+ *   - the fallback: a rate-limited LOG at level 5 (kept by syslogd at log_level 6, off the serial console, whose
+ *     115200-baud write cost ~22 ms per line on the owner's box with console_loglevel 5).
+ * rc writes RFL_PATH ("nflog") only while the kernel takes NFLOG and the collector is running; absent, unreadable or
+ * anything else = the fallback. So a missing collector never means silent loss: rc swaps the file and rewrites the
+ * rules (rflog_sync). Past the fallback's rate the LINE is dropped, never the packet.
+ */
+#ifndef REAPER_FWLOG_H
+#define REAPER_FWLOG_H
+
+#include <stdio.h>
+#include <string.h>
+#include <fcntl.h>
+#include <unistd.h>
+
+#ifndef RFL_DIR			/* host tests point it at a scratch folder */
+#define RFL_DIR		"/tmp/reaper/fwlog"
+#endif
+#define RFL_PATH	RFL_DIR "/path"		/* "nflog\n" while the collector takes the lines */
+
+/* netlink groups, one socket each in rflogd: a burst in one source cannot drop another's lines */
+#define RFL_G_STOCK	40	/* logaccept / logdrop: "ACCEPT " "DROP " */
+#define RFL_G_WARDEN	41	/* "REAPER-WARDEN " "REAPER-WARDEN-OUT " "REAPER-WARDEN-SELF " */
+#define RFL_G_BLOB	42	/* the closed write_extra_filter / 6: "DROP_DNS " "DROP_IP " */
+#define RFL_G_REAPER	43	/* the rules engine: "REAPER-FW:<n> " "REAPER-ICPT " "REAPER-ICPT6 " "REAPER-FWD " */
+
+/* the NFLOG path's flood ceiling (owner 2026-11-08): far above any normal traffic, but a packet flood on a per-packet
+ * chain (Warden logs every drop) cannot turn logging into a CPU sink - ~2 us of softirq per logged packet would be
+ * two cores at 1 Mpps. Both numbers are the most iptables' limit match takes: the rate XT_LIMIT_SCALE (10000/s,
+ * libxt_limit.c parse_rate) and the burst 0-10000 (its option table) - _r2 shipped burst 20000, iptables refused
+ * every NFLOG rule and the restore fallback left the log chains with no log rule at all (metal, 2026-11-08).
+ * test_fwlog_nflog.py checks every limit Reaper emits against the tree's own libxt_limit.c bounds. Suppressed lines
+ * are counted by rflogd from the rule / chain counters. */
+#define RFL_CEIL	"-m limit --limit 10000/s --limit-burst 10000 "
+/* the fallback: one token bucket per rule instance, then LOG at notice */
+#define RFL_LIMIT	"-m limit --limit 10/s --limit-burst 50 "
+#define RFL_LEVEL	"5"
+/* what the stock chains always logged; only LOG understands these (NFLOG hands rflogd the packet itself) */
+#define RFL_STOCK_OPTS	"--log-tcp-sequence --log-tcp-options --log-ip-options "
+
+/* 1 = NFLOG to the collector, 0 = the limited LOG */
+static inline int rfl_nflog(void)
+{
+	char b[8] = "";
+	ssize_t n;
+	int fd = open(RFL_PATH, O_RDONLY | O_NOFOLLOW | O_CLOEXEC);
+
+	if (fd < 0)
+		return 0;
+	n = read(fd, b, sizeof(b) - 1);
+	close(fd);
+	return n >= 5 && strncmp(b, "nflog", 5) == 0;
+}
+
+/* The target text of one log rule, no newline. prefix keeps its trailing space ("ACCEPT "). limit: the LOG form's
+ * bucket, NULL = RFL_LIMIT (the rules engine passes its own per-rule 6/min); the NFLOG form always carries RFL_CEIL.
+ * logopts: "" or RFL_STOCK_OPTS, used by the LOG form only. */
+static inline const char *rfl_target(char *buf, size_t len, int nflog, int group, const char *prefix,
+				     const char *limit, const char *logopts)
+{
+	if (nflog)
+		snprintf(buf, len, RFL_CEIL "-j NFLOG --nflog-group %d --nflog-prefix \"%s\"", group, prefix);
+	else
+		snprintf(buf, len, "%s-j LOG --log-prefix \"%s\" %s--log-level " RFL_LEVEL,
+			 limit ? limit : RFL_LIMIT, prefix, logopts ? logopts : "");
+	return buf;
+}
+
+/* the same into one buffer per file, for a single use inside one fprintf */
+static inline const char *rfl_tgt(int nflog, int group, const char *prefix, const char *limit, const char *logopts)
+{
+	static char buf[192];
+
+	return rfl_target(buf, sizeof(buf), nflog, group, prefix, limit, logopts);
+}
+
+/* a stock log chain body (restore-file form): the NEW packet logged, a target-less NEW rule that only counts, then
+ * the verdict. rflogd reads the log rule's and the counting rule's packet counters (iptables-save -c): the difference
+ * is the lines a limiter suppressed (the fallback's 10/s or the NFLOG flood ceiling) - Warden's and the blob's chains
+ * need no such rule, their DROP right after the log rule sees every packet. One statement, so it can stand under an
+ * unbraced `if (ipv6_enabled())` as the fprintf it replaces did. */
+static inline void rfl_stock_chain(FILE *fp, const char *chain, const char *prefix, const char *verdict)
+{
+	fprintf(fp, "-A %s -m state --state NEW %s\n-A %s -m state --state NEW\n-A %s -j %s\n",
+		chain, rfl_tgt(rfl_nflog(), RFL_G_STOCK, prefix, NULL, RFL_STOCK_OPTS), chain, chain, verdict);
+}
+
+/* a log rule in a generated shell script that the firewall re-runs (Warden's apply.sh): the script picks NFLOG or the
+ * limited LOG when it RUNS, from the state file, so a path change needs only restart_firewall - never a regeneration.
+ * cmd is everything before the target ("iptables -A RW_DROP"). The rules engine does the same through its RFLR()
+ * function (rc/reaper_fw.c), which also keeps a failed rule counted. */
+static inline void rfl_sh_rule(FILE *f, const char *cmd, int group, const char *prefix, const char *limit)
+{
+	char a[192], b[192];
+
+	fprintf(f, "if [ \"$(cat " RFL_PATH " 2>/dev/null)\" = nflog ]; then %s %s; else %s %s; fi\n",
+		cmd, rfl_target(a, sizeof(a), 1, group, prefix, limit, ""),
+		cmd, rfl_target(b, sizeof(b), 0, group, prefix, limit, ""));
+}
+
+#endif /* REAPER_FWLOG_H */
