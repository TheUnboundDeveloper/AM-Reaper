diff --git a/release/src/router/rflogd/Makefile b/release/src/router/rflogd/Makefile
new file mode 100644
index 00000000000..00e4eb0577f
--- /dev/null
+++ b/release/src/router/rflogd/Makefile
@@ -0,0 +1,44 @@
+# SPDX-License-Identifier: GPL-2.0-only
+# Copyright (C) 2026 the Reaper project maintainer
+# Part of the Reaper hardened Asuswrt-Merlin build. See LICENSE / LICENSE.reaper.
+# rflogd: the firewall log collector (NFLOG, shared/reaper_fwlog.h). libc only - rc decides
+# whether it runs and writes its configuration, so it links neither libnvram nor libshared.
+include ../common.mak
+
+CFLAGS	+= -Os -Wall $(EXTRACFLAGS)
+CFLAGS	+= -I$(SRCBASE)/include -I$(TOP)/shared
+# same exploit-mitigation set as rdnsmapd / rtrafd (FORTIFY, strong canaries, format-security, PIE)
+CFLAGS	+= -D_FORTIFY_SOURCE=2 -fstack-protector-strong -Wformat -Wformat-security -fPIE
+LDFLAGS	= -pie -Wl,-z,relro,-z,now
+
+OBJS = rflogd.o
+
+all: rflogd
+
+rflogd: $(OBJS)
+	@echo " [rflogd] CC -o $@"
+	$(CC) $(LDFLAGS) -o $@ $(OBJS)
+
+	$(SIZECHECK)
+	$(CPTMP)
+
+clean:
+	rm -f rflogd .*.depend
+	rm -f *.o
+
+install: all
+	@echo " [rflogd] Installing..."
+	install -D rflogd $(INSTALLDIR)/bin/rflogd
+	$(STRIP) $(INSTALLDIR)/bin/rflogd
+
+%.o: %.c .%.depend
+	@echo " [rflogd] CC $@"
+	@$(CC) $(CFLAGS) -c $<
+
+.depend: $(OBJS:%.o=%.c)
+	@$(CC) $(CFLAGS) -M $^ > .depend
+
+.%.depend: %.c
+	@$(CC) $(CFLAGS) -M $< > $@
+
+-include $(OBJS:%.o=.%.depend)
