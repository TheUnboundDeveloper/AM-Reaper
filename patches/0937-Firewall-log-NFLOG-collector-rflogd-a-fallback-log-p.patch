+static struct rfl_conf C;
+static volatile sig_atomic_t g_hup, g_term;
+static int sock[RFL_MAXG];
+static uint32_t seq_next[RFL_MAXG];
+static int seq_seen[RFL_MAXG];
+static unsigned long long g_rx[RFL_MAXG], g_lost[RFL_MAXG];
+static unsigned long long n_rx, n_written, n_lost, n_bad, n_enobufs, n_fwd, n_fwd_err;
+static unsigned long long st_written, st_missed, st_err;
+static char st_last_err[64] = "", st_file[24] = "", st_state[12] = "off";
+static long long ring_bytes;
+static int ring_fd = -1, fwd_fd = -1;
+static struct sockaddr_storage fwd_sa;
+static socklen_t fwd_salen;
+static char obuf[RFL_OUTBUF];
+static size_t olen;
+static char oday[11] = "";
+/* timers run on the monotonic clock: the router boots with a 2023 clock and NTP jumps it years forward (on _r3
+ * the first "last hour" summary fired two minutes after start and "since" said 2023). Wall time is used only for
+ * the lines' timestamps, the day files and stats.json's "updated" / "since". */
+static time_t since;
+static long mono_start, stats_at, sup_at, expire_at, hour_at, flush_at, errlog_at;
+
+/* the clock counts as set once it is later than this program was built: the router boots at its own default date
+ * (2023-12-31 on the RT-BE96U) - after 2020, so a fixed 2020 floor took it for a real clock (_r4 metal: "since" stayed
+ * 2023, and lines before NTP would have gone into a 2023-12-31.log day file). squashfs keeps the build's mtimes;
+ * a file that cannot be read falls back to 2020-09-13. */
+static time_t clock_floor = 1600000000;
+
+static int clock_set(time_t t)
+{
+	return t > clock_floor;
+}
+
+static long mono(void)
+{
+	struct timespec t;
+
+	clock_gettime(CLOCK_MONOTONIC, &t);
+	return (long)t.tv_sec;
+}
+static unsigned long long hour_rx;
+static int stats_dirty = 1;
+
+static void on_sig(int s)
+{
+	if (s == SIGHUP) g_hup = 1;
+	else g_term = 1;
+}
+
+static int rfl_read_file(const char *path, char *buf, size_t cap)
+{
+	int fd = open(path, O_RDONLY | O_NOFOLLOW | O_CLOEXEC);
+	ssize_t n;
+
+	buf[0] = '\0';
+	if (fd < 0)
+		return -1;
+	n = read(fd, buf, cap - 1);
+	close(fd);
+	if (n < 0)
+		return -1;
+	buf[n] = '\0';
+	return 0;
+}
+
+/* the store: RSTORE_PUB = "<base>\n,<datasets>,\n"; usable only when it lists fwlog and the clock is sane */
+static int rfl_store_base(char *base, size_t cap)
+{
+	char t[512], *nl;
+
+	if (rfl_read_file(RSTORE_PUB, t, sizeof(t)) != 0 || (nl = strchr(t, '\n')) == NULL)
+		return 0;
+	*nl = '\0';
+	if (!strstr(nl + 1, ",fwlog,") || t[0] != '/' || strlen(t) >= cap)
+		return 0;
+	memcpy(base, t, strlen(t) + 1);		/* shorter than cap (checked above) */
+	return 1;
+}
+
+struct rfl_day { char name[16]; long long size; };
+
+static int day_cmp(const void *a, const void *b)
+{
+	return strcmp(((const struct rfl_day *)a)->name, ((const struct rfl_day *)b)->name);
+}
+
+/* keep at most keep_days day files and keep_mb in total, oldest removed first, never the newest; no link followed */
+static void rfl_expire(const char *base)
+{
+	struct rfl_day *v = NULL, *nv;
+	long long total = 0;
+	int n = 0, cap = 0, i, dfd, d2;
+	DIR *dir;
+	struct dirent *e;
+
+	if ((dfd = rstore_open_sub(base, "fwlog")) < 0)
+		return;
+	if ((d2 = dup(dfd)) < 0 || (dir = fdopendir(d2)) == NULL) {
+		if (d2 >= 0)
+			close(d2);
+		close(dfd);
+		return;
+	}
+	while ((e = readdir(dir)) != NULL && n < 8000) {
+		struct stat st;
+		int y, m, d;
+		char tail[8];
+
+		if (strlen(e->d_name) != 14 || sscanf(e->d_name, "%4d-%2d-%2d%7s", &y, &m, &d, tail) != 4 || strcmp(tail, ".log"))
+			continue;
+		if (fstatat(dfd, e->d_name, &st, AT_SYMLINK_NOFOLLOW) != 0 || !S_ISREG(st.st_mode))
+			continue;
+		if (n == cap) {
+			cap = cap ? cap * 2 : 64;
+			if ((nv = realloc(v, (size_t)cap * sizeof(*v))) == NULL)
+				break;
+			v = nv;
+		}
+		memcpy(v[n].name, e->d_name, 15);	/* 14 characters (checked above) and the NUL */
+		v[n].size = st.st_size;
+		total += st.st_size;
+		n++;
+	}
+	closedir(dir);
+	if (n > 1)
+		qsort(v, (size_t)n, sizeof(*v), day_cmp);
+	for (i = 0; i < n - 1; i++) {
+		if (n - i <= C.keep_days && total <= C.keep_mb * 1048576LL)
+			break;
+		if (unlinkat(dfd, v[i].name, 0) == 0)
+			total -= v[i].size;
+	}
+	free(v);
+	close(dfd);
+}
+
+static void rfl_store_chunk(const char *buf, size_t len, const char *day)
+{
+	char base[256], name[24];
+	time_t now = time(NULL);
+
+	if (!clock_set(now)) {			/* no clock yet: a 2023 / 1970 day file name would be wrong forever */
+		st_missed += len;
+		return;
+	}
+	if (!rfl_store_base(base, sizeof(base))) {
+		if (strcmp(st_state, "volatile")) {
+			if (!strcmp(st_state, "usb"))
+				syslog(LOG_NOTICE, "the long-term store is gone or does not list the firewall log: RAM ring only");
+			snprintf(st_state, sizeof(st_state), "volatile");
+		}
+		st_missed += len;
+		return;
+	}
+	if (strcmp(st_state, "usb")) {
+		syslog(LOG_NOTICE, "firewall log lines go to %s/fwlog", base);
+		snprintf(st_state, sizeof(st_state), "usb");
+		expire_at = 0;
+	}
+	snprintf(name, sizeof(name), "%s.log", day);
+	if (rstore_append_buf(base, "fwlog", name, 0, buf, len) != 0) {
+		int e = errno;
+		st_err++;
+		if (!errlog_at || mono() - errlog_at >= 600) {	/* at most one line per 10 minutes */
+			syslog(LOG_WARNING, "could not write the firewall log to the store: %s", strerror(e));
+			errlog_at = mono();
+		}
+		snprintf(st_last_err, sizeof(st_last_err), "%s", strerror(e));
+		st_missed += len;
+		if (e == ENOSPC)
+			rfl_expire(base);
+		return;
+	}
+	st_written += len;
+	snprintf(st_file, sizeof(st_file), "%s", name);
+	if (mono() >= expire_at) {
+		rfl_expire(base);
+		expire_at = mono() + 3600;
+	}
+}
+
+static void rfl_ring_open(void)
+{
+	struct stat st;
+
+	if (ring_fd >= 0)
+		return;
+	ring_fd = open(RFL_CUR, O_WRONLY | O_APPEND | O_CREAT | O_NOFOLLOW | O_CLOEXEC, 0600);
+	ring_bytes = (ring_fd >= 0 && fstat(ring_fd, &st) == 0) ? st.st_size : 0;
+}
+
+static void rfl_flush(void)
+{
+	if (!olen)
+		return;
+	rfl_ring_open();
+	if (ring_fd >= 0) {
+		if (ring_bytes + (long long)olen > C.ram_kb * 1024LL) {
+			close(ring_fd);
+			ring_fd = -1;
+			rename(RFL_CUR, RFL_PREV);
+			rfl_ring_open();
+		}
+		if (ring_fd >= 0 && write(ring_fd, obuf, olen) == (ssize_t)olen)
+			ring_bytes += olen;
+	}
+	rfl_store_chunk(obuf, olen, oday);
+	n_written += olen;
+	olen = 0;
+	stats_dirty = 1;
+}
+
+static void rfl_forward(const char *body, long long sec)
+{
+	char m[RFL_LINE + 160];
+	struct tm tm;
+	time_t t = (time_t)sec;
+	char when[20];
+	int n;
+
+	if (fwd_fd < 0)
+		return;
+	localtime_r(&t, &tm);
+	strftime(when, sizeof(when), "%b %e %H:%M:%S", &tm);
+	/* RFC 3164: facility kern (0), severity notice (5) */
+	n = snprintf(m, sizeof(m), "<5>%s %s rflogd: %s", when, C.host, body);
+	if (n > 0 && sendto(fwd_fd, m, (size_t)n < sizeof(m) ? (size_t)n : sizeof(m) - 1, MSG_DONTWAIT,
+			    (struct sockaddr *)&fwd_sa, fwd_salen) > 0)
+		n_fwd++;
+	else
+		n_fwd_err++;
+}
+
+static void rfl_line(const struct rfl_pkt *pk, time_t now)
+{
+	char ts[48], body[RFL_LINE];
+	struct timespec tv;
+	long long sec;
+	long usec;
+	size_t tl, bl;
+	char day[11];
+
+	if (pk->has_ts) {
+		sec = pk->ts_sec;
+		usec = (long)pk->ts_usec;
+	} else {
+		clock_gettime(CLOCK_REALTIME, &tv);
+		sec = tv.tv_sec;
+		usec = tv.tv_nsec / 1000;
+	}
+	tl = rfl_stamp(ts, sizeof(ts), sec, usec);
+	bl = rfl_format(pk, body, sizeof(body), now);
+	snprintf(day, sizeof(day), "%.10s", ts);
+	if (olen && strcmp(day, oday))
+		rfl_flush();			/* a batch never spans midnight in the day files */
+	snprintf(oday, sizeof(oday), "%s", day);
+	if (olen + tl + bl + 2 > sizeof(obuf))
+		rfl_flush();
+	memcpy(obuf + olen, ts, tl);
+	olen += tl;
+	obuf[olen++] = ' ';
+	memcpy(obuf + olen, body, bl);
+	olen += bl;
+	obuf[olen++] = '\n';
+	rfl_forward(body, sec);
+}
+
+static void rfl_batch(int gi, const unsigned char *buf, size_t len, time_t now)
+{
+	const struct nlmsghdr *nh;
+	size_t rem = len;
+	struct rfl_pkt pk;
+
+	for (nh = (const struct nlmsghdr *)buf; NLMSG_OK(nh, rem); nh = NLMSG_NEXT(nh, rem)) {
+		if (nh->nlmsg_type == NLMSG_DONE || nh->nlmsg_type == NLMSG_NOOP || nh->nlmsg_type == NLMSG_ERROR)
+			continue;
+		if (nh->nlmsg_type != ((NFNL_SUBSYS_ULOG << 8) | NFULNL_MSG_PACKET))
+			continue;
+		if (rfl_parse((const unsigned char *)nh, nh->nlmsg_len, &pk) != 0) {
+			n_bad++;
+			continue;
+		}
+		if (pk.has_seq) {
+			uint32_t gap = rfl_seq_gap(&seq_next[gi], &seq_seen[gi], pk.seq);
+			if (gap) {
+				if (n_lost == 0)	/* the first loss of a run is worth a syslog line; the rest are counted */
+					syslog(LOG_WARNING, "group %d: %u firewall log line(s) lost (the kernel dropped a batch)",
+					       C.groups[gi], gap);
+				g_lost[gi] += gap;
+				n_lost += gap;
+				stats_dirty = 1;
+			}
+		}
+		g_rx[gi]++;
+		n_rx++;
+		hour_rx++;
+		rfl_line(&pk, now);
+	}
+}
+
+/* fork/exec a counters dump, read its stdout (no shell) */
+static int rfl_run(const char *path, char *const argv[], char *buf, size_t cap)
+{
+	int p[2], st;
+	pid_t pid;
+	size_t n = 0;
+	ssize_t r;
+
+	buf[0] = '\0';
+	if (pipe2(p, O_CLOEXEC) != 0)
+		return -1;
+	if ((pid = fork()) < 0) {
+		close(p[0]);
+		close(p[1]);
+		return -1;
+	}
+	if (pid == 0) {
+		int nul = open("/dev/null", O_RDWR);
+		dup2(p[1], 1);
+		if (nul >= 0) { dup2(nul, 0); dup2(nul, 2); }
+		execv(path, argv);
+		_exit(127);
+	}
+	close(p[1]);
+	while (n + 1 < cap && (r = read(p[0], buf + n, cap - 1 - n)) > 0)
+		n += (size_t)r;
+	buf[n] = '\0';
+	close(p[0]);
+	waitpid(pid, &st, 0);
+	return 0;
+}
+
+static void rfl_counters(void)
+{
+	static char buf[262144];
+	char *a4[] = { "iptables-save", "-c", "-t", "filter", NULL };
+	char *a6[] = { "ip6tables-save", "-c", "-t", "filter", NULL };
+
+	if (rfl_run("/usr/sbin/iptables-save", a4, buf, sizeof(buf)) == 0)
+		rfl_counters_parse("v4", buf);
+	if (access("/usr/sbin/ip6tables-save", X_OK) == 0 && rfl_run("/usr/sbin/ip6tables-save", a6, buf, sizeof(buf)) == 0)
+		rfl_counters_parse("v6", buf);
+	stats_dirty = 1;
+}
+
+static void rfl_stats(time_t now)
+{
+	char tmp[] = RFL_DIR "/.stats.XXXXXX";
+	FILE *f;
+	int fd, i;
+
+	/* started before NTP set the clock: "since" was a 2023 date - put it back by the time this has been running */
+	if (!clock_set(since) && clock_set(now))
+		since = now - (mono() - mono_start);
+	if ((fd = mkstemp(tmp)) < 0)
+		return;
+	if ((f = fdopen(fd, "w")) == NULL) {
+		close(fd);
+		unlink(tmp);
+		return;
+	}
+	fprintf(f, "{\"updated\":%ld,\"since\":%ld,\"pid\":%d,\"mode\":\"full\",\"rx\":%llu,\"written\":%llu,"
+		   "\"lost_seq\":%llu,\"bad\":%llu,\"enobufs\":%llu,\"suppressed\":%llu,\"ring_bytes\":%lld,\"ram_kb\":%ld,"
+		   "\"store\":\"%s\",\"store_file\":\"%s\",\"store_written\":%llu,\"store_missed\":%llu,\"store_err\":%llu,"
+		   "\"store_last_err\":\"%s\",\"keep_days\":%ld,\"keep_mb\":%ld,\"fwd\":%d,\"fwd_sent\":%llu,\"fwd_err\":%llu,"
+		   "\"groups\":[",
+		(long)now, (long)since, (int)getpid(), n_rx, n_written, n_lost, n_bad, n_enobufs, rfl_suppressed(0),
+		ring_bytes, C.ram_kb, st_state, st_file, st_written, st_missed, st_err, st_last_err, C.keep_days, C.keep_mb,
+		fwd_fd >= 0, n_fwd, n_fwd_err);
+	for (i = 0; i < C.ngroups; i++)
+		fprintf(f, "%s{\"g\":%d,\"rx\":%llu,\"lost\":%llu,\"suppressed\":%llu}", i ? "," : "",
+			C.groups[i], g_rx[i], g_lost[i], rfl_suppressed(C.groups[i]));
+	fprintf(f, "]}\n");
+	if (fclose(f) != 0 || rename(tmp, RFL_STATS) != 0)
+		unlink(tmp);
+	stats_dirty = 0;
+	stats_at = mono();
+}
+
+static void rfl_fwd_open(void)
+{
+	struct sockaddr_in *s4 = (struct sockaddr_in *)&fwd_sa;
+	struct sockaddr_in6 *s6 = (struct sockaddr_in6 *)&fwd_sa;
+
+	if (fwd_fd >= 0) {
+		close(fwd_fd);
+		fwd_fd = -1;
+	}
+	if (!C.fwd_host[0])
+		return;
+	memset(&fwd_sa, 0, sizeof(fwd_sa));
+	if (inet_pton(AF_INET, C.fwd_host, &s4->sin_addr) == 1) {
+		s4->sin_family = AF_INET;
+		s4->sin_port = htons((uint16_t)C.fwd_port);
+		fwd_salen = sizeof(*s4);
+	} else if (inet_pton(AF_INET6, C.fwd_host, &s6->sin6_addr) == 1) {
+		s6->sin6_family = AF_INET6;
+		s6->sin6_port = htons((uint16_t)C.fwd_port);
+		fwd_salen = sizeof(*s6);
+	} else {
+		syslog(LOG_WARNING, "remote log server '%s' is not an address: firewall lines are not forwarded", C.fwd_host);
+		return;
+	}
+	fwd_fd = socket(fwd_sa.ss_family, SOCK_DGRAM | SOCK_CLOEXEC | SOCK_NONBLOCK, 0);
+}
+
+static void rfl_conf_load(void)
+{
+	char t[2048];
+
+	rfl_conf_default(&C);
+	if (rfl_read_file(RFL_CONF, t, sizeof(t)) == 0)
+		rfl_conf_parse(&C, t);
+}
+
+/* bind one group; 0 ok, else the errno the kernel answered (EBUSY: someone else owns the group) */
+static int rfl_bind(int gi)
+{
+	unsigned char m[256], r[4096];
+	struct sockaddr_nl sa;
+	size_t len;
+	ssize_t n;
+	int fd, sz = RFL_RCVBUF;
+
+	if ((fd = socket(AF_NETLINK, SOCK_RAW | SOCK_CLOEXEC, NETLINK_NETFILTER)) < 0)
+		return errno;
+	memset(&sa, 0, sizeof(sa));
+	sa.nl_family = AF_NETLINK;
+	if (bind(fd, (struct sockaddr *)&sa, sizeof(sa)) != 0) {
+		int e = errno;
+		close(fd);
+		return e;
+	}
+	if (setsockopt(fd, SOL_SOCKET, SO_RCVBUFFORCE, &sz, sizeof(sz)) != 0)
+		setsockopt(fd, SOL_SOCKET, SO_RCVBUF, &sz, sizeof(sz));
+	len = rfl_cfg_msg(m, sizeof(m), (uint16_t)C.groups[gi], NFULNL_CFG_CMD_BIND, 1, C.copy, (uint32_t)gi + 1);
+	if (!len || send(fd, m, len, 0) != (ssize_t)len) {
+		close(fd);
+		return EIO;
+	}
+	n = recv(fd, r, sizeof(r), 0);
+	if (n >= (ssize_t)NLMSG_HDRLEN) {
+		struct nlmsghdr *h = (struct nlmsghdr *)r;
+		if (h->nlmsg_type == NLMSG_ERROR && n >= (ssize_t)(NLMSG_HDRLEN + sizeof(struct nlmsgerr))) {
+			struct nlmsgerr *e = (struct nlmsgerr *)NLMSG_DATA(h);
+			if (e->error) {
+				close(fd);
+				return -e->error;
+			}
+		}
+	}
+	fcntl(fd, F_SETFL, fcntl(fd, F_GETFL) | O_NONBLOCK);
+	sock[gi] = fd;
+	return 0;
+}
+
+/* keep CAP_NET_ADMIN (the sockets' buffers) and CAP_NET_RAW (iptables-save), drop the rest for good */
+static void rfl_drop_caps(void)
+{
+	struct __user_cap_header_struct h = { _LINUX_CAPABILITY_VERSION_3, 0 };
+	struct __user_cap_data_struct d[2];
+	uint32_t keep = (1u << CAP_NET_ADMIN) | (1u << CAP_NET_RAW);
+	int c;
+
+	for (c = 0; c <= 63; c++)
+		if (c != CAP_NET_ADMIN && c != CAP_NET_RAW)
+			prctl(PR_CAPBSET_DROP, c, 0, 0, 0);
+	memset(d, 0, sizeof(d));
+	d[0].effective = d[0].permitted = keep;
+	if (syscall(SYS_capset, &h, d) != 0)
+		syslog(LOG_WARNING, "could not drop capabilities: %s", strerror(errno));
+	prctl(PR_SET_NO_NEW_PRIVS, 1, 0, 0, 0);
+	prctl(PR_SET_DUMPABLE, 0, 0, 0, 0);
+}
+
+int main(void)
+{
+	static unsigned char rb[131072 + 64];
+	struct pollfd pf[RFL_MAXG];
+	struct sigaction sa;
+	time_t now;
+	int gi, bound = 0, err = 0;
+
+	openlog("rflogd", LOG_PID, LOG_DAEMON);
+	umask(077);
+	if (mkdir(RFL_DIR, 0700) != 0 && errno != EEXIST) {
+		syslog(LOG_ERR, "cannot create %s: %s", RFL_DIR, strerror(errno));
+		return 1;
+	}
+	{
+		struct stat st;
+		if (lstat(RFL_DIR, &st) != 0 || !S_ISDIR(st.st_mode) || st.st_uid != 0 || (st.st_mode & 022)) {
+			syslog(LOG_ERR, "%s is not a private directory - not starting", RFL_DIR);
+			return 1;
+		}
+	}
+	rfl_conf_load();
+	{
+		struct stat bst;
+		if (stat("/proc/self/exe", &bst) == 0 && bst.st_mtime > clock_floor)
+			clock_floor = bst.st_mtime;
+	}
+	memset(&sa, 0, sizeof(sa));
+	sa.sa_handler = on_sig;
+	sigaction(SIGHUP, &sa, NULL);
+	sigaction(SIGTERM, &sa, NULL);
+	sigaction(SIGINT, &sa, NULL);
+	signal(SIGPIPE, SIG_IGN);
+
+	for (gi = 0; gi < C.ngroups; gi++) {
+		sock[gi] = -1;
+		if ((err = rfl_bind(gi)) != 0) {
+			syslog(LOG_ERR, "cannot take firewall log group %d: %s%s", C.groups[gi], strerror(err),
+			       err == EBUSY ? " (another program, ulogd?, owns it)" : "");
+			break;
+		}
+		bound++;
+	}
+	if (bound != C.ngroups) {
+		FILE *f = fopen(RFL_STATS, "w");
+		if (f) {
+			fprintf(f, "{\"updated\":%ld,\"bind_error\":%d,\"group\":%d}\n", (long)time(NULL), err, C.groups[gi]);
+			fclose(f);
+		}
+		return 2;			/* rc reads bind_error: stays on the LOG fallback, no restart loop */
+	}
+	if (C.cpu) {
+		cpu_set_t cs;
+		int c;
+		CPU_ZERO(&cs);
+		for (c = 0; c < 8; c++)
+			if (C.cpu & (1u << c))
+				CPU_SET(c, &cs);
+		sched_setaffinity(0, sizeof(cs), &cs);
+	}
+	if (nice(5) == -1 && errno) { /* not fatal */ }
+	rfl_drop_caps();
+	rfl_fwd_open();
+	since = now = time(NULL);
+	mono_start = mono();
+	hour_at = mono_start + 3600;
+	sup_at = mono_start + 5;
+	syslog(LOG_INFO, "collecting firewall log groups %d..%d (%d sockets)", C.groups[0], C.groups[C.ngroups - 1], C.ngroups);
+	rfl_stats(now);
+
+	while (!g_term) {
+		int n, i;
+		long m;
+
+		for (i = 0; i < C.ngroups; i++) {
+			pf[i].fd = sock[i];
+			pf[i].events = POLLIN;
+			pf[i].revents = 0;
+		}
+		n = poll(pf, (nfds_t)C.ngroups, 1000);
+		now = time(NULL);
+		m = mono();
+		if (n > 0)
+			for (i = 0; i < C.ngroups; i++) {
+				if (!(pf[i].revents & (POLLIN | POLLERR)))
+					continue;
+				for (;;) {
+					ssize_t r = recv(sock[i], rb, sizeof(rb), MSG_DONTWAIT);
+					if (r < 0) {
+						if (errno == ENOBUFS) {
+							/* the kernel dropped at least one batch for this socket; the sequence gap
+							 * on the next message says how many lines */
+							n_enobufs++;
+							stats_dirty = 1;
+							continue;
+						}
+						break;
+					}
+					if (r == 0)
+						break;
+					rfl_batch(i, rb, (size_t)r, now);
+				}
+			}
+		if (g_hup) {
+			g_hup = 0;
+			rfl_flush();
+			rfl_conf_load();
+			rfl_fwd_open();
+			sup_at = mono();
+			expire_at = 0;
+		}
+		if (olen && (m - flush_at >= 2 || olen > sizeof(obuf) / 2)) {
+			rfl_flush();
+			flush_at = m;
+		}
+		if (m >= sup_at) {
+			rfl_counters();
+			sup_at = m + 60;
+		}
+		if (m >= hour_at) {
+			if (hour_rx)
+				syslog(LOG_INFO, "%llu firewall log line(s) in the last hour; %llu lost, %llu suppressed since start",
+				       hour_rx, n_lost, rfl_suppressed(0));
+			hour_rx = 0;
+			hour_at = m + 3600;
+		}
+		if (stats_dirty && m - stats_at >= 2)
+			rfl_stats(now);
+	}
+	rfl_flush();
+	if (ring_fd >= 0) {
+		fsync(ring_fd);
+		close(ring_fd);
+	}
+	rfl_stats(time(NULL));
+	return 0;
+}
+#endif /* RFLOGD_HOST */
