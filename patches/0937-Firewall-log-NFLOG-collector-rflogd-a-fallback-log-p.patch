+#define RFL_CONF	RFL_DIR "/fwlog.conf"
+#define RFL_CUR		RFL_DIR "/current.log"
+#define RFL_PREV	RFL_DIR "/prev.log"
+#define RFL_STATS	RFL_DIR "/stats.json"
+#define RFL_MAXG	8
+#define RFL_RCVBUF	(2 << 20)
+#define RFL_OUTBUF	65536
+#define RFL_LINE	1024
+
+/* ------------------------------------------------------------------ configuration (rc writes it) */
+struct rfl_conf {
+	int groups[RFL_MAXG], ngroups;
+	long ram_kb, keep_days, keep_mb;
+	unsigned cpu;			/* affinity mask, 0 = unpinned */
+	int copy;			/* bytes of each packet the kernel copies */
+	char fwd_host[64];		/* remote syslog, "" = none */
+	int fwd_port;
+	char host[64];
+};
+
+void rfl_conf_default(struct rfl_conf *c)	/* (not static: the host test calls it) */
+{
+	memset(c, 0, sizeof(*c));
+	c->groups[0] = RFL_G_STOCK; c->groups[1] = RFL_G_WARDEN; c->groups[2] = RFL_G_BLOB; c->groups[3] = RFL_G_REAPER;
+	c->ngroups = 4;
+	c->ram_kb = 2048; c->keep_days = 30; c->keep_mb = 256; c->cpu = 8; c->copy = 128; c->fwd_port = 514;
+	snprintf(c->host, sizeof(c->host), "router");
+}
+
+static int rfl_word_ok(const char *s)	/* host names and addresses: [A-Za-z0-9._:-] only */
+{
+	if (!*s)
+		return 0;
+	for (; *s; s++)
+		if (!(isalnum((unsigned char)*s) || *s == '.' || *s == '_' || *s == '-' || *s == ':'))
+			return 0;
+	return 1;
+}
+
+/* key=value lines; unknown keys and bad values are ignored (the default stays) */
+void rfl_conf_parse(struct rfl_conf *c, const char *text)
+{
+	char line[256];
+	const char *p = text;
+
+	while (*p) {
+		size_t n = strcspn(p, "\n");
+		char *v;
+		long x;
+
+		if (n >= sizeof(line))
+			n = sizeof(line) - 1;
+		memcpy(line, p, n);
+		line[n] = '\0';
+		p += strcspn(p, "\n");
+		if (*p)
+			p++;
+		if ((v = strchr(line, '=')) == NULL)
+			continue;
+		*v++ = '\0';
+		x = strtol(v, NULL, 10);
+		if (!strcmp(line, "groups")) {
+			char *s = v, *e;
+			int ng = 0;
+			while (*s && ng < RFL_MAXG) {
+				long g = strtol(s, &e, 10);
+				if (e == s)
+					break;
+				if (g > 0 && g < 65536)
+					c->groups[ng++] = (int)g;
+				s = (*e == ',') ? e + 1 : e;
+			}
+			if (ng)
+				c->ngroups = ng;
+		} else if (!strcmp(line, "ram_kb") && x >= 256 && x <= 65536)
+			c->ram_kb = x;
+		else if (!strcmp(line, "keep_days") && x >= 1 && x <= 3650)
+			c->keep_days = x;
+		else if (!strcmp(line, "keep_mb") && x >= 16 && x <= 65536)
+			c->keep_mb = x;
+		else if (!strcmp(line, "cpu") && x >= 0 && x <= 0xff)
+			c->cpu = (unsigned)x;
+		else if (!strcmp(line, "copy") && x >= 64 && x <= 512)
+			c->copy = (int)x;
+		else if (!strcmp(line, "fwd")) {
+			/* host:port, an IPv6 host in brackets: [2001:db8::1]:514 */
+			char h[64] = "";
+			int port = 514;
+			char *q;
+			if (*v == '[' && (q = strchr(v, ']')) != NULL && (size_t)(q - v - 1) < sizeof(h)) {
+				memcpy(h, v + 1, q - v - 1);
+				h[q - v - 1] = '\0';
+				if (q[1] == ':')
+					port = atoi(q + 2);
+			} else if ((q = strrchr(v, ':')) != NULL && strchr(v, ':') == q && (size_t)(q - v) < sizeof(h)) {
+				memcpy(h, v, q - v);
+				h[q - v] = '\0';
+				port = atoi(q + 1);
+			} else if (strlen(v) < sizeof(h))
+				snprintf(h, sizeof(h), "%s", v);
+			if (h[0] && rfl_word_ok(h) && port > 0 && port < 65536) {
+				snprintf(c->fwd_host, sizeof(c->fwd_host), "%s", h);
+				c->fwd_port = port;
+			} else
+				c->fwd_host[0] = '\0';
+		} else if (!strcmp(line, "host") && rfl_word_ok(v) && strlen(v) < sizeof(c->host))
+			snprintf(c->host, sizeof(c->host), "%s", v);
+	}
+}
