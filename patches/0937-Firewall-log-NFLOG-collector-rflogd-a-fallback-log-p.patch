+/* ------------------------------------------------------------------ the kernel side: config messages */
+/* One CONFIG message per group: BIND, then the copy mode (copy bytes of each packet), a 64 KB kernel batch buffer,
+ * a 1 s flush (TIMEOUT is in 1/100 s), up to 100 packets per batch, and per-instance sequence numbers. The kernel
+ * applies the command and the parameters in one pass. No PF_BIND: nfnetlink_log already registers for every family,
+ * and PF_BIND would swap the family's default logger. */
+static size_t rfl_put_attr(unsigned char *buf, size_t at, size_t cap, uint16_t type, const void *data, uint16_t len)
+{
+	struct nlattr *a;
+	size_t need = NLA_HDRLEN + NLA_ALIGN(len);
+
+	if (at + need > cap)
+		return 0;
+	a = (struct nlattr *)(buf + at);
+	a->nla_type = type;
+	a->nla_len = NLA_HDRLEN + len;
+	memcpy(buf + at + NLA_HDRLEN, data, len);
+	memset(buf + at + NLA_HDRLEN + len, 0, NLA_ALIGN(len) - len);
+	return at + need;
+}
+
+size_t rfl_cfg_msg(unsigned char *buf, size_t cap, uint16_t group, uint8_t cmd, int params, int copy, uint32_t seq)
+{
+	struct nlmsghdr *nh = (struct nlmsghdr *)buf;
+	struct nfgenmsg *nf;
+	struct nfulnl_msg_config_cmd c = { cmd };
+	struct nfulnl_msg_config_mode m;
+	uint32_t v;
+	uint16_t f;
+	size_t at = NLMSG_HDRLEN + NLMSG_ALIGN(sizeof(*nf));
+
+	if (cap < at)
+		return 0;
+	memset(buf, 0, at);
+	nh->nlmsg_type = (NFNL_SUBSYS_ULOG << 8) | NFULNL_MSG_CONFIG;
+	nh->nlmsg_flags = NLM_F_REQUEST | NLM_F_ACK;
+	nh->nlmsg_seq = seq;
+	nf = (struct nfgenmsg *)(buf + NLMSG_HDRLEN);
+	nf->nfgen_family = AF_UNSPEC;
+	nf->version = NFNETLINK_V0;
+	nf->res_id = htons(group);
+	if (!(at = rfl_put_attr(buf, at, cap, NFULA_CFG_CMD, &c, sizeof(c))))
+		return 0;
+	if (params) {
+		memset(&m, 0, sizeof(m));
+		m.copy_range = htonl((uint32_t)copy);
+		m.copy_mode = NFULNL_COPY_PACKET;
+		if (!(at = rfl_put_attr(buf, at, cap, NFULA_CFG_MODE, &m, sizeof(m))))
+			return 0;
+		v = htonl(65536);
+		if (!(at = rfl_put_attr(buf, at, cap, NFULA_CFG_NLBUFSIZ, &v, sizeof(v))))
+			return 0;
+		v = htonl(100);
+		if (!(at = rfl_put_attr(buf, at, cap, NFULA_CFG_TIMEOUT, &v, sizeof(v))))
+			return 0;
+		v = htonl(100);
+		if (!(at = rfl_put_attr(buf, at, cap, NFULA_CFG_QTHRESH, &v, sizeof(v))))
+			return 0;
+		f = htons(NFULNL_CFG_F_SEQ);
+		if (!(at = rfl_put_attr(buf, at, cap, NFULA_CFG_FLAGS, &f, sizeof(f))))
+			return 0;
+	}
+	nh->nlmsg_len = (uint32_t)at;
+	return at;
+}
+
+/* ------------------------------------------------------------------ line formatting (xt_LOG's text) */
+struct rfl_out { char *b; size_t n, cap; };
+
+static void ap(struct rfl_out *o, const char *fmt, ...) __attribute__((format(printf, 2, 3)));
+static void ap(struct rfl_out *o, const char *fmt, ...)
+{
+	va_list va;
+	int r;
+
+	if (o->n + 1 >= o->cap)
+		return;
+	va_start(va, fmt);
+	r = vsnprintf(o->b + o->n, o->cap - o->n, fmt, va);
+	va_end(va);
+	if (r < 0)
+		return;
+	o->n += ((size_t)r < o->cap - o->n) ? (size_t)r : o->cap - o->n - 1;
+}
+
+static void ap_hex(struct rfl_out *o, const unsigned char *p, size_t n)
+{
+	size_t i;
+
+	for (i = 0; i < n; i++)
+		ap(o, "%02X", p[i]);
+}
+
+static uint16_t g16(const unsigned char *p) { return (uint16_t)((p[0] << 8) | p[1]); }
+static uint32_t g32(const unsigned char *p) { return ((uint32_t)p[0] << 24) | ((uint32_t)p[1] << 16) | ((uint32_t)p[2] << 8) | p[3]; }
+
+/* which prefixes carry --log-tcp-sequence / --log-tcp-options / --log-ip-options in their LOG form (the stock chains
+ * and the blob's); Warden's and the rules engine's never did */
+static int rfl_prefix_full(const char *prefix)
+{
+	static const char *const full[] = { "ACCEPT ", "DROP ", "DROP_DNS ", "DROP_IP ", NULL };
+	int i;
+
+	for (i = 0; full[i]; i++)
+		if (!strcmp(prefix, full[i]))
+			return 1;
+	return 0;
+}
+
+static void fmt_tcp(struct rfl_out *o, const unsigned char *t, size_t n, int frag, int full, const char *name)
+{
+	size_t doff;
+
+	ap(o, "PROTO=%s ", name);
+	if (frag)
+		return;
+	if (n < 20) {
+		ap(o, "INCOMPLETE [%zu bytes] ", n);
+		return;
+	}
+	ap(o, "SPT=%u DPT=%u ", g16(t), g16(t + 2));
+	if (full)
+		ap(o, "SEQ=%u ACK=%u ", g32(t + 4), g32(t + 8));
+	ap(o, "WINDOW=%u RES=0x%02x ", g16(t + 14), (t[12] & 0x0F) << 2);
+	if (t[13] & 0x80) ap(o, "CWR ");
+	if (t[13] & 0x40) ap(o, "ECE ");
+	if (t[13] & 0x20) ap(o, "URG ");
+	if (t[13] & 0x10) ap(o, "ACK ");
+	if (t[13] & 0x08) ap(o, "PSH ");
+	if (t[13] & 0x04) ap(o, "RST ");
+	if (t[13] & 0x02) ap(o, "SYN ");
+	if (t[13] & 0x01) ap(o, "FIN ");
+	ap(o, "URGP=%u ", g16(t + 18));
+	doff = (size_t)(t[12] >> 4) * 4;
+	if (full && doff > 20) {
+		if (doff > n)
+			ap(o, "OPT (TRUNCATED) ");
+		else {
+			ap(o, "OPT (");
+			ap_hex(o, t + 20, doff - 20);
+			ap(o, ") ");
+		}
+	}
+}
+
+static void fmt_udp(struct rfl_out *o, const unsigned char *u, size_t n, int frag, const char *name)
+{
+	ap(o, "PROTO=%s ", name);
+	if (frag)
+		return;
+	if (n < 8) {
+		ap(o, "INCOMPLETE [%zu bytes] ", n);
+		return;
+	}
+	ap(o, "SPT=%u DPT=%u LEN=%u ", g16(u), g16(u + 2), g16(u + 4));
+}
+
+static void fmt_ip4(struct rfl_out *o, const unsigned char *p, size_t n, int full)
+{
+	char s[INET_ADDRSTRLEN], d[INET_ADDRSTRLEN];
+	size_t ihl;
+	uint16_t off;
+	int frag;
+	const unsigned char *l4;
+	size_t rem;
+
+	if (n < 20) {
+		ap(o, "TRUNCATED ");
+		return;
+	}
+	ihl = (size_t)(p[0] & 0x0F) * 4;
+	if (ihl < 20 || ihl > n) {
+		ap(o, "TRUNCATED ");
+		return;
+	}
+	inet_ntop(AF_INET, p + 12, s, sizeof(s));
+	inet_ntop(AF_INET, p + 16, d, sizeof(d));
+	ap(o, "SRC=%s DST=%s LEN=%u TOS=0x%02X PREC=0x%02X TTL=%u ID=%u ",
+	   s, d, g16(p + 2), p[1] & 0x1E, p[1] & 0xE0, p[8], g16(p + 4));
+	off = g16(p + 6);
+	if (off & 0x8000) ap(o, "CE ");
+	if (off & 0x4000) ap(o, "DF ");
+	if (off & 0x2000) ap(o, "MF ");
+	if (off & 0x1FFF) ap(o, "FRAG:%u ", off & 0x1FFF);
+	frag = (off & 0x1FFF) != 0;
+	if (full && ihl > 20) {
+		ap(o, "OPT (");
+		ap_hex(o, p + 20, ihl - 20);
+		ap(o, ") ");
+	}
+	l4 = p + ihl;
+	rem = n - ihl;
+	switch (p[9]) {
+	case IPPROTO_TCP:
+		fmt_tcp(o, l4, rem, frag, full, "TCP");
+		break;
+	case IPPROTO_UDP:
+		fmt_udp(o, l4, rem, frag, "UDP");
+		break;
+	case IPPROTO_UDPLITE:
+		fmt_udp(o, l4, rem, frag, "UDPLITE");
+		break;
+	case IPPROTO_ICMP:
+		ap(o, "PROTO=ICMP ");
+		if (frag)
+			break;
+		if (rem < 4) {
+			ap(o, "INCOMPLETE [%zu bytes] ", rem);
+			break;
+		}
+		ap(o, "TYPE=%u CODE=%u ", l4[0], l4[1]);
+		switch (l4[0]) {
+		case 0: case 8: case 13: case 14: case 15: case 16: case 17: case 18:
+			if (rem >= 8)
+				ap(o, "ID=%u SEQ=%u ", g16(l4 + 4), g16(l4 + 6));
+			break;
+		case 12:
+			if (rem >= 8)
+				ap(o, "PARAMETER=%u ", l4[4]);
+			break;
+		case 5:
+			if (rem >= 8) {
+				char gw[INET_ADDRSTRLEN];
+				inet_ntop(AF_INET, l4 + 4, gw, sizeof(gw));
+				ap(o, "GATEWAY=%s ", gw);
+			}
+			break;
+		case 3:
+			if (l4[1] == 4 && rem >= 8)
+				ap(o, "MTU=%u ", g16(l4 + 6));
+			break;
+		}
+		break;
+	default:
+		ap(o, "PROTO=%u ", p[9]);
+	}
+}
+
+static void fmt_ip6(struct rfl_out *o, const unsigned char *p, size_t n, int full)
+{
+	char s[INET6_ADDRSTRLEN], d[INET6_ADDRSTRLEN];
+	uint32_t w0;
+	uint8_t nh;
+	size_t at = 40;
+	int frag = 0, hops = 0;
+
+	if (n < 40) {
+		ap(o, "TRUNCATED ");
+		return;
+	}
+	w0 = g32(p);
+	inet_ntop(AF_INET6, p + 8, s, sizeof(s));
+	inet_ntop(AF_INET6, p + 24, d, sizeof(d));
+	ap(o, "SRC=%s DST=%s LEN=%u TC=%u HOPLIMIT=%u FLOWLBL=%u ",
+	   s, d, (unsigned)g16(p + 4) + 40, (w0 >> 20) & 0xFF, p[7], w0 & 0xFFFFF);
+	nh = p[6];
+	/* extension headers: hop-by-hop, routing, destination options, fragment, AH */
+	while (hops++ < 8 && (nh == 0 || nh == 43 || nh == 60 || nh == 44 || nh == 51)) {
+		size_t len;
+		if (at + 8 > n) {
+			ap(o, "INCOMPLETE [%zu bytes] ", n - at);
+			return;
+		}
+		if (nh == 44) {
+			uint16_t off = g16(p + at + 2);
+			ap(o, "FRAG:%u ", off & 0xFFF8);
+			if (off & 0x0001) ap(o, "INCOMPLETE ");
+			ap(o, "ID:%08x ", g32(p + at + 4));
+			frag = (off & 0xFFF8) != 0;
+			len = 8;
+		} else if (nh == 51)
+			len = ((size_t)p[at + 1] + 2) * 4;
+		else
+			len = ((size_t)p[at + 1] + 1) * 8;
+		nh = p[at];
+		at += len;
+		if (frag)
+			break;
+	}
+	if (at > n) {
+		ap(o, "INCOMPLETE ");
+		return;
+	}
+	switch (nh) {
+	case IPPROTO_TCP:
+		fmt_tcp(o, p + at, n - at, frag, full, "TCP");
+		break;
+	case IPPROTO_UDP:
+		fmt_udp(o, p + at, n - at, frag, "UDP");
+		break;
+	case IPPROTO_UDPLITE:
+		fmt_udp(o, p + at, n - at, frag, "UDPLITE");
+		break;
+	case IPPROTO_ICMPV6: {
+		const unsigned char *c = p + at;
+		size_t rem = n - at;
+		ap(o, "PROTO=ICMPv6 ");
+		if (frag)
+			break;
+		if (rem < 4) {
+			ap(o, "INCOMPLETE [%zu bytes] ", rem);
+			break;
+		}
+		ap(o, "TYPE=%u CODE=%u ", c[0], c[1]);
+		if ((c[0] == 128 || c[0] == 129) && rem >= 8)
+			ap(o, "ID=%u SEQ=%u ", g16(c + 4), g16(c + 6));
+		else if (c[0] == 2 && rem >= 8)
+			ap(o, "MTU=%u ", g32(c + 4));
+		else if (c[0] == 4 && rem >= 8)
+			ap(o, "POINTER=%08x ", g32(c + 4));
+		break;
+	}
+	default:
+		ap(o, "PROTO=%u ", nh);
+	}
+}
+
+/* ------------------------------------------------------------------ one packet message */
+struct rfl_pkt {
+	int family;
+	char prefix[64];
+	uint32_t mark, indev, outdev, physin, physout, seq;
+	int has_seq;
+	const unsigned char *payload, *hw;
+	size_t plen, hwlen;
+	long long ts_sec, ts_usec;
+	int has_ts;
+};
+
+/* the attributes of one NFULNL_MSG_PACKET; 0 = usable, -1 = malformed (dropped, counted) */
+int rfl_parse(const unsigned char *msg, size_t len, struct rfl_pkt *pk)
+{
+	const struct nfgenmsg *nf;
+	size_t at;
+
+	memset(pk, 0, sizeof(*pk));
+	if (len < NLMSG_HDRLEN + NLMSG_ALIGN(sizeof(*nf)))
+		return -1;
+	nf = (const struct nfgenmsg *)(msg + NLMSG_HDRLEN);
+	pk->family = nf->nfgen_family;
+	at = NLMSG_HDRLEN + NLMSG_ALIGN(sizeof(*nf));
+	while (at + NLA_HDRLEN <= len) {
+		const struct nlattr *a = (const struct nlattr *)(msg + at);
+		const unsigned char *d = msg + at + NLA_HDRLEN;
+		size_t al = a->nla_len, dl;
+
+		if (al < NLA_HDRLEN || al > len - at)
+			return -1;
+		dl = al - NLA_HDRLEN;
+		switch (a->nla_type & NLA_TYPE_MASK) {
+		case NFULA_PREFIX: {
+			size_t i, k = 0;
+			for (i = 0; i < dl && d[i] && k + 1 < sizeof(pk->prefix); i++)
+				pk->prefix[k++] = (d[i] >= 0x20 && d[i] < 0x7F) ? (char)d[i] : '?';
+			pk->prefix[k] = '\0';
+			break;
+		}
+		case NFULA_MARK:
+			if (dl >= 4) pk->mark = g32(d);
+			break;
+		case NFULA_IFINDEX_INDEV:
+			if (dl >= 4) pk->indev = g32(d);
+			break;
+		case NFULA_IFINDEX_OUTDEV:
+			if (dl >= 4) pk->outdev = g32(d);
+			break;
+		case NFULA_IFINDEX_PHYSINDEV:
+			if (dl >= 4) pk->physin = g32(d);
+			break;
+		case NFULA_IFINDEX_PHYSOUTDEV:
+			if (dl >= 4) pk->physout = g32(d);
+			break;
+		case NFULA_SEQ:
+			if (dl >= 4) { pk->seq = g32(d); pk->has_seq = 1; }
+			break;
+		case NFULA_TIMESTAMP:
+			if (dl >= 16) {
+				pk->ts_sec = ((long long)g32(d) << 32) | g32(d + 4);
+				pk->ts_usec = ((long long)g32(d + 8) << 32) | g32(d + 12);
+				pk->has_ts = pk->ts_sec > 0;
+			}
+			break;
+		case NFULA_HWHEADER:
+			pk->hw = d;
+			pk->hwlen = dl > 64 ? 64 : dl;
+			break;
+		case NFULA_PAYLOAD:
+			pk->payload = d;
+			pk->plen = dl;
+			break;
+		}
+		at += NLA_ALIGN(al);
+	}
+	return pk->payload ? 0 : -1;
+}
+
+/* ifindex -> name, cached for 30 s (an index can be reused by a new interface) */
+#define RFL_IFC 32
+static struct { uint32_t idx; char name[IF_NAMESIZE]; time_t at; } ifc[RFL_IFC];
+
+static const char *rfl_ifname(uint32_t idx, time_t now)
+{
+	int i, slot = 0;
+
+	if (!idx)
+		return "";
+	for (i = 0; i < RFL_IFC; i++) {
+		if (ifc[i].idx == idx && now - ifc[i].at < 30)
+			return ifc[i].name;
+		if (ifc[i].at < ifc[slot].at)
+			slot = i;
+	}
+	if (!if_indextoname(idx, ifc[slot].name))
+		snprintf(ifc[slot].name, sizeof(ifc[slot].name), "if%u", idx);
+	ifc[slot].idx = idx;
+	ifc[slot].at = now;
+	return ifc[slot].name;
+}
+
+/* the line, without the timestamp: "<prefix>IN=.. OUT=.. [PHYSIN=.. PHYSOUT=..] [MAC=..] <ip> [MARK=0x..]" */
+size_t rfl_format(const struct rfl_pkt *pk, char *buf, size_t cap, time_t now)
+{
+	struct rfl_out o = { buf, 0, cap };
+	int full = rfl_prefix_full(pk->prefix);
+
+	buf[0] = '\0';
+	ap(&o, "%sIN=%s OUT=%s ", pk->prefix, rfl_ifname(pk->indev, now), rfl_ifname(pk->outdev, now));
+	if (pk->physin || pk->physout)
+		ap(&o, "PHYSIN=%s PHYSOUT=%s ", rfl_ifname(pk->physin, now), rfl_ifname(pk->physout, now));
+	if (pk->indev) {
+		size_t i;
+		ap(&o, "MAC=");
+		for (i = 0; pk->hw && i < pk->hwlen; i++)
+			ap(&o, "%s%02x", i ? ":" : "", pk->hw[i]);
+		ap(&o, " ");
+	}
+	if (pk->family == AF_INET)
+		fmt_ip4(&o, pk->payload, pk->plen, full);
+	else if (pk->family == AF_INET6)
+		fmt_ip6(&o, pk->payload, pk->plen, full);
+	else
+		ap(&o, "FAMILY=%d ", pk->family);
+	if (pk->mark)
+		ap(&o, "MARK=0x%x ", pk->mark);
+	while (o.n && buf[o.n - 1] == ' ')
+		buf[--o.n] = '\0';
+	return o.n;
+}
+
+/* the timestamp a line starts with: 2026-11-08T21:05:03.123-05:00 */
+size_t rfl_stamp(char *buf, size_t cap, long long sec, long usec)
+{
+	struct tm tm;
+	time_t t = (time_t)sec;
+	char z[8];
+	size_t n;
+
+	localtime_r(&t, &tm);
+	n = strftime(buf, cap, "%Y-%m-%dT%H:%M:%S", &tm);
+	if (!strftime(z, sizeof(z), "%z", &tm) || strlen(z) != 5)
+		snprintf(z, sizeof(z), "+0000");
+	n += snprintf(buf + n, cap - n, ".%03ld%c%c%c:%c%c", usec / 1000, z[0], z[1], z[2], z[3], z[4]);
+	return n;
+}
+
+/* ------------------------------------------------------------------ suppressed lines (rule counters) */
+/* iptables-save -c text: for each log chain, the first rule that targets NFLOG or LOG and the rule right after it.
+ * The second sees every packet the first could have logged (the stock chains' NEW counter, Warden's / the blob's
+ * DROP), so their difference is what the rule's limiter held back. Counters restart with every rule reload: a
+ * value below the last one starts a new base. */
+#define RFL_SUPK 24
+struct rfl_sup { char key[40]; int group; unsigned long long last, base; };
+static struct rfl_sup sup[RFL_SUPK];
+static int nsup;
+
+static int rfl_chain_group(const char *chain)
+{
+	if (!strcmp(chain, "logaccept") || !strcmp(chain, "logdrop")) return RFL_G_STOCK;
+	if (!strcmp(chain, "RW_DROP") || !strcmp(chain, "RW_ODROP") || !strcmp(chain, "RW_SDROP")) return RFL_G_WARDEN;
+	if (!strcmp(chain, "logdrop_dns") || !strcmp(chain, "logdrop_ip")) return RFL_G_BLOB;
+	return 0;
+}
+
+static void rfl_sup_set(const char *fam, const char *chain, unsigned long long v)
+{
+	char key[40];
+	int i;
+
+	snprintf(key, sizeof(key), "%s:%s", fam, chain);
+	for (i = 0; i < nsup; i++)
+		if (!strcmp(sup[i].key, key))
+			break;
+	if (i == nsup) {
+		if (nsup == RFL_SUPK)
+			return;
+		memset(&sup[i], 0, sizeof(sup[i]));
+		snprintf(sup[i].key, sizeof(sup[i].key), "%s", key);
+		sup[i].group = rfl_chain_group(chain);
+		nsup++;
+	}
+	if (v < sup[i].last)
+		sup[i].base += sup[i].last;	/* the rules were reloaded */
+	sup[i].last = v;
+}
+
+void rfl_counters_parse(const char *fam, const char *text)
+{
+	char chain[32] = "", line[512];
+	unsigned long long logp = 0;
+	int state = 0;		/* 0 looking, 1 log rule seen in `chain` */
+	const char *p = text;
+
+	while (*p) {
+		size_t n = strcspn(p, "\n");
+		unsigned long long pk, by;
+		char ch[32];
+		int off = 0;
+
+		if (n >= sizeof(line))
+			n = sizeof(line) - 1;
+		memcpy(line, p, n);
+		line[n] = '\0';
+		p += strcspn(p, "\n");
+		if (*p)
+			p++;
+		if (sscanf(line, "[%llu:%llu] -A %31s %n", &pk, &by, ch, &off) < 3 || !rfl_chain_group(ch))
+			continue;
+		if (state && strcmp(ch, chain) != 0)
+			state = 0;
+		if (!state) {
+			if (strstr(line + off, "-j NFLOG") || strstr(line + off, "-j LOG")) {
+				snprintf(chain, sizeof(chain), "%s", ch);
+				logp = pk;
+				state = 1;
+			}
+			continue;
+		}
+		rfl_sup_set(fam, ch, pk >= logp ? pk - logp : 0);
+		state = 0;
+	}
+}
+
+unsigned long long rfl_suppressed(int group)
+{
+	unsigned long long t = 0;
+	int i;
+
+	for (i = 0; i < nsup; i++)
+		if (!group || sup[i].group == group)
+			t += sup[i].base + sup[i].last;
+	return t;
+}
+
+/* lines lost before this message: the gap between the instance's sequence number and the one expected (wraps at
+ * 2^32; a jump "backwards" - the instance was re-created - restarts the count, never a huge false loss) */
+uint32_t rfl_seq_gap(uint32_t *next, int *seen, uint32_t seq)
+{
+	uint32_t gap = 0;
+
+	if (*seen && seq != *next && (uint32_t)(seq - *next) < 0x80000000u)
+		gap = seq - *next;
+	*next = seq + 1;
+	*seen = 1;
+	return gap;
+}
