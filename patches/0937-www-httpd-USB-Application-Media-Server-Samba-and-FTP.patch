+    post({action_mode: 'apply', ftp_tls: '0', rc_service: 'restart_ftpsamba'}, function(){ delete ch.ftp_tls; sw(); });
+  }
+  var msgs = [];
+  if (ch.enable_ftp !== undefined) msgs.push(ch.enable_ftp === '1' ? `<#confirm_enableftp#>` : `<#confirm_disableftp#>`);
+  if (ch.ftp_wanac === '1') msgs.push(`<#RUSB_29#>`);
+  if (an && q('t_anon').checked) msgs.push(`<#Aidisk_FTP_hint_3#>`);
+  if (!msgs.length) return go();
+  var risky = ch.ftp_wanac === '1' || (an && q('t_anon').checked);
+  window.reaperConfirm(msgs.join('\n\n'), {okLabel: `<#CTL_apply#>`, cancelLabel: `<#CTL_Cancel#>`, danger: risky}, function(ok){ if (ok) go(); });
+}
+
+['t_en', 't_wan', 't_anon', 't_tls'].forEach(function(id){ rp.on(id, 'change', dirty); });
+rp.on('i_max', 'input', dirty); rp.on('s_lang', 'change', dirty);
