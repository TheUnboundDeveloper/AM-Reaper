+}
+function done(){ setTimeout(function(){ location.reload(); }, 9000); }
+function fail(err){ q('applying').className = 'applying'; rp.msg(String(err || '')); }
+
+function apply(){
+  rp.msg(''); rp.note('setmsg', '');
+  var c = cur(), ch = changes(), an = anonChanged();
+  if (!rp.v.int(c.st_max_user, 1, 99)){ rp.note('setmsg', `<#ShareNode_MaximumLoginUser_itemname#>` + ': 1 - 99'); q('i_max').focus(); return; }
