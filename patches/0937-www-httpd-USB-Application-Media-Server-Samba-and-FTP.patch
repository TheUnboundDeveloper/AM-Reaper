+<!DOCTYPE html>
+<html lang="en">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width, initial-scale=1">
+<meta name="reaper-native" content="1">
+<title>REAPER &mdash; FTP</title>
+<!-- Reaper_FTP.asp - USB Application > FTP Share (Reaper-native UI, USB wave, 2026-11-03).
+     Replaces Advanced_AiDisk_ftp.asp (still shipped until the owner has reviewed this page); same nvram, same
+     handlers. Settings: enable_ftp, ftp_wanac (port 21 + ftp_pasvport..+30 on the WAN, firewall.c), ftp_tls (FTPS,
+     only when rc_support has ftp_ssl), st_max_user (shared with Samba), ftp_lang -> /applyapp.cgi rc_service
+     restart_ftpsamba (stock Apply), plus restart_firewall when the on/off or WAN switch changed (stock ran
+     restart_ftpd, which starts the firewall, for those two). Anonymous login (st_ftp_mode 1 anonymous / 2 accounts)
+     -> /aidisk/switch_share_mode.asp, posted first when it changed. Accounts, rights and folders: rp.share.js
+     (shared with Samba). Differences from stock, on purpose: turning WAN access on asks first (stock opened the
+     ports without a word); anonymous login and TLS cannot both be saved (stock checked only in some paths); the
+     SFTP / FTP chooser (UI only - it changed no setting) became a note pointing at SSH. -->
+<link rel="stylesheet" href="/reaper/rp.css">
+<style>
+.msg{font-size:12.5px;color:var(--amber);display:none}
+.msg.show{display:block}
+.off{display:none!important}
+.frow input.num2{max-width:90px}
+.note a{color:var(--bone)}
+</style>
+</head>
+<body>
+<script src="/reaper_util.js"></script>
+<script src="/reaper/rp.js"></script>
+<script src="/reaper/rp.share.js"></script>
+<script src="/disk_msg.js"></script>
+<script>
+/* the stock emitters, run inside one function so their declarations stay off window */
+rp.usbData = (function(){
+/* @usbdata */
+<% available_disk_names_and_sizes(); %>
+<% disk_pool_mapping_info(); %>
+<% get_permissions_of_account(); %>
+var acc = []; try { acc = [<% get_all_accounts(); %>][0] || []; } catch (e) {}
+return {
+  disks: typeof foreign_disks === 'function' ? foreign_disks : null,
+  parts: typeof foreign_disk_pool_number === 'function' ? foreign_disk_pool_number : null,
+  names: typeof pool_names === 'function' ? pool_names : null,
+  devs: typeof pool_devices === 'function' ? pool_devices : null,
+  status: typeof pool_status === 'function' ? pool_status : null,
+  perm: typeof get_account_permissions_in_pool === 'function' ? get_account_permissions_in_pool : null,
+  accounts: acc
+};
+})();
+</script>
+
+<div class="syswrap">
+<div class="pagehead">
+  <div>
+    <div class="eyebrow"><#Menu_usb_application#></div>
+    <h1><#menu5_4_2#></h1>
+  </div>
+  <div class="spacer"></div>
+  <span class="pill warn chgpill" id="chgpill"><span class="dot"></span><span><#RADM_77#>: <b id="chgcount">0</b></span></span>
+  <button type="button" class="btn ghost" id="discardbtn" disabled><#Discard#></button>
+  <button type="button" class="btn primary" id="applybtn"><#CTL_apply#></button>
+</div>
+<div class="msg" id="topmsg" style="margin:-6px 0 12px"></div>
+<div class="hint" style="margin:-4px 0 6px"><#FTP_desc#></div>
+<div class="hint note" id="sftpnote" style="margin:0 0 14px"></div>
+
+<div class="rframe">
+<div class="panel">
+  <h2><#Settings#></h2>
+  <div class="togglerow"><label class="tswitch"><input type="checkbox" id="t_en"><span class="track"></span></label><div><#enableFTP#><div class="sub warnline" id="conflict"></div></div></div>
+  <div class="togglerow"><label class="tswitch"><input type="checkbox" id="t_wan"><span class="track"></span></label><div><#enableWANaccess#></div></div>
+  <div class="togglerow" id="row_anon"><label class="tswitch"><input type="checkbox" id="t_anon"><span class="track"></span></label><div><#AiDisk_Anonymous_Login#><div class="sub" id="anon_hint"></div></div></div>
+  <div class="togglerow" id="row_tls"><label class="tswitch"><input type="checkbox" id="t_tls"><span class="track"></span></label><div><#AiDisk_Enable_TLS#><div class="sub" id="tls_hint"></div></div></div>
+  <div class="frow"><div class="fl"><#ShareNode_MaximumLoginUser_itemname#></div><div class="fc"><input type="text" class="num2" id="i_max" maxlength="2" inputmode="numeric" autocomplete="off"></div></div>
+  <div class="frow"><div class="fl"><#ShareNode_FTPLANG_itemname#></div><div class="fc"><select id="s_lang">
+    <option value="EN">UTF-8</option><option value="TW">Big5</option><option value="CN">GBK</option>
+    <option value="RU"><#ShareNode_FTPLANG_optionname4#></option><option value="CZ"><#ShareNode_FTPLANG_optionname5#></option></select></div></div>
+  <div class="msg" id="setmsg" style="margin-top:8px"></div>
+</div>
+<div id="share"></div>
+</div>
+</div>
+
+<div class="applying" id="applying"><div class="abox"><h2 id="ap_t"><#Reaper_c_applying#></h2><p id="ap_p"><#RUSB_20#></p></div></div>
+
+<script>
+(function(){
+'use strict';
+var q = rp.q;
+var NV = {
+  enable_ftp: <% nvram_get_js("enable_ftp"); %>, ftp_wanac: <% nvram_get_js("ftp_wanac"); %>, ftp_tls: <% nvram_get_js("ftp_tls"); %>,
+  st_max_user: <% nvram_get_js("st_max_user"); %>, ftp_lang: <% nvram_get_js("ftp_lang"); %>
+};
+var ST_MODE = <% nvram_get_js("st_ftp_mode"); %>, ST_FORCE = <% nvram_get_js("st_ftp_force_mode"); %>;
+var RCS = ' ' + <% nvram_get_js("rc_support"); %> + ' ', TERR = <% nvram_get_js("territory_code"); %>, SW_MODE = <% nvram_get_js("sw_mode"); %>;
+var VTS_EN = <% nvram_get_js("vts_enable_x"); %>, VTS = rp.dec('<% nvram_char_to_ascii("","vts_rulelist"); %>'), LAN_IP = <% nvram_get_js("lan_ipaddr"); %>;
+/* web.c get_share_management_status: mode 1 with no force mode reads as accounts (2) */
+var MODE = (ST_FORCE === '' && ST_MODE === '1') ? '2' : ST_MODE;
+var ANON0 = MODE === '1';
+var KR = /^KR/.test(TERR || ''), TLS_OK = RCS.indexOf(' ftp_ssl ') >= 0;
+var MAX0 = parseInt(NV.st_max_user, 10) || 5;
+var LANGS = ['EN', 'TW', 'CN', 'RU', 'CZ'];
+
+/* the stock FTP port-conflict check (js/httpApi.js): a port-forward rule sends WAN port 21 to another host */
+function conflict(){
+  if (!(SW_MODE === '1' || SW_MODE === '5') || VTS_EN === '0') return false;
+  return String(VTS || '').split('<').some(function(r){
+    if (!r) return false;
+    var f = r.split('>'), ext = String(f[1] || ''), ip = String(f[2] || '');
+    if (ip === LAN_IP) return false;
+    return ext.split(',').some(function(p){ var ab = p.split(':');
+      return ab.length > 1 ? (parseInt(ab[0], 10) <= 21 && parseInt(ab[1], 10) >= 21) : parseInt(p, 10) === 21; });
+  });
+}
+function cur(){
+  var c = {enable_ftp: rp.chk('t_en'), ftp_wanac: rp.chk('t_wan'), st_max_user: q('i_max').value.trim(), ftp_lang: q('s_lang').value};
+  if (TLS_OK) c.ftp_tls = rp.chk('t_tls');
+  return c;
+}
+function base(){ var b = {enable_ftp: NV.enable_ftp === '1' ? '1' : '0', ftp_wanac: NV.ftp_wanac === '1' ? '1' : '0', st_max_user: NV.st_max_user,
