+}
+function post(obj, cb){
+  var x = new XMLHttpRequest(), a = [], k;
+  for (k in obj) a.push(encodeURIComponent(k) + '=' + encodeURIComponent(obj[k]));
+  x.open('POST', '/applyapp.cgi', true); x.setRequestHeader('Content-Type', 'application/x-www-form-urlencoded'); x.timeout = 150000;
+  x.onloadend = function(){ if (cb) cb(); };
+  x.send(a.join('&'));
+}
+function apply(){
+  rp.msg('');
+  var c = cur(), ch = changes();
+  if (c.dms_dir_manual === '1' && (c.dms_dir_x.length > MAXLEN || c.dms_dir_type_x.length > MAXLEN)){ rp.msg(`<#RUSB_31#>`); return; }
+  if (!rp.count(ch)){ rp.msg(`<#RADM_63#>`); return; }
+  ch.action_mode = 'apply'; ch.rc_service = 'restart_media';
+  rp.applying(`<#Reaper_c_applying#>`, `<#RUSB_30#>`);
+  post(ch, function(){ setTimeout(function(){ location.reload(); }, 6000); });
+}
+
+['t_daapd', 't_dms', 't_rebuild', 't_web'].forEach(function(id){ rp.on(id, 'change', dirty); });
+['i_dname', 'i_mname'].forEach(function(id){ rp.on(id, 'input', dirty); });
+rp.on('s_manual', 'change', dirty);
+rp.on('s_part', 'change', folders);
+rp.on('b_add', 'click', addRow);
+rp.on('b_new', 'click', function(){ rp.show('newbox', true); q('i_new').focus(); });
+rp.on('b_mkx', 'click', function(){ rp.show('newbox', false); });
+rp.on('b_mk', 'click', newFolder);
+rp.on('i_new', 'keydown', function(e){ if (e.key === 'Enter') newFolder(); if (e.key === 'Escape') rp.show('newbox', false); });
+q('tb').addEventListener('click', function(e){ var t = e.target; if (t && t.classList && t.classList.contains('bwldel')){ LIST.splice(+t.getAttribute('data-i'), 1); drawList(); } });
+rp.on('applybtn', 'click', apply);
+rp.on('discardbtn', 'click', function(){ rp.msg(''); rp.note('lmsg', ''); fill(); });
+document.addEventListener('visibilitychange', pollStatus);
+fill(); pollStatus(); stTimer = setInterval(pollStatus, 5000);
+})();
+</script>
+</body>
+</html>
diff --git a/release/src/router/www/Reaper_Samba.asp b/release/src/router/www/Reaper_Samba.asp
new file mode 100644
index 00000000000..724e8084f36
--- /dev/null
+++ b/release/src/router/www/Reaper_Samba.asp
@@ -0,0 +1,188 @@
+<!-- SPDX-License-Identifier: GPL-2.0-only
+     Copyright (C) 2026 the Reaper project maintainer
+     Part of the Reaper hardened Asuswrt-Merlin build. See LICENSE / LICENSE.reaper. -->
+<!DOCTYPE html>
+<html lang="en">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width, initial-scale=1">
+<meta name="reaper-native" content="1">
+<title>REAPER &mdash; Samba</title>
+<!-- Reaper_Samba.asp - USB Application > Network Place (Samba) Share (Reaper-native UI, USB wave, 2026-11-03).
+     Replaces Advanced_AiDisk_samba.asp (still shipped until the owner has reviewed this page); same nvram, same
+     handlers. Settings: enable_samba, computer_name, st_samba_workgroup, smbd_protocol (1 SMB2 / 2 SMB2+SMB3 /
+     3 SMB3 encrypted), smbd_simpler_naming, smbd_master, smbd_wins, st_max_user (also FTP max_clients and the
+     account cap, as stock) -> /applyapp.cgi rc_service restart_ftpsamba;restart_dnsmasq (stock Apply). Guest login
+     (st_samba_mode 1 guest / 4 accounts, force mode synced by rc) -> /aidisk/switch_share_mode.asp, the stock
+     switch, posted first when it changed. Accounts, rights and folders: rp.share.js over the stock /aidisk
+     handlers (accounts are shared with FTP). Differences from stock, on purpose: the on/off switch saves with
+     the other settings (stock applied it at once); a folder delete says it deletes the files too and asks for
+     DELETE typed (stock said "ensure that it is empty" and deleted everything); the per-folder loop bugs and the
+     raw-name emitter (get_sharedfolder_in_pool) are not carried. -->
+<link rel="stylesheet" href="/reaper/rp.css">
+<style>
+.msg{font-size:12.5px;color:var(--amber);display:none}
+.msg.show{display:block}
+.off{display:none!important}
+.frow input.nb{text-transform:uppercase;max-width:220px}
+.frow input.num2{max-width:90px}
+</style>
+</head>
+<body>
+<script src="/reaper_util.js"></script>
+<script src="/reaper/rp.js"></script>
+<script src="/reaper/rp.share.js"></script>
+<script src="/disk_msg.js"></script>
+<script>
+/* the stock emitters, run inside one function so their declarations stay off window */
+rp.usbData = (function(){
+/* @usbdata */
+<% available_disk_names_and_sizes(); %>
+<% disk_pool_mapping_info(); %>
+<% get_permissions_of_account(); %>
+var acc = []; try { acc = [<% get_all_accounts(); %>][0] || []; } catch (e) {}
+return {
+  disks: typeof foreign_disks === 'function' ? foreign_disks : null,
+  parts: typeof foreign_disk_pool_number === 'function' ? foreign_disk_pool_number : null,
+  names: typeof pool_names === 'function' ? pool_names : null,
+  devs: typeof pool_devices === 'function' ? pool_devices : null,
+  status: typeof pool_status === 'function' ? pool_status : null,
+  perm: typeof get_account_permissions_in_pool === 'function' ? get_account_permissions_in_pool : null,
+  accounts: acc
+};
+})();
+</script>
+
+<div class="syswrap">
+<div class="pagehead">
+  <div>
+    <div class="eyebrow"><#Menu_usb_application#></div>
+    <h1><#menu5_4_1#></h1>
+  </div>
+  <div class="spacer"></div>
+  <span class="pill warn chgpill" id="chgpill"><span class="dot"></span><span><#RADM_77#>: <b id="chgcount">0</b></span></span>
+  <button type="button" class="btn ghost" id="discardbtn" disabled><#Discard#></button>
+  <button type="button" class="btn primary" id="applybtn"><#CTL_apply#></button>
+</div>
+<div class="msg" id="topmsg" style="margin:-6px 0 12px"></div>
+<div class="hint" style="margin:-4px 0 14px"><#Samba_desc#></div>
+
+<div class="rframe">
+<div class="panel">
+  <h2><#Settings#></h2>
+  <div class="togglerow"><label class="tswitch"><input type="checkbox" id="t_en"><span class="track"></span></label><div><#enableCIFS#></div></div>
+  <div class="togglerow" id="row_guest"><label class="tswitch"><input type="checkbox" id="t_guest"><span class="track"></span></label><div><#AiDisk_Guest_Login#><div class="sub" id="guest_hint"></div></div></div>
+  <div class="frow"><div class="fl"><#ShareNode_DeviceName_itemname#></div><div class="fc"><input type="text" class="nb" id="i_cn" maxlength="15" autocomplete="off"></div></div>
+  <div class="frow"><div class="fl"><#ShareNode_WorkGroup_itemname#></div><div class="fc"><input type="text" class="nb" id="i_wg" maxlength="15" autocomplete="off"></div></div>
+  <div class="frow"><div class="fl"><#RUSB_1#></div><div class="fc"><select id="s_proto">
+    <option value="1"><#RUSB_2#></option><option value="2"><#RUSB_3#></option><option value="3"><#RUSB_4#></option></select></div></div>
+  <div class="frow"><div class="fl"><#ShareNode_MaximumLoginUser_itemname#></div><div class="fc"><input type="text" class="num2" id="i_max" maxlength="2" inputmode="numeric" autocomplete="off"></div></div>
+  <div class="togglerow"><label class="tswitch"><input type="checkbox" id="t_simple"><span class="track"></span></label><div><#RUSB_5#></div></div>
+  <div class="togglerow"><label class="tswitch"><input type="checkbox" id="t_master"><span class="track"></span></label><div><#RUSB_6#></div></div>
+  <div class="togglerow"><label class="tswitch"><input type="checkbox" id="t_wins"><span class="track"></span></label><div><#RUSB_7#></div></div>
+  <div class="msg" id="setmsg" style="margin-top:8px"></div>
+</div>
+<div id="share"></div>
+</div>
+</div>
+
+<div class="applying" id="applying"><div class="abox"><h2 id="ap_t"><#Reaper_c_applying#></h2><p id="ap_p"><#RUSB_20#></p></div></div>
+
+<script>
+(function(){
+'use strict';
+var q = rp.q;
+var NV = {
+  enable_samba: <% nvram_get_js("enable_samba"); %>, st_samba_mode: <% nvram_get_js("st_samba_mode"); %>, st_samba_force_mode: <% nvram_get_js("st_samba_force_mode"); %>,
+  computer_name: <% nvram_get_js("computer_name"); %>, st_samba_workgroup: <% nvram_get_js("st_samba_workgroup"); %>,
+  smbd_protocol: <% nvram_get_js("smbd_protocol"); %>, smbd_simpler_naming: <% nvram_get_js("smbd_simpler_naming"); %>,
+  smbd_master: <% nvram_get_js("smbd_master"); %>, smbd_wins: <% nvram_get_js("smbd_wins"); %>, st_max_user: <% nvram_get_js("st_max_user"); %>
+};
+var LAN_HOST = <% nvram_get_js("lan_hostname"); %>, LAN_DOMAIN = <% nvram_get_js("lan_domain"); %>, TERR = <% nvram_get_js("territory_code"); %>;
+/* web.c get_share_management_status: mode 1 with no force mode reads as accounts (4) */
+var MODE = (NV.st_samba_force_mode === '' && NV.st_samba_mode === '1') ? '4' : NV.st_samba_mode;
+var GUEST0 = (MODE === '1' || MODE === '3');
+var KR = /^KR/.test(TERR || '');
+var PROTO0 = /^[123]$/.test(NV.smbd_protocol) ? NV.smbd_protocol : '2';   /* write_smb_conf: anything else = 2 */
+var MAX0 = parseInt(NV.st_max_user, 10) || 5;
+
+function cur(){
+  return {
+    enable_samba: rp.chk('t_en'), computer_name: q('i_cn').value.trim().toUpperCase(), st_samba_workgroup: q('i_wg').value.trim().toUpperCase(),
+    smbd_protocol: q('s_proto').value, smbd_simpler_naming: rp.chk('t_simple'), smbd_master: rp.chk('t_master'), smbd_wins: rp.chk('t_wins'),
+    st_max_user: q('i_max').value.trim()
+  };
+}
+function base(){ var b = {}; for (var k in NV) b[k] = NV[k]; b.smbd_protocol = PROTO0; b.computer_name = NV.computer_name.toUpperCase(); b.st_samba_workgroup = NV.st_samba_workgroup.toUpperCase(); return b; }
+function changes(){ var c = cur(), ch = rp.diff(c, base()); delete ch.st_samba_mode; return ch; }
+function guestChanged(){ return KR ? false : (q('t_guest').checked !== GUEST0); }
+function dirty(){ rp.pill(rp.count(changes()) + (guestChanged() ? 1 : 0)); q('guest_hint').textContent = q('t_guest').checked ? `<#AiDisk_SAMBA_hint_1#>` : `<#AiDisk_SAMBA_hint_2#>`; }
+
+function fill(){
+  rp.setChk('t_en', NV.enable_samba === '1'); rp.setChk('t_guest', GUEST0);
+  q('i_cn').value = NV.computer_name; q('i_cn').placeholder = String(LAN_HOST || '').toUpperCase();
+  q('i_wg').value = NV.st_samba_workgroup; q('i_wg').placeholder = String(LAN_DOMAIN || '').split('.')[0].toUpperCase();
+  q('s_proto').value = PROTO0; q('i_max').value = NV.st_max_user || '5';
+  rp.setChk('t_simple', NV.smbd_simpler_naming === '1'); rp.setChk('t_master', NV.smbd_master === '1'); rp.setChk('t_wins', NV.smbd_wins === '1');
+  rp.show('row_guest', !KR);
+  rp.enhanceSelects(); rp.syncSelect(q('s_proto'));
+  dirty();
+}
+function validate(c){
+  if (c.computer_name && !/^[a-z0-9][a-z0-9-]*$/i.test(c.computer_name)) return [`<#JS_valid_host_name_1#>` + ' ' + `<#JS_valid_host_name_first_char_1#>`, 'i_cn'];
+  if (!c.st_samba_workgroup && !LAN_DOMAIN) return [`<#JS_fieldblank#>`, 'i_wg'];
+  if (c.st_samba_workgroup && !/^[a-z0-9][a-z0-9_-]*$/i.test(c.st_samba_workgroup)) return [`<#JS_valid_host_name#>` + ' ' + `<#JS_valid_host_name_first_char#>`, 'i_wg'];
+  if (!rp.v.int(c.st_max_user, 1, 99)) return [`<#ShareNode_MaximumLoginUser_itemname#>` + ': 1 - 99', 'i_max'];
+  return null;
+}
+function post(obj, cb){
+  var x = new XMLHttpRequest(), a = [], k;
+  for (k in obj) a.push(encodeURIComponent(k) + '=' + encodeURIComponent(obj[k]));
+  x.open('POST', '/applyapp.cgi', true); x.setRequestHeader('Content-Type', 'application/x-www-form-urlencoded'); x.timeout = 150000;
+  x.onloadend = function(){ if (cb) cb(); };
+  x.send(a.join('&'));
+}
+function done(){ setTimeout(function(){ location.reload(); }, 9000); }
+function fail(err){ q('applying').className = 'applying'; rp.msg(String(err || '')); }
+
+function apply(){
+  rp.msg(''); rp.note('setmsg', '');
+  var c = cur(), bad = validate(c);
+  if (bad){ rp.note('setmsg', bad[0]); var e = q(bad[1]); if (e) e.focus(); return; }
+  var ch = changes(), g = guestChanged();
+  if (!rp.count(ch) && !g){ rp.msg(`<#RADM_63#>`); return; }
+  function go(){
+    rp.applying(`<#Reaper_c_applying#>`, `<#RUSB_20#>`);
+    function rest(){
+      if (!rp.count(ch)) return done();
+      ch.action_mode = 'apply'; ch.rc_service = 'restart_ftpsamba;restart_dnsmasq';
+      post(ch, done);
+    }
+    if (!g) return rest();
+    rp.share.post('switch_share_mode.asp', {protocol: 'cifs', mode: q('t_guest').checked ? 'share' : 'account'}, function(err){ if (err) return fail(err); rest(); });
+  }
+  var msgs = [];
+  if (ch.enable_samba !== undefined) msgs.push(ch.enable_samba === '1' ? `<#confirm_enablecifs#>` : `<#confirm_disablecifs#>`);
+  if (g && q('t_guest').checked) msgs.push(`<#AiDisk_SAMBA_hint_3#>`);
+  if (!msgs.length) return go();
+  window.reaperConfirm(msgs.join('\n\n'), {okLabel: `<#CTL_apply#>`, cancelLabel: `<#CTL_Cancel#>`, danger: g && q('t_guest').checked}, function(ok){ if (ok) go(); });
+}
+
+['t_en', 't_guest', 't_simple', 't_master', 't_wins'].forEach(function(id){ rp.on(id, 'change', dirty); });
+['i_cn', 'i_wg', 'i_max'].forEach(function(id){ rp.on(id, 'input', dirty); });
+rp.on('s_proto', 'change', dirty);
+rp.on('applybtn', 'click', apply);
+rp.on('discardbtn', 'click', function(){ rp.msg(''); rp.note('setmsg', ''); fill(); });
+
+rp.share.manager({
+  root: q('share'), model: rp.share.model(rp.usbData), proto: 'cifs', guest: GUEST0, maxUsers: MAX0,
+  levels: [[3, `<#RUSB_8#>`], [1, `<#RUSB_9#>`], [0, `<#checkbox_No#>`]],
+  onBusy: function(t){ rp.applying(`<#Reaper_c_applying#>`, `<#RUSB_20#>`); },
+  onDone: done, onFail: fail, onMsg: function(t){ rp.msg(t); },
+  L: rp.share.labels('cifs')
+});
+fill();
+})();
+</script>
+</body>
+</html>
diff --git a/release/src/router/www/Reaper_USBApps.asp b/release/src/router/www/Reaper_USBApps.asp
new file mode 100644
index 00000000000..16b65ca7cc7
--- /dev/null
+++ b/release/src/router/www/Reaper_USBApps.asp
@@ -0,0 +1,110 @@
+<!-- SPDX-License-Identifier: GPL-2.0-only
+     Copyright (C) 2026 the Reaper project maintainer
+     Part of the Reaper hardened Asuswrt-Merlin build. See LICENSE / LICENSE.reaper. -->
+<!DOCTYPE html>
+<html lang="en">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width, initial-scale=1">
+<meta name="reaper-native" content="1">
+<title>REAPER &mdash; USB Application</title>
+<!-- Reaper_USBApps.asp - USB Application (Reaper-native UI, USB wave, 2026-11-03).
+     Replaces APP_Installation.asp (still shipped until the owner has reviewed this page). On this firmware the
+     stock page only ever rendered a fixed list of links (the optware installer it also carried is not part of
+     the firmware: rc refuses its scripts), so this page is that list with each service's state, plus the disks
+     the services can use. Rows follow the stock gates: printer (printer and not noprinter), 3G/4G (router mode,
+     modem and not nomodem; its page is Internet Connection - Advanced_Modem_Content.asp is bounced there),
+     Time Machine (timemachine). Printer Server and Time Machine open their stock pages. Not carried: the LAN-MAC
+     cookie and the apps_state_action write the stock page made on every view, the ASUS 3G/4G support link. -->
+<link rel="stylesheet" href="/reaper/rp.css">
+<style>
+.apps{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:12px}
+.app{display:block;text-decoration:none;border:1px solid var(--line);border-radius:8px;padding:14px 16px;background:var(--panel,transparent);color:var(--bone-dim)}
+.app:hover{border-color:var(--crimson)}
+.app .t{display:flex;align-items:center;gap:8px;color:var(--bone);font-weight:600;font-size:14px;margin-bottom:6px}
+.app .t .spacer{flex:1}
+.app .d{font-size:12.5px;line-height:1.5}
+.rtab td{padding:7px 10px;border-bottom:1px solid var(--line-soft);color:var(--bone-dim)}
+.rtab td.num{text-align:right;font-family:var(--mono)}
+</style>
+</head>
+<body>
+<script src="/reaper_util.js"></script>
+<script src="/reaper/rp.js"></script>
+<script src="/reaper/rp.share.js"></script>
+<script>
+rp.usbData = (function(){
+/* @usbdata */
+<% available_disk_names_and_sizes(); %>
+<% disk_pool_mapping_info(); %>
+return {
+  disks: typeof foreign_disks === 'function' ? foreign_disks : null,
+  parts: typeof foreign_disk_pool_number === 'function' ? foreign_disk_pool_number : null,
+  names: typeof pool_names === 'function' ? pool_names : null,
+  devs: typeof pool_devices === 'function' ? pool_devices : null,
+  status: typeof pool_status === 'function' ? pool_status : null,
+  kb: typeof pool_kilobytes === 'function' ? pool_kilobytes : null,
+  used: typeof pool_kilobytes_in_use === 'function' ? pool_kilobytes_in_use : null,
+  perm: null, accounts: []
+};
+})();
+</script>
+
+<div class="syswrap">
+<div class="pagehead">
+  <div>
+    <div class="eyebrow"><#Menu_usb_application#></div>
+    <h1><#Menu_usb_application#></h1>
+  </div>
+</div>
+<div class="rframe">
+<div class="panel"><div class="apps" id="apps"></div></div>
+<div class="panel">
+  <h2><#RDST_43#></h2>
+  <table class="rtab"><thead><tr><th><#PoolName#></th><th></th><th class="num"><#Availablespace#></th><th class="num"><#Totalspace#></th></tr></thead><tbody id="disks"></tbody></table>
+  <div class="sub" style="margin-top:8px"><#RUSB_33#></div>
+</div>
+</div>
+</div>
+
+<script>
+(function(){
+'use strict';
+var q = rp.q, hx = rp.esc;
+var RCS = ' ' + <% nvram_get_js("rc_support"); %> + ' ', SW_MODE = <% nvram_get_js("sw_mode"); %>;
+var ON = {samba: <% nvram_get_js("enable_samba"); %>, ftp: <% nvram_get_js("enable_ftp"); %>, dms: <% nvram_get_js("dms_enable"); %>,
+          daapd: <% nvram_get_js("daapd_enable"); %>, tm: <% nvram_get_js("timemachine_enable"); %>, prn: <% nvram_get_js("usb_printer"); %>};
+function sup(f){ return RCS.indexOf(' ' + f + ' ') >= 0; }
+function pill(on){ return on === null ? '' : '<span class="tag' + (on ? ' good' : '') + '">' + hx(on ? `<#CTL_Enabled#>` : `<#CTL_Disabled#>`) + '</span>'; }
+
+var APPS = [
+  {page: 'Reaper_Samba.asp', title: `<#menu5_4_1#>`, desc: `<#Samba_desc#>`, on: ON.samba === '1'},
+  {page: 'Reaper_FTP.asp', title: `<#menu5_4_2#>`, desc: `<#FTP_desc#>`, on: ON.ftp === '1', when: !sup('noftp')},
+  {page: 'Reaper_MediaServer.asp', title: `<#UPnPMediaServer#>`, desc: `<#upnp_Desc#>`, on: ON.dms === '1' || ON.daapd === '1', when: sup('media') && !sup('nomedia')},
+  {page: 'PrinterServer.asp', title: `<#Network_Printer_Server#>`, desc: `<#Network_Printer_desc#>`, on: null, when: sup('printer') && !sup('noprinter')},
+  {page: 'Advanced_TimeMachine.asp', title: `<#TimeMach#>`, desc: `<#TimeMach_enable_hint#>`, on: ON.tm === '1', when: sup('timemachine')},
+  {page: 'Reaper_Internet.asp', title: '3G/4G', desc: `<#HSDPAConfig_hsdpa_enable_hint1#>`, on: null, when: SW_MODE === '1' && sup('modem') && !sup('nomodem')},
+  {page: 'Reaper_USB.asp', title: `<#RDST_43#>`, desc: `<#RUSB_32#>`, on: null}
+];
+q('apps').innerHTML = APPS.filter(function(a){ return a.when !== false; }).map(function(a){
+  return '<a class="app" href="/reaper_shell.asp#' + hx(a.page) + '" target="_top"><div class="t"><span>' + hx(a.title) + '</span><span class="spacer"></span>' + pill(a.on) + '</div>' +
+         '<div class="d">' + hx(a.desc) + '</div></a>';
+}).join('');
+
+var M = rp.share.model(rp.usbData), d = rp.usbData, kb = [], used = [];
+try { kb = d.kb ? d.kb() : []; used = d.used ? d.used() : []; } catch (e) {}
+function gb(k){ var n = parseFloat(k); return isFinite(n) ? (n / 1048576).toFixed(n >= 104857600 ? 0 : 1) + ' GB' : '-'; }
+var h = '', idx = 0;
+M.disks.forEach(function(dk){
+  h += '<tr><td colspan="4" style="color:var(--bone);font-weight:600">' + hx(dk.name) + '</td></tr>';
+  dk.parts.forEach(function(p){
+    var i = M.parts.indexOf(p), free = (parseFloat(kb[i]) || 0) - (parseFloat(used[i]) || 0);
+    h += '<tr><td style="padding-left:20px">' + hx(p.label) + '</td><td>' + (p.rw ? '' : '<span class="tag warn">' + hx(`<#RUSB_24#>`) + '</span>') + '</td>' +
+         '<td class="num">' + hx(kb[i] !== undefined ? gb(free) : '-') + '</td><td class="num">' + hx(gb(kb[i])) + '</td></tr>';
+  });
+});
+q('disks').innerHTML = h || '<tr><td colspan="4" class="empty">' + hx(`<#no_usb_found#>`) + '</td></tr>';
+})();
+</script>
+</body>
+</html>
diff --git a/release/src/router/www/SL.dict b/release/src/router/www/SL.dict
index ee537274976..df4ae34dfa9 100644
--- a/release/src/router/www/SL.dict
+++ b/release/src/router/www/SL.dict
