+  root: q('share'), model: rp.share.model(rp.usbData), proto: 'ftp', guest: ANON0, maxUsers: MAX0,
+  levels: [[3, `<#RUSB_8#>`], [2, `<#RUSB_10#>`], [1, `<#RUSB_9#>`], [0, `<#checkbox_No#>`]],
+  onBusy: function(){ rp.applying(`<#Reaper_c_applying#>`, `<#RUSB_20#>`); },
+  onDone: done, onFail: fail, onMsg: function(t){ rp.msg(t); }
+});
+sftpNote();
+fill();
+})();
+</script>
+</body>
+</html>
