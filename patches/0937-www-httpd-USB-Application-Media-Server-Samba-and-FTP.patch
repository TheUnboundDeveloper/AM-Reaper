+    if (!an) return rest();
+    var tlsFirst = q('t_anon').checked && ch.ftp_tls === '0';
+    function sw(){ rp.share.post('switch_share_mode.asp', {protocol: 'ftp', mode: q('t_anon').checked ? 'share' : 'account'}, function(err){ if (err) return fail(err); rest(); }); }
