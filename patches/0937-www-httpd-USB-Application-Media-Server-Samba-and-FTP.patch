+  else go();
+}
+
+/* scan state: dms_info answers ["Scanning"] while minidlna's scantag exists, else [""] */
+var stTimer = null;
+function pollStatus(){
+  if (document.hidden || !q('t_dms').checked || NV.dms_enable !== '1'){ q('dms_st').textContent = NV.dms_enable === '1' ? q('dms_st').textContent : '-'; return; }
+  var x = new XMLHttpRequest();
