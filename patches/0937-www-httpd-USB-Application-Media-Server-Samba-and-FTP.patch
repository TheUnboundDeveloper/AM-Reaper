+  rp.pill(rp.count(changes()) + (anonChanged() ? 1 : 0));
+  q('anon_hint').textContent = q('t_anon').checked ? `<#Aidisk_FTP_hint_1#>` : `<#Aidisk_FTP_hint_2#>`;
+  q('tls_hint').textContent = q('t_tls').checked ? '' : `<#usb_tls_disabled_hint#>`;
+  q('conflict').textContent = (q('t_en').checked && conflict()) ? `<#IPConnection_VServer_usb_port_conflict#>` + ' ' + `<#IPConnection_VServer_change_lan_port#>` : '';
+}
+function fill(){
+  var b = base();
+  rp.setChk('t_en', b.enable_ftp === '1'); rp.setChk('t_wan', b.ftp_wanac === '1'); rp.setChk('t_anon', ANON0); rp.setChk('t_tls', NV.ftp_tls === '1');
+  q('i_max').value = NV.st_max_user || '5'; q('s_lang').value = b.ftp_lang;
+  rp.show('row_anon', !KR); rp.show('row_tls', TLS_OK);
+  rp.enhanceSelects(); rp.syncSelect(q('s_lang'));
+  dirty();
+}
+function sftpNote(){
+  var n = q('sftpnote'), a = document.createElement('a');
+  n.textContent = `<#RUSB_28#>` + ' ';
+  a.href = '/reaper_shell.asp#Reaper_System.asp'; a.target = '_top'; a.textContent = `<#menu5_6#>` + ' - SSH';
+  n.appendChild(a);
+}
+function post(obj, cb){
+  var x = new XMLHttpRequest(), a = [], k;
+  for (k in obj) a.push(encodeURIComponent(k) + '=' + encodeURIComponent(obj[k]));
+  x.open('POST', '/applyapp.cgi', true); x.setRequestHeader('Content-Type', 'application/x-www-form-urlencoded'); x.timeout = 150000;
+  x.onloadend = function(){ if (cb) cb(); };
