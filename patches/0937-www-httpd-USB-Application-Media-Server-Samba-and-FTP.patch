+  rp.setChk('t_daapd', b.daapd_enable === '1'); q('i_dname').value = NV.daapd_friendly_name; q('i_dname').placeholder = LAN_HOST;
+  rp.setChk('t_dms', b.dms_enable === '1'); q('i_mname').value = NV.dms_friendly_name; q('i_mname').placeholder = LAN_HOST;
+  rp.setChk('t_rebuild', b.dms_rebuild === '1'); rp.setChk('t_web', b.dms_web === '1');
