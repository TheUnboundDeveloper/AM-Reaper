         T('Reaper_USBApps.asp', `<#Menu_usb_application#>`),
         T('Reaper_MediaServer.asp', `<#UPnPMediaServer#>`, sup('media') && !sup('nomedia')),
         T('Reaper_Samba.asp', `<#menu5_4_1#>`), T('Advanced_AiDisk_NFS.asp', `<#Reaper_c_nfs_exports#>`, sup('nfsd')),
         T('Reaper_FTP.asp', `<#menu5_4_2#>`, !sup('noftp')),
         T('PrinterServer.asp', INH), T('Advanced_TimeMachine.asp', INH),
         T('fileflex.asp', INH, sup('fileflex')),
-        T('APP_Installation.asp', INH), T('mediaserver.asp', INH, sup('media') && !sup('nomedia')),
-        T('Advanced_AiDisk_samba.asp', INH), T('Advanced_AiDisk_ftp.asp', INH, !sup('noftp')),
         T('Reaper_USB.asp', `<#RDST_43#>`)]},
       {index: 'menu_ReaperDevices', label: `<#RDEV_00#>`, tabs: [T('Reaper_Devices.asp', `<#RDEV_00#>`)]},
