From d26894163b93b202ace3e84181b701249505260d Mon Sep 17 00:00:00 2001
From: reaper <theunbounddeveloper@outlook.com>
Date: Tue, 3 Nov 2026 19:21:44 -0500
Subject: [PATCH] www, httpd: the stock USB Application pages no longer ship
 (102.8 line)

After the check on hardware, the four stock pages the USB kit pages replace leave the image:
APP_Installation.asp, mediaserver.asp, Advanced_AiDisk_samba.asp and Advanced_AiDisk_ftp.asp
(www/Makefile). A reaper_pagemap[] row each (shipped 0) bounces an old URL - a bookmark, or a link
from another stock page - to its kit page; the menu loses their inherit tabs; the kit pages'
header comments say so.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 release/src/router/httpd/reaper_inject.c      | 5 +++++
 release/src/router/www/Makefile               | 6 ++++++
 release/src/router/www/Reaper_FTP.asp         | 2 +-
 release/src/router/www/Reaper_MediaServer.asp | 2 +-
 release/src/router/www/Reaper_Samba.asp       | 2 +-
 release/src/router/www/Reaper_USBApps.asp     | 2 +-
 release/src/router/www/reaper/menu.js         | 6 ++----
 7 files changed, 17 insertions(+), 8 deletions(-)

diff --git a/release/src/router/httpd/reaper_inject.c b/release/src/router/httpd/reaper_inject.c
index ea847fa5878..28c94bb5623 100644
--- a/release/src/router/httpd/reaper_inject.c
+++ b/release/src/router/httpd/reaper_inject.c
@@ -352,6 +352,11 @@ static const struct reaper_page_row { const char *name, *to; int shipped; } reap
 	{ "mlo.asp", "Reaper_MLO.asp", 0 },
 	{ "advanced_vlan_switch_content.asp", "Reaper_VLAN.asp", 0 },
 	{ "advanced_vlan_profile_content.asp", "Reaper_VLAN.asp?tab=pf", 0 },
+	/* 2026-11-03 (owner, after the metal check): the stock USB Application pages the kit pages replace */
+	{ "app_installation.asp", "Reaper_USBApps.asp", 0 },
+	{ "mediaserver.asp", "Reaper_MediaServer.asp", 0 },
+	{ "advanced_aidisk_samba.asp", "Reaper_Samba.asp", 0 },
+	{ "advanced_aidisk_ftp.asp", "Reaper_FTP.asp", 0 },
 	{ "advanced_switchctrl_content.asp", "Reaper_LAN.asp?tab=switch", 1 },
 	{ "advanced_wireless_content.asp", "Reaper_WiFiSettings.asp", 1 },
 	{ "advanced_wadvanced_content.asp", "Reaper_WiFiSettings.asp", 1 },
diff --git a/release/src/router/www/Makefile b/release/src/router/www/Makefile
index b6ae54ad9e5..be9029d31a2 100644
--- a/release/src/router/www/Makefile
+++ b/release/src/router/www/Makefile
@@ -1315,6 +1315,12 @@ endif
 	rm -f $(INSTALLDIR)/www/MLO.asp
 	rm -f $(INSTALLDIR)/www/Advanced_VLAN_Switch_Content.asp
 	rm -f $(INSTALLDIR)/www/Advanced_VLAN_Profile_Content.asp
+# reaper 2026-11-03 (owner, after the metal check): the USB Application tabs are Reaper kit pages; the stock
+# pages no longer ship and httpd bounces each old URL (reaper_pagemap[]).
+	rm -f $(INSTALLDIR)/www/APP_Installation.asp
+	rm -f $(INSTALLDIR)/www/mediaserver.asp
+	rm -f $(INSTALLDIR)/www/Advanced_AiDisk_samba.asp
+	rm -f $(INSTALLDIR)/www/Advanced_AiDisk_ftp.asp
 # reaper 2026-11-01 (owner): AiMesh and Network carry their own Reaper stylesheet, linked in each page; the stock
 # alternate themes those pages could switch to never load (theme forced empty), so they do not ship.
 	rm -f $(INSTALLDIR)/www/SDN/sdn_WHITE.css $(INSTALLDIR)/www/SDN/sdn_ROG.css $(INSTALLDIR)/www/SDN/sdn_TUF.css
diff --git a/release/src/router/www/Reaper_FTP.asp b/release/src/router/www/Reaper_FTP.asp
index 8e6698403ff..1a9c95d52ae 100644
--- a/release/src/router/www/Reaper_FTP.asp
+++ b/release/src/router/www/Reaper_FTP.asp
@@ -9,7 +9,7 @@
 <meta name="reaper-native" content="1">
 <title>REAPER &mdash; FTP</title>
 <!-- Reaper_FTP.asp - USB Application > FTP Share (Reaper-native UI, USB wave, 2026-11-03).
-     Replaces Advanced_AiDisk_ftp.asp (still shipped until the owner has reviewed this page); same nvram, same
+     Replaces Advanced_AiDisk_ftp.asp (no longer shipped; httpd bounces its URL here); same nvram, same
      handlers. Settings: enable_ftp, ftp_wanac (port 21 + ftp_pasvport..+30 on the WAN, firewall.c), ftp_tls (FTPS,
      only when rc_support has ftp_ssl), st_max_user (shared with Samba), ftp_lang -> /applyapp.cgi rc_service
      restart_ftpsamba (stock Apply), plus restart_firewall when the on/off or WAN switch changed (stock ran
diff --git a/release/src/router/www/Reaper_MediaServer.asp b/release/src/router/www/Reaper_MediaServer.asp
index cc71771a740..2785bb100a6 100644
--- a/release/src/router/www/Reaper_MediaServer.asp
