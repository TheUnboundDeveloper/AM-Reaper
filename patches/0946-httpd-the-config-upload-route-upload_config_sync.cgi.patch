From 213a00a2b52da22e78c5ae2d33e9677b65247c72 Mon Sep 17 00:00:00 2001
From: reaper <theunbounddeveloper@outlook.com>
Date: Tue, 3 Nov 2026 20:14:14 -0500
Subject: [PATCH] httpd: the config-upload route upload_config_sync.cgi is not
 served (CVE-2026-19386) (102.8 line)

ASUS's CVE-2026-19386 (a crafted config-file upload overflows a stack buffer in the closed
handler, admin session needed) is fixed in firmware newer than the closed objects this line builds
with. Nothing on this firmware posts the URL - no Reaper or stock page, no daemon, no AiMesh path
- so its route is compiled out.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 release/src/router/httpd/web.c | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/release/src/router/httpd/web.c b/release/src/router/httpd/web.c
index f138f77824f..640188cf575 100644
--- a/release/src/router/httpd/web.c
+++ b/release/src/router/httpd/web.c
@@ -40889,7 +40889,10 @@ struct mime_handler mime_handlers[] =
 #if 0	/* reaper (audit 2026-10-07 G1): pre-auth China-market CTA endpoint in the closed web_hook.o; no page uses it */
 	{ "get_cta_info.cgi*", "text/html", no_cache_IE7, do_html_post_and_get, do_get_cta_info_cgi, NULL },
 #endif
+#if 0	/* reaper (CVE-2026-19386): the 102.8 blobs' config-upload handler overflows a stack buffer on a crafted
+	 * file (closed code); nothing on this firmware posts it - the route is not served */
 	{ "upload_config_sync.cgi*", "text/html", no_cache_IE7, do_upload_config_sync_post, do_upload_config_sync_cgi, do_auth },
+#endif
 	{ "upload_blacklist_config.cgi*", "text/html", no_cache_IE7, do_html_post_and_get, do_upload_blacklist_config_cgi, do_auth },
 	{ "start_config_sync.cgi*", "text/html", no_cache_IE7, do_html_post_and_get, do_start_config_sync_cgi, do_auth },
 	{ "save_all_profile.cgi*", "application/octet-stream", no_cache_IE7, do_html_post_and_get, do_save_all_profile_cgi, do_auth },
-- 
2.25.1

