+				if (pmtl[k].sdn_t.cp_idx != 0 && strcmp(nm, lanif)) {
+					if (strlen(gkex) + strlen(nm) + 2 < sizeof(gkex)) { strcat(gkex, " "); strcat(gkex, nm); }
+					continue;
+				}
 				if (!strcmp(nm, lanif)) continue;      /* $LANIF already covers it */
 				/* dedup: pad BOTH sides of the accumulator so the trailing element
 				 * matches too - gkifs has no trailing space, so a bare strstr for
@@ -506,6 +518,8 @@ static void gk_gen_apply(void)
 	}
 
 	gk_gen_sink(gkifs);	/* 2026-10-20 (F-6): the sinkhole conf follows the same network set */
+	f_write_string(GK_DIR "/exempt", gkex, 0, 0600);	/* reaper 2026-11-10: for gkd (empty = none) */
+	if (gkex[0]) logmessage("gatekeeper", "Guest Portal network(s)%s: exempt, the portal sign-in is their gate", gkex);
 
 	f = fopen(GK_APPLY ".tmp", "w");
 	if (!f) return;
