diff --git a/release/src/router/gkd/gkd.c b/release/src/router/gkd/gkd.c
index 8de7dfceaca..a90478795aa 100644
--- a/release/src/router/gkd/gkd.c
+++ b/release/src/router/gkd/gkd.c
@@ -153,18 +153,47 @@ static int in_rl(const char *rl, const char *mac)
 	return 0;
 }
 
+/* reaper 2026-11-10 (owner): the bridges of Guest Portal networks, written by rc/gatekeeper.c as GK_DIR "/exempt"
+ * (space-separated). Their devices belong to the portal, not to Gatekeeper: they are not listed and not held, and
+ * such a bridge is not a missed hook. */
+static void gk_exempt_load(char *buf, size_t len)
+{
+	FILE *f = fopen(GK_DIR "/exempt", "r");
+
+	buf[0] = 0;
+	if (!f) return;
+	if (!fgets(buf, len, f)) buf[0] = 0;
+	fclose(f);
+}
+
+static int gk_exempt_has(const char *list, const char *ifn)
+{
+	size_t n = strlen(ifn);
+	const char *p = list;
+
+	if (!n) return 0;
+	while ((p = strstr(p, ifn)) != NULL) {
+		if ((p == list || p[-1] == ' ') && (p[n] == 0 || p[n] == ' ' || p[n] == '\n')) return 1;
+		p += n;
+	}
+	return 0;
+}
+
 static void scan_arp(long now)
 {
 	FILE *f = fopen("/proc/net/arp", "r");
 	char line[256], ip[64], hw[64], dev_if[32];
 	unsigned flags;
+	char ex[256];
 	if (!f) return;
+	gk_exempt_load(ex, sizeof(ex));
 	if (!fgets(line, sizeof(line), f)) { fclose(f); return; }   /* header */
 	while (fgets(line, sizeof(line), f)) {
 		if (sscanf(line, "%63s 0x%*x 0x%x %63s %*s %31s", ip, &flags, hw, dev_if) != 4)
 			continue;
 		if (!(flags & 2)) continue;                 /* incomplete */
 		if (strncmp(dev_if, "br", 2)) continue;     /* LAN bridge only */
+		if (gk_exempt_has(ex, dev_if)) continue;    /* not a Guest Portal network */
 		if (!valid_mac(hw)) continue;
 		{
 			dev_t_gk *d = touch_dev(hw, now);
@@ -178,8 +207,9 @@ static void scan_ndp(long now)
 {
 	/* IPv6-only devices never show in ARP; merge the v6 neighbour table. */
 	FILE *p = popen("ip -6 neigh show 2>/dev/null", "r");
-	char line[256];
+	char line[256], ex[256];
 	if (!p) return;
+	gk_exempt_load(ex, sizeof(ex));
 	while (fgets(line, sizeof(line), p)) {
 		char ip6[64] = "", mac[64] = "";
 		char *ll = strstr(line, "lladdr ");
@@ -188,6 +218,10 @@ static void scan_ndp(long now)
 		if (sscanf(ll + 7, "%63s", mac) != 1) continue;
 		if (strncasecmp(ip6, "fe80", 4) == 0) continue;   /* link-local noise */
 		if (!strstr(line, " br")) continue;
+		{	/* not a Guest Portal network */
+			char ifn[32] = "", *dv = strstr(line, " dev ");
+			if (dv && sscanf(dv + 5, "%31s", ifn) == 1 && gk_exempt_has(ex, ifn)) continue;
+		}
 		if (!valid_mac(mac)) continue;
 		{
 			dev_t_gk *d = touch_dev(mac, now);
@@ -536,7 +570,9 @@ static void heal_networks(void)
 	snprintf(nvbuf, sizeof(nvbuf), "GKCAP=%d; HTTPEN=%d; ", nvram_get_int("gk_captive"), nvram_get_int("http_enable"));
 	snprintf(cmd, sizeof(cmd), "%s%s", nvbuf,
 	          "IFS_=\"$(cat " GK_DIR "/ifs 2>/dev/null)\"; MISS=\"\"; "
+	          "EX_=\"$(cat " GK_DIR "/exempt 2>/dev/null)\"; "	/* reaper 2026-11-10: Guest Portal bridges are left unhooked on purpose */
 	          "for B in $(ls /sys/class/net 2>/dev/null | grep '^br'); do "
+	          "case \" $EX_ \" in *\" $B \"*) continue;; esac; "
 	          "ip -4 addr show dev $B 2>/dev/null | grep -q inet || continue; "
 	          "case \" $IFS_ \" in *\" $B \"*) ;; *) MISS=\"$MISS $B\";; esac; done; "
 	          "echo \"MISS=$MISS\"; "
diff --git a/release/src/router/lighttpd-1.4.39/src/nvram_control.c b/release/src/router/lighttpd-1.4.39/src/nvram_control.c
index 33585f62d56..88951063d8f 100755
--- a/release/src/router/lighttpd-1.4.39/src/nvram_control.c
+++ b/release/src/router/lighttpd-1.4.39/src/nvram_control.c
@@ -1756,14 +1756,33 @@ char *nvram_get_uamsecret(const char *str)
 #ifdef USE_TCAPI
 	// Todo
 #else
-	if (!strncmp(str, nvram_get("chilli_net"), 11))
-	{
-		return nvram_get("chilli_uamsecret");
-	}
+	/* review 2026-11-11: never NULL - callers use the result as a string, and an unset key used to reach
+	 * strncmp() here */
+	const char *reaper_net = nvram_get("chilli_net");
+	char *reaper_sec;
+
+	if (str && reaper_net && !strncmp(str, reaper_net, 11))
+		reaper_sec = nvram_get("chilli_uamsecret");
 	else
-	{
-		return nvram_get("cp_uamsecret");
+		reaper_sec = nvram_get("cp_uamsecret");
+#ifdef RTCONFIG_NVRAM_ENCRYPT
+	/* review 2026-11-11 (B-C4, owner): rc writes chilli's config with the secret DECRYPTED (rc/services.c
+	 * chilli_config*: pw_dec(value, buf, strlen(value), 1)) while this handed the portal module the stored,
+	 * encrypted form. Decrypt the same way, so both ends of the sign-in hold the same secret (rc now stores a
+	 * random per-router secret, reaper_uam_secret_ensure). A value that does not decrypt is passed as stored. */
+	if (reaper_sec && *reaper_sec) {
+		static char reaper_dec[128];
+		size_t reaper_l = strlen(reaper_sec);
+
+		if (reaper_l < sizeof(reaper_dec)) {
+			memset(reaper_dec, 0, sizeof(reaper_dec));
+			pw_dec(reaper_sec, reaper_dec, reaper_l, 1);
+			if (reaper_dec[0])
+				return reaper_dec;
+		}
 	}
+#endif
+	return reaper_sec ? reaper_sec : "";
 #endif
 }
 
diff --git a/release/src/router/lighttpd-1.4.39/src/response.c b/release/src/router/lighttpd-1.4.39/src/response.c
index a342f775968..f306b90f8e1 100755
--- a/release/src/router/lighttpd-1.4.39/src/response.c
+++ b/release/src/router/lighttpd-1.4.39/src/response.c
@@ -66,6 +66,17 @@ int http_response_write_header(server *srv, connection *con) {
 		response_header_overwrite(srv, con, CONST_STR_LEN("Transfer-Encoding"), CONST_STR_LEN("chunked"));
 	}
 
+	/* reaper (review 2026-11-11, B-C4): the closed captive-portal module answers "/Uam?...login=..." with text it
+		builds from the query, labelled text/html. The portal page reads that answer as plain text (uam.js asks with
+		dataType "text" and follows the address in it), so it is sent as plain text that no browser may treat as a
+		page: a link to it can no longer run script on the router's address. */
+	if (!buffer_is_empty(con->uri.query) && !buffer_is_empty(con->uri.path)
+	    && (0 == strncasecmp(con->uri.path->ptr, "/Uam", 4) || 0 == strncasecmp(con->uri.path->ptr, "/FreeUam", 8))
+	    && NULL != strstr(con->uri.query->ptr, "login=")) {
+		response_header_overwrite(srv, con, CONST_STR_LEN("Content-Type"), CONST_STR_LEN("text/plain; charset=utf-8"));
+		response_header_overwrite(srv, con, CONST_STR_LEN("X-Content-Type-Options"), CONST_STR_LEN("nosniff"));
+		response_header_overwrite(srv, con, CONST_STR_LEN("Content-Security-Policy"), CONST_STR_LEN("default-src 'none'; sandbox"));
+	}
 	response_header_overwrite(srv, con, CONST_STR_LEN("X-Frame-Options"), CONST_STR_LEN("SAMEORIGIN"));
 
 	/* add all headers */
