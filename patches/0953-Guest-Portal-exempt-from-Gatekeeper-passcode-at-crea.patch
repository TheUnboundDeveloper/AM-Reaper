@@ -487,6 +489,16 @@ static void gk_gen_apply(void)
 						break;
 				if (*q) continue;                      /* same gate as LANIF */
 				gk_add_net(gknets, sizeof(gknets), nm, &pmtl[k].nw_t);
+				/* reaper 2026-11-10 (owner): a Guest Portal network is exempt. It has its own gate - the portal
+				 * sign-in (chilli), which reads the bridge directly and hands a signed-in device's traffic to the
