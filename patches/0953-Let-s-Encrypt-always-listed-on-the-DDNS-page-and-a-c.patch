diff --git a/release/src/router/rc/reaper_ledns.c b/release/src/router/rc/reaper_ledns.c
new file mode 100644
index 00000000000..50ab850889b
--- /dev/null
+++ b/release/src/router/rc/reaper_ledns.c
@@ -0,0 +1,461 @@
+/* SPDX-License-Identifier: GPL-2.0-only
+ * Copyright (C) 2026 the Reaper project maintainer
+ * Part of the Reaper hardened Asuswrt-Merlin build. See LICENSE / LICENSE.reaper.
+ *
+ * rc/reaper_ledns.c - Let's Encrypt by DNS validation (2026-11-05, owner: "a certificate without DDNS").
+ *
+ * The closed libletsencrypt validates over HTTP (acme.sh --standalone on WAN port 80) for every provider but
+ * asuscomm, and it only starts after a successful DDNS update, so it needs DDNS, an open port 80 and inbound
+ * traffic from Let's Encrypt's validators in several countries. A certificate for the router's own services
+ * (the web interface, Encrypted DNS for the owner's iPhone) needs none of that: Let's Encrypt can check a
+ * temporary TXT record that the router writes through the DNS provider's API, and the name does not have to
+ * point at the router at all.
+ *
+ * reaper_ledns run (the page's Apply via restart_reaper_ledns, and a daily cron line) runs the stock acme.sh
+ * with the provider's own upstream script (dns_cf / dns_desec / dns_duckdns, installed beside dns_asusapi.sh)
+ * in its own home, /jffs/.le_dns (0700), and installs the result through the stock IMPORTED-certificate path:
+ * /jffs/.cert/cert.pem + key.pem, le_enable=2, prepare_cert_in_etc(), the same reload flags the DDNS renewal
+ * path arms. httpd, Encrypted DNS, the certificate panel and the backups then treat it like an uploaded one;
+ * the closed library is never involved. A run that finds the certificate not yet due (acme.sh exit 2) changes
+ * nothing. le_enable is set only once a certificate is on disk: prepare_cert_in_etc() falls back to self-signed
+ * AND deletes /jffs/.cert when le_enable=2 has no usable files.
+ *
+ * Secrets: the API token reaches acme.sh in the environment of this process only (never argv, never a log
+ * line); acme.sh keeps its own copy in /jffs/.le_dns/account.conf. Switching the feature off removes
+ * /jffs/.le_dns (account, token, keys). Warden: with "filter the router's own traffic" on, a blocked country
+ * can cover the provider API (deSEC is in Germany) or Let's Encrypt; for the length of a run the addresses of
+ * those two names are let through (rw_allow / rw_allow6) and removed again, unless they were already allowed.
+ *
+ * nvram: reaper_ledns_enable (switch, default 0), reaper_ledns_provider (cf | desec | duckdns),
+ *        reaper_ledns_domain, reaper_ledns_token; state for the page: reaper_ledns_state (run | ok | fail),
+ *        reaper_ledns_err (the last error line, sanitised), reaper_ledns_when (epoch of the last install).
+ */
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <ctype.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <time.h>
+#include <unistd.h>
+#include <netdb.h>
+#include <sys/file.h>
+#include <sys/socket.h>
+#include <sys/stat.h>
+#include <arpa/inet.h>
+
+#include "rc.h"
+#include <shared.h>
+
+#ifdef RTCONFIG_LETSENCRYPT
+
+#define LD_HOME		"/jffs/.le_dns"
+#define LD_OUT_CERT	LD_HOME "/fullchain.pem"
+#define LD_OUT_KEY	LD_HOME "/key.pem"
+#define LD_LOG		REAPER_TMPDIR "/ledns.log"
+#define LD_LOCK		REAPER_TMPDIR "/ledns.lock"
+#define LD_ACME		"/usr/sbin/acme.sh"
+#define LD_LE_API	"acme-v02.api.letsencrypt.org"
+#define LD_SLEEP	"90"		/* seconds between writing the TXT record and asking Let's Encrypt to look */
+#define LD_TIMEOUT	900		/* one acme.sh run, whole */
+#define LD_MAXIP	16
+
+static const struct ld_prov {
+	const char *id, *hook, *env, *api;
+} ld_provs[] = {
+	{ "cf",      "dns_cf",      "CF_Token",      "api.cloudflare.com" },
+	{ "desec",   "dns_desec",   "DEDYN_TOKEN",   "desec.io" },
+	{ "duckdns", "dns_duckdns", "DuckDNS_Token", "www.duckdns.org" },
+};
+#define LD_NPROV ((int)(sizeof(ld_provs) / sizeof(ld_provs[0])))
+
+static const struct ld_prov *ld_prov_of(const char *id)
+{
+	int i;
+
+	for (i = 0; i < LD_NPROV; i++)
+		if (!strcmp(id, ld_provs[i].id))
+			return &ld_provs[i];
+	return NULL;
+}
+
+/* a host name the provider can hold a TXT record under: lower-case LDH labels of 1-63, at least two of them,
+ * 4-253 bytes, no leading / trailing hyphen. It reaches acme.sh as an argument and names files in its home,
+ * so nothing else passes. DuckDNS only serves its own names. */
+int reaper_ledns_domain_ok(const char *d, const char *prov)
+{
+	size_t n = strlen(d), lab = 0, dots = 0, i;
+	const char *dk = ".duckdns.org";
+
+	if (n < 4 || n > 253)
+		return 0;
+	for (i = 0; i < n; i++) {
+		char c = d[i];
+		if (c == '.') {
+			if (lab == 0 || d[i - 1] == '-')
+				return 0;
+			lab = 0;
+			dots++;
+			continue;
+		}
+		if (!(islower((unsigned char)c) || isdigit((unsigned char)c) || c == '-'))
+			return 0;
+		if (c == '-' && lab == 0)
+			return 0;
+		if (++lab > 63)
+			return 0;
+	}
+	if (lab == 0 || d[n - 1] == '-' || dots == 0)
+		return 0;
+	if (prov && !strcmp(prov, "duckdns") && (n <= strlen(dk) || strcmp(d + n - strlen(dk), dk)))
+		return 0;
+	return 1;
+}
+
+/* the API token: 8-200 of [A-Za-z0-9._-] (Cloudflare, deSEC and DuckDNS tokens all fit); acme.sh writes it
+ * into account.conf inside single quotes, so nothing that could end them passes */
+int reaper_ledns_token_ok(const char *t)
+{
+	size_t n = strlen(t), i;
+
+	if (n < 8 || n > 200)
+		return 0;
+	for (i = 0; i < n; i++)
+		if (!(isalnum((unsigned char)t[i]) || t[i] == '.' || t[i] == '_' || t[i] == '-'))
+			return 0;
+	return 1;
+}
+
+/* the page shows reaper_ledns_err as text: keep it short, printable and free of the token */
+static void ld_state(const char *st, const char *err, int commit)
+{
+	char e[160], *tok = nvram_safe_get("reaper_ledns_token"), *p;
+	size_t i, o = 0;
+
+	for (i = 0; err && err[i] && o + 1 < sizeof(e); i++) {
+		unsigned char c = (unsigned char)err[i];
+		e[o++] = (isalnum(c) || strchr(" .,:;_/()'+-", c)) ? (char)c : ' ';
+	}
+	e[o] = '\0';
+	if (*tok && (p = strstr(e, tok)) != NULL)
+		memset(p, '*', strlen(tok));
+	nvram_set("reaper_ledns_state", st);
+	nvram_set("reaper_ledns_err", e);
+	if (!strcmp(st, "ok")) {
+		char w[24];
+		snprintf(w, sizeof(w), "%ld", (long)time(NULL));
+		nvram_set("reaper_ledns_when", w);
+	}
+	if (commit)
+		nvram_commit();
+}
+
+/* the last error line acme.sh printed ("[date] message"): what the page shows after a failure */
+static void ld_last_error(char *out, size_t cap, int rc)
+{
+	static const char *const words[] = { "error", "fail", "invalid", "unauthorized", "timeout", "timed out" };
+	FILE *f = fopen(LD_LOG, "r");
+	char l[512], lc[512], *m;
+	size_t i;
+	int hit;
+
+	snprintf(out, cap, "acme.sh exit %d", rc);
+	if (!f)
+		return;
+	while (fgets(l, sizeof(l), f)) {
+		l[strcspn(l, "\r\n")] = '\0';
+		for (i = 0; l[i]; i++)
+			lc[i] = (char)tolower((unsigned char)l[i]);
+		lc[i] = '\0';
+		for (hit = 0, i = 0; !hit && i < sizeof(words) / sizeof(words[0]); i++)
+			hit = strstr(lc, words[i]) != NULL;
+		if (!hit)
+			continue;
+		m = l;
+		if (*m == '[' && (m = strchr(l, ']')) != NULL)
+			m++;
+		else
+			m = l;
+		while (*m == ' ')
+			m++;
+		if (*m)
+			snprintf(out, cap, "%s", m);
+	}
+	fclose(f);
+}
+
+/* ---- Warden, for the length of one run ---- */
+struct ld_ip { const char *set; char ip[INET6_ADDRSTRLEN]; };
+
+static int ld_ipset(const char *op, const char *set, const char *ip)
+{
+	char *argv[] = { "ipset", "-q", (char *)op, (char *)set, (char *)ip, NULL };
+
+	return _eval(argv, NULL, 0, NULL);
+}
+
+static int ld_allow(const char *host, struct ld_ip *ips, int n)
+{
+	struct addrinfo hints, *res = NULL, *ai;
+	char ip[INET6_ADDRSTRLEN];
+
+	memset(&hints, 0, sizeof(hints));
+	hints.ai_socktype = SOCK_STREAM;
+	if (getaddrinfo(host, "443", &hints, &res) != 0)
+		return n;
+	for (ai = res; ai && n < LD_MAXIP; ai = ai->ai_next) {
+		const char *set;
+		void *a;
+		int i, dup = 0;
+
+		if (ai->ai_family == AF_INET) {
+			set = "rw_allow";
+			a = &((struct sockaddr_in *)ai->ai_addr)->sin_addr;
+		} else if (ai->ai_family == AF_INET6) {
+			set = "rw_allow6";
+			a = &((struct sockaddr_in6 *)ai->ai_addr)->sin6_addr;
+		} else
+			continue;
+		if (!inet_ntop(ai->ai_family, a, ip, sizeof(ip)))
+			continue;
+		for (i = 0; i < n; i++)
+			if (!strcmp(ips[i].ip, ip))
+				dup = 1;
+		if (dup || ld_ipset("test", set, ip) == 0)	/* already allowed: not ours to remove */
+			continue;
+		if (ld_ipset("add", set, ip) == 0) {
+			ips[n].set = set;
+			snprintf(ips[n].ip, sizeof(ips[n].ip), "%s", ip);
+			logmessage("ledns", "Warden: %s (%s) let through for this certificate request", host, ip);
+			n++;
+		}
+	}
+	freeaddrinfo(res);
+	return n;
+}
+
+static void ld_unallow(struct ld_ip *ips, int n)
+{
+	int i;
+
+	for (i = 0; i < n; i++)
+		ld_ipset("del", ips[i].set, ips[i].ip);
+}
+
+/* ---- install through the imported-certificate path ---- */
+static int ld_same(const char *a, const char *b)
+{
+	FILE *fa = fopen(a, "r"), *fb = fopen(b, "r");
+	int ca, cb, same = 0;
+
+	if (fa && fb) {
+		do {
+			ca = getc(fa);
+			cb = getc(fb);
+		} while (ca == cb && ca != EOF);
+		same = (ca == cb);
+	}
+	if (fa)
+		fclose(fa);
+	if (fb)
+		fclose(fb);
+	return same;
+}
+
+static int ld_copy(const char *src, const char *dst, mode_t mode)
+{
+	char tmp[128];
+	FILE *in, *out;
+	char buf[2048];
+	size_t r;
+	int fd, ok = 1;
+
+	snprintf(tmp, sizeof(tmp), "%s.ledns", dst);
+	unlink(tmp);
+	if ((in = fopen(src, "r")) == NULL)
+		return -1;
+	if ((fd = open(tmp, O_WRONLY | O_CREAT | O_EXCL | O_NOFOLLOW, mode)) < 0 || (out = fdopen(fd, "w")) == NULL) {
+		if (fd >= 0)
+			close(fd);
+		fclose(in);
+		return -1;
+	}
+	while ((r = fread(buf, 1, sizeof(buf), in)) > 0)
+		if (fwrite(buf, 1, r, out) != r)
+			ok = 0;
+	fclose(in);
+	if (fflush(out) != 0 || fsync(fileno(out)) != 0)
+		ok = 0;
+	fclose(out);
+	if (!ok || rename(tmp, dst) != 0) {
+		unlink(tmp);
+		return -1;
+	}
+	return 0;
+}
+
+/* 1 installed, 0 nothing to do, -1 failed */
+static int ld_install(void)
+{
+	if (!nvram_match("reaper_ledns_enable", "1"))
+		return 0;	/* switched off while this run was busy */
+	if (illegal_cert_and_key(LD_OUT_CERT, LD_OUT_KEY))
+		return -1;
+	if (nvram_match("le_enable", "2") && ld_same(LD_OUT_CERT, UPLOAD_CERT) && ld_same(LD_OUT_KEY, UPLOAD_KEY))
+		return 0;
+	mkdir(UPLOAD_CERT_FOLDER, 0700);
+	if (ld_copy(LD_OUT_KEY, UPLOAD_KEY, 0600) != 0 || ld_copy(LD_OUT_CERT, UPLOAD_CERT, 0644) != 0)
+		return -1;
+	/* an end-entity certificate: the root / intermediate pair and what it signed would win over it */
+	unlink(UPLOAD_CACERT);
+	unlink(UPLOAD_CAKEY);
+	unlink(UPLOAD_GEN_CERT);
+	unlink(UPLOAD_GEN_KEY);
+	nvram_set("le_enable", "2");
+	if (prepare_cert_in_etc() > 0) {
+		/* as rc/services.c ddns_updated_main and the prepare_cert verb: httpd loads it after the session */
+		nvram_set("httpds_reload_cert", "2");
+		rednsd_cert_changed();
+#if defined(RTCONFIG_IPV6)
+		if (ipv6_enabled() && nvram_match("misc_http_x", "1"))
+			nvram_set("httpds6_reload_cert", "2");
+#endif
+	}
+	if (!nvram_match("le_enable", "2"))
+		return -1;	/* prepare_cert_in_etc refused the files and fell back to self-signed */
+	return 1;
+}
+
+static int ld_home(void)
+{
+	struct stat st;
+
+	if (mkdir(LD_HOME, 0700) != 0 && errno != EEXIST)
+		return -1;
+	if (lstat(LD_HOME, &st) != 0 || !S_ISDIR(st.st_mode))
+		return -1;
+	if ((st.st_mode & 07777) != 0700)
+		chmod(LD_HOME, 0700);
+	return 0;
+}
+
+static int ld_run(void)
+{
+	char dom[256], tok[256], prov[16], err[200];
+	const struct ld_prov *p;
+	struct ld_ip ips[LD_MAXIP];
+	int lock, nip = 0, rc, r;
+
+	if (!nvram_match("reaper_ledns_enable", "1"))
+		return 0;
+	snprintf(dom, sizeof(dom), "%s", nvram_safe_get("reaper_ledns_domain"));
+	snprintf(tok, sizeof(tok), "%s", nvram_safe_get("reaper_ledns_token"));
+	snprintf(prov, sizeof(prov), "%s", nvram_safe_get("reaper_ledns_provider"));
+	if (!(p = ld_prov_of(prov)) || !reaper_ledns_domain_ok(dom, prov) || !reaper_ledns_token_ok(tok)) {
+		ld_state("fail", "The provider, domain name or API token is missing or not valid", 1);
+		logmessage("ledns", "Let's Encrypt (DNS): not requested - provider, domain name or API token missing or not valid");
+		return 1;
+	}
+	if (reaper_secure_dir(REAPER_TMPDIR, 0700) != 0 || ld_home() != 0)
+		return 1;
+	if ((lock = open(LD_LOCK, O_RDWR | O_CREAT | O_NOFOLLOW | O_CLOEXEC, 0600)) < 0)
+		return 1;
+	if (flock(lock, LOCK_EX | LOCK_NB) != 0) {
+		close(lock);
+		return 0;	/* a run is already busy (Apply during the nightly one): it does the same work */
+	}
+	unlink(LD_LOG);
+	nvram_set("reaper_ledns_state", "run");
+	logmessage("ledns", "Let's Encrypt (DNS): requesting or renewing %s through %s", dom, p->api);
+
+	if (nvram_match("rwarden_enable", "1") && nvram_match("rwarden_self", "1")) {
+		nip = ld_allow(p->api, ips, nip);
+		nip = ld_allow(LD_LE_API, ips, nip);
+	}
+	setenv(p->env, tok, 1);
+	{
+		char *argv[] = { LD_ACME, "--home", LD_HOME, "--config-home", LD_HOME, "--issue", "-d", dom,
+				 "--dns", (char *)p->hook, "--dnssleep", LD_SLEEP, "--keylength", "ec-256",
+				 "--server", "letsencrypt", NULL };
+		rc = _eval(argv, ">" LD_LOG, LD_TIMEOUT, NULL);
+	}
+	if (rc == 0 || rc == 2) {
+		char *argv[] = { LD_ACME, "--home", LD_HOME, "--config-home", LD_HOME, "--install-cert", "-d", dom,
+				 "--ecc", "--fullchain-file", LD_OUT_CERT, "--key-file", LD_OUT_KEY, NULL };
+		if (_eval(argv, ">>" LD_LOG, 120, NULL) != 0)
+			rc = -1;
+	}
+	unsetenv(p->env);
+	ld_unallow(ips, nip);
+
+	if (rc != 0 && rc != 2) {
+		ld_last_error(err, sizeof(err), rc);
+		ld_state("fail", err, 1);
+		logmessage("ledns", "Let's Encrypt (DNS): %s failed - %s", dom, nvram_safe_get("reaper_ledns_err"));
+		close(lock);
+		return 1;
+	}
+	chmod(LD_OUT_KEY, 0600);
+	r = ld_install();
+	if (r < 0) {
+		ld_state("fail", "The new certificate could not be installed", 1);
+		logmessage("ledns", "Let's Encrypt (DNS): %s - the certificate could not be installed", dom);
+	} else if (r > 0) {
+		ld_state("ok", "", 1);
+		logmessage("ledns", "Let's Encrypt (DNS): certificate for %s installed", dom);
+	} else if (!nvram_match("reaper_ledns_state", "ok")) {
+		ld_state("ok", "", 1);	/* already installed and not due: say so once, keep the date */
+	} else
+		nvram_set("reaper_ledns_state", "ok");
+	close(lock);
+	return r < 0;
+}
+
+/* the daily line: a minute and an hour (01-05) from the domain name, so routers do not all ask at once */
+void start_reaper_ledns(int now)
+{
+	char line[96];
+	const char *d;
+	unsigned h = 5381;
+
+	eval("cru", "d", "reaper_ledns");
+	if (!nvram_match("reaper_ledns_enable", "1"))
+		return;
+	for (d = nvram_safe_get("reaper_ledns_domain"); *d; d++)
+		h = h * 33 + (unsigned char)*d;
+	snprintf(line, sizeof(line), "%u %u * * * /sbin/reaper_ledns run", h % 60, 1 + (h / 60) % 5);
+	eval("cru", "a", "reaper_ledns", line);
+	if (now) {
+		char *argv[] = { "/sbin/reaper_ledns", "run", NULL };
+		int pid;
+		_eval(argv, NULL, 0, &pid);
+	}
+}
+
+/* switched off: the cron line goes, and with it acme.sh's home (account key, saved token, keys). The
+ * certificate already installed stays until the page's certificate choice replaces it. */
+void stop_reaper_ledns(void)
+{
+	eval("cru", "d", "reaper_ledns");
+	if (nvram_match("reaper_ledns_enable", "1"))
+		return;
+	eval("rm", "-rf", LD_HOME);
+	nvram_set("reaper_ledns_state", "");
+	nvram_set("reaper_ledns_err", "");
+}
+
+int reaper_ledns_main(int argc, char *argv[])
+{
+	if (argc > 1 && !strcmp(argv[1], "run"))
+		return ld_run();
+	fprintf(stderr, "usage: reaper_ledns run\n");
+	return 1;
+}
+
+#else	/* !RTCONFIG_LETSENCRYPT: acme.sh is not in the image */
+
+void start_reaper_ledns(int now) { (void)now; }
+void stop_reaper_ledns(void) { }
+int reaper_ledns_main(int argc, char *argv[]) { (void)argc; (void)argv; return 1; }
+
+#endif
