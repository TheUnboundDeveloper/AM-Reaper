+/* reaper 2026-11-10 (backlog leftover): the LOCAL subnet may be IPv6 (strongSwan's leftsubnet takes it, and the
+ * profile export below tells the families apart), so it keeps hex digits and ':' as well; still nothing a shell or
+ * strongSwan's lexer would read as more than an address. The virtual subnet stays IPv4 (it is completed to x.x.x.0/24). */
+static void ipsec_subnet_sanitize46(char *subnet)
+{
+    char *p = subnet;
+    while(*p != '\0'){
+        if(!((*p >= '0' && *p <= '9') || (*p >= 'a' && *p <= 'f') || (*p >= 'A' && *p <= 'F')
+             || *p == ':' || *p == '.' || *p == '/' || *p == ',')){
+            *p = '\0';
+            break;
+        }
+        p++;
+    }
+}
+
 static void ipsec_subnet_sanitize(char *subnet)
 {
     char *p = subnet;
@@ -311,6 +341,275 @@ static void ipsec_subnet_sanitize(char *subnet)
     return;
 }
 
+/* reaper ipsec-profile-gate: begin (2026-11-10) - what a saved IPsec profile may hold before rc uses it.
+ * rc writes the fields of ipsec_profile_N / ipsec_profile_client_N into ipsec.conf, ipsec.secrets, strongswan.conf
+ * and quicksecpm.xml, most of them unquoted, and strongSwan reads those files with lexers for which a space ends a
+ * token, '=' is a token of its own, and the word "include" followed by a space opens another file. So:
+ *   - a control character anywhere in either saved value, or in any field, is refused;
+ *   - both saved values must hold the separators the parser consumes (it walked off their end otherwise);
+ *   - "include" followed by a space or tab is refused in every field that is not a quoted secret;
+ *   - the IDs take an allowlist, and so does the remote gateway (it is also the ipsec.secrets selector); the
+ *     fields that are one token on a line of their own take no space, tab or '='; the three secrets that are
+ *     written inside double quotes take no double quote; the DNS / WINS list takes address characters only.
+ * Such a profile is not applied: pre_ipsec_prof_set() clears its slot, so no writer sees it. The saved setting
+ * itself is never rewritten. */
+#define IPSEC_GATE_OK       0
+#define IPSEC_GATE_CHAR     1   /* a character the field must not hold */
+#define IPSEC_GATE_INCLUDE  2   /* the lexers' include keyword */
+#define IPSEC_GATE_SHAPE    3   /* fewer separators than the parser consumes */
+
+#define IPSEC_F_ID      0x01    /* an identity: the ID allowlist */
+#define IPSEC_F_HOST    0x02    /* a host, address or subnet: the same allowlist plus '/' */
+#define IPSEC_F_TOKEN   0x04    /* one token on its own key=value line: no space, tab or '=' */
+#define IPSEC_F_SECRET  0x08    /* only ever written inside "...": no double quote (and no include rule) */
+#define IPSEC_F_ADDRS   0x10    /* the DNS / WINS list: letters, digits, '.', ':' and its separator only */
+
+static int ipsec_str_has_ctl(const char *s)
+{
+    const unsigned char *p = (const unsigned char *)s;
+
+    if(p == NULL)
+        return 0;
+    for(; *p != '\0'; p++){
+        if(*p < 0x20 || *p == 0x7f)
+            return 1;
+    }
+    return 0;
+}
+
+/* "include", then a space or tab: the ipsec.conf and strongswan.conf lexers open the file named after it wherever
+ * a token can start, and ipsec.secrets does at the start of a line */
+static int ipsec_str_has_include(const char *s)
+{
+    const char *p;
+
+    if(s == NULL)
+        return 0;
+    for(p = s; (p = strstr(p, "include")) != NULL; p += 7){
+        if(p[7] == ' ' || p[7] == '\t')
+            return 1;
+    }
+    return 0;
+}
+
+/* An ID as it can stand unquoted on a leftid= / rightid= line and as an ipsec.secrets selector: empty, a key ID
+ * in hex ("@#0a0b"), or letters, digits and @ . _ : + % - only - a host name, user@host, @host, an IPv4 or IPv6
+ * address, %any, null. With host set, '/' as well (a subnet) and no key ID form. A certificate DN is NOT
+ * accepted: unquoted, its '=' is a token of its own for the lexer and the whole ipsec.conf fails to load. */
+static int ipsec_id_chars_ok(const char *s, int host)
+{
+    const char *p;
+
+    if(s == NULL || *s == '\0')
+        return 1;
+    if(!host && s[0] == '@' && s[1] == '#'){
+        for(p = s + 2; (*p >= '0' && *p <= '9') || (*p >= 'a' && *p <= 'f') || (*p >= 'A' && *p <= 'F'); p++)
+            ;
+        return p > s + 2 && *p == '\0';
+    }
+    for(p = s; *p != '\0'; p++){
+        if((*p >= 'a' && *p <= 'z') || (*p >= 'A' && *p <= 'Z') || (*p >= '0' && *p <= '9'))
+            continue;
+        if(*p == '@' || *p == '.' || *p == '_' || *p == ':' || *p == '+' || *p == '%' || *p == '-')
+            continue;
+        if(host && *p == '/')
+            continue;
+        return 0;
+    }
+    return 1;
+}
+
+/* the DNS / WINS list after the parser turned its '<' into '>': addresses (or "null") and that separator */
+static int ipsec_addr_list_ok(const char *s)
+{
+    if(s == NULL)
+        return 1;
+    for(; *s != '\0'; s++){
+        if(!((*s >= 'a' && *s <= 'z') || (*s >= 'A' && *s <= 'Z') || (*s >= '0' && *s <= '9') ||
+             *s == '.' || *s == ':' || *s == '>'))
+            return 0;
+    }
+    return 1;
+}
+
+/* 1 = exactly three dotted decimal octets, each 0-255 ("10.10.10"): the form the callers of
+ * get_virtual_subnet() complete with ".0/24" */
+static int ipsec_subnet3_ok(const char *s)
+{
+    int part, digits, val;
+
+    if(s == NULL)
+        return 0;
+    for(part = 0; part < 3; part++){
+        for(digits = 0, val = 0; *s >= '0' && *s <= '9' && digits < 4; s++, digits++)
+            val = val * 10 + (*s - '0');
+        if(digits < 1 || digits > 3 || val > 255)
+            return 0;
+        if(part < 2 && *s++ != '.')
+            return 0;
+    }
+    return *s == '\0';
+}
+
+/* ipsec_prof_fill()'s walk over a saved profile, without writing: 1 when the parser stays inside the value.
+ * Fields 0..36 each end at a '>' (before fields 8 and 10 the parser steps over one character, the '<' of a
+ * subnet list); field 37 is either the last one, or five more separated fields follow it and a last one. */
+static int ipsec_profile_shape_ok(const char *v)
+{
+    int f;
+
+    if(v == NULL)
+        return 0;
+    for(f = 0; f <= 36; f++){
+        if(f == 8 || f == 10){
+            if(*v == '\0')
+                return 0;
+            v++;
+        }
+        if((v = strchr(v, '>')) == NULL)
+            return 0;
+        v++;
+    }
+    if(strchr(v, '>') == NULL)
+        return 1;
+    for(f = 37; f <= 41; f++){
+        if((v = strchr(v, '>')) == NULL)
+            return 0;
+        v++;
+    }
+    return 1;
+}
+
+/* ipsec_prof_fill_ext(): five numbers that each end at a '>', then a last one */
+static int ipsec_profile_ext_shape_ok(const char *v)
+{
+    int f;
+
+    if(v == NULL)
+        return 0;
+    for(f = 0; f < 5; f++){
+        if((v = strchr(v, '>')) == NULL)
+            return 0;
+        v++;
+    }
+    return 1;
+}
+
+/* 1 = usable. 0 = refused: *bad then names the field (its name, never its value) and *why says which rule. */
+static int ipsec_profile_fields_ok(const ipsec_prof_t *p, const char **bad, int *why)
+{
+    const struct { const char *name; const char *val; int flags; } f[] = {
+        { "profilename", p->profilename, 0 },
+        { "remote_gateway_method", p->remote_gateway_method, 0 },
+        { "remote_gateway", p->remote_gateway, IPSEC_F_HOST },
+        { "local_public_interface", p->local_public_interface, 0 },
+        { "local_pub_ip", p->local_pub_ip, 0 },
+        { "auth_method_key", p->auth_method_key, IPSEC_F_SECRET },
+        { "local_subnet", p->local_subnet, IPSEC_F_TOKEN },
+        { "remote_subnet", p->remote_subnet, IPSEC_F_TOKEN },
+        { "tun_type", p->tun_type, IPSEC_F_TOKEN },
+        { "virtual_ip_en", p->virtual_ip_en, 0 },
+        { "virtual_subnet", p->virtual_subnet, IPSEC_F_TOKEN },
+        { "local_id", p->local_id, IPSEC_F_ID },
+        { "remote_id", p->remote_id, IPSEC_F_ID },
+        { "xauth_account", p->xauth_account, 0 },
+        { "xauth_password", p->xauth_password, IPSEC_F_SECRET },
+        { "rightauth2_method", p->rightauth2_method, IPSEC_F_TOKEN },
+        { "samba_settings", p->samba_settings, IPSEC_F_ADDRS },
+        { "leftauth_method", p->leftauth_method, IPSEC_F_TOKEN },
+        { "leftcert", p->leftcert, IPSEC_F_TOKEN },
+        { "leftsendcert", p->leftsendcert, IPSEC_F_TOKEN },
+        { "leftkey", p->leftkey, IPSEC_F_SECRET },
+        { "eap_identity", p->eap_identity, IPSEC_F_TOKEN },
+    };
+    size_t i;
+
+    for(i = 0; i < sizeof(f) / sizeof(f[0]); i++){
+        const char *v = f[i].val;
+        int fl = f[i].flags, w = IPSEC_GATE_OK;
+
+        if(ipsec_str_has_ctl(v))
+            w = IPSEC_GATE_CHAR;
+        else if(!(fl & IPSEC_F_SECRET) && ipsec_str_has_include(v))
+            w = IPSEC_GATE_INCLUDE;
+        else if((fl & (IPSEC_F_ID | IPSEC_F_HOST)) && !ipsec_id_chars_ok(v, fl & IPSEC_F_HOST))
+            w = IPSEC_GATE_CHAR;
+        else if((fl & IPSEC_F_TOKEN) && strpbrk(v, " \t=") != NULL)
+            w = IPSEC_GATE_CHAR;
+        else if((fl & IPSEC_F_SECRET) && strchr(v, '"') != NULL)
+            w = IPSEC_GATE_CHAR;
+        else if((fl & IPSEC_F_ADDRS) && !ipsec_addr_list_ok(v))
+            w = IPSEC_GATE_CHAR;
+        if(w != IPSEC_GATE_OK){
+            if(bad != NULL)
+                *bad = f[i].name;
+            if(why != NULL)
+                *why = w;
+            return 0;
+        }
+    }
+    return 1;
+}
+
+/* why == IPSEC_GATE_OK: nothing to do. Otherwise clear the slot - ipsec_conn_en becomes IPSEC_CONN_EN_DOWN and
+ * the name is empty, which every writer and the start/stop loop already skip - and say which profile and why.
+ * idx is the profile number as the settings count it (1-based). */
+/* reaper 2026-11-10 (backlog leftover): which slots were refused at the last pass, and whether one was refused that
+ * was not before. A refused slot is cleared, so its connection gets no "ipsec down" (the name is gone, and a name
+ * from a refused value is not written into a shell script anyway); rc_ipsec_set() restarts strongSwan instead when
+ * a refusal is new, which takes that tunnel down with the old configuration. */
+static uint32_t ipsec_gate_refused[2], ipsec_gate_refused_prev[2];
+static int ipsec_gate_new_refusal;
+
+static void ipsec_profile_gate_apply(ipsec_prof_t *slot, int is_svr, int idx, int why, const char *bad)
+{
+    const char *who = is_svr ? "server" : "client";
+
+    if(why == IPSEC_GATE_OK)
+        return;
+    if(idx >= 1 && idx <= 32)
+        ipsec_gate_refused[is_svr ? 1 : 0] |= 1u << (idx - 1);
+    memset(slot, 0, sizeof(*slot));
+    if(bad == NULL)
+        bad = "a field";
+    if(why == IPSEC_GATE_SHAPE)
+        logmessage("ipsec", "%s profile %d skipped: malformed saved value", who, idx);
+    else if(why == IPSEC_GATE_INCLUDE)
+        logmessage("ipsec", "%s profile %d skipped: include directive in %s", who, idx, bad);
+    else
+        logmessage("ipsec", "%s profile %d skipped: unsafe character in %s", who, idx, bad);
+}
+/* reaper 2026-11-10: a VPN user of ipsec_client_list_N. The name opens an ipsec.secrets line unquoted (whitespace,
+ * ':' and '#' would split or end it), the password sits inside double quotes. */
+static int ipsec_cli_user_ok(const char *s)
+{
+    size_t i;
+
+    if(s == NULL || *s == '\0' || strlen(s) > 64 || strcasecmp(s, "include") == 0)
+        return 0;
+    for(i = 0; s[i]; i++){
+        unsigned char ch = (unsigned char)s[i];
+        if(ch <= 0x20 || ch >= 0x7f || strchr("\"\\:#<>", ch) != NULL)
+            return 0;
+    }
+    return 1;
+}
+
+static int ipsec_cli_pass_ok(const char *s)
+{
+    size_t i;
+
+    if(s == NULL || *s == '\0')
+        return 0;
+    for(i = 0; s[i]; i++){
+        unsigned char ch = (unsigned char)s[i];
+        if(ch < 0x20 || ch == 0x7f || ch == '"')
+            return 0;
+    }
+    return 1;
+}
+/* reaper ipsec-profile-gate: end */
+
 void ipsec_prof_fill(int prof_idx, char *p_data, ipsec_prof_type_t prof_type)
 {
     int i = 1;
@@ -351,13 +650,13 @@ void ipsec_prof_fill(int prof_idx, char *p_data, ipsec_prof_type_t prof_type)
     ipsec_profile_str_parse(p_end, p_tmp, &i, sizeof(prof[prof_type][prof_idx].auth_method_key));
     p_end += i;
 	/*p_end+1 for skipping '<'*/
-    p_end += 1;
+    if('\0' != *p_end) p_end += 1;	/* reaper: never step over the terminator */
     /*to parse local subnet e.g.192.168.2.1/24> [local_port] 0>*/
     p_tmp = &(prof[prof_type][prof_idx].local_subnet[0]);
     ipsec_profile_str_parse(p_end, p_tmp, &i, sizeof(prof[prof_type][prof_idx].local_subnet));
 	 /*to replace '<' to ',' e.g. 192.168.3.1/16,192.168.2.1/24*/
 	while ((ptr=strchr(p_tmp, '<'))!=NULL) *ptr = ',';
-	ipsec_subnet_sanitize(p_tmp);
+	ipsec_subnet_sanitize46(p_tmp);	/* reaper 2026-11-10: an IPv6 local subnet is kept */
 
     p_end += i;
     /*local port*/
@@ -367,7 +666,7 @@ void ipsec_prof_fill(int prof_idx, char *p_data, ipsec_prof_type_t prof_type)
     /*remote subnet*/
     /*to parse remote subnet e.g. <192.168.3.1/16>3600>*/
     /*p_end+1 for skipping '<'*/
-    p_end += 1;
+    if('\0' != *p_end) p_end += 1;	/* reaper: never step over the terminator */
     p_tmp = &(prof[prof_type][prof_idx].remote_subnet[0]);
     ipsec_profile_str_parse(p_end, p_tmp, &i, sizeof(prof[prof_type][prof_idx].remote_subnet));
     /*to replace '<' to ',' e.g. 192.168.3.1/16,192.168.2.1/24*/
@@ -568,6 +867,8 @@ void ipsec_prof_fill_ext(int prof_idx, char *p_data, ipsec_prof_type_t prof_type
 
 int pre_ipsec_prof_set()
 {
+    /* reaper 2026-11-10: a fresh record of refused slots for this pass (compared at its end) */
+    ipsec_gate_refused[0] = ipsec_gate_refused[1] = 0;
     char buf[SZ_MIN], buf_ext[SZ_MIN];
     char *p_tmp = NULL, buf1[SZ_BUF];
 	char *p_tmp_ext = NULL, buf1_ext[SZ_BUF];
@@ -593,14 +894,34 @@ int pre_ipsec_prof_set()
 				strlcpy(p_tmp_ext, nvram_safe_get(&buf_ext[0]), sizeof(buf1_ext));
 				/*to avoid nvram that it has not been inited ready*/
 				if(0 != *p_tmp){
-					ipsec_prof_fill(i-1, p_tmp,prof_count);
-					if(0 != *p_tmp_ext)
