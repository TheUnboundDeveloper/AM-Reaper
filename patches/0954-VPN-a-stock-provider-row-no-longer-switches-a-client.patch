+static int vpns_subnet3_ok(const char *s)
+{
+	int part, digits, val;
+
+	if (!s)
+		return 0;
+	for (part = 0; part < 3; part++) {
+		for (digits = 0, val = 0; *s >= '0' && *s <= '9' && digits < 4; s++, digits++)
+			val = val * 10 + (*s - '0');
