+/* reaper 2026-11-10: 1 = a well-formed IPv4 address that is not 0.0.0.0. The server certificate is made once and
+ * kept, so it is only made for a real WAN address. */
+static int ipsec_wan_addr_ok(const char *s)
+{
+    struct in_addr a;
+
+    return s != NULL && inet_pton(AF_INET, s, &a) == 1 && a.s_addr != 0;
+}
+
