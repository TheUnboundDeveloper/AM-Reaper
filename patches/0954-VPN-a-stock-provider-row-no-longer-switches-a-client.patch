+					   A refused profile is cleared before any writer can see it. */
+					const char *gate_bad = NULL;
+					int gate_why = IPSEC_GATE_OK;
+					if(ipsec_str_has_ctl(p_tmp) || ipsec_str_has_ctl(p_tmp_ext)){
