diff --git a/release/src/router/rc/reaper_cthelper.c b/release/src/router/rc/reaper_cthelper.c
new file mode 100644
index 00000000000..0eae5524348
--- /dev/null
+++ b/release/src/router/rc/reaper_cthelper.c
@@ -0,0 +1,108 @@
+/*
+ * reaper 2026-11-05 (audit E-13, owner: "FTP/PPTP helper off by default"): conntrack helpers by explicit rule only.
+ *
+ * Stock sets nf_conntrack_helper=1, so every loaded helper attaches itself to every connection on its port:
+ * any LAN client's port-21 session got the FTP ALG, and a malicious FTP server's 227/PORT reply opened RELATED
+ * pinholes towards that client (the classic ALG exposure); likewise PPTP on 1723. rc now writes 0 there
+ * (setup_conntrack) and attaches each helper with a raw-table CT rule only where it is wanted:
+ *   to the router itself (its own FTP server, a port-forwarded FTP server, its PPTP server) - always, since
+ *     that traffic is addressed to the router (raw PREROUTING runs before DNAT, so a port forward's
+ *     destination is still the router's own address);
+ *   LAN clients going out - FTP only with the FTP passthrough switch (nf_ftp, default 0); PPTP while PPTP
+ *     passthrough (fw_pt_pptp) is on; RTSP / H.323 / SIP while their switches are on (any direction, as before);
+ *   the router's own outgoing PPTP (OUTPUT).
+ * IPv6: FTP and SIP (the helpers stock loaded for both families). Chains REAPER_CTH (PREROUTING) and
+ * REAPER_CTHO (OUTPUT) in the raw table, rebuilt whole on every call (setup_conntrack, setup_pt_conntrack and
+ * setup_ftp_conntrack - the last runs on every firewall start). Nothing else in rc flushes raw.
+ */
+#include <rc.h>
+#include <shared.h>
+
+#define CTH	"REAPER_CTH"
+#define CTHO	"REAPER_CTHO"
+
+static void cth_reset(char *ipt, const char *chain, const char *hook)
+{
+	char *n[] = { ipt, "-t", "raw", "-N", (char *)chain, NULL };
+	char *f[] = { ipt, "-t", "raw", "-F", (char *)chain, NULL };
+	char *c[] = { ipt, "-t", "raw", "-C", (char *)hook, "-j", (char *)chain, NULL };
+	char *i[] = { ipt, "-t", "raw", "-I", (char *)hook, "1", "-j", (char *)chain, NULL };
+
+	_eval(n, ">/dev/null", 0, NULL);	/* "already exists" on every call after the first */
+	_eval(f, NULL, 0, NULL);
+	if (_eval(c, ">/dev/null", 0, NULL) != 0)
+		_eval(i, NULL, 0, NULL);
+}
+
+/* one rule: proto, a destination port list ("21" or "554,8554"), local: 1 = to the router, 0 = not to the
+   router, -1 = either; helper name */
+static void cth_rule(char *ipt, const char *chain, const char *proto, const char *ports, int local, const char *helper)
+{
+	char *a[24];
+	int k = 0;
+
+	a[k++] = ipt; a[k++] = "-t"; a[k++] = "raw"; a[k++] = "-A"; a[k++] = (char *)chain;
+	a[k++] = "-p"; a[k++] = (char *)proto;
+	if (local >= 0) {
+		a[k++] = "-m"; a[k++] = "addrtype";
+		if (!local) a[k++] = "!";
+		a[k++] = "--dst-type"; a[k++] = "LOCAL";
+	}
+	if (strchr(ports, ',')) {
+		a[k++] = "-m"; a[k++] = "multiport"; a[k++] = "--dports"; a[k++] = (char *)ports;
+	} else {
+		a[k++] = "--dport"; a[k++] = (char *)ports;
+	}
+	a[k++] = "-j"; a[k++] = "CT"; a[k++] = "--helper"; a[k++] = (char *)helper;
+	a[k] = NULL;
+	_eval(a, NULL, 0, NULL);
+}
+
+void reaper_ct_helpers(void)
+{
+	char ftp[48];
+	int p, own = 0, v6 = ipv6_enabled();
+	int pptp = !nvram_match("nf_pptp", "0");
+
+	/* the FTP ports addressed to the router: 21, its own FTP server's port, the port-forward FTP port */
+	snprintf(ftp, sizeof(ftp), "21");
+	if (nvram_match("ftp_enable", "1") && (p = nvram_get_int("ftp_port")) > 0 && p != 21 && p < 65536) {
+		snprintf(ftp + strlen(ftp), sizeof(ftp) - strlen(ftp), ",%d", p);
+		own = p;
+	}
+	if ((p = nvram_get_int("vts_ftpport")) > 0 && p != 21 && p != own && p < 65536)
+		snprintf(ftp + strlen(ftp), sizeof(ftp) - strlen(ftp), ",%d", p);
+
+	cth_reset("iptables", CTH, "PREROUTING");
+	cth_reset("iptables", CTHO, "OUTPUT");
+	cth_rule("iptables", CTH, "tcp", ftp, 1, "ftp");
+	if (nvram_match("nf_ftp", "1"))
+		cth_rule("iptables", CTH, "tcp", "21", 0, "ftp");
+	if (pptp) {
+		cth_rule("iptables", CTH, "tcp", "1723", 1, "pptp");
+		if (!nvram_match("fw_pt_pptp", "0"))
+			cth_rule("iptables", CTH, "tcp", "1723", 0, "pptp");
+		cth_rule("iptables", CTHO, "tcp", "1723", -1, "pptp");
+	}
+	if (nvram_match("fw_pt_rtsp", "1"))
+		cth_rule("iptables", CTH, "tcp", "554,8554", -1, "rtsp");
+	if (nvram_match("fw_pt_h323", "1")) {
+		cth_rule("iptables", CTH, "tcp", "1720", -1, "Q.931");
+		cth_rule("iptables", CTH, "udp", "1719", -1, "RAS");
+	}
+	if (nvram_match("fw_pt_sip", "1")) {
+		cth_rule("iptables", CTH, "udp", "5060", -1, "sip");
+		cth_rule("iptables", CTH, "tcp", "5060", -1, "sip");
+	}
+
+	if (v6) {
+		cth_reset("ip6tables", CTH, "PREROUTING");
+		cth_rule("ip6tables", CTH, "tcp", ftp, 1, "ftp");
+		if (nvram_match("nf_ftp", "1"))
+			cth_rule("ip6tables", CTH, "tcp", "21", 0, "ftp");
+		if (nvram_match("fw_pt_sip", "1")) {
+			cth_rule("ip6tables", CTH, "udp", "5060", -1, "sip");
+			cth_rule("ip6tables", CTH, "tcp", "5060", -1, "sip");
+		}
+	}
+}
