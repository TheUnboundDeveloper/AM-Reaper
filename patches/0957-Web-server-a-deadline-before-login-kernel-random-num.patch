+/* review 2026-11-11 (D-L1): a dotted IPv4 address, at most 15 characters - what networkmap reads lan_gateway
+ * as. */
+static int reaper_dotted_v4(const char *s)
+{
+	int parts = 0, digits = 0, val = 0;
+
+	if (!s || strlen(s) > 15)
+		return 0;
+	for (;; s++) {
+		if (*s >= '0' && *s <= '9') {
+			val = val * 10 + (*s - '0');
+			if (++digits > 3 || val > 255)
+				return 0;
+		} else if (*s == '.' || *s == '\0') {
+			if (!digits)
+				return 0;
+			parts++;
+			digits = 0;
+			val = 0;
+			if (*s == '\0')
+				break;
+		} else
+			return 0;
+	}
+	return parts == 4;
+}
