+/* review 2026-11-11 (B-4): the port of "scheme://host[:port]/..." (a Referer) or of "host[:port]" (a Host header).
+ * With no port written: the scheme's own (https 443, http 80), and for a Host header `dflt`. 0 = unreadable. */
+static int reaper_origin_port(const char *s, int dflt)
+{
+	const char *h = strstr(s, "://"), *e;
+	char *end;
+	long v;
+
+	if (h) {
+		if (!strncasecmp(s, "https://", 8))
+			dflt = 443;
+		else if (!strncasecmp(s, "http://", 7))
+			dflt = 80;
+		else
+			return 0;
+		h += 3;
+	} else
+		h = s;
+	if (*h == '[') {
+		e = strchr(h, ']');
+		if (!e)
+			return 0;
+		e++;
+	} else
+		e = h + strcspn(h, ":/?#\r\n \t");
+	if (*e != ':')
+		return dflt;
+	v = strtol(e + 1, &end, 10);
+	if (end == e + 1 || v < 1 || v > 65535 || (*end && !strchr("/?#\r\n \t", *end)))
+		return 0;
+	return (int)v;
+}
