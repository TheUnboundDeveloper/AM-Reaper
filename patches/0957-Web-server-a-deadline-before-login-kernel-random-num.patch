+/* review 2026-11-11 (B-6): a settings import MERGES into the device list. The rows of the file are added (or
+ * replace the row of the same device); every other device on the box keeps its row. One read-modify-write
+ * under the list's lock, each row checked as gk_rl_update() checks it. Returns the rows taken, -1 when the
+ * list could not be written. The import used to replace the whole list, outside the lock, unchecked - every
+ * device approved since the file was made lost its approval. */
+static int
+gk_rl_merge(const char *in)
+{
+	char *rl, *out = NULL, *cur = NULL, *add = NULL, *vin = NULL, *tok, *sp = NULL;
+	size_t cap;
+	int n = 0, rc = 0, lf;
+
+	if (!in)
+		return 0;
+	lf = open("/tmp/gk/rl.lock", O_CREAT | O_RDWR | O_NOFOLLOW, 0600);
+	if (lf >= 0) flock(lf, LOCK_EX);
+	rl = gk_rl_get();
+	cap = strlen(rl) + strlen(in) + 64;
+	out = calloc(1, cap);
+	vin = calloc(1, strlen(in) + 64);
+	cur = strdup(rl);
+	add = strdup(in);
+	if (!out || !vin || !cur || !add) {
+		rc = -1;
+		goto done;
+	}
+	/* the file's rows, checked; a device named twice keeps its first row */
+	for (tok = strtok_r(add, "<", &sp); tok; tok = strtok_r(NULL, "<", &sp)) {
+		char m[18] = "", row[48];
+		int st = -1;
+		long ex = 0;
+		if (sscanf(tok, "%17[^>]>%d>%ld", m, &st, &ex) < 2 || !gk_valid_mac(m) || st < 0 || st > 3 || ex < 0)
+			continue;
+		if (gk_rl_find(vin, m, NULL, NULL))
+			continue;
+		snprintf(row, sizeof(row), "<%s>%d>%ld", m, st, ex);
+		strlcat(vin, row, strlen(in) + 64);
+		n++;
+	}
+	/* the rows on the box the file does not name stay as they are */
+	sp = NULL;
+	for (tok = strtok_r(cur, "<", &sp); tok; tok = strtok_r(NULL, "<", &sp)) {
+		char m[18] = "";
+		if (sscanf(tok, "%17[^>]", m) != 1 || !gk_valid_mac(m)) continue;
+		if (gk_rl_find(vin, m, NULL, NULL)) continue;
+		strlcat(out, "<", cap);
+		strlcat(out, tok, cap);
+	}
+	strlcat(out, vin, cap);
+	if (gk_rl_set(out) != 0) {
+		logmessage("gatekeeper", "device list write FAILED - the imported devices were not added");
+		rc = -1;
+	}
+done:
+	if (lf >= 0) { flock(lf, LOCK_UN); close(lf); }
+	free(out); free(vin); free(cur); free(add);
+	return rc ? -1 : n;
+}
