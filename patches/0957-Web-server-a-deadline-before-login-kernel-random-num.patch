index 00000000000..965f16eb099
--- /dev/null
+++ b/release/src/router/httpd/reaper_rand.c
@@ -0,0 +1,60 @@
+/*
+ * reaper (review 2026-11-11, B-C2). The web server links prebuilt objects that import the C library's rand() and
+ * srand() (see their symbol tables), and a rand() sequence is only as unpredictable as its 32-bit seed. The web
+ * server is linked with --wrap=rand --wrap=srand, so every rand() in the program - the prebuilt objects included -
+ * lands here:
+ *  - each call asks the kernel for fresh random bytes (nothing is kept, so a forked worker never repeats its
+ *    parent);
+ *  - the result keeps rand()'s range, 0 .. RAND_MAX: a caller may index a table with it, so a negative value must
+ *    never come back;
+ *  - srand() does nothing: no caller in this program needs a repeatable sequence.
+ * getrandom() is asked not to wait: before the kernel's generator is ready (early boot) /dev/urandom answers, and
+ * if that cannot be opened the C library's own rand() does - never worse than before.
+ */
+#include <errno.h>
+#include <fcntl.h>
+#include <stdlib.h>
+#include <unistd.h>
+#include <sys/random.h>
+
+int __real_rand(void);
+
+int __wrap_rand(void)
+{
+	unsigned int v = 0;
+	size_t got = 0;
+	int fd;
+
+	while (got < sizeof(v)) {
+		ssize_t n = getrandom((char *)&v + got, sizeof(v) - got, GRND_NONBLOCK);
+
+		if (n > 0)
+			got += (size_t)n;
+		else if (n < 0 && errno == EINTR)
+			continue;
+		else
+			break;
+	}
+	if (got < sizeof(v) && (fd = open("/dev/urandom", O_RDONLY | O_CLOEXEC)) >= 0) {
+		got = 0;
+		while (got < sizeof(v)) {
+			ssize_t n = read(fd, (char *)&v + got, sizeof(v) - got);
+
+			if (n > 0)
+				got += (size_t)n;
+			else if (n < 0 && errno == EINTR)
+				continue;
+			else
+				break;
+		}
+		close(fd);
+	}
+	if (got < sizeof(v))
+		return __real_rand();
+	return (int)(v & 0x7fffffffU);
+}
+
+void __wrap_srand(unsigned int seed)
+{
+	(void)seed;
+}
