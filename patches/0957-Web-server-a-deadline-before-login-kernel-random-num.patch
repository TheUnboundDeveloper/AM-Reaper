+/* One lookup through the upstream forwarder (stubby on 127.0.1.1): the root's NS set, which only an upstream can
+   answer. 1 answered, 0 not. Asked at most every 30 s whatever the page polls; it waits at most 1.5 s, and only
+   that long when the upstream leg is in fact failing. */
+static int renc_up_probe(void)
+{
+	static long last;
+	static int res = -1;
+	static const unsigned char q[] = { 0x52, 0x70, 0x01, 0x00, 0x00, 0x01, 0, 0, 0, 0, 0, 0, 0x00, 0x00, 0x02, 0x00, 0x01 };
+	unsigned char a[512];
+	struct sockaddr_in sa;
+	struct timeval tv = { 1, 500000 };
+	long now = (long)uptime();
+	int s, n;
+
+	if (res >= 0 && now - last < 30)
+		return res;
+	last = now;
+	res = 0;
+	if ((s = socket(AF_INET, SOCK_DGRAM, 0)) < 0)
+		return res;
+	memset(&sa, 0, sizeof(sa));
+	sa.sin_family = AF_INET;
+	sa.sin_port = htons(53);
+	sa.sin_addr.s_addr = htonl(0x7f000101);
+	setsockopt(s, SOL_SOCKET, SO_RCVTIMEO, &tv, sizeof(tv));
+	if (connect(s, (struct sockaddr *)&sa, sizeof(sa)) == 0 && send(s, q, sizeof(q), 0) == (ssize_t)sizeof(q)) {
+		n = recv(s, a, sizeof(a), 0);
