+/* review 2026-11-11 (B-5). The request being served was written to nvram BEFORE the login check
+ * (httpd_handle_request), so the watchdog could record it when it found httpd dead: any client's text, two nvram
+ * writes and two removals per request, and after a crash a commit of that text to flash. It is a private file now,
+ * reduced to letters, digits and . _ - / ; the watchdog reads it (rc/watchdog.c). */
+#define REAPER_REQ_NOTE	"/tmp/reaper/httpd.req"
+static void reaper_req_note(const char *u, int app)
+{
+	char b[112];
+	int n, fd;
+
+	n = snprintf(b, sizeof(b), "%d ", app ? 1 : 0);
+	for (; *u && n < (int)sizeof(b) - 2; u++)
+		b[n++] = (isalnum((unsigned char)*u) || strchr("._-/", *u)) ? *u : '_';
+	b[n++] = '\n';
+	if ((fd = open(REAPER_REQ_NOTE, O_WRONLY | O_CREAT | O_TRUNC | O_NOFOLLOW | O_CLOEXEC, 0600)) >= 0) {
+		if (write(fd, b, n) != n)
+			unlink(REAPER_REQ_NOTE);
+		close(fd);
+	}
+}
+/* review 2026-11-11 (B-3). This web server handles one connection at a time. Each read had a 5 s timeout, but
+ * nothing bounded the whole request: a client that sent one byte every 4 s (or stalled the TLS handshake, or read
+ * the answer one byte at a time) held the interface for everybody until the watchdog restarted httpd minutes later.
+ * A connection now has REAPER_CONN_PREAUTH seconds to get past the login check. A timer of its own (SIGALRM belongs
+ * to check_alive) shuts the socket down when they run out: the read or write the request is blocked in ends, and
+ * the request unwinds the normal way. The timer is switched off the moment the login check passes, so uploads,
+ * firmware flashes and long pages are never cut, and on a router that is not set up yet (no password to pass). */
+#define REAPER_CONN_PREAUTH	15
+static volatile sig_atomic_t reaper_conn_fd = -1;
+/* The kernel's own POSIX timer, called by number. libshared exports a user-space timer_create() / timer_settime()
+ * (shared/linux_timer_ax.c) that take the place of the C library's in every program linked with it; that
+ * timer_create() calls exit(1) for any clock but CLOCK_REALTIME, so through those names httpd quit on its first
+ * connection (test image _r14). The kernel's id is an int. */
+#include <sys/syscall.h>
+static int reaper_conn_timer;
+static int reaper_conn_timer_ok;
+
+static void reaper_conn_expired(int sig)
+{
+	int fd = reaper_conn_fd;
+
+	(void)sig;
+	if (fd >= 0)
+		shutdown(fd, SHUT_RDWR);
+}
+
+static void reaper_conn_deadline_set(int secs)
+{
+	struct itimerspec its;
+
+	if (!reaper_conn_timer_ok)
+		return;
+	memset(&its, 0, sizeof(its));
+	its.it_value.tv_sec = secs;
+	syscall(SYS_timer_settime, reaper_conn_timer, 0, &its, NULL);
+}
+
+static void reaper_conn_deadline_on(int fd, int secs)
+{
+	if (!reaper_conn_timer_ok) {
+		struct sigaction sa;
+		struct sigevent ev;
+
+		memset(&sa, 0, sizeof(sa));
+		sa.sa_handler = reaper_conn_expired;
+		sa.sa_flags = SA_RESTART;
+		sigemptyset(&sa.sa_mask);
+		memset(&ev, 0, sizeof(ev));
+		ev.sigev_notify = SIGEV_SIGNAL;
+		ev.sigev_signo = SIGRTMIN + 3;
+		if (sigaction(SIGRTMIN + 3, &sa, NULL) != 0 || syscall(SYS_timer_create, CLOCK_MONOTONIC, &ev, &reaper_conn_timer) != 0)
+			return;
+		reaper_conn_timer_ok = 1;
+	}
+	reaper_conn_fd = fd;
+	reaper_conn_deadline_set(secs);
+}
+
+static void reaper_conn_deadline_off(void)
+{
+	reaper_conn_fd = -1;
+	reaper_conn_deadline_set(0);
+}
+/* reaper-conn-deadline: end */
