@@ -188,19 +188,12 @@
  * marker, so boxes that already took the ipdeny seed still get this one once. */
 #define RW_ABUSECH_IPS  "151.101.2.49 151.101.66.49 151.101.130.49 151.101.194.49"
 #define RW_SEED_MARK_ABUSECH REAPER_RW_DIR "/.seed_abusech"
-/* The ASUS DDNS server and the Let's Encrypt API, seeded the same way but only once
- * the feature that needs them is in use (owner, 2026-10-22, field reports of a
- * certificate stuck on "Unknown or processing..."). A Let's Encrypt certificate for
- * an asuscomm name IS a DDNS update (acme.sh's dns_asusapi hook publishes the
- * challenge through ns1.asuscomm.com and waits 60 s for it), and both hosts sit in
- * the USA country list (ipdeny: 52.224.0.0/11, 172.64.0.0/13), so the router-traffic
- * filter with US selected dropped both and the certificate never came. One address
