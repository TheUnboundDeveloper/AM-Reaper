From 253fb9e796113a23f1c83daa382e1b6e136de040 Mon Sep 17 00:00:00 2001
From: reaper <theunbounddeveloper@outlook.com>
Date: Fri, 6 Nov 2026 17:29:45 -0500
Subject: [PATCH] Security Review: /tmp and /var folders; rc makes Samba's and
 Stubby's folders 0755 (102.8 line)

- The world-writable check also lists folders under /tmp and /var that any user may write and that
  are not sticky: two levels, symlinked folders not followed, nothing under the USB mount points.
  Its own count and text on the Firewall > Status card and the dashboard bar (these are made at
  every start, so the /jffs wording 'the next reboot removes it' would be wrong).
- The first read of a router found six, all made 0777 by rc at every start through mkdir_if_none
  (it forces 0777): /etc/samba, /var/run, /var/log, /var/lib and /var/cache samba, and
  /etc/stubby. Only root uses them (smbd, nmbd and stubby are started by rc as root, rc writes
  their configs); rc now takes each to 0755 right after making it - Samba's own install mode. The
  helper itself (45 callers, USB share folders among them) is unchanged.
Main_ReaperDash.asp also carries the clock fix of the UI commit (fixed-width digit cells).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 release/src/router/rc/rwatch.c             | 25 +++++++++++++++++++---
 release/src/router/rc/sdn.c                |  1 +
 release/src/router/rc/services.c           |  1 +
 release/src/router/rc/usb.c                |  7 ++++++
 release/src/router/www/Main_ReaperDash.asp |  9 +++++---
 release/src/router/www/Reaper_Firewall.asp |  6 ++++++
 6 files changed, 43 insertions(+), 6 deletions(-)

diff --git a/release/src/router/rc/rwatch.c b/release/src/router/rc/rwatch.c
index bf81015d7f3..01e5c9e41da 100644
--- a/release/src/router/rc/rwatch.c
+++ b/release/src/router/rc/rwatch.c
@@ -261,7 +261,7 @@ static void rwatch_gen(void)
 	  "# line is whatever was typed): backslash and quote escaped, control bytes stripped by the\n"
 	  "# caller; the page renders with textContent only. Changes first, baseline rows after, 200 max.\n"
 	  "_rv_json() {\n"
-	  "  awk -F'\t' -v armed=\"$1\" -v ts=\"$(date +%s)\" -v AUTHF=\"$RV_TMP/review.auth\" -v WWF=\"$RV_TMP/review.ww\" '\n"
+	  "  awk -F'\t' -v armed=\"$1\" -v ts=\"$(date +%s)\" -v AUTHF=\"$RV_TMP/review.auth\" -v WWF=\"$RV_TMP/review.ww\" -v WWT=\"$RV_TMP/review.wwt\" '\n"
 	  "    function esc(s) { gsub(/\\\\/, \"\\\\\\\\&\", s); gsub(/\"/, \"\\\\\\\\&\", s); return s }\n"
 	  "    function item() { return \"{\\\"t\\\":\\\"\" $2 \"\\\",\\\"k\\\":\\\"\" esc($3) \"\\\",\\\"st\\\":\\\"\" $1 \"\\\",\\\"v\\\":\\\"\" esc($4) \"\\\"}\" }\n"
 	  "    $2==\"T\" { tr=1; next }\n"
@@ -284,7 +284,9 @@ static void rwatch_gen(void)
 	   * _rv_ww - its own fields, because the pages word notices_n as failed logins */
 	  "      ww=0; wp=\"\"\n"
 	  "      if ((getline line < WWF) > 0) { split(line, f, \" \"); if (f[1]==\"ww\") { ww=f[2]+0; wp=substr(line, length(f[1]) + length(f[2]) + 3) } }\n"
-	  "      printf \"],\\\"notices_n\\\":%d,\\\"ww\\\":%d,\\\"ww_p\\\":\\\"%s\\\"}\\n\", m, ww, esc(wp)\n"
+	  "      wwt_n=0; wwt_s=\"\"\n"
+	  "      if ((getline line < WWT) > 0) { split(line, f, \" \"); if (f[1]==\"wwt\") { wwt_n=f[2]+0; wwt_s=substr(line, length(f[1]) + length(f[2]) + 3) } }\n"
+	  "      printf \"],\\\"notices_n\\\":%d,\\\"ww\\\":%d,\\\"ww_p\\\":\\\"%s\\\",\\\"wwt\\\":%d,\\\"wwt_p\\\":\\\"%s\\\"}\\n\", m, ww, esc(wp), wwt_n, esc(wwt_s)\n"
 	  "    }'\n"
 	  "}\n"
 	  /* 2026-10-20 (field, RT-BE88U): rc removes write-for-everyone from every file and
@@ -296,6 +298,12 @@ static void rwatch_gen(void)
 	   * firmware's busybox find has no -type, -perm or -xdev (r1 metal: a find-based
 	   * first version read 0 with a 0666 file planted); -a includes the hidden files,
 	   * the 9th mode character is the other-write bit, a trailing t/T is sticky. */
+	  /* 2026-11-06 (audit C-8): folders under /tmp and /var that any user may write and that lack the
+	   * sticky bit (review 2026-11-03 C-1: a nobody process could hold rc's lock, redirect a mount or plant
+	   * a file a root daemon trusts). Folders only - stock files there churn. Two levels; a symlinked
+	   * folder is not followed and nothing under /tmp/mnt (the USB mount points) is listed, so a USB disk
+	   * is never walked. Own count (wwt): stock creates these at every start, so the /jffs wording
+	   * ("the next reboot removes it") would be wrong. RV_WWT_ROOTS is for the tests. */
 	  "_rv_ww() {\n"
 	  /* 2026-11-05 (audit): closed programs write these 0666 (nt_center's pid file, the diag databases); nothing
 	   * but root (their owner) reads them - other-write comes off on every tick. And the long-term store base
@@ -312,6 +320,17 @@ static void rwatch_gen(void)
 	  "  else\n"
 	  "    rm -f $RV_TMP/review.ww $RV_TMP/ww.said\n"
 	  "  fi\n"
+	  "  for _r in ${RV_WWT_ROOTS:-/tmp /var}; do [ -d \"$_r\" ] || continue; echo \"$_r:\"; ls -lan \"$_r/\"; for _d in \"$_r\"/*; do [ -d \"$_d\" ] && [ ! -L \"$_d\" ] && [ \"$_d\" != \"$_r/mnt\" ] && { echo \"$_d:\"; ls -lan \"$_d/\"; }; done; done 2>/dev/null | awk '/^\\/.*:$/ { d=substr($0, 1, length($0)-1); next } ($1 ~ /^d.......w/ && $1 !~ /[tT]$/) { n=$0; for (i=1;i<=8;i++) sub(/^[^ ]+ +/, \"\", n); if (n==\".\" || n==\"..\") next; print d \"/\" n }' | head -n 100 > $RV_TMP/wwt.lst\n"
+	  "  _tn=$(wc -l < $RV_TMP/wwt.lst | tr -d ' ')\n"
+	  "  if [ \"${_tn:-0}\" -gt 0 ]; then\n"
+	  "    _tp=$(head -n 1 $RV_TMP/wwt.lst | tr -d '\\000-\\037\\177')\n"
+	  "    printf 'wwt %s %s\\n' \"$_tn\" \"$_tp\" > $RV_TMP/review.wwt\n"
+	  "    [ \"$_tn\" = \"$(cat $RV_TMP/wwt.said 2>/dev/null)\" ] || logger -t rwatch \"security review: $_tn folder(s) under /tmp or /var are writable by any user and not sticky (first: $_tp) - a compromised non-root service could place or replace files there; they are created that way at every start\"\n"
+	  "    echo \"$_tn\" > $RV_TMP/wwt.said\n"
+	  "  else\n"
+	  "    rm -f $RV_TMP/review.wwt $RV_TMP/wwt.said\n"
+	  "  fi\n"
+	  "  rm -f $RV_TMP/wwt.lst\n"
 	  "  rm -f $RV_TMP/ww.lst\n"
 	  "  return 0\n"
 	  "}\n"
@@ -355,7 +374,7 @@ static void rwatch_gen(void)
 	  "  return 0\n"
 	  "}\n"
 	  "_rv_run() {\n"
-	  "  if [ \"$(_nv rwatch_review)\" != 1 ]; then rm -f $RV_TMP/review.json $RV_TMP/review.last $RV_TMP/review.inv $RV_TMP/review.diff $RV_TMP/review.auth $RV_TMP/auth.cur $RV_TMP/auth.seen $RV_TMP/review.ww $RV_TMP/ww.said 2>/dev/null; return 0; fi\n"
+	  "  if [ \"$(_nv rwatch_review)\" != 1 ]; then rm -f $RV_TMP/review.json $RV_TMP/review.last $RV_TMP/review.inv $RV_TMP/review.diff $RV_TMP/review.auth $RV_TMP/auth.cur $RV_TMP/auth.seen $RV_TMP/review.wwt $RV_TMP/wwt.said $RV_TMP/review.ww $RV_TMP/ww.said 2>/dev/null; return 0; fi\n"
 	  "  _rv_inv > $RV_TMP/review.inv.tmp 2>/dev/null && mv -f $RV_TMP/review.inv.tmp $RV_TMP/review.inv || return 0\n"
 	  "  _rv_auth\n"
 	  "  _rv_ww\n"
diff --git a/release/src/router/rc/sdn.c b/release/src/router/rc/sdn.c
index 31354a5f785..afb648aeda0 100644
--- a/release/src/router/rc/sdn.c
+++ b/release/src/router/rc/sdn.c
@@ -388,6 +388,7 @@ void _start_sdn_stubby(const MTLAN_T *pmtl, char *config_file, const size_t path
 	unlink(buf);
 
 	mkdir_if_none("/etc/stubby");
+	chmod("/etc/stubby", 0755);	/* reaper 2026-11-06: mkdir_if_none forces 0777; rc writes the configs, stubby runs as root */
 
 	// create /etc/stubby/stubby-<subnet_idx>.yml
 	snprintf(config_file, path_len, "/etc/stubby/stubby-%d.yml", pmtl->nw_t.idx);
diff --git a/release/src/router/rc/services.c b/release/src/router/rc/services.c
index 7e6d222ea65..44b6ffa39bd 100644
--- a/release/src/router/rc/services.c
+++ b/release/src/router/rc/services.c
@@ -2803,6 +2803,7 @@ void start_stubby(void)
 	stop_stubby();
 
 	mkdir_if_none("/etc/stubby");
+	chmod("/etc/stubby", 0755);	/* reaper 2026-11-06: mkdir_if_none forces 0777; rc writes the configs, stubby runs as root */
 
 	if ((fp = fopen(stubby_config, "w")) == NULL)
 		return;
diff --git a/release/src/router/rc/usb.c b/release/src/router/rc/usb.c
index 07985cba48a..f964888546d 100644
--- a/release/src/router/rc/usb.c
+++ b/release/src/router/rc/usb.c
@@ -3742,6 +3742,13 @@ start_samba(void)
 	   0700 (secrets.tdb, the messaging sockets) and never re-checks it, so hold it there
 	   on every start. /var is tmpfs: nothing of a user's is touched. */
 	chmod("/var/lib/samba/private", 0700);
+	/* reaper 2026-11-06 (Security Review, /tmp and /var check): mkdir_if_none forces 0777; only root uses
+	   these (smbd/nmbd run as root, rc writes the configs), and 0755 is Samba's own install mode */
+	chmod("/etc/samba", 0755);
+	chmod("/var/run/samba", 0755);
+	chmod("/var/log/samba", 0755);
+	chmod("/var/lib/samba", 0755);
+	chmod("/var/cache/samba", 0755);
 #endif
 
 	unlink("/etc/smb.conf");
