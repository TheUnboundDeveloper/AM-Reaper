    the rail gets. margin-top:auto alone pins it to the foot of the RAIL, and the
@@ -509,10 +511,11 @@ main{min-width:0}
       /* the posture row paints from this same report (paintReview lives in the main block) */
       window.RVJ=j; if(typeof paintReview==='function')paintReview();
       /* drift needs an accepted baseline; a failed-login burst (notices_n) does not */
-      var u=(j&&j.ok&&j.armed)?(j.unreviewed||0):0, nn=(j&&j.ok)?(j.notices_n||0):0, ww=(j&&j.ok)?(j.ww||0):0, t=[];
+      var u=(j&&j.ok&&j.armed)?(j.unreviewed||0):0, nn=(j&&j.ok)?(j.notices_n||0):0, ww=(j&&j.ok)?(j.ww||0):0, wwt=(j&&j.ok)?(j.wwt||0):0, t=[];
       if(u>0)t.push(`<#RDSH_104#>`.replace('%1',u));
       if(nn>0)t.push(`<#RDSH_106#>`.replace('%1',nn));
       if(ww>0)t.push(`<#RDSH_117#>`.replace('%1',ww));
+      if(wwt>0)t.push(`<#RDSH_119#>`.replace('%1',wwt));
       if(t.length){txt.textContent=t.join(' - ');bar.className='rvb on';}
       else bar.className='rvb';
     };
@@ -525,7 +528,7 @@ main{min-width:0}
 
   <!-- LEFT RAIL (always expanded; menu mirrors the current firmware) -->
   <aside class="rail">
-    <div class="railclock"><div class="rc-time" id="rc_time">--:--:--</div><div class="rc-date" id="rc_date">&mdash;</div></div>
+    <div class="railclock"><div class="rc-time" id="rc_time"><b class="rd">-</b><b class="rd">-</b>:<b class="rd">-</b><b class="rd">-</b>:<b class="rd">-</b><b class="rd">-</b></div><div class="rc-date" id="rc_date">&mdash;</div></div>
     <script>var RP_CLK={seed:"<% uptime(); %>",dw:[`<#date_Sun_itemdesc#>`,`<#date_Mon_itemdesc#>`,`<#date_Tue_itemdesc#>`,`<#date_Wed_itemdesc#>`,`<#date_Thu_itemdesc#>`,`<#date_Fri_itemdesc#>`,`<#date_Sat_itemdesc#>`],mo:[`<#Reaper_c_mon_0#>`,`<#Reaper_c_mon_1#>`,`<#Reaper_c_mon_2#>`,`<#Reaper_c_mon_3#>`,`<#Reaper_c_mon_4#>`,`<#Reaper_c_mon_5#>`,`<#Reaper_c_mon_6#>`,`<#Reaper_c_mon_7#>`,`<#Reaper_c_mon_8#>`,`<#Reaper_c_mon_9#>`,`<#Reaper_c_mon_10#>`,`<#Reaper_c_mon_11#>`]};</script><script src="/js/reaper_clock.js"></script>
     <div class="raillang"><span class="raillbl"><#Reaper_c_language#>:</span><select class="raillangsel" id="select_lang" title="<#Reaper_c_language#>" aria-label="<#Reaper_c_language#>"></select></div>
 
@@ -1213,7 +1216,7 @@ function paintReview(){
     /* no report yet: after a boot the first check can take up to 10 minutes -
