+	case 0x2060: return "a word joiner";
+	case 0xfeff: return "a byte-order mark";
+	case 0x00a0: return "a no-break space";
+	case 0x00ad: return "a soft hyphen";
+	case 0x200e: case 0x200f: return "a direction mark";
+	case 0x202a: case 0x202b: case 0x202c: case 0x202d: case 0x202e: return "a direction override";
+	case 0x2066: case 0x2067: case 0x2068: case 0x2069: return "a direction isolate";
+	case 0x2028: case 0x2029: return "a line separator";
+	case 0x3000: case 0x202f: case 0x205f: return "a wide space";
+	case 0xfffd: return "a broken UTF-8 byte";
+	default:
+		if (c >= 0x2000 && c <= 0x200a)
+			return "a typographic space";
+		return "a non-ASCII character";
+	}
+}
+
+/* the report's copy of a line: hidden and non-ASCII characters as <U+XXXX>, control characters as ? */
+static void adv_disp(const char *in, char *out, size_t osz)
+{
+	const unsigned char *s = (const unsigned char *)in;
+	size_t o = 0;
+
+	while (*s && o + 12 < osz) {
+		if (*s >= 0x80) {
+			int l;
+			unsigned long c = adv_utf8(s, &l);
+			o += (size_t)snprintf(out + o, osz - o, "<U+%04lX>", c);
+			s += l;
+		} else {
+			out[o++] = (*s < 0x20 || *s == 0x7f) ? '?' : (char)*s;
+			s++;
+		}
+	}
+	if (*s && o + 4 < osz) {
+		memcpy(out + o, "...", 3);
+		o += 3;
+	}
+	out[o] = 0;
+}
+
+static void adv_report(struct adv_out *o, unsigned long ln, const char *raw, const char *why, int warn)
+{
+	char buf[400];
+
+	if (warn)
+		o->warn++;
+	else
+		o->unsup++;
+	if (o->nreport >= ADV_MAX_REPORT)
+		return;
+	{	/* ~120 characters shown, hidden ones made visible; the line's own end is not part of it */
+		char t[LINE_MAX_];
+		size_t n;
+		snprintf(t, sizeof(t), "%s", raw);
+		n = strlen(t);
+		while (n && (t[n - 1] == '\n' || t[n - 1] == '\r'))
+			t[--n] = 0;
+		adv_disp(t, buf, 160);
+	}
+	fprintf(o->js, "%s{\"line\":%lu,\"kind\":\"%s\",\"text\":", o->nreport++ ? "," : "", ln, warn ? "warn" : "skip");
+	json_str(o->js, buf);
+	fprintf(o->js, ",\"why\":");
+	json_str(o->js, why);
+	fprintf(o->js, "}");
+}
+
+/* one client= / ctag= token -> members appended to m (" mac x" / " ip y"); 0 = nothing resolvable */
+static int adv_member(const char *tok, int ctag, char *m, size_t msz)
+{
+	char t[128], key[144];
+	size_t i, n;
+	int found = 0;
+
+	n = strlen(tok);
+	if (n >= sizeof(t) || !n)
+		return 0;
+	strcpy(t, tok);
+	if ((t[0] == '\'' || t[0] == '"') && n >= 2 && t[n - 1] == t[0]) {
+		t[n - 1] = 0;
+		memmove(t, t + 1, n - 1);
+	}
+	if (!ctag && adv_is_mac(t)) {
+		for (i = 0; t[i]; i++)
+			t[i] = t[i] == '-' ? ':' : (char)tolower((unsigned char)t[i]);
+		snprintf(m + strlen(m), msz - strlen(m), " mac %s", t);
+		return 1;
+	}
+	if (!ctag && adv_is_cidr(t)) {
+		snprintf(m + strlen(m), msz - strlen(m), " ip %s", t);
+		return 1;
+	}
+	snprintf(key, sizeof(key), "%s%s", ctag ? "profile:" : "", t);
+	for (i = 0; key[i]; i++)
+		key[i] = (char)tolower((unsigned char)key[i]);
+	for (i = 0; i < nadvmap; i++)
+		if (!strcmp(advmap[i].name, key) && strlen(m) + 24 < msz) {
+			snprintf(m + strlen(m), msz - strlen(m), " mac %s", advmap[i].mac);
+			found = 1;
+		}
+	return found;
+}
+
+/* "a|b|~c" -> scope id (or -1 = none given), *neg set when every token is ~; why on failure */
+static int adv_scope(struct adv_out *o, char *val, int ctag, int *neg, const char **why, char *unres, size_t usz)
+{
+	char m[512] = "", *tok;
+	int pos = 0, ng = 0, i, cnt = 0;
+
+	/* split on |, and on blanks outside quotes ('Nate PC' stays one name) */
+	for (tok = val; *tok; ) {
+		char *s = tok, q = 0;
+		int isneg;
+		while (*tok && (q || (*tok != '|' && *tok != ' ' && *tok != '\t'))) {
+			if (!q && (*tok == '\'' || *tok == '"'))
+				q = *tok;
+			else if (q && *tok == q)
+				q = 0;
+			tok++;
+		}
+		if (*tok)
+			*tok++ = 0;
+		if (!*s)
+			continue;
+		isneg = s[0] == '~';
+		if (isneg)
+			s++, ng++;
+		else
+			pos++;
+		cnt++;
+		if (!adv_member(s, ctag, m, sizeof(m)))
+			snprintf(unres + strlen(unres), usz - strlen(unres), "%s%s", *unres ? ", " : "", s);
+	}
+	if (!cnt)
+		return *why = "empty client list", -2;
+	if (pos && ng)
+		return *why = "a client list mixes ~ and plain entries", -2;
+	*neg = ng > 0;
+	if (!m[0])
+		return *why = ctag ? "no device has that profile" : "no such device (name, address or MAC)", -3;
+	for (i = 0; i < o->nscope; i++)
+		if (!strcmp(o->scopes[i], m))
+			return i;
+	if (o->nscope >= ADV_MAX_SCOPES)
+		return *why = "too many different client lists", -2;
+	strcpy(o->scopes[o->nscope], m);
+	return o->nscope++;
+}
+
+static int adv_types_of(char *val, char *out, size_t osz, int *neg)
+{
+	char *tok, *save;
+	int pos = 0, ng = 0, i;
+
+	out[0] = 0;
+	for (tok = strtok_r(val, "|", &save); tok; tok = strtok_r(NULL, "|", &save)) {
+		int isneg = tok[0] == '~', t = 0;
+		if (isneg)
+			tok++, ng++;
+		else
+			pos++;
+		for (i = 0; adv_types[i].n; i++)
+			if (!strcasecmp(adv_types[i].n, tok))
+				t = adv_types[i].t;
+		if (!t)
+			return -1;
+		snprintf(out + strlen(out), osz - strlen(out), "%s%d", out[0] ? "," : "", t);
+	}
+	if (!pos && !ng)
+		return -1;
+	if (pos && ng)
+		return -1;
+	*neg = ng > 0;
+	return 0;
+}
+
+#define ADV_SKIP(w)	do { adv_report(o, ln, raw, (w), 0); return; } while (0)
+#define ADV_WARN(w)	do { adv_report(o, ln, raw, (w), 1); return; } while (0)
+static void adv_line(struct adv_out *o, char *raw, unsigned long ln, char **safe, size_t nsafe)
+{
+	char line[LINE_MAX_], rxbuf[260], *p, *e, *mods = NULL, *pat, kind = 'n', flags[8] = "", scope[16] = "-",
+	     qt[128] = "-", unres[160] = "";
+	const char *resp = "-", *why = NULL;
+	int allow = 0, important = 0, subtree = 1, i;
+
+	snprintf(line, sizeof(line), "%s", raw);
+	for (p = line; *p == ' ' || *p == '\t'; p++)
+		;
+	for (e = p + strlen(p); e > p && (e[-1] == '\r' || e[-1] == '\n' || e[-1] == ' ' || e[-1] == '\t'); e--)
+		*(e - 1) = 0;
+	if (!strncmp(p, "\xef\xbb\xbf", 3))
+		p += 3;	/* a byte-order mark at the start of a line: a file artifact */
+	if (!*p || *p == '!' || *p == '#' || *p == '[')
+		return;
+	o->total++;
+	/* " # comment" after a rule (a regex keeps its #s) */
+	if (*p != '/' && (e = strstr(p, " #")))
+		*e = 0, e = p + strlen(p);
+	while (e > p && (e[-1] == ' ' || e[-1] == '\t'))
+		*--e = 0;
+	/* 2026-11-06 (owner): a rule is ASCII - an invisible character would make it never match, silently */
+	{
+		const unsigned char *u;
+		int ch = 0;
+		for (u = (const unsigned char *)p; *u; u++) {
+			if ((*u & 0xc0) != 0x80)
+				ch++;
+			if (*u >= 0x80) {
+				char w[200];
+				int l;
+				unsigned long c = adv_utf8(u, &l);
+				snprintf(w, sizeof(w), "%s (U+%04lX) at character %d - retype the line; a name with non-ASCII letters needs its xn-- form",
+					 adv_cpname(c), c, ch);
+				ADV_SKIP(w);
+			}
+		}
+	}
+	if (!strncmp(p, "@@", 2))
+		allow = 1, p += 2;
+
+	/* split the modifiers off: after the regex's closing slash, else at the first $ */
+	if (*p == '/') {
+		char *c = strrchr(p, '/');
+		if (c == p)
+			ADV_SKIP("a regex needs a closing /");
+		if (c[1] == '$')
+			mods = c + 2;
+		else if (c[1])
+			ADV_SKIP("text after a regex");
+		c[1] = 0;
+		kind = 'r';
+	} else if ((e = strchr(p, '$'))) {
+		*e = 0;
+		mods = e + 1;
+	}
+	pat = p;
+
+	if (mods && *mods) {
+		char *m, *save;
+		for (m = strtok_r(mods, ",", &save); m; m = strtok_r(NULL, ",", &save)) {
+			char *v = strchr(m, '=');
+			if (v)
+				*v++ = 0;
+			if (!strcmp(m, "important") && !v)
+				important = 1;
+			else if ((!strcmp(m, "client") || !strcmp(m, "ctag")) && v && *v) {
+				int neg = 0, id;
+				if (strcmp(scope, "-"))
+					ADV_SKIP("client and ctag together");
+				id = adv_scope(o, v, m[1] == 't', &neg, &why, unres, sizeof(unres));
+				if (id == -2)
+					ADV_SKIP(why);
+				if (id == -3) {
+					char w[240];
+					snprintf(w, sizeof(w), "%s: %s - left out until it exists", why, unres);
+					ADV_WARN(w);
+				}
+				snprintf(scope, sizeof(scope), "%s%d", neg ? "!" : "", id);
+				if (unres[0]) {
+					char w[240];
+					snprintf(w, sizeof(w), "not found, ignored in this rule: %s", unres);
+					adv_report(o, ln, raw, w, 1);
+				}
+			} else if (!strcmp(m, "dnstype") && v && *v) {
+				int neg = 0;
+				char tmp[120];
+				if (adv_types_of(v, tmp, sizeof(tmp), &neg))
+					ADV_SKIP("unknown dnstype");
+				snprintf(qt, sizeof(qt), "%s%s", neg ? "!" : "", tmp);
+			} else if (!strcmp(m, "dnsrewrite")) {
+				if (allow)
+					;	/* @@...$dnsrewrite: exempt from rewrites = an allow here */
+				else if (!v || !*v)
+					ADV_SKIP("dnsrewrite needs a value");
+				else if (!strcasecmp(v, "NOERROR"))
+					resp = "nodata";
+				else if (!strcasecmp(v, "NXDOMAIN"))
+					resp = "nx";
+				else if (!strcasecmp(v, "REFUSED"))
+					resp = "refused";
+				else if (!strcmp(v, "0.0.0.0") || !strcmp(v, "::"))
+					resp = "null";
+				else
+					ADV_SKIP("dnsrewrite to an address: use the DNS rewrites table");
+			} else
+				ADV_SKIP("modifier not supported here");
+		}
+	}
+
+	if (kind != 'r') {
+		size_t n;
+		int start2 = !strncmp(pat, "||", 2), start1 = !start2 && pat[0] == '|';
+		if (start2)
+			pat += 2;
+		else if (start1)
+			pat += 1, subtree = 0;
+		else if (strpbrk(pat, " \t")) {	/* hosts line: an address, then one name */
+			char first[64], *sp = pat + strcspn(pat, " \t");
+			snprintf(first, sizeof(first), "%.*s", (int)(sp - pat), pat);
+			if (!is_ip(first))
+				ADV_SKIP("not a DNS name rule");
+			sp += strspn(sp, " \t");
+			if (!*sp || strpbrk(sp, " \t"))
+				ADV_SKIP("one name per hosts line here");
+			pat = sp;
+			subtree = 0;
+		}
+		n = strlen(pat);
+		if (n && pat[n - 1] == '|')
+			pat[--n] = 0;
+		if (n && pat[n - 1] == '^')
+			pat[--n] = 0;
+		else if ((start2 || start1) && n && pat[n - 1] == '.') {
+			/* ||name. = name followed by any ending (another TLD) */
+			if (n + 2 > 250)
+				ADV_SKIP("too long");
+			pat[n++] = '*';
+			pat[n] = 0;
+			kind = 'g';
+		}
+		if (!strncmp(pat, "*.", 2) && !strchr(pat + 2, '*'))
+			pat += 2;	/* ||*.name^ : name's subdomains (and, here, name) */
+		if (strpbrk(pat, "|^$/ \t"))
+			ADV_SKIP("not a DNS name rule");
+		if (strchr(pat, '*') || strchr(pat, '?'))
+			kind = 'g';
+		for (e = pat; *e; e++)
+			*e = (char)tolower((unsigned char)*e);
+		if (kind == 'n' && norm(pat))
+			ADV_SKIP("not a valid name");
+		if (kind == 'g') {
+			for (e = pat; *e; e++)
+				if (!((*e >= 'a' && *e <= 'z') || (*e >= '0' && *e <= '9') || strchr(".-_*?", *e)))
+					ADV_SKIP("not a valid name pattern");
+			if (strlen(pat) > 250)
+				ADV_SKIP("too long");
+		}
+	} else {
+		regex_t re;
+		size_t n = strlen(pat);
+		char *rx = rxbuf;
+		if (n < 3 || n - 2 >= sizeof(rxbuf))
+			ADV_SKIP("regex too long");
+		memcpy(rx, pat + 1, n - 2);
+		rx[n - 2] = 0;
+		if (strpbrk(rx, " \t"))
+			ADV_SKIP("a space in a regex");
+		if (regcomp(&re, rx, REG_EXTENDED | REG_ICASE | REG_NOSUB))
+			ADV_SKIP("regex does not compile (POSIX extended syntax)");
+		regfree(&re);
+		pat = rx;
+	}
+
+	if (kind == 'g' && o->nglob >= ADV_MAX_GLOB)
+		ADV_SKIP("too many wildcard rules (512)");
+	if (kind == 'r' && o->nre >= ADV_MAX_RE)
+		ADV_SKIP("too many regex rules (64)");
+	if (o->kept >= ADV_MAX_RULES)
+		ADV_SKIP("too many rules (20000)");
+
+	/* a block may not take a name the router itself needs (the safe set: NTP, DoT, DDNS, list hosts ...) */
+	if (!allow && kind == 'n')
+		for (i = 0; i < (int)nsafe; i++) {
+			size_t a = strlen(safe[i]), b = strlen(pat);
+			if (!strcmp(safe[i], pat) || (subtree && a > b && safe[i][a - b - 1] == '.' && !strcmp(safe[i] + a - b, pat)))
+				ADV_SKIP("would block a name the router itself needs");
+		}
+
+	snprintf(flags, sizeof(flags), "%s%s%s", allow ? "a" : "b", important ? "i" : "", subtree ? "s" : "x");
+	fprintf(o->rules, "rule %s %s %s %s %c %s %lu\n", flags, scope, qt, resp, kind, pat, ln);
+	o->kept++;
+	if (allow) o->allow++; else o->block++;
+	if (important) o->important++;
+	if (strcmp(scope, "-")) o->scoped++;
+	if (strcmp(qt, "-")) o->typed++;
+	if (kind == 'g') o->nglob++;
+	if (kind == 'r') o->nre++;
+}
+
+static int cmd_adv(int argc, char **argv)
+{
+	const char *in = NULL, *out = NULL, *stats = NULL, *clients = NULL, *safef = NULL;
+	char tmp[512], tmps[512], line[LINE_MAX_], **safe = NULL;
+	size_t nsafe = 0;
+	unsigned long ln = 0;
+	struct adv_out o;
+	FILE *f, *of;
+	int i;
+
+	for (i = 2; i < argc; i++) {
+		const char *a = argv[i];
+		if (i + 1 >= argc)
+			goto usage;
+		if (!strcmp(a, "--in")) in = argv[++i];
+		else if (!strcmp(a, "--out")) out = argv[++i];
+		else if (!strcmp(a, "--stats")) stats = argv[++i];
+		else if (!strcmp(a, "--clients")) clients = argv[++i];
+		else if (!strcmp(a, "--safe")) safef = argv[++i];
+		else goto usage;
+	}
+	if (!in || !out || !stats)
+		goto usage;
+	memset(&o, 0, sizeof(o));
+	adv_load_map(clients);
+	if (safef && (f = fopen(safef, "r"))) {
+		while (fgets(line, sizeof(line), f)) {
+			line[strcspn(line, " \t\r\n")] = 0;
+			if (!line[0] || line[0] == '#' || norm(line))
+				continue;
+			safe = xrealloc(safe, (nsafe + 1) * sizeof(*safe));
+			safe[nsafe++] = strdup(line);
+		}
+		fclose(f);
+	}
+	snprintf(tmp, sizeof(tmp), "%s.rules.tmp", out);
+	snprintf(tmps, sizeof(tmps), "%s.tmp", stats);
+	if (!(o.rules = fopen(tmp, "w+")) || !(o.js = fopen(tmps, "w"))) {
+		fprintf(stderr, "wallguardc: cannot write %s\n", out);
+		return 1;
+	}
+	fprintf(o.js, "{\"lines\":[");
+	if ((f = fopen(in, "r"))) {
+		while (fgets(line, sizeof(line), f)) {
+			size_t n = strlen(line);
+			ln++;
+			if (n == sizeof(line) - 1 && line[n - 1] != '\n') {
+				int c;
+				while ((c = fgetc(f)) != EOF && c != '\n')
+					;
+				adv_report(&o, ln, "(line longer than 4095 characters)", "too long", 0);
+				continue;
+			}
+			adv_line(&o, line, ln, safe, nsafe);
+		}
+		fclose(f);
+	}
+	/* the real file: header, scopes, then the rules (rename - the engine maps what it finds) */
+	snprintf(line, sizeof(line), "%s.tmp", out);
+	if (!(of = fopen(line, "w")))
+		return 1;
+	fprintf(of, "WGADV 1\n");
+	for (i = 0; i < o.nscope; i++) {
+		char m[512], *t, *save, *kindw;
+		snprintf(m, sizeof(m), "%s", o.scopes[i]);
+		for (kindw = strtok_r(m, " ", &save); kindw && (t = strtok_r(NULL, " ", &save)); kindw = strtok_r(NULL, " ", &save))
+			if (o.nmemb++ < ADV_MAX_MEMB)
+				fprintf(of, "scope %d %s %s\n", i, kindw, t);
+	}
+	rewind(o.rules);
+	{
+		char buf[8192];
+		size_t r;
+		while ((r = fread(buf, 1, sizeof(buf), o.rules)) > 0)
+			fwrite(buf, 1, r, of);
+	}
+	fclose(o.rules);
+	unlink(tmp);
+	if (fclose(of) || rename(line, out)) {
+		fprintf(stderr, "wallguardc: cannot write %s\n", out);
+		return 1;
+	}
+	fprintf(o.js, "],\"total\":%lu,\"kept\":%lu,\"allow\":%lu,\"block\":%lu,\"important\":%lu,\"scoped\":%lu,"
+		"\"typed\":%lu,\"wildcard\":%lu,\"regex\":%lu,\"skipped\":%lu,\"warnings\":%lu,\"devices\":%d}\n",
+		o.total, o.kept, o.allow, o.block, o.important, o.scoped, o.typed, o.nglob, o.nre, o.unsup, o.warn, o.nscope);
+	if (fclose(o.js) || rename(tmps, stats))
+		return 1;
+	for (i = 0; i < (int)nsafe; i++)
+		free(safe[i]);
+	free(safe);
+	free(advmap);
+	return 0;
+usage:
+	fprintf(stderr, "usage: wallguardc adv --in RAW --out RULES --stats JSON [--clients FILE] [--safe FILE]\n");
+	return 2;
+}
