From 1355ea7dacf65fe2997fe958c9d0451ff0559af0 Mon Sep 17 00:00:00 2001
From: reaper <theunbounddeveloper@outlook.com>
Date: Fri, 6 Nov 2026 17:29:47 -0500
Subject: [PATCH] Wallguard: Advanced rules in AdGuard Home syntax; reservation
 names; report line ends (102.8 line)

- Advanced rules: a box on the Wallguard page that takes an AdGuard Home rule list as it is (up to
  40,000 characters): ||name^ blocks a name and its subdomains, |name| that name only, @@ allows,
  $important, $client= (an address, a MAC or a device's name; ~ for everyone else), $ctag= (a
  Wallguard profile), $dnstype=, $dnsrewrite=NOERROR/NXDOMAIN/REFUSED, wildcards and /regex/. A
  rule for some devices applies to those devices only, and a block is never put on a name the
  router itself needs. wallguardc compiles it beside the block table
  (dnsmasq/src/wallguard_adv.h), dnsmasq reloads it when the file changes, and the page shows what
  the last build made of it: rules in use, lines left out with the reason, notes.
- Invisible characters (zero-width and other format characters) are removed before saving and the
  page says how many; control characters are refused by httpd; a line with any other non-ASCII
  byte is left out with the character named.
- Device names for $client= include the DHCP reservations' names, so a reserved device that is
  offline still matches.
- The report no longer shows a reported line's own line end as '?'.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 release/src/router/dnsmasq/src/wallguard.c    | 108 +++
 .../src/router/dnsmasq/src/wallguard_adv.h    | 389 +++++++++++
 release/src/router/httpd/web.c                |  81 +++
 release/src/router/rc/wallguard.c             |  86 +++
 release/src/router/wallguard/wallguard.sh     |  11 +
 release/src/router/wallguard/wallguardc.c     | 621 +++++++++++++++++-
 release/src/router/www/Reaper_Wallguard.asp   |  46 ++
 7 files changed, 1341 insertions(+), 1 deletion(-)
 create mode 100644 release/src/router/dnsmasq/src/wallguard_adv.h

diff --git a/release/src/router/dnsmasq/src/wallguard.c b/release/src/router/dnsmasq/src/wallguard.c
index 5fd3112a112..282f5a173dd 100644
--- a/release/src/router/dnsmasq/src/wallguard.c
+++ b/release/src/router/dnsmasq/src/wallguard.c
@@ -22,6 +22,7 @@
 
 #include "dnsmasq.h"
 #include "wallguard_db.h"
+#include "wallguard_adv.h"	/* 2026-11-06: Advanced rules */
 
 #include <sys/mman.h>
 
@@ -51,6 +52,10 @@ struct wallguard_safe_name { uint64_t h; char g; };
 struct wallguard_safe_addr { char g; int family; union all_addr a; };
 
 static struct {
+  struct wga adv;			/* 2026-11-06: Advanced rules (wallguard_adv.h), SH_DIR/adv */
+  time_t adv_mtime;
+  ino_t adv_ino;
+  off_t adv_size;
   struct wallguard_table t;		/* wallguard_db.h: the block table (review 2026-10-24, Q-A-9: one mapper) */
   time_t checked, pol_mtime, stats_at;
   ino_t pol_ino;
@@ -339,6 +344,66 @@ static char wallguard_safe_group(const char *name)
 }
 
 /* once every WALLGUARD_RECHECK seconds: pick up a new table / policy, the live switch, stats */
+/* 2026-11-06 (owner): Advanced rules - SH_DIR/adv, written by `wallguardc adv`; reloaded when it changes (rename =
+   a new inode), cleared when it goes. A damaged file means no Advanced rules, never a failure. */
+static void wallguard_adv_load(void)
+{
+  char p[SH_PATH];
+  struct stat st;
+  FILE *f;
+
+  wallguard_path(p, sizeof(p), "adv");
+  if (stat(p, &st) == -1)
+    {
+      if (sh.adv_mtime)
+	wga_free(&sh.adv);
+      sh.adv_mtime = 0;
+      return;
+    }
+  if (st.st_mtime == sh.adv_mtime && st.st_ino == sh.adv_ino && st.st_size == sh.adv_size)
+    return;
+  sh.adv_mtime = st.st_mtime;
+  sh.adv_ino = st.st_ino;
+  sh.adv_size = st.st_size;
+  if (!(f = fopen(p, "r")))
+    {
+      wga_free(&sh.adv);
+      return;
+    }
+  if (wga_load(&sh.adv, f))
+    wga_free(&sh.adv);
+  fclose(f);
+}
+
+/* a blocked answer: resp = the rule's own (wallguard_adv.h WGA_R_*), else the global answer mode */
+static size_t wallguard_block_reply(struct dns_header *header, char *limit, size_t qlen, unsigned short qtype, int resp)
+{
+  union all_addr addr;
+  unsigned char *p;
+  int trunc = 0, ip = (qtype == T_A || qtype == T_AAAA);
+  int nx = resp == WGA_R_NX || (resp == WGA_R_DEFAULT && sh.nx);
+  int null = ip && (resp == WGA_R_NULL || (resp == WGA_R_DEFAULT && !sh.nx));
+
+  if (resp == WGA_R_REFUSED)
+    setup_reply(header, 0, EDE_BLOCKED);
+  else if (nx)
+    setup_reply(header, F_NXDOMAIN, EDE_BLOCKED);
+  else if (null)
+    setup_reply(header, qtype == T_A ? F_IPV4 : F_IPV6, EDE_BLOCKED);
+  else
+    setup_reply(header, F_NOERR, EDE_BLOCKED);	/* NODATA */
+  if (!(p = skip_questions(header, qlen)))
+    return 0;
+  if (null)
+    {
+      memset(&addr, 0, sizeof(addr));
+      if (add_resource_record(header, limit, &trunc, sizeof(struct dns_header), &p, WALLGUARD_TTL, NULL,
+			      qtype, C_IN, qtype == T_A ? "4" : "6", &addr))
+	header->ancount = htons(1);
+    }
+  return p - (unsigned char *)header;
+}
+
 static void wallguard_tick(time_t now)
 {
   char p[SH_PATH];
@@ -350,6 +415,7 @@ static void wallguard_tick(time_t now)
   wallguard_map();
   wallguard_policy();
   wallguard_safe_load();
+  wallguard_adv_load();
   wallguard_path(p, sizeof(p), "live.on");
   sh.live = stat(p, &st) == 0 && now - st.st_mtime < WALLGUARD_LIVE_AGE;
   if (now - sh.stats_at >= WALLGUARD_STATS_EVERY)
@@ -615,6 +681,48 @@ size_t wallguard_answer(struct dns_header *header, char *limit, size_t qlen,
   *ede = EDE_UNSET;
   if ((sa = wallguard_safe_answer(header, limit, qlen, client, qtype, name, now)))
     return sa;
+  /* 2026-11-06 (owner): Advanced rules first, in AdGuard's order - an important allow, an important block (it beats
+     the table's allows too: My rules' Never block, the lists' @@ lines), an allow, a plain block (the table's
+     allows still beat that one). Like My rules (bit 0) they apply only where the device's profile has My rules:
+     Bypass and a paused device are left alone. dnsmasq's own answers still win (wallguard_config_answer). */
+  if (sh.adv.nnames || sh.adv.npats)
+    {
+      struct wga_who w;
+      unsigned char amac[6];
+      int imp, resp, av;
+      uint32_t aline, abits;
+
+      memset(&w, 0, sizeof(w));
+      if (client && client->sa.sa_family == AF_INET)
+	w.family = AF_INET, w.addr = (const unsigned char *)&client->in.sin_addr;
+      else if (client && client->sa.sa_family == AF_INET6)
+	{
+	  const unsigned char *a6 = (const unsigned char *)&client->in6.sin6_addr;
+	  if (IN6_IS_ADDR_V4MAPPED(&client->in6.sin6_addr))
+	    w.family = AF_INET, w.addr = a6 + 12;
+	  else
+	    w.family = AF_INET6, w.addr = a6;
+	}
+      if (sh.adv.has_mac && client && find_mac(client, amac, 1, now) == 6)
+	w.mac = amac;
+      av = wga_eval(&sh.adv, name, qtype, &w, &imp, &resp, &aline);
+      if (av == WGA_ALLOW)
+	{
+	  wallguard_live(client, qtype, name, 'a');
+	  return 0;
+	}
+      if (av == WGA_BLOCK && !wallguard_config_answer(name, qtype))
+	{
+	  mask = wallguard_mask(client, now, mac, &have_mac, NULL);
+	  if ((mask & 1u) && (imp || !sh.t.ok || wallguard_lookup(&sh.t.v, name, &abits) != WALLGUARD_ALLOWED))
+	    {
+	      wallguard_hit(client, 1u, 'q', name, mac, have_mac);
+	      wallguard_live(client, qtype, name, 'b');
+	      *ede = EDE_BLOCKED;
+	      return wallguard_block_reply(header, limit, qlen, qtype, resp);
+	    }
+	}
+    }
   if (!sh.t.ok)
     {
       wallguard_live(client, qtype, name, '-');
diff --git a/release/src/router/dnsmasq/src/wallguard_adv.h b/release/src/router/dnsmasq/src/wallguard_adv.h
new file mode 100644
index 00000000000..1a8ad819fc4
--- /dev/null
+++ b/release/src/router/dnsmasq/src/wallguard_adv.h
@@ -0,0 +1,389 @@
+// SPDX-License-Identifier: GPL-2.0-only
+// Copyright (C) 2026 the Reaper project maintainer
+// Part of the Reaper hardened Asuswrt-Merlin build. See LICENSE / LICENSE.reaper.
+/*
+ * wallguard_adv.h - Wallguard's Advanced rules, the engine side (2026-11-06, owner: "a custom box that would
+ * accept all of the text file ... fully switch over to the router and off AdGuard").
+ *
+ * `wallguardc adv` (wallguard/wallguardc.c) turns the operator's AdGuard-syntax text into this file, and every
+ * dnsmasq instance loads it beside the block table. Plain text, one item per line:
+ *   WGADV 1
+ *   scope <id> mac <aa:bb:cc:dd:ee:ff>      | scope <id> ip <address[/prefix]>
+ *   rule <flags> <scope> <qtypes> <resp> <kind> <pattern> <source line>
+ *     flags   a|b (allow|block) [i] (important) s|x (name and subdomains | that name only)
+ *     scope   - | <id> | !<id> (every device but those)     qtypes  - | n,n... | !n,n...
+ *     resp    - (the global answer mode) | nodata | nx | refused | null
+ *     kind    n (a name: hashed, binary search) | g (a glob, fnmatch) | r (POSIX extended regex)
+ * The order AdGuard uses: an important allow > an important block > an allow > a block. The caller combines
+ * the verdict with the block table (see wallguard.c): an important block also beats the table's allows (My
+ * rules' Never block, lists' @@ lines); a plain block does not. The compiler keeps a block off every name the
+ * router itself needs. Damaged lines are skipped; a missing file means no Advanced rules.
+ */
+#ifndef WALLGUARD_ADV_H
+#define WALLGUARD_ADV_H
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <fnmatch.h>
+#include <regex.h>
+#include <arpa/inet.h>
+#include <sys/socket.h>
+
+#define WGA_MAX_RULES	20000
+#define WGA_MAX_PATS	576		/* 512 globs + 64 regexes */
+#define WGA_MAX_RE	64
+#define WGA_MAX_SCOPES	256
+#define WGA_MAX_MEMB	2048
+
+#define WGA_F_ALLOW	1
+#define WGA_F_IMP	2
+#define WGA_F_SUB	4
+#define WGA_F_SNEG	8
+#define WGA_F_QNEG	16
+
+#define WGA_R_DEFAULT	0
+#define WGA_R_NODATA	1
+#define WGA_R_NX	2
+#define WGA_R_REFUSED	3
+#define WGA_R_NULL	4
+
+#define WGA_NONE	0
+#define WGA_ALLOW	1
+#define WGA_BLOCK	2
+
+struct wga_rule {
+	uint64_t h;		/* kind n: the name's hash (wallguard_hash) */
+	char *pat;		/* g / r */
+	regex_t *re;
+	uint32_t line;
+	int16_t scope;		/* -1 = everyone */
+	uint8_t flags, resp, kind, nq;
+	uint16_t q[6];
+};
+
+struct wga_memb {
+	int16_t scope;
+	uint8_t is_mac, mac[6];
+	int family, prefix;
+	unsigned char addr[16];
+};
+
+struct wga {
+	struct wga_rule *names, *pats;
+	size_t nnames, npats;
+	struct wga_memb *memb;
+	size_t nmemb;
+	int has_mac;
+};
+
+static inline uint64_t wga_hash(const char *s, size_t n)
+{
+	uint64_t h = 0xcbf29ce484222325ull;
+	size_t i;
+	for (i = 0; i < n; i++) {
+		unsigned char c = (unsigned char)s[i];
+		if (c >= 'A' && c <= 'Z')
+			c += 32;
+		h ^= c;
+		h *= 0x100000001b3ull;
+	}
+	return h;
+}
+
+static inline void wga_free(struct wga *a)
+{
+	size_t i;
+	for (i = 0; i < a->npats; i++) {
+		if (a->pats[i].re) {
+			regfree(a->pats[i].re);
+			free(a->pats[i].re);
+		}
+		free(a->pats[i].pat);
+	}
+	free(a->names);
+	free(a->pats);
+	free(a->memb);
+	memset(a, 0, sizeof(*a));
+}
+
+static inline int wga_cmp(const void *x, const void *y)
+{
+	const struct wga_rule *a = (const struct wga_rule *)x, *b = (const struct wga_rule *)y;
+	return a->h < b->h ? -1 : a->h > b->h;
+}
+
+static inline int wga_mac_parse(const char *s, uint8_t *m)
+{
+	unsigned int v[6];
+	int i;
+	if (strlen(s) != 17 || sscanf(s, "%2x:%2x:%2x:%2x:%2x:%2x", &v[0], &v[1], &v[2], &v[3], &v[4], &v[5]) != 6)
+		return 0;
+	for (i = 0; i < 6; i++)
+		m[i] = (uint8_t)v[i];
+	return 1;
+}
+
+/* 0 = loaded (possibly empty); the previous content of a is freed first */
+static inline int wga_load(struct wga *a, FILE *f)
+{
+	char line[600];
+	size_t cn = 0, cp = 0, cm = 0;
+	int nre = 0;
+
+	wga_free(a);
+	if (!f || !fgets(line, sizeof(line), f) || strncmp(line, "WGADV 1", 7))
+		return -1;
+	while (fgets(line, sizeof(line), f)) {
+		char fl[8], sc[16], qt[64], rs[12], kd[4], pat[300], kindw[8], val[64];
+		unsigned long ln;
+		int id;
+
+		line[strcspn(line, "\r\n")] = 0;
+		if (sscanf(line, "scope %d %7s %63s", &id, kindw, val) == 3) {
+			struct wga_memb m;
+			if (id < 0 || id >= WGA_MAX_SCOPES || a->nmemb >= WGA_MAX_MEMB)
+				continue;
+			memset(&m, 0, sizeof(m));
+			m.scope = (int16_t)id;
+			if (!strcmp(kindw, "mac")) {
+				if (!wga_mac_parse(val, m.mac))
+					continue;
+				m.is_mac = 1;
+				a->has_mac = 1;
+			} else if (!strcmp(kindw, "ip")) {
+				char *sl = strchr(val, '/');
+				int max;
+				if (sl)
+					*sl++ = 0;
+				if (inet_pton(AF_INET, val, m.addr) == 1)
+					m.family = AF_INET, max = 32;
+				else if (inet_pton(AF_INET6, val, m.addr) == 1)
+					m.family = AF_INET6, max = 128;
+				else
+					continue;
+				m.prefix = sl ? atoi(sl) : max;
+				if (m.prefix < 0 || m.prefix > max)
+					continue;
+			} else
+				continue;
+			if (a->nmemb == cm) {
+				struct wga_memb *n = (struct wga_memb *)realloc(a->memb, (cm = cm ? cm * 2 : 16) * sizeof(*n));
+				if (!n)
+					return -1;
+				a->memb = n;
+			}
+			a->memb[a->nmemb++] = m;
+			continue;
+		}
+		if (sscanf(line, "rule %7s %15s %63s %11s %3s %299s %lu", fl, sc, qt, rs, kd, pat, &ln) == 7) {
+			struct wga_rule r;
+			char *q;
+			memset(&r, 0, sizeof(r));
+			r.line = (uint32_t)ln;
+			r.flags = (fl[0] == 'a' ? WGA_F_ALLOW : 0) | (strchr(fl, 'i') ? WGA_F_IMP : 0) | (strchr(fl, 's') ? WGA_F_SUB : 0);
+			if (fl[0] != 'a' && fl[0] != 'b')
+				continue;
+			r.scope = -1;
+			if (strcmp(sc, "-")) {
+				const char *s = sc;
+				if (*s == '!')
+					r.flags |= WGA_F_SNEG, s++;
+				r.scope = (int16_t)atoi(s);
+				if (r.scope < 0 || r.scope >= WGA_MAX_SCOPES)
+					continue;
+			}
+			if (strcmp(qt, "-")) {
+				char *s = qt;
+				if (*s == '!')
+					r.flags |= WGA_F_QNEG, s++;
+				for (q = strtok(s, ","); q && r.nq < 6; q = strtok(NULL, ","))
+					r.q[r.nq++] = (uint16_t)atoi(q);
+			}
+			r.resp = !strcmp(rs, "nodata") ? WGA_R_NODATA : !strcmp(rs, "nx") ? WGA_R_NX :
+				 !strcmp(rs, "refused") ? WGA_R_REFUSED : !strcmp(rs, "null") ? WGA_R_NULL : WGA_R_DEFAULT;
+			r.kind = (uint8_t)kd[0];
+			if (r.kind == 'n') {
+				if (a->nnames >= WGA_MAX_RULES)
+					continue;
+				r.h = wga_hash(pat, strlen(pat));
+				if (a->nnames == cn) {
+					struct wga_rule *n = (struct wga_rule *)realloc(a->names, (cn = cn ? cn * 2 : 64) * sizeof(*n));
+					if (!n)
+						return -1;
+					a->names = n;
+				}
+				a->names[a->nnames++] = r;
+			} else if (r.kind == 'g' || r.kind == 'r') {
+				if (a->npats >= WGA_MAX_PATS)
+					continue;
+				if (r.kind == 'r') {
+					if (nre >= WGA_MAX_RE || !(r.re = (regex_t *)malloc(sizeof(regex_t))))
+						continue;
+					if (regcomp(r.re, pat, REG_EXTENDED | REG_ICASE | REG_NOSUB)) {
+						free(r.re);
+						continue;
+					}
+					nre++;
+				}
+				if (!(r.pat = strdup(pat))) {
+					if (r.re) {
+						regfree(r.re);
+						free(r.re);
+					}
+					continue;
+				}
+				if (a->npats == cp) {
+					struct wga_rule *n = (struct wga_rule *)realloc(a->pats, (cp = cp ? cp * 2 : 16) * sizeof(*n));
+					if (!n) {
+						free(r.pat);
+						if (r.re) {
+							regfree(r.re);
+							free(r.re);
+						}
+						return -1;
+					}
+					a->pats = n;
+				}
+				a->pats[a->npats++] = r;
+			}
+		}
+	}
+	if (a->nnames)
+		qsort(a->names, a->nnames, sizeof(*a->names), wga_cmp);
+	return 0;
+}
+
+/* the asking device's scopes, worked out once per query and only when a scoped rule is in play */
+struct wga_who {
+	const uint8_t *mac;		/* NULL = unknown */
+	int family;			/* AF_INET / AF_INET6 / 0 */
+	const unsigned char *addr;
+	int done;
+	uint64_t bits[WGA_MAX_SCOPES / 64];
+};
+
+static inline int wga_prefix_eq(const unsigned char *a, const unsigned char *b, int bits)
+{
+	int full = bits / 8, rest = bits % 8;
+	if (full && memcmp(a, b, (size_t)full))
+		return 0;
+	if (rest) {
+		unsigned char m = (unsigned char)(0xff << (8 - rest));
+		if ((a[full] & m) != (b[full] & m))
+			return 0;
+	}
+	return 1;
+}
+
+static inline int wga_in_scope(const struct wga *a, struct wga_who *w, const struct wga_rule *r)
+{
+	int in;
+	if (r->scope < 0)
+		return 1;
+	if (!w->done) {
+		size_t i;
+		memset(w->bits, 0, sizeof(w->bits));
+		for (i = 0; i < a->nmemb; i++) {
+			const struct wga_memb *m = &a->memb[i];
+			int hit = m->is_mac ? (w->mac && !memcmp(m->mac, w->mac, 6))
+				: (w->family == m->family && w->addr && wga_prefix_eq(m->addr, w->addr, m->prefix));
+			if (hit)
+				w->bits[m->scope / 64] |= 1ull << (m->scope % 64);
+		}
+		w->done = 1;
+	}
+	in = (w->bits[r->scope / 64] >> (r->scope % 64)) & 1;
+	return (r->flags & WGA_F_SNEG) ? !in : in;
+}
+
+static inline int wga_qt_ok(const struct wga_rule *r, int qtype)
+{
+	int i, hit = 0;
+	if (!r->nq)
+		return 1;
+	for (i = 0; i < r->nq; i++)
+		if (r->q[i] == qtype)
+			hit = 1;
+	return (r->flags & WGA_F_QNEG) ? !hit : hit;
+}
+
+/* precedence classes: 3 important allow, 2 important block, 1 allow, 0 block */
+static inline int wga_class(const struct wga_rule *r)
+{
+	return (r->flags & WGA_F_ALLOW) ? ((r->flags & WGA_F_IMP) ? 3 : 1) : ((r->flags & WGA_F_IMP) ? 2 : 0);
+}
+
+/* WGA_NONE / WGA_ALLOW / WGA_BLOCK; *imp = the deciding rule was important, *resp its answer, *line its source line.
+   name: the query name, any case, trailing dots ignored. */
+static inline int wga_eval(const struct wga *a, const char *qname, int qtype, struct wga_who *w,
+			   int *imp, int *resp, uint32_t *line)
+{
+	char name[256];
+	const struct wga_rule *best = NULL;
+	size_t n = strlen(qname), i;
+	const char *s;
+	int first = 1;
+
+	*imp = 0;
+	*resp = WGA_R_DEFAULT;
+	*line = 0;
+	if (!a || (!a->nnames && !a->npats))
+		return WGA_NONE;
+	while (n && qname[n - 1] == '.')
+		n--;
+	if (!n || n >= sizeof(name))
+		return WGA_NONE;
+	for (i = 0; i < n; i++)
+		name[i] = (char)((qname[i] >= 'A' && qname[i] <= 'Z') ? qname[i] + 32 : qname[i]);
+	name[n] = 0;
+
