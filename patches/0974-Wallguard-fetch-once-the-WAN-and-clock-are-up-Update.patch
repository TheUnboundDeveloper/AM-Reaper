 }
+/* reaper 2026-11-07 (field: the Wireless Log named an AiMesh node "-"): the node's LAN MAC for one of its
+ * backhaul station MACs (the same shared table), "" when the MAC is no node's station. get_wl_status puts it
+ * on the station's row, so the Wireless Log names the row as the Devices page names the node. */
+int reaper_node_of_sta(const char *mac, char *out, size_t n)
+{
+	int shm_id, i;
+	P_CM_CLIENT_TABLE tbl;
+	void *shm;
+	unsigned char mb[6] = {0};
+
+	if (n)
+		out[0] = '\0';
+	if (!mac || !n || !ether_atoe(mac, mb))
+		return 0;
+	shm_id = shmget((key_t)KEY_SHM_CFG, sizeof(CM_CLIENT_TABLE), 0666|IPC_CREAT);
+	if (shm_id == -1)
+		return 0;
+	shm = shmat(shm_id, (void *)0, 0);
+	if (shm == (void *)-1)
+		return 0;
+	tbl = (P_CM_CLIENT_TABLE)shm;
+	for (i = 1; i < tbl->count; i++) {		/* index 0 = this router (the CAP) */
+		if (memcmp(tbl->sta2g[i], mb, 6) == 0 || memcmp(tbl->sta5g[i], mb, 6) == 0 ||
+		    memcmp(tbl->sta6g[i], mb, 6) == 0) {
+			snprintf(out, n, "%02X:%02X:%02X:%02X:%02X:%02X", tbl->realMacAddr[i][0], tbl->realMacAddr[i][1],
+				 tbl->realMacAddr[i][2], tbl->realMacAddr[i][3], tbl->realMacAddr[i][4], tbl->realMacAddr[i][5]);
+			break;
+		}
+	}
+	shmdt(shm);
+	return out[0] != '\0';
+}
 #else
 static void rdev_node_classify(struct rdev *v, int n) { (void)v; (void)n; }
+int reaper_node_of_sta(const char *mac, char *out, size_t n) { (void)mac; if (n) out[0] = '\0'; return 0; }
 #endif
 
