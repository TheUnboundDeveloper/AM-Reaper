diff --git a/release/src/router/rc/wallguard.c b/release/src/router/rc/wallguard.c
index 22ea1f44822..c32fb58c2a8 100644
--- a/release/src/router/rc/wallguard.c
+++ b/release/src/router/rc/wallguard.c
@@ -985,26 +985,37 @@ void wallguard_update(void)
 /* start_firewall (WAN up): a router that booted without internet has no table yet -
    fetch the lists now. wallguard.sh's own lock turns a second trigger into a no-op.
    2026-10-25 (release review W-1): nor does a table that holds My rules alone because every
-   download failed (wallguard.sh writes "pending"); a firewall restart within two minutes of
-   the last attempt does not start another. */
-void wallguard_on_firewall(void)
+   download failed (wallguard.sh writes "pending").
+   2026-11-07 (field): the mark holds the epoch of the next try - 0 while the WAN was down (a reboot at
+   03:00 fetches at WAN up, not at the 05:15 run), else wallguard.sh's 10 min - 6 h backoff while any list
+   is still owed; a retry fetches only the owed lists, so the lists already down are never fetched again. */
+static int sh_pending_due(void)
 {
-	struct stat st;
+	char b[32] = "";
+
+	if (!f_exists(SH_DIR "/pending"))
+		return 0;
+	f_read_string(SH_DIR "/pending", b, sizeof(b));
+	return atol(b) <= (long)time(NULL);
+}
 
+void wallguard_on_firewall(void)
+{
 	if (!wallguard_enabled() || !f_exists(SH_DIR "/feeds"))
 		return;
 	if (!f_exists(SH_DIR "/db"))
 		sh_run_bg("update");
-	else if (f_exists(SH_DIR "/pending") &&
-		 (stat(SH_DIR "/state", &st) != 0 || time(NULL) - st.st_mtime >= 120))
-		sh_run_bg("update");
+	else if (sh_pending_due())
+		sh_run_bg("retry");
 }
 
 /* the watchdog found the pinned USB store mounted (rc/reaper_usbmon.c, 2026-10-21): Wallguard's lists
-   may be on it - a router with no table yet builds from them at once, no internet needed */
+   may be on it - a router with no table yet builds from them at once, no internet needed.
+   2026-11-07 (metal _r1): or with a rules-only table under the pending mark - the store mounted 7 s after
+   the boot table was built, and nothing rebuilt from it until the 05:15 run. */
 void wallguard_store_attached(void)
 {
-	if (wallguard_enabled() && !f_exists(SH_DIR "/db") && f_exists(SH_DIR "/feeds"))
+	if (wallguard_enabled() && (!f_exists(SH_DIR "/db") || f_exists(SH_DIR "/pending")) && f_exists(SH_DIR "/feeds"))
 		sh_run_bg("restore");
 }
 
diff --git a/release/src/router/wallguard/wallguard.sh b/release/src/router/wallguard/wallguard.sh
index 5a3ac26aab3..4dc5226d5ac 100644
--- a/release/src/router/wallguard/wallguard.sh
+++ b/release/src/router/wallguard/wallguard.sh
@@ -18,7 +18,10 @@
 #   $J/block    My rules: names to block (with subdomains)
 #   $J/allow    names never blocked;  $J/allow24 = "<expiry> <name>" temporary allows
 #
-#   update   fetch every list (keeping the previous copy of one that fails), then build
+#   update   fetch every list (keeping the previous copy of one that fails), then build. 2026-11-07: $D/only
+#            (ids, written by httpd for a list row's Update button) or ONLY in the environment (sync, retry)
+#            restricts it to those lists; the other lists' state lines are carried over, nothing else is fetched
+#   retry    update restricted to the subscribed lists with no usable copy (rc at WAN up, rwatch each tick)
 #   build    compile the table from what is on disk (after a rule change - no downloads)
 #   fold     move dnsmasq's blocked-lookup records into the counters
 #   stats    fold, then print the status JSON for the page
@@ -209,6 +212,41 @@ lock_wait() {
   return 0
 }
 
+# 2026-11-07 (field): a reboot at 03:00 left the lists owed until the 05:15 run - the boot attempt ran before the
+# WAN was up, and a list that failed while another came down was not owed by the pending mark. Now: nothing is
+# fetched until the WAN is up (a default route, and the clock set; no nvram on the host = up); $D/pending holds
+# the epoch of the next try - 0 while the WAN is down (rc retries at WAN up), else 10 min doubling to 6 h while
+# any subscribed list has no usable copy (rwatch checks each tick); a retry fetches only the lists still owed.
+wan_up() {
+  [ -n "${WALLGUARD_WAN+x}" ] && { [ "$WALLGUARD_WAN" = 1 ]; return; }
+  # metal _r2: the router's ash had no `command` builtin (CONFIG_ASH_CMDCMD off) - `command -v nvram` was 127 and
+  # this line said "the host" on the router. An absolute path decides it.
+  [ -x /bin/nvram ] || return 0
+  # metal _r1 (2026-11-07): nvram's wanN_state_t held a stale 2 from before the reboot (start_wan runs after
+  # start_services), so the boot fetch ran before any route existed; and on the unset clock (2023 at boot) a
+  # retry time means nothing and TLS refuses every list host. A default route and a set clock, then.
+  { ip -4 route show default 2>/dev/null; ip -6 route show default 2>/dev/null; } | grep -q '^default' || return 1
+  [ "$(date +%Y)" -ge 2024 ]
+}
+# the subscribed lists with no usable copy, space separated
+owed() {
+  while read -r bit id url kind opt; do
+    feed_ok "$bit" "$id" "$url" "$kind" "$opt" || continue
+    [ "$kind" = s ] && continue
+    list_path "$id" >/dev/null || printf '%s ' "$id"
+  done < "$D/feeds"
+}
+# pending_set 0: at WAN up; pending_set 1: the backoff step (prints the minutes)
+pending_set() {
+  if [ "$1" = 0 ]; then echo 0 > "$D/pending"; return 0; fi
+  _t=$(tr -dc 0-9 < "$D/tries" 2>/dev/null); _t=$(( ${_t:-0} + 1 )); echo "$_t" > "$D/tries"
+  _m=10; _i=1; while [ "$_i" -lt "$_t" ] && [ "$_m" -lt 360 ]; do _m=$(( _m * 2 )); _i=$(( _i + 1 )); done
+  [ "$_m" -gt 360 ] && _m=360
+  echo $(( $(date +%s) + _m * 60 )) > "$D/pending"
+  echo "$_m"
+}
+pending_clear() { rm -f "$D/pending" "$D/tries"; }
+
 # review 2026-11-03 (D-1): an HTTP 200 answer is not yet a list. The download is parsed alone, by the same
 # parser the table uses, and refused (the previous copy stays) when it holds no names, or when most of its
 # lines are not list lines AND it carries under a quarter of the names the copy in use gave - an error or
@@ -225,8 +263,9 @@ list_gate() {
     FNR == 1 { f++ }
     { n = split($0, part, /\{"bit":/)
       for (j = 2; j <= n; j++) if (index(part[j], "\"id\":\"" id "\"")) {
-        if (f == 1) { nm = num(part[j], "names"); bad = num(part[j], "unsupported") + num(part[j], "invalid") }
-        else old = num(part[j], "names") } }
+        # 2026-11-07: a list of @@ lines alone (the AdGuard DNS exceptions list) carries allows, not names - a list still
+        if (f == 1) { nm = num(part[j], "names") + num(part[j], "allows"); bad = num(part[j], "unsupported") + num(part[j], "invalid") }
+        else old = num(part[j], "names") + num(part[j], "allows") } }
     END { printf "%d %d %d\n", nm, bad, old }' "$_gj" $( [ -f "$D/build.json" ] && echo "$D/build.json") 2>/dev/null)
   rm -f "$_gj" "$_gd"
   # shellcheck disable=SC2086
@@ -395,7 +434,7 @@ sync() {
   done < "$D/feeds"
   if [ -n "$_new" ]; then
     log "list(s)$_new not downloaded yet - downloading now"
-    update
+    ONLY=$_new update		# 2026-11-07: those alone - the lists already down are not fetched again
   else
     build
   fi
@@ -407,10 +446,22 @@ update() {
   mkdir -p "$L"
   S=$(st_lists)
   restore_build		# no table yet: block from the stored lists while the downloads run
+  # 2026-11-07: a subset - $D/only from httpd (a row's Update button), or ONLY from sync / retry
+  if [ -z "${ONLY+x}" ] && [ -f "$D/only" ] && [ ! -L "$D/only" ]; then ONLY=$(tr -c 'a-z0-9_\n' ' ' < "$D/only" | tr '\n' ' '); fi
+  rm -f "$D/only"
+  if ! wan_up; then
+    pending_set 0
+    log "the internet is not up yet - the lists are fetched when it is"
+    [ -s "$D/db" ] || build
+    return 0
+  fi
   : > "$D/state.new"
   while read -r bit id url kind opt; do
     feed_ok "$bit" "$id" "$url" "$kind" "$opt" || { [ -n "$id" ] && log "feed line for $id is not valid - skipped"; continue; }
     [ "$kind" = s ] && continue		# rc wrote it; nothing to fetch
+    if [ -n "${ONLY+x}" ]; then
+      case " $ONLY " in *" $id "*) ;; *) awk -v i="$id" '$1 == i' "$D/state" 2>/dev/null >> "$D/state.new"; continue ;; esac
+    fi
     c=$CURL; [ "$kind" = c ] && c=$CURLC
     prev=$(awk -v i="$id" '$1 == i {print $3}' "$D/state" 2>/dev/null)
     now=$(date +%s)
@@ -457,19 +508,24 @@ update() {
   # a boot that runs before the WAN or the clock is up. The table below still carries My rules, so the
   # "no table yet" retries would never fire again and nothing on the lists would be blocked until 05:15.
   # $D/pending says the lists are still owed: rc fetches again when the WAN comes up, rwatch every 10 min.
-  nf=0; nu=0
+  # 2026-11-07: any list still owed keeps the mark, with the epoch of the next try (rc / rwatch call retry then)
+  nf=0; nu=0; ow=
   while read -r bit id url kind opt; do
     feed_ok "$bit" "$id" "$url" "$kind" "$opt" || continue
     [ "$kind" = s ] && continue
-    nf=$((nf + 1)); list_path "$id" >/dev/null && nu=$((nu + 1))
+    nf=$((nf + 1)); if list_path "$id" >/dev/null; then nu=$((nu + 1)); else ow="$ow $id"; fi
   done < "$D/feeds"
   if [ "$nf" -gt 0 ] && [ "$nu" = 0 ]; then
-    : > "$D/pending"
-    log "no block list could be downloaded - only My rules are blocked until the lists come down (retried when the internet is up)"
+    m=$(pending_set 1)
+    log "no block list could be downloaded - only My rules are blocked until the lists come down (tried again in $m min, or when the internet comes up)"
+  elif [ -n "$ow" ]; then
+    m=$(pending_set 1)
+    log "list(s)$ow still owed - tried again in $m min"
   else
-    rm -f "$D/pending"
+    pending_clear
   fi
-  safesearch
+  # the safe-search file: on a full update, or when a reboot took it
+  { [ -z "${ONLY+x}" ] || [ ! -f "$D/safesearch" ]; } && safesearch
   # lists no longer subscribed leave the RAM disk and the USB volume (rstore prune: removed inside
   # the folder by name, never through a link)
   for f in "$L"/*; do
@@ -486,7 +542,8 @@ update() {
 # least one stored list is usable, so the "no table, fetch" paths are never fooled by a table
 # holding My rules alone
 restore_build() {
-  [ -s "$D/db" ] && return 0
+  # metal _r1 (2026-11-07): a rules-only table under the pending mark is no table - the USB store came up 7 s after it
+  [ -s "$D/db" ] && [ ! -f "$D/pending" ] && return 0
   [ -n "$S" ] && [ -f "$D/feeds" ] || return 1
   n=0
   while read -r bit id url kind opt; do
@@ -504,6 +561,18 @@ restore() {
   S=$(st_lists)
   restore_build
 }
+# 2026-11-07: the lists still owed, nothing else (rc at WAN up, rwatch while the pending mark stands)
+retry() {
+  S=$(st_lists)
+  ow=$(owed)
+  if [ -z "$ow" ]; then
+    pending_clear
+    # metal _r1: the copies became usable after the table was built (the USB store mounted later) - build from them
+    grep -q ' missing ' "$D/state" 2>/dev/null && build
+    return 0
+  fi
+  ONLY=$ow update
+}
 
 # Safe search (phase 2, 2026-10-21): which names the engine answers and with what. Google's
 # country domains come from Google's own list; the enforcement addresses are resolved through
@@ -710,7 +779,8 @@ case "$1" in
   reset) reset ;;
   safe) safesearch ;;
   restore) restore ;;
+  retry) retry ;;
