From 0bb03acacf16a6f1dd58d984dae0a5a31d3018ef Mon Sep 17 00:00:00 2001
From: reaper <theunbounddeveloper@outlook.com>
Date: Sat, 7 Nov 2026 14:16:53 -0500
Subject: [PATCH] busybox: the command builtin (CONFIG_ASH_CMDCMD) (102.8 line)

The router's ash had no `command` builtin: `command -v tool` was "command: not found", exit 127.
Scripts that look for a tool that way (acme.sh among them) now work on the router. About 1 KB,
additive.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 release/src/router/busybox/config_base | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/release/src/router/busybox/config_base b/release/src/router/busybox/config_base
index 2f3dca6f599..e044e7e2ce1 100644
--- a/release/src/router/busybox/config_base
+++ b/release/src/router/busybox/config_base
@@ -1031,7 +1031,7 @@ CONFIG_ASH_ALIAS=y
 # CONFIG_ASH_BUILTIN_PRINTF is not set
 # CONFIG_ASH_BUILTIN_TEST is not set
 # CONFIG_ASH_HELP is not set
-# CONFIG_ASH_CMDCMD is not set
+CONFIG_ASH_CMDCMD=y
 # CONFIG_ASH_MAIL is not set
 CONFIG_ASH_OPTIMIZE_FOR_SIZE=y
 # CONFIG_ASH_RANDOM_SUPPORT is not set
-- 
2.25.1

