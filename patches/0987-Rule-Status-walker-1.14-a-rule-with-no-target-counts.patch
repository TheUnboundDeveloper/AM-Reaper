-		fprintf(f, "# the WAN addresses are masked as [WAN-IP]\n");
+		fprintf(f, "# every address on a WAN interface is masked as [WAN-IP], its IPv4 broadcast as [WAN-BRD]\n");
 		for (i = 0; i < nown; i++) {
-			char s[48]; addr_str(&own[i].a, s, sizeof(s));
