 		for (ln = c ? strtok_r(c, "\n", &sv) : NULL; ln; ln = strtok_r(NULL, "\n", &sv))
 			if (sscanf(ln, "%d", &slot) == 1 && slot >= 1 && slot <= 8)
@@ -27148,6 +27152,127 @@ static int sh_keys_save(const char *upd)
 	return src_keys_save(SH_JFFS "/keys", SH_JFFS "/lists", "wallguard", upd);
 }
 
+/* 2026-11-15 (field request): API keys of Warden's custom IP feeds ("$APIkey" in a feed's address, RW_CFKEYS).
+ * A feed has no slot number of its own - its key is filed under its place in the list, which is what rc and
+ * wallguard.sh's fetch read - so every save of the list files the keys again: a feed keeps its key when its name
+ * is unchanged and its addresses still point at a host the key was already sent to, wherever the feed now stands.
+ * A renamed feed, a feed pointed at another host, a feed without "$APIkey" and a feed that is gone lose theirs: a
+ * key is never sent to a host it was not typed for. */
+struct rw_cfrec { char name[28]; char h4[204]; char h6[204]; int uses; };
+
+static void rw_cf_host(const char *url, char *out, size_t sz)
+{
+	size_t n;
+
+	*out = 0;
+	if (!url || strncmp(url, "https://", 8))
+		return;
+	n = strcspn(url + 8, "/?#");
+	if (n >= sz)
+		return;
+	memcpy(out, url + 8, n);
+	out[n] = 0;
+}
+
+/* the records of a rwarden_cfeeds value into r[1..8], numbered as rc numbers them (every non-empty "<" piece
+ * counts, valid or not); the count */
+static int rw_cf_parse(const char *list, struct rw_cfrec *r)
+{
+	char *c = strdup(list ? list : ""), *tok, *sv, *f1, *f2, *e;
+	int n = 0;
+
+	memset(r, 0, 9 * sizeof(*r));
+	for (tok = c ? strtok_r(c, "<", &sv) : NULL; tok && n < 8; tok = strtok_r(NULL, "<", &sv)) {
+		n++;
+		if ((f1 = strchr(tok, '>')) != NULL)
+			*f1++ = 0;
+		if ((f2 = f1 ? strchr(f1, '>') : NULL) != NULL) {
+			*f2++ = 0;
+			if ((e = strchr(f2, '>')) != NULL)
+				*e = 0;
+		}
+		if (strlen(tok) < sizeof(r[n].name))	/* a longer name is no feed (rc skips it): it matches nothing */
+			strcpy(r[n].name, tok);
+		rw_cf_host(f1, r[n].h4, sizeof(r[n].h4));
+		rw_cf_host(f2, r[n].h6, sizeof(r[n].h6));
+		r[n].uses = (f1 && strstr(f1, "$APIkey")) || (f2 && strstr(f2, "$APIkey"));
+	}
+	free(c);
+	return n;
+}
+
+/* is host h one of the hosts the old feed o fetched from */
+static int rw_cf_known_host(const struct rw_cfrec *o, const char *h)
+{
+	return *h && ((*o->h4 && !strcasecmp(o->h4, h)) || (*o->h6 && !strcasecmp(o->h6, h)));
+}
+
+/* old_list: the list the saved keys were filed against; new_list: the list now stored; upd: "<place> <key>" sets,
+ * "<place> -" clears, places as in new_list. 0 ok, -1 a line of upd is not valid (nothing written), -2 the file
+ * could not be written. */
+static int rw_cfkeys_save(const char *old_list, const char *new_list, const char *upd)
+{
+	struct rw_cfrec o[9], n[9];
+	char okey[9][208], nkey[9][208], buf[9 * 220], *c, *ln, *sv, k[208];
+	int set[9], ex, slot, i, j, nn, same, hit;
+	size_t len = 0;
+
+	if (!src_keys_ok(upd))
+		return -1;
+	memset(okey, 0, sizeof(okey));
+	memset(nkey, 0, sizeof(nkey));
+	memset(set, 0, sizeof(set));
+	rw_cf_parse(old_list, o);
+	nn = rw_cf_parse(new_list, n);
+	c = strdup(rjf_get(RW_CFKEYS, &ex));
+	for (ln = c ? strtok_r(c, "\n", &sv) : NULL; ln; ln = strtok_r(NULL, "\n", &sv))
+		if (sscanf(ln, "%d %207s", &slot, k) == 2 && slot >= 1 && slot <= 8 && sh_key_ok(k))
+			snprintf(okey[slot], sizeof(okey[slot]), "%s", k);
+	free(c);
+	if (upd && *upd) {
+		if (!(c = strdup(upd)))
+			return -2;
+		for (ln = strtok_r(c, "\n\r", &sv); ln; ln = strtok_r(NULL, "\n\r", &sv))
+			if (src_key_line(ln, &slot, k)) {
+				set[slot] = 1;
+				snprintf(nkey[slot], sizeof(nkey[slot]), "%s", strcmp(k, "-") ? k : "");
+			}
+		free(c);
+	}
+	for (i = 1; i <= 8; i++) {
+		if (i > nn || !n[i].uses || !*n[i].name || !*n[i].h4) {
+			nkey[i][0] = 0;		/* no feed here, or one that sends no key */
+			continue;
+		}
+		if (set[i])
+			continue;		/* typed (or cleared) in this save */
+		for (same = 0, j = 1; j <= nn; j++)
+			same += !strcmp(n[j].name, n[i].name);
+		for (hit = 0, j = 1; j <= 8 && hit >= 0; j++)
+			if (!strcmp(o[j].name, n[i].name))
+				hit = hit ? -1 : j;
+		if (same == 1 && hit > 0 && okey[hit][0] && rw_cf_known_host(&o[hit], n[i].h4) &&
+		    (!*n[i].h6 || rw_cf_known_host(&o[hit], n[i].h6)))
+			snprintf(nkey[i], sizeof(nkey[i]), "%s", okey[hit]);
+	}
+	for (i = 1; i <= 8; i++)
+		if (nkey[i][0])
+			len += snprintf(buf + len, sizeof(buf) - len, "%d %s\n", i, nkey[i]);
+	if (!len)
+		return (unlink(RW_CFKEYS) == 0 || errno == ENOENT) ? 0 : -2;
+	return rjf_set(RW_CFKEYS, buf, "rwarden") == 0 ? 0 : -2;
+}
+
+/* file the keys against the feed list as it is stored now; old_list = the list before this save (NULL: unchanged) */
+static int rw_cfkeys_refile(const char *old_list, const char *upd)
+{
+	char *now = rw_list_get("cfeeds");
+	int r = rw_cfkeys_save(old_list ? old_list : (now ? now : ""), now ? now : "", upd);
+
+	free(now);
+	return r;
+}
+
 /* 2026-10-27 (owner): Dreadwatch's sources (RDW_SRC), one line each: "hidden <row>" (a built-in row removed from the
  * list; basics = Reaper's Basics), "off <slot>" (one of your sources kept but unticked), "custom <slot> <https-url>
  * [options]" (Wallguard's options, sh_chk_opts). rc/rwarden.c's update.sh checks every line again. */
@@ -28319,7 +28444,14 @@ do_reaper_warden_cgi(char *url, FILE *stream)
 		 * per entry); the charset gate covers them, update.sh re-filters */
 		static const char *names[] = { "ban", "allow", "cfeeds", "dnsallow", NULL };
 		char *src = get_cgi("dnssrc"), *keys = get_cgi("dnskeys"), *clean = NULL;
-		int i, saved = 0;
+		char *cfk = get_cgi("cfkeys"), *cf_old;
+		int i, saved = 0, is_cf;
+
+		/* 2026-11-15: the custom IP feeds' API keys - checked here, before anything is written */
+		if (!src_keys_ok(cfk)) {
+			websWrite(stream, "{\"ok\":0,\"error\":\"an API key is not valid\",\"ek\":\"RWDN_L1\"}");
+			return;
+		}
 
 		/* 2026-10-27 (owner): Dreadwatch's own sources and API keys - every line is checked before anything is
 		 * written; the keys after the sources, so a source that is gone takes its key with it */
@@ -28351,12 +28483,36 @@ do_reaper_warden_cgi(char *url, FILE *stream)
 				websWrite(stream, "{\"ok\":0,\"error\":\"list too long or has unsupported characters\",\"ek\":\"RWDN_L1\"}");
 				return;
 			}
+			/* 2026-11-15: the feeds' API keys are filed by a feed's place in the list, so they are filed
+			 * again with every save of it, at once (rw_cfkeys_save) */
+			is_cf = !strcmp(names[i], "cfeeds");
+			cf_old = is_cf ? rw_list_get("cfeeds") : NULL;
 			if (rw_list_set(names[i], v) != 0) {
+				free(cf_old);
 				websWrite(stream, "{\"ok\":0,\"error\":\"could not save the list\",\"ek\":\"RWDN_L2\"}");
 				return;
 			}
+			if (is_cf) {
+				int kr = rw_cfkeys_refile(cf_old ? cf_old : "", cfk);
+
+				free(cf_old);
+				if (kr != 0) {
+					websWrite(stream, "{\"ok\":0,\"error\":\"could not save the list\",\"ek\":\"RWDN_L2\"}");
+					return;
+				}
+			}
 			saved++;
 		}
+		if (cfk && *cfk) {
+			if (!get_cgi("cfeeds")) {	/* keys alone: against the list as stored */
+				if (rw_cfkeys_refile(NULL, cfk) != 0) {
+					websWrite(stream, "{\"ok\":0,\"error\":\"could not save the list\",\"ek\":\"RWDN_L2\"}");
+					return;
+				}
+				saved++;
+			}
+			reaper_audit("warden", "save", "custom feed API keys");
+		}
 		websWrite(stream, "{\"ok\":1,\"saved\":%d}", saved);
 		return;
 	}
@@ -29729,6 +29885,8 @@ static const struct { const char *sect; const char *nv; size_t max; } rcfg_flags
 	 * their API keys - the keys AFTER the sources, which they are pruned against */
 	{ "warden", "rwarden_reset",    9   },
 	{ "warden", "rwarden_dnssrc",   RDW_SRC_MAX }, { "warden", "rwarden_dnskeys", 8 * 220 + 1 },
+	/* 2026-11-15: the API keys of the custom IP feeds - AFTER rwarden_cfeeds above, which they are filed against */
+	{ "warden", "rwarden_cfkeys",   8 * 220 + 1 },
 	/* IPv6 A3 (2026-10-07): the DHCPv6 reservation list (/jffs, shared/reaper_dhcp6.h) */
 	{ "dev",    "rdev_dhcp6",      8192 },
 	/* 2026-10-19: the security review switch (rc/rwatch.c 3h); the accepted
@@ -29837,6 +29995,7 @@ static char *rcfg_get(int i, int *have)
 		return strdup(ex > 0 && jv ? jv : "");
 	}
 	if (!strcmp(nv, "rwarden_dnskeys")) f = RDW_KEYS;
+	else if (!strcmp(nv, "rwarden_cfkeys")) f = RW_CFKEYS;	/* 2026-11-15 */
 	else if (!strcmp(nv, "wallguard_keys")) f = SH_JFFS "/keys";
 	else if (!strcmp(nv, "wallguard_adv")) f = SH_JFFS "/adv";	/* 2026-11-06 */
 	else if (wf) f = wf->file;
@@ -29878,6 +30037,13 @@ static int rcfg_put(int i, const char *v)
 		unlink(dw ? RDW_KEYS : SH_JFFS "/keys");
 		return (dw ? src_keys_save(RDW_KEYS, RDW_SRC, "rwarden", v) : sh_keys_save(v)) == 0 ? 0 : -1;
 	}
+	if (!strcmp(nv, "rwarden_cfkeys")) {
+		/* 2026-11-15: the feed list came in just before (table order); the file's keys replace this router's */
+		if (!src_keys_ok(v))
+			return -1;
+		unlink(RW_CFKEYS);
+		return rw_cfkeys_refile(NULL, v) == 0 ? 0 : -1;
+	}
 	if (!strcmp(nv, "wallguard_adv"))	/* 2026-11-06: Advanced rules - its own gate (sh_adv_ok) */
 		return (sh_adv_ok(v, strlen(v)) && (*v ? rjf_set(SH_JFFS "/adv", v, "wallguard") == 0 : (unlink(SH_JFFS "/adv"), 1))) ? 0 : -1;
 	if (wf || !strcmp(nv, "rwarden_dnssrc")) {	/* line by line through the page's own check */
@@ -30058,7 +30224,7 @@ static int rcfg_import_json(const char *body, int *nflags_o, int *nlists_o, int
 	int i, nflags = 0, nlists = 0, rejected = 0;
 	int touch_gk = 0, touch_warden = 0;
 	unsigned touch = 0;	/* 2026-10-27: the other sections (rcfg_touch_bit) */
-	int dw_any = 0, dw_src = 0, dw_keys = 0, wg_src = 0, wg_keys = 0;
+	int dw_any = 0, dw_src = 0, dw_keys = 0, wg_src = 0, wg_keys = 0, cf_src = 0, cf_keys = 0;
 
 	root = json_tokener_parse(body);
 	if (!root || json_object_get_type(root) != json_type_object) {
@@ -30101,10 +30267,13 @@ static int rcfg_import_json(const char *body, int *nflags_o, int *nlists_o, int
 				if (!strcmp(n, "rwarden_dnskeys")) dw_keys = 1;
 				if (!strcmp(n, "wallguard_lists")) wg_src = 1;
 				if (!strcmp(n, "wallguard_keys")) wg_keys = 1;
+				if (!strcmp(n, "rwarden_cfeeds")) cf_src = 1;	/* 2026-11-15 */
+				if (!strcmp(n, "rwarden_cfkeys")) cf_keys = 1;
 			}
 			/* restored sources with no keys in the file: the backup had none, so none are kept */
 			if (dw_src && !dw_keys) unlink(RDW_KEYS);
 			if (wg_src && !wg_keys) unlink(SH_JFFS "/keys");
+			if (cf_src && !cf_keys) unlink(RW_CFKEYS);
 			/* F3: the interactive enable path snapshots the baseline so the
 			 * admin's own devices are admitted; an import turning it on must too */
 			if (!gk_was && nvram_match("gk_enable", "1")) gk_baseline_snapshot();
diff --git a/release/src/router/rc/rwarden.c b/release/src/router/rc/rwarden.c
index f546eddc03..48cbca0cc6 100644
--- a/release/src/router/rc/rwarden.c
+++ b/release/src/router/rc/rwarden.c
@@ -140,6 +140,10 @@
 #define RW_DCUST_STR "custom1 custom2 custom3 custom4 custom5 custom6 custom7 custom8"
 #define RW_DNS_SRC   RW_CACHE "/dnssrc"
 #define RW_DNS_KEYS  RW_CACHE "/dnskeys"
+/* 2026-11-15 (field request): a custom IP feed's address may carry "$APIkey" where the supplier wants a key, as
+ * Wallguard's and Dreadwatch's sources do. The keys: "<slot> <key>", slot = the feed's place in rwarden_cfeeds
+ * (1..RW_CFEED_MAX), root 0600, write-only from the page; httpd writes it and keeps it in step with the list. */
+#define RW_CF_KEYS   RW_CACHE "/cfkeys"
 /* The threat sets' ceiling. Was a bare literal repeated at six ipset-create
  * sites AND implicitly assumed by the UI, so "surface the count against the
  * limit" had no single number to quote. One definition, string form for the
@@ -394,21 +398,42 @@ static int rw_valid_feedname(const char *s)
  *            stored and then misread by a human as the trusted host.
  * https only, and not negotiable: whatever is fetched is loaded straight into a
  * DROP set, so an on-path attacker rewriting a plaintext feed would be choosing
- * what the router blocks - including, without the bogon filter below, the LAN. */
+ * what the router blocks - including, without the bogon filter below, the LAN.
+ * 2026-11-15: the one "$" allowed is the literal "$APIkey", and only after the host (never in it: a key must not
+ * choose where it is sent). It stays inert - the URL is still emitted inside single quotes, and the key itself is
+ * never in this string: wallguard.sh's fetch reads it from RW_CF_KEYS and writes it, %-encoded, into a root-only
+ * curl config (the same code Wallguard's and Dreadwatch's keyed sources use). */
 static int rw_valid_feedurl(const char *s)
 {
 	static const char ok[] = "-._~:/?&=%+,[]";
-	int n = 0;
+	size_t n, h;
 
 	if (!s || strncmp(s, "https://", 8) != 0) return 0;
 	if (!s[8]) return 0;
-	for (; *s; s++, n++) {
+	h = 8 + strcspn(s + 8, "/?");
+	for (n = 0; s[n]; n++) {
 		if (n >= RW_CFEED_URL_MAX) return 0;
-		if (isalnum((unsigned char)*s)) continue;
-		if (strchr(ok, *s)) continue;
+		if (isalnum((unsigned char)s[n])) continue;
+		if (strchr(ok, s[n])) continue;
+		if (s[n] == '$' && n > h && !strncmp(s + n, "$APIkey", 7)) {
+			n += 6;
+			continue;
+		}
 		return 0;
 	}
-	return 1;
+	return n <= RW_CFEED_URL_MAX;
+}
+
+/* 2026-11-15: the command that fetches one checked custom-feed address into $TMP. With "$APIkey" in it:
+ * wallguard.sh's fetch (https only, the size cap, the key from RW_CF_KEYS by slot, never in a command line);
+ * without: the plain curl call, unchanged. url has passed rw_valid_feedurl, so it cannot leave the single quotes. */
+static void rw_cfeed_fetch(char *out, size_t sz, const char *url, int slot)
+{
+	if (strstr(url, "$APIkey"))
+		snprintf(out, sz, "${RW_WGSH:-/usr/sbin/wallguard.sh} fetch $TMP '%s' '' " RW_CF_KEYS " custom%d </dev/null >/dev/null 2>&1",
+			 url, slot);
+	else
+		snprintf(out, sz, "$CURLC '%s' -o $TMP 2>/dev/null", url);
 }
 
 /* feed id from nvram must match a known feed (prevents arbitrary ids). */
@@ -1291,6 +1316,7 @@ static void rw_gen_update(int warden)
 		for (tok = strtok_r(list, "<", &save); tok; tok = strtok_r(NULL, "<", &save)) {
 			char nm[RW_CFEED_NAME_MAX + 2];
 			char u4[RW_CFEED_URL_MAX + 2], u6[RW_CFEED_URL_MAX + 2];
+			char fx[RW_CFEED_URL_MAX + 160];
 
 			/* Bound RECORDS PARSED, not feeds emitted. Counting only successes
 			 * made the cap cosmetic: a value full of junk records was walked in
@@ -1309,19 +1335,37 @@ static void rw_gen_update(int warden)
 				logmessage("rwarden", "custom feed \"%s\": URL rejected, feed SKIPPED", nm);
 				continue;
 			}
-			fprintf(f,
-			  "if $CURLC '%s' -o $TMP 2>/dev/null; then\n"
-			  "  grep -oE '([0-9]{1,3}\\.){3}[0-9]{1,3}(/[0-9]{1,2})?' $TMP | rw_f4 >> $NEW\n"
-			  "  OK=1\n"
-			  "else\n"
-			  "  logger -t rwarden \"custom feed fetch FAILED: %s\"\n"
-			  "fi\n", u4, nm);
-			if (rw_field(tok, 2, u6, sizeof(u6)) && *u6 && rw_valid_feedurl(u6))
+			/* 2026-11-15: an address with "$APIkey" is fetched by wallguard.sh's fetch, which fills in the key saved
+			 * for this feed's slot (nrec = its place in the list, as httpd numbers RW_CF_KEYS); 99 = no key saved.
+			 * A feed without it is fetched exactly as before. */
+			rw_cfeed_fetch(fx, sizeof(fx), u4, nrec);
+			if (strstr(u4, "$APIkey")) {
+				fprintf(f,
+				  "if %s; then\n"
+				  "  grep -oE '([0-9]{1,3}\\.){3}[0-9]{1,3}(/[0-9]{1,2})?' $TMP | rw_f4 >> $NEW\n"
