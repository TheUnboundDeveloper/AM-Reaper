+			while (fgets(line, sizeof(line), fp))
+				if (sscanf(line, "%63s %*s %x %63s %*s %63s", b, &flags, a, c) == 4 && (flags & 0x2) && !strncmp(c, "br", 2) &&
+				    strcmp(a, "00:00:00:00:00:00"))
+					rdn_feed_add(f, &n, a, b, NULL);
+		fclose(fp);
+	}
