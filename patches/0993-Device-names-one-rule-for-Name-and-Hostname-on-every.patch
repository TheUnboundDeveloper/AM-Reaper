+
+/* add mac (upper case) once; ip / lease name filled when given and still empty */
+static int rdn_feed_add(struct rdn_feed *f, int *n, const char *mac, const char *ip, const char *lh)
+{
+	int i, k;
+
+	if (!mac || strlen(mac) != 17 || mac[2] != ':' || mac[5] != ':' || mac[8] != ':' || mac[11] != ':' || mac[14] != ':')
+		return -1;
+	if ((i = rdn_feed_find(f, *n, mac)) < 0) {
+		if (*n >= RDN_FEED_MAX)
+			return -1;
+		i = (*n)++;
+		memset(&f[i], 0, sizeof(f[i]));
+		for (k = 0; k < 17; k++)
+			f[i].mac[k] = (char)toupper((unsigned char)mac[k]);
+	}
+	if (ip && *ip && !f[i].ip[0])
+		strlcpy(f[i].ip, ip, sizeof(f[i].ip));
+	if (lh && *lh && strcmp(lh, "*") && !f[i].lh[0])
+		strlcpy(f[i].lh, lh, sizeof(f[i].lh));
+	return i;
+}
