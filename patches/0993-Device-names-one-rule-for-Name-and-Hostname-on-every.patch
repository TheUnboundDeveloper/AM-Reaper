+/* a record "XXXXXX":"Maker" starts at i: a quote after '{', ',' or a line break, six hex digits, then ":" */
+static int oui_key(size_t i, char *key)
+{
+	int k;
+
+	if (i + 10 > oui_len || oui_map[i] != '"' || (i > 0 && oui_map[i - 1] != '{' && oui_map[i - 1] != ',' && oui_map[i - 1] != 10) ||
+	    oui_map[i + 7] != '"' || oui_map[i + 8] != ':' || oui_map[i + 9] != '"')
+		return 0;
+	for (k = 0; k < 6; k++) {
+		if (!isxdigit((unsigned char)oui_map[i + 1 + k]))
+			return 0;
+		key[k] = (char)toupper((unsigned char)oui_map[i + 1 + k]);
+	}
+	key[6] = 0;
+	return 1;
+}
+
+/* the first record starting at or after p (oui_len if none) */
+static size_t oui_next(size_t p, char *key)
+{
+	for (; p < oui_len; p++)
+		if (oui_map[p] == '"' && oui_key(p, key))
+			return p;
+	return oui_len;
+}
+
+int rdn_oui(const char *mac, char *out, size_t n)
+{
+	char hex[13], want[7], key[7];
+	size_t lo = 0, hi, mid, r, v, e;
+	int c;
+
+	out[0] = 0;
+	if (!rdn_mac_hex(mac, hex) || rdn_mac_private(mac) || !rdn_oui_open())
+		return 0;
+	memcpy(want, hex, 6);
+	want[6] = 0;
+	hi = oui_len;
+	/* invariant: a record for want, if any, starts in [lo, hi) */
+	while (lo < hi) {
+		mid = lo + (hi - lo) / 2;
+		r = oui_next(mid, key);
+		if (r >= hi) {
+			hi = mid;		/* no record starts in [mid, hi) */
+			continue;
+		}
+		c = strcmp(key, want);
+		if (c == 0) {
+			v = r + 10;		/* after "XXXXXX":" */
+			for (e = v; e < oui_len && oui_map[e] != '"' && oui_map[e] != 10; e++)
+				;
+			if (e < oui_len && oui_map[e] == '"')
+				rdn_copy(out, n, oui_map + v, e - v);
+			return out[0] != 0;
+		}
+		if (c < 0)
+			lo = r + 1;
+		else
+			hi = r;
+	}
+	return 0;
+}
+
+void rdn_hostname(const char *mac, const char *lease_host, char *out, size_t n)
+{
+	if (rdn_client_host(mac, lease_host, out, n))
+		return;
+	if (rdn_oui(mac, out, n))
+		return;
+	if (rdn_mac_private(mac))
+		snprintf(out, n, "%s", RDN_PRIVATE);
+	else
+		out[0] = 0;
+}
+
+void rdn_label(const char *mac, const char *lease_host, char *out, size_t n)
+{
+	if (!rdn_admin_name(mac, out, n))
+		rdn_hostname(mac, lease_host, out, n);
+}
