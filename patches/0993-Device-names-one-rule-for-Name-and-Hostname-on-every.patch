diff --git a/release/src/router/httpd/reaper_devname.c b/release/src/router/httpd/reaper_devname.c
new file mode 100644
index 0000000000..55b9d7a610
--- /dev/null
+++ b/release/src/router/httpd/reaper_devname.c
@@ -0,0 +1,270 @@
+/* SPDX-License-Identifier: GPL-2.0-only
+ * Copyright (C) 2026 the Reaper project maintainer
+ * Part of the Reaper hardened Asuswrt-Merlin build. See LICENSE / LICENSE.reaper.
+ *
+ * reaper_devname.c - one rule for every device label httpd prints (owner, 2026-11-15).
+ *
+ *   Name     = the name the network admin GAVE the device: the Devices page name (nvram custom_clientlist), the
+ *              one master Name list. The name typed with a DHCP reservation (dhcp_staticlist, 4th field) is the
+ *              device's DNS name (dnsmasq dhcp-host, /etc/hosts), not a Name (owner, 2026-11-15).
+ *   Hostname = what the CLIENT supplied (DHCP option 12, kept raw by shared/reaper_dhcpname.c; the lease file's name
+ *              only when it is not the reservation name - dnsmasq writes a reserved device's reservation name
+ *              there), else the manufacturer from the MAC prefix for a universally administered MAC, else
+ *              "Private-Address" for a locally administered (randomized / private) MAC.
+ *   A surface with one label shows Name if set, else Hostname. A surface with both shows each in its own column.
+ *
+ * Display only: nothing here is used to match, allow or block a device - Gatekeeper, the rules engine, Wallguard,
+ * QoS and DNS Director all key on the MAC / address. The OUI table is the one the image already ships for the stock
+ * network map ("XXXXXX":"Maker" records, sorted by prefix); it is mapped read-only and binary-searched in place by
+ * record (about 16 probes), never copied into httpd's memory.
+ */
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <strings.h>
+#include <ctype.h>
+#include <fcntl.h>
+#include <unistd.h>
+#include <sys/mman.h>
+#include <sys/stat.h>
+
+#include <bcmnvram.h>
+#include <shared.h>
+#include "reaper_devname.h"
+
+/* networkmap's table (one JSON line, the image's only copy: www/ajax/ouiDB.json links to it); a tree whose networkmap
+   ships none keeps the www copy (one record per line). Both are searched the same way: by record, not by line. */
+#define RDN_OUI_FILE	"/usr/networkmap/ieee.oui.json"
+#define RDN_OUI_FILE2	"/www/ajax/ouiDB.json"
+
+/* "aa:bb:cc:dd:ee:ff" in either case -> 1, and the 12 hex digits upper-case into hex (13 bytes) */
+static int rdn_mac_hex(const char *mac, char *hex)
+{
+	int i, j = 0;
+
+	if (!mac || strlen(mac) != 17)
+		return 0;
+	for (i = 0; i < 17; i++) {
+		if (i % 3 == 2) {
+			if (mac[i] != ':' && mac[i] != '-')
+				return 0;
+			continue;
+		}
+		if (!isxdigit((unsigned char)mac[i]))
+			return 0;
+		hex[j++] = (char)toupper((unsigned char)mac[i]);
+	}
+	hex[j] = 0;
+	return 1;
+}
+
+/* copy a label: printable ASCII and UTF-8 bytes, no control characters, at most n-1 bytes, never a partial
+   UTF-8 sequence at the end */
+static void rdn_copy(char *out, size_t n, const char *s, size_t len)
+{
+	size_t o = 0, i;
+
+	if (!n)
+		return;
+	for (i = 0; i < len && s[i] && o + 1 < n; i++) {
+		unsigned char c = (unsigned char)s[i];
+		if (c < 0x20 || c == 0x7f)
+			continue;
+		out[o++] = (char)c;
+	}
+	while (o > 0 && ((unsigned char)out[o - 1] & 0xc0) == 0x80)
+		o--;			/* a cut UTF-8 continuation: back to the lead byte ... */
+	if (o > 0 && ((unsigned char)out[o - 1] & 0xc0) == 0xc0)
+		o--;			/* ... and drop it */
+	while (o > 0 && out[o - 1] == ' ')
+		o--;
+	out[o] = 0;
+}
+
+int rdn_mac_private(const char *mac)
+{
+	char hex[13];
+
+	return rdn_mac_hex(mac, hex) && (strtol((char[]){ hex[0], hex[1], 0 }, NULL, 16) & 0x02);
+}
+
+/* the record of mac in a '<'-separated list whose field fi (0-based, '>'-separated) is the MAC; field fo copied */
+static int rdn_list_field(const char *list, int fi, int fo, const char *mac, char *out, size_t n)
+{
+	char *b, *rec, *sv = NULL;
+	int found = 0;
+
+	out[0] = 0;
+	if (!list || !*list || !(b = strdup(list)))
+		return 0;
+	for (rec = strtok_r(b, "<", &sv); rec && !found; rec = strtok_r(NULL, "<", &sv)) {
+		char *f[8] = { 0 }, *p = rec;
+		int k = 0;
+		while (k < 8) {
+			f[k++] = p;
+			if (!(p = strchr(p, '>')))
+				break;
+			*p++ = 0;
+		}
+		if (fi < k && fo < k && f[fi] && f[fo] && !strcasecmp(f[fi], mac) && *f[fo]) {
+			rdn_copy(out, n, f[fo], strlen(f[fo]));
+			found = out[0] != 0;
+		}
+	}
+	free(b);
+	return found;
+}
+
+static int rdn_resv_name(const char *mac, char *out, size_t n)
+{
+	return rdn_list_field(nvram_safe_get("dhcp_staticlist"), 0, 3, mac, out, n);
+}
+
+int rdn_admin_name(const char *mac, char *out, size_t n)
+{
+	char hex[13];
+
+	out[0] = 0;
+	if (!rdn_mac_hex(mac, hex))
+		return 0;
+	return rdn_list_field(nvram_safe_get("custom_clientlist"), 1, 0, mac, out, n);
+}
+
+int rdn_client_host(const char *mac, const char *lease_host, char *out, size_t n)
+{
+	char resv[RDN_NAME_MAX];
+
+	out[0] = 0;
+	if (reaper_dhcpname_get(mac, out, n) && out[0]) {
+		char t[RDN_NAME_MAX];
+		rdn_copy(t, sizeof(t), out, strlen(out));
+		snprintf(out, n, "%s", t);
+		return out[0] != 0;
+	}
+	out[0] = 0;
+	if (!lease_host || !*lease_host || !strcmp(lease_host, "*"))
+		return 0;
+	/* dnsmasq gives a reserved device its reservation name in the lease file: that is the admin's, not the client's */
+	if (rdn_resv_name(mac, resv, sizeof(resv)) && !strcasecmp(resv, lease_host))
+		return 0;
+	rdn_copy(out, n, lease_host, strlen(lease_host));
+	return out[0] != 0;
+}
+
+/* the OUI table, mapped once; remapped when the file changes (a firmware update replaces the whole image anyway) */
+static const char *oui_map;
+static size_t oui_len;
+static ino_t oui_ino;
+static time_t oui_mtime;
+
+static int rdn_oui_open(void)
+{
+	struct stat st;
+	const char *path = RDN_OUI_FILE;
+	int fd;
+
+	if (stat(path, &st) != 0 || !S_ISREG(st.st_mode) || st.st_size < 16) {
+		path = RDN_OUI_FILE2;
+		if (stat(path, &st) != 0 || !S_ISREG(st.st_mode) || st.st_size < 16)
+			return 0;
+	}
+	if (oui_map && st.st_ino == oui_ino && st.st_mtime == oui_mtime)
+		return 1;
+	if (oui_map) {
+		munmap((void *)oui_map, oui_len);
+		oui_map = NULL;
+	}
+	if ((fd = open(path, O_RDONLY)) < 0)
+		return 0;
+	oui_map = mmap(NULL, (size_t)st.st_size, PROT_READ, MAP_SHARED, fd, 0);
+	close(fd);
+	if (oui_map == MAP_FAILED) {
+		oui_map = NULL;
+		return 0;
+	}
+	oui_len = (size_t)st.st_size;
+	oui_ino = st.st_ino;
+	oui_mtime = st.st_mtime;
+	return 1;
+}
