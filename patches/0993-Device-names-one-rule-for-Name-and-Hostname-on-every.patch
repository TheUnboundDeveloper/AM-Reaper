+	if ((list = strdup(nvram_safe_get("custom_clientlist"))) != NULL) {
+		for (rec = strtok_r(list, "<", &sv); rec; rec = strtok_r(NULL, "<", &sv)) {
+			char *m = strchr(rec, '>'), *e;
+			if (!m)
+				continue;
+			m++;
+			if ((e = strchr(m, '>')) != NULL)
+				*e = 0;
+			rdn_feed_add(f, &n, m, NULL, NULL);
+		}
+		free(list);
+	}
+	if ((fp = fopen("/var/lib/misc/reaper_hostnames", "r")) != NULL) {
+		while (fgets(line, sizeof(line), fp))
+			if (sscanf(line, "%63[^\t]", a) == 1)
+				rdn_feed_add(f, &n, a, NULL, NULL);
+		fclose(fp);
+	}
+	websWrite(wp, "{");
+	for (i = 0; i < n; i++) {
+		rdn_admin_name(f[i].mac, name, sizeof(name));
+		rdn_hostname(f[i].mac, f[i].lh, host, sizeof(host));
+		websWrite(wp, "%s\"%s\":{\"n\":", i ? "," : "", f[i].mac);
+		gk_json_esc(wp, name);
+		websWrite(wp, ",\"h\":");
+		gk_json_esc(wp, host);
+		websWrite(wp, ",\"ip\":\"%s\"}", f[i].ip);
+	}
+	free(f);
+	return websWrite(wp, "}");
+}
