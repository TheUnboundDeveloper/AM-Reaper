+#define RDN_FEED_MAX 512
+struct rdn_feed { char mac[18]; char ip[INET_ADDRSTRLEN]; char lh[64]; };
+
+static int rdn_feed_find(struct rdn_feed *f, int n, const char *mac)
+{
+	int i;
+	for (i = 0; i < n; i++)
+		if (!strcasecmp(f[i].mac, mac))
+			return i;
+	return -1;
