+
+	if (!f)
+		return websWrite(wp, "{}");
+	/* leases first: they carry the address and the lease name */
+	if ((d = opendir("/var/lib/misc")) != NULL) {
+		while ((de = readdir(d)) != NULL) {
+			if (!reaper_leases_name_ok(de->d_name) || !strcmp(de->d_name, "reaper_hostnames"))
+				continue;
+			snprintf(line, sizeof(line), "/var/lib/misc/%s", de->d_name);
+			if (!(fp = fopen(line, "r")))
+				continue;
+			while (fgets(line, sizeof(line), fp))
+				if (sscanf(line, "%*u %63s %63s %63s", a, b, c) == 3) {
+					struct in_addr x;
+					if (inet_pton(AF_INET, b, &x) == 1)
