+int nghttp2_check_nonempty_header_name(const uint8_t *name, size_t len) {
+  const uint8_t *last;
+  int rv;
+
+  for (last = name + len; name != last; ++name) {
+    rv = VALID_HD_NAME_CHARS[*name];
+    if (rv != 1) {
+      return rv;
+    }
+  }
+
+  return 1;
+}
