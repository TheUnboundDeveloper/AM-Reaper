+
+typedef struct {
+  /* fstate is the current huffman decoding state. */
+  uint16_t fstate;
+  uint8_t flags;
+} nghttp2_hd_huff_decode_context;
+
+typedef struct {
+  /* The number of bits in this code */
+  uint32_t nbits;
+  /* Huffman code aligned to LSB */
+  uint32_t code;
+} nghttp2_huff_sym;
