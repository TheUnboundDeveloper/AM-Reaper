+{
+	struct h2 *h = ud;
+	union h2blk *b = ptr;
+
+	if (!b)
+		return;
+	b--;
+	h->mem -= b->n;
+	free(b);
+}
+
+static void *h2_calloc(size_t nmemb, size_t size, void *ud)
+{
+	void *p;
+
+	if (size && nmemb > H2_MEM_MAX / size)
+		return NULL;
+	if ((p = h2_malloc(nmemb * size, ud)))
+		memset(p, 0, nmemb * size);
+	return p;
+}
+
+static void *h2_realloc(void *ptr, size_t size, void *ud)
+{
+	struct h2 *h = ud;
+	union h2blk *b = ptr, *nb;
+
+	if (!b)
+		return h2_malloc(size, ud);
+	b--;
+	if (size > H2_MEM_MAX || h->mem - b->n + size > H2_MEM_MAX)
+		return NULL;		/* the old block stays as it was */
+	if (!(nb = realloc(b, sizeof(*nb) + size)))
+		return NULL;
+	h->mem = h->mem - nb->n + size;
+	nb->n = size;
+	return nb + 1;
+}
+
+static struct h2s *h2s_find(struct h2 *h, int32_t id)
+{
+	int i;
+
+	for (i = 0; i < H2_STREAMS; i++)
+		if (h->st[i].id == id)
+			return &h->st[i];
+	return NULL;
+}
+
+/* The stream is over. A query of it still waiting for dnsmasq is taken back, so nothing is
+   written to a dead stream and neither the pending slot nor the connection's in-flight
+   count leaks (a TCP retry for it finds the slot gone and closes itself: tcpre_io). */
+static void h2s_drop(struct conn *c, struct h2s *st)
+{
+	if (st->pend) {
+		struct pending *p = &pend[st->pend - 1];
+		if (p->used && p->conn == conn_index(c) && p->gen == c->gen && p->stream == st->id) {
+			pend_free(p);
+			c->inflight--;
+		}
+	}
+	if (st->answered && st->buf)
+		c->h2->held -= st->len - st->off;
+	free(st->buf);
+	memset(st, 0, sizeof(*st));
+}
+
+/* conn_close: every stream, then the session (which frees all nghttp2 held for it) */
+static void h2_end(struct conn *c)
+{
+	struct h2 *h = c->h2;
+	int i;
+
+	if (!h)
+		return;
+	for (i = 0; i < H2_STREAMS; i++)
+		if (h->st[i].id)
+			h2s_drop(c, &h->st[i]);
+	nghttp2_session_del(h->sess);
+	free(h);
+	c->h2 = NULL;
+}
+
+/* nghttp2's next chunk into the write buffer. Once pulled it has to be taken whole, so the
+   buffer may pass WBUF_MAX by that one chunk; h2_pump pulls nothing more until it is sent. */
+static int h2_out(struct conn *c, const unsigned char *d, size_t n)
+{
+	if (n > H2_CHUNK_MAX || c->wlen + n > WBUF_MAX + H2_CHUNK_MAX)
+		return -1;
+	if (c->wlen + n > c->wcap) {
+		size_t ncap = (c->wlen + n + 4095) & ~(size_t)4095;
+		unsigned char *nb = realloc(c->wbuf, ncap);
+		if (!nb)
+			return -1;
+		c->wbuf = nb;
+		c->wcap = ncap;
+	}
+	memcpy(c->wbuf + c->wlen, d, n);
+	c->wlen += n;
+	return 0;
+}
+
+/* Send what nghttp2 has ready, as far as the client takes it. Never from inside an nghttp2
+   callback (busy): the library is not to be re-entered, and whoever called it pumps after. */
+static void h2_pump(struct conn *c)
+{
+	struct h2 *h = c->h2;
+	int pulled;
+
+	if (h->busy || c->state != C_OPEN)
+		return;
+	h->busy = 1;
+	do {
+		pulled = 0;
+		if (c->woff && c->woff == c->wlen)
+			c->wlen = c->woff = 0;
+		while (!c->closing && c->wlen < WBUF_MAX) {	/* full: the rest waits inside nghttp2 */
+			const uint8_t *d;
+			nghttp2_ssize n = nghttp2_session_mem_send2(h->sess, &d);
+			if (n < 0 || (n > 0 && h2_out(c, d, (size_t)n)))
+				c->closing = 1;
+			if (n <= 0)
+				break;
+			pulled = 1;
+		}
+		if (!c->closing && c->woff < c->wlen)
+			conn_flush(c);
+		/* all of it left and there may be more: again. Otherwise POLLOUT brings us back. */
+	} while (pulled && !c->closing && !c->want_write);
+	h->busy = 0;
+	/* nghttp2 is done with the session (GOAWAY sent or taken, no stream left) and it is all out */
+	if (!c->closing && c->woff == c->wlen
+	    && !nghttp2_session_want_read(h->sess) && !nghttp2_session_want_write(h->sess))
+		c->closing = 1;
+}
+
+static nghttp2_nv h2_nv(const char *name, const char *value)
+{
+	nghttp2_nv nv;
+
+	/* nghttp2 copies both (NGHTTP2_NV_FLAG_NONE) and writes to neither */
+	nv.name = (uint8_t *)(uintptr_t)name;
+	nv.value = (uint8_t *)(uintptr_t)value;
+	nv.namelen = strlen(name);
+	nv.valuelen = strlen(value);
+	nv.flags = NGHTTP2_NV_FLAG_NONE;
+	return nv;
+}
+
+/* a request that is no DNS query for us: the status alone, no body */
+static void h2_refuse(struct conn *c, struct h2s *st, int status)
+{
+	char code[16];
+	nghttp2_nv nv;
+
+	if (st->answered)
+		return;
+	st->answered = 1;
+	st->pend = 0;
+	free(st->buf);
+	st->buf = NULL;
+	st->len = st->off = 0;
+	snprintf(code, sizeof(code), "%d", status);
+	nv = h2_nv(":status", code);
+	n_h2_err++;
+	c->last = now_ms();
+	if (nghttp2_submit_response2(c->h2->sess, st->id, &nv, 1, NULL))
+		c->closing = 1;
+	else
+		h2_pump(c);
+}
+
+/* How long a DoH client may keep an answer (RFC 8484 5.1): the lowest TTL among its answer
+   records; 0 when there is none, on SERVFAIL, or when the message does not parse. */
+static unsigned long answer_ttl(const unsigned char *m, size_t len)
+{
+	size_t o = 12;
+	unsigned i, qd, an;
+	unsigned long best = 0;
+
+	if (len < 12 || (m[3] & 0x0f) == 2)
+		return 0;
+	qd = (m[4] << 8) | m[5];
+	an = (m[6] << 8) | m[7];
+	for (i = 0; i < qd; i++) {
+		if (skip_name(m, len, &o) || o + 4 > len)
+			return 0;
+		o += 4;
+	}
+	for (i = 0; i < an; i++) {
+		unsigned long ttl;
+		unsigned rdlen;
+		if (skip_name(m, len, &o) || o + 10 > len)
+			return 0;
+		ttl = ((unsigned long)m[o + 4] << 24) | ((unsigned long)m[o + 5] << 16) | (m[o + 6] << 8) | m[o + 7];
+		rdlen = (m[o + 8] << 8) | m[o + 9];
+		if (o + 10 + rdlen > len)
+			return 0;
+		if (ttl & 0x80000000UL)		/* RFC 2181 8: a TTL with the top bit set counts as 0 */
+			ttl = 0;
+		if (!i || ttl < best)
+			best = ttl;
+		o += 10 + rdlen;
+	}
+	return best;
+}
+
+/* nghttp2 fetches the answer's bytes from the stream as the client's window lets them go */
+static nghttp2_ssize h2_body(nghttp2_session *s, int32_t stream, uint8_t *buf, size_t length,
+			     uint32_t *flags, nghttp2_data_source *src, void *ud)
+{
+	struct conn *c = ud;
+	struct h2s *st = h2s_find(c->h2, stream);
+	size_t n;
+
+	(void)s; (void)src;
+	if (!st || !st->answered || !st->buf)	/* cannot happen; if it does, this stream is reset, no more */
+		return NGHTTP2_ERR_TEMPORAL_CALLBACK_FAILURE;
+	n = st->len - st->off;
+	if (n > length)
+		n = length;
+	memcpy(buf, st->buf + st->off, n);
+	st->off += n;
+	c->h2->held -= n;
+	if (st->off == st->len)
+		*flags |= NGHTTP2_DATA_FLAG_EOF;
+	return (nghttp2_ssize)n;
+}
+
+/* answer_to: the answer for one request, with the client's own DNS ID already in it */
+static void h2_answer(struct conn *c, int32_t stream, const unsigned char *m, size_t len)
+{
+	struct h2 *h = c->h2;
+	struct h2s *st;
+	char clen[24], cc[32];
+	nghttp2_nv nv[4];
+	nghttp2_data_provider2 prd;
+
+	if (!h || !(st = h2s_find(h, stream)) || st->answered)
+		return;
+	st->pend = 0;
+	/* Answers wait in their streams until the client's flow-control window and the write
+	   buffer let them go. A client that takes none meets the end a DoT device that never
+	   reads meets in conn_send(): with other answers still waiting, one that would bring
+	   them past WBUF_MAX closes the connection. */
+	if (h->held && h->held + len > WBUF_MAX) {
+		c->closing = 1;
+		return;
+	}
+	free(st->buf);
+	st->len = st->off = 0;
+	st->from_path = 0;
+	if (!(st->buf = malloc(len ? len : 1))) {
+		c->closing = 1;
+		return;
+	}
+	memcpy(st->buf, m, len);
+	st->len = len;
+	st->answered = 1;
+	h->held += len;
+	snprintf(clen, sizeof(clen), "%lu", (unsigned long)len);
+	snprintf(cc, sizeof(cc), "max-age=%lu", answer_ttl(m, len));
+	nv[0] = h2_nv(":status", "200");
+	nv[1] = h2_nv("content-type", "application/dns-message");
+	nv[2] = h2_nv("content-length", clen);
+	nv[3] = h2_nv("cache-control", cc);
+	memset(&prd, 0, sizeof(prd));
+	prd.read_callback = h2_body;
+	if (nghttp2_submit_response2(h->sess, stream, nv, 4, &prd))
+		c->closing = 1;
+	else
+		h2_pump(c);
+}
+
+static int b64url(unsigned char ch)
+{
+	if (ch >= 'A' && ch <= 'Z') return ch - 'A';
+	if (ch >= 'a' && ch <= 'z') return ch - 'a' + 26;
+	if (ch >= '0' && ch <= '9') return ch - '0' + 52;
+	return ch == '-' ? 62 : ch == '_' ? 63 : -1;
+}
+
+/* GET /dns-query?dns=<base64url, no padding> (RFC 8484 4.1): the query into st->buf, or why
+   not into st->dns_err. Under H2_HDR_MAX a path cannot carry QMAX bytes; the 413 stays for
+   the day that limit is raised. */
+static void h2_dns_param(struct h2s *st, const uint8_t *s, size_t n)
+{
+	size_t i, o = 0, out = n / 4 * 3 + (n % 4 ? n % 4 - 1 : 0);
+	unsigned acc = 0;
+	int bits = 0;
+
+	st->has_dns = 1;
+	st->dns_err = 400;
+	if (n % 4 == 1 || st->buf)
+		return;
+	if (out > QMAX) {
+		st->dns_err = 413;
+		return;
+	}
+	if (!(st->buf = malloc(out ? out : 1))) {
+		st->status = 500;
+		return;
+	}
+	for (i = 0; i < n; i++) {
+		int v = b64url(s[i]);
+		if (v < 0) {
+			free(st->buf);
+			st->buf = NULL;
+			return;
+		}
+		acc = ((acc & 0xff) << 6) | (unsigned)v;
+		bits += 6;
+		if (bits >= 8) {
+			bits -= 8;
+			st->buf[o++] = (acc >> bits) & 0xff;
+		}
+	}
+	st->len = o;
+	st->from_path = 1;
+	st->dns_err = 0;
+}
+
+/* only "/dns-query", alone or followed by "?" and its parameters */
+static void h2_path(struct h2s *st, const uint8_t *p, size_t n)
+{
+	static const char want[] = "/dns-query";
+	size_t wl = sizeof(want) - 1, i, e;
+
+	if (n < wl || memcmp(p, want, wl) || (n > wl && p[wl] != '?'))
+		return;
+	st->path_ok = 1;
+	for (i = wl + 1; i < n; i = e + 1) {
+		for (e = i; e < n && p[e] != '&'; e++)
+			;
+		if (e - i >= 4 && !memcmp(p + i, "dns=", 4) && !st->has_dns)
+			h2_dns_param(st, p + i + 4, e - i - 4);
+	}
+}
+
+static int h2_is(const uint8_t *s, size_t n, const char *lit)
+{
+	return n == strlen(lit) && !memcmp(s, lit, n);
+}
+
+/* the request's headers are in: 0, or the status that refuses it */
+static int h2_judge(const struct h2s *st)
+{
+	if (st->status)
+		return st->status;
+	if (!st->path_ok)
+		return 404;
+	if (st->method == H2M_GET)
+		return st->has_dns ? st->dns_err : 400;
+	if (st->method != H2M_POST)
+		return 405;
+	if (!st->ctype_ok)
+		return 415;
+	return st->big_body ? 413 : 0;
+}
+
+/* the request is complete: refuse it, or hand its query to the path every DoT query takes */
+static void h2_request(struct conn *c, struct h2s *st)
+{
+	unsigned char *q;
+	size_t qlen;
+
+	st->req_done = 1;
+	if (st->answered)
+		return;
+	if (st->method == H2M_POST && st->from_path)	/* a POST's query is its body, and none came */
+		st->len = 0;
+	if (st->status || st->len < QMIN) {	/* an empty body or a message shorter than a DNS header: 400 */
+		h2_refuse(c, st, st->status ? st->status : 400);
+		return;
+	}
+	if (c->inflight >= MAX_INFLIGHT) {	/* DoT stops reading here; H2_STREAMS keeps DoH below it */
+		if (nghttp2_submit_rst_stream(c->h2->sess, NGHTTP2_FLAG_NONE, st->id, NGHTTP2_REFUSED_STREAM))
+			c->closing = 1;
+		return;
+	}
+	/* query_in may answer at once (SERVFAIL, 400) and so reuse st->buf: the query leaves it first */
+	q = st->buf;
+	qlen = st->len;
+	st->buf = NULL;
+	st->len = 0;
+	st->from_path = 0;
+	n_doh++;
+	c->last = now_ms();
+	query_in(c, q, qlen, st);
+	free(q);
+}
+
+static int h2_on_begin_headers(nghttp2_session *s, const nghttp2_frame *f, void *ud)
+{
+	struct conn *c = ud;
+	struct h2s *st;
+
+	if (f->hd.type != NGHTTP2_HEADERS || f->headers.cat != NGHTTP2_HCAT_REQUEST)
+		return 0;
+	if (!(st = h2s_find(c->h2, 0))) {
+		/* nghttp2 holds the client to H2_STREAMS itself - REFUSED_STREAM for the extra
+		   ones, a connection error once the client has acknowledged the limit - so a full
+		   table cannot happen. Should it, the same answer. */
+		if (nghttp2_is_fatal(nghttp2_submit_rst_stream(s, NGHTTP2_FLAG_NONE, f->hd.stream_id, NGHTTP2_REFUSED_STREAM)))
+			return NGHTTP2_ERR_CALLBACK_FAILURE;
+		return NGHTTP2_ERR_TEMPORAL_CALLBACK_FAILURE;
+	}
+	memset(st, 0, sizeof(*st));
+	st->id = f->hd.stream_id;
+	return 0;
+}
+
+static int h2_on_header(nghttp2_session *s, const nghttp2_frame *f, const uint8_t *name, size_t nl,
+			const uint8_t *val, size_t vl, uint8_t flags, void *ud)
+{
+	struct conn *c = ud;
+	struct h2s *st;
+
+	(void)flags;
+	if (f->hd.type != NGHTTP2_HEADERS || !(st = h2s_find(c->h2, f->hd.stream_id)))
+		return 0;
+	/* nghttp2 announces SETTINGS_MAX_HEADER_LIST_SIZE but holds no client to it: counted
+	   here the way RFC 7541 4.1 counts (name + value + 32 a field), trailers included */
+	st->hbytes += nl + vl + 32;
+	if (st->hbytes > H2_HDR_MAX) {
+		if (st->hbytes > H2_HDR_ABUSE && nghttp2_session_terminate_session(s, NGHTTP2_ENHANCE_YOUR_CALM))
+			return NGHTTP2_ERR_CALLBACK_FAILURE;
+		if (!st->status)
+			st->status = 431;
+		return 0;
+	}
+	if (f->headers.cat != NGHTTP2_HCAT_REQUEST)
+		return 0;		/* trailers say nothing we use */
+	if (h2_is(name, nl, ":method"))
+		st->method = h2_is(val, vl, "GET") ? H2M_GET : h2_is(val, vl, "POST") ? H2M_POST : H2M_OTHER;
+	else if (h2_is(name, nl, ":path"))
+		h2_path(st, val, vl);
+	else if (h2_is(name, nl, "content-type"))
+		st->ctype_ok = vl >= 23 && !strncasecmp((const char *)val, "application/dns-message", 23)
+			       && (vl == 23 || val[23] == ';' || val[23] == ' ');
+	else if (h2_is(name, nl, "content-length")) {
+		/* nghttp2 has checked that it is a number, and holds the body to it */
+		unsigned long v = 0;
+		size_t i;
+		for (i = 0; i < vl && v <= QMAX && val[i] >= '0' && val[i] <= '9'; i++)
+			v = v * 10 + (val[i] - '0');
+		st->big_body = v > QMAX;
+	}
+	return 0;
+}
+
+static int h2_on_invalid_header(nghttp2_session *s, const nghttp2_frame *f, const uint8_t *name, size_t nl,
+				const uint8_t *val, size_t vl, uint8_t flags, void *ud)
+{
+	struct conn *c = ud;
+	struct h2s *st;
+
+	(void)name; (void)val; (void)flags;
+	if (f->hd.type != NGHTTP2_HEADERS || !(st = h2s_find(c->h2, f->hd.stream_id)))
+		return 0;
+	st->hbytes += nl + vl + 32;
+	if (st->hbytes > H2_HDR_MAX) {
+		if (st->hbytes > H2_HDR_ABUSE && nghttp2_session_terminate_session(s, NGHTTP2_ENHANCE_YOUR_CALM))
+			return NGHTTP2_ERR_CALLBACK_FAILURE;
+		if (!st->status)
+			st->status = 431;
+		return NGHTTP2_ERR_TEMPORAL_CALLBACK_FAILURE;	/* the rest of this block is not looked at */
+	}
+	return 0;
+}
+
+static int h2_on_data(nghttp2_session *s, uint8_t flags, int32_t stream, const uint8_t *d, size_t len, void *ud)
+{
+	struct conn *c = ud;
+	struct h2s *st = h2s_find(c->h2, stream);
+
+	(void)s; (void)flags;
+	if (!stream || !st || st->answered || st->method != H2M_POST)
+		return 0;		/* a body nobody asked for is dropped as it arrives */
+	if (st->from_path) {		/* POST /dns-query?dns=...: the body is the query */
+		free(st->buf);
+		st->buf = NULL;
+		st->len = 0;
+		st->from_path = 0;
+	}
+	if (len > QMAX - st->len) {
+		h2_refuse(c, st, 413);
+		return 0;
+	}
+	if (!st->buf && !(st->buf = malloc(QMAX))) {
+		c->closing = 1;
+		return NGHTTP2_ERR_CALLBACK_FAILURE;
+	}
+	memcpy(st->buf + st->len, d, len);
+	st->len += len;
+	return 0;
+}
+
+static int h2_on_frame_recv(nghttp2_session *s, const nghttp2_frame *f, void *ud)
+{
+	struct conn *c = ud;
+	struct h2s *st;
+
+	(void)s;
+	if ((f->hd.type != NGHTTP2_HEADERS && f->hd.type != NGHTTP2_DATA) || !f->hd.stream_id
+	    || !(st = h2s_find(c->h2, f->hd.stream_id)))
+		return 0;
+	if (f->hd.type == NGHTTP2_HEADERS && f->headers.cat == NGHTTP2_HCAT_REQUEST) {
+		int status = h2_judge(st);
+		if (status)		/* at once: the body of a refused request is not waited for */
+			h2_refuse(c, st, status);
+	}
+	if (f->hd.flags & NGHTTP2_FLAG_END_STREAM)
+		h2_request(c, st);
+	return 0;
+}
+
+static int h2_on_frame_send(nghttp2_session *s, const nghttp2_frame *f, void *ud)
+{
+	struct conn *c = ud;
+	struct h2s *st;
+
+	if (f->hd.type == NGHTTP2_GOAWAY) {
+		if (f->goaway.error_code != NGHTTP2_NO_ERROR)
+			n_h2_err++;	/* the session ends on an error: protocol, flood, compression ... */
+	} else if (f->hd.type == NGHTTP2_HEADERS && (f->hd.flags & NGHTTP2_FLAG_END_STREAM)
+		   && (st = h2s_find(c->h2, f->hd.stream_id)) && !st->req_done) {
+		/* A refusal has gone out while the request was still arriving: the client is told
+		   to stop sending it (RFC 9113 8.1.1). Only now - an RST_STREAM submitted earlier
+		   would have cancelled the refusal itself. */
+		if (nghttp2_is_fatal(nghttp2_submit_rst_stream(s, NGHTTP2_FLAG_NONE, st->id, NGHTTP2_NO_ERROR)))
+			return NGHTTP2_ERR_CALLBACK_FAILURE;
+	}
+	return 0;
+}
+
+static int h2_on_stream_close(nghttp2_session *s, int32_t stream, uint32_t err, void *ud)
+{
+	struct conn *c = ud;
+	struct h2s *st = stream ? h2s_find(c->h2, stream) : NULL;
+
+	(void)s; (void)err;
+	if (st)
+		h2s_drop(c, st);
+	return 0;
+}
+
+static nghttp2_session_callbacks *h2_cbs;
+static nghttp2_option *h2_opt;
+
+/* once, before the first DoH connection: the callbacks and the limits every session gets */
+static int h2_setup(void)
+{
+	if (nghttp2_session_callbacks_new(&h2_cbs) || nghttp2_option_new(&h2_opt))
+		return -1;
