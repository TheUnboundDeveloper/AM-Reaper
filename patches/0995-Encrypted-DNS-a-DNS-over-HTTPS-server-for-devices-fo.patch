+/* 2026-11-10: two switches for the device-facing server - reaper_dot_srv (DNS-over-TLS, port 853) and
+   reaper_doh_srv (DNS-over-HTTPS, TCP 443). One daemon serves both. */
+static int red_dot_on(void)
+{
+	return nvram_get_int("reaper_dot_srv") == 1;
+}
+
+static int red_doh_on(void)
+{
+	return nvram_get_int("reaper_doh_srv") == 1;
+}
+
+/* DNS-over-HTTPS is not started while the router already serves something on TCP 443 itself: the web interface
+   set to that port, or an OpenVPN server on tcp/443 (it binds every address). NULL = free, else the reason the
+   page shows (httpd/web.c renc_doh_busy() makes the same two tests - keep them in step). A port forward of 443
+   is no conflict: it is translated before the router's own sockets are looked at. */
+static const char *red_doh_busy(void)
+{
+	char k[32], u[2] = "1";
+	int i;
+
+	if (nvram_get_int("http_enable") != 0 && nvram_get_int("https_lanport") == RED_DOH_PORT)
+		return "https";
+	/* review 2026-11-11 (C-6): Web Access from WAN over IPv6 has its own listener on the WAN HTTPS port. On 443 the
+		DNS-over-HTTPS rules dropped it and the two wanted the same port. The page shows the same reason as for the
+		LAN HTTPS port (httpd/web.c and rc/encdns.c make the same tests - keep them in step). */
+	if (nvram_get_int("misc_http_x") != 0 && nvram_get_int("misc_httpsport_x") == 443 && ipv6_enabled())
+		return "https";
+	for (i = 1; i <= 2; i++) {
+		u[0] = '0' + i;
+		snprintf(k, sizeof(k), "vpn_server%d_port", i);
+		if (nvram_get_int(k) != RED_DOH_PORT)
+			continue;
+		snprintf(k, sizeof(k), "vpn_server%d_proto", i);
+		if (strncmp(nvram_safe_get(k), "tcp", 3))
+			continue;
+		if (strstr(nvram_safe_get("vpn_serverx_start"), u))
+			return "ovpn";
+	}
+	return NULL;
+}
+
+/* the listener lines of one LAN-side address: 853 for DNS-over-TLS, 443 marked "doh" for DNS-over-HTTPS */
+static void red_listen(struct rb *r, const char *addr)
+{
+	if (red_dot_on())
+		rb_add(r, "listen %s %d\n", addr, RED_PORT);
+	if (red_doh_on() && !red_doh_busy())
+		rb_add(r, "listen %s %d doh\n", addr, RED_DOH_PORT);
+}
