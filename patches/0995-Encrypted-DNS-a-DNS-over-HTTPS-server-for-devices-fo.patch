+/* ---------------------------------------------------------------------------------------------------------
+ * 2026-11-10: automatic setup for devices - DHCP option 162 (RFC 9463, "DNR").
+ *
+ * The option names the router as an encrypted resolver: a name to authenticate, the address to connect to and
+ * the protocols (DNS-over-HTTPS with its path, DNS-over-TLS). A device that supports it switches to encrypted
+ * DNS by itself; every other device ignores an option it did not ask for. The device checks the certificate
+ * against the NAME in the option, so a publicly trusted certificate for the router's name is enough - and
+ * without one nothing is published, because a device would only fail and fall back.
+ * (The other discovery method, the _dns.resolver.arpa record of RFC 9462, is not used: its verified mode needs
+ * the LAN address inside the certificate, which no public CA issues.)
+ *
+ * Published per network, and only where the network's DNS server is the router itself (services.c, sdn.c).
+ * RED_DNR records what the running dnsmasq config publishes; red_dnr_sync() restarts dnsmasq when a switch or
+ * the certificate changed that.
+ */
+#define RED_DNR		RED_DIR "/dnr"		/* root's file: "<name> <dot> <doh>", empty = not published */
+
+/* a lower-case host name with at least two labels: the only thing that goes into the option and the file */
+static int red_name_ok(const char *s)
+{
+	size_t i, lab = 0, dots = 0, n = strlen(s);
+
+	if (n < 4 || n > 253)
+		return 0;
+	for (i = 0; i < n; i++) {
+		if (s[i] == '.') {
+			if (!lab)
+				return 0;
+			lab = 0;
+			dots++;
+		} else if ((s[i] >= 'a' && s[i] <= 'z') || (s[i] >= '0' && s[i] <= '9') || (s[i] == '-' && lab)) {
+			if (++lab > 63)
+				return 0;
+		} else
+			return 0;
+	}
+	return lab && dots;
+}
+
+/* The name a device should use, when the certificate chains to the router's CA bundle: the DDNS name when the
+   certificate covers it, else its first plain name (as the page's encPickName). 0 = nothing to publish.
+   The chain is checked without the clock, as rednsd does (at boot the clock is not set yet); a certificate
+   that has run out is refused once the clock is known. Parsed once per certificate file. */
+static int red_public_name(char *out, size_t outsz)
+{
+	static char c_name[256], c_dd[256];
+	static time_t c_mt, c_na;
+	static off_t c_sz = -1;
+	static long c_bad;	/* review 2026-11-11 (C-8): uptime of a parse that did not verify, 0 = the last one did */
+	struct stat sb;
+	char dd[256];
+	size_t i;
+
+	*out = 0;
+	if (stat(RED_CERT, &sb) != 0 || !f_exists(RED_KEY))
+		return 0;
+	snprintf(dd, sizeof(dd), "%s", nvram_safe_get("ddns_hostname_x"));
+	for (i = 0; dd[i]; i++)
+		dd[i] = tolower((unsigned char)dd[i]);
+	/* review 2026-11-11 (C-8): a chain that did not verify was remembered until the certificate file changed, so
+	 * a CA bundle that could not be read at that moment (early boot) kept the name unpublished for good. It is
+	 * tried again, at most once a minute. */
+	if (c_sz != sb.st_size || c_mt != sb.st_mtime || strcmp(c_dd, dd) || (c_bad && uptime() - c_bad >= 60)) {
+		BIO *b = BIO_new_file(RED_CERT, "r");
+		X509 *x = b ? PEM_read_bio_X509(b, NULL, NULL, NULL) : NULL, *c;
+		STACK_OF(X509) *chain = sk_X509_new_null();
+		X509_STORE *st = X509_STORE_new();
+		X509_STORE_CTX *sc = X509_STORE_CTX_new();
+		int trusted = 0;
+
+		c_name[0] = 0;
+		c_na = 0;
+		while (x && chain && (c = PEM_read_bio_X509(b, NULL, NULL, NULL)) != NULL)
+			if (!sk_X509_push(chain, c))
+				X509_free(c);
+		if (x && chain && st && sc && X509_check_issued(x, x) != X509_V_OK
+#if OPENSSL_VERSION_NUMBER >= 0x30000000L
+		    && X509_STORE_load_file(st, RED_CABUNDLE) == 1
+#else
+		    && X509_STORE_load_locations(st, RED_CABUNDLE, NULL) == 1
+#endif
+		    && X509_STORE_CTX_init(sc, st, x, chain) == 1) {
+			X509_VERIFY_PARAM_set_flags(X509_STORE_CTX_get0_param(sc), X509_V_FLAG_NO_CHECK_TIME);
+			trusted = X509_verify_cert(sc) == 1;
+		}
+		if (trusted) {
+			const ASN1_TIME *na = X509_get0_notAfter(x);
+			struct tm tm;
+
+			if (na && ASN1_TIME_to_tm(na, &tm) == 1)
+				c_na = timegm(&tm);
+			if (red_name_ok(dd) && X509_check_host(x, dd, 0, 0, NULL) == 1)
+				snprintf(c_name, sizeof(c_name), "%s", dd);
+			else {
+				GENERAL_NAMES *gens = X509_get_ext_d2i(x, NID_subject_alt_name, NULL, NULL);
+				int k;
+
+				for (k = 0; gens && !c_name[0] && k < sk_GENERAL_NAME_num(gens); k++) {
+					GENERAL_NAME *g = sk_GENERAL_NAME_value(gens, k);
+					char nm[256];
+					int l;
+
+					if (g->type != GEN_DNS)
+						continue;
+					l = ASN1_STRING_length(g->d.dNSName);
+					if (l <= 0 || l >= (int)sizeof(nm))
+						continue;
+					memcpy(nm, ASN1_STRING_get0_data(g->d.dNSName), l);
+					nm[l] = 0;
+					if ((int)strlen(nm) != l)
+						continue;
+					for (i = 0; nm[i]; i++)
+						nm[i] = tolower((unsigned char)nm[i]);
+					if (red_name_ok(nm))		/* a wildcard name is not one */
+						snprintf(c_name, sizeof(c_name), "%s", nm);
+				}
+				GENERAL_NAMES_free(gens);
+			}
+		}
+		X509_STORE_CTX_free(sc);
+		X509_STORE_free(st);
+		sk_X509_pop_free(chain, X509_free);
+		X509_free(x);
+		BIO_free(b);
+		ERR_clear_error();
+		c_sz = sb.st_size;
+		c_mt = sb.st_mtime;
+		snprintf(c_dd, sizeof(c_dd), "%s", dd);
+		c_bad = trusted ? 0 : (uptime() > 0 ? uptime() : 1);
+	}
+	if (!c_name[0])
+		return 0;
+	if (c_na && nvram_get_int("ntp_ready") == 1 && c_na < time(NULL))
+		return 0;
+	snprintf(out, outsz, "%s", c_name);
+	return 1;
+}
+
+/* the name in DNS wire format (RFC 8415 section 10): length-prefixed labels and the root */
+static size_t red_adn(unsigned char *o, size_t osz, const char *name)
+{
+	const char *p = name, *dot;
+	size_t n = 0, l;
+
+	while (*p) {
+		dot = strchr(p, '.');
+		l = dot ? (size_t)(dot - p) : strlen(p);
+		if (!l || l > 63 || n + l + 2 > osz)
+			return 0;
+		o[n++] = (unsigned char)l;
+		memcpy(o + n, p, l);
+		n += l;
+		p += l + (dot ? 1 : 0);
+	}
+	o[n++] = 0;
+	return n;
+}
+
+/* One "DNR Instance Data" (RFC 9463 section 5.1): length of what follows (2), service priority (2), name
+   length (1), name, address length (1), the address, then the service parameters in RFC 9460 wire format,
+   keys ascending: alpn (1) and, for DNS-over-HTTPS, dohpath (7). No port: 443 and 853 are the defaults.
+   0 = it does not fit. */
+static size_t red_dnr_instance(unsigned char *o, size_t osz, unsigned prio, const unsigned char *adn, size_t al,
+			       const unsigned char *ip, int doh)
+{
+	static const unsigned char s_doh[] = { 0, 1, 0, 3, 2, 'h', '2',
+					       0, 7, 0, 16, '/', 'd', 'n', 's', '-', 'q', 'u', 'e', 'r', 'y', '{', '?', 'd', 'n', 's', '}' };
+	static const unsigned char s_dot[] = { 0, 1, 0, 4, 3, 'd', 'o', 't' };
+	const unsigned char *sv = doh ? s_doh : s_dot;
+	size_t sl = doh ? sizeof(s_doh) : sizeof(s_dot), len = 2 + 1 + al + 1 + 4 + sl, n = 0;
+
+	if (al > 255 || len + 2 > osz)
+		return 0;
+	o[n++] = (unsigned char)(len >> 8);
+	o[n++] = (unsigned char)(len & 0xff);
+	o[n++] = (unsigned char)(prio >> 8);
+	o[n++] = (unsigned char)(prio & 0xff);
+	o[n++] = (unsigned char)al;
+	memcpy(o + n, adn, al);
+	n += al;
+	o[n++] = 4;
+	memcpy(o + n, ip, 4);
+	n += 4;
+	memcpy(o + n, sv, sl);
+	n += sl;
+	return n;
+}
+
+/* what a dnsmasq config written now publishes: "<name> <dot> <doh>", or "" */
+static void red_dnr_state(char *buf, size_t sz)
+{
+	char name[256];
+	int dot, doh;
+
+	*buf = 0;
+	if (!red_enabled() || !red_public_name(name, sizeof(name)))
+		return;
+	dot = red_dot_on();
+	doh = red_doh_on() && !red_doh_busy();
+	if (dot || doh)
+		snprintf(buf, sz, "%s %d %d", name, dot, doh);
+}
+
+/* One network's option line, into its dnsmasq config. tag = the network's DHCP tag, addr = the router's address
+   on it (where rednsd listens). DNS-over-HTTPS first: a device that can do both takes the lower priority number. */
+void rednsd_dnr_option(FILE *fp, const char *tag, const char *addr)
+{
+	char st[300], name[256], hex[3 * 255 + 1];
+	unsigned char opt[255], adn[256], ip[4];
+	size_t al, n = 0, k, i;
+	int dot = 0, doh = 0;
+
+	if (!fp || !tag || !*tag || !addr || inet_pton(AF_INET, addr, ip) != 1)
+		return;
+	red_dnr_state(st, sizeof(st));
+	if (sscanf(st, "%255s %d %d", name, &dot, &doh) != 3 || !(al = red_adn(adn, sizeof(adn), name)))
+		return;
+	if (doh) {
+		if (!(k = red_dnr_instance(opt + n, sizeof(opt) - n, 1, adn, al, ip, 1)))
+			return;
+		n += k;
+	}
+	if (dot) {
+		if (!(k = red_dnr_instance(opt + n, sizeof(opt) - n, 2, adn, al, ip, 0)))
+			return;
+		n += k;
+	}
+	if (!n)
+		return;
+	for (i = 0; i < n; i++)
+		snprintf(hex + 3 * i, 4, "%02x%s", opt[i], i + 1 < n ? ":" : "");
+	fprintf(fp, "dhcp-option=%s,162,%s\n", tag, hex);
+}
+
+/* end of start_dnsmasq(): record what this config publishes */
+void rednsd_dnr_mark(void)
+{
+	char st[300];
+
+	red_dnr_state(st, sizeof(st));
+	if (!*st && !f_exists(RED_DNR))
+		return;
+	if (reaper_secure_dir(RED_DIR, 0755) == 0)
+		reaper_write_atomic(RED_DNR, st, strlen(st), 0644);
+}
+
+/* after rednsd was started, stopped or refreshed: when the running dnsmasq config publishes something else than
+   it should now (a switch, the certificate, the port), dnsmasq is restarted once. Its start writes RED_DNR
+   again; it is also written here, so a config path that never reaches the mark cannot make this repeat. */
+static void red_dnr_sync(void)
+{
+	static int busy;
+	char want[300], have[300] = "", *nl;
+
+	if (busy)
+		return;
+	red_dnr_state(want, sizeof(want));
+	f_read_string(RED_DNR, have, sizeof(have));
+	if ((nl = strpbrk(have, "\r\n")) != NULL)
+		*nl = 0;
+	if (!strcmp(want, have) || !pids("dnsmasq"))
+		return;
+	busy = 1;
+	logmessage("rednsd", "automatic setup for devices (DHCP option 162) %s", *want ? "is offered" : "is withdrawn");
+	/* as the dnsmasq service verb does it (restart_dnsmasq() is not built on every platform) */
+#ifdef RTCONFIG_MULTILAN_CFG
+	stop_dnsmasq(ALL_SDN);
+	start_dnsmasq(ALL_SDN);
+#else
+	stop_dnsmasq();
+	start_dnsmasq();
+#endif
+	if (reaper_secure_dir(RED_DIR, 0755) == 0)
+		reaper_write_atomic(RED_DNR, want, strlen(want), 0644);
+	busy = 0;
+}
+
 void stop_rednsd(void)
 {
 	if (pids("rednsd"))
 		killall_tk("rednsd");
 }
 
-void start_rednsd(void)
+static void red_start(void)
 {
 	struct rb s, p;
 	struct passwd *pw;
@@ -267,6 +600,16 @@ void start_rednsd(void)
 		unlink(RED_NOTE);
 		return;
 	}
+	if (red_doh_on() && red_doh_busy()) {
+		logmessage("rednsd", "DNS-over-HTTPS for devices is not started: TCP %d on the router is in use (%s)%s",
+			   RED_DOH_PORT, red_doh_busy(), red_dot_on() ? "; DNS-over-TLS is not affected" : "");
+		if (!red_dot_on()) {	/* nothing left to listen on */
+			unlink(RED_CONF);
+			unlink(RED_STATUS);
+			red_status_note("doh_port");
+			return;
+		}
+	}
 	if (!f_exists(RED_CERT) || !f_exists(RED_KEY)) {
 		logmessage("rednsd", "Encrypted DNS for devices waits for the router's certificate");
 		unlink(RED_CONF);	/* rwatch respawns rednsd only while rc has a config out */
@@ -296,7 +639,7 @@ void start_rednsd(void)
 
 /* After a LAN, guest network, WAN or DNS Director change: rewrite the config and tell
