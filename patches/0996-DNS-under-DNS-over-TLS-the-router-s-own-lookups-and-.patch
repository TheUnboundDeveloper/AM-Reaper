From a2788cb5afb73566a67cf14cb16a217419188047 Mon Sep 17 00:00:00 2001
From: reaper <theunbounddeveloper@outlook.com>
Date: Wed, 11 Nov 2026 20:17:20 -0500
Subject: [PATCH] DNS under DNS-over-TLS: the router's own lookups and the
 health check (102.8 line)

- With DNS-over-TLS on, the router's own lookups (every program reading /tmp/resolv.conf) still
  went to the WAN servers in plain text. wan.c now points the router's resolver at the local
  forwarder in that case, as stubby's own profile does; the DNS page restarts it when the profile
  or the server list changes.
- The DNS Health Check under DNS-over-TLS asks the watched server over DNS-over-TLS when it is one
  of the DoT servers, else through the forwarder; no plain probe leaves the router and it moves
  nothing. Before the clock is set nothing is counted. The DNS Failover page says how it asks; the
  LAN name check reads Active, Inactive or Fault.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 release/src/router/rc/rdnshc.c             | 283 ++++++++++++++++++++-
 release/src/router/rc/wan.c                |  62 +++++
 release/src/router/www/Reaper_DNS.asp      |   6 +-
 release/src/router/www/Reaper_Failover.asp |  16 +-
 4 files changed, 358 insertions(+), 9 deletions(-)

diff --git a/release/src/router/rc/rdnshc.c b/release/src/router/rc/rdnshc.c
index 8957425351d..a946b4c94d2 100644
--- a/release/src/router/rc/rdnshc.c
+++ b/release/src/router/rc/rdnshc.c
@@ -63,6 +63,12 @@
 #include <sys/sysinfo.h>
 #include <netinet/in.h>
 #include <arpa/inet.h>
+#include <ctype.h>
+#include <poll.h>
+#include <time.h>
+#include <openssl/ssl.h>
+#include <openssl/err.h>
+#include <openssl/x509v3.h>	/* 2026-11-10: the DNS-over-TLS probe */
 #ifdef RTCONFIG_MULTILAN_CFG
 #include "sdn.h"
 #endif
@@ -76,6 +82,17 @@
 #define HC_RESOLV	"/tmp/resolv.conf"
 #define HC_MAXLINES	256
 #define HC_LINE		256
+/* 2026-11-10: the probe under DNS-over-TLS (hc_dot_mode) */
+#ifndef HC_FWD
+#define HC_FWD		"127.0.1.1"	/* the DNS-over-TLS forwarder (stubby), loopback only */
+#endif
+#ifndef HC_FWD_PORT
+#define HC_FWD_PORT	53
+#endif
+#ifndef HC_CABUNDLE
+#define HC_CABUNDLE	"/etc/ssl/certs/ca-certificates.crt"
+#endif
+#define HC_DOT_MULT	3		/* TCP + TLS handshake + the query: three times the admin's timeout */
 
 struct hc_cfg {
 	int enable;
@@ -283,6 +300,200 @@ static int probe_addr(const struct hc_cfg *c, const char *addr, int af)
 	return (rc == 0 && an > 0);
 }
 
+/* DNSHC-DOT-BEGIN (host-tested by test_dnshc_dot.py)
+ * 2026-11-10 (owner): with DNS-over-TLS on, the check sends no plain query out of the router.
+ *   'p' = DNS-over-TLS is off: the plain probe on port 53 and the failover, as before;
+ *   't' = it is on and the watched server (either address) is one of its servers: that server is asked over
+ *         DNS-over-TLS on its own port, its certificate checked against the name the row gives (as stubby
+ *         checks it); a row without a name is judged on an encrypted answer alone;
+ *   's' = it is on and the watched server is not one of them: the router's DNS-over-TLS forwarder (stubby) is
+ *         asked over loopback, and reaches its servers encrypted.
+ * DNS-over-TLS counts as on exactly when the router's own lookups use it (rc/wan.c dot_has_upstream): the switch,
+ * router mode, and a row with an IPv4 address, or an IPv6 one while IPv6 is enabled. */
+struct hc_dot {
+	char addr[INET6_ADDRSTRLEN];
+	int af, port;
+	char host[256];
+};
+
+static int hc_dot_mode(const char *target, const char *alt, struct hc_dot *d)
+{
+	char *nv, *nvp, *b, *server, *tlsport, *hostname, *spkipin;
+	unsigned char bin[sizeof(struct in6_addr)];
+	char canon[INET6_ADDRSTRLEN];
+	int on = 0, mode = 0, af, port;
+	size_t i;
+
+	memset(d, 0, sizeof(*d));
+	if (nvram_get_int("dnspriv_enable") != 1 || !is_routing_enabled())
+		return 'p';
+	nv = nvp = strdup(nvram_safe_get("dnspriv_rulelist"));
+	while (nvp && (b = strsep(&nvp, "<")) != NULL) {
+		server = tlsport = hostname = spkipin = NULL;
+		if (vstrsep(b, ">", &server, &tlsport, &hostname, &spkipin) < 4 || !*server)
+			continue;
+		port = *tlsport ? safe_atoi(tlsport) : 853;
+		if (port <= 0 || port > 65535)
+			continue;
+		if (inet_pton(AF_INET, server, bin) == 1)
+			af = AF_INET;
+		else if (inet_pton(AF_INET6, server, bin) == 1 && ipv6_enabled())
+			af = AF_INET6;
+		else
+			continue;
+		on = 1;
+		if (mode == 't' || (af == AF_INET6 && !hc_v6_usable()))
+			continue;	/* the first match wins; an IPv6 row the router cannot reach now is not asked directly */
+		inet_ntop(af, bin, canon, sizeof(canon));
+		if ((target && *target && !strcmp(canon, target)) || (alt && *alt && !strcmp(canon, alt))) {
+			strlcpy(d->addr, canon, sizeof(d->addr));
+			d->af = af;
+			d->port = port;
+			for (i = 0; hostname[i]; i++)
+				if (!(isalnum((unsigned char)hostname[i]) || hostname[i] == '.' || hostname[i] == '-'))
+					break;
+			if (!hostname[i] && i > 0 && i < sizeof(d->host))
+				strlcpy(d->host, hostname, sizeof(d->host));
+			mode = 't';
+		}
+	}
+	free(nv);
+	if (!on)
+		return 'p';
+	return mode ? mode : 's';
+}
+
+static long long hc_ms(void)
+{
+	struct timespec t;
+
+	clock_gettime(CLOCK_MONOTONIC, &t);
+	return (long long)t.tv_sec * 1000 + t.tv_nsec / 1000000;
+}
+
+/* 1 = fd is ready for ev before the deadline, 0 = it is not (time, an error, or a stop) */
+static int hc_wait(int fd, short ev, long long deadline)
+{
+	struct pollfd p;
+	long long left;
+	int r;
+
+	for (;;) {
+		left = deadline - hc_ms();
+		if (left <= 0 || g_stop)
+			return 0;
+		p.fd = fd;
+		p.events = ev;
+		p.revents = 0;
+		r = poll(&p, 1, (int)left);
+		if (r > 0)
+			return !(p.revents & (POLLERR | POLLNVAL)) || ((ev & POLLIN) && (p.revents & POLLIN));
+		if (r == 0 || errno != EINTR)
+			return 0;
+	}
+}
+
+/* an SSL call that wants the socket: wait for it; 0 = give up */
+static int hc_ssl_wait(SSL *s, int r, int fd, long long deadline)
+{
+	int e = SSL_get_error(s, r);
+
+	if (e == SSL_ERROR_WANT_READ)
+		return hc_wait(fd, POLLIN, deadline);
+	if (e == SSL_ERROR_WANT_WRITE)
+		return hc_wait(fd, POLLOUT, deadline);
+	return 0;
+}
+
+static SSL_CTX *hc_ssl_ctx;
+
+/* <name> A IN over DNS-over-TLS (RFC 7858: a 2-byte length, then the message). The rcode of a reply with our id,
+ * -1 for none (no connection, a refused certificate, silence, garbage) - like dns_ask(). */
+static int dot_ask(const struct hc_dot *d, const char *name, int timeout_ms, int *ancount)
+{
+	unsigned char pkt[2 + 512], ans[2 + 4096];
+	struct sockaddr_storage ss;
+	socklen_t slen, sel;
+	unsigned short id;
+	long long dl = hc_ms() + timeout_ms;
+	int fd, len, r, rc = -1, have, want, se = 0;
+	SSL *s = NULL;
+
+	if (ancount) *ancount = 0;
+	if ((len = dns_build(pkt + 2, sizeof(pkt) - 2, name, &id)) < 0) return -1;
+	pkt[0] = (unsigned char)(len >> 8);
+	pkt[1] = (unsigned char)(len & 0xff);
+	if (!dns_sockaddr(&ss, &slen, d->addr, d->af, d->port)) return -1;
+	if (!hc_ssl_ctx) {
+		if (!(hc_ssl_ctx = SSL_CTX_new(TLS_client_method()))) return -1;
+		SSL_CTX_set_min_proto_version(hc_ssl_ctx, TLS1_2_VERSION);
+		/* without the bundle a named server cannot be verified, and its probe is a miss - never a pass */
+		SSL_CTX_load_verify_locations(hc_ssl_ctx, HC_CABUNDLE, NULL);
+	}
+	if ((fd = socket(d->af == AF_INET6 ? AF_INET6 : AF_INET, SOCK_STREAM | SOCK_NONBLOCK | SOCK_CLOEXEC, 0)) < 0) return -1;
+	if (connect(fd, (struct sockaddr *)&ss, slen) < 0 && errno != EINPROGRESS)
+		goto out;
+	sel = sizeof(se);
+	if (!hc_wait(fd, POLLOUT, dl) || getsockopt(fd, SOL_SOCKET, SO_ERROR, &se, &sel) || se)
+		goto out;
+	if (!(s = SSL_new(hc_ssl_ctx)) || SSL_set_fd(s, fd) != 1)
+		goto out;
+	if (*d->host) {
+		SSL_set_tlsext_host_name(s, (char *)d->host);
+		if (SSL_set1_host(s, d->host) != 1)
+			goto out;
+		SSL_set_verify(s, SSL_VERIFY_PEER, NULL);
+	} else
+		SSL_set_verify(s, SSL_VERIFY_NONE, NULL);
+	while ((r = SSL_connect(s)) != 1)
+		if (!hc_ssl_wait(s, r, fd, dl))
+			goto out;
+	for (have = 0; have < len + 2; ) {
+		if ((r = SSL_write(s, pkt + have, len + 2 - have)) > 0)
+			have += r;
+		else if (!hc_ssl_wait(s, r, fd, dl))
+			goto out;
+	}
+	for (have = 0, want = 2; have < want; ) {
+		if ((r = SSL_read(s, ans + have, want - have)) > 0) {
+			have += r;
+			if (want == 2 && have == 2) {
+				want = 2 + ((ans[0] << 8) | ans[1]);
+				if (want < 2 + 12 || want > (int)sizeof(ans))
+					goto out;
+			}
+		} else if (!hc_ssl_wait(s, r, fd, dl))
+			goto out;
+	}
+	if (ans[2] == (id >> 8) && ans[3] == (id & 0xff) && (ans[4] & 0x80)) {
+		rc = ans[5] & 0x0f;
+		if (ancount) *ancount = (ans[8] << 8) | ans[9];
+	}
+out:
+	if (s) {
+		SSL_shutdown(s);	/* one try; a non-blocking socket may not take it, and nothing waits for it */
+		SSL_free(s);
+	}
+	close(fd);
+	ERR_clear_error();
+	return rc;
+}
+
+/* the probe under DNS-over-TLS: 1 = answered (strict: NOERROR + a record), 0 = not */
+static int probe_dot(const struct hc_cfg *c, int mode, const struct hc_dot *d)
+{
+	int an = 0, rc;
+
+	if (mode == 't')
+		rc = dot_ask(d, c->name, c->timeout_ms * HC_DOT_MULT, &an);
+	else
+		rc = dns_ask(HC_FWD, AF_INET, HC_FWD_PORT, c->name, c->timeout_ms * HC_DOT_MULT, &an);
+	if (rc < 0) return 0;
+	if (!c->strict) return 1;
+	return (rc == 0 && an > 0);
+}
+/* DNSHC-DOT-END */
+
 /* Does this line name the target as a plain upstream? For the servers-file
  * that is "server=<ip>" or "server=<ip>#port" (a "server=/domain/<ip>" line
  * is a domain route and is left where it is); for resolv.conf it is
@@ -434,6 +645,7 @@ static const char *fam_name(int i) { return i ? "IPv6" : "IPv4"; }
  * IPv6 face is configured but the router has no usable IPv6 (not probed).
  * Readers that know only the first three fields keep working. */
 static char g_f4 = '-', g_f6 = '-';
+static char g_dmode = 'p';	/* 2026-11-10: field 6 - p port 53, t over DNS-over-TLS, s through the DoT forwarder */
 static void state_set(const char *what, long since, int alive)
 {
 	char st[64];
@@ -441,7 +653,7 @@ static void state_set(const char *what, long since, int alive)
 	if (strcmp(what, "off") == 0)
 		snprintf(st, sizeof(st), "%s %ld %d", what, since > 0 ? now_s() - since : 0, alive);
 	else
-		snprintf(st, sizeof(st), "%s %ld %d %c %c", what, since > 0 ? now_s() - since : 0, alive, g_f4, g_f6);
+		snprintf(st, sizeof(st), "%s %ld %d %c %c %c", what, since > 0 ? now_s() - since : 0, alive, g_f4, g_f6, g_dmode);
 	nvram_set("reaper_dnshc_state", st);
 }
 
@@ -766,6 +978,8 @@ int rdnshc_main(int argc, char *argv[])
 	int down = 0, misses = 0, hits = 0, last_enabled = -1, i, alive = -1, v6_warned = 0;
 	int uplink_down = 0, held = 0;	/* v3.3.4: misses are not counted while the WAN is known down */
 	int v6skip_warned = 0;
+	int dmode = 'p', last_dmode = 0;	/* 2026-11-10: hc_dot_mode() this tick / last tick (0 = none yet) */
+	struct hc_dot dt;
 	/* 2026-10-08: each face counted on its own with the same thresholds, so one
 	 * dead face is moved behind the others while the live one keeps the
 	 * server's place. Index 0 = IPv4, 1 = IPv6; fseen = probed at least once. */
@@ -798,6 +1012,15 @@ int rdnshc_main(int argc, char *argv[])
 	}
 	cfg_read(&c);
 
+	/* 2026-11-10: publish the LAN name resolution state once at start. ld
+	 * begins LDNS_OFF and landns_tick() publishes only on a change, so with
+	 * the check switched off from boot reaper_landns_state was never written
+	 * (it has no default, and the last instance cleared it on exit) and the
+	 * dashboard read the empty value as "not checked yet" instead of
+	 * "switched off". With the check on, the first landns_tick() below
+	 * replaces this with "unk" in the same pass. */
+	landns_publish(&ld, now_s());
+
 	while (!g_stop) {
 		int enabled, poll;
 		int ok4 = -1, ok6 = -1;	/* this tick: 1 answered, 0 silent, -1 not probed */
@@ -811,6 +1034,7 @@ int rdnshc_main(int argc, char *argv[])
 		} else
 			v6_warned = 0;
 
+		dmode = enabled ? hc_dot_mode(c.target, c.alt, &dt) : 'p';
 		if (enabled != last_enabled) {
 			if (enabled)
 				logmessage(HC_TAG, "DNS Health Check Enabled - watching %s every %d s (query %s, timeout %d ms, %s reply counts; fail over after %d misses, restore after %d hits)%s",
@@ -821,10 +1045,10 @@ int rdnshc_main(int argc, char *argv[])
 
 		/* the watched server changed (or the feature went off) while a
 		 * demotion is in place: give the old one its place back first */
-		if ((down || fdown[0] || fdown[1]) && (!enabled || strcmp(watched, c.target) != 0)) {
+		if ((down || fdown[0] || fdown[1]) && (!enabled || strcmp(watched, c.target) != 0 || dmode != 'p')) {
 			update_resolvconf();	/* plain stock order: the old server is nobody's to arrange now */
 			hc_reload();
-			logmessage(HC_TAG, "DNS Health Check RESTORED %s to its stock place in the router's DNS list: %s", watched, enabled ? "a different server is being watched now" : "the check was switched off");
+			logmessage(HC_TAG, "DNS Health Check RESTORED %s to its stock place in the router's DNS list: %s", watched, !enabled ? "the check was switched off" : dmode != 'p' ? "DNS-over-TLS is on, so the router's DNS list holds its forwarder and the check moves nothing" : "a different server is being watched now");
 			down = 0; misses = hits = 0; since = 0;
 			for (i = 0; i < 2; i++) { fmiss[i] = fhit[i] = fdown[i] = fseen[i] = 0; }
 			unlink(HC_STATE);
@@ -843,6 +1067,59 @@ int rdnshc_main(int argc, char *argv[])
 		}
 		strlcpy(watched, c.target, sizeof(watched));
 
+		/* 2026-11-10 (owner): DNS-over-TLS on = no plain probe leaves the router (hc_dot_mode). Status only: with
+		 * DNS-over-TLS the router's DNS list holds its forwarder alone, and the forwarder uses its other servers by
+		 * itself, so nothing is moved, reloaded or gated here (a demotion left from port-53 mode was undone above). */
+		if (dmode != last_dmode) {
+			if (dmode == 't')
+				logmessage(HC_TAG, "DNS Health Check: DNS-over-TLS is on - %s is asked over DNS-over-TLS (port %d%s%s) instead of port 53; failover is left to the DNS-over-TLS forwarder",
+					dt.addr, dt.port, *dt.host ? ", name " : ", no name to check", dt.host);
+			else if (dmode == 's')
+				logmessage(HC_TAG, "DNS Health Check: DNS-over-TLS is on and %s is not one of its servers - the check asks the router's DNS-over-TLS forwarder instead, so no plain query leaves the router; failover is left to the forwarder", c.target);
+			else if (last_dmode)
+				logmessage(HC_TAG, "DNS Health Check: DNS-over-TLS is off - %s is asked on port 53 again", c.target);
+			if (last_dmode) {
+				down = 0; misses = hits = 0; since = now_s(); held = 0;
+				for (i = 0; i < 2; i++) { fmiss[i] = fhit[i] = fdown[i] = fseen[i] = 0; }
+			}
+			last_dmode = dmode;
+		}
+		g_dmode = (char)dmode;
+		if (dmode != 'p') {
+			const char *who = (dmode == 't') ? c.target : "the DNS-over-TLS forwarder";
+			int ok = -1;
+			if (nvram_get_int("ntp_ready") == 1)
+				ok = probe_dot(&c, dmode, &dt);
+			alive = (ok == 1);
+			/* before the clock is set no certificate can be judged: not a miss (ok < 0), as a known-down uplink */
+			uplink_down = !alive && (ok < 0 || nvram_match("link_wan", "0") ||
+				(*nvram_safe_get("wan0_state_t") && nvram_get_int("wan0_state_t") != 2));
+			if (alive) { hits++; misses = 0; }
+			else if (!uplink_down) { misses++; hits = 0; }
+			if (uplink_down && !held) {
+				logmessage(HC_TAG, "DNS Health Check HOLD: %s - misses are not counted until then",
+					ok < 0 ? "the router's clock is not set yet, and DNS-over-TLS cannot be checked before it is" : "the uplink is down");
+				held = 1;
+			} else if (!uplink_down && held) {
+				logmessage(HC_TAG, "DNS Health Check: %s is judged normally again", who);
+				held = 0;
+			}
+			if (!alive && !down && !uplink_down)
+				logmessage(HC_TAG, "DNS Health Check: %s did not answer over DNS-over-TLS within %d ms (miss %d of %d)", who, c.timeout_ms * HC_DOT_MULT, misses, c.fail);
+			if (!down && misses >= c.fail) {
+				down = 1; since = now_s(); hits = 0;
+				logmessage(HC_TAG, "DNS Health Check: %s is NOT answering over DNS-over-TLS (%d misses) - nothing is moved; the DNS-over-TLS forwarder uses its other servers by itself", who, misses);
+			} else if (down && hits >= c.recover) {
+				logmessage(HC_TAG, "DNS Health Check: %s answers over DNS-over-TLS again (%d hits) after %ld s", who, hits, now_s() - since);
+				down = 0; misses = 0; since = now_s();
+			}
+			g_f4 = g_f6 = '-';
+			state_set(down ? "down" : "up", since ? since : (since = now_s()), alive);
+			poll = c.interval;
+			for (i = 0; i < poll && !g_stop; i++) sleep(1);
+			continue;
+		}
+
 		/* Both faces, each only over a family that can actually carry a query.
 		 * hc_v6_usable() is two local nvram reads, so a router with IPv6 off or
 		 * nothing delegated skips v6 without a socket and without a wait; it
diff --git a/release/src/router/rc/wan.c b/release/src/router/rc/wan.c
index c3584cb4399..75c4613f61a 100644
--- a/release/src/router/rc/wan.c
+++ b/release/src/router/rc/wan.c
@@ -3073,6 +3073,39 @@ void wan_add_resolv_dnsmasq_ipv6(FILE* fp, int wan6_unit)
 }
 #endif
 
+#ifdef RTCONFIG_DNSPRIVACY
+/* reaper 2026-11-10: does dnspriv_rulelist hold at least one server stubby
+ * will accept (the same tests start_stubby and _start_sdn_stubby apply)?
+ * stubby builds its context from the OS resolver (getdns_context_create(.., 1))
+ * and its config names /tmp/resolv.conf, so with no usable upstream it would
+ * query whatever this file names - and once the router's resolver points at
+ * dnsmasq that is a dnsmasq -> stubby -> dnsmasq loop. */
+static int dot_has_upstream(void)
+{
+	char *nv, *nvp, *b, *server, *tlsport, *hostname, *spkipin;
+	unsigned char addr[sizeof(struct in6_addr)];
+	int ok = 0, port;
+
+	nv = nvp = strdup(nvram_safe_get("dnspriv_rulelist"));
+	while (!ok && nvp && (b = strsep(&nvp, "<")) != NULL) {
+		server = tlsport = hostname = spkipin = NULL;
+		if (vstrsep(b, ">", &server, &tlsport, &hostname, &spkipin) < 4 || *server == '\0')
+			continue;
+		port = *tlsport ? safe_atoi(tlsport) : 0;
+		if (port < 0 || port > 65535)
+			continue;
+		if (inet_pton(AF_INET, server, addr) > 0
+#ifdef RTCONFIG_IPV6
+		 || (ipv6_enabled() && inet_pton(AF_INET6, server, addr) > 0)
+#endif
+		)
+			ok = 1;
+	}
+	free(nv);
+	return ok;
+}
+#endif
+
 int update_resolvconf(void)
 {
 	FILE *fp, *fp_servers;
@@ -3089,6 +3122,25 @@ int update_resolvconf(void)
 #endif
 #ifdef RTCONFIG_DNSPRIVACY
 	int dnspriv_enable = nvram_get_int("dnspriv_enable");
+	/* reaper 2026-11-10: the router's OWN lookups (ntpd, DDNS, list fetches,
+	 * the firmware check - every libc caller) read /tmp/resolv.conf, and with
+	 * DNS-over-TLS on, stock still wrote the plain WAN servers here, so those
+	 * lookups left on :53 unencrypted while every LAN query went dnsmasq ->
+	 * stubby -> TLS. Merlin's "use local caching DNS server as system
+	 * resolver" (dns_local_cache) covered this until 3006.102.1 removed it
+	 * over SDN; the SDN dnsmasq instances run no-resolv + servers-file and
+	 * never read this file, so pointing it at the main dnsmasq on loopback is
+	 * safe. Strict profile: loopback only - glibc moves on to the next
+	 * nameserver after a SERVFAIL, which would send the name out in plain
+	 * text. Opportunistic: the WAN servers stay behind loopback as the
+	 * fallback, the same thing stubby does in that profile. Before the first
+	 * NTP sync stubby runs UDP/TCP (tls_possible = ntp_ready), so the clock
