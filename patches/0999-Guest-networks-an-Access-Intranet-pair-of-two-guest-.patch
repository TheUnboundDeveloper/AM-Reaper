+/* reaper 2026-11-16: the enabled networks, for the pair tests above (rg_main_access, rg_peers). One table for the
+ * firewall, the resolver's hosts and mDNS, so the three cannot disagree about what a pair means. */
+static int rg_refs_load(struct rg_ref *refs, int max)
+{
+	MTLAN_T *pmtl = (MTLAN_T *)INIT_MTLAN(sizeof(MTLAN_T));
+	CP_TYPE_RL cpt;
+	char lan[IFNAMSIZ];
+	size_t sz = 0, i;
+	int n = 0;
+
+	if (!pmtl)
+		return 0;
+	strlcpy(lan, nvram_safe_get("lan_ifname"), sizeof(lan));
+	if (!lan[0])
+		strlcpy(lan, "br0", sizeof(lan));
+	if (get_mtlan(pmtl, &sz)) {
+		for (i = 0; i < sz && n < max; i++) {
+			const MTLAN_T *m = &pmtl[i];
+
+			if (m->enable != 1)
+				continue;
+			memset(&refs[n], 0, sizeof(refs[n]));
+			refs[n].idx = m->sdn_t.sdn_idx;
+			/* no bridge of its own: it rides the main LAN */
+			strlcpy(refs[n].br, m->nw_t.br_ifname[0] ? m->nw_t.br_ifname : lan, sizeof(refs[n].br));
+			strlcpy(refs[n].ifname, m->nw_t.ifname[0] ? m->nw_t.ifname : refs[n].br, sizeof(refs[n].ifname));
+			if (m->sdn_t.cp_idx > 0) {
+				memset(&cpt, 0, sizeof(cpt));
+				if (get_cp_type_byidx(m->sdn_t.cp_idx, &cpt))
+					refs[n].portal = (cpt.cp_type == 1 || cpt.cp_type == 2 || cpt.cp_type == 4);
+			}
+			n++;
+		}
+	}
+	FREE_MTLAN((void *)pmtl);
+	return n;
+}
