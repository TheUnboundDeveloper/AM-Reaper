+/* REAPER-GUEST-PAIR-BEGIN (also compiled on the host by test_mdns_reflector.py) */
+/* reaper 2026-11-16 (bug review A1, owner-approved): what an Access Intranet pair means to this layer.
+ * sdn_access_rl is "<a>b" pairs of sdn_idx (sdn.js parse_StrToJSON_sdn_access_rl_list). A pair has no direction, and
+ * the stock firewall turns it into forwarding, both ways, between exactly those two networks (rc/firewall_sdn.c
+ * handle_SDN_internal_access); index 0 is the Main Network. The test used here before read "named in ANY pair" as
+ * "may reach the main network": two guest networks paired with each other both dropped out of guest isolation
+ * (router services, main-LAN names, mDNS and the VPN-down protection all open again), and a Guest Portal named in
+ * any pair let its guests open connections to the main LAN although Main Network was never ticked. Now:
+ *   rg_main_access  true only when the OTHER end of one of the network's pairs is the main network - sdn_idx 0, or
+ *                   an enabled network that sits on the LAN bridge
+ *   rg_peers        the other ends that are isolated guest networks themselves: the two may forward to each other
+ *                   (rg_iface) and nothing else changes for either
+ * A pair end that names no enabled network (deleted, switched off) is ignored, as the stock firewall ignores it. */
+struct rg_ref {
+	int idx;		/* sdn_idx */
+	char ifname[IFNAMSIZ];	/* the interface the FORWARD chain sees: tun22 / tun23 for a portal, else the bridge */
+	char br[IFNAMSIZ];	/* the bridge */
+	int portal;		/* a Guest Portal network */
+};
+
+/* the k-th well-formed pair of the list, k from 0; 0 when there is no such pair */
+static int rg_pair(const char *rl, int k, int *a, int *b)
 {
 	const char *p = rl;
-	int a, b;
 
 	while (p && *p) {
 		if (*p == '<')
 			p++;
-		a = b = -1;
-		if (sscanf(p, "%d>%d", &a, &b) == 2 && (a == idx || b == idx))
+		*a = *b = -1;
+		if (sscanf(p, "%d>%d", a, b) == 2 && k-- == 0)
 			return 1;
 		p = strchr(p, '<');
 	}
 	return 0;
 }
 
+static const struct rg_ref *rg_ref_of(const struct rg_ref *refs, int n, int idx)
+{
+	int i;
+
+	for (i = 0; i < n; i++)
+		if (refs[i].idx == idx)
+			return &refs[i];
+	return NULL;
+}
+
+/* is this pair end the main network: index 0, or an enabled network on the LAN bridge */
+static int rg_is_main(int idx, const struct rg_ref *refs, int n, const char *lanif)
+{
+	const struct rg_ref *r;
+
+	if (idx == 0)
+		return 1;
+	r = idx > 0 ? rg_ref_of(refs, n, idx) : NULL;
+	return r && !strcmp(r->br, (lanif && *lanif) ? lanif : "br0");
+}
+
+/* has network idx main-network access: one of its pairs has the main network at the other end */
+static int rg_main_access(const char *rl, int idx, const struct rg_ref *refs, int n, const char *lanif)
+{
+	int k, a, b;
+
+	for (k = 0; rg_pair(rl, k, &a, &b); k++)
+		if (a != b && ((a == idx && rg_is_main(b, refs, n, lanif)) || (b == idx && rg_is_main(a, refs, n, lanif))))
+			return 1;
+	return 0;
+}
+
+/* the interfaces of the guest networks paired with network idx, into out[0..max-1]; returns how many.
+ * A peer is enabled, not the main network, not a portal, and has no main-network access itself: a network with
+ * main-network access holds the admin's own devices, which a guest must never reach. A portal has no peers (owner
+ * rule 2026-11-13: a portal never reaches another guest network), and neither has a network outside this layer. */
+static int rg_peers(const char *rl, int idx, const struct rg_ref *refs, int n, const char *lanif,
+		    char out[][IFNAMSIZ], int max)
+{
+	const struct rg_ref *x = idx > 0 ? rg_ref_of(refs, n, idx) : NULL, *p;
+	int k, a, b, o, i, np = 0;
+
+	if (!x || x->portal || rg_is_main(idx, refs, n, lanif) || rg_main_access(rl, idx, refs, n, lanif))
+		return 0;
+	for (k = 0; rg_pair(rl, k, &a, &b); k++) {
+		if (a == b || (a != idx && b != idx))
+			continue;
+		o = (a == idx) ? b : a;
+		p = o > 0 ? rg_ref_of(refs, n, o) : NULL;
+		if (!p || p->portal || !p->ifname[0] || rg_is_main(o, refs, n, lanif) || rg_main_access(rl, o, refs, n, lanif))
+			continue;
+		if (!strcmp(p->ifname, x->ifname))
+			continue;	/* one interface: its own traffic already passes */
+		for (i = 0; i < np && strcmp(out[i], p->ifname); i++)
+			;
+		if (i == np && np < max)
+			snprintf(out[np++], IFNAMSIZ, "%s", p->ifname);
+	}
+	return np;
+}
