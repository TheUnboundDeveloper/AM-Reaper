+/* reaper 2026-11-16 (bug review A1): Access Intranet pairs, read per network (G1, G3).
+ * sdn_access_rl is "<a>b" pairs of network indexes; a pair is two-way forwarding between exactly those two networks
+ * and index 0 is the main network. An index resolves to its bridge through the saved lists, the way the firewall
+ * build reads them: sdn_rl "<idx>name>enable>vlan>subnet>...", field 11 = its captive portal, and subnet_rl
+ * "<idx>bridge>...". A network with no VLAN / subnet of its own rides the main LAN. Returns 0 for an index that
+ * names no enabled network - such a pair is ignored, as the firewall build ignores it. */
+static int sdn_bridge(int idx, char *out, size_t ol, int *portal)
+{
+	char rec[512], sub[768], key[16], f[24];
+	out[0] = 0; *portal = 0;
+	if (idx == 0) { snprintf(out, ol, "%s", lan_ifname); return 1; }
+	if (idx < 0) return 0;
+	snprintf(key, sizeof(key), "%d", idx);
+	if (!rec_byname(nv_get("sdn_rl"), key, rec, sizeof(rec))) return 0;
+	if (!rec_field(rec, 2, f, sizeof(f)) || atoi(f) != 1) return 0;
+	if (rec_field(rec, 11, f, sizeof(f)) && atoi(f) > 0) *portal = 1;
+	if (!rec_field(rec, 3, f, sizeof(f)) || atoi(f) <= 0 || !rec_field(rec, 4, f, sizeof(f)) || atoi(f) <= 0) {
+		snprintf(out, ol, "%s", lan_ifname);
+		return 1;
+	}
+	snprintf(key, sizeof(key), "%d", atoi(f));
+	if (!rec_byname(nv_get("subnet_rl"), key, sub, sizeof(sub)) || !rec_field(sub, 1, out, ol) || !out[0]) return 0;
+	return 1;
+}
+
+/* the k-th well-formed pair of sdn_access_rl, k from 0 */
+static int sdn_pair(int k, int *a, int *b)
+{
+	const char *p = nv_get("sdn_access_rl");
+	while (p && *p) {
+		if (*p == '<') p++;
+		*a = *b = -1;
+		if (sscanf(p, "%d>%d", a, b) == 2 && k-- == 0) return 1;
+		p = strchr(p, '<');
+	}
+	return 0;
+}
+
+/* a network on bridge br is paired with the main network */
+static int sdn_main_access(const char *br)
+{
+	char ba[20], bb[20]; int k, a, b, pa, pb;
+	for (k = 0; sdn_pair(k, &a, &b); k++) {
+		if (a == b || !sdn_bridge(a, ba, sizeof(ba), &pa) || !sdn_bridge(b, bb, sizeof(bb), &pb)) continue;
+		if ((!strcmp(ba, br) && !strcmp(bb, lan_ifname)) || (!strcmp(bb, br) && !strcmp(ba, lan_ifname))) return 1;
+	}
+	return 0;
+}
+
+/* the guest bridges paired with bridge br, as rc/reaper_guest.c rg_peers picks them: neither end a captive-portal
+ * network, neither end paired with the main network (such a network holds the admin's own devices). Returns how many. */
+static int sdn_peers(const char *br, char out[][20], int max)
+{
+	char ba[20], bb[20]; const char *o; int k, a, b, pa, pb, i, n = 0;
+	if (!strcmp(br, lan_ifname) || sdn_main_access(br)) return 0;
+	for (k = 0; sdn_pair(k, &a, &b); k++) {
+		if (a == b || !sdn_bridge(a, ba, sizeof(ba), &pa) || !sdn_bridge(b, bb, sizeof(bb), &pb) || pa || pb) continue;
+		if (!strcmp(ba, br)) o = bb; else if (!strcmp(bb, br)) o = ba; else continue;
+		if (!strcmp(o, br) || !strcmp(o, lan_ifname) || sdn_main_access(o)) continue;
+		for (i = 0; i < n && strcmp(out[i], o); i++) { }
+		if (i == n && n < max) snprintf(out[n++], 20, "%.19s", o);
+	}
+	return n;
+}
