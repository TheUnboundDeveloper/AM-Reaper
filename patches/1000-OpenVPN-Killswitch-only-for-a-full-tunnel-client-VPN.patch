@@ -184,6 +184,19 @@ static int ppbr_target(const char *t, int *code, const char **table, int *failcl
 		/* P3: the client's Killswitch, the same key VPN Director reads */
 		snprintf(nv, sizeof(nv), "vpn_client%c_enforce", t[4]);
 		*failclosed = (nvram_get_int(nv) && ovpn_is_client_enabled(t[4] - '0')) ? 1 : 0;
+		/* reaper 2026-11-16: only where the tunnel carries the default route - Redirect "all" (1) or "VPN Director"
+		 * (2) on a TUN client. With Redirect "No", or TAP, the client's table holds pushed routes only: the prohibit
+		 * under the lookup then refused Internet traffic WHILE THE TUNNEL WAS UP, and the client page hides the switch
+		 * in that mode. Merlin's own Killswitch paths skip it there too (libovpn/amvpn_routing.c). Nothing stored is
+		 * changed. */
+		if (*failclosed) {
+			int rgw;
+			snprintf(nv, sizeof(nv), "vpn_client%c_rgw", t[4]);
+			rgw = nvram_get_int(nv);
+			snprintf(nv, sizeof(nv), "vpn_client%c_if", t[4]);
+			if ((rgw != 1 && rgw != 2) || !strncmp(nvram_safe_get(nv), "tap", 3))
+				*failclosed = 0;
+		}
 		return 1;
 	}
 	if (!strncmp(t, "WGC", 3) && t[3] >= '1' && t[3] <= '5' && t[4] == '\0') {
