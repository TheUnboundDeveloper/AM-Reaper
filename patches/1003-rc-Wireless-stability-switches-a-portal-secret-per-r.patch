+/* review 2026-11-11 (B-C4, owner): the portal secret ties the sign-in page (uamsrv's closed portal module) to chilli.
+ * The stock defaults ("chillispot", "ua8k69fo92n") are the same public value on every router, so a guest who knows
+ * the protocol could compute a valid sign-in and skip the passcode or the terms page. Before a portal config is
+ * written, a secret that is empty or one of those is replaced ONCE by 16 random characters, stored encrypted exactly
+ * as httpd stores a CKN_ENC_SVR value (web.c nvram_check -> set_enc_nvram) and kept across reboots. An admin's own
+ * secret (Tweaks > Guest Portal) is never replaced. lighttpd's nvram_get_uamsecret() decrypts the same way, so both
+ * ends of the sign-in always hold the same secret. */
+static void __attribute__((unused)) reaper_uam_secret_ensure(const char *key)
+{
+	static const char *const reaper_pub[] = { "chillispot", "ua8k69fo92n", NULL };
+	static const char reaper_abc[] = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789";
+	char *raw = nvram_safe_get(key);
+	char dec[128], val[17];
+	unsigned char rnd[16];
+	int i, weak = (*raw == '\0');
+
+	memset(dec, 0, sizeof(dec));
+#ifdef RTCONFIG_NVRAM_ENCRYPT
+	if (*raw && strlen(raw) < sizeof(dec))
+		pw_dec(raw, dec, strlen(raw), 1);	/* the same call the config writers below make */
+#endif
+	for (i = 0; !weak && reaper_pub[i]; i++)
+		if (!strcmp(raw, reaper_pub[i]) || !strcmp(dec, reaper_pub[i]))
+			weak = 1;
+	memset(dec, 0, sizeof(dec));
+	if (!weak)
+		return;
+	if (f_read("/dev/urandom", rnd, sizeof(rnd)) != (int)sizeof(rnd)) {
+		logmessage("captive portal", "%s: no random bytes - the portal secret was left as it is", key);
+		return;
+	}
+	for (i = 0; i < 16; i++)
+		val[i] = reaper_abc[rnd[i] % 62];
+	val[16] = '\0';
+#ifdef RTCONFIG_NVRAM_ENCRYPT
+	{
+		char enc[2048];
+
+		memset(enc, 0, sizeof(enc));
+		set_enc_nvram((char *)key, val, enc);
+		nvram_set(key, enc);
+	}
+#else
+	nvram_set(key, val);
+#endif
+	nvram_commit();
+	memset(val, 0, sizeof(val));
+	logmessage("captive portal", "%s: this router now has its own random portal secret (the stock default is the same on every router)", key);
+}
