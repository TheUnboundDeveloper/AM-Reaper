+
+/* review 2026-11-11 (A-C1): the "Radio call timeout" switch (Tweaks > Wireless stability, reaper_dhd_ioto, ms).
+ * The Wi-Fi driver waits up to 5000 ms for a radio to answer one call ("dhd -i <radio> ioctl_timeout" reads it).
+ * In the GT-BE19000 field stalls DHCP, DNS and routing changes waited while a radio did not answer. The wait can
+ * be set, per radio, with that same setting. OFF by default (0 = the driver's own 5000). Allowed 2000-5000: a
+ * much shorter wait risks the driver giving up on a radio that would have recovered.
+ * The driver's value is put back before every wireless teardown (wl down and MLO teardown can be slow) and set
+ * again when the radios are up; the watchdog sets it again every five minutes, since the value can go back to
+ * the default after a radio reset. REAPER_DHD_IOTO_MARK exists while the short value is in the radios. */
+#define REAPER_DHD_IOTO_STOCK	5000
+#define REAPER_DHD_IOTO_MARK	"/tmp/reaper/dhd_ioto"
+
+static int
+reaper_dhd_ioto_want(void)
+{
+	int v = nvram_get_int("reaper_dhd_ioto");
+
+	return (v >= 2000 && v <= REAPER_DHD_IOTO_STOCK) ? v : 0;
+}
+
+/* every radio the dhd driver runs; a radio on the wl driver (dhd_probe != 0) has no such wait */
+static void
+reaper_dhd_ioto_set(int ms)
+{
+	char ifs[128], word[32], *next;
+
+	strlcpy(ifs, nvram_safe_get("wl_ifnames"), sizeof(ifs));
+	foreach (word, ifs, next)
+		if (dhd_probe(word) == 0)
+			dhd_iovar_setint(word, "ioctl_timeout", ms);
+}
+
+void
+reaper_dhd_ioto_apply(void)
+{
+	int want = reaper_dhd_ioto_want();
+
+	if (want && want != REAPER_DHD_IOTO_STOCK) {
+		reaper_dhd_ioto_set(want);
+		if (!f_exists(REAPER_DHD_IOTO_MARK))
+			logmessage("reaper", "radio call timeout: %d ms on every radio (the driver's own is %d)", want, REAPER_DHD_IOTO_STOCK);
+		f_write_string(REAPER_DHD_IOTO_MARK, "1", 0, 0);
+	} else if (f_exists(REAPER_DHD_IOTO_MARK)) {
+		reaper_dhd_ioto_set(REAPER_DHD_IOTO_STOCK);
+		unlink(REAPER_DHD_IOTO_MARK);
+		logmessage("reaper", "radio call timeout: back to the driver's own %d ms", REAPER_DHD_IOTO_STOCK);
+	}
+}
+
+/* before a wireless teardown: the driver's own wait while the radios go down (no log line - apply() sets it again) */
+void
+reaper_dhd_ioto_stock(void)
+{
+	if (f_exists(REAPER_DHD_IOTO_MARK)) {
+		reaper_dhd_ioto_set(REAPER_DHD_IOTO_STOCK);
+		unlink(REAPER_DHD_IOTO_MARK);
+	}
+}
+
+/* the watchdog, every tick (1 s): every 300 s, and only while the short value is meant to be in the radios */
+void
+reaper_dhd_ioto_watch(void)
+{
+	static unsigned tick;
+	int want;
+
+	if (++tick % 300 || !f_exists(REAPER_DHD_IOTO_MARK))
+		return;
+	if ((want = reaper_dhd_ioto_want()) != 0 && want != REAPER_DHD_IOTO_STOCK)
+		reaper_dhd_ioto_set(want);
 }
 
