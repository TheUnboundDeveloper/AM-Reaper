 /* the kept copy's bytes (audit 2026-10-16 C2: it is rewritten only when they differ) */
+/* review 2026-11-11 (C-7): the AiMesh controller's own lock on its channel file, asked for WITHOUT waiting for ever.
+ * file_lock() waits as long as it takes (F_SETLKW), and this runs in rc itself inside every wireless restart: a
+ * controller stuck while holding the lock wedged rc and every service after it. A read lock, twenty tries 100 ms
+ * apart; when it is not given the caller uses the kept snapshot of the plan. */
+static int mc_lock_try(void)
+{
+	struct flock fl;
+	int fd, i;
+
+	if ((fd = open("/var/lock/chanspec.lock", O_CREAT | O_RDWR, 0600)) < 0)
+		return -1;
+	for (i = 0; i < 20; i++) {
+		memset(&fl, 0, sizeof(fl));
+		fl.l_type = F_RDLCK;
+		if (fcntl(fd, F_SETLK, &fl) == 0)
+			return fd;
+		if (errno != EACCES && errno != EAGAIN && errno != EINTR)
+			break;
+		usleep(100 * 1000);
+	}
+	close(fd);
+	return -1;
+}
 static size_t mc_snap_load(char *have, size_t len)
 {
 	FILE *f = fopen(MC_NODES_SNAP, "r");
@@ -903,12 +928,17 @@ static int mc_load(struct mc_nodes *nds, int held[MC_NB])
 		held[i] = 0;
 	mc_nop_read(rec, sizeof(rec));
 	memcpy(was, rec, sizeof(was));
-	lock = file_lock("chanspec");
-	f = fopen(MC_JSON, "r");
-	n = f ? fread(buf, 1, sizeof(buf) - 1, f) : 0;
-	if (f)
-		fclose(f);
-	file_unlock(lock);
+	lock = mc_lock_try();	/* review 2026-11-11 (C-7): bounded; was file_lock("chanspec") */
+	if (lock >= 0) {
+		f = fopen(MC_JSON, "r");
+		n = f ? fread(buf, 1, sizeof(buf) - 1, f) : 0;
+		if (f)
+			fclose(f);
+		close(lock);
+	} else {
+		n = 0;	/* the kept snapshot, below */
+		logmessage("reaper_bwfloor", "the AiMesh controller holds its channel file - the kept node plan is used this time");
+	}
 	m = mc_snap_load(have, sizeof(have));
 	if (n) {
 		buf[n] = 0;
