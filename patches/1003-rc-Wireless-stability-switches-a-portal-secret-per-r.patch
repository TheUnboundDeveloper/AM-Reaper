+static void reaper_cfgmnt_private(void)
+{
+	const char *dir = "/jffs/.sys/cfg_mnt";
+	struct dirent *de;
+	struct stat st;
+	char p[320];
+	DIR *d = opendir(dir);
+
+	if (!d)
+		return;
+	while ((de = readdir(d)) != NULL) {
+		if (de->d_name[0] == '.' || strlen(de->d_name) > 255)
+			continue;
+		snprintf(p, sizeof(p), "%s/%s", dir, de->d_name);
+		if (lstat(p, &st) == 0 && S_ISREG(st.st_mode) && (st.st_mode & 077))
+			chmod(p, st.st_mode & 0700);
+	}
+	closedir(d);
+}
