+			strlcpy(j->src, "set", sizeof(j->src));
+		}
 		/* a LAN bridge that exists: brN (main LAN br0, SDN bridges br52...) */
-		if (strncmp(ifc, "br", 2) || !ifc[2] || strlen(ifc) > 6 || strspn(ifc + 2, "0123456789") != strlen(ifc + 2))
-			return "E_IFACE";
-		snprintf(path, sizeof(path), "/sys/class/net/%s", ifc);
-		if (stat(path, &st) != 0)
+		if (!rnet_br_ok(j->iface))
 			return "E_IFACE";
+		rnet_wake_net(j->iface, j->net, sizeof(j->net));
 		rnet_arg(j, "ether-wake");
-		rnet_arg(j, "-i"); rnet_arg(j, ifc);
+		rnet_arg(j, "-i"); rnet_arg(j, j->iface);
 		rnet_arg(j, "-b");
 		rnet_arg(j, target);
 		j->limit = 10;
@@ -29873,6 +30078,15 @@ do_reaper_net_cgi(char *url, FILE *stream)
 		if ((f = fopen(RNET_LOCK, "w")) != NULL)
 			fclose(f);
 		rnet_state("RUNNING", 0, 0, &rnet_job);
+		/* reaper 2026-11-16: a wake names the bridge it goes out on, in the log and in the reply (the page
+		 * shows the network). iface is brN and net an IPv4 address, both checked in rnet_build. */
+		if (rnet_job.iface[0]) {
+			logmessage("reaper_net", "%s %s on %s (%s)", rnet_job.tool, rnet_job.target, rnet_job.iface, rnet_job.src);
+			reaper_detach(rnet_worker, &rnet_job);
+			websWrite(stream, "{\"ok\":1,\"iface\":\"%s\",\"src\":\"%s\",\"net\":\"%s\"}",
+				  rnet_job.iface, rnet_job.src, rnet_job.net);
+			return;
+		}
 		logmessage("reaper_net", "%s %s", rnet_job.tool, rnet_job.target);
 		reaper_detach(rnet_worker, &rnet_job);
 		websWrite(stream, "{\"ok\":1}");
