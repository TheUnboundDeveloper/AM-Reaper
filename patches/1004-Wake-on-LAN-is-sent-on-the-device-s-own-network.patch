+/* REAPER-WOL-AUTO-BEGIN */
+/* reaper 2026-11-16: Wake on LAN on the device's own network. The page's list holds the devices of every
+ * network (main, guest, VLAN), but a magic packet is a broadcast that stays on the one bridge it is sent
+ * on, and the page always named br0: a wake for a device on another network went nowhere and the page
+ * still said it was sent. With iface=auto the server finds the bridge itself: the ARP table (and the IPv6
+ * neighbour table), then the DHCP lease files, else br0. A source is used only when it names exactly ONE
+ * bridge; a MAC seen on two bridges is treated as unknown there. The packet is never sent on every
+ * bridge: it carries the target's MAC, and that would show a main-network device to every guest station.
+ * Everything between the two markers takes a FILE or plain values, so the lean test runs it on the host. */
+#ifndef RNET_SYSNET
+#define RNET_SYSNET "/sys/class/net"
+#endif
+
+/* a LAN bridge that exists: "br" + 1-4 digits (main LAN br0, SDN bridges br52...) that the kernel lists
+ * as a bridge. Every name passes here before it reaches a path or the tool's arguments. */
+static int rnet_br_ok(const char *s)
+{
+	char path[128];
+	struct stat st;
+
+	if (!s || strncmp(s, "br", 2) || !s[2] || strlen(s) > 6 || strspn(s + 2, "0123456789") != strlen(s + 2))
+		return 0;
+	if (snprintf(path, sizeof(path), RNET_SYSNET "/%s/bridge", s) >= (int)sizeof(path))
+		return 0;
+	return stat(path, &st) == 0 && S_ISDIR(st.st_mode);
+}
+
+/* one more sighting of the MAC, on bridge cand. cnt = the DISTINCT bridges so far (0, 1 with its name in
+ * br, or 2 = two or more); returns the new count. A name that is not an existing bridge does not count. */
+static int rnet_wake_seen(char *br, size_t n, int cnt, const char *cand)
+{
+	if (!rnet_br_ok(cand))
+		return cnt;
+	if (cnt == 0) {
+		snprintf(br, n, "%s", cand);
+		return 1;
+	}
+	if (cnt == 1 && !strcmp(br, cand))
+		return 1;
+	return 2;
+}
+
+/* /proc/net/arp: the bridges this MAC has a complete entry on (flags & 2, as the Devices list reads it; a
+ * STALE entry counts - a sleeping device is the one to wake). Returns 0, 1 (br = the bridge) or 2 = two
+ * or more. The header line does not parse and is skipped. */
+static int rnet_wake_arp(FILE *f, const char *mac, char *br, size_t n)
+{
+	char line[256], hw[64], dif[32];
+	unsigned flags;
+	int cnt = 0;
+
+	if (n)
+		br[0] = '\0';
+	if (!f || !mac)
+		return 0;
+	while (fgets(line, sizeof(line), f)) {
+		if (sscanf(line, "%*s 0x%*x 0x%x %63s %*s %31s", &flags, hw, dif) != 3)
+			continue;
+		if (!(flags & 2) || strcasecmp(hw, mac))
+			continue;
+		cnt = rnet_wake_seen(br, n, cnt, dif);
+	}
+	return cnt;
+}
+
+/* a dnsmasq lease file ("<expiry> <mac> <ip> <host> <clientid>"): 1 when this MAC holds a lease in it. A
+ * DHCPv6 line carries an IAID in that column and never matches. */
+static int rnet_wake_in_leases(FILE *f, const char *mac)
+{
+	char line[1024], hw[64];
+
+	if (!f || !mac)
+		return 0;
+	while (fgets(line, sizeof(line), f))
+		if (sscanf(line, "%*s %63s", hw) == 1 && !strcasecmp(hw, mac))
+			return 1;
+	return 0;
+}
+
+/* the decision. narp / nlease = how many DISTINCT bridges the neighbour tables / the lease files named
+ * (arpbr / leasebr = the one, when it is exactly one). Writes the bridge to br and returns how it was
+ * found: "arp", "lease", or "none" = unknown, so the main network only (the page then says so). */
+static const char *rnet_wake_pick(int narp, const char *arpbr, int nlease, const char *leasebr, char *br, size_t n)
+{
+	if (narp == 1 && rnet_br_ok(arpbr)) {
+		snprintf(br, n, "%s", arpbr);
+		return "arp";
+	}
+	if (nlease == 1 && rnet_br_ok(leasebr)) {
+		snprintf(br, n, "%s", leasebr);
+		return "lease";
+	}
+	snprintf(br, n, "%s", "br0");
+	return "none";
+}
+/* REAPER-WOL-AUTO-END */
+
+/* reaper 2026-11-16: the bridge to wake this MAC on (see REAPER-WOL-AUTO above) and how it was found.
+ * The lease file of a network is named from that row's integer index only - never from request text. */
+static const char *rnet_wake_bridge(const char *mac, char *br, size_t brn)
+{
+	static struct reaper_nd ndt[256];
+	MTLAN_T *pmtl;
+	size_t sz = 0, i;
+	char arpbr[16] = "", leasebr[16] = "", path[64];
+	int narp, nlease = 0, ndn, k;
+	FILE *f;
+
+	/* 1. where the kernel last saw it: IPv4 ARP, then the IPv6 neighbours (bridges only) */
+	f = fopen("/proc/net/arp", "r");
+	narp = rnet_wake_arp(f, mac, arpbr, sizeof(arpbr));
+	if (f)
+		fclose(f);
+	ndn = reaper_nd_load(ndt, 256);
+	for (k = 0; k < ndn; k++)
+		if (!strcasecmp(ndt[k].mac, mac))
+			narp = rnet_wake_seen(arpbr, sizeof(arpbr), narp, ndt[k].br);
+
+	/* 2. the network whose DHCP server holds its lease: the main one, then each network's own */
+	if (narp != 1) {
+		if ((f = fopen("/var/lib/misc/dnsmasq.leases", "r")) != NULL) {
+			if (rnet_wake_in_leases(f, mac))
+				nlease = rnet_wake_seen(leasebr, sizeof(leasebr), nlease, "br0");
+			fclose(f);
+		}
+		pmtl = (MTLAN_T *)INIT_MTLAN(sizeof(MTLAN_T));
+		if (pmtl && !get_mtlan(pmtl, &sz))
+			sz = 0;
+		for (i = 0; pmtl && i < sz; i++) {
+			if (!pmtl[i].enable || !pmtl[i].sdn_t.sdn_idx || !pmtl[i].nw_t.idx)
+				continue;
+			snprintf(path, sizeof(path), "/var/lib/misc/dnsmasq-%d.leases", pmtl[i].sdn_t.sdn_idx);
+			if ((f = fopen(path, "r")) == NULL)
+				continue;
+			if (rnet_wake_in_leases(f, mac))
+				nlease = rnet_wake_seen(leasebr, sizeof(leasebr), nlease, pmtl[i].nw_t.br_ifname);
+			fclose(f);
+		}
+		if (pmtl)
+			FREE_MTLAN((void *)pmtl);
+	}
+	/* 3. exactly one bridge from 1, else exactly one from 2, else br0 */
+	return rnet_wake_pick(narp, arpbr, nlease, leasebr, br, brn);
+}
+
+/* reaper 2026-11-16: the router's own address on that bridge's network, for the page's "on the network"
+ * text; empty when it cannot be told. Only a well-formed IPv4 address is passed on (it goes into JSON). */
+static void rnet_wake_net(const char *br, char *net, size_t n)
+{
+	MTLAN_T *pmtl;
+	size_t sz = 0, i;
+	struct in_addr a4;
+	char addr[INET_ADDRSTRLEN] = "";
+
+	if (!strcmp(br, "br0"))
+		strlcpy(addr, nvram_safe_get("lan_ipaddr"), sizeof(addr));
+	else if ((pmtl = (MTLAN_T *)INIT_MTLAN(sizeof(MTLAN_T))) != NULL) {
+		if (!get_mtlan(pmtl, &sz))
+			sz = 0;
+		for (i = 0; i < sz; i++)
+			if (pmtl[i].enable && !strcmp(pmtl[i].nw_t.br_ifname, br)) {
+				strlcpy(addr, pmtl[i].nw_t.addr, sizeof(addr));
+				break;
+			}
+		FREE_MTLAN((void *)pmtl);
+	}
+	snprintf(net, n, "%s", inet_pton(AF_INET, addr, &a4) == 1 ? addr : "");
+}
+
 /* the argv for one request, from fixed flags only; NULL = ok, else an error code for the page */
 static const char *rnet_build(struct rnet_job *j)
 {
@@ -29724,20 +29922,27 @@ static const char *rnet_build(struct rnet_job *j)
 		target = "";
 		j->limit = 20;
 	} else if (!strcmp(tool, "wake")) {
-		char *ifc = get_cgi("iface"), path[48];
-		struct stat st;
