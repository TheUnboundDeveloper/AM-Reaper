 		if (!rnet_mac_ok(target))
 			return "E_MAC";
-		if (!ifc || !*ifc)
-			ifc = "br0";
+		/* reaper 2026-11-16: iface=auto = the bridge of the device's own network (rnet_wake_bridge);
+		 * no iface stays br0, and a named bridge is used as given. ONE bridge, never all of them. */
