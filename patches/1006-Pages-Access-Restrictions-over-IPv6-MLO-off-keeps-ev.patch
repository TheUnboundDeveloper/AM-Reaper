      the operator navigates away, but never stop the revert itself */
   if(t!=='rules'&&rfwTimer){clearTimeout(rfwTimer);rfwTimer=null;}
 }
+/* reaper 2026-11-16: the Auto refresh switches (Status tab, Rule Status tab) stay as set. They stored nothing, so
+   every page load showed them off and no timer ran. Kept per browser like the last tab (reaper_fw_tab): '1' / '0'
+   in localStorage - no nvram key, nothing in a backup. Storage refused (private mode) = off, as before. */
+function autoGet(k){try{return localStorage.getItem(k)==='1';}catch(e){return false;}}
+function autoSet(k,on){try{localStorage.setItem(k,on?'1':'0');}catch(e){}}
 function initTab(){
   var q=(location.search.match(/[?&]t=([a-z]+)/)||[])[1];
   if(!q){try{q=localStorage.getItem('reaper_fw_tab');}catch(e){}}
@@ -2428,7 +2433,7 @@ function boot(){
     try{var _h=$('st_hint');if(_h)_h.textContent=' ...';}catch(e){}
     loadStatus();
   };
-  $('st_auto').onclick=function(){this.classList.toggle('on');stopAuto();startAuto();};
+  $('st_auto').onclick=function(){this.classList.toggle('on');autoSet('reaper_fw_st_auto',this.classList.contains('on'));stopAuto();startAuto();};
   $('rv_tg').onclick=rvToggle;
   $('rv_ack').onclick=rvAck;
   $('rv_reset').onclick=rvReset;
@@ -2447,8 +2452,12 @@ function boot(){
   $('rv_redit').onclick=function(){rvRulesText2List(true);};
   $('rv_rlist').onclick=function(){rvRulesText2List(false);};
   $('wt_refresh').onclick=function(){try{var _h=$('wt_hint');if(_h)_h.textContent=' ...';}catch(e){}loadWit(true);};
-  $('wt_auto').onclick=function(){this.classList.toggle('on');stopWitAuto();startWitAuto();};
+  $('wt_auto').onclick=function(){this.classList.toggle('on');autoSet('reaper_fw_wt_auto',this.classList.contains('on'));stopWitAuto();startWitAuto();};
   document.addEventListener('visibilitychange',function(){if(document.hidden){stopAuto();stopWitAuto();}else{if($('tab_status').classList.contains('on'))startAuto();if($('tab_witness').classList.contains('on'))startWitAuto();}});
+  /* reaper 2026-11-16: the stored Auto refresh choices, set before the first tab is shown (showTab starts the
+     timers from these classes; the timers themselves are unchanged) */
+  $('st_auto').classList.toggle('on',autoGet('reaper_fw_st_auto'));
+  $('wt_auto').classList.toggle('on',autoGet('reaper_fw_wt_auto'));
   initTab();
 }
 if(document.readyState!=='loading')boot();
