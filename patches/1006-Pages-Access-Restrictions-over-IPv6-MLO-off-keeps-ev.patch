@@ -134,10 +136,11 @@ function mainDutNoMlo(bits){
   if ((bits & 32) && bits > 32 && !(band & 16)) band += 16;
   return '<*>' + band + '>';
 }
-/* the band field of the first entry of a dut_list (<MAC>bands>ports ...) - stock mainfh_smart_connect.band_bitwise */
-function firstBands(dut){
-  var e = String(dut || '').split('<').filter(Boolean)[0];
-  return e ? (parseInt(e.split('>')[1], 10) || 0) : 0;
+/* reaper 2026-11-16: the band bits of EVERY entry of a dut_list (<MAC-or-*>bands>ports ...), ORed together. The page
+   read the first entry only (as stock mainfh_smart_connect.band_bitwise does), so a list with more than one entry
+   lost every band that sat only in a later entry when MLO was switched off. 0 = an empty or unreadable list. */
+function allBands(dut){
+  return String(dut || '').split('<').filter(Boolean).reduce(function(b, e){ return b | (parseInt(e.split('>')[1], 10) || 0); }, 0);
 }
 
 /* sdn_rl rows: idx>sdn_name>sdn_enable>vlan_idx>subnet_idx>apg_idx>... (sdn.js sdn_rl_attr order) */
@@ -247,7 +250,11 @@ function switchOff(){
     var a = AP[pfx(x) + x.apg];
     if (MAINS[x.name]){
       o['apm' + x.apg + '_mlo'] = '0';
-      o['apm' + x.apg + '_dut_list'] = mainDutNoMlo(firstBands(a.dut_list) & BAND_BITS);
+      /* reaper 2026-11-16: the bands of every entry, limited to the bands this router has. No usable band (an empty
+         list, also after a failed read) = the stored list is left alone: writing <*>0> took the main network off
+         every band. apm<N>_mlo=0 above is still written. */
+      var bits = allBands(a.dut_list) & BAND_BITS;
+      if (bits) o['apm' + x.apg + '_dut_list'] = mainDutNoMlo(bits);
     } else {
       o['apg' + x.apg + '_enable'] = '0';
       var f = x.r.f.slice(); f[2] = '0'; x.r = rp.list.row(f); rl = true;
