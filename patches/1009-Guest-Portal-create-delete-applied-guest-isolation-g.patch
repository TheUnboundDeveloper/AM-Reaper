+
+/* the guest upstream of network m (RGD_*), u[0..*n-1] filled; RGD_NONE = not a portal network without a VPN binding */
+static int reaper_guest_dns_mode(const MTLAN_T *m, struct rgd_up *u, int *n)
+{
+	*n = 0;
+	if (!m || !is_routing_enabled() || !rgd_wanted(m->enable, m->sdn_t.cp_idx, m->sdn_t.vpnc_idx, m->nw_t.idx))
+		return RGD_NONE;
+	return rgd_pick(m->nw_t.dns[0], m->nw_t.dns[1], u, n);
+}
+
+/* its own encrypted forwarder: the default or a known DoT provider (an admin's plain server needs none) */
+static int reaper_guest_dot_wanted(const MTLAN_T *m)
+{
+	struct rgd_up u[4];
+	int n, md = reaper_guest_dns_mode(m, u, &n);
+
+	return md == RGD_DEFAULT || md == RGD_DOT;
+}
+
+static void reaper_guest_dot_stop(int sdn_idx)
+{
+	char p[64];
+
+	snprintf(p, sizeof(p), "/var/run/rgdot-%d.pid", sdn_idx);
+	kill_pidfile_tk(p);
+	unlink(p);
+	snprintf(p, sizeof(p), RGD_DIR "/%d.unauth", sdn_idx);
+	unlink(p);
+}
+
+static void reaper_guest_dot_start(const MTLAN_T *m)
+{
+	char cf[64], pf[64], ga[24], b[16];
+	char *argv[] = { RGD_EXE, "-C", cf, NULL };
+	struct rgd_up ups[6];
+	int nup = 0;
+	int auth = nvram_get_int("ntp_ready") == 1;
+	pid_t pid = 0;
+	FILE *fp;
+
+	reaper_guest_dot_stop(m->sdn_t.sdn_idx);
+	if (reaper_secure_dir(RGD_DIR, 0700) != 0)
+		return;
+	if (access(RGD_EXE, X_OK) != 0) {
+		unlink(RGD_EXE);
+		if (symlink("/usr/sbin/stubby", RGD_EXE) != 0)
+			return;
+	}
+	snprintf(cf, sizeof(cf), RGD_DIR "/rgdot-%d.yml", m->sdn_t.sdn_idx);
+	rgd_addr(m->sdn_t.sdn_idx, ga, sizeof(ga));
+	if ((fp = fopen(cf, "w")) == NULL)
+		return;
+	if (reaper_guest_dns_mode(m, ups, &nup) == RGD_DEFAULT && ipv6_enabled()) {	/* the default has IPv6 servers too */
+		snprintf(ups[nup].addr, sizeof(ups[0].addr), "2606:4700:4700::1113"); ups[nup++].host = RGD_HOST;
+		snprintf(ups[nup].addr, sizeof(ups[0].addr), "2606:4700:4700::1003"); ups[nup++].host = RGD_HOST;
+	}
+	rgd_conf(fp, ga, auth, ups, nup);
+	fclose(fp);
+	_eval(argv, NULL, 0, &pid);
+	if (pid > 1) {
+		snprintf(pf, sizeof(pf), "/var/run/rgdot-%d.pid", m->sdn_t.sdn_idx);
+		snprintf(b, sizeof(b), "%d", (int)pid);
+		f_write_string(pf, b, 0, 0644);
+	}
+	if (!auth) {
+		snprintf(pf, sizeof(pf), RGD_DIR "/%d.unauth", m->sdn_t.sdn_idx);
+		f_write_string(pf, "1", 0, 0600);
+	}
+	logmessage("guest DNS", "network %d: guests resolve through %s (encrypted%s)", m->sdn_t.sdn_idx,
+		   nup > 0 && ups[0].host ? ups[0].host : RGD_HOST, auth ? "" : ", certificate checked once the clock is set");
+}
+
+/* watchdog: a forwarder that died, or one started before the clock was set, is started again */
+void reaper_guest_dot_watch(void)
+{
+	MTLAN_T *pmtl;
+	size_t sz = 0, i;
+
+	if (!is_routing_enabled() || (pmtl = (MTLAN_T *)INIT_MTLAN(sizeof(MTLAN_T))) == NULL)
+		return;
+	if (get_mtlan(pmtl, &sz)) {
+		for (i = 0; i < sz; i++) {
+			char p[64], comm[32] = "";
+			int pid, alive = 0, unauth;
+
+			if (!reaper_guest_dot_wanted(&pmtl[i]))
+				continue;
+			snprintf(p, sizeof(p), "/var/run/rgdot-%d.pid", pmtl[i].sdn_t.sdn_idx);
+			pid = f_read_string(p, comm, sizeof(comm)) > 0 ? atoi(comm) : 0;
+			if (pid > 1 && kill(pid, 0) == 0) {
+				snprintf(p, sizeof(p), "/proc/%d/comm", pid);
+				comm[0] = '\0';
+				f_read_string(p, comm, sizeof(comm));
+				alive = !strncmp(comm, "rgdot", 5);
+			}
+			snprintf(p, sizeof(p), RGD_DIR "/%d.unauth", pmtl[i].sdn_t.sdn_idx);
+			unauth = access(p, F_OK) == 0;
+			if (!alive || (unauth && nvram_get_int("ntp_ready") == 1)) {
+				if (!alive)
+					logmessage("guest DNS", "network %d: the encrypted forwarder had stopped - starting it",
+						   pmtl[i].sdn_t.sdn_idx);
+				reaper_guest_dot_start(&pmtl[i]);
+			}
+		}
+	}
+	FREE_MTLAN((void *)pmtl);
+}
