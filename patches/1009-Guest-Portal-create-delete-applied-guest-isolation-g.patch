+/* Reaper 2026-11-12: after a sign-in chilli sends the browser to "<this page>?auth_status=pass" and drops the
+ * address the device first asked for, so the page said "Successful!" and stopped there. That first address is
+ * kept for this tab while the sign-in page is shown, and the success page goes on to it after a short pause. On a
+ * phone it is the system's own connection test, which is what lets its sign-in sheet finish. */
+var REAPER_NEXT_KEY = "reaper_uam_next";
+var REAPER_NEXT_MS = 3000;
+
+function reaperQuery(name) {
+	try {
+		return new URL(window.location.href).searchParams.get(name) || "";
+	} catch (e) {
+		return "";
+	}
+}
+
+function reaperNextUrl(u) {	/* "" unless u is, or decodes once to, a plain http(s) address */
+	var i, p;
+	for (i = 0; i < 2 && typeof u == "string" && u != ""; i++) {
+		try {
+			p = new URL(u);
+			return (p.protocol == "http:" || p.protocol == "https:") ? p.href : "";
+		} catch (e) {}
+		try {
+			u = decodeURIComponent(u);
+		} catch (e) {
+			return "";
+		}
+	}
+	return "";
+}
+
+function reaperKeepNext() {
+	try {
+		var u = reaperNextUrl(reaperQuery("userurl"));
+		if (u != "")
+			window.sessionStorage.setItem(REAPER_NEXT_KEY, u);
+	} catch (e) {}
+}
+
+/* Reaper 2026-11-13: for some seconds after a sign-in a device can still hold the stand-in address it was given
+ * for every name while it was not signed in. A page load sent there never answers, and the page sat on
+ * "Successful!". So the first address is asked for in the background until it really answers, and only then is
+ * the page sent on to it; after REAPER_TRY_MAX tries it is sent on regardless. */
+var REAPER_TRY_MS = 4000;
+var REAPER_TRY_GAP_MS = 1000;
+var REAPER_TRY_MAX = 12;
+
+function reaperTryNext(u, n) {
+	var done = false, ctl = null, timer = null, page = "";
+
+	function settle(ok) {
+		if (done)
+			return;
+		done = true;
+		clearTimeout(timer);
+		if (ok) {
+			window.location.replace(u);
+			return;
+		}
+		try {
+			if (ctl)
+				ctl.abort();
+		} catch (e) {}
+		setTimeout(function() { reaperTryNext(u, n + 1); }, REAPER_TRY_GAP_MS);
+	}
+
+	try {
+		page = new URL(window.location.href).protocol;
+	} catch (e) {}
+	/* no way to ask in the background (no fetch, or an http address from an https page): go on at once */
+	if (n >= REAPER_TRY_MAX || typeof window.fetch != "function" || (page == "https:" && u.indexOf("https:") != 0)) {
+		window.location.replace(u);
+		return;
+	}
+	try {
+		if (typeof AbortController == "function")
+			ctl = new AbortController();
+	} catch (e) {
+		ctl = null;
+	}
+	timer = setTimeout(function() { settle(false); }, REAPER_TRY_MS);
+	try {
+		window.fetch(u, { mode: "no-cors", cache: "no-store", credentials: "omit", signal: ctl ? ctl.signal : undefined })
+			.then(function() { settle(true); }, function() { settle(false); });
+	} catch (e) {
+		settle(false);
+	}
+}
+
+function reaperGoNext() {
+	var u = "";
+	try {
+		u = reaperNextUrl(window.sessionStorage.getItem(REAPER_NEXT_KEY) || "");
+		window.sessionStorage.removeItem(REAPER_NEXT_KEY);
+	} catch (e) {}
+	if (u != "")
+		reaperTryNext(u, 0);
+}
+
+$(function() {
+	if (reaperQuery("auth_status") == "pass")
+		setTimeout(reaperGoNext, REAPER_NEXT_MS);
+});
