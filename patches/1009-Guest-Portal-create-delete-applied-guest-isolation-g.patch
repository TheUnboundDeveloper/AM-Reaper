+	struct dirent *e;
+	int n = 0;
+
+	if (!d)
+		return 0;
+	while ((e = readdir(d)) != NULL) {
+		char path[48], buf[512];
+		const char *a0, *p, *end;
+		ssize_t len;
+		int fd, hit = 0;
+		pid_t pid;
