diff --git a/release/src/router/rc/reaper_guest.c b/release/src/router/rc/reaper_guest.c
new file mode 100644
index 0000000000..ee3489d213
--- /dev/null
+++ b/release/src/router/rc/reaper_guest.c
@@ -0,0 +1,292 @@
+/*
+ * reaper_guest.c - guest isolation (owner hard rule, 2026-11-12).
+ *
+ * A guest - every device on a Guest Portal network, and on any other guest network whose "Access Intranet" is off
+ * (no pair in sdn_access_rl) - must never see or reach non-guest devices or router features, on ANY path: through its
+ * bound VPN client, in WAN fallback while that tunnel is down, kill switch on or off. Stock left it open: each guest
+ * network reached every router service on any router address except lan_ipaddr (firewall_sdn.c SDN_FI); signed-in
+ * portal guests were accepted to anywhere, the main LAN included (firewall.c `-I FORWARD -i tun22 NEW ACCEPT`, which
+ * the `br+ -o br+` drop never sees); a bound VPN client's own rules let new connections in from the tunnel; and a
+ * portal network's IPv6 rode the bridge past the portal (chilli is IPv4-only).
+ *
+ * This layer is DENY-ONLY: REAPER_GUI (INPUT) and REAPER_GUF (FORWARD), IPv4 and IPv6, never ACCEPT. What it lets
+ * through goes on to the stock rules (and the kill switch, Gatekeeper, the rules engine) exactly as before:
+ *   to the router   AiMesh, established flows, flows the router itself DNAT'd (Gatekeeper's waiting room, DNS
+ *                   redirects), DHCP, DNS to the network's own gateway, IPv6 neighbour discovery / MLD, and for a
+ *                   portal its sign-in ports on its own gateway - then DROP, on every router address
+ *   through it      out by a WAN interface or the bound VPN client only (only the VPN client while the kill switch
+ *                   is on - so the kill switch now also holds for a portal network and for IPv6), established
+ *                   replies, port forwards from the WAN; anything else in or out DROP
+ *   portal bridge   chilli reads it raw: nothing for the kernel to route there - INPUT neighbour discovery only,
+ *                   FORWARD nothing; a portal's IPv6 gets nothing at all
+ * Hooked by hook.sh (rc/reaper_hook.c) right after Warden; re-applied at every firewall build's tail and after every
+ * guest-network change. The main LAN (br0) and networks with intranet access are never touched.
+ */
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+#include <sys/stat.h>
+#include <net/if.h>
+#include "rc.h"
+#include <shared.h>
+#include "reaper_hook.h"
+
+#define RG_DIR		"/tmp/rguest"
+#define RG_APPLY	RG_DIR "/apply.sh"
+
+/* REAPER-GUEST-PURE-BEGIN (compiled on the host by test_guest_isolation.py) */
+struct rg_net {
+	int sdn_idx;
+	char ifname[IFNAMSIZ];	/* the kernel interface: tun22 / tun23 for a portal, else the bridge */
+	char brname[IFNAMSIZ];	/* the bridge */
+	char subnet[48];	/* IPv4 subnet "a.b.c.d/n" or "" - live flows are flushed after an apply */
+	char vpnif[IFNAMSIZ];	/* the bound VPN client's interface, "" when none */
+	int portal;		/* 0 none, 1 Free Wi-Fi / message board (chilli), 2 account portal (chilli-cp) */
+	int killsw;		/* kill switch on (meaningful only with a bound VPN client) */
+	int lan_ok;		/* 2026-11-13 (owner): a portal with Access Intranet on may open connections to the main LAN */
+	char lanif[IFNAMSIZ];	/* the main LAN bridge (lan_ifname) */
+};
+
+/* sdn_access_rl is "<access_sdn_idx>sdn_idx" pairs (sdn.js parse_StrToJSON_sdn_access_rl_list): intranet access is
+ * on for a network named on either side of any pair */
+static int rg_access_on(const char *rl, int idx)
+{
+	const char *p = rl;
+	int a, b;
+
+	while (p && *p) {
+		if (*p == '<')
+			p++;
+		a = b = -1;
+		if (sscanf(p, "%d>%d", &a, &b) == 2 && (a == idx || b == idx))
+			return 1;
+		p = strchr(p, '<');
+	}
+	return 0;
+}
+
+/* Merlin's vpnc_idx: 1..5 WireGuard client N (wgcN), 6..10 OpenVPN client idx-5 (tun1N) - shared/mtlan_utils.c
+ * get_vpnx_by_vpnc_idx; the static mapping, not vpncN_ifname, which exists only while the tunnel is up */
+static void rg_vpnif(int vpnc_idx, char *out, size_t n)
+{
+	out[0] = '\0';
+	if (vpnc_idx >= 1 && vpnc_idx <= 5)
+		snprintf(out, n, "wgc%d", vpnc_idx);
+	else if (vpnc_idx >= 6 && vpnc_idx <= 10)
+		snprintf(out, n, "tun1%d", vpnc_idx - 5);
+}
+
+/* the rules of one interface X of guest network g, family v6 (0/1). bridge_only: X is a portal's bridge. */
+static void rg_iface(FILE *f, const struct rg_net *g, const char *X, int v6, int bridge_only,
+		     char wan4[][IFNAMSIZ], int nw4, const char *wan6)
+{
+	const char *T = v6 ? "R ip6tables" : "R iptables";
+	const char *outs[8];
+	int no = 0, k;
+	int closed = bridge_only || (v6 && g->portal);	/* nothing passes, in or out */
+	int vpn_only = g->killsw && g->vpnif[0];
+
+	/* ---- to the router ---- */
+	fprintf(f, "%s -A REAPER_GUI -i %s -m set --match-set " REAPER_AIMESH_SET " src -j RETURN\n", T, X);
+	fprintf(f, "%s -A REAPER_GUI -i %s -m conntrack --ctstate RELATED,ESTABLISHED,DNAT -j RETURN\n", T, X);
+	if (v6)
+		for (k = 0; k < 8; k++)
+			fprintf(f, "%s -A REAPER_GUI -i %s -p ipv6-icmp --icmpv6-type %d -j RETURN\n", T, X,
+				(int[]){ 133, 134, 135, 136, 130, 131, 132, 143 }[k]);
+	if (!closed) {
+		fprintf(f, "%s -A REAPER_GUI -i %s -p udp --dport %d -j RETURN\n", T, X, v6 ? 547 : 67);
+		fprintf(f, "%s -A REAPER_GUI -i %s -p udp --dport 53 -m addrtype --dst-type LOCAL --limit-iface-in -j RETURN\n", T, X);
+		fprintf(f, "%s -A REAPER_GUI -i %s -p tcp --dport 53 -m addrtype --dst-type LOCAL --limit-iface-in -j RETURN\n", T, X);
+		if (!v6 && g->portal)
+			fprintf(f, "%s -A REAPER_GUI -i %s -p tcp -m multiport --dports %s -m addrtype --dst-type LOCAL --limit-iface-in -j RETURN\n",
+				T, X, g->portal == 2 ? "3998,3991,8083" : "3990,3991,8083");
+	}
+	fprintf(f, "%s -A REAPER_GUI -i %s -j DROP\n", T, X);
+
+	/* ---- through the router ---- */
+	if (!closed) {
+		if (g->vpnif[0])
+			outs[no++] = g->vpnif;
+		if (!vpn_only) {
+			if (v6) {
+				if (wan6 && *wan6)
+					outs[no++] = wan6;
+			} else
+				for (k = 0; k < nw4 && no < 8; k++)
+					outs[no++] = wan4[k];
+		}
+		fprintf(f, "%s -A REAPER_GUF -i %s -o %s -j RETURN\n", T, X, X);
+		fprintf(f, "%s -A REAPER_GUF -i %s -m set --match-set " REAPER_AIMESH_SET " src -j RETURN\n", T, X);
+		if (!v6 && g->portal) {	/* 2026-11-13 (owner): DNS is the guest resolver's (REAPER_GUN) - no DoT / DoQ around it */
+			fprintf(f, "%s -A REAPER_GUF -i %s -p tcp --dport 853 -j DROP\n", T, X);
+			fprintf(f, "%s -A REAPER_GUF -i %s -p udp --dport 853 -j DROP\n", T, X);
+		}
+		for (k = 0; k < no; k++)
+			fprintf(f, "%s -A REAPER_GUF -i %s -o %s -j RETURN\n", T, X, outs[k]);
+		/* 2026-11-13 (owner): Access Intranet on a portal network = the MAIN LAN only - never another guest network or
+		 * the router itself (REAPER_GUI above is unchanged); nothing opens from the main LAN into the portal */
+		if (!v6 && g->portal && g->lan_ok && g->lanif[0])
+			fprintf(f, "%s -A REAPER_GUF -i %s -o %s -j RETURN\n", T, X, g->lanif);
+	}
+	fprintf(f, "%s -A REAPER_GUF -i %s -j DROP\n", T, X);
+	if (!closed) {
+		fprintf(f, "%s -A REAPER_GUF -o %s -m conntrack --ctstate RELATED,ESTABLISHED -j RETURN\n", T, X);
+		/* new connections in: port forwards from the WAN only (never from the VPN client or another network) */
+		if (!vpn_only) {
+			if (v6) {
+				if (wan6 && *wan6)
+					fprintf(f, "%s -A REAPER_GUF -o %s -i %s -j RETURN\n", T, X, wan6);
+			} else
+				for (k = 0; k < nw4; k++)
+					fprintf(f, "%s -A REAPER_GUF -o %s -i %s -j RETURN\n", T, X, wan4[k]);
+		}
+	}
+	fprintf(f, "%s -A REAPER_GUF -o %s -j DROP\n", T, X);
+}
+
+/* the whole apply script for n guest networks (n == 0: tear the layer down) */
+static void rg_write(FILE *f, const struct rg_net *g, int n, char wan4[][IFNAMSIZ], int nw4, const char *wan6,
+		     const char *hook_run)
+{
+	int i, v6;
+
+	fputs("#!/bin/sh\n"
+	      "# generated by reaper_guest_gen - guest isolation (owner rule 2026-11-12). See rc/reaper_guest.c.\n"
+	      "RG_FAIL=0\n"
+	      "R() { \"$@\" 2>/dev/null || RG_FAIL=$((RG_FAIL+1)); }\n", f);
+	if (n == 0) {
+		fputs("for T in iptables ip6tables; do\n"
+		      "  $T -D " REAPER_HOOK_IN " -j REAPER_GUI 2>/dev/null; $T -D " REAPER_HOOK_FWD " -j REAPER_GUF 2>/dev/null\n"
+		      "  for C in REAPER_GUI REAPER_GUF; do $T -F $C 2>/dev/null; $T -X $C 2>/dev/null; done\n"
+		      "done\n"
+		      "iptables -t nat -D PREROUTING -j REAPER_GUN 2>/dev/null; iptables -t nat -F REAPER_GUN 2>/dev/null; "
+		      "iptables -t nat -X REAPER_GUN 2>/dev/null\n", f);
+		fputs(hook_run, f);
+		fputs("exit 0\n", f);
+		return;
+	}
+	fputs("ipset create " REAPER_AIMESH_SET " hash:mac -exist 2>/dev/null\n"
+	      "for T in iptables ip6tables; do\n"
+	      "  for C in REAPER_GUI REAPER_GUF; do $T -N $C 2>/dev/null; $T -F $C; done\n"
+	      "done\n"
+	      "# 2026-11-13 (owner): a portal guest's DNS goes to the guest network's own resolver, wherever it was sent\n"
+	      "iptables -t nat -N REAPER_GUN 2>/dev/null; iptables -t nat -F REAPER_GUN\n"
+	      "iptables -t nat -D PREROUTING -j REAPER_GUN 2>/dev/null\n"
+	      "R iptables -t nat -I PREROUTING 1 -j REAPER_GUN\n", f);
+	for (i = 0; i < n; i++) {
+		fprintf(f, "# network %d: %s%s%s%s%s\n", g[i].sdn_idx, g[i].ifname,
+			g[i].portal ? " (portal, bridge " : "", g[i].portal ? g[i].brname : "", g[i].portal ? ")" : "",
+			g[i].vpnif[0] ? (g[i].killsw ? " - VPN client, kill switch on" : " - VPN client, kill switch off") : "");
+		if (g[i].portal) {	/* 2026-11-13: to the address of the tunnel it arrived on = the guest resolver */
+			fprintf(f, "R iptables -t nat -A REAPER_GUN -i %s -p udp --dport 53 -j REDIRECT --to-ports 53\n", g[i].ifname);
+			fprintf(f, "R iptables -t nat -A REAPER_GUN -i %s -p tcp --dport 53 -j REDIRECT --to-ports 53\n", g[i].ifname);
+		}
+		for (v6 = 0; v6 < 2; v6++) {
+			rg_iface(f, &g[i], g[i].ifname, v6, 0, wan4, nw4, wan6);
+			if (strcmp(g[i].brname, g[i].ifname) != 0 && g[i].brname[0])
+				rg_iface(f, &g[i], g[i].brname, v6, g[i].portal != 0, wan4, nw4, wan6);
+		}
+	}
+	fputs(hook_run, f);
+	fputs("# flows opened before these rules must re-traverse them\n", f);
+	for (i = 0; i < n; i++)
+		if (g[i].subnet[0])
+			fprintf(f, "conntrack -D -s %s >/dev/null 2>&1; conntrack -D -d %s >/dev/null 2>&1\n", g[i].subnet, g[i].subnet);
+	fputs("fc flush 2>/dev/null\n"
+	      "[ \"$RG_FAIL\" = 0 ] || logger -t reaper \"guest isolation: $RG_FAIL rule(s) refused\"\n"
+	      "exit 0\n", f);
+}
+/* REAPER-GUEST-PURE-END */
+
+void reaper_guest_gen(void)
+{
+	MTLAN_T *pmtl = NULL;
+	CP_TYPE_RL cpt;
+	struct rg_net g[MTLAN_MAXINUM];
+	char wan4[WAN_UNIT_MAX][IFNAMSIZ];
+	char wan6[IFNAMSIZ] = "";
+	const char *acc, *w;
+	size_t sz = 0, i;
+	int n = 0, nw4 = 0, u, k, dup;
+	FILE *f;
+
+	memset(g, 0, sizeof(g));
+	if (is_routing_enabled() && (pmtl = (MTLAN_T *)INIT_MTLAN(sizeof(MTLAN_T))) != NULL) {
+		acc = nvram_safe_get("sdn_access_rl");
+		if (get_mtlan(pmtl, &sz)) {
+			for (i = 0; i < sz && n < MTLAN_MAXINUM; i++) {
+				const MTLAN_T *m = &pmtl[i];
+				int portal = 0;
+
+				if (m->enable != 1 || m->sdn_t.sdn_idx == 0 || m->nw_t.idx == 0)
+					continue;
+				if (!m->nw_t.br_ifname[0] || !strcmp(m->nw_t.br_ifname, "br0"))
+					continue;	/* the main LAN, or a guest SSID on the main subnet: nothing to isolate at L3 */
+				if (m->sdn_t.cp_idx > 0) {
+					memset(&cpt, 0, sizeof(cpt));
+					if (get_cp_type_byidx(m->sdn_t.cp_idx, &cpt))
+						portal = (cpt.cp_type == 1) ? 2 : ((cpt.cp_type == 2 || cpt.cp_type == 4) ? 1 : 0);
+				}
+				if (!portal && rg_access_on(acc, m->sdn_t.sdn_idx))
+					continue;	/* the admin gave this network intranet access */
+				g[n].sdn_idx = m->sdn_t.sdn_idx;
+				strlcpy(g[n].ifname, m->nw_t.ifname[0] ? m->nw_t.ifname : m->nw_t.br_ifname, sizeof(g[n].ifname));
+				strlcpy(g[n].brname, m->nw_t.br_ifname, sizeof(g[n].brname));
+				if (m->nw_t.subnet[0] && m->nw_t.prefixlen > 0 && m->nw_t.prefixlen <= 32)
+					snprintf(g[n].subnet, sizeof(g[n].subnet), "%s/%u", m->nw_t.subnet, m->nw_t.prefixlen);
+				rg_vpnif(m->sdn_t.vpnc_idx, g[n].vpnif, sizeof(g[n].vpnif));
+				g[n].portal = portal;
+				g[n].killsw = m->sdn_t.killsw_sw ? 1 : 0;
+				if (portal && rg_access_on(acc, m->sdn_t.sdn_idx)) {	/* 2026-11-13 (owner): main LAN only */
+					g[n].lan_ok = 1;
+					strlcpy(g[n].lanif, nvram_safe_get("lan_ifname"), sizeof(g[n].lanif));
+				}
+				n++;
+			}
+		}
+		FREE_MTLAN((void *)pmtl);
+	}
+	for (u = WAN_UNIT_FIRST; u < WAN_UNIT_MAX; u++) {
+		w = get_wan_ifname(u);
+		if (!w || !*w || !strcmp(w, "br0"))
+			continue;
+		for (dup = 0, k = 0; k < nw4; k++)
+			if (!strcmp(wan4[k], w))
+				dup = 1;
+		if (!dup && nw4 < WAN_UNIT_MAX)
+			strlcpy(wan4[nw4++], w, IFNAMSIZ);
+	}
+	if (ipv6_enabled() && (w = get_wan6face()) != NULL)
+		strlcpy(wan6, w, sizeof(wan6));
+
+	reaper_secure_dir(RG_DIR, 0700);
+	if ((f = fopen(RG_APPLY ".tmp", "w")) == NULL)
+		return;
+	rg_write(f, g, n, wan4, nw4, wan6, REAPER_HOOK_RUN);
+	fclose(f);
+	chmod(RG_APPLY ".tmp", 0700);
+	if (rename(RG_APPLY ".tmp", RG_APPLY) != 0)
+		unlink(RG_APPLY ".tmp");
+}
+
+/* 2026-11-13: is intranet access on for this network (sdn.c: may its resolver answer main-LAN names) */
+int reaper_guest_intranet(int sdn_idx)
+{
+	return rg_access_on(nvram_safe_get("sdn_access_rl"), sdn_idx);
+}
+
+/* regenerate and run; have_lock: the caller already holds file_lock("firewall") (the start_firewall tail) */
+void reaper_guest_apply(int have_lock)
+{
+	int lk = -1;
+
+	reaper_hook_gen();
+	reaper_guest_gen();
+	if (!have_lock)
+		lk = file_lock("firewall");
+	if (reaper_script_ok(RG_APPLY))
+		eval("sh", RG_APPLY);
+	if (lk >= 0)
+		file_unlock(lk);
+}
