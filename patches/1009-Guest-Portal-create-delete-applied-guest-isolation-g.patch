+/* REAPER-GUESTDNS-PURE-BEGIN (compiled on the host by test_portal_guest_dns.py)
+ * 2026-11-13, owner decisions for Guest Portal DNS:
+ *  - a guest network without intranet access must not learn the main LAN's names. dnsmasq reads /etc/hosts unless
+ *    told not to, and rc writes every DHCP reservation into it (name + address), so a guest could look up the
+ *    owner's PC. `no-hosts` there; a network with Access Intranet on (or on the main subnet) keeps them.
+ *  - a Guest Portal network with no VPN binding resolves through Cloudflare for Families (malware + adult content),
+ *    encrypted: its resolver - which still applies Warden, Wallguard and the encrypted-DNS block - forwards to its
+ *    own stubby on 127.0.2.<sdn_idx>. TLS always; the server's certificate is checked once the clock is set (before
+ *    that the connection is encrypted but not authenticated, and the watchdog restarts it after the first sync).
+ *    A VPN-bound portal keeps the tunnel's DNS (owner 2026-11-10: lookups never leave outside the tunnel).
+ *  The stock per-network DoT (firewall_sdn.c) DNATs a network's queries straight to its stubby and so skips the
+ *    network's resolver and every filter in it - not used here. */
+#define RGD_DIR		"/tmp/rguestdns"
+#define RGD_EXE		RGD_DIR "/rgdot"	/* a link to stubby under its own name (stock-name-matchers rule) */
+#define RGD_HOST	"family.cloudflare-dns.com"
+
+static int rgd_hide(const char *br, const char *lanif, int intranet)
+{
+	if (!br || !*br || (lanif && *lanif && !strcmp(br, lanif)))
+		return 0;			/* on the main subnet: its devices are the main LAN */
+	return !intranet;
+}
+
+static int rgd_wanted(int enable, int cp_idx, int vpnc_idx, int nw_idx)
+{
+	return enable && cp_idx != 0 && vpnc_idx == 0 && nw_idx != 0;
+}
+
+static void rgd_addr(int sdn_idx, char *out, size_t n)
+{
+	snprintf(out, n, "127.0.2.%d", (sdn_idx >= 1 && sdn_idx <= 254) ? sdn_idx : 254);
+}
+
+/* 2026-11-13 (owner: the admin chooses the guests' DNS provider, independent of the main network): the network's own
+ * DNS Server setting (Network page, nw_t.dns[0..1]) picks the upstream. Known providers are reached over DoT - names
+ * and addresses from the firmware's own www/dot-servers.json (Control D's DoT runs on .11 with the profile in the name),
+ * plus Cloudflare's filtered pair. Anything else is the admin's own server (a LAN Pi-hole, a plain resolver) and is
+ * forwarded as plain DNS. Empty = Cloudflare for Families. */
+#define RGD_NONE	0	/* not a portal network without a VPN binding: the network's normal servers */
+#define RGD_DEFAULT	1	/* nothing set: Cloudflare for Families over DoT */
+#define RGD_DOT		2	/* every address a known DoT provider */
+#define RGD_PLAIN	3	/* at least one address of the admin's own: plain DNS to the address(es) */
+struct rgd_up { char addr[48]; const char *host; };
+static const struct { const char *plain, *dot, *host; } rgd_known[] = {
+	{ "1.1.1.3", "1.1.1.3", "family.cloudflare-dns.com" }, { "1.0.0.3", "1.0.0.3", "family.cloudflare-dns.com" },
+	{ "1.1.1.2", "1.1.1.2", "security.cloudflare-dns.com" }, { "1.0.0.2", "1.0.0.2", "security.cloudflare-dns.com" },
+	{ "1.1.1.1", "1.1.1.1", "cloudflare-dns.com" }, { "1.0.0.1", "1.0.0.1", "cloudflare-dns.com" },
+	{ "9.9.9.9", "9.9.9.9", "dns.quad9.net" }, { "149.112.112.112", "149.112.112.112", "dns.quad9.net" },
+	{ "8.8.8.8", "8.8.8.8", "dns.google" }, { "8.8.4.4", "8.8.4.4", "dns.google" },
+	{ "185.228.168.9", "185.228.168.9", "security-filter-dns.cleanbrowsing.org" },
+	{ "185.228.169.9", "185.228.169.9", "security-filter-dns.cleanbrowsing.org" },
+	{ "185.228.168.168", "185.228.168.168", "family-filter-dns.cleanbrowsing.org" },
+	{ "185.228.169.168", "185.228.169.168", "family-filter-dns.cleanbrowsing.org" },
+	{ "185.228.168.10", "185.228.168.10", "adult-filter-dns.cleanbrowsing.org" },
+	{ "185.228.169.11", "185.228.169.11", "adult-filter-dns.cleanbrowsing.org" },
+	{ "76.76.2.1", "76.76.2.11", "p1.freedns.controld.com" }, { "76.76.10.1", "76.76.10.11", "p1.freedns.controld.com" },
+	{ "76.76.2.2", "76.76.2.11", "p2.freedns.controld.com" }, { "76.76.10.2", "76.76.10.11", "p2.freedns.controld.com" },
+	{ "76.76.2.4", "76.76.2.11", "family.freedns.controld.com" }, { "76.76.10.4", "76.76.10.11", "family.freedns.controld.com" },
+	{ "149.112.121.10", "149.112.121.10", "private.canadianshield.cira.ca" },
+	{ "149.112.122.10", "149.112.122.10", "private.canadianshield.cira.ca" },
+	{ "149.112.121.20", "149.112.121.20", "protected.canadianshield.cira.ca" },
+	{ "149.112.122.20", "149.112.122.20", "protected.canadianshield.cira.ca" },
+	{ "149.112.121.30", "149.112.121.30", "family.canadianshield.cira.ca" },
+	{ "149.112.122.30", "149.112.122.30", "family.canadianshield.cira.ca" },
