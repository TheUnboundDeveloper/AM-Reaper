+static int reaper_sdn_hide_lan_names(const MTLAN_T *m)
+{
+	return m && rgd_hide(m->nw_t.br_ifname, nvram_safe_get("lan_ifname"), reaper_guest_intranet(m->sdn_t.sdn_idx));
