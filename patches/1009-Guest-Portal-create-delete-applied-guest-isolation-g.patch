+/* ---- reaper 2026-11-12: a guest-network request is always applied on the router ----
+ * httpd records a guest-network request it hands to cfg_server in RSDN_PENDING ("<uptime> <service list>") and
+ * starts this applet (httpd/web.c reaper_sdn_pending). The "sdn" / "sdn_del" handlers stamp RSDN_APPLIED when
+ * they run (rc/services.c). Field report + owner's router: a Guest Portal create sent that way never reached rc.
+ * If rc ran no guest-network service since the request, the router applies the saved list itself once the settle
+ * window is over and rc is idle; if cfg_server ran it, this does nothing. */
+#define RSDN_DIR	"/tmp/reaper"
+#define RSDN_PENDING	RSDN_DIR "/sdn_pending"
+#define RSDN_APPLIED	RSDN_DIR "/sdn_applied"
+#define RSDN_SETTLE_S	15	/* cfg_server ran a delete within a second; give it plenty */
+#define RSDN_SETTLE_MAX	45	/* and never wait longer than this for rc to go idle */
+
+/* does a ';' service list hold a guest-network service (name only, arguments ignored) - the same set httpd
+ * records (httpd/web.c reaper_sdn_tok) */
+int reaper_sdn_list_has_svc(const char *list)
+{
+	static const char *const tok[] = { "restart_sdn", "start_sdn_del", "restart_chilli", "restart_uam_srv", "restart_CP", NULL };
+	const char *p, *q;
+	size_t w;
+	int i;
+
+	for (p = list; p && *p; p = *q ? q + 1 : q) {
+		q = p + strcspn(p, ";");
+		w = strcspn(p, " ;");
+		if (w > (size_t)(q - p))
+			w = (size_t)(q - p);
+		for (i = 0; tok[i]; i++)
+			if (strlen(tok[i]) == w && strncmp(p, tok[i], w) == 0)
+				return 1;
+	}
+	return 0;
+}
+
+void reaper_sdn_applied_stamp(void)
+{
+	char buf[24];
+	int fd;
+
+	reaper_secure_dir(RSDN_DIR, 0700);	/* tmp hardening: root's own directory */
+	snprintf(buf, sizeof(buf), "%ld\n", uptime());
+	if ((fd = open(RSDN_APPLIED, O_WRONLY | O_CREAT | O_TRUNC | O_NOFOLLOW, 0600)) < 0)
+		return;
+	if (write(fd, buf, strlen(buf)) < 0)
+		_dprintf("%s: write failed\n", __FUNCTION__);
+	close(fd);
+}
+
+/* RSDN-PURE-BEGIN (compiled on the host by test_portal_settle.py) */
+/* "<uptime>" file -> value, -1 when absent or unreadable */
+static long rsdn_read_long(const char *path)
+{
+	char buf[32];
+	ssize_t n;
+	int fd = open(path, O_RDONLY | O_NOFOLLOW);
+
+	if (fd < 0)
+		return -1;
+	n = read(fd, buf, sizeof(buf) - 1);
+	close(fd);
+	if (n <= 0)
+		return -1;
+	buf[n] = 0;
+	return strtol(buf, NULL, 10);
+}
+
+/* "<uptime> <list>" -> *t + list; 0 when absent, malformed, or not root's regular file */
+static int rsdn_read_pending(const char *path, long *t, char *list, size_t len)
+{
+	char buf[320], *sp;
+	struct stat st;
+	ssize_t n;
+	int fd = open(path, O_RDONLY | O_NOFOLLOW);
+
+	if (fd < 0)
+		return 0;
+	if (fstat(fd, &st) != 0 || !S_ISREG(st.st_mode) || st.st_uid != 0) {
+		close(fd);
+		return 0;
+	}
+	n = read(fd, buf, sizeof(buf) - 1);
+	close(fd);
+	if (n <= 0)
+		return 0;
+	buf[n] = 0;
+	buf[strcspn(buf, "\r\n")] = 0;
+	*t = strtol(buf, &sp, 10);
+	if (sp == buf || *sp != ' ' || !sp[1])
+		return 0;
+	strlcpy(list, sp + 1, len);
+	return 1;
+}
+
+/* one settle step: 0 keep waiting, 1 done (nothing to do), 2 apply the list now */
+static int rsdn_settle_step(int second, long t0, int have, long t, long applied, int rc_busy)
+{
+	if (!have || t != t0)
+		return 1;		/* gone, or a newer request (with its own settle) replaced it */
+	if (applied >= t0)
+		return 1;		/* rc ran a guest-network service since the request */
+	if (second >= RSDN_SETTLE_MAX || (second >= RSDN_SETTLE_S && !rc_busy))
+		return 2;
+	return 0;
+}
+/* RSDN-PURE-END */
+
+int reaper_sdn_settle_main(int argc, char *argv[])
+{
+	char list[256];
+	long t0, t = 0;
+	int i, have, step;
+
+	if (argc < 2 || (t0 = strtol(argv[1], NULL, 10)) <= 0)
+		return 1;
+	for (i = 1; ; i++) {
+		sleep(1);
+		have = rsdn_read_pending(RSDN_PENDING, &t, list, sizeof(list));
+		step = rsdn_settle_step(i, t0, have, t, rsdn_read_long(RSDN_APPLIED), *nvram_safe_get("rc_service") != 0);
+		if (step == 1) {
+			if (have && t == t0)
+				unlink(RSDN_PENDING);
+			return 0;
+		}
+		if (step == 2)
+			break;
+	}
+	unlink(RSDN_PENDING);
+	for (i = 0; list[i]; i++)	/* 2026-11-12: no service name holds a '+' (see httpd apply_cgi) */
+		if (list[i] == '+')
+			list[i] = ' ';
+	logmessage("sdn", "a network change was saved but not applied - applying it now (%s)", list);
+	notify_rc_and_wait_2min(list);
+	return 0;
+}
