+/* d1 / d2 = the network's DNS Server setting -> mode, and u[0..*n-1] = the upstream(s) (host NULL = plain DNS) */
+static int rgd_pick(const char *d1, const char *d2, struct rgd_up *u, int *n)
+{
+	const char *d[2] = { d1, d2 };
+	struct in_addr a;
+	int i, k, j, any = 0, plain = 0;
+
+	*n = 0;
+	for (i = 0; i < 2; i++) {
+		if (!d[i] || !*d[i] || inet_pton(AF_INET, d[i], &a) != 1)
+			continue;			/* empty or not an IPv4 address: not a server */
+		any = 1;
+		for (k = 0; k < (int)(sizeof(rgd_known) / sizeof(rgd_known[0])); k++)
+			if (!strcmp(d[i], rgd_known[k].plain))
+				break;
+		if (k == (int)(sizeof(rgd_known) / sizeof(rgd_known[0])))
+			plain = 1;
+	}
+	if (!any) {
+		snprintf(u[0].addr, sizeof(u[0].addr), "1.1.1.3"); u[0].host = RGD_HOST;
+		snprintf(u[1].addr, sizeof(u[1].addr), "1.0.0.3"); u[1].host = RGD_HOST;
+		*n = 2;
+		return RGD_DEFAULT;
+	}
+	for (i = 0; i < 2; i++) {
+		if (!d[i] || !*d[i] || inet_pton(AF_INET, d[i], &a) != 1)
+			continue;
+		if (plain) {
+			for (j = 0; j < *n; j++)
+				if (!strcmp(u[j].addr, d[i])) break;
+			if (j < *n) continue;
+			snprintf(u[*n].addr, sizeof(u[0].addr), "%s", d[i]);
+			u[*n].host = NULL;
+			(*n)++;
+			continue;
+		}
+		for (k = 0; strcmp(d[i], rgd_known[k].plain); k++)
+			;
+		for (j = 0; j < *n; j++)		/* Control D: two presets can land on one DoT address */
+			if (!strcmp(u[j].addr, rgd_known[k].dot) && !strcmp(u[j].host, rgd_known[k].host)) break;
+		if (j < *n) continue;
+		snprintf(u[*n].addr, sizeof(u[0].addr), "%s", rgd_known[k].dot);
+		u[*n].host = rgd_known[k].host;
+		(*n)++;
+	}
+	return plain ? RGD_PLAIN : RGD_DOT;
+}
