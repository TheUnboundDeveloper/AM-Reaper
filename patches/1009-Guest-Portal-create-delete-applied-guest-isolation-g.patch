+			continue;
+		pid = (pid_t)strtol(e->d_name, NULL, 10);
+		snprintf(path, sizeof(path), "/proc/%d/cmdline", (int)pid);
+		if ((fd = open(path, O_RDONLY)) < 0)
+			continue;
+		len = read(fd, buf, sizeof(buf) - 1);
+		close(fd);
+		if (len <= 0)
+			continue;
+		buf[len] = 0;
+		end = buf + len;
+		a0 = buf;
+		p = strrchr(a0, '/');
+		if (strcmp(p ? p + 1 : a0, "chilli") != 0)
