+/* REAPER-STANDIN-BEGIN (compiled on the host by test_chilli_standin_reset.py)
+ * reaper 2026-11-13 (Guest Portal: about 30 s between "Successful!" and a working connection). Before sign-in
+ * every A lookup is answered with the stand-in address 198.18.0.1 (REAPER-PREAUTH). A phone goes on using that
+ * answer for a while after sign-in, TTL 0 or not. Its connections to the stand-in were then forwarded and dropped
+ * further on, silently, so each one waited out its own timeout (and each was counted as a blocked outbound
+ * connection of that guest). A signed-in device's packets to the stand-in now stop here, and a TCP connection is
+ * refused at once (RFC 793 reset generation), so the device looks the name up again instead of waiting.
+ *
+ * seg = an IPv4 packet, IP header first, len bytes. out = the 40-byte reset to send back, checksums left zero
+ * for the caller. Returns 40, or 0 = send nothing (not TCP, a fragment, too short, or itself a reset). */
+#define REAPER_STANDIN_ADDR 0xC6120001u	/* 198.18.0.1 in host order (RFC 2544 space, never routed) */
+static size_t reaper_tcp_refuse(uint8_t *out, size_t olen, const uint8_t *seg, size_t len)
+{
+  const uint8_t *t;
+  size_t ihl, thl, tot;
+  uint32_t ack;
+  uint8_t fl;
+
+  if (!out || !seg || olen < 40 || len < 40 || (seg[0] >> 4) != 4 || seg[9] != 6)
+    return 0;
+  ihl = (size_t)(seg[0] & 0x0f) * 4;
+  tot = ((size_t)seg[2] << 8) | seg[3];
+  if (ihl < 20 || tot > len || tot < ihl + 20)
+    return 0;
+  if ((seg[6] & 0x3f) || seg[7])	/* more-fragments set or an offset: a fragment has no header to answer */
+    return 0;
+  t = seg + ihl;
+  fl = t[13];
+  thl = (size_t)(t[12] >> 4) * 4;
+  if ((fl & 0x04) || thl < 20 || ihl + thl > tot)	/* never answer a reset */
+    return 0;
+  memset(out, 0, 40);
+  out[0] = 0x45;
+  out[3] = 40;
+  out[6] = 0x40;	/* do not fragment */
+  out[8] = 64;
+  out[9] = 6;
+  memcpy(out + 12, seg + 16, 4);	/* from the address the device wrote to */
+  memcpy(out + 16, seg + 12, 4);
+  memcpy(out + 20, t + 2, 2);
+  memcpy(out + 22, t, 2);
+  if (fl & 0x10) {	/* the segment acknowledges something: a reset with that sequence number */
+    memcpy(out + 24, t + 8, 4);
+    out[33] = 0x04;
+  } else {		/* a first SYN: sequence 0, acknowledging everything it carried */
+    ack = ((uint32_t)t[4] << 24) | ((uint32_t)t[5] << 16) | ((uint32_t)t[6] << 8) | t[7];
+    ack += (uint32_t)(tot - ihl - thl) + ((fl & 0x02) ? 1 : 0) + ((fl & 0x01) ? 1 : 0);
+    out[28] = (uint8_t)(ack >> 24);
+    out[29] = (uint8_t)(ack >> 16);
+    out[30] = (uint8_t)(ack >> 8);
+    out[31] = (uint8_t)ack;
+    out[33] = 0x14;
+  }
+  out[32] = 0x50;
+  return 40;
+}
+/* REAPER-STANDIN-END */
+
+/* REAPER-PREAUTH-BEGIN (compiled on the host by test_chilli_preauth_dns.py)
+ * reaper 2026-11-12 (Guest Portal field report: no "Sign in to network" on Android 17 / iOS 27, then "No internet").
+ * A phone offers the sign-in page only when its probe name (captive.apple.com, connectivitycheck.gstatic.com, ...)
+ * resolves and the HTTP request is redirected. Before sign-in chilli let lookups through to the network's own
+ * resolver only, and that resolver has no upstream whenever the network's VPN client is down (fail-closed by the
+ * owner's choice) - so no answer, no redirect, "No internet". A device that has not signed in now gets the
+ * portal's own address for every A lookup (TTL 0; a phone still holds on to it - see REAPER-STANDIN) and an empty answer for every
+ * other type; walled-garden names (uamdomain) still go to the real resolver. Nothing leaves the router before
+ * sign-in. Returns 0 = forward as before, 1 = answer with the portal address, 2 = answer with no records. */
+static int reaper_preauth_dns(int signed_in, int qtype, const char *q, char *const *doms, int ndoms)
+{
+  size_t ql, dl;
+  int id;
+
+  if (signed_in || qtype < 0 || !q || !*q)
+    return 0;
+  ql = strlen(q);
+  for (id = 0; doms && id < ndoms && doms[id]; id++) {
+    dl = strlen(doms[id]);
+    if (!dl)
+      continue;
+    if ((ql == dl && !strcmp(doms[id], q)) ||
+        (ql > dl && (doms[id][0] == '.' || q[ql - dl - 1] == '.') && !strcmp(doms[id], q + ql - dl)))
+      return 0;
+  }
+  return qtype == 1 ? 1 : 2;
+}
+
+/* the type of the first question in a DNS payload of len bytes (rec = the question section); -1 when it cannot be
+ * read plainly (a compression pointer or a label running past the end) */
+static int reaper_dns_qtype(const uint8_t *rec, size_t len)
+{
+  size_t i = 0;
+
+  while (i < len && rec[i]) {
+    if (rec[i] & 0xc0)
+      return -1;
+    i += (size_t)rec[i] + 1;
+  }
+  if (i + 2 >= len)
+    return -1;
+  return (rec[i + 1] << 8) | rec[i + 2];
+}
+/* REAPER-PREAUTH-END */
+
 static 
 int dhcp_matchDNS(uint8_t *r, char *name) {
   int r_len = strlen((char *)r);
@@ -1836,6 +1939,7 @@ int dhcp_dns(struct dhcp_conn_t *conn, uint8_t *pack,
       uint8_t reply[4];
 
       int match = 0;
+      int reaper_noans = 0;	/* reaper 2026-11-12: answer with no records */
 
       if (!match) {
 	match = dhcp_matchDNS(q, "logout");
@@ -1927,6 +2031,29 @@ int dhcp_dns(struct dhcp_conn_t *conn, uint8_t *pack,
 //	}
       }
       
+      /* reaper 2026-11-12: a device that has not signed in - see reaper_preauth_dns */
+      if (!match) {
+	int pre = reaper_preauth_dns(conn->authstate == DHCP_AUTH_PASS,
+				     reaper_dns_qtype(dnsp->records, olen), (char *)q,
+				     _options.uamdomains, MAX_UAM_DOMAINS);
+#ifdef ENABLE_UAMDOMAINFILE
+	if (pre && _options.uamdomainfile && garden_check_domainfile((char *)q) == 1)
+	  pre = 0;
+#endif
+	if (pre) {
+	  /* 2026-11-12 (_r2 on the owner's router): NOT the alias address - with ENABLE_UAMUIPORT chilli rewrites the
+	   * alias onto its UI port (3991), whose redirect hands the sign-in page uamport=3991, and a /logon there is
+	   * not a sign-in: the page reloaded for ever. Any outside address goes through chilli's own redirect to
+	   * uamlisten:uamport instead; 198.18.0.1 (RFC 2544, never routed) is never a real destination. */
+	  struct in_addr reaper_redir;
+
+	  match = 1;
+	  reaper_noans = (pre == 2);
+	  reaper_redir.s_addr = htonl(0xC6120001);	/* 198.18.0.1 */
+	  memcpy(reply, &reaper_redir.s_addr, 4);
+	}
+      }
+
       if (match) {
 	
 	uint8_t answer[1500];
@@ -1965,6 +2092,7 @@ int dhcp_dns(struct dhcp_conn_t *conn, uint8_t *pack,
 	    query[query_len++] = *p++;
 	}
 	
+	if (!reaper_noans) {	/* reaper 2026-11-12: not an A question - the question alone, no records */
 	query[query_len++] = 0xc0;
 	query[query_len++] = 0x0c;
 	query[query_len++] = 0x00;
@@ -1979,6 +2107,7 @@ int dhcp_dns(struct dhcp_conn_t *conn, uint8_t *pack,
 	query[query_len++] = 0x04;
 	memcpy(query + query_len, reply, 4);
 	query_len += 4;
+	}
 	
 	memcpy(answer, pack, *plen); /* TODO */
 	
@@ -1991,7 +2120,7 @@ int dhcp_dns(struct dhcp_conn_t *conn, uint8_t *pack,
 	answer_dns->id      = dnsp->id;
 	answer_dns->flags   = htons(0x8000);
 	answer_dns->qdcount = htons(0x0001);
-	answer_dns->ancount = htons(0x0001);
+	answer_dns->ancount = htons(reaper_noans ? 0x0000 : 0x0001);
 	answer_dns->nscount = htons(0x0000);
 	answer_dns->arcount = htons(0x0000);
 	memcpy(answer_dns->records, query, query_len);
@@ -3934,6 +4063,23 @@ int dhcp_receive_ip(struct dhcp_ctx *ctx, uint8_t *pack, size_t len) {
     }
 #endif
 
+    /* REAPER-STANDIN: a signed-in device still using the address it was given before sign-in */
+    if (pack_iph->daddr == htonl(REAPER_STANDIN_ADDR)) {
+      uint8_t reaper_rst[sizeof(struct pkt_ethhdr8021q_t) + 40];
+      size_t reaper_el = sizeofeth(pack);
+
+      if (reaper_el <= sizeof(struct pkt_ethhdr8021q_t) && len > reaper_el &&
+	  reaper_tcp_refuse(reaper_rst + reaper_el, 40, (const uint8_t *)pack_iph, len - reaper_el)) {
+	memcpy(reaper_rst, pack, reaper_el);
+	memcpy(pkt_ethhdr(reaper_rst)->dst, pack_ethh->src, PKT_ETH_ALEN);
+	memcpy(pkt_ethhdr(reaper_rst)->src, pack_ethh->dst, PKT_ETH_ALEN);
+	chksum(pkt_iphdr(reaper_rst));
+	dhcp_send(this, dhcp_conn_idx(conn), conn->hismac, reaper_rst, reaper_el + 40);
+      }
+      OTHER_RECEIVED(conn, pack_iph);
+      return 0;
+    }
+
     /* Check for post-auth proxy, otherwise pass packets unmodified */
     dhcp_postauthDNAT(conn, pack, len, 0, &do_checksum);
     break; 
@@ -4968,6 +5114,20 @@ void dhcp_peer_update(char force) {
 }
 #endif
 
+/* REAPER-OWNMAC-BEGIN (compiled on the host by test_chilli_own_mac.py)
+ * reaper 2026-11-13 (Guest Portal: the portal logged a new client and held a pool address for the router's own
+ * address at each start). The portal reads its interface through a packet socket, which also delivers the frames
+ * the router itself sends there; an ARP request or a broadcast among them became a client entry. A frame whose
+ * Ethernet source is the interface's own address is never a client. */
+static int reaper_own_frame(const uint8_t *src, const uint8_t *own)
+{
+  static const uint8_t zero[6] = { 0, 0, 0, 0, 0, 0 };
+  if (!memcmp(own, zero, 6))
+    return 0;	/* the interface address is not known: filter nothing */
+  return !memcmp(src, own, 6);
+}
+/* REAPER-OWNMAC-END */
+
 static 
 int dhcp_decaps_cb(void *pctx, struct pkt_buffer *pb) {
   struct dhcp_ctx *ctx = (struct dhcp_ctx *)pctx;
@@ -4984,6 +5144,10 @@ int dhcp_decaps_cb(void *pctx, struct pkt_buffer *pb) {
     return 0;
   }
   
+  /* REAPER-OWNMAC: a frame the router sent on this interface is not a client */
+  if (reaper_own_frame(pkt_ethhdr(packet)->src, ctx->parent->rawif[ctx->idx].hwaddr))
+    return 0;
+
 #ifdef ENABLE_IEEE8021Q
   if (_options.ieee8021q) {
     if (is_8021q(packet)) {
diff --git a/release/src/router/httpd/web.c b/release/src/router/httpd/web.c
index 070556ce7a..0b741c9463 100644
--- a/release/src/router/httpd/web.c
+++ b/release/src/router/httpd/web.c
@@ -14011,6 +14011,110 @@ static int reaper_syscmd_shape_ok(const char *page, const char *cmd, char *mac,
 	return 0;
 }
 
+#ifdef RTCONFIG_CFGSYNC
+/* reaper 2026-11-12 (Guest Portal field report; reproduced on the owner's router): on an AiMesh router apply_cgi
+ * hands the page's service list to the closed cfg_server (/tmp/cfg.json action_script). A Guest Network Pro
+ * create ("restart_wireless;restart_sdn 4;restart_chilli;restart_uam_srv;") reached it as "...restart_sdn+4..."
+ * and was never run: the settings were saved and nothing was built (no Wi-Fi restart, no bridge, no portal),
+ * while a delete (no argument) ran. So a guest-network request is also recorded in RSDN_PENDING and handed to
+ * reaper_sdn_settle - its own process, never rc's busy queue - which applies the saved list only when rc has
+ * run no guest-network service since (rc/sdn.c). Nothing runs twice; AiMesh nodes are unchanged (cfg_client
+ * derives its own restarts from the synced settings). */
+#define RSDN_PENDING	"/tmp/reaper/sdn_pending"
+
+/* is t[0..n) a guest-network service (its name, arguments ignored) */
+static int reaper_sdn_tok(const char *t, size_t n)
+{
+	static const char *const tok[] = { "restart_sdn", "start_sdn_del", "restart_chilli", "restart_uam_srv", "restart_CP", NULL };
+	size_t w = strcspn(t, " ;");
+	int i;
+
+	if (w > n)
+		w = n;
+	for (i = 0; tok[i]; i++)
+		if (strlen(tok[i]) == w && strncmp(t, tok[i], w) == 0)
+			return 1;
+	return 0;
+}
+
+/* does the ';' list hold the service t[0..n) exactly */
+static int reaper_sdn_list_has(const char *list, const char *t, size_t n)
+{
+	const char *p = list, *q;
+
+	for (; *p; p = *q ? q + 1 : q) {
+		q = p + strcspn(p, ";");
+		if ((size_t)(q - p) == n && strncmp(p, t, n) == 0)
+			return 1;
+	}
+	return 0;
+}
+
+static void reaper_sdn_pending(const char *act)
+{
+	char merged[256] = "", old[300] = "", ts[24], tmp[] = RSDN_PENDING ".XXXXXX";
+	char *argv[] = { "/sbin/reaper_sdn_settle", ts, NULL };
+	const char *p, *q;
+	long now = uptime(), ot;
+	struct stat st;
+	int hit = 0, fd;
+	ssize_t n;
+	pid_t pid;
+
+	for (p = act; *p; p = *q ? q + 1 : q) {
+		q = p + strcspn(p, ";");
+		if (q > p && reaper_sdn_tok(p, (size_t)(q - p)))
+			hit = 1;
+	}
+	if (!hit)
+		return;
+
+	/* a request not yet settled (younger than 60 s): keep its services and add the new ones, so a quick second
+	 * change does not drop the first one's */
+	if ((fd = open(RSDN_PENDING, O_RDONLY | O_NOFOLLOW)) >= 0) {
+		if (fstat(fd, &st) == 0 && S_ISREG(st.st_mode) && st.st_uid == 0 &&
+		    (n = read(fd, old, sizeof(old) - 1)) > 0) {
+			char *sp;
+
+			old[n] = 0;
+			old[strcspn(old, "\r\n")] = 0;
+			ot = strtol(old, &sp, 10);
+			if (sp != old && *sp == ' ' && ot >= now - 60 && strlen(sp + 1) < sizeof(merged))
+				strlcpy(merged, sp + 1, sizeof(merged));
+		}
+		close(fd);
+	}
+	for (p = act; *p; p = *q ? q + 1 : q) {
+		q = p + strcspn(p, ";");
+		if (q == p || reaper_sdn_list_has(merged, p, (size_t)(q - p)))
+			continue;
+		if (strlen(merged) + (size_t)(q - p) + 2 >= sizeof(merged)) {
+			strlcpy(merged, act, sizeof(merged));	/* no room to merge: this request alone */
+			break;
+		}
+		strncat(merged, p, (size_t)(q - p));
+		strcat(merged, ";");
+	}
+
+	reaper_secure_dir(REAPER_TMPDIR, 0700);	/* tmp hardening: root's own directory */
+	if ((fd = mkstemp(tmp)) < 0)
+		return;
+	snprintf(old, sizeof(old), "%ld %s\n", now, merged);
+	if (write(fd, old, strlen(old)) != (ssize_t)strlen(old) || fchmod(fd, 0600) != 0) {
+		close(fd);
+		unlink(tmp);
+		return;
+	}
+	close(fd);
+	if (rename(tmp, RSDN_PENDING) != 0) {
+		unlink(tmp);
+		return;
+	}
+	snprintf(ts, sizeof(ts), "%ld", now);
+	_eval(argv, NULL, 0, &pid);
+}
+#endif
