+/* REAPER-FCLAN-BEGIN (compiled on the host by test_rtrafd_fclan.py)
+ * 2026-11-13: the flow-cache pass's "LAN client" test. It used the main subnet only, so an accelerated upload from a
+ * guest network on its own subnet was filed as the router's own traffic as well as under its network (conntrack).
+ * Any LAN bridge subnet (brsub) or Guest Portal tunnel subnet (ptsub) is a LAN source now. */
+static int fc_src_is_lan(uint32_t sip)
