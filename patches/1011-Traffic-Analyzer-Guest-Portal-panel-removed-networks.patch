-			(unsigned long long)lv_net_rx[i], (unsigned long long)lv_net_tx[i]);
+	first = 1;
+	for (i = 0; i < nnet; i++) {
+		int pt = portal_is_tun(netname[i]);	/* 2026-11-13: REAPER-PORTAL rate, not the conntrack pass's */
+		if (net_gone[i]) continue;	/* 2026-11-13: a network that no longer exists has no live rate */
