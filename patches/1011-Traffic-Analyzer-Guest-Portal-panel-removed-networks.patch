+/* REAPER-NETGONE-BEGIN (compiled on the host by test_rtrafd_net_gone.py)
+ * 2026-11-13, owner report: the Traffic Analyzer's "By network" kept showing br55 after that network was
+ * deleted. A bridge gets a slot the first time it carries traffic and the slot is persisted in rtraf.db, so it
+ * stayed in the live view at 0 for ever, in every history window, and held one of the NNET slots for good - a
+ * network created after the slots ran out was never counted. A slot whose interface no longer exists is now
+ * marked gone: the live view leaves it out, the history payload names it ("netgone") so the page draws it
+ * only where it carried traffic, and when every slot is taken a gone one is reused (its history is dropped:
+ * the network it belonged to no longer exists). The Router bucket is not an interface and is never gone. */
+static int net_iface_exists(const char *name)
+{
+	return if_nametoindex(name) != 0;
+}
+
+static void net_gone_refresh(void)
+{
+	int i;
+	for (i = 0; i < nnet; i++)
+		net_gone[i] = strcmp(netname[i], RT_NETLBL) != 0 && !net_iface_exists(netname[i]);
+}
+
 static int net_slot(const char *name)
 {
 	int i;
 	for (i = 0; i < nnet; i++)
-		if (strcmp(netname[i], name) == 0) return i;
-	if (nnet >= NNET) return -1;
-	strlcpy(netname[nnet], name, sizeof(netname[0]));
-	return nnet++;
+		if (strcmp(netname[i], name) == 0) {
+			net_gone[i] = 0;	/* traffic through it: it is back (a network re-created under the same bridge) */
+			return i;
+		}
+	if (nnet < NNET) {
+		strlcpy(netname[nnet], name, sizeof(netname[0]));
+		net_gone[nnet] = 0;
+		return nnet++;
+	}
+	for (i = 0; i < nnet; i++)
+		if (net_gone[i]) {
+			memset(r_net[i], 0, sizeof(*r_net[i]));
+			lv_net_rx[i] = lv_net_tx[i] = 0;
+			strlcpy(netname[i], name, sizeof(netname[0]));
+			net_gone[i] = 0;
+			return i;
+		}
+	return -1;
 }
+/* REAPER-NETGONE-END */
 
 /* LAN-side interface -> its bridge (per-network grouping). A port's bridge is
  * /sys/class/net/<dev>/master; wireless VIFs (wl2.1) and wired ports resolve to
@@ -1064,6 +1149,173 @@ static ssize_t rt_exec_bounded(char *const argv[], char *out, size_t outsz, int
 	return (ssize_t)got;
 }
 
+/* REAPER-PORTAL-BEGIN (compiled on the host by test_rtrafd_portal.py)
+ * 2026-11-13, owner request: a Guest Portal panel on the Live tab - each guest with their speed - the portal's share
+ * on the total chart, and a Guest Portal row in By network. A portal guest's address sits on the portal's tunnel
+ * (tun22 / tun23, no bridge), so the conntrack pass never attributes it (ip_bridge() knows bridges only). The portal
+ * counts every byte of every session itself, so ask it: `chilli_query -P <port> list`, every PORTAL_MS, and only
+ * while that tunnel exists. One line per guest (coovachilli chilli_print + chilli_getinfo, long format):
+ *   MAC IP state session-id authenticated user session/timeout idle/timeout in/max out/max ...
+ * Without swapoctets (rc never sets it) "in" is what the portal sent TO the guest (download, chilli_acct_tosub)
+ * and "out" what came FROM the guest (upload, chilli_acct_fromsub). A guest with no address yet prints two fields
+ * and is skipped. A counter that went down is a new session: new baseline, no spike. */
+#define NPORTAL		64
+#define PORTAL_MS	2000
+#define PORTAL_OUT	16384		/* ~150 B a guest: NPORTAL guests with room to spare */
+static const char *const portal_tun[2] = { "tun22", "tun23" };
+static const char *const portal_port[2] = { "42424", "42425" };	/* cmdsocketport, rc/services.c */
+typedef struct {
+	char mac[18], ip[16], st[8];
+	int tun, auth, sess, seen;
+	uint64_t lin, lout;		/* the session's own counters at the last poll */
+	uint64_t dn, up;		/* bits/s over the last interval */
+} pcl_t;
+static pcl_t pcl[NPORTAL];
+static int npcl = 0;
+static int portal_up[2];
+static uint64_t ptun_dn[2], ptun_up[2];
+
+static int portal_is_tun(const char *name)
+{
+	int t;
+	if (!name) return -1;
+	for (t = 0; t < 2; t++)
+		if (!strcmp(name, portal_tun[t])) return t;
+	return -1;
+}
+
+/* one long-format line -> g (mac as aa:bb:.., lowercase); 0 = not a whole guest line */
+static int portal_parse_line(const char *line, pcl_t *g)
+{
+	char mac[24], ip[24], st[16];
+	int auth, sess, i;
+	unsigned long long in, out;
+	struct in_addr a;
+
+	if (sscanf(line, "%23s %23s %15s %*s %d %*s %d/%*d %*d/%*d %llu/%*s %llu/%*s",
+		   mac, ip, st, &auth, &sess, &in, &out) != 7)
+		return 0;
+	if (strlen(mac) != 17) return 0;
+	for (i = 0; i < 17; i++) {
+		char c = mac[i];
+		if (i % 3 == 2) { if (c != '-') return 0; mac[i] = ':'; continue; }
+		if (c >= 'A' && c <= 'F') c = (char)(c - 'A' + 'a');
+		if (!((c >= '0' && c <= '9') || (c >= 'a' && c <= 'f'))) return 0;
+		mac[i] = c;
+	}
+	if (inet_aton(ip, &a) == 0) return 0;
+	if (strlen(st) > 7) return 0;
+	for (i = 0; st[i]; i++)
+		if (st[i] < 'a' || st[i] > 'z') return 0;
+	memset(g, 0, sizeof(*g));
+	strlcpy(g->mac, mac, sizeof(g->mac));
+	strlcpy(g->ip, inet_ntoa(a), sizeof(g->ip));
+	strlcpy(g->st, st, sizeof(g->st));
+	g->auth = auth ? 1 : 0;
+	g->sess = sess > 0 ? sess : 0;
+	g->lin = in;
+	g->lout = out;
+	return 1;
+}
+
+/* drop every guest of tunnel t not seen in this poll (all of them when the tunnel is gone) */
+static void portal_sweep(int t)
+{
+	int i, j = 0;
+	for (i = 0; i < npcl; i++) {
+		if (pcl[i].tun == t && !pcl[i].seen) continue;
+		if (j != i) pcl[j] = pcl[i];
+		j++;
+	}
+	npcl = j;
+}
+
+/* one portal's list -> the guest table; returns the bytes moved since the last poll (dn / up) */
+static void portal_ingest(int t, const char *text, long el_ms, uint64_t *ddn, uint64_t *dup)
+{
+	const char *p = text, *nl;
+	int i;
+
+	*ddn = *dup = 0;
+	ptun_dn[t] = ptun_up[t] = 0;
+	for (i = 0; i < npcl; i++)
+		if (pcl[i].tun == t) pcl[i].seen = 0;
+	/* only lines that END in a newline: a reply cut at the buffer's end would otherwise hand over a truncated
+	 * counter (read low, then high again = a spike) */
+	while ((nl = strchr(p, '\n')) != NULL) {
+		char line[512];
+		size_t n = (size_t)(nl - p);
+		pcl_t g;
+		pcl_t *e = NULL;
+
+		if (n >= sizeof(line)) n = sizeof(line) - 1;
+		memcpy(line, p, n);
+		line[n] = '\0';
+		p = nl + 1;
+		if (!portal_parse_line(line, &g)) continue;
+		for (i = 0; i < npcl; i++)
+			if (pcl[i].tun == t && !strcmp(pcl[i].mac, g.mac)) { e = &pcl[i]; break; }
+		if (!e) {
+			if (npcl >= NPORTAL) continue;
+			e = &pcl[npcl++];
+			*e = g;
+			e->tun = t;		/* first sight: baseline only, no rate yet */
+		} else {
+			uint64_t din = g.lin >= e->lin ? g.lin - e->lin : 0;
+			uint64_t dou = g.lout >= e->lout ? g.lout - e->lout : 0;
+			e->dn = el_ms > 0 ? din * 8 * 1000 / (uint64_t)el_ms : 0;
+			e->up = el_ms > 0 ? dou * 8 * 1000 / (uint64_t)el_ms : 0;
+			e->lin = g.lin;
+			e->lout = g.lout;
+			strlcpy(e->ip, g.ip, sizeof(e->ip));
+			strlcpy(e->st, g.st, sizeof(e->st));
+			e->auth = g.auth;
+			e->sess = g.sess;
+			*ddn += din;
+			*dup += dou;
+			ptun_dn[t] += e->dn;
+			ptun_up[t] += e->up;
+		}
+		e->seen = 1;
+	}
+	portal_sweep(t);
+}
+
+static void portal_poll(long el_ms)
+{
+	static char out[PORTAL_OUT];
+	int t;
+
+	for (t = 0; t < 2; t++) {
+		char *av[5];
+		uint64_t ddn, dup;
+
+		portal_up[t] = if_nametoindex(portal_tun[t]) != 0;
+		if (!portal_up[t]) {
+			int i;
+			for (i = 0; i < npcl; i++)
+				if (pcl[i].tun == t) pcl[i].seen = 0;
+			portal_sweep(t);
+			ptun_dn[t] = ptun_up[t] = 0;
+			continue;
+		}
+		av[0] = "chilli_query"; av[1] = "-P"; av[2] = (char *)portal_port[t]; av[3] = "list"; av[4] = NULL;
+		if (rt_exec_bounded(av, out, sizeof(out), 1) < 0) {
+			int i;
+			for (i = 0; i < npcl; i++)	/* could not ask: keep the guests, show no speed */
+				if (pcl[i].tun == t) pcl[i].dn = pcl[i].up = 0;
+			ptun_dn[t] = ptun_up[t] = 0;
+			continue;
+		}
+		portal_ingest(t, out, el_ms, &ddn, &dup);
+		if (ddn || dup) {
+			int ns = net_slot(portal_tun[t]);	/* the By network row (history too: it is a network) */
+			if (ns >= 0) ring_add(r_net[ns], ddn, dup);
+		}
+	}
+}
+/* REAPER-PORTAL-END */
