diff --git a/release/src/router/rom/webs_scripts/reaper_webs_update.sh b/release/src/router/rom/webs_scripts/reaper_webs_update.sh
index 51cb70543e..6d3aa7ccf4 100644
--- a/release/src/router/rom/webs_scripts/reaper_webs_update.sh
+++ b/release/src/router/rom/webs_scripts/reaper_webs_update.sh
@@ -68,6 +68,20 @@ esac
 
 echo "---- model=$model variant=$variant running=$cur_ver ----" >> "$LOG"
 
+# 2026-11-14 (owner): a TEST build - EXTENDNO carries _ALPHA, the unified-tree builds published from the Dev-Uni
+# branch - is installed by hand and is never offered another image: not the stable line, and not a Dev beta, which
+# would take the box off the tree it is testing. Nothing is fetched. The Firmware page says why
+# (webs_state_channel=alpha); the scheduled check and an AiMesh-triggered one end here too.
+case "$(nvram get extendno)" in
+*_ALPHA*)
+	echo "---- test build (alpha): no update is looked for or offered ----" >> "$LOG"
+	logger -t reaper-fw "update check: this is a test build (alpha) - updates are installed by hand, nothing is offered"
+	nvram set webs_state_channel=alpha
+	nvram set webs_state_flag=0
+	nvram set webs_state_update=1
+	exit 0 ;;
+esac
+
 /usr/sbin/wget $wget_options "$MANIFEST_URL" -O "$TMP"
 if [ "$?" != "0" ] || [ ! -s "$TMP" ]; then
 	echo "---- manifest fetch failed ----" >> "$LOG"
