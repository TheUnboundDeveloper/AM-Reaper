-          gw:v['wan'+u+'_gateway']||'', dns:v['wan'+u+'_dns']||''};
+          gw:v['wan'+u+'_gateway']||'', dns:v['wan'+u+'_dns']||'', aux:String(v['wan'+u+'_auxstate_t']||'')};
 }
+/* 2026-11-12 (field report): IPv6 counts as up only while it has a default
+   route. The WAN-face address outlives the ISP's router advertisements and
