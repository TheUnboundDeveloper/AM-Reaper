 #define reaper_wan_leds(u, l) update_wan_leds(u, l)
 #endif
 
+#ifdef RTCONFIG_IPV6
+/* reaper 2026-11-12 (field report: native IPv6 never came back after an ISP
+ * outage until the WAN was toggled or the cable replugged).
+ * odhcp6c is started only from wan6_up(), i.e. on a fresh DHCPv4 *bound*. When
+ * the upstream goes away but the WAN link stays up, IPv4 merely renews when it
+ * returns and nothing touches IPv6 again: odhcp6c sits in its Solicit back-off
+ * (the server's SOL_MAX_RT persists in the process), or holds a bind that has
+ * no prefix, and rdisc6 exited long ago, so no fresh router advertisement is
+ * asked for. The D2C path below only redid NAT and resolv.conf.
+ * So, once per outage (C2D marks it, the next D2C/CONNED consumes it) and only
+ * for the IPv6 WAN unit in router mode with Native / Passthrough IPv6:
+ *   - SIGUSR1 to odhcp6c: when bound it renews now; while soliciting it
+ *     abandons the back-off and starts a fresh Solicit;
+ *   - SIGUSR2 instead when DHCP-PD is on and no prefix is held: a full new
+ *     transaction (IPv6 on the LAN is already gone, so nothing is torn down);
+ *   - start_dhcp6c if odhcp6c is not running at all;
+ *   - start_rdisc6 for a fresh router solicitation.
+ * Rate-limited to one kick a minute so a flapping probe cannot churn DHCPv6. */
+static int reaper_v6_down[WAN_UNIT_MAX];
+static long reaper_v6_last;
+
+static void reaper_v6_mark_down(int wan_unit)
+{
+	if (wan_unit >= 0 && wan_unit < WAN_UNIT_MAX)
+		reaper_v6_down[wan_unit] = 1;
+}
+
+static void reaper_v6_kick(int wan_unit)
+{
+	int service, sig;
+	long now;
+
+	if (wan_unit < 0 || wan_unit >= WAN_UNIT_MAX || !reaper_v6_down[wan_unit])
+		return;
+	reaper_v6_down[wan_unit] = 0;
+
+	if (sw_mode != SW_MODE_ROUTER || wan_unit != wan_primary_ifunit_ipv6())
+		return;
+	service = get_ipv6_service();
+	if (service != IPV6_NATIVE_DHCP
+#ifdef RTCONFIG_6RELAYD
+	    && service != IPV6_PASSTHROUGH
+#endif
+	    )
+		return;
+
+	now = uptime();
+	if (reaper_v6_last && now - reaper_v6_last < 60)
+		return;
+	reaper_v6_last = now;
+
+	if (pidof("odhcp6c") <= 0) {
+		logmessage("wanduck", "internet back on WAN %d: IPv6 client not running, starting it", wan_unit);
+		notify_rc("start_dhcp6c");
+	} else {
+		sig = (service == IPV6_NATIVE_DHCP && nvram_get_int(ipv6_nvname("ipv6_dhcp_pd"))
+		       && !*nvram_safe_get(ipv6_nvname("ipv6_prefix"))) ? SIGUSR2 : SIGUSR1;
+		logmessage("wanduck", "internet back on WAN %d: %s", wan_unit, (sig == SIGUSR2)
+			   ? "no IPv6 prefix held, restarting DHCPv6" : "renewing DHCPv6");
+		killall("odhcp6c", sig);
+	}
+	notify_rc("start_rdisc6");
+}
+#endif
+
 void set_link_internet(int wan_unit, int link_internet){
 #if !defined(RTCONFIG_WANLEDX2)
 	if(nvram_get_int("link_internet") == link_internet){
@@ -5087,6 +5152,10 @@ _dprintf("nat_rule: start_nat_rules 6.\n");
 		}
 #if !defined(RTCONFIG_MULTIWAN_PROFILE)
 		else if(conn_changed_state[current_wan_unit] == C2D || (conn_changed_state[current_wan_unit] == CONNED && isFirstUse)){
+#ifdef RTCONFIG_IPV6
+			if(conn_changed_state[current_wan_unit] == C2D)
+				reaper_v6_mark_down(current_wan_unit);	/* reaper 2026-11-12, see reaper_v6_kick() */
+#endif
 			if(!rule_setup){
 				if(conn_changed_state[current_wan_unit] == C2D){
 #if defined(RTCONFIG_WPS_ALLLED_BTN) || defined(RTCONFIG_DSL)
@@ -5184,6 +5253,9 @@ _dprintf("nat_rule: start_nat_rules 6.\n");
 			handle_wan_line(current_wan_unit, rule_setup);
 		}
 		else if(conn_changed_state[current_wan_unit] == D2C || conn_changed_state[current_wan_unit] == CONNED){
+#ifdef RTCONFIG_IPV6
+			reaper_v6_kick(current_wan_unit);	/* reaper 2026-11-12: once per outage, no-op otherwise */
+#endif
 			if(rule_setup && !isFirstUse){
 #if (defined(RTCONFIG_WPS_ALLLED_BTN) && !defined(RTCONFIG_HND_ROUTER_AX))|| \
     ((defined(RTCONFIG_LED_BTN) || defined(RTCONFIG_TURBO_BTN)) && defined(RTCONFIG_QCA))
