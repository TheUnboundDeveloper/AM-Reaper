 function v6Up(){
   if(!(WAN6 && WAN6.status==='1')) return false;
-  var a=String((WAN6.IPv6_Address)||'').split('/')[0];
-  var gw=String((WAN6.IPv6_Gateway)||'');
-  return !!(a || gw);
+  return !!String((WAN6.IPv6_Gateway)||'');
+}
+/* 2026-11-12 (field report): the word and the colour follow the router's own
+   internet check - the one that turns the WAN LED red - not the lease alone.
+   aux = the picked line's wanN_auxstate_t from rc/wanduck.c: 1 = the WAN port
+   has no link, 2 = the internet check failed (no default route, or the DNS /
+   ping probe got no answer). Before this a valid DHCP lease kept the header
+   green while the LED was red. A failed check over an IPv4 lease fails the
+   whole WAN, IPv6 included (the LED is red too); with no IPv4 lease at all,
+   IPv6 decides on its own. */
