+  return {any:!!(v4 || v6), v4:!!v4, v6:!!v6, why:''};
+}
+function netWord(){
+  return (NET.v4 || NET.v6) ? NT.conn : ((NET.why==='noinet') ? NT.noinet : NT.disc);
 }
