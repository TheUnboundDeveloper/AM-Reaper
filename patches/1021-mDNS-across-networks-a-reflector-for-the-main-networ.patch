From 0da3a38e4ba07a25437b71c06fcd16b5672281f1 Mon Sep 17 00:00:00 2001
From: reaper <theunbounddeveloper@outlook.com>
Date: Sat, 14 Nov 2026 12:41:07 -0500
Subject: [PATCH] mDNS across networks: a reflector for the main network and
 intranet networks (102.8 line)

- avahi: a reflect-interfaces option. The reflector relays only between the interfaces named there
  (checked on the receiving and on the sending side, for responses, queries, probes and legacy
  unicast queries); an empty list keeps the stock behaviour.
- New setting reaper_mdns_reflect (default on, saved with the configuration backup) and a switch
  on the Tweaks page, shown in the routing modes only. The rc side that writes the avahi
  configuration is in the guest networks commit.

Co-Authored-By: Claude Fable 5.2 <noreply@anthropic.com>
---
 release/src/router/avahi/avahi-core/core.h   |  1 +
 release/src/router/avahi/avahi-core/server.c | 45 ++++++++++++++++----
 release/src/router/avahi/avahi-daemon/main.c | 12 ++++++
 release/src/router/httpd/web.c               |  1 +
 release/src/router/shared/defaults.c         |  1 +
 release/src/router/www/Reaper_Tweaks.asp     | 20 +++++++--
 6 files changed, 68 insertions(+), 12 deletions(-)

diff --git a/release/src/router/avahi/avahi-core/core.h b/release/src/router/avahi/avahi-core/core.h
index c0324f93ca..26c037047d 100644
--- a/release/src/router/avahi/avahi-core/core.h
+++ b/release/src/router/avahi/avahi-core/core.h
@@ -71,6 +71,7 @@ typedef struct AvahiServerConfig {
     AvahiUsec ratelimit_interval;     /**< If non-zero, rate-limiting interval parameter. */
     unsigned ratelimit_burst;         /**< If ratelimit_interval is non-zero, rate-limiting burst parameter. */
     char **aliases;                   /**< Additional names to publish as CNAME for this host. */
+    AvahiStringList *reflect_interfaces; /**< reaper 2026-11-14: if enable_reflector is 1 and this is set, only these interfaces take part in reflection */
 } AvahiServerConfig;
 
 /** Allocate a new mDNS responder object. */
diff --git a/release/src/router/avahi/avahi-core/server.c b/release/src/router/avahi/avahi-core/server.c
index 77a352960b..35ae9290bc 100644
--- a/release/src/router/avahi/avahi-core/server.c
+++ b/release/src/router/avahi/avahi-core/server.c
@@ -496,6 +496,21 @@ void avahi_server_generate_response(AvahiServer *s, AvahiInterface *i, AvahiDnsP
     avahi_record_list_flush(s->record_list);
 }
 
+/* reaper 2026-11-14 (owner): reflect-interfaces. With the reflector on and this list set, only the named interfaces
+ * send or receive reflected mDNS; the router's own answers are not affected. rc (generate_mdns_config) names the main
+ * LAN and the networks with Access Intranet on, minus any with Set AP Isolated on, so a client-isolated or guest
+ * network is never joined to another one. An empty list keeps the stock rule (every interface). */
+static int reflect_iface_ok(AvahiServer *s, AvahiInterface *i) {
+    AvahiStringList *l;
+
+    if (!s->config.reflect_interfaces)
+        return 1;
+    for (l = s->config.reflect_interfaces; l; l = l->next)
+        if (strcasecmp((char*) l->text, i->hardware->name) == 0)
+            return 1;
+    return 0;
+}
+
 static void reflect_response(AvahiServer *s, AvahiInterface *i, AvahiRecord *r, int flush_cache) {
     AvahiInterface *j;
 
@@ -503,11 +518,11 @@ static void reflect_response(AvahiServer *s, AvahiInterface *i, AvahiRecord *r,
     assert(i);
     assert(r);
 
-    if (!s->config.enable_reflector)
+    if (!s->config.enable_reflector || !reflect_iface_ok(s, i))
         return;
 
     for (j = s->monitor->interfaces; j; j = j->interface_next)
-        if (j != i && (s->config.reflect_ipv || j->protocol == i->protocol))
+        if (j != i && reflect_iface_ok(s, j) && (s->config.reflect_ipv || j->protocol == i->protocol))
             avahi_interface_post_response(j, r, flush_cache, NULL, 1);
 }
 
@@ -538,11 +553,11 @@ static void reflect_query(AvahiServer *s, AvahiInterface *i, AvahiKey *k) {
     assert(i);
     assert(k);
 
-    if (!s->config.enable_reflector)
+    if (!s->config.enable_reflector || !reflect_iface_ok(s, i))
         return;
 
     for (j = s->monitor->interfaces; j; j = j->interface_next)
-        if (j != i && (s->config.reflect_ipv || j->protocol == i->protocol)) {
+        if (j != i && reflect_iface_ok(s, j) && (s->config.reflect_ipv || j->protocol == i->protocol)) {
             /* Post the query to other networks */
             avahi_interface_post_query(j, k, 1, NULL);
 
@@ -560,11 +575,11 @@ static void reflect_probe(AvahiServer *s, AvahiInterface *i, AvahiRecord *r) {
     assert(i);
     assert(r);
 
-    if (!s->config.enable_reflector)
+    if (!s->config.enable_reflector || !reflect_iface_ok(s, i))
         return;
 
     for (j = s->monitor->interfaces; j; j = j->interface_next)
-        if (j != i && (s->config.reflect_ipv || j->protocol == i->protocol))
+        if (j != i && reflect_iface_ok(s, j) && (s->config.reflect_ipv || j->protocol == i->protocol))
             avahi_interface_post_probe(j, r, 1);
 }
 
@@ -831,7 +846,7 @@ static void reflect_legacy_unicast_query_packet(AvahiServer *s, AvahiDnsPacket *
     assert(port > 0);
     assert(i->protocol == a->proto);
 
-    if (!s->config.enable_reflector)
+    if (!s->config.enable_reflector || !reflect_iface_ok(s, i))
         return;
 
     /* Reflecting legacy unicast queries is a little more complicated
@@ -862,6 +877,7 @@ static void reflect_legacy_unicast_query_packet(AvahiServer *s, AvahiDnsPacket *
     for (j = s->monitor->interfaces; j; j = j->interface_next)
         if (j->announcing &&
             j != i &&
+            reflect_iface_ok(s, j) &&
             (s->config.reflect_ipv || j->protocol == i->protocol)) {
 
             if (j->protocol == AVAHI_PROTO_INET && s->fd_legacy_unicast_ipv4 >= 0) {
@@ -1643,6 +1659,7 @@ AvahiServerConfig* avahi_server_config_init(AvahiServerConfig *c) {
     c->enable_reflector = 0;
     c->reflect_ipv = 0;
     c->reflect_filters = NULL;
+    c->reflect_interfaces = NULL;
     c->add_service_cookie = 0;
     c->enable_wide_area = 0;
     c->n_wide_area_servers = 0;
@@ -1666,13 +1683,14 @@ void avahi_server_config_free(AvahiServerConfig *c) {
     avahi_free(c->domain_name);
     avahi_string_list_free(c->browse_domains);
     avahi_string_list_free(c->reflect_filters);
+    avahi_string_list_free(c->reflect_interfaces);
     avahi_string_list_free(c->allow_interfaces);
     avahi_string_list_free(c->deny_interfaces);
 }
 
 AvahiServerConfig* avahi_server_config_copy(AvahiServerConfig *ret, const AvahiServerConfig *c) {
     char *d = NULL, *h = NULL;
-    AvahiStringList *browse = NULL, *allow = NULL, *deny = NULL, *reflect = NULL ;
+    AvahiStringList *browse = NULL, *allow = NULL, *deny = NULL, *reflect = NULL, *rifs = NULL;
     assert(ret);
     assert(c);
 
@@ -1716,6 +1734,16 @@ AvahiServerConfig* avahi_server_config_copy(AvahiServerConfig *ret, const AvahiS
         return NULL;
     }
 
+    if (!(rifs = avahi_string_list_copy(c->reflect_interfaces)) && c->reflect_interfaces) {
+        avahi_string_list_free(reflect);
+        avahi_string_list_free(allow);
+        avahi_string_list_free(browse);
+        avahi_string_list_free(deny);
+        avahi_free(h);
+        avahi_free(d);
+        return NULL;
+    }
+
     *ret = *c;
     ret->host_name = h;
     ret->domain_name = d;
@@ -1723,6 +1751,7 @@ AvahiServerConfig* avahi_server_config_copy(AvahiServerConfig *ret, const AvahiS
     ret->allow_interfaces = allow;
     ret->deny_interfaces = deny;
     ret->reflect_filters = reflect;
+    ret->reflect_interfaces = rifs;
 
     return ret;
 }
diff --git a/release/src/router/avahi/avahi-daemon/main.c b/release/src/router/avahi/avahi-daemon/main.c
index 170d1bb45c..8397080cef 100644
--- a/release/src/router/avahi/avahi-daemon/main.c
+++ b/release/src/router/avahi/avahi-daemon/main.c
@@ -867,6 +867,18 @@ static int load_config_file(DaemonConfig *c) {
 
                     avahi_strfreev(e);
                 }
+                else if (strcasecmp(p->key, "reflect-interfaces") == 0) {	/* reaper 2026-11-14 */
+                    char **e, **t;
+
+                    avahi_string_list_free(c->server_config.reflect_interfaces);
+                    c->server_config.reflect_interfaces = NULL;
+                    e = avahi_split_csv(p->value);
+
+                    for (t = e; *t; t++)
+                        c->server_config.reflect_interfaces = avahi_string_list_add(c->server_config.reflect_interfaces, *t);
+
+                    avahi_strfreev(e);
+                }
                 else {
                     avahi_log_error("Invalid configuration key \"%s\" in group \"%s\"\n", p->key, g->name);
                     goto finish;
diff --git a/release/src/router/httpd/web.c b/release/src/router/httpd/web.c
index 0b741c9463..f82367d9f8 100644
--- a/release/src/router/httpd/web.c
+++ b/release/src/router/httpd/web.c
@@ -29535,6 +29535,7 @@ static const struct { const char *sect; const char *nv; size_t max; } rcfg_flags
 	{ "misc",   "upnp_protect_svc", 2   }, { "misc",   "rchq_enable",    2   },
 	{ "misc",   "reaper_bgdfs_stock", 2 },	/* review 2026-11-11 (C-5): Tweaks > Wireless stability */
 	{ "misc",   "reaper_dhd_ioto", 6    }, { "misc",   "disable_exap",   2   },	/* review 2026-11-11: Tweaks > Wireless stability */
+	{ "misc",   "reaper_mdns_reflect", 2 },	/* 2026-11-14: Tweaks > mDNS across networks */
 };
 #define RCFG_NFLAGS ((int)(sizeof(rcfg_flags) / sizeof(rcfg_flags[0])))
 static const char *rcfg_fw_lists[] = { "obj", "grp", "svc", "zone", "zpol", "rules", "edef", "nat" };
diff --git a/release/src/router/shared/defaults.c b/release/src/router/shared/defaults.c
index d3127849f8..c64aac69da 100644
--- a/release/src/router/shared/defaults.c
+++ b/release/src/router/shared/defaults.c
@@ -3183,6 +3183,7 @@ struct nvram_tuple router_defaults[] = {
 	{ "reaper_bgdfs_stock", "0", CKN_STR1, CKN_TYPE_DEFAULT, CKN_ACC_LEVEL_DEFAULT, CKN_ENC_DEFAULT, 0 },
 	/* review 2026-11-11 (B-C4, owner): 0 = the Guest Portal secret is this router's random one (rc), 1 = the admin's own */
 	{ "reaper_cp_secret_own", "0", CKN_STR1, CKN_TYPE_DEFAULT, CKN_ACC_LEVEL_DEFAULT, CKN_ENC_DEFAULT, 0 },
+	{ "reaper_mdns_reflect", "1", CKN_STR1, CKN_TYPE_DEFAULT, CKN_ACC_LEVEL_DEFAULT, CKN_ENC_DEFAULT, 0 },	/* 2026-11-14 (owner): Tweaks > mDNS across networks, on */
 	/* review 2026-11-11 (A-C1): the driver's wait for a radio to answer one call, in ms (rc/services.c
 	 * reaper_dhd_ioto_apply). 0 = OFF = the driver's own 5000; the Tweaks page has the switch (2000-5000, 3000 recommended) */
 	{ "reaper_dhd_ioto", "0", CKN_STR8, CKN_TYPE_DEFAULT, CKN_ACC_LEVEL_DEFAULT, CKN_ENC_DEFAULT, 0 },
diff --git a/release/src/router/www/Reaper_Tweaks.asp b/release/src/router/www/Reaper_Tweaks.asp
index fc5e560b0f..ac0aeda260 100644
--- a/release/src/router/www/Reaper_Tweaks.asp
+++ b/release/src/router/www/Reaper_Tweaks.asp
@@ -18,7 +18,11 @@
      restart_dnsmasq (dhcpd_send_wpad, a dnsmasq option) - the stock page sent restart_conntrack alone,
      so the last two waited for some unrelated restart. http_dut_redir is read by the login page.
      2026-11-11 (review 2026-11-11): the Wireless stability panel - reaper_dhd_ioto (restart_reaper_wltune),
-     disable_exap (saved only), reaper_bgdfs_stock (restart_wireless); all three off by default. -->
+     disable_exap (saved only), reaper_bgdfs_stock (restart_wireless); all three off by default.
+     2026-11-14 (owner): mDNS across networks - reaper_mdns_reflect (restart_mdns), ON by default (only "0" is off):
+     avahi's reflector joins the main LAN and every network with Access Intranet on, never one with Set AP Isolated
+     on, never a Guest Portal (rc/reaper_guest.c reaper_mdns_ifaces). Routing modes only; elsewhere the row is hidden
+     and the value kept. -->
 <link rel="stylesheet" href="/reaper/rp.css">
 <style>
 /* page-specific rules only; the Reaper look comes from /reaper/rp.css */
@@ -69,6 +73,7 @@
   <div class="frow"><div class="fl"><#RTWK_23#></div><div class="fc"><label class="tswitch"><input type="checkbox" id="t_http_dut_redir"><span class="track"></span></label></div><div class="fh"><#RTWK_24#> <span class="mono"><#Web_DOMAIN_NAME#></span></div></div>
   <div class="frow"><div class="fl"><#RTWK_25#></div><div class="fc"><label class="tswitch"><input type="checkbox" id="t_ipv6_ns_drop"><span class="track"></span></label></div><div class="fh"><#RTWK_26#></div></div>
   <div class="frow"><div class="fl"><#RTWK_27#></div><div class="fc"><label class="tswitch"><input type="checkbox" id="t_dhcpd_send_wpad"><span class="track"></span></label></div><div class="fh"><#RTWK_28#></div></div>
+  <div class="frow" id="r_mdns_reflect"><div class="fl"><#RTWK_47#></div><div class="fc"><label class="tswitch"><input type="checkbox" id="t_mdns_reflect"><span class="track"></span></label></div><div class="fh"><#RTWK_48#></div></div>
 </div>
 <div class="panel" id="p_wlstab">
   <h2><#RTWK_32#></h2>
@@ -109,10 +114,12 @@ var NV = {
   ct_max: <% nvram_get_js("ct_max"); %>, ct_tcp_timeout: <% nvram_get_js("ct_tcp_timeout"); %>, ct_udp_timeout: <% nvram_get_js("ct_udp_timeout"); %>,
   http_dut_redir: <% nvram_get_js("http_dut_redir"); %>, ipv6_ns_drop: <% nvram_get_js("ipv6_ns_drop"); %>, dhcpd_send_wpad: <% nvram_get_js("dhcpd_send_wpad"); %>,
   /* review 2026-11-11: Wireless stability */
-  reaper_dhd_ioto: <% nvram_get_js("reaper_dhd_ioto"); %>, disable_exap: <% nvram_get_js("disable_exap"); %>, reaper_bgdfs_stock: <% nvram_get_js("reaper_bgdfs_stock"); %>
+  reaper_dhd_ioto: <% nvram_get_js("reaper_dhd_ioto"); %>, disable_exap: <% nvram_get_js("disable_exap"); %>, reaper_bgdfs_stock: <% nvram_get_js("reaper_bgdfs_stock"); %>,
+  /* 2026-11-14: mDNS across networks */
+  reaper_mdns_reflect: <% nvram_get_js("reaper_mdns_reflect"); %>
 };
 /* an empty nvram value means the default (shared/defaults.c): compare against what the control shows for it */
-(function(){ var D = {ct_max: '300000', http_dut_redir: '0', ipv6_ns_drop: '0', dhcpd_send_wpad: '1', reaper_dhd_ioto: '0', disable_exap: '0', reaper_bgdfs_stock: '0'}, k;
+(function(){ var D = {ct_max: '300000', http_dut_redir: '0', ipv6_ns_drop: '0', dhcpd_send_wpad: '1', reaper_dhd_ioto: '0', disable_exap: '0', reaper_bgdfs_stock: '0', reaper_mdns_reflect: '1'}, k;
   for (k in D) if (NV[k] === '') NV[k] = D[k]; })();
 
 /* the timeout fields: id, label, nvram slot, kernel default (seconds), upper bound */
@@ -162,7 +169,11 @@ function udpStr(){ return val('udp_unreplied') + ' ' + val('udp_assured'); }
 
 section('p_adv', function(){
   setChk('t_http_dut_redir', isOn(NV.http_dut_redir)); setChk('t_ipv6_ns_drop', isOn(NV.ipv6_ns_drop)); setChk('t_dhcpd_send_wpad', isOn(NV.dhcpd_send_wpad));
-}, function(c){ c.http_dut_redir = chk('t_http_dut_redir'); c.ipv6_ns_drop = chk('t_ipv6_ns_drop'); c.dhcpd_send_wpad = chk('t_dhcpd_send_wpad'); });
+  /* 2026-11-14: mDNS across networks - on unless "0"; outside routing modes there are no other networks to join */
+  setChk('t_mdns_reflect', NV.reaper_mdns_reflect !== '0');
+  if (!ROUTING) q('r_mdns_reflect').classList.add('off');
+}, function(c){ c.http_dut_redir = chk('t_http_dut_redir'); c.ipv6_ns_drop = chk('t_ipv6_ns_drop'); c.dhcpd_send_wpad = chk('t_dhcpd_send_wpad');
+  c.reaper_mdns_reflect = ROUTING ? chk('t_mdns_reflect') : NV.reaper_mdns_reflect; });
 
 /* review 2026-11-11: Wireless stability - three switches, all OFF by default (off = the router behaves as before).
    reaper_dhd_ioto: how long the Wi-Fi driver waits for a radio to answer one call, ms (0 = its own 5000; rc/services.c
@@ -221,6 +232,7 @@ function applyAll(){
   if (has('rwarden_sched')) S.push('restart_rwarden');
   if (has('ipv6_ns_drop')) S.push('restart_firewall');
   if (has('dhcpd_send_wpad')) S.push('restart_dnsmasq');
+  if (has('reaper_mdns_reflect')) S.push('restart_mdns');	/* 2026-11-14: avahi rereads its networks */
   /* review 2026-11-11: the timeout is set in the radios at once (no Wi-Fi restart); disable_exap is read by the roaming
      assistant on each report (saved only); the DFS rule is applied when the radios are set up, so Wi-Fi restarts */
   if (has('reaper_dhd_ioto')) S.push('restart_reaper_wltune');
