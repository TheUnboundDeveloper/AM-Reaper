index 67068d41bf..0b2816ab1d 100644
--- a/release/src/router/www/Makefile
+++ b/release/src/router/www/Makefile
@@ -902,6 +902,37 @@ ifneq ($(RTCONFIG_CAPTIVE_PORTAL), y)
 	rm -rf $(INSTALLDIR)/www/ajax_captive_portal_log.asp
 	rm -rf $(INSTALLDIR)/www/jscolor
 endif
+# reaper 2026-11-17 (review B-20) REAPER-UNSHIP-CP: on a model built with RTCONFIG_MULTILAN_CFG the menu offers
+# the Network page (SDN.asp) and never the stock Free WiFi / Captive Portal editors or the old Guest Network
+# page (reaper/menu.js: each of their rows needs !mtlancfg); the Guest Portal that IS offered has its own
+# templates under SDN/. Nothing else in the shipped www loads these files - the editors were 2.7 MB of pages
+# only a typed address could reach. httpd answers the old addresses (reaper_inject.c reaper_pagemap[]).
+# The Advanced editor is kept when RTCONFIG_CP_ADVANCED is set (no supported model sets it).
+ifeq ($(RTCONFIG_MULTILAN_CFG), y)
+	rm -f $(INSTALLDIR)/www/Captive_Portal.asp $(INSTALLDIR)/www/Captive_Portal.css
+	rm -f $(INSTALLDIR)/www/Captive_Portal_Preview.asp $(INSTALLDIR)/www/Captive_Portal_template.js
+	rm -f $(INSTALLDIR)/www/Guest_network.asp $(INSTALLDIR)/www/Guest_network.css
+ifneq ($(RTCONFIG_CP_ADVANCED), y)
+	rm -f $(INSTALLDIR)/www/Captive_Portal_Advanced.asp $(INSTALLDIR)/www/Captive_Portal_Advanced.css
+	rm -f $(INSTALLDIR)/www/Captive_Portal_Advanced_Preview.asp $(INSTALLDIR)/www/Captive_Portal_Advanced_template.js
+	rm -f $(INSTALLDIR)/www/ajax_captive_portal.asp $(INSTALLDIR)/www/ajax_captive_portal_log.asp
+	rm -rf $(INSTALLDIR)/www/jscolor
+endif
+endif
+# reaper 2026-11-17 (review B-25) REAPER-UNSHIP-WL: three stock pages every model only bounced away from
+# (Reaper_WiFiSettings.asp / Reaper_LAN.asp took them over), with the schedule script, its style sheet and
+# the tutorial images that only Advanced_WAdvanced_Content.asp loaded. js/weekSchedule/schedule_ui* and
+# jquery-ui.css stay: the Network page and the LED schedule load them.
+	rm -f $(INSTALLDIR)/www/Advanced_Wireless_Content.asp $(INSTALLDIR)/www/Advanced_WAdvanced_Content.asp
+	rm -f $(INSTALLDIR)/www/Advanced_SwitchCtrl_Content.asp
+	rm -f $(INSTALLDIR)/www/js/weekSchedule/weekSchedule.js $(INSTALLDIR)/www/js/weekSchedule/weekSchedule.css
+	rm -rf $(INSTALLDIR)/www/images/New_ui/weekSchedule/tutorial_guide
+# reaper 2026-11-17 (review B-21) REAPER-UNSHIP-PAM: the "phone as modem" help - 12 photos and the fragment that
+# shows them. Its doors were the stock Network Map (every request for index.asp is sent to the dashboard before
+# its body runs) and the stock set-up wizard's WAN steps (the wizard is kept for the AiMesh add-node flow only).
+# USB tethering itself is untouched. The stock rule further down removes the photos only without USB WAN backup.
+	rm -rf $(INSTALLDIR)/www/images/phone_as_modem
+	rm -f $(INSTALLDIR)/www/phone_as_modem_instructions.html
 ifeq ($(RTCONFIG_NOIPTV), y)
 	rm -rf $(INSTALLDIR)/www/Advanced_IPTV_Content.asp
 endif
