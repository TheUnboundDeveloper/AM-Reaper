+/* 2026-11-14 (owner): mDNS across networks - which networks avahi serves and which the reflector may join
+ * (rc/services.c generate_mdns_config; avahi's reflect-interfaces is a Reaper patch, avahi-core/server.c).
+ *   deny  every network guest isolation closes (Access Intranet off, or a Guest Portal - its bridge and its chilli
+ *         interface): REAPER_GUI already drops their 5353, and avahi no longer announces the router onto them either
+ *         (review 2026-11-11 Appendix A).
+ *   refl  the bridges the reflector may join: the main LAN and every network with Access Intranet on (its devices are
+ *         main-network devices on another SSID), minus a bridge that carries any network with Set AP Isolated on (the
+ *         Network page switch: apmN_ap_isolate for the Main Network, apgN_ap_isolate for the others; on the main LAN
+ *         also a radio's wlN_ap_isolate) and never a portal. The reflector never sends a packet back onto the network
+ *         it came from, and a left-out network is not joined to any other, so AP isolation holds.
+ *   why   "br54 AP isolated, br55 no intranet access" for the log.
+ * The AiMesh backhaul (MAINBH) is not a client network and is not looked at. Outside routing modes: nothing. */
+static void rm_add(char *buf, size_t n, const char *s)
+{
+	const char *p = buf;
+	size_t l;
+
+	if (!s || !*s)
+		return;
+	l = strlen(s);
+	while ((p = strstr(p, s)) != NULL) {	/* already listed */
+		if ((p == buf || p[-1] == ',') && (p[l] == ',' || p[l] == '\0'))
+			return;
+		p += l;
+	}
+	if (*buf)
+		strlcat(buf, ",", n);
+	strlcat(buf, s, n);
+}
+
+void reaper_mdns_ifaces(char *deny, size_t dn, char *refl, size_t rn, char *why, size_t wn)
+{
+	struct { char br[IFNAMSIZ]; const char *out; } b[MTLAN_MAXINUM + 1];
+	MTLAN_T *pmtl = NULL;
+	CP_TYPE_RL cpt;
+	const char *lan = nvram_safe_get("lan_ifname"), *acc = nvram_safe_get("sdn_access_rl");
+	char key[32], w[IFNAMSIZ + 24];
+	size_t sz = 0, i;
+	int nb, k, u;
+
+	deny[0] = refl[0] = why[0] = '\0';
+	if (!is_routing_enabled() || !*lan)
+		return;
+	memset(b, 0, sizeof(b));
+	strlcpy(b[0].br, lan, sizeof(b[0].br));
+	nb = 1;
+	for (u = 0; u < MAX_NR_WL_IF; u++) {
+		snprintf(key, sizeof(key), "wl%d_ap_isolate", u);
+		if (nvram_get_int(key) == 1)
+			b[0].out = "AP isolated";
+	}
+	if ((pmtl = (MTLAN_T *)INIT_MTLAN(sizeof(MTLAN_T))) != NULL) {
+		if (get_mtlan(pmtl, &sz)) {
+			for (i = 0; i < sz; i++) {
+				const MTLAN_T *m = &pmtl[i];
+				const char *br = m->nw_t.br_ifname[0] ? m->nw_t.br_ifname : lan;
+				int portal = 0, on_lan = !strcmp(br, lan);
+
+				if (m->enable != 1 || !strcmp(m->name, "MAINBH"))
+					continue;
+				for (k = 0; k < nb && strcmp(b[k].br, br); k++)
+					;
+				if (k == nb) {
+					if (nb > MTLAN_MAXINUM)
+						continue;
+					strlcpy(b[nb].br, br, sizeof(b[nb].br));
+					nb++;
+				}
+				if (m->sdn_t.cp_idx > 0) {
+					memset(&cpt, 0, sizeof(cpt));
+					if (get_cp_type_byidx(m->sdn_t.cp_idx, &cpt))
+						portal = (cpt.cp_type == 1 || cpt.cp_type == 2 || cpt.cp_type == 4);
+				}
+				if (!on_lan && (portal || m->sdn_t.sdn_idx == 0 || m->nw_t.idx == 0 ||
+						!rg_access_on(acc, m->sdn_t.sdn_idx))) {
+					/* the networks guest isolation closes (reaper_guest_gen): avahi stays off them */
+					rm_add(deny, dn, br);
+					if (portal && m->nw_t.ifname[0])
+						rm_add(deny, dn, m->nw_t.ifname);
+					b[k].out = portal ? "Guest Portal" : "no intranet access";
+					continue;
+				}
+				if (portal) {
+					b[k].out = "Guest Portal";
+					continue;
+				}
+				if (m->sdn_t.apg_idx > 0) {
+					snprintf(key, sizeof(key), "%s%d_ap_isolate", strcmp(m->name, "MAINFH") ? "apg" : "apm",
+						 m->sdn_t.apg_idx);
+					if (nvram_get_int(key) == 1 && !b[k].out)
+						b[k].out = "AP isolated";
+				}
+			}
+		}
+		FREE_MTLAN((void *)pmtl);
+	}
+	for (k = 0; k < nb; k++) {
+		if (!b[k].out) {
+			rm_add(refl, rn, b[k].br);
+			continue;
+		}
+		snprintf(w, sizeof(w), "%s %s", b[k].br, b[k].out);
+		if (*why)
+			strlcat(why, ", ", wn);
+		strlcat(why, w, wn);
+	}
+}
+
+/* 2026-11-14 (found on the router, _r1): start_nat_rules() replaces the WHOLE nat table (iptables-restore), and the
+ * guests' DNS redirect - REAPER_GUN and its PREROUTING hook - goes with it. start_chilli() and start_CP() call it right
+ * AFTER their own firewall restart (whose tail had just installed the redirect), and wanduck calls it on a WAN change,
+ * so a portal lost the redirect the moment it started: a guest with a hand-set resolver went around the guest DNS.
+ * This runs the nat lines of the last generated script again. Nat only and idempotent, so no firewall lock (it is
+ * also reached from inside start_firewall, which holds it); nothing is regenerated and no flow is touched. */
+void reaper_guest_nat_reassert(void)
+{
+	if (!f_exists(RG_APPLY) || !reaper_script_ok(RG_APPLY))
+		return;
+	eval("sh", "-c", "R() { \"$@\" 2>/dev/null; }; eval \"$(grep REAPER_GUN " RG_APPLY " | grep -v '^#')\"");
+}
+
 /* regenerate and run; have_lock: the caller already holds file_lock("firewall") (the start_firewall tail) */
 void reaper_guest_apply(int have_lock)
 {
diff --git a/release/src/router/rc/services.c b/release/src/router/rc/services.c
index 58e3cfa491..bde28d6a32 100644
--- a/release/src/router/rc/services.c
+++ b/release/src/router/rc/services.c
@@ -9302,15 +9302,51 @@ void stop_lltd(void)
 #endif
 #define TIMEMACHINE_BACKUP_NAME	"Backups.backupdb"
 
+/* reaper 2026-11-14 (owner): mDNS across networks. The Tweaks switch reaper_mdns_reflect (default on; only "0" is
+ * off) turns on avahi's reflector for the bridges reaper_mdns_ifaces (rc/reaper_guest.c) names - the main LAN and the
+ * networks with Access Intranet on, never one with Set AP Isolated on, never a portal - and only when there are two of
+ * them. The networks guest isolation closes are added to deny-interfaces. The plan's signature is kept beside the
+ * config, so a network change (restart_sdn / sdn_del) restarts avahi only when what it would be told changed. */
+#define REAPER_MDNS_SIG	AVAHI_CONFIG_PATH "/reaper_mdns.sig"
+
+static int reaper_mdns_plan(char *deny, size_t dn, char *refl, size_t rn, char *why, size_t wn, char *sig, size_t sn)
+{
+	const char *p;
+	int on, n = 0;
+
+	reaper_mdns_ifaces(deny, dn, refl, rn, why, wn);
+	if (*refl)
+		for (n = 1, p = refl; (p = strchr(p, ',')) != NULL; p++)
+			n++;
+	on = !nvram_match("reaper_mdns_reflect", "0") && n >= 2;
+	snprintf(sig, sn, "%d|%s|%s", on, deny, on ? refl : "");
+	return on;
+}
+
 int generate_mdns_config(void)
 {
 	FILE *fp;
 	char avahi_config[80];
 	int ret = 0;
 	char *wan1_ifname;
+	char rm_deny[256], rm_refl[256], rm_why[384], rm_sig[600], rm_old[600] = "";
+	int rm_on;
 
 	sprintf(avahi_config, "%s/%s", AVAHI_CONFIG_PATH, AVAHI_CONFIG_FN);
 
+	/* reaper 2026-11-14: mDNS across networks - log the plan when it changes */
+	rm_on = reaper_mdns_plan(rm_deny, sizeof(rm_deny), rm_refl, sizeof(rm_refl), rm_why, sizeof(rm_why), rm_sig, sizeof(rm_sig));
+	f_read_string(REAPER_MDNS_SIG, rm_old, sizeof(rm_old));
+	if (strcmp(rm_old, rm_sig)) {
+		if (rm_on)
+			logmessage("mdns", "devices can find each other across %s%s%s", rm_refl, *rm_why ? "; left out: " : "", rm_why);
+		else if (nvram_match("reaper_mdns_reflect", "0"))
+			logmessage("mdns", "mDNS across networks is off");
+		else if (*rm_why)
+			logmessage("mdns", "mDNS across networks: fewer than two networks can take part (left out: %s)", rm_why);
+		f_write_string(REAPER_MDNS_SIG, rm_sig, 0, 0);
+	}
+
 	/* Generate avahi configuration file */
 	if (!(fp = fopen(avahi_config, "w"))) {
 		perror(avahi_config);
@@ -9339,6 +9375,8 @@ int generate_mdns_config(void)
 	if (*wan1_ifname)
 		fprintf(fp, ",%s", wan1_ifname);
 #endif
+	if (*rm_deny)	/* reaper 2026-11-14: the networks guest isolation closes */
+		fprintf(fp, "%s%s", (*nvram_safe_get("wan0_ifname")) ? "," : "", rm_deny);
 	fprintf(fp, "\n");
 	fprintf(fp, "ratelimit-interval-usec=1000000\n");
 	fprintf(fp, "ratelimit-burst=1000\n");
@@ -9352,6 +9390,14 @@ int generate_mdns_config(void)
 	fprintf(fp, "\n[wide-area]\n");
 	fprintf(fp, "enable-wide-area=no\n");	/* reaper: .local only; unicast DNS-SD unused (CVE-2024-52615/52616) */
 
+	/* reaper 2026-11-14: mDNS across networks (reaper_mdns_plan) */
+	if (rm_on) {
+		fprintf(fp, "\n[reflector]\n");
+		fprintf(fp, "enable-reflector=yes\n");
+		fprintf(fp, "reflect-ipv=no\n");
+		fprintf(fp, "reflect-interfaces=%s\n", rm_refl);
+	}
+
 	/* Set [rlimits] configuration */
 	fprintf(fp, "\n[rlimits]\n");
 	fprintf(fp, "rlimit-core=0\n");
@@ -9566,6 +9612,22 @@ int start_mdns(void)
 	return _eval(avahi_daemon_argv, NULL, 0, &pid);
 }
 
+/* reaper 2026-11-14: the network set changed (restart_sdn / sdn_del): restart avahi only when the networks it serves
+ * or reflects between changed. Called from the rc service handler itself, so no notify_rc (review 2026-11-11 C-1). */
+void reaper_mdns_follow(void)
+{
+	char d[256], r[256], w[384], sig[600], old[600] = "";
+
+	if (!pids("avahi-daemon"))
+		return;
+	reaper_mdns_plan(d, sizeof(d), r, sizeof(r), w, sizeof(w), sig, sizeof(sig));
+	f_read_string(REAPER_MDNS_SIG, old, sizeof(old));
+	if (!strcmp(old, sig))
+		return;
+	stop_mdns();
+	start_mdns();
+}
