 void stop_mdns(void)
 {
 	int i;
@@ -13749,9 +13811,10 @@ void start_chilli(void)
 	}else 
 		goto chilli_cleanup;
 
-	/* reaper 2026-11-12 (owner): a Free Wi-Fi portal has no passcode - one stored before is kept in the settings but
-	 * never asked for (chilli then accepts the sign-in page's noauth:noauth, rc writes /tmp/localusers) */
-	cp_au_type = 0;
+	/* reaper 2026-11-14 (owner): the Free Wi-Fi passcode is back (2026-11-12 had forced every portal to terms-only
+	 * here). The network's own sign-in type decides again: 0 = terms only (chilli accepts the page's noauth:noauth
+	 * from /tmp/localusers), 1 = the admin's passcode (chilli_localUser_passcode -> /etc/shadow.chilli). A portal
+	 * saved with a passcode before 2026-11-12 and not saved since asks for it again, unchanged. */
 	if(cp_local_auth){
 		char *pcode = NULL;
 		if(cp_au_type == 0){
@@ -21106,6 +21169,14 @@ check_ddr_done:
 #endif
