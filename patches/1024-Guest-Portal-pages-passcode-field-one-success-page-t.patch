+/* Reaper 2026-11-14 (field report): a network bound to a VPN client that is switched off had no Internet until someone
+   turned the client on by hand - nothing started it. Choosing a client for a network now switches it on with the same
+   save: WireGuard wgcN_enable (rc starts it after the network is applied, rc/wireguard.c reaper_wgc_start_bound),
+   OpenVPN vpn_clientx_eas plus its own start. Taking a binding away never turns a client off. */
+function reaper_vpnc_on_demand(_nvramSet_obj, _vpnc_idx){
+	var idx = parseInt(_vpnc_idx, 10);
+	if(!(idx >= 1 && idx <= 10) || _nvramSet_obj == undefined) return false;
+	var hit = vpnc_profile_list.filter(function(item){ return parseInt(item.vpnc_idx, 10) == idx; })[0];
+	if(hit == undefined || hit.activate == "1" || hit.activate == 1) return false;
+	if(idx <= 5){
+		_nvramSet_obj["wgc" + idx + "_enable"] = "1";
+	}
+	else{
+		var unit = idx - 5;
+		var eas = httpApi.nvramGet(["vpn_clientx_eas"])["vpn_clientx_eas"];
+		eas = (eas == undefined) ? "" : eas.toString();
+		if(("," + eas).indexOf("," + unit + ",") == -1)
+			_nvramSet_obj["vpn_clientx_eas"] = eas + unit + ",";
+		if(_nvramSet_obj.rc_service != undefined && _nvramSet_obj.rc_service.indexOf("start_vpnclient" + unit + ";") == -1)
+			_nvramSet_obj.rc_service += "start_vpnclient" + unit + ";";
+	}
+	return true;
+}
