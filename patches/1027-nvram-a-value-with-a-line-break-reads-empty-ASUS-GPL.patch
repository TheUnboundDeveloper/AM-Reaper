From af0cc236150164eeb85a1e52803154f450bbcf00 Mon Sep 17 00:00:00 2001
From: reaper <theunbounddeveloper@outlook.com>
Date: Wed, 18 Nov 2026 17:05:18 -0500
Subject: [PATCH] nvram: a value with a line break reads empty (ASUS GPL
 102_39448); infosvr bounded

- nvram_safe_get() returns an empty string, with a log line, for a value holding a newline or
  carriage return, apart from the multi-line settings ASUS allows (VPN custom configs, SSH keys, a
  feedback comment) - taken from ASUS GPL 102_39448.
- infosvr writes the fields of its device-info reply with snprintf / strlcpy (ASUS GPL 102_39442).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../wl/impl103/main/src/include/bcmnvram.h    | 44 +++++++++++++++++--
 release/src/router/infosvr/common.c           | 10 ++---
 2 files changed, 46 insertions(+), 8 deletions(-)

diff --git a/release/src-rt-5.04behnd.4916/bcmdrivers/broadcom/net/wl/impl103/main/src/include/bcmnvram.h b/release/src-rt-5.04behnd.4916/bcmdrivers/broadcom/net/wl/impl103/main/src/include/bcmnvram.h
index 2646c0d1cb..1c132d2a37 100644
--- a/release/src-rt-5.04behnd.4916/bcmdrivers/broadcom/net/wl/impl103/main/src/include/bcmnvram.h
+++ b/release/src-rt-5.04behnd.4916/bcmdrivers/broadcom/net/wl/impl103/main/src/include/bcmnvram.h
@@ -126,16 +126,54 @@ extern char * nvram_get_bitflag(const char *name, const int bit);
  */
 extern int BCMINITFN(nvram_resetgpio_init)(void *sih);
 
+#ifndef __KERNEL__
+#include <syslog.h>
+#endif
+
 /*
  * Get the value of an NVRAM variable.
  * @param	name	name of variable to get
- * @return	value of variable or NUL if undefined
+ * @return	value of variable or "" if undefined; returns "" if value
+ *		contains \n or \r to prevent config injection via nvram.
+ *		VPN custom config keys are exempt because they are intentionally
+ *		multi-line OpenVPN configuration blocks.
+ * reaper 2026-11-18 (REAPER-NVRAM-NEWLINE): taken verbatim from ASUS GPL 102_39448 (GT-BE98). Reaper keeps no
+ * multi-line value in nvram outside this list (OpenVPN custom config and keys, Warden / Dreadwatch / Wallguard lists
+ * live in /jffs or are stored space-separated); sshd_authkeys and fb_comment are the two multi-line keys it uses.
  */
 static INLINE char *
 nvram_safe_get(const char *name)
 {
-	char *p = nvram_get(name);
-	return p ? p : "";
+	static const char * const newline_allowed[] = {
+		"vpn_server_custom",
+		"vpn_server1_custom",
+		"vpn_client_custom",
+		"vpn_client1_custom",
+		"vpn_client2_custom",
+		"vpn_client3_custom",
+		"vpn_client4_custom",
+		"vpn_client5_custom",
+		"sshd_authkeys",
+		"fb_comment",
+		NULL
+	};
+	char *val = nvram_get(name);
+	if (!val)
+		return (char *)"";
+	if (strchr(val, '\n') || strchr(val, '\r')) {
+		const char * const *p;
+		for (p = newline_allowed; *p; p++) {
+			if (!strcmp(name, *p))
+				return val;
+		}
+#ifdef __KERNEL__
+		pr_warn_ratelimited("nvram_safe_get: blocked newline in key %s\n", name);
+#else
+		syslog(LOG_WARNING, "nvram_safe_get: blocked newline in key %s", name);
+#endif
+		return (char *)"";
+	}
+	return val;
 }
 
 /*
diff --git a/release/src/router/infosvr/common.c b/release/src/router/infosvr/common.c
index bb938d8c57..a6c0c11c6c 100644
--- a/release/src/router/infosvr/common.c
+++ b/release/src/router/infosvr/common.c
@@ -271,15 +271,15 @@ char *processPacket(int sockfd, char *pdubuf, unsigned short cli_port, char *cli
 			if (strlen(nvram_safe_get("u2ec_mfg")) && strlen(nvram_safe_get("u2ec_device")))
 			{
 				if (strstr(nvram_safe_get("u2ec_device"), nvram_safe_get("u2ec_mfg")))
-					sprintf(ginfo->PrinterInfo, "%s", nvram_safe_get("u2ec_device"));
+					snprintf(ginfo->PrinterInfo, sizeof(ginfo->PrinterInfo), "%s", nvram_safe_get("u2ec_device"));
 				else
-					sprintf(ginfo->PrinterInfo, "%s %s", nvram_safe_get("u2ec_mfg"), nvram_safe_get("u2ec_device"));
+					snprintf(ginfo->PrinterInfo, sizeof(ginfo->PrinterInfo), "%s %s", nvram_safe_get("u2ec_mfg"), nvram_safe_get("u2ec_device"));
 			}
 #endif
 		     get_discovery_ssid(ssid_g, sizeof(ssid_g));
-		     strcpy(ginfo->NetMask, get_lan_netmask());
-		     strcpy(ginfo->ProductID, productid_g);	// disable for tmp
-		     strcpy(ginfo->FirmwareVersion, firmver_g);	// disable for tmp
+		     strlcpy(ginfo->NetMask, get_lan_netmask(), sizeof(ginfo->NetMask));
+		     strlcpy(ginfo->ProductID, productid_g, sizeof(ginfo->ProductID));	// disable for tmp
+		     strlcpy(ginfo->FirmwareVersion, firmver_g, sizeof(ginfo->FirmwareVersion));	// disable for tmp
 		     memcpy(ginfo->MacAddress, mac, 6);
 		     ginfo->sw_mode = get_sw_mode();
 #ifdef WCLIENT
