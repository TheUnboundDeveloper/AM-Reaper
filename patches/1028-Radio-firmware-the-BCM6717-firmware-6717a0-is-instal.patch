From 4d571b8fe9979ba0d64efd64726145b189465791 Mon Sep 17 00:00:00 2001
From: reaper <theunbounddeveloper@outlook.com>
Date: Wed, 18 Nov 2026 17:05:19 -0500
Subject: [PATCH] Radio firmware: the BCM6717 firmware 6717a0 is installed only
 for models with that chip

- GT-BE98, GT-BE98 Pro, GT-BE19000, BQ16 and BQ16 Pro: every board file names BCM6726 radios only,
  so the BCM6717 firmware (6717a0, about 4 MB) is not installed for them. The RT-BE96U keeps both:
  its early units carry three BCM6717 radios.
- The RT-BE96U's 6717a0 file is ASUS's from stock firmware 3006.102.39435.
- A model's own prebuilt wireless event pair is used when the tree has one.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../main/components/apps/cevent_app/Makefile  |   7 +++++--
 .../dongle/sysdeps/RT-BE96U/6717a0/rtecdc.bin | Bin 4075544 -> 4079846 bytes
 release/src-rt/Makefile                       |  11 ++++++++++-
 3 files changed, 15 insertions(+), 3 deletions(-)

diff --git a/release/src-rt-5.04behnd.4916/bcmdrivers/broadcom/net/wl/impl103/main/components/apps/cevent_app/Makefile b/release/src-rt-5.04behnd.4916/bcmdrivers/broadcom/net/wl/impl103/main/components/apps/cevent_app/Makefile
index 5763569a85..ffe3ab094a 100644
--- a/release/src-rt-5.04behnd.4916/bcmdrivers/broadcom/net/wl/impl103/main/components/apps/cevent_app/Makefile
+++ b/release/src-rt-5.04behnd.4916/bcmdrivers/broadcom/net/wl/impl103/main/components/apps/cevent_app/Makefile
@@ -1,6 +1,9 @@
+# reaper 2026-11-18: a model whose GPL drop carries a newer ceventc / ceventd than the shared pair keeps its own
+# in prebuilt/$(BUILD_NAME)/ (the alpha overlays carry only per-model folders); otherwise the shared pair.
+CEV_PRE := $(if $(wildcard prebuilt/$(BUILD_NAME)/ceventd),prebuilt/$(BUILD_NAME),prebuilt)
 all:
-	cp -f prebuilt/ceventc ceventc
-	cp -f prebuilt/ceventd ceventd
+	cp -f $(CEV_PRE)/ceventc ceventc
+	cp -f $(CEV_PRE)/ceventd ceventd
 	cp -f prebuilt/libceshared.so libceshared.so
 
 install: all
diff --git a/release/src-rt-5.04behnd.4916/bcmdrivers/broadcom/net/wl/impl103/sys/src/dongle/sysdeps/RT-BE96U/6717a0/rtecdc.bin b/release/src-rt-5.04behnd.4916/bcmdrivers/broadcom/net/wl/impl103/sys/src/dongle/sysdeps/RT-BE96U/6717a0/rtecdc.bin
index 03099a09d4cd590873e8d8d7d070c9d07e089b61..d75aa3fe055ded5c142ddb1f14cd1e43965c692e 100755
