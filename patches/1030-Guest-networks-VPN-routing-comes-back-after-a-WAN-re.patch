 }
 
+/* REAPER-V6SPLIT-BEGIN */
+/* reaper 2026-11-19 (IPv6 prefix split): a provider prefix of /57 to /63 gives each network its own /64. The network's
+ * subnet index goes into bits plen..63, so the main LAN (index 0) keeps the first /64 and is never renumbered.
+ * mtlan_extend_prefix_by_subnet_idx() above is unchanged: it splits on whole bytes only, which is right for /56 and
+ * larger and gave a /72 (no SLAAC) between /57 and /63, so those prefixes were only used with ipv6_prefix_div. */
+
+/* 1 when a /57-/63 prefix has a /64 for subnet index idx (idx < 2^(64-plen)) */
+int mtlan_prefix_subnet64_fits(int prefix_length, int subnet_idx)
+{
+	return prefix_length >= 57 && prefix_length <= 63 && subnet_idx >= 0 && subnet_idx < (1 << (64 - prefix_length));
+}
+
+/* the /64 of subnet index idx in a /57-/63 prefix: returns 64, or 0 (buf untouched) when it does not fit or parse */
+int mtlan_prefix_subnet64(const char *prefix, int prefix_length, int subnet_idx, char *buf, size_t len)
+{
+	uint8_t addr[16];
+	char out[INET6_ADDRSTRLEN];
+	int bits, i;
+
+	if (!prefix || !buf || !mtlan_prefix_subnet64_fits(prefix_length, subnet_idx))
+		return 0;
+	if (inet_pton(AF_INET6, prefix, addr) != 1)
+		return 0;
+	bits = 64 - prefix_length;	/* 1 to 7: all inside byte 7 */
+	addr[7] = (uint8_t)((addr[7] & (0xff << bits)) | subnet_idx);
+	for (i = 8; i < 16; i++)
+		addr[i] = 0;
+	if (!inet_ntop(AF_INET6, addr, out, sizeof(out)) || strlen(out) >= len)
+		return 0;
+	memcpy(buf, out, strlen(out) + 1);
+	return 64;
+}
+
+/* Does a network get a split of the provider prefix? /56 and larger: the whole-byte split as before. /57-/63: its own
+ * /64 only while its index fits - never the old split, even with ipv6_prefix_div (REAPER-V6SPLIT-STRICT: that gave a
+ * /72 inside the main LAN's /64). /64 and longer: the old split only when ipv6_prefix_div asks (as before).
+ * 0 = no: the caller keeps its private (ULA) fallback. */
+int mtlan_prefix_split_ok(int prefix_length, int subnet_idx, int prefix_div)
+{
+	if (prefix_length >= 57 && prefix_length <= 63)
+		return mtlan_prefix_subnet64_fits(prefix_length, subnet_idx);
+	return prefix_length <= 56 || prefix_div;
+}
+
+/* the network's prefix under that order (call it after mtlan_prefix_split_ok() said yes); returns its length or 0 */
+int mtlan_prefix_by_subnet(const char *prefix, int prefix_length, int subnet_idx, char *buf, size_t len)
+{
+	if (prefix_length >= 57 && prefix_length <= 63)
+		return mtlan_prefix_subnet64(prefix, prefix_length, subnet_idx, buf, len);	/* 0 when it does not fit */
+	if (subnet_idx < 0 || subnet_idx > 255)
+		return 0;
+	return mtlan_extend_prefix_by_subnet_idx(prefix, prefix_length, (uint8_t)subnet_idx, 8, buf, len);
+}
+/* REAPER-V6SPLIT-LANCLASH: 1 when two IPv6 addresses / prefixes share their first 64 bits (both must parse) */
+int mtlan_prefix_same64(const char *a, const char *b)
+{
+	uint8_t x[16], y[16];
+
+	if (!a || !b || inet_pton(AF_INET6, a, x) != 1 || inet_pton(AF_INET6, b, y) != 1)
+		return 0;
+	return !memcmp(x, y, 8);
+}
+
