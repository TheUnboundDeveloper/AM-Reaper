diff --git a/release/src/router/shared/mtlan_utils.c b/release/src/router/shared/mtlan_utils.c
index b151d81d99..ee60acaf19 100644
--- a/release/src/router/shared/mtlan_utils.c
+++ b/release/src/router/shared/mtlan_utils.c
