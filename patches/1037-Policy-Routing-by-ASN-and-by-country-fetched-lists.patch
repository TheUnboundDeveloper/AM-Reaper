+  for(i=0;i<ROWS.length;i++) if((ROWS[i].seltype==='ipset'||ROWS[i].seltype==='domain')&&ROWS[i].selval===r[0]) used=true;
+  if(used && !confirm(`<#RVR_52#>`)) return;
+  if(EDIT_OBJ>k) EDIT_OBJ--;
+  flShift(k);
+  OBJ.splice(k,1); renderObjects(); flStore(kind);
+}
+function flLoad(){
+  pbrcgi('action=lists',function(j){
+    if(j&&j.ok){
+      var m={}, o={}, i, ks=j.keys||[], os=j.objs||[];
+      for(i=0;i<ks.length;i++) m[ks[i].k]=ks[i];
+      for(i=0;i<os.length;i++) o[os[i].n]=os[i];
+      LST={keys:m,objs:o,running:j.running?1:0,script:j.script?1:0,t:j.t||0};
+    }
+    /* REAPER-FW-LISTS-BUSY: the Update now press ends when the router's status is newer and nothing runs */
+    if(flBusy && j && j.ok && !LST.running && LST.t!==flBusyT){ var fb=flBusy; flBusy=null; fb(true); }
+    flRender();
+    clearTimeout(flTimer); flTimer=setTimeout(flLoad, LST.running?3000:30000);
+  });
+}
+function flUpdate(kind){
+  var bf=ReaperBusy.startLast({maxMs:180000});   /* REAPER-FW-LISTS-BUSY: busy until this run has finished */
+  pbrcgi('action=lists_update',function(j){
+    if(j&&j.ok){ flMsg(kind,true,`<#RVR_109#>`); flBusy=bf; flBusyT=LST.t; LST.running=1; flRender(); clearTimeout(flTimer); flTimer=setTimeout(flLoad,2000); }
+    else { flMsg(kind,false,(j&&j.error==='E_NOLISTS')?`<#RVR_110#>`:`<#RVR_113#>`); bf(false); }
+  });
+}
