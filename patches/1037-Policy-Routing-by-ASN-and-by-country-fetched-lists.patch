+/* REAPER-FW-LISTS H-BEGIN */
+/* Policy Routing was switched off: no rule names a fetched list any more, so the daily job, the sets this
+ * engine filled and the saved lists go (rc/reaper_pbr.c stop_reaper_pbr). */
+void reaper_fw_lists_sync(void)
+{
+	rfw_cfg_t c;
+
+	if (!rfw_cfg_load(&c, nvram_match("reaper_fw_enable", "1") ? 1 : 0)) return;
+	rfw_gen_lists(&c);
+	rfw_cfg_free(&c);
+}
+
+/* The page's "Update now" (service start_reaper_fw_lists): fetch every list in use, in the background. The
+ * script takes its own lock, so a second request while one runs does nothing. */
+void reaper_fw_lists_update(void)
+{
+	if (access(RFW_LISTS, F_OK) != 0) return;
+	(void)(reaper_script_ok(RFW_LISTS) && system("sh " RFW_LISTS " update >/dev/null 2>&1 &"));
+}
