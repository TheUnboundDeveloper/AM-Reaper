+    good=a.filter(function(x){ return x.n; });
+    if(bad.length){ no(`<#RVR_89#>`+' '+bad.slice(0,8).join(', '),'_val'); return; }
+    if(!good.length){ no(`<#RVR_88#>`,'_val'); return; }
+    if(good.length>16){ no(`<#RVR_90#>`,'_val'); return; }
+    v=good.map(function(x){ return 'AS'+x.n; }).join(',');
