+function flShift(k){ ['asn','geo'].forEach(function(q){ if(EDIT_FL[q]===k) flEditCancel(q); else if(EDIT_FL[q]>k) EDIT_FL[q]--; }); }
+function flEdit(kind,k){
+  var r=OBJ[k]; if(!r) return;
+  EDIT_FL[kind]=k;
+  document.getElementById(kind+'_name').value=r[0]||''; document.getElementById(kind+'_cmt').value=r[3]||'';
