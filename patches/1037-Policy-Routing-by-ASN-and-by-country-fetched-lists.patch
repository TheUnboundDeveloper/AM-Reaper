+		if (strcmp(en, "1") != 0) continue;
+		if (strcmp(seltype, "ipset") != 0 && strcmp(seltype, "domain") != 0) continue;
+		if (!strcmp(selval, name)) { hit = 1; break; }
+		if (!(grp = strdup(reaper_fw_list_get("grp")))) continue;
+		gp = grp;
+		while (!hit && (g = strsep(&gp, "<")) != NULL) {
