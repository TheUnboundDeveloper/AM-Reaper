diff --git a/release/src/router/rc/reaper_legacy_blobs_shim.c b/release/src/router/rc/reaper_legacy_blobs_shim.c
new file mode 100644
index 0000000000..d13025c692
--- /dev/null
+++ b/release/src/router/rc/reaper_legacy_blobs_shim.c
@@ -0,0 +1,62 @@
+/* SPDX-License-Identifier: GPL-2.0-only
+ *
+ * Reaper compatibility layer, rc side. Built only with RTCONFIG_REAPER_LEGACY_BLOBS, which the
+ * target.mak blocks of GT-BE98, GT-BE19000, BQ16 and BQ16 Pro set: their closed rc and shared objects
+ * come from an older ASUS GPL drop (102_39274 for the two GT models, 102_39256 for the two BQ16s)
+ * than the open source in this tree. The open source calls a handful of functions that only the
+ * newer closed objects carry; each one is provided here with the behaviour these models' own
+ * firmware had, where the call did not exist yet.
+ *
+ * Every definition is weak: when a later GPL drop brings the real function, it wins at link time
+ * and this file needs no change before the token is dropped.
+ */
+
+#include <stdio.h>
+#include <string.h>
+#include "rc.h"
+
+#ifndef WIFI7
+#define WIFI7	(1 << 2)	/* shared/shared.h: the wifi generation bits */
+#endif
+
+/* rc applet "wl_scb" (rc.c): a station-table diagnostic. These models' firmware has no such
+ * applet; it reports nothing here, exactly as before. */
+void __attribute__((weak)) wl_scb(void)
+{
+}
+
+/* AiMesh onboarding timeout (watchdog.c): backs up the onboarding log right before the reset to
+ * defaults. Without it only that diagnostic copy is skipped; the reset path is unchanged. */
+int __attribute__((weak)) backup_eth_ob_log(void)
+{
+	return 0;
+}
+
+/* MULTISERVICE_WAN STB auto-bridge gate (interface.c). None of the four builds MULTISERVICE_WAN;
+ * 0 selects the generic path, which is what their firmware's open code did. */
+int __attribute__((weak)) is_wan_port_ext_switch(int base_unit)
+{
+	(void)base_unit;
+	return 0;
+}
+
+#if defined(RTCONFIG_AMAS)
+/* AiMesh misc info (init.c): the Wi-Fi generation this router reports to its nodes. All four
+ * models are Wi-Fi 7 routers, the same answer the newer firmware gives. */
+unsigned int __attribute__((weak)) get_wifi_gen(void)
+{
+	return WIFI7;
+}
+#endif
+
+/* Guest/SDN WDS (lan.c, RTCONFIG_MULTILAN_CFG): tells a raw WDS interface apart from a tagged
+ * vconfig sub-interface. The raw one is named wds<unit>.<subunit>.<index> - three numbers; a
+ * tagged sub-interface carries a fourth (the VLAN id) or more. */
+int __attribute__((weak)) apg_is_wds_raw_if(char *interface)
+{
+	int a, b, c, d, e;
+
+	if (!interface || !*interface || strncmp(interface, "wds", 3))
+		return 0;
+	return sscanf(interface, "wds%d.%d.%d.%d.%d", &a, &b, &c, &d, &e) == 3;
+}
