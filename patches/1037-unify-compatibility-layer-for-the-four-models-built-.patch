 ...PAK_License-1077.Asus_RT-BE86U_88U_96U.bin | Bin 0 -> 1076 bytes
 ...1079.Asus_GT-BE19000BE96_BE98_BE98_PRO.bin | Bin 0 -> 1076 bytes
 ...om-PAK_License-1080.Asus_BQ16_BQ16_PRO.bin | Bin 0 -> 1076 bytes
 release/src-rt/Makefile                       |   4 +
 release/src-rt/target.mak                     | 150 ++++++++++++++++++
 release/src/router/config/config.in           |   4 +
 release/src/router/httpd/Makefile             |   6 +
 .../router/httpd/reaper_legacy_blobs_httpd.c  |  30 ++++
 release/src/router/httpd/web.c                |   4 +
 release/src/router/rc/Makefile                |  11 +-
 release/src/router/rc/init.c                  |   7 +
 .../src/router/rc/reaper_legacy_blobs_shim.c  |  62 ++++++++
 release/src/router/rc/sysdeps/init-broadcom.c |  11 +-
 release/src/router/rc/usb.c                   |  17 ++
 15 files changed, 307 insertions(+), 6 deletions(-)
 create mode 100644 release/src-rt-5.04behnd.4916/targets/pakl/legacy-39256/Broadcom-PAK_License-1077.Asus_RT-BE86U_88U_96U.bin
 create mode 100644 release/src-rt-5.04behnd.4916/targets/pakl/legacy-39256/Broadcom-PAK_License-1079.Asus_GT-BE19000BE96_BE98_BE98_PRO.bin
 create mode 100644 release/src-rt-5.04behnd.4916/targets/pakl/legacy-39256/Broadcom-PAK_License-1080.Asus_BQ16_BQ16_PRO.bin
 create mode 100644 release/src/router/httpd/reaper_legacy_blobs_httpd.c
 create mode 100644 release/src/router/rc/reaper_legacy_blobs_shim.c

diff --git a/release/src-rt-5.04behnd.4916/targets/buildFS b/release/src-rt-5.04behnd.4916/targets/buildFS
index f5700bad07..550e49cf1b 100755
--- a/release/src-rt-5.04behnd.4916/targets/buildFS
+++ b/release/src-rt-5.04behnd.4916/targets/buildFS
@@ -668,6 +668,13 @@ fi
 if [ "$BCM_CHIP" == "6813" ]; then
 	mkdir -p $TARGETS_DIR/$ROOTFS/rom/etc/licenses
 	cp $TARGETS_DIR/pakl/*BQ16*.bin $TARGETS_DIR/$ROOTFS/rom/etc/licenses
+	# reaper: BQ16 and BQ16 Pro run their 102_39256 closed objects and keep the licence set of their
+	# own stock firmware (1077, 1079, 1080, 1119, 1212). The three older files sit in a sub-directory
+	# so the *BQ16* glob above cannot pick 1080 up for every other 6813 model.
+	if [ "$BUILD_NAME" = "BQ16" ] || [ "$BUILD_NAME" = "BQ16_PRO" ]; then
+		cp $TARGETS_DIR/pakl/legacy-39256/*.bin $TARGETS_DIR/$ROOTFS/rom/etc/licenses
+		rm -f $TARGETS_DIR/$ROOTFS/rom/etc/licenses/*1296*.bin
+	fi
 fi
 
 if [ "$BCM_CHIP" == "6765" ]; then
