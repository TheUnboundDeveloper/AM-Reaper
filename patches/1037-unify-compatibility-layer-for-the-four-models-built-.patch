+/* SPDX-License-Identifier: GPL-2.0-only
+ *
+ * Reaper compatibility layer, httpd side. Built only with RTCONFIG_REAPER_LEGACY_BLOBS (GT-BE98,
+ * GT-BE19000, BQ16, BQ16 Pro), whose closed httpd objects come from an older ASUS GPL drop than the
+ * open source in this tree. Weak, so a later drop that brings the real functions wins at link time.
+ */
+
+#include <stdio.h>
+#include <string.h>
+#include <shutils.h>
+#include "httpd.h"
+
+/* Apply loop (web.c): a setting that may only be changed from the LAN. telnetd_enable is refused
+ * when the session did not log in from the LAN (cur_login_ip_type 0 = LAN, 1 = WAN, -1 = unknown),
+ * the same rule the newer firmware applies. Every other name passes. */
+int __attribute__((weak)) check_apply_nvram_lan_only(const char *name)
+{
+	if (name && !strcmp(name, "telnetd_enable") && cur_login_ip_type != 0) {
+		dbg("[httpd] %s: reject non-LAN (ip_type=%d)\n", name, cur_login_ip_type);
+		return 0;
+	}
+	return 1;
+}
+
+/* ASP function hw_accel_status: no page in this firmware calls it; it writes nothing. */
+int __attribute__((weak)) ej_hw_accel_status(int eid, webs_t wp, int argc, char_t **argv)
+{
+	(void)eid; (void)wp; (void)argc; (void)argv;
+	return 0;
+}
