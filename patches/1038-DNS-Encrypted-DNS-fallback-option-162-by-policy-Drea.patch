diff --git a/release/src/router/rc/encdns.c b/release/src/router/rc/encdns.c
index 42d81614a0..13dc42869a 100644
--- a/release/src/router/rc/encdns.c
+++ b/release/src/router/rc/encdns.c
@@ -214,6 +214,68 @@ static int dnsf_router_ok(int mode)
 }
 #endif
 
+/* REAPER-DNR-STEP (2026-11-22): DNS Director's per-device rules and network modes, read in ONE place for both
+   users - rednsd's policy (red_policy: allow-mac / deny-mac / deny-net) and the DHCP option 162 offer
+   (rednsd_dnr_option) - so a device is told about the router's encrypted DNS exactly when rednsd serves it.
+   An iPhone takes the offer by itself; offered and then refused, it has no DNS at all. */
+static int red_mac_shape(const char *s)
+{
+	int i;
+
+	for (i = 0; i < 17; i++)
+		if (i % 3 == 2 ? s[i] != ':' : !isxdigit((unsigned char)s[i]))
+			return 0;
+	return 1;
+}
+
+/* cb(normalised MAC, 1 = rednsd serves it, arg) for every per-device rule; returns the number of rules */
+static int red_dd_each(void (*cb)(const char *mac, int ok, void *arg), void *arg)
+{
+	int n = 0;
+#ifdef RTCONFIG_DNSFILTER
+	char *nv, *nvp, *rule, *name, *mac, *mode, macbuf[18];
+	unsigned char ea[ETHER_ADDR_LEN];
+
+	if (!nvram_get_int("dnsfilter_enable_x"))
+		return 0;
+#ifdef HND_ROUTER
+	nv = nvp = malloc(255 * 6 + 1);
+	if (nv) nvram_split_get("dnsfilter_rulelist", nv, 255 * 6 + 1, 5);
+#else
+	nv = nvp = strdup(nvram_safe_get("dnsfilter_rulelist"));
+#endif
+	while (nv && (rule = strsep(&nvp, "<")) != NULL) {
+		/* the 17-character shape first: ether_atoe() takes "zz:zz" as all zeros; then the normalised address,
+		   because DNS Director's text may hold anything after the sixth group */
+		if (vstrsep(rule, ">", &name, &mac, &mode) != 3 || !*mode || !red_mac_shape(mac) || !ether_atoe(mac, ea))
+			continue;
+		cb(ether_etoa(ea, macbuf), dnsf_router_ok(safe_atoi(mode)), arg);
+		n++;
+	}
+	free(nv);
+#else
+	(void)cb; (void)arg;
+#endif
+	return n;
+}
+
+/* DNS Director sends a whole network to another server: mode = the global mode for the main network, a
+   guest/VLAN network's own row otherwise */
+static int red_dd_refused(int mode)
+{
+#ifdef RTCONFIG_DNSFILTER
+	return nvram_get_int("dnsfilter_enable_x") && !dnsf_router_ok(mode);
+#else
+	(void)mode;
+	return 0;
+#endif
+}
+
+static void red_policy_cb(const char *mac, int ok, void *arg)
+{
+	rb_add((struct rb *)arg, "%s %s\n", ok ? "allow-mac" : "deny-mac", mac);
+}
+
 /* peers + DNS Director policy: a change here is a SIGHUP */
 static void red_policy(struct rb *r)
 {
@@ -259,31 +321,14 @@ static void red_policy(struct rb *r)
 	/* DNS Director: a device it sends to another server must not get the router's
 	   unfiltered answers over DoT. rednsd closes it before TLS, so Android's automatic
 	   mode falls back to port 53, where DNS Director applies. */
-	if (nvram_get_int("dnsfilter_enable_x")) {
-		char *nv, *nvp, *rule, *name, *mac, *mode, macbuf[18];
-		unsigned char ea[ETHER_ADDR_LEN];
-
