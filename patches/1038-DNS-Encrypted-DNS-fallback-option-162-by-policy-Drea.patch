+
+/* Called about once a second (hc_nap). The per-second part only keeps an active fallback in place; a check runs
+ * every UT_EVERY seconds. */
+static void uptls_tick(struct uptls *u)
+{
+	long t = now_s();
+	int on, strict, prev, r;
+
+	if (u->swapped) {
+		on = ut_gate(&strict);
+		if (!on || strict) {	/* Strict never keeps plain servers, not even for a second after the change */
+			ut_end(u, on, t);
+			u->strict = strict;
+			ut_publish(u);
+			return;
+		}
+		if (t - u->fixed >= UT_REASSERT && ut_file_has_fwd()) {
+			update_resolvconf_plain();	/* wan_up(), a VPN client or a DNS apply put the forwarder back: quietly again */
+			u->fixed = t;
+		}
+	}
+	if (t < u->next)
+		return;
+	u->next = t + UT_EVERY;
+
+	on = ut_gate(&strict);
+	if (!on || u->m.st == UT_OFF || strict != u->strict) {
+		if (on || u->m.st != UT_OFF)
+			ut_end(u, on, t);	/* switched on, off, or the profile changed: the first check waits UT_FIRST */
+		u->strict = strict;
+		ut_publish(u);
+		return;
+	}
+
+	prev = u->m.st;
+	r = ut_observe(u, strict, t);
+	ut_step(&u->m, r, strict, UT_FAIL_AFTER, UT_RECOVER_AFTER);
+	if (u->m.st != prev) {
+		long dur = t - u->since;
+		if (u->m.st == UT_FB && !u->swapped)
+			ut_swap(u, t);
+		else if (u->m.st != UT_FB && u->swapped)
+			ut_unswap(u);
+		if (ut_failed(u->m.st) || ut_failed(prev))
+			ut_log_change(prev, &u->m, dur);	/* after the swap: the line counts the servers dnsmasq now has */
+		if (prev == UT_PLAIN && u->m.st == UT_OK)
+			ut_restart_fwd();
+		u->since = t;
+	} else if (u->m.st == UT_FB && u->swapped) {
+		char v[32];
+		snprintf(v, sizeof(v), "fb %s", ut_why(u->m.why));
+		f_write_string(UT_STATE, v, 0, 0);	/* the reason may have changed */
+	}
+	ut_publish(u);
+}
+
+/* A fallback a previous instance left in place (restart_rdnshc, or it died) is ours to undo */
+static void uptls_adopt(struct uptls *u)
+{
+	char prev[32] = "";
+	long t = now_s();
+
+	memset(u, 0, sizeof(*u));
+	ut_reset(&u->m, UT_OFF);
+	u->since = t;
+	u->next = t + UT_FIRST;
+	u->strict = -1;
+	if (f_read_string(UT_STATE, prev, sizeof(prev)) > 0 && !strncmp(prev, "fb", 2)) {
+		u->m.st = UT_FB;
+		u->m.why = strstr(prev, "dead") ? UT_R_DEAD : UT_R_FWD;
+		u->m.bad = u->m.kbad = UT_FAIL_AFTER;
+		u->m.kst = UT_FB;
+		u->swapped = 1;
+		u->strict = 0;
+		u->fixed = t - UT_REASSERT;	/* re-asserted on the first second */
+	}
+}
+
+/* sleep(1) secs times, with the fallback's per-second part between */
+static void hc_nap(int secs, struct uptls *u)
+{
+	int i;
+
+	for (i = 0; i < secs && !g_stop; i++) {
+		sleep(1);
+		uptls_tick(u);
+	}
+}
