+	rc = dns_ask(HC_FWD, AF_INET, HC_FWD_PORT, "", UT_FWD_MS, NULL);	/* the root zone: only an upstream answers it */
+	if (!landns_rcode_ok(rc))
+		return UT_R_FWD;
+	if (strict)
