@@ -628,7 +630,7 @@ static int wallguard_config_answer(char *name, unsigned short qtype)
 
   if ((lookup_domain(name, fl, &first, &last) &&
        (daemon->serverarray[first]->flags & SERV_LITERAL_ADDRESS)) ||
-      reaper_nx_listed(name))	/* reaper 2026-10-24: the mapped threat table (reaper_nx.c) */
+      (reaper_nx_listed(name) && !reaper_nx_exempt(client, now)))	/* reaper 2026-10-24: the mapped threat table (reaper_nx.c) */
     return 1;
   /* reaper 2026-11-05: the router's own records for the name - a DNS rewrite (host-record=, cname=),
      /etc/hosts, a device's DHCP name - are the operator's answer as well; a cached upstream answer
@@ -670,7 +672,7 @@ static size_t wallguard_safe_answer(struct dns_header *header, char *limit, size
   for (i = 0; i < ss.naddr; i++)
     if (ss.addr[i].g == want)
       any = 1;
-  if (!any || wallguard_config_answer((char *)name, qtype))
+  if (!any || wallguard_config_answer((char *)name, qtype, client, now))
     return 0;
   setup_reply(header, F_NOERR, EDE_UNSET);
   if (!(p = skip_questions(header, qlen)))
@@ -736,7 +738,7 @@ size_t wallguard_answer(struct dns_header *header, char *limit, size_t qlen,
 	  wallguard_live(client, qtype, name, 'a', NULL);
 	  return 0;
 	}
-      if (av == WGA_BLOCK && !wallguard_config_answer(name, qtype))
+      if (av == WGA_BLOCK && !wallguard_config_answer(name, qtype, client, now))
 	{
 	  mask = wallguard_mask(client, now, mac, &have_mac, NULL);
 	  if ((mask & 1u) && (imp || !sh.t.ok || wallguard_lookup(&sh.t.v, name, &abits) != WALLGUARD_ALLOWED))
@@ -754,7 +756,7 @@ size_t wallguard_answer(struct dns_header *header, char *limit, size_t qlen,
       return 0;
     }
   r = wallguard_lookup_at(&sh.t.v, name, &bits, &listed);
-  if (r == WALLGUARD_LISTED && wallguard_config_answer(name, qtype))
+  if (r == WALLGUARD_LISTED && wallguard_config_answer(name, qtype, client, now))
