+			if (t - seen[i].at < 3600000LL)
+				return;
+			break;
+		}
+	if (i == 16) {
+		i = next;
+		next = (next + 1) % 16;
+	}
+	memset(seen[i].k, 0, sizeof(seen[i].k));
+	memcpy(seen[i].k, b, n);
+	seen[i].fam = fam;
+	seen[i].at = t ? t : 1;
+	inet_ntop(fam, b, txt, sizeof(txt));
+	logmsg(LOG_NOTICE, "rednsd: refused %s - DNS Director sends this device to another DNS server", txt);
+}
