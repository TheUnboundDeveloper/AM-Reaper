+/* ======================================================================
+ * reaper 2026-11-20 REAPER-UPTLS: automatic fallback of the upstream
+ * DNS-over-TLS leg (owner 2026-11-10, Encrypted DNS stage 2; BACKLOG
+ * "fall back to plain upstream by itself (Opportunistic only), restore it,
+ * and show that state in red").
+ *
+ * With DNS-over-TLS on for the router (the same test rc/wan.c uses for its
+ * own lookups: the switch, router mode, a usable server row) dnsmasq's only
+ * upstream is the forwarder, stubby on 127.0.1.1. Nothing else falls back
+ * when it is dead or reaches none of its servers: every LAN lookup fails.
+ * Every UT_EVERY seconds this asks the forwarder a question only an upstream
+ * can answer (the root zone) and, with the Opportunistic profile, asks the
+ * servers themselves over DNS-over-TLS (no certificate check, as stubby in
+ * that profile), at least every UT_TLS_EVERY seconds and on every check
+ * while something is wrong. What a check finds:
+ *   the forwarder is not running, or gives no resolving answer
+ *     Opportunistic, after UT_FAIL_AFTER checks in a row: dnsmasq is given the
+ *       plain WAN DNS servers in place of 127.0.1.1 (rc/wan.c
+ *       update_resolvconf_plain, under the resolv lock, dnsmasq reloaded) -
+ *       state "fb"; re-asserted while it lasts, because wan_up(), the VPN
+ *       clients and a DNS apply rewrite the file;
+ *     Strict: never - state "down", a red line on the page, nothing changed;
+ *   the forwarder answers but no server completes an encrypted lookup
+ *     (Opportunistic): the forwarder already asks the same servers in the
+ *     clear by itself (its transport list has UDP and TCP after TLS); nothing
+ *     is moved, so the servers the admin chose keep answering - state
+ *     "plain", a red line on the page;
+ *   every part answers: after UT_RECOVER_AFTER checks in a row the servers-
+ *     file is rebuilt by update_resolvconf() (127.0.1.1 again, reloaded); from
+ *     "plain" the forwarder is restarted, because it backs off DNS-over-TLS
+ *     for tls_backoff_time (900 s) after failed connections.
+ * Not judged (state "held", counters stand): before the clock is set (stubby
+ * runs without TLS until then) and while the uplink is known down. A dead
+ * forwarder counts only after UT_FAIL_AFTER checks, so the watchdog's own
+ * restart of stubby normally lands first. Published as nvram
+ * reaper_uptls_state "<state> <uptime at entry> <reason>" (never committed;
+ * httpd renc_upstream() turns it into the age the Encrypted DNS page shows).
+ * Syslog: one line per change into, between or out of the failed states.
+ * Main LAN only: the per-network stubby instances of guest networks with
+ * DNS-over-TLS (rc/sdn.c) are not watched.
+ * ====================================================================== */
+#define UT_EVERY	30	/* s between checks */
+#define UT_FIRST	20	/* s after start before the first */
+#define UT_TLS_EVERY	120	/* s, the servers asked over DNS-over-TLS directly at least this often */
+#define UT_FWD_MS	4000	/* the forwarder: its own per-query timeout is 3 s (start_stubby) */
+#define UT_TLS_MS	3000	/* each server, asked directly */
+#define UT_TLS_MAX	4	/* servers asked directly per check; the first that answers ends it */
+#define UT_REASSERT	5	/* s, at most one rewrite of the servers-file this often */
+#define UT_STATE	"/tmp/reaper/uptls.state"	/* "fb <reason>" while dnsmasq has the plain servers, so a restart adopts it */
+
+/* UPTLS-PURE-BEGIN (host-tested by test_dnshc_dot.py; no firmware calls in here) */
+#define UT_OFF		0	/* DNS-over-TLS is not in use for the router */
+#define UT_UNK		1	/* not judged yet */
+#define UT_HELD		2	/* clock not set, or the uplink is down: not judged */
+#define UT_OK		3
+#define UT_FB		4	/* Opportunistic: the forwarder does not answer - dnsmasq asks the plain WAN servers */
+#define UT_PLAIN	5	/* Opportunistic: the forwarder answers, but asks its servers in the clear */
+#define UT_DOWN		6	/* Strict: not answering - nothing changed, nothing sent in the clear */
+#define UT_R_OK		0	/* one check: every part answered */
+#define UT_R_HOLD	1	/* not judged */
+#define UT_R_DEAD	2	/* the forwarder is not running */
+#define UT_R_FWD	3	/* it runs, but gives no resolving answer */
+#define UT_R_TLS	4	/* it answers, but no server completes an encrypted lookup (Opportunistic only) */
+#define UT_FAIL_AFTER	3
+#define UT_RECOVER_AFTER 2
