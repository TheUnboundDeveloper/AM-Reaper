+struct ut_sm {
+	int st, why;		/* the state and the observation that put it there (UT_R_*) */
+	int bad, good;		/* consecutive bad / good checks */
+	int kst, kbad;		/* the failed state the last bad check calls for, and how many in a row called for it */
+};
