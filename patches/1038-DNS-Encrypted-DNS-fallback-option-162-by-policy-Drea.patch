+static void refused_note(const sockaddr_u *a)
+{
+	static struct { unsigned char k[16]; int fam; long long at; } seen[16];
+	static int next;
+	char txt[INET6_ADDRSTRLEN] = "?";
+	int fam, n, i;
+	const unsigned char *b = sa_bytes(a, &fam);
+	long long t = now_ms();
