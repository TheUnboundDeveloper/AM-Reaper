+/* The fallback ends without a recovery: DNS-over-TLS switched off, or the profile changed */
+static void ut_end(struct uptls *u, int on, long t)
+{
+	if (ut_failed(u->m.st))
+		logmessage(HC_TAG, "Encrypted DNS: %s - the upstream fallback (%s) ends after %ld s", !on ? "DNS-over-TLS is no longer in use for the router" : "the DNS-over-TLS profile changed", ut_name(u->m.st), t - u->since);
+	if (u->swapped)
+		ut_unswap(u);
+	ut_reset(&u->m, on ? UT_UNK : UT_OFF);
+	u->since = t;
+	u->next = t + (on ? UT_FIRST : UT_EVERY);
+	u->tls_next = 0;
