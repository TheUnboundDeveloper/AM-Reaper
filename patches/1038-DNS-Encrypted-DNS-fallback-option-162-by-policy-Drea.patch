+/* REAPER-DREAD-EXEMPT (2026-11-22, owner): devices that skip Dreadwatch. rc writes their MAC addresses, one a
+   line, into --reaper-nx-exempt (at most NX_EXEMPT_MAX: the admin's list on the Dreadwatch page). The file is
+   looked at again every NX_RECHECK seconds, so an edit needs no restart. An exempt device's lookup of a listed
+   name is forwarded like any other name - and because the judge below runs AFTER the cache, such a lookup must
+   never read the cache, leave its answer there or share another device's query in flight: forward.c makes it
+   not cacheable where the query comes in (reaper_nx_pass). Without that, one exempt lookup would unblock the
+   name for every device. What is kept of it is a count per device ("<hitlog>.pass": "<epoch> <mac>"), never
+   the name. */
+#define NX_EXEMPT_MAX 16
+#define NX_PASS_RATE 20			/* records a second */
+#define NX_PASS_MAX (64 * 1024)		/* bytes, until the collector takes the file away */
+
+static struct {
+  unsigned char mac[NX_EXEMPT_MAX][6];
+  int n, have;
+  time_t checked, mtime;
+  off_t size;
+  ino_t ino;
+} nxe;
+
+/* exactly "xx:xx:xx:xx:xx:xx" and the end of the line */
+static int nxe_parse(const char *s, unsigned char *m)
+{
+  unsigned int v;
+  int i;
+
+  for (i = 0; i < 17; i++)
+    if (i % 3 == 2 ? s[i] != ':' : !isxdigit((unsigned char)s[i]))
+      return 0;
+  if (s[17] && s[17] != '\n' && s[17] != '\r')
+    return 0;
+  for (i = 0; i < 6; i++)
+    {
+      if (sscanf(s + 3 * i, "%2x", &v) != 1)
+	return 0;
+      m[i] = (unsigned char)v;
+    }
+  return 1;
+}
+
+static void nxe_load(time_t now)
+{
+  struct stat st;
+  char line[64];
+  FILE *f;
+
+  if (nxe.checked && now - nxe.checked < NX_RECHECK)
+    return;
+  nxe.checked = now ? now : 1;
+  if (stat(daemon->reaper_nx_exempt, &st) != 0 || !S_ISREG(st.st_mode))
+    {
+      nxe.n = nxe.have = 0;
+      return;
+    }
+  if (nxe.have && st.st_mtime == nxe.mtime && st.st_size == nxe.size && st.st_ino == nxe.ino)
+    return;
+  nxe.n = nxe.have = 0;
+  if (!(f = fopen(daemon->reaper_nx_exempt, "r")))
+    return;
+  while (nxe.n < NX_EXEMPT_MAX && fgets(line, sizeof(line), f))
+    if (nxe_parse(line, nxe.mac[nxe.n]))
+      nxe.n++;
+  fclose(f);
+  nxe.have = 1;
+  nxe.mtime = st.st_mtime;
+  nxe.size = st.st_size;
+  nxe.ino = st.st_ino;
+}
+
+/* the device's MAC when it is on the list; the neighbour table is asked only while somebody is exempt */
+static int nxe_match(union mysockaddr *client, time_t now, unsigned char *mac)
+{
+  int i;
+
+  if (!daemon->reaper_nx_exempt || !client)
+    return 0;
+  nxe_load(now);
+  if (!nxe.n || find_mac(client, mac, 1, now) != 6)
+    return 0;
+  for (i = 0; i < nxe.n; i++)
+    if (!memcmp(nxe.mac[i], mac, 6))
+      return 1;
+  return 0;
+}
+
+/* 1 = the admin lets this device past Dreadwatch (wallguard.c asks too: its own lists still apply to it) */
+int reaper_nx_exempt(union mysockaddr *client, time_t now)
+{
+  unsigned char mac[6];
+
+  return nxe_match(client, now, mac);
+}
+
+/* forward.c, before a query joins another device's query in flight: only when Dreadwatch judges both alike
+   (with an option that makes every query not cacheable, FREC_NO_CACHE alone would not keep them apart) */
+int reaper_nx_merge_ok(union mysockaddr *a, union mysockaddr *b, time_t now)
+{
+  if (!daemon->reaper_nx_exempt)
+    return 1;
+  nxe_load(now);
+  if (!nxe.n)
+    return 1;
+  return reaper_nx_exempt(a, now) == reaper_nx_exempt(b, now);
+}
+
+/* one count record: the date and the device, nothing about what it asked */
+static void nx_pass_rec(const unsigned char *mac)
+{
+  static time_t win;
+  static int used;
+  char path[256], line[48];
+  struct stat st;
+  time_t t = time(NULL);
+  int fd, n;
+
+  if (!daemon->reaper_hitlog)
+    return;
+  if (t != win)
+    {
+      win = t;
+      used = 0;
+    }
+  if (used >= NX_PASS_RATE)
+    return;
+  used++;
+  if (snprintf(path, sizeof(path), "%s.pass", daemon->reaper_hitlog) >= (int)sizeof(path))
+    return;
+  if ((fd = open(path, O_WRONLY | O_APPEND | O_CREAT | O_NOFOLLOW, 0600)) == -1)
+    return;
+  n = snprintf(line, sizeof(line), "%ld %02x:%02x:%02x:%02x:%02x:%02x\n", (long)t, mac[0], mac[1], mac[2], mac[3], mac[4], mac[5]);
+  if (fstat(fd, &st) == 0 && S_ISREG(st.st_mode) && st.st_size < NX_PASS_MAX && n > 0 && (size_t)n < sizeof(line) &&
+      write(fd, line, n) != n)
+    used = NX_PASS_RATE;		/* a full or failing file: no more tries this second */
+  close(fd);
+}
+
+/* forward.c, where a query comes in (UDP and TCP), after add_edns0_config() so that a device behind Encrypted
+   DNS is the device rednsd named: 1 = an exempt device asks for a listed name; the caller then makes the
+   query not cacheable. Costs one comparison while nobody is exempt. */
+int reaper_nx_pass(const char *name, union mysockaddr *client, time_t now)
+{
+  unsigned char mac[6];
+  uint32_t bits = 0;
+  const char *at = NULL;
+
+  if (!daemon->reaper_nx_db || !daemon->reaper_nx_exempt || !client || !name)
+    return 0;
+  nxe_load(now);
+  if (!nxe.n)
+    return 0;
+  nx_map(now);
+  if (!nx_longest(name, &bits, &at) || !nxe_match(client, now, mac))
+    return 0;
+  nx_pass_rec(mac);
+  return 1;
+}
+
 /* forward.c, right after the server-array search: matched = lookup_domain found an entry (first
    is then its index; *flags = what is_local_answer made of it). A listed suffix longer than that
    entry's domain turns the query into the --reaper-nx answer - the longest entry wins, as it did
@@ -100,6 +257,8 @@ int reaper_nx_judge(time_t now, int matched, int first, char *name, unsigned int
     return 0;
   if (!(ml = nx_longest(name, &bits, &at)))
     return 0;
+  if (reaper_nx_exempt(client, now))	/* REAPER-DREAD-EXEMPT: counted where the query came in (reaper_nx_pass) */
+    return 0;
   if (matched && first >= 0 && first < daemon->serverarraysz &&
       (size_t)daemon->serverarray[first]->domain_len >= ml)
     return 0;			/* a config entry of equal or longer domain owns this name */
