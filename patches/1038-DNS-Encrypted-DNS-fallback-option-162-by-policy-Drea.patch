+		logmessage(HC_TAG, "Encrypted DNS: no upstream DNS-over-TLS server completes an encrypted lookup (%d checks) - Opportunistic profile: the forwarder asks them in the clear until one does%s", prev == UT_FB ? m->kbad : bad, prev == UT_FB ? "; dnsmasq asks the forwarder again" : "");
+	else if (st == UT_DOWN)
+		logmessage(HC_TAG, "Encrypted DNS: the upstream DNS-over-TLS forwarder %s (%d checks) - Strict profile: nothing is sent in the clear, so lookups fail until it answers", fwd, bad);
+	else if (prev == UT_FB)
+		logmessage(HC_TAG, "Encrypted DNS: the upstream DNS-over-TLS forwarder answers again (%d checks) after %ld s - dnsmasq asks it again", good, dur);
+	else if (prev == UT_PLAIN)
+		logmessage(HC_TAG, "Encrypted DNS: the upstream servers answer over DNS-over-TLS again (%d checks) after %ld s - the forwarder is restarted so it stops asking in the clear", good, dur);
