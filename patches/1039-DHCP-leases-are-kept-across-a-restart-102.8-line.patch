+/* 2026-11-15: is name the reservation name of mac (dhcp_staticlist "<MAC>IP>DNS>name"), case-insensitive */
+static int reaper_resv_name_is(const char *mac, const char *name)
+{
+	char *b = strdup(nvram_safe_get("dhcp_staticlist")), *rec, *sv = NULL;
+	int hit = 0;
+
+	for (rec = b ? strtok_r(b, "<", &sv) : NULL; rec && !hit; rec = strtok_r(NULL, "<", &sv)) {
+		char *f[4] = { rec, NULL, NULL, NULL }, *p = rec;
+		int k;
+		for (k = 1; k < 4 && (p = strchr(p, '>')) != NULL; k++) {
+			*p++ = 0;
+			f[k] = p;
+		}
+		if (f[3] && *f[3] && !strcasecmp(f[0], mac) && !strcasecmp(f[3], name))
+			hit = 1;
+	}
+	free(b);
+	return hit;
+}
