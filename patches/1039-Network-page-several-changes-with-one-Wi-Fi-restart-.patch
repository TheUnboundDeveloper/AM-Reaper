+/* ---- reaper 2026-11-20 REAPER-SDN-DEFER (plan item 1): Network-page changes waiting for Apply ----
+ * With the Network page's switch on, httpd stores a create / edit / switch-on at once but holds its service list in
+ * RDEFER_MARK ("<uptime> <list>" + a line of network items) until Apply now or the next request that runs
+ * (httpd/web.c REAPER-SDN-DEFER). A held save never reaches RSDN_PENDING, so the settle above never applies it.
+ * If another change restarts the radios meanwhile (the Wireless page, a node, a script, the settle itself), the
+ * radios have built every stored network - including the waiting ones - so rc runs the rest of the waiting list
+ * (each network's DHCP / DNS / firewall service) once rc is idle again; otherwise a new network would be up without
+ * its DHCP server. The marker is cleared only when every waiting change was saved before that radio restart began.
+ * REAPER-SDN-DEFER-KEYS (2026-11-24): and only when httpd holds no settings for the AiMesh nodes - it sends those only
+ * together with a service list, so the marker stays and the page keeps offering Apply now until they have gone. */
+#define RDEFER_MARK	RSDN_DIR "/sdn_defer"
+#define RDEFER_KEYS	RSDN_DIR "/sdn_defer.json"	/* httpd's held settings for the AiMesh sync service (REAPER-SDN-DEFER-KEYS) */
+
+/* RDEFER-RC-PURE-BEGIN (compiled on the host by test_sdn_defer.py) */
+/* is p[0..n) a radio restart (whole service name) */
+static int rdefer_radio_tok(const char *p, size_t n)
+{
+	return (n == 16 && strncmp(p, "restart_wireless", 16) == 0) || (n == 19 && strncmp(p, "restart_net_and_phy", 19) == 0);
+}
+
+/* does a ';' service list restart the radios (and so build every stored network) */
+int reaper_sdn_defer_radio(const char *list)
+{
+	const char *p, *q;
+
+	for (p = list; p && *p; p = *q ? q + 1 : q) {
+		q = p + strcspn(p, ";");
+		if (rdefer_radio_tok(p, (size_t)(q - p)))
+			return 1;
+	}
+	return 0;
+}
+
+/* the waiting list without the radio restart a radio restart already did ("" when nothing is left) */
+static void rdefer_remainder(const char *list, char *out, size_t cap)
+{
+	const char *p, *q;
+	size_t n, o = 0;
+
+	out[0] = 0;
+	for (p = list; p && *p; p = *q ? q + 1 : q) {
+		q = p + strcspn(p, ";");
+		n = (size_t)(q - p);
+		if (!n || rdefer_radio_tok(p, n))
+			continue;
+		if (o + n + 2 > cap)
+			break;
+		memcpy(out + o, p, n);
+		o += n;
+		out[o++] = ';';
+		out[o] = 0;
+	}
+}
+/* RDEFER-RC-PURE-END */
+
+/* rc, at the end of handle_notifications: the list it ran restarted the radios while changes wait -> the settle
+ * applet in its own process (never rc's own queue) runs what is left once rc is idle */
+void reaper_sdn_defer_backstop(const char *list, long t0)
+{
+	char ts[24];
+	char *argv[] = { "/sbin/reaper_sdn_settle", "defer", ts, NULL };
+	pid_t pid;
+
+	if (!reaper_sdn_defer_radio(list) || access(RDEFER_MARK, F_OK) != 0)
+		return;
+	snprintf(ts, sizeof(ts), "%ld", t0);
+	_eval(argv, NULL, 0, &pid);
+}
+
+static int rdefer_backstop_main(long t0)
+{
+	char list[256], rest[256];
+	long t = 0;
+	int i;
+
+	for (i = 0; i < RSDN_SETTLE_MAX && *nvram_safe_get("rc_service"); i++)
+		sleep(1);	/* the radio restart's own list is still finishing */
+	if (!rsdn_read_pending(RDEFER_MARK, &t, list, sizeof(list)))
+		return 0;	/* nothing waits any more (Apply now took it) */
+	rdefer_remainder(list, rest, sizeof(rest));
+	if (t < t0 && access(RDEFER_KEYS, F_OK) != 0)
+		unlink(RDEFER_MARK);	/* every waiting change was stored before this radio restart began */
+	else if (t < t0)	/* REAPER-SDN-DEFER-KEYS: the nodes have not had them yet */
+		logmessage("sdn", "the AiMesh nodes have not received the waiting Network-page changes yet - they wait for Apply on the Network page");
+	if (rest[0]) {
+		logmessage("sdn", "the Wi-Fi was restarted by another change - running the rest of the waiting Network-page changes (%s)", rest);
+		notify_rc_and_wait_2min(rest);
+	}
+	return 0;
+}
+
