+/* REAPER-SDN-DEFER (2026-11-20, owner-approved plan item 1; design 2026-11-16) - the Network page side.
+   Loaded after sdn.js (and mlo.js) by SDN/sdn.html and SDN/mlo.html; these pages get no serve-time injection.
+
+   1. Hold Wi-Fi restarts until Apply (switch reaper_sdn_defer, OFF at factory, kept in backups). Every save of the
+      page goes through httpApi.nvramSet; while the switch is on, a save that carries a service list is marked
+      reaper_defer "1" and httpd decides (httpd/web.c REAPER-SDN-DEFER): a create / edit / switch-on that leaves every
+      enabled network as it is is stored at once and its restart held (reply reaper_deferred "1"); anything else -
+      switch-off, delete, LAN-port change, portal - runs at once and takes the held changes with it. A held save gets
+      no long wait and no reconnect card: the page's own after-save code runs with a one-second wait. The bar lists
+      the waiting networks (new / edited / switched on) and has Apply now (one request, the Wi-Fi restarts once).
+      There is no Discard: the settings are already stored. A reboot applies everything stored.
+   2. Delete selected: tick boxes on the network cards and one button; ONE request through the stock multi-delete
+      form (reaper_sdn_multi_del in sdn.js); it runs at once and takes any held changes with it.
+   All state lives in this closure (window.reaperSdnDefer only marks the file as loaded). The pure helpers are
+   reaperSdnDefer.kinds / .names, run under node by test_sdn_defer.py. */
+(function(){
+	'use strict';
+	if(window.reaperSdnDefer || typeof httpApi != "object" || typeof httpApi.nvramSet != "function" || typeof $ != "function")
+		return;
+	var st = {"on": 0, "wait": 0, "list": "", "items": []};
+	var sel = null;	/* Delete selected: null = not choosing, else {idx: true} */
+	var orig = httpApi.nvramSet;
+	var KIND = {"n": "<#RSDN_40#>", "e": "<#RSDN_41#>", "o": "<#RSDN_42#>"};
+
+	function esc(s){
+		return String(s == undefined ? "" : s).replace(/[&<>"']/g, function(c){
+			return {"&": "&amp;", "<": "&lt;", ">": "&gt;", "\"": "&quot;", "'": "&#39;"}[c];
+		});
+	}
+	/* [[idx, kind], ...] + the page's network list -> [{"idx", "name", "kind"}] (name: SSID, else the type) */
+	function names(items, nets){
+		var out = [];
+		(Array.isArray(items) ? items : []).forEach(function(it){
+			if(!Array.isArray(it) || !/^\d+$/.test(String(it[0])) || !KIND.hasOwnProperty(it[1]))
+				return;
+			var hit = (Array.isArray(nets) ? nets : []).filter(function(n){ return n && n.sdn_rl && String(n.sdn_rl.idx) == String(it[0]); })[0];
+			var nm = hit ? ((hit.apg_rl && hit.apg_rl.ssid) ? hit.apg_rl.ssid : hit.sdn_rl.sdn_name) : ("#" + it[0]);
+			out.push({"idx": String(it[0]), "name": String(nm), "kind": it[1]});
+		});
+		return out;
+	}
+	function kinds(list){
+		return list.map(function(x){ return x.name + " (" + KIND[x.kind] + ")"; }).join(", ");
+	}
+	function nets(){
+		return (typeof sdn_all_rl_json == "object" && Array.isArray(sdn_all_rl_json)) ? sdn_all_rl_json : [];
+	}
+	function page(){
+		return ((typeof PAGE_CONTAINER == "string" && PAGE_CONTAINER == "mlo") ? "MLO" : "SDN") + ".asp";
+	}
+	function wait_time(list){
+		try{ return get_showLoading_status(list || "restart_wireless;").time; }catch(e){ return 20; }
+	}
+
+	function css(){
+		if(document.getElementById("rsdn_defer_css"))
+			return;
+		var s = document.createElement("style");
+		s.id = "rsdn_defer_css";
+		s.textContent = "#rsdn_defer_bar{box-sizing:border-box;margin:0 0 12px;padding:10px 14px;border-radius:6px;" +
+			"border:1px solid rgba(224,169,59,.38);background:rgba(224,169,59,.08);box-shadow:inset 3px 0 0 #E0A93B;font-size:13px}" +
+			"#rsdn_defer_bar .rsd_row{display:flex;align-items:center;gap:10px;flex-wrap:wrap}" +
+			"#rsdn_defer_bar .rsd_t{font-weight:600;flex:1 1 auto;min-width:0}" +
+			"#rsdn_defer_bar .rsd_hint{margin-top:6px;opacity:.8;line-height:1.4}" +
+			"#rsdn_defer_bar .rsd_wait{margin-top:10px;padding-top:10px;border-top:1px solid rgba(224,169,59,.3)}" +
+			"#rsdn_defer_bar .rsd_wait b{color:#E0A93B}" +
+			"#rsdn_defer_bar .rsd_btn{display:inline-block;cursor:pointer;padding:5px 12px;border-radius:6px;" +
+			"border:1px solid rgba(224,169,59,.6);white-space:nowrap;user-select:none}" +
+			"#rsdn_defer_bar .rsd_btn.off{opacity:.45;pointer-events:none}" +
+			".rsdn_wait_tag{border:1px solid #E0A93B !important;color:#E0A93B !important}" +
+			".rsdn_mdel_cb{display:inline-flex;align-items:center;justify-content:center;width:18px;height:18px;margin:0 8px 0 0;" +
+			"border:2px solid #E0A93B;border-radius:4px;cursor:pointer;flex:0 0 auto;font-weight:700;line-height:1}" +
+			".rsdn_mdel_cb.on:after{content:'x'}";
+		(document.head || document.documentElement).appendChild(s);
+	}
+
+	function draw(){
+		var $bar = $("#rsdn_defer_bar");
+		if($bar.length == 0)
+			return;
+		css();
+		var w = names(st.items, nets());
+		var h = "<div class='rsd_row'><span class='rsd_t'><#RSDN_35#></span>" +
+			"<div id='rsdn_defer_sw' class='icon_switch " + (st.on ? "on" : "off") + "' role='switch' aria-checked='" + (st.on ? "true" : "false") + "'></div></div>" +
+			"<div class='rsd_hint'><#RSDN_36#></div>";
+		if(st.wait){
+			h += "<div class='rsd_wait'><div class='rsd_row'><span class='rsd_t'><b><#RSDN_37#>" + (w.length ? ": " + w.length : "") + "</b>" +
+				(w.length ? " &mdash; " + esc(kinds(w)) : "") + "</span>" +
+				"<span class='rsd_btn' id='rsdn_defer_apply'><#RSDN_38#></span></div>" +
+				"<div class='rsd_hint'><#RSDN_39#></div></div>";
+		}
+		var can = nets().some(function(n){ return typeof reaper_mdel_ok == "function" && reaper_mdel_ok(n, (typeof vlan_trunklist_orig == "string") ? vlan_trunklist_orig : ""); });
+		if(can && typeof reaper_sdn_multi_del == "function"){
+			if(sel == null){
+				h += "<div class='rsd_wait'><div class='rsd_row'><span class='rsd_t'></span><span class='rsd_btn' id='rsdn_mdel_start'><#RSDN_47#></span></div></div>";
+			}
+			else{
+				var n = Object.keys(sel).length;
+				h += "<div class='rsd_wait'><div class='rsd_row'><span class='rsd_t'><#RSDN_48#></span>" +
+					"<span class='rsd_btn" + (n ? "" : " off") + "' id='rsdn_mdel_go'><#RSDN_45#>" + (n ? " (" + n + ")" : "") + "</span>" +
+					"<span class='rsd_btn' id='rsdn_mdel_cancel'><#CTL_Cancel#></span></div></div>";
+			}
+		}
+		$bar.html(h).show();
+		$("#rsdn_defer_sw").on("click", toggle);
+		$("#rsdn_defer_apply").on("click", function(){ apply_now(); });
+		$("#rsdn_mdel_start").on("click", function(){ sel = {}; draw(); marks(); });
+		$("#rsdn_mdel_cancel").on("click", function(){ sel = null; draw(); marks(); });
+		$("#rsdn_mdel_go").on("click", confirm_del);
+		if(typeof resize_iframe_height == "function")
+			try{ resize_iframe_height(); }catch(e){}
+	}
+
+	/* the waiting badge on each waiting network's card, and the tick boxes while choosing networks to delete */
+	function marks(){
+		var $list = $("#profile_list_content");
+		$list.find(".rsdn_wait_tag, .rsdn_mdel_cb").remove();
+		if(st.wait){
+			names(st.items, nets()).forEach(function(x){
+				$list.find("[sdn_idx='" + x.idx + "'] .item_tag_container").first()
+					.append($("<div>").addClass("item_tag no_icon rsdn_wait_tag").text("<#RSDN_43#>"));
+			});
+		}
+		if(sel != null){
+			var trunk = (typeof vlan_trunklist_orig == "string") ? vlan_trunklist_orig : "";
+			nets().forEach(function(n){
+				if(!reaper_mdel_ok(n, trunk))
+					return;
+				var idx = String(n.sdn_rl.idx);
+				var $cb = $("<span>").addClass("rsdn_mdel_cb" + (sel[idx] ? " on" : "")).attr({"role": "checkbox", "aria-checked": sel[idx] ? "true" : "false"});
+				$cb.on("click", function(e){
+					e.stopPropagation();
+					e.preventDefault();
+					if(sel[idx]) delete sel[idx]; else sel[idx] = true;
+					draw();
+					marks();
+				});
+				$list.find("[sdn_idx='" + idx + "']").first().prepend($cb);
+			});
+		}
+	}
+
+	function refresh(){
+		try{
+			httpApi.hookGetAsync({"data": "reaper_sdn_defer", "error": function(){}, "success": function(d){
+				if(d && typeof d == "object"){
+					st = {"on": d.on ? 1 : 0, "wait": d.wait ? 1 : 0, "list": String(d.list || ""), "items": Array.isArray(d.items) ? d.items : []};
+					draw();
+					marks();
+				}
+			}});
+		}catch(e){}
+	}
+
+	/* the page's own after-save code, with a one-second wait and no reconnect card (nothing restarted) */
+	function run_held(handler, resp){
+		var sv = {"sl": window.showLoading, "sg": window.showLoading_gaming, "wl": window.isWLclient, "to": window.setTimeout};
+		try{
+			if(typeof sv.sl == "function") window.showLoading = function(){ return sv.sl.call(window, 1); };
+			if(typeof sv.sg == "function") window.showLoading_gaming = function(){ return sv.sg.call(window, 1); };
+			window.isWLclient = function(){ return false; };
+			window.setTimeout = function(fn, ms){
+				var rest = Array.prototype.slice.call(arguments, 2);
+				return sv.to.apply(window, [fn, Math.min(parseInt(ms, 10) || 0, 1000)].concat(rest));
+			};
+			if(typeof handler == "function")
+				handler.call(resp);
+		}
+		finally{
+			window.showLoading = sv.sl;
+			if(typeof sv.sg == "function") window.showLoading_gaming = sv.sg;
+			window.isWLclient = sv.wl;
+			window.setTimeout = sv.to;
+		}
+	}
+
+	httpApi.nvramSet = function(postData, handler, async, postMessageToAppFlag){
+		if(postData && typeof postData == "object" && postData.action_mode == "apply" && st.on &&
+		   typeof postData.rc_service == "string" && postData.rc_service != "")
+			postData.reaper_defer = "1";
+		var h = function(){
+			var resp = this;
+			if(resp && resp.reaper_deferred == "1")
+				run_held(handler, resp);
+			else if(typeof handler == "function")
+				handler.call(resp);
+			if(resp && (resp.reaper_deferred == "1" || resp.reaper_applied == "1" || st.wait))
+				refresh();
+		};
+		return orig.call(httpApi, postData, h, async, postMessageToAppFlag);
+	};
+
+	/* one request: the waiting list (and settings) go now; the radios restart once */
+	function apply_now(extra){
+		var t = wait_time(st.list), o = $.extend({"action_mode": "apply", "reaper_defer_apply": "1"}, extra || {});
+		if(typeof showLoading == "function") showLoading();
+		orig.call(httpApi, o, function(){
+			if(typeof isWLclient == "function" && isWLclient()){
+				if(typeof showWlHintContainer == "function") showWlHintContainer();
+				if(typeof reaperMaskWlHintKey == "function") reaperMaskWlHintKey();
+				if(typeof check_isAlive_and_redirect == "function"){
+					check_isAlive_and_redirect({"page": page(), "time": t});
+					return;
+				}
+			}
+			if(typeof showLoading == "function") showLoading(t);
+			setTimeout(function(){ location.reload(); }, t * 1000);
+		});
+	}
+
+	function toggle(){
+		var on = st.on ? 0 : 1;
+		if(!on && st.wait){	/* switched off with changes waiting: they are applied with the switch */
+			apply_now({"reaper_sdn_defer": "0"});
+			return;
+		}
+		orig.call(httpApi, {"action_mode": "apply", "reaper_sdn_defer": on ? "1" : "0"}, function(){
+			st.on = on;
+			draw();
+		});
+	}
+
+	function confirm_del(){
+		var idxs = Object.keys(sel || {});
+		if(idxs.length == 0)
+			return;
+		var picked = nets().filter(function(n){ return idxs.indexOf(String(n.sdn_rl.idx)) != -1; })
+			.map(function(n){ return (n.apg_rl && n.apg_rl.ssid) ? n.apg_rl.ssid : n.sdn_rl.sdn_name; });
+		$(".container").addClass("blur_effect");
+		$(".popup_element_second").css("display", "flex");
+		var $pop = $(".popup_container.popup_element_second").empty();
+		var $c = Get_Component_Del_Profile().appendTo($pop);
+		$c.find(".del_profile .title").text("<#RSDN_45#>");
+		$c.find(".del_profile .desc").text("<#RSDN_46#>".replace(/#NAMES/g, picked.join(", ")));
+		$c.find("[data-btn=del]").click(function(e){
+			e.stopPropagation();
+			var obj = reaper_sdn_multi_del(idxs);
+			close_popup_container("all");
+			if(obj == null){
+				sel = null;
+				draw();
+				marks();
+				return;
+			}
+			var t = wait_time(obj.rc_service);
+			sel = null;
+			if(typeof showLoading == "function") showLoading();
+			httpApi.nvramSet(obj, function(){
+				if(typeof isWLclient == "function" && isWLclient()){
+					if(typeof showWlHintContainer == "function") showWlHintContainer();
+					if(typeof reaperMaskWlHintKey == "function") reaperMaskWlHintKey();
+					if(typeof check_isAlive_and_redirect == "function"){
+						check_isAlive_and_redirect({"page": page(), "time": t});
+						return;
+					}
+				}
+				if(typeof showLoading == "function") showLoading(t);
+				setTimeout(function(){ location.reload(); }, t * 1000);
+			});
+		});
+	}
+
+	["show_sdn_profilelist", "show_mlo_profilelist"].forEach(function(fn){
+		var f = window[fn];
+		if(typeof f != "function")
+			return;
+		window[fn] = function(){
+			var r = f.apply(this, arguments);
+			try{ marks(); }catch(e){}
+			return r;
+		};
+	});
+
+	window.reaperSdnDefer = {"names": names, "kinds": kinds};
+	$(function(){ refresh(); });
+})();
