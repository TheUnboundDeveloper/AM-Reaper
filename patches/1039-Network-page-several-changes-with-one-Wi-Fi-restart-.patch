 {
 	char list[256];
 	long t0, t = 0;
 	int i, have, step;
 
+	if (argc >= 3 && strcmp(argv[1], "defer") == 0)	/* 2026-11-20: REAPER-SDN-DEFER backstop */
+		return ((t0 = strtol(argv[2], NULL, 10)) > 0) ? rdefer_backstop_main(t0) : 1;
 	if (argc < 2 || (t0 = strtol(argv[1], NULL, 10)) <= 0)
 		return 1;
 	for (i = 1; ; i++) {
