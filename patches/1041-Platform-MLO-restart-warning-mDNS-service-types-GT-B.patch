diff --git a/release/src/router/rc/reaper_mloboot.c b/release/src/router/rc/reaper_mloboot.c
new file mode 100644
index 0000000000..7912d91519
--- /dev/null
+++ b/release/src/router/rc/reaper_mloboot.c
@@ -0,0 +1,158 @@
+/*
+ * reaper 2026-11-20 (REAPER-MLOBOOT, owner: warn only, no automatic reboot): MLO on - a restart without a power-off
+ * can leave Wi-Fi accepting no devices until the router is unplugged (RT-BE96U, seen 2026-07 and 2026-10, 1 of 6
+ * soft restarts on 2026-10-17).
+ *
+ * What is observable: on every power-on with MLO on the kernel log carries the Wi-Fi driver's
+ * "dhdpcie_bus_bridge_init" lines (the link between the radio chips that MLO uses); on a failed soft restart they
+ * are missing. The SoC's reset status (/proc/bootstate/reset_status, printed as plain hex such as "20000000") tells
+ * a power-on reset (0x80000000) from a hardware (0x40000000), software (0x20000000) or PCIe (0x10000000) reset.
+ * No software path gives the radios a power-on reset, so the router can only say so.
+ *
+ * Once per boot, when start_lan has brought the radios up (wlready), rc reads the kernel log at once - the ring is
+ * 128 KB and a busy boot can rotate the early lines out, so it is read early and a log that no longer holds the
+ * start of this boot ("Linux version") decides nothing. MLO on (mld_enable=1) + a known reset that is not a
+ * power-on + the log still complete + no bridge line = one syslog line and reaper_mlo_coldboot_owed=1; every other
+ * boot writes 0 (the flag is never committed here, but another save may commit it, so each boot sets it). The
+ * dashboard shows a banner from the flag (Main_ReaperDash.asp). The decision is a pure function between the
+ * REAPER-MLOBOOT-PURE markers, compiled on the host by test_mlo_coldboot.py.
+ *
+ * 2026-11-23 (REAPER-MLOBOOT-SEEN): the missing line counts only on a router that has printed it on an earlier start
+ * (an empty file on /jffs, written the first time it is seen). The line comes from the closed dongle driver and was
+ * read on one board; until this router has shown it, its absence decides nothing.
+ */
+#include <rc.h>
+#include <shared.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/klog.h>
+#include <sys/stat.h>
+#include <fcntl.h>
+#include <unistd.h>
+
+/* REAPER-MLOBOOT-PURE-BEGIN */
+#define RMB_POR		0x80000000UL	/* bcm_bootstate.h POR_RESET_STATUS */
+#define RMB_HW		0x40000000UL	/* HW_RESET_STATUS */
+#define RMB_SW		0x20000000UL	/* SW_RESET_STATUS */
+#define RMB_PCIE	0x10000000UL	/* PCIE_RESET_STATUS */
+#define RMB_MASK	0xF0000000UL	/* RESET_STATUS_MASK */
+
+/* reset_status as the kernel prints it: hex digits, an optional 0x, trailing white space; 1 = parsed */
+static int rmb_parse_status(const char *s, unsigned long *st)
+{
+	unsigned long v = 0;
+	int n = 0;
+
+	if (!s)
+		return 0;
+	while (*s == ' ' || *s == '\t')
+		s++;
+	if (s[0] == '0' && (s[1] == 'x' || s[1] == 'X'))
+		s += 2;
+	for (; *s; s++, n++) {
+		int d;
+
+		if (*s >= '0' && *s <= '9')
+			d = *s - '0';
+		else if (*s >= 'a' && *s <= 'f')
+			d = *s - 'a' + 10;
+		else if (*s >= 'A' && *s <= 'F')
+			d = *s - 'A' + 10;
+		else
+			break;
+		if (n >= 8)
+			return 0;
+		v = (v << 4) | (unsigned long)d;
+	}
+	while (*s == ' ' || *s == '\t' || *s == '\n' || *s == '\r')
+		s++;
+	if (!n || *s)
+		return 0;
+	*st = v;
+	return 1;
+}
+
+static int rmb_has(const char *buf, size_t len, const char *needle)
+{
+	size_t nl = strlen(needle), i;
+
+	if (!buf || nl == 0 || len < nl)
+		return 0;
+	for (i = 0; i + nl <= len; i++)
+		if (buf[i] == needle[0] && !memcmp(buf + i, needle, nl))
+			return 1;
+	return 0;
+}
+
+/* 1 = a power cycle is owed: MLO on, a known reset other than power-on, the kernel log still holds this boot's
+ * start and no MLO bridge line - and `seen`: this router has printed that line on an earlier start, so its radios
+ * are known to log it (a radio revision that words it differently must never get the banner on every restart).
+ * Anything unknown (no status, no log, a rotated log, a line never seen) = 0. */
+static int rmb_owed(const char *mld, const char *reset_status, const char *klog, size_t klen, int seen)
+{
+	unsigned long st;
+
+	if (!mld || strcmp(mld, "1"))
+		return 0;
+	if (!rmb_parse_status(reset_status, &st) || !(st & RMB_MASK) || (st & RMB_POR))
+		return 0;
+	if (!rmb_has(klog, klen, "Linux version"))
+		return 0;
+	return seen && !rmb_has(klog, klen, "dhdpcie_bus_bridge_init");
+}
+/* REAPER-MLOBOOT-PURE-END */
+
+/* REAPER-MLOBOOT-SEEN: one empty file, written the first time a start with MLO on logs the bridge line. Never
+ * followed through a link, never rewritten; when /jffs is reset it is only learned again. */
+#define RMB_SEEN_DIR	"/jffs/reaper"
+#define RMB_SEEN	RMB_SEEN_DIR "/mlo_bridge_seen"
+
+static int rmb_seen(void)
+{
+	struct stat st;
+
+	return lstat(RMB_SEEN, &st) == 0 && S_ISREG(st.st_mode);
+}
+
+static void rmb_mark_seen(void)
+{
+	int fd;
+
+	mkdir(RMB_SEEN_DIR, 0700);
+	fd = open(RMB_SEEN, O_WRONLY | O_CREAT | O_EXCL | O_NOFOLLOW, 0600);
+	if (fd >= 0)
+		close(fd);
+}
+
+void reaper_mlo_coldboot_check(void)
+{
+	static int done;
+	char rs[32] = "";
+	char *klog = NULL;
+	int sz, n = 0, owed, seen;
+
+	if (done)
+		return;
+	done = 1;
+	if (nvram_match("mld_enable", "1")) {
+		f_read_string("/proc/bootstate/reset_status", rs, sizeof(rs));
+		rs[strcspn(rs, "\r\n")] = '\0';
+		sz = klogctl(10, NULL, 0);	/* SYSLOG_ACTION_SIZE_BUFFER */
+		if (sz > 0 && sz <= (4 << 20) && (klog = malloc(sz)) != NULL) {
+			n = klogctl(3, klog, sz);	/* SYSLOG_ACTION_READ_ALL: the ring as it is, nothing consumed */
+			if (n < 0)
+				n = 0;
+		}
+	}
+	seen = rmb_seen();
+	owed = rmb_owed(nvram_safe_get("mld_enable"), rs, klog, (size_t)n, seen);
+	if (!seen && n > 0 && rmb_has(klog, (size_t)n, "dhdpcie_bus_bridge_init"))
+		rmb_mark_seen();
+	free(klog);
+	nvram_set("reaper_mlo_coldboot_owed", owed ? "1" : "0");
+	if (owed)
+		logmessage("mlo", "MLO is on, but this start was a restart without a power-off (reset status %s) and the "
+			   "radios' MLO link did not form: Wi-Fi may accept no devices. Unplug the router for about 10 seconds "
+			   "and plug it back in; a restart from the web page is not enough.", rs);
+}
