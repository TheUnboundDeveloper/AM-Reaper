diff --git a/release/src/router/www/reaper/reaper_mdns_svc.js b/release/src/router/www/reaper/reaper_mdns_svc.js
new file mode 100644
index 0000000000..fdc7deaa19
--- /dev/null
+++ b/release/src/router/www/reaper/reaper_mdns_svc.js
@@ -0,0 +1,56 @@
+/* SPDX-License-Identifier: GPL-2.0-only
+ * Copyright (C) 2026 the Reaper project maintainer
+ * Part of the Reaper hardened Asuswrt-Merlin build. See LICENSE / LICENSE.reaper.
+ *
+ * reaper_mdns_svc.js - mDNS service-type picker logic for kit pages (reaper 2026-11-20, REAPER-MDNS-CORETYPES).
+ * A careful copy of the Network page helpers in SDN/sdn.js (reaper_gc_svc_types, reaper_gc_mdns_parse,
+ * reaper_gc_mdns_serialise; that page loads no kit files) so Tweaks > mDNS across networks stores reaper_mdns_types in
+ * exactly the format of apgN_rg_mdns: a comma list of presets (print, airplay, cast, homekit, audio) and service types
+ * _name._tcp / _name._udp, at most 16 types expanded, at most 255 characters. rc expands it again with the same table
+ * (rc/reaper_guest.c rg_mdns_presets). test_mdns_reflector.py runs this file and the sdn.js helpers under node and
+ * requires the same answers. No page state, no strings: the page supplies the labels.
+ */
+(function(){
+  'use strict';
+  var RE = /^_[a-z0-9-]{1,32}\._(tcp|udp)$/;
+  function types(){
+    return [
+      ['print', ['_ipp._tcp', '_ipps._tcp', '_printer._tcp', '_pdl-datastream._tcp', '_uscan._tcp']],
+      ['airplay', ['_airplay._tcp', '_raop._tcp']],
+      ['cast', ['_googlecast._tcp']],
+      ['homekit', ['_hap._tcp', '_hap._udp', '_matter._tcp', '_matterc._udp']],
+      ['audio', ['_spotify-connect._tcp', '_sonos._tcp']]
+    ];
+  }
+  /* stored value -> picker state: presets and well-formed service types (anything else is dropped) */
+  function parse(value){
+    var presets = types().map(function(p){ return p[0]; }), out = {presets: [], extra: []};
+    String(value == undefined ? '' : value).toLowerCase().split(',').forEach(function(t){
+      t = t.trim();
+      if (t === '') return;
+      if (presets.indexOf(t) !== -1){ if (out.presets.indexOf(t) === -1) out.presets.push(t); }
+      else if (RE.test(t) && out.extra.indexOf(t) === -1) out.extra.push(t);
+    });
+    return out;
+  }
+  /* picker state -> stored value. Presets in a fixed order, then free entries (lower case, commas or spaces between
+     them); an entry a chosen preset already covers is dropped. Refused: a malformed entry, nothing chosen, more than
+     16 service types after expansion, more than 255 characters. */
+  function serialise(presets, extraText){
+    var chosen = (presets || []).map(function(p){ return String(p).toLowerCase(); }), ty = [], tokens = [], i;
+    types().forEach(function(p){
+      if (chosen.indexOf(p[0]) === -1) return;
+      tokens.push(p[0]);
+      p[1].forEach(function(t){ if (ty.indexOf(t) === -1) ty.push(t); });
+    });
+    var extra = String(extraText == undefined ? '' : extraText).toLowerCase().split(/[\s,]+/).filter(function(t){ return t !== ''; });
+    for (i = 0; i < extra.length; i++){
+      if (!RE.test(extra[i])) return {ok: false, bad: extra[i]};
+      if (ty.indexOf(extra[i]) === -1){ ty.push(extra[i]); tokens.push(extra[i]); }
+    }
+    var value = tokens.join(',');
+    if (tokens.length === 0 || ty.length > 16 || value.length > 255) return {ok: false, bad: ''};
+    return {ok: true, value: value, types: ty.length};
+  }
+  window.ReaperMdnsSvc = {types: types, parse: parse, serialise: serialise};
+})();
