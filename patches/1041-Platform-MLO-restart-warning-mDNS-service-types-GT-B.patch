diff --git a/release/src/router/avahi/avahi-daemon/main.c b/release/src/router/avahi/avahi-daemon/main.c
index ca21568734..a0b3048cc3 100644
--- a/release/src/router/avahi/avahi-daemon/main.c
+++ b/release/src/router/avahi/avahi-daemon/main.c
@@ -662,6 +662,37 @@ static char *reaper_rg_entry(const char *v) {
     return out;
 }
 
+/* reaper 2026-11-20 (REAPER-MDNS-CORETYPES, owner): reflect-core-types=<type>:<type>... - the service types the
+ * reflector relays between the reflect-interfaces (rc writes them expanded and validated from reaper_mdns_types).
+ * Each must pass reaper_rg_type_ok(), at most 32 are kept. An empty value = unfiltered (NULL); a value with no valid
+ * type at all relays none (an empty list, never unfiltered by mistake). */
+static char *reaper_core_types(const char *v) {
+    const char *t, *e;
+    size_t tl;
+    unsigned n = 0;
+    char *out, *o;
+
+    if (!v || !*v)
+        return NULL;
+    if (!(out = avahi_new(char, strlen(v) + 1)))
+        return NULL;
+    o = out;
+    for (t = v; t; t = e ? e + 1 : NULL) {
+        e = strchr(t, ':');
+        tl = e ? (size_t) (e - t) : strlen(t);
+        if (reaper_rg_type_ok(t, tl) && n < 32) {
+            if (o != out)
+                *o++ = ':';
+            memcpy(o, t, tl);
+            o += tl;
+            n++;
+        } else if (tl)
+            avahi_log_warn("reflect-core-types: service type \"%.*s\" ignored", (int) tl, t);
+    }
+    *o = 0;
+    return out;
+}
+
 static int load_config_file(DaemonConfig *c) {
