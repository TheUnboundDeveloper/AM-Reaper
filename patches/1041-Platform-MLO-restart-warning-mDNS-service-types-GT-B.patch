+  _rm="$(nvram get apg${AI}_rg_mdns 2>/dev/null | tr -c 'a-z0-9._-' ' ' | awk '{ for (i = 1; i <= NF; i++) if ($i ~ /^(print|airplay|cast|homekit|audio)$/) p = p $i "+"; else c++ } END { if (p == "" && !c) print "off"; else { sub(/\+$/, "", p); print (p == "" ? "" : p) (c ? (p == "" ? "" : "+") c "-typed" : "") } }')"
