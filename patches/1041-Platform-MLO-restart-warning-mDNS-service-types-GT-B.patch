+# v1.3.62: the four Bastion tools side by side, then Wallguard (rc/wallguard.c + wallguard.sh: the compiled table every
+# dnsmasq maps, the subscribed lists and their last download, the operator's rules counted, pauses, the counters),
+# Encrypted DNS (rednsd: listeners by protocol, queries and refusals, devices by protocol; the DHCP option 162 offer;
+# the REAPER_EDNS block), Let's Encrypt via DNS and the web certificate. A list address, a list entry, a device
+# address and an API key are never printed; the certificate names are on the literal list (section 1) and masked.
+echo "  bastion switches  : warden=$(nvram get rwarden_enable 2>/dev/null) dreadwatch=$(nvram get rwarden_dns 2>/dev/null) wallguard=$(nvram get wallguard_enable 2>/dev/null) encrypted-dns dot=$(nvram get reaper_dot_srv 2>/dev/null) doh=$(nvram get reaper_doh_srv 2>/dev/null)  block 853=$(nvram get reaper_dot_block 2>/dev/null) block doh=$(nvram get reaper_doh_block 2>/dev/null)"
+_lc() { if [ -f "$1" ] && [ ! -L "$1" ]; then grep -c . "$1" 2>/dev/null; else echo 0; fi; }
+_wgd=/tmp/wallguard; _wgj=/jffs/wallguard; _wge="$(nvram get wallguard_enable 2>/dev/null)"
+_wgb=0; [ -s $_wgd/db ] && _wgb="$(wc -c < $_wgd/db 2>/dev/null | tr -d ' ')"; case "$_wgb" in ''|*[!0-9]*) _wgb=0;; esac
+_wgm=0; for _p in $(pidof dnsmasq 2>/dev/null); do grep -q "$_wgd/db" /proc/$_p/maps 2>/dev/null && _wgm=$((_wgm+1)); done
+_wgc="$(ls /etc/dnsmasq.conf /etc/dnsmasq-*.conf 2>/dev/null | wc -l | tr -d ' ')"
+echo "  wallguard         : enable=${_wge:-unset} mode=$(nvram get wallguard_mode 2>/dev/null) table=$( [ "$_wgb" -gt 0 ] && echo "$_wgb bytes" || echo none) mapped_by=$_wgm/$_wgc dnsmasq instance(s)  lists in RAM=$(du -sk $_wgd/lists 2>/dev/null | cut -f1) KB"
+echo "  wallguard config  : lists=$(_lc $_wgj/lists) profiles=$(_lc $_wgj/profiles) assignments=$(_lc $_wgj/assign) my-block=$(_lc $_wgj/block) my-allow=$(_lc $_wgj/allow) unbreak-24h=$(_lc $_wgj/allow24) adguard-rules=$(_lc $_wgj/adv) rewrites=$(_lc $_wgj/rewrite) blocked-services=$(_lc $_wgj/services) schedules=$(_lc $_wgj/sched) api-keys=$(_lc $_wgj/keys)"
+if [ -s $_wgd/state ] && [ ! -L $_wgd/state ]; then
+  echo "  list states       : $(awk -v n="$(date +%s)" '$1 ~ /^[a-z0-9_]+$/ { a = ($3 + 0 > 0) ? int((n - $3) / 3600) "h" : "never"; printf "%s=%s(last good %s ago) ", $1, $2, a }' $_wgd/state)"
+  _wgf="$(awk '$1 ~ /^[a-z0-9_]+$/ && $2 != "ok" { printf "%s(%s) ", $1, $2 }' $_wgd/state)"
+  [ "$_wge" = 1 ] && [ -n "$_wgf" ] && finding WARN "Wallguard: list(s) $_wgf did not download on the last run (failed = the previous copy is kept, missing = nothing loaded); the Wallguard page, Lists tab, says why (see 14h)"
+fi
+[ -s $_wgd/build.st ] && [ ! -L $_wgd/build.st ] && echo "  last build        : $(head -n 1 $_wgd/build.st | sed 's/"t":\([0-9]*\)/"age_s":\1/')"
+_wgs="$(sed -n 's/.*"skip":"\([a-z]*\)".*/\1/p' $_wgd/build.st 2>/dev/null)"
+[ "$_wge" = 1 ] && [ -n "$_wgs" ] && finding WARN "Wallguard: the last table build was skipped ($_wgs) - the table in use is older than the lists (see 14h)"
+echo "  pauses            : all=$(awk '$1 == "all"' $_wgd/pause 2>/dev/null | wc -l | tr -d ' ') devices=$(awk '$1 == "mac"' $_wgd/pause 2>/dev/null | wc -l | tr -d ' ')  live view=$( [ -f $_wgd/live.on ] && echo on || echo off)  retry owed=$( [ -f $_wgd/pending ] && echo "yes (tries $(cat $_wgd/tries 2>/dev/null || echo 0))" || echo no)  safe-search addresses=$(_lc $_wgd/safesearch)"
+echo "  wallguard counts  : $(awk '$1 == "TOTAL" { t = $2 } $1 == "SINCE" { s = $2 } $1 == "DROPPED" { d = $2 } $1 == "CNAME" { c = $2 } END { printf "blocked=%d via-cname=%d not_recorded=%d since=%s", t, c, d, (s ? s : "-") }' $_wgj/counters 2>/dev/null)"
+[ "$_wge" = 1 ] && [ "$_wgb" = 0 ] && finding WARN "Wallguard is switched on but its table /tmp/wallguard/db is missing - nothing is blocked until a list arrives (see 14h)"
+[ "$_wge" = 1 ] && [ "$_wgb" -gt 0 ] && [ "$_wgm" = 0 ] && [ "${_wgc:-0}" -gt 0 ] && finding INFO "Wallguard's table is built but no dnsmasq instance has mapped it yet - each maps it at its first query; a restart of DNS is not needed (see 14h)"
+echo "  -- Encrypted DNS (rednsd) --"
+_rs=/tmp/rednsd/run/status.json
+_rsv() { _v="$(sed -n "s/.*\"$1\":\([0-9]*\).*/\1/p" "$_rs" 2>/dev/null | head -1)"; echo "${_v:-0}"; }
+_rst="$(sed -n 's/^{"state":"\([a-z_]*\)".*/\1/p' "$_rs" 2>/dev/null)"
+echo "  rednsd            : running=$(pidof rednsd 2>/dev/null | wc -w) state=${_rst:-no status} up=$(_rsv up)s strict=$(nvram get reaper_dot_strict 2>/dev/null)  rc note: $(sed -n 's/.*"state":"\([^"]*\)".*/\1/p' /tmp/rednsd/note.json 2>/dev/null)"
+echo "  listeners         : $(grep -o '"p":[0-9]*,"wan":[01],"ok":[01],"proto":"do[ht]"' "$_rs" 2>/dev/null | sed 's/"p":\([0-9]*\),"wan":\([01]\),"ok":\([01]\),"proto":"\(do[ht]\)"/\4:\1(wan=\2,ok=\3)/' | sort | uniq -c | awk '{ printf "%s x%s  ", $2, $1 }')"
+echo "  traffic           : conns_open=$(_rsv conns) conns_total=$(_rsv conns_total) queries=$(_rsv queries) doh_queries=$(_rsv doh_queries) refused peer=$(_rsv refused_peer) policy=$(_rsv refused_policy) busy=$(_rsv refused_busy) tls_fail=$(_rsv hs_fail) servfail=$(_rsv servfail) h2_errors=$(_rsv h2_errors)"
+echo "  devices           : $(grep -o '"proto":"do[ht]","q":' "$_rs" 2>/dev/null | sort | uniq -c | awk '{ split($2, a, "\""); printf "%s=%s ", a[4], $1 }')"
+echo "  certificate       : $(sed -n 's/.*"cert":\({[^}]*}\).*/\1/p' "$_rs" 2>/dev/null)"
+_dnr="$(cat /tmp/rednsd/dnr 2>/dev/null)"
+echo "  dhcp option 162   : $( [ -n "$_dnr" ] && echo "$_dnr" | awk '{ printf "published (dot=%s doh=%s)", $2, $3 }' || echo "not published (needs a publicly trusted certificate for the router's name)")"
+# v3.8.4 (REAPER-DNR-STEP): the offer skips the devices DNS Director sends to another server (counts only)
+echo "  option 162 offer  : configs offering=$(grep -l ',162,' /etc/dnsmasq.conf /etc/dnsmasq-*.conf 2>/dev/null | wc -l) device rules left out=$(cat /etc/dnsmasq.conf /etc/dnsmasq-*.conf 2>/dev/null | grep '^dhcp-mac=set:rednodnr,' | sort -u | wc -l) kept in on a redirected network=$(cat /etc/dnsmasq.conf /etc/dnsmasq-*.conf 2>/dev/null | grep '^dhcp-mac=set:reddnr,' | sort -u | wc -l)"
+for T in iptables ip6tables; do
+  if $T -nL REAPER_EDNS >/dev/null 2>&1; then
+    $T -nvxL REAPER_EDNS 2>/dev/null | tail -n +3 | awk -v f="$T" '{ n++; if ($3 == "REJECT" || $3 == "DROP") r += $1 } END { printf "  block chain %-9s: REAPER_EDNS rules=%d refused-pkts=%d\n", f, n + 0, r + 0 }'
+  else
+    echo "  block chain $T: REAPER_EDNS absent"
+  fi
+done
+echo "  doh resolver sets : redns_doh=$(ipset list -t redns_doh 2>/dev/null | sed -n 's/.*Number of entries: //p') redns_doh6=$(ipset list -t redns_doh6 2>/dev/null | sed -n 's/.*Number of entries: //p')"
+{ [ "$(nvram get reaper_dot_srv 2>/dev/null)" = 1 ] || [ "$(nvram get reaper_doh_srv 2>/dev/null)" = 1 ]; } && [ "$(pidof rednsd 2>/dev/null | wc -w)" = 0 ] && finding WARN "Encrypted DNS is switched on but rednsd is not running (rc note: $(sed -n 's/.*"state":"\([^"]*\)".*/\1/p' /tmp/rednsd/note.json 2>/dev/null)) - devices fall back to plain DNS (see 14h)"
+grep -q '"ok":0' "$_rs" 2>/dev/null && [ "$(pidof rednsd 2>/dev/null | wc -w)" -gt 0 ] && finding WARN "Encrypted DNS: a listener could not bind (ok=0 in 14h) - another service holds that port"
+{ [ "$(nvram get reaper_dot_block 2>/dev/null)" = 1 ] || [ "$(nvram get reaper_doh_block 2>/dev/null)" = 1 ]; } && ! iptables -nL REAPER_EDNS >/dev/null 2>&1 && finding WARN "the Encrypted DNS block is switched on but the REAPER_EDNS chain is absent - encrypted DNS around the router is not blocked (see 14h)"
+echo "  -- certificates --"
+_lt="$(nvram get reaper_ledns_token 2>/dev/null)"; _lw="$(nvram get reaper_ledns_when 2>/dev/null)"
+echo "  lets encrypt dns  : enable=$(nvram get reaper_ledns_enable 2>/dev/null) provider=$(nvram get reaper_ledns_provider 2>/dev/null) domain=$( [ -n "$(nvram get reaper_ledns_domain 2>/dev/null)" ] && echo SET || echo EMPTY) token=$( [ -n "$_lt" ] && echo SET || echo EMPTY) state=$(nvram get reaper_ledns_state 2>/dev/null) last=$(case "$_lw" in ''|*[!0-9]*) echo "${_lw:-never}";; *) date -d @$_lw '+%F %R' 2>/dev/null;; esac)"
+_le="$(nvram get reaper_ledns_err 2>/dev/null)"; [ -n "$_le" ] && echo "  last error        : $_le"
+[ "$(nvram get reaper_ledns_enable 2>/dev/null)" = 1 ] && [ "$(nvram get reaper_ledns_state 2>/dev/null)" = fail ] && finding WARN "Let's Encrypt via DNS failed on its last run - the DDNS page shows the provider's answer (see 14h)"
+echo "  stock le_enable   : $(nvram get le_enable 2>/dev/null) (0 none, 1 Let's Encrypt via DDNS, 2 imported)"
+if have openssl && [ -r /etc/cert.pem ]; then
+  echo "  web certificate   : $(openssl x509 -in /etc/cert.pem -noout -issuer 2>/dev/null | sed 's/^issuer= *//')  expires $(openssl x509 -in /etc/cert.pem -noout -enddate 2>/dev/null | sed 's/^notAfter=//')"
+  openssl x509 -in /etc/cert.pem -noout -checkend 0 >/dev/null 2>&1 || finding WARN "the web certificate (/etc/cert.pem) has expired - browsers and Encrypted DNS devices refuse it (see 14h)"
+fi
+# REAPER-DIAG-14H-END
