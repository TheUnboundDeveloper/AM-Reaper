     else if (k ~ /_ssid$/) cls="SSID"
-    else if (k ~ /ddns_hostname|_hostname$|computer_name|lan_domain|ddns_username|reaper_ledns_domain|reaper_landns_domain|https_crt_cn/) cls="HOST"
+    else if (k ~ /ddns_hostname|_hostname$|computer_name|lan_domain|ddns_username|reaper_ledns_domain|reaper_landns_domain|https_crt_cn|^reaper_dut_redir_host$/) cls="HOST"
     # v1.3.61 (review P6-4-G2 / G3, rule diag-sanitizer-name-sources): the ISP-given DHCP domain (wanN_domain - dnsmasq
     # prints it as "using nameserver ... for domain <d>"), the remote log server, the server of each VPN client
     # (WireGuard endpoint name and the addresses it resolved to, OpenVPN server) and a typed NTP server. The public
@@ -939,6 +948,31 @@ else
 fi
 GKNV="$(nvram get gk_rl 2>/dev/null | wc -c)"; [ "$GKNV" -gt 1 ] && finding INFO "gk_rl still in nvram ($GKNV bytes) - Gatekeeper list not migrated to /jffs yet (pre-v2.6.3 or Gatekeeper never restarted)"
 
+# REAPER-DIAG-3C-BEGIN
+sec "3c. HARDENING (mount flags, conntrack helpers, log flood cap, USB 3 levers)"
+# v1.3.62: hardening a page does not show. /tmp, /var and /jffs are mounted nosuid,nodev at boot (v3.7.6); the kernel
+# attaches no conntrack helper by itself (v3.7.2: nf_conntrack_helper=0, the helpers ride raw-table rules in
+# REAPER_CTH / REAPER_CTHO, FTP passthrough nf_ftp off at factory); syslogd holds back a message that repeats fast
+# and says how many it held back (v3.7.7); the USB 3 write-speed levers are unset unless an A/B test set them (v3.7.0).
+for _mp in /tmp /var /jffs; do
+  _mo="$(awk -v m="$_mp" '$2 == m { o = $4 } END { print o }' /proc/mounts 2>/dev/null)"
+  if [ -z "$_mo" ]; then echo "  mount $_mp        : not a separate mount"; continue; fi
+  _ms=""
+  case ",$_mo," in *,nosuid,*) _ms="nosuid";; *) _ms="SUID-ALLOWED";; esac
+  case ",$_mo," in *,nodev,*) _ms="$_ms,nodev";; *) _ms="$_ms,DEV-ALLOWED";; esac
+  echo "  mount $_mp        : $_ms"
+  case "$_ms" in *ALLOWED*) finding WARN "$_mp is mounted without nosuid/nodev ($_ms) - rc mounts it with both since v3.7.6 (see 3c)";; esac
+done
+_cth="$(cat /proc/sys/net/netfilter/nf_conntrack_helper 2>/dev/null)"
+_cthr=0; for _c in REAPER_CTH REAPER_CTHO; do _n="$(iptables -t raw -S "$_c" 2>/dev/null | grep -c -- '-j CT')"; _cthr=$((_cthr + ${_n:-0})); done
+echo "  conntrack helpers : automatic=${_cth:-?} (0 = only by rule)  raw CT rules=$_cthr  ftp passthrough nf_ftp=$(nvram get nf_ftp 2>/dev/null)  pptp passthrough=$(nvram get fw_pt_pptp 2>/dev/null)"
+[ "$_cth" = 1 ] && finding WARN "the kernel attaches conntrack helpers to every connection on their port (nf_conntrack_helper=1) - rc sets 0 since v3.7.2 (see 3c)"
+_lcs="$(cat /tmp/syslog.log-1 /tmp/syslog.log 2>/dev/null | grep -c 'were suppressed')"
+echo "  log flood cap     : ${_lcs:-0} line(s) saying repeated messages were held back (19 and 19b show which)"
+_u3="$(sed -n 's/^reaper_usb3_\([a-z0-9_]*\)=\(..*\)$/\1=\2/p' "$NVS" 2>/dev/null | tr '\n' ' ')"
+echo "  usb3 levers       : ${_u3:-none set (driver defaults)}"
+# REAPER-DIAG-3C-END
+
 sec "4. LAN / BRIDGE"
 for k in lan_proto lan_ipaddr lan_netmask lan_ifname lan_ifnames lanports wanports dhcp_enable_x dhcp_start dhcp_end; do
   echo "  $k = $(nvram get $k 2>/dev/null)"
@@ -1070,6 +1104,66 @@ else
   echo "  ipv6 filter FORWARD: no chain"
 fi
 
+# REAPER-DIAG-4D-BEGIN
+sec "4d. GUEST NETWORKS (isolation, opt-in paths, Guest Portal, device discovery - bridges and counts, no names)"
+# v1.3.62: guest isolation (rc/reaper_guest.c, v3.7.7 on) and the v3.8.3 opt-ins, per enabled network. sdn_rl fields:
+# 1 idx, 2 type, 3 enable, 5 subnet_idx, 6 apg_idx, 7 vpnc_idx, 12 cp_idx, 15 kill switch; subnet_rl field 1 is the
+# subnet index and field 2 its bridge; apgN_* are keyed by apg_idx. The type is printed only when it is one of the
+# firmware's own words. Access Intranet with the main network = an sdn_access_rl pair with sdn_idx 0. "isolated" is
+# read from the live chain: REAPER_GUI rules for that bridge. Chosen devices are counted (apgN_rg_devs holds MACs);
+# discovery service types are printed as the preset words, anything typed is counted.
+_acc="$(nvram get sdn_access_rl 2>/dev/null)"
+nvram get subnet_rl 2>/dev/null | tr '<' '\n' | awk -F'>' 'NF >= 2 && $1 != "" { print $1, $2 }' > "$DFS.br"
+nvram get sdn_rl 2>/dev/null | tr '<' '\n' | awk -F'>' 'function d(x) { gsub(/[ \t]/, "_", x); return (x == "" ? "-" : x) } NF >= 12 && $1 != "" && $3 == "1" { print d($1), d($2), d($5), d($6), d($7), d($12), (NF >= 15 ? d($15) : "-") }' | \
+while read -r SI TY SU AI VC CP KS; do
+  [ "$SU" = - ] && SU=0; [ "$AI" = - ] && AI=0; [ "$VC" = - ] && VC=0; [ "$CP" = - ] && CP=0; [ "$KS" = - ] && KS=0
