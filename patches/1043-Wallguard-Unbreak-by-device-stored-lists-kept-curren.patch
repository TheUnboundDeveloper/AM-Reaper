+case "$RECKEEP$RECMAX" in *[!0-9]*) RECKEEP=3600; RECMAX=20000 ;; esac
 
 # 2026-10-25 (release review X-2): each list is capped at 32 MB, but nine presets and eight custom lists
 # together could fill the RAM disk. The lists kept in RAM (a USB store takes them out of it) stay under
@@ -108,11 +113,23 @@ st_get() {
   fi
   echo "$ST/$1"
 }
-# the usable copy of list <id>: the checked RAM copy of the stored one, else the downloaded one
+# the usable copy of list <id>: the downloaded one still in RAM, else the checked RAM copy of the stored one.
+# reaper 2026-11-15 (D9, field): the stored copy was asked first. A list downloaded while the USB volume was not
+# up yet (the boot update runs seconds before the store mounts) or whose write failed stays in RAM with its NEW
+# sha256 in lists.sum, the volume keeps the OLDER copy - so every later build fetched that older copy, logged
+# "does not match its last download" for every list and fell back to RAM. A RAM copy is always the newest (offload
+# records its sum and removes it only once the stored copy checks out); build moves it to the volume (st_push).
 list_path() {
-  st_get "$1" && return 0
   [ -s "$L/$1" ] && [ ! -L "$L/$1" ] && { echo "$L/$1"; return 0; }
-  return 1
+  st_get "$1"
+}
+# reaper 2026-11-15 (D9): a RAM copy whose sum is the one recorded goes to the USB volume now (put, read back,
+# checked, then dropped from RAM) - no sum is written, nothing on /jffs changes. Any failure keeps it in RAM.
+st_push() {
+  [ -n "$S" ] && [ -s "$L/$1" ] && [ ! -L "$L/$1" ] || return 1
+  r=$(sum_rec "$1"); [ -n "$r" ] && [ "$(sum_of "$L/$1")" = "$r" ] || return 1
+  rm -f "$ST/$1"
+  "$RS" put "$S" wallguard/lists "$1" "$L/$1" 2>/dev/null && st_get "$1" >/dev/null && rm -f "$L/$1"
 }
 # a list just downloaded to RAM: record its sha256; with a USB store, write it there (rstore put),
 # read it back and check it, then drop the downloaded copy. Any failure keeps the list in RAM.
@@ -281,7 +298,7 @@ build() {
   # one build at a time (rc's background rebuilds, Unbreak's Allow, the update): two at once wrote the
   # same table file (review 2026-10-21); waits, so the later rule change still lands
   exec 8>"$D/build.lock"
-  lock_wait 8 300 || { log "another block table build is still running - this one was skipped"; return 1; }
+  lock_wait 8 300 || { log "another block table build is still running - this one was skipped"; bstat lock; return 1; }
   # 2026-11-06 (owner): Advanced rules - the AdGuard-syntax box, compiled beside the table (the engine reads
   # $D/adv); rc writes $D/clients (device and profile names -> MACs) and $D/safe before every build
   if [ -s "$J/adv" ]; then
@@ -293,15 +310,21 @@ build() {
   else
     rm -f "$D/adv" "$D/adv.json"
   fi
-  args=; miss=
+  args=; miss=; _bw=0; _bu=0; _bn=
   [ -f "$D/feeds" ] || : > "$D/feeds"
   [ -n "${S+x}" ] || S=$(st_lists)
   while read -r bit id url kind opt; do
     feed_ok "$bit" "$id" "$url" "$kind" "$opt" || continue
+    [ "$kind" != s ] && _bw=$((_bw + 1))
+    st_push "$id"	# reaper 2026-11-15 (D9): a list still in RAM moves to the USB volume
     if p=$(list_path "$id"); then
       args="$args --list $bit:$id:$p"
-    elif [ "$kind" != s ] && awk -v i="$id" '$1 == i && $3 > 0 {f=1} END {exit !f}' "$D/state" 2>/dev/null; then
-      miss="$miss $id"
+      [ "$kind" != s ] && _bu=$((_bu + 1))
+    else
+      [ "$kind" != s ] && _bn="$_bn $id"
+      if [ "$kind" != s ] && awk -v i="$id" '$1 == i && $3 > 0 {f=1} END {exit !f}' "$D/state" 2>/dev/null; then
+        miss="$miss $id"
+      fi
     fi
   done < "$D/feeds"
   # a list that was downloaded before and has no usable copy now (its USB volume is not mounted):
@@ -309,6 +332,7 @@ build() {
   if [ -n "$miss" ] && [ -s "$D/db" ]; then
     log "list(s)$miss have no usable copy (USB volume not mounted, or the copy changed) - the block table in use stays until they are back or downloaded again"
     rm -rf "$ST"
+    bstat miss "$miss"
     return 1
   fi
   now=$(date +%s)
@@ -325,12 +349,24 @@ build() {
        --allow "$D/allow24" --allow "$D/safe" $args; then
     log "block table built: $(grep -o '"names":[0-9]*' "$D/build.json" | head -1 | cut -d: -f2) names"
     rm -rf "$ST"
+    bstat "" "$_bn"
   else
     log "the block table could not be built - the previous one stays in use"
     rm -rf "$ST"
+    bstat fail "$_bn"
     return 1
   fi
 }
+# reaper 2026-11-15 (D7): a skipped rebuild left only a syslog line - the page went on showing the old table as
+# current. What the last build did goes to $D/build.st (RAM), which stats hands the page as "bstat":
+# skip = "" built | lock another build held the lock | miss a list downloaded before has no usable copy | fail;
+# want / used = the subscribed downloads and how many had a usable copy; none = the ids without one.
+# bstat <skip> [ids]   (ids are feed ids, [a-z0-9_] - feed_ok checked them)
+bstat() {
+  _bi=$(echo $2)	# one space between ids, none at the ends
+  printf '{"t":%d,"skip":"%s","want":%d,"used":%d,"none":"%s"}\n' "$(date +%s)" "$1" "${_bw:-0}" "${_bu:-0}" "$_bi" \
+    > "$D/build.st.tmp" && mv "$D/build.st.tmp" "$D/build.st"
+}
 
 # 2026-10-26 (owner, _r41 metal): a list server that Warden's router-traffic filter (rwarden_self) drops - a
 # picked country, the ban list or a threat feed - failed as a bare "download failed" (OISD on OVH France).
@@ -635,9 +671,15 @@ fold() {
                           else if ($1 == "DEV" && ($2 ~ ipre || $2 ~ macre) && $5 ~ ipre) { dc[$2] = $3; dt[$2] = $4; di[$2] = $5 }
                           else if ($1 == "LIST") lc[$2] = $3; next }
     /^# dropped [0-9]+$/ { dr += $3; next }
-    NF != 6 || $1 !~ /^[0-9]+$/ || $2 !~ ipre || $3 !~ /^[0-9a-f]+$/ || ($4 != "q" && $4 != "c") || ($5 != "-" && $5 !~ macre) || $6 !~ re { next }
+    # reaper 2026-11-15: "time ip bits reason mac name", and for reason c a 7th field - the listed chain name that
+    # caused the block (- when unknown); field 6 is then the name the device asked for
+    (NF != 6 && NF != 7) || $1 !~ /^[0-9]+$/ || $2 !~ ipre || $3 !~ /^[0-9a-f]+$/ || ($4 != "q" && $4 != "c") || ($5 != "-" && $5 !~ macre) || $6 !~ re { next }
+    NF == 7 && ($4 != "c" || ($7 != "-" && $7 !~ re)) { next }
+    # a CNAME block counts under the listed chain entry, never the asked name: the asker picks that one, and a
+    # wildcard CNAME could invent names without end (the asked name stays in recent, for Unbreak)
     { tot++; if ($4 == "c") cn++
-      nc[$6]++; nb[$6] = $3; nt[$6] = $1
+      nm = (NF == 7 && $7 != "-") ? $7 : $6
+      nc[nm]++; nb[nm] = $3; nt[nm] = $1
       dev = ($5 != "-") ? $5 : $2; dc[dev]++; dt[dev] = $1; di[dev] = $2
       bits = hexv($3); for (b = 0; b < 31; b++) { if (bits % 2 == 1) lc[b]++; bits = int(bits / 2) }
       print > REC }
@@ -659,7 +701,10 @@ fold() {
     cat "$REC.add" >> "$REC"
     store_peek shh >/dev/null && cat "$REC.add" >> "$D/hist.q"
     rm -f "$REC.add"
-    tail -n 500 "$REC" > "$REC.t" && mv "$REC.t" "$REC"
+    # reaper 2026-11-15 (D5, field): the last 500 records of ALL devices were kept - 70 min on a quiet network, a few
+    # minutes on a busy one, so Unbreak's 15 min for one device came back short. Now the last RECKEEP seconds (an
+    # hour), at most RECMAX records (RAM only: $D is /tmp, and nothing here is ever banked on /jffs)
+    tail -n "$RECMAX" "$REC" | awk -v since="$(( $(date +%s) - RECKEEP ))" '$1 >= since' > "$REC.t" && mv "$REC.t" "$REC"
   fi
   hist_bg
   # bank on /jffs at most hourly (NAND wear)
@@ -711,6 +756,7 @@ stats() {
   q=${1:-0}; b=${2:-0}; c=${3:-0}
   awk -v q="$q" -v b="$b" -v c="$c" -v now="$(date +%s)" -v re="$NAMERE" -v ipre="$IPRE" -v macre="$MACRE" \
       -v built="$( [ -f "$D/build.json" ] && cat "$D/build.json" || echo null)" \
+      -v bst="$( [ -f "$D/build.st" ] && [ ! -L "$D/build.st" ] && head -n 1 "$D/build.st")" \
       -v hist="$HS" -v histvol="$HV" -v bypass="$(dns_bypass)" \
       -v store="$(b=$(store_peek shl) && case "$b" in "${RSTORE_MNT_D:-/tmp/mnt}"/*) b=${b%/.reaper}; echo "${b##*/}" ;; esac)" \
       -v live="$( [ -f "$D/live.on" ] && echo $(( 3600 - ($(date +%s) - $(date -r "$D/live.on" +%s)) )) || echo 0)" '
@@ -728,7 +774,9 @@ stats() {
     END {
       gsub(/[^A-Za-z0-9 ._-]/, "", store); gsub(/[^A-Za-z0-9 ._-]/, "", histvol)
       gsub(/[^0-9a-fA-F.: ]/, "", bypass); sub(/ +$/, "", bypass)
-      printf "{\"ok\":1,\"now\":%d,\"queries\":%d,\"blocked_live\":%d,\"cname_live\":%d,\"since\":%d,\"total\":%d,\"cname\":%d,\"dropped\":%d,\"live\":%d,\"build\":%s,\"store\":\"%s\",\"hist\":\"%s\",\"histvol\":\"%s\",\"bypass\":\"%s\",", now, q, b, c, since, tot, cn, dr, (live > 0 ? live : 0), built, store, hist, histvol, bypass
+      # reaper 2026-11-15 (D7): the last build status line (bstat), only in the one shape bstat writes
+      if (bst !~ /^[{]"t":[0-9]+,"skip":"(lock|miss|fail)?","want":[0-9]+,"used":[0-9]+,"none":"[a-z0-9_ ]*"[}]$/) bst = "null"
+      printf "{\"ok\":1,\"now\":%d,\"queries\":%d,\"blocked_live\":%d,\"cname_live\":%d,\"since\":%d,\"total\":%d,\"cname\":%d,\"dropped\":%d,\"live\":%d,\"build\":%s,\"bstat\":%s,\"store\":\"%s\",\"hist\":\"%s\",\"histvol\":\"%s\",\"bypass\":\"%s\",", now, q, b, c, since, tot, cn, dr, (live > 0 ? live : 0), built, bst, store, hist, histvol, bypass
       printf "\"feeds\":["
       for (i = 1; i <= nf; i++) { id = order[i]
         printf "%s{\"id\":\"%s\",\"bit\":%d,\"kind\":\"%s\",\"st\":\"%s\",\"ok\":%d,\"at\":%d,\"blocked\":%d,\"warden\":\"%s\",\"wip\":\"%s\"}", (i > 1 ? "," : ""), id, fb[id], fk[id], (id in st ? st[id] : "new"), ok[id], at[id], lc[fb[id]], wd[id], wip[id] }
@@ -742,23 +790,98 @@ stats() {
   ' "$D/state" "$D/feeds" "$CTR" 2>/dev/null || echo '{"ok":0}'
 }
 
+# reaper 2026-11-15 (D4): the addresses a MAC holds now - the neighbour table (IPv4 and IPv6) and dnsmasq's leases.
+# Records whose MAC field is "-" (the engine wrote "-" for every record before 2026-11-15, and still does when the
+# neighbour is unknown) are matched to the device through these. Prints them space separated, lower case.
+mac_ips() {
+  { ip neigh show 2>/dev/null; ip -6 neigh show 2>/dev/null; arp -an 2>/dev/null
+    [ -f "${WALLGUARD_LEASES:-/var/lib/misc/dnsmasq.leases}" ] && cat "${WALLGUARD_LEASES:-/var/lib/misc/dnsmasq.leases}"
+  } | tr 'A-Z' 'a-z' | awk -v m="$1" -v ipre="$IPRE" '
+    # ip neigh: "<addr> dev <if> lladdr <mac> <state>"; arp -an: "? (<addr>) at <mac> [ether] on <if>";
+    # leases: "<expiry> <mac> <addr> <host> <id>"
+    { a = ""
+      for (i = 1; i < NF; i++) if ($i == "lladdr" && $(i + 1) == m) a = $1
+      if ($1 == "?" && $4 == m) { a = $2; gsub(/[()]/, "", a) }
+      if ($2 == m && $1 ~ /^[0-9]+$/) a = $3
+      if (a ~ ipre && a ~ /[.:]/ && !(a in s)) { s[a] = 1; printf "%s ", a } }'
+}
+
 unbreak() {
-  dev=$1; mins=${2:-15}
+  # reaper 2026-11-15 (D4): the page sends the MAC as the device list holds it - records carry it in lower case
+  dev=$(printf '%s' "$1" | tr 'A-Z' 'a-z'); mins=${2:-15}
   case "$mins" in ''|*[!0-9]*|??????*) mins=15 ;; esac	# review 2026-11-03: shell arithmetic below - digits only, whoever calls
   fold
-  awk -v dev="$dev" -v since="$(( $(date +%s) - mins * 60 ))" -v re="$NAMERE" '
-    NF == 6 && $1 >= since && ($2 == dev || $5 == dev) && $6 ~ re { c[$6]++; t[$6] = $1; b[$6] = $3 }
+  ips=; echo "$dev" | grep -q "$MACRE" && ips=$(mac_ips "$dev")
+  # reaper 2026-11-15 (D6, field): Allow looked like it did nothing - the page asked again and the same records
+  # came back. A name allowed now (My rules allow list, or a 24 h allow still running; an allow covers its
+  # subdomains, as wallguardc builds it) is left out: it is answered for every new lookup once the table is rebuilt.
+  _ua=$D/unbreak.allow.$$
+  { [ -f "$J/allow" ] && [ ! -L "$J/allow" ] && cat "$J/allow"
+    [ -f "$J/allow24" ] && [ ! -L "$J/allow24" ] && awk -v n="$(date +%s)" '$1 > n {print $2}' "$J/allow24"
+  } 2>/dev/null | tr 'A-Z' 'a-z' > "$_ua"
+  # records are "time ip bits reason mac name" and, for reason c (a CNAME block), "... name via": the device asked
+  # for name, the listed chain name via caused the block. Matched by the MAC, or by an address the MAC holds now
+  # when the record carries no MAC; a record with ANOTHER device's MAC never matches an address it reused.
+  awk -v dev="$dev" -v ips=" $ips" -v since="$(( $(date +%s) - mins * 60 ))" -v re="$NAMERE" '
+    function allowed(n,   p, k) { p = n
+      while (p != "") { if (p in al) return 1; k = index(p, "."); if (!k) return 0; p = substr(p, k + 1) }
+      return 0 }
+    FILENAME == ARGV[1] { a = $1; sub(/^\*\./, "", a); sub(/\.$/, "", a); if (a != "") al[a] = 1; next }
+    (NF == 6 || (NF == 7 && $4 == "c")) && $1 >= since && $6 ~ re && ($2 == dev || $5 == dev || ($5 == "-" && index(ips, " " $2 " "))) {
+      c[$6]++; t[$6] = $1; b[$6] = $3; if (NF == 7 && $7 != "-" && $7 ~ re) v[$6] = $7 }
     END { printf "{\"ok\":1,\"names\":["; i = 0
-          for (n in c) printf "%s{\"d\":\"%s\",\"n\":%d,\"t\":%d,\"bits\":\"%s\"}", (i++ ? "," : ""), n, c[n], t[n], b[n]
-          printf "]}\n" }' "$REC" 2>/dev/null || echo '{"ok":1,"names":[]}'
+          for (n in c) { if (allowed(n) || ((n in v) && allowed(v[n]))) continue
+            printf "%s{\"d\":\"%s\",\"n\":%d,\"t\":%d,\"bits\":\"%s\",\"via\":\"%s\"}", (i++ ? "," : ""), n, c[n], t[n], b[n], v[n] }
+          printf "]}\n" }' "$_ua" "$( [ -f "$REC" ] && echo "$REC" || echo /dev/null)" 2>/dev/null || echo '{"ok":1,"names":[]}'
+  rm -f "$_ua"
+}
+
+# reaper 2026-11-15 (Wallguard page, Devices tab): the address -> MAC pairs known now, from the same sources as mac_ips
+# (neighbour tables, arp, dnsmasq's leases); one "<addr> <mac>" line per address, the first source wins.
+ip_macs() {
+  { ip neigh show 2>/dev/null; ip -6 neigh show 2>/dev/null; arp -an 2>/dev/null
+    [ -f "${WALLGUARD_LEASES:-/var/lib/misc/dnsmasq.leases}" ] && cat "${WALLGUARD_LEASES:-/var/lib/misc/dnsmasq.leases}"
+  } | tr 'A-Z' 'a-z' | awk -v ipre="$IPRE" -v macre="$MACRE" '
+    { a = ""; m = ""
+      for (i = 1; i < NF; i++) if ($i == "lladdr") { a = $1; m = $(i + 1) }
+      if ($1 == "?" && $3 == "at") { a = $2; gsub(/[()]/, "", a); m = $4 }
+      if ($1 ~ /^[0-9]+$/ && NF >= 3) { a = $3; m = $2 }
+      if (a ~ ipre && a ~ /[.:]/ && m ~ macre && !(a in s)) { s[a] = 1; print a, m } }'
+}
+
+# reaper 2026-11-15 (Wallguard page, Devices tab): blocked lookups per device in the last <minutes> (1-60), from recent
+# ("time ip bits reason mac name [via]"). A record with MAC "-" (older records) counts under the MAC its address belongs
+# to now, else under the address. {"ok":1,"mins":N,"devs":[{"dev":"<mac or address>","n":<count>,"t":<last>}]}
+devcounts() {
+  mins=${1:-15}
+  case "$mins" in ''|*[!0-9]*|???*) mins=15 ;; esac
+  [ "$mins" -ge 1 ] && [ "$mins" -le 60 ] || mins=15
+  fold
+  _im=$D/devcounts.ip.$$
+  ip_macs > "$_im" 2>/dev/null
+  awk -v since="$(( $(date +%s) - mins * 60 ))" -v mins="$mins" -v ipre="$IPRE" -v macre="$MACRE" -v re="$NAMERE" '
+    FILENAME == ARGV[1] { im[$1] = $2; next }
+    (NF == 6 || (NF == 7 && $4 == "c")) && $1 ~ /^[0-9]+$/ && $1 >= since && $2 ~ ipre && ($5 == "-" || $5 ~ macre) && $6 ~ re {
+      d = ($5 != "-") ? $5 : (($2 in im) ? im[$2] : $2); c[d]++; if ($1 > t[d]) t[d] = $1 }
+    END { printf "{\"ok\":1,\"mins\":%d,\"devs\":[", mins; i = 0
+          for (d in c) if (i < 256) printf "%s{\"dev\":\"%s\",\"n\":%d,\"t\":%d}", (i++ ? "," : ""), d, c[d], t[d]
