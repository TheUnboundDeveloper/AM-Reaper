+++ b/release/src/router/rc/wireguard.c
@@ -50,7 +50,10 @@ static int _wg_if_exist(char *ifname)
 #endif
 }
 
-static void _wg_tunnel_create(char* prefix, char* ifname, char* conf_path)
+/* reaper 2026-11-16: returns what "ip link set up" returned (0 = the interface is up). The kernel binds the listen
+ * port at that step, so a port already in use (an OpenVPN server, another daemon) fails here and the interface
+ * stays down; start_wgs() used to log "Starting server." all the same. */
+static int _wg_tunnel_create(char* prefix, char* ifname, char* conf_path)
 {
 	char addr[64] = {0};
 	char buf[64] = {0};
@@ -67,7 +70,7 @@ static void _wg_tunnel_create(char* prefix, char* ifname, char* conf_path)
 	if (nvram_pf_get_int(prefix, "mtu"))
 		eval("ip", "link", "set", ifname, "mtu", nvram_pf_safe_get(prefix, "mtu"));
 
-	eval("ip", "link", "set", "up", "dev", ifname);
+	return eval("ip", "link", "set", "up", "dev", ifname);
 }
 
 static void _wg_tunnel_delete(char* ifname)
@@ -1529,6 +1532,7 @@ void start_wgs(int unit)
 	char cp_path[128] = {0};
 	int c_unit;
 	char tmp[4];
+	int up_rc;	/* reaper 2026-11-16: what bringing the interface up returned */
 
 	snprintf(prefix, sizeof(prefix), "%s%d_", WG_SERVER_NVRAM_PREFIX, unit);
 	snprintf(path, sizeof(path), "%s/server%d.conf", WG_DIR_CONF, unit);
@@ -1557,7 +1561,7 @@ void start_wgs(int unit)
 	_wg_server_gen_conf(prefix, path);
 
 	/// setup tunnel
-	_wg_tunnel_create(prefix, ifname, path);
+	up_rc = _wg_tunnel_create(prefix, ifname, path);
 
 	unlink(path);
 
@@ -1584,7 +1588,11 @@ void start_wgs(int unit)
 	snprintf(tmp, sizeof(tmp), "%d", unit);
 	run_custom_script("wgserver-start", 0, tmp, NULL);
 
-	logmessage("WireGuard", "Starting server.");
+	/* reaper 2026-11-16: say so when the interface did not come up, instead of "Starting server." */
+	if (up_rc)
+		logmessage("WireGuard", "WireGuard server did not start: the interface could not be brought up (is UDP port %s in use?)", nvram_pf_safe_get(prefix, "port"));
+	else
+		logmessage("WireGuard", "Starting server.");
 }
 
 void stop_wgs(int unit)
