@@ -875,6 +896,23 @@ static void rfw_emit_sets(FILE *f, const rfw_cfg_t *c, char *keep, size_t keeple
 		rfw_emit_one_set(f, type, name, val, keep, keeplen);
 	}
 	free(dup);
+	/* one load for every literal object. `ipset restore` stops at the first line it refuses, so on a refusal the
