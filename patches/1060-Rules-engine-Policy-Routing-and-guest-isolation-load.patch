diff --git a/release/src/router/rc/reaper_cc.h b/release/src/router/rc/reaper_cc.h
new file mode 100644
index 0000000000..e48278012e
--- /dev/null
+++ b/release/src/router/rc/reaper_cc.h
@@ -0,0 +1,55 @@
+/*
+ * reaper_cc.h - reaper 2026-11-18 (review 2026-11-17, C-D2): the two parts of commit-confirm that the rules engine
+ * (rc/reaper_fw.c) and Policy Routing (rc/reaper_pbr.c) each carried as an identical copy.
+ *
+ *   reaper_cc_secs()  the confirm window in seconds. ONE setting, reaper_fw_confirm, times both engines; the floor
+ *                     is never 0 (an apply that can cut the admin off must always revert on its own).
+ *   reaper_cc_gen()   the deadline watcher cron runs every minute: nothing armed, no readable deadline, or the
+ *                     deadline not reached -> exit; otherwise run the engine's pre-generated revert script. It needs
+ *                     neither httpd nor rc alive, which is the case it exists for.
+ *
+ * NOT here, on purpose: arm / confirm / revert themselves. The two engines differ in substance there (what a
+ * snapshot holds, the object sets, the token order, what runs under reaper_lockrun), and each copy carries fixes
+ * the other needed in its own form. Folding them is a change of behaviour, not of layout.
+ *
+ * The four paths are compile-time strings of the caller, never operator text.
+ */
+#ifndef REAPER_CC_H
+#define REAPER_CC_H
+#include <stdio.h>
+#include <sys/stat.h>
+#include "reaper_nv.h"
+
+#define REAPER_CC_MIN	15	/* floor, seconds (never 0) */
+#define REAPER_CC_DEF	60
+#define REAPER_CC_MAX	3600
+
+static inline int reaper_cc_secs(void)
+{
+	int n = nvram_get_int("reaper_fw_confirm");
+
+	if (n < REAPER_CC_MIN)
+		n = (n <= 0) ? REAPER_CC_DEF : REAPER_CC_MIN;
+	if (n > REAPER_CC_MAX)
+		n = REAPER_CC_MAX;
+	return n;
+}
+
+static inline void reaper_cc_gen(const char *cc, const char *armed, const char *deadline, const char *rollback)
+{
+	FILE *f = fopen(cc, "w");
+
+	if (!f)
+		return;
+	fputs("#!/bin/sh\n" REAPER_NV_HELPER, f);
+	fprintf(f,
+	  "[ -d %s ] || exit 0\n"
+	  "D=\"$(cat %s 2>/dev/null)\"\n"
+	  "case \"$D\" in ''|*[!0-9]*) exit 0;; esac\n"
+	  "N=\"$(date +%%s)\"\n"
+	  "[ \"$N\" -lt \"$D\" ] && exit 0\n"
+	  "sh %s\n", armed, deadline, rollback);
+	fclose(f);
+	chmod(cc, 0700);
+}
+#endif
