diff --git a/release/src/router/shared/reaper_tmpsafe.c b/release/src/router/shared/reaper_tmpsafe.c
index 9994cb0550..82bbc9d76a 100644
--- a/release/src/router/shared/reaper_tmpsafe.c
+++ b/release/src/router/shared/reaper_tmpsafe.c
@@ -13,6 +13,10 @@
 #include <syslog.h>
 #include <sys/stat.h>
 #include <sys/types.h>
+#include <sys/wait.h>
+#include <poll.h>
+#include <signal.h>
+#include <time.h>
 #include "reaper_tmpsafe.h"
 
 static int tmpsafe_dir_ok(const char *path, const struct stat *st)
@@ -178,3 +182,126 @@ int reaper_script_ok(const char *path)
 	       (int)st.st_uid, (unsigned)(st.st_mode & 07777));
 	return 0;
 }
+
+/* ---- reaper 2026-11-17 (review D-3 / D-24) REAPER-POPEN-BOUNDED: see reaper_tmpsafe.h ---- */
+#define REAPER_POPEN_MAX	(256 * 1024)
+#define REAPER_POPEN_LATE	8
+
+static long reaper_mono_ms(void)
+{
+	struct timespec ts;
+
+	clock_gettime(CLOCK_MONOTONIC, &ts);
+	return ts.tv_sec * 1000L + ts.tv_nsec / 1000000L;
+}
+
+FILE *reaper_popen_bounded(const char *cmd, int secs, int *status)
+{
+	static pid_t late[REAPER_POPEN_LATE];	/* killed, but not yet gone when their call returned */
+	int pfd[2], st = 0, timedout = 0, reaped = 0, i;
+	size_t total = 0;
+	long deadline, now;
+	pid_t pid;
+	FILE *out;
+
+	if (status)
+		*status = -1;
+	for (i = 0; i < REAPER_POPEN_LATE; i++)
+		if (late[i] > 0 && waitpid(late[i], NULL, WNOHANG) != 0)
+			late[i] = 0;
+	if (!cmd || secs < 1 || (out = tmpfile()) == NULL)
+		return NULL;
+	if (pipe(pfd) != 0) {
+		fclose(out);
+		return NULL;
+	}
+	if ((pid = fork()) < 0) {
+		close(pfd[0]);
+		close(pfd[1]);
+		fclose(out);
+		return NULL;
+	}
+	if (pid == 0) {
+		int fd;
+
+		setpgid(0, 0);
+		close(pfd[0]);
+		dup2(pfd[1], 1);
+		if (pfd[1] != 1)
+			close(pfd[1]);
+		if ((fd = open("/dev/null", O_RDWR)) >= 0) {
+			dup2(fd, 0);
+			if (fd > 2)
+				close(fd);
+		}
+		execl("/bin/sh", "sh", "-c", cmd, (char *)NULL);
+		_exit(127);
+	}
+	close(pfd[1]);
+	deadline = reaper_mono_ms() + (long)secs * 1000L;
+	for (;;) {
+		struct pollfd pd;
+		char buf[1024];
+		ssize_t n;
+		int r;
+
+		if ((now = reaper_mono_ms()) >= deadline) {
+			timedout = 1;
+			break;
+		}
+		pd.fd = pfd[0];
+		pd.events = POLLIN;
+		pd.revents = 0;
+		r = poll(&pd, 1, (int)(deadline - now));
+		if (r < 0) {
+			if (errno == EINTR)
+				continue;
+			break;
+		}
+		if (r == 0) {
+			timedout = 1;
+			break;
+		}
+		if ((n = read(pfd[0], buf, sizeof(buf))) <= 0)
+			break;		/* the command closed its output: it is done (or the read failed) */
+		if (total < REAPER_POPEN_MAX) {
+			fwrite(buf, 1, (size_t)n, out);
+			total += (size_t)n;
+		}
+	}
+	close(pfd[0]);
+	if (timedout) {
+		kill(-pid, SIGKILL);	/* the shell and what it started */
+		kill(pid, SIGKILL);	/* in case the child had not made its own group yet */
+	}
+	/* the command is exiting (or was just killed): wait for it, but never without end */
+	deadline = reaper_mono_ms() + (timedout ? 2000L : 3000L);
+	for (;;) {
+		pid_t w = waitpid(pid, &st, WNOHANG);
+
+		if (w == pid) {
+			reaped = 1;
+			break;
+		}
+		if (w < 0 && errno != EINTR)
+			break;
+		if (reaper_mono_ms() >= deadline)
+			break;
+		usleep(10000);
+	}
+	if (!reaped) {
+		if (!timedout) {
+			kill(-pid, SIGKILL);
+			kill(pid, SIGKILL);
+		}
+		for (i = 0; i < REAPER_POPEN_LATE; i++)
+			if (late[i] <= 0) {
+				late[i] = pid;
+				break;
+			}
+	} else if (!timedout && status && WIFEXITED(st))
+		*status = WEXITSTATUS(st);
+	fflush(out);
+	rewind(out);
+	return out;
+}
diff --git a/release/src/router/shared/reaper_tmpsafe.h b/release/src/router/shared/reaper_tmpsafe.h
index fe4f8edc89..89edf55cda 100644
--- a/release/src/router/shared/reaper_tmpsafe.h
+++ b/release/src/router/shared/reaper_tmpsafe.h
@@ -80,6 +80,14 @@ int reaper_write_changed(const char *path, const void *data, size_t len, mode_t
  * NULL when something won the race to the name. */
 FILE *reaper_fopen_new(const char *path, mode_t mode);
 
+/* reaper 2026-11-17 (review D-3 / D-24): popen(cmd, "r") with a time limit. Runs `sh -c cmd` in its own process
+ * group, collects its standard output for at most `secs` seconds (and at most 256 KB), then returns that output
+ * as a rewound stream - read it with fgets() as before and fclose() it (never pclose()). When the time is up the
+ * whole process group is killed. *status (may be NULL): the command's exit code, or -1 when it was killed, did
+ * not exit normally or could not be reaped in time. NULL = could not start. A daemon that asks the radio driver
+ * something through `wl` uses this: a call the driver never answers used to stop the daemon for good. */
+FILE *reaper_popen_bounded(const char *cmd, int secs, int *status);
+
 /* 1 when `path` is a regular file (lstat: not a symlink), owned by this
  * process's user and not writable by group or other - the precondition for
  * running it with sh as root. 0 otherwise, with one syslog line. */
