+/* reaper 2026-11-17 (review D-3): every command this daemon reads goes through reaper_popen_bounded()
+ * (libshared): at most RP_CMD_SECS seconds, then the command is killed and the reader sees what arrived.
+ * popen() had no limit, so one radio call the driver never answered stopped rpunctd for good. */
+#define RP_CMD_SECS	8
+static int rp_scan_st;		/* exit status of the last neighbour scan command */
+
 /* first line of a command, "" on failure */
 static int cmd_line(const char *cmd, char *buf, size_t len)
 {
-	FILE *p = popen(cmd, "r");
+	FILE *p = reaper_popen_bounded(cmd, RP_CMD_SECS, NULL);
 	int ok;
 	buf[0] = 0;
 	if (!p) return 0;
 	ok = fgets(buf, len, p) != NULL;
-	pclose(p);
+	fclose(p);
 	if (ok) buf[strcspn(buf, "\r\n")] = 0;
 	return ok;
 }
@@ -372,11 +378,11 @@ static int read_phy(struct radio *r)
