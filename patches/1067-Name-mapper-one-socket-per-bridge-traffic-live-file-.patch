  * a client receives names exactly the address it is about to connect to.
  *
  * Mechanism, sized for zero idle cost:
- *   - one AF_PACKET socket, unbound (every interface, both directions), with a
+ *   - one AF_PACKET socket per LAN bridge (br*) and one for lo, each BOUND to its interface (2026-11-17:
+ *     an unbound one taps every device and costs a clone per transmitted frame), with a
  *     classic BPF filter attached BEFORE bind so the kernel rejects everything
  *     that is not a UDP datagram from port 53 before a byte is copied; a frame
  *     whose ingress device is not a LAN bridge (br*) is dropped before parsing
  *     (audit 2026-10-06 V2: AF_PACKET sits ahead of netfilter, so the WAN INPUT
  *     policy never applied and an Internet host sending UDP from port 53 at the
  *     WAN address reached the parser as root);
- *   - a blocking recv: no tick, no timer, no sweep - asleep while the LAN is quiet;
+ *   - a poll over those sockets: asleep while the LAN is quiet, one wake every 30 s to follow the interfaces;
  *   - per reply: parse the ANSWER section and map every A and AAAA record to the
  *     QNAME the client asked for (every address record there belongs to the
  *     question's CNAME chain, so this IS the chain walked back, with no CNAME
@@ -835,43 +836,151 @@ static void rdm_src_report(time_t now)
 	at = now;
 }
 
-/* drain both sockets for ms milliseconds: forward replies keep being learned
+/* reaper 2026-11-17 (review D-19) REAPER-RDM-PERIF. The daemon used ONE packet socket bound to every protocol on
+ * every interface. That puts it on the kernel's global tap list: every frame the CPU transmits on any device - the
+ * WAN port, each radio, each tunnel, each bridge port - was cloned and run through the filter, and user space
+ * then dropped whatever did not come from a LAN bridge or loopback. One socket per LAN bridge and one for lo, each
+ * bound to its interface, puts the tap on those devices only. The set follows the interfaces: refreshed every 30 s
+ * (a guest bridge made later is heard within that time), and a socket whose interface is gone is closed. */
+#define RDM_MAXSK 24
+static struct { int fd, idx; } rdm_sk[RDM_MAXSK];
+static int rdm_nsk;
+
+static int rdm_sock_open(int idx)
+{
+	struct sock_fprog prog = { sizeof(rdm_bpf) / sizeof(rdm_bpf[0]), rdm_bpf };
+	struct sockaddr_ll sll;
+	int sk, rcv = 262144;
+
+	/* protocol 0 delivers nothing until bind(): the filter is in place first */
+	if ((sk = socket(AF_PACKET, SOCK_RAW | SOCK_CLOEXEC, 0)) < 0)
+		return -1;
+	if (setsockopt(sk, SOL_SOCKET, SO_ATTACH_FILTER, &prog, sizeof(prog)) != 0) {
+		close(sk);
+		return -1;
+	}
+	setsockopt(sk, SOL_SOCKET, SO_RCVBUF, &rcv, sizeof(rcv));
+	memset(&sll, 0, sizeof(sll));
+	sll.sll_family = AF_PACKET;
+	sll.sll_protocol = htons(ETH_P_ALL);
+	sll.sll_ifindex = idx;			/* never 0: 0 would be the every-interface tap again */
+	if (idx <= 0 || bind(sk, (struct sockaddr *)&sll, sizeof(sll)) != 0) {
+		close(sk);
+		return -1;
+	}
+	return sk;
+}
+
+static void rdm_sock_drop(int i)
+{
+	close(rdm_sk[i].fd);
+	rdm_sk[i] = rdm_sk[--rdm_nsk];
+}
+
+/* open a socket for each LAN bridge and for lo that has none, close the ones whose interface is gone */
+static void rdm_socks_sync(void)
+{
+	struct if_nameindex *ni = if_nameindex(), *p;
+	int seen[RDM_MAXSK], nseen = 0, i, j;
+
+	if (ni == NULL)
+		return;				/* keep what is open: a failed listing is not "no interfaces" */
+	for (p = ni; p->if_index != 0 && p->if_name != NULL; p++) {
+		if (!((p->if_name[0] == 'b' && p->if_name[1] == 'r') || strcmp(p->if_name, "lo") == 0))
+			continue;
+		for (i = 0; i < rdm_nsk; i++)
+			if (rdm_sk[i].idx == (int)p->if_index)
+				break;
+		if (i == rdm_nsk) {
+			int fd;
+
+			if (rdm_nsk >= RDM_MAXSK || (fd = rdm_sock_open((int)p->if_index)) < 0)
+				continue;
+			rdm_sk[rdm_nsk].fd = fd;
+			rdm_sk[rdm_nsk].idx = (int)p->if_index;
+			rdm_nsk++;
+		}
+		if (nseen < RDM_MAXSK)
+			seen[nseen++] = (int)p->if_index;
+	}
+	if_freenameindex(ni);
+	for (i = 0; i < rdm_nsk; ) {
+		for (j = 0; j < nseen; j++)
+			if (seen[j] == rdm_sk[i].idx)
+				break;
+		if (j < nseen)
+			i++;
+		else
+			rdm_sock_drop(i);
+	}
+}
+
+/* one frame from packet socket i: the same tests as ever, then the parser. 0 = the socket is dead */
+static int rdm_sock_read(int i, void *map, time_t now, int learn_src)
+{
+	static uint8_t buf[4096];			/* EDNS replies fit; longer ones are truncated by the sender */
+	struct sockaddr_ll from;
+	socklen_t fl = sizeof(from);
+	int n, lanv;
+
+	n = (int)recvfrom(rdm_sk[i].fd, buf, sizeof(buf), MSG_DONTWAIT, (struct sockaddr *)&from, &fl);
+	if (n < 0)
+		return errno == EINTR || errno == EAGAIN || errno == EWOULDBLOCK;
+	if (n == 0)
+		return 1;
+	lanv = rdm_lan_if(from.sll_ifindex, now);
+	if (!lanv)
+		return 1;			/* not a LAN bridge or lo (cannot happen on a bound socket; kept as the V2 belt) */
+	if (lanv == 2 && !rdm_lo_keep(from.sll_pkttype == PACKET_OUTGOING, buf, n))
+		return 1;			/* loopback: the outgoing copy, or stubby's upstream answer */
+	if (learn_src)
+		rdm_src_load(now);		/* F-2: refreshed every 30 s, on traffic only */
+	rdm_parse(buf, n, map, (uint32_t)now);
+	if (learn_src)
+		rdm_src_report(now);
+	return 1;
+}
+
+/* drain the packet sockets and the PTR socket for ms milliseconds: forward replies keep being learned
  * while the backfill runs, PTR answers land as reverse names */
-static void rdm_bf_drain(struct pollfd *pf, void *map, const uint8_t (*tg)[16], int ntg, int ms)
+static void rdm_bf_drain(int us, void *map, const uint8_t (*tg)[16], int ntg, int ms)
 {
 	static uint8_t rb[4096];
+	struct pollfd pf[RDM_MAXSK + 1];
 	struct timespec t0, t1;
-	int n, left;
+	int n, left, i, npk;
 
 	clock_gettime(CLOCK_MONOTONIC, &t0);
 	for (;;) {
 		clock_gettime(CLOCK_MONOTONIC, &t1);
 		left = ms - (int)((t1.tv_sec - t0.tv_sec) * 1000 + (t1.tv_nsec - t0.tv_nsec) / 1000000);
-		if (left <= 0 || poll(pf, 2, left) <= 0)
+		if (left <= 0)
 			return;
-		if (pf[0].revents & POLLIN) {
-			struct sockaddr_ll from;
-			socklen_t fl = sizeof(from);
-
-			n = (int)recvfrom(pf[0].fd, rb, sizeof(rb), 0, (struct sockaddr *)&from, &fl);
-			if (n > 0) {
-				int lanv = rdm_lan_if(from.sll_ifindex, time(NULL));
-
-				if (lanv == 1 || (lanv == 2 && rdm_lo_keep(from.sll_pkttype == PACKET_OUTGOING, rb, n)))
-					rdm_parse(rb, n, map, (uint32_t)time(NULL));
-			}
+		npk = rdm_nsk;
+		for (i = 0; i < npk; i++) {
+			pf[i].fd = rdm_sk[i].fd;
+			pf[i].events = POLLIN;
+			pf[i].revents = 0;
 		}
-		if ((pf[1].revents & POLLIN) && (n = (int)recv(pf[1].fd, rb, sizeof(rb), 0)) > 0)
+		pf[npk].fd = us;
+		pf[npk].events = POLLIN;
+		pf[npk].revents = 0;
+		if (poll(pf, npk + 1, left) <= 0)
+			return;
+		if ((pf[npk].revents & POLLIN) && (n = (int)recv(us, rb, sizeof(rb), 0)) > 0)
 			rdm_parse_ptr(rb, n, map, (uint32_t)time(NULL), tg, ntg);
+		for (i = npk - 1; i >= 0; i--)	/* downwards: a dropped socket is replaced by the last one, already handled */
+			if ((pf[i].revents & (POLLERR | POLLHUP | POLLNVAL)) ||
+			    ((pf[i].revents & POLLIN) && !rdm_sock_read(i, map, time(NULL), 0)))
+				rdm_sock_drop(i);
 	}
 }
 
-static void rdm_backfill(void *map, int pk)
+static void rdm_backfill(void *map)
 {
