+/* reaper 2026-11-17 (review D-20) REAPER-RTRAF-VIEWER. live.json was rewritten on every base tick - ten file
+ * replacements a second for the life of the box - whether or not a page was open. Its only reader is httpd's
+ * reaper_traffic.cgi, which now stamps RTRAF_VIEWER when it serves the live window. While the stamp is younger
+ * than RTRAF_VIEWER_SECS the file is written on every tick, as before; otherwise once a second, so the first
+ * request after a pause still reads a figure at most a second old (and its stamp brings the full rate back
+ * within a second). Anything unexpected reads as "somebody is watching": a stamp that cannot be read, or one
+ * dated in the future (the clock was set back). The tick itself does not change - the class, flow-cache and
+ * probe cadences and the stale-flow times are counted in ticks. */
+#define RTRAF_VIEWER		"/tmp/rtraf/.viewer"
+#define RTRAF_VIEWER_SECS	15
+static int live_viewer = 1;		/* until the first look says otherwise */
+
+static int viewer_active(const char *path, time_t now)
+{
+	struct stat st;
+
+	if (stat(path, &st) != 0)
+		return errno != ENOENT;	/* never stamped = nobody has looked; any other failure = assume a viewer */
+	return st.st_mtime > now || now - st.st_mtime <= RTRAF_VIEWER_SECS;
+}
+
