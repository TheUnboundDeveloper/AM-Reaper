-	strcpy(window, nvram_safe_get("iperf3_cli_window"));
+	strlcpy(window, nvram_safe_get("iperf3_cli_window"), sizeof(window));
 	iperf3_argv[10] = window;
-	strcpy(omit, nvram_safe_get("iperf3_cli_omit"));
+	strlcpy(omit, nvram_safe_get("iperf3_cli_omit"), sizeof(omit));
