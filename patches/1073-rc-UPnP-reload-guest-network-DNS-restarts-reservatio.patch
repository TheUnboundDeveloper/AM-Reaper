 		 * (added, readdressed, retyped, toggled) - every instance needs them again */
 		if ((action & RC_SERVICE_START) && revshare_sig_changed()) {
 			logmessage("dnsmasq", "networks changed - restarting the resolvers so each one can name the others' devices");
-			notify_rc("restart_dnsmasq");
