-	strcpy(buf_len, nvram_safe_get("iperf3_cli_buf_len"));
+	strlcpy(buf_len, nvram_safe_get("iperf3_cli_buf_len"), sizeof(buf_len));
 	iperf3_argv[14] = buf_len;
-	strcpy(interval, nvram_safe_get("iperf3_cli_interval"));
+	strlcpy(interval, nvram_safe_get("iperf3_cli_interval"), sizeof(interval));
 	iperf3_argv[16] = interval;
 	
 	if(nvram_match("iperf3_cli_reverse", "0"))
@@ -10000,12 +10101,10 @@ int gen_uam_srv_conf()
 	if (fp==NULL) return -1;
 
 	/* Load modules */
+	/* reaper 2026-11-17 (review B-10): only the two modules this file configures. userdir, redirect, rewrite and
+	 * compress were loaded with no settings (their request hooks ran for every guest before sign-in), and
+	 * usertrack, with no cookie name set, gave every guest a TRACKID cookie. The pages are seven aliased files. */
 	fprintf(fp, "server.modules+=(\"mod_alias\")\n");
-	fprintf(fp, "server.modules+=(\"mod_userdir\")\n");
-	fprintf(fp, "server.modules+=(\"mod_redirect\")\n");
-	fprintf(fp, "server.modules+=(\"mod_compress\")\n");
