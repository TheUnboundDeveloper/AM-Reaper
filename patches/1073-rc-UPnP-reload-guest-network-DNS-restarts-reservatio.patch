-	fprintf(fp, "server.modules+=(\"mod_rewrite\")\n");
 	fprintf(fp, "server.modules+=(\"mod_captive_portal_uam\")\n");
 
 	/* Basic setting */
@@ -10058,7 +10157,7 @@ int gen_uam_srv_conf()
 
 	// ****
 	//fprintf(fp, "compress.cache-dir          = \"/tmp/lighttpd/compress/\"\n");
-	fprintf(fp, "compress.filetype           = ( \"application/x-javascript\", \"text/css\", \"text/html\", \"text/plain\" )\n");
+	/* reaper 2026-11-17 (review B-10): no compress.filetype line - mod_compress is no longer loaded here */
 
 	/*** SSL ***/
 	/* default : https://192.168.1.1:443/webdav */
@@ -12655,6 +12754,29 @@ static void reaper_portal_reconcile(const char *rest)
 		}
 	}
 }
+
+/* reaper 2026-11-17 (review D-6) REAPER-PORTAL-WATCH. Nothing started a portal daemon again after it died (a
+ * crash, an abort on a bad frame): the guest network stayed up with no sign-in page until the next settings
+ * change. The rc watchdog asks reaper_portal_down() once a minute while a portal has been started this boot
+ * and, when a portal an enabled network asks for has no process on two looks in a row, requests the service
+ * below - at most three times a boot, so a daemon that cannot stay up is not restarted for ever. */
+int reaper_portal_down(void)
+{
+	int want = reaper_portals_wanted();
+
+	if (want <= 0)
+		return 0;
+	if ((want & 1) && reaper_chilli_count("/tmp/chilli.conf", 0) <= 0)
+		return 1;
+	if ((want & 2) && reaper_chilli_count("/tmp/chilli-cp.conf", 0) <= 0)
+		return 1;
+	return 0;
+}
+
+void reaper_portal_heal(void)
+{
+	reaper_portal_reconcile(NULL);
+}
 #endif
 
