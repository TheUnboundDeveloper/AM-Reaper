From 8893159e71bce779b3fb24963448b506f56c1478 Mon Sep 17 00:00:00 2001
From: reaper <theunbounddeveloper@outlook.com>
Date: Wed, 18 Nov 2026 17:05:41 -0500
Subject: [PATCH] Wi-Fi scripts as on the 3006.102.10 line; Broadcom licence
 1296 (102.8 line)

- wifi.sh, bcm-wlan-drivers.sh and wlinc.sh take the 3006.102.10 versions (quoting, an affinity
  setting that BusyBox accepts).
- Broadcom licence file 1296 is added, as ASUS's stock images carry it.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../wlan/scripts/bcm-wlan-drivers.sh            |   6 +++---
 .../router-sysdep.rt-be96u/wlan/scripts/wifi.sh |  16 ++++++++--------
 .../wlan/scripts/wlinc.sh                       |   9 ++++++++-
 ...dcom-PAK_License-1296.Asus_BQ16_BQ16_PRO.bin | Bin 0 -> 1076 bytes
 4 files changed, 19 insertions(+), 12 deletions(-)
 create mode 100644 release/src-rt-5.04behnd.4916/targets/pakl/Broadcom-PAK_License-1296.Asus_BQ16_BQ16_PRO.bin

diff --git a/release/src-rt-5.04behnd.4916/router-sysdep.rt-be96u/wlan/scripts/bcm-wlan-drivers.sh b/release/src-rt-5.04behnd.4916/router-sysdep.rt-be96u/wlan/scripts/bcm-wlan-drivers.sh
index aea0a58b3b..9298ee5e01 100755
--- a/release/src-rt-5.04behnd.4916/router-sysdep.rt-be96u/wlan/scripts/bcm-wlan-drivers.sh
+++ b/release/src-rt-5.04behnd.4916/router-sysdep.rt-be96u/wlan/scripts/bcm-wlan-drivers.sh
@@ -34,8 +34,8 @@ fi
 
 # Allow wifi.sh script to correct dpd settings first
 /rom/etc/init.d/wifi.sh dpdmode 1
-DPDMODE=`sh /rom/etc/init.d/wifi.sh dpdmode |  cut -d '|' -f1`
-if [ -z $DPDMODE ]; then
+DPDMODE=`/bin/sh /rom/etc/init.d/wifi.sh dpdmode |  cut -d '|' -f1`
+if [ -z "$DPDMODE" ]; then
   DPDMODE=0
 fi
 echo "DPDMODE:$DPDMODE"
@@ -413,7 +413,7 @@ fi
 # Parse the first argument
 case "$1" in
     start)
-        if [ $ALLOW_LOAD_DRIVER_IN_BACKGROUND == "y" ]; then
+        if [ "$ALLOW_LOAD_DRIVER_IN_BACKGROUND" = "y" ]; then
             start_main &
         else
             start_main
diff --git a/release/src-rt-5.04behnd.4916/router-sysdep.rt-be96u/wlan/scripts/wifi.sh b/release/src-rt-5.04behnd.4916/router-sysdep.rt-be96u/wlan/scripts/wifi.sh
index 9423e5a519..7088523daa 100644
--- a/release/src-rt-5.04behnd.4916/router-sysdep.rt-be96u/wlan/scripts/wifi.sh
+++ b/release/src-rt-5.04behnd.4916/router-sysdep.rt-be96u/wlan/scripts/wifi.sh
@@ -123,7 +123,7 @@ wl_suspend()
 # - restart wlan configuration manager
 wl_resume()
 {
-  grep -e${mod// /.ko -e}.ko /rom/etc/init.d/bcm-base-drivers.sh | sh
+  grep -e${mod// /.ko -e}.ko /rom/etc/init.d/bcm-base-drivers.sh | /bin/sh
   /rom/etc/init.d/bcm-wlan-drivers.sh start
   nvram restart
 }
@@ -142,7 +142,7 @@ wl_mlo_unit()
   wlunit=$(echo $ifname | cut -d 'l' -f2)
   mlounit=$(echo $wl_mlo_config |  awk -v N=$((wlunit+1)) '{print $N}')
 
-  if [ -z $mlounit ]; then
+  if [ -z "$mlounit" ]; then
     mlounit=-1
   fi
 
@@ -234,12 +234,12 @@ wledpdctl_mlo_up()
           # Wait for MLC state to be MLC_SYNC or MLC_ACTIVE
           for i in $(seq 1 3); do
             mlc_state=$(wl -i $wlif mlc_state | cut -d ' ' -f1)
-            if [ $mlc_state = $MLC_SYNC ] || [ $mlc_state = $MLC_ACTIVE ]; then
+            if [ "$mlc_state" = "$MLC_SYNC" ] || [ "$mlc_state" = "$MLC_ACTIVE" ]; then
               break
             fi
             sleep 1
           done
-          if [ $mlc_state != $MLC_SYNC ] && [ $mlc_state != $MLC_ACTIVE ]; then
+          if [ "$mlc_state" != "$MLC_SYNC" ] && [ "$mlc_state" != "$MLC_ACTIVE" ]; then
             echo "WIFI.SH : WARN: $wlif is not in MLC_SYNC/ACTIVE state"
           fi
         fi
@@ -254,17 +254,17 @@ wledpdctl_mlo_up()
       # Wait for MLC state to be MLC_ACTIVE
       for i in $(seq 1 30); do
         mlc_state=$(wl -i $ifname mlc_state | cut -d ' ' -f1)
-        if [ $mlc_state = $MLC_ACTIVE ]; then
+        if [ "$mlc_state" = "$MLC_ACTIVE" ]; then
           break
         fi
         sleep 1
       done
-      if [ $mlc_state != $MLC_ACTIVE ]; then
+      if [ "$mlc_state" != "$MLC_ACTIVE" ]; then
          echo "WIFI.SH : ERROR: wl$wluint is not in MLC_ACTIVE state"
       fi
     fi
     mlc_state=$(wl -i wl$wl_mlo_mapunit mlc_state | cut -d ' ' -f1)
-    if [ $mlc_state = $MLC_ACTIVE ]; then
+    if [ "$mlc_state" = "$MLC_ACTIVE" ]; then
       echo "WIFI.SH : $ifname mlo up Success"
     fi
     touch /tmp/edpd_${ifname}_mloready
@@ -1158,7 +1158,7 @@ wldpdctl_mode()
     echo "    Restarting PCIe with correct settings     "
     echo "=============================================="
     rmmod -w bcm_pcie_hcd
-    grep -e bcm_pcie_hcd /rom/etc/init.d/bcm-base-drivers.sh | sh
+    grep -e bcm_pcie_hcd /rom/etc/init.d/bcm-base-drivers.sh | /bin/sh
   fi
 
   if [ $mode = $DPD_MODE_EDPD ] && [ $wl_mlo_mapunit != -1 ]; then
diff --git a/release/src-rt-5.04behnd.4916/router-sysdep.rt-be96u/wlan/scripts/wlinc.sh b/release/src-rt-5.04behnd.4916/router-sysdep.rt-be96u/wlan/scripts/wlinc.sh
index be903abb38..679ba638dc 100755
--- a/release/src-rt-5.04behnd.4916/router-sysdep.rt-be96u/wlan/scripts/wlinc.sh
+++ b/release/src-rt-5.04behnd.4916/router-sysdep.rt-be96u/wlan/scripts/wlinc.sh
@@ -382,7 +382,14 @@ setProcAffinity() {
     local proc_name=$2
     local pid=$3
     local affinity=$4
-    [[ $4 =~ ^[0-9]+$ ]] && affinity=`printf \%x $4`
+    # taskset expects a hex CPU mask; convert a decimal argument to hex.
+    # Use a POSIX all-digits test via case: /bin/bash is a busybox symlink on
+    # target firmware, and busybox ash's [[ ]] lacks the =~ regex operator
+    # (it errors with "[[: =~: unknown operand" and skips the conversion).
+    case "$4" in
+        ''|*[!0-9]*) ;;
+        *) affinity=`printf %x $4` ;;
+    esac
     echo "set $proc_name $pid to aff:$affinity"
     echo ""
     if [ ! -f "/bin/rtpolicy" ]; then
diff --git a/release/src-rt-5.04behnd.4916/targets/pakl/Broadcom-PAK_License-1296.Asus_BQ16_BQ16_PRO.bin b/release/src-rt-5.04behnd.4916/targets/pakl/Broadcom-PAK_License-1296.Asus_BQ16_BQ16_PRO.bin
