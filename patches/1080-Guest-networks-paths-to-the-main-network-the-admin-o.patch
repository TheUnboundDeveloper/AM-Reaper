+/* REAPER-AIMESH-MLO-BEGIN */
+/* reaper 2026-11-19 (v3.8.1 alpha field report: "devices connected as MLO are not showing in the AiMesh tab as
+ * MLO even when connected to the main router"). The AiMesh tab (aimesh_topology.html) and the stock client lists
+ * (client_function.js) read "mlo" from the get_clientlist hook - networkmap's closed list - and networkmap leaves it
+ * 0 for stations Reaper's own scan knows are MLO (the PSEUDO_MLO_CAP links cfg_mnt maps through mld_mac). The hook
+ * now only RAISES a row's "mlo" to "1" for such a device: a "1" is never cleared, no row is added, no other field
+ * changes. Host-tested by build-scripts/tests/test_aimesh_tab_mlo.py: json-c and libc only in this block. */
+#define RMLO_MAX 512
+struct rmlo_set {
+	char dev[RMLO_MAX][18];		/* device (MLD) MACs Reaper marks MLO - uppercase, sorted by rmlo_finish */
+	int ndev;
+	char link[RMLO_MAX][2][18];	/* per-link MAC -> its device MAC (cfg_mnt mld_mac), sorted by link MAC */
+	int nlink;
+};
+
+/* a MAC in the 17-char xx:xx:xx:xx:xx:xx shape, uppercased into out[18]; 0 for anything else */
+static int rmlo_norm(const char *in, char *out)
+{
+	int i;
+
+	if (!in || strlen(in) != 17)
+		return 0;
+	for (i = 0; i < 17; i++) {
+		unsigned char c = (unsigned char)in[i];
+
+		if ((i % 3 == 2) ? (c != ':') : !isxdigit(c))
+			return 0;
+		out[i] = (char)toupper(c);
+	}
+	out[17] = '\0';
+	return 1;
+}
+
+static void rmlo_reset(struct rmlo_set *s)
+{
+	s->ndev = 0;
+	s->nlink = 0;
+}
+
+/* full table = the rest is left out (those rows keep what networkmap said) */
+static void rmlo_add_dev(struct rmlo_set *s, const char *mac)
+{
+	if (s->ndev < RMLO_MAX && rmlo_norm(mac, s->dev[s->ndev]))
+		s->ndev++;
+}
+
+static void rmlo_add_link(struct rmlo_set *s, const char *link, const char *dev)
+{
+	if (s->nlink < RMLO_MAX && rmlo_norm(link, s->link[s->nlink][0]) && rmlo_norm(dev, s->link[s->nlink][1]))
+		s->nlink++;
