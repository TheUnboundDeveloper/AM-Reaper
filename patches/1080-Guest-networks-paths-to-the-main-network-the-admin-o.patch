+/* REAPER-GUEST-MDNS-BEGIN (reaper 2026-11-19; also compiled on the host by test_mdns_reflector.py) */
+/* apgN_rg_mdns -> the service types the reflector may relay for the network, ':'-joined into out; returns how many.
+ * A token is a preset or a type "_name._tcp" / "_name._udp" (name: 1-32 of a-z, 0-9, '-'); anything else is
+ * ignored. At most RG_MDNS_MAX types, no duplicates. "" = discovery off. */
+static const char *const rg_mdns_presets[][2] = {
+	{ "print", "_ipp._tcp,_ipps._tcp,_printer._tcp,_pdl-datastream._tcp,_uscan._tcp" },
+	{ "airplay", "_airplay._tcp,_raop._tcp" },
+	{ "cast", "_googlecast._tcp" },
+	{ "homekit", "_hap._tcp,_hap._udp,_matter._tcp,_matterc._udp" },
+	{ "audio", "_spotify-connect._tcp,_sonos._tcp" },
+};
+
+static int rg_mdns_type_ok(const char *s, size_t l)
+{
+	size_t i;
+
+	if (l < 7 || l > 38 || s[0] != '_' || (memcmp(s + l - 5, "._tcp", 5) && memcmp(s + l - 5, "._udp", 5)))
+		return 0;
+	for (i = 1; i < l - 5; i++)
+		if (!((s[i] >= 'a' && s[i] <= 'z') || (s[i] >= '0' && s[i] <= '9') || s[i] == '-'))
+			return 0;
+	return 1;
+}
+
+static int rg_mdns_add(char *out, size_t on, int n, const char *t, size_t l)
+{
+	const char *p, *q;
+	size_t ol = strlen(out), tl;
+
+	if (n >= RG_MDNS_MAX || !rg_mdns_type_ok(t, l))
+		return n;
+	for (p = out; *p; p = q + 1) {
+		q = strchr(p, ':');
+		tl = q ? (size_t)(q - p) : strlen(p);
+		if (tl == l && !memcmp(p, t, l))
+			return n;
+		if (!q)
+			break;
+	}
+	if (ol + l + 2 > on)
+		return n;
+	if (ol)
+		out[ol++] = ':';
+	memcpy(out + ol, t, l);
+	out[ol + l] = '\0';
+	return n + 1;
+}
+
+static int rg_mdns_types(const char *in, char *out, size_t on)
+{
+	const char *p = in, *e, *x, *y;
+	size_t l, k, np = sizeof(rg_mdns_presets) / sizeof(rg_mdns_presets[0]);
+	int n = 0;
+
+	if (!out || !on)
+		return 0;
+	out[0] = '\0';
+	while (p && *p) {
+		e = strchr(p, ',');
+		l = e ? (size_t)(e - p) : strlen(p);
+		for (k = 0; k < np; k++)
+			if (strlen(rg_mdns_presets[k][0]) == l && !memcmp(rg_mdns_presets[k][0], p, l))
+				break;
+		if (k < np)
+			for (x = rg_mdns_presets[k][1]; ; x = y + 1) {
+				y = strchr(x, ',');
+				n = rg_mdns_add(out, on, n, x, y ? (size_t)(y - x) : strlen(x));
+				if (!y)
+					break;
+			}
+		else
+			n = rg_mdns_add(out, on, n, p, l);
+		p = e ? e + 1 : NULL;
+	}
+	return n;
+}
