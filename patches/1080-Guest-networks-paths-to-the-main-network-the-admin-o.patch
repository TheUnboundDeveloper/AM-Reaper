+/* reaper 2026-11-19 (owner): reflect-guest. One entry "<ifname>:<type>:<type>..." per guest network; rc
+ * (generate_mdns_config) writes the types expanded and validated. Here the interface name must be 1-15 of
+ * [A-Za-z0-9._-]; a type must be _name._tcp or _name._udp (name 1-32 of [A-Za-z0-9-]); others are dropped with a
+ * warning, at most 32 types are kept. Returns a new string, or NULL when there is no usable interface name. */
+static int reaper_rg_type_ok(const char *t, size_t n) {
+    size_t k, d;
+
+    if (n < 7 || n > 38 || t[0] != '_')
+        return 0;
+    d = n - 5;
+    if (strncmp(t + d, "._tcp", 5) != 0 && strncmp(t + d, "._udp", 5) != 0)
+        return 0;
+    for (k = 1; k < d; k++)
+        if (!((t[k] >= 'a' && t[k] <= 'z') || (t[k] >= 'A' && t[k] <= 'Z') || (t[k] >= '0' && t[k] <= '9') || t[k] == '-'))
+            return 0;
+    return 1;
+}
+
+static char *reaper_rg_entry(const char *v) {
+    const char *c = strchr(v, ':'), *t, *e;
+    size_t il = c ? (size_t) (c - v) : strlen(v), k, tl;
+    unsigned n = 0;
+    char *out, *o;
+
+    if (il < 1 || il > 15)
+        return NULL;
+    for (k = 0; k < il; k++)
+        if (!((v[k] >= 'a' && v[k] <= 'z') || (v[k] >= 'A' && v[k] <= 'Z') || (v[k] >= '0' && v[k] <= '9') ||
+              v[k] == '.' || v[k] == '_' || v[k] == '-'))
+            return NULL;
+    if (!(out = avahi_new(char, strlen(v) + 1)))
+        return NULL;
+    memcpy(out, v, il);
+    o = out + il;
+    for (t = c; t; t = e) {
+        t++;
+        e = strchr(t, ':');
+        tl = e ? (size_t) (e - t) : strlen(t);
+        if (reaper_rg_type_ok(t, tl) && n < 32) {
+            *o++ = ':';
+            memcpy(o, t, tl);
+            o += tl;
+            n++;
+        } else if (tl)
+            avahi_log_warn("reflect-guest: service type \"%.*s\" for %.*s ignored", (int) tl, t, (int) il, v);
+    }
+    *o = 0;
+    return out;
+}
