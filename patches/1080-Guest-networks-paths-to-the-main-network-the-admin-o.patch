+
+/* REAPER-ZPOL-PURE-BEGIN (reaper 2026-11-19; compiled on the host by test_guest_cross_rc.py)
+ * The rules engine's zone policies as rc/reaper_fw.c rfw_emit_zpol() emits them: records "<src>dst>action" in list
+ * order, at most 64 (every record counts, as there); a zone "<name>iface,iface,...>comment" - the FIRST record of
+ * that name, at most 8 valid interfaces (a kernel name, or one ending in the '+' wildcard). A policy with an unknown
+ * action, a field too long or a zone without interfaces emits nothing in the engine and is left out here too; a pair
+ * of equal interfaces gets no rule. reaper_fw.c keeps its own parser (test_review_2026_11_18_batch.py extracts its
+ * rfw_field); test_guest_cross_rc.py runs both on the same lists. */
+#define RZP_MAX		64	/* RFW_MAX_ZPOL */
+#define RZP_IFMAX	8	/* RFW_MAX_IFACE */
+#define RZP_IFLEN	18	/* IFNAMSIZ + 2 */
+#define RZP_NAMELEN	27	/* RFW_NAME_MAX + 2 */
+#define RZP_REC		2048	/* rfw_find / rfw_zone_ifaces */
+struct reaper_zpol {
+	int n;
+	struct {
+		int act;	/* 1 accept, 2 drop, 3 reject */
+		int same;	/* source zone == destination zone */
+		int ns, nd;
+		char s[RZP_IFMAX][RZP_IFLEN], d[RZP_IFMAX][RZP_IFLEN];
+	} p[RZP_MAX];
+};
+
+static int rzp_field(const char *rec, int idx, char *out, size_t ol)
+{
+	const char *p = rec, *end;
+	size_t n;
+	int i;
+
+	out[0] = 0;
+	for (i = 0; i < idx; i++) {
+		if ((p = strchr(p, '>')) == NULL)
+			return 0;
+		p++;
+	}
+	end = strchr(p, '>');
+	n = end ? (size_t)(end - p) : strlen(p);
+	if (n >= ol)
+		return 0;
+	memcpy(out, p, n);
+	out[n] = 0;
+	return 1;
+}
+
+static int rzp_iface_ok(const char *s)
+{
+	const char *p;
+	size_t n = strlen(s);
+
+	if (n == 0 || n > 16)
+		return 0;
+	for (p = s; *p; p++) {
+		if (*p == '+') {
+			if (p[1])
+				return 0;
+			continue;
+		}
+		if (!((*p >= 'A' && *p <= 'Z') || (*p >= 'a' && *p <= 'z') || (*p >= '0' && *p <= '9') || *p == '.' || *p == '_'))
+			return 0;
+	}
+	return 1;
+}
+
+static int rzp_zone(const char *zone, const char *name, char ifs[][RZP_IFLEN])
+{
+	char *dup, *tok, *save = NULL, f0[RZP_NAMELEN], *list, *d2, *t2, *s2 = NULL;
+	int n = 0;
+
+	if (!zone || !*zone || !*name || (dup = strdup(zone)) == NULL)
+		return 0;
+	for (tok = strtok_r(dup, "<", &save); tok; tok = strtok_r(NULL, "<", &save)) {
+		if (!rzp_field(tok, 0, f0, sizeof(f0)) || strcmp(f0, name))
+			continue;
+		if (strlen(tok) < RZP_REC && (list = malloc(RZP_REC)) != NULL) {
+			if (rzp_field(tok, 1, list, RZP_REC) && (d2 = strdup(list)) != NULL) {
+				for (t2 = strtok_r(d2, ",", &s2); t2 && n < RZP_IFMAX; t2 = strtok_r(NULL, ",", &s2))
+					if (rzp_iface_ok(t2))
+						snprintf(ifs[n++], RZP_IFLEN, "%s", t2);
+				free(d2);
+			}
+			free(list);
+		}
+		break;
+	}
+	free(dup);
+	return n;
+}
+
+struct reaper_zpol *reaper_zpol_load(const char *zone, const char *zpol)
+{
+	struct reaper_zpol *z;
+	char *dup, *tok, *save = NULL, sz[RZP_NAMELEN], dz[RZP_NAMELEN], act[12];
+	int cnt = 0, a;
+
+	if (!zpol || !*zpol || (z = calloc(1, sizeof(*z))) == NULL)
+		return NULL;
+	if ((dup = strdup(zpol)) == NULL) {
+		free(z);
+		return NULL;
+	}
+	for (tok = strtok_r(dup, "<", &save); tok; tok = strtok_r(NULL, "<", &save)) {
+		if (++cnt > RZP_MAX)
+			break;
+		if (!rzp_field(tok, 0, sz, sizeof(sz)) || !rzp_field(tok, 1, dz, sizeof(dz)) || !rzp_field(tok, 2, act, sizeof(act)))
+			continue;
+		a = !strcmp(act, "accept") ? 1 : !strcmp(act, "drop") ? 2 : !strcmp(act, "reject") ? 3 : 0;
+		if (!a)
+			continue;
+		z->p[z->n].ns = rzp_zone(zone, sz, z->p[z->n].s);
+		z->p[z->n].nd = rzp_zone(zone, dz, z->p[z->n].d);
+		if (!z->p[z->n].ns || !z->p[z->n].nd)
+			continue;
+		z->p[z->n].act = a;
+		z->p[z->n].same = !strcmp(sz, dz);
+		z->n++;
+	}
+	free(dup);
+	return z;
+}
+
+static int rzp_match(const char *pat, const char *name)
+{
+	size_t l = strlen(pat);
+
+	return (l && pat[l - 1] == '+') ? !strncmp(pat, name, l - 1) : !strcmp(pat, name);
+}
+
+/* does the engine open a -> b: its FIRST zone-policy rule that matches the pair (wildcards as iptables reads them)
+ * must be an ACCEPT, of a policy between two different zones that names both interfaces itself. a and b are
+ * interface names, never a wildcard. */
+int reaper_zpol_open(const struct reaper_zpol *z, const char *a, const char *b)
+{
+	int k, i, j, hit, named;
+
+	if (!z || !a || !b || !*a || !*b || !strcmp(a, b) || strchr(a, '+') || strchr(b, '+'))
+		return 0;
+	for (k = 0; k < z->n; k++) {
+		for (hit = named = 0, i = 0; i < z->p[k].ns; i++)
+			for (j = 0; j < z->p[k].nd; j++) {
+				if (!strcmp(z->p[k].s[i], z->p[k].d[j]))
+					continue;	/* the engine emits no rule for it */
+				if (rzp_match(z->p[k].s[i], a) && rzp_match(z->p[k].d[j], b)) {
+					hit = 1;
+					if (!strcmp(z->p[k].s[i], a) && !strcmp(z->p[k].d[j], b))
+						named = 1;
+				}
+			}
+		if (hit)
+			return z->p[k].act == 1 && !z->p[k].same && named;
+	}
+	return 0;
+}
+/* REAPER-ZPOL-PURE-END */
