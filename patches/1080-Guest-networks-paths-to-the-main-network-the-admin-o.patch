diff --git a/release/src/router/avahi/avahi-core/server.c b/release/src/router/avahi/avahi-core/server.c
index 35ae9290bc..610d31062f 100644
--- a/release/src/router/avahi/avahi-core/server.c
+++ b/release/src/router/avahi/avahi-core/server.c
@@ -511,19 +511,322 @@ static int reflect_iface_ok(AvahiServer *s, AvahiInterface *i) {
     return 0;
 }
 
+/* REAPER-RGUEST-BEGIN reaper 2026-11-19 (owner): reflect-guest - device discovery between the main network and chosen
+ * guest networks, star only. An interface named in reflect-guest ("<ifname>:<type>:<type>...") is a GUEST interface;
+ * the interfaces in reflect-interfaces are the CORE (with reflect-guest set, an empty reflect-interfaces names none).
+ *   core <-> core   the reflect-interfaces rule above, unfiltered;
+ *   core <-> guest  reflected through THAT guest's service types, both directions;
+ *   guest <-> guest never; an interface in neither list never.
+ * The filter (only when one end is a guest): PTR whose owner is an allowed type (or its subtype) and whose target is
+ * an instance of it, or a type-enumeration PTR (_services._dns-sd._udp.local) whose target is an allowed type;
+ * SRV / TXT of an instance of an allowed type; A / AAAA only for a host that an allowed SRV record in the SENDING
+ * network's cache points at (never the router's own name); nothing else (HINFO, NSEC, CNAME, reverse PTR...).
+ * A type matches anchored: the name equals "<type>.local" or ends with ".<type>.local" after an unescaped dot, so
+ * _ipp._tcp never matches _ipps._tcp. Queries from either side cross only for such names (A / AAAA: an allowed host in
+ * the answering network's cache). The router's own records never go onto a guest interface (announce.c). With
+ * reflect-guest unset every function here reduces to reflect_iface_ok() on both ends: stock / 2026-11-14 behaviour. */
+
+#define RG_ENUM_NAME "_services._dns-sd._udp.local"
+
+/* mode 0: n is an instance of type t ("<label>.<t>.local", a subtype included); 1: that or n is "<t>.local";
+ * 2: only "<t>.local" */
+static int rg_name_is_type(const char *n, const char *t, size_t tl, int mode) {
+    size_t nl = strlen(n), k, b;
+
+    if (!tl || nl < tl + 6 || strcasecmp(n + nl - 6, ".local") != 0 || strncasecmp(n + nl - 6 - tl, t, tl) != 0)
+        return 0;
+    if (nl == tl + 6)
+        return mode != 0;
+    if (mode == 2)
+        return 0;
+    k = nl - 7 - tl;
+    if (k == 0 || n[k] != '.')
+        return 0;
+    for (b = 0; k > 0 && n[k - 1] == '\\'; k--)
+        b++;
+    return !(b & 1);
+}
+
+/* types = "<type>:<type>..." */
+static int rg_has_type(const char *types, const char *n, int mode) {
+    const char *t = types, *c;
+
+    while (t && *t) {
+        c = strchr(t, ':');
+        if (rg_name_is_type(n, t, c ? (size_t) (c - t) : strlen(t), mode))
+            return 1;
+        t = c ? c + 1 : NULL;
+    }
+    return 0;
+}
+
+/* an allowed SRV record in this cache points at host */
+static int rg_host_ok(AvahiCache *c, const char *types, const char *host) {
+    AvahiCacheEntry *e;
+
+    if (!c || !host)
+        return 0;
+    for (e = c->entries; e; e = e->entry_next)
+        if (e->record->key->type == AVAHI_DNS_TYPE_SRV && e->record->key->clazz == AVAHI_DNS_CLASS_IN &&
+            rg_has_type(types, e->record->key->name, 0) && avahi_domain_equal(e->record->data.srv.name, host))
+            return 1;
+    return 0;
+}
+
+/* may record r cross between a guest (types) and the core; src = the cache of the network it comes from,
+ * own = the router's host name */
+static int rg_record_ok(const char *types, AvahiRecord *r, AvahiCache *src, const char *own) {
+    const char *n = r->key->name;
+
+    if (r->key->clazz != AVAHI_DNS_CLASS_IN)
+        return 0;
+    switch (r->key->type) {
+        case AVAHI_DNS_TYPE_PTR:
+            if (strcasecmp(n, RG_ENUM_NAME) == 0)
+                return rg_has_type(types, r->data.ptr.name, 2);
+            return rg_has_type(types, n, 1) && rg_has_type(types, r->data.ptr.name, 0);
+        case AVAHI_DNS_TYPE_SRV:
+        case AVAHI_DNS_TYPE_TXT:
+            return rg_has_type(types, n, 0);
+        case AVAHI_DNS_TYPE_A:
+        case AVAHI_DNS_TYPE_AAAA:
+            if (own && avahi_domain_equal(n, own))
+                return 0;
+            return rg_host_ok(src, types, n);
+        default:
+            return 0;
+    }
+}
+
+/* may query key k cross between a guest (types) and the core; answering = the cache of the network it goes to */
+static int rg_key_ok(const char *types, AvahiKey *k, AvahiCache *answering) {
+    const char *n = k->name;
+
+    if (k->clazz != AVAHI_DNS_CLASS_IN && k->clazz != AVAHI_DNS_CLASS_ANY)
+        return 0;
+    if (rg_has_type(types, n, 1))
+        return 1;
+    if (strcasecmp(n, RG_ENUM_NAME) == 0)
+        return k->type == AVAHI_DNS_TYPE_PTR || k->type == AVAHI_DNS_TYPE_ANY;
+    if (k->type == AVAHI_DNS_TYPE_A || k->type == AVAHI_DNS_TYPE_AAAA || k->type == AVAHI_DNS_TYPE_ANY)
+        return rg_host_ok(answering, types, n);
+    return 0;
+}
+
+const char *avahi_reflect_guest_types(AvahiServer *s, AvahiInterface *i) {
+    AvahiStringList *l;
+    const char *n = i->hardware->name;
+    size_t nl = strlen(n);
+
+    for (l = s->config.reflect_guest; l; l = l->next)
+        if (l->size >= nl && strncasecmp((const char*) l->text, n, nl) == 0 && (l->size == nl || l->text[nl] == ':'))
+            return (const char*) l->text + (l->size == nl ? nl : nl + 1);
+    return NULL;
+}
+
+static int rg_core_ok(AvahiServer *s, AvahiInterface *i) {
+    return reflect_iface_ok(s, i) && (s->config.reflect_interfaces || !s->config.reflect_guest) &&
+        !avahi_reflect_guest_types(s, i);
+}
+
+/* the receiving end takes part at all */
+static int reflect_side_ok(AvahiServer *s, AvahiInterface *i) {
+    return rg_core_ok(s, i) || avahi_reflect_guest_types(s, i) != NULL;
+}
+
+/* i -> j allowed; *types = NULL unfiltered (core <-> core), else the guest end's service types */
+static int reflect_pair_ok(AvahiServer *s, AvahiInterface *i, AvahiInterface *j, const char **types) {
+    const char *gi = avahi_reflect_guest_types(s, i), *gj = avahi_reflect_guest_types(s, j);
+
+    *types = NULL;
+    if (gi && gj)
+        return 0;
+    if (gi || gj) {
+        if (!rg_core_ok(s, gi ? j : i))
+            return 0;
+        *types = gi ? gi : gj;
+        return 1;
+    }
+    return rg_core_ok(s, i) && rg_core_ok(s, j);
+}
+
+static void* rg_found_callback(AVAHI_GCC_UNUSED AvahiCache *c, AVAHI_GCC_UNUSED AvahiKey *pattern, AVAHI_GCC_UNUSED AvahiCacheEntry *e, void* userdata) {
+    return userdata;
+}
+
+/* a core interface's cache holds this name and type (owned by a main-network device) */
+static int rg_core_claims(AvahiServer *s, AvahiKey *k) {
+    AvahiInterface *x;
+
+    for (x = s->monitor->interfaces; x; x = x->interface_next)
+        if (x->cache && rg_core_ok(s, x) && avahi_cache_walk(x->cache, k, rg_found_callback, x))
+            return 1;
+    return 0;
+}
+
+/* a name this router publishes itself: its host name, its aliases (CNAMEs such as findasus.local), its service
+ * instances, its address records - every local entry, any type */
+static int rg_local_name(AvahiServer *s, const char *n) {
+    AvahiEntry *e;
+
+    if (!n)
+        return 0;
+    for (e = s->entries; e; e = e->entries_next)
+        if (avahi_domain_equal(e->record->key->name, n))
+            return 1;
+    return 0;
+}
+
+/* reaper 2026-11-19 (review): names seen on the main network during this daemon's life - A / AAAA owners, SRV
+ * targets, SRV / TXT instance names, PTR targets received on a CORE interface (only while reflect-guest is set). A
+ * main device's record leaves the router's cache after its TTL while main clients may still hold it; a guest must not
+ * take such a name either. Fixed size (RG_SEEN_MAX), FIFO replacement, lower-case copies, freed with the server. */
+#define RG_SEEN_MAX 512
+
+struct RgSeen {
+    unsigned next;
+    unsigned hash[RG_SEEN_MAX];
+    char *name[RG_SEEN_MAX];
+};
+
+static unsigned rg_seen_hash(const char *n) {
+    unsigned h = 2166136261U;
+
+    for (; *n; n++)
+        h = (h ^ (unsigned char) (*n >= 'A' && *n <= 'Z' ? *n + 32 : *n)) * 16777619U;
+    return h;
+}
+
+static int rg_seen_has(AvahiServer *s, const char *n) {
+    unsigned h, k;
+
+    if (!s->reaper_rg_seen || !n)
+        return 0;
+    h = rg_seen_hash(n);
+    for (k = 0; k < RG_SEEN_MAX; k++)
+        if (s->reaper_rg_seen->name[k] && s->reaper_rg_seen->hash[k] == h && strcasecmp(s->reaper_rg_seen->name[k], n) == 0)
+            return 1;
+    return 0;
+}
+
+static void rg_seen_add(AvahiServer *s, const char *n) {
+    struct RgSeen *t;
+    char *c, *p;
+
+    if (!n || !*n || rg_seen_has(s, n))
+        return;
+    if (!s->reaper_rg_seen && !(s->reaper_rg_seen = avahi_new0(struct RgSeen, 1)))
+        return;
+    if (!(c = avahi_strdup(n)))
+        return;
+    for (p = c; *p; p++)
+        if (*p >= 'A' && *p <= 'Z')
+            *p += 32;
+    t = s->reaper_rg_seen;
+    avahi_free(t->name[t->next]);
+    t->name[t->next] = c;
+    t->hash[t->next] = rg_seen_hash(c);
+    t->next = (t->next + 1) % RG_SEEN_MAX;
+}
+
+/* a record received on a core interface (handle_response_packet): remember the names it holds */
+static void rg_seen_note(AvahiServer *s, AvahiInterface *i, AvahiRecord *r) {
+    if (!s->config.enable_reflector || !s->config.reflect_guest || r->key->clazz != AVAHI_DNS_CLASS_IN || !rg_core_ok(s, i))
+        return;
+    switch (r->key->type) {
+        case AVAHI_DNS_TYPE_A:
+        case AVAHI_DNS_TYPE_AAAA:
+        case AVAHI_DNS_TYPE_TXT:
+            rg_seen_add(s, r->key->name);
+            break;
+        case AVAHI_DNS_TYPE_SRV:
+            rg_seen_add(s, r->key->name);
+            rg_seen_add(s, r->data.srv.name);
+            break;
+        case AVAHI_DNS_TYPE_PTR:
+            if (strcasecmp(r->key->name, RG_ENUM_NAME) != 0)
+                rg_seen_add(s, r->data.ptr.name);
+            break;
+        default:
+            break;
+    }
+}
+
+static void rg_seen_free(AvahiServer *s) {
+    unsigned k;
+
+    if (!s->reaper_rg_seen)
+        return;
+    for (k = 0; k < RG_SEEN_MAX; k++)
+        avahi_free(s->reaper_rg_seen->name[k]);
+    avahi_free(s->reaper_rg_seen);
+    s->reaper_rg_seen = NULL;
+}
+
+static void* rg_same_callback(AVAHI_GCC_UNUSED AvahiCache *c, AVAHI_GCC_UNUSED AvahiKey *pattern, AvahiCacheEntry *e, void* userdata) {
+    return avahi_record_equal_no_ttl(e->record, userdata) ? e : NULL;
+}
+
+/* the instance a PTR names is held on the main network: an SRV or TXT for it in a core cache (no memory = held) */
+static int rg_core_holds_instance(AvahiServer *s, const char *n) {
+    AvahiKey *k;
+    int held;
+
+    if (!(k = avahi_key_new(n, AVAHI_DNS_CLASS_IN, AVAHI_DNS_TYPE_SRV)))
+        return 1;
+    held = rg_core_claims(s, k);
+    avahi_key_unref(k);
+    if (held)
+        return 1;
+    if (!(k = avahi_key_new(n, AVAHI_DNS_CLASS_IN, AVAHI_DNS_TYPE_TXT)))
+        return 1;
+    held = rg_core_claims(s, k);
+    avahi_key_unref(k);
+    return held;
+}
+
+/* record r crossing a guest boundary (gt = the guest's types): the filter; and from a guest never a name this router
+ * publishes (as the owner or as an SRV / PTR target) and never a unique name a main-network device holds in a core
+ * cache or seen there (rg_seen_*), and no goodbye for what it did not announce. A PTR owner is a shared type name the router may publish too (_ipp._tcp): there the target (an instance)
+ * decides; a type-enumeration PTR points at a shared type name, which the router may publish as well. */
+static int rg_cross_ok(AvahiServer *s, const char *gt, AvahiRecord *r, AvahiCache *from, int from_guest) {
+    if (!rg_record_ok(gt, r, from, s->host_name_fqdn))
+        return 0;
+    if (!from_guest)
+        return 1;
+    /* a goodbye (TTL 0) only for a record this guest network announced itself (in its own cache) */
+    if (r->ttl == 0 && !(from && avahi_cache_walk(from, r->key, rg_same_callback, r)))
+        return 0;
+    if (r->key->type == AVAHI_DNS_TYPE_PTR)
+        return strcasecmp(r->key->name, RG_ENUM_NAME) == 0 ||
+            (!rg_local_name(s, r->data.ptr.name) && !rg_seen_has(s, r->data.ptr.name) &&
+             !rg_core_holds_instance(s, r->data.ptr.name));
+    if (r->key->type == AVAHI_DNS_TYPE_SRV && (rg_local_name(s, r->data.srv.name) || rg_seen_has(s, r->data.srv.name)))
+        return 0;
+    return !rg_local_name(s, r->key->name) && !rg_seen_has(s, r->key->name) && !rg_core_claims(s, r->key);
+}
+/* REAPER-RGUEST-END */
+
 static void reflect_response(AvahiServer *s, AvahiInterface *i, AvahiRecord *r, int flush_cache) {
     AvahiInterface *j;
+    const char *gt;
+    int gi;
 
     assert(s);
     assert(i);
     assert(r);
 
-    if (!s->config.enable_reflector || !reflect_iface_ok(s, i))
+    if (!s->config.enable_reflector || !reflect_side_ok(s, i))
         return;
 
+    /* reaper 2026-11-19: a guest's record reaches the main network WITHOUT the cache-flush bit, so a name the checks
+     * cannot see (a main device's record already expired from the cache) can never evict the real owner's records */
+    gi = avahi_reflect_guest_types(s, i) != NULL;
+
     for (j = s->monitor->interfaces; j; j = j->interface_next)
-        if (j != i && reflect_iface_ok(s, j) && (s->config.reflect_ipv || j->protocol == i->protocol))
-            avahi_interface_post_response(j, r, flush_cache, NULL, 1);
+        if (j != i && reflect_pair_ok(s, i, j, &gt) && (s->config.reflect_ipv || j->protocol == i->protocol) &&
+            (!gt || rg_cross_ok(s, gt, r, i->cache, gi)))
+            avahi_interface_post_response(j, r, gi ? 0 : flush_cache, NULL, 1);
 }
 
 static void* reflect_cache_walk_callback(AvahiCache *c, AvahiKey *pattern, AvahiCacheEntry *e, void* userdata) {
@@ -546,40 +849,83 @@ static void* reflect_cache_walk_callback(AvahiCache *c, AvahiKey *pattern, Avahi
     return NULL;
 }
 
+/* reaper 2026-11-19: reflect-guest - a cache answer crosses into or out of a guest network only through its filter */
+struct rg_walk {
+    AvahiServer *server;
+    const char *types;
+    int from_guest;
+};
+
+static void* rg_cache_walk_callback(AvahiCache *c, AvahiKey *pattern, AvahiCacheEntry *e, void* userdata) {
+    struct rg_walk *w = userdata;
+    AvahiRecord *r;
+
+    assert(w);
+    assert(e);
+
+    if (!rg_cross_ok(w->server, w->types, e->record, c, w->from_guest))
+        return NULL;
+    if (!w->from_guest)
+        return reflect_cache_walk_callback(c, pattern, e, w->server);
+
+    /* from a guest cache: as reflect_cache_walk_callback, but never with the cache-flush bit */
+    r = e->record;
+    if ((r->key->type == AVAHI_DNS_TYPE_AAAA) &&
+            (r->data.aaaa.address.address[0] == 0xFE) &&
+            (r->data.aaaa.address.address[1] == 0x80))
+        return NULL;
+    avahi_record_list_push(w->server->record_list, r, 0, 0, 0);
+    return NULL;
+}
+
 static void reflect_query(AvahiServer *s, AvahiInterface *i, AvahiKey *k) {
     AvahiInterface *j;
+    const char *gt;
