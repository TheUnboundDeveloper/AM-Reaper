+++ b/release/src/router/avahi/avahi-core/announce.c
@@ -239,6 +239,13 @@ static void new_announcer(AvahiServer *s, AvahiInterface *i, AvahiEntry *e) {
     if (!avahi_interface_match(i, e->interface, e->protocol) || !i->announcing || !avahi_entry_is_commited(e))
         return;
 
+    /* reaper 2026-11-19 (owner): reflect-guest. The router's own records (its host name, its addresses, its service
