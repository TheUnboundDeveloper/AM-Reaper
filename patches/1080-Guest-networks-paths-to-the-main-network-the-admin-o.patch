+			if (!row || !json_object_is_type(row, json_type_object) || !rmlo_hit(s, key))
+				continue;
+			cur = (json_object_object_get_ex(row, "mlo", &o) && o) ? json_object_get_string(o) : NULL;
+			if (cur && !strcmp(cur, "1"))
+				continue;
+			json_object_object_add(row, "mlo", json_object_new_string("1"));
+			marked++;
+		}
+	}
