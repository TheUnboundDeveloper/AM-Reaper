+/* the chosen devices of one network -> their IPv4 addresses (out, at most max, no duplicates); returns how many.
+ * devs is apgN_rg_devs ("<MAC><MAC>..."), stl dhcp_staticlist ("<MAC>IP>DNS>name"), static_on dhcp_static_x == 1,
+ * lanip / lanmask the main LAN, aim[0..naim-1] the AiMesh node MACs (reaper_aimesh_macs). A device is used only
+ * when it has a reservation, reservations are on, the address is inside the LAN subnet and is neither the router's
+ * own nor the subnet's network / broadcast address, and it is not an AiMesh node. Each one left out is named in
+ * skip ("<mac> <why>, ..."); an entry that is not a MAC is never echoed. */
+static int rg_dev_resolve(const char *devs, const char *stl, int static_on, const char *lanip, const char *lanmask,
