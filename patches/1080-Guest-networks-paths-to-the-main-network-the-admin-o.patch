+			continue;
+		}
+		if (++seen > RG_DEV_MAX || n >= max) {
+			rg_note(skip, sn, "devices", 7, "past the first 16 ignored");
+			break;
+		}
+		if (!rg_mac_ok(p, len)) {
+			rg_note(skip, sn, "an entry", 8, "that is not a MAC address");
+			p = e;
+			continue;
+		}
+		if (!static_on) {
+			rg_note(skip, sn, p, 17, "(DHCP reservations are off)");
+			p = e;
+			continue;
+		}
+		ips[0] = '\0';
+		for (hit = 0, r = stl; r && *r && !hit; r = re) {
+			if (*r == '<')
