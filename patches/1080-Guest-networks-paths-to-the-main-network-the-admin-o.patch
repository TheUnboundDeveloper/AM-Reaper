+
+/* both tables start each entry with a NUL-terminated MAC: one compare serves the sort and the lookups */
+static int rmlo_cmp(const void *a, const void *b)
+{
+	return strcmp((const char *)a, (const char *)b);
+}
+
+static void rmlo_finish(struct rmlo_set *s)
+{
+	if (s->ndev > 1)
+		qsort(s->dev, s->ndev, sizeof(s->dev[0]), rmlo_cmp);
+	if (s->nlink > 1)
