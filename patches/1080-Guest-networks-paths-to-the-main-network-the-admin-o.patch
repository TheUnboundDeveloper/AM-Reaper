+			f = strchr(r, '>');
+			if (!f || (re && f > re) || !rg_mac_ok(r, (size_t)(f - r)) || !rg_mac_eq(r, p))
+				continue;
+			hit = 1;
+			f++;
+			fe = strchr(f, '>');
+			if (re && (!fe || fe > re))
+				fe = re;
+			fl = fe ? (size_t)(fe - f) : strlen(f);
+			if (fl > 0 && fl < 16) {
+				memcpy(ips, f, fl);
+				ips[fl] = '\0';
+			}
+		}
+		if (!hit)
+			rg_note(skip, sn, p, 17, "(no DHCP reservation)");
+		else if (!ips[0] || strchr(ips, '/') || !rg_cidr4(ips, &ip, &lp) || lp != 32 || !lm || (ip & lm) != (la & lm) ||
+			 ip == la || (ip & ~lm) == 0 || (ip | lm) == 0xffffffffU)
+			rg_note(skip, sn, p, 17, "(reserved address is not a device address on the main LAN)");
+		else {
+			for (k = 0; k < naim && !(strlen(aim[k]) == 17 && rg_mac_eq(aim[k], p)); k++)
+				;
+			if (k < naim)
+				rg_note(skip, sn, p, 17, "(an AiMesh node)");
+			else {
+				for (k = 0; k < n && strcmp(out[k], ips); k++)
+					;
+				if (k == n)
+					snprintf(out[n++], 16, "%s", ips);
+			}
+		}
+		p = e;
+	}
+	return n;
+}
