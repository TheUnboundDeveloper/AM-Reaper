 #endif
 
+#ifdef RTCONFIG_MULTILAN_CFG
+/* REAPER-BRPORT-WIRED-BEGIN */
+/*
+ * 2026-11-19 (owner): AP Isolation is a choice per network - Off / Wi-Fi only (default) / Wi-Fi and LAN ports.
+ * The switch is the stock one (wlN_ap_isolate, apmN_ap_isolate for the main network, apgN_ap_isolate for the others);
+ * the LAN choice is reaper_ap_isolate_lan (main network) / apgN_ap_isolate_lan (the others): "1" = Wi-Fi and LAN
+ * ports, anything else = Wi-Fi only. Wired = a bridge member that is not Wi-Fi (Wi-Fi = name wl* / wds*, or the
+ * netdev has sysfs wireless/ or phy80211). Isolated bridge ports never forward to each other.
+ * Since GPL 102.40585 the firmware isolates wired members too: after apg_start() / apg_create_vlan_for_lan() with
+ * a main Wi-Fi interface's ap_isolate on, the wired LAN ports of the main bridge read brport/isolated = 1 in sysfs,
+ * and a guest bridge's wired trunk VLAN members are isolated while that network's switch is on. The GPL 102_39274
+ * objects of the 3006.102.8 line never isolate a wired member. After each of those calls this helper makes
+ * both lines follow the choice, per bridge:
+ *  - isolation on, Wi-Fi only, MAIN bridge: every wired member open (0) - the owner's case (a wired TV and a wired
+ *    NAS). That includes a wired AiMesh backhaul port, so Wi-Fi clients of different nodes can reach each other on
+ *    the main network: the accepted trade-off;
+ *  - isolation on, Wi-Fi only, another bridge: every wired ACCESS member open (0); a VLAN trunk member (a name with a
+ *    dot - the trunk to an AiMesh node or a switch) is left exactly as the firmware set it, which keeps Wi-Fi guests of
+ *    different nodes apart on 102.10 (isolated there while the switch is on) and is untouched on 102.8;
+ *  - isolation on, Wi-Fi and LAN ports: every wired member isolated (1), except the WAN ports (wan_ifnames,
+ *    wan0..3_ifname, autowan_detected_ifname; outside router mode also the uplink: eth_ifnames, sta_*), a VLAN trunk
+ *    member (a name with a dot: it may lead to an AiMesh node) and a port an AiMesh node is learned on (the bridge
+ *    forwarding table against the cfg_relist MACs): those are left as they are, unless this helper isolated them;
+ *  - isolation off: wired members are left as they are, except the ones this helper isolated (opened again);
+ *  - never touched: a bridge of a Guest Portal, of a network with VLAN port isolation (vlan_rl port_isolation=1, the
+ *    admin's own wired isolation) or of MAINBH (AiMesh backhaul), and a bridge of no enabled network. The main bridge
+ *    is always planned (owner). Wi-Fi members are never written. nvram is never changed.
+ * On an AiMesh node (re_mode) it does nothing at all: the choice keys do not sync to nodes, so a node keeps the
+ * firmware's own behaviour. Isolation the firmware programs inside an external switch chip is not changed here:
+ * only the bridge flags are.
+ * REAPER_BRPORT_STATE lists the ports this helper isolated ("<bridge> <port>" lines); it lives in RAM, like the flags.
+ * After apg_stop() / apg_destory_vlan_for_lan() the flags read cleared, and apg_hotplug_net() only touches wds
+ * interfaces, so they need no call. The rwatch tick runs it again through the reaper_brport applet, only while a
+ * network has its switch on with Wi-Fi and LAN ports (an AiMesh node is in the forwarding table only once it talks;
+ * at boot its port may not be known yet). Runs serialize on file_lock("reaper_brport"), a leaf lock: nothing is
+ * called under it that takes another lock.
+ */
+#ifndef REAPER_BRPORT_SYSFS
+#define REAPER_BRPORT_SYSFS	"/sys/class/net"
+#endif
+#ifndef REAPER_BRPORT_STATE_DIR
+#define REAPER_BRPORT_STATE_DIR	REAPER_TMPDIR
+#endif
+#ifndef REAPER_BRPORT_STATE
+#define REAPER_BRPORT_STATE	REAPER_TMPDIR "/brport_iso"
+#endif
+#ifndef REAPER_BRPORT_NETS
+#define REAPER_BRPORT_NETS	MTLAN_MAXINUM
+#endif
+#define REAPER_BRPORT_MAX	64
+#define REAPER_BRPORT_NODES	64
+
+/* REAPER-BRPORT-PURE-BEGIN */
+enum { RBP_KEEP = 0, RBP_OPEN, RBP_CLOSE, RBP_OFF, RBP_OPENG };	/* OPENG: Wi-Fi only on a bridge other than the main */
+
+struct reaper_brport {
+	char name[16];
+	int wireless;	/* 1 = Wi-Fi member (name or sysfs test) */
+	int isolated;	/* brport isolated flag: 1, 0, or -1 = unreadable */
+	int excluded;	/* uplink / WAN, VLAN trunk or AiMesh node port: never isolated by this helper */
+	int ours;	/* this helper isolated it (REAPER_BRPORT_STATE) */
+	int port;	/* brport port_no, -1 = unknown */
+	int trunk;	/* a VLAN trunk member (a name with a dot) */
+};
+
+struct reaper_brnet {
+	char br[16];	/* the network's bridge (its own, or the main bridge it rides) */
+	int enable;	/* 1 = enabled */
+	int portal;	/* a Guest Portal network */
+	int port_iso;	/* vlan_rl port_isolation (VLAN profile wired isolation) */
+	int mainbh;	/* the AiMesh backhaul network */
+	int ap_iso;	/* its AP Isolation switch is on */
+	int lan_iso;	/* its choice is Wi-Fi and LAN ports */
+};
+
+struct reaper_brplan {
+	char br[16];
+	int act;	/* RBP_OPEN / RBP_OPENG / RBP_CLOSE / RBP_OFF */
+};
+
+/* Wi-Fi by name: wl0, wl0.1, wl1.2 ... and wds0.0.1 ... (wireless backhaul) */
+static int reaper_brport_wl_name(const char *name)
+{
+	return strncmp(name, "wl", 2) == 0 || strncmp(name, "wds", 3) == 0;
+}
+
+/* name is a word of the space-separated list */
+static int reaper_brport_listed(const char *list, const char *name)
+{
+	size_t l = strlen(name);
+	const char *p = list;
+
+	if (!l)
+		return 0;
+	while (p && *p) {
+		while (*p == ' ')
+			p++;
+		if (!strncmp(p, name, l) && (p[l] == ' ' || p[l] == '\0'))
+			return 1;
+		p = strchr(p, ' ');
+	}
+	return 0;
+}
+
+/* one member under the bridge's plan: 0 = leave, 1 = write 0 (open), 2 = write 1 (isolate) */
+static int reaper_brport_member(int act, const struct reaper_brport *m)
+{
+	if (!m->name[0] || m->wireless || reaper_brport_wl_name(m->name) || m->isolated < 0)
+		return 0;
+	if (act == RBP_OPEN)
+		return m->isolated == 1 ? 1 : 0;
+	if (act == RBP_OPENG)	/* a trunk stays as the firmware set it (Wi-Fi isolation across AiMesh nodes) */
+		return (m->isolated == 1 && !m->trunk) ? 1 : 0;
+	if (act == RBP_CLOSE) {
+		if (m->excluded)
+			return (m->ours && m->isolated == 1) ? 1 : 0;
+		return m->isolated == 0 ? 2 : 0;
+	}
+	if (act == RBP_OFF)
+		return (m->ours && m->isolated == 1) ? 1 : 0;
+	return 0;
+}
+
+/* The bridges and what to do on each: the main bridge first, always (its switch: main_on or a network riding it with
+ * its switch on; its choice: main_lan); then each other bridge of an enabled network, once, unless any enabled network
+ * on it is a portal, sets VLAN port isolation or is MAINBH. Wi-Fi and LAN ports when a network on the bridge with its
+ * switch on chose it. */
+static int reaper_brport_plan(const char *lan, int main_on, int main_lan, const struct reaper_brnet *nw, int n,
+			      struct reaper_brplan *out, int max)
+{
+	int i, j, k, cnt = 0, keep, on, lanm;
+
+	if (!lan[0] || max < 1)
+		return 0;
+	on = main_on;
+	for (j = 0; j < n; j++)
+		if (nw[j].enable == 1 && !strcmp(nw[j].br, lan) && nw[j].ap_iso && !nw[j].mainbh)	/* never MAINBH */
+			on = 1;
+	snprintf(out[cnt].br, sizeof(out[cnt].br), "%s", lan);
+	out[cnt++].act = on ? (main_lan ? RBP_CLOSE : RBP_OPEN) : RBP_OFF;
+	for (i = 0; i < n && cnt < max; i++) {
+		if (nw[i].enable != 1 || !nw[i].br[0] || !strcmp(nw[i].br, lan))
+			continue;
+		for (k = 0; k < cnt && strcmp(out[k].br, nw[i].br); k++)
+			;
+		if (k < cnt)
+			continue;
+		keep = on = lanm = 0;
+		for (j = 0; j < n; j++) {
+			if (nw[j].enable != 1 || strcmp(nw[j].br, nw[i].br))
+				continue;
+			if (nw[j].portal || nw[j].port_iso == 1 || nw[j].mainbh)
+				keep = 1;
+			if (nw[j].ap_iso) {
+				on = 1;
+				if (nw[j].lan_iso)
+					lanm = 1;
+			}
+		}
+		if (keep)
+			continue;
+		snprintf(out[cnt].br, sizeof(out[cnt].br), "%s", nw[i].br);
+		out[cnt++].act = on ? (lanm ? RBP_CLOSE : RBP_OPENG) : RBP_OFF;
+	}
+	return cnt;
+}
+
+/* the bridge ports an AiMesh node is learned on: buf = struct __fdb_entry records (16 bytes: mac[6], port_no,
+ * is_local, ageing[4], port_hi, pad, unused[2]); nodes = 6-byte MACs */
+static int reaper_brport_fdb_ports(const unsigned char *buf, size_t len, const unsigned char (*nodes)[6], int nn,
+				   int *ports, int max)
+{
+	size_t o;
+	int i, k, c = 0, p;
+
+	for (o = 0; o + 16 <= len; o += 16) {
+		const unsigned char *e = buf + o;
+
+		if (e[7])
+			continue;	/* the bridge's own address */
+		for (i = 0; i < nn && memcmp(e, nodes[i], 6); i++)
+			;
+		if (i == nn)
+			continue;
+		p = (e[12] << 8) | e[6];
+		for (k = 0; k < c && ports[k] != p; k++)
+			;
+		if (k == c && c < max)
+			ports[c++] = p;
+	}
+	return c;
+}
+/* REAPER-BRPORT-PURE-END */
+
+struct reaper_brctx {
+	const char *uplink;	/* the uplink / WAN interface names */
+	const char *state;	/* "\n<bridge> <port>\n..." - what this helper isolated */
+	const unsigned char (*nodes)[6];
+	int nn;
+	char nstate[2048];
+	size_t nsl;
+	char names[128];
+	size_t nl;
+	int more, opened, closed;
+};
+
+static int reaper_brport_has(const char *ifname, const char *leaf)
+{
+	char p[128];
+
+	snprintf(p, sizeof(p), REAPER_BRPORT_SYSFS "/%s/%s", ifname, leaf);
+	return access(p, F_OK) == 0;
+}
+
+static void reaper_brport_name(struct reaper_brctx *x, const char *br, int *first, char sign, const char *name)
+{
+	if (x->nl + strlen(br) + strlen(name) + 4 < sizeof(x->names) - 4) {
+		x->nl += snprintf(x->names + x->nl, sizeof(x->names) - x->nl, "%s%s%s%c%s",
+			x->nl ? (*first ? " " : ",") : "", *first ? br : "", *first ? ":" : "", sign, name);
+		*first = 0;
+	} else
+		x->more = 1;
+}
+
+/* one bridge under its plan */
+static void reaper_brport_bridge(const char *br, int act, struct reaper_brctx *x)
+{
+	struct reaper_brport m[REAPER_BRPORT_MAX];
+	int nports[REAPER_BRPORT_MAX];
+	unsigned char fdb[16 * 128];
+	char p[160], v[16], key[48];
+	struct dirent *de;
+	DIR *d;
+	FILE *fp;
+	ssize_t r;
+	int n = 0, i, k, fd, np = 0, first = 1, todo, chunks = 0;
+
+	if (!br[0] || strlen(br) >= sizeof(m[0].name) || strchr(br, '/') || br[0] == '.')
+		return;
+	snprintf(p, sizeof(p), REAPER_BRPORT_SYSFS "/%s/brif", br);
+	if ((d = opendir(p)) == NULL)
+		return;	/* no such bridge, or no sysfs */
+	while (n < REAPER_BRPORT_MAX && (de = readdir(d)) != NULL) {
+		if (de->d_name[0] == '.' || strlen(de->d_name) >= sizeof(m[n].name))
+			continue;
+		memset(&m[n], 0, sizeof(m[n]));
+		snprintf(m[n].name, sizeof(m[n].name), "%s", de->d_name);
+		m[n].wireless = reaper_brport_wl_name(m[n].name)
+			|| reaper_brport_has(m[n].name, "wireless") || reaper_brport_has(m[n].name, "phy80211");
+		m[n].isolated = -1;
+		m[n].port = -1;
+		m[n].trunk = strchr(m[n].name, '.') != NULL;
+		/* brif/<port> is the port's brport directory: the flag is read and written on THIS bridge only */
+		snprintf(p, sizeof(p), REAPER_BRPORT_SYSFS "/%s/brif/%s/isolated", br, m[n].name);
+		if ((fp = fopen(p, "r")) != NULL) {
+			if (fgets(v, sizeof(v), fp) != NULL)
+				m[n].isolated = (v[0] == '1') ? 1 : ((v[0] == '0') ? 0 : -1);
+			fclose(fp);
+		}
+		snprintf(key, sizeof(key), "\n%s %s\n", br, m[n].name);
+		m[n].ours = strstr(x->state, key) != NULL;
+		n++;
+	}
+	closedir(d);
+	if (act == RBP_CLOSE) {
+		if (x->nn > 0) {
+			snprintf(p, sizeof(p), REAPER_BRPORT_SYSFS "/%s/brforward", br);
+			if ((fd = open(p, O_RDONLY)) >= 0) {
+				while (chunks++ < 32 && (r = read(fd, fdb, sizeof(fdb))) > 0)
+					np += reaper_brport_fdb_ports(fdb, (size_t)r, x->nodes, x->nn, nports + np,
+								      REAPER_BRPORT_MAX - np);
+				close(fd);
+			}
+		}
+		for (i = 0; i < n; i++) {
+			snprintf(p, sizeof(p), REAPER_BRPORT_SYSFS "/%s/brif/%s/port_no", br, m[i].name);
+			if ((fp = fopen(p, "r")) != NULL) {
+				if (fgets(v, sizeof(v), fp) != NULL)
+					m[i].port = (int)strtol(v, NULL, 0);
+				fclose(fp);
+			}
+			m[i].excluded = reaper_brport_listed(x->uplink, m[i].name) || m[i].trunk;
+			for (k = 0; k < np && !m[i].excluded; k++)
+				if (m[i].port >= 0 && nports[k] == m[i].port)
+					m[i].excluded = 1;
+		}
+	}
+	for (i = 0; i < n; i++) {
+		todo = reaper_brport_member(act, &m[i]);
+		if (todo) {
+			snprintf(p, sizeof(p), REAPER_BRPORT_SYSFS "/%s/brif/%s/isolated", br, m[i].name);
+			if ((fd = open(p, O_WRONLY)) >= 0) {
+				if (write(fd, todo == 2 ? "1" : "0", 1) == 1) {
+					m[i].isolated = (todo == 2) ? 1 : 0;
+					if (todo == 2)
+						x->closed++;
+					else
+						x->opened++;
+					reaper_brport_name(x, br, &first, todo == 2 ? '+' : '-', m[i].name);
+				}
+				close(fd);
+			}
+		}
+		/* remembered: what stays isolated under Wi-Fi and LAN ports, apart from the excluded ports */
+		if (act == RBP_CLOSE && !m[i].excluded && !m[i].wireless && !reaper_brport_wl_name(m[i].name) &&
+		    m[i].isolated == 1 && x->nsl + strlen(br) + strlen(m[i].name) + 3 < sizeof(x->nstate))
+			x->nsl += snprintf(x->nstate + x->nsl, sizeof(x->nstate) - x->nsl, "%s %s\n", br, m[i].name);
+	}
+}
+
+static int reaper_brport_nv1(const char *key)
+{
+	return strcmp(nvram_safe_get(key), "1") == 0;	/* "1" only; anything else = off / Wi-Fi only */
+}
+
+/* REAPER-BRPORT-NETS-BEGIN */
+/* the networks and their bridges (get_mtlan); a portal = a Captive Portal profile (cp_type 1, 2 or 4; an
+ * unreadable profile counts as a portal - left alone) */
+static int reaper_brport_nets(const char *lan, struct reaper_brnet *nw, int max)
+{
+	MTLAN_T *pmtl;
+	CP_TYPE_RL cpt;
+	char key[48];
+	size_t sz = 0, i;
+	int n = 0;
+
+	if ((pmtl = (MTLAN_T *)INIT_MTLAN(sizeof(MTLAN_T))) == NULL)
+		return 0;
+	if (get_mtlan(pmtl, &sz)) {
+		for (i = 0; i < sz && n < max; i++) {
+			const MTLAN_T *m = &pmtl[i];
+
+			memset(&nw[n], 0, sizeof(nw[n]));
+			snprintf(nw[n].br, sizeof(nw[n].br), "%s", m->nw_t.br_ifname[0] ? m->nw_t.br_ifname : lan);
+			nw[n].enable = (m->enable == 1) ? 1 : 0;
+			nw[n].port_iso = m->port_isolation;
+			nw[n].mainbh = !strcmp(m->name, "MAINBH");
+			if (m->sdn_t.apg_idx > 0) {
+				/* MAINFH and MAINBH are apm networks (sdn.js); their apg index means nothing. The LAN choice
+				 * of MAINFH is the main network's (reaper_ap_isolate_lan); MAINBH is never planned. */
+				int apm = !strcmp(m->name, "MAINFH") || nw[n].mainbh;
+
+				snprintf(key, sizeof(key), "%s%d_ap_isolate", apm ? "apm" : "apg", m->sdn_t.apg_idx);
+				nw[n].ap_iso = reaper_brport_nv1(key);
+				if (!apm) {
+					snprintf(key, sizeof(key), "apg%d_ap_isolate_lan", m->sdn_t.apg_idx);
+					nw[n].lan_iso = reaper_brport_nv1(key);
+				}
+			}
+			if (m->sdn_t.cp_idx > 0) {
+				memset(&cpt, 0, sizeof(cpt));
+				nw[n].portal = 1;
+				if (get_cp_type_byidx(m->sdn_t.cp_idx, &cpt) &&
+				    !(cpt.cp_type == 1 || cpt.cp_type == 2 || cpt.cp_type == 4))
+					nw[n].portal = 0;
+			}
+			n++;
+		}
+	}
+	FREE_MTLAN((void *)pmtl);
+	return n;
+}
+
+/* the AiMesh nodes' MACs (cfg_relist, rc/reaper_aimesh.c) as bytes */
+static int reaper_brport_nodes(unsigned char (*nodes)[6], int max)
+{
+	char macs[REAPER_BRPORT_NODES][18];
+	unsigned int b[6];
+	int n, i, c = 0, k;
+
+	n = reaper_aimesh_macs(macs, REAPER_BRPORT_NODES, NULL);
+	for (i = 0; i < n && c < max; i++) {
+		if (sscanf(macs[i], "%2x:%2x:%2x:%2x:%2x:%2x", &b[0], &b[1], &b[2], &b[3], &b[4], &b[5]) != 6)
+			continue;
+		for (k = 0; k < 6; k++)
+			nodes[c][k] = (unsigned char)b[k];
+		c++;
+	}
+	return c;
+}
+/* REAPER-BRPORT-NETS-END */
+
+void reaper_brport_wired_open(void)
+{
+	/* never isolated: the WAN names; outside router mode also the uplink (eth_ifnames / sta_*). In router mode
+	 * eth_ifnames lists AiMesh Ethernet-backhaul CANDIDATES that are real LAN ports (RT-BE96U "eth0 eth5" with the
+	 * 10G LAN on eth5): there the AiMesh check is the forwarding table, not that list. */
+	static const char *upl[] = { "wan_ifnames", "wan0_ifname", "wan1_ifname", "wan2_ifname", "wan3_ifname",
+				     "autowan_detected_ifname", NULL };
+	static const char *upl_nr[] = { "eth_ifnames", "sta_ifnames", "sta_phy_ifnames", NULL };
+	struct reaper_brnet nw[REAPER_BRPORT_NETS];
+	struct reaper_brplan plan[REAPER_BRPORT_NETS + 1];
+	unsigned char nodes[REAPER_BRPORT_NODES][6];
+	static struct reaper_brctx x;
+	char lan[16], key[32], uplink[512], state[2048 + 2];
+	const char *l = nvram_safe_get("lan_ifname");
+	size_t ul = 0;
+	ssize_t r;
+	int n, np, b, u, fd, lock, main_on = 0, close_any = 0;
+
+	/* An AiMesh node (RE): neither choice key syncs to nodes (wlX_ap_isolate does), so the node keeps the firmware's
+	 * own behaviour - never less isolation than stock. Nothing is touched or logged there. */
+	if (re_mode())
+		return;
+	if (!*l)
+		l = "br0";
+	if (strlen(l) >= sizeof(lan))
+		return;
+	snprintf(lan, sizeof(lan), "%s", l);
+	lock = file_lock("reaper_brport");	/* the apply paths and the rwatch tick: one run at a time (a leaf lock) */
+	for (u = 0; u < MAX_NR_WL_IF; u++) {
+		snprintf(key, sizeof(key), "wl%d_ap_isolate", u);
+		if (reaper_brport_nv1(key))
+			main_on = 1;
+	}
+	n = reaper_brport_nets(lan, nw, REAPER_BRPORT_NETS);
+	np = reaper_brport_plan(lan, main_on, reaper_brport_nv1("reaper_ap_isolate_lan"), nw, n, plan,
+				REAPER_BRPORT_NETS + 1);
+	memset(&x, 0, sizeof(x));
+	uplink[0] = '\0';
+	for (u = 0; upl[u]; u++)
+		if (ul < sizeof(uplink) - 1)
+			ul += snprintf(uplink + ul, sizeof(uplink) - ul, " %s", nvram_safe_get(upl[u]));
+	for (u = 0; sw_mode() != SW_MODE_ROUTER && upl_nr[u]; u++)
+		if (ul < sizeof(uplink) - 1)
+			ul += snprintf(uplink + ul, sizeof(uplink) - ul, " %s", nvram_safe_get(upl_nr[u]));
+	x.uplink = uplink;
+	/* what this helper isolated before: "\n" + the file, so every line is "\n<bridge> <port>\n" */
+	state[0] = '\n';
+	state[1] = '\0';
+	if ((fd = open(REAPER_BRPORT_STATE, O_RDONLY | O_NOFOLLOW)) >= 0) {
+		if ((r = read(fd, state + 1, sizeof(state) - 2)) > 0)
+			state[1 + r] = '\0';
+		close(fd);
+	}
+	x.state = state;
+	for (b = 0; b < np; b++)
+		if (plan[b].act == RBP_CLOSE)
+			close_any = 1;
+	x.nodes = (const unsigned char (*)[6])nodes;
+	x.nn = close_any ? reaper_brport_nodes(nodes, REAPER_BRPORT_NODES) : 0;
+	for (b = 0; b < np; b++)
+		reaper_brport_bridge(plan[b].br, plan[b].act, &x);
+	if (strcmp(state + 1, x.nstate) && reaper_secure_dir(REAPER_BRPORT_STATE_DIR, 0700) == 0)
+		(void)reaper_write_atomic(REAPER_BRPORT_STATE, x.nstate, x.nsl, 0600);
+	file_unlock(lock);
+	if (x.opened || x.closed)
+		logmessage("reaper", "AP Isolation: wired ports opened / isolated: %d / %d (%s%s)",
+			x.opened, x.closed, x.names, x.more ? " ..." : "");
+}
+
+/* the rwatch tick's gate, nvram only: some network may have its switch on with Wi-Fi and LAN ports - the main network
+ * (reaper_ap_isolate_lan and a radio's or a network's switch on: a network riding the main bridge counts there) or a
+ * network with its own choice. A superset of the helper's own plan; never touches sysfs. */
+static int reaper_brport_lan_wanted(void)
+{
+	char key[48];
+	int u, on = 0;
+
+	if (reaper_brport_nv1("reaper_ap_isolate_lan")) {
+		for (u = 0; u < MAX_NR_WL_IF && !on; u++) {
+			snprintf(key, sizeof(key), "wl%d_ap_isolate", u);
+			on = reaper_brport_nv1(key);
+		}
+		for (u = 1; u < REAPER_BRPORT_NETS && !on; u++) {
+			snprintf(key, sizeof(key), "apg%d_ap_isolate", u);
+			on = reaper_brport_nv1(key);
+			snprintf(key, sizeof(key), "apm%d_ap_isolate", u);
+			on = on || reaper_brport_nv1(key);
+		}
+		if (on)
+			return 1;
+	}
+	for (u = 1; u < REAPER_BRPORT_NETS; u++) {
+		snprintf(key, sizeof(key), "apg%d_ap_isolate", u);
+		if (!reaper_brport_nv1(key))
+			continue;
+		snprintf(key, sizeof(key), "apg%d_ap_isolate_lan", u);
+		if (reaper_brport_nv1(key))
+			return 1;
+	}
+	return 0;
+}
+
+/* /sbin/reaper_brport (applets dispatch by basename only - see reaper_lockrun): the rwatch tick */
+int reaper_brport_tick_main(int argc, char *argv[])
+{
+	(void)argc;
+	(void)argv;
+	if (reaper_brport_lan_wanted())
+		reaper_brport_wired_open();
+	return 0;
+}
