+	for (tok = strtok_r(c, " ,\r\n\t", &sv); tok; tok = strtok_r(NULL, " ,\r\n\t", &sv)) {
+		if (strlen(tok) != 17) { n = -1; break; }
+		for (i = 0; i < 17; i++) {
+			if (i % 3 == 2 ? tok[i] != ':' : !isxdigit((unsigned char)tok[i]))
+				break;
+			m[i] = (char)tolower((unsigned char)tok[i]);
+		}
+		if (i != 17) { n = -1; break; }
+		m[17] = 0;
+		if (strstr(out, m))
+			continue;
+		if (n >= RDW_EXEMPT_MAX || strlen(out) + 19 > osz) { n = -1; break; }
+		snprintf(out + strlen(out), osz - strlen(out), "%s%s", n ? " " : "", m);
+		n++;
+	}
+	free(c);
+	return n;
+}
