+/* reaper 2026-11-20 (owner): REAPER-WG-ALLOWED - the Wallguard page's Allowed tab changes the three lists a name at a
+ * time: Allowed for 24 hours (SH_JFFS/allow24, "<expiry> <name>" per line), Never block (SH_JFFS/allow) and Always
+ * block (SH_JFFS/block), one name per line. The page sends the names comma-separated (a comma is never part of a
+ * name); every one is checked with sh_name. A change is applied by a rebuild from the lists already on the router
+ * (start_wallguard_rebuild: no download, no restart of Wallguard) and audited, one line per name. */
+#define SH_EDIT_MAX	100		/* names in one request (the page sends a larger selection in turns) */
+#define SH_A24_ADD	86400		/* +24 h */
+#define SH_A24_CAP	(7 * 86400)	/* an extended allow ends at most 7 days from now - for longer, Make permanent */
+
+/* v (cut in place): "name,name,..." -> names[] in lower case, each once. The count, or -1 for an empty or bad list,
+ * or one longer than max */
+static int sh_names_split(char *v, char **names, int max)
+{
+	char *p, *sv = NULL;
+	int n = 0, i;
+
+	if (!v || !*v)
+		return -1;
+	for (p = strtok_r(v, ",", &sv); p; p = strtok_r(NULL, ",", &sv)) {
+		for (i = 0; p[i]; i++)
+			p[i] = (char)tolower((unsigned char)p[i]);
+		if (!sh_name(p))
+			return -1;
+		for (i = 0; i < n && strcmp(names[i], p); i++)
+			;
+		if (i < n)
+			continue;
+		if (n >= max)
+			return -1;
+		names[n++] = p;
+	}
+	return n ? n : -1;
+}
+
+/* which of names[] the first len bytes of s spell (case-insensitive), or -1 */
+static int sh_names_find(char **names, int n, const char *s, size_t len)
+{
+	int i;
+
+	for (i = 0; i < n; i++)
+		if (strlen(names[i]) == len && !strncasecmp(names[i], s, len))
+			return i;
+	return -1;
+}
+
+/* one list of names (allow / block): the lines naming one of del[] go, then each of add[] not there yet is added.
+ * A line's first word is its name (as sh_chk_name reads it); every other line is kept as it is, empty lines go.
+ * 0, or -1 when the result would not fit in max */
+static int sh_names_edit(const char *cur, char **del, int ndel, char **add, int nadd, char *out, size_t max)
+{
+	const char *l = cur, *e;
+	char got[SH_EDIT_MAX];
+	size_t o = 0, w;
+	int i;
+
+	*out = 0;
+	if (nadd > SH_EDIT_MAX)
+		return -1;
+	memset(got, 0, sizeof(got));
+	while (*l) {
+		e = l + strcspn(l, "\n");
+		w = strcspn(l, " \t\r\n");
+		if (w > (size_t)(e - l))
+			w = (size_t)(e - l);
+		if (e > l && sh_names_find(del, ndel, l, w) < 0) {
+			if ((i = sh_names_find(add, nadd, l, w)) >= 0)
+				got[i] = 1;
+			if (o + (size_t)(e - l) + 2 > max)
+				return -1;
+			memcpy(out + o, l, (size_t)(e - l));
+			o += (size_t)(e - l);
+			out[o++] = '\n';
+			out[o] = 0;
+		}
+		l = *e ? e + 1 : e;
+	}
+	for (i = 0; i < nadd; i++) {
+		if (got[i])
+			continue;
+		w = strlen(add[i]);
+		if (o + w + 2 > max)
+			return -1;
+		memcpy(out + o, add[i], w);
+		o += w;
+		out[o++] = '\n';
+		out[o] = 0;
+	}
+	return 0;
+}
+
+/* the 24 h allows (SH_JFFS/allow24, "<expiry> <name>" per line). op 'd': the lines naming one of names[] go. op 'e':
+ * each such name gets ONE line, where its first line was - its latest expiry (or now, once that has passed) plus
+ * 24 h, at most SH_A24_CAP from now; its other lines go (duplicates from repeated allows). Every other line is kept.
+ * *hit = how many of names[] had a line. 0, or -1 when the result would not fit in max */
+static int sh_a24_edit(const char *cur, char **names, int n, int op, long long now, char *out, size_t max, int *hit)
+{
+	long long best[SH_EDIT_MAX], t, x;
+	char found[SH_EDIT_MAX], done[SH_EDIT_MAX], line[300], nm[256];
+	const char *l, *e;
+	size_t o = 0, len;
+	int pass, i, k, end;
+
+	*out = 0;
+	*hit = 0;
+	if (n > SH_EDIT_MAX)
+		return -1;
+	memset(found, 0, sizeof(found));
+	memset(done, 0, sizeof(done));
+	for (i = 0; i < n; i++)
+		best[i] = 0;
+	for (pass = 0; pass < 2; pass++) {
+		for (l = cur; *l; l = *e ? e + 1 : e) {
+			e = l + strcspn(l, "\n");
+			len = (size_t)(e - l);
+			k = -1;
+			t = 0;
+			if (len && len < sizeof(line)) {
+				memcpy(line, l, len);
+				line[len] = 0;
+				end = 0;
+				if (sscanf(line, "%lld %255s%n", &t, nm, &end) == 2 && (size_t)end == len)
+					k = sh_names_find(names, n, nm, strlen(nm));
+			}
+			if (pass == 0) {
+				if (k >= 0 && (!found[k] || t > best[k]))
+					best[k] = t;
+				if (k >= 0)
+					found[k] = 1;
+				continue;
+			}
+			if (k < 0) {
+				if (!len)
+					continue;
+				if (o + len + 2 > max)
+					return -1;
+				memcpy(out + o, l, len);
+				o += len;
+				out[o++] = '\n';
+				out[o] = 0;
+			} else if (op == 'e' && !done[k]) {
+				x = (best[k] > now ? best[k] : now) + SH_A24_ADD;
+				if (x > now + SH_A24_CAP)
+					x = now + SH_A24_CAP;
+				i = snprintf(out + o, max - o, "%lld %s\n", x, names[k]);
+				if (i < 0 || (size_t)i >= max - o)
+					return -1;
+				o += (size_t)i;
+				done[k] = 1;
+			}
+		}
+	}
+	for (i = 0; i < n; i++)
+		*hit += found[i];
+	return 0;
+}
+
+/* a and b hold the same lines (a list as rjf_get returns it - no trailing newline - against one edited above) */
+static int sh_same(const char *a, const char *b)
+{
+	size_t la = strlen(a), lb = strlen(b);
+
+	while (la && (a[la - 1] == '\n' || a[la - 1] == '\r'))
+		la--;
+	while (lb && (b[lb - 1] == '\n' || b[lb - 1] == '\r'))
+		lb--;
+	return la == lb && !memcmp(a, b, la);
+}
+
+/* one list file edited: read (refused when the file exists but cannot be read - writing would
+ * lose it), edit, write only when something changed. *changed |= 1 when it did. 0, or -1 */
+static int sh_file_edit(const char *path, char **del, int ndel, char **add, int nadd, int a24op, int *hit, int *changed)
+{
+	int ex, r;
+	char *cur = strdup(rjf_get(path, &ex)), *next = malloc(SH_LIST_MAX);
+
+	if (!cur || !next || ex < 0) {
+		free(cur);
+		free(next);
+		return -1;
+	}
+	if (a24op)
+		r = sh_a24_edit(cur, del, ndel, a24op, (long long)time(NULL), next, SH_LIST_MAX, hit);
+	else
+		r = sh_names_edit(cur, del, ndel, add, nadd, next, SH_LIST_MAX);
+	if (r == 0 && !sh_same(cur, next)) {
+		r = rjf_set(path, next, "wallguard");
+		if (r == 0)
+			*changed = 1;
+	}
+	free(cur);
+	free(next);
+	return r ? -1 : 0;
+}
+
+/* action=allow24 (op=del|extend|keep) and action=myrules (list=allow|block, op=del|move), name=<names>. POST only.
+ * keep = Make permanent: added to Never block first, then taken off the 24 h list, so a failure between the two
+ * leaves the name allowed, never gone; move works the same way (added to the other list, then removed). One
+ * rebuild for the whole request, and only when a file changed. The answer carries how many names were sent. */
+static void sh_edit_cgi(FILE *stream, const char *action)
+{
+	char *op = get_cgi("op"), *list = get_cgi("list"), *nv = get_cgi("name"), *buf = NULL, *names[SH_EDIT_MAX];
+	const char *what = NULL;
+	int n = -1, i, hit = 0, changed = 0, r = 0;
+
+	if (reaper_req_post && op && nv && strlen(nv) < SH_LIST_MAX && (buf = strdup(nv)) != NULL)
+		n = sh_names_split(buf, names, SH_EDIT_MAX);
+	if (n > 0 && !strcmp(action, "allow24")) {
+		if (!strcmp(op, "del"))
+			what = "allow 24h removed";
+		else if (!strcmp(op, "extend"))
+			what = "allow 24h extended";
+		else if (!strcmp(op, "keep"))
+			what = "allow 24h made permanent";
+	} else if (n > 0 && list && (!strcmp(list, "allow") || !strcmp(list, "block"))) {
+		if (!strcmp(op, "del"))
+			what = !strcmp(list, "allow") ? "never block removed" : "always block removed";
+		else if (!strcmp(op, "move"))
+			what = !strcmp(list, "allow") ? "never block moved to always block" : "always block moved to never block";
+	}
+	if (!what) {
+		free(buf);
+		websWrite(stream, "{\"ok\":0,\"ek\":\"RSHD_E2\"}");
+		return;
+	}
+	if (!strcmp(action, "allow24")) {
+		if (!strcmp(op, "keep"))
+			r = sh_file_edit(SH_JFFS "/allow", NULL, 0, names, n, 0, &hit, &changed);
+		if (r == 0)
+			r = sh_file_edit(SH_JFFS "/allow24", names, n, NULL, 0, !strcmp(op, "extend") ? 'e' : 'd', &hit, &changed);
+	} else {
+		const char *from = !strcmp(list, "allow") ? SH_JFFS "/allow" : SH_JFFS "/block";
+		const char *to = !strcmp(list, "allow") ? SH_JFFS "/block" : SH_JFFS "/allow";
+
+		if (!strcmp(op, "move"))
+			r = sh_file_edit(to, NULL, 0, names, n, 0, &hit, &changed);
+		if (r == 0)
+			r = sh_file_edit(from, names, n, NULL, 0, 0, &hit, &changed);
+	}
+	if (changed)
+		notify_rc("start_wallguard_rebuild");
+	if (r) {
+		free(buf);
+		websWrite(stream, "{\"ok\":0,\"ek\":\"RSHD_E1\"}");
+		return;
+	}
+	if (changed)
+		for (i = 0; i < n; i++)
+			reaper_audit("wallguard", what, names[i]);
+	websWrite(stream, "{\"ok\":1,\"n\":%d,\"changed\":%d}", n, changed);
+	free(buf);
+}
