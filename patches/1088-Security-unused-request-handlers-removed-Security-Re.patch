+/* the page's view (Network page bar, dashboard notice; also an appGet hook):
+ *   {"on":0|1,"wait":0|1,"list":"<waiting services>","items":[[<network index>,"n|o|e"],...]} */
+static int ej_reaper_sdn_defer(int eid, webs_t wp, int argc, char_t **argv)
+{
+	char list[RDEFER_MAX + 1] = "", items[RDEFER_ITEMS] = "";
+	const char *p, *q;
+	long t = 0;
+	int w, ret, first = 1;
+
+	w = rdefer_mark_read(RDEFER_MARK, &t, list, sizeof(list), items, sizeof(items));
+	if (!w || strspn(list, "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_ ;") != strlen(list))
+		list[0] = 0;
+	ret = websWrite(wp, "{\"on\":%d,\"wait\":%d,\"list\":\"%s\",\"items\":[", nvram_match("reaper_sdn_defer", "1") ? 1 : 0,
+			w ? 1 : 0, list);
+	for (p = items; w && *p; p = *q ? q + 1 : q) {	/* "<digits><e|o|n>" entries only */
+		q = p + strcspn(p, ",");
+		if (q - p >= 2 && q - p <= 11 && strchr("eon", q[-1]) && strspn(p, "0123456789") == (size_t)(q - p - 1)) {
+			ret += websWrite(wp, "%s[%.*s,\"%c\"]", first ? "" : ",", (int)(q - p - 1), p, q[-1]);
+			first = 0;
+		}
+	}
+	ret += websWrite(wp, "]}");
+	return ret;
+}
