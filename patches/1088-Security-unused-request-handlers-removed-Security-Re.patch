+/* 2026-11-21 (owner-approved design): the SEAL of the accepted baseline. (A password on the actions that can hide a
+ * change stood beside it 2026-11-21..23; the owner removed it, REAPER-REVIEW-NOPW.)
+ *
+ * WHY. Anyone with an admin session could accept a new baseline, and anything able to write /jffs could edit the
+ * baseline or add an ignore rule: a change could be hidden and the review stayed green.
+ *
+ * THE SEAL. One nvram value, rwatch_review_seal = "<fingerprint> <epoch> <who>" (about 90 bytes; outside /jffs),
+ * written and committed on every LEGITIMATE write: Accept (all / one / selected), a rules save on the page - only
+ * while the seal held just before - and rwatch's own adopt / retire edits (rc/rwatch.c _rv_seal_put). Reset clears
+ * it with the baseline. rwatch recomputes the fingerprint at every run (_rv_seal_get):
+ *   ok / none            the review as before
+ *   changed / removed    red on the pages: the baseline or the rules were changed, or the baseline deleted,
+ *                        outside this CGI
+ *   unsealed             amber: a baseline without a seal - every router once after the upgrade; one Accept seals
+ *                        it (never adopted silently, or clearing the seal would earn a free re-seal)
+ * THE FINGERPRINT (rc/rwatch.c _rv_fp() writes the same bytes through sha256sum): sha256 over
+ *   "reaper-review-seal-1\n" "baseline <bytes>\n" <baseline file> "\nrules <bytes>\n" <rules file> "\n"
+ * with <bytes> the decimal size of what follows (0 and nothing when there is no rules file). The sizes fix where
+ * each file ends, so no byte can be moved from one into the other.
+ *
+ * NOT IN THE SETTINGS FILE: the key has no rcfg_flags row on purpose (test_backup_coverage.py names it
+ * full-backup-only). The full .rbk carries it in the router settings next to the /jffs that holds the baseline, so
+ * the two travel together; alone in a JSON export it would describe a baseline that file does not carry.
+ *
+ * WHAT IT IS NOT. Root on the router can write the nvram value too. This raises the bar for a hijacked admin
+ * session and for anything that can only write /jffs; it does not stop someone who already has root. */
+#define RVIEW_SEAL_NV		"rwatch_review_seal"
+#define RVIEW_SEAL_HEAD		"reaper-review-seal-1\n"
+#define RVIEW_SEAL_BASE_MAX	(RVIEW_INV_MAX + 64 * 1024)	/* an accepted inventory plus what rwatch adopted since */
+#define RVIEW_SEAL_RULES_MAX	(64 * 1024)
+#define RVS_NONE	0
+#define RVS_OK		1
+#define RVS_CHANGED	2
+#define RVS_REMOVED	3
+#define RVS_UNSEALED	4
+static const char *const rview_seal_word[] = { "none", "ok", "changed", "removed", "unsealed" };
+
+/* the fingerprint of a baseline text and a rules text, 64 hex digits. 0 = ok */
+static int rview_seal_hash(const char *base, const char *rules, char hex[65])
+{
+	EVP_MD_CTX *c = EVP_MD_CTX_new();
+	unsigned char md[EVP_MAX_MD_SIZE];
+	unsigned int ml = 0, i;
+	char h[48];
+	int ok;
+
+	if (!c)
+		return -1;
+	ok = EVP_DigestInit_ex(c, EVP_sha256(), NULL) == 1 &&
+	     EVP_DigestUpdate(c, RVIEW_SEAL_HEAD, sizeof(RVIEW_SEAL_HEAD) - 1) == 1;
+	snprintf(h, sizeof(h), "baseline %lu\n", (unsigned long)strlen(base));
+	ok = ok && EVP_DigestUpdate(c, h, strlen(h)) == 1 && EVP_DigestUpdate(c, base, strlen(base)) == 1;
+	snprintf(h, sizeof(h), "\nrules %lu\n", (unsigned long)strlen(rules));
+	ok = ok && EVP_DigestUpdate(c, h, strlen(h)) == 1 && EVP_DigestUpdate(c, rules, strlen(rules)) == 1 &&
+	     EVP_DigestUpdate(c, "\n", 1) == 1 && EVP_DigestFinal_ex(c, md, &ml) == 1 && ml == 32;
+	EVP_MD_CTX_free(c);
+	if (!ok)
+		return -1;
+	for (i = 0; i < 32; i++)
+		snprintf(hex + 2 * i, 3, "%02x", md[i]);
+	return 0;
+}
+
+/* the rules file for the fingerprint: "" when there is none; NULL when the path holds something that is not a
+ * plain file of a sane size (a link, a folder, over 64 KB) - rwatch would read THROUGH a link, so what this
+ * process may read is not what would be applied, and nothing is sealed or held to match */
+static char *rview_seal_rules(void)
+{
+	struct stat st;
+
+	if (lstat(RVIEW_RULES, &st) != 0)
+		return errno == ENOENT ? strdup("") : NULL;
+	return rview_slurp(RVIEW_RULES, RVIEW_SEAL_RULES_MAX);
+}
+
+/* the fingerprint of (base, rules); NULL = that file as it is on disk now. 0 = ok, -1 = it cannot be worked out */
+static int rview_seal_calc(const char *base, const char *rules, char hex[65])
+{
+	char *b = base ? NULL : rview_slurp(RVIEW_BASE, RVIEW_SEAL_BASE_MAX);
+	char *r = rules ? NULL : rview_seal_rules();
+	int rc = -1;
+
+	if ((base || b) && (rules || r))
+		rc = rview_seal_hash(base ? base : b, rules ? rules : r, hex);
+	free(b);
+	free(r);
+	return rc;
+}
+
+/* 1 = the stored seal is the fingerprint of this baseline text (NULL = the file on disk) and the rules on disk */
+static int rview_seal_holds(const char *base)
+{
+	const char *seal = nvram_safe_get(RVIEW_SEAL_NV);
+	char hex[65];
+
+	return strcspn(seal, " ") == 64 && rview_seal_calc(base, NULL, hex) == 0 && strncmp(seal, hex, 64) == 0;
+}
+
+/* the state rwatch works out at every run, for the request path (the answer before the first report after a
+ * boot, and the checks before a partial write). The baseline test is rwatch's `-s` and `! -L`. */
+static int rview_seal_state(void)
+{
+	const char *seal = nvram_safe_get(RVIEW_SEAL_NV);
+	struct stat bs;
+	int have = lstat(RVIEW_BASE, &bs) == 0 && S_ISREG(bs.st_mode) && bs.st_size > 0;
+
+	if (!have)
+		return *seal ? RVS_REMOVED : RVS_NONE;
+	if (!*seal)
+		return RVS_UNSEALED;
+	return rview_seal_holds(NULL) ? RVS_OK : RVS_CHANGED;
+}
+
+/* store and commit the seal of a write this CGI just made */
+static void rview_seal_store(const char *hex)
+{
+	char v[160], who[48];
+	size_t i;
+
+	strlcpy(who, reaper_client_ip[0] ? reaper_client_ip : "-", sizeof(who));
+	for (i = 0; who[i]; i++)
+		if ((unsigned char)who[i] <= 0x20 || (unsigned char)who[i] > 0x7e)
+			who[i] = '_';
+	snprintf(v, sizeof(v), "%s %ld %s", hex, (long)time(NULL), who);
+	nvram_set(RVIEW_SEAL_NV, v);
+	nvram_commit();
+}
+
+static void rview_seal_clear(void)
+{
+	if (nvram_safe_get(RVIEW_SEAL_NV)[0]) {
+		nvram_unset(RVIEW_SEAL_NV);
+		nvram_commit();
+	}
+}
