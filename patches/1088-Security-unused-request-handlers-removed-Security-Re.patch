+/* reaper 2026-11-20 (owner): REAPER-DUT-REDIR-JS - the login page's redirect address, printed only while the
+ * redirect switch is on, so a stored but unused name never shows on the login page (served before sign-in). Every part
+ * is checked with shared/reaper_dut_redir.h first (host letters, digits, '.' and '-'; port digits; http or https), so
+ * nothing printed needs escaping. Any other state prints {} and the page keeps the stock name. */
+static int ej_reaper_dut_redir_js(int eid, webs_t wp, int argc, char_t **argv)
+{
+	const char *h = nvram_safe_get("reaper_dut_redir_host");
+	const char *pr = nvram_safe_get("reaper_dut_redir_proto");
+	const char *pt = nvram_safe_get("reaper_dut_redir_port");
