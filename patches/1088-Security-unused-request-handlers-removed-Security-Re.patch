+			if(!strstr(file, ".cgi") && !strstr(file, "syslog.txt") && !(strstr(file,"uploadIconFile.tar")) && !(strstr(file,".CFG")) && !(strstr(file,".rbk")) /* reaper v2.7.2: full-backup download is handler-generated, not on disk */ && !(strstr(file,".log")) && !check_if_file_exist(reaper_fp)
