+static void reaper_removed_note(const char *u, const char *client)
+{
+	static unsigned char seen[sizeof(reaper_removed_addr) / sizeof(reaper_removed_addr[0])];	/* this process */
+	char pat[64], who[48], c = 0;
+	int i, n, fd;
+
+	for (i = 0; reaper_removed_addr[i].head; i++) {
+		snprintf(pat, sizeof(pat), "%s%s", reaper_removed_addr[i].head, reaper_removed_addr[i].rest);
+		if (match(pat, u))
+			break;
+	}
+	if (!reaper_removed_addr[i].head || seen[i])
+		return;
+	seen[i] = 1;
+	/* the other listener, or this one before a restart, may have written the line already */
+	if ((fd = open(REAPER_REMOVED_SEEN, O_RDWR | O_CREAT | O_NOFOLLOW | O_CLOEXEC, 0600)) >= 0) {
+		if (flock(fd, LOCK_EX | LOCK_NB) == 0) {
+			if (lseek(fd, i, SEEK_SET) == i && read(fd, &c, 1) == 1 && c == '1') {
+				close(fd);
+				return;
+			}
+			c = '1';
+			if (lseek(fd, i, SEEK_SET) != i || write(fd, &c, 1) != 1)
+				c = 0;	/* no room in /tmp: this process still writes its one line */
+		}
+		close(fd);
+	}
+	for (n = 0; client && *client && n < (int)sizeof(who) - 1; client++)
+		if (isxdigit((unsigned char)*client) || *client == '.' || *client == ':')
+			who[n++] = *client;
+	who[n] = '\0';
+	logmessage("httpd", "reaper: a request for the removed address %s came from %s (written once per boot)",
+		pat, n ? who : "an unknown address");
+}
