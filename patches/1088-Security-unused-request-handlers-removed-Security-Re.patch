+#define RDW_EXEMPT_MAX 16
+/* REAPER-DREAD-EXEMPT (2026-11-22, owner): the devices that skip Dreadwatch, as the page or a settings file gives
+ * them (MAC addresses separated by spaces, commas or line ends) -> out: lower case, one space between, no
+ * repeats. Returns the number of devices; -1 = an entry that is not a MAC address, or more than RDW_EXEMPT_MAX. */
+static int rdw_exempt_clean(const char *in, char *out, size_t osz)
+{
+	char *c = strdup(in ? in : ""), *tok, *sv = NULL, m[18];
+	int n = 0, i;
+
+	*out = 0;
+	if (!c)
