+/* field k ('>' separated) of the row row[0..len) into out; 0 when there is no such field or it does not fit */
+static int rdefer_field(const char *row, size_t len, int k, char *out, size_t cap)
+{
+	const char *p = row, *e = row + len, *q;
+
+	out[0] = 0;
+	while (k-- > 0) {
+		if (!(q = memchr(p, '>', (size_t)(e - p))))
+			return 0;
+		p = q + 1;
+	}
+	if (!(q = memchr(p, '>', (size_t)(e - p))))
+		q = e;
+	if ((size_t)(q - p) >= cap)
+		return 0;
+	memcpy(out, p, (size_t)(q - p));
+	out[q - p] = 0;
+	return 1;
+}
