+	{ "crea", "te_sdn_mwl.cgi*" }, { "crea", "te_sdn_legacy.cgi*" }, { "rese", "t_sdn_rule.cgi*" },
+	{ "auto", "_guestnetwork.cgi" }, { "wl_a", "pply.cgi*" }, { "set_", "wl_band.cgi*" },
