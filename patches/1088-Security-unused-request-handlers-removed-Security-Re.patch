-/* REAPER-RG-CLEAR (2026-11-19, image 2): a new network takes the lowest free apg index, and the Reaper keys of a
- * network deleted before it are still stored under that index - the Network page clears them on delete (sdn.js), but
- * the app / Alexa / IFTTT create paths below write only the stock apgN_ keys. Without this the new network would
- * inherit the chosen main-network devices (apgN_rg_devs) and the device discovery services (apgN_rg_mdns) of the old
- * one. Unset = off (rc/reaper_guest.c reads both as empty). Router-only keys: not in APGx_NVRAM_LIST, so AiMesh never
- * syncs them. Not in update_apgx_profile(): that one edits an EXISTING app network, whose choices stay. */
-static void reaper_apg_rg_clear(int apg_idx)
-{
-	char k[32];
-
-	if (apg_idx <= 0)
-		return;
-	snprintf(k, sizeof(k), "apg%d_rg_devs", apg_idx);
-	nvram_unset(k);
-	snprintf(k, sizeof(k), "apg%d_rg_mdns", apg_idx);
-	nvram_unset(k);
-	snprintf(k, sizeof(k), "apg%d_ap_isolate_lan", apg_idx);	/* 2026-11-19: and the AP Isolation choice (rc/lan.c) */
-	nvram_unset(k);
-}
