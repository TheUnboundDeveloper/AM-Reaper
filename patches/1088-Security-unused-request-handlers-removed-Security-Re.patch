+	reaper_main_radius_fmt(nvram_safe_get("sdn_rl"), nvram_safe_get("radius_list"), rmr_apm_security, out, sizeof(out));
+	n = strlen(out) * 3 + 1;
+	if (!(enc = malloc(n)))
+		return 0;
+	char_to_ascii_safe(enc, out, n);
+	ret = websWrite(wp, "%s", enc);
+	free(enc);
+	return ret;
+}
