+/* reaper 2026-11-20 (owner-approved plan item 1; design 2026-11-16) REAPER-SDN-DEFER: several Network-page changes,
+ * one Wi-Fi restart. With the page's switch on (reaper_sdn_defer, OFF at factory) a create / edit / switch-on is
+ * stored at once (validate_apply) but its service list is held: the list goes into RDEFER_MARK, the settings this
+ * save hands to the AiMesh sync service go into RDEFER_KEYS, and nothing is signalled. The next request that runs -
+ * Apply now on the page, a switch-off, a delete, a LAN-port change, or a save with a service list on any page -
+ * takes the held list and settings with it in ONE hand-off (one combined list under rc's 256-character limit), so
+ * the nodes see one save and the radios restart once. A change is held only when every network that is enabled now
+ * stays enabled with the same VLAN, bridge, portal type and radio set (a network stored as off or deleted while its
+ * bridge is still up would lose its guest isolation at the next firewall build), and only for the Network page's
+ * own services (no portal, delete, LAN-port or reboot service). Both files are RAM-only on purpose: a reboot
+ * applies everything stored. When another change restarts the radios meanwhile, rc runs what is left (rc/sdn.c).
+ * A held save never reaches reaper_sdn_pending, so reaper_sdn_settle never applies it. */
+#define RDEFER_MARK	REAPER_TMPDIR "/sdn_defer"	/* "<uptime> <list>\n<items>\n", root 0600 */
+#define RDEFER_KEYS	REAPER_TMPDIR "/sdn_defer.json"	/* the held settings for the sync service, root 0600 */
+
+/* RDEFER-PURE-BEGIN (compiled on the host by test_sdn_defer.py) */
+#define RDEFER_MAX	255	/* rc reads a service list into nv[256] (rc/services.c handle_notifications) */
+#define RDEFER_TOKS	32
+#define RDEFER_NETS	64
+#define RDEFER_ITEMS	128
+enum { RDC_LEDG, RDC_DEL, RDC_NETPHY, RDC_WL, RDC_SDN, RDC_CHILLI, RDC_UAM, RDC_CP, RDC_RGUEST, RDC_QOS, RDC_FW,
+	RDC_STUBBY, RDC_VPNC, RDC_N };
+
+/* the Network page's services in the order a combined list runs them; -1 = any other service (runs last) */
+static int rdefer_cat(const char *t)
+{
+	static const char *const ord[RDC_N] = { "restart_ledg", "start_sdn_del", "restart_net_and_phy", "restart_wireless",
+						"restart_sdn", "restart_chilli", "restart_uam_srv", "restart_CP",
+						"restart_reaper_guest", "restart_qos", "restart_firewall", "restart_stubby",
+						"start_vpnclient" };
+	size_t w = strcspn(t, " "), l;
+	int i;
+
+	for (i = 0; i < RDC_N; i++) {
+		l = strlen(ord[i]);
+		if (i == RDC_VPNC) {	/* start_vpnclientN */
+			if (t[w] == 0 && w > l && strncmp(t, ord[i], l) == 0 && strspn(t + l, "0123456789") == w - l)
+				return i;
+			continue;
+		}
+		if (w != l || strncmp(t, ord[i], l) != 0)
+			continue;
+		if (t[w] == 0)
+			return i;
+		if (i == RDC_SDN && t[w + 1] && strspn(t + w + 1, "0123456789") == strlen(t + w + 1))
+			return i;	/* restart_sdn N */
+		return -1;
+	}
+	return -1;
+}
+
+/* add the distinct non-empty services of a ';' list to tok[n..]; the new count, -1 when too many / too long */
+static int rdefer_split(const char *list, char tok[][64], int n, int max)
+{
+	const char *p, *q;
+	size_t l;
+	int i;
+
+	for (p = list; p && *p; p = *q ? q + 1 : q) {
+		q = p + strcspn(p, ";");
+		if (!(l = (size_t)(q - p)))
+			continue;
+		if (l >= 64)
+			return -1;
+		for (i = 0; i < n; i++)
+			if (strlen(tok[i]) == l && strncmp(tok[i], p, l) == 0)
+				break;
+		if (i < n)
+			continue;
+		if (n >= max)
+			return -1;
+		memcpy(tok[n], p, l);
+		tok[n][l] = 0;
+		n++;
+	}
+	return n;
+}
+
+/* may a request with this list wait: it restarts the radios, and holds only restart_ledg / restart_wireless /
+ * restart_sdn N / restart_qos / restart_firewall / restart_stubby / start_vpnclientN */
+static int rdefer_list_ok(const char *list)
+{
+	char tok[RDEFER_TOKS][64];
+	int n, i, k, wl = 0;
+
+	if ((n = rdefer_split(list, tok, 0, RDEFER_TOKS)) <= 0)
+		return 0;
+	for (i = 0; i < n; i++) {
+		k = rdefer_cat(tok[i]);
+		if (k == RDC_WL)
+			wl = 1;
+		else if (k == RDC_SDN) {
+			if (!strchr(tok[i], ' '))
+				return 0;	/* every network: not a single change */
+		}
+		else if (k != RDC_LEDG && k != RDC_QOS && k != RDC_FW && k != RDC_STUBBY && k != RDC_VPNC)
+			return 0;
+	}
+	return wl;
+}
+
+static int rdefer_build(char tok[][64], int n, int plain, char *out, size_t cap)
+{
+	const char *t;
+	size_t o = 0;
+	int c, i, k, np = 0, sdn = 0;
+
+	for (i = 0; i < n; i++)
+		if (rdefer_cat(tok[i]) == RDC_NETPHY)
+			np = 1;
+	out[0] = 0;
+	for (c = 0; c <= RDC_N; c++)	/* c == RDC_N: the other services, in their own order */
+		for (i = 0; i < n; i++) {
+			k = rdefer_cat(tok[i]);
+			if ((c < RDC_N) ? k != c : k != -1)
+				continue;
+			if (k == RDC_WL && np)
+				continue;	/* restart_net_and_phy restarts the radios too */
+			t = tok[i];
+			if (k == RDC_SDN && plain) {
+				if (sdn++)
+					continue;
+				t = "restart_sdn";
+			}
+			if (o + strlen(t) + 1 >= cap)
+				return -1;
+			o += snprintf(out + o, cap - o, "%s;", t);
+		}
+	return 0;
+}
