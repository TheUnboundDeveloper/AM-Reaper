+	if (!nvram_match("http_dut_redir", "1") || !h[0] || !rdr_host_ok(h) || !rdr_proto_ok(pr) || !rdr_port_ok(pt))
+		return websWrite(wp, "{}");
+	return websWrite(wp, "{\"h\":\"%s\",\"pr\":\"%s\",\"pt\":\"%s\"}", h, pr, pt);
+}
