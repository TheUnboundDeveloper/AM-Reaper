+/* one list that runs both: a's and b's services once each, in rdefer_cat order; plain restart_sdn (every network)
+ * with a delete, with more than three networks, or when the per-network form does not fit. A reboot runs b alone
+ * (a boot applies everything stored). 0 = done, -1 = it cannot fit in cap */
+static int rdefer_combine(const char *a, const char *b, char *out, size_t cap)
+{
+	char tok[RDEFER_TOKS][64];
+	int n, i, k, nsdn = 0, plain = 0;
+
+	if ((n = rdefer_split(a, tok, 0, RDEFER_TOKS)) < 0 || (n = rdefer_split(b, tok, n, RDEFER_TOKS)) < 0)
+		return -1;
+	for (i = 0; i < n; i++) {
+		if (strcmp(tok[i], "reboot") == 0)
+			return (strlcpy(out, b, cap) < cap) ? 0 : -1;
+		k = rdefer_cat(tok[i]);
+		if (k == RDC_DEL || (k == RDC_SDN && !strchr(tok[i], ' ')))
+			plain = 1;
+		else if (k == RDC_SDN)
+			nsdn++;
+	}
+	if (nsdn > 3)
+		plain = 1;
+	if (rdefer_build(tok, n, plain, out, cap) == 0)
+		return 0;
+	if (!plain && rdefer_build(tok, n, 1, out, cap) == 0)
+		return 0;
+	out[0] = 0;
+	return -1;
