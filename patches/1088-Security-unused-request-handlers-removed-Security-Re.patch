+/* ---- reaper 2026-11-20 (REAPER-MAINRADIUS; bug review 2026-11-16 #13): the main network's RADIUS server as the
+ * Network page stores it, for Wireless > RADIUS Setting to show read-only. Once the main network is a Network-page
+ * profile (sdn_rl has a MAINFH row) it runs on wlN.1 and its server is the radius_list row whose index is the
+ * MAINFH row's idx; the wlN_radius_* keys that page edits belong to the hidden primary interface. radius_list
+ * carries four secrets per row and the rsec_lists[] helper masks one field per row, hence this hook: it prints
+ * only servers and ports, a set / not-set flag per secret, and the main network's authentication modes from
+ * apm<N>_security (whose rows also carry the Wi-Fi password: only the mode word is read, and only a known one).
+ * One row per MAINFH row (one per band when Smart Connect is off), URL-encoded as nvram_char_to_ascii:
+ *   <sdn_idx>apm_idx>ok|bad>modes>as1>ap1>ak1>cs1>cp1>ck1>as2>ap2>ak2>cs2>cp2>ck2
+ * modes = known mode words joined by ','; ak / ck = 1 set, 0 not set. A secret holding '<' or '>' shifts the
+ * fields of its row, so unless every radius_list row has exactly the 13 fields the Network page writes (rows
+ * alike in their closing '>', no index twice) the list is reported as "bad" with every server field empty. ---- */
+#define RMR_FIELDS	13	/* a radius_list row as the Network page writes it */
+#define RMR_MAIN	8	/* MAINFH rows */
+#define RMR_ROWS	64
+
+static const char *const rmr_auth_words[] = {
+	"open", "shared", "psk", "psk2", "pskpsk2", "sae", "psk2sae", "owe", "openowe",
+	"wpa", "wpa2", "wpawpa2", "wpa3", "wpa2wpa3", "suite-b", "radius", NULL
+};
+
+static void rmr_cat(char *out, size_t cap, const char *s)
+{
+	size_t l = strlen(out);
+
+	while (*s && l + 1 < cap)
+		out[l++] = *s++;
+	out[l] = 0;
+}
+
+static int rmr_digits(const char *s, size_t max)
+{
+	size_t n = 0;
+
+	for (; *s; s++, n++)
+		if (*s < '0' || *s > '9' || n >= max)
+			return 0;
+	return n > 0;
+}
+
+/* a server address: host name, IPv4 or IPv6 characters only, at most 64 of them */
+static int rmr_host_ok(const char *s)
+{
+	size_t n = 0;
+
+	for (; *s; s++, n++)
+		if (n >= 64 || !(isalnum((unsigned char)*s) || *s == '.' || *s == ':' || *s == '-' || *s == '_'))
+			return 0;
+	return 1;
+}
+
+static int rmr_has_word(const char *list, const char *w)
+{
+	size_t l = strlen(w);
+	const char *p = list;
+
+	while ((p = strstr(p, w)) != NULL) {
+		if ((p == list || p[-1] == ',') && (p[l] == 0 || p[l] == ','))
+			return 1;
+		p += l;
+	}
+	return 0;
+}
+
+/* split s in place at sep: the field count, or max + 1 when there are more than max (the first max are set) */
+static size_t rmr_split(char *s, char sep, char **f, size_t max)
+{
+	size_t n = 0;
+
+	f[n++] = s;
+	for (; *s; s++) {
+		if (*s != sep)
+			continue;
+		*s = 0;
+		if (n == max)
+			return max + 1;
+		f[n++] = s + 1;
+	}
+	return n;
+}
+
+static int reaper_main_radius_fmt(const char *sdn_rl, const char *radius_list,
+	const char *(*sec_of)(const char *apm_idx), char *out, size_t cap)
+{
+	char *sdn, *rl, *sec, *p, *row, *f[RMR_FIELDS + 2];
+	char *main_idx[RMR_MAIN], *main_apm[RMR_MAIN], *mf[RMR_MAIN][RMR_FIELDS], *seen[RMR_ROWS];
+	int nmain = 0, bad = 0, rows = 0, form = -1, i, j;
+	size_t n;
+
+	if (!out || !cap)
+		return 0;
+	out[0] = 0;
+	if (!(sdn = strdup(sdn_rl ? sdn_rl : "")))
+		return 0;
+	if (!(rl = strdup(radius_list ? radius_list : ""))) {
+		free(sdn);
+		return 0;
+	}
+	memset(mf, 0, sizeof(mf));
+	/* sdn_rl: <idx>name>enable>vlan_idx>subnet_idx>apg_idx>... - the MAINFH rows (apg_idx = the apm profile) */
+	for (p = sdn; nmain < RMR_MAIN && (row = strsep(&p, "<")) != NULL; ) {
+		if (rmr_split(row, '>', f, 6) < 6 || strcmp(f[1], "MAINFH") || !rmr_digits(f[0], 4) || !rmr_digits(f[5], 4))
+			continue;
+		main_idx[nmain] = f[0];
+		main_apm[nmain] = f[5];
+		nmain++;
+	}
+	/* radius_list: <radius_idx>as1>ap1>ak1>cs1>cp1>ck1>as2>ap2>ak2>cs2>cp2>ck2> - every row exactly 13 fields,
+	 * all rows with or all without the closing '>', no index twice (a secret cut at '<' leaves a short row, or
+	 * a row without the closing '>' next to rows with it, or a second row under one index) */
+	for (p = rl; nmain && (row = strsep(&p, "<")) != NULL; ) {
+		int closed;
+
+		if (!*row)
+			continue;
+		n = rmr_split(row, '>', f, RMR_FIELDS + 1);
+		closed = n == RMR_FIELDS + 1 && !*f[RMR_FIELDS];
+		if (closed)
+			n = RMR_FIELDS;
+		if (n != RMR_FIELDS || rows >= RMR_ROWS || (form >= 0 && form != closed)) {
+			bad = 1;
+			break;
+		}
+		form = closed;
+		for (i = 0; i < rows && strcmp(seen[i], f[0]); i++)
+			;
+		if (i < rows) {
+			bad = 1;
+			break;
+		}
+		seen[rows++] = f[0];
+		for (i = 0; i < nmain; i++)
+			if (!mf[i][0] && !strcmp(f[0], main_idx[i]))
+				memcpy(mf[i], f, sizeof(mf[i]));
+	}
+	for (i = 0; i < nmain; i++) {
+		char modes[160] = "";
+		const char *s = sec_of ? sec_of(main_apm[i]) : NULL;
+
+		/* apm<N>_security: <band>auth>crypto>password>radius_idx... - the auth word of each band, known words only */
+		if (s && (sec = strdup(s)) != NULL) {
+			char *q = sec, *r;
+
+			while ((r = strsep(&q, "<")) != NULL) {
+				if (rmr_split(r, '>', f, 2) < 2 || !rmr_digits(f[0], 4))
+					continue;
+				for (j = 0; rmr_auth_words[j]; j++)
+					if (!strcmp(f[1], rmr_auth_words[j]))
+						break;
+				if (!rmr_auth_words[j] || rmr_has_word(modes, f[1]))
+					continue;
+				if (modes[0])
+					rmr_cat(modes, sizeof(modes), ",");
+				rmr_cat(modes, sizeof(modes), f[1]);
+			}
+			free(sec);
+		}
+		rmr_cat(out, cap, "<");
+		rmr_cat(out, cap, main_idx[i]);
+		rmr_cat(out, cap, ">");
+		rmr_cat(out, cap, main_apm[i]);
+		rmr_cat(out, cap, bad ? ">bad>" : ">ok>");
+		rmr_cat(out, cap, modes);
+		for (j = 1; j < RMR_FIELDS; j++) {
+			const char *v = (!bad && mf[i][j]) ? mf[i][j] : "";
+
+			rmr_cat(out, cap, ">");
+			if (j % 3 == 0)		/* 3 6 9 12: a secret - set or not, never its text */
+				rmr_cat(out, cap, *v ? "1" : "0");
+			else if (j % 3 == 2)	/* a port */
+				rmr_cat(out, cap, rmr_digits(v, 5) ? v : "");
+			else			/* a server */
+				rmr_cat(out, cap, rmr_host_ok(v) ? v : "");
+		}
+	}
+	free(rl);
+	free(sdn);
+	return nmain;
+}
+
+static const char *rmr_apm_security(const char *apm_idx)
+{
+	char nv[32];
+
+	snprintf(nv, sizeof(nv), "apm%s_security", apm_idx);
+	return nvram_safe_get(nv);
+}
