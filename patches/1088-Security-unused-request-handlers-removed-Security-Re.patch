+/* may this save wait: every network enabled before (b*) is still enabled after it (a*) with the same VLAN, bridge,
+ * portal type and radio group, so no bridge that is up loses the stored network its isolation rules are built from */
+static int rdefer_safe(const char *b0, const char *b1, const char *b2, const char *a0, const char *a1, const char *a2)
+{
+	struct rdefer_net b[RDEFER_NETS], a[RDEFER_NETS];
+	int nb, na, i, j;
+
+	if ((nb = rdefer_nets(b0, b1, b2, b, RDEFER_NETS)) < 0 || (na = rdefer_nets(a0, a1, a2, a, RDEFER_NETS)) < 0)
+		return 0;
+	for (i = 0; i < nb; i++) {
+		if (!b[i].en)
+			continue;
+		if (strcmp(b[i].vid, "?") == 0 || strcmp(b[i].br, "?") == 0)
+			return 0;
+		for (j = 0; j < na && strcmp(a[j].idx, b[i].idx) != 0; j++)
+			;
+		if (j == na || !a[j].en || strcmp(a[j].vid, b[i].vid) || strcmp(a[j].br, b[i].br) ||
+		    strcmp(a[j].cp, b[i].cp) || strcmp(a[j].apg, b[i].apg))
+			return 0;
+	}
+	return 1;
+}
+
+/* the networks waiting, "<idx><kind>,..." (kind n = new, o = switched on, e = edited; the strongest kept): old plus
+ * every restart_sdn N of list, judged from before (b*) and after (a*) */
+static void rdefer_items(const char *old, const char *list, const char *b0, const char *b1, const char *b2,
+			 const char *a0, const char *a1, const char *a2, char *out, size_t cap)
+{
+	static const char rank[] = "eon";	/* weakest first */
+	struct rdefer_net b[RDEFER_NETS], a[RDEFER_NETS];
+	char tok[RDEFER_TOKS][64], idx[RDEFER_TOKS][12], kind[RDEFER_TOKS];
+	const char *p, *q;
+	int nb, na, nt, ni = 0, i, j;
+	size_t o = 0;
+
+	for (p = old; p && *p && ni < RDEFER_TOKS; p = *q ? q + 1 : q) {
+		q = p + strcspn(p, ",");
+		if (q - p >= 2 && q - p <= 11 && strchr(rank, q[-1]) && strspn(p, "0123456789") == (size_t)(q - p - 1)) {
+			memcpy(idx[ni], p, (size_t)(q - p - 1));
+			idx[ni][q - p - 1] = 0;
+			kind[ni++] = q[-1];
+		}
+	}
+	nb = rdefer_nets(b0, b1, b2, b, RDEFER_NETS);
+	na = rdefer_nets(a0, a1, a2, a, RDEFER_NETS);
+	nt = rdefer_split(list, tok, 0, RDEFER_TOKS);
+	for (i = 0; i < nt && nb >= 0 && na >= 0; i++) {
+		const char *n;
+		char k;
+
+		if (rdefer_cat(tok[i]) != RDC_SDN || !strchr(tok[i], ' '))
+			continue;
+		n = strchr(tok[i], ' ') + 1;
+		for (j = 0; j < na && strcmp(a[j].idx, n) != 0; j++)
+			;
+		if (j == na)
+			continue;
+		k = 'e';
+		for (j = 0; j < nb && strcmp(b[j].idx, n) != 0; j++)
+			;
+		if (j == nb)
+			k = 'n';
+		else if (!b[j].en)
+			k = 'o';
+		for (j = 0; j < ni && strcmp(idx[j], n) != 0; j++)
+			;
+		if (j < ni) {
+			if (strchr(rank, k) > strchr(rank, kind[j]))
+				kind[j] = k;
+		} else if (ni < RDEFER_TOKS && strlen(n) < sizeof(idx[0])) {
+			strcpy(idx[ni], n);
+			kind[ni++] = k;
+		}
+	}
+	out[0] = 0;
+	for (i = 0; i < ni; i++) {
+		if (o + strlen(idx[i]) + 3 >= cap)
+			break;
+		o += snprintf(out + o, cap - o, "%s%s%c", i ? "," : "", idx[i], kind[i]);
+	}
+}
