+			net[n].br[0] = 0;
+		else if (!rdefer_row(subnet, si, &row, &len) || !rdefer_field(row, len, 1, net[n].br, sizeof(net[n].br)))
+			strcpy(net[n].br, "?");
+		n++;
+	}
+	return n;
+}
