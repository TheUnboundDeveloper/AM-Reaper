+/* the marker: "<uptime> <list>\n<items>\n" -> 1, or 0 when absent, malformed, or not root's regular file */
+static int rdefer_mark_read(const char *path, long *t, char *list, size_t ln, char *items, size_t in)
+{
+	char buf[512], *sp, *nl;
+	struct stat st;
+	ssize_t n;
+	int fd = open(path, O_RDONLY | O_NOFOLLOW);
+
+	if (fd < 0)
+		return 0;
+	if (fstat(fd, &st) != 0 || !S_ISREG(st.st_mode) || st.st_uid != 0) {
+		close(fd);
+		return 0;
+	}
+	n = read(fd, buf, sizeof(buf) - 1);
+	close(fd);
+	if (n <= 0)
+		return 0;
+	buf[n] = 0;
+	*t = strtol(buf, &sp, 10);
+	if (sp == buf || *sp != ' ' || !(nl = strchr(++sp, '\n')))
+		return 0;
+	*nl = 0;
+	if (!*sp || strlen(sp) >= ln)
+		return 0;
+	strlcpy(list, sp, ln);
+	sp = nl + 1;
+	sp[strcspn(sp, "\n")] = 0;
+	if (strlen(sp) < in && strspn(sp, "0123456789eon,") == strlen(sp))
+		strlcpy(items, sp, in);
+	else
+		items[0] = 0;
+	return 1;
+}
+
+static int rdefer_mark_write(const char *path, long t, const char *list, const char *items)
+{
+	char tmp[128], buf[512];
+	int fd, l;
+
+	snprintf(tmp, sizeof(tmp), "%s.XXXXXX", path);
+	if ((fd = mkstemp(tmp)) < 0)
+		return -1;
+	l = snprintf(buf, sizeof(buf), "%ld %s\n%s\n", t, list, items);
+	if (l <= 0 || l >= (int)sizeof(buf) || write(fd, buf, l) != l || fchmod(fd, 0600) != 0) {
+		close(fd);
+		unlink(tmp);
+		return -1;
+	}
+	close(fd);
+	if (rename(tmp, path) != 0) {
+		unlink(tmp);
+		return -1;
+	}
+	return 0;
+}
+/* RDEFER-PURE-END */
+
+/* REAPER-SDN-DEFER-MERGE: the one place that knows how a save's hand-over to the sync service looks. It is taken as
+ * a JSON object and merged key by key without assuming any key name: a later save's value replaces an earlier one's,
+ * an object value is merged the same way one level down, and action_script is never kept (the flush sets its own). */
+static void rdefer_json_merge(json_object *dst, json_object *src)
+{
+	json_object *old;
+
+	if (!dst || !src || !json_object_is_type(dst, json_type_object) || !json_object_is_type(src, json_type_object))
+		return;
+	json_object_object_foreach(src, key, val) {
+		if (strcmp(key, "action_script") == 0)
+			continue;
+		if (val && json_object_is_type(val, json_type_object) && json_object_object_get_ex(dst, key, &old) &&
+		    old && json_object_is_type(old, json_type_object)) {
+			rdefer_json_merge(old, val);
+			continue;
+		}
+		json_object_object_add(dst, key, val ? json_object_get(val) : NULL);
+	}
+}
+
+/* the held settings (root's 0600 file), or a new empty object */
+static json_object *rdefer_keys_load(void)
+{
+	json_object *o = NULL;
+	struct stat st;
+
+	if (lstat(RDEFER_KEYS, &st) == 0 && S_ISREG(st.st_mode) && st.st_uid == 0)
+		o = json_object_from_file(RDEFER_KEYS);
+	if (o && !json_object_is_type(o, json_type_object)) {
+		json_object_put(o);
+		o = NULL;
+	}
+	return o ? o : json_object_new_object();
+}
+
+/* merge this save's hand-over (CFG_JSON_FILE) into the held settings; 0 on success */
+static int rdefer_keys_add_cfg(void)
+{
+	char tmp[] = RDEFER_KEYS ".XXXXXX";
+	json_object *keys, *cfg;
+	const char *s;
+	int fd, lk, ret = -1;
+	size_t l;
+
+	lk = file_lock(CFG_APPLY_LOCK);
+	cfg = json_object_from_file(CFG_JSON_FILE);
+	file_unlock(lk);
+	if (!cfg)
+		return -1;
+	keys = rdefer_keys_load();
+	rdefer_json_merge(keys, cfg);
+	s = json_object_to_json_string(keys);
+	reaper_secure_dir(REAPER_TMPDIR, 0700);
+	if (s && (fd = mkstemp(tmp)) >= 0) {
+		l = strlen(s);
+		if (fchmod(fd, 0600) == 0 && write(fd, s, l) == (ssize_t)l) {
+			close(fd);
+			ret = rename(tmp, RDEFER_KEYS);
+		} else
+			close(fd);
+		if (ret != 0)
+			unlink(tmp);
+	}
+	json_object_put(keys);
+	json_object_put(cfg);
+	return ret;
+}
+
+struct rdefer_snap { char *sdn, *vlan, *subnet; };
+
+/* before validate_apply: the stored networks, only for a Network-page save while the switch is on */
+static void rdefer_snap_take(struct rdefer_snap *s, json_object *root)
+{
+	char *f = get_cgi_json("reaper_defer", root);
+
+	s->sdn = s->vlan = s->subnet = NULL;
+	if (!f || strcmp(f, "1") != 0 || !nvram_match("reaper_sdn_defer", "1"))
+		return;
+	s->sdn = strdup(nvram_safe_get("sdn_rl"));
+	s->vlan = strdup(nvram_safe_get("vlan_rl"));
+	s->subnet = strdup(nvram_safe_get("subnet_rl"));
+	if (!s->sdn || !s->vlan || !s->subnet) {
+		free(s->sdn);
+		free(s->vlan);
+		free(s->subnet);
+		s->sdn = s->vlan = s->subnet = NULL;
+	}
+}
+
+static void rdefer_snap_free(struct rdefer_snap *s)
+{
+	free(s->sdn);
+	free(s->vlan);
+	free(s->subnet);
+	s->sdn = s->vlan = s->subnet = NULL;
+}
+
+/* apply_cgi, after validate_apply: hold this request (1: the caller sends nothing), or go on with *act - this
+ * request's list, or the combined one when changes were waiting (0). Apply now = reaper_defer_apply "1". */
+static int rdefer_apply(json_object *root, struct rdefer_snap *s, char **act, json_object *res)
+{
+	static char combined[RDEFER_MAX + 1];
+	char wlist[RDEFER_MAX + 1] = "", items[RDEFER_ITEMS] = "", nitems[RDEFER_ITEMS];
+	const char *a = (*act) ? *act : "";
+	char *ap = get_cgi_json("reaper_defer_apply", root);
+	int apply_now = ap && strcmp(ap, "1") == 0, waiting, keys, lk;
+	long stamp = 0;
+	struct stat st;
+
+	waiting = rdefer_mark_read(RDEFER_MARK, &stamp, wlist, sizeof(wlist), items, sizeof(items));
+	keys = (lstat(RDEFER_KEYS, &st) == 0);
+
+	/* hold: a Network-page create / edit / switch-on that leaves every enabled network as it is */
+	if (s->sdn && !apply_now && *a && rdefer_list_ok(a) &&
+	    rdefer_safe(s->sdn, s->vlan, s->subnet, nvram_safe_get("sdn_rl"), nvram_safe_get("vlan_rl"), nvram_safe_get("subnet_rl")) &&
+	    rdefer_combine(waiting ? wlist : "", a, combined, sizeof(combined)) == 0 && rdefer_list_ok(combined) &&
+	    (!cfg_changed || !is_cfg_server_ready() || rdefer_keys_add_cfg() == 0)) {
+		rdefer_items(waiting ? items : "", a, s->sdn, s->vlan, s->subnet, nvram_safe_get("sdn_rl"),
+			     nvram_safe_get("vlan_rl"), nvram_safe_get("subnet_rl"), nitems, sizeof(nitems));
+		reaper_secure_dir(REAPER_TMPDIR, 0700);
+		if (rdefer_mark_write(RDEFER_MARK, uptime(), combined, nitems) == 0) {
+			cfg_changed = 0;
+			logmessage("sdn", "Network page: change saved, the Wi-Fi restart waits for Apply (%s)", a);
+			json_object_object_add(res, "reaper_deferred", json_object_new_string("1"));
+			return 1;
+		}
+	}
+	if (!waiting && !keys)
+		return 0;
+	if (!*a && !apply_now) {
+		/* a save with no service list while changes wait: keep the held settings the newest */
+		if (cfg_changed && is_cfg_server_ready())
+			rdefer_keys_add_cfg();
+		return 0;
+	}
+
+	/* flush: this request runs and takes the waiting changes with it */
+	if (waiting) {
+		if (rdefer_combine(wlist, a, combined, sizeof(combined)) != 0) {
+			/* too long for one list (rc's limit): this request runs alone, the waiting changes stay for Apply */
+			logmessage("sdn", "Network page: the waiting changes do not fit in this request's service list - they stay waiting for Apply");
+			return 0;
+		}
+	} else if (strlcpy(combined, a, sizeof(combined)) >= sizeof(combined))
+		return 0;
+	if (!combined[0])
+		return 0;
+	if (keys && is_cfg_server_ready()) {
+		json_object *m = rdefer_keys_load(), *c = NULL;
+		char ver[32];
+
+		lk = file_lock(CFG_APPLY_LOCK);
+		if (cfg_changed && (c = json_object_from_file(CFG_JSON_FILE)) != NULL)
+			rdefer_json_merge(m, c);	/* this request's values are the newest */
+		json_object_to_file(CFG_JSON_FILE, m);
+		file_unlock(lk);
+		if (c)
+			json_object_put(c);
+		json_object_put(m);
+		if (!cfg_changed) {	/* Apply now: a new settings version, as a save makes */
+			srand(time(NULL));
+			snprintf(ver, sizeof(ver), "%d%d", rand(), rand());
+			nvram_set("cfg_ver", ver);
+		}
+		cfg_changed = 1;
+	}
+	unlink(RDEFER_MARK);
+	unlink(RDEFER_KEYS);
+	logmessage("sdn", "Network page: applying the waiting changes (%s)", combined);
+	json_object_object_add(res, "reaper_applied", json_object_new_string("1"));
+	*act = combined;
+	return 0;
+}
