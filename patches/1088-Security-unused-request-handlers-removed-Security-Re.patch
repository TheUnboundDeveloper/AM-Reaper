diff --git a/release/src/router/shared/reaper_dut_redir.h b/release/src/router/shared/reaper_dut_redir.h
new file mode 100644
index 0000000000..b87a9c5e96
--- /dev/null
+++ b/release/src/router/shared/reaper_dut_redir.h
@@ -0,0 +1,97 @@
+/*
+ * reaper 2026-11-20 (owner): REAPER-DUT-REDIR - the login page's redirect to an address the admin types
+ * (Administration > Tweaks, "Redirect the login page to the router domain name"). Three settings, kept apart so each
+ * is checked on its own and the name can be masked in a diagnostics report:
+ *     reaper_dut_redir_proto   http | https
+ *     reaper_dut_redir_host    empty = the stock router domain name (stock behaviour), else a host name
+ *     reaper_dut_redir_port    empty = the router's own port for that protocol, else 1-65535
+ * httpd checks every value when the Tweaks page saves it (nvram_check) and when a settings file brings it
+ * (rcfg_put), and checks the name again where it reads it (reaper_host_is_self); Main_Login.asp builds the address
+ * only from values that pass the same rules (its own copy, in script).
+ *
+ * The name: labels of 1-63 letters, digits and '-', no '-' at either end of a label, joined by single dots, at
+ * most RDR_HOST_MAX characters in all. 57, not 63: httpd keeps the request's Host header - the name plus ":port",
+ * up to 6 more - in 64 bytes, and a longer one would be cut (the login page would then see another host). No IP
+ * address: the last label must not be all digits (that is an IPv4 literal; an IPv6 one has ':' and fails anyway) -
+ * the redirect exists to move the browser from the router's address to a name, and an address gains nothing over
+ * the one the browser already uses. Nothing but those characters can reach the page's script or a header.
+ */
+#ifndef REAPER_DUT_REDIR_H
+#define REAPER_DUT_REDIR_H
+
+#include <string.h>
+
+#define RDR_HOST_MAX	57
+
+static inline int rdr_host_ok(const char *h)
+{
+	size_t n, i, lab = 0;
+	int digits = 1;
+
+	if (!h || (n = strlen(h)) == 0 || n > RDR_HOST_MAX)
+		return 0;
+	for (i = 0; i <= n; i++) {
+		char c = h[i];
+
+		if (c == '.' || c == '\0') {
+			if (lab == 0 || lab > 63 || h[i - 1] == '-')
+				return 0;
+			if (c == '\0')
+				break;
+			lab = 0;
+			digits = 1;
+			continue;
+		}
+		if (c == '-') {
+			if (lab == 0)
+				return 0;
+			digits = 0;
+		} else if ((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z'))
+			digits = 0;
+		else if (!(c >= '0' && c <= '9'))
+			return 0;
+		lab++;
+	}
+	return !digits;
+}
+
+/* empty, or 1-65535 written as plain digits (no sign, no leading zero) */
+static inline int rdr_port_ok(const char *p)
+{
+	size_t n, i;
+	long v = 0;
+
+	if (!p)
+		return 0;
+	if ((n = strlen(p)) == 0)
+		return 1;
+	if (n > 5 || p[0] == '0')
+		return 0;
+	for (i = 0; i < n; i++) {
+		if (p[i] < '0' || p[i] > '9')
+			return 0;
+		v = v * 10 + (p[i] - '0');
+	}
+	return v >= 1 && v <= 65535;
+}
+
+static inline int rdr_proto_ok(const char *p)
+{
+	return p && (!strcmp(p, "http") || !strcmp(p, "https"));
+}
+
+/* one of the three settings by its nvram name: 1 = may be stored. Any other reaper_dut_redir_ name is refused. */
+static inline int rdr_field_ok(const char *name, const char *v)
+{
+	if (!name || !v)
+		return 0;
+	if (!strcmp(name, "reaper_dut_redir_proto"))
+		return rdr_proto_ok(v);
+	if (!strcmp(name, "reaper_dut_redir_host"))
+		return !*v || rdr_host_ok(v);
+	if (!strcmp(name, "reaper_dut_redir_port"))
+		return rdr_port_ok(v);
+	return 0;
+}
+
+#endif /* REAPER_DUT_REDIR_H */
