+	for (p = rl; p && *p; p = q) {
+		if (*p == '<')
+			p++;
+		q = p + strcspn(p, "<");
+		if (q > p && rdefer_field(p, (size_t)(q - p), 0, f0, sizeof(f0)) && strcmp(f0, key) == 0) {
+			*row = p;
+			*len = (size_t)(q - p);
+			return 1;
+		}
+	}
+	return 0;
+}
