+	{ "ipse", "cupload.cgi*" }, { "ipse", "c_s2s_upload.cgi*" }, { "uplo", "ad_server_ipsec_cert.cgi*" },
+	{ "caup", "load.cgi*" }, { "exec", "_force_cable_diag.cgi" }, { "feed", "back_mail.cgi*" },
+	{ "dfb_", "log.cgi" }, { "netw", "orkmap.tar" }, { "set_", "app_mnt.cgi*" }, { "get_", "app_mnt.cgi*" },
+	{ "ftpS", "erverTree.cgi*" }, { "set_", "usb_bk.cgi*" },
+	/* v3.8.4, batch 2 */
+	{ "set_", "family_group.cgi" }, { "bloc", "k_device_internet.cgi" }, { "inte", "rnet_ctrl.cgi*" },
+	{ "del_", "client_data.cgi*" }, { "set_", "pc_reward.cgi*" }, { "get_", "pc_reward.cgi*" },
+	{ "enab", "le_remote_control.cgi" }, { "get_", "custom_clientlist.cgi" }, { "nc_e", "xist_wifi_notice.cgi" },
+	{ "nc_n", "ew_wifi_notice.cgi" }, { "nc_e", "xist_wifi_notice_app.cgi" },
+	{ "nc_n", "ew_wifi_notice_app.cgi" }, { "nc_n", "otice.cgi" }, { "get_", "nc_conf.cgi*" },
+	/* v3.8.4, batch C (REAPER-UNUSED-V384C) */
