+/* POST /chpass.cgi: the fields and their encoding are the stock API script's chpass() */
+function chpass(postData, done){
+	var x = new XMLHttpRequest(), body = [], k, fired = false;
+	function end(rc){ if (!fired){ fired = true; done(rc); } }
+	if (!postData.http_id) postData.http_id = HTTPID;
+	if (postData.cur_username) postData.cur_username = md5hex(postData.cur_username);
+	if (postData.cur_passwd) postData.cur_passwd = md5hex(postData.cur_passwd);
+	if (postData.new_username) postData.new_username = btoa(postData.new_username);
+	if (postData.new_passwd) postData.new_passwd = btoa(postData.new_passwd);
+	for (k in postData) if (Object.prototype.hasOwnProperty.call(postData, k)) body.push(encodeURIComponent(k) + '=' + encodeURIComponent(postData[k]));
+	x.open('POST', '/chpass.cgi', true);
+	x.setRequestHeader('Content-Type', 'application/x-www-form-urlencoded; charset=UTF-8');
+	x.onload = function(){
+		var rc = "-1";
+		try { if (x.status === 200) rc = JSON.parse(x.responseText).statusCode; } catch (e) { rc = "-1"; }
+		end(rc);
+	};
+	x.onerror = x.ontimeout = x.onabort = function(){ end("-1"); };
+	x.send(body.join('&').replace(/%20/g, '+'));
 }
 
