@@ -0,0 +1,40 @@
+<!DOCTYPE html>
+<html>
+<head>
+<meta charset="utf-8">
+<title>LED scheduler</title>
+<!-- reaper 2026-11-25 (native-UI cutover, stage 2): host for the stock LED scheduler (js/ledScheduler.js).
+     Reaper_AiMesh.asp opens this file in a hidden frame from its System Settings tab; the scheduler draws its
+     window in the top document, as it did from the stock AiMesh page, and announces "ledSchedulerClosed" there
+     when it is closed. The owner's decision was to keep the stock scheduler until the final cutover stage; this
+     file gives it the stock scripts it needs (jQuery, state.js for isSupport, httpApi.js) without loading them
+     into the Reaper page. It is removed with the stock scheduler. -->
+<script type="text/javascript" src="/js/jquery.js"></script>
+<script type="text/javascript" src="/state.js"></script>
+<script type="text/javascript" src="/js/httpApi.js"></script>
+<script type="text/javascript" src="/js/ledScheduler.js"></script>
+</head>
+<body>
+<script>
+(function(){
+'use strict';
+var TOKEN = '<% nvram_get("http_id"); %>';
+var q = location.search, night = q.indexOf('night=1') >= 0, mode = q.indexOf('mode=ledNight') >= 0 ? 'ledNight' : 'led';
+if (window.top === window.self) return;                        /* a host only: nothing to show on its own */
+/* httpd refuses an apply without the page token; the scheduler saves through httpApi.nvramSet */
+if (typeof httpApi === 'object' && typeof httpApi.nvramSet === 'function'){
+  var save = httpApi.nvramSet;
+  httpApi.nvramSet = function(o){ if (o && typeof o === 'object' && !o.http_id) o.http_id = TOKEN; return save.apply(this, arguments); };
+}
+function closed(){ try { window.top.dispatchEvent(new CustomEvent('ledSchedulerClosed')); } catch (e) {} }
+if (typeof popupLedScheduler !== 'function'){ closed(); return; }
+try {
+  var s = new popupLedScheduler({theme: '', schedMode: mode, hide_btn_back_container: true, popupTitle: `<#Schedule_LED_Scheduler#>`, ledClassType: 'led', supportLedNightMode: night});
+  s.show();
+  var m = s.shadowRoot && s.shadowRoot.querySelector('.modal');
+  if (m) m.style.top = '50px';
+} catch (e) { closed(); }
+})();
+</script>
+</body>
+</html>
