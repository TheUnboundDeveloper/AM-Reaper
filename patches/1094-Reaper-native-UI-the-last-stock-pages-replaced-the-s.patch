+    <h2><span id="c_model"></span><small id="c_mac"></small><span class="warnf off" id="c_nosup" title="">!</span></h2>
+    <div class="kv">
+      <div class="k"><#AiMesh_NodeLocation#></div>
+      <div class="v">
+        <select id="c_loc"></select>
+        <input type="text" id="c_loc_txt" maxlength="32" autocomplete="off" class="off">
