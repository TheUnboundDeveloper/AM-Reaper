+.ep_box{margin:8px 0 0;padding:14px 18px}
+.ep_box ul{margin:0;padding:0 0 0 18px} .ep_box li{margin:0 0 6px} .ep_box li:last-child{margin:0}
+.ep_box a{color:var(--bone)!important;text-decoration:underline}
+.ep_note{margin:14px 0 0;text-align:center}
+.ep_anim{display:flex;align-items:center;justify-content:center;gap:10px;padding:14px 0}
