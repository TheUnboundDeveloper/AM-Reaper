+/* reaper_cb.css - colour-blind mode (REAPER-CBMODE, owner request 2026-11-26; Administration > System >
+   Accessibility, nvram reaper_cbmode). Every Reaper colour is written var(--cb-<role>,<today's colour>); the
+   --cb-* properties exist only while <html> carries class "cb", so with the mode off nothing here applies.
+   The owner's table: red accent -> #3B82F6, green -> #38BDF8, teal -> #7DD3FC, amber -> #FACC15,
+   red alert / upload / loss -> #FB923C, dark red tints -> #1E293B. Shades and series are derived:
+   acc         #3B82F6  owner: red primary accent -> Electric Blue
+   acc-deep    #2563EB  darker accent (was #B3000C): gradients, pressed, hover borders
+   acc-dim     #1E3A8A  dim accent (was #7A0C0C): button edges
+   acc-hi      #60A5FA  light accent (was #FF3B2A / #FF453F): link hover
+   tint        #1E293B  owner: dark red icon / box tints -> Muted Slate Blue
+   tint-deep   #0F172A  darker tint (was #160204 / #330000 / #1A0B0B)
+   ok          #38BDF8  owner: green positive -> Bright Cyan
+   ok-deep     #0284C7  darker positive (was #1A7F4B / #3D7A5C)
+   ok-pale     #BAE6FD  pale positive text (was #9FD8BB / #7FD9A3)
+   data        #7DD3FC  owner: teal data -> Sky Ice (download line, rate figures)
+   warn        #FACC15  owner: amber warning -> Warm Gold
+   warn-deep   #CA8A04  darker warning (was #B5851F / #BDA158)
+   warn-hi     #FDE047  light warning (was #F0BD57): banner button hover
+   warn-tint   #17150A  dark warning banner base (was #14110B)
+   alert       #FB923C  owner: red alert / upload / loss -> Bright Orange
+   alert-deep  #EA580C  darker alert (was #C1121F, and #B3000C where red means wrong)
+   alert-dim   #9A3412  dim alert (was #7A0C0C where red means wrong)
+   alert-pale  #FED7AA  pale alert text (was #F0B6B2 / #E0837D)
+   alert-tint  #1C1208  dark alert banner base (was #160C0B)
+   s1          #3B82F6  series 1 blue (was #3987E5)
+   s2          #E69F00  series 2 orange (was green #199E70)
+   s3          #F0E442  series 3 yellow (was amber #C98500)
+   s4          #CC79A7  series 4 reddish purple (was purple #9085E9)
+   s5          #D55E00  series 5 vermillion (was orange #D95926)
+   s6          #56B4E9  series 6 sky blue (was red #E66767)
+   s7          #009E73  series 7 bluish green (was pink #D55181)
+   Generated by cbify.py (keep the inline copy on the sign-in pages identical: test_cbmode.py). */
+html.cb{--cb-acc:#3B82F6;--cb-acc-rgb:59,130,246;--cb-acc-deep:#2563EB;--cb-acc-deep-rgb:37,99,235;--cb-acc-dim:#1E3A8A;--cb-acc-dim-rgb:30,58,138;--cb-acc-hi:#60A5FA;--cb-acc-hi-rgb:96,165,250;--cb-tint:#1E293B;--cb-tint-rgb:30,41,59;--cb-tint-deep:#0F172A;--cb-tint-deep-rgb:15,23,42;--cb-ok:#38BDF8;--cb-ok-rgb:56,189,248;--cb-ok-deep:#0284C7;--cb-ok-deep-rgb:2,132,199;--cb-ok-pale:#BAE6FD;--cb-ok-pale-rgb:186,230,253;--cb-data:#7DD3FC;--cb-data-rgb:125,211,252;--cb-warn:#FACC15;--cb-warn-rgb:250,204,21;--cb-warn-deep:#CA8A04;--cb-warn-deep-rgb:202,138,4;--cb-warn-hi:#FDE047;--cb-warn-hi-rgb:253,224,71;--cb-warn-tint:#17150A;--cb-warn-tint-rgb:23,21,10;--cb-alert:#FB923C;--cb-alert-rgb:251,146,60;--cb-alert-deep:#EA580C;--cb-alert-deep-rgb:234,88,12;--cb-alert-dim:#9A3412;--cb-alert-dim-rgb:154,52,18;--cb-alert-pale:#FED7AA;--cb-alert-pale-rgb:254,215,170;--cb-alert-tint:#1C1208;--cb-alert-tint-rgb:28,18,8;--cb-s1:#3B82F6;--cb-s1-rgb:59,130,246;--cb-s2:#E69F00;--cb-s2-rgb:230,159,0;--cb-s3:#F0E442;--cb-s3-rgb:240,228,66;--cb-s4:#CC79A7;--cb-s4-rgb:204,121,167;--cb-s5:#D55E00;--cb-s5-rgb:213,94,0;--cb-s6:#56B4E9;--cb-s6-rgb:86,180,233;--cb-s7:#009E73;--cb-s7-rgb:0,158,115;--cb-alert-wash:rgba(251,146,60,.16)}
