+<!-- P1 (Reaper): the mesh daemon only runs once the router is set up as the mesh controller -->
+<div class="notice off" id="setupnote"><#RAMS_10#> <a href="/reaper_shell.asp#Reaper_WiFiSetup.asp" target="_top"><#RWFS_1#></a></div>
+
+<div class="tabs" id="tabs">
+  <button type="button" data-t="topo" class="on"><#AiMesh_Topology#></button>
