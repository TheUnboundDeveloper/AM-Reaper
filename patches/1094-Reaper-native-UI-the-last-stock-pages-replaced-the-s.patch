diff --git a/release/src/router/tools/reaper_dict_prune.py b/release/src/router/tools/reaper_dict_prune.py
new file mode 100755
index 0000000000..c1207c5e70
--- /dev/null
+++ b/release/src/router/tools/reaper_dict_prune.py
@@ -0,0 +1,140 @@
+#!/usr/bin/env python3
+"""reaper_dict_prune.py <staged-www> <key-list> [dictenum.txt]
+
+REAPER-CUT8-DICT (native-UI cutover stage 5, 2026-11-27). Drops from the STAGED language packs the dictionary keys
+that only the stock pages removed at install named (the list: tools/reaper_dict_prune.txt). The source packs are not
+touched, so an upstream dictionary merge stays a plain merge.
+
+Two staged forms exist, and the tool reads which one it has from the EN pack itself:
+  named    (102.10 Dev / unify: lines are KEY=text, httpd looks a key up by name)  -> the line is deleted.
+  numbered (102.8: LnxDictPrep renumbered every key; lines are the text alone and httpd indexes them by line
+           position, so deleting a line would shift every later string)          -> the line is emptied in place;
+           dictenum.txt (N=KEY, written by LnxDictPrep) says which line holds which key.
+Refuses, and exits 1 so the install fails, when: a pack is missing or unreadable, the form is unclear, the numbered
+form has no dictenum.txt, the packs stop being lockstep (equal line counts), or any staged file other than a pack
+still names a listed key (<#KEY#>, or its number in the numbered form) - that page would print nothing there.
+Byte-exact otherwise: every other line, the UTF-8 BOM and the final newline are kept as they were. A second run is a
+no-op (named form: the keys are gone; numbered form: the lines are already empty).
+"""
+import os, re, sys
+
+TOK = re.compile(rb'<#([A-Za-z0-9_]+)#>')
+KV = re.compile(rb'^[A-Za-z][A-Za-z0-9_]*=')
+BOM = b'\xef\xbb\xbf'
+
+
+def die(msg):
+    sys.stderr.write('reaper_dict_prune: REFUSED - %s\n' % msg)
+    sys.exit(1)
+
+
+def load_list(path):
+    keys = []
+    for line in open(path, 'rb'):
+        line = line.strip()
+        if not line or line.startswith(b'#'):
+            continue
+        if not re.match(rb'^[A-Za-z0-9_]+$', line):
+            die('bad key in %s: %r' % (path, line))
+        keys.append(line.decode())
+    if not keys:
+        die('empty key list %s' % path)
+    return set(keys)
+
+
+def form_of(data):
+    lines = [l for l in data.split(b'\n') if l.strip()]
+    if not lines:
+        return None
+    named = sum(1 for l in lines if KV.match(l[3:] if l.startswith(BOM) else l))
+    if named > 0.9 * len(lines):
+        return 'named'
+    if named < 0.01 * len(lines):
+        return 'numbered'
+    return None
+
+
+def main(argv):
+    if len(argv) not in (3, 4):
+        sys.stderr.write(__doc__)
+        return 2
+    www, listf = argv[1], argv[2]
+    enumf = argv[3] if len(argv) == 4 else ''
+    keys = load_list(listf)
+    packs = sorted(f for f in os.listdir(www) if f.endswith('.dict') and f != 'temp.dict')
+    if 'EN.dict' not in packs:
+        die('no EN.dict in %s' % www)
+    data = {p: open(os.path.join(www, p), 'rb').read() for p in packs}
+    form = form_of(data['EN.dict'])
+    if form is None:
+        die('cannot tell whether EN.dict is the named or the numbered form')
+    nums = set()
+    if form == 'numbered':
+        if not enumf or not os.path.isfile(enumf):
+            die('numbered packs but no dictenum.txt (%s)' % (enumf or 'not given'))
+        for line in open(enumf, 'rb'):
+            line = line.lstrip(BOM).rstrip(b'\r\n')
+            if b'=' in line:
+                n, k = line.split(b'=', 1)
+                if k.decode('utf-8', 'replace') in keys and n.isdigit():
+                    nums.add(int(n))
+    # guard: nothing that ships may still name a listed key
+    named_by = []
+    for root, _, files in os.walk(www):
+        for f in files:
+            p = os.path.join(root, f)
+            if f.endswith('.dict') or os.path.islink(p) or not os.path.isfile(p):
+                continue
+            for m in set(TOK.findall(open(p, 'rb').read())):
+                m = m.decode()
+                if (form == 'named' and m in keys) or (form == 'numbered' and m.isdigit() and int(m) in nums):
+                    named_by.append('%s <#%s#>' % (os.path.relpath(p, www), m))
+    if named_by:
+        die('%d staged token(s) still name a listed key: %s' % (len(named_by), '; '.join(sorted(named_by)[:20])))
+    before = after = 0
+    hit_en = 0
+    out = {}
+    for p in packs:
+        lines = data[p].split(b'\n')
+        new = []
+        carry = b''
+        for i, line in enumerate(lines):
+            if form == 'named':
+                body = line[3:] if line.startswith(BOM) else line
+                k = body.split(b'=', 1)[0].decode('utf-8', 'replace') if b'=' in body else None
+                if k in keys:
+                    if line.startswith(BOM):
+                        carry = BOM
+                    if p == 'EN.dict':
+                        hit_en += 1
+                    continue
+            else:
+                if i in nums:
+                    if p == 'EN.dict':
+                        hit_en += 1
+                    line = BOM if line.startswith(BOM) else b''
+            if carry and not line.startswith(BOM):
+                line = carry + line
+            carry = b''
+            new.append(line)
+        out[p] = b'\n'.join(new)
+        before += len(data[p]); after += len(out[p])
+    counts = set(o.count(b'\n') for o in out.values())
+    if len(counts) != 1:
+        die('packs would stop being lockstep: %s' % sorted(counts))
+    if hit_en == 0:
+        # a list key the packs no longer carry is not an error (an upstream merge may drop it first); the lean test
+        # test_dict_prune.py is what catches a list that does not belong to the tree
+        print('reaper_dict_prune: %s form, none of the %d listed keys is in EN.dict - nothing to drop' % (form, len(keys)))
+        return 0
+    for p in packs:
+        if out[p] != data[p]:
+            with open(os.path.join(www, p), 'wb') as fh:
+                fh.write(out[p])
+    print('reaper_dict_prune: %s form, %d packs, %d of %d listed keys present, %d -> %d bytes (%d dropped)'
+          % (form, len(packs), hit_en, len(keys), before, after, before - after))
+    return 0
+
+
+if __name__ == '__main__':
+    sys.exit(main(sys.argv))
