+       Repeater     -> /QIS_wizard.htm?flag=sitesurvey_rep   (Express Way 2.4 / 5 GHz: sitesurvey_exp2 / sitesurvey_exp5)
+       AiMesh Node  -> /QIS_wizard.htm?flag=amasnode_page
+     Kept from stock: which modes are offered (noRouter, noAP, repeater, psta, rp_express_2g / _5g, amas + amasNode),
+     the labels and descriptions per mode (AiMesh wording on an AiMesh router), "already in this mode" (for Repeater
+     the Express Way choice counts too), and the AiMesh question before Repeater or Media Bridge on an AiMesh router.
+     Differences, on purpose: no mode picture; the questions are Reaper dialogs, not browser confirm boxes; the
+     descriptions' link to ASUS's Device Discovery download is not carried (plain text stays). WISP is not offered:
+     no supported model builds it (the stock page's WISP branch was removed on 2026-10-15). -->
+<link rel="stylesheet" href="/reaper/rp.css">
+<style>
+/* page-specific rules only; the Reaper look comes from /reaper/rp.css */
+.msg{font-size:12.5px;color:var(--amber);display:none}
+.modes{display:flex;flex-direction:column;gap:8px;margin:4px 0 14px}
+.mode{display:flex;align-items:center;gap:10px;padding:10px 12px;border:1px solid var(--line-soft);border-radius:10px;background:var(--raised);cursor:pointer}
+.mode:hover{border-color:var(--line2)}
+.mode.sel{border-color:rgba(var(--cb-ok-rgb,79,178,134),.55)}
+.mode input{margin:0;flex:0 0 auto}
+.mode .nm{font-size:13.5px;color:var(--bone);min-width:0;overflow-wrap:anywhere}
+.mode .now{margin-left:auto;font-family:var(--hdr);font-weight:600;font-size:10.5px;letter-spacing:.12em;text-transform:uppercase;color:var(--jade);flex:0 0 auto}
+.desc{font-size:13px;color:var(--bone-dim);line-height:1.6;overflow-wrap:anywhere}
+.desc .warn{color:var(--amber)}
+</style>
+</head>
+<body>
+<script src="/reaper_util.js"></script>
+<script src="/reaper/rp.js"></script>
+
+<div class="syswrap">
+<div class="pagehead">
+  <div>
+    <div class="eyebrow"><#menu5_6#></div>
+    <h1><#menu5_6_1#></h1>
+  </div>
+  <div class="spacer"></div>
+  <button type="button" class="btn primary" id="savebtn"><#CTL_onlysave#></button>
+</div>
+<div class="msg" id="topmsg" style="margin:-6px 0 12px"></div>
+<div class="hint" style="margin:-4px 0 14px" id="intro"></div>
+
+<div class="rframe">
+<div class="panel">
+  <h2><#menu5_6_1#></h2>
+  <div class="modes" id="modes"></div>
+  <div class="desc" id="desc"></div>
+</div>
+</div>
+</div>
+
+<script>
+(function(){
+'use strict';
+/* everything stays inside this closure: a page-level name can shadow reaper_util.js's window.esc and friends */
+var q = rp.q;
+var msg = rp.msg, on = rp.on;                                  /* the kit's copies (rp.js) */
+var UI = {}; try { UI = [<% get_ui_support(); %>][0] || {}; } catch (e) {}
+var MODE = 'rt'; try { MODE = String([<% get_operation_mode(); %>][0] || 'rt').toLowerCase(); } catch (e) {}
+var NV = { wlc_express: <% nvram_get_js("wlc_express"); %>, model: <% nvram_get_js("productid"); %>, odmpid: <% nvram_get_js("odmpid"); %> };
+function sup(x){ return !!UI[x]; }
+var MESH = sup('amas') && sup('amasRouter');                   /* an AiMesh router: the AiMesh wording and questions */
+var NAME = NV.odmpid || NV.model;
+function T(s){ return String(s).split('ZVMODELVZ').join(NAME); }
+
+/* the mode the router is in now, in the stock page's numbering (1 router, 2 repeater, 3 AP, 4 media bridge) */
+var NOW = MODE === 'mb' ? '4' : MODE === 'ap' ? '3' : (MODE === 'rp' || MODE === 're') ? '2' : '1';
+var NOWX = /^[12]$/.test(NV.wlc_express) ? NV.wlc_express : '0';
+
+/* the stock notes about the changed address end in a link to ASUS's Device Discovery download; keep the words */
+function plain(s){ var d = document.createElement('div'); d.innerHTML = T(s); return d.textContent; }
+var MODES = [
+  {id: 'rt', mode: '1', x: '0', when: !sup('noRouter'), label: MESH ? `<#AiMesh_GW_item#>` : `<#OP_GW_item#>`,
+   desc: MESH ? [`<#AiMesh_GW_desc#>`, `<#AiMesh_Node_Add#>`] : [`<#OP_GW_desc#>`], warn: ''},
+  {id: 'ap', mode: '3', x: '0', when: !sup('noAP'), label: MESH ? `<#AiMesh_AP_item#>` : `<#OP_AP_item#>`,
+   desc: MESH ? [`<#AiMesh_AP_desc#>`, `<#AiMesh_Node_Add#>`] : [`<#OP_AP_desc#>`], warn: MESH ? `<#AiMesh_deviceDiscorvy3#>` : `<#deviceDiscorvy3#>`},
+  {id: 'rp', mode: '2', x: '0', when: sup('repeater'), label: `<#OP_RE_item#>`, desc: [`<#OP_RE_desc#>`], warn: `<#deviceDiscorvy2#>`},
+  {id: 'x2', mode: '2', x: '1', when: sup('rp_express_2g'), label: `<#OP_RE2G_item#>`, desc: [`<#OP_RE2G_desc#>`], warn: `<#deviceDiscorvy2#>`},
+  {id: 'x5', mode: '2', x: '2', when: sup('rp_express_5g'), label: `<#OP_RE5G_item#>`, desc: [`<#OP_RE5G_desc#>`], warn: `<#deviceDiscorvy2#>`},
+  {id: 'mb', mode: '4', x: '0', when: sup('psta'), label: `<#OP_MB_item#>`,
+   desc: [`<#OP_MB_desc1#>` + `<#OP_MB_desc2#>` + `<#OP_MB_desc3#>` + `<#OP_MB_desc4#>` + `<#OP_MB_desc5#>`, `<#OP_MB_desc6#>`], warn: `<#deviceDiscorvy4#>`},
+  {id: 'node', mode: '5', x: '0', when: sup('amas') && sup('amasNode'), label: `<#AiMesh_Node#>`,
+   desc: [`<#AiMesh_Node_desc#>`, '1. ' + `<#AiMesh_Node_desc1#>`, '2. ' + `<#AiMesh_Node_desc2#>`], warn: ''}
+].filter(function(m){ return m.when; });
+
+var picked = null;
+function isNow(m){ return m.mode === NOW && (m.mode !== '2' || m.x === NOWX); }
+function describe(m){
+  var d = q('desc'), p; d.textContent = '';
+  m.desc.forEach(function(t){ p = document.createElement('div'); p.textContent = plain(t); d.appendChild(p); });
+  if (m.warn){ p = document.createElement('div'); p.className = 'warn'; p.textContent = plain(m.warn); d.appendChild(p); }
+}
+function pick(m){
+  picked = m; msg('');
+  Array.prototype.forEach.call(q('modes').children, function(row){ row.classList.toggle('sel', row.getAttribute('data-id') === m.id); });
+  describe(m);
+}
+function draw(){
+  var box = q('modes'), first = null;
+  MODES.forEach(function(m){
+    var row = document.createElement('label'), r = document.createElement('input'), n = document.createElement('span'), now;
+    row.className = 'mode'; row.setAttribute('data-id', m.id);
+    r.type = 'radio'; r.name = 'opmode'; r.value = m.id; r.checked = isNow(m);
+    r.addEventListener('change', function(){ if (r.checked) pick(m); });
+    n.className = 'nm'; n.textContent = plain(m.label);
+    row.appendChild(r); row.appendChild(n);
+    if (isNow(m)){ now = document.createElement('span'); now.className = 'now'; now.textContent = `<#Status_Active#>`; row.appendChild(now); first = m; }
+    box.appendChild(row);
+  });
+  pick(first || MODES[0]);
+}
+function go(url){ (window.top || window).location.href = url; }
+/* reaper_util.js reaperConfirm(message, options, callback(answer)): text only, anchored to the visible part of the frame */
+function ask(text, yes){
+  if (typeof window.reaperConfirm === 'function') window.reaperConfirm(text, {okLabel: `<#CTL_ok#>`, cancelLabel: `<#CTL_Cancel#>`}, function(ok){ if (ok) yes(); });
+  else if (window.confirm(text)) yes();
+}
+function proceed(m){
+  if (m.mode === '2'){ go(m.x === '1' ? '/QIS_wizard.htm?flag=sitesurvey_exp2' : m.x === '2' ? '/QIS_wizard.htm?flag=sitesurvey_exp5' : '/QIS_wizard.htm?flag=sitesurvey_rep'); return; }
+  if (m.mode === '4'){ go('/Reaper_ModeSetup.asp?mode=mb'); return; }
+  if (m.mode === '5'){ go('/QIS_wizard.htm?flag=amasnode_page'); return; }
+  /* Router <-> Access Point on a model with the Network page: the stock warning (what stops working, the cleared
+     network list, the advice to save the configuration first) */
+  var from = m.mode === '3' ? '1' : '3', hint;
+  if (sup('mtlancfg') && NOW === from){
+    hint = `<#OP_sdn_change_mode_desc1#>`.replace('#FUNCTIONS', `<#AiProtection_title#>` + ', ' + `<#vpnc_title#>` + ', ' + `<#BOP_isp_heart_item#>` + ', ' + `<#EzQoS_type_QoS#>`) + '\n' +
+           `<#OP_sdn_change_mode_desc2#>`.replace('#GUESTNAMING', `<#GuestNetwork_PRO_title#>`) + '\n' +
+           `<#OP_sdn_change_mode_desc3#>`.replace('#OPMODE', plain(m.label)) + '\n' + `<#Setting_factorydefault_hint2#>`;
+    ask(hint, function(){ go('/Reaper_ModeSetup.asp?mode=' + (m.mode === '3' ? 'ap' : 'rt')); });
+    return;
+  }
+  go('/Reaper_ModeSetup.asp?mode=' + (m.mode === '3' ? 'ap' : 'rt'));
+}
+function save(){
+  var m = picked;
+  if (!m) return;
+  if (isNow(m)){ msg(NAME + ' ' + `<#op_already_configured#>`); return; }
+  /* an AiMesh router leaving for Repeater or Media Bridge: the mesh stops */
+  if (MESH && (m.mode === '2' || m.mode === '4')){
+    ask((m.mode === '2' ? `<#AiMesh_confirm_msg2#>` : `<#AiMesh_confirm_msg4#>`) + '\n' + `<#AiMesh_confirm_msg0#>`, function(){ proceed(m); });
+    return;
+  }
+  proceed(m);
+}
+q('intro').textContent = plain(`<#OP_desc1#>`);
+if (MODES.length){ draw(); on('savebtn', 'click', save); } else q('savebtn').disabled = true;
+})();
+</script>
+</body>
+</html>
