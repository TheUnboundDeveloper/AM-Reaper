+return {
+  names: typeof pool_names === 'function' ? pool_names : null,
+  status: typeof pool_status === 'function' ? pool_status : null,
+  kb: typeof pool_kilobytes === 'function' ? pool_kilobytes : null,
+  used: typeof pool_kilobytes_in_use === 'function' ? pool_kilobytes_in_use : null
+};
+})();
+</script>
+
+<div class="syswrap">
+<div class="pagehead">
+  <div>
+    <div class="eyebrow"><#Menu_usb_application#></div>
+    <h1><#TimeMach#></h1>
+  </div>
+  <span class="pill" id="statepill"><span class="dot"></span><span id="statetext"></span></span>
+  <div class="spacer"></div>
+  <span class="pill warn chgpill" id="chgpill"><span class="dot"></span><span><#RADM_77#>: <b id="chgcount">0</b></span></span>
+  <button type="button" class="btn ghost" id="discardbtn" disabled><#Discard#></button>
+  <button type="button" class="btn primary" id="applybtn"><#CTL_apply#></button>
+</div>
+<div class="msg" id="topmsg" style="margin:-6px 0 12px"></div>
+
+<div class="rframe">
+<div class="panel" id="p_tm">
+  <h2><#t2BC#></h2>
+  <ol class="steps">
+    <li><#TimeMach_enable#></li>
+    <li><#TimeMach_target#></li>
+    <li><#TimeMach_usage_limit#></li>
+    <li><#TimeMach_backup#></li>
+  </ol>
+  <div class="frow"><div class="fl"><#TimeMach_enable#></div><div class="fc"><label class="tswitch"><input type="checkbox" id="t_enable"><span class="track"></span></label></div></div>
+  <div class="frow on1" id="r_part"><div class="fl"><#TimeMach_backuppath#></div><div class="fc"><select id="s_part"></select></div><div class="fh" id="h_part"></div></div>
+  <div class="frow on1" id="r_size"><div class="fl"><#TimeMach_vol_size#></div><div class="fc"><input type="text" class="num" id="i_size" maxlength="5" inputmode="numeric" autocomplete="off" placeholder="0"> GB (0: <#Limitless#>)</div><div class="fh" id="h_size"></div></div>
+  <div class="hint"><#TimeMach_recommand1#><br><#TimeMach_recommand2#><br><#TimeMach_recommand3#></div>
+</div>
+</div>
+</div>
+
+<div class="applying" id="applying"><div class="abox"><h2 id="ap_t"><#Reaper_c_applying#></h2><p id="ap_p"><#RADM_61#></p></div></div>
+<iframe name="hidden_frame" id="hidden_frame" style="display:none" width="0" height="0"></iframe>
+<form method="post" name="form" action="/start_apply.htm" target="hidden_frame">
+  <input type="hidden" name="current_page" value="Reaper_TimeMachine.asp">
+  <input type="hidden" name="next_page" value="Reaper_TimeMachine.asp">
+  <input type="hidden" name="action_mode" value="apply">
+  <input type="hidden" name="action_script" value="">
+  <input type="hidden" name="action_wait" value="5">
+  <!-- settings fields: added by rp.post at Apply -->
+</form>
+
+<script>
+(function(){
+'use strict';
+/* everything stays inside this closure: a page-level name can shadow reaper_util.js's window.esc and friends */
+var q = rp.q;
+var chk = rp.chk, U = rp.dec, msg = rp.msg, on = rp.on, setChk = rp.setChk;   /* the kit's copies (rp.js) */
+
+/* what the box holds now: the page posts only what differs from this. tm_vol_size is stored in MB. */
+var NV = {
+  timemachine_enable: <% nvram_get_js("timemachine_enable"); %>,
+  tm_device_name: U('<% nvram_char_to_ascii("","tm_device_name"); %>'),
+  tm_vol_size: <% nvram_get_js("tm_vol_size"); %>
+};
+if (NV.timemachine_enable !== '1') NV.timemachine_enable = '0';
+if (!/^\d+$/.test(NV.tm_vol_size)) NV.tm_vol_size = '0';
+
+/* mounted partitions: name (the mount directory, what tm_device_name holds), free and total space in GB */
+function call(f){ try { return typeof f === 'function' ? (f() || []) : []; } catch (e) { return []; } }
+function gb(kb){ return Math.floor(kb / 1024 / 1024 * 100) / 100; }
+var PARTS = (function(){
+  var d = rp.usbData || {}, names = call(d.names), st = call(d.status), kb = call(d.kb), used = call(d.used), out = [], i;
+  for (i = 0; i < names.length; i++){
+    if (String(st[i] || '') === 'unmounted' || !names[i]) continue;
+    var total = +kb[i] || 0, free = Math.max(0, total - (+used[i] || 0));
+    out.push({name: String(names[i]), free: gb(free), total: gb(total)});
+  }
+  return out;
+})();
+function part(name){ var i; for (i = 0; i < PARTS.length; i++) if (PARTS[i].name === name) return PARTS[i]; return null; }
+
+function fillParts(){
+  var s = q('s_part'), o, i, p, saved = NV.tm_device_name;
+  s.textContent = '';
+  o = document.createElement('option'); o.value = ''; o.textContent = PARTS.length ? `<#DM_Install_partition#>` : `<#no_usb_found#>`; s.appendChild(o);
+  for (i = 0; i < PARTS.length; i++){
+    p = PARTS[i]; o = document.createElement('option'); o.value = p.name;
+    o.textContent = '/mnt/' + p.name + '  -  ' + `<#Availablespace#>` + ': ' + p.free + ' GB, ' + `<#Totalspace#>` + ': ' + p.total + ' GB';
+    /* stock: a partition with 1 GB free or less cannot be chosen (the saved one stays selectable) */
+    if (!(p.free > 1) && p.name !== saved) o.disabled = true;
+    s.appendChild(o);
+  }
+  /* the saved partition is shown even while its disk is unplugged, so a save never drops it silently */
+  if (saved && !part(saved)){ o = document.createElement('option'); o.value = saved; o.textContent = '/mnt/' + saved; s.appendChild(o); }
+  s.value = saved;
+}
+function sizeHint(){
+  var p = part(q('s_part').value);
+  q('h_size').textContent = p ? `<#Availablespace#>` + ': ' + p.free + ' GB' : '';
+}
+function sync(){
+  var up = q('t_enable').checked, rows = document.querySelectorAll('.frow.on1'), i;
+  for (i = 0; i < rows.length; i++) rows[i].classList.toggle('off', !up);
+  sizeHint();
+}
+function statePill(){
+  var up = NV.timemachine_enable === '1';
+  q('statetext').textContent = up ? `<#btn_Enabled#>` : `<#btn_Disabled#>`;
+  q('statepill').className = 'pill' + (up ? ' on' : '');
+}
+/* GB typed -> MB stored; an empty box is 0 (no limit), as on the stock page */
+var SIZE0 = '';                       /* what the box showed at load: left alone, the stored MB value is kept as is */
+function sizeMb(){
+  var v = q('i_size').value.trim();
+  if (v === SIZE0) return NV.tm_vol_size;
+  return v === '' ? '0' : (/^\d+$/.test(v) ? String(parseInt(v, 10) * 1024) : null);
+}
+function collect(){
+  return { timemachine_enable: chk('t_enable'), tm_device_name: q('s_part').value, tm_vol_size: sizeMb() };
+}
+function diff(c){ var x = {timemachine_enable: c.timemachine_enable, tm_device_name: c.tm_device_name, tm_vol_size: c.tm_vol_size === null ? '?' : c.tm_vol_size}; return rp.diff(x, NV); }
+function dirty(){ rp.dirtyMark(diff(collect())); }
+function bad(id, m){
+  var el = q(id), row = el && el.closest ? el.closest('.frow') : null;
+  if (row){ row.classList.add('bad'); setTimeout(function(){ row.classList.remove('bad'); }, 6000); }
+  if (el && el.focus) el.focus();
+  return m;
+}
+function validate(c){
+  var p, max;
+  if (c.timemachine_enable === '1' && c.tm_device_name === '') return bad('s_part', `<#DM_Install_partition#>`);
+  p = part(c.tm_device_name); max = p ? Math.floor(p.free) : null;
+  /* stock: a whole number from 0 to the free space of the partition, in GB (no upper check while its disk is away) */
+  if (c.tm_vol_size === null || (max !== null && parseInt(c.tm_vol_size, 10) / 1024 > max))
+    return bad('i_size', `<#JS_validrange#>` + ' 0 ' + `<#JS_validrange_to#>` + ' ' + (max === null ? 99999 : max));
+  return '';
+}
+function applyAll(){
+  msg('');
+  var c = collect(), err = validate(c), changed, n = 0, k;
+  if (err){ msg(err); return; }
+  changed = diff(c); for (k in changed) n++;
+  if (!n){ msg(`<#RADM_63#>`); return; }
+  changed.tm_ui_setting = '1';        /* rc/timemachine.c: take the partition named by the page */
+  rp.applying(`<#Reaper_c_applying#>`, `<#RADM_61#>`);
+  rp.post(document.form, changed, 'restart_timemachine', 5, false);
+  setTimeout(function(){ location.reload(); }, 9000);
+}
+
+setChk('t_enable', NV.timemachine_enable === '1');
+fillParts();
+SIZE0 = NV.tm_vol_size === '0' ? '' : String(Math.floor(parseInt(NV.tm_vol_size, 10) / 1024));
+q('i_size').value = SIZE0;
+on('applybtn', 'click', applyAll);
+on('discardbtn', 'click', function(){ location.reload(); });
+on('t_enable', 'change', sync);
+on('s_part', 'change', function(){ q('i_size').value = ''; sizeHint(); });   /* stock: another partition clears the size */
+document.addEventListener('input', dirty); document.addEventListener('change', dirty);
+sync(); statePill(); dirty();
+})();
+</script>
+</body>
+</html>
