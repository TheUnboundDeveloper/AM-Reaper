+<!-- SPDX-License-Identifier: GPL-2.0-only
+     Copyright (C) 2026 the Reaper project maintainer
+     Part of the Reaper hardened Asuswrt-Merlin build. See LICENSE / LICENSE.reaper. -->
+<!DOCTYPE html>
+<html lang="en">
+<head>
+<meta charset="utf-8">
+<link rel="stylesheet" href="/reaper/reaper_cb.css"><script>/*REAPER-CBMODE*/if(<% nvram_get_js("reaper_cbmode"); %>==="1")document.documentElement.classList.add("cb");</script>
+<meta name="viewport" content="width=device-width, initial-scale=1">
+<meta name="reaper-native" content="1">
+<title>REAPER &mdash; Printer Server</title>
+<!-- Reaper_Printer.asp - USB Application > Network Printer Server (Reaper-native UI, 2026-11-25).
+     Replaces PrinterServer.asp: the same one setting (usb_printer) and the same services
+     (restart_lpd;restart_u2ec), parity file build-scripts/tests/ui_parity/PrinterServer.json.
+     Differences from stock, on purpose: the switch is saved with Apply (stock posted on every click);
+     the two FAQ links are not carried (they went through an ASUS forwarding address). -->
+<link rel="stylesheet" href="/reaper/rp.css">
+<style>
+/* page-specific rules only; the Reaper look comes from /reaper/rp.css */
+.msg{font-size:12.5px;color:var(--amber);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:100%;min-width:0;display:none}
+</style>
+</head>
+<body>
+<script src="/reaper_util.js"></script>
+<script src="/reaper/rp.js"></script>
+
+<div class="syswrap">
+<div class="pagehead">
+  <div>
+    <div class="eyebrow"><#Menu_usb_application#></div>
+    <h1><#Network_Printer_Server#></h1>
+  </div>
+  <span class="pill" id="statepill"><span class="dot"></span><span id="statetext"></span></span>
+  <div class="spacer"></div>
+  <span class="pill warn chgpill" id="chgpill"><span class="dot"></span><span><#RADM_77#>: <b id="chgcount">0</b></span></span>
+  <button type="button" class="btn ghost" id="discardbtn" disabled><#Discard#></button>
+  <button type="button" class="btn primary" id="applybtn"><#CTL_apply#></button>
+</div>
+<div class="msg" id="topmsg" style="margin:-6px 0 12px"></div>
+<div class="hint" style="margin:-4px 0 14px"><#Network_Printer_desc#></div>
+
+<div class="rframe">
+<div class="panel" id="p_printer">
+  <h2><#t2BC#></h2>
+  <div class="frow"><div class="fl"><#Network_Printer_Server#></div><div class="fc"><label class="tswitch"><input type="checkbox" id="t_usb_printer"><span class="track"></span></label></div></div>
+</div>
+</div>
+</div>
+
+<div class="applying" id="applying"><div class="abox"><h2 id="ap_t"><#Reaper_c_applying#></h2><p id="ap_p"><#RADM_61#></p></div></div>
+<iframe name="hidden_frame" id="hidden_frame" style="display:none" width="0" height="0"></iframe>
+<form method="post" name="form" action="/start_apply.htm" target="hidden_frame">
+  <input type="hidden" name="current_page" value="Reaper_Printer.asp">
+  <input type="hidden" name="next_page" value="Reaper_Printer.asp">
+  <input type="hidden" name="action_mode" value="apply">
+  <input type="hidden" name="action_script" value="">
+  <input type="hidden" name="action_wait" value="5">
+  <!-- settings fields: added by rp.post at Apply -->
+</form>
+
+<script>
+(function(){
+'use strict';
+/* everything stays inside this closure: a page-level name can shadow reaper_util.js's window.esc and friends */
+var q = rp.q;
+var chk = rp.chk, msg = rp.msg, on = rp.on, setChk = rp.setChk;   /* the kit's copies (rp.js) */
+
+/* what the box holds now: the page posts only what differs from this (an empty value = the default, off) */
+var NV = { usb_printer: <% nvram_get_js("usb_printer"); %> };
+if (NV.usb_printer !== '1') NV.usb_printer = '0';
+
+function collect(){ return { usb_printer: chk('t_usb_printer') }; }
+function dirty(){ rp.dirtyMark(rp.diff(collect(), NV)); }
+function statePill(){
+  var up = NV.usb_printer === '1';
+  q('statetext').textContent = up ? `<#btn_Enabled#>` : `<#btn_Disabled#>`;
+  q('statepill').className = 'pill' + (up ? ' on' : '');
+}
+function applyAll(){
+  msg('');
+  var changed = rp.diff(collect(), NV), n = 0, k;
+  for (k in changed) n++;
+  if (!n){ msg(`<#RADM_63#>`); return; }
+  /* the stock page's services: the LPR daemon and the USB-over-network printer daemon */
+  rp.applying(`<#Reaper_c_applying#>`, `<#RADM_61#>`);
+  rp.post(document.form, changed, 'restart_lpd;restart_u2ec;', 5, false);
+  setTimeout(function(){ location.reload(); }, 9000);
+}
+setChk('t_usb_printer', NV.usb_printer === '1');
+on('applybtn', 'click', applyAll);
+on('discardbtn', 'click', function(){ location.reload(); });
+document.addEventListener('change', dirty);
+statePill(); dirty();
+})();
+</script>
+</body>
+</html>
