+<script>
+(function(){
+'use strict';
+/* everything stays inside this closure: a page-level name can shadow reaper_util.js's window.esc and friends */
+/* ==== part n1_model.js ==== */
+
+/* ---------- the data model: what the router stores for the networks, read and written in the stock formats ----------
+   Every list is rows that start with "<" and hold ">"-separated fields. sdn_rl and sdn_access_rl rows have no trailing
+   ">", vlan_rl / subnet_rl / radius_list rows do. A save posts WHOLE lists rebuilt from this model, as the stock page does;
+   that is why the model keeps every field it reads, including the ones no control edits. */
+var M = (function(){
+  var SDN_F = ['idx', 'sdn_name', 'sdn_enable', 'vlan_idx', 'subnet_idx', 'apg_idx', 'vpnc_idx', 'vpns_idx', 'dns_filter_idx', 'urlf_idx', 'nwf_idx', 'cp_idx', 'gre_idx',
+               'firewall_idx', 'kill_switch', 'access_host_service', 'wan_unit', 'pppoe_relay', 'wan6_unit', 'createby', 'mtwan_idx', 'mswan_idx', 'prio'];
+  var SDN_LATE = {wan_unit: '0', pppoe_relay: '0', wan6_unit: '0', createby: 'WEB', mtwan_idx: '0', mswan_idx: '0', prio: '0'};   /* fields a short (older) row lacks */
+  var SUB_F = ['subnet_idx', 'ifname', 'addr', 'netmask', 'dhcp_enable', 'dhcp_min', 'dhcp_max', 'dhcp_lease', 'domain_name', 'dns', 'wins', 'dhcp_static', 'dhcp_unit',
+               'ipv6_enable', 'autoconf', 'addr6', 'dhcp6_start', 'dhcp6_end', 'dns6', 'dot_enable', 'dot_tls'];
+  var RAD_F = ['radius_idx', 'auth_server_1', 'auth_port_1', 'auth_key_1', 'acct_server_1', 'acct_port_1', 'acct_key_1', 'auth_server_2', 'auth_port_2', 'auth_key_2',
+               'acct_server_2', 'acct_port_2', 'acct_key_2'];
+  /* apg / apm key suffixes, in the order the stock page posts them; "disabled" is read only, the three rg / lan keys are apg only */
+  var APG_F = ['enable', 'ssid', 'hide_ssid', 'security', 'bw_limit', 'timesched', 'sched', 'expiretime', 'ap_isolate', 'macmode', 'mlo', 'maclist', 'iot_max_cmpt', '11be',
+               'dut_list', 'disabled', 'rg_devs', 'rg_mdns', 'ap_isolate_lan'];
+  var APG_ONLY = {rg_devs: 1, rg_mdns: 1, ap_isolate_lan: 1};
+  var CP_F = ['enable', 'auth_type', 'conntimeout', 'idle_timeout', 'auth_timeout', 'redirecturl', 'term_of_service', 'bw_limit_ul', 'bw_limit_dl', 'NAS_ID', 'idx_for_customized_ui'];
+
+  function rows(s){ return String(s || '').split('<').filter(function(r){ return r !== ''; }).map(function(r){ return r.split('>'); }); }
+  function given(v){ return v !== undefined && v !== ''; }
+  function isMain(name){ return name === 'MAINFH' || name === 'MAINBH'; }
+  function prefixOf(net){ return isMain(net.sdn.sdn_name) ? 'apm' : 'apg'; }
+  function clone(o){ return JSON.parse(JSON.stringify(o)); }
+  function empty(o){ var k; for (k in o) if (Object.prototype.hasOwnProperty.call(o, k)) return false; return true; }
+
+  function sdnRow(f){
+    var o = {}, i, k;
+    for (i = 0; i < SDN_F.length; i++){ k = SDN_F[i]; o[k] = has(SDN_LATE, k) ? (given(f[i]) ? f[i] : SDN_LATE[k]) : (f[i] === undefined ? (i === 2 ? '1' : '0') : f[i]); }
+    return o;
+  }
+  function has(o, k){ return Object.prototype.hasOwnProperty.call(o, k); }
+  function vlanRows(s){
+    return rows(s).map(function(f){ return {vlan_idx: f[0], vid: f[1], port_isolation: given(f[2]) ? f[2] : '0'}; })
+                  .sort(function(a, b){ return parseInt(a.vlan_idx, 10) - parseInt(b.vlan_idx, 10); });
+  }
+  function subnetRows(s){
+    return rows(s).map(function(f){
+      var o = {}, i; for (i = 0; i < SUB_F.length; i++) o[SUB_F[i]] = f[i] === undefined ? '' : f[i];
+      if (o.ipv6_enable === 'disabled') o.ipv6_enable = '0';
+      return o;
+    });
+  }
+  function radiusRows(s){ return rows(s).map(function(f){ var o = {}, i; for (i = 0; i < RAD_F.length; i++) o[RAD_F[i]] = f[i] === undefined ? '' : f[i]; return o; }); }
+  function accessRows(s){ return rows(s).map(function(f){ return {access_sdn_idx: f[0], sdn_idx: f[1]}; }); }
+  function resRows(s){ return rows(s).map(function(f){ return {mac: f[0], ip: f[1], dns: f[2], hostname: f[3]}; }); }
+  function cpRow(idx, profile, local, radius){
+    var f = rows(profile)[0], o, i;
+    if (!f) return null;
+    o = {cp_idx: String(idx)};
+    for (i = 0; i < CP_F.length; i++) o[CP_F[i]] = f[i];
+    o.local_auth_profile = String(local || '').substring(1); o.radius_profile = String(radius || '');
+    return o;
+  }
+
+  /* the first read: the five lists. -> {sdn0: row 0 as stored, rows: the other sdn_rl rows, vlans, subnets, radius, access} */
+  function parseLists(nv, defSdn){
+    var sdn0 = '', out = {rows: [], vlans: vlanRows(nv.vlan_rl), subnets: subnetRows(nv.subnet_rl), radius: radiusRows(nv.radius_list), access: accessRows(nv.sdn_access_rl)};
+    String(nv.sdn_rl || '').split('<').forEach(function(r){
+      var f; if (r === '') return;
+      f = r.split('>');
+      if (f[0] === '0'){ if (sdn0 === '') sdn0 = '<' + r; return; }
+      out.rows.push(sdnRow(f));
+    });
+    out.sdn0 = sdn0 !== '' ? sdn0 : String(defSdn || '');
+    return out;
+  }
+  /* the keys the second read must fetch for those rows: every apg / apm key, the portal profiles in use, the reservations */
+  function keysFor(L){
+    var keys = [];
+    L.rows.forEach(function(r){
+      var p = isMain(r.sdn_name) ? 'apm' : 'apg', sub;
+      if (parseInt(r.apg_idx, 10) > 0) APG_F.forEach(function(k){ keys.push(p + r.apg_idx + '_' + k); });
+      if (parseInt(r.cp_idx, 10) > 0) ['_profile', '_local_auth_profile', '_radius_profile'].forEach(function(k){ if (keys.indexOf('cp' + r.cp_idx + k) < 0) keys.push('cp' + r.cp_idx + k); });
+      sub = L.subnets.filter(function(s){ return s.subnet_idx === r.subnet_idx; })[0];
+      if (sub && sub.dhcp_static === '1' && sub.dhcp_unit !== '') keys.push('dhcpres' + sub.subnet_idx + '_rl');
+    });
+    return keys;
+  }
+  /* join: one object per network. net = {sdn, vlan, subnet, radius, apg, cp, access[], res{idx, data[]}} (empty object = none) */
+  function build(L, nv){
+    var nets = L.rows.map(function(r){
+      var net = {sdn: r, vlan: {}, subnet: {}, radius: {}, apg: {}, cp: {}, access: [], res: {idx: '', data: []}}, p = isMain(r.sdn_name) ? 'apm' : 'apg', v, s, x, c;
+      v = L.vlans.filter(function(q){ return q.vlan_idx === r.vlan_idx; })[0]; if (v) net.vlan = v;
