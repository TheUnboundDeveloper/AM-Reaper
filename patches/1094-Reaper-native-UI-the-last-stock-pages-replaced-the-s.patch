+<!-- SPDX-License-Identifier: GPL-2.0-only
+     Copyright (C) 2026 the Reaper project maintainer
+     Part of the Reaper hardened Asuswrt-Merlin build. See LICENSE / LICENSE.reaper. -->
+<!DOCTYPE html>
+<html lang="en">
+<head>
+<meta charset="utf-8">
+<link rel="stylesheet" href="/reaper/reaper_cb.css"><script>/*REAPER-CBMODE*/if(<% nvram_get_js("reaper_cbmode"); %>==="1")document.documentElement.classList.add("cb");</script>
+<meta name="viewport" content="width=device-width, initial-scale=1">
+<meta name="reaper-native" content="1">
+<title>REAPER &mdash; Internet Speed</title>
+<!-- Reaper_Speed.asp - Traffic Manager > Internet Speed (Reaper-native UI, 2026-11-25).
+     Replaces AdaptiveQoS_InternetSpeed.asp + internet_speed.html (the Ookla speed test). Same backends:
+       POST /ookla_speedtest_exe.cgi            type ("" = run, "list" = fetch servers), id (server), iface
+       POST /set_ookla_speedtest_state.cgi      ookla_state   (0 idle 1 run 2 WAN down 3 timeout 4 terminated 5 unknown)
+       POST /set_ookla_speedtest_start_time.cgi ookla_start_time (ms; a reload during a run picks the run up again)
+       POST /ookla_speedtest_write_history.cgi  speedTest_history (one JSON object per line)
+       GET  /appGet.cgi?hook= ookla_speedtest_get_result() / _get_servers() / _get_history() / _get_quota()
+     Kept from the stock page, rule for rule: the 120 s limit per run; history of 50 results, newest first, a result id
+     saved once; pages of 10; the six speed levels and their limits; the link-rate panel shown instead of the test when
+     the WAN link is 5 Gbps or more and the model has no 10G speed test (or the ISP profile says so); the daily quota
+     and end-of-service notices; the interface menu (WAN, running OpenVPN and WireGuard clients).
+     Kept from Reaper's fixes inside the stock page: result polling that never blocks the page and never stacks
+     (v3.0.5), one silent retry per run for a first-attempt failure, consecutive-error counting per NEW engine line,
+     the failure reason named with the engine's own words, and the note saying what QoS caps the result at (RSPD_1).
+     Differences, on purpose: the choice between test and link-rate panel waits for the port reading (stock decided
+     after 100 ms, whether or not the reading had arrived); time zones with a half hour are shown correctly (stock
+     used whole hours); the server-list poll gives up after 60 s and is asked again by the next run; one status poll
+     chain (stock could start several); the privacy line links Ookla's policy page (stock opened ASUS's policy
+     window); the Ethernet-monitor substitute result is not carried (no supported model reports eth_monitor). -->
+<link rel="stylesheet" href="/reaper/rp.css">
+<style>
+/* page-specific rules only; the Reaper look comes from /reaper/rp.css */
+.off{display:none!important}
+.msg{font-size:12.5px;color:var(--amber);display:none}
+.testgrid{display:grid;grid-template-columns:minmax(220px,300px) 1fr;gap:18px;align-items:start}
+@media (max-width:760px){.testgrid{grid-template-columns:1fr}}
+.gobox{display:flex;flex-direction:column;align-items:center;gap:12px;padding:10px 0}
+.gobtn{width:132px;height:132px;border-radius:50%;border:2px solid var(--jade);background:transparent;color:var(--bone);
+  font-family:var(--hdr);font-weight:700;font-size:22px;letter-spacing:.08em;text-transform:uppercase;cursor:pointer;transition:.15s}
+.gobtn:hover{background:rgba(var(--cb-ok-rgb,79,178,134),.12)}
+.gobtn.testing{border-color:var(--amber);color:var(--amber);cursor:default;font-size:15px;animation:spd 1.4s ease-in-out infinite}
+.gobtn.disabled{border-color:var(--line2);color:var(--steel);cursor:default}
+@keyframes spd{50%{box-shadow:0 0 0 8px rgba(var(--cb-warn-rgb,224,169,59),.10)}}
+.when{font-family:var(--mono);font-size:12px;color:var(--steel);min-height:16px;text-align:center}
+.tiles{display:grid;grid-template-columns:repeat(4,minmax(110px,1fr));gap:10px}
+@media (max-width:900px){.tiles{grid-template-columns:repeat(2,1fr)}}
+.tile{background:var(--raised);border:1px solid var(--line-soft);border-radius:10px;padding:12px 14px;min-width:0}
+.tile .k{font-family:var(--hdr);font-weight:600;font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:var(--steel)}
+.tile .v{font-family:var(--hdr);font-weight:700;font-size:30px;color:var(--bone);line-height:1.15;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
+.tile .v.long{font-size:22px}
+.tile .u{font-size:11.5px;color:var(--steel)}
+.srvrow{display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin-top:12px}
+.srvrow .lab{font-size:12px;color:var(--steel)}
+.srvrow select{min-width:200px;max-width:100%}
+.srvnow{font-size:12.5px;color:var(--bone-dim);margin-top:8px;min-height:18px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
+.level{display:inline-flex;align-items:center;gap:8px;margin-top:12px;padding:6px 12px;border-radius:999px;border:1px solid var(--line2);
+  background:transparent;color:var(--bone-dim);font-size:12.5px;cursor:pointer}
+.level b{color:var(--bone);font-weight:600}
+.level.has{border-color:rgba(var(--cb-ok-rgb,79,178,134),.45)}
+.note{display:flex;gap:8px;align-items:center;font-size:12.5px;color:var(--amber);margin:0 0 12px}
+.note .more{text-decoration:underline;cursor:pointer;background:none;border:0;color:inherit;font:inherit;padding:0}
+.cap{font-size:12.5px;color:var(--bone-dim);margin:0 0 12px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
+.quota{border:1px solid rgba(var(--cb-warn-rgb,224,169,59),.4);border-radius:10px;padding:14px 16px;margin-bottom:14px}
+.quota h3{margin:0 0 6px;font-family:var(--hdr);font-size:15px;color:var(--amber)}
+.quota p{margin:0 0 10px;font-size:12.5px;color:var(--bone-dim);line-height:1.5}
+.rates{display:flex;gap:28px;flex-wrap:wrap}
+.rates .v{font-family:var(--hdr);font-weight:700;font-size:38px;color:var(--bone)}
+.hbar{display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin-bottom:8px}
+.hbar .range{font-size:12px;color:var(--steel);margin-left:auto}
+table.hist{width:100%;border-collapse:collapse;font-size:12.5px}
+table.hist th{font-family:var(--hdr);font-weight:600;font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:var(--steel);text-align:left;padding:6px 8px;border-bottom:1px solid var(--line-soft)}
+table.hist td{padding:7px 8px;border-bottom:1px solid var(--line-soft);color:var(--bone-dim);font-family:var(--mono)}
+table.hist td.num{color:var(--bone)}
+table.hist td.empty{text-align:center;color:var(--steel);font-family:inherit;padding:22px 8px}
+table.hist tr.more td{color:var(--steel);font-size:12px;background:rgba(255,255,255,.02)}
+.xbtn{background:none;border:0;color:var(--steel);cursor:pointer;font-size:14px;padding:0 4px}
+.foot{font-size:11.5px;color:var(--steel);margin-top:12px;line-height:1.6}
+.foot a{color:var(--bone-dim)}
+.dlg{position:fixed;inset:0;background:rgba(0,0,0,.6);display:none;align-items:center;justify-content:center;z-index:50;padding:16px}
+.dlg.show{display:flex}
+.dlg .box{background:var(--panel);border:1px solid var(--line2);border-radius:12px;max-width:520px;width:100%;padding:18px 20px}
+.dlg h3{margin:0 0 8px;font-family:var(--hdr);font-size:16px;color:var(--bone)}
+.dlg p{margin:0 0 14px;font-size:13px;color:var(--bone-dim);line-height:1.55;overflow-wrap:anywhere}
+.dlg p a{color:var(--bone)}
+.dlg .acts{display:flex;justify-content:flex-end}
+</style>
+</head>
+<body>
+<script src="/reaper_util.js"></script>
+<script src="/reaper/rp.js"></script>
+
+<div class="syswrap">
+<div class="pagehead">
+  <div>
+    <div class="eyebrow"><#Menu_TrafficManager#></div>
+    <h1><#InternetSpeed#></h1>
+  </div>
+  <div class="spacer"></div>
+</div>
+<div class="msg" id="topmsg" style="margin:-6px 0 12px"></div>
+
+<div class="rframe">
+<!-- the WAN link is 5 Gbps or more and this model has no 10G test: the link rate is what can be shown -->
+<div class="panel off" id="p_rate">
+  <h2><#InternetSpeed#></h2>
+  <div class="rates">
+    <div><div class="tile"><div class="k"><#AiMesh_Receive_Rate#></div><div class="v"><span id="rx_rate">--</span> <span class="u" id="rx_unit">Mbps</span></div></div></div>
+    <div><div class="tile"><div class="k"><#AiMesh_Transmit_Rate#></div><div class="v"><span id="tx_rate">--</span> <span class="u" id="tx_unit">Mbps</span></div></div></div>
+  </div>
+</div>
+
+<div class="panel off" id="p_test">
+  <h2><#InternetSpeed#></h2>
+  <div class="quota off" id="quota">
+    <h3 id="quota_title"></h3>
+    <p id="quota_desc"></p>
+    <button type="button" class="btn ghost" id="quota_go">Go to Speedtest</button>
+  </div>
+  <div class="note off" id="wan_note"><span><#InternetSpeed_Pause#></span> <button type="button" class="more" id="wan_more"><#InternetSpeed_More_Info#></button></div>
+  <div class="cap off" id="qos_cap"></div>
+  <div class="testgrid" id="testgrid">
+    <div class="gobox">
+      <button type="button" class="gobtn" id="gobtn"><#InternetSpeed_Go#></button>
+      <div class="when" id="when"></div>
+    </div>
+    <div>
+      <div class="tiles">
+        <div class="tile"><div class="k"><#InternetSpeed_Download#></div><div class="v" id="r_down">--</div><div class="u"><#InternetSpeed_Mbps#></div></div>
+        <div class="tile"><div class="k"><#InternetSpeed_Upload#></div><div class="v" id="r_up">--</div><div class="u"><#InternetSpeed_Mbps#></div></div>
+        <div class="tile"><div class="k"><#InternetSpeed_Ping#></div><div class="v" id="r_ping">--</div><div class="u"><#InternetSpeed_ms#></div></div>
+        <div class="tile"><div class="k"><#InternetSpeed_Jitter#></div><div class="v" id="r_jit">--</div><div class="u"><#InternetSpeed_ms#></div></div>
+      </div>
+      <div class="srvrow off" id="iface_row"><span class="lab" id="iface_lab"></span><select id="iface"></select></div>
+      <div class="srvrow"><span class="lab"><#InternetSpeed_Servers_Nearby#></span><select id="server"><option value=""><#Auto#></option></select></div>
+      <div class="srvnow" id="srvnow"></div>
+      <button type="button" class="level" id="levelbtn"><span><#InternetSpeed_Level#></span> <b id="level_text"></b></button>
+    </div>
+  </div>
+</div>
+
+<div class="panel off" id="p_hist">
+  <h2><#InternetSpeed_History#></h2>
+  <div class="hbar">
+    <label class="chk"><input type="checkbox" id="h_all"> <span><#Clientlist_All_List#></span></label>
+    <button type="button" class="btn ghost" id="h_del" disabled><#CTL_del#></button>
+    <span class="range off" id="h_range"><span id="h_range_str"></span> <#InternetSpeed_Items#></span>
+    <button type="button" class="btn ghost" id="h_prev">&lsaquo;</button>
+    <button type="button" class="btn ghost" id="h_next">&rsaquo;</button>
+  </div>
+  <table class="hist">
+    <thead><tr><th style="width:28px"></th><th><#diskUtility_time#></th><th><#InternetSpeed_Download#></th><th><#InternetSpeed_Upload#></th><th style="width:28px"></th></tr></thead>
+    <tbody id="h_rows"></tbody>
+  </table>
+</div>
+</div>
+<div class="foot"><#InternetSpeed_ookla_mark#><br><span id="pp"></span></div>
+</div>
+
+<div class="dlg" id="dlg"><div class="box"><h3 id="dlg_t"></h3><p id="dlg_p"></p><div class="acts"><button type="button" class="btn primary" id="dlg_ok"><#CTL_ok#></button></div></div></div>
+
+<script>
+(function(){
+'use strict';
+/* everything stays inside this closure: a page-level name can shadow reaper_util.js's window.esc and friends */
+var q = rp.q;
+var U = rp.dec, on = rp.on;                                   /* the kit's copies (rp.js) */
+var ST = {IDLE: '0', RUN: '1', ERR_DISCON: '2', ERR_TIMEOUT: '3', ERR_TERMINATE: '4', ERR_UNKNOWN: '5'};
+var TEST_TIMEOUT = 120000, LEVEL_ERR_MAX = 50, PAGE = 10, KEEP = 50;
+
+var NV = {
+  state: <% nvram_get_js("ookla_state"); %>,
+  start: <% nvram_get_js("ookla_start_time"); %>,
+  link: <% nvram_get_js("link_internet"); %>,
+  qos_enable: <% nvram_get_js("qos_enable"); %>, qos_type: <% nvram_get_js("qos_type"); %>,
+  qos_obw: <% nvram_get_js("qos_obw"); %>, qos_ibw: <% nvram_get_js("qos_ibw"); %>, qos_ipolicer: <% nvram_get_js("qos_ipolicer"); %>,
+  ispctrl: U('<% nvram_char_to_ascii("","ispctrl_desc"); %>'),
+  lanmac: '<% get_lan_hwaddr(); %>',
+  uptime: '<% uptime(); %>'
+};
+var UI = {}; try { UI = [<% get_ui_support(); %>][0] || {}; } catch (e) {}
+function sup(x){ return !!UI[x]; }
+/* the running VPN clients a test can be sent through (stock: OpenVPN state 2, WireGuard enabled) */
+var VPN = [
+  ['tun11', 'OVPN1', <% nvram_get_js("vpn_client1_state"); %>, U('<% nvram_char_to_ascii("","vpn_client1_desc"); %>')],
+  ['tun12', 'OVPN2', <% nvram_get_js("vpn_client2_state"); %>, U('<% nvram_char_to_ascii("","vpn_client2_desc"); %>')],
+  ['tun13', 'OVPN3', <% nvram_get_js("vpn_client3_state"); %>, U('<% nvram_char_to_ascii("","vpn_client3_desc"); %>')],
+  ['tun14', 'OVPN4', <% nvram_get_js("vpn_client4_state"); %>, U('<% nvram_char_to_ascii("","vpn_client4_desc"); %>')],
+  ['tun15', 'OVPN5', <% nvram_get_js("vpn_client5_state"); %>, U('<% nvram_char_to_ascii("","vpn_client5_desc"); %>')]
+];
+var WGC = [
+  ['wgc1', 'WGC1', <% nvram_get_js("wgc1_enable"); %>, U('<% nvram_char_to_ascii("","wgc1_desc"); %>')],
+  ['wgc2', 'WGC2', <% nvram_get_js("wgc2_enable"); %>, U('<% nvram_char_to_ascii("","wgc2_desc"); %>')],
+  ['wgc3', 'WGC3', <% nvram_get_js("wgc3_enable"); %>, U('<% nvram_char_to_ascii("","wgc3_desc"); %>')],
+  ['wgc4', 'WGC4', <% nvram_get_js("wgc4_enable"); %>, U('<% nvram_char_to_ascii("","wgc4_desc"); %>')],
+  ['wgc5', 'WGC5', <% nvram_get_js("wgc5_enable"); %>, U('<% nvram_char_to_ascii("","wgc5_desc"); %>')]
+];
+
+/* ---------- requests: asynchronous, each completes exactly once (load, error, timeout and abort share one guard) ---------- */
+function req(method, url, body, done, wait){
+  var x = new XMLHttpRequest(), fired = false;
+  function end(ok){ if (fired) return; fired = true; if (done) done(ok ? x.responseText : null); }
+  x.open(method, url, true);
+  x.timeout = wait || 15000;
+  if (body !== null) x.setRequestHeader('Content-Type', 'application/x-www-form-urlencoded');
+  x.onload = function(){ end(x.status === 200); };
+  x.onerror = x.ontimeout = x.onabort = function(){ end(false); };
+  x.send(body);
+}
+function form(o){ var k, a = []; for (k in o) if (Object.prototype.hasOwnProperty.call(o, k)) a.push(encodeURIComponent(k) + '=' + encodeURIComponent(o[k])); return a.join('&'); }
+function post(url, o, done){ req('POST', url, form(o), done, 60000); }      /* the engine launch may answer late under load */
+/* one appGet hook -> its value (null on any failure) */
+function hook(name, done){
+  req('GET', '/appGet.cgi?hook=' + name + '()&_=' + Date.now(), null, function(t){
+    var d = null; try { d = t === null ? null : JSON.parse(t)[name]; } catch (e) { d = null; }
+    done(d === undefined ? null : d);
+  });
+}
+function nvget(key, done){
+  req('GET', '/appGet.cgi?hook=nvram_get(' + key + ')&_=' + Date.now(), null, function(t){
+    var v = null; try { v = t === null ? null : JSON.parse(t)[key]; } catch (e) { v = null; }
+    done(v === undefined ? null : v);
+  });
+}
+
+/* ---------- state ---------- */
+var result = [], hist = [{}], servers = [], quota = {};
+var delSel = {}, pageId = 0, maxPage = 0, rangeStart = 0, rangeEnd = 0;
+var startTime = parseInt(NV.start, 10) || 0;
+var btn = 'go', linkInternet = NV.link;
+var levelErr = 0, levelErrLen = 0, retryDone = false, pollBusy = false;
+var autoServer = true, curServer = '', level = null;
+var EOS = sup('ookla_eos');
+var wanTimer = null, srvTries = 0;
+
+function setText(id, t){ q(id).textContent = t; }
+function show(id, yes){ q(id).classList.toggle('off', !yes); }
+function setState(s){ post('/set_ookla_speedtest_state.cgi', {ookla_state: s}); }
+
+/* router local time of a UTC stamp: the offset comes from the router's own clock line (" -0500(") */
+var TZ = (function(){ var m = /([+-])(\d\d)(\d\d)\(/.exec(NV.uptime); return m ? (m[1] === '-' ? -1 : 1) * ((+m[2]) * 60 + (+m[3])) * 60000 : 0; })();
+function localTime(stamp){
+  var t = new Date(new Date(stamp).getTime() + TZ), p = function(n){ return n < 10 ? '0' + n : String(n); };
+  if (isNaN(t.getTime())) return {date: '', time: ''};
+  return {date: t.getUTCFullYear() + '/' + (t.getUTCMonth() + 1) + '/' + t.getUTCDate(), time: p(t.getUTCHours()) + ':' + p(t.getUTCMinutes())};
+}
+/* the engine reports bytes per second */
+function mbps(bytes){
+  var b = parseInt(bytes, 10) || 0, m = (b * 8) / 1000000;
+  return b >= 12500000000 ? m.toFixed(0) : b >= 1250000000 ? m.toFixed(1) : m.toFixed(2);
+}
+function fix2(n){ return typeof n === 'number' ? n.toFixed(2) : '--'; }
+function tile(id, t){ var e = q(id); e.textContent = t; e.classList.toggle('long', String(t).length > 6); }
+
+/* ---------- dialog ---------- */
+function dialog(title, html){
+  setText('dlg_t', title); q('dlg_p').innerHTML = html;
+  /* the stock failure texts link the old network map; the dashboard is its place now */
+  Array.prototype.forEach.call(q('dlg_p').querySelectorAll('a'), function(a){ a.setAttribute('href', '/Main_ReaperDash.asp'); a.setAttribute('target', '_top'); });
+  q('dlg').classList.add('show');
+}
+function dialogText(title, text){ setText('dlg_t', title); q('dlg_p').textContent = text; q('dlg').classList.add('show'); }
+
+/* ---------- the Go button ---------- */
+function setBtn(t){
+  var b = q('gobtn'); btn = t;
+  b.className = 'gobtn' + (t === 'testing' ? ' testing' : t === 'disable' ? ' disabled' : '');
+  b.textContent = t === 'testing' ? `<#InternetSpeed_Testing#>` : `<#InternetSpeed_Go#>`;
+  b.disabled = t !== 'go';
+  q('levelbtn').disabled = t === 'testing'; q('server').disabled = t === 'testing'; q('iface').disabled = t === 'testing';
+}
+function resetResult(){
+  tile('r_down', '--'); tile('r_up', '--'); tile('r_ping', '--'); tile('r_jit', '--');
+  setText('when', ''); setLevel(null);
+}
+
+/* ---------- speed level (stock limits, on the whole-number Mbps of the download) ---------- */
+var LEVELS = [
+  [5, `<#InternetSpeed_Normal#>`, `<#InternetSpeed_Normal_title#>`, `<#InternetSpeed_Normal_desc#>`],
+  [50, `<#InternetSpeed_Good#>`, `<#InternetSpeed_Good_title#>`, `<#InternetSpeed_Good_desc#>`],
+  [100, `<#InternetSpeed_Great#>`, `<#InternetSpeed_Great_title#>`, `<#InternetSpeed_Great_detail#>`],
+  [250, `<#InternetSpeed_Fast#>`, `<#InternetSpeed_Fast_title#>`, `<#InternetSpeed_Fast_detail#>`],
+  [900, `<#InternetSpeed_Super#>`, `<#InternetSpeed_Super_title#>`, `<#InternetSpeed_Super_detail#>`],
+  [Infinity, `<#InternetSpeed_Ultra#>`, `<#InternetSpeed_Ultar_title#>`, `<#InternetSpeed_Ultra_detail#>`]
+];
+function setLevel(downMbps){
+  level = null;
+  if (downMbps !== null){ var s = parseInt(downMbps, 10) || 0, i; for (i = 0; i < LEVELS.length; i++) if (s <= LEVELS[i][0]){ level = LEVELS[i]; break; } }
+  setText('level_text', level ? level[1] : ''); q('levelbtn').classList.toggle('has', !!level);
+}
+
+/* ---------- quota / end of service (the stock page's own English; it has no dict strings for these) ---------- */
+function quotaExceeded(){
+  return quota && typeof quota.remaining_cnt !== 'undefined' && parseInt(quota.remaining_cnt, 10) === 0 &&
+         typeof quota.reset_remaining !== 'undefined' && parseInt(quota.reset_remaining, 10) >= 0;
+}
+function renderNotice(){
+  var h, left;
+  if (EOS){
+    setText('quota_title', 'Internet Speed Test Service Ended');
+    setText('quota_desc', 'Thank you for your support. The built-in speed test is no longer supported. If you would like to test the internet speed, please click the button to continue on the Speed Test website');
+    show('quota', true); show('testgrid', false); return;
+  }
+  if (quotaExceeded()){
+    left = parseInt(quota.reset_remaining, 10); h = Math.ceil(left / 3600);
+    setText('quota_title', left > 0 ? 'A new test quota will be restored automatically in ' + h + ' hour' + (h > 1 ? 's' : '') + '.' : 'A new test quota will be restored automatically soon.');
+    setText('quota_desc', 'Your basic test quota has been used up. If you need an immediate speed test, click the button below to continue on the Speedtest website.');
+    show('quota', true); show('testgrid', false);
+  } else { show('quota', false); show('testgrid', true); }
+}
+function getQuota(){ hook('ookla_speedtest_get_quota', function(d){ quota = (d && typeof d === 'object') ? d : {}; renderNotice(); }); }
+
+/* ---------- what QoS caps the result at (Reaper v3.0.5; mirrors rc/qos.c per engine) ---------- */
+function qosCap(){
+  var obw = parseInt(NV.qos_obw, 10) || 0, ibw = parseInt(NV.qos_ibw, 10) || 0, t = String(NV.qos_type), up = obw, down = 0, parts = [], e;
+  if (NV.qos_enable !== '1' || obw <= 0) return;
+  if (t === '9'){ up = obw - Math.floor(obw / 10); down = ibw - Math.floor(ibw / 10); }
+  else if (t === '11'){ down = (NV.qos_ipolicer !== '0') ? ibw - Math.floor(ibw / 10) : 0; }
+  else if (t === '1'){ down = ibw; }
+  function m(k){ return (k / 1000).toFixed(0) + ' ' + `<#InternetSpeed_Mbps#>`; }
+  if (down > 0) parts.push(m(down) + ' ' + `<#InternetSpeed_Download#>`);
+  parts.push(m(up) + ' ' + `<#InternetSpeed_Upload#>`);
+  e = q('qos_cap'); e.textContent = `<#RSPD_1#>`.replace('%1', parts.join(', ')); show('qos_cap', true);
+  if (e.scrollWidth > e.clientWidth + 1) e.title = e.textContent; else e.removeAttribute('title');
+}
+
+/* ---------- WAN state: one poll chain, paused while a test runs (stock) ---------- */
+function wanCheck(){
+  clearTimeout(wanTimer); wanTimer = null;
+  if (btn === 'testing') return;
+  nvget('link_internet', function(v){
+    if (v !== null) linkInternet = v;
+    if (btn !== 'testing'){
+      if (linkInternet !== '2'){
+        if (btn !== 'disable') setBtn('disable');
+        show('wan_note', true); setState(ST.ERR_DISCON);
+      } else {
+        if (btn !== 'go') setBtn('go');
+        show('wan_note', false);
+      }
+      clearTimeout(wanTimer); wanTimer = setTimeout(wanCheck, 2000);
+    }
+  });
+}
+
+/* ---------- servers ---------- */
+function exe(type, id){
+  startTime = Date.now();
+  post('/set_ookla_speedtest_start_time.cgi', {ookla_start_time: startTime});
+  post('/ookla_speedtest_exe.cgi', {type: type || '', id: id || '', iface: q('iface').value}, function(t){
+    if (t === null) return;
+    if (!type) setTimeout(getResult, 1000);
+    else if (type === 'list'){ srvTries = 0; setTimeout(getServers, 1000); }
+  });
+}
+function getServers(){
+  hook('ookla_speedtest_get_servers', function(d){
+    servers = Array.isArray(d) ? d : [];
+    if (servers.length < 2){ if (++srvTries < 60) setTimeout(getServers, 1000); return; }
+    var s = q('server'), keep = s.value, o;
+    while (s.options.length > 1) s.remove(1);
+    servers.forEach(function(v){
+      if (!v || v.name === undefined) return;
+      o = document.createElement('option'); o.value = String(v.id);
+      o.textContent = String(v.name) + (v.location ? ' - ' + String(v.location) : ''); s.appendChild(o);
+    });
+    s.value = keep; if (s.value !== keep) s.value = '';
+  });
+}
+function serverPicked(){
+  var s = q('server'), v = s.value, i;
+  autoServer = (v === ''); curServer = v;
+  if (autoServer){ setText('srvnow', ''); return; }
+  for (i = 0; i < servers.length; i++) if (servers[i] && String(servers[i].id) === v) setText('srvnow', String(servers[i].name) + (servers[i].location ? ' - ' + servers[i].location : ''));
+}
+function run(){ if (!autoServer && curServer !== '') exe('', curServer); else exe(''); }
+
+/* ---------- a run ---------- */
+function start(){
+  if (quotaExceeded() || btn !== 'go') return;
+  retryDone = false; pollBusy = false; levelErr = 0; levelErrLen = 0;      /* a fresh budget per user run */
+  resetResult(); setBtn('testing'); run();
+}
+function getResult(){
+  if (Date.now() - startTime >= TEST_TIMEOUT){ pollBusy = false; fail(ST.ERR_TIMEOUT); return; }
+  if (pollBusy) return;
+  pollBusy = true;
+  hook('ookla_speedtest_get_result', function(d){
+    pollBusy = false;
+    if (d === null){ setTimeout(getResult, 200); return; }               /* httpd busy under load: ask again, the run is fine */
+    result = Array.isArray(d) ? d : [];
+    processResult();
+  });
+}
+function processResult(){
+  var next = true, last, i, r, t;
+  if (result.length < 2){ setTimeout(getResult, 200); return; }
+  last = result[result.length - 2] || {};
+  if (typeof last.error !== 'undefined'){
+    if (last.error === 'quota exceeded'){
+      levelErr = 0; setState(ST.ERR_TERMINATE); resetResult(); setBtn('go'); getQuota(); wanCheck(); return;
+    }
+    fail(ST.ERR_TERMINATE); return;
+  }
+  /* count CONSECUTIVE engine errors, each line once (the buffer is re-read on every poll) */
+  if (result.length > levelErrLen){
+    levelErrLen = result.length;
+    if (last.level === 'error'){
+      if (++levelErr >= LEVEL_ERR_MAX){ fail(ST.ERR_TERMINATE); levelErr = 0; levelErrLen = 0; return; }
+    } else levelErr = 0;
+  }
+  for (i = 0; i < result.length - 1; i++){
+    r = result[i]; if (!r) continue;
+    if (r.type === 'testStart'){
+      t = localTime(r.timestamp); setText('when', t.date + ' ' + t.time);
+      if (r.server) setText('srvnow', String(r.server.name || '') + (r.server.location ? ' - ' + r.server.location : ''));
+    }
+    else if (r.type === 'download' && r.download) tile('r_down', mbps(r.download.bandwidth));
+    else if (r.type === 'upload' && r.upload) tile('r_up', mbps(r.upload.bandwidth));
+    else if (r.type === 'result'){
+      next = false;
+      t = localTime(r.timestamp); setText('when', t.date + ' ' + t.time);
+      tile('r_ping', fix2(r.ping && r.ping.latency)); tile('r_jit', fix2(r.ping && r.ping.jitter));
+      tile('r_down', mbps(r.download.bandwidth)); tile('r_up', mbps(r.upload.bandwidth));
+      setLevel(mbps(r.download.bandwidth));
+      if (!dupe(r)){
+        if (hist.length === KEEP + 1) hist.splice(KEEP - 1, 1);       /* 50 kept: the oldest goes */
+        hist.splice(0, 0, r);
+        histInfo(); histDraw(); histSave();
+      }
+      if (servers.length < 2) setTimeout(function(){ exe('list'); }, 1000);
+      setBtn('go');
+      setTimeout(function(){ getQuota(); wanCheck(); }, 3000);
+      levelErr = 0;
+    }
+  }
+  if (next) setTimeout(getResult, 200);
+}
+/* the engine's last complaint: a terminal error entry, else its newest error line (plain text, cut at 160) */
+function lastEngineError(){
+  var i, e;
+  for (i = result.length - 1; i >= 0; i--){
+    e = result[i]; if (!e) continue;
+    if (typeof e.error === 'string' && e.error) return e.error.substring(0, 160);
+    if (e.level === 'error' && typeof e.message === 'string' && e.message) return e.message.substring(0, 160);
+  }
+  return '-';
+}
+function fail(status){
+  /* the engine fetches its configuration once, without a retry: the first run after boot can fail on cold DNS or a
+     clock not set yet and work seconds later. One silent retry per run; a WAN that is down is reported at once. */
+  if (!retryDone && status !== ST.ERR_DISCON){
+    retryDone = true; levelErr = 0; levelErrLen = 0;
+    setState(ST.IDLE);
+    setTimeout(run, 2000);
+    return;
+  }
+  var reason = '';
+  if (status === ST.ERR_TIMEOUT) reason = `<#RSPD_2#>`;
+  else if (status === ST.ERR_DISCON) reason = `<#RSPD_6#>`;
+  else if (status === ST.ERR_UNKNOWN) reason = `<#RSPD_5#>`;
+  else if (status === ST.ERR_TERMINATE) reason = `<#RSPD_3#>`.replace('%1', rp.esc(lastEngineError()));
+  setState(status); resetResult(); setBtn('go'); wanCheck();
+  dialog(`<#InternetSpeed_Notice#>`, `<#InternetSpeed_Failure_Hint#>` + (reason ? '<br>' + reason : ''));
+}
+
+/* ---------- hist: newest first, an empty object closes the list (the file format the router keeps) ---------- */
+function dupe(r){ var i; for (i = 0; i < hist.length - 1; i++) if (hist[i].result && r.result && hist[i].result.id === r.result.id) return true; return false; }
+function histSave(){
+  var s = '', i;
+  for (i = 0; i < hist.length - 1; i++) s += JSON.stringify(hist[i]) + '\n';
+  post('/ookla_speedtest_write_history.cgi', {speedTest_history: s});
+}
+function histInfo(){
+  var n = hist.length - 1;
+  maxPage = n <= PAGE ? 0 : Math.ceil(n / PAGE) - 1;
+  if (pageId > maxPage) pageId = maxPage;
+  rangeStart = pageId * PAGE + 1; rangeEnd = Math.min(rangeStart + PAGE - 1, n);
+  setText('h_range_str', rangeStart + '-' + rangeEnd); show('h_range', n > 0);
+  q('h_prev').disabled = pageId <= 0; q('h_next').disabled = pageId >= maxPage;
+}
+function cell(tr, text, cls){ var td = document.createElement('td'); td.textContent = text; if (cls) td.className = cls; tr.appendChild(td); return td; }
+function histDraw(){
+  var tb = q('h_rows'), i, n = hist.length - 1; tb.textContent = '';
+  if (n < 1){ var tr0 = document.createElement('tr'), td0 = cell(tr0, 'No Test Results.', 'empty'); td0.colSpan = 5; tb.appendChild(tr0); }
+  for (i = rangeStart - 1; i < rangeEnd && n > 0; i++) (function(h){
+    if (!h || !h.result) return;
+    var id = String(h.result.id), t = localTime(h.timestamp), tr = document.createElement('tr'), more = document.createElement('tr');
+    var c = document.createElement('input'), td = document.createElement('td'), x = document.createElement('button'), tx = document.createElement('td'), md;
+    c.type = 'checkbox'; c.checked = !!delSel[id]; c.setAttribute('data-id', id);
+    c.addEventListener('change', function(){ if (c.checked) delSel[id] = 1; else delete delSel[id]; histSel(); });
+    td.appendChild(c); tr.appendChild(td);
+    cell(tr, t.date + ' ' + t.time);
+    cell(tr, mbps(h.download && h.download.bandwidth), 'num'); cell(tr, mbps(h.upload && h.upload.bandwidth), 'num');
+    x.type = 'button'; x.className = 'xbtn'; x.textContent = '+'; tx.appendChild(x); tr.appendChild(tx);
+    more.className = 'more off'; md = cell(more, `<#InternetSpeed_Ping#>` + ' ' + fix2(h.ping && h.ping.latency) + ' ' + `<#InternetSpeed_ms#>` + '   ' +
+      `<#InternetSpeed_Jitter#>` + ' ' + fix2(h.ping && h.ping.jitter) + ' ' + `<#InternetSpeed_ms#>` + (h.server && h.server.name ? '   ' + h.server.name : ''));
+    md.colSpan = 5;
+    x.addEventListener('click', function(){ var hidden = more.classList.toggle('off'); x.textContent = hidden ? '+' : '-'; });
+    tb.appendChild(tr); tb.appendChild(more);
+  })(hist[i]);
+  histSel();
+}
+function histSel(){
+  var any = false, all = rangeEnd >= rangeStart, i, id;
+  for (i = rangeStart - 1; i < rangeEnd; i++){ id = hist[i] && hist[i].result ? String(hist[i].result.id) : ''; if (delSel[id]) any = true; else all = false; }
+  q('h_del').disabled = !any; q('h_all').checked = any && all;
+}
+function histAll(){
+  var want = q('h_all').checked, i, id;
+  for (i = rangeStart - 1; i < rangeEnd; i++){ id = hist[i] && hist[i].result ? String(hist[i].result.id) : ''; if (!id) continue; if (want) delSel[id] = 1; else delete delSel[id]; }
+  histDraw();
+}
+function histDelete(){
+  var before = hist.length;
+  hist = hist.filter(function(h, i){ return i === hist.length - 1 || !(h.result && delSel[String(h.result.id)]); });
+  delSel = {};
+  if (hist.length !== before) histSave();
+  histInfo(); histDraw();
+}
+function showLatest(){
+  var r = hist[0], t;
+  if (!r || !r.result) return;
+  t = localTime(r.timestamp); setText('when', t.date + ' ' + t.time);
+  if (r.server) setText('srvnow', String(r.server.name || '') + (r.server.location ? ' - ' + r.server.location : ''));
+  tile('r_down', mbps(r.download.bandwidth)); tile('r_up', mbps(r.upload.bandwidth));
+  tile('r_ping', fix2(r.ping && r.ping.latency)); tile('r_jit', fix2(r.ping && r.ping.jitter));
+  setLevel(mbps(r.download.bandwidth));
+}
+
+/* ---------- interface menu ---------- */
+function ifaces(){
+  var s = q('iface'), o = document.createElement('option');
+  o.value = ''; o.textContent = 'WAN'; s.appendChild(o);
+  function add(list, yes){ list.forEach(function(v){ if (v[2] !== yes) return; var p = document.createElement('option'); p.value = v[0]; p.textContent = v[1] + ': ' + v[3]; s.appendChild(p); }); }
+  if (sup('openvpnd')) add(VPN, '2');
+  if (sup('wireguard')) add(WGC, '1');
+  show('iface_row', s.options.length > 1);
+}
+
+/* ---------- start-up ---------- */
+function initTest(){
+  show('p_test', true);
+  ifaces(); renderNotice();
+  if (EOS) return;
+  show('p_hist', true);
+  getQuota();
+  hook('ookla_speedtest_get_history', function(d){
+    hist = (Array.isArray(d) && d.length) ? d : [{}];
+    histInfo(); histDraw();
+    if (NV.state === ST.RUN){
+      /* a run was in progress when the page was opened: follow it, unless the WAN is down */
+      if (linkInternet === '2'){ setLevel(null); setBtn('testing'); getResult(); } else setState(ST.ERR_TERMINATE);
+    } else {
+      exe('list');
+      if (hist.length > 1) showLatest();
+    }
+    qosCap(); wanCheck();
+  });
+}
+function initRate(rate){
+  show('p_rate', true);
+  if (rate >= 1000){ rate = Math.round(rate / 1000); setText('rx_unit', 'Gbps'); setText('tx_unit', 'Gbps'); }
+  setText('rx_rate', String(rate)); setText('tx_rate', String(rate));
+}
+function boot(){
+  var isp = false, decided = false, timer;
+  try { isp = !!(NV.ispctrl && JSON.parse(NV.ispctrl).ISPCtrl !== ''); } catch (e) { isp = false; }
+  q('pp').innerHTML = rp.esc(`<#Thirdparty_PP_Desc1#>`).replace('%1$@', 'Speedtest').replace('[aa]%2$@[/aa]', '<a href="https://www.speedtest.net/about/privacy" target="_blank" rel="noopener noreferrer">Ookla PRIVACY POLICY</a>');
+  on('gobtn', 'click', start);
+  on('server', 'change', serverPicked);
+  on('quota_go', 'click', function(){ window.open('https://www.speedtest.net/', '_blank', 'noopener'); });
+  on('wan_more', 'click', function(){ dialog(`<#InternetSpeed_Notice#>`, `<#InternetSpeed_WAN_Discon_Hint#>`); });
+  on('levelbtn', 'click', function(){ if (level) dialogText(`<#InternetSpeed_downloadSpeedRating#>` + ': ' + level[1], level[2] + '. ' + level[3]); });
+  on('dlg_ok', 'click', function(){ q('dlg').classList.remove('show'); });
+  on('h_all', 'change', histAll); on('h_del', 'click', histDelete);
+  on('h_prev', 'click', function(){ if (pageId > 0){ pageId--; histInfo(); histDraw(); } });
+  on('h_next', 'click', function(){ if (pageId < maxPage){ pageId++; histInfo(); histDraw(); } });
+  function decide(rate){
+    if (decided) return; decided = true; clearTimeout(timer);
+    if (!EOS && rate >= 5000 && (!sup('10g_speedTest') || isp)) initRate(rate); else initTest();
+  }
+  if (EOS){ decide(0); return; }
+  /* the active WAN ports' link rate (capability bit 30 = primary WAN, bit 29 = secondary) */
+  timer = setTimeout(function(){ decide(0); }, 3000);
+  req('GET', '/get_port_status.cgi?node_mac=' + encodeURIComponent(NV.lanmac) + '&_=' + Date.now(), null, function(t){
+    var rate = 0, ports, k, p, cap;
+    try { ports = ((JSON.parse(t) || {}).port_info || {})[NV.lanmac] || {}; } catch (e) { ports = {}; }
+    for (k in ports){ if (!Object.prototype.hasOwnProperty.call(ports, k)) continue;
+      p = ports[k]; cap = parseInt(p.cap, 10) || 0;
+      if (String(p.is_on) !== '1') continue;
+      if ((Math.floor(cap / 1073741824) % 2 === 1 || Math.floor(cap / 536870912) % 2 === 1) && (+p.link_rate) >= 5000) rate = Math.max(rate, +p.link_rate);
+    }
+    decide(rate);
+  });
+}
+boot();
+})();
+</script>
+</body>
+</html>
