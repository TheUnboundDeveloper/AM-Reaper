+/* REAPER-DEVICON-BEGIN (2026-11-27, owner: device pictures and device types, both steps)
+ * The device pictures live in the stock store, written and read here only:
+ *   /jffs/usericon/<MAC12>.log       one device's picture as a data URL - the stock format, so pictures set on the
+ *                                    old pages show without a migration
+ *   /jffs/usericon/<type>.log        a picture for a whole device type (stock; read here, never written)
+ *   /jffs/usericon/usericon_md5.json the stock index (MAC12 -> md5 of the data URL); renew_upload_icon() rebuilds
+ *                                    it at every httpd start
+ * A picture is accepted only as data:image/png, image/jpeg or image/webp in base64 - never SVG, which is a document
+ * that can carry script - at most RDIC_MAX_BYTES once decoded, and only when its first bytes are what the type says.
+ * The page shrinks it to 64 x 64 pixels in a canvas first, so a real one is a few KB. The MAC passes the 17-character
+ * shape check and isValidMacAddress() before any path is built from it; files are opened with O_NOFOLLOW, written to
+ * a temporary file and renamed over the old one. At most RDIC_MAX_FILES pictures, and a write needs RDIC_MIN_FREE
+ * bytes free on /jffs. A stored picture is checked again, the same way, every time it is read. */
+#define RDIC_DIR	"/jffs/usericon"
+#define RDIC_MAX_BYTES	32768				/* one decoded picture */
+#define RDIC_B64_MAX	(((RDIC_MAX_BYTES + 2) / 3) * 4)
+#define RDIC_URL_MAX	(24 + RDIC_B64_MAX)		/* the longest prefix is 23 characters */
+#define RDIC_MAX_FILES	256
+#define RDIC_MIN_FREE	(256 * 1024)			/* /jffs bytes left free after a write */
+#define RDIC_GET_MAX	32				/* pictures per icon_get request */
+
+/* the only accepted forms: no image/svg+xml, no other type, no parameters */
+static const char *const rdic_prefix[] = { "data:image/png;base64,", "data:image/jpeg;base64,", "data:image/webp;base64,", NULL };
+static unsigned char rdic_buf[RDIC_MAX_BYTES];
+
+/* 0 png, 1 jpeg, 2 webp by the prefix, -1 for anything else; *b64 = the base64 that follows */
+static int rdic_kind(const char *u, const char **b64)
+{
+	int i;
+
+	if (!u)
+		return -1;
+	for (i = 0; rdic_prefix[i]; i++) {
+		size_t n = strlen(rdic_prefix[i]);
+		if (!strncmp(u, rdic_prefix[i], n)) {
+			*b64 = u + n;
+			return i;
+		}
+	}
+	return -1;
+}
+
+static int rdic_b64v(unsigned char c)
+{
+	if (c >= 'A' && c <= 'Z') return c - 'A';
+	if (c >= 'a' && c <= 'z') return c - 'a' + 26;
+	if (c >= '0' && c <= '9') return c - '0' + 52;
+	if (c == '+') return 62;
+	if (c == '/') return 63;
+	return -1;
+}
+
+/* strict base64 into rdic_buf: a multiple of 4 characters, the 64-character alphabet only, '=' only as the last one or
+ * two. Returns the decoded length, -1 for malformed input, -2 when it would not fit RDIC_MAX_BYTES. */
+static int rdic_b64dec(const char *s)
+{
+	size_t n = strlen(s), i, o = 0;
+	int pad = 0;
+
+	if (n == 0 || n % 4)
+		return -1;
+	if (n > RDIC_B64_MAX)
+		return -2;
+	if (s[n - 1] == '=') {
+		pad = 1;
+		if (s[n - 2] == '=')
+			pad = 2;
+	}
+	for (i = 0; i < n; i += 4) {
+		int v[4], k, nb = 3;
+		for (k = 0; k < 4; k++) {
+			unsigned char c = (unsigned char)s[i + k];
+			if (c == '=' && i + 4 == n && k >= 4 - pad)
+				v[k] = 0;
+			else if ((v[k] = rdic_b64v(c)) < 0)
+				return -1;
+		}
+		if (i + 4 == n)
+			nb = 3 - pad;
+		if (o + nb > sizeof(rdic_buf))
+			return -2;
+		rdic_buf[o++] = (unsigned char)((v[0] << 2) | (v[1] >> 4));
+		if (nb > 1) rdic_buf[o++] = (unsigned char)(((v[1] & 15) << 4) | (v[2] >> 2));
+		if (nb > 2) rdic_buf[o++] = (unsigned char)(((v[2] & 3) << 6) | v[3]);
+	}
+	return (int)o;
+}
+
+/* the file starts the way its type says (the decoded bytes, not the label) */
+static int rdic_magic_ok(int kind, const unsigned char *b, int n)
+{
+	static const unsigned char png[8] = { 0x89, 'P', 'N', 'G', 0x0d, 0x0a, 0x1a, 0x0a };
+
+	if (n < 16)
+		return 0;
+	if (kind == 0) return !memcmp(b, png, sizeof(png));
+	if (kind == 1) return b[0] == 0xff && b[1] == 0xd8 && b[2] == 0xff;
+	if (kind == 2) return !memcmp(b, "RIFF", 4) && !memcmp(b + 8, "WEBP", 4);
+	return 0;
+}
+
+/* NULL when u is a picture this store keeps, else the error key for the page */
+static const char *rdic_check(const char *u)
+{
+	const char *b64 = NULL;
+	int kind, n;
+
+	if (!u || strlen(u) > RDIC_URL_MAX)
+		return "RDIC_14";
+	kind = rdic_kind(u, &b64);
+	if (kind < 0)
+		return "RDIC_13";
+	n = rdic_b64dec(b64);
+	if (n == -2)
+		return "RDIC_14";
+	if (n < 0 || !rdic_magic_ok(kind, rdic_buf, n))
+		return "RDIC_13";
+	return NULL;
+}
+
+/* the picture's file stem from a MAC that passed both checks: 12 upper-case hex digits, no separator */
+static int rdic_mac12(const char *mac, char *out)
+{
+	int i, o = 0;
+
+	if (!gk_valid_mac(mac) || !isValidMacAddress(mac))
+		return 0;
+	for (i = 0; i < 17; i++)
+		if (mac[i] != ':')
+			out[o++] = (char)toupper((unsigned char)mac[i]);
+	out[o] = 0;
+	return o == 12;
+}
+
+/* a stored file's name: 1 = <12 hex>.log (a device), 2 = <1..3 digits>.log (a device type), 0 = anything else.
+ * stem (17 bytes) gets the part before ".log". */
+static int rdic_name_kind(const char *name, char *stem)
+{
+	size_t n = strlen(name), s;
+
+	if (n < 5 || n > 16 || strcmp(name + n - 4, ".log"))
+		return 0;
+	s = n - 4;
+	if (s == 12 && strspn(name, "0123456789ABCDEFabcdef") == 12) {
+		if (stem) { memcpy(stem, name, 12); stem[12] = 0; }
+		return 1;
+	}
+	if (s >= 1 && s <= 3 && strspn(name, "0123456789") == s) {
+		if (stem) { memcpy(stem, name, s); stem[s] = 0; }
+		return 2;
+	}
+	return 0;
+}
+
+/* /jffs/usericon as a real directory, created when missing (mk); 0 when it is anything else (a link, a file) */
+static int rdic_dir_ok(int mk)
+{
+	struct stat st;
+
+	if (lstat(RDIC_DIR, &st) != 0) {
+		if (!mk || mkdir(RDIC_DIR, 0755) != 0 || lstat(RDIC_DIR, &st) != 0)
+			return 0;
+	}
+	return S_ISDIR(st.st_mode) ? 1 : 0;
+}
+
+/* device pictures stored; *mine = one exists for this MAC (any letter case). With drop: unlink this MAC's files,
+ * keeping the one spelled exactly m12 when keep_exact. unlink() never follows a link. */
+static int rdic_scan(const char *m12, int *mine, int drop, int keep_exact)
+{
+	DIR *d;
+	struct dirent *e;
+	char stem[17], p[64];
+	int n = 0;
+
+	if (mine)
+		*mine = 0;
+	if (!rdic_dir_ok(0) || (d = opendir(RDIC_DIR)) == NULL)
+		return 0;
+	while ((e = readdir(d)) != NULL) {
+		if (rdic_name_kind(e->d_name, stem) != 1)
+			continue;
+		n++;
+		if (!m12 || strcasecmp(stem, m12))
+			continue;
+		if (mine)
+			*mine = 1;
+		if (drop && !(keep_exact && !strcmp(stem, m12))) {
+			snprintf(p, sizeof(p), RDIC_DIR "/%.16s", e->d_name);
+			unlink(p);
+		}
+	}
+	closedir(d);
+	return n;
+}
