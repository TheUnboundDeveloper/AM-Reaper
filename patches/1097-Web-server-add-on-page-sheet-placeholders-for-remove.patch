+/* REAPER-ADDON-SKIN: the Merlin add-on page slots, user<N>.asp (/www/userN.asp -> /www/user/userN.asp ->
+ * /tmp/var/wwwext). No Reaper or stock page has such a name; the shell's ReaperAddons uses the same rule. */
+static int reaper_addon_name(const char *name)
+{
+	size_t d;
+
+	if (strncasecmp(name, "user", 4) != 0)
