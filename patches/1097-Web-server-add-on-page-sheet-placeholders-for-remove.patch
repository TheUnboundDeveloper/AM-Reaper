+/* a stored picture file, returned (malloc'd, NUL-ended, *len set) only when it passes the same check as an upload;
+ * NULL otherwise. The open never follows a link and never waits on a FIFO (O_NONBLOCK); only a regular file of a
+ * plausible size is read. Used by icon_get and by the stock get_upload_icon hook. */
+static char *rdic_load(const char *p, size_t *len)
+{
+	char *b;
+	struct stat st;
+	size_t got = 0;
+	int fd;
+
+	fd = open(p, O_RDONLY | O_NOFOLLOW | O_NONBLOCK);
+	if (fd < 0)
+		return NULL;
+	if (fstat(fd, &st) != 0 || !S_ISREG(st.st_mode) || st.st_size <= 0 || st.st_size > RDIC_URL_MAX + 2 ||
+	    (b = malloc((size_t)st.st_size + 1)) == NULL) {
+		close(fd);
+		return NULL;
+	}
+	while (got < (size_t)st.st_size) {
+		ssize_t r = read(fd, b + got, (size_t)st.st_size - got);
+		if (r < 0 && errno == EINTR)
+			continue;
+		if (r <= 0)
+			break;
+		got += (size_t)r;
+	}
+	close(fd);
+	b[got] = 0;
+	while (got && (b[got - 1] == '\n' || b[got - 1] == '\r'))
+		b[--got] = 0;
+	if (rdic_check(b) != NULL) {
+		free(b);
+		return NULL;
+	}
+	*len = got;
+	return b;
+}
+
+/* one stored picture as  ,"stem":"data:..."  (only one that passes the check) */
+static void rdic_emit(FILE *stream, const char *stem, int *first)
+{
+	char p[64], *b;
+	size_t got = 0;
+
+	snprintf(p, sizeof(p), RDIC_DIR "/%s.log", stem);
+	if ((b = rdic_load(p, &got)) == NULL)
+		return;
+	websWrite(stream, "%s\"%s\":\"", *first ? "" : ",", stem);
+	websWriteData(stream, b, got);
+	websWrite(stream, "\"");
+	*first = 0;
+	free(b);
+}
