+/* a whole file in RDIC_DIR: written to .<name>.tmp (O_EXCL | O_NOFOLLOW), then renamed over <name> */
+static int rdic_put(const char *name, const char *data, size_t len)
+{
+	char tmp[80], dst[80];
+	size_t off = 0;
+	int fd;
+
+	snprintf(tmp, sizeof(tmp), RDIC_DIR "/.%s.tmp", name);
+	snprintf(dst, sizeof(dst), RDIC_DIR "/%s", name);
+	unlink(tmp);
+	fd = open(tmp, O_WRONLY | O_CREAT | O_EXCL | O_NOFOLLOW, 0644);
+	if (fd < 0)
+		return -1;
+	while (off < len) {
+		ssize_t w = write(fd, data + off, len - off);
+		if (w < 0 && errno == EINTR)
+			continue;
+		if (w <= 0) {
+			close(fd);
+			unlink(tmp);
+			return -1;
+		}
+		off += (size_t)w;
+	}
+	if (fsync(fd) != 0) {
+		close(fd);
+		unlink(tmp);
+		return -1;
+	}
+	if (close(fd) != 0 || rename(tmp, dst) != 0) {
+		unlink(tmp);
+		return -1;
+	}
+	return 0;
+}
