diff --git a/release/src/router/httpd/ej.c b/release/src/router/httpd/ej.c
index 4ffa0a4b28..2c5add5e20 100644
--- a/release/src/router/httpd/ej.c
+++ b/release/src/router/httpd/ej.c
@@ -76,11 +76,59 @@ get_arg(char *args, char **next)
 	return arg;
 }
 
+/* REAPER-HOOK-PLACEHOLDER (2026-11-27, owner): a <% name(); %> hook with no handler prints nothing. For most removed
+ * hooks that is harmless (a quoted value becomes "", a statement hook leaves nothing), but a hook written as a bare
+ * JavaScript value - `var a = <% apps_info("asus"); %>;` - turns into `var a = ;`, a syntax error that stops every
+ * script in that block. Third-party add-on pages written for stock Merlin may still use these hooks, so each one
+ * that the stock pages used as a bare value prints a harmless empty value of the same shape instead. Printed only
+ * when no handler matched: a hook that is still built (on any model) answers as before. Each row also writes one
+ * system log line per httpd run naming the page, so the add-on that still uses it can be found. */
+static const struct ej_removed_row { const char *name, *value; } ej_removed_hooks[] = {
+	{ "apps_info", "[]" },
+	{ "bwdpi_appStat", "[]" },
+	{ "bwdpi_wanStat", "[]" },
+	{ "dns_appStat", "[]" },
+	{ "dns_wanStat", "[]" },
+	{ "dns_status", "[]" },
+	{ "usb_is_exist", "0" },
+	{ "get_label_mac", "\"\"" },
+	{ "cpu_core_num", "0" },
+	{ NULL, NULL }
+};
+static const char *ej_cur_page;		/* do_ej(): the page being served (for the log line only) */
+
+static void
+ej_removed_hook(const char *func, FILE *stream)
+{
+	static unsigned int logged;	/* one bit per row: each row logs once per httpd run */
+	const char *p;
+	char page[65];
+	int i, n;
+
+	for (i = 0; ej_removed_hooks[i].name; i++) {
+		if (strcmp(ej_removed_hooks[i].name, func) != 0)
+			continue;
+		fputs(ej_removed_hooks[i].value, stream);
+		if (i < 32 && !(logged & (1u << i))) {
+			logged |= 1u << i;
+			p = ej_cur_page ? strrchr(ej_cur_page, '/') : NULL;
+			p = p ? p + 1 : (ej_cur_page ? ej_cur_page : "");
+			for (n = 0; *p && n < (int)sizeof(page) - 1; p++)	/* a file name: keep the plain characters only */
+				if (isalnum((unsigned char)*p) || *p == '.' || *p == '_' || *p == '-')
+					page[n++] = *p;
+			page[n] = '\0';
+			logmessage("httpd", "reaper: page %s uses removed hook %s (an empty value was written; logged once)",
+				n ? page : "(unknown)", func);
+		}
+		return;
+	}
+}
+
 static void
 call(char *func, FILE *stream)
 {
 	char *args, *end, *next;
-	int argc;
+	int argc, matched = 0;
 	char * argv[16];
 	struct ej_handler *handler;
 
@@ -100,9 +148,13 @@ call(char *func, FILE *stream)
 	/* Call handler */
 	for (handler = &ej_handlers[0]; handler->pattern; handler++) {
 //		if (strncmp(handler->pattern, func, strlen(handler->pattern)) == 0)
-		if (strcmp(handler->pattern, func) == 0)
+		if (strcmp(handler->pattern, func) == 0) {
 			handler->output(0, stream, argc, argv);
+			matched = 1;
+		}
 	}
+	if (!matched)
+		ej_removed_hook(func, stream);	/* REAPER-HOOK-PLACEHOLDER */
 }
 #ifdef TRANSLATE_ON_FLY
 static const char *asp_mark1 = "<%", *asp_mark2 = "%>", *kw_mark1 = "<#", *kw_mark2 = "#>";
@@ -253,6 +305,7 @@ do_ej(char *path, FILE *stream)
 
 	if (!(fp = fopen(path, "r")))
 		return;
+	ej_cur_page = path;	/* REAPER-HOOK-PLACEHOLDER: named in the removed-hook log line */
 
 #ifdef TRANSLATE_ON_FLY
 	char *current_lang = NULL;
@@ -421,6 +474,7 @@ do_ej(char *path, FILE *stream)
 
 	fflush (stream);
 
+	ej_cur_page = NULL;
 	fclose(fp);
 }
 #endif  // defined TRANSLATE_ON_FLY
diff --git a/release/src/router/httpd/httpd.c b/release/src/router/httpd/httpd.c
index 1d185dd1d7..a62f4c681f 100644
--- a/release/src/router/httpd/httpd.c
+++ b/release/src/router/httpd/httpd.c
@@ -965,6 +965,81 @@ static int reaper_wan_listener(void)
 	return http_ifname && *http_ifname && *lan && strcmp(http_ifname, "lo") && strcmp(http_ifname, lan);
 }
 
+/* REAPER-APP-OPTIN (2026-11-28, field request; owner: a choice the admin takes on). The ASUS Router phone app sends
+ * no Referer and no page token, so since REAPER-NOAPP (2026-11-24) its requests fail the checks every browser
+ * request gets. With the switch reaper_app_allow on (Administration > System > Login and access; off at factory,
+ * never set by the firmware) a request is let past those checks - the cross-site refusal, the Referer rule and the
+ * two Referer checks behind it, the page token on an apply, the "an apply is a POST" rule of apply.cgi - and past
+ * nothing else: it still has to sign in. It earns that only when ALL of this holds:
+ *   - the switch is 1;
+ *   - its User-Agent is the app's own kind, check_user_agent() == FROM_DUTUtil ("asusrouter-<os>-DUTUtil-<version>").
+ *     The other FROM_* kinds of shared.h (IFTTT, Alexa, ASSIA, WebView, ATE, MyASUS, unknown) earn nothing;
+ *   - it came in on a LAN listener: not the remote-access listener, not the loopback one;
+ *   - its peer is on the main network (reaper_peer_main_lan(), below).
+ * The User-Agent is the client's own word - any device or program on the main network can claim it; that is the
+ * risk the switch's page text spells out. Decided ONCE per request, in handle_request() (reaper_req_app); the
+ * five places read that result, web.c through httpd.h. With the switch 0 nothing here changes any request. */
+int reaper_req_app = 0;	/* REAPER-APP-OPTIN: this request earns the opt-in app exemption */
+#define REAPER_APP_USED	"/tmp/reaper/.app_optin_used"	/* made at the first use after a boot (one log line per boot) */
+
+/* Is the peer of this connection a device on the main network? IPv4: an address inside lan_ipaddr / lan_netmask that
+ * is not the router's own. A client from the internet (web access from WAN forwards the port to the LAN address,
+ * the peer keeps its own address), a VPN-server client and a guest or other network with its own subnet are outside
+ * it. IPv6: only on the listener rc bound to the LAN bridge (-i <lan_ifname>, SO_BINDTODEVICE) - a packet that came
+ * in on any other interface never reaches that socket; with no bound interface (access-point mode) IPv6 earns
+ * nothing. A network that shares the main subnet cannot be told apart here. */
+static int reaper_peer_main_lan(void)
+{
+	const char *lan = nvram_safe_get("lan_ifname");
+	struct in_addr ip, mask;
+
+	if (uaddr_is_unspecified(&login_uip_tmp) || uaddr_is_localhost(&login_uip_tmp))
+		return 0;
+	if (reaper_wan_listener() || (http_ifname && !strcmp(http_ifname, "lo")))
+		return 0;
+	switch (login_uip_tmp.family) {
+	case AF_INET:
+		if (inet_aton(nvram_safe_get("lan_ipaddr"), &ip) == 0 || inet_aton(nvram_safe_get("lan_netmask"), &mask) == 0 ||
+		    !mask.s_addr || login_uip_tmp.in.s_addr == ip.s_addr)
+			return 0;
+		return (ip.s_addr & mask.s_addr) == (login_uip_tmp.in.s_addr & mask.s_addr);
+#ifdef RTCONFIG_IPV6
+	case AF_INET6:
+		return http_ifname && *lan && !strcmp(http_ifname, lan);
+#endif
+	}
+	return 0;
+}
+
+/* fromapp = what check_user_agent() made of this request's User-Agent. 1 = the exemption applies to this request. */
+static int reaper_app_exempt(int fromapp)
+{
+	static long last;
+	static int said;
+	char ip[64];
+	int fd;
+
+	if (fromapp != FROM_DUTUtil || !nvram_match("reaper_app_allow", "1"))
+		return 0;
+	if (!reaper_peer_main_lan()) {
+		if (uptime() - last >= 10) {	/* as the neighbouring refusals: one line per 10 s */
+			last = uptime();
+			logmessage("httpd", "reaper: a request names the ASUS Router app from outside the home network (%s) - no exemption, it is checked like a browser",
+				safe_uaddr_ntop(&login_uip_tmp, ip, sizeof(ip)));
+		}
+		return 0;
+	}
+	if (!said) {	/* once per boot, whichever listener sees it first */
+		said = 1;
+		if ((fd = open(REAPER_APP_USED, O_WRONLY | O_CREAT | O_EXCL | O_NOFOLLOW | O_CLOEXEC, 0600)) >= 0) {
+			close(fd);
+			logmessage("httpd", "reaper: the ASUS Router app exemption is in use (first request since boot, from %s) - the cross-site checks are relaxed for app requests from the home network",
+				safe_uaddr_ntop(&login_uip_tmp, ip, sizeof(ip)));
+		}
+	}
+	return 1;
+}
+
