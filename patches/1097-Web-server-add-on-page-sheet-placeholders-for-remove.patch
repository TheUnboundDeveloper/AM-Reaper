@@ -2517,6 +2593,7 @@ handle_request(void)
 		strlcpy(user_agent, "", sizeof(user_agent));
 
 	fromapp = check_user_agent(useragent);
+	reaper_req_app = reaper_app_exempt(fromapp);	/* REAPER-APP-OPTIN: decided once per request */
 	reaper_req_authed = 0;
 	reaper_req_post = strcasecmp(method, "post") == 0;	/* reaper 2026-10-25 (review S-C2-1): web.c refuses an apply on anything else */
 
@@ -2565,7 +2642,8 @@ handle_request(void)
 	}
 
 	/* review 2026-11-24 (REAPER-NOAPP-REFERER): the Referer rule of a page is looked up for every request - it
-	 * was skipped when the User-Agent named the ASUS app, which any client can claim */
+	 * was skipped when the User-Agent named the ASUS app, which any client can claim. REAPER-APP-OPTIN
+	 * (2026-11-28): the rule is dropped again only for a request the opt-in exemption applies to. */
 	// check doreferer first
 	for (doreferer = &mime_referers[0]; doreferer->pattern; doreferer++) {
 		if(match(doreferer->pattern, url))
@@ -2574,6 +2652,8 @@ handle_request(void)
 			break;
 		}
 	}
+	if (reaper_req_app)	/* REAPER-APP-OPTIN: the app sends no Referer */
+		do_referer = 0;
 
 	// for each page, mime_exception is defined to do exception handler
 	// check exception first
@@ -2662,15 +2742,16 @@ handle_request(void)
 					/* REAPER-XSITE-OWNOUT (P6-2-1): and for every row with an output function of its own */
 					reaper_xsite_own_out = handler->output && handler->output != do_ej && handler->output != do_file;
 					/* reaper 2026-10-23: cross-site refusal for every authenticated CGI */
-					/* review 2026-11-24 (REAPER-NOAPP-XSITE): also for a request that names the ASUS app in its User-Agent */
-					if (reaper_xsite_cgi_refused(url, file, method, sec_fetch_site, useragent, do_ssl)) {
+					/* review 2026-11-24 (REAPER-NOAPP-XSITE): also for a request that names the ASUS app in its User-Agent -
+					 * REAPER-APP-OPTIN (2026-11-28): unless the opt-in exemption applies to this request */
+					if (!reaper_req_app && reaper_xsite_cgi_refused(url, file, method, sec_fetch_site, useragent, do_ssl)) {
 						if(strcasecmp(method, "post") == 0 && handler->input)	//response post request
 							{ int _dn = cl; if (_dn > 65536) _dn = 65536; while (_dn-- > 0 && fgetc(conn_fp) != EOF) ; }
 						send_error( 403, "Forbidden", (char*) 0, "Cross-site request refused." );
 						return;
 					}
 					if(do_referer&CHECK_REFERER){
-						referer_result = referer_check(referer, 0);	/* REAPER-NOAPP-REFCHK: was fromapp */
+						referer_result = referer_check(referer, reaper_req_app ? fromapp : 0);	/* REAPER-NOAPP-REFCHK: the app flag only with the opt-in (REAPER-APP-OPTIN) */
 						if(referer_result != 0){
 							if(strcasecmp(method, "post") == 0 && handler->input)	//response post request
 								{ int _dn = cl; if (_dn > 65536) _dn = 65536; while (_dn-- > 0 && fgetc(conn_fp) != EOF) ; }
@@ -2715,7 +2796,7 @@ handle_request(void)
 					app_http_login(&login_uip_tmp);
 			}else{
 				if(do_referer&CHECK_REFERER){
-					referer_result = check_noauth_referrer(referer, 0);	/* REAPER-NOAPP-NOAUTHREF: was fromapp */
+					referer_result = check_noauth_referrer(referer, reaper_req_app ? fromapp : 0);	/* REAPER-NOAPP-NOAUTHREF: the app flag only with the opt-in (REAPER-APP-OPTIN) */
 					if(referer_result != 0){
 						if(strcasecmp(method, "post") == 0 && handler->input)	//response post request
 							{ int _dn = cl; if (_dn > 65536) _dn = 65536; while (_dn-- > 0 && fgetc(conn_fp) != EOF) ; }
