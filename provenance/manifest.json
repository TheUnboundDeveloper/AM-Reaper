{
  "description": "Build provenance for the RT-BE Series 'Reaper' firmware. Each published image is traceable to an exact, independently-reproducible source tree: apply the published patch series onto the pinned upstream base, then hash release/src/router. The CI workflow .github/workflows/verify-provenance.yml reproduces every 'verifiable' entry on each run.",
  "base": {
    "project": "Asuswrt-Merlin",
    "tag": "3006.102.8-beta2",
    "commit": "a7ebfa133ad7e5efc23ed6bb8ee912bc72fd00b3",
    "upstream": "https://github.com/RMerl/asuswrt-merlin.ng",
    "source_tree": {
      "release/src/router": "91ac46a9fde7714dbed651d02c04898b4e134be0",
      "release/src-rt": "3de97a56ffbfb82625b1bb8929c3c70da9dc9c80"
    },
    "note": "The base pin never moves. Reaper changes are carried as the patches/ series, and upstream carry-forwards (e.g. Merlin 3006.102.8 -> v2.1.2) are cherry-picked, NOT rebased, so this base stays constant and the reproduction recipe below is stable across releases."
  },
  "toolchain": {
    "host": "Ubuntu 20.04 (WSL2)",
    "cross": "am-toolchains crosstools gcc-10.3 (BCM4916 userspace, 32-bit ARM)",
    "target": "rt-be96u (make target); PROFILE 96813GW",
    "note": "Bit-for-bit binary reproduction additionally requires the proprietary Broadcom/ASUS/Trend Micro prebuilt blobs that upstream ships in-tree and that cannot be re-hosted here; the SOURCE reproduction (release/src/router tree hash) is fully independent of them."
  },
  "reproduce": "git clone https://github.com/RMerl/asuswrt-merlin.ng && cd asuswrt-merlin.ng && git checkout a7ebfa133a && git am --keep-cr /path/to/patches/0001-*.patch .. /path/to/patches/<NNNN>-*.patch && git rev-parse HEAD:release/src/router  # == the release's source_tree['release/src/router']",
  "releases": [
